                "senses": [
                    {
                        "sense_id": "a2c5f24f-fab0-3993-a6a0-a6eb489520f7",
                        "entry_id": "79d2f0d8-0574-355e-a67c-a897c4250a9d",
                        "glosses": [
                            "zentrales, wichtigstes Argument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a9c121-2858-4660-ab8f-cd82396369eb",
                                "sense_id": "a2c5f24f-fab0-3993-a6a0-a6eb489520f7",
                                "text": "„Das Hauptargument Nader Schahs war, dass ein Paschtune aus dem Stamm der Mohammadzai auf dem Kabuler Thron sitzen müsse.“"
                            },
                            {
                                "example_id": "bdc42d7e-9d54-42e0-8470-22d699898693",
                                "sense_id": "a2c5f24f-fab0-3993-a6a0-a6eb489520f7",
                                "text": "„Als Hauptargument gegen die Möglichkeit von Zeitreisen wird von Forschern gern das so genannte ›Großvater-Paradox‹ ins Feld geführt.“"
                            },
                            {
                                "example_id": "9cbd026a-e2db-4f62-b2ec-c07103c4d1c2",
                                "sense_id": "a2c5f24f-fab0-3993-a6a0-a6eb489520f7",
                                "text": "„Dass Syrien und Iran sich konsequent für die Palästinenser einsetzten, war hier übrigens das Hauptargument, an den besonderen Beziehungen zu den beiden Staaten festzuhalten.“"
                            },
                            {
                                "example_id": "b750fac9-bc95-4b9f-a2b2-d9c54058f351",
                                "sense_id": "a2c5f24f-fab0-3993-a6a0-a6eb489520f7",
                                "text": "„Sein Hauptargument war also, dass das Überleben der Spanier in den neu eroberten Gebieten und der Erhalt der militärischen Kontrolle von der Zuteilung indigener Arbeitskraft abhängig seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
