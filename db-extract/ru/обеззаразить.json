                                        "entry_id": "836f89cf-3898-3df6-880f-302cc3ca1ec2",
                                        "glosses": [
                                            "die Bakterien und/oder Keime von etwas entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3543cf8-28d3-4b5b-bc7c-3462aa717c96",
                                                "sense_id": "b00340de-a1d5-3ad3-a7d2-e08e523049c6",
                                                "text": "„Trinkwasser wird laufend durch Chlorzusatz desinfiziert.“"
                                            },
                                            {
                                                "example_id": "6c810a24-fbc4-4de1-ae0d-de0ac9038483",
                                                "sense_id": "b00340de-a1d5-3ad3-a7d2-e08e523049c6",
                                                "text": "„Um das Wasser zu desinfizieren, bestrahlt Al-Hakim es mit UV-Licht, statt es mit Chlor zu versetzen.“"
                                            },
                                            {
                                                "example_id": "676da5fb-8b06-407a-9af0-5d9e6c7f313c",
                                                "sense_id": "b00340de-a1d5-3ad3-a7d2-e08e523049c6",
                                                "text": "„Ein OP muss regelmäßig desinfiziert bzw. sterilisiert werden.“"
                                            },
                                            {
                                                "example_id": "90d35fb8-10e0-464a-bdd9-49370bf31480",
                                                "sense_id": "b00340de-a1d5-3ad3-a7d2-e08e523049c6",
                                                "text": "Die desinfizierende Wirkung des Mittels war nicht stark genug."
                                            },
                                            {
                                                "example_id": "aae19424-f479-4867-ad3d-74557598406d",
                                                "sense_id": "b00340de-a1d5-3ad3-a7d2-e08e523049c6",
                                                "text": "Bitte desinfizieren Sie Ihre Hände, bevor Sie die Handschuhe überstreifen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
