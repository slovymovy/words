                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ad0f8a6-fa38-32e8-8296-c88fc93bcb53",
                                        "entry_id": "3a8bdd56-b1f5-37d2-8baf-78cb717d1686",
                                        "glosses": [
                                            "A similar rotational or orbital characteristic of some other celestial body."
                                        ],
