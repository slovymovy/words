                                "target_senses": [
                                    {
                                        "sense_id": "be33901b-5153-3471-8364-de9b8b5b4056",
                                        "entry_id": "f8122ad6-0359-3495-b3c2-83bbec152eeb",
                                        "glosses": [
                                            "Variante de banshee."
                                        ],
