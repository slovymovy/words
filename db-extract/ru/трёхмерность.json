                ],
                "translations": [
                    {
                        "translation_id": "72f38082-118b-4009-91ec-e4f2523c03f1",
                        "source_entry_id": "e8848762-c727-3b65-83cd-58f5b078e72c",
                        "source_sense_id": "6757e3fb-7541-3878-95dd-091aca9ca392",
                        "target_lang_word": "three-dimensionality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "three-dimensionality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd466e6-706e-30e8-86d6-ed56d9c30749",
                                        "entry_id": "0896f6c5-844c-3106-9d96-494dd98075af",
                                        "glosses": [
                                            "The state or characteristic of occupying, or of appearing to occupy, three dimensions of space."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a92294ef-06e8-46de-8b57-e6722a0f15ae",
                                                "sense_id": "bdd466e6-706e-30e8-86d6-ed56d9c30749",
                                                "text": "[T]here are several fascinating mixed-media pieces that give subtle three-dimensionality to predominately flat surfaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f18fa96-b495-3bdd-9558-5ab8ae6750d9",
                                        "entry_id": "0896f6c5-844c-3106-9d96-494dd98075af",
                                        "glosses": [
                                            "Complexity and depth of character."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5d8c9c-a9c5-489f-9feb-667ef09a59b2",
                                                "sense_id": "9f18fa96-b495-3bdd-9558-5ab8ae6750d9",
                                                "text": "Gleeson, a brilliant performer, shows us the face of evil but with the mitigating circumstances of humanity. But his three-dimensionality is jarring; at odds with the wooden movie around him."
                                            },
                                            {
                                                "example_id": "68a4382f-bf32-438c-9515-b01f377ac78b",
                                                "sense_id": "9f18fa96-b495-3bdd-9558-5ab8ae6750d9",
                                                "text": "Dr. Williams . . . commended his \"search for some way of talking about human value, human depth and three-dimensionality, that doesn't depend on God.\""
                                            },
                                            {
                                                "example_id": "06bb1723-8fbe-4a28-9308-9fcedb7ba799",
                                                "sense_id": "9f18fa96-b495-3bdd-9558-5ab8ae6750d9",
                                                "text": "In 1968, she costarred with Clint Eastwood in the feature film Coogan's Bluff, bringing three-dimensionality to the otherwise cliched role of a hippie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7159d5ea-8223-48c1-b23a-23366a6ab4d0",
                        "source_entry_id": "e8848762-c727-3b65-83cd-58f5b078e72c",
                        "source_sense_id": "6757e3fb-7541-3878-95dd-091aca9ca392",
                        "target_lang_word": "Dreidimensionalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreidimensionalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2b12f1e-88d9-3463-965c-abed9e522250",
                                        "entry_id": "2497f7cd-1f9b-3763-86f3-d8b7f5ba66c0",
                                        "glosses": [
                                            "Eigenschaft, drei Dimensionen zu haben (Höhe, Breite und Tiefe im Raum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa839986-4b51-4cf0-a253-d47689ac605b",
                                                "sense_id": "f2b12f1e-88d9-3463-965c-abed9e522250",
                                                "text": "„Zum einen werden Würfelgebäude mit konkretem Material (Holzwürfel) als Objekt dargestellt. Zum anderen sind die Kinder gefordert, den klassischen Bauplan und Schrägbildabbildungen als zweidimensionale Darstellungen in Dreidimensionalität zu übersetzen.“"
                                            },
                                            {
                                                "example_id": "0da2a2e5-4625-44fc-a49c-79b1595130f7",
                                                "sense_id": "f2b12f1e-88d9-3463-965c-abed9e522250",
                                                "text": "„Anders ist das bei den Bildern von Frederike Balke, die bewußt mit der Dreidimensionalität spielt. Dabei werden optische Täuschungen hervorgerufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
