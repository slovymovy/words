                        "glosses": [
                            "An enclave of Indianapolis, Wayne Township, Marion County, Indiana, United States."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "514e2a8b-f5a8-47f1-b6e4-94803434a64b",
                                "sense_id": "02d4322a-cf82-39c3-b5e0-b8d0e5545fec",
                                "text": "A couple of broad ideas they determined included converting Indianapolis into a single, countywide government led by a strong mayor, and, for political purposes, omitting the school districts and the cities of Beech Grove, Lawrence, Southport and Speedway from any consolidation efforts."
                            }
                        ]
                    }
