                "senses": [
                    {
                        "sense_id": "db02c086-de9c-312f-b9ed-07475f9bf2cd",
                        "entry_id": "1fbfd36a-f24e-3ff8-8cc0-823bc9c993e0",
                        "glosses": [
                            "Donner un caractère tadjik à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28fb8779-debc-4a6c-a17c-df8356db64ed",
                                "sense_id": "db02c086-de9c-312f-b9ed-07475f9bf2cd",
                                "text": "Cet ouvrage composé de neuf chapitres décrit dans un persan tadjikisé la ville de Samarcande et ses faubourgs en insistant sur les institutions religieuses."
                            },
                            {
                                "example_id": "f1651463-f330-40ef-82e6-04a379291c0d",
                                "sense_id": "db02c086-de9c-312f-b9ed-07475f9bf2cd",
                                "text": "Sans doute également la branche tadjike répondait-elle précisément aux spécificités de la pratique de l’islam, propre au pays, comme si le PRI au Tadjikistan s’était « tadjikisé »."
                            },
                            {
                                "example_id": "1b6c1129-3d96-44bd-83f4-b23058969ab5",
                                "sense_id": "db02c086-de9c-312f-b9ed-07475f9bf2cd",
                                "text": "Néanmoins, les fonctionnaires du gouvernement durent s'organiser pour que toute l'Administration puisse se tadjikiser complètement, tant à l'oral qu'à l'écrit, pour 1994."
                            }
                        ]
                    }
                ],
