                        "examples": [
                            {
                                "example_id": "50f31f5b-8b36-4293-9730-0067ed429d72",
                                "sense_id": "9ecb4e12-47ce-3c42-a120-ed75ea70850b",
                                "text": "The sick man lay unutterably weak and spent, kept alive by morphia and by drinks, which he sipped slowly."
                            },
                            {
                                "example_id": "720b6061-e65b-43e7-b8f5-7b91b4541af3",
                                "sense_id": "9ecb4e12-47ce-3c42-a120-ed75ea70850b",
                                "text": "“Die? Yes, they’ll all die—all these men. No bandages, no salves, no quinine, no chloroform. Oh, God, for some morphia! Just a little morphia for the worst ones. Just a little chloroform. God damn the Yankees! God damn the Yankees!”"
                            }
                        ]
                    }
