                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un voleur adroit lui a <w>fait</w> son portefeuille dans le métro bondé ce matin."
                        },
                        {
                            "text": "Fais bien attention à tes affaires ici, car on peut te <w>faire</w> ton sac facilement."
                        }
                    ],
                    "common_phrases": [
