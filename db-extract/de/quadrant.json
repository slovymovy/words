                                    {
                                        "sense_id": "9ca1ffaf-c0bc-304a-bf9f-e03018d1a1c7",
                                        "entry_id": "0a1a99b8-c79d-3be8-b37f-0488f21ea027",
                                        "glosses": [
                                            "One of the four sections made by dividing an area with two perpendicular lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe12632-06a1-4e0a-ad25-9b877873f4bd",
                                                "sense_id": "9ca1ffaf-c0bc-304a-bf9f-e03018d1a1c7",
                                                "text": "Kids, I swear, I'm gonna love all of you, and equally. I'll be dividing my love into seven equal sections, or \"Love Quadrants\". Each quadrant will be worth 15 \"Love Units\" represented by these small brass marbles. You may use these marbles as currency amongst yourselves. Collect 35 \"Love Units\", you can trade those in for a beach towel with my face on it."
                                            },
                                            {
                                                "example_id": "1ceaf0ac-5b3d-4570-8049-b4e48ab0e59b",
                                                "sense_id": "9ca1ffaf-c0bc-304a-bf9f-e03018d1a1c7",
                                                "text": "Ops wanted some initiative, blew up their entire quadrant. I'm movin' like Oppenheimer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6a46d1-a262-377b-83f6-62f06e860aca",
