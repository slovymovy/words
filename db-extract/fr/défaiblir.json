                "senses": [
                    {
                        "sense_id": "830c9916-ed7b-3648-8f6c-c0978c1a372e",
                        "entry_id": "a8ad2c2c-b33e-35e4-abda-2e4fdbd9056f",
                        "glosses": [
                            "Faiblir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d9eae8b4-e0ce-45ce-ab2f-78cb61541128",
                                "sense_id": "830c9916-ed7b-3648-8f6c-c0978c1a372e",
                                "text": "Il exhorta de nouveau le jeune colon à la résignation tandis que lui-même il se sentait défaiblir et trembler, lui que rien ne pouvait émouvoir ni les rugissements de la tempête, ni les grondements du canon ni le sifflement des balles sur le champ de bataille."
                            },
                            {
                                "example_id": "ae69077c-dc7b-4da8-8bb3-30a8e52e9165",
                                "sense_id": "830c9916-ed7b-3648-8f6c-c0978c1a372e",
                                "text": "Nous sommes alors capables de marcher d’un pas ferme et assuré à travers les dangers du pèlerinage de cette vie ; mais pour ne pas laisser défaiblir ceux qui le suivent, le divin Sauveur leur a préparé une table où il leur offre le pain des forts, qui est la substance méme de son corps adorable."
                            }
                        ]
                    }
                ],
