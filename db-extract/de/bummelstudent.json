                "senses": [
                    {
                        "sense_id": "de1c0e95-b493-308d-9f82-6cd0424dd215",
                        "entry_id": "b592b5e9-2777-35a6-8b75-7db45c52732b",
                        "glosses": [
                            "wenig zielstrebiger Studierender, der sich viel Zeit für sein Studium lässt und vielleicht nie einen Abschluss macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "699639dd-7371-4dde-85ca-0290b996418c",
                                "sense_id": "de1c0e95-b493-308d-9f82-6cd0424dd215",
                                "text": "„So ist es oft nicht Faulheit, sondern der eigene Ehrgeiz, an dem Bummelstudenten scheitern.“"
                            },
                            {
                                "example_id": "78dd2900-cbd2-44f6-9180-f15d71111082",
                                "sense_id": "de1c0e95-b493-308d-9f82-6cd0424dd215",
                                "text": "„Im Saarland und in Niedersachsen müssen Bummelstudenten schon längst zahlen.“"
                            },
                            {
                                "example_id": "2d1b6cc2-6356-47bc-9187-2ba6259ad1b2",
                                "sense_id": "de1c0e95-b493-308d-9f82-6cd0424dd215",
                                "text": "„So hatte er das Leben eines internationalen Bummelstudenten geführt, bis ihn der Treuhänder seines Vaters von dessen plötzlichem Tod unterrichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
