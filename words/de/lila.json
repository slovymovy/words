                                "ru": "Светлый <w>лиловый цвет</w> отлично подходит к белым шторам.",
                                "nl": "Het lichte <w>lila</w> past heel goed bij de witte gordijnen.",
                                "pl": "Jasny <w>kolor liliowy</w> bardzo dobrze pasuje do białych zasłon.",
                                "fr": "Le <w>lilas</w> clair s'accorde très bien avec les rideaux blancs.",
                                "it": "Il <w>lilla</w> chiaro si abbina molto bene alle tende bianche.",
                                "cs": "Světlá <w>fialová</w> se velmi dobře hodí k bílým závěsům.",
                                "tr": "Açık <w>lila</w>, beyaz perdelere çok iyi uyuyor.",
                                "es": "El <w>lila</w> claro combina muy bien con las cortinas blancas.",
                                "zh": "明亮的<w>浅紫色</w>和白色的窗帘非常相配。"
                            }
                        },
                        {
                            "text": "Sie hat die Wände ihres Zimmers in einem sanften <w>Lila</w> gestrichen.",
                            "target_lang_translations": {
                                "en": "She painted the walls of her room in a soft <w>lilac</w>.",
                                "ru": "Она покрасила стены своей комнаты в нежный <w>лиловый цвет</w>.",
                                "nl": "Ze heeft de muren van haar kamer in een zacht <w>lila</w> geschilderd.",
                                "pl": "Pomalowała ściany swojego pokoju na delikatny <w>kolor liliowy</w>.",
                                "fr": "Elle a peint les murs de sa chambre dans un <w>mauve</w> doux.",
                                "it": "Ha dipinto le pareti della sua stanza di un <w>lilla</w> tenue.",
                                "cs": "Stěny svého pokoje vymalovala jemnou <w>fialovou</w>.",
                                "tr": "Odasının duvarlarını yumuşak bir <w>lila rengine</w> boyadı.",
                                "es": "Pintó las paredes de su habitación de un <w>lila</w> suave.",
                                "zh": "她把房间的墙壁刷成了柔和的<w>淡紫色</w>。"
                            }
