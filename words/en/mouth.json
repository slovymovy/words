{
    "word_family": [
        "mouthful",
        "mouthpiece",
        "mouthy",
        "badmouth",
        "loudmouth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98a15d0e-ccc9-3595-8728-25001b05f2b8",
                    "sense_definition": "The front opening of a creature through which food is ingested.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please open your <w>mouth</w> so the doctor can see your throat.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, откройте <w>рот</w>, чтобы врач мог осмотреть ваше горло.",
                                "zh": "请张开<w>嘴</w>，让医生看看你的喉咙。"
                            }
                        },
                        {
                            "text": "It is polite to close your <w>mouth</w> when you are chewing food.",
                            "target_lang_translations": {
                                "ru": "Вежливо закрывать <w>рот</w>, когда пережевываешь пищу.",
                                "zh": "吃东西时闭上<w>嘴</w>才礼貌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maw",
                        "gob",
                        "trap"
                    ],
                    "common_phrases": [
                        "open your mouth",
                        "shut your mouth",
                        "big mouth",
                        "mouth to mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переднее отверстие у живого существа, через которое принимается пища.",
                        "zh": "生物摄取食物的器官，位于面部前方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рот",
                                "target_lang_sense_clarification": "основное слово для людей"
                            },
                            {
                                "target_lang_word": "пасть",
                                "target_lang_sense_clarification": "рот животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘴",
                                "target_lang_sense_clarification": "人体或动物进食、发声的器官"
                            },
                            {
                                "target_lang_word": "嘴巴",
                                "target_lang_sense_clarification": "口语中常用的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b84fa81-a6bf-3931-917e-9741e5b554b5",
                    "sense_definition": "The end of a river out of which water flows into a sea or other large body of water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was built at the <w>mouth</w> of the river to help with trade.",
                            "target_lang_translations": {
                                "ru": "Город был построен в <w>устье</w> реки для содействия торговле.",
                                "zh": "这座城市建在<w>河口</w>，以利于贸易。"
                            }
                        },
                        {
                            "text": "We sailed our small boat from the source of the stream down to its <w>mouth</w>.",
                            "target_lang_translations": {
                                "ru": "Мы проплыли на нашей маленькой лодке от истока ручья до его <w>устья</w>.",
                                "zh": "我们划着小船从溪流的源头一直航行到<w>河口</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "river mouth",
                        "mouth of the river"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец реки, из которого вода впадает в море или другой крупный водоем.",
                        "zh": "河流流入海洋或其他大型水体的末端。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устье",
                                "target_lang_sense_clarification": "географический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "河口",
                                "target_lang_sense_clarification": "河流入海处"
                            },
                            {
                                "target_lang_word": "入海口",
                                "target_lang_sense_clarification": "河流汇入海洋的地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3a97c34-0067-3756-94f2-709eaeb5e61c",
                    "sense_definition": "An outlet, aperture, or entrance to a hollow space.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stood at the <w>mouth</w> of the dark cave, afraid to go inside.",
                            "target_lang_translations": {
                                "ru": "Туристы стояли у <w>входа</w> в темную пещеру, боясь войти внутрь.",
                                "zh": "徒步旅行者站在黑暗的<w>洞口</w>，不敢进去。"
                            }
                        },
                        {
                            "text": "He wiped the <w>mouth</w> of the bottle before taking a drink.",
                            "target_lang_translations": {
                                "ru": "Он вытер <w>горлышко</w> бутылки, прежде чем сделать глоток.",
                                "zh": "他喝水前擦了擦<w>瓶口</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouth of a cave",
                        "mouth of a tunnel",
                        "mouth of a bottle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выход, отверстие или вход в полое пространство.",
                        "zh": "空腔的入口或开口处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горлышко",
                                "target_lang_sense_clarification": "бутылки или сосуда"
                            },
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "в пещеру или туннель"
                            },
                            {
                                "target_lang_word": "отверстие",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口",
                                "target_lang_sense_clarification": "指容器或空间的开口"
                            },
                            {
                                "target_lang_word": "瓶口",
                                "target_lang_sense_clarification": "瓶子的开口处"
                            },
                            {
                                "target_lang_word": "洞口",
                                "target_lang_sense_clarification": "洞穴的入口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2661cf91-4464-3151-972f-893c54fd01d4",
                    "sense_definition": "A loud or overly talkative person; a gossip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't tell him your secrets because he is such a <w>mouth</w>.",
                            "target_lang_translations": {
                                "ru": "Не рассказывай ему свои секреты, потому что он такой <w>болтун</w>.",
                                "zh": "别告诉他你的秘密，他是个大<w>嘴巴</w>。"
                            }
                        },
                        {
                            "text": "She can be a bit of a <w>mouth</w> when she has had too much coffee.",
                            "target_lang_translations": {
                                "ru": "Она бывает настоящей <w>болтушкой</w>, когда выпьет слишком много кофе.",
                                "zh": "她喝太多咖啡后会变得很爱<w>唠叨</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe a person who talks too much"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий или слишком разговорчивый человек; сплетник.",
                        "zh": "说话过多、喜欢搬弄是非的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтун",
                                "target_lang_sense_clarification": "разговорчивый человек"
                            },
                            {
                                "target_lang_word": "трепло",
                                "target_lang_sense_clarification": "сплетник (разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大嘴巴",
                                "target_lang_sense_clarification": "形容爱说闲话的人"
                            },
                            {
                                "target_lang_word": "长舌妇",
                                "target_lang_sense_clarification": "指爱散布流言的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f532522d-5f8e-3e4c-b9b4-f4c4fb69df24",
                    "sense_definition": "A wry face or grimace made to show displeasure or mockery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child made a <w>mouth</w> at his mother when she told him to eat his vegetables.",
                            "target_lang_translations": {
                                "ru": "Ребенок скорчил <w>гримасу</w> матери, когда она велела ему есть овощи.",
                                "zh": "当妈妈让他吃蔬菜时，孩子向她做了个<w>鬼脸</w>。"
                            }
                        },
                        {
                            "text": "He made a <w>mouth</w> of disgust when he tasted the sour lemon.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>гримасу</w> отвращения, когда попробовал кислый лимон.",
                                "zh": "他尝到酸柠檬时，露出了厌恶的<w>表情</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искаженное выражение лица или гримаса, выражающая недовольство или насмешку.",
                        "zh": "为了表示不满或嘲弄而做出的扭曲表情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гримаса",
                                "target_lang_sense_clarification": "выражение лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做鬼脸",
                                "target_lang_sense_clarification": "通过面部表情表达嘲弄"
                            },
                            {
                                "target_lang_word": "撇嘴",
                                "target_lang_sense_clarification": "表示不满或轻蔑的表情"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "766c2fdf-267f-3e0e-a0a4-a03902bf0aa1",
                    "sense_definition": "To move the lips as if speaking but without making any sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>mouthed</w> a silent goodbye to her friend across the crowded room.",
                            "target_lang_translations": {
                                "ru": "Она <w>беззвучно прошептала</w> прощание своему другу через переполненную комнату.",
                                "zh": "她隔着拥挤的房间，向朋友<w>无声地</w>说了再见。"
                            }
                        },
                        {
                            "text": "The singer <w>mouthed</w> the words to the song because he had lost his voice.",
                            "target_lang_translations": {
                                "ru": "Певец лишь <w>открывал рот</w> под слова песни, потому что потерял голос.",
                                "zh": "歌手因为失声，只能跟着音乐<w>对口型</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouth the words",
                        "mouth an apology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шевелить губами, имитируя речь, но не издавая звуков.",
                        "zh": "只动嘴唇而不发出声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззвучно шевелить губами",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "артикулировать",
                                "target_lang_sense_clarification": "произносить без звука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对口型",
                                "target_lang_sense_clarification": "模仿说话或唱歌的动作"
                            },
                            {
                                "target_lang_word": "无声地动嘴",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6d5260e-01b8-39d9-b121-b8d88f500be0",
                    "sense_definition": "To speak or utter something, often in a distinct or pompous way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>mouthed</w> his opinions loudly during the meeting, annoying everyone else.",
                            "target_lang_translations": {
                                "ru": "Он громко <w>выкрикивал</w> свои мнения во время собрания, раздражая всех остальных.",
                                "zh": "他在会议上大声<w>高谈阔论</w>，惹恼了其他人。"
                            }
                        },
                        {
                            "text": "The politician <w>mouthed</w> empty promises that he did not intend to keep.",
                            "target_lang_translations": {
                                "ru": "Политик <w>изрекал</w> пустые обещания, которые не собирался выполнять.",
                                "zh": "那位政客<w>空谈</w>着他并不打算兑现的承诺。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или произносить что-либо, часто отчетливо или помпезно.",
                        "zh": "以一种夸张或做作的方式说出某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствовать",
                                "target_lang_sense_clarification": "говорить много и помпезно"
                            },
                            {
                                "target_lang_word": "изрекать",
                                "target_lang_sense_clarification": "говорить с важностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高谈阔论",
                                "target_lang_sense_clarification": "夸张地发表意见"
                            },
                            {
                                "target_lang_word": "空谈",
                                "target_lang_sense_clarification": "指说些不切实际的话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aad422f-044c-36ed-8099-c57d5c81f19c",
                    "sense_definition": "To pick up, handle, or explore something with the lips or mouth, especially used of animals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy <w>mouthed</w> the toy gently before starting to chew on it.",
                            "target_lang_translations": {
                                "ru": "Щенок нежно <w>прикусывал</w> игрушку, прежде чем начать ее грызть.",
                                "zh": "小狗在开始啃咬玩具前，先轻轻地<w>衔</w>住了它。"
                            }
                        },
                        {
                            "text": "The horse <w>mouthed</w> the bit as the rider prepared to mount.",
                            "target_lang_translations": {
                                "ru": "Лошадь <w>перебирала губами</w> удила, пока всадник готовился сесть в седло.",
                                "zh": "当骑手准备上马时，马儿<w>嚼</w>着马衔铁。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать, трогать или исследовать что-либо губами или ртом, особенно о животных.",
                        "zh": "用嘴唇或嘴部触碰、探索物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать в рот",
                                "target_lang_sense_clarification": "действие животного"
                            },
                            {
                                "target_lang_word": "прикусывать",
                                "target_lang_sense_clarification": "слегка кусать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衔",
                                "target_lang_sense_clarification": "用嘴叼住"
                            },
                            {
                                "target_lang_word": "啃",
                                "target_lang_sense_clarification": "用牙齿或嘴部轻咬"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}