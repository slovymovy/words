                "senses": [
                    {
                        "sense_id": "18564e64-0d42-3df4-abaf-b2514ca4b54b",
                        "entry_id": "ac234278-2a7c-3501-aaa8-f6f255b6b4d0",
                        "glosses": [
                            "zur Leistung des Wehrdiensts verpflichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "140d8623-cb7f-401e-94ae-ba151a0073f4",
                                "sense_id": "18564e64-0d42-3df4-abaf-b2514ca4b54b",
                                "text": "„Die ländliche Bevölkerung war in Preußen bereits vor 1814 militärpflichtig gewesen, allerdings in weit geringerem Umfang.“"
                            },
                            {
                                "example_id": "d2d32400-697e-4802-b4fc-d42ee01fcc81",
                                "sense_id": "18564e64-0d42-3df4-abaf-b2514ca4b54b",
                                "text": "„Der Einführung des Personalausweises entzogen sich 1947 die Schinwari, Mohmand, Safi und Mangal durch die Flucht über die Durand-Linie, um ihre militärpflichtigen Männer nicht angeben zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
