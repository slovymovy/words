                                "target_senses": [
                                    {
                                        "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "The action of the verb to knit; the process of producing knitted material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c24ba468-d3ed-4325-8b32-b0a0137ea976",
                                                "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                                                "text": "I find knitting very relaxing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "Material that has been, or is being knitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e8fbcd-3449-43c3-8b2d-7a3e2a8c2d87",
                                                "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                                "text": "She put down her knitting and went to answer the phone."
                                            },
                                            {
                                                "example_id": "2f7d2b43-ce07-4c11-8867-8c0f546cee46",
                                                "sense_id": "490f5a85-f068-36da-8152-27ce97ee8ac7",
                                                "text": "At Kiwi, 40 miles from Nelson [New Zealand], eight women installed themselves in the goods shed, taking with them their knitting, and a supply of food and magazines. The demolition crew was unable to pull the building down without injuring them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "overhead electrification wires, OHLE"
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69499aa1-feba-4941-9481-aec1de33e850",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "Fair point. Instead of tearing down the knitting and using diesel, tear down the knitting and use turbines."
                                            },
                                            {
                                                "example_id": "3a061ec0-9ebc-4149-a94e-33095871ffe0",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "It also helps, if: [...] the knitting is aligned with the track below, or rather vice versa, something else that went after 1996."
                                            },
                                            {
                                                "example_id": "09b036a4-4a1e-452c-8b89-905935b9aae7",
                                                "sense_id": "fe387765-4a55-325e-8800-b1d2ce8dbefb",
                                                "text": "My suggestion would be to electrify the uphill bits only, in each direction, and to use diesel traction when coming down the other side. Massive savings on posts and knitting for a start."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65a5493e-4866-4de5-8bbe-0b6eb60f2b52",
                        "source_entry_id": "a07cc19e-18cc-3733-a67f-9aad675ff952",
                        "source_sense_id": "6cf73080-3c88-33ad-89a1-b983d8e056d9",
                        "target_lang_word": "tricot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0530f115-b49e-3d64-87d3-76064dd4638f",
                                        "entry_id": "90cfaa28-27cf-3425-b3b1-1230f1bd422b",
                                        "glosses": [
                                            "Tissu fait en mailles, soit à la main, avec de longues aiguilles émoussées, soit au métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89bc8cd-38ac-4c18-bc10-7144ca22bda6",
                                                "sense_id": "0530f115-b49e-3d64-87d3-76064dd4638f",
                                                "text": "Un gilet de tricot."
                                            },
                                            {
                                                "example_id": "0c899384-8015-4f85-a555-5db5ec37b170",
                                                "sense_id": "0530f115-b49e-3d64-87d3-76064dd4638f",
                                                "text": "Elle portait de gros bas anglais, une courte jupe écossaise, un chandail de tricot et ses cheveux flottaient librement au vent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ddf561-43e9-3fef-8da5-e68e8bfcd644",
                                        "entry_id": "90cfaa28-27cf-3425-b3b1-1230f1bd422b",
                                        "glosses": [
                                            "Travail d’une personne qui tricote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543fc551-b5e1-4fef-bd54-94e9e9eb9445",
                                                "sense_id": "a6ddf561-43e9-3fef-8da5-e68e8bfcd644",
                                                "text": "Elle est toujours occupée de son tricot."
                                            },
                                            {
                                                "example_id": "941a9897-cbdb-4c9e-839c-e4fb3721a8e6",
                                                "sense_id": "a6ddf561-43e9-3fef-8da5-e68e8bfcd644",
                                                "text": "Elle ne perdait pas son temps, comme elle disait, en tricots interminables. Parfois, les dimanches d’hiver, comme un remords, elle essaie de s’y mettre, toutes les deux comptant laborieusement les mailles d’une écharpe au point mousse qui ne dépassera jamais vingt centimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25754bd-b03c-3edd-8070-6b1b341062d7",
                                        "entry_id": "90cfaa28-27cf-3425-b3b1-1230f1bd422b",
                                        "glosses": [
                                            "Vêtement fait en fils de laine (ou d'une autre matière) tricotés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ec92ca-7b45-471a-81d8-e5affdc98a83",
                                                "sense_id": "a25754bd-b03c-3edd-8070-6b1b341062d7",
                                                "text": "Quand il veut être à l'aise, Helmut Kohl tombe la veste et enfile un tricot de laine à larges torsades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd755c3-19a3-3e40-acdc-7c61e52a1158",
                                        "entry_id": "90cfaa28-27cf-3425-b3b1-1230f1bd422b",
                                        "glosses": [
                                            "Vêtement de coton couvrant le haut du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09dc29e7-6fc5-4638-af91-629718c04004",
                                                "sense_id": "bfd755c3-19a3-3e40-acdc-7c61e52a1158",
                                                "text": "Ils traversèrent la pelouse, qui était entretenue par les prisonniers en tricot brun et jaune, s'arrêtèrent devant le perron du bungalow qu'on leur avait désigné ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011b98c5-4227-34d2-ab0a-3194c317f502",
                                        "entry_id": "90cfaa28-27cf-3425-b3b1-1230f1bd422b",
                                        "glosses": [
                                            "T-shirt."
                                        ],
                                        "tags": [
                                            "Martinique"
                                        ],
                                        "examples": []
                                    }
