                "senses": [
                    {
                        "sense_id": "d2c23203-17b3-35e3-aa71-b9afacdfad32",
                        "entry_id": "b4ea1267-dd09-3298-be8a-41f3e9dcebd3",
                        "glosses": [
                            "Consommé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ed4def-05e2-43c5-9d9d-e0a6c66246d2",
                                "sense_id": "d2c23203-17b3-35e3-aa71-b9afacdfad32",
                                "text": "Konsommee ist eine Rinderkraftbrühe, in der noch einmal geschreddertes, oder gewolftes Fleisch, Eiweiß und Wurzelgemüse, vermengt mit Eiswürfeln gekocht wurde.",
                                "translation": "Le consommé est un bouillon de bœuf dans lequel on fait cuire de nouveau de la viande râpée ou hachée, du blanc d’œuf et des tubercules, mélangés à des glaçons."
                            }
                        ]
                    }
                ],
