{
    "word_family": [
        "crouch"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18ecb71b-886e-32e4-a191-ed7c2ebe4816",
                    "sense_definition": "present participle and gerund of <w>crouch</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat was <w>crouching</w> behind the sofa, waiting to pounce on the toy.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>сидела на корточках</w> за диваном, ожидая возможности прыгнуть на игрушку."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>crouching</w> in the garden to plant the flowers.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>сидя на корточках</w> в саду, чтобы посадить цветы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crouching down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «приседать» или «сидеть на корточках»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сидящий на корточках",
                                "target_lang_sense_clarification": "описание позы человека или животного"
                            },
                            {
                                "target_lang_word": "приседающий",
                                "target_lang_sense_clarification": "процесс принятия позы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "278923ba-9482-3485-bc20-af2fa0c79d2f",
                    "sense_definition": "In a position where the body is bent low with the knees bent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crouching</w> figure remained perfectly still in the shadows of the alleyway.",
                            "target_lang_translations": {
                                "ru": "<w>Присевшая</w> фигура оставалась совершенно неподвижной в тени переулка."
                            }
                        },
                        {
                            "text": "She spotted a <w>crouching</w> animal hidden among the tall grass near the river.",
                            "target_lang_translations": {
                                "ru": "Она заметила <w>присевшее</w> животное, спрятавшееся в высокой траве у реки."
                            }
                        }
                    ],
                    "synonyms": [
                        "stooping"
                    ],
                    "antonyms": [
                        "standing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в положении, при котором тело низко опущено, а колени согнуты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присевший",
                                "target_lang_sense_clarification": "состояние человека или животного"
                            },
                            {
                                "target_lang_word": "согнувшийся",
                                "target_lang_sense_clarification": "описание позы с согнутыми коленями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c5df312-2ce2-3b37-b6dd-ebc6fbeb5300",
                    "sense_definition": "The act of bending low with the knees bent.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>crouchings</w> during the exercise routine made his knees feel quite sore.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>приседания</w> во время тренировки заставили его колени сильно болеть."
                            }
                        },
                        {
                            "text": "After many <w>crouchings</w> to inspect the floor, he finally found the lost ring.",
                            "target_lang_translations": {
                                "ru": "После множества <w>приседаний</w>, чтобы осмотреть пол, он наконец нашел потерянное кольцо."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в приседании или нахождении в согнутом положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приседание",
                                "target_lang_sense_clarification": "физическое действие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}