                    },
                    {
                        "translation_id": "f26e4859-a01e-4332-a308-2a2af2243b55",
                        "source_entry_id": "3c8f2e3e-0c86-3d86-9f9d-ca97b0e888c2",
                        "source_sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                        "source_sense_description": "Betrieb, der aus Ton Baumaterial (zum Beispiel Ziegel) brennt",
                        "target_lang_word": "briqueterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "briqueterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "123c5f51-d5ef-36d5-9574-4e06d450631e",
                                        "entry_id": "edcd0784-fa3d-350d-a231-b6b066f94337",
                                        "glosses": [
                                            "Lieu où on fait de la brique."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c0bf39-d92c-4df2-967c-0ce131a98f2e",
                                                "sense_id": "123c5f51-d5ef-36d5-9574-4e06d450631e",
                                                "text": "Emmène-les, Caralin, dit Bryne en se levant. Et quand tu les auras confiées à Joni, rejoins-moi à la briqueterie. (La lassitude du seigneur revint d’un seul coup.) Pour continuer à produire des briques, Thad Haren affirme avoir besoin de plus d’eau, et j’ignore où j’en trouverai…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd67876b-1720-3883-80f0-115715d4d00f",
                                        "entry_id": "edcd0784-fa3d-350d-a231-b6b066f94337",
                                        "glosses": [
                                            "Entreprise qui fabrique des briques ou des tuiles (tuilerie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b3584df-96e1-4089-a11b-f9ad0c012f33",
                                                "sense_id": "bd67876b-1720-3883-80f0-115715d4d00f",
                                                "text": "La briqueterie a été construite au milieu du XIXᵉ siècle par un châtelain fouriériste qui voulait procurer du travail aux habitants de Cémoy."
                                            },
                                            {
                                                "example_id": "ef96dbd6-ef94-4a5d-a31d-0fb2dfc8e3bf",
                                                "sense_id": "bd67876b-1720-3883-80f0-115715d4d00f",
                                                "text": "Si une briqueterie s’installe à Québec dès le début de la colonie, cette industrie se développe peu au cours de la première moitié du xviiiᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
