                "senses": [
                    {
                        "sense_id": "206a944e-ca90-3f88-8601-d25cddba0b54",
                        "entry_id": "022ea7b2-d4a1-3d1b-9e86-a6cfe446d8b3",
                        "glosses": [
                            "Tod, Sensenmann"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "d7881b99-c1e8-47aa-9c52-cbe41c46a923",
                                "sense_id": "206a944e-ca90-3f88-8601-d25cddba0b54",
                                "text": "„Quiqui ist der Tod.“"
                            },
                            {
                                "example_id": "3b393385-abdb-4b4a-a36e-984737dc33c7",
                                "sense_id": "206a944e-ca90-3f88-8601-d25cddba0b54",
                                "text": "„Ein maghrebinisches Wiegenlied mündet in eine alte sephardische Melodie. Echte Weana Bazi und der Quiqui, der Wiener Tod, treffen auf gefallene Engel und einen als Elvis getarnten Satan.“"
                            },
                            {
                                "example_id": "64690cbd-d804-4f1e-8cfe-8a1c8db01fe6",
                                "sense_id": "206a944e-ca90-3f88-8601-d25cddba0b54",
                                "text": "„Der unter Poelstras Kilmister-Oberfläche ist also jener, den man in Wien Quiqui heißt: der Gevatter, ohne den es zum Beispiel das Motörhead-Album Kiss of Death von 2006 nicht gäbe.“"
                            },
                            {
                                "example_id": "d2e0170d-a038-4186-aba2-872cbba6a937",
                                "sense_id": "206a944e-ca90-3f88-8601-d25cddba0b54",
                                "text": "„Nach anderslautender Theorie und mit größerer Wahrscheinlichkeit kommt der Quiqui ebenfalls aus dem Romanischen, aber vom Fragewort quisquis (sinngemäß: „wer auch immer“). Im fünften Casus, Lateinern als Vokativ (Anredefall) bekannt, wird der Quisquis zum Quiqui. Der Quiqui ist also die Anredeform des sensenschwingenden Unbekannten und darf im fürchterlichen Begegnungsfall mit „Wer auch immer Du bist!“ übersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
