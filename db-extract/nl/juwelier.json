                    {
                        "translation_id": "2b35d146-f2f1-4de5-b411-2f0ff6b22c22",
                        "source_entry_id": "914ba114-c377-3978-a0d5-19c816e743b9",
                        "source_sense_id": "6c3b0f27-0576-3380-af43-62b21ac6412b",
                        "source_sense_description": "iemand die juwelen vervaardigt en erin handelt",
                        "target_lang_word": "Juwelier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juwelier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                        "entry_id": "0f53a8f5-548c-35f3-844b-a9fc47e98c1e",
                                        "glosses": [
                                            "jemand, der teuren Schmuck verkauft"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf8350a1-27c1-4867-b3b5-daf69e3aacc3",
                                                "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                                "text": "Der Juwelier meinte, mein Ring sei eine Fälschung."
                                            },
                                            {
                                                "example_id": "7b7f148b-27cd-4f46-8f31-fcde5e805a53",
                                                "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                                "text": "„Ihr Vater, Herbert Schöning, arbeitete als Uhrmachermeister bei Juwelier Franzen in Monschau.“"
                                            },
                                            {
                                                "example_id": "6da3457e-c555-4a7c-b98c-e49d54f03dd2",
                                                "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                                "text": "„Signor Rinaldi lief sogleich hinunter, um einen Juwelier, einen Strumpfhändler, einen Schuhmacher und einen Parfümeur zu holen.“"
                                            },
                                            {
                                                "example_id": "629d97f4-ee74-41f8-b94f-09e1c335b695",
                                                "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                                "text": "„Ich passierte das Geschäft der Juweliere van Cleef und Arpels.“"
                                            },
                                            {
                                                "example_id": "0a996e94-feb8-48e8-a1bb-101f10f79cce",
                                                "sense_id": "2ba4e7bc-38af-35dc-b584-dfbf5bafee7e",
                                                "text": "„Später brachte Smoaks die Zähne nach Savannah zu einem Juwelier, wo er sie in echtes Silber fassen und zu Schlüsselketten verarbeiten ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4427a162-a06b-30cd-b653-354efe259e6c",
                                        "entry_id": "0f53a8f5-548c-35f3-844b-a9fc47e98c1e",
                                        "glosses": [
                                            "das Geschäft von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d660dcb-3d4d-4868-956a-c9d8453c818d",
                                                "sense_id": "4427a162-a06b-30cd-b653-354efe259e6c",
                                                "text": "„Später brachte Smoaks die Zähne nach Savannah zu einem Juwelier, wo er sie in echtes Silber fassen und zu Schlüsselketten verarbeiten ließ.“"
                                            },
                                            {
                                                "example_id": "ede0ba37-dba3-46b1-a3e5-62ad55d08430",
                                                "sense_id": "4427a162-a06b-30cd-b653-354efe259e6c",
                                                "text": "Ich war beim Juwelier und habe einen teuren Ring gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
