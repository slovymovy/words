                                        "entry_id": "476660ce-a067-34eb-befc-70fba00f3229",
                                        "glosses": [
                                            "A shrub of the genus Rosa, with red, pink, white or yellow flowers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f4c8090-5042-35f6-a1a1-4383bf9de7b8",
                                        "entry_id": "476660ce-a067-34eb-befc-70fba00f3229",
                                        "glosses": [
                                            "A flower of the rose plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ccfb15-444e-4f46-8e17-01d13dfc886a",
                                                "sense_id": "3f4c8090-5042-35f6-a1a1-4383bf9de7b8",
                                                "text": "Iu. 'Tis but thy name that is my Enemy:\nThou art thy ſelfe...\nWhat's in a name? That which we call a Roſe,\nBy any other word would ſmell as ſweete..."
                                            },
                                            {
                                                "example_id": "cf9f4052-810d-4235-b787-af25d1668a76",
                                                "sense_id": "3f4c8090-5042-35f6-a1a1-4383bf9de7b8",
                                                "text": "1794, Robert Burns, \"A Red, Red Rose:\"\nO my Luve's like a red, red rose\nThat's newly sprung in june..."
                                            },
                                            {
                                                "example_id": "b4075b01-2a36-449e-8c2e-5ed3f7e8d33f",
                                                "sense_id": "3f4c8090-5042-35f6-a1a1-4383bf9de7b8",
                                                "text": "Rose is a rose is a rose is a rose."
                                            }
                                        ]
                                    },
