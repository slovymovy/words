                    }
                ],
                "senses": [
                    {
                        "sense_id": "689b0884-6c5d-3738-809a-6aaa95da6d02",
                        "entry_id": "6b45b787-eb67-3530-9ba5-bdf42f3e2712",
                        "glosses": [
                            "The fortress in a city in North Africa or the Middle East."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a2059fc2-d8eb-38ad-b5e5-bb3a800287cf",
                        "entry_id": "6b45b787-eb67-3530-9ba5-bdf42f3e2712",
                        "glosses": [
                            "The medina, the older part of a city in North Africa or the Middle East."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa47ca8-06bc-49bc-8578-06ced8ca7bd1",
                                "sense_id": "a2059fc2-d8eb-38ad-b5e5-bb3a800287cf",
                                "text": "The king called up his jet fighters / He said, \"You better earn your pay / Drop your bombs between the minarets / Down the casbah way\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e2e85d3d-c3df-3d05-962f-b96efbd7ca68",
                        "entry_id": "6b45b787-eb67-3530-9ba5-bdf42f3e2712",
                        "glosses": [
                            "A person's house or flat/apartment."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "58f210e6-a3b2-4ae7-a832-d1c45bd80800",
                                "sense_id": "e2e85d3d-c3df-3d05-962f-b96efbd7ca68",
                                "text": "He gave me an earth-shattering kiss and whispered, “Come to my casbah and let me ply you with cupcakes.” […] We made good time getting to his apartment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e03bca-53ef-42fb-b122-76275fb438e6",
                        "source_entry_id": "6b45b787-eb67-3530-9ba5-bdf42f3e2712",
                        "source_sense_description": "the fortress in a city in North Africa or the Middle East",
                        "target_lang_word": "casbah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casbah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10ce2afb-3ba4-383b-b34a-7c42ec1cad9a",
                                        "entry_id": "19516afe-d78e-3147-bd78-0e010dbcf8fc",
                                        "glosses": [
                                            "Forteresse d’une ville du Maghreb ou du Levant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20387d6e-3aa8-42de-89c1-0e5686034de9",
                                                "sense_id": "10ce2afb-3ba4-383b-b34a-7c42ec1cad9a",
                                                "text": "Au programme de ce voyage familial (enfant à partir de 6 ans), une rando chamelière, des nuits sahariennes en bivouac au cœur des dunes, une autre dans une casbah traditionnelle dans la palmeraie de Skoura."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e36e72e9-6983-32cc-bae2-0baf6e08eb6a",
                                        "entry_id": "19516afe-d78e-3147-bd78-0e010dbcf8fc",
                                        "glosses": [
                                            "Médina, vieille-ville de ces villes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edee70ef-8e57-43d1-8b8b-f11c94006b4e",
                                                "sense_id": "e36e72e9-6983-32cc-bae2-0baf6e08eb6a",
                                                "text": "L’Angoulême noble cria contre l’introduction d’un giaour dans la casbah, car le salon de Mme de Bargeton était le cénacle d’une société pure de tout alliage."
                                            },
                                            {
                                                "example_id": "9c926810-4cab-4e8c-a3b2-001794443684",
                                                "sense_id": "e36e72e9-6983-32cc-bae2-0baf6e08eb6a",
                                                "text": "On avait choisi de les construire en parpaings : les blocs paraissaient posés, les uns sur les autres, et cela d’une façon si rectiligne, si froidement géométrique qu’on pouvait se demander si l’on n’avait pas voulu donner à l’ensemble une allure de casbah."
                                            },
                                            {
                                                "example_id": "d94beec7-ffa5-4af0-ba87-1e3753f90125",
                                                "sense_id": "e36e72e9-6983-32cc-bae2-0baf6e08eb6a",
                                                "text": "De ma fenêtre, je peux voir la misère urticante de la casbah, sa noirceur de rinçure et au bout la Méditerranée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5221e001-89f1-3f44-b9e6-a4459eeb8f2a",
                                        "entry_id": "19516afe-d78e-3147-bd78-0e010dbcf8fc",
                                        "glosses": [
                                            "Maison."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d5edf1c-33ce-4592-9469-c9f6e17907d8",
                        "source_entry_id": "6b45b787-eb67-3530-9ba5-bdf42f3e2712",
                        "source_sense_description": "the fortress in a city in North Africa or the Middle East",
                        "target_lang_word": "kasbah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
