                        "target_lang_word": "unbewegt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5a7d7d5e-8cac-47c4-bc60-caf705e43411",
                        "source_entry_id": "1edb0650-d3fc-3a99-8da7-4ed3f8937829",
                        "source_sense_id": "bb53119b-2cf5-3299-b7a6-dd5c19cf8e11",
                        "source_sense_description": "lacking emotion",
                        "target_lang_word": "gefühllos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gefühllos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                        "entry_id": "aa3962de-9395-310c-862e-d8efec1c52a4",
                                        "glosses": [
                                            "keinen Tastsinn habend"
                                        ],
                                        "tags": [
                                            "körperlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be7fd1aa-4ae6-4980-9b0f-25ea74e1559b",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Nach der Schneeballschlacht sind meine Hände ganz gefühllos."
                                            },
                                            {
                                                "example_id": "7417844f-33a6-4f7e-a34f-b6e1132b49ad",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Ich spüre meine Zehen vor Kälte nicht mehr, meine Füße sind komplett gefühllos."
                                            },
                                            {
                                                "example_id": "f656e207-cd3b-45df-a093-bd304d90985d",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Dabei ist vor allem darauf zu achten, dass die Zehen geschützt sind, da diese im regelmäßig sehr kalten Wasser schnell gefühllos werden."
                                            },
                                            {
                                                "example_id": "9ac76298-9251-476f-91f6-1b754b0d8db4",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Ich komme gerade vom Zahnarzt, nach der Betäubung ist meine rechte Gesichtshälfte ganz gefühllos."
                                            },
                                            {
                                                "example_id": "a5e72114-de47-4ab4-adcd-f092f57d50aa",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Die Lenkung des neuen XYZ-Autos ist schwammig und gefühllos."
                                            },
                                            {
                                                "example_id": "d3b99cef-0674-4a22-a1bb-b2247549e63a",
                                                "sense_id": "8dc86f0e-2d01-3acc-9976-f80337a6e8a0",
                                                "text": "Ich habe fünf Wochen kein Tischtennistraining mehr gehabt, ich spiele völlig gefühllos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                        "entry_id": "aa3962de-9395-310c-862e-d8efec1c52a4",
                                        "glosses": [
                                            "kein Mitgefühl habend, wenig von den Bedürfnissen anderer mitbekommend oder diese ausblendend"
                                        ],
                                        "tags": [
                                            "seelisch",
                                            "negative Konnotation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "015b4398-f5bd-49d7-a0d0-a155bb99a1c2",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Marianne wirft ihm [dem Schwiegervater] vor, gefühllos und abweisend zu sein."
                                            },
                                            {
                                                "example_id": "37ddbc47-ba61-4a26-82e8-9421bf54a39d",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "„Da bist du ja.“ Ihre Stimme hallte zu ihm herüber und wirkte dabei noch kühler, noch gefühlloser als sonst."
                                            },
                                            {
                                                "example_id": "3923ad08-3b4d-4dfe-a615-d4371f55857e",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Man muss nicht so gefühllos sein, sich nach drei Jahren von seiner Freundin per SMS zu trennen."
                                            },
                                            {
                                                "example_id": "b1f380eb-18fb-4f7e-9421-77acbfc6b498",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Unsere Wirtschaftsform ist, wie Marx es sah, unbarmherzig und zynisch, es zählt nur das nackte Interesse, nur die gefühllose 'bare Zahlung'."
                                            },
                                            {
                                                "example_id": "0d4a650d-2ea7-451a-b70a-70d705e78dfa",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Weihnachten [darf] nicht zu einem Fest werden, an dem man sich für Geschenke [abmüht], aber gegenüber Ausgegrenzten gefühllos [bleibt], sagte Papst Franziskus in der Christmette im Petersdom."
                                            },
                                            {
                                                "example_id": "aa0359f3-d244-4759-b5df-b7f2705b3204",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "[Ein 14-jährigen Tatverdächtiger war festgenommen worden.] Der Junge wurde bereits nach der Tat als Zeuge vernommen und zeigte sich damals gefühllos und abgeklärt."
                                            },
                                            {
                                                "example_id": "30f7fee7-657f-4ef7-aac6-95de92eb0cc5",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Vor Gericht hatte [Zdenek H.] sich gefühllos und ohne Reue gegeben."
                                            },
                                            {
                                                "example_id": "cb94e291-c90d-4c14-a00b-9a026827c850",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Hillary Clinton gilt als durchaus kompetent, aber berechnend und gefühllos."
                                            },
                                            {
                                                "example_id": "d7c56b17-fd61-45da-b94d-71ba21348951",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "„Dass [der britische Aussenminister] Boris Johnson diese Toten [der libyschen Stadt Sirte] für einen Witz hält, für eine bloße Unannehmlichkeit, bevor britische Unternehmen die Stadt in einen Badeort verwandeln können, ist unglaublich krass, gefühllos und grausam“, sagte [Emily Thornberry, Labour Party]."
                                            },
                                            {
                                                "example_id": "ad63e936-8672-4c0c-a887-a7d963a9bc3a",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "[Die britische Premierministerin Theresa] May wirkte gefühllos, abgehoben, ohne Verständnis für die wirklichen Anliegen der Menschen."
                                            },
                                            {
                                                "example_id": "a2fd1d45-2275-4e98-ba12-261ed1cb1628",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Frauen sind emotional klug und kümmern sich um andere, Männer sind Einzelgänger und gefühllos – diese Art von Vorurteilen zementieren toxische Rollenklischees."
                                            },
                                            {
                                                "example_id": "e6f1d2c0-2d98-4d5e-b5ee-ec45741e8822",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "Jede und jeder kann das [in unserer Gesellschaft] täglich erleben und manchmal auch erleiden: die Kluft zwischen Menschen, die sich gegenüber anderen respektvoll, freundlich, mitfühlend und in der Mehrheit auch solidarisch verhalten – und denen, die saugrob, ruppig, gefühllos, aggressiv auftreten."
                                            },
                                            {
                                                "example_id": "fb996451-a09c-476b-b2d4-2d448c63ac3e",
                                                "sense_id": "9b615f9f-8400-36d2-b20e-54b2364b79b6",
                                                "text": "[Ich sollte wegen meiner bipolaren Störung] jetzt ein Medikament wie Lithium nehmen, das [mich] unter eine Käseglocke verbannt, [mich] gefühllos macht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
