                        "sense_id": "3fa5a759-e669-3523-8bca-28ae55117b72",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to tighten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c97e33e-0c61-4d29-9d5b-f6e37a0fcee1",
                                "sense_id": "3fa5a759-e669-3523-8bca-28ae55117b72",
                                "text": "затя́гивать корсе́т",
                                "translation": "to lace/tighten up a corset/girdle",
                                "english": "to lace/tighten up a corset/girdle"
                            },
                            {
                                "example_id": "e4805ea1-a7b2-4e96-94df-9665b4b3baf3",
                                "sense_id": "3fa5a759-e669-3523-8bca-28ae55117b72",
                                "text": "затяну́ть га́йки",
                                "translation": "to tighten the screws (also figuratively)",
                                "english": "to tighten the screws (also figuratively)"
                            },
                            {
                                "example_id": "4ece1856-fb31-4a21-9f19-d414fdb5b4a7",
                                "sense_id": "3fa5a759-e669-3523-8bca-28ae55117b72",
                                "text": "затяну́ть по́яс",
                                "translation": "to tighten one's belt; to take one's belt in",
                                "english": "to tighten one's belt; to take one's belt in"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e0f0bc9-68d0-3521-8f19-28270c70c885",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to cover, to close"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf426c1-fc73-451f-b066-65e1e79fcffe",
                                "sense_id": "2e0f0bc9-68d0-3521-8f19-28270c70c885",
                                "text": "ра́ну затяну́ло",
                                "translation": "the wound is beginning to heal; the wound has skinned over [has closed]",
                                "english": "the wound is beginning to heal; the wound has skinned over [has closed]"
                            },
                            {
                                "example_id": "9d6fa2aa-ed3e-48ee-b79b-8e63caae3f00",
                                "sense_id": "2e0f0bc9-68d0-3521-8f19-28270c70c885",
                                "text": "Ра́ны, ра́ны, ра́ны затя́нет\nУ́тром ра́но, ра́но,\nРа́ны, ра́ны, ра́ны затя́нет\nУ́тром ра́но, ра́но"
                            }
                        ]
                    },
                    {
                        "sense_id": "9acc491f-ed7b-3eed-a648-9c5d4dd83d31",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to procrastinate, to delay, to drag out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14788d4d-eaff-46c9-ad76-8bff73f72a94",
                                "sense_id": "9acc491f-ed7b-3eed-a648-9c5d4dd83d31",
                                "text": "затяну́ть де́ло",
                                "translation": "to drag out a business",
                                "english": "to drag out a business"
                            },
                            {
                                "example_id": "cfa3bad3-0f28-4c38-bced-2f351771c39f",
                                "sense_id": "9acc491f-ed7b-3eed-a648-9c5d4dd83d31",
                                "text": "затяну́ть конфли́кт",
                                "translation": "to protract a conflict",
                                "english": "to protract a conflict"
                            }
                        ]
                    },
                    {
                        "sense_id": "1697ec95-8d0d-3167-9518-42b0dd2a5087",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to pull (into)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83332362-83fb-345b-9d07-47925b609791",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to drag (into), to suck (into), to suck (down), to engulf, to swallow up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52641f97-d15a-422c-bf54-150ef56d9927",
                                "sense_id": "83332362-83fb-345b-9d07-47925b609791",
                                "text": "лошаде́й затяну́ло в боло́то; боло́то затяну́ло лошаде́й",
                                "translation": "the horses were sucked down in the bog",
                                "english": "the horses were sucked down in the bog"
                            }
                        ]
                    },
                    {
                        "sense_id": "19f151d5-835c-3b2d-ae07-e3a2d732026c",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to swallow up, to absorb, to engross"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ba4120-6d73-4446-96cd-1eb972abb957",
                                "sense_id": "19f151d5-835c-3b2d-ae07-e3a2d732026c",
                                "text": "э́та кни́га про́сто затяну́ла меня́",
                                "translation": "this book really absorbed me",
                                "english": "this book really absorbed me"
                            }
                        ]
                    },
                    {
                        "sense_id": "915a0cf3-a27e-3722-978f-fa8d25f08e17",
                        "entry_id": "cb1a19fc-d3af-3ea9-b9dc-9ce5b3da39a3",
                        "glosses": [
                            "to start singing, to begin to harp (on)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b124acfe-1b12-4cef-9e07-845309744fec",
                                "sense_id": "915a0cf3-a27e-3722-978f-fa8d25f08e17",
                                "text": "затяну́ть ста́рую (свою́ обы́чную / люби́мую) пе́сню",
                                "translation": "to (begin to) harp on one's favourite/favorite tune",
                                "english": "to (begin to) harp on one's favourite/favorite tune"
                            },
                            {
                                "example_id": "5e4d760a-cb2c-4f2d-bdee-421bec911d43",
                                "sense_id": "915a0cf3-a27e-3722-978f-fa8d25f08e17",
                                "text": "Ло́шади меня́ мчат; изво́зчик мой затяну́л пе́сню, по обыкнове́нию зауны́вную.",
                                "translation": "The horses carry me quickly; my driver has started a song, as usual a melancholy one.",
                                "english": "The horses carry me quickly; my driver has started a song, as usual a melancholy one."
                            }
                        ]
                    }
