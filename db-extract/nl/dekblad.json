                                    {
                                        "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                        "entry_id": "2f8879f1-8bb8-3c92-b5be-ea1f419698c0",
                                        "glosses": [
                                            "A blank leaf at the front or back of a book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ffcd5e-8a1a-4c82-93c7-033fb2979c24",
                                                "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                                "text": "The flyleaf of Alice Walker's The Color Purple calls the book \"honest, poignant, laughing, defiant...a story about heroic lives, love, and the nature of god.... It breaks new ground in fiction with its portrayal of women.\""
                                            },
                                            {
                                                "example_id": "76b116e7-fbd2-4d8b-ae1d-f439c8cf55b3",
                                                "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                                "text": "The scribbles on the margins, the occasional date on the flyleaf, the faded bus ticket marking a page for a reason today mysterious, all try to remind me of who I was then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bf9384-080a-304b-8f49-29a16dc5a044",
                                        "entry_id": "2f8879f1-8bb8-3c92-b5be-ea1f419698c0",
                                        "glosses": [
                                            "A blank leaf at the front or back of a book.",
                                            "Especially, the free portion of an endpaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7900fb1f-e44c-48e2-ae95-193ad6be09a4",
                                                "sense_id": "c2bf9384-080a-304b-8f49-29a16dc5a044",
