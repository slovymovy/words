                "senses": [
                    {
                        "sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                        "entry_id": "b8e850d9-a3ae-3217-bf8e-95d20f29b8b8",
                        "glosses": [
                            "Lichtstrahl, der von einem Laser ausgesendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9369b6b0-9f5d-4929-bc35-db575349f845",
                                "sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                                "text": "Mit Laserstrahlen kann man sehr genau Entfernungen messen."
                            },
                            {
                                "example_id": "5c936ec3-d0aa-4246-ad94-051096b738bd",
                                "sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                                "text": "„Das Compact Laser Weapon System (CLWS) schießt die Fluggeräte einfach mit einem gezielten Laserstrahl ab.“"
                            },
                            {
                                "example_id": "45502a33-1644-4253-89f0-ddd09179cbd6",
                                "sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                                "text": "„Ein neues Kamerasystem macht sichtbar, wie ein Laserstrahl von einem Spiegel reflektiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58f7aa97-c7bc-4095-9bdd-6badf99a049b",
                        "source_entry_id": "b8e850d9-a3ae-3217-bf8e-95d20f29b8b8",
                        "source_sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                        "source_sense_description": "Technik: Lichtstrahl, der von einem Laser ausgesendet wird",
                        "target_lang_word": "laser beam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laser beam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68b1a6aa-6797-3d8a-bb9d-aed8aa5ac522",
                                        "entry_id": "46f072e7-42bb-396c-b7bb-59559a48e9ac",
                                        "glosses": [
                                            "The light emitted by a laser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2eb52f-659e-41aa-8e7e-7f8509ba01bf",
                                                "sense_id": "68b1a6aa-6797-3d8a-bb9d-aed8aa5ac522",
                                                "text": "Depending on whether the laser beam is defocused or focused, the CO₂ laser can perform two distinct therapeuteic functions."
                                            },
                                            {
                                                "example_id": "a7894522-6451-4191-8836-43ba3532ccc4",
                                                "sense_id": "68b1a6aa-6797-3d8a-bb9d-aed8aa5ac522",
                                                "text": "i hate old people man. “i was in the war” congratulations. i’m gonna be in the next one and they have laser beams now"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                        "entry_id": "46f072e7-42bb-396c-b7bb-59559a48e9ac",
                                        "glosses": [
                                            "A low, hard-hit or -thrown ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62768613-c54a-4223-b0c6-2a20f41a5044",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "Ramirez hit a laser beam home run into the right center field seats leading the 10th inning off Boston closer Ken Ryan"
                                            },
                                            {
                                                "example_id": "7f40f400-df5b-492b-9fea-9a297f0b2ed0",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "The batter hit a laser-beam to right field. A run for Cincinnati! Now the score was five to three."
                                            },
                                            {
                                                "example_id": "e7618133-39ab-4afa-a431-15c157cf077d",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "When in doubt, so I threw my best fastball. Mantle hit a laser beam past my right knee."
                                            },
                                            {
                                                "example_id": "cef8bc9d-d8d1-4d42-b592-f84b003cef5f",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "The way he warmed up his famous arm by throwing laser beams out of a sleepy, feline half-windup to some bullpen lackey armed with the added protection of a catcher's mitt."
                                            },
                                            {
                                                "example_id": "8ff3a46e-0fde-46c6-8c73-94582babb17e",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "Just as he finished that sentence, Evan Longoria hit a laser beam over the left field fence. The Red Sox season was over in a flash."
                                            },
                                            {
                                                "example_id": "a13943b2-efe7-473b-bec2-58f1c1868c82",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "One reason the rookies weren't catching too many was that Bradshaw was throwing laser beams."
                                            },
                                            {
                                                "example_id": "c3e06c9d-7fc2-4299-afd9-86d6949d515e",
                                                "sense_id": "07dd29a7-9ba0-30fa-b281-d559fea8da29",
                                                "text": "The Bloomer Girls played a respectable brand of baseball, to be sure, but they didn't throw 350-foot laser beams from deep center, or chew Red Man during ballgames."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddea0ecf-89f1-4212-8d98-1ec7c22f3b94",
                        "source_entry_id": "b8e850d9-a3ae-3217-bf8e-95d20f29b8b8",
                        "source_sense_id": "c6645634-b499-3736-80a2-e9b5335fab0e",
                        "source_sense_description": "Technik: Lichtstrahl, der von einem Laser ausgesendet wird",
                        "target_lang_word": "rayon laser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rayon laser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ed7889-8e22-3643-a760-33c083bd00b4",
                                        "entry_id": "33480a9c-ff47-3e05-b391-235eced4af55",
                                        "glosses": [
                                            "Rayon lumineux produit par un laser."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "774d1aa7-e6eb-4a3a-8666-a529ce0cd0a6",
                                                "sense_id": "b5ed7889-8e22-3643-a760-33c083bd00b4",
                                                "text": "La focalisation d’un rayon laser permet d’élever la température d’une zone réduite de matière, jusqu’à vaporisation. La puissance d’un laser varie en fonction du matériau à découper et de son épaisseur. La zone affectée thermiquement (ou ZAT) par le rayon laser est relativement faible, ce qui explique le peu de déformation subi par les pièces découpées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
