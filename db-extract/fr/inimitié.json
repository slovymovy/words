                                "target_senses": [
                                    {
                                        "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A state of long-standing mutual hostility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff1dda1-4c11-4eb4-aee0-1486a785dab7",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "You couldn't call it a feud exactly, but there had always been a chill between Phil Mickelson and Tiger Woods."
                                            },
                                            {
                                                "example_id": "0877e12c-6904-43ae-af7f-27dd4bb441f5",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "Mr. Cumming’s Dionysus in “The Bacchae” is conceived as a rock star, the rhythm-and-blues Maenads as his backup singers and groupies, and his feud with his cousin Pentheus, king of Thebes, as an encounter of the hedonistic, ambigendered, exotic Other, with “the fear of letting that into your culture,” Mr. Tiffany said."
                                            },
                                            {
                                                "example_id": "c933c749-14a6-4775-8e27-4d05a517e205",
                                                "sense_id": "81c0480f-51d9-3cc8-864d-263010489880",
                                                "text": "The feuds between Namsang and Borduria continued. In 1875-76 the dispute between the Namsang and Borduria arose about the buffaloes which were carried off by Borduria people from Namsang areas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425c3fce-7218-377b-a765-6466458a4c7f",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A staged rivalry between wrestlers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e678f50-4819-378a-9794-35478d41f5f9",
                                        "entry_id": "99c26bfb-e4cc-3086-8d88-55619aa6e521",
                                        "glosses": [
                                            "A combination of kindred to avenge injuries or affronts, done or offered to any of their blood, on the offender and all his race."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "feud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                        "entry_id": "afc0884b-f58a-371f-8478-09eefac4b533",
                                        "glosses": [
                                            "To carry on a feud."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa20f013-2cc8-44d8-80b2-0c8fae9c4867",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "The two men began to feud after one of them got a job promotion and the other thought he was more qualified."
                                            },
                                            {
                                                "example_id": "f423c17c-01ef-43df-8760-1f0745808f35",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "As a result of the heel turn, [Riki] Choshu was instantly elevated as a headliner and feuded with [Tatsumi] Fujinami in main events for two years over the WWF [World Wrestling Federation] International Heavyweight strap."
                                            },
                                            {
                                                "example_id": "bf8eeec0-6627-416d-8940-0354292bee4c",
                                                "sense_id": "3c1457f2-27bb-30ad-955b-b64c5426a487",
                                                "text": "Don’t look back in anger—Oasis, the prodigal sons of Brit-pop, is returning. After years of public feuding and subtweets and alleged battery with a cricket bat, the Gallagher brothers—Liam and Noel, obvs—are working it out on the remix, with a rash of 2025 summer dates announced on their website."
                                            }
                                        ]
                                    }
                                ]
