                "senses": [
                    {
                        "sense_id": "ee7a5906-0140-37ee-bfa1-86fab5dd8cda",
                        "entry_id": "7e27b8f5-6d37-3de6-ab65-738536660940",
                        "glosses": [
                            "Transfuser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15d04b2-f41d-49a8-9a2b-02f4ec3a7042",
                                "sense_id": "ee7a5906-0140-37ee-bfa1-86fab5dd8cda",
                                "text": "Pour obtenir ce résultat, il faut continuer à soustraire du sang dans un premier temps, puis au contraire en retransfuser dans un deuxième temps."
                            },
                            {
                                "example_id": "3a135a65-badb-4cdb-9f93-53ff9334a9bc",
                                "sense_id": "ee7a5906-0140-37ee-bfa1-86fab5dd8cda",
                                "text": "Le sang ainsi soustrait est conservé dans un récipient connecté à la veine du malade ; on a la possibilité de le retransfuser à tout moment."
                            }
                        ]
                    }
