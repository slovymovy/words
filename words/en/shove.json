                        "cs": [
                            {
                                "target_lang_word": "strkat",
                                "target_lang_sense_clarification": "opakované nebo hrubé tlačení"
                            },
                            {
                                "target_lang_word": "postrčit",
                                "target_lang_sense_clarification": "jednorázové silné strčení"
                            },
                            {
                                "target_lang_word": "odstrčit",
                                "target_lang_sense_clarification": "odsunutí někoho silou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d852aa0-c379-3ed4-b8ad-f0066d4c6ecc",
                    "sense_definition": "To put something into a space quickly, carelessly, or roughly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>shoved</w> the dirty clothes under the bed before her mother came in.",
                            "target_lang_translations": {
                                "ru": "Она <w>запихнула</w> грязную одежду под кровать, пока не вошла мама.",
                                "zh": "妈妈进来前，她把脏衣服<w>硬塞</w>到了床底下。",
                                "cs": "Než přišla matka, <w>nacpala</w> špinavé oblečení pod postel."
                            }
                        },
                        {
                            "text": "I just <w>shoved</w> the receipt into my pocket without looking at it.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>сунул</w> чек в карман, не глядя на него.",
                                "zh": "我连看都没看，就把收据<w>塞</w>进了口袋。",
                                "cs": "Prostě jsem <w>zastrčil</w> účtenku do kapsy, aniž bych se na ni podíval."
                            }
                        }
                    ],
                    "synonyms": [
                        "stuff",
                        "cram",
                        "jam",
                        "stick",
                        "squeeze"
                    ],
                    "common_phrases": [
                        "shove into",
                        "shove in"
                    ],
