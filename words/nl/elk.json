            "senses": [
                {
                    "sense_id": "ebf9c501-3464-3c86-b3bf-c5eaceb5fe2e",
                    "sense_definition": "elk exemplaar van een groep afzonderlijk beschouwd",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga <w>elke</w> dag even naar het park om te wandelen.",
                            "target_lang_translations": {
                                "en": "I go to the park <w>every</w> day for a short walk.",
                                "ru": "Я хожу в парк <w>каждый</w> день немного погулять."
                            }
                        },
                        {
                            "text": "In <w>elke</w> kamer van het huis hangt een rookmelder.",
                            "target_lang_translations": {
                                "en": "There is a smoke detector in <w>every</w> room of the house.",
                                "ru": "В <w>каждой</w> комнате дома висит датчик дыма."
                            }
                        }
                    ],
                    "synonyms": [
                        "ieder"
                    ],
                    "common_phrases": [
                        "elke dag",
                        "elk jaar",
                        "elke keer"
                    ],
                    "target_lang_definitions": {
                        "en": "each instance of a group considered separately",
                        "ru": "каждый экземпляр из группы, рассматриваемый в отдельности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "every",
                                "target_lang_sense_clarification": "all members of a group"
                            },
                            {
                                "target_lang_word": "each",
                                "target_lang_sense_clarification": "every individual item separately"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "любой из группы"
                            },
                            {
                                "target_lang_word": "всякий",
                                "target_lang_sense_clarification": "любой без исключения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "215aed8d-8af0-3f6c-8157-53fb951d4359",
                    "sense_definition": "alle personen in een groep afzonderlijk",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Melk is goed voor <w>elk</w> zegt het oude gezegde.",
                            "target_lang_translations": {
                                "en": "Milk is good for <w>everyone</w>, says the old proverb.",
                                "ru": "Молоко полезно для <w>каждого</w>, гласит старая поговорка."
                            }
                        },
                        {
                            "text": "In dit spel komt <w>elk</w> op zijn beurt aan de beurt.",
                            "target_lang_translations": {
                                "en": "In this game, <w>each</w> person gets their turn.",
                                "ru": "В этой игре <w>каждый</w> ходит в свою очередь."
                            }
                        }
                    ],
                    "synonyms": [
                        "ieder",
                        "iedereen"
                    ],
                    "common_phrases": [
