                "senses": [
                    {
                        "sense_id": "8a20e6a0-efee-3b0a-bf3e-2a2cbaf0ed6b",
                        "entry_id": "86b22c5d-f816-3dbc-84af-a07c56c2f64a",
                        "glosses": [
                            "Verpackung aus Plastik/Kunststoff, zumeist in Form eines Quaders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a32639-bb36-4604-b02b-12f00e1cbcb0",
                                "sense_id": "8a20e6a0-efee-3b0a-bf3e-2a2cbaf0ed6b",
                                "text": "„Er wollte gerade nach der Kunststoffschachtel mit dem Essen greifen, als Vater sich grunzend umdrehte.“"
                            },
                            {
                                "example_id": "5d92ee69-2137-481e-99f8-7d9d2794661d",
                                "sense_id": "8a20e6a0-efee-3b0a-bf3e-2a2cbaf0ed6b",
                                "text": "„Ein Verpackungshersteller liefert Kunststoffschachteln für das Verpacken von Lebensmitteln.“"
                            },
                            {
                                "example_id": "7559e79b-41d3-45e1-b74c-1876561f31fc",
                                "sense_id": "8a20e6a0-efee-3b0a-bf3e-2a2cbaf0ed6b",
                                "text": "„Etwas Brot kaufte ich auch und die in Kunststoffschachteln eingepackten Sandwichs, die sich länger frisch hielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
