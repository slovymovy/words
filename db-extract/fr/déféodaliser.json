                "senses": [
                    {
                        "sense_id": "a8eac091-7465-3c9f-834c-00a66865dc3f",
                        "entry_id": "ce5decfd-74a4-3d57-8ef1-355237ff5614",
                        "glosses": [
                            "Faire perdre son caractère féodal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c250fd00-0980-4e9f-a6f5-1fab5dafe08b",
                                "sense_id": "a8eac091-7465-3c9f-834c-00a66865dc3f",
                                "text": "On rappelle, à ce propos, un vieux bruit d’après lequel certains zélés de l’époque révolutionnaire auraient entrepris de « déféodaliser » l’impertinent castel."
                            },
                            {
                                "example_id": "b0b0636e-8dee-4629-9280-043c7d54833a",
                                "sense_id": "a8eac091-7465-3c9f-834c-00a66865dc3f",
                                "text": "Cette africanisation doit s’inspirer du souci de « déféodaliser » nos institutions : car le peuple ruandais a condamné le colonialisme de quelque couleur qu’il soit."
                            },
                            {
                                "example_id": "8ad60118-f27c-4fa5-8b1f-5a0c9064cdee",
                                "sense_id": "a8eac091-7465-3c9f-834c-00a66865dc3f",
                                "text": "L’économie mouride doit encore se déféodaliser pour que s’annonce un processus authentique de socialisation."
                            }
                        ]
                    }
                ],
