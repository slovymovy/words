                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "6d76602e-69d7-4106-bff4-a0390cb00bee",
                                "sense_id": "d9a900b7-0027-3185-be19-06d829904beb",
                                "text": "Czarne wstążki umieszczaliśmy na antenach samochodów, niektórzy przypinali do ubrań białe lub czarne kokardki – znak żałoby, a w dzień pogrzebu w godzinę śmierci Papieża zgasiliśmy światła"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
