                                "target_lang_sense_clarification": "participio passato di accartocciare"
                            },
                            {
                                "target_lang_word": "sgualcito",
                                "target_lang_sense_clarification": "participio passato di sgualcire"
                            },
                            {
                                "target_lang_word": "accartocciò",
                                "target_lang_sense_clarification": "passato remoto: strinse in una palla"
                            },
                            {
                                "target_lang_word": "si accartocciò",
                                "target_lang_sense_clarification": "passato remoto: si deformò per un impatto"
                            }
