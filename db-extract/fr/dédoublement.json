        "fr-extract.jsonl": [
            {
                "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                "word": "dédoublement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1cbf1bcf-b43f-47b6-bea5-81fb52c9b429",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "dédoublements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9946bdaa-5d8c-31bd-8e52-8e1c9252330d",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "glosses": [
                            "Action de dédoubler ou état de ce qui est dédoublé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18422a18-9362-480b-b351-46406ef789ef",
                                "sense_id": "9946bdaa-5d8c-31bd-8e52-8e1c9252330d",
                                "text": "Y avait-il en elle ce même dédoublement de tendresse qu’en moi, ce même trouble voluptueux de choses familiales et d’idées amoureuses ?"
                            },
                            {
                                "example_id": "ac3539eb-cf7a-45b6-a59a-2d211cb32d2e",
                                "sense_id": "9946bdaa-5d8c-31bd-8e52-8e1c9252330d",
                                "text": "J’entendais la respiration égale d’un dormeur : c’était la mienne et je me voyais dans mon lit, par un dédoublement inexplicable."
                            },
                            {
                                "example_id": "2b823863-dd23-48a7-816f-88d4fc5fd1e8",
                                "sense_id": "9946bdaa-5d8c-31bd-8e52-8e1c9252330d",
                                "text": "Pour la plupart des gens, la schizophrénie, c’est le dédoublement de la personnalité."
                            },
                            {
                                "example_id": "50062b79-9ee4-4ee7-8a90-673fa3a585a2",
                                "sense_id": "9946bdaa-5d8c-31bd-8e52-8e1c9252330d",
                                "text": "« Chez nous, 40 écoles comptent plus de 20 classes. Le dédoublement des classes en CP, CE1, grande section en éducation prioritaire ne peut se faire par manque de place », note aussi Bechir Ben Hamouda, secrétaire départemental du FSU-SNUipp à La Réunion."
                            }
                        ]
                    },
                    {
                        "sense_id": "960238dd-2ed2-370c-b9bd-259c2769bf99",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "glosses": [
                            "Division d’un ensemble en deux lots identiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c5422b-461c-45f4-9e04-b033abb1f522",
                                "sense_id": "960238dd-2ed2-370c-b9bd-259c2769bf99",
                                "text": "Le dédoublement des chromosomes durant la méiose est responsable de la transmission des gènes du père à l’enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8b698d8-82b2-3dcc-883f-e4e52c29e793",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "glosses": [
                            "Réduction d’une substance composée en deux autres substances moins composées."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "07cd0d4e-dc67-34e9-a8af-a0142063b5c1",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "glosses": [
                            "Séparation de deux substances mélangées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "141da3f0-309f-4da2-82cc-09dc1c41ee6a",
                                "sense_id": "07cd0d4e-dc67-34e9-a8af-a0142063b5c1",
                                "text": "Procéder au dédoublement d’un racémique."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8bcf55c-7ce1-3626-b5d9-ea6c85f47b3d",
                        "entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "glosses": [
                            "Incapacité du contrôleur d'un périphérique à matrice (un clavier, le plus souvent) à déterminer quelles touches sont enfoncées lorsqu'au moins trois le sont en même temps. Il en résulte soit une mauvaise décision du contrôleur (ordonnant par exemple l'affichage d'un z à la place d'une s), soit le rejet des entrées incomprises (souvent associé à un signal sonore). Ghosting."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae9051e-fd69-4925-a4b2-f680033ef02f",
                        "source_entry_id": "1f8d8b62-e1da-36e1-862c-7dc34cb67fb2",
                        "source_sense_description": "Action de dédoubler",
                        "target_lang_word": "Verdoppelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdoppelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee4c778-2ded-3ce9-a680-597a6a58239b",
                                        "entry_id": "c7509dd7-14a3-3b16-bb01-676996caa9f5",
                                        "glosses": [
                                            "eine Erhöhung oder Vergrößerung auf das Zweifache (= Doppelte) des Ursprünglichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64dd1a27-0b41-454a-a726-566e7efd8de2",
                                                "sense_id": "1ee4c778-2ded-3ce9-a680-597a6a58239b",
                                                "text": "Der Schutzwall hat eine Verdoppelung der Dicke nötig, damit er effektiv gegen das Hochwasser wirkt."
                                            },
                                            {
                                                "example_id": "894c3447-f2bc-4bea-ae85-3b9f075cbbea",
                                                "sense_id": "1ee4c778-2ded-3ce9-a680-597a6a58239b",
                                                "text": "Eine Verdoppelung meines Gehaltes könnte mich zum Bleiben überreden."
                                            },
                                            {
                                                "example_id": "a1597c0f-1c6e-4043-b49c-29468ec90773",
                                                "sense_id": "1ee4c778-2ded-3ce9-a680-597a6a58239b",
                                                "text": "„Dieser Tatbestand steht auch in Korrelation mit der Empfindung einer Verdoppelung, der der Dichter unterworfen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "279be6ed-43a6-4628-aac7-e193cd7202cc",
