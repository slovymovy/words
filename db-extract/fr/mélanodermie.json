                        "entry_id": "b97f0d32-ee06-33b6-86bc-c56ac5fbeda9",
                        "glosses": [
                            "Coloration foncée naturelle chez les populations noires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "695a32c9-3d03-4aee-8cf7-ffd06c1387a8",
                                "sense_id": "e8f6c2ca-95e1-3b67-a54b-ff0287bbda4e",
                                "text": "Des tests de mélanine sur des échantillons de peau de momies égyptiennes permettraient, selon Cheikh Anta Diop, de confirmer les récits des auteurs grecs anciens sur la mélanodermie des anciens Égyptiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0f898eb-7289-321b-833c-a74cd5f7b288",
                        "entry_id": "b97f0d32-ee06-33b6-86bc-c56ac5fbeda9",
                        "glosses": [
                            "Hyperpigmentation de la peau due à la mélanine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea44fc89-8376-4e11-b119-750cb841fd74",
                                "sense_id": "c0f898eb-7289-321b-833c-a74cd5f7b288",
                                "text": "La maladie d'Addison se traduit notamment par une asthénie, une hypotension artérielle, un amaigrissement et une mélanodermie au niveau des points de frottement et des muqueuses due à l'origine commune des voies de contrôle de la mélanogenèse."
                            }
                        ]
                    }
