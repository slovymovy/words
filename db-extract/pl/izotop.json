                        ]
                    },
                    {
                        "translation_id": "d0321e5b-e16f-495d-a67b-c9eedc0c66de",
                        "source_entry_id": "1e82f918-5f56-333b-bed6-6f5ea69473e0",
                        "source_sense_id": "ee2cc76a-f630-3f7e-8bde-d100261b9458",
                        "target_lang_word": "isotope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isotope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                        "entry_id": "326db578-5efb-3637-baa9-aacb80254d65",
                                        "glosses": [
                                            "Élément chimique ayant un même nombre de protons que l’élément chimique de référence, donc une même « place » dans le tableau périodique des éléments, mais un nombre de neutrons différent."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8498dd08-5d3f-49f7-8577-06f137c370e8",
                                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                                "text": "Il y a là un exemple de « transmutation avec capture » donnant lieu à la production d’un isotope d’oxygène de masse 17."
                                            },
                                            {
                                                "example_id": "0fa81527-fdd2-42c5-ac0a-67b8fc1c1221",
                                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                                "text": "Nous avons déjà vu que les procédés de détection des isotopes sont suffisamment sensibles pour permettre des dilutions très considérables de l'élément marqué."
                                            },
                                            {
                                                "example_id": "5667dcd6-662c-4b2a-8987-658e414511a4",
                                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                                "text": "Il y a là un exemple de « transmutation avec capture » donnant lieu à la production d’un isotope d’oxygène de masse 17."
                                            },
                                            {
                                                "example_id": "384e32ae-82f0-4a31-82cd-872056ddb34f",
                                                "sense_id": "9e95838d-1c30-3e07-81ad-ed86aed8d982",
                                                "text": "Selon ce maître de conférences en sciences des planètes, l'instrument \"donne une connaissance inédite des isotopes de l'eau dans l'atmosphère de Mars en fonction à la fois du temps et de leur localisation\" sur la planète, …\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isotope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8f2ed4-67fd-3d28-a14b-16f49c42b0b5",
                                        "entry_id": "19c2d8cb-3d26-3a6a-91a1-64423a756156",
                                        "glosses": [
                                            "Qui a les caractéristiques chimiques ou physiques d’un isotope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84ce69f-66ef-4f5b-b145-a50d5ed27189",
                                                "sense_id": "5f8f2ed4-67fd-3d28-a14b-16f49c42b0b5",
                                                "text": "Les carbone-12 et carbone-13 sont des éléments chimiques isotopes stables, alors que le carbone-14 en est un radio-isotope naturel."
                                            },
                                            {
                                                "example_id": "71a52677-2132-42ab-8734-a8f617fcc2ec",
                                                "sense_id": "5f8f2ed4-67fd-3d28-a14b-16f49c42b0b5",
                                                "text": "Enfin les cas comme celui du chlore (masse atomique 35,5) où un écart important existe avec un multiple entier de l’hydrogène semblent devoir s’expliquer par l’existence d’un mélange d’éléments isotopes doués des mêmes propriétés chimiques mais de masses atomiques différentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15049b0d-158f-47b3-8935-fd470a8c85e6",
                        "source_entry_id": "1e82f918-5f56-333b-bed6-6f5ea69473e0",
                        "source_sense_id": "ee2cc76a-f630-3f7e-8bde-d100261b9458",
                        "target_lang_word": "isótopo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isótopo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e8114294-67eb-3820-a8b8-848a2c9c4007",
                                        "entry_id": "bb4e6163-e571-3454-bff3-cabfeb463601",
                                        "glosses": [
                                            "Cada una de las especies de átomos de un elemento químico que poseen el mismo número atómico y distinto número másico."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec3321b-f181-4ca8-bac5-7e1b4a005615",
                                                "sense_id": "e8114294-67eb-3820-a8b8-848a2c9c4007",
                                                "text": "el uranio está constituído por tres isótopos: el de peso atómico 238, que entra en la proporción de 99'3 %; el de peso atómico 235, en la proporción de 0'7 %, y el de peso atómico 234, en la proporción de 0'0006 %. El isótopo causante de la emisión intensa y difusora es el uranio 235. El isótopo más pesado, el uranio 238, que importa el 99'3 % de la mezcla, también absorbe los neutrones; pero, por una razón inexplicable, en lugar de dividirse en fragmentos atómicos con una fuerte liberación de energía, retiene los neutrones y emite el exceso de energía en forma de rayos gamma duros."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b344437-2d34-4dd7-8ade-a9cddc66387c",
                        "source_entry_id": "1e82f918-5f56-333b-bed6-6f5ea69473e0",
                        "source_sense_id": "ee2cc76a-f630-3f7e-8bde-d100261b9458",
                        "target_lang_word": "Isotop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isotop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8bff777-f11c-355d-92b5-f796955489fa",
                                        "entry_id": "0f200096-924f-390e-9a60-3ac8ced949bb",
                                        "glosses": [
                                            "Variante eines Atoms, mit gleicher Protonenzahl, aber mit verschiedener Neutronenzahl im Atomkern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880412ad-7586-4534-9412-da02a01fb34f",
                                                "sense_id": "b8bff777-f11c-355d-92b5-f796955489fa",
                                                "text": "Das Element Wasserstoff (H) hat drei Isotope: ¹H (Protium) ohne Neutron, Deuterium mit einem Neutron und Tritium mit zwei Neutronen, jeweils mit einem Proton."
                                            },
                                            {
                                                "example_id": "f43de4e2-e53a-4da3-bc46-a9c1cc14468c",
                                                "sense_id": "b8bff777-f11c-355d-92b5-f796955489fa",
                                                "text": "„Was ihm half, sein fünftes und sechstes Lebensjahrzehnt zu überstehen, waren seine Frau Claire, seine zwei Kinder und sein neues Forschungsgebiet: die Anwendung von radioaktiven Isotopen bei der Therapie bösartiger Krankheiten.“"
                                            }
                                        ],
