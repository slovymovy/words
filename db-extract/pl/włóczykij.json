                "senses": [
                    {
                        "sense_id": "9af644c2-a486-34fb-b775-89070d523cab",
                        "entry_id": "c895d659-5ff1-365a-b5d9-2c494aed282a",
                        "glosses": [
                            "człowiek lubiący się włóczyć"
                        ],
