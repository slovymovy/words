                        "source_sense_description": "so shocked as to be unable to speak",
                        "target_lang_word": "sprachlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprachlos",
