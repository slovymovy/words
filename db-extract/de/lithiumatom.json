                ],
                "senses": [
                    {
                        "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                        "entry_id": "11dfe5b6-7035-3e99-814d-b43120625d1b",
                        "glosses": [
                            "Atom des Lithiums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0116be49-ba62-449f-83a0-fcfd53b16c8a",
                                "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                                "text": "„Treffen die bei der Fusion frei gewordenen Neutronen auf Lithiumatome, so entstehen dabei Tritium und Helium.“"
                            },
                            {
                                "example_id": "6e8d363b-1c35-434b-b7dc-b6b3df517064",
                                "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                                "text": "„Wegen der Ordnungszahl 3 handelt es sich also um ein Lithiumatom.“"
                            },
                            {
                                "example_id": "834e4ef9-a99a-42b8-8295-162700f9da1b",
                                "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                                "text": "„Das neue Material ist schwierig herzustellen, aber attraktiv: ‚Während bisher zur Speicherung von einem Lithiumatom etwa sechs Kohlenstoffatome nötig waren, sind es nun nur noch drei bis vier‘, so Müllen.“"
                            },
                            {
                                "example_id": "0d221462-2078-43a9-93ab-58c6d73306e1",
                                "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                                "text": "„Lithiumatome geben bereitwillig ein Elektron ab und können daher einen großen Strom erzeugen.“"
                            },
                            {
                                "example_id": "f3c9271e-8b2e-456b-ad73-4274321263bc",
                                "sense_id": "9b757c67-85f4-32d6-92c6-b5253007cc98",
                                "text": "„Die Wissenschaftler, darunter auch Forscher vom Max-Planck-Institut für Festkörperforschung in Stuttgart, präparierten auf einer Unterlage aus Siliziumkarbid eine Monolage Graphen und schieden darauf dosiert Lithiumatome ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
