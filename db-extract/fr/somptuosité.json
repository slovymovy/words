                                "target_senses": [
                                    {
                                        "sense_id": "0af21a36-7596-385a-8fbd-89a8611e2493",
                                        "entry_id": "be89b177-fb8a-3275-81c7-9581b3e87c69",
                                        "glosses": [
                                            "The state or quality of being sumptuous; wealth; high price"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aeaf8ee-e614-4363-93c0-9dc59a55c348",
                                                "sense_id": "0af21a36-7596-385a-8fbd-89a8611e2493",
                                                "text": "Macedon may justly be called to witness, who found more cities and sumptuosity in that little kingdom of Porus[…] than in all his other travels and undertakings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
