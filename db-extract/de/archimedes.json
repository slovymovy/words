                            {
                                "example_id": "de53d557-875d-46ee-b637-1867e8c83a4d",
                                "sense_id": "b010b044-246d-3990-810c-d68cc0218b75",
                                "text": "„›Heureka, ich hab’s gefunden!‹ Splitternackt, offensichtlich aus dem Bad gesprungen, läuft Archimedes durch die Straßen von Syrakus und ruft voll Freude: ›Heureka, ich hab’s gefunden!‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
