                    "sense_definition": "To lay siege to a town or fortress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered his troops to <w>invest</w> the city and cut off supplies.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал своим войскам <w>осадить</w> город и перекрыть поставки.",
