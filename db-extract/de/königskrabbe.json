                                            {
                                                "example_id": "d90834ae-dc8e-4583-b7a7-23518974a4b7",
                                                "sense_id": "24a8199c-eabd-3813-a185-3a965d6800f4",
                                                "text": "Ook de uit de kluiten geschoten neef van de wolhandkrab komt langs in de Klootwijks keet. Het is de koningskrab, afkomstig uit de zeeën rond de Noordpool en hier ook bekend van de eindeloos op Discovery Channel uitgezonden serie Deadliest Catch. Deze joekels kunnen naar een spanwijdte van bijna twee meter groeien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b7d91d-3c54-3071-a8ed-11f372fab598",
