                    {
                        "form_id": "246cb562-953b-402c-a9ac-7a113886b83d",
                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Zofe"
                    },
                    {
                        "form_id": "c768c261-41a6-480e-a876-6b97c89ccc73",
                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zofen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                        "glosses": [
                            "Bedienstete einer vornehmen, höhergestellten Dame, Herrin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7343627a-6b15-4c18-b2f1-3f92c45a206e",
                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                "text": "„Eine Zofe, ebenfalls im historischen Kostüm, bringt frisch geräucherte Forellen.“"
                            },
                            {
                                "example_id": "7c958ba5-1cfb-4940-85a2-ffc4981b10fb",
                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                "text": "„Natürlich hatte die Gräfin außer dem Butler noch anderes Personal: Zimmermädchen, Koch, Köchin, Gärtner, Zofe, Chauffeur.“"
                            },
                            {
                                "example_id": "c058ca1e-aaab-4ead-b105-544be056e8f4",
                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                "text": "„Bald darauf bemerkte er, wie die kleine Zofe Lenzfreude in der Dunkelheit die Mauer erkletterte und scheinbar die Katze rief.“"
                            },
                            {
                                "example_id": "5827404a-edd4-42fe-b9f8-70ebbee8a41a",
                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                "text": "„Die kleine Fürstin erhob sich aus ihrem Lehnstuhl, läutete nach der Zofe und begann flink und vergnügt einen Plan für die Toilette der Prinzessin Marja zu entwerfen und auszuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2987b0d9-5335-4e43-b1a3-a4cec643f753",
                        "source_entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                        "source_sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                        "source_sense_description": "Bedienstete einer vornehmen, höhergestellten Dame, Herrin",
                        "target_lang_word": "lady's maid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lady's maid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                        "entry_id": "8f176b96-b36e-3532-9865-ea49ef634094",
                                        "glosses": [
                                            "A female servant employed by an upper-class woman to attend to her personal needs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533410ed-7b8e-43a2-ba6a-c58cde953577",
                                                "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                                "text": "A pretty Girl, the Lady’s Maid,\nWho all her Dress in Order Laid,\nBehind her Mistress simp’ring stood,\nAnd rais’d the youthful ’Squires Blood."
                                            },
                                            {
                                                "example_id": "35b915c2-75bd-4d82-bc5e-950630974cc6",
                                                "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                                "text": "He stopped, ran his eye over my dress, which, as usual, was quite simple: a black merino cloak, a black beaver bonnet; neither of them half fine enough for a lady’s-maid."
                                            },
                                            {
                                                "example_id": "7796b2a6-6deb-49d0-950f-ec17fa997280",
                                                "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                                "text": "[…] the servant, a neat, plain woman, with a French face and a lady’s maid’s manner, ushered him into a diminutive drawing-room and requested the favour of his name."
                                            },
                                            {
                                                "example_id": "3e603181-6d16-4add-9ad6-d20c89008ba0",
                                                "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                                "text": "The cat is the offspring of a cat and the dog of a dog, but butlers and lady’s maids do not reproduce their kind. They have other duties."
                                            },
                                            {
                                                "example_id": "2d2696c1-ed13-4720-b18a-170720b92750",
                                                "sense_id": "80534e82-7225-3d1d-a2de-8dbf6da872d4",
                                                "text": "A first class lady’s maid is required to be a hairdresser, a good packer and an expert needlewoman. Her first duty is to keep her lady's clothes in order and to help her dress, and undress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e19229e-af88-43fa-8ce8-69f66af7fce2",
                        "source_entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                        "source_sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                        "source_sense_description": "Bedienstete einer vornehmen, höhergestellten Dame, Herrin",
                        "target_lang_word": "fille de chambre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fille de chambre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9940bc50-6605-3f12-a3d7-0568a6d86dee",
                                        "entry_id": "72f9a77e-3f04-3a65-8f70-187d7cf36746",
                                        "glosses": [
                                            "Camériste."
                                        ],
                                        "tags": [
                                            "Centre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3cc7ef-3604-4fef-b6fd-e6db9f178fb7",
                                                "sense_id": "9940bc50-6605-3f12-a3d7-0568a6d86dee",
                                                "text": "Bien que Claudie fût plus spécialement fille de chambre, comme on dit au pays, ce n’était pas elle qui déshabillait, le soir, mademoiselle de Boussac."
                                            },
                                            {
                                                "example_id": "1199c096-4e6a-483c-9b3a-a0b863feb72d",
                                                "sense_id": "9940bc50-6605-3f12-a3d7-0568a6d86dee",
                                                "text": "Croyant que ce fût quelque fille de chambre qui entrât pour les besoins du service, Isabelle n’avait pas relevé ses longues paupières dont les cils, traversés du jour, ressemblaient à des fils d’or, et continuait dans une somnolence rêveuse à débiter machinalement ses rimes comme on égrène un chapelet, presque sans y penser."
                                            },
                                            {
                                                "example_id": "057bf0b0-c6ae-43b3-82dd-535dbca7df9d",
                                                "sense_id": "9940bc50-6605-3f12-a3d7-0568a6d86dee",
                                                "text": "— N’en parlons donc plus, dit d’Artagnan, et brûlons cette lettre qui, sans doute, vous annonçait quelque nouvelle infidélité de votre grisette ou de votre fille de chambre."
                                            },
                                            {
                                                "example_id": "76e7b55e-cb2c-4f74-a4cb-c888aca8190c",
                                                "sense_id": "9940bc50-6605-3f12-a3d7-0568a6d86dee",
                                                "text": "Jeanne était prête à monter en voiture lorsque la baronne descendit l'escalier, soutenue d'un côté par son mari, et, de l'autre, par une grande fille de chambre forte et bien découplée comme un gars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
