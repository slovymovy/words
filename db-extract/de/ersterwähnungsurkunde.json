                "senses": [
                    {
                        "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                        "entry_id": "e89d409d-cc0a-3a02-aeb7-2a86d080671e",
                        "glosses": [
                            "Eine Urkunde, in der ein Gemeinwesen oder eine Organisation erstmals in der Geschichte erwähnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06679151-7d36-4fab-ab15-c5b01eca90fc",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "Die Ersterwähnungsurkunden besagen, seit wann ein Ort spätestens bestanden hat."
                            },
                            {
                                "example_id": "77ec1afd-c166-479b-818a-263e3d7998fc",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "„Die Ersterwähnungsurkunde von 1236 führt ihn als Zeugen, die um 1240 erstellte Urkunde mit der erstmaligen Bezeichnung Frankenbergs als Stadt wurde von ihm veranlasst und besiegelt.“"
                            },
                            {
                                "example_id": "20e68339-e219-4a99-9eb4-87622c00d7ca",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "Nachdem Graf Heinrich zu Stolberg (1435-1511) und seine Bergbau treibenden Gewerken bereits 1487 in der Ersterwähnungsurkunde von Sankt Andreasberg genannt werden, sind im Dezember 1550 folgende Andreasberger Gruben mit gräflicher Beteiligung verzeichnet: […]“"
                            },
                            {
                                "example_id": "7be452c9-e07d-4200-9147-35a9afb421de",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "Eine ältere Urkunde von 927 war nur in einer heute verschollenen Abschrift erhalten, das darin gleichfalls genannte Nordhausen betrachtet diese als seine Ersterwähnungsurkunde.“"
                            },
                            {
                                "example_id": "5325c5b3-c382-4700-bfa3-acb59c325a0b",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "„Übersetzung der Ersterwähnungsurkunde von Dr. Georg Pilk 1924: „Im Namen des Herrn Amen! Bruno IL von Gottes Gnaden Bischof von Meißen. […]““"
                            },
                            {
                                "example_id": "6077c7db-8ee3-4e5b-bfa6-d658b35d1bf5",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "„Die Stadt Dresden besteht bereits über 800 Jahre. Aber auch die Friedrichstadt ist in der Ersterwähnungsurkunde von Dresden, vom 31. März 1206 enthalten, als „Dorf Ostrov“.“"
                            },
                            {
                                "example_id": "b35fea8a-60b3-429f-aa6e-7ccdf0225a9b",
                                "sense_id": "0224df10-01d9-3b7e-8b41-4404a3064aa4",
                                "text": "\"Die Ersterwähnungsurkunde von 1282, Von Dr. Rainer Ernst - Die erstmalige Übersetzung der Urkunde fertigte Dr. Lorenz Friedrich Beck (Potsdam) an. […]\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
