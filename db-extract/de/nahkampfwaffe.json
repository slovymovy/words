                "senses": [
                    {
                        "sense_id": "287240a4-3a8d-36c4-8555-c55103e2c339",
                        "entry_id": "e12bc0f1-a104-344a-a0f1-1818c0cbed3b",
                        "glosses": [
                            "Waffe, die für Kampfhandlungen über kurze/kürzeste Entfernung geeignet/vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff032ab-cd7d-4570-a4d9-1ab4dfaa9daf",
                                "sense_id": "287240a4-3a8d-36c4-8555-c55103e2c339",
                                "text": "„Beim Nahkampf in unübersichtlichem Terrain benutzten viele Schwarze ihre traditionelle (und vollkommen legale) Nahkampfwaffe, das Coupe-coupe.“"
                            },
                            {
                                "example_id": "d1e77ead-5911-45df-b4ef-bfb1f02ec6c5",
                                "sense_id": "287240a4-3a8d-36c4-8555-c55103e2c339",
                                "text": "„Nahkampfwaffen sind allgemein sehr spezialisierte Geräte, die für den Kampf als ihre primäre Funktion gestaltet werden und ein spezielles Kampftraining erfordern […]“"
                            },
                            {
                                "example_id": "4b211e0b-1262-430b-a916-172fe93f2f4e",
                                "sense_id": "287240a4-3a8d-36c4-8555-c55103e2c339",
                                "text": "„Zu den Angriffswaffen rechnet man die Seil- und Schleuderwaffen hinzu, welche aus organischem Material bestanden und eine Zwischenform zwischen Fern- und Nahkampfwaffen bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
