                "senses": [
                    {
                        "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                        "entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
                        "glosses": [
                            "meist schlechtes (neues, junges) Erzeugnis von etwas"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "281dcefe-80b8-47d6-b7ec-47740b4da57f",
                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                "text": "Niemand ahnt, dass die Frau eine Ausgeburt des Bösen gebären wird, die allen das Leben zur Hölle macht."
                            },
                            {
                                "example_id": "4491b054-773e-4993-8daa-b253f93a7410",
                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                "text": "„Jeder stillgelegte deutsche Kleinstadtbahnhof ist schöner als diese Ausgeburten einer verkrüppelten Phantasie, diese architektonischen Flughafen-Desaster in Köln oder Hamburg, Düsseldorf oder Hannover.“"
                            },
                            {
                                "example_id": "27b0fd4b-b4d0-4b2a-a62c-ce903ad3732d",
                                "sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                                "text": "„Wie oft hat er sich in Gedanken ausgemalt, was er mit Stalin anstellen würde, falls ihm diese Ausgeburt der Hölle in die Hände fiele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f9349f-f848-475d-bfca-a61b26d4aa17",
                        "source_entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
                        "source_sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                        "source_sense_description": "abwertend, mit Genitiv: meist schlechtes (neues, junges) Erzeugnis von etwas",
                        "target_lang_word": "monstrosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monstrosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3499d20d-f263-39bd-b1ba-c089cedc921b",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "An organism showing abnormal development or deformity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acc2de2-3630-4077-9be5-72fc76ea5077",
                                                "sense_id": "3499d20d-f263-39bd-b1ba-c089cedc921b",
                                                "text": "Geoffroy St. Hilaire's experiments show that unnatural treatment of the embryo causes monstrosities; and monstrosities cannot be separated by any clear line of distinction from mere variations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30a3719c-4235-3faa-b872-299c6988da00",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "A monstrous person, thing, or act."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a77fcdd-47ff-4706-b1fa-af2a613396aa",
                                                "sense_id": "30a3719c-4235-3faa-b872-299c6988da00",
                                                "text": "St Enoch Centre (1989) - a glass-domed monstrosity of a shopping centre - stands on the site of the station today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd848810-ea76-33e9-a47b-88144234e15d",
                                        "entry_id": "eb7f5d8c-5b67-3622-ac6a-8322df53d8b5",
                                        "glosses": [
                                            "The state of being monstrous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5854e386-423d-4a4e-b722-8714a6fe3060",
                        "source_entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
                        "source_sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                        "source_sense_description": "abwertend, mit Genitiv: meist schlechtes (neues, junges) Erzeugnis von etwas",
                        "target_lang_word": "excrescence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excrescence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca4e6a2-42d8-3300-8e5e-0103f4351fca",
                                        "entry_id": "12b7ff4c-e8ee-3d8e-8b4b-6b57873acd0c",
                                        "glosses": [
                                            "Something, usually abnormal, which grows out of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6d28396-9763-4eb0-8114-3f0c86449a48",
                                                "sense_id": "0ca4e6a2-42d8-3300-8e5e-0103f4351fca",
                                                "text": "I have again and again intimated that I desire the hair to be arranged closely, modestly, plainly. Miss Temple, that girl’s hair must be cut off entirely; I will send a barber to-morrow: and I see others who have far too much of the excrescence—that tall girl, tell her to turn round."
                                            },
                                            {
                                                "example_id": "f987ab48-24a5-4924-a259-65aeb0033959",
                                                "sense_id": "0ca4e6a2-42d8-3300-8e5e-0103f4351fca",
                                                "text": "The squirrels were in hiding. One only he saw,—a sleek gray fellow, flattened against a gray dead limb so that he seemed a part of it, a woody excrescence upon the wood itself."
                                            },
                                            {
                                                "example_id": "3f590e7d-2bc7-41cf-a6f5-df5cf5386768",
                                                "sense_id": "0ca4e6a2-42d8-3300-8e5e-0103f4351fca",
                                                "text": "Perhaps he meant that towns are after all excrescences, grey fluxions, where men, hurrying to find one another, have lost themselves."
                                            },
                                            {
                                                "example_id": "7b610478-eefc-443b-b43f-f9a25efe8d43",
                                                "sense_id": "0ca4e6a2-42d8-3300-8e5e-0103f4351fca",
                                                "text": "It is taken for granted that a beggar does not 'earn' his living, as a bricklayer or a literary critic 'earns' his. He is a mere social excrescence, tolerated because we live in a humane age, but essentially despicable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6e2e5c-c8d8-37a9-b679-e6fed8b7f5c0",
                                        "entry_id": "12b7ff4c-e8ee-3d8e-8b4b-6b57873acd0c",
                                        "glosses": [
                                            "A disfiguring or unwanted mark or adjunct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a476d9-4637-4a34-b707-dca3155e49be",
                                                "sense_id": "ba6e2e5c-c8d8-37a9-b679-e6fed8b7f5c0",
                                                "text": "Being bussum buddies, the two friends often communicated with mere exchange of psychic forces, verbal communication having been rendered unnecessary excrescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e9d9661-db30-3280-9eb4-df04961a359e",
                                        "entry_id": "12b7ff4c-e8ee-3d8e-8b4b-6b57873acd0c",
                                        "glosses": [
                                            "The epenthesis of a consonant, e.g., warmth as [ˈwɔrmpθ] (adding a [p] between [m] and [θ]), or -t (Etymology 2)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb7f75f-b549-43f6-b8c5-fd552d045b40",
                        "source_entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
                        "source_sense_id": "6bfc730a-e377-3a2b-90d2-d7b3125183a5",
                        "source_sense_description": "abwertend, mit Genitiv: meist schlechtes (neues, junges) Erzeugnis von etwas",
                        "target_lang_word": "плод",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плод",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1c21aacc-dee3-3a0c-87e1-fdfd2a1a0717",
                                        "entry_id": "8eaf9e8a-b28f-3be5-a2fd-1220acb176f0",
                                        "glosses": [
                                            "ботан. репродуктивный о́рган растения, развивающийся после оплодотворения из завязи цветка и содержащий семена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27846ee8-c6ef-496a-b130-7410afb7dbac",
                                                "sense_id": "1c21aacc-dee3-3a0c-87e1-fdfd2a1a0717",
                                                "text": "Три плода — три яблока — висело на тонких, кверху загнутых ветках."
                                            },
                                            {
                                                "example_id": "f6aacb36-bcc3-431c-aeac-8816c4f083e2",
                                                "sense_id": "1c21aacc-dee3-3a0c-87e1-fdfd2a1a0717",
                                                "text": "Стрелолист уже дал первые плоды — зелёные шишки, покрытые со всех сторон мягкими иглами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed2ff39-1992-3cf3-85e5-3809d85e609e",
                                        "entry_id": "8eaf9e8a-b28f-3be5-a2fd-1220acb176f0",
                                        "glosses": [
                                            "сочная съедобная часть некоторых растений (фрукты, ягоды)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b76bd5-ddbf-4f1c-a337-4fd6aa42aeda",
                                                "sense_id": "0ed2ff39-1992-3cf3-85e5-3809d85e609e",
                                                "text": "Утолив жажду и голод плодами довольно вкусными, вроде трюфелей, мы набрали смолистых сучьев и с зажжёнными пуками пошли вперёд по берегу источника."
                                            },
                                            {
                                                "example_id": "2bfaa713-14a9-4a04-9b9c-5af5979aed1b",
                                                "sense_id": "0ed2ff39-1992-3cf3-85e5-3809d85e609e",
                                                "text": "В прекрасном Новосельском фруктовом саду поспели все плоды и между прочим крупные груши."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2a2dc1-0cbe-36d3-ae48-def2794ad04e",
                                        "entry_id": "8eaf9e8a-b28f-3be5-a2fd-1220acb176f0",
                                        "glosses": [
                                            "мед., биол. детёныш человека и млекопитающих в период внутриутробного развития (после закладки основных органов и систем) в организме матери"
                                        ],
                                        "tags": [
                                            "обычно ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245a4906-5a78-47eb-9613-e8bc65037348",
                                                "sense_id": "7e2a2dc1-0cbe-36d3-ae48-def2794ad04e",
                                                "text": "Захватывание верхней ножки следует считать ошибкой, так как при этом легко может получиться осевое перекручивание плода, которое может дать повод к тяжёлому вколачиванию плода и, вследствие этого, к самым печальным последствиям."
                                            },
                                            {
                                                "example_id": "70594302-0fe0-419f-b8e7-5f24c1f32d16",
                                                "sense_id": "7e2a2dc1-0cbe-36d3-ae48-def2794ad04e",
                                                "text": "От него была вся му́ка, от него был затравленный плод."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8509044b-b879-3d1c-a815-e72849c228a8",
                                        "entry_id": "8eaf9e8a-b28f-3be5-a2fd-1220acb176f0",
                                        "glosses": [
                                            "перен. итог, результат, продукт какой-либо деятельности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bce02ad-a141-4a33-a4ce-97b9a4725e78",
                                                "sense_id": "8509044b-b879-3d1c-a815-e72849c228a8",
                                                "text": "Вот злонравия достойные плоды!"
                                            },
                                            {
                                                "example_id": "32dfa326-ea2a-445d-bf56-fd1466e49f1a",
                                                "sense_id": "8509044b-b879-3d1c-a815-e72849c228a8",
                                                "text": "Но я плоды моих мечтаний // И гармонических затей // Читаю только старой няне, // Подруге юности моей"
                                            },
                                            {
                                                "example_id": "a6459cde-6bc7-4cc3-80b3-eb949b631768",
                                                "sense_id": "8509044b-b879-3d1c-a815-e72849c228a8",
                                                "text": "Разум! — где плоды твоих трудов?"
                                            },
                                            {
                                                "example_id": "4422b79c-7966-4eee-a78f-fbd62d6c5a2b",
                                                "sense_id": "8509044b-b879-3d1c-a815-e72849c228a8",
                                                "text": "Старой традицией является готовность учёных и исследователей безвозмездно публиковать плоды своих трудов в научных изданиях для получения и распространения новых знаний."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8409289-bfbc-4060-b302-a522bac74aa1",
                        "source_entry_id": "bd93c4e4-f4fa-34db-8232-c7b70607dc2c",
