{
    "word_family": [
        "exclusion",
        "exclusive",
        "exclusively",
        "exclusionary"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20e5f83d-b4b6-3542-89f7-885f317ee8de",
                    "sense_definition": "To bar someone or something from entering; to keep out.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "prevention_of_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>exclude</w> him from the meeting because he arrived too late.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>не допустить</w> его на собрание, так как он приехал слишком поздно.",
                                "tr": "Çok geç geldiği için onu toplantıya <w>almamaya</w> karar verdik."
                            }
                        },
                        {
                            "text": "The heavy curtains <w>exclude</w> almost all sunlight from the bedroom.",
                            "target_lang_translations": {
                                "ru": "Тяжелые шторы <w>не пропускают</w> почти весь солнечный свет в спальню.",
                                "tr": "Kalın perdeler yatak odasına neredeyse hiçbir güneş ışığını <w>geçirmiyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shut out",
                        "turn away",
                        "debar"
                    ],
                    "antonyms": [
                        "include"
                    ],
                    "common_phrases": [
                        "exclude from",
                        "exclude someone from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не впускать кого-либо или что-либо; преграждать доступ.",
                        "tr": "Birinin veya bir şeyin içeri girmesini engellemek, dışarıda tutmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не допускать",
                                "target_lang_sense_clarification": "препятствовать входу или участию"
                            },
                            {
                                "target_lang_word": "не пропускать",
                                "target_lang_sense_clarification": "о свете, звуке или веществе"
                            },
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "устранять из состава участников"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haricinde tutmak",
                                "target_lang_sense_clarification": "içeri almamak veya dahil etmemek"
                            },
                            {
                                "target_lang_word": "almamak",
                                "target_lang_sense_clarification": "içeriye geçirmemek veya kabul etmemek"
                            },
                            {
                                "target_lang_word": "geçirmemek",
                                "target_lang_sense_clarification": "ışık, ses veya sıvı için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47e77cb8-6d9c-3306-9bf7-86e385aab60d",
                    "sense_definition": "To omit from consideration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The listed price seems to <w>exclude</w> tax and shipping costs.",
                            "target_lang_translations": {
                                "ru": "Указанная цена, по-видимому, <w>не включает</w> налоги и стоимость доставки.",
                                "tr": "Listelenen fiyat vergi ve kargo ücretlerini <w>dahil etmiyor</w> gibi görünüyor."
                            }
                        },
                        {
                            "text": "Please do not <w>exclude</w> any important details when you write the report.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>не упускайте</w> никаких важных деталей при написании отчета.",
                                "tr": "Lütfen raporu yazarken hiçbir önemli detayı <w>göz ardı etmeyin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "omit"
                    ],
                    "antonyms": [
                        "include"
                    ],
                    "common_phrases": [
                        "exclude the possibility",
                        "exclude from the list"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не включать в рассмотрение или в состав чего-либо.",
                        "tr": "Dikkate almamak, kapsam dışında bırakmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не включать",
                                "target_lang_sense_clarification": "оставлять за пределами (напр. цены или списка)"
                            },
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "убирать из рассмотрения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hariç tutmak",
                                "target_lang_sense_clarification": "hesaba veya kapsama dahil etmemek"
                            },
                            {
                                "target_lang_word": "dahil etmemek",
                                "target_lang_sense_clarification": "fiyat, liste veya plana katmamak"
                            },
                            {
                                "target_lang_word": "göz ardı etmek",
                                "target_lang_sense_clarification": "dikkate almamak veya atlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6ae7f7-c831-3444-abe4-404a167ea1eb",
                    "sense_definition": "To expel; to put out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school had to <w>exclude</w> the student for repeated bad behavior.",
                            "target_lang_translations": {
                                "ru": "Школе пришлось <w>исключить</w> ученика за неоднократное плохое поведение.",
                                "tr": "Okul, tekrarlanan kötü davranışları nedeniyle öğrenciyi <w>atmak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "The body's immune system works to <w>exclude</w> foreign organisms.",
                            "target_lang_translations": {
                                "ru": "Иммунная система организма работает над тем, чтобы <w>не допускать</w> проникновения чужеродных организмов.",
                                "tr": "Vücudun bağışıklık sistemi yabancı organizmaları <w>dışarıda tutmak</w> için çalışır."
                            }
                        }
                    ],
                    "synonyms": [
                        "eject",
                        "throw out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выгонять; удалять из состава организации или группы.",
                        "tr": "Kovmak, uzaklaştırmak, üyelikten çıkarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "удалять из организации"
                            },
                            {
                                "target_lang_word": "отчислять",
                                "target_lang_sense_clarification": "об учащихся или студентах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "atmak",
                                "target_lang_sense_clarification": "okuldan veya gruptan uzaklaştırmak"
                            },
                            {
                                "target_lang_word": "çıkarmak",
                                "target_lang_sense_clarification": "üyelikten veya yapıdan dışarıda bırakmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c14e7a35-bae4-3029-b199-2ea307c434d4",
                    "sense_definition": "To eliminate from diagnostic consideration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors performed several tests to <w>exclude</w> cancer as a cause of the symptoms.",
                            "target_lang_translations": {
                                "ru": "Врачи провели несколько тестов, чтобы <w>исключить</w> рак как причину симптомов.",
                                "tr": "Doktorlar, belirtilerin nedeni olarak kanser ihtimalini <w>elemek</w> için birkaç test yaptı."
                            }
                        },
                        {
                            "text": "We need to <w>exclude</w> other potential illnesses before we start this treatment.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>исключить</w> другие потенциальные заболевания, прежде чем мы начнем это лечение.",
                                "tr": "Bu tedaviye başlamadan önce diğer potansiyel hastalıkları <w>dışlamamız</w> gerekiyor."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устранять из рассмотрения при постановке диагноза.",
                        "tr": "Tıbbi teşhiste bir olasılığı elemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "доказывать отсутствие заболевания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "elemek",
                                "target_lang_sense_clarification": "teşhiste bir hastalığı ihtimal dışı bırakmak"
                            },
                            {
                                "target_lang_word": "dışlamak",
                                "target_lang_sense_clarification": "olasılıklar arasından çıkarmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6830e6ac-8cde-3de5-9950-a1597fb22133",
                    "sense_definition": "To refuse to accept evidence as valid.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to <w>exclude</w> the witness testimony from the trial.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>исключить</w> показания свидетеля из судебного разбирательства.",
                                "tr": "Yargıç, tanık ifadesini duruşmadan <w>muaf tutmaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "The defense attorney argued to <w>exclude</w> the evidence obtained illegally.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты требовал <w>исключить</w> доказательства, полученные незаконным путем.",
                                "tr": "Savunma avukatı, yasa dışı yollarla elde edilen delillerin <w>kabul edilmemesini</w> savundu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказываться принять доказательства как допустимые (юридический термин).",
                        "tr": "Kanıtı mahkemede geçerli kabul etmeyip reddetmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключать",
                                "target_lang_sense_clarification": "признавать недопустимым в суде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kabul etmemek",
                                "target_lang_sense_clarification": "delili mahkemede geçersiz saymak"
                            },
                            {
                                "target_lang_word": "dışında tutmak",
                                "target_lang_sense_clarification": "dava kapsamına almamak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}