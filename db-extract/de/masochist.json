                            {
                                "example_id": "aed34f9b-d33b-4662-8dd1-98bd455b2e23",
                                "sense_id": "1e8f2fa9-2542-3f37-bc2d-20ce9254c845",
                                "text": "„Der Masochist unterwirft sich bestimmten Regeln, gibt bewusst seine Freiheit auf und empfindet dabei Vergnügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
