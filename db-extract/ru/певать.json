                "senses": [
                    {
                        "sense_id": "c29e9e22-b741-3c06-8326-a5125953fe9f",
                        "entry_id": "94119dc3-dd58-348d-9bda-c0f8cb63b2c0",
                        "glosses": [
                            "устар., разг., также ирон. многокр. к петь"
                        ],
                        "tags": [
                            "iterative"
                        ],
                        "examples": [
                            {
                                "example_id": "0d15474a-4abe-46d6-911a-0d16f31c1660",
                                "sense_id": "c29e9e22-b741-3c06-8326-a5125953fe9f",
                                "text": "На фортепиано я играл гораздо лучше моего учителя и пел так приятно, что даже на наших музыкальных вечерах певал соло."
                            },
                            {
                                "example_id": "589face1-94b0-4968-9f59-7b143008323d",
                                "sense_id": "c29e9e22-b741-3c06-8326-a5125953fe9f",
                                "text": "Думаю, что, имей он возможность певать, скажем, в Лужниках, под стать размаху дарования, не будь этого душевного разлада, ни водка, ни наркота не сладили бы с ним."
                            }
                        ]
                    }
