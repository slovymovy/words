                "senses": [
                    {
                        "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                        "entry_id": "bad9d809-ea88-370c-a674-42dd7b44111a",
                        "glosses": [
                            "Laufen/Joggen am Nachmittag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "62105724-e67d-4461-accb-f219d65015a7",
                                "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                                "text": "„Für den heutigen Nachmittagslauf hab ich mir mal wieder eine alte Strecke rausgesucht… nur mal um zu schauen, ob der Bauer schon mit seinem Traktor wieder die Laufstrecke abfährt oder er noch immer im wohlverdienten Neujahrsurlaub am Strand liegt….“"
                            },
                            {
                                "example_id": "289cacd5-b810-4c00-a30a-8f11870acc27",
                                "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                                "text": "„Dass der Nachmittagslauf in Lünen, auch wenn es wärmer war, nicht ganz so erfolgreich sein würde, war Willingmann von vornherein klar.“"
                            },
                            {
                                "example_id": "07263a03-0493-44c3-9d25-81b8321fa686",
                                "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                                "text": "„Zweimal in der Woche sind wir für einen lockeren Nachmittagslauf in den nahen Wald auf 2’700 m ü.M. gefahren.“"
                            },
                            {
                                "example_id": "9d3ecaf6-7f5f-47b2-b046-6b3b0ef4f3ff",
                                "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                                "text": "„Ich muss zugeben, dass das mit der Motivation für einen Nachmittagslauf bei mir nur funktioniert, wenn ich mich auf gar keinen Fall nach der Arbeit aufs Sofa pflanze, sondern gleich losstarte.“"
                            },
                            {
                                "example_id": "ab313540-1f51-4d95-9378-b160a36f39de",
                                "sense_id": "7c5c508b-3817-3a2e-8fcc-c1fe1bb57eb5",
                                "text": "„Das finde ich sehr erstaunlich, nach so manchem schweißtreibenden Nachmittagslauf hatte ich am nächsten Tag schon mal ganz andere Probleme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
