                                "target_senses": [
                                    {
                                        "sense_id": "a640a28b-b3ad-3f6b-974b-f9ccea068910",
                                        "entry_id": "c9953b6b-46aa-3966-864f-4f34dd8c1946",
                                        "glosses": [
                                            "The act of one who rallies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a847e5-b1fa-4443-ae91-3afa526f1c8d",
                                                "sense_id": "a640a28b-b3ad-3f6b-974b-f9ccea068910",
                                                "text": "We are convinced that these public rallyings around the banner of Christ the King are a most effective means of counteracting \"the diabolical program\" and \"the brazen unfurlings of the satanical banners of war against God and religion\" […]"
                                            }
                                        ]
                                    },
