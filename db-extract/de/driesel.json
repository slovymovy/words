                "senses": [
                    {
                        "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                        "entry_id": "403c2e44-8b50-3da3-b318-e30205e67cc6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69745c63-a53c-4256-b0ea-eedc5e293c49",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Frau Driesel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ed7d5815-a631-4368-9fa8-d5da6c9ed76d",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Herr Driesel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "603314bd-aa57-4315-a2d6-7480b396b27c",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Die Driesels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "70115f24-a7dc-4bd9-a9cb-ecc1ef6825ba",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Der Driesel trägt nie die Pullover, die die Driesel ihm strickt."
                            },
                            {
                                "example_id": "0dd0b45e-185b-4817-87ca-f1f0a8595772",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Driesel kommt, geht der Herr Driesel.“"
                            },
                            {
                                "example_id": "96a67220-3a81-480c-9cb2-2306f0eda7c3",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Driesel kommt und geht."
                            },
                            {
                                "example_id": "aaffe5d7-2f1a-42bd-874c-4be1b7c742d8",
                                "sense_id": "241afd26-983c-3c93-b33b-7b2415f6694c",
                                "text": "Driesels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
