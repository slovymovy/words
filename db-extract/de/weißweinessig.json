                        "glosses": [
                            "aus Weißwein durch Gärung/Fermentierung gewonnenes Würzmittel (Essig)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1433bfc9-8012-46b8-b947-468bf49a5756",
                                "sense_id": "29680768-a0d1-35e6-8de4-c2df6577538f",
                                "text": "„Immer wieder experimentieren sie mit neuen Varianten wie Himbeere-Minze oder Weißweinessig mit Ingwer und Zitronengras.“"
                            },
                            {
                                "example_id": "890dea7c-149a-44d7-afbe-d30e2728afa4",
                                "sense_id": "29680768-a0d1-35e6-8de4-c2df6577538f",
                                "text": "„»Es ist Unsinn, teure Weine zu verkochen.« Er selbst mischt schon seit Jahren spezielle Basismixturen für seine Soßen. »Etwa aus dem Süßwein Montbazillac, aus Riesling, Weißweinessig, Apfelsaft und weißem Portwein«, zählt Amador auf, »oder aus Rotweinessig, rotem Portwein und rotem Traubensaft.«“"
                            }
                        ],
