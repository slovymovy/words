        "fr-extract.jsonl": [
            {
                "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                "word": "puritain",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2739d369-53ae-4cea-9dad-d8893665a77f",
                        "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "puritains"
                    },
                    {
                        "form_id": "5f330bab-8881-4d8e-b14a-b6260b33863c",
                        "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "puritaine"
                    },
                    {
                        "form_id": "f5f86feb-c75c-4e52-bc0f-efb4a959d7df",
                        "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "puritaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                        "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "glosses": [
                            "Qui professe une grande pureté de principes moraux ou politiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc92bb7-9e15-46cb-bc46-0f3a84a908b6",
                                "sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                                "text": "Un ministre puritain. — Un esprit puritain."
                            },
                            {
                                "example_id": "27b7fd54-7219-4a66-b0ea-6dc76020dc9a",
                                "sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                                "text": "Sa vie était monotone et sa tâche répugnait à son caractère, mais elle accomplissait son devoir et brisait sa volonté avec une joie puritaine."
                            },
                            {
                                "example_id": "129974c3-c241-4fa6-9f23-db62bfe1b73d",
                                "sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                                "text": "Facebook et Instagram se sont mis à censurer toute image contraire à leur vision puritaine de la société, à masquer les sites de presse contraires à ce qu'ils jugent être le « juste débat » et à organiser nos « fils d'actualité » pour nous rendre plus réceptifs à leur publicité."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c6fdec-5ea3-3330-8cc7-fc14302152a9",
                        "entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "glosses": [
                            "Relatif au puritanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfbe8bb7-06d5-4ee7-8fbb-1e8cb40b66b9",
                                "sense_id": "f7c6fdec-5ea3-3330-8cc7-fc14302152a9",
                                "text": "On comprend bien des choses si l'on sait que chacun de ces hommes devait être enterré selon les rites de sa bande, avec tout ce qu'il peut y avoir de prières : catholiques, juives, puritaines, presbytériennes, méthodistes, parsies, jaines, musulmanes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e292fdf9-cd6c-4ed7-a0df-9159476553d8",
                        "source_entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "source_sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                        "source_sense_description": "Qui professe une grande pureté de principes moraux ou politiques.",
                        "target_lang_word": "puritanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puritanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "den Puritanismus betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed3c05f-60d2-4363-ad94-bd5319279d3f",
                                                "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                                "text": "„Die Familie nahm in der puritanischen Gesellschaftsordnung Neuenglands eine hohe Stellung ein, sie wurde als »Kirche im Kleinen« bezeichnet.“"
                                            },
                                            {
                                                "example_id": "e51c578a-9db9-44f3-85f7-bc83d05d0006",
                                                "sense_id": "3ef264fc-6e9f-31d5-b46c-497be63c870f",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ae71ce3-f696-3b8a-9f71-c56ce9d21a88",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "auf das Wesentliche beschränkt, einfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36045079-fa8b-455c-9b17-6e113cd78dd6",
                                                "sense_id": "2ae71ce3-f696-3b8a-9f71-c56ce9d21a88",
                                                "text": "„Das neogotische Wohnhaus im Hintergrund sowie die aus der Mimik sprechende puritanische Lebensweise und strenge Gläubigkeit werden durch den Titel ausdrücklich betont: «Amerikanische Gotik».“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "984d982b-c19d-3368-9481-8ad419f4c0e8",
                                        "entry_id": "a9599e4c-03e9-33f5-a999-a34cb2c8b2ac",
                                        "glosses": [
                                            "sittenstreng, sehr tugendhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8f6ce6-3d42-447c-ba8f-4883229f2b7b",
                                                "sense_id": "984d982b-c19d-3368-9481-8ad419f4c0e8",
                                                "text": "„Nur das puritanisch enge Korsett der Hofgesellschaft schnürt ihr die Luft ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2136274b-c285-4466-b91f-9a75f910b996",
                        "source_entry_id": "d29a9bc4-9201-352f-8492-97d409640dec",
                        "source_sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                        "source_sense_description": "Qui professe une grande pureté de principes moraux ou politiques.",
                        "target_lang_word": "puritan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puritan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab9ca07-dc23-3fc1-b21a-c7ac643c40d9",
                                        "entry_id": "9bb5c26a-482c-324c-ae80-d50c3be88441",
                                        "glosses": [
                                            "A puritanical person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79684fdf-1f9f-4fb6-a923-b9cddda7a1da",
                                                "sense_id": "2ab9ca07-dc23-3fc1-b21a-c7ac643c40d9",
                                                "text": "These new puritans have turned out to be surprisingly unskilled and inexperienced - very different from my generation who invented wife-swapping, orgies and free love in the late Sixties and early Seventies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puritan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4c584de-f16a-32fd-891f-2f8edbff2bc5",
