            {
                "entry_id": "e30a0039-eb1d-34e3-8de8-a890e8c58a49",
                "word": "aeon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7c1e567-d8af-30fa-bb18-176d033d6e5c",
                        "entry_id": "e30a0039-eb1d-34e3-8de8-a890e8c58a49",
                        "glosses": [
                            "der Äon, die Ewigkeit, die Vorzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0447617f-5289-4763-b78e-b787f5024445",
                                "sense_id": "b7c1e567-d8af-30fa-bb18-176d033d6e5c",
                                "text": "In general usage ^(→ en), an aeon (sometimes spelled eon) is a period of time arbitrarily ^(→ en) designated by humans."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8885e191-3173-47f7-ae12-2e93829f82d9",
                        "source_entry_id": "e30a0039-eb1d-34e3-8de8-a890e8c58a49",
                        "source_sense_id": "b7c1e567-d8af-30fa-bb18-176d033d6e5c",
                        "source_sense_description": "der Äon, die Ewigkeit, die Vorzeit",
                        "target_lang_word": "Äon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Erdzeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447d31fe-5d7c-46e1-a587-89bffbbfff82",
                                                "sense_id": "63d1bf0c-025d-3109-bb14-5b04566b8285",
                                                "text": "Das Hadaikum ist der erste Äon in der Geologie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "sehr langer, nach menschlichem Ermessen unüberschaubarer, unendlich erscheinender Zeitraum"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63191cee-00ab-4f7d-9e74-7c0154b051f5",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Moor: Nein, nicht erschlagen! das Wort ist Beschönigung! - der Sohn hat den Vater tausendmal gerädert, gespießt, gefoltert, geschunden! die Worte sind mir zu menschlich - worüber die Sünde roth wird, worüber der Kannibale schaudert, worauf seit Äonen kein Teufel gekommen ist.“"
                                            },
                                            {
                                                "example_id": "f98ae1bc-a8f6-4b2a-bfe5-74310b6d7515",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Äonen, nachdem die Sonne zur roten Riesin geworden ist, werden im Sternennebel noch immer verstreute Funksignale aufgefangen.“"
                                            },
                                            {
                                                "example_id": "6aa6f460-b878-4170-ac80-726ca595e12d",
                                                "sense_id": "62b8ed7b-1d00-3a52-95e1-fa7b0535eb49",
                                                "text": "„Als Jäger und Sammler hat sich der Mensch einst in Afrika entwickelt, und so hat er dort auch über Äonen gelebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                        "entry_id": "db02a3d9-9b00-3961-862c-ef4a53f20e03",
                                        "glosses": [
                                            "Zeitabschnitt der Weltgeschichte, Zeitalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4d7aa1-35f9-48c1-aea4-52f76364e32a",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Der Kalte Krieg hatte lange genug gedauert, um damals beiden Seiten seine Vergeblichkeit zu beweisen. Ein neuer Äon kündigte sich an. Fantasien vom Ende der Geschichte versprachen ein Goldenes Zeitalter.“"
                                            },
                                            {
                                                "example_id": "3ca974b8-1ce2-4ba4-8ae7-9fa758adadfb",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„Jetzt, im mandarinen Äon, glauben die Menschen nur noch an die Kaufkraft.“"
                                            },
                                            {
                                                "example_id": "766c89a3-0ff4-4174-a4ff-bc051e9bf505",
                                                "sense_id": "1916e8b9-4564-3a46-a936-432ac5dc6ab8",
                                                "text": "„So trächtig schwärmten die Gedanken, daß sich die Menschen einbildeten, in der überstürzten Spanne von Jahrzehnten die Entwicklung eines Äons zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b9a54f6-5b64-48a5-9328-4963f477aff9",
                        "source_entry_id": "e30a0039-eb1d-34e3-8de8-a890e8c58a49",
                        "source_sense_id": "b7c1e567-d8af-30fa-bb18-176d033d6e5c",
                        "source_sense_description": "der Äon, die Ewigkeit, die Vorzeit",
                        "target_lang_word": "Ewigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ewigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "ein langer Zeitraum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e4f5bd-a82a-4f2e-ad46-438618884dba",
                                                "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                                "text": "Du brauchst ja wieder eine Ewigkeit, bis du endlich fertig bist."
                                            },
                                            {
                                                "example_id": "ee394a97-62f8-4ad7-acfc-caee4bf76468",
                                                "sense_id": "c1475242-488c-351e-ad6d-f1cfa6568a2e",
                                                "text": "„An der Front sei er einer brutalen Ewigkeit ausgesetzt gewesen, er habe irgendwann nicht einmal mehr Tag und Nacht unterscheiden können unter all dem Staub und Rauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b4ee663-3b74-343f-9b34-f70e5506c87f",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "Zeitlosigkeit ohne Anfang und ohne Ende"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "Philosopie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f709f9-1e7a-4ded-9dd8-6db0687dd6ad",
                                                "sense_id": "3b4ee663-3b74-343f-9b34-f70e5506c87f",
                                                "text": "Ewigkeit ist wie „Liebe“ – sehr real, aber schwer zu definieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7b940e78-d40b-3dc7-b9f1-c995f4291700",
                                        "entry_id": "9d1bbc52-8231-37b4-a851-d6961db76ac0",
                                        "glosses": [
                                            "Zeitlosigkeit mit Anfang, aber ohne Ende"
                                        ],
                                        "tags": [
                                            "Theologie",
                                            "Philosopie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb782bd7-7d64-44a1-b28a-5f9791a522e4",
                                                "sense_id": "7b940e78-d40b-3dc7-b9f1-c995f4291700",
                                                "text": "Da droht Verdammnis in alle Ewigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b510f13-1cbf-43e0-bbde-1726fd31f936",
                        "source_entry_id": "e30a0039-eb1d-34e3-8de8-a890e8c58a49",
                        "source_sense_id": "b7c1e567-d8af-30fa-bb18-176d033d6e5c",
                        "source_sense_description": "der Äon, die Ewigkeit, die Vorzeit",
                        "target_lang_word": "Vorzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "992677e5-c0c2-3790-88df-308049a47dc9",
                                        "entry_id": "8ffde3d3-3b0b-361c-a9c7-1766c0c831db",
                                        "glosses": [
                                            "Zeitraum, der längst vergangen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7c10d9-400f-44d3-8d91-45402bb52764",
                                                "sense_id": "992677e5-c0c2-3790-88df-308049a47dc9",
                                                "text": "„Gab es nicht in grauer Vorzeit einen Kaiser, der zur eigenen Belustigung die Stadt Rom anzünden ließ?“"
                                            },
                                            {
                                                "example_id": "df3ec6c3-aeca-4df6-859c-00ff4ca6ff44",
                                                "sense_id": "992677e5-c0c2-3790-88df-308049a47dc9",
                                                "text": "„An einem 1. Mai in grauer Vorzeit macht ein Schiff beim Slieve-Mish-Gebirge an den südwestlichen Gestaden Irlands fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
