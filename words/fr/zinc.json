                    "frequency": "Middle",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les toits de Paris sont souvent recouverts de plaques de <w>zinc</w> étanches."
                        },
                        {
                            "text": "L'artisan remplace la gouttière abîmée par un tuyau solide en <w>zinc</w>."
                        }
                    ],
                    "common_phrases": [
