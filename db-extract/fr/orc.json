                                            "scornfully"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df64b18-3887-43d0-a41e-2f5034aa3a24",
                                                "sense_id": "365654c8-3ae2-3803-aaf1-e4346dcbfb95",
                                                "text": "W przerwach między bitwami pijane orki wychodziły z opancerzonych transporterów. Chodzili po domach z karabinami maszynowymi i straszyli bezbronnych cywilów!"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
