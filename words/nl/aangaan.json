{
    "word_family": [
        "aangaande",
        "aangaan",
        "gang",
        "voortgaan",
        "uitgaan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e55bef71-13a4-33f5-ac23-b2efd99dfe12",
                    "sense_definition": "het beginnen te werken van een apparaat, machine of verlichting",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inschakelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra het donker wordt, zal de buitenverlichting automatisch <w>aangaan</w>.",
                            "target_lang_translations": {
                                "en": "As soon as it gets dark, the outdoor lighting will <w>turn on</w> automatically.",
                                "ru": "Как только стемнеет, наружное освещение <w>включится</w> автоматически."
                            }
                        },
                        {
                            "text": "De computer wilde maar niet <w>aangaan</w> omdat de stekker niet in het stopcontact zat.",
                            "target_lang_translations": {
                                "en": "The computer just wouldn't <w>start</w> because it wasn't plugged into the socket.",
                                "ru": "Компьютер никак не хотел <w>запускаться</w>, потому что вилка не была вставлена в розетку."
                            }
                        }
                    ],
                    "synonyms": [
                        "starten",
                        "aanspringen"
                    ],
                    "antonyms": [
                        "uitgaan"
                    ],
                    "common_phrases": [
                        "het licht gaat aan",
                        "de verwarming gaat aan"
                    ],
                    "target_lang_definitions": {
                        "en": "the starting or turning on of a device, machine, or lighting",
                        "ru": "начало работы устройства, машины или освещения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn on",
                                "target_lang_sense_clarification": "to start a device or light"
                            },
                            {
                                "target_lang_word": "go on",
                                "target_lang_sense_clarification": "to start working or illuminate"
                            },
                            {
                                "target_lang_word": "switch on",
                                "target_lang_sense_clarification": "to activate via a switch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "включаться",
                                "target_lang_sense_clarification": "о свете или приборе"
                            },
                            {
                                "target_lang_word": "загораться",
                                "target_lang_sense_clarification": "о свете или лампе"
                            },
                            {
                                "target_lang_word": "запускаться",
                                "target_lang_sense_clarification": "о машине или компьютере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9085be3-ee57-3372-97b6-209a3dd7882e",
                    "sense_definition": "van belang zijn voor iemand of betrekking hebben op iets",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "betreffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn persoonlijke keuzes en mijn doen en laten <w>gaan</w> jou helemaal niets <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "My personal choices and my actions are none of your <w>business</w> at all.",
                                "ru": "Мой личный выбор и мои поступки тебя совершенно не <w>касаются</w>."
                            }
                        },
                        {
                            "text": "Deze nieuwe regels <w>gaan</w> alle medewerkers van het bedrijf <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "These new rules <w>concern</w> all employees of the company.",
                                "ru": "Эти новые правила <w>касаются</w> всех сотрудников компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "betreffen",
                        "belangen"
                    ],
                    "common_phrases": [
                        "iemand niets aangaan",
                        "wat mij aangaat"
                    ],
                    "target_lang_definitions": {
                        "en": "to be of importance to someone or to relate to something",
                        "ru": "иметь значение для кого-то или относиться к чему-то"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "concern",
                                "target_lang_sense_clarification": "to relate to or affect someone"
                            },
                            {
                                "target_lang_word": "be someone's business",
                                "target_lang_sense_clarification": "to be a matter for someone to deal with"
                            },
                            {
                                "target_lang_word": "affect",
                                "target_lang_sense_clarification": "to have an impact on"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "иметь отношение к кому-либо"
                            },
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "иметь связь с чем-либо"
                            },
                            {
                                "target_lang_word": "быть чьим-то делом",
                                "target_lang_sense_clarification": "касаться чьих-то личных интересов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd36b513-adfc-3a5e-ba79-d3cf7bdc0a37",
                    "sense_definition": "een verbintenis, relatie of formele afspraak beginnen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ondernemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>ging</w> vorig jaar een zakelijk contract <w>aan</w> met dat grote internationale bedrijf.",
                            "target_lang_translations": {
                                "en": "She <w>entered into</w> a business contract with that large international company last year.",
                                "ru": "В прошлом году она <w>заключила</w> деловой контракт с этой крупной международной компанией."
                            }
                        },
                        {
                            "text": "Het is dapper om een nieuwe uitdaging <w>aan</w> te <w>gaan</w> in een vreemd land.",
                            "target_lang_translations": {
                                "en": "It is brave to <w>take on</w> a new challenge in a foreign country.",
                                "ru": "Это смело — <w>принять</w> новый вызов в чужой стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluiten",
                        "beginnen",
                        "ondernemen"
                    ],
                    "common_phrases": [
                        "een contract aangaan",
                        "een relatie aangaan",
                        "een gesprek aangaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to enter into a commitment, relationship, or formal agreement",
                        "ru": "начать обязательство, отношения или формальное соглашение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enter into",
                                "target_lang_sense_clarification": "to formally begin a contract or agreement"
                            },
                            {
                                "target_lang_word": "take on",
                                "target_lang_sense_clarification": "to accept a challenge or responsibility"
                            },
                            {
                                "target_lang_word": "contract",
                                "target_lang_sense_clarification": "to enter into a formal binding agreement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "о договоре или контракте"
                            },
                            {
                                "target_lang_word": "вступать",
                                "target_lang_sense_clarification": "в отношения или спор"
                            },
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "вызов или обязательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47ebccd1-1e79-3d85-8f45-205f763e4cf2",
                    "sense_definition": "naar iemand toe gaan of iemand benaderen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "benaderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt die leraar altijd even <w>aangaan</w> als je vragen hebt over de lesstof.",
                            "target_lang_translations": {
                                "en": "You can always <w>approach</w> that teacher if you have questions about the course material.",
                                "ru": "Ты всегда можешь <w>обратиться</w> к этому учителю, если у тебя есть вопросы по учебному материалу."
                            }
                        },
                        {
                            "text": "Hij besloot de directeur direct <w>aan</w> te <w>gaan</w> om zijn probleem te bespreken.",
                            "target_lang_translations": {
                                "en": "He decided to <w>go to</w> the director directly to discuss his problem.",
                                "ru": "Он решил <w>подойти</w> напрямую к директору, чтобы обсудить свою проблему."
                            }
                        }
                    ],
                    "synonyms": [
                        "benaderen",
                        "opzoeken"
                    ],
                    "common_phrases": [
                        "iemand aangaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to go towards someone or to approach someone",
                        "ru": "подойти к кому-то или обратиться к кому-то"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approach",
                                "target_lang_sense_clarification": "to come near or speak to someone"
                            },
                            {
                                "target_lang_word": "go to",
                                "target_lang_sense_clarification": "to visit or contact someone for help"
                            },
                            {
                                "target_lang_word": "address",
                                "target_lang_sense_clarification": "to speak to someone about a specific issue"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "к кому-либо с вопросом"
                            },
                            {
                                "target_lang_word": "подходить",
                                "target_lang_sense_clarification": "к кому-либо для разговора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32de89f0-7baa-3b4b-bafc-3e827decb450",
                    "sense_definition": "iemand overkomen of gebeuren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overkomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand weet welk lot hem in de verre toekomst zal <w>aangaan</w>.",
                            "target_lang_translations": {
                                "en": "No one knows what fate will <w>befall</w> him in the distant future.",
                                "ru": "Никто не знает, какая судьба <w>постигнет</w> его в далеком будущем."
                            }
                        },
                        {
                            "text": "Het onheil dat de familie <w>aanging</w>, was voor iedereen een grote schok.",
                            "target_lang_translations": {
                                "en": "The disaster that <w>happened to</w> the family was a great shock to everyone.",
                                "ru": "Беда, которая <w>случилась</w> с семьей, стала для всех большим шоком."
                            }
                        }
                    ],
                    "synonyms": [
                        "overkomen",
                        "wedervaren",
                        "gebeuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in formele of literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to happen to someone or befall them",
                        "ru": "случиться или произойти с кем-то"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "befall",
                                "target_lang_sense_clarification": "to happen to someone (formal/literary)"
                            },
                            {
                                "target_lang_word": "happen to",
                                "target_lang_sense_clarification": "to occur to someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "постигать",
                                "target_lang_sense_clarification": "о судьбе или участи"
                            },
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "происходить с кем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
