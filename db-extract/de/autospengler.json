                    {
                        "sense_id": "e91ee4e4-d780-3697-b793-16794703c586",
                        "entry_id": "dbaabebe-7dcd-3a70-a26f-2c42480e4fad",
                        "glosses": [
                            "Person, die beruflich Karosserien von Autos repariert"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "97e612b0-351a-437d-9f77-2d76da7feca1",
                                "sense_id": "e91ee4e4-d780-3697-b793-16794703c586",
                                "text": "„Die Überlegung des Prüfers bestand nun darin, dass ein Autospengler kein Lager hat und daher Ersatzteile immer nur gezielt für konkrete Reparaturaufträge einkauft. Er kann ja nicht wissen, welcher PKW am Folgetag einen Unfall haben wird.“"
                            }
                        ],
