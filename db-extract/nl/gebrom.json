                "senses": [
                    {
                        "sense_id": "90c96f4b-fa1e-373b-bfa1-25f52b0ec45d",
                        "entry_id": "4515b475-a716-32ef-8627-883597ca5753",
                        "glosses": [
                            "een dof trillend geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f23e845f-9406-4289-bd1c-4bbef42b6ee3",
                                "sense_id": "90c96f4b-fa1e-373b-bfa1-25f52b0ec45d",
                                "text": "Het plan heeft geleid tot onrust onder omwonenden. Met name de bewoners van de Charloise Lagedijk vrezen het gebrom en de slagschaduwen die windmolens voortbrengen. De huizen aan de historische dijk liggen het dichtst bij de beoogde locatie."
                            }
                        ]
                    },
                    {
                        "sense_id": "57a5478e-28d9-305a-ba55-30390e89524b",
                        "entry_id": "4515b475-a716-32ef-8627-883597ca5753",
                        "glosses": [
                            "uiting van ontevredenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8a08d46-afd5-4e4c-b3df-c4ed34b02d0a",
                                "sense_id": "57a5478e-28d9-305a-ba55-30390e89524b",
                                "text": "Raskatov maakte er met spaarzaam ingezette instrumenten kale, onheilszwangere muziek bij. Dreigend gespook, geratel, gebrom en gegrom ondersteunt de partij van de imposante bas Nikolaj Didenko, die vaak vol mag uithalen in verontwaardigde klaagkreten."
                            }
                        ]
                    }
