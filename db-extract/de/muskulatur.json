                                        "examples": [
                                            {
                                                "example_id": "d563d167-34eb-491e-8e78-12f33fe11d52",
                                                "sense_id": "47643fdf-4f85-3237-82ec-ca0ecba759d8",
                                                "text": "Lorsque nous sommes en très bonne santé, c’est-à-dire munis de graisses fluides, notre musculature s’entretient d’elle-même naturellement et au niveau auquel nous la sollicitons."
                                            },
                                            {
                                                "example_id": "e770676d-c329-4df3-95b4-54828a72d642",
                                                "sense_id": "47643fdf-4f85-3237-82ec-ca0ecba759d8",
                                                "text": "Ils n'en sont pas moins de véritables sportifs, dotés de musculatures d'athlètes, qui n'ont rien à envier aux footballeurs ou autres rugbymen."
                                            }
                                        ]
                                    }
                                ]
