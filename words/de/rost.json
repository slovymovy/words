                    "semantic_group_id": "korrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das alte Fahrrad stand den ganzen Winter im Regen und hat überall <w>Rost</w> angesetzt."
                        },
                        {
                            "text": "Die eisernen Geländer an der Brücke müssen dringend von dem dicken <w>Rost</w> befreit werden."
                        }
                    ],
                    "synonyms": [
