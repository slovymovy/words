                        "sense_id": "5f492392-717a-31d7-9cee-a72397711453",
                        "entry_id": "6483ffff-69b6-3ba7-bbef-ade9d0751eb7",
                        "glosses": [
                            "A trader, particularly in furs, who worked (and explored) in the area of Canada and the northern United States from the 16th to early 19th centuries; they were often of Quebecois extraction."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6955b4e5-b11e-449b-b63f-891da1db2764",
                                "sense_id": "5f492392-717a-31d7-9cee-a72397711453",
                                "text": "The powers of the Canadian voyageurs and hunters in the consumption of meat strike the greenhorn with wonder and astonishment; and are only equalled by the gastronomical capabilities exhibited by Indian dogs, both following the same plan in their epicurean gorgings."
                            }
                        ]
                    }
                ],
