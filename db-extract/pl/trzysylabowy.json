                                        "entry_id": "81eafbb5-ee6c-3c4a-a2e2-aa8b26cd7539",
                                        "glosses": [
                                            "aus genau drei Silben bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86becd94-51e9-4a89-8b86-8477f20ca67b",
                                                "sense_id": "b0f4a2f4-3539-37e2-a838-2805379595aa",
                                                "text": "„Die meisten Wörter in diesen Sprachen haben nur ein oder zwei Silben; bereits dreisilbige Wörter sind selten.“"
                                            }
