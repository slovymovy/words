{
    "word_family": [
        "stewardship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c156de4a-7def-388f-a30e-8ce5712227b3",
                    "sense_definition": "A passenger assistant on an aircraft or ship, responsible for safety and service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>steward</w> handed out drinks and snacks during the flight.",
                            "target_lang_translations": {
                                "tr": "Uçuş sırasında <w>kamarot</w> içecek ve atıştırmalık dağıttı."
                            }
                        },
                        {
                            "text": "He asked the <w>flight</w> <w>steward</w> for an extra blanket.",
                            "target_lang_translations": {
                                "tr": "<w>Kabin görevlisinden</w> ekstra bir battaniye istedi."
                            }
                        }
                    ],
                    "synonyms": [
                        "flight attendant",
                        "air steward",
                        "airline steward"
                    ],
                    "common_phrases": [
                        "flight steward"
                    ],
                    "target_lang_definitions": {
                        "tr": "Uçakta veya gemide güvenlik ve hizmetten sorumlu yolcu yardımcısı, kamarot veya host."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kamarot",
                                "target_lang_sense_clarification": "gemi veya uçak görevlisi"
                            },
                            {
                                "target_lang_word": "host",
                                "target_lang_sense_clarification": "erkek kabin görevlisi"
                            },
                            {
                                "target_lang_word": "kabin görevlisi",
                                "target_lang_sense_clarification": "uçak hizmet personeli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "327d42ce-05db-31b0-bff7-1f2af2d1c56b",
                    "sense_definition": "An official responsible for managing order, safety, or logistics at a public event, match, or concert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A stadium <w>steward</w> directed the crowd toward the correct exit.",
                            "target_lang_translations": {
                                "tr": "Stadyum <w>görevlisi</w> kalabalığı doğru çıkışa yönlendirdi."
                            }
                        },
                        {
                            "text": "The event <w>steward</w> helped visitors find their reserved seats.",
                            "target_lang_translations": {
                                "tr": "Etkinlik <w>görevlisi</w> ziyaretçilerin ayrılmış koltuklarını bulmalarına yardımcı oldu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stadium steward",
                        "event steward"
                    ],
                    "target_lang_definitions": {
                        "tr": "Halka açık bir etkinlik, maç veya konserde düzen, güvenlik ve lojistikten sorumlu görevli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "görevli",
                                "target_lang_sense_clarification": "etkinlik veya stadyum görevlisi"
                            },
                            {
                                "target_lang_word": "saha komiseri",
                                "target_lang_sense_clarification": "spor müsabakalarında düzeni sağlayan yetkili"
                            },
                            {
                                "target_lang_word": "düzen görevlisi",
                                "target_lang_sense_clarification": "etkinlik alanı yönlendiricisi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1212a3a-82ad-3275-9e8d-757414f11ad7",
                    "sense_definition": "A manager or overseer who takes care of property, finances, or affairs for someone else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served as a faithful <w>steward</w> of the estate for over twenty years.",
                            "target_lang_translations": {
                                "tr": "Yirmi yıldan fazla bir süre mülkün sadık bir <w>kahyası</w> olarak hizmet etti."
                            }
                        },
                        {
                            "text": "The chief <w>steward</w> managed the daily operations of the large house.",
                            "target_lang_translations": {
                                "tr": "Baş <w>kahya</w> büyük evin günlük işlerini yönetiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "caretaker",
                        "custodian"
                    ],
                    "common_phrases": [
                        "chief steward"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başka birinin mülkünü, finansını veya işlerini yöneten ve gözeten kahya veya yönetici."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kahya",
                                "target_lang_sense_clarification": "mülk ve ev yöneticisi"
                            },
                            {
                                "target_lang_word": "yönetici",
                                "target_lang_sense_clarification": "iş veya mülk sorumlusu"
                            },
                            {
                                "target_lang_word": "vekilharç",
                                "target_lang_sense_clarification": "harcamaları ve mali işleri idare eden kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f500a7bc-0702-3189-a8d3-8750ab626fee",
                    "sense_definition": "A worker elected by fellow trade union members to represent them in discussions with management.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop <w>steward</w> negotiated better working hours with the manager.",
                            "target_lang_translations": {
                                "tr": "İş yeri <w>sendika temsilcisi</w>, müdürle daha iyi çalışma saatleri için müzakere etti."
                            }
                        },
                        {
                            "text": "Workers spoke with their union <w>steward</w> about the safety issue.",
                            "target_lang_translations": {
                                "tr": "İşçiler güvenlik sorunu hakkında <w>sendika temsilcileriyle</w> konuştu."
                            }
                        }
                    ],
                    "synonyms": [
                        "shop steward"
                    ],
                    "common_phrases": [
                        "shop steward",
                        "union steward"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yönetimle yapılan görüşmelerde kendilerini temsil etmesi için sendika üyeleri tarafından seçilen çalışan temsilcisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sendika temsilcisi",
                                "target_lang_sense_clarification": "iş yeri sendika temsilcisi"
                            },
                            {
                                "target_lang_word": "iş yeri temsilcisi",
                                "target_lang_sense_clarification": "çalışanları temsil eden görevli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe8da14-e464-373a-a61e-ff15725ef430",
                    "sense_definition": "A person who acts responsibly to protect and care for resources or the environment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humans must act as an environmental <w>steward</w> to protect our planet.",
                            "target_lang_translations": {
                                "tr": "İnsanlar gezegenimizi korumak için bir çevre <w>koruyucusu</w> gibi hareket etmelidir."
                            }
                        },
                        {
                            "text": "The organization works as a good <w>steward</w> of public funds.",
                            "target_lang_translations": {
                                "tr": "Kuruluş, kamu fonlarının iyi bir <w>gözetmeni</w> olarak çalışmaktadır."
                            }
                        }
                    ],
                    "synonyms": [
                        "custodian"
                    ],
                    "common_phrases": [
                        "environmental steward",
                        "good steward"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kaynakları veya çevreyi korumak ve kollamak için sorumlulukla hareket eden koruyucu, muhafız."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "koruyucu",
                                "target_lang_sense_clarification": "çevre veya kaynak koruyucusu"
                            },
                            {
                                "target_lang_word": "muhafız",
                                "target_lang_sense_clarification": "gözeten, kollayan kimse"
                            },
                            {
                                "target_lang_word": "gözetmen",
                                "target_lang_sense_clarification": "kaynakları sorumlu şekilde yöneten kişi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5af4fb8c-d1d1-3385-813c-74bafbb08552",
                    "sense_definition": "To manage, care for, or supervise something responsibly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has successfully <w>stewarded</w> the company through difficult economic times.",
                            "target_lang_translations": {
                                "tr": "Zorlu ekonomik zamanlarda şirketi başarıyla <w>yönetti</w>."
                            }
                        },
                        {
                            "text": "The committee was appointed to <w>steward</w> public funds wisely.",
                            "target_lang_translations": {
                                "tr": "Komite, kamu fonlarını akıllıca <w>idare etmek</w> üzere atandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steward funds",
                        "steward resources"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi sorumlulukla yönetmek, gözetmek veya idare etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yönetmek",
                                "target_lang_sense_clarification": "sorumlulukla idare etmek"
                            },
                            {
                                "target_lang_word": "gözetmek",
                                "target_lang_sense_clarification": "korumak ve idare etmek"
                            },
                            {
                                "target_lang_word": "idare etmek",
                                "target_lang_sense_clarification": "yönetimini üstlenmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4b878a56-7516-3e58-9cbf-aa98a4c5b30b",
                    "sense_definition": "A family name of English origin, derived from the occupational title.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Steward</w> gave an interesting lecture on medieval history.",
                            "target_lang_translations": {
                                "tr": "Profesör <w>Steward</w> ortaçağ tarihi üzerine ilgi çekici bir ders verdi."
                            }
                        },
                        {
                            "text": "I met Mr. <w>Steward</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "tr": "Dün konferansta Bay <w>Steward</w> ile tanıştım."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İngiliz kökenli, meslek unvanından türemiş bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Steward",
                                "target_lang_sense_clarification": "özel soyadı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b177c30-45f4-318d-847d-4cf0d2e729a5",
                    "sense_definition": "A small village located in Lee County, Illinois, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through <w>Steward</w> on their way across Illinois.",
                            "target_lang_translations": {
                                "tr": "Illinois'i geçerken <w>Steward</w> kasabasından arabayla geçtiler."
                            }
                        },
                        {
                            "text": "Few people live in the quiet village of <w>Steward</w>.",
                            "target_lang_translations": {
                                "tr": "Sessiz <w>Steward</w> köyünde çok az insan yaşıyor."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Amerika Birleşik Devletleri'nin Illinois eyaletindeki Lee İlçesinde bulunan küçük bir köy."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Steward",
                                "target_lang_sense_clarification": "yer adı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}