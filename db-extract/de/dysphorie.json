                        "translation_id": "90abdd42-5ec7-469d-924c-e8cbf993db96",
                        "source_entry_id": "4d2bb4f1-1f4e-332f-9fc3-7e3303117713",
                        "source_sense_id": "b882f02c-ad71-3207-842b-5ca010ddf5e8",
                        "source_sense_description": "Medizin, Psychologie: Störung der Affektivität mit misslauniger, gereizter Stimmung",
                        "target_lang_word": "dysphoria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysphoria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                        "entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                                        "glosses": [
                                            "A state of feeling unwell or unhappy; a feeling of emotional and mental discomfort and suffering from restlessness, malaise, depression, or anxiety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a075e993-adf9-4b9f-9705-e85a130177f5",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "body dysphoria"
                                            },
                                            {
                                                "example_id": "fc4540ba-c76a-48b7-8ce0-e4939d89ace7",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "premenstrual dysphoria"
                                            },
                                            {
                                                "example_id": "3722a3d1-fc23-4b0a-a9a6-e75bd381933c",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "weight dysphoria"
                                            },
                                            {
                                                "example_id": "6b2e985f-e898-4a84-ad16-24e63aa9469d",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "Chronic dysphoria can be secondary to a debilitating medical illness, a psychiatric disorder, or both (Akiskal, 1983)."
                                            },
                                            {
                                                "example_id": "abd838f5-690f-4464-82bb-2a132565ae4f",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "As a result of the critical review of the literature by the Work Group on Late Luteal Phase Dysphoric Disorder (LLPDD), it was agreed that the studies reviewed support the view that the predominant feature of LLPDD is the dysphoria that occurs during the premenstrual period."
                                            },
                                            {
                                                "example_id": "7b7ce6f4-b84f-4c19-be55-b88ae03efe13",
                                                "sense_id": "fd3bb36e-6c5c-3ece-8bb2-aa021fd3e68e",
                                                "text": "While the reason for the individual's dysphoria on realizing that he has an STD is a result of lack of acceptance of his sexual orientation, the basis is not religious, and the dysphoria not so pronounced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f1c239-636a-3292-bf4a-db9f0bfb1525",
                                        "entry_id": "aef6d105-eb80-316b-8afa-2d4b2c70f932",
                                        "glosses": [
                                            "Ellipsis of gender dysphoria."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b83ad4b2-3436-4a73-91a5-227f09342695",
                                                "sense_id": "57f1c239-636a-3292-bf4a-db9f0bfb1525",
                                                "text": "height dysphoria"
                                            },
                                            {
                                                "example_id": "e7e0e234-1935-465a-9759-089158a6927a",
                                                "sense_id": "57f1c239-636a-3292-bf4a-db9f0bfb1525",
                                                "text": "bottom dysphoria"
                                            },
                                            {
                                                "example_id": "5f2ae613-c294-4e2a-b052-0deac7fefd75",
                                                "sense_id": "57f1c239-636a-3292-bf4a-db9f0bfb1525",
                                                "text": "voice dysphoria"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
