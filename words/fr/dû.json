        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "661200a6-a70d-3ed9-9b93-b15d0bcb7227",
                    "sense_definition": "Ce qui revient légitimement ou de droit à une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "créance_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des semaines de négociations, il est enfin venu réclamer son <w>dû</w>.",
                            "target_lang_translations": {
                                "en": "After weeks of negotiations, he has finally come to claim his <w>due</w>.",
                                "ru": "После нескольких недель переговоров он наконец пришёл за <w>причитающимся</w>.",
                                "de": "Nach wochenlangen Verhandlungen ist er endlich gekommen, um seinen <w>Anspruch</w> einzufordern.",
                                "es": "Tras semanas de negociaciones, por fin vino a reclamar <w>lo debido</w>.",
                                "zh": "经过几周的谈判，他终于来讨回自己<w>应得的</w>东西。"
                            }
                        },
                        {
                            "text": "L'ouvrier attend patiemment de recevoir son <w>dû</w> pour le travail accompli.",
                            "target_lang_translations": {
                                "en": "The worker waits patiently to receive his <w>due</w> for the work completed.",
                                "ru": "Рабочий терпеливо ждёт, когда ему выплатят <w>причитающееся</w> за выполненную работу.",
                                "de": "Der Arbeiter wartet geduldig darauf, das ihm <w>Geschuldete</w> für die geleistete Arbeit zu erhalten.",
                                "es": "El obrero espera pacientemente recibir <w>lo debido</w> por el trabajo realizado.",
                                "zh": "工人耐心地等着领取完成这项工作的<w>报酬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
