                    {
                        "form_id": "09320bb9-000b-4e50-89e5-debe0203cc3e",
                        "entry_id": "d5b5a44e-d0d4-3285-91a7-c32d2711ec71",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Landesgrenzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                        "entry_id": "d5b5a44e-d0d4-3285-91a7-c32d2711ec71",
                        "glosses": [
                            "territoriale Grenze eines Staates oder Bundeslandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4aacf2-8af4-4c1b-84ea-d71418777bea",
                                "sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                                "text": "Er darf sich nur innerhalb der Landesgrenzen aufhalten."
                            },
                            {
                                "example_id": "ee6a9ed6-09bc-4671-9cc0-8cfb6019fe27",
                                "sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                                "text": "„Die bisherigen Gesetze reichen jedenfalls nicht aus, und die Zuständigkeiten der nationalen Wettbewerbshüter enden an den Landesgrenzen.“"
                            },
                            {
                                "example_id": "8e89e019-00d9-4873-88b3-ade1b6469104",
                                "sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                                "text": "„Etwas nördlicher, ebenfalls im ehemaligen Grenzstreifen, unmittelbar an der Landesgrenze zu Hessen befindet sich ein Eichsfelder Prachtstück, die Burgruine Hanstein.“"
                            },
                            {
                                "example_id": "0a64d785-062b-4ca6-8d49-498b5f0968a0",
                                "sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                                "text": "„Zu den über die Landesgrenzen hinaus berühmten Schreinen gehören etwa der von Lal Shahbaz Qalandar in Sehvan im Sindh, der von Bahauddin Zakariya in Multan und der von Ali Hajvery (Data Ganj Bakhsh) in Lahore.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4849b2fc-a7c1-4f88-b2eb-4d5509648d3b",
                        "source_entry_id": "d5b5a44e-d0d4-3285-91a7-c32d2711ec71",
                        "source_sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                        "source_sense_description": "territoriale Grenze eines Staates oder Bundeslandes",
                        "target_lang_word": "state boundary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f172232c-d2e9-4dfb-a210-aa68c72f37c2",
                        "source_entry_id": "d5b5a44e-d0d4-3285-91a7-c32d2711ec71",
                        "source_sense_id": "95385905-3a37-3bb4-b9b7-94b441d41ac9",
                        "source_sense_description": "territoriale Grenze eines Staates oder Bundeslandes",
                        "target_lang_word": "frontière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                        "entry_id": "50dbab38-a9a1-3cac-9122-2e95894968df",
                                        "glosses": [
                                            "Les limites d’un état ou d’une contrée en tant qu’elles le séparent d’un autre état, d’une autre contrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1124c45a-c313-4529-bee0-66ebb4f1d780",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "Depuis la mi-janvier, le Canada et les États-Unis imposent l’équivalent du passe vaccinal pour traverser la frontière. Un déplacement que les routiers canadiens effectuent régulièrement, puisque la frontière entre les deux pays est longue de 9 000 kilomètres."
                                            },
                                            {
                                                "example_id": "1c589ed5-4e0e-475b-a724-c5ba0b1777d5",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "Une promenade d’une dizaine de minutes sur la plate-forme me permet d’entrevoir les hauteurs de la frontière persane à l’extrême limite de l’horizon."
                                            },
                                            {
                                                "example_id": "8080adf2-eebc-419a-8f51-0b73a5e4174a",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "Cette frontière qu’il fallait défendre contre les Goths et contre les Basques appartenait alors toute entière au roi d’Austrasie, au nom duquel le ban de guerre fut publié sur les deux rives de l’Adour."
                                            },
                                            {
                                                "example_id": "9636b326-7fac-4ddd-88fe-94edba17dd39",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "C’est pourquoi il trouvait que Locarno, situé à la frontière de la Suisse et de l’Italie, était un point qui lui convenait merveilleusement. C’était le centre révolutionnaire où les conspirateurs italiens venaient secrètement s’entretenir avec lui."
                                            },
                                            {
                                                "example_id": "85ce7261-c095-482d-b122-f4cdcf405c48",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "Par ethnicité, je suppose que nous entendons une diversité de groupes ethniques ou « nations » à l’intérieur des frontières territoriales d’un État. Naturellement, cela n’empêche pas l’existence du même groupe ethnique de part et d’autre de plusieurs frontières, comme c’est le cas des Kurdes, par exemple."
                                            },
                                            {
                                                "example_id": "d00b3082-9baf-48ac-ba39-959eda684b07",
                                                "sense_id": "88ae703c-1f78-3c3d-9135-9065ce737269",
                                                "text": "Les frontières ne sont pas des murs blindés. Elles peuvent se faire membranes protectrices et espaces d'interconnexions. Tantôt ouvertes, tantôt fermées; tantôt destinées à échanger, tantôt à préserver de nécessaires autonomies sanitaires et vivrières. À la fois ouvertes et fermées, selon les temps, les lieux et les nécessités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55d96d7-b837-3aa3-9790-e0f9d9091ba3",
                                        "entry_id": "50dbab38-a9a1-3cac-9122-2e95894968df",
                                        "glosses": [
                                            "Représentation de cette limite sur une carte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53decf9-3713-4bc8-b4b2-ec37e1e0db11",
                                                "sense_id": "e55d96d7-b837-3aa3-9790-e0f9d9091ba3",
                                                "text": "Ça m'énerve assez, pour tout dire. Sur une carte, on voit souvent les frontières en grosses lignes noires. La nuit, quand je n'ai vraiment plus rien à faire, je change les lignes en pointillé avec du correcteur liquide. Je fais des points, j'efface les frontières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9c60f74-0655-3d77-b579-eeb2238a7f98",
                                        "entry_id": "50dbab38-a9a1-3cac-9122-2e95894968df",
                                        "glosses": [
                                            "Ce qui sépare une chose d'une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ccb0487-7a23-4903-8b59-860db40d1283",
                                                "sense_id": "c9c60f74-0655-3d77-b579-eeb2238a7f98",
                                                "text": "L’agent voyer avait toujours eu le respect des frontières, des bornes que l’on posa entre les heures du jour comme entre les départements de la France, et il aimait à ne se coucher qu’à minuit juste, de même qu’il s’amusait encore, à la limite du Bourbonnais et du Berry, à poser le pied droit dans le Cher, le pied gauche dans l’Allier, ou bien, le corps dans une province, à ne laisser dans l’autre que son ombre."
                                            },
                                            {
                                                "example_id": "20617b65-e7cc-44e2-a08d-27dbfa66d907",
                                                "sense_id": "c9c60f74-0655-3d77-b579-eeb2238a7f98",
                                                "text": "La vraie question, nous le verrons, est de définir ce qu'était la magie pour les Anciens : science des \"Mages\" ou sorcellerie ? La frontière entre les deux est indécise, certainement autant qu'elle ne l'était, au Moyen-Âge, entre alchimie et science."
                                            },
                                            {
                                                "example_id": "efe26a48-c54f-4bf2-b3d9-f63e23f3f0da",
                                                "sense_id": "c9c60f74-0655-3d77-b579-eeb2238a7f98",
                                                "text": "L'ensemble des dispositions relatives à la protection contre les « cyber-pirates » peut s'avérer parfois inutile, tant il est vrai que la frontière est mince avec le banditisme le « cyber-pirate » n'est alors rien de plus qu'un « cyber-ganster »."
                                            },
                                            {
                                                "example_id": "44644a3a-e68e-472f-ba84-07cb3a50addc",
                                                "sense_id": "c9c60f74-0655-3d77-b579-eeb2238a7f98",
                                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26acd85e-33a8-3ae3-9637-b6e015b51bcb",
                                        "entry_id": "50dbab38-a9a1-3cac-9122-2e95894968df",
                                        "glosses": [
                                            "Limites ; bornes"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19772197-e4fc-46c3-b60a-a9b3b769834a",
                                                "sense_id": "26acd85e-33a8-3ae3-9637-b6e015b51bcb",
                                                "text": "Les frontières du savoir humain."
                                            },
                                            {
                                                "example_id": "41ee6890-62e0-4100-8558-4e5968860f60",
                                                "sense_id": "26acd85e-33a8-3ae3-9637-b6e015b51bcb",
                                                "text": "Reculer les frontières de la sottise, du mauvais goût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf13b5e1-4eb6-33b1-a445-04bcccd78cf0",
                                        "entry_id": "50dbab38-a9a1-3cac-9122-2e95894968df",
                                        "glosses": [
                                            "Ensemble des points de l'adhérence n'appartenant pas à l’intérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200bdfd6-6aae-4d11-ac49-eefe7ace2b07",
                                                "sense_id": "bf13b5e1-4eb6-33b1-a445-04bcccd78cf0",
                                                "text": "Dans le plan, la frontière d’un disque est un cercle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frontière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64829721-5e25-3f32-9bc3-92081d2a6f11",
                                        "entry_id": "ae3a1b46-e344-3d1d-b36b-2ab032db1010",
                                        "glosses": [
                                            "Sorte de coiffe traditionnelle savoyarde des femmes, qui mettait le front en valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423dc465-ced2-449b-9a33-3be9ad9b3778",
                                                "sense_id": "64829721-5e25-3f32-9bc3-92081d2a6f11",
                                                "text": "La couèche (ici on parle de couèchage) vient s'appuyer à l'arrière de la frontière, formant une couronne qu'agrémentent les douze épingles à tête de jais noires piquées tout autour de cette couèche."
                                            },
                                            {
                                                "example_id": "83049a13-8229-4bb7-b212-4f0b8ffce8eb",
                                                "sense_id": "64829721-5e25-3f32-9bc3-92081d2a6f11",
                                                "text": "Cette frontière sera, tous les matins, fixée par des épingles à la « couèche », rond noir porté en couronne sur l'arrière de la tête et composé d'une double tresse de cheveux et ruban, entouré d'un long velours noir tenu par 18 épingles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
