                "senses": [
                    {
                        "sense_id": "26b89b2d-8b39-3e86-b954-f848f1dea9c6",
                        "entry_id": "ae1ecd65-98a8-3d3f-b432-a4419bdd3638",
                        "glosses": [
                            "Bahnkurve, auf der sich ein Mond um seinen Planeten bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c851553-dcb0-4edd-974a-90808aab10b7",
                                "sense_id": "26b89b2d-8b39-3e86-b954-f848f1dea9c6",
                                "text": "„Erst vor eineinhalb Wochen war der deutlich größere Asteroid 2016 QA2 ebenfalls innerhalb der Mondbahn an der Erde vorübergezogen.“"
                            },
                            {
                                "example_id": "f4a38ab1-eea8-4767-8b97-1988637c526e",
                                "sense_id": "26b89b2d-8b39-3e86-b954-f848f1dea9c6",
                                "text": "„Ihr Vater entwickelte für den Selective Sequence Electronic Calculator von IBM Programme zur Berechnung der Mondbahn und erfand zusammen mit Harlan Herrick Speedcoding, das Programmierer von der Notwendigkeit befreite, in der Maschinensprache des Computers zu programmieren.“"
                            },
                            {
                                "example_id": "25eae91c-e406-4d9b-b927-646b9f0587b2",
                                "sense_id": "26b89b2d-8b39-3e86-b954-f848f1dea9c6",
                                "text": "„Sie hatte signifikante Hinweise aus ihren Beobachtungen gewonnen, dass solche Anomalien immerhin auch auf dem Mond auftraten, und, so vermutete sie, auch weit über die Mondbahn hinaus denkbar seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
