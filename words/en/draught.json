{
    "word_family": [
        "draughtsman",
        "draughtsmanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8708cc5-848b-3c94-97b5-8a0ea2fdc726",
                    "sense_definition": "A current of cool air in a room or other enclosed space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could feel a <w>draught</w> coming from the open window.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>сквозняк</w>, идущий от открытого окна.",
                                "pl": "Czuła <w>przeciąg</w> dochodzący z otwartego okna.",
                                "nl": "Ze voelde een <w>tocht</w> vanuit het open raam komen."
                            }
                        },
                        {
                            "text": "Close the door to stop the cold <w>draught</w>.",
                            "target_lang_translations": {
                                "ru": "Закрой дверь, чтобы остановить холодный <w>сквозняк</w>.",
                                "pl": "Zamknij drzwi, żeby zatrzymać zimny <w>przeciąg</w>.",
                                "nl": "Doe de deur dicht om de koude <w>tocht</w> tegen te houden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold draught"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток холодного воздуха в помещении или другом закрытом пространстве.",
                        "pl": "Przepływ chłodnego powietrza w pomieszczeniu lub innej zamkniętej przestrzeni.",
                        "nl": "Een stroom koele lucht in een kamer of andere afgesloten ruimte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквозняк",
                                "target_lang_sense_clarification": "поток воздуха, возникающий при открытии окон или дверей"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeciąg",
                                "target_lang_sense_clarification": "przepływ powietrza powstający między otwartymi oknami lub drzwiami"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tocht",
                                "target_lang_sense_clarification": "koude luchtstroom in een binnenruimte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30544f85-5233-3893-abc9-227267113544",
                    "sense_definition": "Beer served from a cask or keg rather than a bottle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They serve excellent <w>draught</w> beer at the local pub.",
                            "target_lang_translations": {
                                "ru": "В местном пабе подают отличное <w>разливное</w> пиво.",
                                "pl": "W lokalnym pubie serwują wyśmienite <w>piwo lane</w>.",
                                "nl": "Ze serveren uitstekend <w>tapbier</w> in het lokale café."
                            }
                        },
                        {
                            "text": "Would you prefer a bottle or <w>draught</w>?",
                            "target_lang_translations": {
                                "ru": "Вы предпочитаете бутылочное или <w>разливное</w>?",
                                "pl": "Wolisz butelkowe czy <w>lane</w>?",
                                "nl": "Wil je liever een flesje of <w>van de tap</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draught beer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пиво, подаваемое из бочки или кега, а не в бутылках.",
                        "pl": "Piwo podawane z beczki lub kegu, a nie z butelki.",
                        "nl": "Bier dat uit een vat getapt wordt in plaats van uit een fles geserveerd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливное пиво",
                                "target_lang_sense_clarification": "пиво, которое наливают из крана (кега)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "piwo z nalewaka",
                                "target_lang_sense_clarification": "piwo serwowane bezpośrednio z instalacji barowej"
                            },
                            {
                                "target_lang_word": "piwo lane",
                                "target_lang_sense_clarification": "potoczne określenie piwa z beczki"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tapbier",
                                "target_lang_sense_clarification": "bier getapt uit een fust"
                            },
                            {
                                "target_lang_word": "bier van het vat",
                                "target_lang_sense_clarification": "vers getapt vatbier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "685187a3-c9be-3055-9f6b-0d99dec9621e",
                    "sense_definition": "A game piece used in the game of draughts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He moved his <w>draught</w> across the board.",
                            "target_lang_translations": {
                                "ru": "Он передвинул свою <w>шашку</w> по доске.",
                                "pl": "Przesunął swojego <w>warcaba</w> po planszy.",
                                "nl": "Hij schoof zijn <w>damschijf</w> over het bord."
                            }
                        },
                        {
                            "text": "The player lost a <w>draught</w> during the match.",
                            "target_lang_translations": {
                                "ru": "Игрок потерял <w>шашку</w> во время матча.",
                                "pl": "Gracz stracił <w>warcaba</w> podczas partii.",
                                "nl": "De speler verloor een <w>damsteen</w> tijdens de wedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "checker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игровая фигура, используемая в игре в шашки.",
                        "pl": "Figurka używana w grze w warcaby.",
                        "nl": "Een speelstuk gebruikt bij het damspel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шашка",
                                "target_lang_sense_clarification": "игровая фигура в шашках"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "warcab",
                                "target_lang_sense_clarification": "pionek używany w grze w warcaby"
                            },
                            {
                                "target_lang_word": "pionek",
                                "target_lang_sense_clarification": "ogólne określenie figury na planszy"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "damschijf",
                                "target_lang_sense_clarification": "schijf gebruikt bij dammen"
                            },
                            {
                                "target_lang_word": "damsteen",
                                "target_lang_sense_clarification": "speelstuk voor het damspel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed29859-e27d-365e-ab48-48c6c3e2309d",
                    "sense_definition": "An outbuilding used as a lavatory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cottage had a small <w>draught</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "У старого коттеджа в саду был небольшой <w>уличный туалет</w>.",
                                "pl": "Stary domek miał w ogrodzie mały <w>wychodek</w>.",
                                "nl": "Het oude huisje had een klein <w>buitentoilet</w> in de tuin."
                            }
                        },
                        {
                            "text": "They walked to the <w>draught</w> behind the house.",
                            "target_lang_translations": {
                                "ru": "Они пошли к <w>уличному туалету</w> за домом.",
                                "pl": "Poszli do <w>wychodka</w> za domem.",
                                "nl": "Ze liepen naar de <w>plee</w> achter het huis."
                            }
                        }
                    ],
                    "synonyms": [
                        "outhouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an old-fashioned or historical term for an outhouse."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее название отдельно стоящего туалета на улице.",
                        "pl": "Przestarzałe określenie na wolnostojącą toaletę zewnętrzną.",
                        "nl": "Een vrijstaand buitengebouwtje dat dienstdoet als toilet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уличный туалет",
                                "target_lang_sense_clarification": "туалет, расположенный вне жилого дома"
                            },
                            {
                                "target_lang_word": "сортир",
                                "target_lang_sense_clarification": "просторечное или устаревшее название туалета"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wychodek",
                                "target_lang_sense_clarification": "zewnętrzna toaleta, często w formie budki"
                            },
                            {
                                "target_lang_word": "sławojka",
                                "target_lang_sense_clarification": "potoczne określenie wiejskiego ustępu"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "buitentoilet",
                                "target_lang_sense_clarification": "toilet buiten het hoofdgebouw"
                            },
                            {
                                "target_lang_word": "plee",
                                "target_lang_sense_clarification": "ouderwets of informeel buitentoilet"
                            },
                            {
                                "target_lang_word": "outhouse",
                                "target_lang_sense_clarification": "afzonderlijk toiletgebouwtje"
                            }
                        ]
                    },
                    "common_phrases": [
                        "draught-house"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "788add4b-e5d9-3f03-ad2f-32a111ccc096",
                    "sense_definition": "Relating to beer or cider served from a cask or keg.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a pint of <w>draught</w> ale.",
                            "target_lang_translations": {
                                "ru": "Мы заказали пинту <w>разливного</w> эля.",
                                "pl": "Zamówiliśmy pintę <w>lanego</w> ale.",
                                "nl": "We bestelden een pint ale <w>van het vat</w>."
                            }
                        },
                        {
                            "text": "The pub is famous for its <w>draught</w> cider.",
                            "target_lang_translations": {
                                "ru": "Паб славится своим <w>разливном</w> сидром.",
                                "pl": "Pub słynie ze swojego <w>lanego</w> cydru.",
                                "nl": "De pub staat bekend om zijn cider <w>van de tap</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "draught ale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к пиву или сидру, подаваемому из бочки или кега.",
                        "pl": "Dotyczący piwa lub cydru serwowanego z beczki lub kegu.",
                        "nl": "Met betrekking tot bier of cider dat uit een vat geschonken wordt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливной",
                                "target_lang_sense_clarification": "о напитках, продаваемых на розлив"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "lane",
                                "target_lang_sense_clarification": "przymiotnik określający napój serwowany z nalewaka"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "van de tap",
                                "target_lang_sense_clarification": "geschonken uit een tapinstallatie"
                            },
                            {
                                "target_lang_word": "van het vat",
                                "target_lang_sense_clarification": "afkomstig uit een fust"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1011ff66-756d-308a-adfc-c78289476d0d",
                    "sense_definition": "To prepare a preliminary version of a document.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will <w>draught</w> the new policy next week.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>составит черновик</w> новой политики на следующей неделе.",
                                "pl": "Komitet <w>sporządzi projekt</w> nowej polityki w przyszłym tygodniu.",
                                "nl": "De commissie zal volgende week het nieuwe beleid <w>opstellen</w>."
                            }
                        },
                        {
                            "text": "They had to <w>draught</w> the agreement before the meeting.",
                            "target_lang_translations": {
                                "ru": "Им нужно было <w>набросать</w> соглашение до начала встречи.",
                                "pl": "Musieli <w>naszkicować</w> umowę przed spotkaniem.",
                                "nl": "Ze moesten de overeenkomst vóór de vergadering <w>ontwerpen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготовить предварительную версию документа.",
                        "pl": "Przygotować wstępną wersję dokumentu.",
                        "nl": "Een voorlopige versie of concept van een document opstellen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять черновик",
                                "target_lang_sense_clarification": "писать предварительный вариант документа"
                            },
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "делать предварительную запись или проект"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sporządzić projekt",
                                "target_lang_sense_clarification": "napisać wstępną wersję dokumentu"
                            },
                            {
                                "target_lang_word": "naszkicować",
                                "target_lang_sense_clarification": "przygotować ogólny zarys tekstu"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opstellen",
                                "target_lang_sense_clarification": "een conceptversie van een tekst schrijven"
                            },
                            {
                                "target_lang_word": "ontwerpen",
                                "target_lang_sense_clarification": "een eerste opzet van een document maken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}