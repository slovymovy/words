                    {
                        "sense_id": "0b702172-2f3f-379b-b20f-63e1f5c433f6",
                        "entry_id": "504130fc-bb0a-39ee-a914-ac4192ad1df9",
                        "glosses": [
                            "Agrume originaire d’Indonésie, qui a un léger goût de citronnelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f1142d-1c66-48c3-b6a3-01f57318d2c4",
                                "sense_id": "0b702172-2f3f-379b-b20f-63e1f5c433f6",
                                "text": "L'hiver austral nous prive des sublimes litchis, mangues ou longanes, mais on s'émerveille devant les piles d'ananas victoria, le rouge profond des goyaviers, les caramboles aux formes étoilées, les agrumes locaux comme le tangor à la peau vert orangé, le minuscule citron galet ou le combawa fripé."
                            },
                            {
                                "example_id": "9bf65ad9-b261-4e7a-9d81-db66b2fb2b01",
                                "sense_id": "0b702172-2f3f-379b-b20f-63e1f5c433f6",
                                "text": "Mon préféré, c’est le combawa, fameux en digestif, dans les crêpes ou dans le riz au lait."
                            }
                        ]
                    }
                ],
