                "senses": [
                    {
                        "sense_id": "8ec4490e-2071-3ae9-a338-e91ac888100f",
                        "entry_id": "f78a35a4-6eca-37ee-b0aa-c342a87c2530",
                        "glosses": [
                            "bitch (promiscuous woman)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d6decd32-e84d-4154-909a-5565dab3d6c6",
                                "sense_id": "8ec4490e-2071-3ae9-a338-e91ac888100f",
                                "text": "a teraz to coś szczerze i między nami - mój mąz zdradził mnie z suczą (kobiety wchodzące w trójkąty to sucze...) która obiektywnie jest ode mnie brzydsza.",
                                "translation": "And now it's something sincerely and between us — my husband cheated on me with a bitch (women entering into triangles are bitches…), who is objectively uglier than me.",
                                "english": "And now it's something sincerely and between us — my husband cheated on me with a bitch (women entering into triangles are bitches…), who is objectively uglier than me."
                            }
                        ]
                    },
                    {
                        "sense_id": "35be4b5f-bda9-3053-a521-76ddf9d9f738",
                        "entry_id": "f78a35a4-6eca-37ee-b0aa-c342a87c2530",
                        "glosses": [
                            "bitch (despicable or disagreeable, aggressive person, usually a woman)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "914fe708-e86b-40a1-9993-a938cb0b0f31",
                                "sense_id": "35be4b5f-bda9-3053-a521-76ddf9d9f738",
                                "text": "Tak, trzeba sucz trzymać krótko, bo zacznie się panoszyć, pyskować, wymagać.",
                                "translation": "Yes, the bitch has to be held short, or she'll start to boss around, to mouth off, to demand.",
                                "english": "Yes, the bitch has to be held short, or she'll start to boss around, to mouth off, to demand."
                            },
                            {
                                "example_id": "ce833826-5c6a-4e95-ab79-9a12d7c018e0",
                                "sense_id": "35be4b5f-bda9-3053-a521-76ddf9d9f738",
                                "text": "Ma w sobie wiele z suczy. Uwielbia naciągać ludzi, wkręcać i opowiadać im urojone historie, które przez swój debilizm są tak irracjonalne, że mam chęć strzelić sobie w łeb, a w pozostawioną po kuli dziurkę wlać domestosa.",
                                "translation": "She has quite a lot from a bitch. She likes to embellish people, screw them and tell them imagined stories, which due to their moronism are so irrational, that I want to just shoot myself in the head, and in the hole left by theh bullet to pour Domestos in.",
                                "english": "She has quite a lot from a bitch. She likes to embellish people, screw them and tell them imagined stories, which due to their moronism are so irrational, that I want to just shoot myself in the head, and in the hole left by theh bullet to pour Domestos in."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bb9ba87-1fe3-3b38-b44c-62c335a72d65",
                        "entry_id": "f78a35a4-6eca-37ee-b0aa-c342a87c2530",
                        "glosses": [
                            "bitch (female canine)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "d9fcb82d-a2d9-4408-b9f8-6ab647d399f6",
                                "sense_id": "8bb9ba87-1fe3-3b38-b44c-62c335a72d65",
                                "text": "Wyobrażała sobie chłopaków, z którymi spała, facetów mijanych na ulicy. Zlizywali z jej ciała wyginającego się w łuk swoją działkę. Ssali ją jak sucz, odgryzając z zachłanności sutki.",
                                "translation": "She imagines boys, who she was sleeping with, guys passing by in the streets. They licked their fix off from her body bowing in an arch. They sucked her like a bitch, biting off nipples from rapacity.",
                                "english": "She imagines boys, who she was sleeping with, guys passing by in the streets. They licked their fix off from her body bowing in an arch. They sucked her like a bitch, biting off nipples from rapacity."
                            },
                            {
                                "example_id": "f0a96af4-bfd2-46c4-a7b5-ff2e4377fd3b",
                                "sense_id": "8bb9ba87-1fe3-3b38-b44c-62c335a72d65",
                                "text": "Parę tygodni temu poszłam ze swoim psem (3[–]letnia suka boksera) wieczorem na wybieg dla psów — było pusto i ciemno, to uznałam, że się sucz wybiega.",
                                "translation": "A few weeks ago I went with my dog (3-year-old female of a boxer) in the evening to a dog enclosure — it was empty and dark, so I thought, let the bitch run out.",
                                "english": "A few weeks ago I went with my dog (3-year-old female of a boxer) in the evening to a dog enclosure — it was empty and dark, so I thought, let the bitch run out."
                            }
                        ]
                    }
