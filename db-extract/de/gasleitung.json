                                                "sense_id": "e1443e50-8d00-3fa4-92af-79f65592447d",
                                                "text": "Call before you dig — there is a gas line buried in the area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda710c9-fe4e-3a8c-a616-e7d7f8e22c32",
