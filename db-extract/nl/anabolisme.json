                            }
                        ]
                    },
                    {
                        "translation_id": "8de0b594-274e-4682-a455-b8d5703992fb",
                        "source_entry_id": "d1e39af0-9f95-3d78-a186-22e572d48b41",
                        "source_sense_id": "08910928-977a-32cb-85c7-5590dfbbac2a",
                        "source_sense_description": "opbouw bij de stofwisseling waarbij simpele stoffen omgezet worden tot chemisch ingewikkeldere stoffen",
