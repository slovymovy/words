                        "données du problème"
                    ]
                },
                {
                    "sense_id": "5aca7726-b512-35cb-9509-dfe9f1323ab8",
                    "sense_definition": "Question complexe qui exige un examen approfondi ou suscite de vifs débats politiques et sociaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chômage des jeunes reste un <w>problème</w> majeur dans plusieurs pays du continent."
                        },
                        {
                            "text": "Les élus locaux cherchent à traiter ce <w>problème</w> de société avec le plus grand sérieux."
                        }
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "problème de société",
                        "problème majeur"
                    ]
                },
                {
                    "sense_id": "d83b6a38-2601-3794-a222-95061f056ce3",
                    "sense_definition": "Jeu d'esprit, énigme ou casse-tête proposé dans la presse ou dans les jeux de réflexion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon père tente toujours de trouver la solution du <w>problème</w> d'échecs dans le quotidien."
                        },
                        {
                            "text": "Elle consacre une demi-heure chaque matin à un <w>problème</w> de logique très stimulant."
                        }
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "problème de logique"
                    ]
                },
                {
                    "sense_id": "4ecc3717-c9ce-329a-a58b-bc9025c592ab",
                    "sense_definition": "Personne, caractère ou conduite dont la nature est indéfinissable et difficile à concevoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dirigeant imprévisible reste un <w>problème</w> que même ses conseillers n'arrivent pas à déchiffrer."
                        },
                        {
                            "text": "Même après tant d'années, cet homme demeure pour ses collègues un <w>problème</w> indéchiffrable."
                        }
                    ]
                }
            ]
        }
