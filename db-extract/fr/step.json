                "forms": [
                    {
                        "form_id": "b2927243-cc7e-400b-965e-12da0648bb76",
                        "entry_id": "a76fd260-b015-341a-b474-c9267d4de80f",
                        "tags": [
                            "plural"
                        ],
                        "form": "steps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d824f753-1430-3df4-a4e3-74bcc1a662e7",
                        "entry_id": "a76fd260-b015-341a-b474-c9267d4de80f",
                        "glosses": [
                            "Accessoire de mise en forme, de fitness, ressemblant à une marche sur laquelle on monte et on descend."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b90478f2-a44e-4506-a3a3-af919b80493f",
                                "sense_id": "d824f753-1430-3df4-a4e3-74bcc1a662e7",
                                "text": "Départ derrière le step sur l adroite, on monte pied gauche puis droit au centre du step puis on descend à gauche derrière le step, pied gauche puis droit."
                            }
                        ]
                    },
                    {
                        "sense_id": "81897081-e78a-3c44-8fc4-06492449369d",
                        "entry_id": "a76fd260-b015-341a-b474-c9267d4de80f",
                        "glosses": [
                            "Technique de mise en forme aérobique utilisant cet accessoire."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "ab2a4b8f-bb05-4f7f-a338-d41976580c7c",
                                "sense_id": "81897081-e78a-3c44-8fc4-06492449369d",
                                "text": "J’allais aussi faire du step ou de la course pour entretenir mon endurance de base."
                            },
                            {
                                "example_id": "a6cddc93-903e-481c-bf69-d75398d521f6",
                                "sense_id": "81897081-e78a-3c44-8fc4-06492449369d",
                                "text": "Certains cours de step ont été créés sur une musique à 3 temps, mais ce n’est pas l’objet de ce livre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "24110aa5-1449-332c-9bf8-79ce6859aa16",
                "word": "step",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a6e7e75-a1d3-4d0b-a90c-fe1b0a00b263",
