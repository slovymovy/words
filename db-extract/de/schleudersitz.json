                                            {
                                                "example_id": "a9e85ce4-2277-42bf-a760-4bfdeed48f26",
                                                "sense_id": "67411625-7fa4-3952-be73-d13380eb2ee3",
                                                "text": "Ils s’apprêtent à sortir le pilote quand l’un d’eux découvre la poignée derrière sa tête, ignorant tout du siège éjectable, et la tire brutalement !"
                                            },
                                            {
                                                "example_id": "adb715b1-3a0e-405b-a223-6cfd6d27633b",
                                                "sense_id": "67411625-7fa4-3952-be73-d13380eb2ee3",
                                                "text": "Gad vérifia que tout était en ordre, m’expliqua le fonctionnement du siège éjectable, m’indiquant quels gestes j’aurais à faire en cas de danger et s’il me le commandait : « Vous êtes assis sur une véritable bombe, ne touchez à cette poignée pour rien au monde. »"
                                            }
                                        ]
                                    },
