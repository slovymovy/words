                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5829a10c-0409-417a-8d81-378942a8b98d",
                                                "sense_id": "4d287504-0787-371f-9582-2cf22166c372",
                                                "text": "Vorige week werd duidelijk dat bij het Vijfpartijenakkoord is afgesproken dat de bezuiniging wordt teruggedraaid. Er komt 44 miljoen beschikbaar zodat de eerste consulten bij een voedingsdeskundige toch weer kunnen worden gedeclareerd."
                                            },
                                            {
                                                "example_id": "1a9ba9c9-b7d4-467e-8f24-a015eff75f97",
                                                "sense_id": "4d287504-0787-371f-9582-2cf22166c372",
                                                "text": "Oremans, tegenwoordig voedingsdeskundige en parttime tennislerares, vertelt verder hoe Navratilova een rode draad voor haar werd, hoe een oefenpotje waar ze geen zin in had toch heel belangrijk was voor Roland Garros 1994 en hoe het kwam dat ze na de zege op Navratilova in de eerste ronde alleen achterbleef in Parijs en mede daardoor in de derde ronde verloor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "279b7476-f8a9-49c3-ab97-5ee3a706c73a",
                        "source_entry_id": "3c09880a-9daf-3695-a12a-366b1d4c163c",
                        "source_sense_id": "3819aae4-9a9b-3813-9b5d-4d73fc14153b",
