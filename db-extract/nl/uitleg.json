                        "target_lang_word": "Erklärung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erklärung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b409592-2b1a-3306-a3a9-fe7b53e48b61",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Aufschluss über Zusammenhänge, Sachverhalte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21bb7a45-4756-45d8-9b51-c2675e62a8f6",
                                                "sense_id": "9b409592-2b1a-3306-a3a9-fe7b53e48b61",
                                                "text": "Eine Bedienungsanleitung enthält eine Erklärung der Funktion des Gerätes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "offizielle Mitteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b3c1bb-93fa-4418-8937-f1cf3e5da66b",
                                                "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                                "text": "In seiner Erklärung teilt der Minister mit, dass er an den bisherigen politischen Zielen festhalten wird."
                                            },
                                            {
                                                "example_id": "8e0d2d6d-5ca6-4fea-9002-d1e9f138acf7",
                                                "sense_id": "3d345ad9-5400-364d-9261-f3cca285383c",
                                                "text": "„Um eine solche Erklärung herbeizuführen, richtete sie es so ein, dass die jungen Leute vor dem Hochamt beim Bischof zusammenkamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "00970a8f-5e83-3ea0-80bf-7c4781ca9d27",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Erläuterung der Bedeutung eines Wortes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7473706d-0f90-451d-9526-adf71743af4e",
                                                "sense_id": "00970a8f-5e83-3ea0-80bf-7c4781ca9d27",
                                                "text": "In Wörterbüchern findet man auch eine Erklärung der Bedeutung der Wörter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee0785a0-bbbc-30c7-9f15-3decaeb2701e",
                                        "entry_id": "0447e63a-511a-3924-b3c8-f9663d8b020f",
                                        "glosses": [
                                            "Nachweis, dass ein Sachverhalt oder ein Prozess unter Berücksichtigung von Randbedingungen so sein muss, wie er beobachtet wurde, weil bestimmte Gesetze gelten"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c16a4e7-489d-4c00-b5a2-c5637bbefbfe",
                                                "sense_id": "ee0785a0-bbbc-30c7-9f15-3decaeb2701e",
                                                "text": "Eine Erklärung liegt - grob gesprochen - dann vor, wenn man weiß, warum etwas so ist, wie es ist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
