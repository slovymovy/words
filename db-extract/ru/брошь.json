                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb4719e0-a57f-3b55-9df7-e0572790fcb6",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
