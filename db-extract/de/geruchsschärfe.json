                "senses": [
                    {
                        "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                        "entry_id": "8f4016d0-9d97-3b90-be98-0cb117ab7218",
                        "glosses": [
                            "scharfer Geruch; geruchliche Wahrnehmung scharfer Geruchsstoffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0aee033-36f9-48b5-8c92-f2406b2e2c65",
                                "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                                "text": "„Jetzt wird das Substrat thermisch behandelt, um ihm die extreme Geruchsschärfe zu nehmen, so Klein.“"
                            },
                            {
                                "example_id": "85226788-2bfe-457d-8cf0-3a761ebe3151",
                                "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                                "text": "„Selbst die im landwirtschaftlichen Bereich ausgebrachte und viel umstrittene Gülle kann ebenfalls über mikrobiologische Veränderungen positiv beeinflusst werden, was sich u.a. durch eine verminderte Geruchsschärfe und bessere Pflanzenverträglichkeit zeigen kann.“"
                            },
                            {
                                "example_id": "794d2338-7f4e-48fc-9271-33074edb8560",
                                "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                                "text": "„Allein durch die Geruchsschärfe der Inhaltsstoffe werden Marder, Ratten, Wühlmäuse & Co. effektiv und dauerhaft aus den zu schützenden Bereichen ferngehalten.“"
                            },
                            {
                                "example_id": "039bd7af-d94f-4a42-a913-d7ddddfd123f",
                                "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                                "text": "„Die Geruchsschärfe der Molche verschiedenen reinen Duftstoffen gegenüber entspricht ungefähr der des Menschen.“"
                            },
                            {
                                "example_id": "ddf6b37d-84c6-4927-90f7-ae2f8025e91d",
                                "sense_id": "407b056c-bcbb-342b-8fbc-ec225c55f2df",
                                "text": "„Viele Leute glauben, dass die menschliche Geruchsschärfe und -spezifität abgenommen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
