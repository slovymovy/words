                        "glosses": [
                            "Au Japon, guerrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ecc2748-6e2c-4e93-9dcf-e490946a555d",
                                "sense_id": "8f70330b-1edd-3648-ba6d-83c1987583c6",
                                "text": "L’époque de Kamakura marque une période de rupture avec le long règne de la culture et de la société aristocratique ayant pour centre la Cour de Kyôto, ainsi que de remaniements politiques et économiques à travers le développement de la nouvelle classe des guerriers (bushi)."
                            },
                            {
                                "example_id": "e2780625-9ea0-4c9e-8794-68bacfe11f86",
                                "sense_id": "8f70330b-1edd-3648-ba6d-83c1987583c6",
                                "text": "Un grand homme, disait son père, d’une grande noblesse, un vrai bushi qui comprenait le sens du sacrifice et de l’autorité."
                            }
                        ]
                    }
                ],
