                        "target_lang_word": "sud-ouest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sud-ouest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93928edd-7910-3abf-a463-d8743b1a5a23",
                                        "entry_id": "837e61e7-2639-3649-8cd6-51b9ed55c683",
                                        "glosses": [
                                            "Point de l’horizon qui est entre le sud et l’ouest. Il correspond à l'azimut 225°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94fb970-6e7a-4d4d-934e-f9a7e7248334",
                                                "sense_id": "93928edd-7910-3abf-a463-d8743b1a5a23",
                                                "text": "La ville de Saumur se trouve au sud-ouest de Paris."
                                            },
                                            {
                                                "example_id": "a9f2da99-157f-4661-8896-a525eaf01d5c",
                                                "sense_id": "93928edd-7910-3abf-a463-d8743b1a5a23",
                                                "text": "Des averses, voire des orages, se produisent du sud-ouest au centre-est, ainsi que le long des Ardennes."
                                            },
                                            {
                                                "example_id": "50967503-6117-4542-b25c-66d5e2a91637",
                                                "sense_id": "93928edd-7910-3abf-a463-d8743b1a5a23",
                                                "text": "Cependant, le moteur tournait aisément au régime de 1.620 tours-minute, et notre vol en avant était facilité par un vent du sud-ouest."
                                            },
                                            {
                                                "example_id": "a50ac181-2585-45b1-963b-a0faf40f77db",
                                                "sense_id": "93928edd-7910-3abf-a463-d8743b1a5a23",
                                                "text": "Dès le 14 au matin, une effroyable tourmente du sud-ouest vint assaillir ces escadres, et, soulevant une mer monstrueuse, leur fit courir les plus grands périls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c62174-72cb-3304-aa5e-17e02d3c654c",
                                        "entry_id": "837e61e7-2639-3649-8cd6-51b9ed55c683",
                                        "glosses": [
                                            "Vent qui souffle d’entre le sud et l’ouest."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1b205da-32d5-4be1-a119-9270175b7976",
                                                "sense_id": "03c62174-72cb-3304-aa5e-17e02d3c654c",
                                                "text": "Le sud-ouest est ordinairement violent et pluvieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sud-ouest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7025286-c2f7-34ba-82cb-12e9c4265e1d",
                                        "entry_id": "c240cee6-6b46-3f9f-bdeb-c72cdf03e0da",
                                        "glosses": [
                                            "Qui vient du sud-ouest."
