                ],
                "senses": [
                    {
                        "sense_id": "ef9fc718-5d76-3822-b3e3-f966b5a5f305",
                        "entry_id": "f0dd4481-6494-3566-ab72-af5d5855aa92",
                        "glosses": [
                            "neulateinische Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe21444-34a6-4ac1-b2c7-3b8518a60af2",
                                "sense_id": "ef9fc718-5d76-3822-b3e3-f966b5a5f305",
                                "text": "Denn die Späthumanisten suchten die Modernität des Neulatein dadurch zu erweisen, daß sie die zeitgemäßen volkssprachlichen Formen wie Tragikomödie, Romanzo oder Sonett lateinisch imitierten und assimilierten."
                            },
                            {
                                "example_id": "0268c6f8-12d9-4d8c-b7a8-3527c3d97849",
                                "sense_id": "ef9fc718-5d76-3822-b3e3-f966b5a5f305",
                                "text": "Wie hoch die Zahl derer ist, die in Neulatein Predigtbücher, Gedichte oder Prosa verfasst haben, ist kaum abschätzbar. Töchterle geht von „gigantischen Beständen“ und bis zu „Hunderttausenden, auch weniger bedeutenden, Autoren“ aus."
                            },
                            {
                                "example_id": "8bb7ca2d-4653-4210-b8a7-9f90c31ba2b7",
                                "sense_id": "ef9fc718-5d76-3822-b3e3-f966b5a5f305",
                                "text": "Durch das Aufkommen der Nationalliteraturen verfiel das Neulatein allmählich."
                            },
                            {
                                "example_id": "4f30bb5d-9f6e-443f-b676-db5472b8f8f3",
                                "sense_id": "ef9fc718-5d76-3822-b3e3-f966b5a5f305",
                                "text": "„Bis in das 19. Jahrhundert hinein blieb das Neulatein die vorherrschende Sprache botanischer Schriften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
