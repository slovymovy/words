                "senses": [
                    {
                        "sense_id": "e462399b-5754-3d8d-b855-a1bfe2dd0f32",
                        "entry_id": "d554220f-adfe-3b68-bf0c-6f9ebb993849",
                        "glosses": [
                            "Person, die Kinder vergewaltigt; Kinderschänder, Pädophiler"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "bf8a1e1e-1fdc-4e98-ac29-fe900bcbd103",
                                "sense_id": "e462399b-5754-3d8d-b855-a1bfe2dd0f32",
                                "text": "„Ed war außerdem niemand, der einen Kinderficker verteidigte ... das hatte er schon vor Jahren in einer dunklen Seitenstraße unmissverständlich klargestellt.“"
                            },
                            {
                                "example_id": "c1c9cf23-9f83-4320-8232-b123c1a08a8c",
                                "sense_id": "e462399b-5754-3d8d-b855-a1bfe2dd0f32",
                                "text": "„Einchecken bei den Kinderfickern, Vergewaltigern und Deppen? Schutzhaft? Spinnst du?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
