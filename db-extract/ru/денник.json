                ],
                "senses": [
                    {
                        "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                        "entry_id": "3ce17ac7-a02d-395b-8bdd-fd89fbe07942",
                        "glosses": [
                            "рег. спец. отдельное просторное стойло для крупного домашнего скота (чаще — для верховых лошадей в конюшне)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c6cc74-2aa6-4fb7-8a30-4a2d84e9d24d",
                                "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                                "text": "В деннике стоял вороной конь."
                            },
                            {
                                "example_id": "ef67f5ae-6882-4d7a-8e59-f037684bfee7",
                                "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                                "text": "Вычистить денник."
                            },
                            {
                                "example_id": "cd4bbc10-6742-4f72-b7d8-dcdb287793ab",
                                "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                                "text": "А до того у лошадей в денниках арканы поотвязал, заворины отложил, потом всему скоту ворота распахнул да в огороды и запустил: ступайте, животинки Божьи, на все четыре стороны ― я вам больше не хозяин и не кормилец…"
                            },
                            {
                                "example_id": "f461610a-1206-4f0b-b2b5-4393b5d22ec8",
                                "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                                "text": "Расседлал иноходку, хлопнул по крупу, велев идти в свой денник, и пешком направился к шатру."
                            },
                            {
                                "example_id": "bc8cc237-2c7f-4a47-bf00-b981adf08167",
                                "sense_id": "1229d2fa-bdc3-35f6-a0f3-5608638108a9",
                                "text": "В тесном деннике замшевый, дымчато-белый ослёнок ростом с табуретку топал копытцем в опилки."
                            }
                        ]
                    }
                ],
