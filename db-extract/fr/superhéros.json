                        ],
                        "form": "superhéroïne"
                    },
                    {
                        "form_id": "a3141aa9-ed59-4cbd-b383-c774a191cd37",
                        "entry_id": "dbf95cb8-54a7-3fc1-9999-072f6a092bf3",
