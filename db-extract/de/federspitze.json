                        "entry_id": "d42bc630-2877-394c-a359-8cc797b3c14b",
                        "glosses": [
                            "gespaltener, metallischer Kopf eines Füllfederhalters, der die Tinte gleichmäßig zuführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3d58ea-61cd-461a-866d-5113ad4c81f4",
                                "sense_id": "2479437b-bcaa-39e4-8d73-42cc40ecf450",
                                "text": "„So war die Feder nun nicht mehr eine Vogel-Federspitze, sondern eine Federspitze aus Metall, welche nun stabiler und langlebiger war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
