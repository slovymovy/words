{
    "word_family": [
        "pecker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "235d4d58-933b-3cc5-844f-b0857b8d1c8e",
                    "sense_definition": "To strike or pierce with the beak or bill of a bird.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bird_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry birds <w>pecked</w> at the seeds on the ground.",
                            "target_lang_translations": {
                                "cs": "Hladoví ptáci <w>zobali</w> semínka na zemi."
                            }
                        },
                        {
                            "text": "The rooster <w>pecked</w> at the wooden fence while looking for insects.",
                            "target_lang_translations": {
                                "cs": "Kohout <w>kloval</w> do dřevěného plotu, když hledal hmyz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peck at food"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udeřit nebo bodnout zobákem (u ptáků); sbírat potravu zobákem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zobat",
                                "target_lang_sense_clarification": "sbírat zrní či potravu zobákem"
                            },
                            {
                                "target_lang_word": "klovat",
                                "target_lang_sense_clarification": "útočit či bodat zobákem"
                            },
                            {
                                "target_lang_word": "vyzobávat",
                                "target_lang_sense_clarification": "zobáním vybírat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "750296f5-917f-33d3-8655-bef06a6b739d",
                    "sense_definition": "To kiss briefly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kiss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>pecked</w> him on the cheek before leaving for work.",
                            "target_lang_translations": {
                                "cs": "Než odešla do práce, <w>dala mu pusu</w> na tvář."
                            }
                        },
                        {
                            "text": "They <w>pecked</w> each other goodbye at the train station.",
                            "target_lang_translations": {
                                "cs": "Na nádraží se na rozloučenou letmo <w>políbili</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peck on cheek"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dát někomu krátký, rychlý polibek (hubičku)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dát pusu",
                                "target_lang_sense_clarification": "rychle a letmo políbit"
                            },
                            {
                                "target_lang_word": "vlepit hubičku",
                                "target_lang_sense_clarification": "krátký polibek"
                            },
                            {
                                "target_lang_word": "cmrndnout",
                                "target_lang_sense_clarification": "letmo políbit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61725f42-4ce6-3372-b0b3-46fc50ac2b9f",
                    "sense_definition": "To type by searching for each key individually.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "typing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He still <w>pecks</w> at the keyboard with only two fingers.",
                            "target_lang_translations": {
                                "cs": "Stále do klávesnice jen <w>datluje</w> dvěma prsty."
                            }
                        },
                        {
                            "text": "It takes a long time to <w>peck</w> out a message on this old machine.",
                            "target_lang_translations": {
                                "cs": "Trvá dlouho <w>vyťukat</w> zprávu na tomto starém stroji."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peck at keyboard"
                    ],
                    "target_lang_definitions": {
                        "cs": "Psát na klávesnici pomalu, hledáním jednotlivých kláves (zpravidla jedním či dvěma prsty)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "datlovat",
                                "target_lang_sense_clarification": "psát na klávesnici dvěma prsty"
                            },
                            {
                                "target_lang_word": "vyťukávat",
                                "target_lang_sense_clarification": "pomalu psát klávesu po klávese"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7f6cb12-02e6-3942-a53a-4c3ac2651f32",
                    "sense_definition": "A unit of dry measure equal to one quarter of a bushel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer sold a <w>peck</w> of apples at the market.",
                            "target_lang_translations": {
                                "cs": "Farmář na trhu prodal <w>peck</w> jablek."
                            }
                        },
                        {
                            "text": "She bought a <w>peck</w> of potatoes for the winter.",
                            "target_lang_translations": {
                                "cs": "Koupila si na zimu <w>čtvrt bušlu</w> brambor."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Historická jednotka objemu sypkých látek rovnající se čtvrtině bušlu (přibližně 9 litrů)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "peck",
                                "target_lang_sense_clarification": "angloamerická dutá míra (cca 9 litrů)"
                            },
                            {
                                "target_lang_word": "čtvrtka bušlu",
                                "target_lang_sense_clarification": "přepočet jednotky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cac6e0ca-caa1-35b2-a8ad-6ded7c23b400",
                    "sense_definition": "A large or excessive quantity of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a whole <w>peck</w> of problems to deal with today.",
                            "target_lang_translations": {
                                "cs": "Dnes musí vyřešit celou <w>hromadu</w> problémů."
                            }
                        },
                        {
                            "text": "There is a <w>peck</w> of work waiting for us on Monday.",
                            "target_lang_translations": {
                                "cs": "V pondělí na nás čeká <w>spousta</w> práce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peck of trouble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velké, značné množství něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hromada",
                                "target_lang_sense_clarification": "velké množství"
                            },
                            {
                                "target_lang_word": "spousta",
                                "target_lang_sense_clarification": "velké množství"
                            },
                            {
                                "target_lang_word": "kopec",
                                "target_lang_sense_clarification": "přeneseně velký počet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}