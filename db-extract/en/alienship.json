                "senses": [
                    {
                        "sense_id": "a27b057b-5154-3889-bf23-ea162fae0192",
                        "entry_id": "a9de6c18-5748-3b4f-85c3-f20b241de316",
                        "glosses": [
                            "The state or status of being alien."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c22d8115-4920-40f2-926d-bfa5f0ce9774",
                                "sense_id": "a27b057b-5154-3889-bf23-ea162fae0192",
                                "text": "The stipulations of international treaties relative to citizenship, alienship, naturalization, rights and obligations of aliens, remain unprejudiced."
                            },
                            {
                                "example_id": "a9884890-fa83-4361-96cc-69528d05d81f",
                                "sense_id": "a27b057b-5154-3889-bf23-ea162fae0192",
                                "text": "The law of alienship is not in harmony with the law of nations. For by the law of alienship foreigners are excluded from the right of succession in the case of the goods of a dead citizen or even of a foreigner who dies in alien territory, nor can they be appointed heirs in a will nor can legacies be left to them, and consequently if there is no one who can become heir by virtue of the laws of that place, the goods of the deceased, as goods of nobody, go by right of occupation to the ruler of the state representing the treasury."
                            },
                            {
                                "example_id": "6059e2f1-77f9-4bf5-aad7-18bd40930886",
                                "sense_id": "a27b057b-5154-3889-bf23-ea162fae0192",
                                "text": "We return to the twofold relation between man and the 'other animals', which seems to be one of kinship and one of alienship."
                            }
                        ]
                    }
                ],
