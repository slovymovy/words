                                        "sense_id": "d4da1ba3-083a-3103-a620-88213896ec33",
                                        "entry_id": "ec585604-0c23-366e-b0d8-d5eedf0b9a27",
                                        "glosses": [
                                            "Sans comparaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d517aa7-78e3-41c2-b8bb-590676a02060",
                                                "sense_id": "d4da1ba3-083a-3103-a620-88213896ec33",
                                                "text": "Cette valeur, incomparablement supérieure à celle du rendement des haut-parleurs à rayonnement direct, explique son emploi dans les grandes salles de cinéma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a81571c-8180-396e-b156-12a23bb4ea74",
                                        "entry_id": "ec585604-0c23-366e-b0d8-d5eedf0b9a27",
                                        "glosses": [
                                            "Beaucoup. Note d’usage : Ordinairement suivi par un adverbe de comparaison, comme plus, mieux, moins."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65cddf2a-5dfa-4754-a79b-1be7b3ab410f",
                                                "sense_id": "4a81571c-8180-396e-b156-12a23bb4ea74",
                                                "text": "... et pour cette cause elle est incomparablement plus claire, plus facile et moins sujette à erreur..."
                                            },
                                            {
                                                "example_id": "fd6d12d3-c573-406b-86de-f410f6514655",
                                                "sense_id": "4a81571c-8180-396e-b156-12a23bb4ea74",
                                                "text": "...des parties incomparablement plus petites..."
                                            },
                                            {
                                                "example_id": "101738bd-c021-477d-8e55-c1aa57f0c62a",
                                                "sense_id": "4a81571c-8180-396e-b156-12a23bb4ea74",
                                                "text": "Qui leur eût dit qu’il y avait une sorte de navigation incomparablement plus parfaite […] vous pouvez compter qu’ils ne l’eussent jamais cru."
                                            },
                                            {
                                                "example_id": "7877dc1a-3cdd-48eb-8844-2316fc4f1167",
                                                "sense_id": "4a81571c-8180-396e-b156-12a23bb4ea74",
                                                "text": "La terre est un globe dont le rayon n'est pas de sept millions de mètres ; le soleil est incomparablement plus gros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
