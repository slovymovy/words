                    },
                    {
                        "translation_id": "ab75b047-da58-46ac-816f-52f9de4b6e32",
                        "source_entry_id": "37633eb0-e475-33ee-9961-714c6983c2ec",
                        "source_sense_id": "a1320deb-d6ce-3c15-a632-a3b4b35f01b8",
