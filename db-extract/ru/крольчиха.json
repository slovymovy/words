                                                "sense_id": "52066b61-fd75-3db9-bd98-9e317bba0959",
                                                "text": "A doe from round a spruce stood looking at them\nAcross the wall, as near the wall as they.\nShe saw them in their field, they her in hers."
                                            },
                                            {
                                                "example_id": "c0211b57-d201-49a4-8862-365c0ec1287a",
                                                "sense_id": "52066b61-fd75-3db9-bd98-9e317bba0959",
                                                "text": "The city recently carried out a deer census, determining there are 313 stags (males), 798 does (females) and 214 fawns (babies) in Nara Park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b44dc67-5e56-3439-8a25-362bb322a087",
