                        ],
                        "form": "den Kontrollverlust"
                    },
                    {
                        "form_id": "3f723779-82ef-4653-8ead-6dd830097e2f",
                        "entry_id": "f90f6208-310e-3257-971b-643132c5531a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kontrollverluste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                        "entry_id": "f90f6208-310e-3257-971b-643132c5531a",
                        "glosses": [
                            "teilweises oder totales Verschwinden der Herrschaft (= die Kontrolle) über etwas (beispielsweise seine Person / Persönlichkeit, ein Gefängnis, den Gegner in einem Fußballspiel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb312a32-fa42-47ad-b554-e9e10dab54be",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "Mit einem epileptischem Anfall geht sehr häufig ein Kontrollverlust einher."
                            },
                            {
                                "example_id": "9ba24301-c79f-4d5a-94b4-4caf0dd2b860",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "Unter Drogen oder erheblichen Mengen Alkohols erleiden sie zwangläufig einen Kontrollverlust."
                            },
                            {
                                "example_id": "ab584cad-6d3b-4ecf-9ebf-ad3f2e986d4c",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "„Stotternde Menschen haben es nicht einfach. Das Schlimmste ist der vom Betroffenen katastrophal wahrgenommene unvorhersehbare Kontrollverlust, erklärt [der Therapeut Wolff] von Gudenberg.“"
                            },
                            {
                                "example_id": "b9e7a40b-86c8-4a67-9b80-5d7b7c503998",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "Wer auf regennasser Fahrbahn zu schnell fährt muss mit einem Kontrollverlust über sein Auto rechnen."
                            },
                            {
                                "example_id": "af149b58-a69d-4295-b822-b572176495d3",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "Aber Recht und Gesetz [müssen] durchgesetzt werden – und Chemnitz ist nicht der erste gravierende Schwächeanfall des deutschen Rechtsstaats. Die Krawalle am G20-Gipfel in Hamburg 2017 waren genauso ein staatlicher Kontrollverlust mit Ansage."
                            },
                            {
                                "example_id": "49df5918-776e-4aa7-aa3e-3d6ac836111e",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "[Zwänge oder zwanghaftes Verhalten] können ein grosses Sicherheitsbedürfnis, auch die Furcht vor Kontrollverlust oder allgemein Angst zugrunde liegen."
                            },
                            {
                                "example_id": "8be961c0-8da7-474d-9d91-5e440bf0edec",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "„Brexit und Trump: Die Idee der Moderne, alles berechen- und beherrschbar zu machen, sei gescheitert, sagt der Soziologe Hartmut Rosa im Gespräch. Der Kontrollverlust hat Folgen.“"
                            },
                            {
                                "example_id": "b97923d0-7089-4396-be22-9769832ec35e",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "Kontrollverlust in einem Gefängnis? Das geht gar nicht."
                            },
                            {
                                "example_id": "d4652c73-8e12-4191-8516-888ee6ef56c0",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "„Wegen chaotischer Zustände hat die britische Regierung ein privat geführtes Gefängnis in Birmingham wieder unter staatliche Kontrolle gestellt. Inspekteure berichteten von Gewalt, Drogen und einem Kontrollverlust der Sicherheitsleute.“"
                            },
                            {
                                "example_id": "e27a900b-7e13-4067-8f13-f42daa017316",
                                "sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                                "text": "„[Werder Bremen Trainer Florian Kohlfeld nach dem Fußballspiel gegen VfL Wolfsburg:] »Wir hatten immer wieder Phasen mit Kontrollverlust, deshalb war ich nicht vollständig zufrieden«, bilanzierte der Coach […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14c2d2fe-d58b-4eee-a982-1efecacee8a6",
                        "source_entry_id": "f90f6208-310e-3257-971b-643132c5531a",
                        "source_sense_id": "143f4ee8-142f-3b64-b529-302c6afcf5e8",
                        "target_lang_word": "tailspin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tailspin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e496ad1-6e35-3d57-b615-c8c2108ff68e",
                                        "entry_id": "f184c20e-2389-3964-ac98-728402d776b1",
                                        "glosses": [
                                            "The rapid, uncontrollable descent of an aircraft in a steep spiral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603f125d-284c-4dbb-a0bf-03375fd38d42",
                                                "sense_id": "2e496ad1-6e35-3d57-b615-c8c2108ff68e",
                                                "text": "The loss of the third engine threw the plane into a tailspin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b210ca6-10df-3ad2-9581-07e17c0c77d5",
                                        "entry_id": "f184c20e-2389-3964-ac98-728402d776b1",
                                        "glosses": [
                                            "A severe mental or emotional collapse; emotional breakdown."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34df5fdd-ac9e-4280-bcef-d9e71eb1962f",
                                                "sense_id": "4b210ca6-10df-3ad2-9581-07e17c0c77d5",
                                                "text": "Just hours after leaving the institution, she suffered another tailspin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b328967-8816-3489-874a-832d1fb84c3e",
                                        "entry_id": "f184c20e-2389-3964-ac98-728402d776b1",
                                        "glosses": [
                                            "Any sharp, sustained, often uncontrollable descent or decline."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4124badb-7497-4ca4-b5bc-fb83c627334e",
                                                "sense_id": "5b328967-8816-3489-874a-832d1fb84c3e",
                                                "text": "The present stock tailspin proves bankruptcy is imminent."
                                            },
                                            {
                                                "example_id": "6ab057ae-bea3-41c7-8826-acd910cae7c1",
                                                "sense_id": "5b328967-8816-3489-874a-832d1fb84c3e",
                                                "text": "But I was reading a statement that either you made or was part of your movie, “An Inconvenient Truth”, and it said we have just 10 years to avert a major catastrophe that could send our entire planet into a tailspin of epic destruction involving extreme weather, floods, droughts, epidemics and killer heat waves beyond anything we have ever experienced."
                                            },
                                            {
                                                "example_id": "f211af9c-914a-43ee-9cee-be7e190fa9eb",
                                                "sense_id": "5b328967-8816-3489-874a-832d1fb84c3e",
                                                "text": "St. Louis, the fourth-largest U.S. city in 1900, is fading fast […] . Jobs, and airline, an educated population—all gone or in a tailspin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tailspin",
