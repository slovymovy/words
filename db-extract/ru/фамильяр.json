                "senses": [
                    {
                        "sense_id": "d81bbce5-f283-31ae-a127-952179193cd8",
                        "entry_id": "f7b11c60-8d39-35b4-9d83-a6e76c211cad",
                        "glosses": [
                            "мифол. волшебный дух-оборотень, согласно средневековым западноевропейским поверьям, служивший ведьмам, колдунам и другим практикующим магию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f59fdd5-ef6c-434c-ac2f-b482d3347cb5",
                                "sense_id": "d81bbce5-f283-31ae-a127-952179193cd8",
                                "text": "Фамильяр – волшебный помощник, служивший ведьмам, магам и колдунам. Фамильяры помогали колдунам и ведьмам по хозяйству, в бытовых делах, как шпионы, но также при случае могли помочь околдовать кого-нибудь."
                            }
                        ]
                    }
                ],
