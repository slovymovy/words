                        "examples": [
                            {
                                "example_id": "6634ec6a-65d5-4673-a88f-6c6b9dc80d8e",
                                "sense_id": "5b8783f0-687f-3482-97e0-e3759a042a85",
                                "text": "De Brit heeft al twee keer olympisch goud op de sprint en teamsprint, zijn topsnelheid is niet te evenaren dit toernooi. Precies daarom kiest Büchli steeds het wiel van de Brit, ook in races hiervoor, toen er twee keer werd afgeschoten omdat renners hun zenuwen niet in bedwang konden houden en de derny - een gangmaker op een brommer - te vroeg passeerden."
                            },
                            {
                                "example_id": "ec14a6c0-750d-49fc-a527-a5c305fc63a8",
                                "sense_id": "5b8783f0-687f-3482-97e0-e3759a042a85",
                                "text": "„Het is in het begin altijd even wennen. Ik ben in de eerste plaats wegrenner, dus ik ga tijdens het seizoen ook niet trainen op de baan. Dat betekent dat ik nu een week voorbereidingstijd heb op de zesdaagse van Amsterdam. Vorige week begon ik rondjes te rijden achter de derny (gangmaker, red.) en zo kom je langzaam weer in het ritme van de baan.”"
                            }
                        ]
                    }
