                        "entry_id": "465dcbcb-fbe4-375e-bf1a-0d0f6a68f966",
                        "glosses": [
                            "A close-fitting sleeveless jacket, descending below the hips, worn over armour."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7e488309-fbe9-4bfd-bc02-d85e1810727a",
                                "sense_id": "c53db2d5-eeaa-3717-aa3d-6a704543c885",
                                "text": "Some wore coat armour, imitating scale,\nAnd next their skins were stubborn shirts of mail;\nSome wore a breastplate and a light juppon,\nTheir horses clothed with rich caparison;"
                            },
                            {
                                "example_id": "89414046-8fdd-4afb-bb33-6ec25b4f2f09",
                                "sense_id": "c53db2d5-eeaa-3717-aa3d-6a704543c885",
                                "text": "He climbed three marble steps, crossed the terrace and entered a dim foyer, where a chamberlain silently helped him from his helmet, his jupon and his chain cuirass."
                            }
                        ]
                    },
