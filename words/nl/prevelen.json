                    "sense_definition": "op een zachte, onduidelijke manier woorden uitspreken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man zat in de hoek van de kamer zachtjes voor zich uit te <w>prevelen</w>.",
                            "target_lang_translations": {
                                "en": "The old man sat in the corner of the room softly <w>muttering</w> to himself.",
                                "ru": "Старик сидел в углу комнаты, тихо <w>бормоча</w> себе под нос."
                            }
                        },
                        {
                            "text": "De man <w>prevelde</w> een kort gebed en verliet daarna langzaam het graf.",
                            "target_lang_translations": {
                                "en": "The man <w>murmured</w> a short prayer and then slowly left the grave.",
                                "ru": "Мужчина <w>пробормотал</w> короткую молитву и затем медленно покинул могилу."
                            }
                        }
                    ],
                    "synonyms": [
                        "mompelen"
                    ],
                    "common_phrases": [
                        "een gebed prevelen",
                        "onverstaanbaar prevelen",
                        "zachtjes prevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To speak words in a soft, indistinct manner, often to oneself or as a prayer.",
                        "ru": "произносить слова тихо и невнятно, часто про себя или в качестве молитвы"
                    },
                    "translations": {
