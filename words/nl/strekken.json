                            },
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "на пользу или в честь"
                            },
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "достижению результата"
                            }
                        ]
                    }
                }
            ]
