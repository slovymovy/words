                        "glosses": [
                            "Qui peut être oralisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4718294-3e5f-44a5-8b15-17155968c941",
                                "sense_id": "d61c1512-0a84-3d89-b2ed-ae5afa61d85d",
                                "text": "Après le IIᵉ siècle environ, [l’hébreu] cesse d’être parlé mais il reste employé chez les juifs comme langue liturgique (oralisable) et, parfois, comme langue littéraire (également oralisable)."
                            },
                            {
                                "example_id": "1687dcab-c6e4-429c-a22f-dfbcbc411391",
                                "sense_id": "d61c1512-0a84-3d89-b2ed-ae5afa61d85d",
                                "text": "Le conte est au départ un genre oral, ce n’est que tardivement qu’il est devenu un genre écrit, mais toujours oralisable, telle la mère qui lit un conte le soir à son enfant."
                            },
                            {
                                "example_id": "10408873-79b6-4c94-9b4c-2b836aabdecd",
                                "sense_id": "d61c1512-0a84-3d89-b2ed-ae5afa61d85d",
                                "text": "Cette réforme est beaucoup moins dramatique qu'on ne le dit, car elle se réduit à un jeu d'écriture : elle n'est pas oralisable."
                            }
                        ]
                    }
