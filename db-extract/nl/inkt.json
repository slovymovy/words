                    },
                    {
                        "translation_id": "5ad62b99-90f8-4d0a-b6df-7859d997cb1d",
                        "source_entry_id": "14b6dc73-7d4d-30ab-aad5-2b89c6781447",
                        "source_sense_id": "eeafb20f-0a43-3768-966f-92b653c93da5",
                        "source_sense_description": "een gekleurde vloeistof waarmee geschreven wordt",
                        "target_lang_word": "encre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                        "entry_id": "0231bafa-f208-3463-bab0-ad26137a292c",
                                        "glosses": [
                                            "Liquide ordinairement noir dont on se sert pour écrire, pour imprimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512f0b70-bb25-48bf-9620-432315387649",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Le tactac des linos emplissait leurs oreilles. Fagerolle […] connaissait cette odeur poussiéreuse de plomb et de papier chargé d’encre fraîche."
                                            },
                                            {
                                                "example_id": "db23bb20-8abe-4a75-8f66-df87bc2bb6b8",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Il y avait vraiment une malédiction du Ciel sur les ganaches de sacristie qui n’appréhendaient pas de manier une plume. Leur encre se muait aussitôt en une pâte, en un galipot, en une poix qui engluaient tout."
                                            },
                                            {
                                                "example_id": "998f8402-9b6e-4d7b-a704-161579557db5",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Cette terrible histoire des Vaudois, dois-je en parler ou m'en taire ? En parler ? Elle est trop cruelle ; personne ne la racontera sans que la plume n'hésite, et que l’encre, en écrivant, ne blanchisse de larmes."
                                            },
                                            {
                                                "example_id": "4dff1f42-65dc-4ce0-a323-0abef208be73",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Je soutiendrai mon opinion jusqu’à la dernière goutte de mon encre."
                                            },
                                            {
                                                "example_id": "76d3d76b-b41e-4dd9-87f9-55c3098ead8e",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Mais je vois venir sur le soir Notre astronomique Émilie, Avec un vieux tablier noir, Et la main d’encre encor salie."
                                            },
                                            {
                                                "example_id": "931a7b02-693e-480b-8f36-1a9912e54acf",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "— Mille soupçons plus noirs que l’encre s’emparèrent de son imagination."
                                            },
                                            {
                                                "example_id": "1ea03a29-0375-4c30-b5c6-f3171018d1dc",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Cœur d’encre"
                                            },
                                            {
                                                "example_id": "3330f96b-17d5-4962-a3c4-925c836a915a",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Sang d’encre"
                                            },
                                            {
                                                "example_id": "dd3b2b7e-6501-4be0-b33f-e28a6d3f415c",
                                                "sense_id": "f2a89eb1-11a9-3ef4-a0cd-ee336d5dff82",
                                                "text": "Mort d’encre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c23ded2-ff42-3c9c-b06e-717ffb125ba3",
                                        "entry_id": "0231bafa-f208-3463-bab0-ad26137a292c",
                                        "glosses": [
                                            "Substance très foncée projetée dans l’eau par les poulpes, seiches et calmars pour échapper à un prédateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "889ef9a7-2929-4091-9028-2df8b8e9e07a",
                                                "sense_id": "5c23ded2-ff42-3c9c-b06e-717ffb125ba3",
                                                "text": "Du côté des rochers, j’aperçois Ouma qui fouille avec son harpon dans les anfractuosités, et le nuage d’encre qui monte."
                                            },
                                            {
                                                "example_id": "92c8bee7-1a32-4096-bec5-f05a5dbe68ee",
                                                "sense_id": "5c23ded2-ff42-3c9c-b06e-717ffb125ba3",
                                                "text": "Le lion a ses dents et ses griffes ; l’éléphant, le sanglier ont leurs défenses, le taureau a ses cornes, la sèche a son encre, qui lui sert à brouiller l’eau autour d’elle ; la nature n’a donné à la femme pour se défendre et se protéger que la dissimulation ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e258a2-ec96-3e5b-8ed4-c7e494e5921b",
                                        "entry_id": "0231bafa-f208-3463-bab0-ad26137a292c",
                                        "glosses": [
                                            "Maladie provoquant des écoulements noirâtres ; écoulement noirâtre en question."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db4b6d7f-6dc7-4eed-a02a-d5ff2575dc9c",
                                                "sense_id": "e3e258a2-ec96-3e5b-8ed4-c7e494e5921b",
                                                "text": "[…] nécrose cambiale en flamme au collet entourée d'un liseret ^([sic]) noir avec parfois écoulement de sève noire oxydée à l'air (d'où le nom d'encre). Ce symptôme est rare sur châtaignier (il n'a pas le temps de s'exprimer avant la mort de l'arbre)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "encre",
                                "target_lang_code": "fr",
