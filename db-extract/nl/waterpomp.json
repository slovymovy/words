                    }
                ],
                "translations": [
                    {
                        "translation_id": "12238210-baa1-4079-aae5-45c12869c943",
                        "source_entry_id": "284712f3-5d93-3628-bd02-089667afd78a",
                        "source_sense_id": "47ab70c4-df36-361e-9e67-363574fcf261",
                        "source_sense_description": "werktuig om water te verplaatsen",
                        "target_lang_word": "Wasserpumpe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserpumpe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5b892c-55a6-3258-8a77-e40d01931f1d",
                                        "entry_id": "baa9e1df-a9a4-334e-a60a-f56231de4e70",
                                        "glosses": [
                                            "Pumpe, die zur Förderung von Wasser verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc47bdc-7950-4d8f-ad39-c50283053dbe",
                                                "sense_id": "fe5b892c-55a6-3258-8a77-e40d01931f1d",
                                                "text": "„Die Wasserpumpe steht im Hinterhof, ebenso das Plumpsklo.“"
                                            },
                                            {
                                                "example_id": "9c9fb19b-8220-4eff-99cd-054cc1f4bc4a",
                                                "sense_id": "fe5b892c-55a6-3258-8a77-e40d01931f1d",
                                                "text": "„Draußen war die Wasserpumpe mit einem Brett, das über zwei niedrige Mauern gelegt war, darüber hing eine Art Handtuch.“"
                                            },
                                            {
                                                "example_id": "060a3f2a-ffea-4374-9146-b0cb1bd3b37e",
                                                "sense_id": "fe5b892c-55a6-3258-8a77-e40d01931f1d",
                                                "text": "„Leere Häuser stehn hier unverschlossen, auf Plätzen voll Gras und steinigen Böden, ein Zaun, ein Gehölz, eine Wasserpumpe, ein paar Vogelbeerbäume schräg im Wind.“"
                                            },
                                            {
                                                "example_id": "fcfe1dfe-a1c0-460e-bd3b-f01ce322402d",
                                                "sense_id": "fe5b892c-55a6-3258-8a77-e40d01931f1d",
                                                "text": "„Da gibt es einen ganz bestimmten Geruch nach feuchter Erde, er erinnert mich zuverlässig an die Wasserpumpe in Amalias Garten, die an der Seite des Hauses angebracht ist und immer tropft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3996c534-cfdb-4ef0-b56f-2efc3d137d05",
                        "source_entry_id": "284712f3-5d93-3628-bd02-089667afd78a",
                        "source_sense_id": "47ab70c4-df36-361e-9e67-363574fcf261",
                        "source_sense_description": "werktuig om water te verplaatsen",
                        "target_lang_word": "water pump",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "water pump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13c31b11-f682-3530-9df3-e3b511b87988",
                                        "entry_id": "9124c30c-a4ed-3c69-bd83-cdde460f7a4e",
                                        "glosses": [
                                            "A pump for raising or circulating water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc3e314a-7f2f-4b25-a15f-8576f6c497f5",
                                                "sense_id": "13c31b11-f682-3530-9df3-e3b511b87988",
                                                "text": "I cautiously raised the hood, freed a hoodful of smoke-steam, but there was no flame. As the smoke blew away I leaned over the radiator. I didn't expect to see anything that made sense to me; I don't know a distributor from a water pump."
                                            },
                                            {
                                                "example_id": "01edd3ef-692f-4001-a728-cae851c12195",
                                                "sense_id": "13c31b11-f682-3530-9df3-e3b511b87988",
                                                "text": "Following a 24 hours’ incubation in a cold room at the temperature of 4° C the samples were agitated and then filtered through membranae Synpor 6 of 24 mm dia. by means of a water pump."
                                            },
                                            {
                                                "example_id": "5a58c71e-b93d-4c13-be1e-0294d14398f9",
                                                "sense_id": "13c31b11-f682-3530-9df3-e3b511b87988",
                                                "text": "A remoisturizing shower does not work if the water pump is not on."
                                            },
                                            {
                                                "example_id": "1b1005eb-281b-433a-b6ae-152ec83e337e",
                                                "sense_id": "13c31b11-f682-3530-9df3-e3b511b87988",
                                                "text": "Toilet stations and a restroom and shower unit, along with the six water pumps scattered throughout the two sites, give all campers easy access."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
