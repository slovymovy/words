                                    },
                                    {
                                        "sense_id": "75a20ef0-ed03-3d54-a189-7b2ff2738563",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "Delivery, in speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81fa28f-fdc6-4880-8c7e-d812ec6afb37",
                                                "sense_id": "75a20ef0-ed03-3d54-a189-7b2ff2738563",
                                                "text": "the words are chosen , their sound ample , the composition full , the absolution plenteous"
                                            }
                                        ]
