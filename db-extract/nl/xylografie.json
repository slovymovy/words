                    {
                        "translation_id": "d50f211e-9a9a-4260-b355-73e689b3e4d4",
                        "source_entry_id": "c45ddef0-7500-3998-95e1-908102dd966d",
                        "source_sense_id": "98703357-03cd-3f7f-b988-da7338c66c3e",
