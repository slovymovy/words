                                        "entry_id": "2d0b1051-76fe-3304-a13b-ef786e7d33bf",
                                        "glosses": [
                                            "mindestens eine Million Einheiten einer Währung besitzend/kostend (beispielsweise eine Million Euro)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3d7c0d-f6ea-4427-97a3-f832b834e9ed",
                                                "sense_id": "94b32ab1-6104-3553-84e0-2b61f0d0983f",
                                                "text": "„Parteigünstlinge erhalten millionenschwere Staatsaufträge — und führen sie häufig nicht aus.“"
                                            },
                                            {
                                                "example_id": "a6024271-59fd-4c59-afb1-859f3228242e",
                                                "sense_id": "94b32ab1-6104-3553-84e0-2b61f0d0983f",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
