                                        "entry_id": "a1953065-3cec-396e-a1e2-77475b0e03cc",
                                        "glosses": [
                                            "To use a condom for protection in sexual intercourse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78cc307-8d2e-43ab-a8c2-67da512f9492",
                                                "sense_id": "34202b46-54bd-3e75-aa5a-dc7f085c5e75",
                                                "text": "They take the medication when they are not feeling well and some take the medication everyday^([sic]) but they don't condomize."
                                            }
