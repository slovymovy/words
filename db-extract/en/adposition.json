                                    {
                                        "sense_id": "8e3cd755-b11b-30d7-a70d-a77a97d944f6",
                                        "entry_id": "883ed999-ca48-3b03-a4c3-c999b44d2a80",
                                        "glosses": [
                                            "Mot-outil que l’on utilise accolé à un mot ou un groupe nominal pour expliciter son sens dans une phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7293b527-401b-4d22-aa8d-9e3063454559",
                                                "sense_id": "8e3cd755-b11b-30d7-a70d-a77a97d944f6",
                                                "text": "Il a travaillé deux ans durant. : le mot en gras est une adposition, dans ce cas une postposition."
                                            },
                                            {
                                                "example_id": "0f472b6a-494e-4ba9-a2dc-776754d7c44b",
                                                "sense_id": "8e3cd755-b11b-30d7-a70d-a77a97d944f6",
                                                "text": "Elle est sortie avec moi, Elle est sortie sans moi, Elle est sortie après moi, Elle est sortie avant moi, Elle est sortie devant moi. : tous les mots en gras sont des adpositions, dans ce cas des prépositions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d1b4d09-9cda-4f3f-9f22-75eeb7a22605",
