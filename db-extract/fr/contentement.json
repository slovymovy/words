        "fr-extract.jsonl": [
            {
                "entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                "word": "contentement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3bcc3b21-5dfd-4a22-9a5d-51019e0d64a2",
                        "entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                        "tags": [
                            "plural"
                        ],
                        "form": "contentements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                        "entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                        "glosses": [
                            "État de celui qui est content, satisfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd699e5-af68-42b7-96bb-37093c3db741",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "[…], mais on peut aussi être tout à la fois très riche et très malheureux, car l’argent ne donne ni la santé, ni le contentement de soi-même, et il ne préserve pas de l’ennui, cette plaie des oisifs opulents."
                            },
                            {
                                "example_id": "1c28fd9c-4961-4174-ad23-014dac9491bd",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "Rougon lui-même se laissa prendre à ce contentement de l’homme illettré qui voit ses enfants devenir plus savants que lui."
                            },
                            {
                                "example_id": "14ff22fb-a36c-4eb4-a579-e65302d7fcf3",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "Un chaud contentement lui venait, grâce à cette demi-bouteille de Pouilly."
                            },
                            {
                                "example_id": "3d142dd1-1bce-4d5f-be79-24408e99acc2",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "Angelo avait surveillé avec grand soin l’ébullition de l’eau pour le thé. Il montra aussi beaucoup de contentement personnel du sac de farine de maïs, de la cassonade et de douze œufs durs qu’il avait eu l’esprit de faire préparer."
                            },
                            {
                                "example_id": "575337ba-3285-467f-9ea7-bebdccb51e8b",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "– Y a qu’la cavalerie ! Ça, c’est quelque chose ! T’as un cheval à toi, c’est ton compagnon, et si tu l’soignes bien, si tu l’dresses comme il faut, sans brutalité, avec lui t’as que des contentements."
                            },
                            {
                                "example_id": "1b3519d9-10cd-44f6-9f10-8f87a26ad2f8",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": "Une sorte de contentement donnait à son teint une lueur presque phosphorescente."
                            },
                            {
                                "example_id": "cc12210f-4529-473c-9dbc-f6d53b6b4385",
                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                "text": ". Immobiles, calmes et droits, nous étions enfin capables de comprendre pourquoi il émanait des chats au carreau cette gravité des êtres parvenus au contentement intégral, synonyme de la vie réussie, antipode de l’inquiétude humaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aca7214-d4d3-400b-93cd-afdf64d2a5c6",
                        "source_entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                        "source_sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                        "target_lang_word": "satisfaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satisfaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A fulfilment of a need or desire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32d0a7f-19ee-4357-8326-5dd3b50c5f2b",
                                                "sense_id": "4a2f63c7-7b5b-31a0-b13e-d104cc92fd6b",
                                                "text": "The witch, repository of hieratic lore and folk legends and occult arcana, became the distributor of philtres and unguents, electuaries and pastilles, herbs and charms and incantations - directed toward sexual pleasures and amatory satisfactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The pleasure obtained by such fulfillment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d34259c4-c60b-473a-b42b-035929ff20c6",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "November 4, 1860, Henry David Thoreau, letter to Mr. D. R.\nThis life is not for complaint, but for satisfaction."
                                            },
                                            {
                                                "example_id": "7a9e0a5b-44e7-49bf-b2ac-5f1e4220978c",
                                                "sense_id": "615924bd-4126-3510-9556-341a30f22ea9",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70bff076-83ba-3c86-81dd-8118a07497aa",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "The source of such gratification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa560a67-e08d-308f-8633-5a534f01305a",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A reparation for an injury or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "A vindication for a wrong suffered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8dc26fd-bb59-431c-b7cb-fc84dded6dc9",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "The count demanded satisfaction in the form of a duel at dawn."
                                            },
                                            {
                                                "example_id": "60be5258-092d-487b-97d8-22cbc0f91c48",
                                                "sense_id": "07a90fd2-fbd7-3816-96a5-876676c63714",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                        "entry_id": "f1f0a7e5-2ae5-3c8f-9ffe-72c5434b229e",
                                        "glosses": [
                                            "Sexual pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8e87f0-53e0-4937-ba26-ab7866e2060f",
                                                "sense_id": "a70eaccc-c774-3e97-90ae-2d4d43b7a16d",
                                                "text": "To young man who enjoys receiving oral satisfaction, this BiWM will give you all you want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4699743e-7f01-44ec-976e-f928633537c0",
                        "source_entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
