                    {
                        "translation_id": "60bba581-1eca-48d5-9f43-9ea67d9cfe77",
                        "source_entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "source_sense_description": "school-leaver",
                        "target_lang_word": "Absolvent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolvent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b67cd274-b6b7-37ba-ac10-d474d7fc93ff",
                                        "entry_id": "c810e260-d512-3430-a95f-85af5f3b7401",
                                        "glosses": [
                                            "jemand, der eine Ausbildung (zum Beispiel eine Schul- oder Hochschulausbildung) abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107b02a8-fbad-4d15-9672-6b3fde069e44",
                                                "sense_id": "b67cd274-b6b7-37ba-ac10-d474d7fc93ff",
                                                "text": "„Als ein weiterer Höhepunkt der Feier wird in dem Bericht die Ansprache des Absolventen Johannes Schlundt bezeichnet […]“"
                                            },
                                            {
                                                "example_id": "4adb0cf3-bf6c-4165-a69d-6493b6c47a81",
                                                "sense_id": "b67cd274-b6b7-37ba-ac10-d474d7fc93ff",
                                                "text": "„Es berücksichtigt sowohl die diesbezügliche Kompetenz des Analphabeten als auch die durch mehrjährige sprachhistorische Schulung sensibilisierte Kompetenz der Absolventen unserer Gymnasien.“"
                                            },
                                            {
                                                "example_id": "a638ba35-4f3a-4f49-ab1c-4b33ad53b6f1",
                                                "sense_id": "b67cd274-b6b7-37ba-ac10-d474d7fc93ff",
                                                "text": "„Es waren mehrere Bewerbungen eingegangen, sogar von Polizisten mit deutlich mehr Erfahrung, aber schließlich hatte Ari sich für einen der frischen Absolventen entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "425104a9-4b0e-4f7a-bc4f-6e0dfa663d09",
                        "source_entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "source_sense_description": "school-leaver",
                        "target_lang_word": "Absolventin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolventin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a488004-2398-371e-ba4f-9ac15a296c18",
                                        "entry_id": "7a7e2f17-12d0-376f-b58c-c7d10cf25f64",
                                        "glosses": [
                                            "eine Frau, die eine Ausbildung (zum Beispiel eine Schul- oder Hochschulausbildung) abgeschlossen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e78eb0-33f2-4956-8c8f-a688cd7a6c03",
                                                "sense_id": "4a488004-2398-371e-ba4f-9ac15a296c18",
                                                "text": "„Allerdings ist die Zahl der weiblichen Studienabbrecher höher als bei den männlichen, wenn auch die Zahl der Absolventinnen von 1975/76 bis 1983/84 von 27,6% auf 36,8% gestiegen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81380f7f-7d06-4f28-9ed0-3e5a5bd0edb0",
                        "source_entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "source_sense_description": "school-leaver",
                        "target_lang_word": "Abiturient",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiturient",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                        "entry_id": "b331c586-4178-391a-be9a-d8e40a617c56",
                                        "glosses": [
                                            "ein Schüler, der das Abitur absolviert oder bereits absolviert hat"
                                        ],
                                        "tags": [
                                            "Bildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8fedb3-fbf8-459d-b7ce-9b170027f099",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "Viele Abiturienten entschließen sich, ihre Ausbildung mit einem Studium fortzusetzen."
                                            },
                                            {
                                                "example_id": "6cff8622-a38b-4216-9aa5-919a2b67c6e4",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Der Abiturient kann's nicht mehr hören.“"
                                            },
                                            {
                                                "example_id": "3733dec8-2ca1-47f7-a77b-8efeab030fb6",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Jedes Jahr, wenn die Arbeiter ihren 1. Mai feiern, feiern auch die Abiturienten wieder ihren Schulabschluss.“"
                                            },
                                            {
                                                "example_id": "6dc66fbe-ac0c-43f4-9819-d65c823afb6a",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Für Abiturienten gilt meistens noch die Sonderregelung, daß sie bis zum sechsten Semester neben den üblichen Praktika eine sechswöchige fachpraktische Ausbildung nachweisen müssen.“"
                                            },
                                            {
                                                "example_id": "4725cb27-1cfd-4afa-9e6b-7f864582959b",
                                                "sense_id": "a53d84cc-60a2-39d3-960c-f1695a6194b2",
                                                "text": "„Je älter und selbständiger der Abiturient wird, desto mehr kann er am öffentlichen Lebens Frankfurts teilnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e60489-0c73-40d9-8263-a04f45f5a84f",
                        "source_entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "source_sense_description": "school-leaver",
                        "target_lang_word": "Abiturientin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiturientin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                        "entry_id": "ba4d48cd-0702-398f-9147-e424495a1b2f",
                                        "glosses": [
                                            "Schülerin, die ihr Abitur ablegt oder bereits abgelegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8021543f-5ce7-477d-902b-2a51ab5d0540",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Uns fehlen auch Frauen in den technischen Studiengängen und Berufen. Das liegt unter anderem daran, dass den Abiturientinnen Vorbilder fehlen, die sie für einen solchen Weg begeistern.“"
                                            },
                                            {
                                                "example_id": "5ccb45e1-993c-41dd-90b2-898c52facc34",
                                                "sense_id": "e68a18d1-1955-3816-9322-055304b40608",
                                                "text": "„Eine Abiturientin aus Lyck hat ihre bitteren Erlebnisse auf der Flucht beschrieben, das Leid, den Hunger, die Entbehrungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99914378-0750-4875-a0c8-ea4cf4d583b8",
                        "source_entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "source_sense_description": "school-leaver",
                        "target_lang_word": "Schulabgänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
