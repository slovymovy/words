    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "700ed559-1d84-3ee7-baf9-24479ce0c855",
                    "sense_definition": "Objet de piété constitué d'un cordon ou d'une chaînette où sont enfilés des grains, utilisé pour compter les prières récitées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille dame récite ses prières en faisant glisser les grains de son <w>chapelet</w>."
                        },
                        {
                            "text": "Il garde toujours un petit <w>chapelet</w> en bois dans la poche de son manteau."
                        }
                    ],
                    "synonyms": [
                        "rosaire"
                    ],
                    "common_phrases": [
                        "égrener un chapelet",
                        "chapelet de perles"
                    ]
                },
                {
                    "sense_id": "1d755f35-ea77-3bb3-add6-667f5a065622",
                    "sense_definition": "Suite d'éléments matériels ou géographiques disposés en enfilade ou attachés les uns aux autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bateau navigue lentement le long d'un <w>chapelet</w> d'îles désertes et sauvages."
                        },
                        {
                            "text": "Dans la vieille cuisine de la ferme, un <w>chapelet</w> d'oignons pendait au plafond."
                        }
                    ],
                    "synonyms": [
                        "chaîne"
                    ],
                    "common_phrases": [
                        "chapelet d'îles",
                        "chapelet de saucisses"
                    ]
                },
                {
                    "sense_id": "7bd783fa-317a-3255-bc07-be9493f0e04c",
                    "sense_definition": "Longue suite ininterrompue d'éléments abstraits ou verbaux de même nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En trébuchant violemment sur une racine, l'homme en colère a laissé échapper un <w>chapelet</w> de jurons."
                        },
                        {
                            "text": "Face aux journalistes curieux, le ministre a dû répondre à un véritable <w>chapelet</w> de questions embarrassantes."
                        }
                    ],
                    "synonyms": [
                        "kyrielle",
                        "litanie"
                    ],
                    "common_phrases": [
                        "chapelet de jurons",
                        "chapelet de mensonges"
                    ]
                },
                {
                    "sense_id": "8e06bf9d-4c06-3323-aa51-facbdf306966",
                    "sense_definition": "Ensemble déterminé de prières que l'on récite lors d'une dévotion religieuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque soir à l'église, la communauté locale se réunit pour réciter ensemble le <w>chapelet</w>."
                        },
                        {
                            "text": "Le prêtre a demandé à tous les fidèles de dire un <w>chapelet</w> pour la paix."
                        }
                    ],
                    "common_phrases": [
                        "dire son chapelet",
                        "réciter le chapelet"
                    ]
                },
                {
                    "sense_id": "038d80eb-36b9-3e16-ae9f-97c6f9de0f2a",
                    "sense_definition": "Couronne tressée de fleurs ou de roses que l'on portait sur la tête.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète décrivait une jeune fille parée d'un délicat <w>chapelet</w> de roses sauvages."
                        },
                        {
                            "text": "Autrefois, les bergères confectionnaient un <w>chapelet</w> de fleurs des champs pour célébrer le printemps."
                        }
                    ],
                    "synonyms": [
                        "couronne"
                    ],
                    "common_phrases": [
                        "chapelet de fleurs",
                        "chapelet de roses"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme ancien et poétique"
                        }
                    ]
                }
            ]
        }
