                    {
                        "sense_id": "5fe49988-f9ea-3d63-a7b0-174d73c0ddac",
                        "entry_id": "fe519681-2059-3339-b2bb-748135f28a52",
                        "glosses": [
                            "Variante orthographique de people. Relatif aux personnalités de la vie publique ou politique, ou du show business."
                        ],
                        "tags": [
                            "alt-of",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c750ed40-b43f-4b85-bae8-4dd7b87ee148",
                                "sense_id": "5fe49988-f9ea-3d63-a7b0-174d73c0ddac",
                                "text": "Pas de campagne politique sans une savante utilisation de la presse pipole !"
                            },
                            {
                                "example_id": "e0069993-ec54-43a8-9dc5-248120203a68",
                                "sense_id": "5fe49988-f9ea-3d63-a7b0-174d73c0ddac",
                                "text": "Ce néolangage « pipole », qui est devenu le langage de l’idéologie de l’image, dans une certaine forme, totalitaire, s’impose sans un rapport précis au politique et surtout par delà le vrai et le faux."
                            },
                            {
                                "example_id": "617a1fd0-5a3c-467f-9484-4d7ef741637d",
                                "sense_id": "5fe49988-f9ea-3d63-a7b0-174d73c0ddac",
                                "text": "Autre curiosité : son interview tire-larmes dans le « JDD » sur son enfance à Évreux dans 15 m² (« La fenêtre donnait sur la maison d’arrêt, on s’habillait au Secours populaire… ») a été amplement relayée par la presse pipole, notamment « Closer »."
                            }
                        ]
                    }
                ],
