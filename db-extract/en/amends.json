                    {
                        "translation_id": "39e8011e-eca0-4928-b21f-dc228f07a541",
                        "source_entry_id": "019e3213-993b-34be-9083-e1d628433ed9",
                        "source_sense_id": "afae3a18-563c-3123-b41b-7f69fd256046",
                        "source_sense_description": "compensation for a loss or injury",
                        "target_lang_word": "Wiedergutmachung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiedergutmachung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                        "entry_id": "a79d3903-8e3a-37aa-bd02-069cd6eab3f2",
                                        "glosses": [
                                            "Entschädigung, Leistungen zur Schadensbehebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66c5560-8dba-4567-af17-6856f8976efb",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "Trotz Wiedergutmachung blieb ein Restschaden."
                                            },
                                            {
                                                "example_id": "75b8c842-835c-4b0e-a5f0-bdf90357d6be",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "„Später verlangten sie Wiedergutmachung.“"
                                            },
                                            {
                                                "example_id": "4b7d70dd-ede2-4c53-a7aa-e8de1457530e",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "„Der oftmals vergebliche Kampf um Wiedergutmachung fehlt nur selten in den Lebensberichten.“"
                                            },
                                            {
                                                "example_id": "893d2d04-23a3-4153-a40c-86541d6a52c0",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "„Einige sagten zu ihr, ihr Leben könnte ganz anders sein, wenn sie nur deutsche Wiedergutmachung akzeptieren würde.“"
                                            },
                                            {
                                                "example_id": "0691ef7b-6a00-40fc-97c5-6f481667fa8f",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "„Zum einen sollte Deutschland Wiedergutmachung leisten für die Zerstörungen, die es zwischen Atlantik und Wolga angerichtet hatte.“"
                                            },
                                            {
                                                "example_id": "949aa614-10d9-4dad-a63f-c56e3502dd86",
                                                "sense_id": "23976649-7cb4-3010-acf1-8be2d780796c",
                                                "text": "„Dieser Brief hätte andererseits keine Folgen gehabt, wenn er nicht gerade in dem Augenblick gekommen wäre, als mich meine Verhaftung und die Wiedergutmachung, die mir Graf von Aranda zuteil werden ließ, zum Tagesgespräch gemacht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "853f6ef4-a38d-4e32-bd6e-f02bedf80ec3",
                        "source_entry_id": "019e3213-993b-34be-9083-e1d628433ed9",
                        "source_sense_id": "afae3a18-563c-3123-b41b-7f69fd256046",
                        "source_sense_description": "compensation for a loss or injury",
                        "target_lang_word": "Schadensersatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadensersatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                        "entry_id": "e88c5e6b-d733-36dd-a8a2-f86c8e6412c7",
                                        "glosses": [
                                            "Ausgleich/Kompensation für einen entstandenen Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c818effb-1897-42bc-a0e6-e0dafe26edc0",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Vier Ex-Fahnder verlangen Schadensersatz, weil sie aufgrund unlauterer Gutachten zwangspensioniert wurden.“"
                                            },
                                            {
                                                "example_id": "44183b8a-f0d4-4dd3-83b1-7b6906378a39",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„In dem Fall hatte die Klägerin Schadensersatz für Schmuck verlangt, der aus ihrem Reisegepäck verschwunden war.“"
                                            },
                                            {
                                                "example_id": "1eeabdd8-0a45-4470-9cf7-5a936a35cd63",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Erst am Donnerstag kündigte Stöckl an, erstmals eine Bank auf Schadensersatz zu klagen.“"
                                            },
                                            {
                                                "example_id": "acdc904f-ce49-4911-b36f-75062b53dc62",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Ein nach sonstigen Vorschriften begründeter Anspruch auf Schadensersatz bleibt unberührt.“"
                                            },
                                            {
                                                "example_id": "df7c590d-38a8-49e4-abbb-f900a6843fbf",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Wer schuldlos in einen Unfall verwickelt wird, hat in der Regel Anspruch auf Schadensersatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
