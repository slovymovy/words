                },
                {
                    "sense_id": "634e0df2-6598-36be-9f46-d7be5356d945",
                    "sense_definition": "Charger ou transporter des matériaux lourds à l'aide d'une civière ou d'un chariot spécial appelé bard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manutention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les carriers devaient autrefois <w>barder</w> de lourds blocs de pierre jusqu'au chantier naval."
                        },
                        {
                            "text": "Il fallait <w>barder</w> le bois débité depuis la rive escarpée directement vers la barque."
                        }
                    ],
                    "synonyms": [
                        "charrier",
                        "transporter"
                    ],
                    "common_phrases": [
