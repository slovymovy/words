                    {
                        "translation_id": "2c7daa30-1ba2-44c0-b41b-02731f8ce9f5",
                        "source_entry_id": "96d37f07-080e-3b18-89f9-aae29c4e187c",
                        "source_sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
