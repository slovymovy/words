                        "examples": [
                            {
                                "example_id": "a80aa0af-fd77-4c89-8174-87fa0dd4123e",
                                "sense_id": "075dce6e-51c6-37de-97fa-8e23d1ab68ba",
                                "text": "„Der Plastikteller war dank des Spülgangs mit Trockensand blitzsauber und trocken, nicht das kleinste Stückchen Essen oder Sand war zu sehen.“"
                            },
                            {
                                "example_id": "c290e59e-4e12-4a16-983c-4252f685bf3a",
                                "sense_id": "075dce6e-51c6-37de-97fa-8e23d1ab68ba",
                                "text": "„Auf dem Herd stapelten sich die Plastikteller vom Kabab-Lieferdienst.“"
                            }
                        ],
