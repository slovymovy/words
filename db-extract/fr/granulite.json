                "senses": [
                    {
                        "sense_id": "7e03927b-2888-3a15-922a-0fc7664c7f13",
                        "entry_id": "d61e52a1-44c0-3629-b8fb-3c8c6623ef5d",
                        "glosses": [
                            "Variété de granite sans muscovite, riche en feldspath, avec du grenat et du pyroxène. Elle est de teinte généralement rosâtre, de grain très fin, appartenant à la deuxième période de roches éruptives anciennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e07911-2ba0-4793-b396-83dc75ab6975",
                                "sense_id": "7e03927b-2888-3a15-922a-0fc7664c7f13",
                                "text": "Dans la granulite (...) le quartz est en grains isolés."
                            },
                            {
                                "example_id": "eac41da3-4330-4e9f-915f-29bd646837b9",
                                "sense_id": "7e03927b-2888-3a15-922a-0fc7664c7f13",
                                "text": "Les feldspaths des granulites, en se décomposant, donnent parfois une argile blanche, très pure, le kaolin."
                            }
                        ]
                    },
                    {
                        "sense_id": "41b794ba-2e5a-36ac-8a6c-edc0205cf91f",
                        "entry_id": "d61e52a1-44c0-3629-b8fb-3c8c6623ef5d",
                        "glosses": [
                            "Roche métamorphique à texture massive composée de quartz et de feldspaths alcalins, mais pauvre en micas."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
