                "senses": [
                    {
                        "sense_id": "62cd1862-43c5-316e-9830-9cfb6c9f18d8",
                        "entry_id": "c415ac2d-8e92-3674-8cde-2a3e6d73f11b",
                        "glosses": [
                            "unbridled, rampant, frenzied, wild, extreme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10cd548e-54fa-47d1-9094-b8e6d8312914",
                                "sense_id": "62cd1862-43c5-316e-9830-9cfb6c9f18d8",
                                "text": "оголте́лый национали́зм",
                                "translation": "unbridled nationalism",
                                "english": "unbridled nationalism"
                            },
                            {
                                "example_id": "6df4812b-5a1d-4488-bebf-a738dd6176e5",
                                "sense_id": "62cd1862-43c5-316e-9830-9cfb6c9f18d8",
                                "text": "Грома́дные облака́, освещённые лишь со́бственным сла́бым све́том, прилега́ли бли́зко к пове́рхности городски́х крыш и уноси́лись в тьму поле́й, в ско́шенные простра́нства пусто́й, оголте́лой земли́.",
                                "translation": "Huge clouds, lit only by their own weak light, were lying close to the surface of the city roofs and being carried away into the dark of the fields, towards the mown spaces of an empty, frenzied earth.",
                                "english": "Huge clouds, lit only by their own weak light, were lying close to the surface of the city roofs and being carried away into the dark of the fields, towards the mown spaces of an empty, frenzied earth."
                            }
                        ]
                    }
                ],
