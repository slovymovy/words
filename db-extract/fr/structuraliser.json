                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2a91b3-0427-4c8b-bd76-78255f90d981",
                                "sense_id": "35707da5-5f70-3156-b442-a14b8ed4f366",
                                "text": "Nous les voyons se mettre à structuraliser à tout-va."
                            },
                            {
                                "example_id": "360971c3-901f-4286-812a-b7665f24294a",
                                "sense_id": "35707da5-5f70-3156-b442-a14b8ed4f366",
                                "text": "Il y a là une rage théorique de morceler l’objet en fonctions, pour les dialectiser ensuite « historiquement » — en fait pour les structuraliser sous l’hégémonie de l’une d’entre elles — et réconcilier le tout sous le signe de la science !"
                            }
                        ]
