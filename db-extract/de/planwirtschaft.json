                ],
                "senses": [
                    {
                        "sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                        "entry_id": "a2fe1469-9ab8-312d-8d4f-23d9ec7fb6da",
                        "glosses": [
                            "eine Zentralverwaltungswirtschaft, in der alle oder die wesentlichen Entscheidungen zur Verteilung und Zuordnung knapper Ressourcen von einer zentralen Regierung getroffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea9a6f7-e198-4f78-a646-7ba614949b7b",
                                "sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                                "text": "Die Planwirtschaften der sozialistischen Länder stehen im Gegensatz zu den Systemen der kapitalistischen Länder."
                            },
                            {
                                "example_id": "aea3febf-26fc-47b9-a195-0a6b7912add7",
                                "sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                                "text": "„Weil dieser sowjetische Tourismus eine Flucht vor der Realität des Alltags war, vergaß die sonst ziemlich vergessliche Planwirtschaft der Sowjetunion nie, stets in überausreichendem Maße touristisches Zubehör zu produzieren.“"
                            },
                            {
                                "example_id": "93a69f69-c726-411d-ab35-fd6166b4c9be",
                                "sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                                "text": "„Dazu und zu Götz von Berlichingen gab es damals einen trefflichen Witz über die Planwirtschaft.“"
                            },
                            {
                                "example_id": "c5445e62-d302-476e-b2e0-7f1bd40b36e3",
                                "sense_id": "a65e530d-2f0a-31fb-abf6-697a50df313f",
                                "text": "„Die Planwirtschaft funktionierte so, dass auf oberster Ebene die Pläne aufgestellt wurden und auf der untersten Ebene die Pläne zu erfüllen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
