                "senses": [
                    {
                        "sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                        "entry_id": "42237a0d-6f15-3e68-9d0c-d2d26bccfb0b",
                        "glosses": [
                            "betrekking hebbend op de architectuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0569122-d66a-4d06-9e79-a4e3a839efda",
                                "sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                                "text": "Gebouw X van Windesheim is een architectonische blikvanger."
                            },
                            {
                                "example_id": "9a420795-2a6f-4202-905b-eaf5280ec2fa",
                                "sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                                "text": "Dit was het zwembad van Hotel Luxor. Een architectonisch hoogstandje waarvan iedere gast behoorlijk onder de indruk was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0f6f77b-a3ec-4c84-8278-beeb71a73553",
                        "source_entry_id": "42237a0d-6f15-3e68-9d0c-d2d26bccfb0b",
                        "source_sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                        "source_sense_description": "betrekking hebbend op de architectuur",
                        "target_lang_word": "architektonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architektonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                        "entry_id": "380afd71-6b69-35ca-acec-8f2eee2d1a09",
                                        "glosses": [
                                            "die Architektur oder Architektonik betreffend, was zu ihr gehört oder auf ihr beruht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c1c861-2ee4-42b0-b9b9-7e1ad29c28c6",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Ringsum erheben sich klassizistische Straßenzüge, stuckselig und mit der architektonischen Großzügigkeit der Jahrhundertwende entworfen.“"
                                            },
                                            {
                                                "example_id": "d8515235-04be-4734-a9b6-b2fbc7a32994",
                                                "sense_id": "25a46aac-4975-34bf-9969-9f84de4a2c68",
                                                "text": "„Die gegenüber einem reinen Zweckbau deutlich höheren Kosten nahm die Stiftungsuniversität für ihre architektonischen Ambitionen in Kauf, zumal auch die öffentliche Hand von dem Großvorhaben angetan war und großzügig Fördermittel bereitstellte: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "727c7cdc-2a64-4b26-b6c6-90b040bc2401",
                        "source_entry_id": "42237a0d-6f15-3e68-9d0c-d2d26bccfb0b",
                        "source_sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                        "source_sense_description": "betrekking hebbend op de architectuur",
                        "target_lang_word": "architectural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                        "entry_id": "420c4c88-aef1-387e-acaf-9ff5c1ff021f",
                                        "glosses": [
                                            "Pertaining to architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ab2f12-a088-410f-96a9-e4d375ed098c",
                                                "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "e26e793c-b41b-4a68-90fc-3b5dfa956a75",
                                                "sense_id": "777ef00c-946e-3076-889c-9d26c0d5e0bc",
                                                "text": "Wheelchair users are restricted entry into many structures and public facilities by architectural barriers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220ae4c5-d56f-3314-b0bd-68da094a9036",
                                        "entry_id": "420c4c88-aef1-387e-acaf-9ff5c1ff021f",
                                        "glosses": [
                                            "Resembling architecture in style; seeming to have been designed (by an architect)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb82d63f-0212-42b7-a7d9-c7cbf2979495",
                        "source_entry_id": "42237a0d-6f15-3e68-9d0c-d2d26bccfb0b",
                        "source_sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                        "source_sense_description": "betrekking hebbend op de architectuur",
                        "target_lang_word": "architectonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Relating to or characteristic of architecture, design and construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a2a9af-e378-4e56-8680-22ea0954a5d8",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "architectonic wisdom"
                                            },
                                            {
                                                "example_id": "728052ca-1338-44ff-980e-1b9aa04a4dec",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "[T]he great Creator hath likevviſe ſignalized his Care and Skill, by giving Animals an architectonick Faculty, to build themſelves convenient places of Retirement, in vvhich to repoſe and ſecure themſelves, and to nurſe up their Young."
                                            },
                                            {
                                                "example_id": "365f8214-2ea9-449b-b3e7-3570b4591201",
                                                "sense_id": "de03ecc3-b1cf-3da1-8692-77d352a936d3",
                                                "text": "these architectonic functions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad55c9d8-50e9-364b-840c-931c01e7bf5b",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Foundational, fundamental; supporting the structure of a morality, society, or culture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0595164a-3b7d-449c-84c1-3abacbe3681a",
                                                "sense_id": "ad55c9d8-50e9-364b-840c-931c01e7bf5b",
                                                "text": "We do not of course always, or even often, find the moral principles clearly and consciously expressed or consistently supported, but we cannot but feel that they are present in the shape of instincts, and those instincts pervading and architectonic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6bbdff-2b16-3d49-906f-e7f87ba11b38",
                                        "entry_id": "be46a6f8-23f3-373f-8f57-c8ec87adff16",
                                        "glosses": [
                                            "Relating to the scientific systematization of the totality of knowledge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "architectonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                        "entry_id": "e5c0ad39-e652-3500-9716-4bd9c102794e",
                                        "glosses": [
                                            "The design, structure, or architecture of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da84faf9-50b8-4f3f-a8f7-b1d29701c892",
                                                "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                                "text": "Because the poems are an investigation into the nature of time, it is important to be aware of the overall temporal architectonic of the love-cycle."
                                            },
                                            {
                                                "example_id": "a1fdb181-d828-4d8e-8f71-5a48ba769d61",
                                                "sense_id": "b30e2d19-5981-32e5-b501-4621b6f8a80e",
                                                "text": "The question of commandeering social space and, by extension, reviving a public sphere could well be developed within the architectonic of Bakhtin's theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c720cf55-962f-4335-aaee-0a7701796f24",
                        "source_entry_id": "42237a0d-6f15-3e68-9d0c-d2d26bccfb0b",
                        "source_sense_id": "bd9798b2-3d70-3d75-8877-a089a63c53b8",
                        "source_sense_description": "betrekking hebbend op de architectuur",
                        "target_lang_word": "architectural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "architectural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                        "entry_id": "6ade56b9-4744-3502-b73d-465e2777258c",
                                        "glosses": [
                                            "Qui a rapport à l’architecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d5a4ff-8b2d-4ce0-9540-8def5ae963e4",
                                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                                "text": "La perspective des rues se dessinait par des lignes architecturales que pas un char, pas un cheval, pas un esclave ne troublait."
                                            },
                                            {
                                                "example_id": "b0f93c35-6da5-4386-8ecc-9712a5d5690c",
                                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]."
                                            },
                                            {
                                                "example_id": "c0919242-eb31-4e0d-b0b0-83f6e8695d32",
                                                "sense_id": "0feac190-26a7-38ea-b635-1a5a56e09848",
                                                "text": "Toujours selon l’ingénieur de Facebook, les technologies proposées par Apple avaient largement évolué depuis le temps. D’ailleurs, des modifications dans le SDK (Software development kit) d’iOS avaient forcé l’équipe à revoir certaines approches architecturales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
