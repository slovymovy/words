                ],
                "senses": [
                    {
                        "sense_id": "f36f7663-e804-31e8-942c-3b2eef936dc5",
                        "entry_id": "98820ea7-c4be-3316-aaff-b91b7d1af7ac",
                        "glosses": [
                            "архит. сооружение мостового типа для перехода или переезда через речную долину, овраг, ущелье, железнодорожный путь и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293bb176-128a-495a-aa1a-6d788d8a76a6",
                                "sense_id": "f36f7663-e804-31e8-942c-3b2eef936dc5",
                                "text": "На шоссейных и грунтовых дорогах подрывать и сжигать мосты, виадуки, разрушать гати и другие искусственные сооружения."
                            },
                            {
                                "example_id": "39d403fa-da88-42a7-b6e0-ce0efa59debb",
                                "sense_id": "f36f7663-e804-31e8-942c-3b2eef936dc5",
                                "text": "Виадуки сооружают вместо высокой обычной насыпи при пересечении железной дорогой глубоких долин, оврагов и ущелий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64169549-009d-4416-8008-66601dbe6683",
                        "source_entry_id": "98820ea7-c4be-3316-aaff-b91b7d1af7ac",
                        "source_sense_id": "f36f7663-e804-31e8-942c-3b2eef936dc5",
                        "target_lang_word": "viaduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viaduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                        "entry_id": "c4e97e4f-4bc8-3d7c-8fa2-9175c15c2cec",
                                        "glosses": [
                                            "A bridge with several spans that carries rail or road traffic over a valley or other obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875d4a63-24b3-49ef-a937-687729c52bfc",
                                                "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "bce2db10-9ed7-4754-9a59-395451d853f0",
                                                "sense_id": "13311ae3-eb9e-389b-a486-9efb693b3855",
                                                "text": "The L.C.C. [London County Council] considers viaducts in London objectionable and a hindrance to town planning and would like to abolish all the Southern Railway lines on viaducts in South London. [Nothing much happened, they still exist.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9085d37-7f02-492c-99b6-eb2f600252d0",
                        "source_entry_id": "98820ea7-c4be-3316-aaff-b91b7d1af7ac",
                        "source_sense_id": "f36f7663-e804-31e8-942c-3b2eef936dc5",
