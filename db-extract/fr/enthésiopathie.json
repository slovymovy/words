                    {
                        "sense_id": "87b18f6c-4506-3c17-914a-53816d99bab0",
                        "entry_id": "fc0c806d-d69d-3d47-8bee-a42b2dd3e2b3",
                        "glosses": [
                            "Maladie inflammatoire et douloureuse de l’enthèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb68c13a-172f-4dad-b459-b25d545fc43d",
                                "sense_id": "87b18f6c-4506-3c17-914a-53816d99bab0",
                                "text": "Les spondylarthropathies se caractérisent par l’existence d’une atteinte inflammatoire des enthèses (enthésite ou enthésiopathie inflammatoire), c’est-à-dire de la zone d’insertion tendineuse, capsulaire ou ligamentaire sur l’os."
                            },
                            {
                                "example_id": "89eebd40-d4d6-4fdf-936c-4ac69ec669b0",
                                "sense_id": "87b18f6c-4506-3c17-914a-53816d99bab0",
                                "text": "Quand bien même il existe plusieurs indices d’enthésiopathie, la surveillance de cette présentation clinique se résume le plus souvent au niveau de la douleur et/ou de la gêne fonctionnelle en fonction de la localisation de l’enthésiopathie."
                            }
                        ]
                    }
