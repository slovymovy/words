                    },
                    {
                        "translation_id": "f5cfbd8a-f451-446a-88b8-45985adf8e6d",
                        "source_entry_id": "e109f265-496f-39b6-ba1c-8e305e38d363",
                        "source_sense_id": "a2fe0fd3-4fb2-3277-b6e1-ff0989fb1ac0",
                        "source_sense_description": "gymnasium student",
                        "target_lang_word": "Gymnasiast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gymnasiast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                        "entry_id": "6b254d2b-b866-3e03-a19a-e27e19a04dcd",
                                        "glosses": [
                                            "eine Person, die auf einem Gymnasium den Unterricht besucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145b114b-708d-4879-bab6-a426cd842f72",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "Er war schon als Gymnasiast gut in Mathematik."
                                            },
                                            {
                                                "example_id": "46d86983-177d-49f1-9ec5-d67932176db7",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "„Dort schließt sich der Gymnasiast der Bekennenden Kirche an.“"
                                            },
                                            {
                                                "example_id": "8d5b9569-d523-44de-b201-bea0314a51d9",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "„Generationen französischer Gymnasiasten haben an ihm gelitten.“"
                                            },
                                            {
                                                "example_id": "57b6621d-79ea-41e7-a9c2-e433bb9a0ff5",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "„In der heutigen russischen Literatur gibt es vom Gymnasiasten bis zum gelehrten Historiker keinen Menschen, der nicht sein Steinchen auf Alexander wegen alles in dieser Periode seiner Regierung getanen Unrechts würfe.“"
                                            },
                                            {
                                                "example_id": "69b36aa6-b30a-4e10-95dd-d1274bae8ed3",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "„Im Taumel seiner ersten Liebe als Gymnasiast ging er zu seiner Großmutter, ließ sich Geld geben, entwarf ein Plakat, ließ es drucken und an den Anschlagsäulen von Breslau anbringen.“"
                                            },
                                            {
                                                "example_id": "646c47f3-c1a8-4334-a93c-7450748405fb",
                                                "sense_id": "166544e9-d42b-3a5d-8e37-177180004ff0",
                                                "text": "„Heute sind etwa ein Fünftel der Gymnasiasten Arbeiterkinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d2d1e54-c118-4fd1-9139-dec266694eb6",
                        "source_entry_id": "e109f265-496f-39b6-ba1c-8e305e38d363",
                        "source_sense_id": "a2fe0fd3-4fb2-3277-b6e1-ff0989fb1ac0",
                        "source_sense_description": "gymnasium student",
                        "target_lang_word": "Gymnasiastin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gymnasiastin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3339818a-b23f-35b4-86c9-445d0825c789",
                                        "entry_id": "68509f4b-0881-3902-a3d6-ea6d108263f5",
                                        "glosses": [
                                            "Schülerin eines Gymnasiums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec35c86-a7aa-4749-acac-ab9f3d098aeb",
                                                "sense_id": "3339818a-b23f-35b4-86c9-445d0825c789",
                                                "text": "„Neulich fragte eine Gymnasiastin, offenbar verunsichert durch die millimetergenauen Interpretationskünste ihres Deutschlehrers, woher man eigentlich wisse, wie der Autor sein Buch gemeint habe.“"
                                            },
                                            {
                                                "example_id": "3a5cec42-4d1e-4921-89e9-031c42387ed6",
                                                "sense_id": "3339818a-b23f-35b4-86c9-445d0825c789",
                                                "text": "„Nach einem halben Jahr der intensiven Auseinandersetzung, die auch jenseits des regulären Unterrichts in ihrer Freizeit stattfand, luden die Gymnasiastinnen zu einer Ausstellung ein, in der sie mit den Fotografien und Modellen ihre kreativen Fähigkeiten unter Beweis stellten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
