                        "sense_id": "ce43e4dd-4d40-3469-bd34-1537ce9ee70e",
                        "entry_id": "aea72706-3bba-393a-94fe-774c56885781",
                        "glosses": [
                            "надеть на кого-либо пояс, ремень и т. п.; стянуть одежду по талии поясом, ремнём и т. п."
                        ],
                        "tags": [],
