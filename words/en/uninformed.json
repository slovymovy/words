{
    "word_family": [
        "inform",
        "information",
        "informative",
        "informant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13d4f0d0-52fa-3f76-a3d6-529e15c411aa",
                    "sense_definition": "Lacking knowledge or information about a particular subject or situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public remained <w>uninformed</w> about the changes to the local tax laws.",
                            "target_lang_translations": {
                                "zh": "公众对于当地税法的变动依然<w>不知情</w>。"
                            }
                        },
                        {
                            "text": "It is dangerous to make decisions while <w>uninformed</w> regarding the potential risks.",
                            "target_lang_translations": {
                                "zh": "在对潜在风险<w>不知情</w>的情况下做决定是很危险的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ignorant",
                        "unaware",
                        "uneducated"
                    ],
                    "antonyms": [
                        "informed",
                        "knowledgeable"
                    ],
                    "common_phrases": [
                        "remain uninformed",
                        "completely uninformed"
                    ],
                    "target_lang_definitions": {
                        "zh": "对特定主题或情况缺乏了解或信息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不知情的",
                                "target_lang_sense_clarification": "指对某事缺乏了解或未被告知。"
                            },
                            {
                                "target_lang_word": "无知的",
                                "target_lang_sense_clarification": "指缺乏相关知识或信息。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a802bd77-1214-36b8-8ade-e1607ae3e741",
                    "sense_definition": "Lacking vitality, spirit, or active life.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performance felt <w>uninformed</w> by any real passion or artistic vision.",
                            "target_lang_translations": {
                                "zh": "这场表演感觉<w>缺乏灵感</w>，没有展现出真正的热情或艺术构思。"
                            }
                        },
                        {
                            "text": "His writing style is <w>uninformed</w> and lacks the energy needed to engage readers.",
                            "target_lang_translations": {
                                "zh": "他的写作风格<w>缺乏内涵</w>，没有吸引读者所需的活力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lifeless",
                        "spiritless",
                        "dull"
                    ],
                    "antonyms": [
                        "vibrant",
                        "animated"
                    ],
                    "target_lang_definitions": {
                        "zh": "缺乏活力、精神或生命力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缺乏灵感的",
                                "target_lang_sense_clarification": "指艺术或创作中缺乏内在的洞察力或精神支撑。"
                            },
                            {
                                "target_lang_word": "死气沉沉的",
                                "target_lang_sense_clarification": "形容缺乏活力和感染力。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}