                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ba9d67ca-5c72-424f-811a-5daa2b3d9f79",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "tags": [
                            "plural"
                        ],
                        "form": "remembrancers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1033ea91-59d9-37ef-98cd-7a6cb791fcb6",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "glosses": [
                            "A person who reminds someone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1983f62a-a990-4b7c-b6cc-3f0f613c448b",
                                "sense_id": "1033ea91-59d9-37ef-98cd-7a6cb791fcb6",
                                "text": "I wonder, Dick, you did not put me in mind of sending for my own mattresses - But, if I had not been an ass, I should not have needed a remembrancer."
                            },
                            {
                                "example_id": "ba882fe9-e56e-4c2a-86e3-0c4986e53f95",
                                "sense_id": "1033ea91-59d9-37ef-98cd-7a6cb791fcb6",
                                "text": "Tribal chieftains in Africa had had official remembrancers about them; I was Ulick's remembrancer."
                            }
                        ]
                    },
                    {
                        "sense_id": "706c75c3-d126-376a-895c-7adea83dff9d",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "glosses": [
                            "A memento or souvenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03fb45f3-28e0-4763-9e8d-0ab336a56f90",
                                "sense_id": "706c75c3-d126-376a-895c-7adea83dff9d",
                                "text": "Near a fortnight had passed before I attempted to restrain their affliction; for premature consolation is but the remembrancer of sorrow."
                            }
                        ]
                    },
                    {
                        "sense_id": "e418068f-9857-34b9-ab7c-fb2368706723",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "glosses": [
                            "A recorder, or municipal judge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a661b80-5cba-3923-b9bb-0f4397066940",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "glosses": [
                            "An officer of exchequer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "18d9d980-4727-3d2f-80f5-34560f207b0c",
                        "entry_id": "4a7d90a4-a537-3c85-8a2e-06bdb4c9dddc",
                        "glosses": [
                            "Alternative letter-case form of Remembrancer: an official of the City of London Corporation."
                        ],
                        "tags": [
                            "UK",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "50f45c13-6617-4f6c-99c1-555c685bad2b",
                                "sense_id": "18d9d980-4727-3d2f-80f5-34560f207b0c",
                                "text": "In one respect at least the Corporation acts as the superior body: it imposes on the House of Commons a figure called the remembrancer: an official lobbyist who sits behind the Speaker's chair and ensures that, whatever our elected representatives might think, the City's rights and privileges are protected."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4075fce9-bfe3-304b-9581-ac80aa3e6b02",
