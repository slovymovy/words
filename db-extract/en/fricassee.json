                "senses": [
                    {
                        "sense_id": "9616794a-cd0b-3106-b152-210c0c5091f8",
                        "entry_id": "a18c2ba9-6d8f-34ee-81e0-962be6688a7a",
                        "glosses": [
                            "To cook meat or poultry in this manner."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "53e5aac6-fcf8-498d-9065-c3969f5a46b5",
                                "sense_id": "9616794a-cd0b-3106-b152-210c0c5091f8",
                                "text": "Just now I'm waiting for Tony Goodwin [the publisher] to arrive, casseroling a rabbit, fricasseeing it actually, listening to Revolver on the record player and the gale stripping the olive trees outside, and answering my correspondence, when […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c035b50f-0adc-45c6-b2fc-6d8c83427b21",
                        "source_entry_id": "a18c2ba9-6d8f-34ee-81e0-962be6688a7a",
                        "source_sense_id": "9616794a-cd0b-3106-b152-210c0c5091f8",
                        "source_sense_description": "to cook meat or poultry in this manner",
                        "target_lang_word": "frikassieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frikassieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "697da610-2c54-3a5b-846c-1775a2aff2a5",
                                        "entry_id": "cfd9f720-24e5-3962-9a7d-7bac911811b8",
                                        "glosses": [
                                            "zu Frikassee verarbeiten, (helles Fleisch) in Ragout verwandeln, in kleine Stücke zerteilen"
                                        ],
                                        "tags": [
                                            "Kochen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb156fd5-9c10-4783-9936-7a690fd5bf5e",
                                                "sense_id": "697da610-2c54-3a5b-846c-1775a2aff2a5",
                                                "text": "„Denn man kann ein Huhn braten, sieden, frikassieren, sulzen, verschiedentlich versaucen, spicken, bebändern, daß es ein Wunder ist und fast gar kein Huhn mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2b9ef7c-02be-3a7f-b1b4-65f026445832",
                                        "entry_id": "cfd9f720-24e5-3962-9a7d-7bac911811b8",
                                        "glosses": [
                                            "zu Frikassee verarbeiten, im Sinne von kurz und klein schlagen, verprügeln"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee9c5c3-f13c-47d2-88f2-1a977a1518cd",
                                                "sense_id": "f2b9ef7c-02be-3a7f-b1b4-65f026445832",
                                                "text": "„»Frikassieren werde ich ihn. Frikassieren!!« Er sah sich um, packte einen Stuhl mit lieblich geschwungenen Beinen, schwenkte ihn hoch empor und schmetterte ihn gegen die Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5bcf76c2-2da1-3513-abd1-1429984af440",
                                        "entry_id": "cfd9f720-24e5-3962-9a7d-7bac911811b8",
                                        "glosses": [
                                            "übel behandeln, verunstalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5476f03-74f0-423a-85d1-f7afe772479e",
                                                "sense_id": "5bcf76c2-2da1-3513-abd1-1429984af440",
                                                "text": "„Das führt dazu, dass einige Arbeitsprozesse so frikassiert sind, dass man zwar den ganzen Tag ungeheuer emsig war, aber am Ende gar nicht weiß, was man geschafft hat. Wofür bin ich verantwortlich?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
