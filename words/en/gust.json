{
    "word_family": [
        "gusty",
        "gustiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39321bb1-d21b-3c38-ae55-36c0cea28322",
                    "sense_definition": "A strong, abrupt rush of wind.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>gust</w> of wind blew my hat off while I was walking.",
                            "target_lang_translations": {
                                "zh": "我走路时，一阵<w>阵风</w>突然把我的帽子吹掉了。",
                                "ru": "Внезапный <w>порыв</w> ветра сдул мою шляпу, пока я шёл.",
                                "cs": "Náhlý <w>poryv</w> větru mi sfoukl klobouk, když jsem šel."
                            }
                        },
                        {
                            "text": "The storm brought heavy rain and powerful <w>gusts</w> that damaged several trees.",
                            "target_lang_translations": {
                                "zh": "暴风雨带来了大雨和强劲的<w>阵风</w>，吹倒了几棵树。",
                                "ru": "Шторм принёс сильный дождь и мощные <w>порывы</w> ветра, которые повредили несколько деревьев.",
                                "cs": "Bouře přinesla silný déšť a mocné <w>poryvy</w> větru, které poškodily několik stromů."
                            }
                        }
                    ],
                    "synonyms": [
                        "windflaw"
                    ],
                    "common_phrases": [
                        "sudden gust"
                    ],
                    "target_lang_definitions": {
                        "zh": "一阵强劲而突然的风。",
                        "ru": "Внезапный и сильный порыв ветра.",
                        "cs": "Silný, náhlý závan větru."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阵风",
                                "target_lang_sense_clarification": "指突然刮起的一阵强风。"
                            },
                            {
                                "target_lang_word": "狂风",
                                "target_lang_sense_clarification": "指猛烈且突发的风。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное и резкое усиление ветра"
                            },
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "внезапный, очень сильный порыв ветра"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "poryv",
                                "target_lang_sense_clarification": "náhlé a prudké zesílení větru"
                            },
                            {
                                "target_lang_word": "náraz větru",
                                "target_lang_sense_clarification": "silný, krátký úder větru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0f5044b-91d6-384d-b147-10e02e8aec3f",
                    "sense_definition": "A sudden, brief outburst of emotion or energy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a <w>gust</w> of anger but quickly regained her composure.",
                            "target_lang_translations": {
                                "zh": "她感到<w>一阵</w>怒火涌上心头，但很快恢复了镇定。",
                                "ru": "Она почувствовала <w>вспышку</w> гнева, но быстро взяла себя в руки.",
                                "cs": "Pocítila <w>výbuch</w> hněvu, ale rychle znovu získala klid."
                            }
                        },
                        {
                            "text": "The room was filled with a <w>gust</w> of laughter after the comedian told his joke.",
                            "target_lang_translations": {
                                "zh": "喜剧演员讲完笑话后，房间里爆发出了<w>一阵</w>笑声。",
                                "ru": "Комната наполнилась <w>взрывом</w> смеха после того, как комик рассказал свою шутку.",
                                "cs": "Místnost se naplnila <w>výbuchem</w> smíchu poté, co komik řekl svůj vtip."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "突然爆发的情绪或能量。",
                        "ru": "Внезапное и кратковременное проявление сильной эмоции или энергии.",
                        "cs": "Náhlý, krátký výbuch emocí nebo energie."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爆发",
                                "target_lang_sense_clarification": "指情绪或能量的突然释放。"
                            },
                            {
                                "target_lang_word": "一阵",
                                "target_lang_sense_clarification": "用于形容情绪或感觉的短暂突发。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "внезапное проявление сильного чувства"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное и резкое проявление чувства"
                            },
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "бурное, внезапное проявление эмоций"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "výbuch",
                                "target_lang_sense_clarification": "náhlé uvolnění silných emocí"
                            },
                            {
                                "target_lang_word": "záchvat",
                                "target_lang_sense_clarification": "náhlý projev citu nebo stavu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9094f12-e3c1-3882-b509-fc42257c7cb9",
                    "sense_definition": "Great enjoyment or enthusiasm for something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate his dinner with great <w>gust</w> after a long day of hiking.",
                            "target_lang_translations": {
                                "zh": "徒步旅行了一整天后，他吃晚餐时显得非常有<w>兴致</w>。",
                                "ru": "После долгого дня похода он ел ужин с большим <w>усердием</w>.",
                                "cs": "Po dlouhém dni túry jedl večeři s velkou <w>chutí</w>."
                            }
                        },
                        {
                            "text": "The children played in the park with such <w>gust</w> that they were exhausted by evening.",
                            "target_lang_translations": {
                                "zh": "孩子们在公园里玩得非常有<w>兴致</w>，到了晚上都精疲力竭了。",
                                "ru": "Дети играли в парке с таким <w>воодушевлением</w>, что к вечеру были совершенно измотаны.",
                                "cs": "Děti si v parku hrály s takovým <w>zápalem</w>, že byly večer vyčerpané."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事物的极大享受或热情（多见于文学用语）。",
                        "ru": "Большое удовольствие или энтузиазм при выполнении чего-либо (устаревшее или литературное).",
                        "cs": "Velké potěšení nebo nadšení pro něco (zastaralé nebo literární)."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兴致",
                                "target_lang_sense_clarification": "指做某事时的热情和兴趣。"
                            },
                            {
                                "target_lang_word": "热忱",
                                "target_lang_sense_clarification": "指极大的热情。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "охота",
                                "target_lang_sense_clarification": "сильное желание или интерес к чему-либо"
                            },
                            {
                                "target_lang_word": "усердие",
                                "target_lang_sense_clarification": "старание и рвение в деле"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chuť",
                                "target_lang_sense_clarification": "velký zájem nebo potěšení z činnosti"
                            },
                            {
                                "target_lang_word": "zápal",
                                "target_lang_sense_clarification": "velké nadšení a horlivost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "362fc05b-e8e9-38db-9168-8dcb5b8edcd8",
                    "sense_definition": "To blow in strong, sudden bursts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>gust</w> as the dark clouds approached the city.",
                            "target_lang_translations": {
                                "zh": "随着乌云逼近城市，风开始<w>一阵阵地刮</w>了起来。",
                                "ru": "Ветер начал <w>дуть порывами</w>, когда тёмные тучи приблизились к городу.",
                                "cs": "Vítr začal <w>foukat v nárazech</w>, jak se k městu blížila tmavá mračna."
                            }
                        },
                        {
                            "text": "Outside, the cold air was <w>gusting</w> through the narrow streets all night.",
                            "target_lang_translations": {
                                "zh": "外面，冷空气整晚都在狭窄的街道上<w>一阵阵地吹</w>过。",
                                "ru": "Снаружи холодный воздух всю ночь <w>дул порывами</w> по узким улицам.",
                                "cs": "Venku studený vzduch celou noc <w>foukal v nárazech</w> úzkými ulicemi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "风猛烈地一阵阵吹过。",
                        "ru": "Дуть сильными, внезапными порывами.",
                        "cs": "Foukat v silných, náhlých poryvech."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阵风",
                                "target_lang_sense_clarification": "作动词用时，指风一阵阵地刮。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дуть порывами",
                                "target_lang_sense_clarification": "о ветре, который усиливается и ослабевает"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "foukat v nárazech",
                                "target_lang_sense_clarification": "o větru, který zesiluje a slábne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "251dd40b-2e21-3f35-9143-4a2855563c3a",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the report is Dr. <w>Gust</w>.",
                            "target_lang_translations": {
                                "zh": "这份报告的作者是<w>格斯特</w>博士。",
                                "ru": "Автор отчёта — доктор <w>Гаст</w>.",
                                "cs": "Autorem zprávy je doktor <w>Gust</w>."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Gust</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "zh": "昨天我在会议上遇到了一位名叫<w>格斯特</w>先生的人。",
                                "ru": "Вчера на конференции я встретил человека по фамилии <w>Гаст</w>.",
                                "cs": "Včera jsem na konferenci potkal muže jménem pan <w>Gust</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。",
                        "ru": "Фамилия.",
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "格斯特",
                                "target_lang_sense_clarification": "Gust 作为姓氏的音译。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Гаст",
                                "target_lang_sense_clarification": "транслитерация фамилии Gust"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Gust",
                                "target_lang_sense_clarification": "přepis příjmení Gust"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}