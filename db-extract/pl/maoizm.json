                    {
                        "sense_id": "11e05fe0-d821-354f-b22f-34ef50395c70",
                        "entry_id": "db50c204-000a-3d82-be29-7df9616458ae",
                        "glosses": [
                            "sformułowana przez Mao Tse-tunga doktryna Komunistycznej Partii Chin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc81cae9-b919-42dd-af9c-94092f47f691",
                                "sense_id": "11e05fe0-d821-354f-b22f-34ef50395c70",
                                "text": "William E. Griffith już w 1964 r. wyrażał nadzieję, że aczkolwiek maoizm nie zdobył w Europie poważniejszych wpływów, to jednak może on przyczynić się do „rosnącego zróżnicowania\" komunizmu europejskiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3622deff-79af-4727-b501-738221b62895",
                        "source_entry_id": "db50c204-000a-3d82-be29-7df9616458ae",
                        "source_sense_id": "11e05fe0-d821-354f-b22f-34ef50395c70",
