                    {
                        "translation_id": "f215f7e2-dc06-4118-9bb4-1333a9a2784b",
                        "source_entry_id": "7d1c4cfa-fb2d-312a-a387-33004acc1019",
                        "source_sense_id": "8ad5df9d-b3cb-3a79-83ee-5de312716052",
                        "source_sense_description": "iemand die toegezegd heeft met een partner in het huwelijk te willen treden",
                        "target_lang_word": "novio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
