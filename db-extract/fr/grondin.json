        "fr-extract.jsonl": [
            {
                "entry_id": "42bbb9f5-7623-37f4-94db-92988b405ba7",
                "word": "Grondin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "63b8b13e-1959-3b24-a4c7-a29e8d5aeebd",
                        "entry_id": "42bbb9f5-7623-37f4-94db-92988b405ba7",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bcca9f1-975d-402b-9ac4-a5bd1aa21f14",
                                "sense_id": "63b8b13e-1959-3b24-a4c7-a29e8d5aeebd",
                                "text": "Je revois les grands sombreros et les mantilles\n Y s’appelait Aimé Grondin\n Y avait les bras comme des rondins\n Et pis un torse de Rodin\n Et pis l’ corps raide comme un sapin\n Y était fort comme un taureau\n Mais y était doux comme un agneau\n La vie lui coulait sur le dos\n Comme l’eau sur le dos d’un canard sauvage."
                            },
                            {
                                "example_id": "8261784d-0606-4ab6-b21e-e636294c51be",
                                "sense_id": "63b8b13e-1959-3b24-a4c7-a29e8d5aeebd",
                                "text": "Le Canadien Éliot Grondin a décroché la médaille d'argent en snowboard cross aux Jeux olympiques de Pékin, jeudi, au Parc de ski acrobatique de Genting, dans une finale serrée jusqu'au bout."
                            },
                            {
                                "example_id": "196c2b9f-1e75-47b6-8331-4c518dcf8300",
                                "sense_id": "63b8b13e-1959-3b24-a4c7-a29e8d5aeebd",
                                "text": "Je prends beaucoup de plaisir à courir l’américaine (disputée en relais avec Donovan Grondin)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "5e3cce79-2df3-3579-ac57-4e71a920a0e1",
                "word": "grondin",
                "pos": "noun",
