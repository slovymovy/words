{
    "word_family": [
        "ingenious",
        "ingenuous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                    "sense_definition": "The ability to solve difficult problems in original, clever, and inventive ways.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creativity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pyramids demonstrate the <w>ingenuity</w> of the ancient Egyptians.",
                            "target_lang_translations": {
                                "ru": "Пирамиды демонстрируют <w>изобретательность</w> древних египтян."
                            }
                        },
                        {
                            "text": "Solving this complex puzzle required a great deal of <w>ingenuity</w>.",
                            "target_lang_translations": {
                                "ru": "Решение этой сложной головоломки потребовало большой <w>находчивости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "inventiveness",
                        "creativity",
                        "cleverness"
                    ],
                    "common_phrases": [
                        "show great ingenuity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность решать сложные задачи оригинальными, умными и изобретательными способами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобрета́тельность",
                                "target_lang_sense_clarification": "способность находить новые, оригинальные решения"
                            },
                            {
                                "target_lang_word": "нахо́дчивость",
                                "target_lang_sense_clarification": "умение быстро находить выход из затруднительного положения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd37c08-b1b1-3911-8cee-d337fa1ccfaf",
                    "sense_definition": "The quality of being honest and straightforward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with such <w>ingenuity</w> that everyone believed his sincere apology.",
                            "target_lang_translations": {
                                "ru": "Он говорил с такой искренностью, что все поверили его чистосердечному извинению."
                            }
                        },
                        {
                            "text": "Her <w>ingenuity</w> in admitting the mistake immediately earned her much respect.",
                            "target_lang_translations": {
                                "ru": "Её прямота в признании ошибки сразу же вызвала к ней большое уважение."
                            }
                        }
                    ],
                    "synonyms": [
                        "honesty",
                        "sincerity",
                        "frankness"
                    ],
                    "antonyms": [
                        "deceit",
                        "dishonesty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely considered archaic or rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество честности и прямоты (устар.)."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "52c1c48e-5cb6-34f0-beb4-efa8ab2a109b",
                    "sense_definition": "An ingenuous or naive action or thought.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child's simple <w>ingenuity</w> was charming to all the adults present.",
                            "target_lang_translations": {
                                "ru": "Простодушная наивность ребёнка очаровала всех присутствующих взрослых."
                            }
                        },
                        {
                            "text": "His <w>ingenuity</w> led him to trust the stranger without any hesitation.",
                            "target_lang_translations": {
                                "ru": "Его доверчивость побудила его без колебаний довериться незнакомцу."
                            }
                        }
                    ],
                    "synonyms": [
                        "naivety",
                        "innocence"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely considered archaic or rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наивный или простодушный поступок или мысль (устар.)."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}