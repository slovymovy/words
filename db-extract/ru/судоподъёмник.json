                    {
                        "translation_id": "dafa18e3-acc6-43c0-ba81-1454ed8b5fc0",
                        "source_entry_id": "f646b798-360d-3816-a775-72db5abafa69",
                        "source_sense_id": "8d1d9727-4266-374f-b159-b499a64640fc",
                        "target_lang_word": "ascenseur à bateaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascenseur à bateaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7820e5-aa57-32b7-86f9-8df4573a542c",
                                        "entry_id": "c913315f-cd7e-305c-ae8f-d3aa7d7155a3",
                                        "glosses": [
                                            "Dispositif permettant à un bateau de franchir, le plus souvent dans un bac plein d’eau, un important dénivelé qui nécessiterait autrement un grand nombre d’écluses successives."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27e98e66-4b7c-4f22-be1b-631cf887625c",
                                                "sense_id": "aa7820e5-aa57-32b7-86f9-8df4573a542c",
                                                "text": "L’ascenseur à bateaux des Fontinettes, étudié par M. Barbet, ingénieur en chef de la société, et construit sous sa direction, a été reçu provisoirement le 19 avril 1888, par le service des ponts et chaussées, inauguré officiellement le 8 juillet suivant et est depuis lors en pleine activité."
                                            },
                                            {
                                                "example_id": "619d6b60-5dcc-4af4-b11d-67df39a9a296",
                                                "sense_id": "aa7820e5-aa57-32b7-86f9-8df4573a542c",
                                                "text": "D’après l’office de tourisme du pays de Phalsbourg, il s’agit d’un « ascenseur à bateaux unique en son genre en Europe ». Aménagé sur le canal de la Marne au Rhin entre les communes de Saint-Louis et d’Arzviller, « il permet aux plaisanciers de franchir le seuil du massif vosgien en rattrapant un dénivelé de 44,55 m en quelques minutes »."
                                            },
                                            {
                                                "example_id": "34e9e164-b32a-4f9b-bb96-86c4e4e8c598",
                                                "sense_id": "aa7820e5-aa57-32b7-86f9-8df4573a542c",
                                                "text": "Après six ans de fermeture, l’ascenseur à bateaux des Fontinettes rouvre le 1ᵉʳ août, si la commission de sécurité en valide la possibilité, quelques jours plus tôt."
                                            }
                                        ]
                                    }
