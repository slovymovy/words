                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "larmes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On percevait dans la pénombre un doux <w>pleurer</w> que rien ne semblait pouvoir consoler."
                        },
                        {
                            "text": "Ce <w>pleurer</w> silencieux exprimait un désespoir bien plus profond que de grands éclats."
                        }
