                ],
                "senses": [
                    {
                        "sense_id": "b8e68493-3f59-33dd-94ef-c2c70826734b",
                        "entry_id": "056a48fa-844a-3834-a698-1f77e7576e54",
                        "glosses": [
                            "Rendre salubre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c166c954-b6f1-4615-977e-e2e02d6c5d8d",
                                "sense_id": "b8e68493-3f59-33dd-94ef-c2c70826734b",
                                "text": "Ils offriroient l’inappréciable avantage, par leur végétation, de salubriser notre air et nos eaux; de recréer nos sens par leur verdure et leurs fruits; de prospérer dans des lieux où un plus grand arbre ne trouveroit pas assez de substance."
                            },
                            {
                                "example_id": "bc505146-7ed1-4747-8d2b-d0e77b0b3f12",
                                "sense_id": "b8e68493-3f59-33dd-94ef-c2c70826734b",
                                "text": "Les tentatives de salubriser les idéologies attachées au capitalisme, n’ont satisfait ni la critique, ni l'opinion publique."
                            }
                        ]
                    }
                ],
