                                "sense_id": "f54ef90c-5901-3582-8348-21d99c7ec93f",
                                "text": "Waarna kwam de vrede van Munster?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d662fa7-0e95-3c18-bb38-283740a24145",
                        "entry_id": "3a793202-f113-33db-8b7b-42f683266141",
