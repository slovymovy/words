                        "target_lang_word": "Auschwitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auschwitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cbf68f-8c2c-3a1b-b66c-163d1ecead10",
                                        "entry_id": "195385d1-f52e-39be-b1f4-676e04f1bb5c",
                                        "glosses": [
                                            "deutscher Name einer Stadt in der polnischen Woiwodschaft Kleinpolen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d072d03-85a1-4d3e-834e-d4daa5325a54",
                                                "sense_id": "f7cbf68f-8c2c-3a1b-b66c-163d1ecead10",
                                                "text": "Auschwitz ist eine polnische Stadt an der Weichsel."
                                            },
                                            {
                                                "example_id": "b4a263b1-1c21-469f-9d6b-3af8af5d8b02",
                                                "sense_id": "f7cbf68f-8c2c-3a1b-b66c-163d1ecead10",
                                                "text": "„Auschwitz war bis 1939 ein armseliges Städtchen von 14000 Einwohnern, die Hälfte Polen, die Hälfte Juden, dazu 61 Volksdeutsche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "171cf3aa-48a2-31ce-9f6b-f3b346882a68",
                                        "entry_id": "195385d1-f52e-39be-b1f4-676e04f1bb5c",
                                        "glosses": [
                                            "ein deutsches Konzentrationslager im Zweiten Weltkrieg"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b40d018-4a00-4794-b219-89c090621c3a",
                                                "sense_id": "171cf3aa-48a2-31ce-9f6b-f3b346882a68",
                                                "text": "Das Konzentrationslager Auschwitz gilt weltweit als Symbol für den Nazi-Terror und wurde 1979 zum Weltkulturerbe ernannt."
                                            },
                                            {
                                                "example_id": "1e839da8-7296-4b1f-9b19-db5b41a8c6a3",
                                                "sense_id": "171cf3aa-48a2-31ce-9f6b-f3b346882a68",
                                                "text": "Die Befreiung des Konzentrations- und Vernichtungslagers Auschwitz-Birkenau in Polen durch die Rote Armee am 27. Januar 1945 jährt sich zum 70. Mal."
                                            },
                                            {
                                                "example_id": "6416a958-e514-4c76-8bdb-ae12c63a78da",
                                                "sense_id": "171cf3aa-48a2-31ce-9f6b-f3b346882a68",
                                                "text": "„Am Nachmittag des nächsten Tages – es war Samstag, der 27. Januar 1945 – befreiten Soldaten der 60. Armee der 1. Ukrainischen Front Auschwitz und seine Nebenlager.“"
                                            },
                                            {
                                                "example_id": "cdc27eed-13da-450d-846e-c088fb77121b",
                                                "sense_id": "171cf3aa-48a2-31ce-9f6b-f3b346882a68",
                                                "text": "„Seine Eltern wurden in Lodz, seine Geschwister in Treblinka ermordet, seine Schwiegereltern in Auschwitz vergast.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
