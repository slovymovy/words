                                "target_senses": [
                                    {
                                        "sense_id": "2609af56-e2fc-3462-a51b-548b412058e0",
                                        "entry_id": "47232b59-d791-37c1-84b6-02a95f4cc2c5",
                                        "glosses": [
                                            "związany z triumfem, dotyczący triumfu, wyrażający triumf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa39728-92b2-484c-b6dc-0f5a62d7712a",
                                                "sense_id": "2609af56-e2fc-3462-a51b-548b412058e0",
                                                "text": "Zobaczyła go pod łukiem triumfalnym w samo południe."
                                            },
                                            {
                                                "example_id": "ce95a53a-2ae2-491e-971f-c264a0de5ea3",
                                                "sense_id": "2609af56-e2fc-3462-a51b-548b412058e0",
                                                "text": "Żołnierze wznieśli okrzyk triumfalny na cześć wodza."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73633cb1-2b52-4696-8037-de0dd3635997",
                        "source_entry_id": "bee2b69a-f577-34ad-bc76-94d1658eb7bf",
                        "source_sense_description": "of or relating to a triumph",
                        "target_lang_word": "триумфальный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "триумфальный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae6e430-9f81-37d2-91d4-62352a4475eb",
                                        "entry_id": "3d741032-7d86-330f-afd9-1829298f8c25",
                                        "glosses": [
                                            "истор. связанный, соотносящийся по значению с существительным триумф"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78487831-fd98-4f0e-84bc-51fcfd9c85bf",
                                                "sense_id": "9ae6e430-9f81-37d2-91d4-62352a4475eb",
                                                "text": "Термы, портики, кипарисы, монастыри в мрачных оградах, церкви, форумы, триумфальные колонны и квадриги, библиотеки, все сокровища древнего мира, собранные за циклопической кладкой городских стен и башен, делают город похожим на Рим."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2669fe1-c350-370f-b3bd-cf2097a12e4c",
                                        "entry_id": "3d741032-7d86-330f-afd9-1829298f8c25",
                                        "glosses": [
                                            "перен. свойственный триумфу, успеху, победе, характерный для них; торжественный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5835a188-a6a0-4afb-bf75-97c9d0e0bb9a",
                                                "sense_id": "c2669fe1-c350-370f-b3bd-cf2097a12e4c",
                                                "text": "Литература сплошных гениев, если судить по их триумфальным заявлениям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d744e2-bed5-38f9-95e6-44017e330e8d",
                                        "entry_id": "3d741032-7d86-330f-afd9-1829298f8c25",
                                        "glosses": [
                                            "перен. сопровождающийся необычайным успехом, триумфом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06af0242-a29c-4ccf-9d2d-90fcb3b28d9e",
                                                "sense_id": "e2d744e2-bed5-38f9-95e6-44017e330e8d",
                                                "text": "Канадцы совершили триумфальную поездку по Европе: с разгромным счетом они победили сборную команду ФРГ, коллектив Дортмунда, сборную Южной Швеции, города Мальме."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72d8cb43-d33f-420b-942c-82b5fcd1defd",
