                        "translation_id": "c3110761-8745-4480-abb4-4d61c332bee6",
                        "source_entry_id": "af351e51-1184-31fe-a3a1-c0f10dde0aa5",
                        "source_sense_id": "e6d2b87d-acc0-3d0b-8793-4a971adf7778",
