                                        "entry_id": "b95cb3a1-e6ea-37e2-a870-003d031ba7d3",
                                        "glosses": [
                                            "Fragment de la croûte terrestre, de la lithosphère, se déplaçant de quelques centimètres par an dans des directions différentes et formant des zones de divergence, de subduction, de collision et de coulissage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19da853-30b6-47b5-96d5-a013b432c8d8",
                                                "sense_id": "908e6aa7-565b-3cce-947a-dad5fd206dcb",
                                                "text": "Les plaques tectoniques forment toute la croûte terrestre. Les plaques tectoniques ne semblent pouvoir glisser que sur de la matière en fusion."
                                            },
                                            {
                                                "example_id": "756a9a32-a49d-41e2-bd39-5ed8f4186b11",
                                                "sense_id": "908e6aa7-565b-3cce-947a-dad5fd206dcb",
                                                "text": "L'Indonésie connaît une activité sismique et volcanique fréquente en raison de sa position sur la «ceinture de feu» du Pacifique, où les plaques tectoniques entrent en collision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7290ccd3-bafa-33ad-9daf-6ccc33a4923e",
                                        "entry_id": "b95cb3a1-e6ea-37e2-a870-003d031ba7d3",
                                        "glosses": [
                                            "Épaisse couche ; chape de plomb."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c41e6e-170b-4214-8878-40b0045d0a97",
                                                "sense_id": "7290ccd3-bafa-33ad-9daf-6ccc33a4923e",
                                                "text": "La plaque tectonique de droite qui recouvre la télé depuis 1995 au moins s'est effondrée."
                                            }
                                        ]
                                    }
