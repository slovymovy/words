                                    {
                                        "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                        "entry_id": "4f2a4611-acdd-3d74-83a9-8182bb455a5c",
                                        "glosses": [
                                            "To perform this dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107d196b-35f6-4f2e-81f5-dd3a2600c8d3",
                                                "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                                "text": "You had one eye in the mirror as / you watched yourself gavotte / And all the girls dreamed that they'd be your partner / They'd be your partner, and / You're so vain"
                                            },
                                            {
                                                "example_id": "f253a828-cf88-44d1-b977-660e79c28036",
                                                "sense_id": "0361a81a-ec7d-3eaa-bee3-c0d128c7c4bb",
                                                "text": "\"Upbeat I can do.\" Karen paged through the options for a while, her pretty face tight, jaw clamped shut, then perked up at something she saw and jabbed the buttons like she wanted to speak to their manager. A bright, jangly guitar burst out of the wall speakers. George Harrison's voice announced that contrary to appearances, it was all right. Karen gavotted into the middle of the bar to dance, eyes closed in rapture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c7a75b5-b18e-47d2-88be-28d7998a552d",
                        "source_entry_id": "56b7387a-68c0-38c5-a63b-9ce6790210f0",
                        "source_sense_id": "d1cd1912-33e7-3b10-bd03-b9a1fe8b05f9",
                        "target_lang_word": "gavotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gavotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e096352-0f07-3a19-82c1-0c7433b68263",
                                        "entry_id": "d07c75cb-212f-3614-89a2-6cd35e0dff9e",
                                        "glosses": [
                                            "Air de danse à deux temps, qui est composé de deux reprises et dont le mouvement est quelquefois vif et gai, quelquefois tendre et lent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dd3d84-9d74-4880-bf91-acfbaa49544c",
                                                "sense_id": "0e096352-0f07-3a19-82c1-0c7433b68263",
                                                "text": "Il se mit à chantonner je ne sais quelle gavotte, sachant bien qu’avec les Allemandes il lui fallait agir progressivement."
                                            },
                                            {
                                                "example_id": "26324d56-d3b6-477e-ae37-4615506f3f6c",
                                                "sense_id": "0e096352-0f07-3a19-82c1-0c7433b68263",
                                                "text": "[…]; une gavotte de ce bon vieux Jean-Sébastien Bach se mit soudain à chanter dans sa tête avec ses accords de clavecin nets et acides comme du jus de citron."
                                            },
                                            {
                                                "example_id": "b8bd66d9-d374-4ee3-bdbe-5f81ad98a0f0",
                                                "sense_id": "0e096352-0f07-3a19-82c1-0c7433b68263",
                                                "text": "Jouer une gavotte."
                                            }
                                        ]
                                    },
