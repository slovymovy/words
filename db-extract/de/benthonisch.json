                "senses": [
                    {
                        "sense_id": "3d27da99-64a1-384a-886a-f0619dd880e3",
                        "entry_id": "fc375d04-1d08-3999-b6eb-e6cf95b966f3",
                        "glosses": [
                            "das Benthos betreffend, zum Benthos gehörend, am Boden der Gewässer lebend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e79d290-b17c-472c-9456-d1a213534af9",
                                "sense_id": "3d27da99-64a1-384a-886a-f0619dd880e3",
                                "text": "„Ich möchte dabei darauf hinweisen, dass alle diese Formen, die hier als benthonisch angesprochen werden, gegenüber den normalen Ammoniten gerade in der Lobenlinie starke Abweichungen zeigen, die vielfach vielleicht mit Recht als Degenerationserscheinungen aufgefasst worden sind, dass also die daraus gezogenen Schlüsse auf ihre Lebensweise nicht auf die Ammoniten überhaupt verallgemeinert werden dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
