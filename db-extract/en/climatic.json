    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9328a574-7c44-3ba8-9bc1-a539542fee9e",
                "word": "climatic",
                "pos": "adj",
                "lang_code": "en",
