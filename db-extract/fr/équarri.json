                "senses": [
                    {
                        "sense_id": "13b37678-946c-3756-b549-4d61d3e6a905",
                        "entry_id": "dfed8807-04d1-3e2e-8d1d-efb60ec60a2e",
                        "glosses": [
                            "Dressé de manière à être taillé à angle droit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e56486-ce3d-4230-9304-122b77a2edf3",
                                "sense_id": "13b37678-946c-3756-b549-4d61d3e6a905",
                                "text": "Un arbre équarri."
                            },
                            {
                                "example_id": "0a47eab5-6d10-4722-bc6f-ce691cc36423",
                                "sense_id": "13b37678-946c-3756-b549-4d61d3e6a905",
                                "text": "Assis sur un banc mal équarri\nJ’attends mon tour."
                            },
                            {
                                "example_id": "01682479-27eb-444a-8a92-6335058dcea6",
                                "sense_id": "13b37678-946c-3756-b549-4d61d3e6a905",
                                "text": "La baraque des bûcherons était une pièce unique, assez vaste, où se trouvait une longue table formée par un assemblage de mauvaises planches posées sur six piquets fichés en terre, deux bancs mal équarris, et une espèce de bat-flanc recouvert de paille."
                            },
                            {
                                "example_id": "5edac494-6176-41d6-a6f5-cdf9cc784a75",
                                "sense_id": "13b37678-946c-3756-b549-4d61d3e6a905",
                                "text": "La fonction publique est un corset rigide qui redresse tous les corps, transforme les bois noueux en planches bien équarries."
                            }
                        ]
                    },
                    {
                        "sense_id": "97d75ae3-0a78-334e-ae39-93c8782e45fc",
                        "entry_id": "dfed8807-04d1-3e2e-8d1d-efb60ec60a2e",
                        "glosses": [
                            "Dépecé, en parlant des animaux abattus ou morts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf4f65a-9abe-4e14-b42a-574e131d81cf",
                                "sense_id": "97d75ae3-0a78-334e-ae39-93c8782e45fc",
                                "text": "Un cheval équarri."
                            },
                            {
                                "example_id": "4d11d323-b356-4554-b158-81242d7ba13d",
                                "sense_id": "97d75ae3-0a78-334e-ae39-93c8782e45fc",
                                "text": "Ils s’asseyaient en face de ces gens qui croient aux marques, aux slogans, aux images qui leur sont proposés, et qui mangent de la graisse de bœuf équarri en en trouvant délicieux le parfum végétal et l’odeur de noisette (mais eux-mêmes, sans trop savoir pourquoi, avec le sentiment curieux, presque inquiétant, que quelque chose leur échappait, ne trouvaient-ils pas belles certaines affiches, formidables certains slogans, géniaux certains films-annonces ?)."
                            }
                        ]
                    }
