                                "target_senses": [
                                    {
                                        "sense_id": "fb5757c0-6e74-3ffd-b8fc-9986327b75dc",
                                        "entry_id": "24b07953-0546-3dca-a0f6-c741b20c296f",
                                        "glosses": [
                                            "Of an appropriate or pertinent nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c6ff0e-f779-445e-8ede-354b634322c2",
                                                "sense_id": "fb5757c0-6e74-3ffd-b8fc-9986327b75dc",
                                                "text": "Nothing easier. I received not long ago a map from my friend, Augustus Petermann, at Leipzig. Nothing could be more apropos."
                                            },
                                            {
                                                "example_id": "2002ddb5-6ce0-46a9-a726-e761c1484883",
                                                "sense_id": "fb5757c0-6e74-3ffd-b8fc-9986327b75dc",
                                                "text": "A particularly apropos line many will remember from this film was the closing shot of a Times editorial reading \"Is There No Sense of Decency?\""
                                            },
                                            {
                                                "example_id": "0f70b209-b3cf-4419-baf7-068ae079eff1",
                                                "sense_id": "fb5757c0-6e74-3ffd-b8fc-9986327b75dc",
                                                "text": "Served outside the shell and sliced in bite-sized pieces, it's as apropos for a first date as a business dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c3e479f-5fac-3d87-bcce-76024ea86ddd",
                                        "entry_id": "24b07953-0546-3dca-a0f6-c741b20c296f",
                                        "glosses": [
                                            "By the way, incidental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ca858d-7e5f-4e1c-914f-bf63d6712579",
                                                "sense_id": "3c3e479f-5fac-3d87-bcce-76024ea86ddd",
                                                "text": "Sherlock Holmes rose and lit his pipe. \"No doubt you think that you are complimenting me in comparing me to [C. Auguste] Dupin,\" he observed. \"Now, in my opinion, Dupin was a very inferior fellow. That trick of his of breaking in on his friends' thoughts with an apropos remark after a quarter of an hour's silence is really very showy and superficial. He had some analytical genius, no doubt; but he was by no means such a phenomenon as [Edgar Allan] Poe appeared to imagine.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apropos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae7afb7-169e-330a-b563-67918588064d",
                                        "entry_id": "db5b124b-7ae9-3124-9828-1cdb62f0dce9",
                                        "glosses": [
                                            "Regarding, concerning, in regard to, on the subject of"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf43f5c2-0b8f-42df-a9cf-3d820088c7bf",
                                                "sense_id": "5ae7afb7-169e-330a-b563-67918588064d",
                                                "text": "Few have the same root and branch obsession with the recent past or the avenger’s recall (‘the necessity for long memory and sarcasm in argument’, as he wrote apropos the old left intelligentsia in New York)."
                                            }
