                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7694e9-8451-4adf-8304-0b56e4006602",
                                "sense_id": "eadadbf9-44f3-366e-ae49-d08f1eb9d453",
                                "text": "Die Anaptyxe ist eine Unterkategorie der Lauteinschaltung, also ein Vorgang, bei dem durch Änderung der Silbenstruktur die Aussprache erleichtert wird. Dies geschieht in diesem Falle durch silbenbildenden Einschub eines Vokals, besonders vor l, m und r."
                            }
