                                        "entry_id": "9fbb6850-8b7b-3c76-9740-382f027e21d2",
                                        "glosses": [
                                            "in der Nähe von bitter, das Gegenteil von süßlich"
                                        ],
                                        "tags": [
                                            "geschmacklich oder auch über einen Geruch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f415d4-f261-4e03-bea0-29abfa966aa5",
                                                "sense_id": "95ebb451-83e0-3368-bb69-bfbb39bed61c",
                                                "text": "Besonders heikel ist der verfeinerte Gaumen ja mit den simpelsten Drinks: „Ein guter Daiquiri ist angenehm herb und ein klein wenig süß; ein schlechter kann wie Salzsäure schmecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e44cdcfd-d70f-38f8-bdea-48a868797d0e",
                                        "entry_id": "9fbb6850-8b7b-3c76-9740-382f027e21d2",
                                        "glosses": [
                                            "eher mit groberen geraderen Zügen ausgestattet"
                                        ],
                                        "tags": [
                                            "vom Äußeren her"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d24a952-623d-4897-be63-631762e91468",
                                                "sense_id": "e44cdcfd-d70f-38f8-bdea-48a868797d0e",
                                                "text": "Seine neue Freundin ist eine herbe Schönheit mit langen, dunklen Haaren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf3c882d-f90b-32c1-9379-bef71fbca6db",
                                        "entry_id": "9fbb6850-8b7b-3c76-9740-382f027e21d2",
                                        "glosses": [
                                            "deutlich und unangenehm"
                                        ],
                                        "tags": [
                                            "verstärkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ea0656-0874-40bb-a6b9-f6ccea9d01b0",
                                                "sense_id": "cf3c882d-f90b-32c1-9379-bef71fbca6db",
                                                "text": "Gestern hat Hanne herbe Kritik von ihrer Mutter einstecken müssen."
                                            },
                                            {
                                                "example_id": "3e95a6bd-925a-43f4-af35-f41fb62bf794",
                                                "sense_id": "cf3c882d-f90b-32c1-9379-bef71fbca6db",
                                                "text": "„Weil Blüten bei der männlich dominierten Gruppe nicht ankamen, zog der Aromajockey immer herbere Register, am Ende warf er Eichenrinde ins Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fc1f7f3-7e9d-4c9f-bf6a-78f22d192270",
                        "source_entry_id": "e90e2664-b4bb-3d80-826d-1bb393ed1cfa",
