        "ru-extract.jsonl": [
            {
                "entry_id": "592e6a9a-d2b7-304d-94a4-1e55cb67914d",
                "word": "порой",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "bb4ce498-576c-4a91-b57c-33f1b6355ab8",
                        "entry_id": "592e6a9a-d2b7-304d-94a4-1e55cb67914d",
                        "tags": [
                            "stressed"
                        ],
                        "form": "поро́й"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "869b76f3-11b1-30d4-bad9-5968173a3974",
                        "entry_id": "592e6a9a-d2b7-304d-94a4-1e55cb67914d",
                        "glosses": [
                            "иногда, иной раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76218345-adbe-4c27-8d19-a2365eb2b203",
                                "sense_id": "869b76f3-11b1-30d4-bad9-5968173a3974",
                                "text": "Порой она скользила меж камней, смеясь неловкости своей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "076a0fb2-3593-4b1f-ad32-c0748f237ee7",
                        "source_entry_id": "592e6a9a-d2b7-304d-94a4-1e55cb67914d",
                        "source_sense_id": "869b76f3-11b1-30d4-bad9-5968173a3974",
                        "target_lang_word": "sometimes",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sometimes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                        "entry_id": "6ea2c7e4-2fd6-383d-81a2-e5366c9381a5",
                                        "glosses": [
                                            "On some occasions, over some periods, or in certain circumstances, but not always."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec4f805-14b1-4fc8-987b-7329df2490fd",
                                                "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                                "text": "Sometimes I sit and think, but mostly I just sit."
                                            },
                                            {
                                                "example_id": "bf598915-2b5c-4912-af12-8074b71793c7",
                                                "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                                "text": "It is good that we sometimes be contradicted, and ill though of, and that we always bear it well, even when we deserve to be well spoken of : perfect peace and security cannot be had in this world."
                                            },
                                            {
                                                "example_id": "cb74cc8a-5ef1-4a32-9cc9-ea0621e071a8",
                                                "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner. He could not be induced to remain permanently at Mohair because Miss Trevor was at Asquith, but he appropriated a Hempstead cart from the Mohair stables and made the trip sometimes twice in a day."
                                            },
                                            {
                                                "example_id": "e4a23dd4-79e2-4200-8aa0-03dd3d25db03",
                                                "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            },
                                            {
                                                "example_id": "e74bfba5-d62f-43c4-9323-ac8968bdd579",
                                                "sense_id": "0dd3f03e-6091-3c24-a1f7-ad73f6efda68",
                                                "text": "In 16th and 17th century Britain, for example, women’s alopecia was sometimes interpreted as retribution for sins, including adultery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a095bc6b-5f19-3d28-9118-c736dcf5f513",
                                        "entry_id": "6ea2c7e4-2fd6-383d-81a2-e5366c9381a5",
                                        "glosses": [
                                            "On a certain occasion in the past; once."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb81752-8eb2-4407-9212-546018b7df90",
                                                "sense_id": "a095bc6b-5f19-3d28-9118-c736dcf5f513",
                                                "text": "For yee were sometimes darkenesse, but now are yee light in the Lord: walke as children of light […]"
                                            },
                                            {
                                                "example_id": "0ff1dba2-c69e-4ab8-8ec7-4aa480cd2c97",
                                                "sense_id": "a095bc6b-5f19-3d28-9118-c736dcf5f513",
                                                "text": "What art thou that vſurp’ſt this time of night, / Together with that Faire and Warlike forme / In which the Maieſty of buried Denmarke / Did ſometimes march : By Heauen I charge thee ſpeake."
                                            },
                                            {
                                                "example_id": "53022942-3463-47b5-8dd3-abed023139a9",
                                                "sense_id": "a095bc6b-5f19-3d28-9118-c736dcf5f513",
                                                "text": "They detract, ſcoffe and raile ſaith one, & barke at mee on every ſide, but I, like that Albanian dog ſometimes given to Alexander for a preſent, vindico me ab illis ſolo contemptu, I ly ſtill and ſleep, vindicate my ſelfe by contempt alone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sometimes",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1141947-172d-386e-8bd2-bd5033a7dc3a",
                                        "entry_id": "47a80a11-e1d7-3693-a6ae-98d72990837e",
                                        "glosses": [
                                            "Former; sometime."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a701386e-ab92-4490-83c2-d25b5cfefa39",
                                                "sense_id": "f1141947-172d-386e-8bd2-bd5033a7dc3a",
                                                "text": "Farewell old Gaunt, thy ſometimes brothers wife / With her companion Greefe, muſt end her life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0884207-36eb-4219-96c0-c36caeb23f27",
                        "source_entry_id": "592e6a9a-d2b7-304d-94a4-1e55cb67914d",
                        "source_sense_id": "869b76f3-11b1-30d4-bad9-5968173a3974",
                        "target_lang_word": "eventually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eventually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "In the end; at some later time, especially after a long time, a series of problems, struggles, delays or setbacks."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d63c5a-1839-4b76-83fc-e99675f25613",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "Everyone's true colors will be revealed eventually."
                                            },
                                            {
                                                "example_id": "1f136da1-cd9c-4634-bd0a-fbcea66353fa",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "She didn't arrive. Eventually, we started without her."
                                            },
                                            {
                                                "example_id": "d13c67cb-ffcf-41b4-a8af-60f0ecb611ed",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "He hopes eventually to attend nursing school."
                                            },
                                            {
                                                "example_id": "ccf5b733-0dd6-4f74-bbdb-3923972596f3",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "Eventually, the railway opened on Monday, December 14, 1896, with a universal fare of 1d. collected at the turnstiles, and conditions were immediately chaotic, as many passengers travelled round and round, and refused to leave the cars."
                                            },
                                            {
                                                "example_id": "79ff4c40-c140-484f-80cc-6eb7e54ab7ee",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "It had taken nine years from the evening that Truman first showed up with a pie plate at her mother's door, but his dogged perseverance eventually won him the hand of his boyhood Sunday school crush."
                                            },
                                            {
                                                "example_id": "a30ee782-8713-4cb2-85ec-aec7529fd1c2",
                                                "sense_id": "1b0e8186-5eb7-3dec-a08e-d15da1bc846c",
                                                "text": "President Volodymyr Zelensky has known the day would come when the idea of another “forever war” became unappealing to NATO, and the world’s largest military alliance eventually sought to wind down its involvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6f712c4-5f89-3e0f-8ad8-1cc8663c8a10",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "For some tail; for all terms beyond some term; with only finitely many exceptions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda1e907-f13f-4e2e-a3c8-6496bca6d2b5",
                                                "sense_id": "f6f712c4-5f89-3e0f-8ad8-1cc8663c8a10",
                                                "text": "Eventually, all prime numbers are odd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c47485-a5f1-34bd-9692-f6df8b9a75e3",
                                        "entry_id": "0fdf22a8-42e1-315c-83ba-0b30eaccd7c1",
                                        "glosses": [
                                            "Possibly, potentially, perhaps."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e224df-8ec8-4d7a-a803-7b833dde4144",
                                                "sense_id": "60c47485-a5f1-34bd-9692-f6df8b9a75e3",
                                                "text": "I will come eventually, but haven't decided yet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
