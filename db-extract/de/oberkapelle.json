                ],
                "senses": [
                    {
                        "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                        "entry_id": "50169ca8-b5b7-3846-aaff-23999666b485",
                        "glosses": [
                            "baulich getrennter oberer Kapellenraum einer Doppelkapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c694301-2622-4b83-97f4-4665b5b258e4",
                                "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                                "text": "„Die Oberkapelle (den Hl. Erhard und Ursula geweiht) war für Gottesdienste gedacht, vor allem wenn der Kaiser auf der Burg zugegen war.“"
                            },
                            {
                                "example_id": "7773a16f-fa87-44d2-a3e0-6c7eb1755947",
                                "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                                "text": "„Aus eben jener Zeit, konkret aus den Jahren zwischen 1271 und 1286, stammt nach den Forschungen von F.-H. Hye die älteste erhaltene farbige Darstellung des Tiroler Wappens über dem Eingang in der Mitte der Westwand der Oberkapelle von Schloß Tirol.“"
                            },
                            {
                                "example_id": "bbbc3d55-d4db-425f-8699-ce59e86b162f",
                                "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                                "text": "„Die Oberkapelle ist dem Heiligen Kreuz geweiht.“"
                            },
                            {
                                "example_id": "e77a3799-818f-4865-8a07-dcd322948949",
                                "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                                "text": "„Die Apsisausmalung ähnelt den Malereien in der Oberkapelle, die aus dem fünften Jahrzehnt des 14. Jahrhunderts stammen und mit der Kapelle von Schloß Tirol in Zusammenhang stehen.“"
                            },
                            {
                                "example_id": "e71b6605-dd2c-48f0-8f21-c7b792ff30e7",
                                "sense_id": "f242e45a-4571-33c1-adc4-2a5f0501629b",
                                "text": "„Nach und nach erfolgte außerdem die Freilegung der Wandmalereien, in der Unterkapelle 1854, in der Oberkapelle 1868 bis 1875.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
