                                            {
                                                "example_id": "e4b51adf-1ae7-4a46-a838-edb7f861cf42",
                                                "sense_id": "868a77db-faf1-3cad-9ca0-1c829b8cb0aa",
                                                "text": "Das ist ein krasser Widerspruch."
                                            },
                                            {
                                                "example_id": "199d51d8-b9ad-4d0f-88bc-a8942d86febe",
                                                "sense_id": "868a77db-faf1-3cad-9ca0-1c829b8cb0aa",
                                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                                            },
                                            {
                                                "example_id": "27bb34f4-1692-4549-adac-3bc416b7baf3",
                                                "sense_id": "868a77db-faf1-3cad-9ca0-1c829b8cb0aa",
