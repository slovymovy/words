                        ],
                        "examples": [
                            {
                                "example_id": "61c464ab-1c19-4781-bcf2-e37af4bd6c81",
                                "sense_id": "9c1f71bf-a5ed-356f-90bd-905c0d9b8f58",
                                "text": "Het was de tijd waarin de jonge Speranski op het hoogtepunt van zijn roem stond, en waarin zijn hervormingen energiek werden doorgevoerd. De tsaar was in die augustusmaand tijdens een ritje uit zijn rijtuig gevallen, had daarbij zijn voet bezeerd en verbleef drie weken in Peterhof, waar hij elke dag uitsluitend Speranski ontving."
                            },
                            {
                                "example_id": "a1c8e3cb-b79e-426b-8df7-f44a54895b97",
                                "sense_id": "9c1f71bf-a5ed-356f-90bd-905c0d9b8f58",
                                "text": "De kachel kan weer uit, de warme kleding kan weer terug in de kast en de chocolademelk hoeft nog niet te worden opgewarmd. Want na een natte augustusmaand komt de zomer even terug."
                            }
                        ]
                    }
