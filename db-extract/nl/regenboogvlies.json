                                        "sense_id": "1658fa76-0435-3c72-bb0a-69247ec2178b",
                                        "entry_id": "32e7b5a6-decf-3c91-8c90-50ffcc9b63db",
                                        "glosses": [
                                            "A plant of the genus Iris, common in the northern hemisphere, and generally having attractive blooms (See Iris (plant) on Wikipedia.Wikipedia)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b902339-c176-4ce8-aacc-d5db98f124ce",
                                                "sense_id": "1658fa76-0435-3c72-bb0a-69247ec2178b",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "322f2f4b-06eb-31ea-adb0-340ad650f897",
                                        "entry_id": "32e7b5a6-decf-3c91-8c90-50ffcc9b63db",
                                        "glosses": [
                                            "The contractile membrane perforated by the pupil, which adjusts to control the amount of light reaching the retina, and which forms the colored portion of the eye (See Iris (anatomy) on Wikipedia.Wikipedia)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3aae7bd-7dfc-315f-93c7-b20d7ec27e15",
