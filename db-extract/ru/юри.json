                                    {
                                        "sense_id": "1744acca-2d83-374d-bd20-ae2620b6c01c",
                                        "entry_id": "e3222897-1d19-3316-8ee7-cbfcc8eef863",
                                        "glosses": [
                                            "Sous-genre de manga qui présente des relations féminines plus ou moins homosexuelles."
                                        ],
                                        "tags": [
                                            "Fiction japonaise"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ea2610-149b-48a9-8fff-470dca9e410b",
                                                "sense_id": "1744acca-2d83-374d-bd20-ae2620b6c01c",
                                                "text": "Le manga du 24 décembre !\n(Mais il y en aura encore un pour demain)\nEncore un yuri qui devrait être édité en France depuis des années, c'est honteux qu'il soit pas chez nous !"
                                            },
                                            {
                                                "example_id": "4b98afe9-36ed-4a67-8458-2516483bdee8",
                                                "sense_id": "1744acca-2d83-374d-bd20-ae2620b6c01c",
                                                "text": "Opposé au yaoi, le yuri est lui exclusivement centré sur les relations intimes entre personnages féminins. Bien qu’ils ne courent pas les rues, et sont loin d’être les animés les plus vus, ils sont pourtant bel et bien présents. Et peut-être plus que vous ne le pensez !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
