                                "sense_id": "7355a3aa-f5c3-3e20-ab8b-fbd6243a3bdc",
                                "text": "Si vraiment ça va mal, vous pouvez toujours essayer le thé salé additionné de Worcestershire-sauce et de Mango-chutney…"
                            },
                            {
                                "example_id": "54a1ce85-d1e9-4b2a-9d83-05e7456da9fa",
                                "sense_id": "7355a3aa-f5c3-3e20-ab8b-fbd6243a3bdc",
                                "text": "Pulpe du tamarinier : ingrédient de la Worcestershire-Sauce."
                            }
                        ]
                    }
