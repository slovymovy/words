                "senses": [
                    {
                        "sense_id": "2f6770a9-4fcd-3a99-b343-dcb76dc7e3a1",
                        "entry_id": "0ecc7c03-de91-3e00-9e66-f698b5c3de2f",
                        "glosses": [
                            "Donner un caractère mogol à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6317d94d-dd23-4577-8d4b-9dad6a159fce",
                                "sense_id": "2f6770a9-4fcd-3a99-b343-dcb76dc7e3a1",
                                "text": "Si cette opinion doit changer, c’est évidemment dans les Pays du Nord, et je sais bien que beaucoup de voyageurs, — surtout de l’espèce \"tourbillon\", ne gardent de l’Inde que des souvenirs mogols ou mogolisés......"
                            },
                            {
                                "example_id": "efcd58d4-3213-4812-a499-9c1bcfa34070",
                                "sense_id": "2f6770a9-4fcd-3a99-b343-dcb76dc7e3a1",
                                "text": "Elle s’était mogolisée à tel point par l’usage de l’opium que je me souviens encore du mouvement de répulsion que j’éprouvais au toucher de sa main."
                            }
                        ]
                    }
