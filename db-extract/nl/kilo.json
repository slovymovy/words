                            "singular"
                        ],
                        "form": "kilootje"
                    },
                    {
                        "form_id": "7e90c011-b584-412c-8c86-f3981be9bd76",
                        "entry_id": "34b2dc77-8d05-3795-aa0a-740f111cfa47",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "kilootjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
                        "entry_id": "34b2dc77-8d05-3795-aa0a-740f111cfa47",
                        "glosses": [
                            "informele afkorting van \\\"kilogram\\\" de SI-eenheid van massa (symbool: kg)"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "5f867e06-fef9-4377-8af7-ee5c79e5b1f9",
                                "sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
                                "text": "Op zo'n grote massa (hoeveelheid) maakt een kilo meer of minder niets uit."
                            },
                            {
                                "example_id": "5cc273f3-a6c7-479e-8592-42d491c15f7f",
                                "sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
                                "text": "Vraag het aan Gentenaar Geert Claus, uitbater van frituur Emily’s, hoe zwaar het is. Hij legt de laatste meters te voet af, met de fiets aan de hand. ‘Een paar tandjes te weinig, een paar kilootjes te veel.’"
                            },
                            {
                                "example_id": "2cf69c64-e587-49a1-b0e6-0e6bacecab09",
                                "sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
                                "text": "‘Mijn rugzak woog wel 20 kilo, en nu loopt iedereen met dat ultralichte spul. Ik begrijp al die haast van tegenwoordig niet. Wij vonden 25 kilometer per dag al prima, terwijl jullie nu ruim 40 kilometer per dag doorjakkeren. Neem toch de tijd, zoiets maak je maar een keer in je leven mee. Het heeft me nooit losgelaten na al die jaren.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "1554776d-8880-39e5-804b-ed666355799a",
                        "entry_id": "34b2dc77-8d05-3795-aa0a-740f111cfa47",
                        "glosses": [
                            "informele afkorting van \\\"kilogram\\\" (kilogramkracht) een eenheid voor een gewicht of kracht, (niet volgens het SI-stelsel, maar heel gebruikelijk)"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c874ae71-7d18-4e63-8d66-ffed01f73bf3",
                                "sense_id": "1554776d-8880-39e5-804b-ed666355799a",
                                "text": "De prijs per kilo is ongeveer gelijk aan die van onze concurrent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8b3988c-b394-46a3-a936-b81843c1c8ca",
                        "source_entry_id": "34b2dc77-8d05-3795-aa0a-740f111cfa47",
                        "source_sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
                        "source_sense_description": "informele afkorting van \"kilogram\" de SI-eenheid van massa (symbool: kg)",
                        "target_lang_word": "Kilo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kilo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                        "entry_id": "85ab26a7-81b4-302a-9555-5e6498bfcfee",
                                        "glosses": [
                                            "Kilogramm"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7308119a-7eca-4ec9-91c7-fffc2e92a28c",
                                                "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                                "text": "Dieser Gegenstand wiegt knapp ein Kilo."
                                            },
                                            {
                                                "example_id": "9987ca22-f3d0-405f-9fb5-55ed9fc34ab7",
                                                "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                                "text": "„Und wenn man wirklich auch einmal körperlich flüchten müssen sollte: Gold ist sehr schwer: in den 1990er-Jahren hatten 10.000 Euro ungefähr einen Kilo gewogen – seit 2006 hieß es dann 15.000 Euro für ein Kilo – die Rechenunterschiede ergeben sich aus dem Preisanstieg und aus der mittlerweile auch erfolgten Abwertung des US-Dollar.“"
                                            },
                                            {
                                                "example_id": "1f4e5ebf-88f0-4353-adf4-142d79713d9a",
                                                "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                                "text": "„Im industriellen Zweig bedarf es 100 Liter an Wasser um einen Kilo Stahl herzustellen.“"
                                            },
                                            {
                                                "example_id": "0571252c-97cf-4a68-9c09-e0986b58a50d",
                                                "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                                "text": "„Das Geschütz wurde im Jahr 1411 in Braunschweig gegossen, wog gut 8000 Kilo und soll durch ein knapp drei Meter langes Rohr mit einem Kaliber von 76 Zentimetern schwere Steinkugeln verschossen haben.“"
                                            },
                                            {
                                                "example_id": "53823086-f011-4e0f-9369-d9d9bcfa41bc",
                                                "sense_id": "eb2d7f1f-70a4-3f90-91ca-690fb1a2edf8",
                                                "text": "„Wobei das jetzt anders war; in den vergangenen Monaten purzelten die Kilos, und die Sachen hingen nur noch lose an ihr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66fe7462-c1a1-49bd-94a7-afa36d06a31b",
                        "source_entry_id": "34b2dc77-8d05-3795-aa0a-740f111cfa47",
                        "source_sense_id": "ab1b3fc0-e4f5-3a44-8100-579d4588d3d4",
