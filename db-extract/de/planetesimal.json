                    {
                        "translation_id": "58759bed-2df0-4301-b0f4-68d403344061",
                        "source_entry_id": "d43f88df-acaa-3f2d-9002-ed8d77ae1e82",
                        "source_sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                        "target_lang_word": "planétésimal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planétésimal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f8ea331-905a-3b83-8dfd-ffb669954d80",
                                        "entry_id": "3f6c079a-08c7-3720-be6d-046f77386e02",
                                        "glosses": [
                                            "Qui concerne les planétésimaux, futurs constituants des planètes."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a60ac78-4a1d-4c90-89ba-3b4aa4e22e9f",
                                                "sense_id": "4f8ea331-905a-3b83-8dfd-ffb669954d80",
                                                "text": "Ces processus, qui sont caractéristiques de la formation d’entités planétésimales, sont en plein accord avec les éléments produits par l’environnement terrestre (Lune, Terre et plus particulièrement météorites). […] La théorie planétésimale rend compte d’un épuisement des gaz rares car ils ne sont pas retenus par des objets de faible champ gravitationnel et sont perdus quand les résidus de la nébuleuse gazeuse se dissipent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "planétésimal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "094aa9f5-4a17-35ba-8638-22f733fdb0ea",
                                        "entry_id": "3f67a0e3-04e6-37ed-b9c9-b6d5f1b5ba86",
                                        "glosses": [
                                            "Objet céleste de 5 à 10 kilomètres de diamètre et d’une masse de l’ordre de mille milliards de tonnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d1690ca-0793-4dc4-aaa8-9647ecb0a86d",
                                                "sense_id": "094aa9f5-4a17-35ba-8638-22f733fdb0ea",
                                                "text": "En revanche, la dispersion des fragments ne se produit que si l’énergie cinétique liée à l’impact est supérieure à l’énergie gravitationnelle du planétésimal."
                                            },
                                            {
                                                "example_id": "6bde2034-7886-4f6e-82ff-5cb5cba8bc4d",
                                                "sense_id": "094aa9f5-4a17-35ba-8638-22f733fdb0ea",
                                                "text": "L’agglomération de poussières peut donner naissance à des petits corps appelés planétésimaux."
                                            },
                                            {
                                                "example_id": "b27c02df-3a2c-4d38-8179-5de4576d7f87",
                                                "sense_id": "094aa9f5-4a17-35ba-8638-22f733fdb0ea",
                                                "text": "Pour les astronomes, ces cratères sont très anciens et racontent l’histoire de la formation du système solaire, lorsque les planétésimaux entraient en collision avec les jeunes planètes pour fusionner avec elles."
                                            },
                                            {
                                                "example_id": "a0892ac4-e841-48ff-9b3c-d671aa988504",
                                                "sense_id": "094aa9f5-4a17-35ba-8638-22f733fdb0ea",
                                                "text": "L’inventaire chimique de WASP-39 b laisse à penser qu’elle a été créée à partir de la collision et de la fusion de plusieurs corps plus petits qualifiés de planétésimaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
