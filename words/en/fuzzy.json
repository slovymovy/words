{
    "word_family": [
        "fuzz",
        "fuzziness",
        "fuzzily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4524def1-d228-3d86-b8b1-7b079d945e77",
                    "sense_definition": "Covered with fuzz or a large number of tiny loose fibres like a carpet or many stuffed animals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child loved to hug her <w>fuzzy</w> teddy bear before going to sleep.",
                            "target_lang_translations": {
                                "ru": "Ребенок обожал обнимать своего <w>пушистого</w> плюшевого мишку перед сном.",
                                "zh": "那个孩子睡前喜欢抱着她那只<w>毛茸茸的</w>泰迪熊。",
                                "cs": "Dítě milovalo objímání svého <w>chlupatého</w> medvídka před spaním."
                            }
                        },
                        {
                            "text": "After washing the new sweater, it became even more <w>fuzzy</w> and soft.",
                            "target_lang_translations": {
                                "ru": "После стирки новый свитер стал еще более <w>ворсистым</w> и мягким.",
                                "zh": "新毛衣洗过以后变得更加<w>毛茸茸</w>、也更柔软了。",
                                "cs": "Po vyprání nového svetru se stal ještě více <w>chlupatým</w> a měkkým."
                            }
                        }
                    ],
                    "antonyms": [
                        "smooth",
                        "bald"
                    ],
                    "common_phrases": [
                        "fuzzy blanket",
                        "fuzzy slippers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый пушком или большим количеством мелких свободных волокон, как ковер или мягкие игрушки.",
                        "zh": "表面覆盖着绒毛或大量细小松散纤维的，如地毯或许多毛绒玩具那样。",
                        "cs": "Pokrytý chmýřím nebo velkým množstvím drobných volných vláken, jako koberec nebo plyšové hračky."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушистый",
                                "target_lang_sense_clarification": "о текстуре поверхности"
                            },
                            {
                                "target_lang_word": "ворсистый",
                                "target_lang_sense_clarification": "имеющий ворс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毛茸茸的",
                                "target_lang_sense_clarification": "表面有绒毛、茸毛，常形容玩具、衣物等"
                            },
                            {
                                "target_lang_word": "绒毛状的",
                                "target_lang_sense_clarification": "有一层细小绒毛，强调表面质感"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chlupatý",
                                "target_lang_sense_clarification": "o povrchu s hustými vlákny nebo srstí"
                            },
                            {
                                "target_lang_word": "plyšový",
                                "target_lang_sense_clarification": "o měkkém, jemném povrchu hraček"
                            },
                            {
                                "target_lang_word": "chmýřovitý",
                                "target_lang_sense_clarification": "pokrytý jemným chmýřím"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8173ea97-6456-36f9-8078-faf4fc8ed9f1",
                    "sense_definition": "Not clear; unfocused or blurry in appearance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I finally threw out a large stack of <w>fuzzy</w> photos that were out of focus.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то выбросил большую стопку <w>размытых</w> фотографий, которые были не в фокусе.",
                                "zh": "我终于扔掉了一大摞失焦的<w>模糊</w>照片。",
                                "cs": "Konečně jsem vyhodil velkou hromadu <w>rozmazaných</w> fotek, které byly mimo ohnisko."
                            }
                        },
                        {
                            "text": "Without my glasses, everything in the distance looks like a <w>fuzzy</w> image.",
                            "target_lang_translations": {
                                "ru": "Без очков всё вдали кажется <w>нечётким</w> изображением.",
                                "zh": "不戴眼镜时，远处的一切看起来都像一幅<w>模糊的</w>图像。",
                                "cs": "Bez brýlí vypadá vše v dálce jako <w>neostrý</w> obraz."
                            }
                        }
                    ],
                    "synonyms": [
                        "blurry",
                        "hazy",
                        "indistinct",
                        "unclear"
                    ],
                    "antonyms": [
                        "clear",
                        "sharp",
                        "focused"
                    ],
                    "common_phrases": [
                        "fuzzy image",
                        "fuzzy picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неясный; расплывчатый или размытый на вид.",
                        "zh": "不清楚的；看起来失焦、模糊的。",
                        "cs": "Nejasný; rozmazaný nebo neostrý na pohled."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размытый",
                                "target_lang_sense_clarification": "не в фокусе"
                            },
                            {
                                "target_lang_word": "нечёткий",
                                "target_lang_sense_clarification": "лишённый ясности"
                            },
                            {
                                "target_lang_word": "нерезкий",
                                "target_lang_sense_clarification": "о фотографии или изображении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊的",
                                "target_lang_sense_clarification": "外观不清楚、不清晰"
                            },
                            {
                                "target_lang_word": "失焦的",
                                "target_lang_sense_clarification": "失去焦点，常用于照片或图像"
                            },
                            {
                                "target_lang_word": "朦胧的",
                                "target_lang_sense_clarification": "轮廓不清"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozmazaný",
                                "target_lang_sense_clarification": "postrádající ostré kontury"
                            },
                            {
                                "target_lang_word": "neostrý",
                                "target_lang_sense_clarification": "mimo ohnisko, např. u fotografie"
                            },
                            {
                                "target_lang_word": "mlhavý",
                                "target_lang_sense_clarification": "působící dojmem nejasnosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44bac9bf-f295-3170-8fa2-80b39eb32d6a",
                    "sense_definition": "Vague, imprecise, or not clearly defined in thought or memory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My recollection of that event is <w>fuzzy</w> because it happened so long ago.",
                            "target_lang_translations": {
                                "ru": "Мои воспоминания об этом событии <w>смутные</w>, потому что это было очень давно.",
                                "zh": "那件事过去太久了，我对它的记忆已经很<w>模糊</w>了。",
                                "cs": "Moje vzpomínka na tu událost je <w>mlhavá</w>, protože se to stalo před tak dlouhou dobou."
                            }
                        },
                        {
                            "text": "The witness gave a <w>fuzzy</w> description of the suspect, making it hard for the police.",
                            "target_lang_translations": {
                                "ru": "Свидетель дал <w>неясное</w> описание подозреваемого, что затруднило работу полиции.",
                                "zh": "目击者对嫌疑人的描述很<w>含糊</w>，这让警方很难办。",
                                "cs": "Svědek podal <w>nejasný</w> popis podezřelého, což policii ztížilo práci."
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "imprecise",
                        "ambiguous",
                        "uncertain",
                        "woolly"
                    ],
                    "antonyms": [
                        "precise",
                        "definite",
                        "clear-cut"
                    ],
                    "common_phrases": [
                        "fuzzy memory",
                        "fuzzy logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смутный, неточный или не имеющий четких очертаний в мыслях или памяти.",
                        "zh": "在思想或记忆中模糊、笼统或没有清晰界限的。",
                        "cs": "Nejasný, nepřesný nebo špatně definovaný v myšlenkách či paměti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутный",
                                "target_lang_sense_clarification": "о воспоминаниях или идеях"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "неопределенный"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "нечетко сформулированный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊的",
                                "target_lang_sense_clarification": "指记忆、想法等不清楚"
                            },
                            {
                                "target_lang_word": "含糊的",
                                "target_lang_sense_clarification": "指表述、概念等不明确"
                            },
                            {
                                "target_lang_word": "朦胧的",
                                "target_lang_sense_clarification": "指印象、记忆朦胧不明"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "mlhavý",
                                "target_lang_sense_clarification": "o vzpomínkách nebo představách"
                            },
                            {
                                "target_lang_word": "nejasný",
                                "target_lang_sense_clarification": "nedostatečně definovaný"
                            },
                            {
                                "target_lang_word": "neurčitý",
                                "target_lang_sense_clarification": "postrádající přesnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3964428d-9613-3de7-9739-67528de409b0",
                    "sense_definition": "Warm and comforting; affectionate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a long time since anything had made her feel that <w>fuzzy</w> inside.",
                            "target_lang_translations": {
                                "ru": "Прошло много времени с тех пор, как что-то заставляло её чувствовать такое <w>тепло</w> внутри.",
                                "zh": "已经很久没有什么事能让她内心感到那样<w>温暖</w>了。",
                                "cs": "Už je to dlouho, co ji něco naposledy naplnilo takovým <w>hřejivým</w> pocitem."
                            }
                        },
                        {
                            "text": "The movie was full of warm <w>fuzzy</w> feelings that made the audience smile.",
                            "target_lang_translations": {
                                "ru": "Фильм был полон теплых и <w>нежных</w> чувств, которые заставляли зрителей улыбаться.",
                                "zh": "这部电影充满了温暖而<w>柔和的</w>情感，让观众都露出了笑容。",
                                "cs": "Film byl plný vřelých a <w>příjemných</w> pocitů, které diváky rozesmály."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warm fuzzy feeling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'warm and fuzzy'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплый и утешительный; вызывающий приятные, нежные чувства.",
                        "zh": "温暖而令人安慰的；带有亲切、柔和感情的。",
                        "cs": "Teplý a uklidňující; vyvolávající příjemné, něžné pocity."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятный",
                                "target_lang_sense_clarification": "вызывающий душевное тепло"
                            },
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "о чувствах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "温暖的",
                                "target_lang_sense_clarification": "使人感到内心温暖、安慰"
                            },
                            {
                                "target_lang_word": "柔和的",
                                "target_lang_sense_clarification": "形容情感柔软、亲切"
                            },
                            {
                                "target_lang_word": "暖心的",
                                "target_lang_sense_clarification": "口语中指让人心里暖暖的"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hřejivý",
                                "target_lang_sense_clarification": "vyvolávající pocit tepla a pohody"
                            },
                            {
                                "target_lang_word": "příjemný",
                                "target_lang_sense_clarification": "o pocitech, které potěší"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b61aa89-571a-3265-a08b-519341201efe",
                    "sense_definition": "Employing or relating to fuzzy logic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The washing machine uses <w>fuzzy</w> logic to determine the best water level.",
                            "target_lang_translations": {
                                "ru": "Стиральная машина использует <w>нечёткую</w> логику для определения оптимального уровня воды.",
                                "zh": "这台洗衣机使用<w>模糊</w>逻辑来确定最佳水位。",
                                "cs": "Pračka používá <w>fuzzy</w> logiku k určení nejlepší hladiny vody."
                            }
                        },
                        {
                            "text": "Engineers applied <w>fuzzy</w> sets to solve the complex control problem.",
                            "target_lang_translations": {
                                "ru": "Инженеры применили <w>нечёткие</w> множества для решения сложной задачи управления.",
                                "zh": "工程师们应用了<w>模糊</w>集合来解决这个复杂的控制问题。",
                                "cs": "Inženýři aplikovali <w>fuzzy</w> množiny k vyřešení komplexního problému řízení."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuzzy logic",
                        "fuzzy set"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics and computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использующий нечеткую логику или относящийся к ней.",
                        "zh": "使用模糊逻辑的，或与模糊逻辑有关的。",
                        "cs": "Využívající fuzzy logiku nebo se k ní vztahující."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечёткий",
                                "target_lang_sense_clarification": "в контексте математической логики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "数学、计算机中的术语，如模糊逻辑、模糊集合"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "fuzzy",
                                "target_lang_sense_clarification": "v odborném kontextu matematiky a informatiky"
                            },
                            {
                                "target_lang_word": "rozmazaný",
                                "target_lang_sense_clarification": "v kontextu neostré logiky"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74087ed6-5e99-3f0b-aae5-f3afe5451967",
                    "sense_definition": "A very small piece of plush material such as lint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You've got a <w>fuzzy</w> on your coat that must have come from your scarf.",
                            "target_lang_translations": {
                                "ru": "У тебя на пальто <w>ворсинка</w>, должно быть, от шарфа.",
                                "zh": "你外套上有一小团<w>绒毛</w>，肯定是从围巾上掉下来的。",
                                "cs": "Máš na kabátě <w>vlákno</w>, které muselo pocházet z tvé šály."
                            }
                        },
                        {
                            "text": "She spent a few minutes picking every little <w>fuzzy</w> off the velvet sofa.",
                            "target_lang_translations": {
                                "ru": "Она потратила несколько минут, собирая каждую маленькую <w>пушинку</w> с бархатного дивана.",
                                "zh": "她花了几分钟把天鹅绒沙发上的每一小点<w>绒毛</w>都拈掉了。",
                                "cs": "Strávila pár minut sbíráním každého malého <w>chmýří</w> ze sametové pohovky."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for lint"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленький кусочек мягкого материала, например, ворсинка или пушинка.",
                        "zh": "一小点柔软的绒状物，如衣物上的绒毛或毛絮。",
                        "cs": "Velmi malý kousek měkkého materiálu, např. vlákno nebo chmýří."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушинка",
                                "target_lang_sense_clarification": "маленький комочек пуха"
                            },
                            {
                                "target_lang_word": "ворсинка",
                                "target_lang_sense_clarification": "отделившееся волокно ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绒毛",
                                "target_lang_sense_clarification": "衣物等上的细小绒屑、毛絮"
                            },
                            {
                                "target_lang_word": "毛絮",
                                "target_lang_sense_clarification": "很小的纤维或毛絮"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vlákno",
                                "target_lang_sense_clarification": "odpadlé z látky"
                            },
                            {
                                "target_lang_word": "chmýří",
                                "target_lang_sense_clarification": "drobné částečky materiálu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf85a396-8496-3b90-8266-b35b6c4b428f",
                    "sense_definition": "Something covered with fuzz or hair, as an animal or plush toy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you don't yet have a ferret, this book can help you decide whether a <w>fuzzy</w> is for you.",
                            "target_lang_translations": {
                                "ru": "Если у вас еще нет хорька, эта книга поможет вам решить, подходит ли вам такой <w>пушистик</w>.",
                                "zh": "如果你还没有养雪貂，这本书可以帮助你判断这种<w>毛茸茸的小家伙</w>是否适合你。",
                                "cs": "Pokud ještě nemáš fretku, tato kniha ti pomůže rozhodnout, zda je takový <w>chlupáč</w> pro tebe."
                            }
                        },
                        {
                            "text": "The toddler carried his favorite little <w>fuzzy</w> everywhere he went.",
                            "target_lang_translations": {
                                "ru": "Малыш повсюду носил с собой своего любимого маленького <w>пушистика</w>.",
                                "zh": "那个幼儿走到哪里都带着他最喜欢的那个小<w>毛绒玩具</w>。",
                                "cs": "Batole nosilo svého oblíbeného malého <w>plyšáka</w> všude, kam šlo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a small furry animal or toy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то покрытое пухом или шерстью, например, животное или мягкая игрушка.",
                        "zh": "带有绒毛或毛发的东西，如小动物或毛绒玩具。",
                        "cs": "Něco pokryté chmýřím nebo srstí, např. zvíře nebo plyšová hračka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушистик",
                                "target_lang_sense_clarification": "о зверьке или игрушке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毛茸茸的小家伙",
                                "target_lang_sense_clarification": "口语，指毛茸茸的小动物"
                            },
                            {
                                "target_lang_word": "毛绒玩具",
