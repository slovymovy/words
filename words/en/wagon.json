{
    "word_family": [
        "wagoner",
        "wagonette",
        "wagonload",
        "station-wagon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8237375e-d7a3-3bcb-89ba-80b45bfdcf47",
                    "sense_definition": "A heavy four-wheeled vehicle, usually horse-drawn, used for transporting goods or people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers loaded the wooden <w>wagon</w> with hay before heading back to the barn.",
                            "target_lang_translations": {
                                "ru": "Фермеры нагрузили деревянную <w>телегу</w> сеном, прежде чем отправиться обратно в сарай.",
                                "zh": "农民们在回谷仓前把干草装上了木制<w>马车</w>。"
                            }
                        },
                        {
                            "text": "A horse-drawn <w>wagon</w> moved slowly along the dusty country road.",
                            "target_lang_translations": {
                                "ru": "Запряженная лошадьми <w>повозка</w> медленно двигалась по пыльной проселочной дороге.",
                                "zh": "一辆马车在尘土飞扬的乡间小路上缓慢行驶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cart",
                        "wain"
                    ],
                    "common_phrases": [
                        "horse-drawn wagon",
                        "covered wagon",
                        "wooden wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелое четырехколесное транспортное средство, обычно запряженное лошадьми, используемое для перевозки грузов или людей.",
                        "zh": "一种重型四轮车辆，通常由马匹牵引，用于运输货物或人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "телега",
                                "target_lang_sense_clarification": "традиционная четырехколесная повозка"
                            },
                            {
                                "target_lang_word": "повозка",
                                "target_lang_sense_clarification": "общее название для колесного транспорта на живой тяге"
                            },
                            {
                                "target_lang_word": "фургон",
                                "target_lang_sense_clarification": "крытая повозка"
                            },
                            {
                                "target_lang_word": "воз",
                                "target_lang_sense_clarification": "груженая повозка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马车",
                                "target_lang_sense_clarification": "由马牵引的车辆"
                            },
                            {
                                "target_lang_word": "货车",
                                "target_lang_sense_clarification": "用于运输货物的车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26a1add5-790c-3ec9-bd4a-f95bab1e197b",
                    "sense_definition": "A child's toy vehicle with four wheels and a long handle for pulling.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "toys",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy pulled his red <w>wagon</w> filled with stuffed animals across the lawn.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик вез по лужайке свою красную <w>тележку</w>, наполненную мягкими игрушками.",
                                "zh": "小男孩拉着装满毛绒玩具的红色<w>小推车</w>穿过草坪。"
                            }
                        },
                        {
                            "text": "She sat in the toy <w>wagon</w> while her older brother pulled her around the park.",
                            "target_lang_translations": {
                                "ru": "Она сидела в игрушечной <w>тележке</w>, пока старший брат катал ее по парку.",
                                "zh": "她坐在玩具<w>小推车</w>里，哥哥拉着她在公园里转悠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toy wagon"
                    ],
                    "common_phrases": [
                        "red wagon",
                        "pull a wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детское игрушечное транспортное средство с четырьмя колесами и длинной ручкой для того, чтобы его тянуть.",
                        "zh": "一种儿童玩具车，有四个轮子和一根长柄，可以拉着走。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "игрушечная или небольшая платформа на колесах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小推车",
                                "target_lang_sense_clarification": "儿童玩具手推车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4926d6b8-6dc3-394c-a90f-0d2573b1fac7",
                    "sense_definition": "A railway vehicle used for carrying goods or minerals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rail_transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The freight train consisted of fifty <w>wagons</w> carrying coal to the power station.",
                            "target_lang_translations": {
                                "ru": "Товарный поезд состоял из пятидесяти <w>вагонов</w>, везущих уголь на электростанцию.",
                                "zh": "这列货运火车由五十节运煤到发电站的<w>货车车厢</w>组成。"
                            }
                        },
                        {
                            "text": "Workers spent the afternoon loading the railway <w>wagon</w> with heavy steel beams.",
                            "target_lang_translations": {
                                "ru": "Рабочие провели вторую половину дня, загружая железнодорожный <w>вагон</w> тяжелыми стальными балками.",
                                "zh": "工人们花了一下午时间把沉重的钢梁装上铁路<w>货车车厢</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "railroad car",
                        "truck",
                        "freight car"
                    ],
                    "common_phrases": [
                        "railway wagon",
                        "freight wagon",
                        "goods wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Железнодорожное транспортное средство, используемое для перевозки грузов или полезных ископаемых.",
                        "zh": "用于运输货物或矿产的铁路车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вагон",
                                "target_lang_sense_clarification": "железнодорожный, обычно товарный"
                            },
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "открытый железнодорожный вагон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "货车车厢",
                                "target_lang_sense_clarification": "铁路货运车厢"
                            },
                            {
                                "target_lang_word": "敞车",
                                "target_lang_sense_clarification": "一种无盖的铁路货车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b4b4dd8-9756-3465-aaa0-ddac8bfdc5c1",
                    "sense_definition": "A station wagon; a car with a long body and a rear door for luggage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "automobiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family packed their suitcases into the back of the <w>wagon</w> for the road trip.",
                            "target_lang_translations": {
                                "ru": "Семья сложила чемоданы в багажник <w>универсала</w> для поездки.",
                                "zh": "一家人为公路旅行把行李箱装进了<w>旅行车</w>的后部。"
                            }
                        },
                        {
                            "text": "He decided to buy a station <w>wagon</w> because it had more room for his dogs.",
                            "target_lang_translations": {
                                "ru": "Он решил купить автомобиль с кузовом <w>универсал</w>, потому что в нем было больше места для его собак.",
                                "zh": "他决定买一辆<w>旅行车</w>，因为那里面有更多空间给他的狗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "station wagon",
                        "estate car"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип кузова легкового автомобиля с длинным багажным отделением и задней дверью.",
                        "zh": "旅行车；一种车身较长且后部有行李门的汽车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "универсал",
                                "target_lang_sense_clarification": "тип кузова автомобиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旅行车",
                                "target_lang_sense_clarification": "一种汽车车身类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293ae8e4-a79d-3345-9864-aa59628383f8",
                    "sense_definition": "A shopping cart used in a supermarket.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shopping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I filled my <w>wagon</w> with groceries and headed toward the checkout counter.",
                            "target_lang_translations": {
                                "ru": "Я наполнил свою <w>тележку</w> продуктами и направился к кассе.",
                                "zh": "我把<w>购物车</w>装满杂货，然后走向收银台。"
                            }
                        },
                        {
                            "text": "Please return your shopping <w>wagon</w> to the designated area in the parking lot.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, верните магазинную <w>тележку</w> в специально отведенное место на парковке.",
                                "zh": "请将您的<w>购物车</w>归还到停车场指定的区域。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shopping cart",
                        "trolley"
                    ],
                    "common_phrases": [
                        "shopping wagon"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly US and Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тележка для покупок, используемая в супермаркете.",
                        "zh": "超市里使用的购物推车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тележка",
                                "target_lang_sense_clarification": "магазинная корзина на колесах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "购物车",
                                "target_lang_sense_clarification": "超市购物用的推车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d1ae14-2b93-3908-ae3e-08f663b03f80",
                    "sense_definition": "A police van used for transporting prisoners.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspects were handcuffed and led into the back of the <w>wagon</w>.",
                            "target_lang_translations": {
                                "ru": "На подозреваемых надели наручники и отвели в заднюю часть <w>автозака</w>.",
                                "zh": "嫌疑人被戴上手铐，带进了<w>囚车</w>后部。"
                            }
                        },
                        {
                            "text": "A paddy <w>wagon</w> waited outside the building to take the protesters away.",
                            "target_lang_translations": {
                                "ru": "Снаружи здания ждал <w>воронок</w>, чтобы увезти протестующих.",
                                "zh": "一辆<w>囚车</w>停在楼外，准备带走抗议者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paddy wagon",
                        "police van"
                    ],
                    "common_phrases": [
                        "police wagon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'paddy wagon'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский фургон, используемый для перевозки заключенных.",
                        "zh": "用于运送囚犯的警用厢式车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автозак",
                                "target_lang_sense_clarification": "специальный автомобиль для перевозки задержанных"
                            },
                            {
                                "target_lang_word": "воронок",
                                "target_lang_sense_clarification": "разговорное название полицейской машины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "囚车",
                                "target_lang_sense_clarification": "运送犯人的车辆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8320b25e-6c0a-37fd-9dfc-8148a8711e39",
                    "sense_definition": "A small cart or set of shelves on wheels used for serving food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter pushed the dessert <w>wagon</w> to our table so we could choose a cake.",
                            "target_lang_translations": {
                                "ru": "Официант подкатил десертную <w>тележку</w> к нашему столику, чтобы мы могли выбрать торт.",
                                "zh": "服务员把甜点<w>餐车</w>推到我们桌边，让我们挑选蛋糕。"
                            }
                        },
                        {
                            "text": "They used a dinner <w>wagon</w> to bring the heavy plates from the kitchen to the dining room.",
                            "target_lang_translations": {
                                "ru": "Они использовали сервировочную <w>тележку</w>, чтобы привезти тяжелые тарелки из кухни в столовую.",
                                "zh": "他们用<w>餐车</w>把沉重的盘子从厨房送到餐厅。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dinner wagon",
                        "trolley",
                        "tea cart"
                    ],
                    "common_phrases": [
                        "dessert wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая тележка или набор полок на колесах, используемые для подачи еды.",
                        "zh": "一种带轮子的小推车或架子，用于上菜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сервировочная тележка",
                                "target_lang_sense_clarification": "столик на колесах для еды"
                            },
                            {
                                "target_lang_word": "каталка",
                                "target_lang_sense_clarification": "разговорное название передвижного столика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "餐车",
                                "target_lang_sense_clarification": "餐厅内用于送餐的推车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f38eaa06-2673-3ebf-ae0f-d986c5f5c949",
                    "sense_definition": "An insulting term for an unpleasant or obnoxious woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He muttered that she was a total <w>wagon</w> after she shouted at the staff.",
                            "target_lang_translations": {
                                "ru": "Он пробормотал, что она настоящая <w>стерва</w>, после того как она накричала на персонал.",
                                "zh": "她对员工大吼大叫后，他嘟囔着说她简直是个<w>泼妇</w>。"
                            }
                        },
                        {
                            "text": "Don't be such a <w>wagon</w> and try to be nice to your neighbors for once.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>хабалкой</w> и попытайся хоть раз быть вежливой с соседями.",
                                "zh": "别那么<w>泼妇</w>，试着对邻居友好一次吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch",
                        "cow"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Irish"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительный термин для неприятной или несносной женщины.",
                        "zh": "对令人不快或讨厌的女性的侮辱性称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стерва",
                                "target_lang_sense_clarification": "грубое обращение к неприятной женщине"
                            },
                            {
                                "target_lang_word": "хабалка",
                                "target_lang_sense_clarification": "грубая, крикливая женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "形容粗鲁、蛮横的女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a7513c4-aaef-34c1-b8d7-ed89e4e5641b",
                    "sense_definition": "A derogatory term for a woman perceived as promiscuous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gossip in the village labeled her a <w>wagon</w> because of her many boyfriends.",
                            "target_lang_translations": {
                                "ru": "Деревенские сплетники прозвали ее <w>шалавой</w> из-за ее многочисленных кавалеров.",
                                "zh": "村里的流言蜚语因为她有很多男朋友而称她为<w>荡妇</w>。"
                            }
                        },
                        {
                            "text": "It is incredibly rude to call someone a <w>wagon</w> just because of how they dress.",
                            "target_lang_translations": {
                                "ru": "Невероятно грубо называть кого-то <w>потаскухой</w> только из-за того, как человек одевается.",
                                "zh": "仅仅因为一个人的穿着就称其为<w>荡妇</w>是非常粗鲁的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slapper",
                        "slut",
                        "tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Irish"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar/Pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уничижительный термин для женщины, считающейся распутной.",
                        "zh": "对被认为生活放荡的女性的贬义称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шалава",
                                "target_lang_sense_clarification": "вульгарное оскорбление женщины"
                            },
                            {
                                "target_lang_word": "потаскуха",
                                "target_lang_sense_clarification": "презрительное обозначение распутной женщины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荡妇",
                                "target_lang_sense_clarification": "对女性的侮辱性称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f71627b-5772-3a4a-a6ee-0b08efc5c617",
                    "sense_definition": "To transport goods or people using a wagon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners had to <w>wagon</w> the ore down the steep mountain path to the processing plant.",
                            "target_lang_translations": {
                                "ru": "Шахтерам приходилось <w>перевозить</w> руду на телегах вниз по крутой горной тропе к перерабатывающему заводу.",
                                "zh": "矿工们必须<w>用马车运送</w>矿石，沿着陡峭的山路送到加工厂。"
                            }
                        },
                        {
                            "text": "During the harvest, they would <w>wagon</w> produce to the local market every Saturday morning.",
                            "target_lang_translations": {
                                "ru": "Во время сбора урожая они каждое субботнее утро <w>развозили</w> продукты на рынок.",
                                "zh": "收获季节，他们每周六早上都会<w>用马车运送</w>农产品到当地市场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cart",
                        "transport",
                        "haul"
                    ],
                    "common_phrases": [
                        "wagon produce",
                        "wagon goods"
