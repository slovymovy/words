                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1618c40-1392-4627-904d-a76b2abef905",
                                                "sense_id": "f719e876-2899-3168-b6ad-c04b2ceb4573",
                                                "text": "Now that we have done the impossible we can finish it, all that remain are rather easy and surmountable obstacles."
                                            },
                                            {
                                                "example_id": "7799b28d-7a45-4588-8a47-4a30152d3060",
                                                "sense_id": "f719e876-2899-3168-b6ad-c04b2ceb4573",
                                                "text": "A spokesman for South Western Railway told RAIL that all the issues were surmountable, and that it was continuing to work with both the train supplier and the union to bring the trains into service."
                                            }
                                        ]
                                    }
                                ]
                            }
