                "senses": [
                    {
                        "sense_id": "6f230f72-bff4-35ef-9ac4-fabe4406277c",
                        "entry_id": "b4ce2014-0430-313c-a912-bab86c6e7c85",
                        "glosses": [
                            "Essayer de voir, à l’intérieur de quelque chose ou de quelqu’un, ce qui est normalement invisible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf8551f-cbc2-42bb-8047-f4d3bc66e46f",
                                "sense_id": "6f230f72-bff4-35ef-9ac4-fabe4406277c",
                                "text": "Le terme \"moléculaire\" fut adopté dans les années 1950 pour caractériser une biologie dont le défi était d’introspecter le vivant au-delà du cellulaire."
                            },
                            {
                                "example_id": "64226ed0-2fe9-4f55-81c0-c5c8c07f71cb",
                                "sense_id": "6f230f72-bff4-35ef-9ac4-fabe4406277c",
                                "text": "S'introspecter, pour se voir en tant que tel est, à l’avis du philosophe, une opération aussi radicalement impossible que celle qui consisterait à prétendre vouloir retourner ses yeux à l’intérieur de ses orbites."
                            }
                        ]
                    }
                ],
