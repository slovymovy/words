                                                "example_id": "f78e2c03-cb9e-48ba-8a1f-e8d14b752cce",
                                                "sense_id": "abb2f710-97f4-3859-b6e6-af19df6266d9",
                                                "text": "„Zu seinem siebten Geburtstag bekam er ein eigenes Pony, einen Falben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3c22802-6bd9-39df-9d55-dd0753bbf6cc",
