                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aba6a82-d481-4b29-b9c9-618e1b5813e3",
                                                "sense_id": "b28c2806-4b05-3d1c-a25c-20f44e8f14dc",
                                                "text": "It was the first time I had ever “soldiered” a horse. Soldiering means using a horse without the owner's leave or knowledge. Two of our lost horses we never found. Probably some one was soldiering them!"
                                            }
