                                        "glosses": [
                                            "An arrangement of spikes found on the tails of various stegosaurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf7b35b-a3ae-4193-a0a4-c117d3a20179",
                                                "sense_id": "45220e2b-831d-35ae-80b7-4e833a48de48",
                                                "text": "Like the thagomizer of the stegosaur, the ankylosaurid tail club was probably used to smash into attackers."
                                            },
                                            {
                                                "example_id": "48a54b12-121d-47dc-a2d5-3f7de754cc17",
                                                "sense_id": "45220e2b-831d-35ae-80b7-4e833a48de48",
                                                "text": "An Allosaurus backbone had a hole in which a Stegosaurus thagomizer fitted perfectly. Over the years, many of the fossil thagomizers that have been dug up have had broken tips."
                                            },
                                            {
                                                "example_id": "4b9e1c80-efef-4ad3-8ab7-7c228f2981e1",
                                                "sense_id": "45220e2b-831d-35ae-80b7-4e833a48de48",
                                                "text": "\"Not like that,\" Snap growled, raising her four fists, swishing her thagomizer around threateningly."
                                            }
                                        ]
                                    }
