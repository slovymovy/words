                ],
                "senses": [
                    {
                        "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                        "entry_id": "da7aea97-39d2-3874-b57c-63bf2513fc09",
                        "glosses": [
                            "Verlangen, sich neues Wissen anzueignen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac89909-2ea7-4746-a105-401891ef0cff",
                                "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                                "text": "Er hat großen Wissensdurst."
                            },
                            {
                                "example_id": "ce6245e2-13b9-4919-8684-a67ad644c939",
                                "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                                "text": "Vom Wissensdurst getrieben, las Gitta jedes Buch über Physik, das in der kleinen Stadtbibliothek zu leihen war."
                            },
                            {
                                "example_id": "d1b91339-8a7c-43c3-add5-b8152c90e565",
                                "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                                "text": "„Poseidonios ist der Erste, der den Wissensdurst stillt.“"
                            },
                            {
                                "example_id": "9c8196fd-7cfc-40f0-9365-c2ce0ce248c0",
                                "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                                "text": "„Dann rief sie Henni zu sich, erklärte und zeigte und hatte sichtlich Freude an deren Wissensdurst.“"
                            },
                            {
                                "example_id": "0225b19f-21aa-4ca7-a26d-0dfd41fb6eda",
                                "sense_id": "48c1450e-0e7d-375f-8467-452ec4366437",
                                "text": "„Das alles soll in diesem kurzen Strich stecken, auch der für seine Tüchtigkeit, seine Findigkeit und Fertigkeit gerühmte Fischer, dem vor keinem Wetter bange war, der zu viel trank, zugleich aber über einen unstillbaren Wissensdurst verfügte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
