                "translations": [
                    {
                        "translation_id": "7910ca15-c777-4445-ac0a-5e17155c33d5",
                        "source_entry_id": "2ec79f6e-e788-3bb5-b192-7e0e4d37fc52",
                        "source_sense_description": "to become wood",
                        "target_lang_word": "verhouten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verhouten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                                        "entry_id": "61f3d17a-f36f-3e0a-8302-79d25d7fb659",
                                        "glosses": [
                                            "een houtachtige structuur krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c449c4be-2036-4015-8cb1-a734bfba3f93",
                                                "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                                                "text": "„Bamboe is een alternatief voor hout. Doordat de grasplant verhout, kun je er allerlei interessante en decoratieve producten van maken”, zegt René Zaal, directeur van Moso."
                                            },
                                            {
                                                "example_id": "16f8035c-1393-4560-a721-56271281f090",
                                                "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                                                "text": "Natuurwetenschapper Charles Darwin hield zich daar ook al mee bezig: hij ontdekte dat planten onder bepaalde omstandigheden kunnen 'verhouten'. Zo groeien er bijvoorbeeld op de Canarische eilanden grote, houtachtige madeliefjes en paardenbloemen, die geen stengel hebben maar een houten stam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebdbb982-2e2b-4f28-bc29-c44840beb2d5",
                        "source_entry_id": "2ec79f6e-e788-3bb5-b192-7e0e4d37fc52",
