                ],
                "senses": [
                    {
                        "sense_id": "6e748b83-e858-37ae-b4fc-bb26a302970a",
                        "entry_id": "3b630096-4a4a-3f6c-83da-331221133278",
                        "glosses": [
                            "der Stolz, Teil seiner Nation zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217d9658-f34f-4a73-8983-3f2ce966170e",
                                "sense_id": "6e748b83-e858-37ae-b4fc-bb26a302970a",
                                "text": "Bei all der Kritik über das internationale Verhalten seines Landes, fühlte er sich in seinem Nationalstolz gekränkt."
                            },
                            {
                                "example_id": "36402e66-8a90-4b9c-83fe-6c3baa10131f",
                                "sense_id": "6e748b83-e858-37ae-b4fc-bb26a302970a",
                                "text": "„Er steht für die schlimmsten Exzesse des amerikanischen Nationalstolzes.“"
                            },
                            {
                                "example_id": "9122d91f-8cac-49a8-9a68-633cf3e5036f",
                                "sense_id": "6e748b83-e858-37ae-b4fc-bb26a302970a",
                                "text": "„Aber der als Teil des Versailler Vertrags eingerichtete Weichselkorridor trug erheblich zum verletzten deutschen Nationalstolz bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
