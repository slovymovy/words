                "senses": [
                    {
                        "sense_id": "8b1fc352-165d-3367-b520-b4d98a6610ed",
                        "entry_id": "35a9bc05-3584-35f1-8749-9d7f9503faae",
                        "glosses": [
                            "Doter de trois moteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e45fe7a8-1295-4982-9f23-f2e453c014bc",
                                "sense_id": "8b1fc352-165d-3367-b520-b4d98a6610ed",
                                "text": "Il sera trimotorisé et offrira une redondance totale de la chaîne énergétique."
                            },
                            {
                                "example_id": "24b2ed5e-5706-4d17-9401-07ee245fe8f4",
                                "sense_id": "8b1fc352-165d-3367-b520-b4d98a6610ed",
                                "text": "En 1932, le Junkers 52 avait été conçu pour être un monomoteur (JU-52/1MD). Devant le manque de puissance il fut rapidement \"trimotorisé\" par des BMW 132 (JU-52/3MCE), et devient un des principaux avions transports civils et ira équiper de nombreuses compagnies aériennes civiles allemande, argentine, belge, danoise, grecque, hongroise, italienne, mexicaine, norvégienne, péruvienne, britannique, etc."
                            }
                        ]
                    }
