                "senses": [
                    {
                        "sense_id": "fcb2af47-4ed4-3991-b0f4-c72d6731d7f2",
                        "entry_id": "3f759ce6-f3e2-35ad-82f0-a62bbb6b36bc",
                        "glosses": [
                            "In a biblical manner."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e023e490-0ac1-4303-b494-fd21428c97ac",
                                "sense_id": "fcb2af47-4ed4-3991-b0f4-c72d6731d7f2",
                                "text": "Furthermore, what would otherwise be good points about the sort of selective literalism that renders homosexuality an unpardonable sin but shrugs off Sarah Palin’s biblically forbidden pearl earrings are lost in Eichenwald’s assumption that evangelicals make these decisions “with less care than they exercise in selecting side orders for lunch.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8edefd5-b7b7-33b0-a1e7-308077c6eef9",
                        "entry_id": "3f759ce6-f3e2-35ad-82f0-a62bbb6b36bc",
                        "glosses": [
                            "Carnally; in the biblical sense."
                        ],
                        "tags": [
                            "euphemistic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c36c63c5-32fd-4837-954b-d8878217d537",
                                "sense_id": "a8edefd5-b7b7-33b0-a1e7-308077c6eef9",
                                "text": "Most of them showed an intimate knowledge of the young blonde, leading Seth to the conclusion they had known her biblically."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9269231-feeb-41bc-aae6-f76005e66fea",
                        "source_entry_id": "3f759ce6-f3e2-35ad-82f0-a62bbb6b36bc",
                        "source_sense_description": "in a biblical manner",
                        "target_lang_word": "bibliquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47579a47-3762-3d80-8673-d0a12e813de1",
                                        "entry_id": "cb91c671-bb8c-3916-89ed-abc5139c21eb",
                                        "glosses": [
                                            "D’une manière biblique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4675bf-5f69-40a7-a155-181b3bcf79f3",
                                                "sense_id": "47579a47-3762-3d80-8673-d0a12e813de1",
                                                "text": "Il est rejoint par un collègue à lui, à qui il demande innocemment:\n — Tu la connais la petite brune là-bas?\n— Bibliquement. Une suceuse de première."
                                            },
                                            {
                                                "example_id": "d336544e-a95c-4976-b63e-73ac839fda00",
                                                "sense_id": "47579a47-3762-3d80-8673-d0a12e813de1",
                                                "text": "Charles Schweitzer jouissait fièrement de la considération qu’on témoignait à son grand âge, à sa culture, à sa beauté, à ses vertus, ce luthérien ne se défendait pas de penser, très bibliquement, que l’Éternel avait béni sa Maison."
                                            },
                                            {
                                                "example_id": "42d1f6fc-98fa-4ba7-ac64-c35a5c4c97a9",
                                                "sense_id": "47579a47-3762-3d80-8673-d0a12e813de1",
                                                "text": "Une tribu de Magalis était née bibliquement dans les lézardes de ces vieux murs, se chauffant avec des échalas, des sarments, des poutres et des volets, braconnant, ramassant la châtaigne, retaillant les vignes abandonnées, tuant les sars à la dynamite et suçant les chèvres à même le pis, comme les vipères."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
