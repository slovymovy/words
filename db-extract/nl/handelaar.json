                        "examples": [
                            {
                                "example_id": "cdbc2196-6f45-4625-b9ad-89ba504bbed3",
                                "sense_id": "c9711640-f84a-3aef-a4ab-658c54471c8e",
                                "text": "De handelaar reisde naar verre landen om handel te drijven.",
                                "translation": "The merchant traveled to distant lands to conduct trade.",
                                "english": "The merchant traveled to distant lands to conduct trade."
                            },
                            {
                                "example_id": "d2dfa2ef-1863-4df5-8449-2ed31a4ca09d",
                                "sense_id": "c9711640-f84a-3aef-a4ab-658c54471c8e",
                                "text": "De handelaar had een grote verscheidenheid aan goederen in zijn winkel.",
                                "translation": "The trader had a wide variety of goods in his shop.",
                                "english": "The trader had a wide variety of goods in his shop."
                            },
                            {
                                "example_id": "1becd6d1-4fae-44f6-b9af-8c3ca90944ab",
                                "sense_id": "c9711640-f84a-3aef-a4ab-658c54471c8e",
                                "text": "Hij werkt als handelaar op de markt en verkoopt allerlei producten.",
                                "translation": "He works as a trader at the market and sells various products.",
                                "english": "He works as a trader at the market and sells various products."
                            }
                        ]
                    }
