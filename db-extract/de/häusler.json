                "senses": [
                    {
                        "sense_id": "26067dfd-988d-3a7e-95bd-5162357f11ab",
                        "entry_id": "1a22dcf1-a6a1-382d-a36b-ef05981da573",
                        "glosses": [
                            "Landbewohner, Eigentümer eines kleinen Hauses mit sehr geringem oder ganz ohne Landbesitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5527bc2a-11ed-4707-8b08-1015069fc809",
                                "sense_id": "26067dfd-988d-3a7e-95bd-5162357f11ab",
                                "text": "„Alljährlich im Juni ziehn die Bossdomer Kossäten und Häusler zum Heumachen an die Flüsse.“"
                            },
                            {
                                "example_id": "9d61747a-295f-442a-830a-57ba66ee09e8",
                                "sense_id": "26067dfd-988d-3a7e-95bd-5162357f11ab",
                                "text": "„Es gab (wenige) wohlhabende bis reiche Bauern, solche mit mittleren Höfen und solche mit Kleinbesitz, außerdem die nicht mit vollen Rechten als Gemeindemitglieder ausgestatteten Hintersiedler mit wenig Besitz, dann die Bündner oder Häusler und schließlich die völlig besitzlosen Einlieger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
