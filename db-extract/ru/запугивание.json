                "translations": [
                    {
                        "translation_id": "ad13ffa4-8033-4f78-8609-bb393bf5d71f",
                        "source_entry_id": "34eb3946-ff77-3dde-8a35-77b0044ba04d",
                        "source_sense_description": "действие по значению гл. запугивать",
                        "target_lang_word": "intimidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intimidation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                        "entry_id": "1d78c5e6-63c4-3238-bec6-1a24b7fcc16c",
                                        "glosses": [
                                            "Action d’intimider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77da781-bcda-4484-be0f-f7a0703aa9ef",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "« Pas de menaces, pas d’interventions violentes », convient la procureure, Solenne Briand, « mais ils caractérisent bien des intimidations »."
                                            },
                                            {
                                                "example_id": "8a7a41fb-d521-4f13-9051-ec9d4505bb04",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "Le manuel d’histoire mettait en valeur le courage du commandant Lospinoso résistant à toutes les intimidations de la Gestapo pour sauver près de cinq mille réfugiés juifs."
                                            },
                                            {
                                                "example_id": "1c6afcc3-ed96-484b-a91e-d7c6db57710e",
                                                "sense_id": "e5b0fc7f-93d1-33ae-b1cd-5567b00ba899",
                                                "text": "« Le blasphème est toujours dangereux, non plus à cause de la loi, mais à cause des intimidations », observe Khadija Khan, journaliste britannique menacée de mort pour apostasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29c1686e-a398-4af9-84d7-7078d6c14585",
                        "source_entry_id": "34eb3946-ff77-3dde-8a35-77b0044ba04d",
                        "source_sense_description": "действие по значению гл. запугивать",
                        "target_lang_word": "bluff",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bluff",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22e88e0f-172d-34e4-a314-a15ff21edc6c",
                                        "entry_id": "089779f5-b558-3485-a843-a0c8946b12a8",
                                        "glosses": [
                                            "Propos ou acte consistant à faire croire qu’on a un jeu différent de celui qu’on a en vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4879766-3a02-4166-8a70-4c0908766dc9",
                                                "sense_id": "22e88e0f-172d-34e4-a314-a15ff21edc6c",
                                                "text": "C’est du bluff, tu n’as absolument pas ce carré d’as dans ta main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "186a8a09-7930-3e2e-baca-d50bc4ce0ae2",
                                        "entry_id": "089779f5-b558-3485-a843-a0c8946b12a8",
                                        "glosses": [
                                            "Propos ou actes accompagnés d’une grande confiance en soi réelle ou simulée afin d’intimider, voire de faire renoncer un adversaire en lui faisant croire qu’il est dans une position d’infériorité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f200a5a8-6eca-4bf6-97e2-8fd984ef7c5f",
                                                "sense_id": "186a8a09-7930-3e2e-baca-d50bc4ce0ae2",
                                                "text": "Le braqueur a raté son coup de bluff : l’arme factice avec laquelle il menaçait le guichetier n’a pas trompé ce dernier, qui ne s’est pas laissé démonter et a appelé la police."
                                            },
                                            {
                                                "example_id": "c05b4ffd-e16e-4647-be8a-a4dad978ec4d",
                                                "sense_id": "186a8a09-7930-3e2e-baca-d50bc4ce0ae2",
                                                "text": "A notre époque faut bluffer ! Toujours du bluff ! Faut faire croire aux gens !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ff2985-5b18-3ed3-bce3-8b44739f3697",
                                        "entry_id": "089779f5-b558-3485-a843-a0c8946b12a8",
                                        "glosses": [
                                            "Tromperie dans le but de profiter de la naïveté, de la crédulité ou de l’ignorance d’autrui."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f50eba55-0145-400c-ac67-ecbe52d93f77",
                                                "sense_id": "50ff2985-5b18-3ed3-bce3-8b44739f3697",
                                                "text": "C’est la hauteur de votre bluff qui fit si profonde et si douloureuse la chute de ma confiance, de mon admiration, de ma joie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
