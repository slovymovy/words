                        "sense_id": "7b354bfa-113d-34bc-842f-6c0272318433",
                        "entry_id": "20e34694-bdaf-307e-828b-beb45519d743",
                        "glosses": [
                            "A type of naturally occurring black glass produced by volcanoes."
                        ],
                        "tags": [
