                "senses": [
                    {
                        "sense_id": "65e75966-efb3-334b-aa75-8655f4f6f43a",
                        "entry_id": "f250aa8a-ec3b-3e0f-a40f-6c502111ddfd",
                        "glosses": [
                            "auf dem indischen Subkontinent verbreitete Tigerart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2edd01eb-813c-40a2-a4ff-8fc1b68a9b98",
                                "sense_id": "65e75966-efb3-334b-aa75-8655f4f6f43a",
                                "text": "„Der männliche Königstiger wird, von der Schnauzen- bis zur Schwanzspitze gemessen, zwischen 270 und 310 cm lang, in Ausnahmefällen über 360 cm, die Weibchen erreichen 240–270 cm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f08f849-c523-49a7-90ed-f29a150da917",
                        "source_entry_id": "f250aa8a-ec3b-3e0f-a40f-6c502111ddfd",
                        "source_sense_id": "65e75966-efb3-334b-aa75-8655f4f6f43a",
                        "source_sense_description": "auf dem indischen Subkontinent verbreitete Tigerart",
                        "target_lang_word": "Bengal tiger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bengal tiger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69887ab1-5333-34de-b2db-d098979e8683",
                                        "entry_id": "9121b1dc-ed2a-35f5-b74e-43f61b43aff5",
                                        "glosses": [
                                            "Any tiger of a specific, fragmented population of the subspecies Panthera tigris tigris in the Indian subcontinent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4106e1d5-9170-4e7d-b81a-ff044bdf4d6a",
                                                "sense_id": "69887ab1-5333-34de-b2db-d098979e8683",
                                                "text": "Bengal tiger is considered sacred by Hindus and the antipodes (so-called no-caste tribes) living in the forests of India.[…]In addition to this, the health of forests is determined by the presence of Bengal tigers."
                                            },
                                            {
                                                "example_id": "46e0c75e-e303-4865-9a76-efa1c9ea8c76",
                                                "sense_id": "69887ab1-5333-34de-b2db-d098979e8683",
                                                "text": "Bengal tigers are endangered animals. Their numbers have been dropping for more than a century. In the early 1900s, about 40,000 Bengal tigers lived in India. Today, that number stands at around 1,400. About 400 more Bengal tigers live in nearby countries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "840f8c79-6e41-4768-978e-710826fb99fc",
                        "source_entry_id": "f250aa8a-ec3b-3e0f-a40f-6c502111ddfd",
                        "source_sense_id": "65e75966-efb3-334b-aa75-8655f4f6f43a",
