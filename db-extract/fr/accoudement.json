                                            {
                                                "example_id": "c1c7bd8c-a9c2-413a-9d90-9c3fc3b8818c",
                                                "sense_id": "5145f6ae-548e-3cd0-af86-0251eb35d221",
                                                "text": "To Johnson Life was as a Prison, to be endured with heroic faith: to Hume it was little more than a foolish Bartholomew-Fair Show-booth, with the foolish crowdings and elbowings of which it was not worth while to quarrel[…]"
                                            },
                                            {
                                                "example_id": "e7321273-03c1-450f-9518-f49179579611",
                                                "sense_id": "5145f6ae-548e-3cd0-af86-0251eb35d221",
                                                "text": "But in the elbowings of the noisy throng\nThere is no calm for holiness like thine."
                                            }
