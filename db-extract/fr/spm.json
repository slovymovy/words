                                            {
                                                "example_id": "e7d4824c-a448-4a2d-8ece-b19b91286d93",
                                                "sense_id": "242717a0-8d5d-3975-ba9b-f81d429f2489",
                                                "text": "Other circumstances, such as sunburn, travel, or emotional crisis, can also aggravate fluid retention and \"PMT\"."
                                            },
                                            {
                                                "example_id": "b45b2591-e91d-46a9-8c5a-5e9b44cf409c",
                                                "sense_id": "242717a0-8d5d-3975-ba9b-f81d429f2489",
                                                "text": "Fraser knew girls had periods but he'd never heard of PMT."
                                            },
                                            {
                                                "example_id": "f12b103e-ced2-4f2f-9c8f-948897ea5c94",
                                                "sense_id": "242717a0-8d5d-3975-ba9b-f81d429f2489",
                                                "text": "In the 20th century Frank coined the term premenstrual tension (PMT)."
                                            },
                                            {
                                                "example_id": "17bd6aee-77a3-4dd1-a09d-4178240cdfab",
                                                "sense_id": "242717a0-8d5d-3975-ba9b-f81d429f2489",
                                                "text": "\"It's PMT - she'll be back.\" \"I expect that's your father - let's eat.\""
                                            }
                                        ]
                                    },
