                "senses": [
                    {
                        "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                        "entry_id": "05087988-e835-3ce7-af20-83c57adb8168",
                        "glosses": [
                            "Ausruf und Gruß zu Karneval, Fasching und zur Fastnacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02dafba3-a3a3-4c6b-97ef-27c75f45f5b1",
                                "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                                "text": "„Völliger Wahnsinn eigentlich, einen Artikel zu schreiben, der sich mit den Narrenrufen aus Baden-Württemberg und Rheinland-Pfalz beschäftigt.“"
                            },
                            {
                                "example_id": "3415f38f-cefd-4f1a-9504-fd66591f5eda",
                                "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                                "text": "„Wer richtig feiern möchte, braucht nicht nur ein originelles Karnevalskostüm, sondern muss natürlich auch den Narrenruf des regionalen Karnevals kennen.“"
                            },
                            {
                                "example_id": "b64a8486-04a1-40b0-84ec-47e8745536b7",
                                "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                                "text": "„Denn hinter diesem Narrenruf verbirgt sich der Ruf nach dem Gott Zeus, dem der „Ziustag“, auch „Zeischteg“ genannt, geweiht ist.“"
                            },
                            {
                                "example_id": "be9a12b8-417c-4624-be87-992e630f3fa4",
                                "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                                "text": "„Jecken identifizieren sich mit speziellen Narrenrufen, die den Spaß, die Begeisterung und Feierlaune der Narren im närrischen Treiben charakterisieren.“"
                            },
                            {
                                "example_id": "8f28987d-57a0-4891-92a6-557bfbc3dee8",
                                "sense_id": "d078d5c5-b2f4-3e41-97fe-5acdd8e5d1b2",
                                "text": "„Auf der Karte der Sprachforscher sind die zwölf am häufigsten genannten Narrenrufe abgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
