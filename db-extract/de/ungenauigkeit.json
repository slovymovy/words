                        "form": "die Ungenauigkeit"
                    },
                    {
                        "form_id": "7dcc258e-b285-46e6-a081-3650853cca6a",
                        "entry_id": "654235eb-8951-3ed2-a34c-d48ec526bd9c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ungenauigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                        "entry_id": "654235eb-8951-3ed2-a34c-d48ec526bd9c",
                        "glosses": [
                            "Eigenschaft, Zustand, nicht präzise, genau zu sein, also nur ungefähr zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f3d7b09-992e-4ae5-80c5-393b77a56ac9",
                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                "text": "„Die in den Messungen steckende Ungenauigkeit beträgt etwa 90 Sekunden.“"
                            },
                            {
                                "example_id": "febe5a29-22ed-4488-9e86-0e734a3a1e36",
                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                "text": "„Die Ungenauigkeit von 47 ppm (Teile pro Million), bislang ein großes Problem, konnte deutlich auf 12 ppm gesenkt werden.“"
                            },
                            {
                                "example_id": "e286977a-fbb3-460b-9d11-b7dbff481b08",
                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                "text": "„Im Extremfall kann die Ungenauigkeit der Ortung in diesen Gebieten 38 Kilometer betragen.“"
                            },
                            {
                                "example_id": "c336d12f-ada9-45d5-a44e-bd3a2b0473ce",
                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                "text": "„Und was die Ungenauigkeit der DNA-Schreibgeräte angeht, so wären die Algorithmen des DNA-Fountain-Verfahrens effektiv genug, um die fehlerhaften DANN-Informationsschnipsel zuverlässig im Herstellungsprozess auszusortieren.“"
                            },
                            {
                                "example_id": "e00591fc-6a63-4132-8e85-5d277bdde158",
                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                "text": "„Um diese Ungenauigkeit zu vermeiden, legen einige Hersteller viel Wert auf ihre eigene Clock, die hinreichend exakt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                        "entry_id": "654235eb-8951-3ed2-a34c-d48ec526bd9c",
                        "glosses": [
                            "etwas, das [1] hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3321635a-8fb4-4a04-bd04-60b36c7ac612",
                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                "text": "„Um diese Ungenauigkeit zu vermeiden, legen einige Hersteller viel Wert auf ihre eigene Clock, die hinreichend exakt ist.“"
                            },
                            {
                                "example_id": "5d2071b1-bbbd-4c9a-bf33-d2183aa1a42b",
                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                "text": "„Es seien einige sachliche Fehler und ‚Ungenauigkeiten der Schilderung‘ aufgefallen.“"
                            },
                            {
                                "example_id": "030f38c7-e58a-4998-8274-a49bc80b4834",
                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                "text": "„Es hatte sich herausgestellt, dass sachliche Fehler, Ungenauigkeiten und Flüchtigkeiten bei der Zuordnung des Materials unterlaufen waren und durch die Art der Präsentation ‚pauschale und suggestive Aussagen‘ getroffen wurden.“"
                            },
                            {
                                "example_id": "f1402bc0-f418-427d-aa1c-3705cfadd44f",
                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                "text": "„Schnell führen sprachliche Ungenauigkeiten zum Pranger und zum Abkanzeln, zumal die Erregungsschleifen in den sozialen Medien eine aufklärerische und differenzierte Diskussion erschweren.“"
                            },
                            {
                                "example_id": "a17b8e99-64cd-49ec-8ec8-74e896f38328",
                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                "text": "„Trotz verstärkter Briefwahl und dadurch bedingter Ungenauigkeiten in der Prognose gab es keine Überraschungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
