                ],
                "senses": [
                    {
                        "sense_id": "fedbcfc7-fc9d-32a1-aaea-3fc40b818470",
                        "entry_id": "48ff2c65-f268-3b6b-9ea7-be27195b29bc",
                        "glosses": [
                            "ohne Kinn, kein Kinn habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d826109-4eb7-4ba8-8f26-dab2e34e6714",
                                "sense_id": "fedbcfc7-fc9d-32a1-aaea-3fc40b818470",
                                "text": "„Platt ruhte das Wesen auf dem Felsvorsprung, schob den kinnlosen Schädel mit dem breit geschlitzten Maul über den Rand des Vorsprungs hinaus und schielte aus kalten, lidlosen Augen auf Avoosl Wuthoqquan nieder.“"
                            },
                            {
                                "example_id": "5352fc4a-cd1b-40d4-901b-a17298f50ede",
                                "sense_id": "fedbcfc7-fc9d-32a1-aaea-3fc40b818470",
                                "text": "„Aber der Zwerg schien in Gedanken versunken. Stand da, das kinnlose Gesicht in eine Flosse gestützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
