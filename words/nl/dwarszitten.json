{
    "word_family": [
        "dwarsligger",
        "dwarsbomen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ef47155-25d3-3b05-88d3-0d0bf473816a",
                    "sense_definition": "iemand irriteren, storen of bezorgd maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nou, wat <w>zit</w> je <w>dwars</w>?",
                            "target_lang_translations": {
                                "en": "Well, what is <w>bothering</w> you?"
                            }
                        },
                        {
                            "text": "Ik weet niet wat hem <w>dwarszit</w>, maar hij praat vandaag met niemand.",
                            "target_lang_translations": {
                                "en": "I don't know what is <w>troubling</w> him, but he isn't talking to anyone today."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderen",
                        "irriteren",
                        "plagen"
                    ],
                    "common_phrases": [
                        "iemand dwarszitten",
                        "wat zit je dwars"
                    ],
                    "target_lang_definitions": {
                        "en": "To annoy, disturb, or make someone worried"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "to annoy or worry someone"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "to cause worry or distress to someone"
                            },
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "to irritate someone slightly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4f080a1-ae5a-364f-adcb-1e4c65de8c96",
                    "sense_definition": "de voortgang van iets of iemand belemmeren of tegenwerken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De harde wind <w>zat</w> de fietsers flink <w>dwars</w> tijdens hun tocht.",
                            "target_lang_translations": {
                                "en": "The strong wind really <w>hindered</w> the cyclists during their trip."
                            }
                        },
                        {
                            "text": "Zij probeerden de plannen van de concurrentie bewust <w>dwars</w> te <w>zitten</w>.",
                            "target_lang_translations": {
                                "en": "They deliberately tried to <w>thwart</w> the competitor's plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "belemmeren",
                        "hinderen",
                        "tegenwerken",
                        "dwarsbomen"
                    ],
                    "antonyms": [
                        "helpen",
                        "steunen"
                    ],
                    "common_phrases": [
                        "de plannen dwarszitten"
                    ],
                    "target_lang_definitions": {
                        "en": "To obstruct, hinder, or work against the progress of someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thwart",
                                "target_lang_sense_clarification": "to prevent someone from accomplishing something"
                            },
                            {
                                "target_lang_word": "hinder",
                                "target_lang_sense_clarification": "to make it difficult for someone to do something"
                            },
                            {
                                "target_lang_word": "obstruct",
                                "target_lang_sense_clarification": "to block or get in the way of progress"
                            },
                            {
                                "target_lang_word": "frustrate",
                                "target_lang_sense_clarification": "to prevent a plan or action from progressing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba64c810-8128-342c-bea4-33648b0bd0c2",
                    "sense_definition": "een voortdurende bron van wrok, diepe zorg of angst in de geest zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bother",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het feit dat hij geen afscheid kon nemen, <w>zat</w> hem nog jarenlang <w>dwars</w>.",
                            "target_lang_translations": {
                                "en": "The fact that he couldn't say goodbye <w>weighed on</w> him for years."
                            }
                        },
                        {
                            "text": "Als er niet zo veel herrie was geweest, had hij kunnen nadenken over wat hem <w>dwarszat</w>.",
                            "target_lang_translations": {
                                "en": "If there hadn't been so much noise, he could have thought about what was <w>gnawing at</w> him."
                            }
                        }
                    ],
                    "synonyms": [
                        "knagen",
                        "pijnigen"
                    ],
                    "common_phrases": [
                        "iets zit dwars"
                    ],
                    "target_lang_definitions": {
                        "en": "To be a constant source of resentment, deep concern, or anxiety in the mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eat away at",
                                "target_lang_sense_clarification": "to slowly destroy or worry someone's mind"
                            },
                            {
                                "target_lang_word": "weigh on",
                                "target_lang_sense_clarification": "to make someone feel worried or anxious over time"
                            },
                            {
                                "target_lang_word": "gnaw at",
                                "target_lang_sense_clarification": "to persistently worry or torment someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}