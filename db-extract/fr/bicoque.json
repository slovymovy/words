                    },
                    {
                        "sense_id": "96475446-7a98-3fff-8593-6fa39f27cc6f",
                        "entry_id": "c45b1637-45c0-3e90-badf-a08c5a5629cf",
                        "glosses": [
                            "Hydravion à deux coques"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b97e18b2-0327-461f-ba6d-83f38ac6dde7",
                                "sense_id": "96475446-7a98-3fff-8593-6fa39f27cc6f",
                                "text": "Le Savoïa S-55 est un bicoque, monoplan à ailes surbaissées de 25 mètres d'envergure, empannage en porte-à-faux sans fuselage. Deux moteurs en tendeur lui donnent une vitesse de 160 à 180 kilomètres […]."
                            }
                        ]
                    }
