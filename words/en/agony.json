                            },
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "внезапное и сильное проявление чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9cf6fd-b2ba-39e1-9ad3-9c18fed8674a",
                    "sense_definition": "The specific spiritual and physical suffering of Jesus Christ in the Garden of Gethsemane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_context",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "The painting depicts the <w>Agony</w> in the Garden with great emotional depth.",
                            "target_lang_translations": {
                                "pl": "Obraz przedstawia <w>Konanie</w> w Ogrójcu z wielką głębią emocjonalną.",
                                "ru": "Картина с большой эмоциональной глубиной изображает <w>Моление о чаше</w>."
                            }
                        },
                        {
                            "text": "And being in an <w>agonie</w>, he prayed more earnestly to the Father.",
                            "target_lang_translations": {
                                "pl": "A będąc w <w>udręce</w>, modlił się jeszcze gorliwiej do Ojca.",
                                "ru": "И, находясь в <w>борении</w>, Он прилежнее молился Отцу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "agony in the garden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Specyficzne duchowe i fizyczne cierpienie Jezusa Chrystusa w Ogrodzie Getsemani.",
                        "ru": "Особые духовные и физические страдания Иисуса Христа в Гефсиманском саду."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "konanie",
                                "target_lang_sense_clarification": "w kontekście religijnym: Konanie w Ogrójcu"
                            },
                            {
                                "target_lang_word": "modlitwa w Ogrójcu",
                                "target_lang_sense_clarification": "nazwa wydarzenia biblijnego"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "моление о чаше",
                                "target_lang_sense_clarification": "религиозный сюжет о страданиях Христа в саду"
                            },
                            {
                                "target_lang_word": "борение",
                                "target_lang_sense_clarification": "духовная борьба и страдания Христа"
                            }
                        ]
                    }
                }
            ]
        }
