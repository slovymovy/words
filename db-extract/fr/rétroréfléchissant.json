                "senses": [
                    {
                        "sense_id": "2804c351-841e-37fe-aa7a-d7f1d2d38677",
                        "entry_id": "e9378ee0-8d64-3c23-bc53-0765e0874ef8",
                        "glosses": [
                            "Qui rétroréfléchit la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6c3661-8fff-443f-8a61-96c1d0cae223",
                                "sense_id": "2804c351-841e-37fe-aa7a-d7f1d2d38677",
                                "text": "La signalisation arrière des véhicules, dont le poids total autorisé en charge est supérieur à 3,5 tonnes, peut être complétée par un dispositif rétroréfléchissant conforme aux dispositions du règlement no 104 annexé à l'accord de Genève du 20 mars 1958."
                            },
                            {
                                "example_id": "2cd9ef9e-4655-43e1-955f-6e75a4ad087b",
                                "sense_id": "2804c351-841e-37fe-aa7a-d7f1d2d38677",
                                "text": "Les catadioptres sont également obligatoires sur les pédales, à l’avant et à l’arrière du vélo. Sur les rayons des roues aussi, à moins que les pneus ne comportent déjà des bandes rétroréfléchissantes. Quant au gilet fluorescent est obligatoire de nuit hors agglomération."
                            }
                        ]
                    }
