                        ],
                        "form": "потво́рствовавши"
                    },
                    {
                        "form_id": "25144e0e-6891-4d60-9d90-383d23cb08bc",
                        "entry_id": "f6e16b1a-8457-3038-b86e-376dd04463aa",
