                    "sense_definition": "gebiedende wijs van <w>spoken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Spook</w> niet zo in de gang, je maakt de kinderen wakker!",
                            "target_lang_translations": {
