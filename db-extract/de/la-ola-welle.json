                "senses": [
                    {
                        "sense_id": "f420e446-0a16-3921-a27f-28c82aeb848e",
                        "entry_id": "bf0286d5-bd0d-3770-95e0-3e32a24bbb25",
                        "glosses": [
                            "wasserwellenartige Bewegung des Publikums in sich kreisförmig bewegende Richtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ebe91a-43dc-402e-a134-9cf0984bc7d8",
                                "sense_id": "f420e446-0a16-3921-a27f-28c82aeb848e",
                                "text": "Als das Fußballspiel zunehmend verflachte wurde die La-Ola-Welle von dem Publikum eröffnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f28b7e6-78c5-47e5-be63-3872667ce47c",
                        "source_entry_id": "bf0286d5-bd0d-3770-95e0-3e32a24bbb25",
                        "source_sense_id": "f420e446-0a16-3921-a27f-28c82aeb848e",
                        "source_sense_description": "wasserwellenartige Bewegung des Publikums in sich kreisförmig bewegende Richtung",
                        "target_lang_word": "Mexican wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mexican wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67f776b8-87d9-3a40-b007-48514b3b8d29",
                                        "entry_id": "8f15a3f8-f191-3564-a2a1-7745fafd5f7b",
                                        "glosses": [
                                            "A phenomenon that primarily occurs at sports events, where the members of the crowd stand up and/or raise their hands in turn, creating the illusion of a wave passing through the crowd."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16a82e0-c1bc-4a48-beb4-bd30f24c316a",
                                                "sense_id": "67f776b8-87d9-3a40-b007-48514b3b8d29",
                                                "text": "1995, Shane Cloude, An Introduction to Electromagnetic Wave Propagation & Antennas, Springer, 0-387-91501-X, pages 3–4,\nThis is an important idea and can best be illustrated by analogy with a Mexican wave. Although the Mexican wave seems to involve the coherent motion of a large number of people, it is clear to those who have been involved, that the “trigger” for an individual to react is entirely spatially and temporally local, i.e. the individual reacts at the appropriate time and space point simply by waiting until his or her neighbours react."
                                            },
                                            {
                                                "example_id": "15de4d99-b6d5-43af-b050-c949ec03fac6",
                                                "sense_id": "67f776b8-87d9-3a40-b007-48514b3b8d29",
                                                "text": "2001, John Morgan, Debrett’s New Guide to Etiquette and Modern Manners: The Indispensable Handbook, St. Martin's Press, →ISBN, page 127,\nThe usual signals for standing are: at the arrival of Queen Elizabeth The Queen Mother; […]; and every time the Colour passes in front of you. The effect can sometimes be like a rather well-dressed Mexican wave."
                                            },
                                            {
                                                "example_id": "d0fe398b-8b12-4bd5-adc8-e1fd091021f7",
                                                "sense_id": "67f776b8-87d9-3a40-b007-48514b3b8d29",
                                                "text": "2007, Scott Hamilton, An Analog Electronics Companion: Basic Circuit Design for Engineers and Scientists, Cambridge University Press, →ISBN, page 94,\nA Mexican wave travels around a stadium very much more rapidly than a person could."
                                            },
                                            {
                                                "example_id": "e0bcfd14-835d-4c0d-a424-61c863a09a30",
                                                "sense_id": "67f776b8-87d9-3a40-b007-48514b3b8d29",
                                                "text": "Now Australian cricket is reeling from its quadruple loss. Joining the hat trick of players exiting the game in 2007 – once-in-a-lifetime legend Shane Warne, Glenn McGrath and Damien Martyn – was the Mexican wave. Cricket Australia, which instituted the ban, acknowledged that it could be construed as ‘the fun police gone wrong’ but explained that it was the only way to stop people throwing things."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mexican wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "090eaaa7-68e9-33e0-805e-587d590eff0e",
                                        "entry_id": "09288d62-0555-379c-98b5-a2daf57ea9a2",
                                        "glosses": [
                                            "To perform a Mexican wave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4cfd073-3a2b-4ad3-b773-535694390430",
                        "source_entry_id": "bf0286d5-bd0d-3770-95e0-3e32a24bbb25",
                        "source_sense_id": "f420e446-0a16-3921-a27f-28c82aeb848e",
                        "source_sense_description": "wasserwellenartige Bewegung des Publikums in sich kreisförmig bewegende Richtung",
                        "target_lang_word": "ola",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ola",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a169332-455e-37d9-a6b6-9b656ce2d9e0",
                                        "entry_id": "5eba0aca-8d5e-3e01-b4d9-e2b7ca7890bd",
                                        "glosses": [
                                            "Mouvement de foule ayant lieu surtout pendant les évènements sportifs, où des spectateurs se mettent debout chacun à leur tour en levant les bras, évoquant une vague traversant la foule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3eb191-95bd-454b-9360-919e490c8afe",
                                                "sense_id": "1a169332-455e-37d9-a6b6-9b656ce2d9e0",
                                                "text": "Lorsqu’un petit groupe de spectateurs se lève pour déclencher le mouvement, la ola devrait en principe partir simultanément du côté droit et du côté gauche des initiateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
