                    "sense_id": "3a262391-beb6-3fa6-964b-d580bcfee152",
                    "sense_definition": "Verkleinwoord van <w>lied</w>; een kort, muzikaal stuk met zang.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "song",
                    "name_type": "no",
