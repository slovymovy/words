                        "sense_id": "d8239ae7-21a0-3a60-bdf0-e5480f25c242",
                        "entry_id": "9394ee61-998c-30bc-b47c-8841ac4a6759",
                        "glosses": [
                            "Manchot papou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5a205c-69d3-42d5-93dd-88af42b43654",
                                "sense_id": "d8239ae7-21a0-3a60-bdf0-e5480f25c242",
                                "text": "Il s'agit d'une seconde espèce de Manchot, le Papou (Pygoscelis papua), un peu plus grand que le Manchot antarctique et plus somptueusement vêtu."
                            }
                        ]
                    }
