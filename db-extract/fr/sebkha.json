                                        "examples": [
                                            {
                                                "example_id": "6fae3630-2210-4941-bed9-830e15ea0f2e",
                                                "sense_id": "cd2f2ac9-13b9-3117-b048-07b2a1061d0b",
                                                "text": "And so it was that when the sun came up he looked between two oleanders and saw it reflected red across the miles of glittering salt sebkha that lay between him and the mountains."
                                            }
