{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "44aefd61-e375-390c-80e0-e6e2cef48068",
                    "sense_definition": "Служит для подчёркивания мысли, указания на очевидность факта или напоминания о том, что известно собеседнику.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emphatic_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты <w>ведь</w> знаешь, что я всегда готов помочь тебе в трудную минуту.",
                            "target_lang_translations": {
                                "en": "You know, <w>after all</w>, that I am always ready to help you in a difficult moment.",
                                "zh": "你<w>毕竟</w>知道，我随时准备在你困难的时候帮助你。"
                            }
                        },
                        {
                            "text": "<w>Ведь</w> я вам говорил, что нужно приходить вовремя!",
                            "target_lang_translations": {
                                "en": "<w>But</w> I told you that you need to arrive on time!",
                                "zh": "我<w>不是</w>告诉过你们要准时来吗！"
                            }
                        },
                        {
                            "text": "Это <w>ведь</w> совсем не сложно, если немного подумать.",
                            "target_lang_translations": {
                                "en": "It's really not difficult at all, <w>you know</w>, if you think about it a little.",
                                "zh": "这<w>毕竟</w>一点也不难，只要稍微想一想。"
                            }
                        }
                    ],
                    "synonyms": [
                        "же"
                    ],
                    "common_phrases": [
                        "я ведь",
                        "ты ведь",
                        "это ведь",
                        "ведь правда"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in spoken language to emphasize a point"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize a point, indicate that a fact is obvious, or remind the listener of something they already know.",
                        "zh": "用于强调观点、指出事实显而易见，或提醒听者已知的信息。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "after all",
                                "target_lang_sense_clarification": "used to remind someone of a fact or reason"
                            },
                            {
                                "target_lang_word": "you know",
                                "target_lang_sense_clarification": "used to appeal to shared knowledge or obviousness"
                            },
                            {
                                "target_lang_word": "why",
                                "target_lang_sense_clarification": "emphatic interjection expressing surprise or indignation"
                            },
                            {
                                "target_lang_word": "but",
                                "target_lang_sense_clarification": "used for emphasis or objection"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毕竟",
                                "target_lang_sense_clarification": "用于提醒对方已知的事实或理由"
                            },
                            {
                                "target_lang_word": "难道",
                                "target_lang_sense_clarification": "用于反问以强调事实的显而易见"
                            },
                            {
                                "target_lang_word": "不是",
                                "target_lang_sense_clarification": "用于强调已知事实的语气词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "aa54d336-5811-348d-b2b6-75d84f0d1abe",
                    "sense_definition": "Указывает на причину или обоснование предшествующего утверждения; соответствует по значению союзам «потому что», «так как».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "causal_conjunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не мог туда пойти, <w>ведь</w> у него не было пропуска.",
                            "target_lang_translations": {
                                "en": "He couldn't go there, <w>since</w> he didn't have a pass.",
                                "zh": "他没法去那里，<w>因为</w>他没有通行证。"
                            }
                        },
                        {
                            "text": "Мы решили остаться дома, <w>ведь</w> на улице началась сильная гроза.",
                            "target_lang_translations": {
                                "en": "We decided to stay home, <w>because</w> a strong thunderstorm started outside.",
                                "zh": "我们决定待在家里，<w>因为</w>外面下起了大雷雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "потому что",
                        "так как",
                        "поскольку"
                    ],
                    "target_lang_definitions": {
                        "en": "Introduces a clause giving a reason or justification; corresponds to 'because' or 'since'.",
                        "zh": "引出原因或理由，相当于“因为”或“由于”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "because",
                                "target_lang_sense_clarification": "introduces a cause or reason"
                            },
                            {
                                "target_lang_word": "since",
                                "target_lang_sense_clarification": "introduces a reason or justification"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "causal conjunction"
                            },
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "formal causal conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "因为",
                                "target_lang_sense_clarification": "引出原因或理由"
                            },
                            {
                                "target_lang_word": "毕竟",
                                "target_lang_sense_clarification": "引出作为理由的事实"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}