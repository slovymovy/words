                "senses": [
                    {
                        "sense_id": "f02baef4-9af3-3701-aa00-a50adadbcf43",
                        "entry_id": "40413425-0cd9-3ecf-8f4f-c3b91fafd324",
                        "glosses": [
                            "Donner un caractère hexagonal (et en particulier un caractère français ou franchouillard) à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad279de-440a-4e86-9c76-17d427d01982",
                                "sense_id": "f02baef4-9af3-3701-aa00-a50adadbcf43",
                                "text": "Vous êtes censé vous arrêter de tout hexagonaliser au détriment des lemondestbienplatinistes."
                            },
                            {
                                "example_id": "ff29b231-af2b-4c5f-9d0d-5996bd9c1fbc",
                                "sense_id": "f02baef4-9af3-3701-aa00-a50adadbcf43",
                                "text": "Difficile à comprendre le jargon INSEE et la méthode « pourquoi écrire simple quand on peut hexagonaliser »."
                            },
                            {
                                "example_id": "f015bd77-062c-40b5-b6a8-b8ed9867d1e7",
                                "sense_id": "f02baef4-9af3-3701-aa00-a50adadbcf43",
                                "text": "Mais le risque, pour lui, est désormais de s’« hexagonaliser » à l’approche de l’élection présidentielle."
                            }
                        ]
                    }
