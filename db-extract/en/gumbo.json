    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                "word": "gumbo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f78fd5ed-c131-47ce-a48d-c2ace236bf32",
                        "entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                        "tags": [
                            "plural"
                        ],
                        "form": "gumbos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd5b356a-cd2d-34c3-b81f-e4c2c9c3e44d",
                        "entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                        "glosses": [
                            "Synonym of okra: the plant or its edible capsules."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8b0267dc-4e78-3414-9d7a-ef99969fec2e",
                        "entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                        "glosses": [
                            "A soup or stew popular in Louisiana, consisting of a strong stock, meat or shellfish, a thickener (often okra), and the \\\"Holy Trinity\\\" of celery, bell peppers, and onions."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "70c19b12-ee12-355a-9fc5-fc5ec6db8bd6",
                        "entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                        "glosses": [
                            "A fine silty soil that when wet becomes very thick and heavy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "056b3ed9-70e5-4ef6-92bd-e357f5a2da4f",
                                "sense_id": "70c19b12-ee12-355a-9fc5-fc5ec6db8bd6",
                                "text": "The team stuck fast in the black muck, and every effort to extricate them served only to imbed them more hopelessly in the sticky gumbo."
                            },
                            {
                                "example_id": "17c3788b-1c22-47a7-8746-0b87aafb1468",
                                "sense_id": "70c19b12-ee12-355a-9fc5-fc5ec6db8bd6",
                                "text": "There are no poorer roads in all the United States than the \"gumbo\" roads of the south—gumbo being the name give a certain kind of mud or clay that is particularly sticky, clings tenaciously, seems to have no bottom, and will not support any weight."
                            },
                            {
                                "example_id": "30f95dce-f694-41a1-b1bf-063f150aed1a",
                                "sense_id": "70c19b12-ee12-355a-9fc5-fc5ec6db8bd6",
                                "text": "The red gumbo soil uttered ugly sucking sounds at the touch of a man's boot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82dd2925-2e3e-4219-83cf-575035733e96",
                        "source_entry_id": "424a9f89-567d-358b-ae1d-a6b8363d7717",
                        "source_sense_description": "soup or stew",
                        "target_lang_word": "gombo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gombo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7148fd6-5af1-31c3-8925-a3a3fb1aa59f",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Plante à fleurs herbacée annuelle ou bisannuelle tropicale du genre Abelmoschus, de la famille des Malvaceae (Malvacées). Il s'agit en particulier de Abelmoschus callei et de Abelmoschus esculentus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7fccb8-7db7-4ba0-a539-1c647acb1199",
                                                "sense_id": "e7148fd6-5af1-31c3-8925-a3a3fb1aa59f",
                                                "text": "M. Landrin transmet des échantillons d'un nouveau papier.... obtenu avec les fibres d'un végétal très répandu aux colonies et dans les pays chauds, le gombo […] Il fournit ensuite des fruits comestibles qui ne sont pas à dédaigner ; enfin de sa graine il est facile d'extraire une huile qui, si elle ne peut être employée aux usages culinaires, trouverait au moins une application dans l'industrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Son jeune fruit immature consommé comme légume."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f99f78f-7819-4e1d-93f7-bae31a68b5cc",
                                                "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                                "text": "Nous n’avons, pour notre compte, aucun entraînement pour le potage au gombo ; mais cela n’empêche pas que ce brouet verdâtre et filant ne soit en grande réputation en Amérique, et surtout aux Antilles, où la ketmie-gombo est cultivée comme plante potagère… elle est aujourd’hui acclimatée en Algérie."
                                            },
                                            {
                                                "example_id": "8c9138d1-e820-4b7e-9bee-99e3d0eb8ba7",
                                                "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                                "text": "Il est probable qu’Ife, et toute la région de la forêt tropicale ouest-africaine en général, prospéra grâce à la technologie de fusion du fer qui pouvait produire des outils en fer comme la houe et, à son tour, produire de nombreuses récoltes d’aliments tels que le gombo, l’igname, les dattes, l’huile de palme et le poisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a8116f-3b1a-32f1-963b-698e0b022ad9",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Pourboire, pot-de-vin, honoraires."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Ragout originaire de la Louisiane."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f289932e-b94f-4956-ae3a-a399d486e8f9",
                                                "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                                "text": "Et parce qu’il fait faim à cette heure-là, vous pourrez aussi découvrir le gombo, une sorte de ragoût typique de la Louisiane composé de crustacés et de divers légumes."
                                            },
                                            {
                                                "example_id": "6d680894-5a26-4998-8fc4-5eee5849d47f",
                                                "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                                "text": "Le plat emblématique de la Louisiane est le gombo, dont le nom vient de la plante appelée okra en Louisiane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
