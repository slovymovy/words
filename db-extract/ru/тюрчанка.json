                "senses": [
                    {
                        "sense_id": "646bc1e1-d904-32a1-aa5d-8a2b6370c2f0",
                        "entry_id": "f4b2b8e6-9d6b-37c5-ad10-f644d2c4df0b",
                        "glosses": [
                            "женск. к тюрк, тюрок; представительница группы родственных народов, говорящих на тюркских языках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3e18f5-e219-4932-aa5e-d010732134f7",
                                "sense_id": "646bc1e1-d904-32a1-aa5d-8a2b6370c2f0",
                                "text": "Из женщин только необыкновенно красивая тюрчанка с выразительными глазами."
                            },
                            {
                                "example_id": "6eadeefd-d567-458d-90ad-304f3fa8aa71",
                                "sense_id": "646bc1e1-d904-32a1-aa5d-8a2b6370c2f0",
                                "text": "Невыносимое солнце закатывалось за пологую гору, с мутной Куры долетало подобие прохлады, или это только казалось; тюрчанки под чадрами семенили подобно монашкам."
                            }
                        ]
                    }
