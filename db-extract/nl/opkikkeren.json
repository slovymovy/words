                                                "example_id": "950efc26-5d7f-4e63-b492-a886bb61d9ce",
                                                "sense_id": "65d86beb-0779-3f98-abee-f907ddbc8e8b",
                                                "text": "I cheered up after seeing the results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd17fd5-1572-3ad5-945d-cd0f4258582f",
                                        "entry_id": "808fadf0-9f9f-3fd6-8f6c-2cbca1c5f84d",
                                        "glosses": [
                                            "To make someone happier or less downcast."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3028099d-a4ca-47d4-b72c-716a8939d1f6",
                                                "sense_id": "1bd17fd5-1572-3ad5-945d-cd0f4258582f",
                                                "text": "The arrival of the unexpected letter cheered him up almost immediately."
                                            },
                                            {
                                                "example_id": "cfb8fd0c-afe3-4eef-9320-ad9c2c39759d",
                                                "sense_id": "1bd17fd5-1572-3ad5-945d-cd0f4258582f",
                                                "text": "Therefore cheere vp your mindes, prepare to fight,\nHe that can take or ſlaughter Tamburlaine,\nShall rule the Prouince of Albania."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheer up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
