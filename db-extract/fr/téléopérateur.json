                "senses": [
                    {
                        "sense_id": "8e6ecc3b-f2ba-3756-a8bf-ebe1b5bdc74e",
                        "entry_id": "2d85e86b-049a-38d6-8dd4-42fd304a9380",
                        "glosses": [
                            "Personne qui agit à distance sur un appareil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf61f89-c4b4-40b7-b6e8-1a7feaee95ad",
                                "sense_id": "8e6ecc3b-f2ba-3756-a8bf-ebe1b5bdc74e",
                                "text": "Un chercheur-tueur est une aiguille mortelle montée sur répulseurs et pilotée à distance par un téléopérateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbd77a3a-4d73-3c56-91c3-79f797e335f0",
                        "entry_id": "2d85e86b-049a-38d6-8dd4-42fd304a9380",
                        "glosses": [
                            "Personne qui passe ou répond à des appels téléphoniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd3240c-ffee-442f-b93d-af1f55d51e1a",
                                "sense_id": "bbd77a3a-4d73-3c56-91c3-79f797e335f0",
                                "text": "Le couplage téléphonie-informatique rend possible l'affichage simultané de données et de la présentation de l'appel sur l'écran du téléopérateur et sur son poste téléphonique."
                            },
                            {
                                "example_id": "92b557c6-9c9a-4ca1-b970-3f38e48085f3",
                                "sense_id": "bbd77a3a-4d73-3c56-91c3-79f797e335f0",
                                "text": "On recherche huit téléopératrices de 16 h à 20 h pour de la prise de rendez vous commerciaux."
                            }
                        ]
                    }
                ],
