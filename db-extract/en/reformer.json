                        "source_entry_id": "17b098ff-bdca-3e00-a163-2fb65c91b7f4",
                        "source_sense_description": "one who was involved in the Reformation",
                        "target_lang_word": "Reformator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
