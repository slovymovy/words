                    },
                    {
                        "form_id": "49c821f4-9fdc-4cd0-9df0-903b3650249e",
                        "entry_id": "92e33b42-dc66-3fb1-94a8-63945b1b992e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "pataude"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "284c880d-03c6-34e9-824a-f211c7cb33da",
                        "entry_id": "92e33b42-dc66-3fb1-94a8-63945b1b992e",
                        "glosses": [
                            "Jeune chien qui a de grosses pattes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "485fb1f3-a27d-3713-b00e-0a3dfa004d0c",
                        "entry_id": "92e33b42-dc66-3fb1-94a8-63945b1b992e",
                        "glosses": [
                            "Quelqu’un dont la personne et les manières sont lourdes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d3d945bc-da56-4f3c-b68d-ff0fe38679c5",
                                "sense_id": "485fb1f3-a27d-3713-b00e-0a3dfa004d0c",
                                "text": "Quel gros pataud !"
                            },
                            {
                                "example_id": "e8d0cfcb-0dc2-495e-b52c-af69fa2094d1",
                                "sense_id": "485fb1f3-a27d-3713-b00e-0a3dfa004d0c",
                                "text": "C’est une pataude."
                            },
                            {
                                "example_id": "9cc2c019-176a-4238-b2e9-79fe72a78f14",
                                "sense_id": "485fb1f3-a27d-3713-b00e-0a3dfa004d0c",
                                "text": "Les Campagnols restèrent incrédules. C’étaient de petits patauds qui, nés sous terre, puis installés dans la meule, la croyaient éternelle comme le monde."
                            },
                            {
                                "example_id": "e5b4b17a-3f7a-49f5-9174-452198bee0d9",
                                "sense_id": "485fb1f3-a27d-3713-b00e-0a3dfa004d0c",
                                "text": "Chicar, ayant reconnu un garçon meunier à son habit de velours blanc, s’écria :\n– Attention, messieurs-mésédames, voici le pataud le plus adroit du pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "e197688a-47c8-3111-ac11-e26fb2e45a01",
                        "entry_id": "92e33b42-dc66-3fb1-94a8-63945b1b992e",
                        "glosses": [
                            "Personne originaire de Vendée ayant des opinions républicaines durant la guerre de Vendée."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "d56e264f-3b11-45ef-b3c3-1e708aa8ea53",
                                "sense_id": "e197688a-47c8-3111-ac11-e26fb2e45a01",
                                "text": "Pour ne pas s'égarer dans leurs courses, et ainsi pour mieux surprendre leurs victimes, les farouches lieutenant de Turreau, de Grignon, etc., avaient embrigadé les gens du pays qui conduisaient leurs colonnes, ou bien ils se servaient de jeunes patauds, qui s'offraient d'eux-mêmes pour marcher à leur tête."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5339adf-e8aa-485d-8658-8f1013c07586",
                        "source_entry_id": "92e33b42-dc66-3fb1-94a8-63945b1b992e",
                        "target_lang_word": "Tollpatsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tollpatsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee606248-16b3-3944-9f2c-d792ca0d4ee8",
                                        "entry_id": "70497559-aaf9-31bd-b138-cc4ce55908fc",
                                        "glosses": [
                                            "ungeschickter Mensch, Pechvogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1bcc9a-2c3c-4be3-8d7d-83ed17fea944",
                                                "sense_id": "ee606248-16b3-3944-9f2c-d792ca0d4ee8",
                                                "text": "Der Tollpatsch stolpert über den Bahnsteig."
                                            },
                                            {
                                                "example_id": "d720d225-0732-4e1c-ba85-eaa1c0c01ecc",
                                                "sense_id": "ee606248-16b3-3944-9f2c-d792ca0d4ee8",
                                                "text": "Du bist aber auch ein Tollpatsch! Hol einen Lappen aus der Küche und wisch das wieder auf!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
