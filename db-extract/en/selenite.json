    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d1b95d13-897a-343e-ace5-7f22dcda769c",
                "word": "Selenite",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b3363b0-493f-3c7b-8de5-816d425183db",
                        "entry_id": "d1b95d13-897a-343e-ace5-7f22dcda769c",
                        "glosses": [
                            "Pertaining to the inhabitants of Luna (Lunarians/Selenites)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c6275efc-94ee-4cf8-bdcc-5a4f968f32e1",
                                "sense_id": "4b3363b0-493f-3c7b-8de5-816d425183db",
                                "text": "a Selenite colony"
                            },
                            {
                                "example_id": "ba169e4a-ef4e-48bc-afd3-ce7c845fe9d0",
                                "sense_id": "4b3363b0-493f-3c7b-8de5-816d425183db",
                                "text": "\"Come, Diana [a dog],\" said he; \"come, my girl! thou whose destiny will be marked in the cynegetic annals; […] thou who art rushing into interplanetary space, and wilt perhaps be the Eve of all Selenite dogs! come, Diana, come here.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                "word": "selenite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4db9f681-bd23-4b35-b88a-60ac85a7fb57",
                        "entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                        "tags": [
                            "plural"
                        ],
                        "form": "selenites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94ae1680-155d-3eba-8803-c6938acf3b2c",
                        "entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                        "glosses": [
                            "A soft, glassy form of gypsum (chemical formula CaSO₄·2H₂O)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1846b22c-44c6-4e0d-a8fb-d85281b046e4",
                                "sense_id": "94ae1680-155d-3eba-8803-c6938acf3b2c",
                                "text": "I followed them to my study, and found lying on my writing-table still, with the selenite paper-weight upon it, the sheet of work I had left on the afternoon of the opening of the cylinder."
                            },
                            {
                                "example_id": "cf8e4a13-af4b-4d0b-8c61-5811f771a356",
                                "sense_id": "94ae1680-155d-3eba-8803-c6938acf3b2c",
                                "text": "Glass windows replaced the old tiny windows of selenite (crystallized gypsum), and stovepipe replaced adobe chimneys."
                            }
                        ]
                    },
                    {
                        "sense_id": "086bb758-5073-3954-8558-1746b61a7edb",
                        "entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                        "glosses": [
                            "The anion SeO₃²⁻ derived from selenous acid; any salt or ester of selenous acid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cadf190-7859-4cab-a58a-30b40deb8370",
                        "source_entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                        "source_sense_description": "gypsum",
                        "target_lang_word": "sélénite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sélénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d68755-855f-3963-b75e-b96dfe22f81e",
                                        "entry_id": "f9264342-1469-3a12-8977-3c97539cf26e",
                                        "glosses": [
                                            "ou Relatif à la Lune, lunaire."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d39a8d-c69f-4823-8454-0eb70f60e39e",
                                                "sense_id": "a9d68755-855f-3963-b75e-b96dfe22f81e",
                                                "text": "Alors on se demanda ce que pouvait devenir la malheureuse pseudo-atmosphère sélénite soumise à ce furieux « vent solaire »."
                                            },
                                            {
                                                "example_id": "a0bdb9ef-6ad4-4c4c-9414-838467973763",
                                                "sense_id": "a9d68755-855f-3963-b75e-b96dfe22f81e",
                                                "text": "Neil Armstrong descendit pour être le premier terrien à fouler du pied gauche le sol sélénite."
                                            },
                                            {
                                                "example_id": "a2d928f0-98fd-44c0-b3a7-0bb907d4d16e",
                                                "sense_id": "a9d68755-855f-3963-b75e-b96dfe22f81e",
                                                "text": "Ceux qui ont connu le Colisée au clair de lune, cratère sélénite, retrouveront la magie à Lanleff, observatoire des rêves de l’Orient en migration vers les Finistères de l’ouest…"
                                            },
                                            {
                                                "example_id": "60ae8248-656e-46c7-8733-ac27bfdbeefc",
                                                "sense_id": "a9d68755-855f-3963-b75e-b96dfe22f81e",
                                                "text": "Les vallées sans rivières qui alvéolent le calcaire des Grands Fonds prenaient des aspects de cirques sélénites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sélénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e40f5ea6-4730-34ab-82a8-b5ebb223625b",
                                        "entry_id": "9096a49d-563c-37e4-98b2-6c56a881e44d",
                                        "glosses": [
                                            "Gypse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208974c2-61b5-4476-8b5f-2cf40ac4d403",
                                                "sense_id": "e40f5ea6-4730-34ab-82a8-b5ebb223625b",
                                                "text": "J’avertis que j’appelle gypse ce que les nomenclateurs ont nommé sélénite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a49e7b-509b-3e1e-9434-180b25121f39",
                                        "entry_id": "9096a49d-563c-37e4-98b2-6c56a881e44d",
                                        "glosses": [
                                            "Variété de gypse translucide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sélénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e379820c-f54c-3520-8167-e559b7a747cc",
                                        "entry_id": "c527819a-ec9f-38ba-b2c6-bf47514320d3",
                                        "glosses": [
                                            "Sel produit par la combinaison de l’acide sélénieux avec une base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ca1fda4-a56a-432b-8f71-54d0801f4896",
                                                "sense_id": "e379820c-f54c-3520-8167-e559b7a747cc",
                                                "text": "…des apports trop élevés en vitamine C pourraient réduire considérablement l’absorption du sélénite de sodium."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sélénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1b5e5c-d415-3b23-8c42-776bf3b18fed",
                                        "entry_id": "b197e21e-fb0e-3929-b97c-a9e1f021115e",
                                        "glosses": [
                                            "Variante de Sélénite."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e4fcca-839e-40d7-a5b3-010940645a84",
                                                "sense_id": "0e1b5e5c-d415-3b23-8c42-776bf3b18fed",
                                                "text": "Le fameux bandit américain Stickforth, qui était un homme savant et lettré, docteur de plusieurs universités réputées, connaît l'existence de deux diamants énormes, acquis dans les siècles derniers par des moines impies de Londres, les sélénites, adorateurs de la lune, également appelés les moines bleus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7644df0d-3381-495f-beda-825d6a00a359",
                        "source_entry_id": "0ef4ee51-557b-3a58-ac43-fe8b305c405d",
                        "source_sense_description": "gypsum",
                        "target_lang_word": "Selenit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
