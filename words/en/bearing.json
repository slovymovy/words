                                "target_lang_word": "rodamiento",
                                "target_lang_sense_clarification": "mecanismo con elementos rodantes"
                            },
                            {
                                "target_lang_word": "cojinete",
                                "target_lang_sense_clarification": "pieza donde gira un eje"
                            },
                            {
                                "target_lang_word": "balinera",
                                "target_lang_sense_clarification": "término común en Latinoamérica para rodamientos"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ložisko",
                                "target_lang_sense_clarification": "strojní součástka pro snížení tření"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b3bc98-93dc-30a6-b675-be34dd9b9786",
                    "sense_definition": "One's understanding of one's orientation or relative position, literally or figuratively.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a moment to look at the map and get my <w>bearings</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужна минута, чтобы посмотреть на карту и определить свое <w>местоположение</w>.",
                                "es": "Necesito un momento para mirar el mapa y <w>orientarme</w>.",
                                "cs": "Potřebuji chvilku, abych se podíval do mapy a <w>zorientoval se</w>."
                            }
                        },
                        {
                            "text": "It took him a few weeks to find his <w>bearings</w> in the new office environment.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько недель, чтобы <w>освоиться</w> в новой офисной обстановке.",
                                "es": "Le tomó unas semanas <w>orientarse</w> en el nuevo entorno de oficina.",
                                "cs": "Trvalo mu několik týdnů, než se v novém kancelářském prostředí <w>rozkoukal</w>."
                            }
                        }
                    ],
                    "synonyms": [
