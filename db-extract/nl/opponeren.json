                "entry_id": "ba13dbcc-0231-3342-a6bd-edc6a2e5d5e8",
                "word": "opponeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5134c841-e933-3769-99dc-1a51230f9973",
                        "entry_id": "ba13dbcc-0231-3342-a6bd-edc6a2e5d5e8",
                        "glosses": [
                            "kritiek leveren, debatteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1820015-5c5a-4cf0-b150-af664c548e8e",
                                "sense_id": "5134c841-e933-3769-99dc-1a51230f9973",
                                "text": "Het debat wordt echter vergiftigd wanneer er op de man gespeeld wordt. Dat gebeurt wanneer pogingen worden ondernomen om mijn geloofwaardigheid als boodschapper aan te tasten, in plaats van te opponeren tegen de inhoud van de boodschap zelf."
                            },
                            {
                                "example_id": "50fecf38-a291-4495-b6d9-725be8a3c5dd",
                                "sense_id": "5134c841-e933-3769-99dc-1a51230f9973",
                                "text": "Zo bezien staat het parlement náást de regering als belangrijkste politieke orgaan van de democratie. De regering regeert en het parlement controleert. De laatste is dus constitutioneel gezien de opponent van de regering. Het is zijn constitutionele taak te opponeren, oppositie te voeren tegen de regering. Niet om het stelsel te ondermijnen, maar juist om het stelsel te waarborgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "08c966ce-9bdc-3eca-aac0-d88864f0925d",
                        "entry_id": "ba13dbcc-0231-3342-a6bd-edc6a2e5d5e8",
                        "glosses": [
                            "kritische vragen stellen over een proefschrift tijdens de promotieplechtigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64834f81-5729-4f78-9d64-a06f51296409",
                                "sense_id": "08c966ce-9bdc-3eca-aac0-d88864f0925d",
                                "text": "Hun beider werk wordt wereldwijd toegepast en is met een groot aantal prijzen en eredoctoraten beloond. Het echtpaar zal via skype opponeren tijdens de verdediging van de proefschriften van de drie promovendi. Dat betekent dat de vooraanstaande wetenschappers vragen stellen over de gepresenteerde onderzoeken."
                            }
                        ]
                    }
