{
    "word_family": [
        "два",
        "двойка",
        "двойной",
        "двоиться",
        "удвоить",
        "вдвоём",
        "двойня",
        "двойник",
        "двоякий",
        "раздвоение"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "c79721bd-2337-3a92-8a9e-31c355e96b62",
                    "sense_definition": "Количество из двух лиц или живых существ (обычно употребляется с существительными мужского рода, обозначающими людей, с названиями детей и детёнышей животных, а также с личными местоимениями).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У моей старшей сестры <двое> детей.",
                            "target_lang_translations": {
                                "en": "My older sister has <two> children.",
                                "zh": "我姐姐有<w>两个</w>孩子。"
                            }
                        },
                        {
                            "text": "Нас было <двое>, и мы решили пойти в кино вместе.",
                            "target_lang_translations": {
                                "en": "There were <two> of us, and we decided to go to the cinema together.",
                                "zh": "我们<w>两个</w>决定一起去看电影。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "нас двое",
                        "двое детей",
                        "работает за двоих",
                        "их двое"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of two people or living beings (usually used with masculine nouns denoting people, children, baby animals, and personal pronouns).",
                        "zh": "指两个（通常用于人、孩子或幼小动物，强调作为一个整体的两个个体）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "two",
                                "target_lang_sense_clarification": "collective numeral for people or animals"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两个",
                                "target_lang_sense_clarification": "用于人或动物的集合数词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c15b42a3-ae00-3446-a048-f570b53ec9bc",
                    "sense_definition": "Две штуки или две пары (употребляется с существительными, имеющими только форму множественного числа, или обозначающими парные предметы).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы ждали ответа целых <двое> суток.",
                            "target_lang_translations": {
                                "en": "We waited for an answer for <two> whole days.",
                                "zh": "我们足足等了<w>两天</w>两夜的答复。"
                            }
                        },
                        {
                            "text": "В ящике стола лежали старые <двое> ножниц.",
                            "target_lang_translations": {
                                "en": "There were <two pairs of> old scissors in the desk drawer.",
                                "zh": "抽屉里放着<w>两把</w>旧剪刀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "двое суток",
                        "двое часов",
                        "двое очков",
                        "двое брюк"
                    ],
                    "target_lang_definitions": {
                        "en": "Two items or two pairs (used with nouns that only have a plural form or denote paired objects).",
                        "zh": "指两件或两副（用于复数形式的名词或成对的物品）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "two pairs of",
                                "target_lang_sense_clarification": "for paired objects like scissors or trousers"
                            },
                            {
                                "target_lang_word": "two",
                                "target_lang_sense_clarification": "for plural-only nouns like days or nights"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两副",
                                "target_lang_sense_clarification": "用于成对物品，如眼镜或剪刀"
                            },
                            {
                                "target_lang_word": "两天",
                                "target_lang_sense_clarification": "用于复数形式的时间单位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}