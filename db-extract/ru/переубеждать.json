                        "cross_references": [
                            {
                                "target_word": "umstimmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09ed6945-c121-3ffb-ae6d-96941271004a",
                                        "entry_id": "dfc26f65-0784-38c0-a5c0-7a3ea2de6385",
                                        "glosses": [
                                            "die Stimmung oder Tonhöhe eines Musikinstrumentes ändern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a75a80-3172-4c9f-a9e5-b07da6ccde09",
                                                "sense_id": "09ed6945-c121-3ffb-ae6d-96941271004a",
                                                "text": "Zum Tonartwechsel muss man eine oder mehrere Saiten umstimmen."
                                            },
                                            {
                                                "example_id": "950775df-fba2-447e-b673-aead9c0a5371",
                                                "sense_id": "09ed6945-c121-3ffb-ae6d-96941271004a",
                                                "text": "Wenn man mit anderen Instrumenten spielt, die man nicht so leicht umstimmen kann (z.B. Klavier oder Flöte), dann richtet sich die Gitarre natürlich an diesen Instrumenten aus und nimmt von denen die Stimmtöne ab."
                                            },
                                            {
                                                "example_id": "d1243b91-3c62-43d3-b4b0-16dd3936dbd7",
                                                "sense_id": "09ed6945-c121-3ffb-ae6d-96941271004a",
                                                "text": "Diese [Pauken] konnten „augenblicklich und ohne Geräusch von einer Tonart in die andere umgestimmt werden“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc0824ae-c590-3a9c-9103-2c29906597aa",
                                        "entry_id": "dfc26f65-0784-38c0-a5c0-7a3ea2de6385",
                                        "glosses": [
                                            "jemandes Meinung oder Verhalten durch Überredung oder Überzeugung wandeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ff07a6-a8dd-4521-b741-58578e027ef9",
                                                "sense_id": "fc0824ae-c590-3a9c-9103-2c29906597aa",
                                                "text": "Flehend sah er sie an, als könnte sein Blick sie noch umstimmen."
                                            },
                                            {
                                                "example_id": "ae62a3ef-b7fd-49b1-8d39-8c03843e4c8a",
                                                "sense_id": "fc0824ae-c590-3a9c-9103-2c29906597aa",
                                                "text": "Kann der Brexit die Polen umstimmen, wenn viele zurückkehren, freiwillig oder unter Zwang?"
                                            },
                                            {
                                                "example_id": "94f1685b-839a-4255-a09d-77d78bd04032",
                                                "sense_id": "fc0824ae-c590-3a9c-9103-2c29906597aa",
                                                "text": "Die Hoffnung der Familien ruht nun darauf, dass sich die drei beteiligten Staaten umstimmen lassen - beziehungsweise darauf, dass sich ein reicher Privatmann findet oder dass es einen Zufallsfund gibt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4ce21b8b-9b70-37f7-8170-4b530005bd46",
                                        "entry_id": "dfc26f65-0784-38c0-a5c0-7a3ea2de6385",
                                        "glosses": [
                                            "den Metabolismus beeinflussen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a973829c-8bb0-4339-a205-409bd04d8b4b",
                                                "sense_id": "4ce21b8b-9b70-37f7-8170-4b530005bd46",
                                                "text": "Nicht zuletzt spricht für die vegetative Genese, dass Massnahmen, welche vegetativ «umstimmen», den Schmerz beeinflussen."
                                            },
                                            {
                                                "example_id": "f016ff0a-bbd0-4787-a862-25de82fa5d30",
                                                "sense_id": "4ce21b8b-9b70-37f7-8170-4b530005bd46",
                                                "text": "Obwohl er seine Ergebnisse nur durch Tierexperimente künstlich herbeigeführt hatte, erklärte er im Analogieschluß vom Meerschweinchen auf den Menschen homosexuelle Männer durch Keimdrüsentransplantation heterosexuell „umstimmen\" zu können (…)."
                                            },
                                            {
                                                "example_id": "b9342b29-a45b-4e47-a13a-efc9971bb133",
                                                "sense_id": "4ce21b8b-9b70-37f7-8170-4b530005bd46",
                                                "text": "Vor dem Hintergrund der Annahme, dass der Körper „Zeit“ für die Verdauung braucht, wird der Mensch der seinen Stoffwechsel umstimmen möchte, dazu aufgefordert Pausen zwischen den Mahlzeiten zu lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
