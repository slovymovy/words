                "senses": [
                    {
                        "sense_id": "a69e22e9-7b96-3a42-bc99-24297eedd517",
                        "entry_id": "4c9919e7-2a33-307a-a397-5d9d58e4d512",
                        "glosses": [
                            "Perte ou diminution du désir, ou désintérêt à l’égard des choses du sexe. → voir anorgasmie, impossibilité d'éprouver l’orgasme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "536e5a83-0f02-497f-9d38-add8a61561ca",
                                "sense_id": "a69e22e9-7b96-3a42-bc99-24297eedd517",
                                "text": "Anaphrodisie ne signifie pas forcément frigidité, qui associe absence de désir et absence de plaisir, la femme anaphrodisiaque peut éprouver du plaisir sexuel."
                            },
                            {
                                "example_id": "d2b9ddf2-b1f6-4596-a37e-01e9281109df",
                                "sense_id": "a69e22e9-7b96-3a42-bc99-24297eedd517",
                                "text": "Dans deux cas cependant l’anaphrodisie semblait consécutive à une dyspareunie : la souffrance avait, semble-t-il, inhibé tout désir."
                            }
                        ]
                    }
                ],
