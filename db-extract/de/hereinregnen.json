                "senses": [
                    {
                        "sense_id": "42d60831-326e-3a12-a071-e05e8af58d20",
                        "entry_id": "d370d808-52ba-35d6-8771-6884e6eba99b",
                        "glosses": [
                            "in das Innere von etwas regnen (dortherein, wo sich der Sprechende befindet)"
                        ],
                        "tags": [
                            "impersonal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b40d677c-1459-44ad-bc36-cf72cff9cc5d",
                                "sense_id": "42d60831-326e-3a12-a071-e05e8af58d20",
                                "text": "Ich habe vergessen, die Fenster zu schließen, sodass es in mein Wohnzimmer hineinregnete."
                            },
                            {
                                "example_id": "80894f8e-1600-4896-8e2a-855cb90e8e62",
                                "sense_id": "42d60831-326e-3a12-a071-e05e8af58d20",
                                "text": "„Ein herabfallender Block zerschlug mehrere der Scheiben im Kuckuk über der Cajüte so, dass es hereinregnete, und durch das starke Rollen fielen Tische und Möbeln um.“"
                            }
                        ],
