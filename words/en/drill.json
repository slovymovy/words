                {
                    "sense_id": "6dab0e8a-b1d5-3d00-bba7-794698a9224b",
                    "sense_definition": "A short-tailed monkey found in the forests of West Africa, related to the mandrill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drill</w> is an endangered primate living in the rainforests of Nigeria and Cameroon.",
                            "target_lang_translations": {
                                "ru": "<w>Дрил</w> — это находящийся под угрозой исчезновения примат, живущий в тропических лесах Нигерии и Камеруна.",
                                "tr": "<w>Dril</w>, Nijerya ve Kamerun'un yağmur ormanlarında yaşayan nesli tehlike altındaki bir primattır."
                            }
                        },
                        {
                            "text": "Unlike the mandrill, the face of the <w>drill</w> is black without bright colors.",
                            "target_lang_translations": {
                                "ru": "В отличие от мандрила, лицо <w>дрила</w> черное, без ярких цветов.",
                                "tr": "Mandrilin aksine, <w>drilin</w> yüzü parlak renkler barındırmayan siyah renktedir."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткохвостая обезьяна, обитающая в лесах Западной Африки, родственная мандрилу.",
                        "tr": "Batı Afrika ormanlarında yaşayan, mandrille akraba kısa kuyruklu bir maymun türü."
                    },
                    "translations": {
