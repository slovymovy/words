                        "cross_references": [
                            {
                                "target_word": "psychosomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                        "entry_id": "24a698a5-71c4-36eb-9c0a-bba107804c9a",
                                        "glosses": [
                                            "Relatif à l’influence de l’esprit sur le corps (maladies psychosomatiques)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eec3df2-55d6-4e52-b4b3-168e487e2a37",
                                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                                "text": "Les peurs et les angoisses, qui accompagnent ces tourments, se traduisent aussi par des symptômes psychosomatiques : se sentir moche, avoir mal à la tête, des vertiges, des nausées ou des crampes à l’estomac."
                                            },
                                            {
                                                "example_id": "8c668921-3bb7-4c40-9a00-8d389971a7ad",
                                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                                "text": "Dans l’un et l’autre cas, le traumatisme induit est utilisé pour casser l’identité initiale et l’équilibre psychosomatique."
                                            },
                                            {
                                                "example_id": "fb96fd7e-85e3-4785-ba48-58f656400a49",
                                                "sense_id": "5da3ff8f-72a0-3358-8a02-17156638849f",
                                                "text": "Le manque d’appétit dû au stress est un trouble psychosomatique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychosomatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a560634a-4d55-395b-9409-6400ffb93a79",
                                        "entry_id": "9ad9fd6a-4f06-3eda-bed4-bbdb4611fa24",
                                        "glosses": [
                                            "Mécanisme par lequel l’esprit influence le corps."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1259a364-4c2b-4193-ab4f-b7798b43af46",
                                                "sense_id": "a560634a-4d55-395b-9409-6400ffb93a79",
                                                "text": "En plein XVIᵉ siècle, Montaigne découvre les principes de la psychosomatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9341a4d2-25c8-4d55-be7f-ce2eaf0f32f3",
                        "source_entry_id": "a3d2c32f-7831-3a44-b2af-f0c2e281542f",
                        "source_sense_description": "of physical effects with mental causes",
                        "target_lang_word": "psychosomatisch",
