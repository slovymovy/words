                "senses": [
                    {
                        "sense_id": "914df3c9-7a41-3fc4-ac20-9bb9c542156d",
                        "entry_id": "e3f351e7-7dfc-3ae8-89d5-78e43c3f6198",
                        "glosses": [
                            "Örtlichkeit, die an einen Bahnhof angeschlossen ist und der (durchgängigen) Vorführung von Wochenschauen, Filmen mit hohem Anteil an Gewaltdarstellungen oder Sexfilmen diente"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd2bdc0-7b25-48bc-89be-a3d26dd364f4",
                                "sense_id": "914df3c9-7a41-3fc4-ac20-9bb9c542156d",
                                "text": "Die Bahnhofslichtspiele waren ursprünglich dazu gedacht, den Reisenden die Wartezeit zu verkürzen und den Neubau von Bahnhöfen in der Nachkriegszeit zu finanzieren."
                            },
                            {
                                "example_id": "deed6abf-e40f-4e9c-9201-4658169372fa",
                                "sense_id": "914df3c9-7a41-3fc4-ac20-9bb9c542156d",
                                "text": "„Die Bahnhofskinos, meist „Bali“ für Bahnhofslichtspiele oder „Aki“ für Aktualitätenkino benamst, waren eine westdeutsche Besonderheit. Sie entstanden nach dem Zweiten Weltkrieg in der Phase des Wiederaufbaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
