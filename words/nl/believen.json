{
    "word_family": [
        "lief",
        "liefde",
        "believenis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5018ba2b-ac03-3fd8-b043-a21eace4e0e8",
                    "sense_definition": "eigen wil of wens, meestal in vaste verbindingen om aan te geven dat men iets naar eigen inzicht mag doen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gasten mogen tijdens het ontbijt naar <w>believen</w> koffie en thee inschenken.",
                            "target_lang_translations": {
                                "en": "Guests are welcome to pour coffee and tea <w>at will</w> during breakfast."
                            }
                        },
                        {
                            "text": "Je kunt de volgorde van de hoofdstukken naar eigen <w>believen</w> aanpassen.",
                            "target_lang_translations": {
                                "en": "You can adjust the order of the chapters <w>as you see fit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "welgevallen",
                        "wens",
                        "keuze"
                    ],
                    "common_phrases": [
                        "naar believen",
                        "naar eigen believen"
                    ],
                    "target_lang_definitions": {
                        "en": "one's own will, desire, or pleasure, usually used in set phrases indicating that something may be done as one sees fit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pleasure",
                                "target_lang_sense_clarification": "one's will or desire, as in 'at will/at pleasure'"
                            },
                            {
                                "target_lang_word": "will",
                                "target_lang_sense_clarification": "personal choice or desire"
                            },
                            {
                                "target_lang_word": "discretion",
                                "target_lang_sense_clarification": "freedom to decide according to one's own judgment"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae91606d-84c5-3146-b3e4-33b72d188700",
                    "sense_definition": "wensen of verkiezen iets te doen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wensen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U kunt gaan en staan waar het u <w>belieft</w>.",
                            "target_lang_translations": {
                                "en": "You can come and go wherever you <w>please</w>."
                            }
                        },
                        {
                            "text": "Zij <w>beliefde</w> pas laat op de avond haar opwachting te maken.",
                            "target_lang_translations": {
                                "en": "She <w>deigned</w> to make her appearance only late in the evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "wensen",
                        "verkiezen"
                    ],
                    "common_phrases": [
                        "als het u belieft",
                        "zoals het u belieft"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak gebruikt met een formele of spottende toon."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to wish, desire, or choose to do something (often formal, dated, or ironic)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please",
                                "target_lang_sense_clarification": "to choose, wish, or see fit"
                            },
                            {
                                "target_lang_word": "choose",
                                "target_lang_sense_clarification": "to decide or prefer to do something"
                            },
                            {
                                "target_lang_word": "see fit",
                                "target_lang_sense_clarification": "to decide that something is appropriate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1f53993-7406-3873-a47d-8963c5a7ae6d",
                    "sense_definition": "iemand behagen of naar de zin zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>beliefde</w> hem niet om op die moeilijke vraag te reageren.",
                            "target_lang_translations": {
                                "en": "It did not <w>please</w> him to respond to that difficult question."
                            }
                        },
                        {
                            "text": "Het heeft de koning <w>beliefd</w> de wet te ondertekenen.",
                            "target_lang_translations": {
                                "en": "It has <w>pleased</w> the king to sign the bill."
                            }
                        }
                    ],
                    "synonyms": [
                        "behagen",
                        "aanstaan"
                    ],
                    "common_phrases": [
                        "het belieft hem"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Meestentijds onpersoonlijk gebruikt ('het belieft iemand')."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to please someone, to be to someone's liking or satisfaction (mostly impersonal)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please",
                                "target_lang_sense_clarification": "to satisfy or be agreeable to someone"
                            },
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "to be convenient or agreeable to someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}