                "senses": [
                    {
                        "sense_id": "2aa0ee7c-3435-3ea0-b03a-81d8cae08f8a",
                        "entry_id": "50a02cae-4680-342f-894e-369b88f64a34",
                        "glosses": [
                            "Poisson de l’Atlantique nord et de la Méditerranée, de la famille des zéidés (Zeus faber), vivant à proximité des côtes sur les fonds rocheux, au corps haut et comprimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5dcb0f-3caf-4de6-b664-fc4f1c44c32c",
                                "sense_id": "2aa0ee7c-3435-3ea0-b03a-81d8cae08f8a",
                                "text": "Le chef aura peut-être, ce soir-là, préparé son émincé de saint-pierre aux poivrons rouges doux qui, suivi d’un soufflé aux fruits frais, vous ouvrira les portes d’une nuit sereine."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6b4356a-44ed-3ff4-939e-60f517e9a4cb",
                        "entry_id": "50a02cae-4680-342f-894e-369b88f64a34",
                        "glosses": [
                            "Poisson de la famille des Oreosomatinae, dont le nom scientifique est Neocyttus rhomboidalis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "044a96d2-b509-30a4-bebe-8e3583502546",
                        "entry_id": "50a02cae-4680-342f-894e-369b88f64a34",
                        "glosses": [
                            "Poisson du Pacifique sud de la famille des Oreosomatidae dont le nom scientifique est Pseudocyttus maculatus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6e63d469-da07-3184-9aea-d3eeb11c9754",
                        "entry_id": "50a02cae-4680-342f-894e-369b88f64a34",
                        "glosses": [
                            "Aiglefin, poisson dont le nom scientifique est Melanogrammus aeglefinus."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fe9c46f8-72d1-35f2-9518-bd7188eadcb0",
                        "entry_id": "50a02cae-4680-342f-894e-369b88f64a34",
                        "glosses": [
                            "Synonyme de plusieurs cépages donnant du raisin blanc : le colombaud et le saint-pierre doré."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e32580fa-4517-4f23-bfdc-0c6515b9d7ef",
                                "sense_id": "fe9c46f8-72d1-35f2-9518-bd7188eadcb0",
                                "text": "Il n’existe donc aucune raison plausible pour lui adjoindre aucun autre cépage dans les vignes dont les produits sont destinés à la distillation, pas même le colombar, qui se comporte le mieux après lui, et encore moins la chalosse, la balustre, le saint-pierre, le blanc ramé, l’aubier, la franche, le pouillot, le muscadet, le clairet, dont les allures sont bien différentes parmi les cépages blancs."
                            }
                        ]
                    }
                ],
