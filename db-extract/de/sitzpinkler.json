                    {
                        "sense_id": "fd41de8a-578f-3f51-8bec-30430c5bc6bb",
                        "entry_id": "270f3eef-57ba-336b-b494-f1ca2cac76b3",
                        "glosses": [
                            "verweichlichte männliche Person"
