                        "glosses": [
                            "To agree to sell more of something than one can supply."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1abbf685-0320-30a7-8fd2-ab7b5cc06f69",
                        "entry_id": "7f500106-113b-379f-b21b-c19e94a5ba19",
                        "glosses": [
                            "To be too eager in attempting to sell something."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "290fed4a-c229-3ee0-b638-9a87b84ee2ba",
                        "entry_id": "7f500106-113b-379f-b21b-c19e94a5ba19",
                        "glosses": [
                            "To praise something to excess."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ddbcdb8c-40c3-4d1e-9669-e6e890e3ce7e",
                                "sense_id": "290fed4a-c229-3ee0-b638-9a87b84ee2ba",
                                "text": "I don't want to oversell it, but [second clause]"
                            },
                            {
                                "example_id": "a8926128-08e4-4bff-baa7-d6f806d4d0fc",
                                "sense_id": "290fed4a-c229-3ee0-b638-9a87b84ee2ba",
                                "text": "I don't want to oversell it, but you've got to check out that new restaurant on Third Street."
                            }
                        ]
                    },
                    {
                        "sense_id": "18ec5f65-d538-33b9-b40e-97489ebbda1d",
                        "entry_id": "7f500106-113b-379f-b21b-c19e94a5ba19",
                        "glosses": [
                            "To sell for a higher price than; to exceed in sale price."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "96998499-8c3c-4644-bd05-121058cdcf1a",
                                "sense_id": "18ec5f65-d538-33b9-b40e-97489ebbda1d",
                                "text": "One whose beauty / Would oversell all Italy"
                            }
                        ]
