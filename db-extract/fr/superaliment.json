                        "cross_references": [
                            {
                                "target_word": "superfood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b40d58c-4fb3-3c00-887c-f7c77abdb30d",
                                        "entry_id": "dccfea4c-8ead-3536-807e-b98e47d14a59",
                                        "glosses": [
                                            "Any food purported to confer remarkable health benefits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d32191-89ea-4054-a073-0341903d1436",
                                                "sense_id": "5b40d58c-4fb3-3c00-887c-f7c77abdb30d",
                                                "text": "Superfoods include many different food choices, which make going on the superfood diets so easy because you have a big variety to choose from for your meals. It does not matter which of the superfoods you eat, you can gain the nutrients […]"
                                            },
                                            {
                                                "example_id": "05cb1a26-499f-4e31-9f5f-d3ce9dde1f1b",
                                                "sense_id": "5b40d58c-4fb3-3c00-887c-f7c77abdb30d",
                                                "text": "2015, Sonoma Press, Quinoa: The Everyday Superfood: 150 Gluten-Free Recipes to Delight Every Kind of Eater, Arcas Publishing →ISBN\nThere's a lot of interesting stuff to know about this superfood, but you don't have to learn everything about quinoa to know it's delicious, versatile, and easy to make. In fact, you can cook and eat quinoa like just about any grain, even though it […]"
                                            },
                                            {
                                                "example_id": "5707eeee-a49e-4165-a9c5-d7b32bd3e698",
                                                "sense_id": "5b40d58c-4fb3-3c00-887c-f7c77abdb30d",
                                                "text": "Many other wonderful adaptogens are available. Finding a formula with many of these superfood nutrients will have a very positive impact on your body and its response to stress."
                                            },
                                            {
                                                "example_id": "ad51994d-814b-4e03-909c-684f96349246",
                                                "sense_id": "5b40d58c-4fb3-3c00-887c-f7c77abdb30d",
                                                "text": "Don't worry, Coach. In my cooler, I've got a greens superfood drink that will cancel out the chips, beef jerky, and candy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f92588b6-fd09-3c35-98f3-c586807da7a3",
                                        "entry_id": "dccfea4c-8ead-3536-807e-b98e47d14a59",
                                        "glosses": [
                                            "Any food which provides a very concentrated source of protein, fats, or other nutritional necessities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5876343d-915e-460a-90c9-ea222c2d8430",
                                                "sense_id": "f92588b6-fd09-3c35-98f3-c586807da7a3",
                                                "text": "The foremost reason a food is considered a superfood is because of nutrient density, which is the percentage of nutrients in a food compared to the number of calories."
                                            },
                                            {
                                                "example_id": "bad5a13e-9485-4e49-842d-b112a9ce7efa",
                                                "sense_id": "f92588b6-fd09-3c35-98f3-c586807da7a3",
                                                "text": "Here are some useful tips to encourage your kids to eat more fruit and vegetables – one of the main sources of superfood nutrients in their diet."
                                            },
                                            {
                                                "example_id": "e7a7d4ad-1d27-4994-a707-bea29a200634",
                                                "sense_id": "f92588b6-fd09-3c35-98f3-c586807da7a3",
                                                "text": "Superfoods are all about using as wide a range as possible of good quality, fresh ingredients in your cooking."
                                            },
                                            {
                                                "example_id": "2ea1c36f-d1d5-410f-8394-8e97eab6e51c",
                                                "sense_id": "f92588b6-fd09-3c35-98f3-c586807da7a3",
                                                "text": "This salad is a superfood party in a bowl! It's so good, so colorful, and so full of nourishing ingredients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
