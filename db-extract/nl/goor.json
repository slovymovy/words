                        "source_sense_id": "d4168941-5ea7-3b3e-aab9-8fb7aa0feb6e",
                        "source_sense_description": "onsmakelijk, vies op een onhygiënische of immorele wijze",
                        "target_lang_word": "sordid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sordid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a0b3f8-4c0f-302b-9edf-db817d04bcb1",
                                        "entry_id": "cf519ae1-e66b-323a-b5ff-2cb2dd38db49",
                                        "glosses": [
                                            "Distasteful, ignoble, vile, or contemptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58510fc6-26a9-4185-a68d-8a8ebbb6de5a",
                                                "sense_id": "47a0b3f8-4c0f-302b-9edf-db817d04bcb1",
                                                "text": "The more hopelessly sordid and insensible he appeared, the greater became Mrs. Shelby's dread of his succeeding in recapturing Eliza and her child, and of course the greater her motive for detaining him by every female artifice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3dc998-eb3f-3d12-9f2c-1737dec8e944",
                                        "entry_id": "cf519ae1-e66b-323a-b5ff-2cb2dd38db49",
                                        "glosses": [
                                            "Dirty or squalid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ac7825a-9278-3b20-8c32-6fe1cda1d6af",
                                        "entry_id": "cf519ae1-e66b-323a-b5ff-2cb2dd38db49",
                                        "glosses": [
                                            "Morally degrading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6f6275-6d8c-4167-b438-2eeb5ef27220",
                                                "sense_id": "8ac7825a-9278-3b20-8c32-6fe1cda1d6af",
                                                "text": "He rode slowly home along the deserted road, watching the stars come out in the clear violet sky. They flashed softly into the limpid heavens, like jewels let fall into clear water. They were a reproach, he felt, to a sordid world."
                                            },
                                            {
                                                "example_id": "f9674b24-2107-44b6-ac34-5ee7d1d37431",
                                                "sense_id": "8ac7825a-9278-3b20-8c32-6fe1cda1d6af",
                                                "text": "I know it sounds sordid but you'll be rewarded, when at last I've been given my dues."
                                            },
                                            {
                                                "example_id": "54863892-e56e-4f44-b983-310b3e6d68d6",
                                                "sense_id": "8ac7825a-9278-3b20-8c32-6fe1cda1d6af",
                                                "text": "It is a sordid business, this divvying us up by race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf1ef22-91c4-38f8-8cbf-1b39aebcb2fc",
                                        "entry_id": "cf519ae1-e66b-323a-b5ff-2cb2dd38db49",
                                        "glosses": [
                                            "Grasping; stingy; avaricious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "043e1a8c-a1b3-3373-8e96-d1dc326acc43",
                                        "entry_id": "cf519ae1-e66b-323a-b5ff-2cb2dd38db49",
                                        "glosses": [
                                            "Of a dull colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
