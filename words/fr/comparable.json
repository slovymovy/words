    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "036f76c6-3bde-39e4-943e-8ee0160a5ef2",
                    "sense_definition": "Qui peut être comparé avec quelqu'un ou quelque chose en raison de traits communs ou d'une ressemblance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le salaire proposé pour ce poste est tout à fait <w>comparable</w> à la moyenne nationale."
                        },
                        {
                            "text": "Ces deux pays ont une taille <w>comparable</w>, mais leurs économies restent très différentes."
                        }
                    ],
                    "synonyms": [
                        "analogue",
                        "assimilable",
                        "similaire"
                    ],
                    "antonyms": [
                        "incomparable"
                    ]
                },
                {
                    "sense_id": "3b80ec68-a913-393a-be3f-3d1c8f998c8e",
                    "sense_definition": "Qualifie des éléments entre lesquels existe une relation d'ordre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une structure ordonnée, deux éléments sont dits <w>comparables</w> si l'un est inférieur à l'autre."
                        },
                        {
                            "text": "Ces deux nombres réels restent toujours <w>comparables</w> selon la relation d'ordre habituelle."
                        }
                    ],
                    "common_phrases": [
                        "éléments comparables"
                    ]
                },
                {
                    "sense_id": "30b3620c-c110-3fa0-bd3a-3015acffe1fb",
                    "sense_definition": "Qualifie un mot dont on peut former les degrés de comparaison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un adjectif <w>comparable</w> peut former un degré de supériorité ou d'infériorité dans la phrase."
                        },
                        {
                            "text": "Les grammairiens considèrent que cet adverbe n'est pas <w>comparable</w> dans ce contexte précis."
                        }
                    ]
                }
            ]
        }
    ]
