                        "entry_id": "4db167bc-cbc4-3031-913a-5436962a0942",
                        "glosses": [
                            "sluier die het gehele gezicht bedekt en alleen de ogen vrij laat, gedragen door moslimvrouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339c0f20-ee0c-46da-a7e7-038563f10977",
                                "sense_id": "f5f61be8-c326-3a60-9162-867bcce7ccd3",
                                "text": "In haar nikab zag ze er nog verleidelijker uit"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b143cad-a403-4c6b-b72c-75db036fff21",
                        "source_entry_id": "4db167bc-cbc4-3031-913a-5436962a0942",
                        "source_sense_id": "f5f61be8-c326-3a60-9162-867bcce7ccd3",
                        "target_lang_word": "Niqab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niqab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                        "entry_id": "a440fefe-6bbd-3677-b413-4d15b4138a4c",
                                        "glosses": [
                                            "Gesichtsschleier, bei dem die Augen frei bleiben"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8832b469-6f0b-4b9b-b960-f103d70ef1c7",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "Der Niqab ist auf der arabischen Halbinsel entstanden und dort auch heute noch am stärksten verbreitet."
                                            },
                                            {
                                                "example_id": "d639ff06-6734-4f8a-a979-d2853f1e888a",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Im Nachtdienst hielt ich einen PKW an, in dem vier komplett vermummte Frauen in ihren schwarzen Niqabs saßen.“"
                                            },
                                            {
                                                "example_id": "dbd0c905-a7a2-4c7f-82c4-f6f2115c1219",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„In vielen Ländern sehen Frauen die Welt nur durch ein engmaschiges Netz - sie tragen einen Niqab, den Gesichtsschleier der Muslima.“"
                                            },
                                            {
                                                "example_id": "f5f70995-ecac-4a0b-93c2-e39245310097",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Weil sie für ein Verbot der Vollverschleierung demonstrieren wollte, trat die Thüringer AfD-Abgeordnete Wiebke Muhsal mit einem Niqab im Landtag auf.“"
                                            },
                                            {
                                                "example_id": "445b4e51-9317-469b-b134-0dc18fced97a",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Die Debatte über den Schleier, die ein Minister der Regierung Blair vor drei Monaten lostrat, zielte auf die unbestreitbare Tatsache, dass Niqab und Burka ein ‚Zeichen der Trennung‘ darstellten, die Gräben in der Gesellschaft vertieften und Integration verhinderten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352d78ea-d026-41db-b7db-2af1c94bbd1e",
                        "source_entry_id": "4db167bc-cbc4-3031-913a-5436962a0942",
