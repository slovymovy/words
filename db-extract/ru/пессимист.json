                                                "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                                                "text": "Doctrine pessimiste."
                                            },
                                            {
                                                "example_id": "d99fc85c-86d0-4538-ad51-08f0297df4ea",
                                                "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                                                "text": "Une des plus sombres et des plus pessimistes tragédies, Hécube, illustre les conséquences d’une guerre sanglante qui pèsent sur la vie des populations vaincues."
                                            }
                                        ]
                                    },
