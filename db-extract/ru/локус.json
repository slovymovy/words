                        "examples": [
                            {
                                "example_id": "e4ca48ef-8454-4793-a230-4182d7ae570d",
                                "sense_id": "1036f55c-073e-31a4-8295-ca3d58921970",
                                "text": "Употребление алкоголя, исходя из интерпретации данного фактора, связано с типом поведения, ориентированным на внешний локус контроля."
                            }
                        ]
