                "senses": [
                    {
                        "sense_id": "333680bc-e005-3a15-badb-90b96656007f",
                        "entry_id": "7220c01c-ed29-3200-a64b-c007fef1cbac",
                        "glosses": [
                            "Vorhersage „durch wissenschaftliche Verallgemeinerung“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d36977f7-b628-464b-990a-630d7b7b96b6",
                                "sense_id": "333680bc-e005-3a15-badb-90b96656007f",
                                "text": "„Die lineare Prädiktion führt dann je nach deren Güte zu einem höher dekorrelierten Fehlersignal…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da441eb-7764-481c-8ae4-58a9b55be9ff",
                        "source_entry_id": "7220c01c-ed29-3200-a64b-c007fef1cbac",
                        "source_sense_id": "333680bc-e005-3a15-badb-90b96656007f",
                        "target_lang_word": "prédiction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédiction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                        "entry_id": "2b05d9ee-0fa9-3040-a6b1-6ff6857658d8",
                                        "glosses": [
                                            "Action de prédire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ecf2ad-1fa9-4b95-aa0a-b3063a834c8c",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Faire une prédiction."
                                            },
                                            {
                                                "example_id": "a99c430b-f801-4484-8d0a-6ba44562c57a",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Se mêler de prédiction."
                                            },
                                            {
                                                "example_id": "18ea3fd9-e2ef-4ded-9406-903d0aa49133",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Avoir le don de prédiction."
                                            },
                                            {
                                                "example_id": "e8eb924e-71e1-45ee-852b-9bf51d4cbf3f",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Les astrologues avaient fait un art de la prédiction."
                                            },
                                            {
                                                "example_id": "10442556-4ce3-4134-9c47-ace821985161",
                                                "sense_id": "c1f8e04f-e1fb-38fe-a2cb-e4de66d23626",
                                                "text": "Comme nous l’avons vu, notre système cognitif réalise en permanence des prédictions sur les événements à venir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                        "entry_id": "2b05d9ee-0fa9-3040-a6b1-6ff6857658d8",
                                        "glosses": [
                                            "Chose qui est prédite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1890a7a-d5a7-4a0b-9a72-779254555abc",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "Bah ! vous croyez, Madame, dit le roi d’un air qui indiquait qu’il n’ajoutait pas grande foi aux prédictions de sa mère."
                                            },
                                            {
                                                "example_id": "79dc1b98-e91d-4718-b119-3323e1ec7eec",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "C’était la première fois dans sa vie que Zaheira avait ajouté foi à des prédictions de ce genre. La compagnie des femmes du village, depuis son mariage, l’avait peu à peu inclinée vers ces superstitions."
                                            },
                                            {
                                                "example_id": "65f2b862-f772-4b8b-b6ef-6094ab90b363",
                                                "sense_id": "6c19a412-351c-34e0-8ce5-695b0b04a1cc",
                                                "text": "C'est un bon métier que celui de prophète, mais à la condition d'y éviter les trop grosses bourdes et de ne pas montrer aux simples mortels combien est peu sensible parfois l’écart entre une prédiction et une bévue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86163f26-e14b-4570-b812-ad9633a58de0",
                        "source_entry_id": "7220c01c-ed29-3200-a64b-c007fef1cbac",
                        "source_sense_id": "333680bc-e005-3a15-badb-90b96656007f",
                        "target_lang_word": "projection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "projection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3346ef-8f82-35d3-acda-dc0fe358ad68",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Action de projeter."
                                        ],
                                        "tags": [
                                            "En général"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85556c41-0ecf-4069-b416-9aa52da77203",
                                                "sense_id": "7d3346ef-8f82-35d3-acda-dc0fe358ad68",
                                                "text": "La douche, c’est-à-dire la projection d’eau froide ou chaude sur le corps en jet, en pluie, en ablutions, est un agent thérapeutique de premier ordre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54cce3a-f062-343d-b43b-7c8a81f524aa",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Ce corps projeté en mouvement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab8ace4-5afb-44cd-af34-dccd6dc1ebdd",
                                                "sense_id": "d54cce3a-f062-343d-b43b-7c8a81f524aa",
                                                "text": "Une bâche de 1000 m² qui la recouvre et un dispositif d'aspersion de gouttes d’eau contribuent à éviter les projections alentour et à limiter la diffusion des poussières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f8da2f-ce39-3f35-be04-6e69f9bbae4e",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Amas de roches projetées par une éruption volcanique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f382260-0362-4be2-8a42-610ab1d7d12d",
                                                "sense_id": "76f8da2f-ce39-3f35-be04-6e69f9bbae4e",
                                                "text": "[…], c'est ainsi qu'il n'y a qu'une différence de 50 m entre le basalte de Reilhaguet, d’Onsac et le basalte du pliocène moyen entre la Vaissière et Jussac, qu'il n'y a qu'une petite masse de projections entre le trachyte de Giou-de-Mamou et le basalte du Coyan (Plioc. sup.), […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c182abf7-ee9a-317e-a189-fcf7a2647c51",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Action de projeter de la lumière ou des images lumineuses."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37afdb4-a1e7-413d-bcd7-26a9b6bd7eb9",
                                                "sense_id": "c182abf7-ee9a-317e-a189-fcf7a2647c51",
                                                "text": "La projection du film commence dans un quart d’heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e6d0a2-4281-3e9c-aa2e-d63fea325af4",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Image d’un objet, d’un portrait, d’une scène, d’un paysage, etc., projetée par un appareil d’optique, par une lanterne sur un écran."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd7a2fa-6637-444a-89a2-9bf8e180dce3",
                                                "sense_id": "96e6d0a2-4281-3e9c-aa2e-d63fea325af4",
                                                "text": "Appareil à projections."
                                            },
                                            {
                                                "example_id": "b95d843c-6fc6-4f71-aba4-75b1b1494159",
                                                "sense_id": "96e6d0a2-4281-3e9c-aa2e-d63fea325af4",
                                                "text": "Une conférence avec projections, illustrée de projections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead8ab7f-9345-3a8d-a5c8-43eaa6623442",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Séance durant laquelle un film est montré."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "870a88e7-20f9-4844-a42a-8b5047a85575",
                                                "sense_id": "ead8ab7f-9345-3a8d-a5c8-43eaa6623442",
                                                "text": "Sauf qu'à force de réduire la taille des salles, on est arrivé au seuil au-delà duquel, à riquiquitude égale, il n'y a plus guère de différence entre la projection quasi privée dans une micro-salle vide et la vision à domicile du même film à la télé."
                                            },
                                            {
                                                "example_id": "c70e60e3-5852-4a90-9590-2df9d0ca8805",
                                                "sense_id": "ead8ab7f-9345-3a8d-a5c8-43eaa6623442",
                                                "text": "A Marchand, le réalisateur reprochera de « ribouler » quand il joue la colère. En pleine projection de rushes, sa voix s'élève, pour lancer à l'acteur sur l'écran : « Arrête de ribouler des yeux! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6967056b-7992-3e4f-a78a-4f652e157cfe",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Acheminement, par voie aérienne, maritime ou terrestre, d’une force militaire loin de son lieu habituel de stationnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72b1e06-19bb-49c9-8307-1b2cd766e00c",
                                                "sense_id": "6967056b-7992-3e4f-a78a-4f652e157cfe",
                                                "text": "Projection de moyens humanitaires ou militaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cff0fd5-825c-3ce1-90c0-3ee81b148461",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Opération qui fournit une partie de table, donc un sous-ensemble en retirant des attributs (des colonnes), parfois selon ceux d’une autre table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a1428a2-8487-3d28-a57a-7b471fd02573",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            ": Image unique d’un élément sur un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abf7168-a369-48f3-aea9-3cc107672b26",
                                                "sense_id": "0a1428a2-8487-3d28-a57a-7b471fd02573",
                                                "text": "pour tout x ∈ H, il existe un unique élément de C appelé la projection de x sur C"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f434496e-23eb-3d50-8133-15d50aa64005",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Image obtenue par un vecteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130cf65f-2599-4af2-ab91-aea981263d79",
                                                "sense_id": "f434496e-23eb-3d50-8133-15d50aa64005",
                                                "text": "L’application p est appelée projection (vectorielle) sur F parallèlement à G."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50dd706-8260-322a-83b8-f6e95ebc4589",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Image obtenue parallèlement à une direction donnée."
                                        ],
                                        "tags": [
                                            "Géométrie descriptive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30148bc-ee3d-414e-9653-f7f61be21b4a",
                                                "sense_id": "a50dd706-8260-322a-83b8-f6e95ebc4589",
                                                "text": "On appelle projection orthogonale d’un point sur un axe …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cefc810-aa78-3bfb-a918-ba1e6e537396",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Mécanisme de défense psychique par lequel un sujet rejette des pulsions, des pensées, voire des désirs sur un autre, refusant d’admettre ceux-ci comme siens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4301c248-37cc-4671-90b5-55a6acceab0c",
                                                "sense_id": "6cefc810-aa78-3bfb-a918-ba1e6e537396",
                                                "text": "Pour Jung, la question de l'ombre est intimement liée à celle de la projection, ce phénomène singulier par lequel un individu imprime sur un objet ou un être un contenu psychique qui est un trait de sa vie intérieure. En somme, nous prêtons aux autres des traits de caractère et des attitudes que nous possédons sans les remarquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "212ee3b5-f253-336b-9508-2bebed275d2e",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Représentation de la sphère ou de tel autre corps solide, projetée verticalement sur un plan, d’après certaines règles géométriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaabe467-0a34-43ae-ab25-485be8e28d43",
                                                "sense_id": "212ee3b5-f253-336b-9508-2bebed275d2e",
                                                "text": "Toutes les lignes d’heures tracées sur les cadrans solaires sont les projections des méridiens célestes sur la surface du cadran."
                                            },
                                            {
                                                "example_id": "93263011-70b8-4db3-afce-062f1566157b",
                                                "sense_id": "212ee3b5-f253-336b-9508-2bebed275d2e",
                                                "text": "On nomme “plan” la projection d’un édifice sur une surface horizontale, et “élévation” la projection d’un édifice sur une surface verticale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47caba6d-8a9e-3ce1-93c8-daa72ffdd9d3",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Correspondance mathématique continue, généralement biunivoque, entre les points d'un ellipsoïde de référence, ou d'une partie de cet ellipsoïde, et les points d'un plan (ou éventuellement d'une autre surface), utilisée pour la réalisation de cartes de la surface de la Terre ou d'un autre corps céleste, celle-ci étant supposée projeter sur un ellipsoïde de référence suivant les normales à ce dernier."
                                        ],
                                        "tags": [
                                            "Entre les points d'un ellipsoïde de référence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de84f78-cf9e-4712-8a40-46072c0d660a",
                                                "sense_id": "47caba6d-8a9e-3ce1-93c8-daa72ffdd9d3",
                                                "text": "La projection de Bonne est aussi appelée projection de Flamsteed modifiée."
                                            },
                                            {
                                                "example_id": "778d2b39-cb00-4c38-8a76-c374231e7a43",
                                                "sense_id": "47caba6d-8a9e-3ce1-93c8-daa72ffdd9d3",
                                                "text": "La projection cartographique de Mercator est une projection tangentielle de type cylindrique."
                                            },
                                            {
                                                "example_id": "1c1a8952-ef28-40e4-b4d8-c97d670b56e5",
                                                "sense_id": "47caba6d-8a9e-3ce1-93c8-daa72ffdd9d3",
                                                "text": "Sans que cela soit nécessaire pour l’apprentissage de la technique même du dessin, il est bon de connaître les principes de base de la cartographie mathématique et de savoir quels sont les grands types de projections : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba032066-96f4-3f8c-9e88-c8e2650e8257",
                                        "entry_id": "253a29fc-a19c-379e-9e51-96f51694fa46",
                                        "glosses": [
                                            "Représentation graphique globale ou partielle, en deux ou trois dimensions, de la configuration de la Terre, d'un autre corps céleste ou du ciel, et des phénomènes qui s'y rapportent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
