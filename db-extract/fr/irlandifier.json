                "senses": [
                    {
                        "sense_id": "9547ffa7-9a2b-3cc1-bbaa-63535c2732c5",
                        "entry_id": "2870234a-319e-3104-8ce9-6725af730b67",
                        "glosses": [
                            "Devenir plus irlandais, prendre des caractéristiques rappelant l’Irlande."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a46c47f9-9d64-4d21-9f97-33aa0350ad46",
                                "sense_id": "9547ffa7-9a2b-3cc1-bbaa-63535c2732c5",
                                "text": "On se moqua de cette loi et l’on continua à s’irlandifier."
                            },
                            {
                                "example_id": "4f703378-97d6-4df6-b54e-82517e0f528c",
                                "sense_id": "9547ffa7-9a2b-3cc1-bbaa-63535c2732c5",
                                "text": "Si l’homme se distingue de tous les autres animaux par le caractère extensible et illimité de ses besoins, il n’existe cependant pas d’animal apte à restreindre ses besoins et à réduire ses conditions d’existence dans une mesure aussi incroyable et aussi minimale que l’homme ; en un mot, nul animal ne possède autant que l’homme le talent de s’irlandifier."
                            }
                        ]
                    }
                ],
