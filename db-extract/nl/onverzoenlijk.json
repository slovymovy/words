                        "cross_references": [
                            {
                                "target_word": "resentful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1be60855-85c6-33eb-ba31-752a1771443c",
                                        "entry_id": "1bf8cd83-cc00-38a6-96a2-dce2546b49df",
                                        "glosses": [
                                            "Inclined to resent, who tends to harbor resentment, when wronged."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "679fed6a-f927-3415-82b0-9fb1484b813c",
                                        "entry_id": "1bf8cd83-cc00-38a6-96a2-dce2546b49df",
                                        "glosses": [
                                            "Harboring resentment, full of resentment, at a given moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4bc84e4-b801-4ace-a85d-dfdc635d59a7",
                                                "sense_id": "679fed6a-f927-3415-82b0-9fb1484b813c",
                                                "text": "‘Them bloody chaps 'ave a cushy job,’ said little Martlow with resentful envy. ‘Just fly over the line, take a peek at ol' Fritz, and as soon as a bit o' shrapnel comes their way, fuck off 'ome jildy, toot sweet.’"
                                            },
                                            {
                                                "example_id": "b06fb34c-b71a-4ab8-974e-f149d1593c78",
                                                "sense_id": "679fed6a-f927-3415-82b0-9fb1484b813c",
                                                "text": "Is it serving Hashem to be machmir and resentful, rather than adhere to the letter of the law and be relaxed and happy?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
