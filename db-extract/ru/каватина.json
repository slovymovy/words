                "senses": [
                    {
                        "sense_id": "464cede6-7d86-394f-a6fe-3e5d2043e349",
                        "entry_id": "8d497826-b05f-3d8e-af25-6c70a90cc836",
                        "glosses": [
                            "муз. небольшая ария лирико-повествовательного характера в опере или оратории"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84182e60-c45d-4829-8fa8-0deaf353b626",
                                "sense_id": "464cede6-7d86-394f-a6fe-3e5d2043e349",
                                "text": "Он [Карл Павлович] .. с нежностью влюблённого просил её [жену Эмилию] сесть за фортепиано и спеть знаменитую каватину из «Нормы»."
                            },
                            {
                                "example_id": "2e2f1a1d-0485-42dc-9821-98c86c21b8de",
                                "sense_id": "464cede6-7d86-394f-a6fe-3e5d2043e349",
                                "text": "Не придётся больше услышать Тальбергу каватины про Бога всесильного, не услышать, как Елена играет Шервинскому аккомпанемент!"
                            }
                        ]
                    },
