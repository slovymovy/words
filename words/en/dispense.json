{
    "word_family": [
        "dispensation",
        "dispensary",
        "dispenser",
        "dispensable",
        "indispensable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca97913b-2504-3080-b5ca-f186c78573de",
                    "sense_definition": "To distribute or give out items to people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine <w>dispenses</w> free water to anyone who needs it.",
                            "target_lang_translations": {
                                "ru": "Автомат <w>раздает</w> бесплатную воду всем нуждающимся."
                            }
                        },
                        {
                            "text": "The charity <w>dispenses</w> food and clothing to the local community.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация <w>раздает</w> еду и одежду местным жителям."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "allocate",
                        "hand out"
                    ],
                    "common_phrases": [
                        "dispense items",
                        "dispense goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределять или выдавать предметы людям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздавать",
                                "target_lang_sense_clarification": "выдавать что-либо многим людям"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "делить что-либо между кем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27e7888c-b3e6-3c46-9436-16b86321440a",
                    "sense_definition": "To prepare and provide medicine or medical supplies according to a prescription.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacist <w>dispensed</w> the medication after checking the doctor's note.",
                            "target_lang_translations": {
                                "ru": "Фармацевт <w>отпустил</w> лекарство после проверки рецепта врача."
                            }
                        },
                        {
                            "text": "Local clinics are authorized to <w>dispense</w> vaccines to the public.",
                            "target_lang_translations": {
                                "ru": "Местные клиники уполномочены <w>выдавать</w> вакцины населению."
                            }
                        }
                    ],
                    "synonyms": [
                        "prepare",
                        "supply"
                    ],
                    "common_phrases": [
                        "dispense medicine",
                        "dispense prescriptions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить и выдавать лекарства или медицинские препараты по рецепту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпускать",
                                "target_lang_sense_clarification": "выдавать лекарства в аптеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c36c5acd-958d-3a95-84ed-0c6a6978647c",
                    "sense_definition": "To administer or carry out official duties like justice or laws.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge is expected to <w>dispense</w> justice fairly to all citizens.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что судья будет <w>вершить</w> правосудие справедливо по отношению ко всем гражданам."
                            }
                        },
                        {
                            "text": "The committee <w>dispenses</w> the rules governing the organization's daily operations.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>устанавливает</w> правила, регулирующие повседневную деятельность организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "administer",
                        "execute"
                    ],
                    "common_phrases": [
                        "dispense justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществлять официальные обязанности, такие как правосудие или исполнение законов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершить",
                                "target_lang_sense_clarification": "о правосудии"
                            },
                            {
                                "target_lang_word": "отправлять",
                                "target_lang_sense_clarification": "о выполнении официальных функций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "753cebc0-4c40-3394-ae2e-89a77f21a88a",
                    "sense_definition": "To grant an exemption or excuse someone from a rule or duty.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The principal <w>dispensed</w> the student from attending the mandatory morning assembly.",
                            "target_lang_translations": {
                                "ru": "Директор <w>освободил</w> ученика от посещения обязательной утренней линейки."
                            }
                        },
                        {
                            "text": "She was <w>dispensed</w> from her usual duties while she recovered from her illness.",
                            "target_lang_translations": {
                                "ru": "Она была <w>освобождена</w> от своих обычных обязанностей на время восстановления после болезни."
                            }
                        }
                    ],
                    "synonyms": [
                        "exempt",
                        "excuse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in formal or legal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождать кого-либо от соблюдения правила или выполнения обязанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "от обязанности или правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc6fd32c-8119-32d9-adcb-1dca689dc430",
                    "sense_definition": "To make up for or compensate for something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One happy moment can <w>dispense</w> for many years of sorrow.",
                            "target_lang_translations": {
                                "ru": "Один счастливый момент может <w>компенсировать</w> долгие годы печали."
                            }
                        },
                        {
                            "text": "His hard work helped <w>dispense</w> for his earlier mistakes.",
                            "target_lang_translations": {
                                "ru": "Его упорный труд помог <w>искупить</w> прежние ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "compensate",
                        "atone"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возмещать или компенсировать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компенсировать",
                                "target_lang_sense_clarification": "возмещать ущерб или потери"
                            },
                            {
                                "target_lang_word": "искупать",
                                "target_lang_sense_clarification": "о вине или ошибках"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc14f63b-b61a-3a3f-9c98-d2723da42c4c",
                    "sense_definition": "The act of distributing or providing something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dispense</w> of resources was handled by the central office.",
                            "target_lang_translations": {
                                "ru": "<w>Распределение</w> ресурсов осуществлялось центральным офисом."
                            }
                        },
                        {
                            "text": "The efficient <w>dispense</w> of aid saved many lives during the crisis.",
                            "target_lang_translations": {
                                "ru": "Эффективная <w>раздача</w> помощи спасла много жизней во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "dispensation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс распределения или предоставления чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределение",
                                "target_lang_sense_clarification": "процесс выдачи ресурсов"
                            },
                            {
                                "target_lang_word": "раздача",
                                "target_lang_sense_clarification": "акт предоставления чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}