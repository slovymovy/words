                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cell cycle <w>checkpoint</w> prevents damaged DNA from being replicated."
                        },
                        {
                            "text": "A failure at a molecular <w>checkpoint</w> can lead to uncontrolled cell growth."
                        }
                    ],
                    "common_phrases": [
