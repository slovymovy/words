                "translations": [
                    {
                        "translation_id": "e6128ad7-9a58-4b8b-b276-03cbd0fe40fc",
                        "source_entry_id": "3ef3fe11-2c76-31b6-b305-42b8ec5a26af",
                        "target_lang_word": "assembly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assembly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14188b2e-e913-3d88-895c-3333184ef3bc",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "A set of pieces that work together in unison as a mechanism or device."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcf006a-17b7-4e2c-b632-8f94c9dde101",
                                                "sense_id": "14188b2e-e913-3d88-895c-3333184ef3bc",
                                                "text": "In order to change the bearing, you must first remove the gearbox assembly."
                                            },
                                            {
                                                "example_id": "9d2273eb-a3c8-4d48-9160-dd383b8e03f9",
                                                "sense_id": "14188b2e-e913-3d88-895c-3333184ef3bc",
                                                "text": "Sheets of water poured over the car, making visibility all but nil. Suddenly the windshield wiper, not just the blade but the entire assembly, blew off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "The act or process of putting together a set of pieces, fragments, or elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2aa0e0-8e70-48d4-9d48-832928a23386",
                                                "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                                                "text": "instructions for assembly"
                                            },
                                            {
                                                "example_id": "2b066586-ad20-4dbc-81dc-520e9814d6e4",
                                                "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                                                "text": "some assembly required"
                                            },
                                            {
                                                "example_id": "fabfdf55-b14e-48fd-a1ee-83e143ea694a",
                                                "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                                                "text": "assembly line"
                                            },
                                            {
                                                "example_id": "a4570c1c-d69e-485d-b1c8-954aec5a4c12",
                                                "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                                                "text": "The bogies are built up of welded sub-units which are stress-relieved before assembly by riveting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "A congregation of people in one place for a purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916790ce-eba5-4b58-973f-2df0444ea0ca",
                                                "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                                                "text": "school assembly"
                                            },
                                            {
                                                "example_id": "0fd0ce85-d29b-4740-84a2-9fb6b496b57b",
                                                "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                                                "text": "freedom of assembly"
                                            },
                                            {
                                                "example_id": "bb273995-14ca-405f-b2ad-f71947bb9fb1",
                                                "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                                                "text": "In a word, they were made uſe of by the immediate ſucceſſors of the Apoſtles, and many of them read in the Public Aſſemblies of Chriſtians, as Canonical Scripture, without the leaſt mark of Diſtinction, in point of Autority[…]"
                                            },
                                            {
                                                "example_id": "ec711942-e637-4be7-abee-e1a01ed26397",
                                                "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8a6a22-8955-37e3-93f4-7ac140ae639f",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "A legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2a4e70-56a5-429b-bdd7-bd7aa956d6db",
                                                "sense_id": "1e8a6a22-8955-37e3-93f4-7ac140ae639f",
                                                "text": "the General Assembly of the United Nations"
                                            },
                                            {
                                                "example_id": "cb8a4e08-be65-4686-b65f-bb96228c074d",
                                                "sense_id": "1e8a6a22-8955-37e3-93f4-7ac140ae639f",
                                                "text": "New York State Assembly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c713f55f-e42e-357d-88f5-59cc7ea9e114",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "A beat of the drum or sound of the bugle as a signal to troops to assemble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56a35297-a669-3e40-a4f0-36faf5ee180d",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "Ellipsis of assembly language."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f50876-3c80-3359-aa8b-ccfde38b817a",
                                        "entry_id": "50ce03c3-d28e-3668-bff4-0bec86e1d6df",
                                        "glosses": [
                                            "A building block of an application, similar to a DLL, but containing both executable code and information normally found in a DLL's type library. The type library information in an assembly, called a manifest, describes public functions, data, classes, and version information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
