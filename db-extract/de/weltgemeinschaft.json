                "senses": [
                    {
                        "sense_id": "752e3ab2-d164-32d9-980c-b7a308752e76",
                        "entry_id": "c8bad502-52f6-34ce-bd2c-14774dc67a39",
                        "glosses": [
                            "Gesamtheit aller Menschen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "cab50ee1-8bb0-4f32-aad5-eef77be9e2cf",
                                "sense_id": "752e3ab2-d164-32d9-980c-b7a308752e76",
                                "text": "„Zum ersten Mal seit Generationen erwartet die Weltgemeinschaft wieder etwas von den Deutschen.“"
                            },
                            {
                                "example_id": "eacb8bfb-64c1-47c8-9f3e-8d7d85f1718b",
                                "sense_id": "752e3ab2-d164-32d9-980c-b7a308752e76",
                                "text": "„Soll ich meinen Optimismus, meinen Glauben an die Weltgemeinschaft, meine Hoffnung auf eine bessere Zukunft für meine Kinder aufgeben und durch die klassische jüdische Paranoia ersetzen?“"
                            }
                        ],
