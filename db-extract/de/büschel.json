                        "form": "die Büschel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                        "entry_id": "3d6ad474-59d0-323f-bffe-8ddc31f63eaa",
                        "glosses": [
                            "gebündelte oder miteinander verwachsene, relativ kleine Menge von (dünnen) länglichen Gegenständen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c21fb68-e57a-45ee-8fc0-b42837a34159",
                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                "text": "Der Friseur schnitt ein Büschel Haare."
                            },
                            {
                                "example_id": "b0239f83-19e3-43cd-9f02-14f91be9f186",
                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                "text": "„Nur die Brise vom Dorf und Fluß her wuchs, und die Kornfelder neigten sich und mit ihnen der rote Mohn, der in ganzen Büscheln zwischen den Halmen stand.“"
                            },
                            {
                                "example_id": "5afa86e9-6973-4969-9002-323288976e51",
                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                "text": "„Moos bedeckte den Boden um den Baum herum und einige trockene Büschel Wildgras, die sich der Aufmerksamkeit des Gärtners entzogen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56cff927-a375-44a4-b745-eddbcee7fd2d",
                        "source_entry_id": "3d6ad474-59d0-323f-bffe-8ddc31f63eaa",
                        "source_sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
