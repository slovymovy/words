                            {
                                "example_id": "e5ca7444-e68d-414c-a1c9-be98a09632ce",
                                "sense_id": "9af41624-2b03-399d-9c97-d1a1ffd333c0",
                                "text": "Ahead of us was a great ochreous depression over which a shifting heat haze trembled looking almost like blue smoke."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e19101f-ea78-3020-bd16-4516ca8ccb46",
                        "entry_id": "4f2137ec-a772-36fc-9d1f-6e22a0bbb471",
                        "glosses": [
                            "Ochre-coloured; brownish-yellow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8d8d0b-5330-4854-a6d9-7a84d0f2678c",
                                "sense_id": "5e19101f-ea78-3020-bd16-4516ca8ccb46",
                                "text": "[…] they looked around for a refreshment tent among the many which dotted the down. Two, which stood nearest to them in the ochreous haze of expiring sunlight, seemed almost equally inviting."
                            },
                            {
                                "example_id": "9bf3f98e-bbf5-4f91-be25-4f3d6c7db486",
                                "sense_id": "5e19101f-ea78-3020-bd16-4516ca8ccb46",
                                "text": "The Lutheran Church across the way, which in the daylight was the color of baby shit, had now taken on a soft ochrous hue which blended serenely with the black of the asphalt."
                            },
                            {
                                "example_id": "581369dc-b111-4985-8be4-9fc1c0300d78",
                                "sense_id": "5e19101f-ea78-3020-bd16-4516ca8ccb46",
                                "text": "It was a Saturday, one of those dusty, ocherous autumnal days whose vivid weather never again seems so sweet and inviting after that youthful time of discovery [...]."
                            }
                        ]
                    }
