                                        "entry_id": "34cb6a38-6e50-3015-b41a-84fb3353e28c",
                                        "glosses": [
                                            "Composition vocale avec accompagnement instrumental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1be9f40-14f1-4063-83cf-35eecb4bc422",
                                                "sense_id": "b96f8b85-35d7-3d10-98e9-dc5735695058",
                                                "text": "Il compose des œuvres pour orgue et des cantates pour chœur, solistes et instrumentistes."
                                            },
                                            {
                                                "example_id": "5b2e20d7-1a34-4b2b-996c-270bfcecff3b",
                                                "sense_id": "b96f8b85-35d7-3d10-98e9-dc5735695058",
                                                "text": "Elle ouvre la partition, c’est une cantate composée par Barbara Strozzi, musicienne morte quelques années auparavant."
                                            },
                                            {
                                                "example_id": "d8dd69fd-8dd6-4788-ae85-c217226f8771",
                                                "sense_id": "b96f8b85-35d7-3d10-98e9-dc5735695058",
                                                "text": "Les cantates de J.S.Bach."
