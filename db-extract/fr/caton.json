            {
                "entry_id": "0d29ebb3-cdab-39e1-b9e2-d1bb1fb3ab5d",
                "word": "Caton",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be75f45f-f1e8-396c-b7f7-c80357c12052",
                        "entry_id": "0d29ebb3-cdab-39e1-b9e2-d1bb1fb3ab5d",
                        "glosses": [
                            "Désigne plusieurs personnalités :"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "4b71bcc9-485a-4417-8863-0b839c098c62",
                                "sense_id": "be75f45f-f1e8-396c-b7f7-c80357c12052",
                                "text": "Caton l’Ancien (Marcus Porcius Cato, Cato Maior) ou Caton le Censeur (Cato Censorius), politicien, écrivain et militaire romain."
                            },
                            {
                                "example_id": "196fed9d-be45-47b6-8844-2398826ed715",
                                "sense_id": "be75f45f-f1e8-396c-b7f7-c80357c12052",
                                "text": "Caton d’Utique (Marcus Porcius Cato Uticencis) ou Caton le Jeune (Cato Minor), homme politique romain, petit-fils du précédent."
                            },
                            {
                                "example_id": "6ee3ef9a-a809-4ea7-b27b-d31879e659d3",
                                "sense_id": "be75f45f-f1e8-396c-b7f7-c80357c12052",
                                "text": "Dionysius Caton, auteur latin, connu pour son Disticha de moribus ad filium."
                            },
                            {
                                "example_id": "440dfc16-ab22-4214-b79b-a776904edba0",
                                "sense_id": "be75f45f-f1e8-396c-b7f7-c80357c12052",
                                "text": "Valerius Caton, grammairien et poète satirique latin."
                            }
                        ]
                    },
                    {
                        "sense_id": "a52fa188-9358-3980-985a-fc452c266560",
                        "entry_id": "0d29ebb3-cdab-39e1-b9e2-d1bb1fb3ab5d",
                        "glosses": [
                            "Personne rappelant Caton l’Ancien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690b9f0b-d1ac-4f5e-b9f9-e0c03aad5a70",
                                "sense_id": "a52fa188-9358-3980-985a-fc452c266560",
                                "text": "Certains Catons voudroient spartiatiser leur luxe & nous persuader qu’ils vont en voiture pour économiser leurs souliers."
                            },
                            {
                                "example_id": "a230baff-d5e0-46c2-91b7-3fd688bc3cce",
                                "sense_id": "a52fa188-9358-3980-985a-fc452c266560",
                                "text": "Quelle tête ils feraient, mes jeunes Catons, quand ils liraient, ainsi racontés, ces plaisirs de mon cœur !"
                            }
                        ]
                    }
                ],
