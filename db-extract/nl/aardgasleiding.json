                        "examples": [
                            {
                                "example_id": "7a5abedb-439e-4220-a5ac-074317cd8776",
                                "sense_id": "4b8a3113-7a49-3366-a868-3eef871015cb",
                                "text": "Nog een factor in de orde van ‘vragen om moeilijkheden’ is wat de Hoevenaren betreft een aardgasleiding van de Gasunie. Die loopt op zo'n honderd meter van de demonstratie-locatie waar nu een ‘wellpad’ is uitgezet. Maar even verderop komen de plekken waaronder cavernes zullen ontstaan, dichterbij."
                            },
                            {
                                "example_id": "81e76127-20f0-4140-9884-e65578c0548f",
                                "sense_id": "4b8a3113-7a49-3366-a868-3eef871015cb",
                                "text": "Rusland tekende vrijdagochtend alvast een voorlopige overeenkomst voor de bouw van een aardgasleiding door Griekenland."
                            }
                        ]
                    }
