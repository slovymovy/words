                    {
                        "sense_id": "9a108324-be82-39be-9946-9b0b01771b8f",
                        "entry_id": "77b47329-fb0e-30ab-a1d8-66d3a9f38f37",
                        "glosses": [
                            "Restes de consommation trouvés non transformés sur un site de fouille ou d'observation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18cead06-13b0-4dd8-898e-d079c5d75791",
                                "sense_id": "9a108324-be82-39be-9946-9b0b01771b8f",
                                "text": "Un macroreste d’une telle taille fut formé sur place et fournit une preuve directe de l’incidence d’un feu donné dans le site d’étude (Ohlson et Tryterud, 2000)."
                            },
                            {
                                "example_id": "93da6e39-40e4-4156-a367-451495a7d6f7",
                                "sense_id": "9a108324-be82-39be-9946-9b0b01771b8f",
                                "text": "Chez les végétaux fossiles, certains groupes, qualifiés de mégathermes (Van Steenis, 1962), sont inféodés au [climat tropical humide], et la présence de macrorestes ou de pollen attribuables à ces groupes implique un climat tropical humide."
                            },
                            {
                                "example_id": "359ea204-6cf3-41fb-806f-9994e942fcfe",
                                "sense_id": "9a108324-be82-39be-9946-9b0b01771b8f",
                                "text": "Les macrorestes végétaux comprennent des graines ingérées de fraises, de framboises, de concombre et de pois, de même que des noyaux d'amndes, d'olives, de cerises et des grains de café d'Arabie."
                            }
                        ]
                    }
