                        "entry_id": "d3341185-dabb-3c82-b6a3-fc049e97bfd5",
                        "glosses": [
                            "A magnet which attracts metals only when electrically activated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f2460d2-3a44-43e5-9f29-e08079921b38",
                                "sense_id": "393b0ea9-60ff-39dd-9e19-d7718e772a73",
                                "text": "Hold the electromagnet near something made of iron and push the switch (S2). […] Large electromagnets are used to move things around at factories and junkyards."
                            }
                        ]
                    }
                ],
