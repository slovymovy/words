                        "target_lang_word": "blood diamond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blood diamond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "829869b2-ccaa-395d-82b3-d4aa517b2d20",
                                        "entry_id": "12a7b5c1-fba3-3494-93c6-3c2a4078ccbd",
                                        "glosses": [
                                            "A diamond that has been mined in a war zone and sold to finance the conflict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277ff5a7-c354-4ec6-800d-9a01c8c6a80e",
                                                "sense_id": "829869b2-ccaa-395d-82b3-d4aa517b2d20",
                                                "text": "Several certification systems already exist throughout the world. The Kimberly Process certifies the origin of rough diamonds from areas that have conflict-free diamond production. The process aims to prevent “blood diamonds.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
