                "translations": [
                    {
                        "translation_id": "5e223c72-0e9b-4f9e-857d-50a917757619",
                        "source_entry_id": "ef4316ab-d490-3a5d-987c-c35e90ffd5de",
                        "target_lang_word": "subjectively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subjectively",
