                ],
                "senses": [
                    {
                        "sense_id": "424dce9b-0995-35bd-a582-902fef453372",
                        "entry_id": "288f8453-8833-3e5a-9828-0958038e6219",
                        "glosses": [
                            "Raum in einem vornehmen Haushalt, in den sich der Hausherr mit (männlichen) Freunden/Bekannten zurückziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c39037-ae20-4eca-926f-dbb371ff9c7f",
                                "sense_id": "424dce9b-0995-35bd-a582-902fef453372",
                                "text": "„Vor dem Bild Friedrichs des Großen, unter Geweihen und Gehörnen versammeln sich die Kandidaten der Flucht im Herrenzimmer.“"
                            },
                            {
                                "example_id": "88d86442-f69f-46ef-a3a4-82e322af14cb",
                                "sense_id": "424dce9b-0995-35bd-a582-902fef453372",
                                "text": "„Jadeflöte ging sie vergeblich im Herrenzimmer suchen.“"
                            },
                            {
                                "example_id": "eef5c382-d74d-4fe9-9c35-ca75dcf65ea6",
                                "sense_id": "424dce9b-0995-35bd-a582-902fef453372",
                                "text": "„Doch der Atem ging mir erst aus, als ich im Herrenzimmer neben dem Hausgang stand; lauter Bücher, vom Fußboden bis zur Decke, und ganz gleich, welches Buch ich herauszog, ich verstand nichts; gibt es Verbrechen, so ist es ein Verbrechen, ungebildet zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
