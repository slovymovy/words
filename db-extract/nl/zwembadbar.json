                        "examples": [
                            {
                                "example_id": "02188baa-c4c3-4262-9791-0abe7b41dbbc",
                                "sense_id": "a7cc0a69-b82f-39ca-993f-84df9751fb27",
                                "text": "Op vakantie. Even lekker niks aan je hoofd. Alleen maar zonnen, relaxen en zo min mogelijk beweging. En wat is er nog heerlijker dan vanaf je luchtbedje een cocktail te kunnen bestellen? Thedailymeal.com maakte een top van mooiste zwembadbarretjes."
                            },
                            {
                                "example_id": "ad373fd1-491b-448d-9c05-9c88642c0f24",
                                "sense_id": "a7cc0a69-b82f-39ca-993f-84df9751fb27",
                                "text": "Snorkelen in het kristalheldere water, luieren op het strand, cocktailtje drinken aan de zwembadbar… Je zou bijna vergeten dat er op Curaçao ook mensen zijn die keihard moeten werken. Zoals deze succesvolle Nederlandse vrouw!"
                            }
                        ]
