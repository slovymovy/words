                "senses": [
                    {
                        "sense_id": "1f7fe484-b9c5-31a9-98b3-cc5bf36ff5ff",
                        "entry_id": "3b55b1a5-07c0-3ce1-87e9-c8c2a22491f0",
                        "glosses": [
                            "Déconcentrer, retirer à quelque chose son caractère aggloméré."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1eb8393a-c29a-4d75-a157-961199c6463f",
                                "sense_id": "1f7fe484-b9c5-31a9-98b3-cc5bf36ff5ff",
                                "text": "A l'origine de ce phénomène se trouvent des facteurs sociaux — il prend la forme de migrations des villages vers les villes, migrations gratuites qui ne sont basées ni sur la nécessité de déglomérer les territoires surpeuplés, ni sur la demande de la main-d'oeuvre."
                            },
                            {
                                "example_id": "8c20caa5-d28f-4de8-aab6-f4c28db7801c",
                                "sense_id": "1f7fe484-b9c5-31a9-98b3-cc5bf36ff5ff",
                                "text": "Mais aujourd'hui on ne «conglomère» plus, on «déglomère» entend-on dire aux USA."
                            }
                        ]
                    }
                ],
