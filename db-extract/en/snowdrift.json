                                        "entry_id": "e7377cb5-db1f-3689-909d-c22c714981ce",
                                        "glosses": [
                                            "plaatselijke opeenhoping van sneeuw onder invloed van de wind in de vorm van een langgerekte bank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b574914-c864-4b32-a0ea-97a2cffdb8c7",
                                                "sense_id": "20852889-58e6-3962-aa2c-c5b819c6c867",
                                                "text": "⧖ De wind heeft een sneeuwbank dwars over den weg opgewaaid. De mannen uit het Armhuis hebben de bank doorgegraven, maar de bank is er nog altijd. Je loopt tusschen twee sneeuwmuren door over den weg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cda03027-706d-40fb-a282-dbd1dcb68bca",
