                        "translation_id": "8ada349f-74cd-4e23-96f9-0f148c46ae58",
                        "source_entry_id": "ccf2bc32-8655-3689-98fa-e617136bd651",
                        "source_sense_id": "52888be5-751f-3027-9e16-b388702692dd",
                        "source_sense_description": "weibliche Person, die von Optimismus erfüllt ist",
                        "target_lang_word": "optimiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optimiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1da423c7-6c81-31a3-b42e-a63c00ecef33",
                                        "entry_id": "4d61c522-fbf4-3513-aa16-f65a141d1e19",
                                        "glosses": [
                                            "Qui a rapport à l’optimisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc623ca-ca0f-4408-8aec-5e2168085e9c",
                                                "sense_id": "1da423c7-6c81-31a3-b42e-a63c00ecef33",
                                                "text": "Doctrine optimiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9442f5fe-75e1-39bd-a7b6-cd7be149d7d8",
                                        "entry_id": "4d61c522-fbf4-3513-aa16-f65a141d1e19",
                                        "glosses": [
                                            "Qui est disposé naturellement à trouver que tout est bien, que tout va bien, à être content de tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debfec7b-3f63-4dd4-a2e7-44e8f3ecdcaa",
                                                "sense_id": "9442f5fe-75e1-39bd-a7b6-cd7be149d7d8",
                                                "text": "Mais Renan avait été trop favorisé durant toute sa vie par la fortune, pour ne pas être optimiste ; il croyait donc que le mal se bornerait à l'obligation de traverser de mauvais jours, […]."
                                            },
                                            {
                                                "example_id": "f7f7cc74-a077-408d-a23a-f0689ac87afd",
                                                "sense_id": "9442f5fe-75e1-39bd-a7b6-cd7be149d7d8",
                                                "text": "Caractère optimiste. Point de vue optimiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bd9432-3276-3b54-ad5e-f217336bbc29",
                                        "entry_id": "4d61c522-fbf4-3513-aa16-f65a141d1e19",
                                        "glosses": [
                                            "Dont l'avenir est assuré et radieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb04b0bf-558e-4a85-9557-103d77ff4dcb",
                                                "sense_id": "51bd9432-3276-3b54-ad5e-f217336bbc29",
                                                "text": "Si le reste de l’Europe voit en cette probable victoire l’ombre d’un « Italexit », les Italiens, eux, préfèrent rester optimistes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "optimiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2e35b7-9b17-3074-9a75-0ca434a17804",
                                        "entry_id": "ce102156-b856-3752-98ed-542d8a2614f5",
                                        "glosses": [
                                            "Celui, celle qui est optimiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4ebd8c-149a-45ad-96ee-440a6af6a400",
                                                "sense_id": "8c2e35b7-9b17-3074-9a75-0ca434a17804",
                                                "text": "C’est un optimiste."
                                            },
                                            {
                                                "example_id": "9ce60e31-b19e-45f0-a807-7161f491de8e",
                                                "sense_id": "8c2e35b7-9b17-3074-9a75-0ca434a17804",
                                                "text": "L’optimiste actif que je prétends être déteste être pris de court, car le manque de temps réduit le champ des possibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
