                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le taux de chômage n'a que <w>faiblement</w> augmenté au cours du dernier trimestre."
                        },
                        {
                            "text": "Cette région est très <w>faiblement</w> peuplée en raison du climat rude de la montagne."
                        }
                    ],
                    "synonyms": [
                        "légèrement",
                        "modérément"
                    ],
                    "common_phrases": [
