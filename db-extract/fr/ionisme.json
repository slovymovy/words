                ],
                "senses": [
                    {
                        "sense_id": "b0d2522d-641f-392b-a38c-b9de3bfb4ce5",
                        "entry_id": "c2025050-6ff5-34e8-bfd9-792d25dc53d5",
                        "glosses": [
                            "Mot ou tournure propre au dialecte grec de la Ionie (celui d’Hérodote)."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "fa1d4c36-52c3-4e77-9aad-7b18b4f3f354",
                                "sense_id": "b0d2522d-641f-392b-a38c-b9de3bfb4ce5",
                                "text": "Il [le texte anonyme « Dissoi Logoi »] est écrit dans un dialecte dorien de l'Ouest, avec des traces de ionismes et peut-être même d’atticismes, dont la présence est difficile à interpréter."
                            }
                        ]
                    },
                    {
                        "sense_id": "696001cc-9887-38a5-bfa2-d22512583f6c",
                        "entry_id": "c2025050-6ff5-34e8-bfd9-792d25dc53d5",
                        "glosses": [
                            "Style caractéristique de l’architecture ionienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8525404e-a9c1-4b70-b6bb-3838053a3003",
                                "sense_id": "696001cc-9887-38a5-bfa2-d22512583f6c",
                                "text": "Satyros représentait l’ionisme parien, l’ionisme de l’Archipel, et il n’était pas tenu par les règles (?) appliquées en Asie Mineure."
                            }
                        ]
                    },
                    {
                        "sense_id": "a84bcfa4-22d9-3678-a4f3-63ffe45ab09d",
                        "entry_id": "c2025050-6ff5-34e8-bfd9-792d25dc53d5",
                        "glosses": [
                            "Ensemble des idées et des mœurs de la Ionie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c61ec2-ffec-4708-8fb8-b0b3c4de4b85",
                                "sense_id": "a84bcfa4-22d9-3678-a4f3-63ffe45ab09d",
                                "text": "Ce qu’il y a de plus hellénique en Grèce, c’est Athènes, la reine de la mer Egée, qui concentre en elle comme la substance de l’ionisme, et l’hellénisme cesse quand cesse le rôle actif d’Athènes."
                            }
                        ]
                    },
                    {
                        "sense_id": "218a916a-411e-3eb2-adfd-fe03f6fba38a",
                        "entry_id": "c2025050-6ff5-34e8-bfd9-792d25dc53d5",
                        "glosses": [
                            "Philosophie de l’Ècole ionienne (celle d’Héraclite et des Milésiens)."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "d4d57fc9-6e49-478f-832a-cd54e27d1896",
                                "sense_id": "218a916a-411e-3eb2-adfd-fe03f6fba38a",
                                "text": "Il [Jules Barthélemy-Saint-Hilaire] va jusqu’à accuser Aristote d’avoir, en contredisant son maître, rétrogradé vers le passé, d’avoir rebroussé chemin à peu près jusqu’à l’ionisme."
                            }
                        ]
                    }
                ],
