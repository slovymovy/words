{
    "word_family": [
        "головной",
        "головка",
        "головушка",
        "головёшка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bf0b354-4d96-3d57-a507-02caac1a46cb",
                    "sense_definition": "Верхняя часть тела человека или животного, где находятся органы чувств и рот.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него сильно разболелась <w>голова</w> после долгого рабочего дня.",
                            "target_lang_translations": {
                                "pl": "Mocno rozbolała go <w>głowa</w> po długim dniu pracy."
                            }
                        },
                        {
                            "text": "Маленький мальчик поднял <w>голову</w> и посмотрел на птицу в небе.",
                            "target_lang_translations": {
                                "pl": "Mały chłopiec podniósł <w>głowę</w> i spojrzał na ptaka na niebie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "болит голова",
                        "повернуть голову"
                    ],
                    "target_lang_definitions": {
                        "pl": "Górna część ciała człowieka lub przednia zwierzęcia, na której znajdują się narządy zmysłów i otwór gębowy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "część ciała"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a9a9fd6-9793-3a9c-ba80-ee9a3b962f01",
                    "sense_definition": "Ум, интеллект или способность мыслить.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Думай <w>головой</w>, прежде чем принимать такое важное решение!",
                            "target_lang_translations": {
                                "pl": "Myśl <w>głową</w>, zanim podejmiesz tak ważną decyzję!"
                            }
                        },
                        {
                            "text": "У него светлая <w>голова</w>, он быстро решает любые математические задачи.",
                            "target_lang_translations": {
                                "pl": "On ma tęgą <w>głowę</w>, szybko rozwiązuje wszelkie zadania matematyczne."
                            }
                        }
                    ],
                    "synonyms": [
                        "ум"
                    ],
                    "common_phrases": [
                        "думать головой",
                        "светлая голова",
                        "ломать голову"
                    ],
                    "target_lang_definitions": {
                        "pl": "Umysł, inteligencja, rozum lub zdolność logicznego myślenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "rozum, umysł"
                            },
                            {
                                "target_lang_word": "rozum",
                                "target_lang_sense_clarification": "intelekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baf63ff6-14e9-3199-afc1-c4b4e7020e97",
                    "sense_definition": "Волосы на голове человека, прическа.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она помыла <w>голову</w> перед тем, как пойти на вечеринку.",
                            "target_lang_translations": {
                                "pl": "Umyła <w>głowę</w> przed wyjściem na imprezę."
                            }
                        },
                        {
                            "text": "У него была аккуратно причёсанная <w>голова</w>.",
                            "target_lang_translations": {
                                "pl": "Miał starannie uczesaną <w>głowę</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "помыть голову"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Włosy na głowie człowieka, fryzura (często w odniesieniu do mycia lub czesania)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "włosy na głowie, np. myć głowę"
                            },
                            {
                                "target_lang_word": "włosy",
                                "target_lang_sense_clarification": "owłosienie na głowie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30e0075a-7ce5-3585-bef7-d717b345ce7e",
                    "sense_definition": "Передняя часть чего-либо движущегося или протяженного.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Колонна демонстрантов двигалась медленно, и <w>голова</w> её уже скрылась за поворотом.",
                            "target_lang_translations": {
                                "pl": "Kolumna demonstrantów poruszała się powoli, a jej <w>czoło</w> zniknęło już za zakrętem."
                            }
                        },
                        {
                            "text": "Наш отряд шёл в <w>голове</w> всей группы туристов.",
                            "target_lang_translations": {
                                "pl": "Nasz oddział szedł na <w>czele</w> całej grupy turystów."
                            }
                        }
                    ],
                    "antonyms": [
                        "хвост"
                    ],
                    "common_phrases": [
                        "в голове колонны"
                    ],
                    "target_lang_definitions": {
                        "pl": "Początkowa, przednia część czegoś poruszającego się lub wydłużonego, np. kolumny lub pochodu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czele",
                                "target_lang_sense_clarification": "przód kolumny, w wyrażeniu: na czele"
                            },
                            {
                                "target_lang_word": "początek",
                                "target_lang_sense_clarification": "przód grupy, pochodu"
                            },
                            {
                                "target_lang_word": "czoło",
                                "target_lang_sense_clarification": "przód kolumny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a0728e3-13e1-3845-b34b-6dcdf60c6344",
                    "sense_definition": "Единица счета для животных или скота.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "counting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ферме содержится более ста <w>голов</w> крупного рогатого скота.",
                            "target_lang_translations": {
                                "pl": "W gospodarstwie znajduje się ponad sto <w>sztuk</w> bydła."
                            }
                        },
                        {
                            "text": "Пастух пересчитал всех овец, получилось пятьдесят <w>голов</w>.",
                            "target_lang_translations": {
                                "pl": "Pasterz przeliczył wszystkie owce, wyszło pięćdziesiąt <w>sztuk</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Jednostka przeliczeniowa dla zwierząt hodowlanych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sztuka",
                                "target_lang_sense_clarification": "jednostka liczenia bydła i trzody"
                            },
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "sztuka bydła, rzadziej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fdb0bc0-c3af-3d76-aa08-ebb9640bf023",
                    "sense_definition": "Руководитель, начальник или главный человек в группе.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Городской <w>голова</w> выступил с речью на открытии новой площади.",
                            "target_lang_translations": {
                                "pl": "<w>Burmistrz</w> miasta wygłosił przemówienie na otwarciu nowego placu."
                            }
                        },
                        {
                            "text": "Он сам себе <w>голова</w> и не любит слушать чужих советов.",
                            "target_lang_translations": {
                                "pl": "On jest sam sobie <w>panem</w> i nie lubi słuchać cudzych rad."
                            }
                        }
                    ],
                    "synonyms": [
                        "глава"
                    ],
                    "common_phrases": [
                        "городской голова",
                        "сам себе голова"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przywódca, przewodniczący lub zwierzchnik grupy, miasta itp."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "przywódca, głowa rodziny lub państwa"
                            },
                            {
                                "target_lang_word": "burmistrz",
                                "target_lang_sense_clarification": "zwierzchnik miasta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9abd8ce4-79b1-3746-b643-f0bf3e0a7d8a",
                    "sense_definition": "Большой кусок продукта шарообразной формы, например сыра или сахара.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе лежала огромная <w>голова</w> сыра, привезённая из деревни.",
                            "target_lang_translations": {
                                "pl": "Na stole leżał ogromny <w>krąg</w> sera, przywieziony ze wsi."
                            }
                        },
                        {
                            "text": "Раньше сахар часто продавали в виде твёрдой <w>головы</w>.",
                            "target_lang_translations": {
                                "pl": "Kiedyś cukier często sprzedawano w postaci twardej <w>głowy</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "голова сыра",
                        "сахарная голова"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Duża bryła artykułu spożywczego w kształcie stożka lub kuli, zazwyczaj sera lub cukru."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowa",
                                "target_lang_sense_clarification": "np. głowa cukru"
                            },
                            {
                                "target_lang_word": "krąg",
                                "target_lang_sense_clarification": "okrągły blok, zwłaszcza sera"
                            },
                            {
                                "target_lang_word": "główka",
                                "target_lang_sense_clarification": "bryła sera, kapusty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}