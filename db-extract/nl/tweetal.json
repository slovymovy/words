                    },
                    {
                        "translation_id": "ef85fc18-3a66-4702-8722-159f685aefa6",
                        "source_entry_id": "29fda851-0e1a-3aad-8f90-be7bb6b9a7e0",
                        "source_sense_id": "92686744-fe1a-36a5-8674-4acad9ba0974",
                        "source_sense_description": "een groep van twee",
                        "target_lang_word": "Gespann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gespann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "392c2c3a-f6a4-3ee5-b89b-a8eb4e2a9eae",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "mehrere mittels eines Geschirrs miteinander verbundene Zugtiere (etwa Pferde, Ochsen oder Hunde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6607a8b2-7aff-40c8-807c-40c55135b574",
                                                "sense_id": "392c2c3a-f6a4-3ee5-b89b-a8eb4e2a9eae",
                                                "text": "„In rasantem Galopp dirigiert Attila sein Gespann aus fünf Pferden, während er auf den beiden hinteren Pferden steht.“"
                                            },
                                            {
                                                "example_id": "0213933a-be58-41a9-9fb5-6f75fbb86214",
                                                "sense_id": "392c2c3a-f6a4-3ee5-b89b-a8eb4e2a9eae",
                                                "text": "Als das Tagesziel erreicht war, beauftragte Elmar den jungen Okko damit, das Gespann auszuschirren."
                                            },
                                            {
                                                "example_id": "d3eb44c6-abca-45c4-ac0f-0a0c77b4b275",
                                                "sense_id": "392c2c3a-f6a4-3ee5-b89b-a8eb4e2a9eae",
                                                "text": "„Manche irren schon seit Wochen umher, ihre Gespanne sind müde und lahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fb2fb07-e21c-39b8-80d0-72494bfbbb9b",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "eine Einheit, bestehend aus einem Gespann^([1]) und einer angespannten Last (z.B. Kutsche, Egge oder Schlitten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60aefc87-50b7-4998-b5a7-289378c668af",
                                                "sense_id": "1fb2fb07-e21c-39b8-80d0-72494bfbbb9b",
                                                "text": "Bei dem Turnier waren auch mehrere Gespanne am Start."
                                            },
                                            {
                                                "example_id": "75ec4eb9-2e93-4c3d-950d-7d00c97eb6cf",
                                                "sense_id": "1fb2fb07-e21c-39b8-80d0-72494bfbbb9b",
                                                "text": "„Auf dem Turnier in Essen/Oldenburg konnte Vahle mit seinem ‚Groom‘, dem Mitfahrer auf dem Gespann, Alexander Dajde, die Konkurrenz hinter sich lassen.“"
                                            },
                                            {
                                                "example_id": "93b1ffd5-3d52-4456-b4bc-831cbd9e8003",
                                                "sense_id": "1fb2fb07-e21c-39b8-80d0-72494bfbbb9b",
                                                "text": "„Die großen Gespanne fuhren in den Hof ein, und die Fohlen wieherten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc1cd84d-aa70-30f8-bc73-b3907a9a8a95",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "Verbindung aus mehreren Landfahrzeugen mit mindestens einem Zugfahrzeug. Meistens wird das Gespann aus einem Zugfahrzeug und einem Anhänger gebildet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af3b434-7938-48cf-b674-b0e45f9b99a2",
                                                "sense_id": "dc1cd84d-aa70-30f8-bc73-b3907a9a8a95",
                                                "text": "Das verunfallte Gespann bestand aus zwei Zugfahrzeugen und einem Anhänger."
                                            },
                                            {
                                                "example_id": "fb11aeef-0238-4e03-972e-80223c5f263f",
                                                "sense_id": "dc1cd84d-aa70-30f8-bc73-b3907a9a8a95",
                                                "text": "„Ein Gespann aus LKW und Anhänger war in Brand geraten.“"
                                            },
                                            {
                                                "example_id": "e20d55c8-28e2-48ef-8d68-fc99133dac38",
                                                "sense_id": "dc1cd84d-aa70-30f8-bc73-b3907a9a8a95",
                                                "text": "„Als der 24-jährige Fahrer eines sogenannten Sprinters von der Berliner Straße auf die Landstraße abbog, übersah er eine 33-jährige Autofahrerin, die gerade dabei war, dort ein ortsauswärts in Richtung B74 fahrendes landwirtschaftliches Gespann, bestehend aus einem Traktor und zwei Anhängern, zu überholen.“"
                                            },
                                            {
                                                "example_id": "f62578c3-f823-4293-a556-8afd342bec2e",
                                                "sense_id": "dc1cd84d-aa70-30f8-bc73-b3907a9a8a95",
                                                "text": "„Auf der linken Fahrspur der Höllentalstrecke, unweit vom Hofgut Sternen, kam das aus einem Geländewagen mit Anhänger bestehende Gespann ins Schlingern und kippte um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6a128df2-ae26-310f-a407-37b29cd9bc9c",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "zwei Personen, die in einer bestimmten Weise zusammengehören oder zusammenwirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c883bd6-f2ae-4aec-97d8-63b062642ef9",
                                                "sense_id": "6a128df2-ae26-310f-a407-37b29cd9bc9c",
                                                "text": "Bei der Bewältigung des alljährlichen Touristenansturms auf das Hotel ihrer Eltern bilden die Brüder Hansi und Holger schon lange ein gutes Gespann."
                                            },
                                            {
                                                "example_id": "82024cb0-506e-444e-803d-fe152470b4be",
                                                "sense_id": "6a128df2-ae26-310f-a407-37b29cd9bc9c",
                                                "text": "Nachdem sich das Gespann aus Ulf und Ingo beim Unterhaltungsprogramm des Dorffestes im letzten Jahr bewährt hatte, kamen die beiden auch in diesem Jahr wieder zum Einsatz."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c1a410da-ed71-3415-8321-85e823803bc9",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "Lattengerüst"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e63a7c-74b5-4bf9-bc99-e14469d698dd",
                                                "sense_id": "c1a410da-ed71-3415-8321-85e823803bc9",
                                                "text": "Das Gespann zeigt an, wie groß der fertige Bau werden soll."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c6a75d9c-63f7-36e0-80e2-de4f111e1eae",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "diejenige Ackerfläche, die mit einem Gespann^([1]) während eines halben Tages bearbeitet werden kann"
                                        ],
                                        "tags": [
                                            "Oberlausitz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b4f7e9a-fa3d-4f6f-a6ef-b04dad38f680",
                                                "sense_id": "c6a75d9c-63f7-36e0-80e2-de4f111e1eae",
                                                "text": "Heute hat Ignaz ein ganzes Gespann gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "881a9aa6-792f-39ad-8ee9-13f0c4799496",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "aus einem vier- oder mehreckigen Holzrahmen bestehender Teil des Grubenausbaus"
                                        ],
                                        "tags": [
                                            "Bergmannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eac4fae-1eaf-4d37-bc66-f0d914a65892",
                                                "sense_id": "881a9aa6-792f-39ad-8ee9-13f0c4799496",
                                                "text": "Für ein Gespann brauchte man durchschnittlich 35 Pfähle."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "a0bebc5e-0a85-3d82-8367-621bbaaafec1",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "zehn bis 18 runde kupferne Scheiben oder Schalen, die unter dem Tiefhammer zur gleichen Zeit ausgetieft werden"
                                        ],
                                        "tags": [
                                            "Hüttenwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f132e950-8202-4fcf-be5f-49f36f1db921",
                                                "sense_id": "a0bebc5e-0a85-3d82-8367-621bbaaafec1",
                                                "text": "„Das Gespann wird warm gemacht, und sogleich auf den Ambos unter dem Tiefhammer gebracht. Diesen läßt man zuerst auf die Mitte fallen; alsdenn aber drehet der Arbeiter das Gespann dergestalt, daß vom Mittel an, nach der Peripherie zu, eine Schneckenlinie durch die Schläge beschrieben wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "4ab8e083-7810-3cff-aa31-332200013084",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "Maulsperre, Mundklemme"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6339b442-543e-47fc-aa58-fdc507fbec44",
                                                "sense_id": "4ab8e083-7810-3cff-aa31-332200013084",
                                                "text": "Er litt am Gespann, bis er eine Backpfeife bekam."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "39e0b0b1-2236-36c3-a198-cf0bcae56ed2",
                                        "entry_id": "3c3a3106-e6b8-3a99-a659-6eee07c982f9",
                                        "glosses": [
                                            "Beklemmung des Herzens"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a4ab0a4-c779-464e-a0dd-dec6144b5ef3",
                                                "sense_id": "39e0b0b1-2236-36c3-a198-cf0bcae56ed2",
                                                "text": "Pflanze und Beschwerde: „Im deutschen Wort Herzgespann werden die zu behandelnden Beschwerden: ‚Spannen – Krämpfe des Herzens‘ deutlich zum Ausdruck gebracht. Als Volksnamen sind Löwenschwanz, Herzheil, Herzkraut […] bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    }
