    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4ca6abe1-ff31-3806-9192-9ab218d13433",
                "word": "collywobbles",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "949728ca-541e-4499-be39-8b17e050d3fe",
                        "entry_id": "4ca6abe1-ff31-3806-9192-9ab218d13433",
                        "tags": [
                            "canonical",
                            "plural"
                        ],
                        "form": "the collywobbles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                        "entry_id": "4ca6abe1-ff31-3806-9192-9ab218d13433",
                        "glosses": [
                            "A stomach ache or an upset stomach."
                        ],
                        "tags": [
                            "British",
                            "humorous",
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "a5630dfd-db87-4514-b7c3-a68a31da163c",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "Collywobbles, the gripes."
                            },
                            {
                                "example_id": "75df10ce-f133-4de0-998f-fc1f5fbaefc2",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "Petunia’s off school today with a touch of the collywobbles."
                            },
                            {
                                "example_id": "c76024f2-dac9-4215-8a85-c5508a8cecf6",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "I know I have something else to say to you, but unfortunately I awoke this morning with collywobbles, and had to take a small dose of laudanum with the usual consequences of dry throat, intoxicated legs, partial madness and total imbecility; and for the life of me I cannot remember what it is."
                            },
                            {
                                "example_id": "bcf90f56-801b-4219-854b-6b51910a8193",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "\"I deeply regret,\" answered Liza, \"but my royal 'ighness 'as got the collywobbles.\""
                            },
                            {
                                "example_id": "676007d6-7a21-4b38-a2ee-76dc8388fc2b",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "The prefect was there again and it was his voice that was saying that he was to get up, that Father Minister had said he was to get up and dress and go to the infirmary. And while he was dressing himself as quickly as he could the prefect said: / ― We must pack off to Brother Michael because we have the collywobbles!"
                            },
                            {
                                "example_id": "d8386eb9-b9aa-4209-a0b1-3b581eb63269",
                                "sense_id": "1b2745a2-7586-3567-bd60-1d78969e182e",
                                "text": "\"D'ye hear, Richard? Now's your chance,\" repeated Ned, not to be done. \"There's a pot o' money in it. A very different thing this, I can tell you, from running round dosing people for the collywobbles. I know men who are raising the splosh to get in, any way they can.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "660685c8-a3ef-339b-8984-679d9c063974",
                        "entry_id": "4ca6abe1-ff31-3806-9192-9ab218d13433",
                        "glosses": [
                            "Anxiety, fear, uneasiness."
                        ],
                        "tags": [
                            "British",
                            "broadly",
                            "humorous",
                            "informal",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "a4380632-ca67-421a-bd65-dcfdb43cf3c7",
                                "sense_id": "660685c8-a3ef-339b-8984-679d9c063974",
                                "text": "I don’t like walking through the forest at night. It gives me the collywobbles."
                            },
                            {
                                "example_id": "f6b89c47-b8eb-4746-acee-c06619d281e7",
                                "sense_id": "660685c8-a3ef-339b-8984-679d9c063974",
                                "text": "This business of getting Bill educated has just about given me the collywobbles. You wouldn't think to look at the boy, that he could possibly be such a tragic misfit in school."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d36b7183-b0a1-4e7b-8ff4-982913feca79",
                        "source_entry_id": "4ca6abe1-ff31-3806-9192-9ab218d13433",
                        "source_sense_description": "(informal, chiefly humorous) anxiety, fear, uneasiness",
