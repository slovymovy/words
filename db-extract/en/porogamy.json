                "senses": [
                    {
                        "sense_id": "f89b30f9-6f1c-306c-b5cf-a3d940981899",
                        "entry_id": "0f53b661-2554-3b54-ae4f-24776b3db687",
                        "glosses": [
                            "The property of having the pollen tube in a seed plant enter the ovule by way of the micropyle."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "40a611a7-e0d0-4664-873b-754478e7545b",
                                "sense_id": "f89b30f9-6f1c-306c-b5cf-a3d940981899",
                                "text": "The subject of Chalazogamy in Casuarina was discussed somewhat in detail, the speaker taking exception to Nawaschin's theory that Chalazogamy is a primitive type of fecundation from which porogamy has been developed."
                            },
                            {
                                "example_id": "c474c81e-d96c-46e5-9ecf-4d02844d1e71",
                                "sense_id": "f89b30f9-6f1c-306c-b5cf-a3d940981899",
                                "text": "No statistical records are presently available about the plants showing porogamy, chalazogamy or mesogamy, in angiosperms."
                            },
                            {
                                "example_id": "ce387544-9695-462e-9284-219a0da37fa5",
                                "sense_id": "f89b30f9-6f1c-306c-b5cf-a3d940981899",
                                "text": "The pollen tube may enter the ovule either via the chalaza (chalazogamy) (Billings 1903) or via the micropyle (porogamy) (Woodroof 1928)."
                            }
                        ]
                    }
