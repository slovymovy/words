                    {
                        "sense_id": "ab1e8d54-e5a7-361a-8e6b-2d59a815ad1f",
                        "entry_id": "b71c3005-c562-312e-9c1e-449c52486f5b",
                        "glosses": [
                            "To groan about; bewail; groan at."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f13c904c-8160-4ea3-bccd-aac735bd7aef",
                                "sense_id": "ab1e8d54-e5a7-361a-8e6b-2d59a815ad1f",
                                "text": "And, why dost thou oft begroan in sorrow Then other times, bid wisdom good morrow?"
                            },
                            {
                                "example_id": "9048e55b-741e-4b51-858f-07f3501741d3",
                                "sense_id": "ab1e8d54-e5a7-361a-8e6b-2d59a815ad1f",
                                "text": "For these deeds' sake do I begroan thy fate."
                            },
                            {
                                "example_id": "a5270aa3-f469-425d-b844-d2b9353ea69a",
                                "sense_id": "ab1e8d54-e5a7-361a-8e6b-2d59a815ad1f",
                                "text": "Yo, guys, I hate to break it to you: It's your own misbegotten will, your dumb choices, your desire to bemoan and begroan your terrible, miserable, luckless fate […] that put you into harm's way."
                            }
                        ]
                    }
