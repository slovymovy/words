                "senses": [
                    {
                        "sense_id": "2451f1ab-c2dd-3df3-85a1-1608c3437bf9",
                        "entry_id": "be5f20f8-0dc8-3694-8e3e-06b368cf5628",
                        "glosses": [
                            "Stock, auf den man sich beim Wandern stützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a1bc0a-986b-454f-992e-4ce99ea879a4",
                                "sense_id": "2451f1ab-c2dd-3df3-85a1-1608c3437bf9",
                                "text": "„Der Guide hatte mir einen Wanderstock geschnitzt, auf den ich mich immer häufiger, pustend und schwitzend, stützen musste, dann ›Pole, pole‹ ausstieß.“"
                            },
                            {
                                "example_id": "b19b5e93-225b-497c-83d6-a78fef574591",
                                "sense_id": "2451f1ab-c2dd-3df3-85a1-1608c3437bf9",
                                "text": "„Mit zwei Wanderstöcken in den Fäusten spaziert sie an einem Sommertag im Jahr 2020 bedächtig über grüne Almen zur Wallfahrtskapelle Maria Birkenstein.“"
                            },
                            {
                                "example_id": "d668894c-705a-4805-9ac8-546f9bf4691d",
                                "sense_id": "2451f1ab-c2dd-3df3-85a1-1608c3437bf9",
                                "text": "„Dann wurde Robert zu den nächsten Ständen abgedrängt, wo er schließlich gegen einen weiteren Abschnitt seiner Kaufkarte einen kräftigen Wanderstock erwarb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
