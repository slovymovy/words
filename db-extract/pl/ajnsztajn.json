                                                "sense_id": "95ef7daa-4b02-30e2-8406-02df824830cc",
                                                "text": "Bei vollständiger Ausbeute des einfallenden Sonnenlichtes […] werden zur Produktion eines Mol Sauerstoff 8 Einstein benötigt, d. h. acht Photonen pro Molekül."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
