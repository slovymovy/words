                                            {
                                                "example_id": "c352102e-4c83-4b41-a27d-ee2150dee3df",
                                                "sense_id": "923af5e4-d251-36ab-a0b9-c47b653c1587",
                                                "text": "Il prononça une formule magique et lança ainsi un sort à la petite graine qui se transforma en gentil dragon."
                                            },
                                            {
                                                "example_id": "19fd6e2e-6ce1-44b1-ae6e-259e44245a9e",
                                                "sense_id": "923af5e4-d251-36ab-a0b9-c47b653c1587",
                                                "text": "Mais quand je songe à « A wop/Bop a loo bop/A lop/Bam boom » la scansion onomatopéique qui ouvre le célèbre Tutti Frutti de Little Richard, je ne peux m’empêcher d’y voir une formule magique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1432b57-b306-3a17-8852-d7f61af58819",
                                        "entry_id": "a067a5d6-b751-3f37-a7d8-1c707e58d262",
                                        "glosses": [
                                            "Solution miracle, solution à un problème insoluble."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bd8cbf-2574-4dc5-8e96-8d175ffa613c",
                                                "sense_id": "d1432b57-b306-3a17-8852-d7f61af58819",
                                                "text": "J’aimerais bien connaître la formule magique pour faire baisser le chômage, mais elle n’existe pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc64d560-37b1-315b-baae-cc8ace905634",
                                        "entry_id": "a067a5d6-b751-3f37-a7d8-1c707e58d262",
                                        "glosses": [
                                            "Règle tacite réglant la répartition, entre les principaux partis politiques du pays, des sièges au Conseil fédéral de la Confédération suisse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b3fc23-35b6-4256-9eab-3e287fb9a5a8",
                                                "sense_id": "fc64d560-37b1-315b-baae-cc8ace905634",
                                                "text": "Le Conseil fédéral est élu par l’Assemblée fédérale selon des règles strictes (la fameuse « formule magique »)."
                                            },
                                            {
                                                "example_id": "16bfbb8a-f726-49ee-8b6e-0987f054f9ea",
                                                "sense_id": "fc64d560-37b1-315b-baae-cc8ace905634",
                                                "text": "Cette politique du consensus se reflète au niveau de l’exécutif fédéral dans ce que l’on a appelé la « formule magique ». Le Conseil fédéral – sept membres élus par l'Assemblée fédérale – est à partir de 1959 composé de deux radicaux, deux démocrates chrétiens, deux socialistes et un agrarien (Union démocratique du centre)"
                                            },
                                            {
                                                "example_id": "efec7478-35a6-4aa3-b780-dd3d55922792",
                                                "sense_id": "fc64d560-37b1-315b-baae-cc8ace905634",
                                                "text": "La formule magique doit être repensée, estiment la majorité des journaux suisses au lendemain de l’échec des Verts à entrer au Conseil fédéral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24f891c9-ba2a-44a6-97a6-1558020caae7",
                        "source_entry_id": "93e71e08-8201-3c64-8d70-48a7c25e56cb",
                        "source_sense_id": "4085feba-0453-3501-87a5-8b2301ad1e0d",
                        "source_sense_description": "umgangssprachlich, allgemein: ein Wort, das eine besondere Wirkung hervorrufen soll",
                        "target_lang_word": "magic word",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magic word",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d22cc82d-bae6-3cd7-b76c-12c10769f77b",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "Any word that has a magical effect when uttered."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "One of the words please, thank you, or hello."
                                        ],
                                        "tags": [
                                            "in teaching or training polite words to children"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c26bfff-e881-49c8-a569-1b1dac1bd625",
                                                "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                                "text": "If you learn to use magic words when you are little, it would be easy in your adulthood."
                                            },
                                            {
                                                "example_id": "0fdc95f2-902b-421b-9d90-511d3af42a1a",
                                                "sense_id": "fbb862e6-9619-3fe4-83ba-927e0c47b528",
                                                "text": "What's the magic word?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7175e7-472a-35ac-9484-0b467d5d59f3",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "Any word that is considered very significant in a certain situation or context."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b624cb-6865-46eb-9fde-7af88b19a5c1",
                                                "sense_id": "3b7175e7-472a-35ac-9484-0b467d5d59f3",
                                                "text": "When someone offers you drugs, the magic word is \"no\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                        "entry_id": "071fe53d-7c48-3aff-ba45-da7760cc1bcc",
                                        "glosses": [
                                            "A string of text having some special function or purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b628f68-2e92-40fa-b98a-f115f31dee3a",
                                                "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                                "text": "One of the magic words used in the MediaWiki software is __NOTOC__, which hides the table of contents that would normally be on the page."
                                            },
                                            {
                                                "example_id": "06bba8ae-0bf0-4805-a799-57ecb4f38f8b",
                                                "sense_id": "5727269d-4136-3ae4-b107-919aae427382",
                                                "text": "The header consists of an optional self-execution script, a magic word, a version number, and the word offset of the first instruction, relative to the magic word."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
