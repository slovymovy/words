                        "entry_id": "17212ce9-bcc4-3618-970d-1dce08af9ca6",
                        "glosses": [
                            "почувствовать сильное нерасположение, неприязнь к кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb818a2-7151-4945-8813-eaad3e3d1b6e",
                                "sense_id": "66f8108c-7800-3ffe-b685-779386769e66",
                                "text": "Почему его невзлюбили?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6f8b7ec-2b14-4fc1-9f89-0debc196b62f",
                        "source_entry_id": "17212ce9-bcc4-3618-970d-1dce08af9ca6",
                        "source_sense_id": "66f8108c-7800-3ffe-b685-779386769e66",
                        "target_lang_word": "dislike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dislike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b4fe8e7-b419-32f2-839d-bc511cc30b8e",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "An attitude or a feeling of distaste or aversion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2285807-8523-4cad-82fa-d4f1c6ca1394",
                                                "sense_id": "2b4fe8e7-b419-32f2-839d-bc511cc30b8e",
                                                "text": "In deference to Queen Victoria's dislike of high speed, the specials were allowed about 75 min. for the journey on the Deeside line, but after her death, they were slightly accelerated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e38d20-5cb6-34fe-8ac5-5bf6a3c2c2ae",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "Something that a person dislikes (has or feels aversion to)."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507a8379-684a-4f7a-870c-aee659d993fd",
                                                "sense_id": "a9e38d20-5cb6-34fe-8ac5-5bf6a3c2c2ae",
                                                "text": "Tell me your likes and dislikes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2cdcd2e-d670-3f42-ab71-dfbea16aac4b",
                                        "entry_id": "2a611033-b4c8-3684-911e-25e7f68b0d79",
                                        "glosses": [
                                            "An individual vote showing disapproval of, or lack of support for, something posted on the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dislike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cadbeef8-a34b-3830-8425-7b2b4ae135d5",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To displease; to offend. In third-person only."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969103ac-afc0-4c5e-ba58-92d7bb149ba8",
                                                "sense_id": "cadbeef8-a34b-3830-8425-7b2b4ae135d5",
                                                "text": "customes and conceipts differing from mine, doe not so much dislike [translating desplaisent] me, as instruct me[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f198308b-3350-34a7-a24c-f417c4b79454",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To have a feeling of aversion or antipathy towards; not to like."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bbff42-12c4-4a4c-b493-45de8acc94fc",
                                                "sense_id": "f198308b-3350-34a7-a24c-f417c4b79454",
                                                "text": "In the thick of the railway controversies of his day, Francis naturally had his prejudices. It seems that he cordially disliked the aristocracy in general."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aec5133-51c2-3d63-91aa-c84e88492715",
                                        "entry_id": "accabc0b-51f4-325a-bd8b-58fc91a563b8",
                                        "glosses": [
                                            "To leave a vote to show disapproval of, or lack of support for, something posted on the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e05e9f-9320-408d-9628-81732098cc65",
                                                "sense_id": "1aec5133-51c2-3d63-91aa-c84e88492715",
                                                "text": "Rebecca Black's \"Friday\" video has gained notoriety for being one of the most disliked videos in YouTube history."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
