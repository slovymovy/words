                    {
                        "sense_id": "8632e9d5-2465-3634-aa47-b009d329d6dc",
                        "entry_id": "562fba31-7951-3059-bcc1-bdd7466210c9",
                        "glosses": [
                            "Prügel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f415e9bd-9b7d-413c-882d-65707cb38f9e",
                                "sense_id": "8632e9d5-2465-3634-aa47-b009d329d6dc",
                                "text": "Für das, was er getan hat, verdient er richtig Dresche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d62afb94-f4e5-4d03-929e-e41170b3ab62",
                        "source_entry_id": "562fba31-7951-3059-bcc1-bdd7466210c9",
                        "source_sense_id": "8632e9d5-2465-3634-aa47-b009d329d6dc",
                        "source_sense_description": "umgangssprachlich: Prügel",
                        "target_lang_word": "larrup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "larrup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfa6c20-6d70-3d19-b163-25b04fa06e7d",
                                        "entry_id": "dcba33eb-7f46-31fc-9b75-82c4d4f205b7",
                                        "glosses": [
                                            "To beat or thrash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b695c0eb-3deb-4805-bd80-24ad1628c744",
                                                "sense_id": "1cfa6c20-6d70-3d19-b163-25b04fa06e7d",
                                                "text": "ZOE-FANNY: I let him larrup it into me for the fun of it."
                                            },
                                            {
                                                "example_id": "6510d8c2-a11b-4bec-8a1a-e52317ce9cec",
                                                "sense_id": "1cfa6c20-6d70-3d19-b163-25b04fa06e7d",
                                                "text": "‘A kid like that oughtn’t to be mixed up with things,’ Ida said. ‘If he was mine I’d just larrup it out of him.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "larrup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d226a5-d859-3b47-92fe-ba15864bedb8",
                                        "entry_id": "df2ef29a-617f-3717-8a55-c9e828643bf4",
                                        "glosses": [
                                            "A blow or smack."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11377c25-197c-49a6-981f-cd85c05afe3c",
                                                "sense_id": "c3d226a5-d859-3b47-92fe-ba15864bedb8",
                                                "text": "That way, you got the perfect four-in-one gauge every time. If you were caught doing it any other way, you got a larrup round the lughole or a kick up the khyber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c7c59b-384f-367b-b54f-f7785079cc13",
                                        "entry_id": "df2ef29a-617f-3717-8a55-c9e828643bf4",
                                        "glosses": [
                                            "backchat or rudeness"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf61b37d-96db-4eaa-9d34-8ec64f1e4815",
                                                "sense_id": "d1c7c59b-384f-367b-b54f-f7785079cc13",
                                                "text": "Oi, less of your larrup!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
