            {
                "entry_id": "37e11644-294e-371b-9f0c-47bc7ead8eb4",
                "word": "rotte",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b8f2d427-4ed8-36dc-b1d2-5b1da032d219",
                        "entry_id": "37e11644-294e-371b-9f0c-47bc7ead8eb4",
                        "glosses": [
                            "een groep wilde zwijnen geleid door een matriarch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583677b5-5204-424f-b1e2-520dd31620d4",
                                "sense_id": "b8f2d427-4ed8-36dc-b1d2-5b1da032d219",
                                "text": "⧖ Er vielen eenige schoten bij den stamhouder, zooals later bleek, missers op een rotte zwijnen en eenige rake kogels op een tweetal varkens bij de andere schutters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66fa6010-a708-4383-99f2-68ba3f022a19",
                        "source_entry_id": "37e11644-294e-371b-9f0c-47bc7ead8eb4",
                        "source_sense_id": "b8f2d427-4ed8-36dc-b1d2-5b1da032d219",
                        "target_lang_word": "Rotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ce71401-6de1-39d7-af6d-38f8fd4036d1",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "ein mittelalterliches Saiteninstrument"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8bf6ab0-dd91-4266-8ce8-17fd35619265",
                                                "sense_id": "0ce71401-6de1-39d7-af6d-38f8fd4036d1",
                                                "text": "„Steger hat in seinem Buch Philologia Musica aufgrund des Bildmaterials die Rotte als „Harfenzither\" identifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f4373b04-77b6-3f90-9f4d-12e14929e667",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "eine kleinere, ungeordnete Gruppe von Menschen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a14e230-baec-4b32-a2de-ee6f5c9fa367",
                                                "sense_id": "f4373b04-77b6-3f90-9f4d-12e14929e667",
                                                "text": "Eine Rotte von Fußballfans fiel in die Kneipe ein."
                                            },
                                            {
                                                "example_id": "8c34216f-282a-4d24-83b6-83996accd08d",
                                                "sense_id": "f4373b04-77b6-3f90-9f4d-12e14929e667",
                                                "text": "„Es war schon gegen Abend, als die letzten vom Thing heimwärts ritten, in kleinen Rotten, eine jegliche nach ihrer Richtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b37e0964-8099-34da-84f7-95e8f2ba1680",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "ein kleiner Verband, zwei gemeinsam im Einsatz stehende Flugzeuge oder Schiffe, eine Untereinheit eines Landsknechtsheeres mehrere hintereinanderstehende Soldaten"
                                        ],
                                        "tags": [
                                            "früher auch",
                                            "oder lediglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f96c30-bcef-4501-8c14-063078e8f180",
                                                "sense_id": "b37e0964-8099-34da-84f7-95e8f2ba1680",
                                                "text": "„Eine Rotte gebrauchter Jets könnte sofort günstig erworben werden, und 2005, wenn die heimische Budget-Lage nicht mehr so angespannt sein soll, würde eine zweite Rotte neuer Hieger eingekauft.“"
                                            },
                                            {
                                                "example_id": "c439be10-6b41-418c-867f-24c7cfb8c7b2",
                                                "sense_id": "b37e0964-8099-34da-84f7-95e8f2ba1680",
                                                "text": "„Aus Rotten setzt sich das Fähnlein zusammen, die in sozialer wie symbolischer Hinsicht wichtigste militärische Einheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "303851b7-08df-3a40-bc4d-3c33080c93a4",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "eine Gruppe von Wildschweinen oder Wölfen"
                                        ],
                                        "tags": [
                                            "jägersprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3517ec-7eee-4d54-9abb-461c2ef38e90",
                                                "sense_id": "303851b7-08df-3a40-bc4d-3c33080c93a4",
                                                "text": "Eine Rotte Wildschweine wechselt über die Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a2eab737-e2c0-3a55-9802-b520ed165fd4",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "eine Gruppe von Gleisbauarbeitern oder von Holzfällern"
                                        ],
                                        "tags": [
                                            "Eisenbahn",
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac519eb-a40b-4f89-8e55-de0e35cfce75",
                                                "sense_id": "a2eab737-e2c0-3a55-9802-b520ed165fd4",
                                                "text": "„Man theilt die Arbeiter in Rotten von acht bis zehn Mann, wo dann jeder Rotte ein Rottenmeister vorsteht.“ (1845)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1d9f3789-fb3a-3c10-9579-88afbb86daa9",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "eine Siedlung aus wenigen Häusern, die verstreut liegen"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1389a47-53e1-404d-937c-e85de431aef3",
                                                "sense_id": "1d9f3789-fb3a-3c10-9579-88afbb86daa9",
                                                "text": "Das einzelnstehende Haus ist zur Rotte Purach gehörig."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "0d2db7a2-a771-3a34-9dbf-e8d85a613896",
                                        "entry_id": "cf0dde38-9424-35dc-a500-f95425dd9532",
                                        "glosses": [
                                            "das Verrotten"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbb10b6-15d6-4acf-bb6e-21ec4e89d7ed",
                                                "sense_id": "0d2db7a2-a771-3a34-9dbf-e8d85a613896",
                                                "text": "„Im richtig aufgebauten Komposthaufen gibt es keine Fäulnis, sondern eine durch die Tätigkeit unzähliger Lebewesen bewirkte Rotte, weshalb der Haufen auch absolut nicht stinkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
