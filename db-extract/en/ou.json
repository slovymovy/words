                        ],
                        "examples": [
                            {
                                "example_id": "4bcc4f14-f737-4787-b08b-66e2aa2b3a92",
                                "sense_id": "f6711228-7e00-3d82-82db-76fd6eb52489",
                                "text": "Ag pleez Deddy won't you take us to the wrestling\n We wanna see an ou called Sky High Lee"
                            },
                            {
                                "example_id": "8214d383-2914-4ca8-8d4c-dcf8c59ab484",
                                "sense_id": "f6711228-7e00-3d82-82db-76fd6eb52489",
                                "text": "I couldn't care that the ous call me rooinek and sometimes whiterat because of my hair and face. At least I am not a hairyback I tell them."
                            },
                            {
                                "example_id": "6688c729-7dd6-4529-8427-3107a81912b4",
                                "sense_id": "f6711228-7e00-3d82-82db-76fd6eb52489",
                                "text": "“They're the same good and solid ous they'd been before. Because they managed not to think.”"
                            }
                        ]
