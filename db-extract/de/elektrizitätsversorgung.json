                "senses": [
                    {
                        "sense_id": "95bca582-b3f8-3ebe-8f89-6dd4dd5135b6",
                        "entry_id": "dab43735-2ae5-373c-b54e-a666ffd7286a",
                        "glosses": [
                            "Versorgung mit elektrischem Strom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65d2e12-cceb-43ff-8a04-7d0e9157dedd",
                                "sense_id": "95bca582-b3f8-3ebe-8f89-6dd4dd5135b6",
                                "text": "„Im US-amerikanischen Bundesstaat Kalifornien ist wegen der Engpässe in der Elektrizitätsversorgung Stromalarm ausgelöst worden.“"
                            },
                            {
                                "example_id": "7f10cc07-f9dd-46c8-a0b9-c7c351ab5498",
                                "sense_id": "95bca582-b3f8-3ebe-8f89-6dd4dd5135b6",
                                "text": "„Vor allem in der Elektrizitätsversorgung hat die Anzahl der Betriebe jedoch zugenommen. 1991 waren es noch 706, nun sind es fast doppelt so viele: 1309.“"
                            },
                            {
                                "example_id": "6c3775bb-f1e9-41dd-8a25-2e622be34303",
                                "sense_id": "95bca582-b3f8-3ebe-8f89-6dd4dd5135b6",
                                "text": "„Um 12 Uhr 39 fiel zunächst in einigen Athener Stadtteilen der Strom aus. Binnen weniger Minuten brach in einer Kettenreaktion die Elektrizitätsversorgung in der gesamten südlichen Landeshälfte zusammen. Rund acht Millionen Menschen zwischen dem mittelgriechischen Larissa und Kalamata im Süden des Peloponnes, den Ionischen Inseln im Westen des Landes und den Kykladen in der Ägäis waren ohne Strom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
