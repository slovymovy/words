                        "sense_id": "03078abc-9766-3e92-b0bc-9eb16a7ec3a1",
                        "entry_id": "99bb558b-0692-3a02-97d0-2aaf6cdad2b5",
                        "glosses": [
                            "een bepaalde reputatie hebbend; bekend zijn bij een groot publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d355eef4-0954-43f8-8f7b-d0af473e8213",
                                "sense_id": "03078abc-9766-3e92-b0bc-9eb16a7ec3a1",
                                "text": "Het gros van die Toursuccessen noteerde de gebrilde coureur, die zich van proloogspecialist gestaag ontwikkelde tot een gereputeerd tijdrijder, in zijn jaren bij de TI-Raleigh-formatie van Peter Post (1976-1983)."
                            },
                            {
                                "example_id": "6e20b489-e3ab-4aba-a9a7-f16504fb0cd6",
                                "sense_id": "03078abc-9766-3e92-b0bc-9eb16a7ec3a1",
                                "text": "De pater Oblaat sprak hun taal, schreef boeken over hun eeuwenoude tradities en cultuur en werkte zich op tot een gereputeerd en alom gerespecteerd innu-deskundige."
                            }
                        ]
                    }
