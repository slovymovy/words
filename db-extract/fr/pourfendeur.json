                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c253756e-8fb0-408d-817c-ee5ca0f46b16",
                                "sense_id": "8e23ab3f-9cdf-36f7-ab29-988a438fa80f",
                                "text": "Mais l’écho de ses paroles continuait de me troubler ; je ne trouvais pas de refuge contre sa folie pourfendeuse."
