                                "ru": "Туристы отправились в Японию, чтобы подняться на склоны вулкана <w>Акан</w>.",
                                "zh": "徒步旅行者前往日本攀登<w>阿寒岳</w>的山坡。"
                            }
                        },
                        {
                            "text": "The national park surrounding <w>Akan</w> is famous for its beautiful crater lakes.",
                            "target_lang_translations": {
                                "ru": "Национальный парк вокруг вулкана <w>Акан</w> славится своими красивыми кратерными озерами.",
                                "zh": "环绕<w>阿寒岳</w>的国立公园以其美丽的火山口湖而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вулкан, расположенный на острове Хоккайдо в Японии.",
                        "zh": "位于日本北海道的一座火山。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Акан",
                                "target_lang_sense_clarification": "вулкан"
                            }
