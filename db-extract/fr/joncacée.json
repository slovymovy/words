                        "examples": [
                            {
                                "example_id": "bb4fe603-7ca9-4e7d-a70c-e24f9ec0ac6d",
                                "sense_id": "c9c11761-8f20-357e-a54c-3d0898964c21",
                                "text": "Une joncacée poussant à partir d’une stipe épaisse, à l’imitation d’un arbre, était un symbole de royauté sur le pourtour de la Méditerranée orientale."
                            },
                            {
                                "example_id": "35c490f9-612a-44a5-b0ac-d04617628646",
                                "sense_id": "c9c11761-8f20-357e-a54c-3d0898964c21",
                                "text": "Les plantes qui, naturellement, peuplent la toundra : mousses et lichens, pelouses à cypéracées et joncacées avec buissons rampants de salicacées et de bouleaux nains, partagent l'espace avec des individus liés à l'aridité."
                            }
                        ]
