{
    "word_family": [
        "splotchy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4782622d-907f-339c-bea6-27768a490042",
                    "sense_definition": "An irregularly shaped spot, stain, or patch of color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irregular_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A dark red <w>splotch</w> of wine ruined the front of her clean shirt.",
                            "target_lang_translations": {
                                "cs": "Tmavě červená <w>skvrna</w> od vína jí zničila přední část čisté košile."
                            }
                        },
                        {
                            "text": "The artist accidentally left an ink <w>splotch</w> right in the center of the drawing.",
                            "target_lang_translations": {
                                "cs": "Umělec omylem nechal inkoustovou <w>kaňku</w> přímo uprostřed kresby."
                            }
                        }
                    ],
                    "synonyms": [
                        "splodge"
                    ],
                    "common_phrases": [
                        "ink splotch",
                        "red splotches"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nepravidelná skvrna, kaňka nebo barevný flek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skvrna",
                                "target_lang_sense_clarification": "nepravidelná stopa či nečistota"
                            },
                            {
                                "target_lang_word": "flek",
                                "target_lang_sense_clarification": "větší nepravidelná skvrna"
                            },
                            {
                                "target_lang_word": "kaňka",
                                "target_lang_sense_clarification": "inkoustová či tekutá skvrna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9a866a1-8afc-325d-ba54-014044105591",
                    "sense_definition": "To mark or cover something with irregular spots or patches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irregular_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Splashes from the passing bus began to <w>splotch</w> the white wall with mud.",
                            "target_lang_translations": {
                                "cs": "Cákance od projíždějícího autobusu začaly bílou zeď <w>pokrývat blátivými skvrnami</w>."
                            }
                        },
                        {
                            "text": "Years of sun exposure had started to <w>splotch</w> his skin with dark marks.",
                            "target_lang_translations": {
                                "cs": "Roky na slunci začaly jeho kůži <w>pokrývat tmavými skvrnami</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokrýt nebo označkovat něco nepravidelnými skvrnami či fleky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokrýt skvrnami",
                                "target_lang_sense_clarification": "udělat na povrchu fleky"
                            },
                            {
                                "target_lang_word": "zaprlat",
                                "target_lang_sense_clarification": "ušpinit fleky či cákanci"
                            },
                            {
                                "target_lang_word": "pocákat",
                                "target_lang_sense_clarification": "zanechat skvrny stříkáním"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}