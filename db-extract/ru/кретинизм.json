                                        "sense_id": "f7ceba2b-71a4-3451-ab99-ec0dfe8bc307",
                                        "entry_id": "fb4c27f3-e192-3fa5-9172-c42f8da166aa",
                                        "glosses": [
                                            "A condition of severely stunted physical and mental growth due to the untreated congenital deficiency of thyroid hormones."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8529857b-db36-4e8d-ac70-bdf48856d4ac",
                                                "sense_id": "f7ceba2b-71a4-3451-ab99-ec0dfe8bc307",
                                                "text": "Cretinism is a form of amentia, which is endemic in certain districts, especially in some of the valleys of Switzerland, Savoy, and France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
