                "senses": [
                    {
                        "sense_id": "ad4f3358-cc55-3f67-b2e1-634715b70015",
                        "entry_id": "01496f64-183c-3069-9f30-57e56b4e4cac",
                        "glosses": [
                            "Adverb, dessen Bedeutung die Art und Weise benennt, unter der ein Vorgang oder Zustand sich befindet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5345393-a516-44da-87ad-a95d3da7a123",
                                "sense_id": "ad4f3358-cc55-3f67-b2e1-634715b70015",
                                "text": "Im Satz „Er war derart aufdringlich, dass ich ihn rauswerfen musste“ ist „derart“ ein Modaladverb. Man kann hier statt „derart“ auch das wohl meistverwendete Modaladverb „so“ einsetzen."
                            },
                            {
                                "example_id": "06ca8581-c499-4361-8888-edf030c6fa92",
                                "sense_id": "ad4f3358-cc55-3f67-b2e1-634715b70015",
                                "text": "„Die Untersuchungen zu Modalverben, Modaladverbien und Modalausdrücken anderer Art sind Legion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
