                "senses": [
                    {
                        "sense_id": "4317df50-5524-3551-ac08-f758f1ee4b8c",
                        "entry_id": "90967196-eb8b-37b7-b170-5f2fe1bff0c6",
                        "glosses": [
                            "перех. сделать тупым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413d7b9c-ef79-48d2-b651-f5e6b6f661da",
                                "sense_id": "4317df50-5524-3551-ac08-f758f1ee4b8c",
                                "text": "Её сколько ни руби, не изрубишь, а топор затупишь."
                            },
                            {
                                "example_id": "e8d9e106-08fc-4211-877b-e6e19532375a",
                                "sense_id": "4317df50-5524-3551-ac08-f758f1ee4b8c",
                                "text": "«Что же это такое?» — возмутился Медвежонок. Взял уголёк и затупил гвоздики. Теперь бочка не кололась."
                            }
                        ]
                    },
