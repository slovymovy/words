                "senses": [
                    {
                        "sense_id": "b203365d-139b-387f-97d2-6e968f0778b3",
                        "entry_id": "80962d89-c70f-3a00-9c7f-438a4579693f",
                        "glosses": [
                            "Fachmann beziehungsweise Forscher/Wissenschaftler auf dem Gebiet der Atomphysik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6306bbd-8dfa-4f30-8844-2fe19ff7b697",
                                "sense_id": "b203365d-139b-387f-97d2-6e968f0778b3",
                                "text": "„Der US-Atomphysiker starb im Alter von 95 Jahren an den Folgen eines Schlaganfalls.“"
                            },
                            {
                                "example_id": "1799eb31-6329-476e-a6b7-aba8aa152f95",
                                "sense_id": "b203365d-139b-387f-97d2-6e968f0778b3",
                                "text": "„2001 wurden pakistanische Atompyhsiker verhaftet, die angeblich al-Qaida Baupläne für «die Bombe» verkaufen wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cd5cea2-bdfe-443d-8342-4c6cf406c545",
                        "source_entry_id": "80962d89-c70f-3a00-9c7f-438a4579693f",
                        "source_sense_id": "b203365d-139b-387f-97d2-6e968f0778b3",
                        "source_sense_description": "Fachmann beziehungsweise Forscher/Wissenschaftler auf dem Gebiet der Atomphysik",
                        "target_lang_word": "nuclear physicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear physicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                        "entry_id": "59dcb22c-9c55-3a37-9ae9-9881f318e0c3",
                                        "glosses": [
                                            "a scientist of nuclear physics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6358af6-f516-41c2-b3d8-be7e4f04365f",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "Certainly it would be better if he were a nuclear physicist. On the other hand, I believe that a team of that sort would give stronger support to industrial work than a team of four nuclear engineers."
                                            },
                                            {
                                                "example_id": "b47fb971-0e1b-4380-a179-2c0e4789077f",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "Explaining the history is a nuclear physicist who is also an accomplished writer."
                                            },
                                            {
                                                "example_id": "9d2bf31a-f746-48d1-aaaf-4ad5e525bc04",
                                                "sense_id": "4c59e610-fb86-3761-8ecd-c2412694f426",
                                                "text": "And Theodore Taylor, the nuclear physicist who designed America's smallest and largest atomic bombs, has repeatedly stated that given fissile material, building a bomb is \"very easy. Double underline. Very easy.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
