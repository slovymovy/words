                    {
                        "sense_id": "ec15016c-a34d-37d9-aec2-809e20efd9df",
                        "entry_id": "5d00ef1b-47e6-3189-bb84-7c14f90e4aef",
                        "glosses": [
                            "Qui a lieu après une opération chirurgicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3672b3-2a3f-47e1-935b-60921569c263",
                                "sense_id": "ec15016c-a34d-37d9-aec2-809e20efd9df",
                                "text": "L'inhibition diaphragmatique postopératoire a été confirmée plus récemment par des études faisant appel à l’électromyographie du diaphragme qui témoigne de façon plus directe de la fonction du diaphragme."
                            },
                            {
                                "example_id": "cbfe6578-a833-4630-bbd4-75086752d545",
                                "sense_id": "ec15016c-a34d-37d9-aec2-809e20efd9df",
                                "text": "Sur Twitter, Sandra raconte qu’une amie, en consultation postopératoire, a enregistré sa chirurgienne par « peur de ne pas tout retenir »."
                            }
                        ]
                    }
                ],
                "translations": [
