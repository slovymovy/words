                        "entry_id": "222179fd-de5b-3609-83b7-6e4179fc74ed",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße Verhalten frei von Bedenken und Rücksicht zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181ae729-737f-4fcd-8eef-6321a81b970e",
                                "sense_id": "1b03b86c-d44b-395c-9c7c-f47534510c57",
                                "text": "Mit beispielloser Bedenkenlosigkeit verfolgte sie ihre Pläne und setzte sie ihre Vorstellungen in die Praxis um."
                            },
                            {
                                "example_id": "8b65fce7-f5d5-4d29-9f1f-493382d12006",
                                "sense_id": "1b03b86c-d44b-395c-9c7c-f47534510c57",
                                "text": "Die Bedenkenlosigkeit, mit der man einfach direkt behauptete, der Brand sei angelegt worden, grenzte an politische Dummheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
