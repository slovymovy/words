                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "696f8677-6005-4b9c-b32c-b367583ec3b6",
                                "sense_id": "0639e9b7-ac5d-332c-b84a-1cc2a3462ba2",
                                "text": "Intel is important in espionage."
                            },
                            {
                                "example_id": "01d3db7e-90a2-433e-8b0d-55a2e4e40d58",
                                "sense_id": "0639e9b7-ac5d-332c-b84a-1cc2a3462ba2",
                                "text": "We have reason to believe one of our people is giving intel to the enemy. Hit an enemy communication center and get us a name."
                            },
                            {
                                "example_id": "9864fc23-cbcf-401c-9b91-7fa819cd546f",
                                "sense_id": "0639e9b7-ac5d-332c-b84a-1cc2a3462ba2",
                                "text": "“The Bynar ship went missing on stardate 58934.9.” “Okay, so your intel is legit, but this still feels like a trick.” “No. I'm a changed computer. Just look at me. Do you see the blue light?” “The light is reassuring.”"
                            },
                            {
                                "example_id": "c805a836-f7f7-419c-af7d-a04bb7dcf0b2",
                                "sense_id": "0639e9b7-ac5d-332c-b84a-1cc2a3462ba2",
                                "text": "Aaaaaand that’s pretty much everything we know about Zazie and David’s ‘ship, but definitely check back here for any and all intel on the couple. ❤️"
                            }
                        ]
                    }
