                ],
                "senses": [
                    {
                        "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                        "entry_id": "568b20e5-1f95-33e8-b239-272fa3e690cb",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8416d920-3360-4c20-a1fe-0822fdcec2f3",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Leweks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "adc92def-7f9b-44d7-a2ac-bae670c6ca52",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Lewek kommt und geht."
                            },
                            {
                                "example_id": "bcd84053-91b6-4234-81f2-fac6248763cc",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Frau Lewek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b3701afb-3240-45ea-9771-1c1069f32b18",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Herr Lewek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6df3247c-46e6-4304-9a07-817d51ebe86b",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Die Leweks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ad3e70b3-b4e6-4647-a49c-c65636caf7a0",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Der Lewek trägt nie die Schals, die die Lewek ihm strickt."
                            },
                            {
                                "example_id": "8ac0529e-1be8-4993-8051-0bb5ef92866b",
                                "sense_id": "11f92736-e012-3c44-b0db-674e5ef3cd54",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lewek kommt, geht der Herr Lewek.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
