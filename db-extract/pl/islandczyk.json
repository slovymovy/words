                    {
                        "translation_id": "a7566a97-853a-4d22-8c36-324ae748de68",
                        "source_entry_id": "4e330e7e-82db-361d-965c-3df3f5d3f33a",
                        "source_sense_id": "03f9334b-a819-31f3-a71b-60b25a97d1df",
                        "target_lang_word": "Isländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Isländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7753ae70-bb89-3bc1-bb1a-165da2f01407",
                                        "entry_id": "8fac828c-3f56-3c28-b814-60f341eb2167",
                                        "glosses": [
                                            "Staatsbürger von Island"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bff3f45-552e-46bc-9b88-2a8a4ba8bede",
                                                "sense_id": "7753ae70-bb89-3bc1-bb1a-165da2f01407",
                                                "text": "„Die Isländer scheinen bei allem, was Hightech angeht, stets auf dem neuesten Stand zu sein.“"
                                            },
                                            {
                                                "example_id": "554bd866-f513-41d2-b775-b3d9780a4507",
                                                "sense_id": "7753ae70-bb89-3bc1-bb1a-165da2f01407",
                                                "text": "„Ist es da ein Wunder, dass jeder zweite Isländer an Elfen glaubt?“"
                                            },
                                            {
                                                "example_id": "6528fa15-e5fd-4be5-9a5a-d378e99aa64a",
                                                "sense_id": "7753ae70-bb89-3bc1-bb1a-165da2f01407",
                                                "text": "„In dem Haus wohne noch ein Isländer, und die anderen Mieter seien Färinger.“"
                                            },
                                            {
                                                "example_id": "9fc8ff74-2a56-4c61-a78e-b5ac83d18277",
                                                "sense_id": "7753ae70-bb89-3bc1-bb1a-165da2f01407",
                                                "text": "„Und einen Monat später, im Juni, kommen die Isländer zu einem weiteren Treffen zusammen, dessen Entscheidungen auf der gesamten Insel Gültigkeit haben: zum Althing - einem in Europa einzigartigen Plenum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
