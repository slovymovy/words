                },
                {
                    "sense_id": "7505c685-1a71-3e36-b8ce-c97abb431425",
                    "sense_definition": "op een aangename manier de aandacht van iemand vasthouden of iemand aan het lachen maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "iemand vermaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De clown wist het jonge publiek uitstekend te <w>amuseren</w> met zijn trucjes.",
                            "target_lang_translations": {
                                "en": "The clown knew how to <w>amuse</w> the young audience perfectly with his tricks."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn gasten te <w>amuseren</w> met sterke verhalen over zijn reizen.",
                            "target_lang_translations": {
                                "en": "He tried to <w>entertain</w> his guests with tall tales about his travels."
                            }
                        }
                    ],
                    "synonyms": [
                        "vermaken"
                    ],
                    "antonyms": [
                        "vervelen"
                    ],
                    "common_phrases": [
                        "het publiek amuseren",
                        "de gasten amuseren"
                    ],
                    "target_lang_definitions": {
                        "en": "To hold someone's attention in a pleasant way or to make someone laugh"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amuse",
                                "target_lang_sense_clarification": "to cause laughter or provide entertainment"
                            },
                            {
