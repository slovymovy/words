                    },
                    {
                        "translation_id": "5296e374-98a3-432e-a91e-6268a4af4ece",
                        "source_entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "source_sense_description": "something that saps a resource produced by something else",
                        "target_lang_word": "sangsue",
