                "senses": [
                    {
                        "sense_id": "761611b3-8096-3f8b-9d8d-792580212bbf",
                        "entry_id": "cb6db5f5-b89b-3758-8e60-ea0682216e09",
                        "glosses": [
                            "To disinfect, purify, or rid of vermin with the fumes of certain chemicals."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2661fbe4-7fcc-47b6-ba70-d6a9402cd3a4",
                                "sense_id": "761611b3-8096-3f8b-9d8d-792580212bbf",
                                "text": "They fumigated the Church with burnt wool and feathers instead of incense, put foul water into the holy-water basins, and celebrated a parody on the Church-service, the mock Abbot officiating at the altar; […]"
                            },
                            {
                                "example_id": "e4387509-714f-4c2d-8e7d-8f4d770a8b1c",
                                "sense_id": "761611b3-8096-3f8b-9d8d-792580212bbf",
                                "text": "‘Pest control are coming too. They’ll be fumigating the place.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8ad866a-b780-4a9b-8ff6-69ce0097be56",
                        "source_entry_id": "cb6db5f5-b89b-3758-8e60-ea0682216e09",
                        "source_sense_id": "761611b3-8096-3f8b-9d8d-792580212bbf",
                        "source_sense_description": "disinfect",
                        "target_lang_word": "uitroken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitroken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4852b674-d39f-340d-8865-b934c3dfcbe1",
                                        "entry_id": "6d89414d-ca08-3b1e-a3a7-00df7b3c2d6c",
                                        "glosses": [
                                            "iemand verjagen met rook"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f1bf23-c430-4430-8040-f0fb4c9c94e1",
                                                "sense_id": "4852b674-d39f-340d-8865-b934c3dfcbe1",
                                                "text": "Elke minuut die je in een advocaat steekt, gaat niet meer naar onderzoeksjournalistiek. We hebben sterk het gevoel dat ze ons willen uitroken. We zijn een klein bedrijf en het bedrag van de schadeclaims is even groot als het kapitaal dat we ooit hebben opgehaald om onze droom te realiseren.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc7d78d-1956-35a1-bdcd-3e5867b148a9",
                                        "entry_id": "6d89414d-ca08-3b1e-a3a7-00df7b3c2d6c",
                                        "glosses": [
                                            "met rook behandelen om een plaag te bestrijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "202b19ed-367c-4ca2-b7cd-38e19b950630",
                                                "sense_id": "dcc7d78d-1956-35a1-bdcd-3e5867b148a9",
                                                "text": "Groendeskundigen weten niet goed hoe de plant aan te pakken. Moet je maaien, begrazen, de plant met gif te lijf gaan, uitroken of met wortel en al rooien? \"Maaien is bijvoorbeeld niet altijd de beste optie. Sommige soorten komen er zelfs versneld door terug\", aldus een medewerker van de gemeente Enschede. \"Bovendien staan ze ook geregeld op particuliere grond.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4da0d83a-7861-47d4-a8ff-f6f7e5e0c125",
                        "source_entry_id": "cb6db5f5-b89b-3758-8e60-ea0682216e09",
