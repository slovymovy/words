                        "cross_references": [
                            {
                                "target_word": "discreetly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24906953-df4c-3375-9686-e2629b1e85f2",
                                        "entry_id": "c1e8ab9b-0245-3f6c-8f8a-3ef4fde80309",
                                        "glosses": [
                                            "Acting in a discreet manner; acting in a way that respects privacy or secrecy; quietly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab25ad5-17f2-4647-be5c-4e1951c30c38",
                                                "sense_id": "24906953-df4c-3375-9686-e2629b1e85f2",
                                                "text": "Mao was animated and following every nuance of the conversation, but I could see that he was also becoming very tired. Chou had been discreetly glancing at his watch with increasing frequency, so I decided that I should try to bring the session to a close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                        "entry_id": "c1e8ab9b-0245-3f6c-8f8a-3ef4fde80309",
                                        "glosses": [
                                            "inconspicuously"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e692e0-6780-434b-b977-5a939c38720c",
                                                "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                                "text": "And, placed discreetly among these commonplaces, a few pieces of genuine quality, bizarrely distinguished by craftsmanship from the vulgar products of the machine."
                                            },
                                            {
                                                "example_id": "82026b26-c776-4d1a-83be-0bb7406ed6b8",
                                                "sense_id": "630ff14a-9a44-3709-87fb-9c7b4a3c501c",
                                                "text": "A Forest Trail and wild life hides lie 2 miles to the north-east. Blue hares, deer, wild geese, herons and duck can be discreetly observed from the hides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "952abd7d-6322-4504-beb3-461420933821",
                        "source_entry_id": "0f6930ce-529b-30c8-8f88-699230735aca",
                        "source_sense_id": "a89d3210-0fdf-3886-ad64-51ddb755cdd7",
                        "target_lang_word": "unobtrusively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unobtrusively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                        "entry_id": "c7b6aa89-60a3-3e63-9164-1f174665427a",
                                        "glosses": [
                                            "In an unobtrusive manner; in a manner that is not noticeable or blatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488f4993-4c23-405d-9ea6-bf2f2b4be7dd",
                                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                                "text": "He felt not the slightest doubt in his mind that this was the girl who had written him, and, having given an order to the waiter, he started to study her face as unobtrusively as possible."
                                            },
                                            {
                                                "example_id": "9064eefa-1b4f-4e27-af69-5c614cdd9616",
                                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                                "text": "Sometimes she and Miss Baker talked at once, unobtrusively and with a bantering inconsequence that was never quite chatter, that was as cool as their white dresses and their impersonal eyes in the absence of all desire."
                                            },
                                            {
                                                "example_id": "b085dcdb-53be-449a-b90c-89d2832816e7",
                                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                                "text": "Eudemis moved hastily but as unobtrusively as he could through the gaping crowd[.]"
                                            },
                                            {
                                                "example_id": "d3a5531f-1aa4-42ae-b638-dc69cca6e381",
                                                "sense_id": "a7ae82ec-1f1c-39c0-bf0c-f0c8a6bc7596",
                                                "text": "Most of the old fishermen's cottages have been unobtrusively modernised, the harbour is busy with summer yachts, and the sands are superb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7aa1070-fe56-4cfe-b165-21bfd8619da9",
                        "source_entry_id": "0f6930ce-529b-30c8-8f88-699230735aca",
                        "source_sense_id": "a89d3210-0fdf-3886-ad64-51ddb755cdd7",
                        "target_lang_word": "inconspicuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
