                "senses": [
                    {
                        "sense_id": "b13ad669-a595-3d2b-9040-135e1814a462",
                        "entry_id": "517ad441-cb64-3117-9fcf-514f425a8518",
                        "glosses": [
                            "auf der Halbinsel Kola gelegene Stadt im Nordwesten Russlands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06aaefa-6139-49c6-a7cc-f707a398c166",
                                "sense_id": "b13ad669-a595-3d2b-9040-135e1814a462",
                                "text": "„In einer Zeit, als Siege der Wehrmacht schon nicht mehr selbstverständlich waren und der angestrebte Erfolg an der Küste der Barentsee, die Eroberung von Murmansk, ausblieb, reiste Hitler am 4. Juni 1942 zum 75. Geburtstag des finnischen Oberbefehlshabers von Mannerheim in den Norden.“"
                            },
                            {
                                "example_id": "9f70c8c8-eae4-4d89-8bb4-e9892b5b58f1",
                                "sense_id": "b13ad669-a595-3d2b-9040-135e1814a462",
                                "text": "[9. März 1918:] „Britische Flottenverbände landen mit Zustimmung der bolschewistischen Sowjetregierung in Murmansk, um gegen die in Finnland vordringenden Deutschen vorzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
