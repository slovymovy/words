                        "translation_id": "d466ce66-69da-4b88-b938-06fdbd3bf801",
                        "source_entry_id": "015ee8d8-8790-34f5-94b0-05fd6dda776d",
                        "source_sense_id": "ce111379-a2c4-381e-82c0-3cd028b0bd93",
                        "source_sense_description": "a spacecraft capable of traveling to other stars",
                        "target_lang_word": "hvězdolet",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hvězdolet",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2dae4a3c-07a3-3aa1-952c-74c5d42aa5df",
                                        "entry_id": "826b2c93-71e4-30f4-a6c8-84e3e952559f",
                                        "glosses": [
                                            "vesmírná loď určená k mezihvězdným cestám"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1e5732-752c-4106-bd4b-77770360a8ae",
                                                "sense_id": "2dae4a3c-07a3-3aa1-952c-74c5d42aa5df",
                                                "text": "...máme po ruce víc než dost argumentů, že žádný mimozemský hvězdolet by nemohl proletět z vesmíru na naši Zemi nezaregistrován sítí družic a radarů."
                                            },
                                            {
                                                "example_id": "aaf90e6a-0539-4ae0-adcb-b254d33bf018",
                                                "sense_id": "2dae4a3c-07a3-3aa1-952c-74c5d42aa5df",
                                                "text": "Obrovský prostor, který obsáhl zrakem, byl mrtvý, jako by sem nikdy nevkročila lidská noha, jako by to nebyla planeta, která pohltila hvězdolet třídy Nepřemožitelného i s jeho osmdesátičlennou posádkou, obrovské, zkušené plavidlo v prázdnotě, plavidlo schopné vyvinout ve zlomku vteřiny energii miliard kilowatt, přeměnit ji v energetické pole, kterým nepronikne žádné materiální těleso, zkoncentrovat ji do všeničícího záření o hvězdné teplotě, které může sežehnout horský řetěz nebo vysušit moře."
                                            },
                                            {
                                                "example_id": "2802f5cb-2722-4323-b9fd-1c3b0650a4c6",
                                                "sense_id": "2dae4a3c-07a3-3aa1-952c-74c5d42aa5df",
                                                "text": "Hvězdolet se dále prodíral prostorem a časem. Bez zájmu míjel oblaka plynů a prach, rodící se a umírající hvězdy, ba i ty, které zatím v plné kráse svého zenitu mrhaly energií na všechny strany."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
