                "senses": [
                    {
                        "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                        "entry_id": "212e8b5b-fa9e-3807-b088-ba5fd8feda4b",
                        "glosses": [
                            "Verlangen nach einem bestimmten Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf95e930-7973-408b-9170-1dd62bd6dbec",
                                "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                                "text": "„Bei häufiger Enthaltung sollte man diese Spieler in vorsichtigen Gesprächen dazu veranlassen, Gründe anzugeben und andere Spielwünsche vorzubringen.“"
                            },
                            {
                                "example_id": "f19f4e37-487b-4602-a564-280b11ef35c6",
                                "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                                "text": "„Den Kindern werden ihre Spielwünsche zunehmend bewusst, sie lernen sie zu artikulieren und zu vertreten und werden auch zunehmend bereit, den eigenen Wunsch […] zugunsten des Wunsches der Mehrheit der Kinder zurückzustellen.“"
                            },
                            {
                                "example_id": "95bb802e-d46e-4ec1-875e-939d0855d314",
                                "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                                "text": "„Während er so redete, ließ er natürlich die Kugel keine Sekunde still liegen, unterbrach die Auszahlung und das Placieren der neuen Einsätze nicht ein einziges Mal, seine Worte riefen auch jedesmal so heftige Proteste hervor, daß er sich gleich wieder lächelnd dem Spielwunsch der Allgemeinheit fügte und achselzuckend und eine weitere Phrase anfügend seine Bankhalterdienste versah.“"
                            },
                            {
                                "example_id": "a33fd8e4-2187-46f8-b7ec-2d8301c79612",
                                "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                                "text": "„So musste Adidas-Organisator Alexander Scholl schon um 16 Uhr alle Spielwünsche abblocken.“"
                            },
                            {
                                "example_id": "c672d988-0ce7-457f-8184-3fad1a860552",
                                "sense_id": "8889e0e9-7251-3f73-90ab-6a2b3f7d8b68",
                                "text": "„So kommt es in gemischten Gruppen häufig vor, dass die Spielwünsche der Jungen sich sehr von denen der Mädchen unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
