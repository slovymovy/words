                "senses": [
                    {
                        "sense_id": "3ac6e1b6-3cb3-3da0-9961-80c76d0cac27",
                        "entry_id": "cd0e4036-98cb-3988-804d-22dff6dd5d54",
                        "glosses": [
                            "ursprünglich aus Asien stammender Käfer, der sich von mehr als 300 Wirtspflanzen (zum Beispiel Obstgehölze, Gemüse, Ackerkulturen und holzige sowie krautige Zierpflanzen) ernährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c26e373b-8d49-4c60-a00f-311d49bdfdc7",
                                "sense_id": "3ac6e1b6-3cb3-3da0-9961-80c76d0cac27",
                                "text": "„In der Nähe des Güterbahnhofs wurde ein Japankäfer entdeckt. Dessen Larven können in Massen ganze Wiesen zerstören.“"
                            },
                            {
                                "example_id": "e5b58638-8d04-4361-bd67-a78fff7a6f0f",
                                "sense_id": "3ac6e1b6-3cb3-3da0-9961-80c76d0cac27",
                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
