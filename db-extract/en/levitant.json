                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9653e97f-9926-40e7-8cb1-208f1267acce",
                                "sense_id": "f075206b-71fa-3c9c-af92-14f708aedc20",
                                "text": "All the levitant euphoria of a moment past was gone now."
                            },
                            {
                                "example_id": "8f13dbd0-c4a2-4b6f-88cc-552865958349",
                                "sense_id": "f075206b-71fa-3c9c-af92-14f708aedc20",
                                "text": "His rooms were as levitant with her as they were with air."
                            },
                            {
                                "example_id": "584d1d8c-1df0-4deb-b2b6-a4836a361af0",
                                "sense_id": "f075206b-71fa-3c9c-af92-14f708aedc20",
                                "text": "Though our clayey feet still press the earth the levitant soul may saunter among the stars."
                            }
                        ]
                    }
                ],
