                    },
                    {
                        "sense_id": "05b2fb5a-eaa1-36bc-ae20-da2afac0adde",
                        "entry_id": "cf46731d-a532-30ce-ad9d-76d215272ff9",
                        "glosses": [
                            "Fass, in dem Butter aufbewahrt und transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41561723-f440-48be-a053-a19dad13d80c",
                                "sense_id": "05b2fb5a-eaa1-36bc-ae20-da2afac0adde",
                                "text": "„Beim Chargenverfahren im Butterfass wird viel Luft in die Butter eingetragen, daher spielt hier die Luftkontamination eine größere Rolle als beim kontinuierlichen Verfahren.“"
                            }
                        ],
