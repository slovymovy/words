                ],
                "senses": [
                    {
                        "sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                        "entry_id": "941568a0-5a76-372e-872a-db3d0e8e32df",
                        "glosses": [
                            "feierliches Versprechen, die Aufgaben verfassungsgemäß beziehungsweise gesetzestreu zu erfüllen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46fc5d87-4459-4128-9db1-05ba104cead5",
                                "sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                                "text": "Wenn jemand zum Minister ernannt wird, muss er einen Amtseid leisten."
                            },
                            {
                                "example_id": "95b7ff04-daf5-4e09-942c-46065c13edab",
                                "sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                                "text": "„Zum Amtseid trug Deb Haaland die Insignien ihrer Vorfahren.“"
                            },
                            {
                                "example_id": "848299df-284b-4fa9-aa2e-00418bc0036a",
                                "sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                                "text": "„Präsident Banana und Premierminister Mugabe legten öffentlich ihre Amtseide ab.“"
                            },
                            {
                                "example_id": "691dec64-9e41-4919-8275-704f5ded08e3",
                                "sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                                "text": "„Nach erfolgter Bestätigung der Ernennung hat der ernannte Börsesensal vor dem Landeshauptmann den Amtseid zu leisten, daß [sic!] er die ihm obliegenden Pflichten getreu erfüllen wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "916aa6f7-9575-47e5-a9da-c3561bec87da",
                        "source_entry_id": "941568a0-5a76-372e-872a-db3d0e8e32df",
                        "source_sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
