                ],
                "senses": [
                    {
                        "sense_id": "5bce57a4-2805-3bef-a445-e432b47f6abf",
                        "entry_id": "841e5148-2384-385c-a41f-74ff75e8e92a",
                        "glosses": [
                            "weite, altmodische Hose, die unterhalb des Knies durch einen Bund oder einen Gummizug zusammengehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb8e219-5acd-4a32-8f88-238f0b3e695f",
                                "sense_id": "5bce57a4-2805-3bef-a445-e432b47f6abf",
                                "text": "Ich ziehe doch keine Pumphose an!"
                            },
                            {
                                "example_id": "6d99a1de-7c83-4486-9f1c-958e6875517f",
                                "sense_id": "5bce57a4-2805-3bef-a445-e432b47f6abf",
                                "text": "„Auf der Höhe, von der uns vorhin die Franzosen beschossen hatten, lag ein Schwarzer mit weißen Pumphosen.“"
                            },
                            {
                                "example_id": "ecda284c-fa49-4e60-a5ab-35d5d934eafe",
                                "sense_id": "5bce57a4-2805-3bef-a445-e432b47f6abf",
                                "text": "„Also schneiderten sich die Frauen Pumphosen - was zu einer Diskussion darüber führte, ob diese eine angemessene Kleidung in der Öffentlichkeit darstellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
