                                    {
                                        "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                                        "entry_id": "1a40ae6a-25cb-3e87-97cc-b22ed3beb697",
                                        "glosses": [
                                            "woord dat hetzelfde wordt uitgesproken als een ander woord, maar anders wordt geschreven en een andere betekenis heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b00a400f-386c-40aa-beef-8fb14cd7b1e0",
                                                "sense_id": "0eac44fc-eaf7-3d69-9289-7eef5582faba",
                                                "text": "Homofonen zijn woorden die hetzelfde klinken maar die je anders schrijft. Er zijn in het Nederlands vrij veel van deze woorden omdat we bijvoorbeeld de ei en ij hebben en ook de ou en au."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homofoon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3acf73ca-1fa7-3e71-8b55-8e4c39bc5f95",
                                        "entry_id": "cbcd6e63-2a73-343e-a76e-0df0bd83587c",
                                        "glosses": [
                                            "éénstemmig gezongen, eventueel met harmonisch begeleidende stemmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de0a6c1-4781-4ec2-8668-29b1b9a32974",
                                                "sense_id": "3acf73ca-1fa7-3e71-8b55-8e4c39bc5f95",
                                                "text": "Je ziet meteen aan geschreven muziek dat het homofoon is: de stemmen staan keurig recht onder elkaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c72aea5a-e733-38a2-b603-0a12d08e3c63",
                                        "entry_id": "cbcd6e63-2a73-343e-a76e-0df0bd83587c",
                                        "glosses": [
                                            "gelijkluidend"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c9f3b7c-35be-4952-9edc-6a91fd65b6f1",
                        "source_entry_id": "d3e32455-64a2-32e5-a790-615dde434698",
                        "source_sense_description": "words with the same pronunciation",
                        "target_lang_word": "homophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbcf822-f6cf-3c3c-91b8-979b509818c8",
                                        "entry_id": "4676025c-1e16-3bd5-b230-e794471ca557",
                                        "glosses": [
                                            "Qui se prononcent de la même façon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d05e74-8089-4546-a436-091a49e688d3",
                                                "sense_id": "5fbcf822-f6cf-3c3c-91b8-979b509818c8",
                                                "text": "Notons que les ambiguïtés causées par la liaison vont parfois jusqu’à constituer des suites totalement homophones (il est ouvert / il est tout vert)."
                                            },
                                            {
                                                "example_id": "bb5df921-d678-4e9d-8e91-ed212bcdec99",
                                                "sense_id": "5fbcf822-f6cf-3c3c-91b8-979b509818c8",
                                                "text": "Les mots Baule /bol/ et bol /bɔl/, fée /fe/ et fait /fɛ/ sont homophones en Normandie."
                                            },
                                            {
                                                "example_id": "1bb1310c-7919-4973-a616-9b1020229b56",
                                                "sense_id": "5fbcf822-f6cf-3c3c-91b8-979b509818c8",
                                                "text": "Par exemple, au lieu de dire 猪肝 zhūgān « foie de porc » qui se compose de zhū « porc » et de gān « foie », dans cet argot on dira 猪润 zhūrùn parce que gān « foie » est homophone du lexème 干 gān « [séché] » alors que 润 rùn signifie « hydraté »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75d5a2e-f9ea-325f-84a8-dcc3a109d331",
                                        "entry_id": "4676025c-1e16-3bd5-b230-e794471ca557",
                                        "glosses": [
                                            "Qui a le même son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442bcbc9-5460-4ca4-9b9b-339c344e8a78",
                                                "sense_id": "d75d5a2e-f9ea-325f-84a8-dcc3a109d331",
                                                "text": "On appelle enharmonie la différence entre un mi dièse et un fa naturel et entre un si dièse et un do naturel lorsque le système tempéré, en rendant égaux les semi-tons, a ôté ces différences et donc rendu homophones les deux notes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fa8ed9f-2ffc-362e-bcfd-415334c40e9c",
                                        "entry_id": "78a00514-21ac-323d-85cc-0a728d4f7158",
                                        "glosses": [
                                            "Mot ou hiéroglyphe ayant la même prononciation qu’un ou plusieurs autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5152b9bb-3dad-4d8b-9902-cbda17c43469",
                                                "sense_id": "9fa8ed9f-2ffc-362e-bcfd-415334c40e9c",
                                                "text": "J’ai déjà établi, dans un travail particulier, la correspondance fixe des signes hiératiques avec les signes hiéroglyphiques ; et toutes les fois que la collation des deux rituels présentera dans le rituel hiératique un caractère qui n’est point l’équivalent fixe de l’hiéroglyphe auquel il correspond dans le rituel hiéroglyphique, en cherchant dans le Tableau général de correspondance des deux écritures l’hiéroglyphe dont le signe hiératique est le représentant habituel, on connaîtra alors un nouvel hiéroglyphe phonétique, un homophone de l’hiéroglyphe que porte le rituel hiéroglyphique."
                                            },
                                            {
                                                "example_id": "4407b17c-084b-4138-bc17-548177c6b609",
                                                "sense_id": "9fa8ed9f-2ffc-362e-bcfd-415334c40e9c",
                                                "text": "Les homophones, — c’est le nom que l’on donne à ces signes qui ont la même valeur et peuvent permuter entre eux, — les homophones sont très fréquents dans les hiéroglyphes ; il n’était donc pas téméraire, en apparence, de supposer que les Assyriens eussent usé d’un procédé si familier aux Égyptiens. Mais si le vrai peut quelquefois n’être pas vraisemblable, souvent aussi le vraisemblable n’est pas vrai. On s’aperçut bientôt que la théorie des homophones, admise au début par M. Botta, ne pouvait rendre compte de tous les faits."
                                            },
                                            {
                                                "example_id": "6b1348f4-c4f5-4e57-bc54-d1bff5fea00a",
                                                "sense_id": "9fa8ed9f-2ffc-362e-bcfd-415334c40e9c",
                                                "text": "Le sumérien étant majoritairement monosyllabique, il en aurait résulté des homophones nombreux (des mots différents se prononçant de la même façon, comme en français vers, verre, vert, ver) si la langue n’avait pas utilisé un autre moyen de distinguer entre les différents sens de ces « homophones »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e0bb84-c5f6-3264-8eef-5c5bb08e77eb",
                                        "entry_id": "78a00514-21ac-323d-85cc-0a728d4f7158",
                                        "glosses": [
                                            "Chacun d’un ensemble de codes assignés à un même élément de texte non-chiffré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af0e8fe-15bd-4ade-9b05-2fbf669b458f",
                                                "sense_id": "85e0bb84-c5f6-3264-8eef-5c5bb08e77eb",
                                                "text": "Le principe de substitution connaît de multiples variantes. Il est tout d’abord possible d’associer à chaque lettre un choix de plusieurs symboles, appelés homophones. De nombreux textes chiffrés, même anciens, n’hésitent pas à utiliser comme alphabet des groupes de deux chiffres, surmontés éventuellement de barres et de symboles de ponctuation divers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c8b66d9-00c2-4a74-994d-e17098571e8c",
                        "source_entry_id": "d3e32455-64a2-32e5-a790-615dde434698",
                        "source_sense_description": "words with the same pronunciation",
                        "target_lang_word": "Homophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                        "entry_id": "4d69fd40-a07b-33eb-94ee-20782195ed5a",
                                        "glosses": [
                                            "eine sprachliche Einheit (vor allem Morphem oder Wort), die genau so ausgesprochen wird wie eine andere, obwohl sie verschiedene Einheiten sind, was durch ihre unterschiedliche Bedeutung und oft auch durch verschiedene Schreibweise deutlich wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918b853e-f13d-4449-9b3e-022c2750b521",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "„Ein anderer Grund, der gegen eine Transliteration der japanischen Schrift spricht, ist die große Zahl der Homophone.“"
                                            },
                                            {
                                                "example_id": "4a08ed20-e487-4523-8539-9efd4fded7d4",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "Ein bekanntes Beispiel für Homophone sind die Wörter „Seite“ und „Saite“, die gleich ausgesprochen werden, aber unterschiedlich geschrieben werden und zugleich eine verschiedene Bedeutung haben."
                                            },
                                            {
                                                "example_id": "4d536aff-0dd3-45a4-b280-17e3da6fefb2",
                                                "sense_id": "12996845-b710-3fbe-9ac4-694ade4b93c8",
                                                "text": "„Die zahlreichen Homophone seines Alphabets versucht er durch das ziemlich fragwürdige Prinzip der Akrophonie zu erklären (das davon ausgeht, ein Ägypter habe beim Betrachten eines Zeichens stets den gemalten Gegenstand erkannt, seinen Namen und den Anfangsbuchstaben dieses Namens gewußt, so daß das Lesen des Lautes von ihm weder großes Können noch besonders gutes Gedächtnis erfordert hätten!);…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
