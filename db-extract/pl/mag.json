                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f994a5f-9212-4556-8def-155db689212b",
                        "source_entry_id": "87d77b1a-606c-3761-8bd7-baa4e4389be5",
                        "source_sense_id": "d4f313c9-f505-3d1b-b099-6b7202715622",
                        "target_lang_word": "sorcerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                        "entry_id": "b8a3cb3a-5338-3514-9425-9ccf36257571",
                                        "glosses": [
                                            "A magician or wizard. Sometimes specifically male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298215e-0bc5-4c17-aa36-2200e2e9168e",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "Pope Joan, who once occupied the throne of the Vatican, was reputed to be the blackest sorcerer of them all."
                                            },
                                            {
                                                "example_id": "e7a46346-c9b2-4598-9e25-03c2001fb7ac",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc8a11b6-513f-4a0e-ab77-d8ad92102ccd",
                        "source_entry_id": "87d77b1a-606c-3761-8bd7-baa4e4389be5",
                        "source_sense_id": "d4f313c9-f505-3d1b-b099-6b7202715622",
                        "target_lang_word": "Magier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd4ec2c-451a-3b6d-a6a0-f11d40f68c86",
                                        "entry_id": "3e4c75e3-13c6-3f62-a93a-680c9ee0b043",
                                        "glosses": [
                                            "Person, die übernatürliche Fähigkeiten besitzt und anwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b133b255-d7d3-4d34-92ec-bd5eaa2b98d5",
                                                "sense_id": "7cd4ec2c-451a-3b6d-a6a0-f11d40f68c86",
                                                "text": "„Der Magier wartete still, bis der Mann den Saal verlassen hatte.“"
                                            },
                                            {
                                                "example_id": "1e605b20-2e77-4c94-a156-c8a3ed182e0f",
                                                "sense_id": "7cd4ec2c-451a-3b6d-a6a0-f11d40f68c86",
                                                "text": "„Ich fühlte mich etwas unbehaglich, als sei ich, ein höchst gewöhnlicher Bursche, in die Gesellschaft von Magiern geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56851f2e-19ac-39dd-bccf-82082ecbdfda",
                                        "entry_id": "3e4c75e3-13c6-3f62-a93a-680c9ee0b043",
                                        "glosses": [
                                            "Person, die Zaubertricks vorführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edd9570e-f7a1-484c-8ab2-675bf71692f4",
                                                "sense_id": "56851f2e-19ac-39dd-bccf-82082ecbdfda",
                                                "text": "Der Magier zauberte ein Kaninchen aus seinem Zylinder hervor."
                                            },
                                            {
                                                "example_id": "9a425481-ec54-481f-a022-79d36cbfd7e8",
                                                "sense_id": "56851f2e-19ac-39dd-bccf-82082ecbdfda",
                                                "text": "„Dieser hier hatte etwas von den Magiern, die auf den Jahrmärkten zum Eintritt in verhangene Zelte anlocken, doch fehlte ihm die Scharlatanerie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
