                {
                    "sense_id": "1522f450-6870-33d2-aec4-7df8c12172cb",
                    "sense_definition": "Déployer du linge mouillé sur un fil ou un étendoir pour le faire sécher.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deploiement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir fait la lessive, elle va <w>étendre</w> les chemises dans le jardin."
                        },
                        {
                            "text": "N'oublie pas d'<w>étendre</w> le linge avant de partir au travail ce matin."
                        }
                    ],
                    "common_phrases": [
                        "étendre le linge",
                        "étendre la lessive"
                    ]
                },
                {
                    "sense_id": "0aedc596-dfc9-32a7-97f4-110701d7ec87",
                    "sense_definition": "Étaler une pâte ou une matière sur une surface pour la rendre plus mince ou plus large.",
