                        "examples": [
                            {
                                "example_id": "ae9ed7a7-2698-439b-b663-aae14ce04661",
                                "sense_id": "d9465e2e-83d7-359e-8a05-bdbfad1bbb1e",
                                "text": "In veel kerkelijke gemeenten leven vragen over de verhouding tot de staat Israël. Poorthuis vreest voor een taboeïsering in de kerken. „Het spook van het antisemitisme mag niet maken dat we geen kritiek meer kunnen leveren op de politiek van de staat Israël."
                            },
                            {
                                "example_id": "61f55fce-62a9-44d9-b912-3f6e8ce1b87c",
                                "sense_id": "d9465e2e-83d7-359e-8a05-bdbfad1bbb1e",
                                "text": "Rutjes concludeert uit de lange taboeïsering van begrippen als volkssoevereiniteit en gelijkheid dat „grondbeginselen van een politieke gemeenschap nooit lang als vanzelfsprekendheden gelden. Zij worden op den duur betwist en aangevallen op basis van andere opvattingen over politiek.”"
                            }
                        ]
