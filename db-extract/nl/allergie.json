                        "source_sense_id": "5d94dcf3-026f-3490-91fc-90ef5c056de7",
                        "source_sense_description": "een reactie van het immuunsysteem op lichaamsvreemde stoffen (allergenen), die op zich helemaal niet schadelijk hoeven te zijn",
                        "target_lang_word": "Allergie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allergie",
