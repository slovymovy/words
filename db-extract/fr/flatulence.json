                                        "sense_id": "ee670d9f-e5b9-3b12-b4c9-51f8a7fd7308",
                                        "entry_id": "102fb8b2-714f-3a52-a2bf-e37cf37a7abb",
                                        "glosses": [
                                            "de neiging hebbend om zich belangrijker voor te doen als iemand is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
