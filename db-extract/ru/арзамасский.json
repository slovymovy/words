                                    {
                                        "sense_id": "8cc23037-8273-3d02-805d-48d56a9f9368",
                                        "entry_id": "c1155e9a-f2e2-3156-8032-af3c9d044c67",
                                        "glosses": [
                                            "związany z Arzamasem, dotyczący Arzamasu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2e1f2e-2791-4691-9ce1-a7f9ab7697e2",
                                                "sense_id": "8cc23037-8273-3d02-805d-48d56a9f9368",
                                                "text": "Polacy nie mogli przedostać się do przyczółka, mimo kontrataków Małachowskiego, który pośpieszył im z pomocą oraz jednoczesnego uderzenia pułku Sierawskiego na wołyńców i dragonów arzamaskich"
                                            },
                                            {
                                                "example_id": "c228df19-a4dc-439b-9be0-2c42062bd7a6",
                                                "sense_id": "8cc23037-8273-3d02-805d-48d56a9f9368",
                                                "text": "Najsilniej przy tym zareagowały gęsi chińskie (wiek dojrzewania średnio 150 dni), najpóźniej zaś dojrzewające gęsi arzamaskie skróciły okres dojrzewania z 331 do średnio 212 dni"
                                            }
                                        ],
