                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metamorficzny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "097acdcf-3be0-3f0e-ac28-540af11e8cfa",
                                        "entry_id": "0360b8be-4426-3f8e-b157-a9af1cbc4c17",
                                        "glosses": [
                                            "ulegający przemianie lub powstały w jej wyniku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc99e91e-e04c-4039-99df-1ced7dc2cb4b",
                                                "sense_id": "097acdcf-3be0-3f0e-ac28-540af11e8cfa",
                                                "text": "Archipelag jest zbudowany ze skał pochodzenia wulkanicznego i metamorficznego, których wiek ocenia się na 3 miliardy lat"
                                            },
                                            {
                                                "example_id": "126d86b4-372c-4f25-bc36-f1d6c875d77d",
                                                "sense_id": "097acdcf-3be0-3f0e-ac28-540af11e8cfa",
                                                "text": "Cechą charakterystyczną wirusa metamorficznego jest ciągła edycja jego kodu, która utrudnia jego wykrycie przez program antywirusowy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "629cfaa8-44f2-4cc6-8831-f93c730ccad2",
                        "source_entry_id": "0bd06596-bef8-3528-9111-af1a386ecfac",
                        "source_sense_description": "geology: resulting from intense heat and/or pressure",
                        "target_lang_word": "metamorfovaný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
