                "senses": [
                    {
                        "sense_id": "ea7dbdf6-bd6b-3cf2-a4e7-1897ef19e621",
                        "entry_id": "6ae2b418-4e4f-3ddc-8a81-c8625f1538c5",
                        "glosses": [
                            "(männliche^☆) Person, die als Portier in einem Hotel tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce01f2c-d6f3-486f-82be-cb566b37a6f7",
                                "sense_id": "ea7dbdf6-bd6b-3cf2-a4e7-1897ef19e621",
                                "text": "Jeder Kellner, jeder Hotelportier, jeder Führer, jeder Barbier sprach die Sprache des Tages geläufiger als ich."
                            },
                            {
                                "example_id": "257ed34a-ff19-4e15-b50e-1dc1be940c38",
                                "sense_id": "ea7dbdf6-bd6b-3cf2-a4e7-1897ef19e621",
                                "text": "Der Hotelportier weiß zu berichten, dass kurz vor der Tat an der Rezeption einige Billardqueues für Jefferson abgegeben wurden."
                            },
                            {
                                "example_id": "bc581d8d-652f-4d8f-aa81-b62842ac82e8",
                                "sense_id": "ea7dbdf6-bd6b-3cf2-a4e7-1897ef19e621",
                                "text": "„Der Überfall auf einen 23-jährigen Hotelportier in Bad Radkersbug stelle sich als fingiert heraus.“"
                            },
                            {
                                "example_id": "9f3602ef-69da-41c3-9bc4-d1d78940abaa",
                                "sense_id": "ea7dbdf6-bd6b-3cf2-a4e7-1897ef19e621",
                                "text": "„Und nichts bringt einen Wiener Hotelportier mehr in Schwung, als der Besuch einer Künstlerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
