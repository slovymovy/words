                "senses": [
                    {
                        "sense_id": "995ad512-6aa2-3357-b396-34cb733b36c7",
                        "entry_id": "bf47d266-4724-3ba1-811d-b100b632be9e",
                        "glosses": [
                            "zwarte die uit slavernij naar de wildernis is ontsnapt"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "6f70f8e3-3bd6-4016-90d9-58d17d3d856e",
                                "sense_id": "995ad512-6aa2-3357-b396-34cb733b36c7",
                                "text": "Het ontoegankelijke bos wordt beschreven als bondgenoot van de marrons en als vijand van de blanke. Een oude slaaf waarschuwt: ‘Vluchten is één kans op vrijheid en duizend kansen op een wrede, afschuwelijke dood.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2628a4d-d55e-3702-90bd-0046fb29b3bd",
                        "entry_id": "bf47d266-4724-3ba1-811d-b100b632be9e",
                        "glosses": [
                            "iemand die afstamt van zwarten die uit slavernij naar de wildernis waren ontsnapt"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": [
                            {
                                "example_id": "497f672c-8994-4adf-b626-ad94acf8f43d",
                                "sense_id": "c2628a4d-d55e-3702-90bd-0046fb29b3bd",
                                "text": "Marrons, nakomelingen van ooit gevluchte slaven die leven in de binnenlanden van Suriname en Frans Guyana, hebben hun Afrikaanse genetische erfenis voor 98 procent bewaard."
                            }
                        ]
                    }
