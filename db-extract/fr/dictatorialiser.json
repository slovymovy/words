                "senses": [
                    {
                        "sense_id": "81017d25-27fb-3ddf-b951-6dea43d15f02",
                        "entry_id": "71ffcfb4-7a17-3e4b-b528-e43ecac4e367",
                        "glosses": [
                            "Donner un caractère dictatorial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67bedb3c-af08-45a8-9fe1-00d6c3c564e5",
                                "sense_id": "81017d25-27fb-3ddf-b951-6dea43d15f02",
                                "text": "Eh! oui, dictatorialiser notre profession forme le rêve des grands Pontifes de l’Ordre."
                            },
                            {
                                "example_id": "39c7f4f4-01b4-4d9a-b40d-05af1ea82a00",
                                "sense_id": "81017d25-27fb-3ddf-b951-6dea43d15f02",
                                "text": "L’auteur ne parle que des trois expériences bolchéviste, fasciste et rooseveltienne, en laissant de côté l’Allemagne, le Portugal et tous les autres pays plus ou moins dictatorialisés."
                            }
                        ]
                    }
