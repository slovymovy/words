        "nl-extract.jsonl": [
            {
                "entry_id": "fd115f70-db22-3687-8e8f-aebbd338dc69",
                "word": "losknopen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db32849c-5c34-3976-9825-a7d7b4f86819",
                        "entry_id": "fd115f70-db22-3687-8e8f-aebbd338dc69",
                        "glosses": [
                            "een kledingstuk losmaken door de knopen door het knoopsgat te duwen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5943a110-5325-47cf-a2ec-6acae0e7e643",
                                "sense_id": "db32849c-5c34-3976-9825-a7d7b4f86819",
                                "text": "Hoe hij mij al zoenend op het bed duwde terwijl hij mijn blouse losknoopte (ik dacht dat dit alleen in films soepel kon), hoe hij naar me keek toen ik naakt naast hem lag en hoe we alsof we het al jaren samen deden voor de allereerste keer seks hadden."
                            },
                            {
                                "example_id": "aa805b5f-62a1-4efb-ba00-06d4551a8b57",
                                "sense_id": "db32849c-5c34-3976-9825-a7d7b4f86819",
                                "text": "Vader en dj Sander de Heer organiseert samen met een andere vader Floris Regouin papaklassen. Mannen leren wat een hydrofiele luier is en kijken onder het genot van bier en worst en chips toe hoe je een rompertje losknoopt op zo’n manier dat je de beentjes van de baby er makkelijk doorheen kunt doen. Doe even normaal"
                            }
                        ]
                    },
                    {
                        "sense_id": "79e8c606-dbea-3cc8-a805-c5aba7a7a3e8",
                        "entry_id": "fd115f70-db22-3687-8e8f-aebbd338dc69",
                        "glosses": [
                            "het losmaken van een knoop in een touw of riem"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad9ec7d6-bbc0-41ce-bfdb-b595e14a8744",
                                "sense_id": "79e8c606-dbea-3cc8-a805-c5aba7a7a3e8",
                                "text": "Ik had geen hekel aan zeilen, maar wel aan dat gedoe er omheen. Dat losknopen, bijstellen en hijsen en niet te vergeten het opruimen, oprollen en schoonpoetsen. Nog steeds hou ik niet van werkzaamheden waarvan de bijwerkzaamheden meer tijd kosten dan de actie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68cd1995-1fd3-43f2-b16e-e4db6ea0383b",
                        "source_entry_id": "fd115f70-db22-3687-8e8f-aebbd338dc69",
                        "source_sense_id": "db32849c-5c34-3976-9825-a7d7b4f86819",
                        "source_sense_description": "losmaken van een kledingstuk",
                        "target_lang_word": "unbutton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbutton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93b6f0e5-d40f-3adf-adc1-39ca170b1786",
                                        "entry_id": "60029f00-2f81-3467-b234-453f5b0f8e38",
                                        "glosses": [
                                            "To open (something) by undoing its buttons."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f590baf-6d3a-4082-b5e0-c5f91b3bfde6",
                                                "sense_id": "93b6f0e5-d40f-3adf-adc1-39ca170b1786",
                                                "text": "Being now too high wound up to bear a delay, he unbutton'd, and drawing out the engine of love-assaults, drove it currently, as at a ready-made breach",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
