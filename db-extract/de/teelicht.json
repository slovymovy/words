                "senses": [
                    {
                        "sense_id": "61a6eeed-68df-3eba-8363-42bf59aa9603",
                        "entry_id": "1d4cb183-e4dc-3b60-937c-15e626c17430",
                        "glosses": [
                            "eine kleine Kerze, welche ursprünglich in einem Stövchen zum Warmhalten einer Teekanne diente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de4dab5b-caf0-48bb-9b1c-ef8a988410bb",
                                "sense_id": "61a6eeed-68df-3eba-8363-42bf59aa9603",
                                "text": "Teelichter halten nicht nur den Tee warm, sie sorgen auch für eine angenehme Atmosphäre."
                            },
                            {
                                "example_id": "5d867f98-b5fd-457c-bcba-659e244ee770",
                                "sense_id": "61a6eeed-68df-3eba-8363-42bf59aa9603",
                                "text": "„Da wird dann an jeder einzelnen geschnüffelt und gerochen – und auch wenn sonst nichts gefunden wird, eine Palette Teelichte und das eine oder andere Gebinde Duftkerzen wird garantiert mitgenommen.“"
                            },
                            {
                                "example_id": "5aa08029-893b-4ec2-8756-bf42cfe9cc61",
                                "sense_id": "61a6eeed-68df-3eba-8363-42bf59aa9603",
                                "text": "„Vor einer Buddha-Statue steht ein kleines Teelicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
