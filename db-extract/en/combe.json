            {
                "entry_id": "919037f3-02e3-30e6-b182-8a871af1cb77",
                "word": "combe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "85a19764-a69f-4f58-b9ca-af504c65021d",
                        "entry_id": "919037f3-02e3-30e6-b182-8a871af1cb77",
                        "tags": [
                            "plural"
                        ],
                        "form": "combes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0640fe3f-eca9-357a-98b3-d7a51c38ed76",
                        "entry_id": "919037f3-02e3-30e6-b182-8a871af1cb77",
                        "glosses": [
                            "A valley, often wooded and often with no river"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e05f59-16f4-43f1-b9d7-0b8a3ee76ca9",
                                "sense_id": "0640fe3f-eca9-357a-98b3-d7a51c38ed76",
                                "text": "its long, latticed window [...] looked out on a wild spreading view of hill and heather and wooded combe."
                            },
                            {
                                "example_id": "de850df7-41f1-49a4-bdf5-46fba5c82954",
                                "sense_id": "0640fe3f-eca9-357a-98b3-d7a51c38ed76",
                                "text": "gradual rise the shelving combe displayed."
                            },
                            {
                                "example_id": "49fcca32-4aa7-4796-9e83-d1223731d6b2",
                                "sense_id": "0640fe3f-eca9-357a-98b3-d7a51c38ed76",
                                "text": "You wake up next morning on what looks like Salisbury Plain, only here you climb up the side of every combe, round the end and out the other side."
                            }
                        ]
                    },
                    {
                        "sense_id": "0268fd8d-6f8f-3e62-a89f-0b058205a14e",
                        "entry_id": "919037f3-02e3-30e6-b182-8a871af1cb77",
                        "glosses": [
                            "A cirque."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f41ef1a0-eaeb-4255-a67b-a40d57932e84",
                        "source_entry_id": "919037f3-02e3-30e6-b182-8a871af1cb77",
                        "source_sense_description": "deep, narrow valley",
                        "target_lang_word": "combe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                        "entry_id": "01947da2-18b5-3f76-a696-6e87128a9694",
                                        "glosses": [
                                            "Petite vallée, pli de terrain, lieu bas entouré de collines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68da802f-5722-4f0e-91e2-553dfceb91f8",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Dans ces espèces de plaines au-dessus des montagnes, il se trouve des terrains enfoncés, des vallons secs et froids qu’on appelle des combes."
                                            },
                                            {
                                                "example_id": "60523211-cda6-44bc-9b38-b1c23ee4d693",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Dans une combe, à vingt pas, j’aperçois une manufacture de bas."
                                            },
                                            {
                                                "example_id": "e967c731-3b91-4b2f-a325-1233175abea4",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Mais au fond d’une combe ignorée et stérile Qui pourrait attirer les cupides soldats ?"
                                            },
                                            {
                                                "example_id": "d0b983dc-ba29-427f-bb41-4b0966453862",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Pompées par le soleil, les brumes bleues se dissipèrent : tout au fond des combes feuillues, il n’y eut plus que le moutonnement sans fin des grands arbres, sous la monotonie de la lumière."
                                            },
                                            {
                                                "example_id": "9250592a-8032-4f6e-80d7-ea20f447f1fa",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Assise dans une combe d’herbe, ou à demi enterrée dans le sable chaud et le regard perdu sur la mer, je sais bien qu’elle pense."
                                            },
                                            {
                                                "example_id": "c8189b94-c57f-47c4-b3ed-f6fbf4775fd0",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "Assis sur le parapet du vieux pont, je passais une heure ou deux à regarder cette route sauvage qui conduisait vers les forêts, les combes et les plateaux que tourmente la tramontane."
                                            },
                                            {
                                                "example_id": "3ff0c5c7-3b5c-41c5-9196-fd37f8b16682",
                                                "sense_id": "4c1de02c-e8fc-3b62-a474-1844053d52c4",
                                                "text": "La combe enfle son écho mais, du petit bois, ne reviennent que les coups du hachot, les craquements dans les branchages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae401a1-e51f-371e-afb6-05ff2e937974",
                                        "entry_id": "01947da2-18b5-3f76-a696-6e87128a9694",
                                        "glosses": [
                                            "Esplanade peu étendue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
