                    {
                        "sense_id": "5948006b-4ab7-3a86-a943-64964a74f4ef",
                        "entry_id": "7a8b8fe3-0e5c-3ded-b9c0-effe685b9c61",
                        "glosses": [
                            "de denkbeeldige scheidslijn tussen het noordelijk en zuidelijk halfrond op aarde of op de hemelglobe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e51530d-98d6-41bd-b250-ef44dcc5bc52",
                                "sense_id": "5948006b-4ab7-3a86-a943-64964a74f4ef",
                                "text": "Het vlak van de equator staat haaks op de aardas, midden tussen de polen. en strekt zich uit tot aan de hemelglobe."
                            }
                        ]
                    },
                    {
                        "sense_id": "999c854c-c6ce-3e1f-87a0-ed4ad39ca05c",
                        "entry_id": "7a8b8fe3-0e5c-3ded-b9c0-effe685b9c61",
                        "glosses": [
                            "de grens van het tandvlees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd847287-c80a-4503-a3d4-50872bd078ca",
                                "sense_id": "999c854c-c6ce-3e1f-87a0-ed4ad39ca05c",
                                "text": "De prothetische equator van de afzonderlijke tanden."
                            }
                        ]
