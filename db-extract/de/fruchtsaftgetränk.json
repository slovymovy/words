                                                "example_id": "f17a9de4-7f80-4b54-90df-88ed5eb0e29b",
                                                "sense_id": "21b3a8d0-ad4f-3187-8f1d-22e7aa77a079",
                                                "text": "Сварили густую гороховую кашу, морсу из черники и вишни."
                                            },
