                                        "examples": [
                                            {
                                                "example_id": "6db28020-d785-4e52-974a-737aeeabb6f3",
                                                "sense_id": "d89ade0a-1cc3-3b38-a9af-90df466ef2a2",
                                                "text": "Впервые многодневное голосование в России* было использовано в ходе плебисцита по одобрению поправок к Конституции (25 июня — 1 июля). *Официальная российская статистика включает сведения по аннексированному Крыму"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a93911f-739a-3206-90d1-bd246edb2926",
                                        "entry_id": "61955edb-1e86-348a-8653-a243a6a50db5",
                                        "glosses": [
                                            "рассчитанный на много дней"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcc3e90f-f651-3fc1-aa30-f6d64aa59148",
                                        "entry_id": "61955edb-1e86-348a-8653-a243a6a50db5",
                                        "glosses": [
                                            "появившийся за много дней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eedfea1-cdb0-4043-afde-b664486de7a8",
                                                "sense_id": "dcc3e90f-f651-3fc1-aa30-f6d64aa59148",
                                                "text": "Фома за последние дни заметно сдал: неряшливость в одежде, многодневная щетина, раздражительность по любому поводу."
                                            }
                                        ]
                                    }
                                ]
