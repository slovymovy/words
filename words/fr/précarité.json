                    "sense_definition": "Situation d'instabilité financière ou sociale marquée par l'absence de garanties d'emploi ou de revenus suffisants.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux jeunes diplômés doivent faire face à la <w>précarité</w> de l'emploi au début de leur carrière."
                        },
                        {
                            "text": "Cette association vient en aide aux familles qui vivent dans une grande <w>précarité</w>."
                        }
                    ],
                    "synonyms": [
                        "insécurité",
                        "instabilité",
                        "pauvreté"
                    ],
                    "antonyms": [
                        "sécurité",
                        "stabilité"
                    ],
                    "common_phrases": [
