                        "nl": "Iemand een somber of ongelukkig gevoel geven",
                        "pl": "Sprawiać, że ktoś czuje się smutny lub nieszczęśliwy",
                        "de": "Jemanden traurig oder niedergeschlagen machen",
                        "fr": "Rendre quelqu'un triste ou malheureux.",
                        "it": "Rendere qualcuno triste o infelice",
                        "cs": "Způsobit, že se někdo cítí smutný nebo nešťastný",
                        "tr": "Birini üzgün veya mutsuz hissettirmek",
                        "es": "Hacer que alguien se sienta triste o infeliz.",
                        "zh": "使人感到忧郁或不开心"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удручать",
                                "target_lang_sense_clarification": "вызывать чувство подавленности или грусти"
                            },
                            {
                                "target_lang_word": "нагонять тоску",
                                "target_lang_sense_clarification": "разговорный вариант, вызывать уныние"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "deprimeren",
                                "target_lang_sense_clarification": "iemand somber stemmen"
                            },
                            {
                                "target_lang_word": "neerslachtig maken",
                                "target_lang_sense_clarification": "iemand een neerslachtig gevoel geven"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przygnębiać",
