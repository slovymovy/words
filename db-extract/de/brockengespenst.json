                        "entry_id": "0ec884fa-f582-361b-910b-85ea9ca5e1df",
                        "glosses": [
                            "optischer Effekt, der durch den Schattenwurf von Wanderern im Nebel entsteht und häufig zusammen mit einer Glorie auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f536dc2-b81a-4762-8fe6-623cf3b50089",
                                "sense_id": "b2babfe2-4f5c-3dc8-a13c-def19f36e5c4",
                                "text": "Bei einer seiner Besteigungen des Brocken begegnete Johann Wolfgang von Goethe seinem eigenen Brockengespenst."
                            }
                        ],
