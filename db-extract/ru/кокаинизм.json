                "senses": [
                    {
                        "sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "glosses": [
                            "форма наркомании, при которой объектом пристрастия является кокаин"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd8f0a7-2da8-4245-9ace-262039e1cd36",
                                "sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                                "text": "Кокаинизм приводит к кахексии, быстрому старению, развиваются психозы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2928937-a165-466e-8d54-6348458b328a",
                        "source_entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "source_sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "target_lang_word": "cocainomania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocainomania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf6db214-9a65-36e9-9fe0-ffb6e5b18d4c",
                                        "entry_id": "db701636-d22f-3c79-ad71-21ab53b7f61e",
                                        "glosses": [
                                            "Cocaine addiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42986bb6-ad1a-410a-8abf-0a8e9d8befc1",
                                                "sense_id": "cf6db214-9a65-36e9-9fe0-ffb6e5b18d4c",
                                                "text": "Freud, of Vienna, denies the danger of chronic cocainomania, except in cases of previous morphine or alcohol inebriety, or in cases predisposed to the various forms of inebriety."
                                            },
                                            {
                                                "example_id": "9e406e07-272e-45c0-9f22-5ecd302fe910",
                                                "sense_id": "cf6db214-9a65-36e9-9fe0-ffb6e5b18d4c",
                                                "text": "But, in order that the campaign against cocainomania may be effective, it is desirable that some form of international understanding on the subject should be reached."
                                            },
                                            {
                                                "example_id": "4782be68-5024-47b1-a523-f2ca86d964e5",
                                                "sense_id": "cf6db214-9a65-36e9-9fe0-ffb6e5b18d4c",
                                                "text": "Naturally, some of the drugs are sold in the country and are the reason for the increase of “cocainomania” here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f670a45-c4f8-41cc-88b7-56c52bd52d9e",
                        "source_entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "source_sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "target_lang_word": "cocainismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e1206a60-cdc8-44f8-9d38-77c65a9ac73c",
                        "source_entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "source_sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "target_lang_word": "cocainismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3192f2a9-7a35-46c4-bd98-f2021d9fc5ef",
                        "source_entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "source_sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "target_lang_word": "Kokainsucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kokainsucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                        "entry_id": "5ae65c99-f4fa-3ecb-92bc-597dc7ab43bc",
                                        "glosses": [
                                            "krankhaftes Verlangen zum (regelmäßigen) Konsum von Kokain"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df74c06e-5fb7-42d0-93fa-6bd16e88d9ee",
                                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                                "text": "„Einer Kokainsucht gehen meist Erfahrungen mit legalen und schwächeren Drogen wie Alkohol, Nikotin und Marihuana voraus.“"
                                            },
                                            {
                                                "example_id": "12d3c7d7-0893-4fa2-aafd-128ccbb1013e",
                                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                                "text": "„Eine Reihe medizinischer Experten sagt, dass die Nahrungssucht genauso schwerwiegend ist wie die Nikotin- oder Kokainsucht – und möglicherweise genauso tödlich sein kann.“"
                                            },
                                            {
                                                "example_id": "e4fde5d6-28ce-4851-906e-96640cf750da",
                                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                                "text": "„Die Anwendung des Kokains als Linderungsmittel bei der Morphiumentziehung hat eine der Morphiumsucht ganz entsprechende, aber noch verderblichere Kokainsucht kennen gelehrt.“"
                                            },
                                            {
                                                "example_id": "a69eb597-a52b-4fcd-9518-d3d4dfc3847e",
                                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                                "text": "„Um sieben Uhr stand ich auf und konnte immer noch nicht glauben, dass meine Tochter nun in eine geschlossene Maßnahme kam, zur Entzugstherapie, wegen schwerer Kokainsucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6449293-c98a-4c06-9e33-49f01889ceb5",
                        "source_entry_id": "5be74fb0-d8ec-3791-835e-1b4082e5e9fb",
                        "source_sense_id": "63a88ac1-b3ce-38ed-9015-051fe629b260",
                        "target_lang_word": "cocaïnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocaïnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b3654d1-064c-3196-9329-0d13b198b459",
                                        "entry_id": "30250431-c5fa-3f1e-8b67-64b9c4781258",
                                        "glosses": [
                                            "Intoxication pathologique due à une cocaïnomanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9d58423-44b4-4be0-bae9-2587b4235402",
                                                "sense_id": "8b3654d1-064c-3196-9329-0d13b198b459",
                                                "text": "Les accidents auxquels nous venons de faire allusion sont les accidents du cocaïnisme aigu."
                                            },
                                            {
                                                "example_id": "a92e2b09-4cb4-4b3b-ac52-6482b28dafe0",
                                                "sense_id": "8b3654d1-064c-3196-9329-0d13b198b459",
                                                "text": "Le cocaïsme, c’est-à-dire la mastication de la feuille de coca, se distingue nettement du cocaïnisme, ou consommation de la cocaïne extraite de la feuille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
