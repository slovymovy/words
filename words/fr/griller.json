                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supplice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les récits anciens évoquent des condamnés qu'on faisait <w>griller</w> en place publique."
                        },
                        {
                            "text": "Le tyran menaçait de faire <w>griller</w> tous ceux qui oseraient trahir ses ordres."
