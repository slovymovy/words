                                        "sense_id": "9d290497-d865-3dab-870b-dde36b13cf05",
                                        "entry_id": "f7dab7f9-8572-315b-8973-12f7cc872efa",
                                        "glosses": [
                                            "eine Ordnung aus der Klasse der Gürtelwürmer, wissenschaftlich: Hirudinea"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f07e479-ca11-432a-86ae-6a9ed3c29a3a",
                                                "sense_id": "9d290497-d865-3dab-870b-dde36b13cf05",
                                                "text": "Die Egel zählen sicher nicht zu den beliebtesten Tieren."
                                            },
                                            {
                                                "example_id": "4493b5be-8790-4529-be1c-f4ea363bbe9a",
                                                "sense_id": "9d290497-d865-3dab-870b-dde36b13cf05",
                                                "text": "„Beim Ritt durch hohes, nasses Gras saugen sich Egel an den Beinen der Pferde fest.“"
                                            }
                                        ],
