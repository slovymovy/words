                "senses": [
                    {
                        "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                        "glosses": [
                            "Dont le bord est découpé en dents irrégulières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed70a7a3-f620-40ef-b589-8f8b92968cc2",
                                "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                                "text": "Partout des gazes blanches ou peintes comme les ailes des plus jolies libellules, des crêpes, des dentelles, des blondes, des tulles variés comme les fantaisies de la nature entomologique, découpés, ondés, dentelés, des fils d’aranéide en or, en argent, des brouillards de soie, des fleurs brodées par les fées ou fleuries par des génies emprisonnés, des plumes colorées par les feux du tropique, en saule pleureur autour des têtes orgueilleuses, des perles tordues en nattes, des étoffes laminées, côtelées, déchiquetées, comme si le génie des arabesques avait conseillé l’industrie française."
                            },
                            {
                                "example_id": "ee80aa48-68b7-4589-a407-b071d7a15c51",
                                "sense_id": "3acf7c85-0d01-33d4-bfe2-728b1280dc35",
                                "text": "La feuille de l’orme est dentelée."
                            }
                        ]
                    },
                    {
                        "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                        "glosses": [
                            "Dont le bord est découpé en petites dents fines et serrées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8e7fe4-530c-4b2b-bd4b-ca891b0a309b",
                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                "text": "Médaille dentelée."
                            },
                            {
                                "example_id": "ac805c7e-7e16-4bef-b2f6-733f7d95025b",
                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                "text": "Pièce de blason dentelée."
                            },
                            {
                                "example_id": "cf9a3fe6-37a4-481c-b69a-0bc8fa0544ad",
                                "sense_id": "5656e5c2-31c4-3a54-8b78-2c9820b9532f",
                                "text": "Timbre dentelé."
                            }
                        ]
                    },
                    {
                        "sense_id": "968730ca-80ce-311e-8e64-7c5e020ee4b4",
                        "entry_id": "56c2fde5-c0a7-3ee1-b13f-ebffa360bc26",
                        "glosses": [
                            "Caractérisé par de petits pans alignés et serrés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92957c1-2131-4390-ac17-2b44ee8d40c4",
                                "sense_id": "968730ca-80ce-311e-8e64-7c5e020ee4b4",
                                "text": "La photo, ancienne, avec des bords dentelés, montrait un groupe d'ouvriers alignés sur trois rangs, regardant l'objectif, tous en casquette."
                            }
                        ]
                    }
                ],
