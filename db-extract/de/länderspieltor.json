                "senses": [
                    {
                        "sense_id": "5843974a-8225-3974-9202-3cb41ff244e9",
                        "entry_id": "ec78cb08-473c-3c10-ac39-9e0620f29c4e",
                        "glosses": [
                            "Tor, das bei einer sportlichen Auseinandersetzung zwischen Nationalmannschaften zweier Länder fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09945f3-30eb-4619-bb13-767b96ff2e7c",
                                "sense_id": "5843974a-8225-3974-9202-3cb41ff244e9",
                                "text": "„Sein einziges Länderspieltor gelang ihn im vierten Länderspiel gegen Finnland.“"
                            },
                            {
                                "example_id": "709b17ee-3d0c-4f04-9ca2-e04f69b04b4b",
                                "sense_id": "5843974a-8225-3974-9202-3cb41ff244e9",
                                "text": "„Müller mit seinen Länderspieltoren 33 und 34 (15./60. Minute) sowie sein Bayern-Kollege Joshua Kimmich (45.) mit seinem ersten Nationalmannschaftstreffer sorgten für einen ruhigen Abend.“"
                            },
                            {
                                "example_id": "a95a06dd-7c46-421f-9524-822d032432e3",
                                "sense_id": "5843974a-8225-3974-9202-3cb41ff244e9",
                                "text": "„Für den Profi des VfB Stuttgart war es das erste Länderspieltor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
