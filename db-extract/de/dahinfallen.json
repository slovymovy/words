                "senses": [
                    {
                        "sense_id": "2d2b9653-22bc-3843-9106-ae0f3efc1958",
                        "entry_id": "f5da5cd4-66ff-3cdb-9bbf-a11c06e76306",
                        "glosses": [
                            "nicht mehr in Betracht kommen, nicht mehr begründet/wichtig sein, hinfällig werden"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "especially",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "808b25ca-a362-4d22-8942-4d2c2079f6b1",
                                "sense_id": "2d2b9653-22bc-3843-9106-ae0f3efc1958",
                                "text": "„Als all diese Tricks aber mit der Angleichung des Rechts an internationale Börsen-Gepflogenheiten praktisch dahinfielen, passierte gar nichts, ausser dass ein echter, funktionsfähiger Kapitalmarkt entstand.“"
                            },
                            {
                                "example_id": "625f729c-88a2-46d4-a214-fa374795e635",
                                "sense_id": "2d2b9653-22bc-3843-9106-ae0f3efc1958",
                                "text": "„Ausgleichsabgaben und Ursprungszeugnisse würden bei einer vollständigen Harmonisierung der Außenzölle der gesamten Freihandelszone dahinfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
