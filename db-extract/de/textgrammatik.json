                "senses": [
                    {
                        "sense_id": "17554561-720f-3ec8-b8b8-251c3098421b",
                        "entry_id": "3a6d7539-67b8-3822-bc07-8994af178414",
                        "glosses": [
                            "spezielle Richtung der Textlinguistik, die sich um die Bezüge zwischen den Sätzen eines Textes (= Kohärenzen) bemüht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65841c38-6f46-458b-8ae5-d50745efd457",
                                "sense_id": "17554561-720f-3ec8-b8b8-251c3098421b",
                                "text": "Die Textgrammatik befasst sich mit der Frage, welche sprachlichen Mittel dazu dienen, dass aufeinanderfolgende Sätze nicht wie eine Collage, sondern als eine Einheit mit einem inneren Zusammenhang wirken."
                            },
                            {
                                "example_id": "ab246752-c148-4d13-976b-c317d97d89b9",
                                "sense_id": "17554561-720f-3ec8-b8b8-251c3098421b",
                                "text": "„Mit derartigen Fragestellungen befaßt sich die Textgrammatik; sie kann nicht mehr in einem entscheidbaren Kalkül formalisiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
