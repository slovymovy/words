                                    {
                                        "sense_id": "b4c88dd4-d576-30d2-b77b-3aa9287cb673",
                                        "entry_id": "8f71b872-1b83-34be-b537-fd547240b56c",
                                        "glosses": [
                                            "niski stan wody w akwenie morskim wynikający ze zjawiska pływów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2086dae-3d0f-4593-9f57-3ac99412f387",
                                                "sense_id": "b4c88dd4-d576-30d2-b77b-3aa9287cb673",
                                                "text": "W antwerpskim porcie różnica między odpływem a przypływem wynosi zwykle kilka metrów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ddbbf2fa-572c-339f-a472-9e987c0c07b1",
                                        "entry_id": "8f71b872-1b83-34be-b537-fd547240b56c",
                                        "glosses": [
                                            "ujście, otwór, przez który odpływa skądś woda"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc90912-ce10-4453-9cde-b9e52aba9229",
                                                "sense_id": "ddbbf2fa-572c-339f-a472-9e987c0c07b1",
                                                "text": "Odpływ w wannie zatkał się i nie schodzi nam teraz woda."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "82d61bcc-eade-3b7a-9cc5-dc39b7b3d5a5",
                                        "entry_id": "8f71b872-1b83-34be-b537-fd547240b56c",
                                        "glosses": [
                                            "ubywanie czegoś z danego miejsca"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e82b3b4-2bfb-47e3-b821-a03bbd78b4c3",
                                                "sense_id": "82d61bcc-eade-3b7a-9cc5-dc39b7b3d5a5",
                                                "text": "Sama podwyżka wynagrodzeń nie jest wyjściem, ale może pomóc spowolnić odpływ z zawodu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
