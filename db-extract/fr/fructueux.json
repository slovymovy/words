                                        "examples": [
                                            {
                                                "example_id": "d340ef83-97ad-41e2-ac46-bf0a046e7d98",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "The president delivered an effective speech!"
                                            },
                                            {
                                                "example_id": "9e7874d0-b8ae-4fae-b345-a9436ea9a616",
                                                "sense_id": "0bc59e6c-e3a7-3df1-b8a8-a1d211f79ede",
                                                "text": "Whosoever is an effective, real cause of doing his neighbour wrong, is criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Efficient, serviceable, or operative, available for useful work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03884e67-bda6-4cac-a6cc-675bf35dcbbb",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "How long does it take to make a bunch of civilians an effective military force?"
                                            },
                                            {
                                                "example_id": "cd0b53c0-6a07-4d45-bd1b-a33709e21a07",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "My effective income after taxes and child support is $500 a month."
                                            },
                                            {
                                                "example_id": "f5bfddbf-0512-4471-9c6a-4f7da1dec171",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective radiated power is determined by multiplying the transmitter power output with the antenna gain."
                                            },
                                            {
                                                "example_id": "065ffb7e-cf61-44e2-86c3-e031e92e4214",
                                                "sense_id": "ffac2383-28d0-3b7a-bc89-73be0ff0c496",
                                                "text": "The effective voltage of an alternating current is 0.7 times its peak voltage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Actually in effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c70d38c5-299a-442c-a116-55b98878150d",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "effective immediately"
                                            },
                                            {
                                                "example_id": "e2a3dbee-98cf-4d48-9fc3-6cc9b9b931ce",
                                                "sense_id": "744aa830-5303-3ac1-949a-b70f740055d7",
                                                "text": "The curfew is effective at midnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9576b30d-3f51-3ce5-b03a-72594d4008f8",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Having no negative coefficients."
                                        ],
                                        "tags": [
                                            "of a cycle or divisor"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0636d0b3-9ee3-3eb9-a4de-824261a73174",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "Such that no group element acts trivially."
                                        ],
                                        "tags": [
                                            "of a group action"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36ff4799-ea97-3dd5-b985-9b52714f9e5a",
                                        "entry_id": "cec26415-8373-3bf1-9c4f-e4e18198b6fe",
                                        "glosses": [
                                            "approximate; Not describing the fundamental dynamic changes in some system as they happen."
                                        ],
                                        "tags": [
                                            "for any effective theory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "effective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f760f64-8fa0-3390-99f5-460f2d0dc0b3",
                                        "entry_id": "c1699abd-5509-39d5-8343-c113c87b40b0",
                                        "glosses": [
                                            "a soldier fit for duty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89190bf0-aa25-49d6-bcb8-c8e845a143e7",
                                                "sense_id": "8f760f64-8fa0-3390-99f5-460f2d0dc0b3",
                                                "text": "The Army of the West reached Corinth sometime after the battle of Shiloh. We were 15,000 effectives, and brought Beauregard's effective force up to 45,000 men."
                                            }
