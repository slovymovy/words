                ],
                "senses": [
                    {
                        "sense_id": "77a83389-7240-3f80-8f3c-a0943ba05e2b",
                        "entry_id": "c86cdcc5-f2de-3bb0-9217-725e334f30d9",
                        "glosses": [
                            "aufsteigende Luftbewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346bfd72-e7d2-4f93-baf8-3a6f096a9d84",
                                "sense_id": "77a83389-7240-3f80-8f3c-a0943ba05e2b",
                                "text": "„Das Deltafliegen stellt besonders hohe Ansprüche an die körperliche Leistungsfähigkeit, die physisch-technische Kompetenz, die Geländebeurteilung, das Erspüren von Aufwinden.“"
                            },
                            {
                                "example_id": "b43e5410-8be2-49a4-97a4-bdfadd22e7ee",
                                "sense_id": "77a83389-7240-3f80-8f3c-a0943ba05e2b",
                                "text": "„Bald einmal gehörten die Deltaflieger so selbstverständlich zum Himmel über Vaduz wie die Bussarde und Milane, mit denen sie gemeinsam die Aufwinde nützen.“"
                            },
                            {
                                "example_id": "5e1236b2-7312-46c8-8e3b-9c9954294e12",
                                "sense_id": "77a83389-7240-3f80-8f3c-a0943ba05e2b",
                                "text": "Der Aufwind bescherte dem Segler genug Höhe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "532fad15-a0b0-35ae-b10e-a6a6ef25ab5f",
                        "entry_id": "c86cdcc5-f2de-3bb0-9217-725e334f30d9",
                        "glosses": [
                            "neuer Schwung, Fortschritt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5b4cbb9f-7acc-4937-855c-3bf7940d2bab",
                                "sense_id": "532fad15-a0b0-35ae-b10e-a6a6ef25ab5f",
                                "text": "Nach diesem gewonnenen Satz bekam der Sportler wieder Aufwind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
