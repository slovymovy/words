                "senses": [
                    {
                        "sense_id": "886c6397-8014-382a-bd43-730fa32d0b94",
                        "entry_id": "30209831-00e3-34af-b5e2-019c09bf4259",
                        "glosses": [
                            "Kiste, hergestellt aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f51ec4-85b6-45ec-a0ce-5601a721943e",
                                "sense_id": "886c6397-8014-382a-bd43-730fa32d0b94",
                                "text": "„Bühnenbild und Requisiten sind, in großen Holzkisten verladen, im Lkw von Berlin nach Paris gefahren worden.“"
                            },
                            {
                                "example_id": "38501cc5-cba9-441d-b077-7021acbf08a7",
                                "sense_id": "886c6397-8014-382a-bd43-730fa32d0b94",
                                "text": "„Daneben türmten sich bis zur Decke Fässer und Holzkisten.“"
                            },
                            {
                                "example_id": "80738490-c294-4a94-9e17-4af7e2a1034e",
                                "sense_id": "886c6397-8014-382a-bd43-730fa32d0b94",
                                "text": "„Mit meiner Lampe leuchtete ich die kleine Holzkiste auf meinem Schoß an.“"
                            },
                            {
                                "example_id": "b8fb7d4d-da36-48c0-9a15-5cc8a7a638b3",
                                "sense_id": "886c6397-8014-382a-bd43-730fa32d0b94",
                                "text": "„Deutsche Kriegsgefangene kamen zum Minenräumen ins Dorf, sie sammelten Holzkisten mit Sprengladungen vom Boden auf und warfen sie danach in eine Grube hinter unserer Hecke.“"
                            }
                        ],
