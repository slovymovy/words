                "senses": [
                    {
                        "sense_id": "ec2785b7-5308-3e4d-a1f9-57e93a7cd5ba",
                        "entry_id": "6e36537a-b676-3d4e-9286-e1384ad94272",
                        "glosses": [
                            "nach Stand und Geschlecht abgestuftes Bußgeld bei Verletzung und Totschlag (explizit nicht bei Mord)"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0ada2edb-9179-4a27-b1f5-245869c15170",
                                "sense_id": "ec2785b7-5308-3e4d-a1f9-57e93a7cd5ba",
                                "text": "„Es kommt mir vor, als ob er in seinem Gebirgstale die letzten tausend Jahre verschlafen hätte, denn daß er sich damals in der Bahn vor uns eines Totschlags rühmte, den er vielleicht auch in der Tat begangen hatte, war ein altertümlicher Zug, der an die Zeiten erinnerte, wo man dergleichen mit einem Wergeld oder durch den Waldgang ehrenhaft ordnete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd8affaa-c569-4b69-8905-4177b7e79f76",
                        "source_entry_id": "6e36537a-b676-3d4e-9286-e1384ad94272",
                        "source_sense_id": "ec2785b7-5308-3e4d-a1f9-57e93a7cd5ba",
                        "source_sense_description": "abgestuftes Bußgeld bei Verletzung und Totschlag einer Person",
                        "target_lang_word": "víra",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "víra",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "66ffcfbb-865a-3d91-9ff9-7cfc2e59d308",
                                        "entry_id": "9df08bee-ad63-3ba2-9868-fb9b0ff164f7",
                                        "glosses": [
                                            "pevný názor, že skutečnost je či bude v souladu s představou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65d36dd-b015-4d4d-b39a-f8aa5a0aaf35",
                                                "sense_id": "66ffcfbb-865a-3d91-9ff9-7cfc2e59d308",
                                                "text": "Do Ameriky proudily davy uprchlíků s vírou, že zde najdou lepší životní podmínky."
                                            },
                                            {
                                                "example_id": "f5111b10-247b-4036-bde3-b78f3d334d3e",
                                                "sense_id": "66ffcfbb-865a-3d91-9ff9-7cfc2e59d308",
                                                "text": "V dobré víře jim pomohl, ale vyklubali se z nich darebové."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5852935-f287-397d-a265-cf86b030089d",
                                        "entry_id": "9df08bee-ad63-3ba2-9868-fb9b0ff164f7",
                                        "glosses": [
                                            "soubor názorů odpovídajících danému náboženství"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07e2687-2eb0-4062-960c-dc01173866f2",
                                                "sense_id": "c5852935-f287-397d-a265-cf86b030089d",
                                                "text": "Židovská víra vychází z Bible, neuznává však osobnost Ježíše."
                                            }
                                        ]
                                    }
                                ]
                            },
