                "senses": [
                    {
                        "sense_id": "fe278c63-e68f-3c02-8bf4-107be1b61fb3",
                        "entry_id": "953849e2-67b5-3c90-b5d3-61ce282d5d26",
                        "glosses": [
                            "ein Verhalten oder eine Eigenschaft aufweisend, die nicht der Erwartung an das Geschlecht des betreffenden Individuums entsprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a19ed71-7f61-4eec-b336-66c9aec92a0d",
                                "sense_id": "fe278c63-e68f-3c02-8bf4-107be1b61fb3",
                                "text": "„Dieses Vorgehen ist gekennzeichnet durch ein Nicht-Reagieren auf eine oft elterliche Anfrage, was mit ihrem Kind aufgrund seines als geschlechtsabweichend interpretierten Verhaltens zu tun sei.“"
                            },
                            {
                                "example_id": "50ce14bd-a6f9-4ec5-b294-d283dcc0e83b",
                                "sense_id": "fe278c63-e68f-3c02-8bf4-107be1b61fb3",
                                "text": "„Sie stellen materielle ‚Tätigkeitsformen des Kulturellen‘ (Bachmann-Medick 2010: 9) dar, die gleichsam Zeugnis von der Existenz eines visuellen Archivs zu ‚geschlechtsabweichenden‘ Phänomenen, ablegen, dessen Elemente nicht nur in zeitgenössische mediale Verhandlungen von Transgeschlechtlichkeit Eingang finden, sondern auch das gesellschaftliche Verständnis von Transgeschlechtlichkeit beeinflussen.“"
                            },
                            {
                                "example_id": "743c8c3b-4559-4e87-a74a-57533d86f27f",
                                "sense_id": "fe278c63-e68f-3c02-8bf4-107be1b61fb3",
                                "text": "„Geschlechtsabweichendes Verhalten und Präferenzen allein sind nicht die Basis der Diagnosestellung“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
