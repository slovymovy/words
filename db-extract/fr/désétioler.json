                "senses": [
                    {
                        "sense_id": "92a9fbba-083c-3f7d-a2de-833dc2fdae97",
                        "entry_id": "9b56a4e2-dc47-3392-885d-6d7a4c25988d",
                        "glosses": [
                            "Redonner de la vigueur, faire perdre son caractère étiolé, à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10531c38-8f64-406f-9829-bf95b63e557d",
                                "sense_id": "92a9fbba-083c-3f7d-a2de-833dc2fdae97",
                                "text": "L’occasion d’une croisade utile au grand nombre, utile à la civilisation, utile à la terre entière, — au surplus, flatteuse à l’orgueil européen (mais il me déplaît de faire appel à cet orgueil) — une occasion de croisade nous est offerte : la manquerons-nous ? Ce qui revient à dire : une occasion d’accroître nos âmes, de devenir plus hommes, de « désétioler » nos personnes, de les rendre capables de l’atmosphère éternelle, cette occasion splendide est là."
                            },
                            {
                                "example_id": "629f3ebb-f780-46ff-abea-a4d4110da53e",
                                "sense_id": "92a9fbba-083c-3f7d-a2de-833dc2fdae97",
                                "text": "Femmes aux noms évocateurs d’un monde ignoré, promesses d’un éloignement sans pareil qui se réalisait enfin dans celui de Noura, lumière noire de la vie d’Adrien enfin débarrassé d’encombrantes habitudes, désattaché de son pesant passé, désenglué de ses carapaces étroites, désétiolé de son asphyxie latente, allégé de ses souvenirs lithiques."
                            },
                            {
                                "example_id": "80c1a329-9c2a-4b76-9051-ba6a28bac328",
                                "sense_id": "92a9fbba-083c-3f7d-a2de-833dc2fdae97",
                                "text": "J’ai un petit problème d’étiolage avec certaines de mes plantes… est-il possible de les désétioler ?"
                            }
                        ]
                    }
