                                                "sense_id": "8869c769-5b80-39dd-81c1-b0979d1bff48",
                                                "text": "Acheter des confiseries."
                                            },
                                            {
                                                "example_id": "b83fdf08-ea14-427f-be9d-b98d0ef6e15a",
                                                "sense_id": "8869c769-5b80-39dd-81c1-b0979d1bff48",
                                                "text": "Se régaler de confiseries."
                                            },
                                            {
                                                "example_id": "3ca672a4-ac66-4d41-9b53-b8a40ddc0532",
                                                "sense_id": "8869c769-5b80-39dd-81c1-b0979d1bff48",
                                                "text": "Tout comme le pain d’épice, les confiseries à base de miel ont traversé les siècles dans bien des pays du monde, chacun les adaptant en fonction des produits dont il dispose et de ses habitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdaf5e62-1a76-3507-9ee5-26b9ddead15b",
                                        "entry_id": "4cd0b6ff-2d47-3e59-b91f-887700aa088b",
                                        "glosses": [
                                            "Entreprise qui prépare des olives pour la bouche, pour être mangées et non pour en faire de l'huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92babd8e-7318-435d-a332-3bf01ce3e684",
                                                "sense_id": "bdaf5e62-1a76-3507-9ee5-26b9ddead15b",
                                                "text": "L'industrie agricole est représentée ici par une distillerie importante , une entreprise de détartrage et une confiserie d'olives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "371721d2-474d-4ea2-806b-e743ddbd0838",
                        "source_entry_id": "271d0613-b3b0-38c4-89e7-b38aad0d570b",
                        "source_sense_id": "69c681f3-c071-3050-8bc9-e2733e351182",
                        "source_sense_description": "Lebens- und Genussmittel, die einen süßen Geschmack haben",
                        "target_lang_word": "sucrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sucrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0b1c16-cf25-30f0-9188-05c05f6fc279",
                                        "entry_id": "8cc99373-1007-3b8a-b121-ed43fcba8308",
                                        "glosses": [
                                            "Fabrique de sucre."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9dc53a-61fe-479b-b117-b74c681449e1",
                                                "sense_id": "1e0b1c16-cf25-30f0-9188-05c05f6fc279",
                                                "text": "Les cheminées des sucreries d’Hawamdieh se profilaient au delà, moins laides dans la pénombre que lorsqu’elles troublaient la paix ensoleillée du grand jour."
                                            },
                                            {
                                                "example_id": "283dfb5c-4ef9-4250-b6a0-16f922d9e315",
                                                "sense_id": "1e0b1c16-cf25-30f0-9188-05c05f6fc279",
                                                "text": "Les quotas betteraviers ne sont pas attachés aux terres par le règlement communautaire qui les régit. Ils peuvent l'être par les accords interprofessionnels passés entre les sucreries et les planteurs."
                                            },
                                            {
                                                "example_id": "6f25d8ac-5de8-4c60-9528-c33cb132fc89",
                                                "sense_id": "1e0b1c16-cf25-30f0-9188-05c05f6fc279",
                                                "text": "Dans la nuit du 9 au 10 avril, à Escaudœuvres, près de Cambrai dans le Nord, la digue d’un bassin de décantation de la sucrerie Tereos a cédé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df91e3d4-f81f-3ea7-a87b-62e9831725e2",
                                        "entry_id": "8cc99373-1007-3b8a-b121-ed43fcba8308",
                                        "glosses": [
                                            "Cabane à sucre, érablière."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7b4852-b845-4d47-b713-6c17d465e00e",
                                                "sense_id": "df91e3d4-f81f-3ea7-a87b-62e9831725e2",
                                                "text": "Mais s’occuper d’une sucrerie n’est pas seulement une partie de plaisir. « Je n’arrête pas là de la journée, et j'adore ça. »— (François Vigneault, De policier à producteur de sirop d'érable, il adore son nouveau métier, Radio Canada, 15 avril 2019)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2eaafc6-0884-3225-8567-974961c82e97",
                                        "entry_id": "8cc99373-1007-3b8a-b121-ed43fcba8308",
                                        "glosses": [
                                            "L’industrie du sucre."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1387739b-f701-4c9f-9012-bb47ed82e59c",
                                                "sense_id": "a2eaafc6-0884-3225-8567-974961c82e97",
                                                "text": "Malgré la diminution du nombre d’usines à sucre betteravières qui passe de 384 à 325 et du nombre de départements sucriers métropolitains, de 34 à 22, les progrès de la sucrerie française sont rapides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e7839fd-cee3-3719-9234-27f6e54b2f17",
                                        "entry_id": "8cc99373-1007-3b8a-b121-ed43fcba8308",
                                        "glosses": [
                                            "Friandises où il entre du sucre."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c8c0700-4c2a-4602-bc78-6aadd2a39f39",
                                                "sense_id": "7e7839fd-cee3-3719-9234-27f6e54b2f17",
                                                "text": "Il y eut un arrêt, pendant que la nappe achevait de se charger de fruits et de sucreries."
                                            },
                                            {
                                                "example_id": "dc0aa25a-6eb4-498a-a772-cadbf7b90634",
                                                "sense_id": "7e7839fd-cee3-3719-9234-27f6e54b2f17",
                                                "text": "Un jour dans Fez, le Capitaine de Latte s'arrête à l'éventaire d'un marchand de sucreries arabes."
                                            },
                                            {
                                                "example_id": "c179c368-2f15-409e-8ec5-97e04da75a32",
                                                "sense_id": "7e7839fd-cee3-3719-9234-27f6e54b2f17",
                                                "text": "Le problème avec Christine, ce sont ses enfants qui, loin de se contenter de lui avoir déformé le ventre à jamais, la suivent partout, tout le temps, meute pleurnicharde, gavée de sucreries et de gagatisme infantile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
