                "senses": [
                    {
                        "sense_id": "19a06131-9972-3c2d-82c6-23bba6cd6297",
                        "entry_id": "aa21c69a-dfe6-3674-b4fb-ea4e08ff7dbe",
                        "glosses": [
                            "To burst or split open at definite places, discharging seeds, pollen or similar content."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "171baf9e-bcca-4a26-b97c-ea0dc1dbafab",
                                "sense_id": "19a06131-9972-3c2d-82c6-23bba6cd6297",
                                "text": "Anthers dehisce when the flower opens."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a3ba476-10c4-3268-a509-06c9d7507657",
                        "entry_id": "aa21c69a-dfe6-3674-b4fb-ea4e08ff7dbe",
                        "glosses": [
                            "To rupture or break open, as a surgical wound."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1b1c239d-623c-4242-b8c7-0addaf20c2b8",
                                "sense_id": "2a3ba476-10c4-3268-a509-06c9d7507657",
                                "text": "A surgical wound may partially or completely dehisce after surgery, depending upon whether some or all of the layers of tissue come open."
                            }
                        ]
                    }
                ],
