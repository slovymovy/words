                "senses": [
                    {
                        "sense_id": "8a8041fb-2304-3aa2-bd64-40eca701fe66",
                        "entry_id": "f40c52e8-676c-348d-83bb-548ccda5e351",
                        "glosses": [
                            "Alternative spelling of Li-Lo (“Lindsay Lohan”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "87044564-886b-4eba-ad2c-8c604d8b0089",
                                "sense_id": "8a8041fb-2304-3aa2-bd64-40eca701fe66",
                                "text": "I mean, who cares if LiLo (Lindsay Lohan) has been caught doped (again!) or how low Delta Goodrem's neckline plunges each year in her appearance as judge on The Voice show? […]"
                            },
                            {
                                "example_id": "04c86ec4-b0a0-4fb5-9ae4-320af54668e5",
                                "sense_id": "8a8041fb-2304-3aa2-bd64-40eca701fe66",
                                "text": "LiLo started acting when she was just three years old, and by the late 1990s she'd starred in a slew of Disney films, including The Parent Trap and Freaky Friday."
                            }
                        ]
                    }
