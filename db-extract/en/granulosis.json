                    {
                        "sense_id": "4f8c1368-c694-392c-aeb9-8850894d37cc",
                        "entry_id": "bb85574d-2ce7-37bb-829d-f1bca34a3f6f",
                        "glosses": [
                            "A viral disease that affects many insects."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe2e76f1-3be7-44cd-95a5-bd07df9cf4c7",
                                "sense_id": "4f8c1368-c694-392c-aeb9-8850894d37cc",
                                "text": "The gross pathologies of granuloses are similar to those of nuclear polyhedroses, but differences occur depending on the types of tissues infected."
                            },
                            {
                                "example_id": "276c8a53-5904-4060-8a61-3f16b540e770",
                                "sense_id": "4f8c1368-c694-392c-aeb9-8850894d37cc",
                                "text": "Larvae of the latter developed granulosis after they had been fed leaves dipped in suspensions of crushed, apparently healthy, final-instar Cambridge larvae."
                            },
                            {
                                "example_id": "3a05c090-74bf-4576-a6e1-31134e258e5c",
                                "sense_id": "4f8c1368-c694-392c-aeb9-8850894d37cc",
                                "text": "In Cambridge, England, it is very difficult to rear wild Pieris rapae, the small white butterfly, in captivity since a very high proportion die from a granulosis."
                            },
                            {
                                "example_id": "f622612b-5f75-48c6-8341-dd3ca1a83907",
                                "sense_id": "4f8c1368-c694-392c-aeb9-8850894d37cc",
                                "text": "Each virus particle, as in the case of the nuclear polyhedrosis virus, is surrounded by two membranes, the intimate and developmental membranes. Much less is known about the histopathology of granuloses than polyhedroses."
                            }
                        ]
                    }
