                        ]
                    },
                    {
                        "translation_id": "b9bce4a5-a6c5-4903-927d-535ca54584e1",
                        "source_entry_id": "521de7f0-e586-3d72-aca7-d13a7dbecc78",
                        "source_sense_description": "person",
                        "target_lang_word": "Nichtsnutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtsnutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                        "entry_id": "6a4be8ca-7a3c-3cfe-9eab-d82069cc776e",
                                        "glosses": [
                                            "Person, die zu nichts nützlich und brauchbar ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4acf4750-dab8-4330-ba71-e16916c10cc2",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Ach, Herr Jesu Christ, verdient er jetzt nicht die ärgste Tracht Prügel, die nur auf seinem Buckel Platz hat, der verdammte Nichtsnutz!“"
                                            },
                                            {
                                                "example_id": "f571e095-f26f-4b08-a651-8cc810fe14c8",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "Ihr Nichtsnutze könntet auch mal in den Garten gehen und Laub harken!"
                                            },
                                            {
                                                "example_id": "129e1dc8-38c6-4093-aeb9-77f119dad14b",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Ohne diesen Aberglauben, der lediglich der Furcht entsprang, wäre ich nicht eine Minute länger geblieben; meine Flucht hätte dann Capitani und Francia verraten, daß ich bei weitem kein Magier, sondern ganz einfach ein rechter Nichtsnutz war.“"
                                            },
                                            {
                                                "example_id": "a219e82e-9b6a-4f33-9f9b-4c21385abf06",
                                                "sense_id": "84cebb5c-b2ab-39e2-91e5-140af249336c",
                                                "text": "„Der Sanguiniker Mirabeau lebt aus dem vollen, er ist ein Nichtsnutz, aber gesund an Temperament und immer natürlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bb28224-5931-4b8a-a21c-c8cd1b8b1206",
                        "source_entry_id": "521de7f0-e586-3d72-aca7-d13a7dbecc78",
                        "source_sense_description": "person",
                        "target_lang_word": "Tunichtgut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tunichtgut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                        "entry_id": "cf3cfa0d-7f11-30d8-a4e4-81517a3cee27",
                                        "glosses": [
                                            "jemand, der allerlei ungehörige und nichtsnutzige Dinge treibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3295f7f-15fe-44ad-ae10-b410878db9a4",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "Zwei Tunichtgute wurden jüngst dabei ertappt, wie sie Obst aus dem Pfarrgarten stahlen."
                                            },
                                            {
                                                "example_id": "18665be9-3f89-4a34-a7ab-653d6add6afe",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Apollo Robbins war ein ausgemachter Tunichtgut, ganz ähnlich wie seine missratenen Halbbrüder…“"
                                            },
                                            {
                                                "example_id": "e37352f6-f84d-4a6e-9f50-c84a8ba4ca52",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Doch weil er sich, selbst in betrunkenem Zustand, immer noch wenig redselig zeigte, waren die drei Tunichtgute seiner bald überdrüssig geworden, in eine andere Wirtschaft weitergezogen und hatten ihn allein und bald auch elend zurückgelassen.“"
                                            },
                                            {
                                                "example_id": "876df138-2549-4b0a-a2f4-51f66cfce2b9",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Er war ein junger, leichtfertiger, nicht unbegabter Tunichtgut, der sich auf allerlei Schnurren verstand.“"
                                            },
                                            {
                                                "example_id": "f211ebf2-d555-4363-a0bf-fe21361292d4",
                                                "sense_id": "1d99bb07-67c2-32b6-8e79-8b14681f9b5b",
                                                "text": "„Je nachdem, wie das gelingt, kommt der dann gut vorbereitet (wie nicht selten), und die Welt findet nach dem Tod des Vaters mal einen gut instruierten und ernsthaften Nachfolger, mal einen tändelnden Tunichtgut oder etwas dazwischen vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af3a279b-cb89-4f1d-8426-fac270da45ae",
                        "source_entry_id": "521de7f0-e586-3d72-aca7-d13a7dbecc78",
                        "source_sense_description": "person",
                        "target_lang_word": "Taugenichts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taugenichts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                        "entry_id": "d8f790fb-3b15-3ff8-913e-869ab404e4c5",
                                        "glosses": [
                                            "Person, die zu nichts nützlich oder brauchbar ist"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da229c1-7a5d-4842-9796-9839bd88ae7a",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Er war schon immer ein Taugenichts."
                                            },
                                            {
                                                "example_id": "7a4d9162-034b-4c14-b4fe-a992adc1a212",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "Dein Sohn ist ein richtiger Taugenichts; er hat nur Unfug im Sinn."
                                            },
                                            {
                                                "example_id": "2fe6fde3-81d4-43fc-91d9-bbdc42629fda",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„So einen löblichen Vatter Wenceslaus gehabt, so wenig ahmte er doch demselben in seiner Regierung nach, indem ihn nichts, als seine Faulheit, Tyranney, und Unmäßigkeit der Nachwelt bekant gemacht haben, uṅ [und] er, mit einem Wort, ein rechter Taugenichts gewesen ist.“"
                                            },
                                            {
                                                "example_id": "8fe3fd79-b318-48fd-8fb1-4e336b0a6b64",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Wir bringen es leicht fertig, die Armen, die von staatlichen Zuwendungen leben, als Taugenichtse zu beschimpfen.“"
                                            },
                                            {
                                                "example_id": "d33f8e77-55ef-455b-9a21-b0a80ead9ae7",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Daß wir hier schon zahlreiche Vorgänger gehabt hatten, verrieten die Wände, die als Fremdenbuch dienten und auf die alle Taugenichtse der Welt ihren Namen geschrieben oder geritzt hatten.“"
                                            },
                                            {
                                                "example_id": "079748a7-efde-49dd-ae36-a89bc3beb42d",
                                                "sense_id": "1ffb08fb-1cfc-3b96-822f-37691748e8fb",
                                                "text": "„Han's jüngerer Bruder Han Dau-gwe (das ist der Faselhans) war ein Spieler und Taugenichts.“"
                                            }
