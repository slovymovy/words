                "senses": [
                    {
                        "sense_id": "e14592e8-feb9-3901-bcf7-5c6247399a67",
                        "entry_id": "3ebda534-bf83-3bc8-9afe-134fc88762d5",
                        "glosses": [
                            "Enzyme de la classe des peptidases, appelée ainsi en raison de la présence dans son site actif d’un ion métallique (zinc, souvent) qui participe à la catalyse de la coupure de la liaison peptidique dans les protéines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "613d75af-108c-4bad-b5dc-5b098b574bc1",
                                "sense_id": "e14592e8-feb9-3901-bcf7-5c6247399a67",
                                "text": "La principale physiopathogenèse est un déficit sévère en métalloprotéase (ADAMTS13) dont le rôle est de cliver les multimères du FvW."
                            },
                            {
                                "example_id": "21ec7679-4fad-402c-8a4b-a1e408efaba2",
                                "sense_id": "e14592e8-feb9-3901-bcf7-5c6247399a67",
                                "text": "Ci-dessous, des informations plus détaillées sont données pour les thrombospondines, l’angiostatine, l’endostatine, le fragment hémopexine (PEX) de la métalloprotéase MMP2 et le facteur plaquettaire-4 (PF-4)."
                            },
                            {
                                "example_id": "8bbd3dec-fa2f-460f-ac04-4a8c08049fd6",
                                "sense_id": "e14592e8-feb9-3901-bcf7-5c6247399a67",
                                "text": "Les inhibiteurs de métalloprotéases matricielles possèdent un potentiel thérapeutique dans la lutte contre l’invasion métastasique."
                            }
                        ]
                    }
                ],
