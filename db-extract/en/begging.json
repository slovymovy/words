                            {
                                "target_word": "manche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                        "entry_id": "7fc70b14-42f5-35f2-90f3-ad23006db4e3",
                                        "glosses": [
                                            "Personne maladroite, qui s’y prend mal, ne répond pas à ce que l’on attend d’elle."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2b1546-81fe-4f36-a438-dd8d09e87396",
                                                "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                                "text": "Conduire comme un manche."
                                            },
                                            {
                                                "example_id": "f1ac81e1-3d6a-4ce1-9211-d5cbc9e7c209",
                                                "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                                "text": "Ben quoi, Compain ! Il est sourd, c’manche-là !"
                                            },
                                            {
                                                "example_id": "1897dea6-2142-4e51-9009-3b49e44e8ae1",
                                                "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                                "text": "Nous avons creusé pendant deux ans sauf le dimanche\nY a rien de plus dur que cette salop'rie d’béton\nNous quatre Dudule on peut pas dire qu’on soye des manches\nMais j'aim’rais mieux faire, comme les marchands d’gruyère,\ndes trous dans du from’ton."
                                            },
                                            {
                                                "example_id": "2f15e84b-98f6-4c87-bf8c-ff5e4425b97a",
                                                "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                                "text": "— C’est pas un manche, Decambrais."
                                            },
                                            {
                                                "example_id": "1e9cb710-f083-4c1c-8c0c-02a9e598bfdb",
                                                "sense_id": "20cf51b3-e656-3178-8198-dee72dffcfb5",
                                                "text": "Rires dans la classe. Bête comme ses pieds, Paulie Fielder. Un vrai manche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
