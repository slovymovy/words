                "senses": [
                    {
                        "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                        "entry_id": "04d01209-aff3-3cc6-ab7b-3250d639b587",
                        "glosses": [
                            "Person mit viel Lauferfahrung; Person, die durch häufiges oder langjähriges Laufen umfangreiche Kenntnisse, Fähigkeiten und Erlebnisse im Laufen gesammelt hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "54db7baf-b400-4585-b4d3-3e72adecda77",
                                "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                                "text": "„Es spielte keine Rolle, ob Lauferfahrene oder Laufanfänger, gemeinsam haben wir einen sportlichen und spaßigen Tag erlebt!“"
                            },
                            {
                                "example_id": "ec6965ed-e86e-4095-8f1a-1ef3f6ef12b4",
                                "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                                "text": "„Nach wochenlanger Vorbereitung durch die Lauferfahrenen ging es für unsere beiden Ärzte Dr. Ghafar und Oskar Aviles sowie für unseren Buchhalter David Bartz in den ersten Lauf-Wettkampf.“"
                            },
                            {
                                "example_id": "904bfafd-08fc-44a4-8759-2eeea95f696a",
                                "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                                "text": "„Die Anfangs erwähnte Laufstrecke von 11,5 km nahmen nur unsere beiden Lauferfahrenen Dirk Müller und Andreas Sawall in Angriff.“"
                            },
                            {
                                "example_id": "0f7d36fb-6e08-44e7-92e8-866758e21121",
                                "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                                "text": "„Egal ob Anfänger oder Lauferfahrene – Jogging ist eine Form des Ausdauertrainings und stärkt nicht nur die körperliche Ausdauer, sondern auch die physische Leistungsfähigkeit.“"
                            },
                            {
                                "example_id": "440c1898-3609-4ec7-a727-e83a2ff86ea5",
                                "sense_id": "3f611489-83f6-3633-ba09-db29f5b4f3de",
                                "text": "„Ein intensives, jedoch wertungsfreies Gemeinschaftserlebnis für Groß und Klein, Jung und Alt, Lauferfahrene und Einsteiger bietet der Jedermannslauf über 3,5 km.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
