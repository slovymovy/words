    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ad37258-53d4-3e33-b817-ed4e75b73e4f",
                    "sense_definition": "The state of living, occurring, or having objective reality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization has been in <w>existence</w> for more than a century.",
                            "target_lang_translations": {
                                "ru": "Эта организация продолжает свое <w>существование</w> уже более века.",
                                "tr": "Örgüt bir asırdan fazla süredir <w>varlığını</w> sürdürmektedir.",
                                "zh": "该组织已经<w>存在</w>一个多世纪了。"
                            }
                        },
                        {
                            "text": "Scientists are trying to prove the <w>existence</w> of life on other planets.",
                            "target_lang_translations": {
                                "ru": "Ученые пытаются доказать <w>существование</w> жизни на других планетах.",
                                "tr": "Bilim insanları başka gezegenlerde yaşamın <w>varlığını</w> kanıtlamaya çalışıyor.",
                                "zh": "科学家们正试图证明其他星球上生命<w>存在</w>的事实。"
                            }
                        }
                    ],
                    "synonyms": [
                        "being",
                        "presence"
                    ],
                    "antonyms": [
                        "nonexistence",
                        "nothingness"
                    ],
                    "common_phrases": [
                        "come into existence",
                        "in existence",
                        "struggle for existence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние жизни, присутствия или обладания объективной реальностью",
                        "tr": "Yaşama, var olma veya nesnel bir gerçekliğe sahip olma durumu.",
                        "zh": "指生命、发生或具有客观现实的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существование",
                                "target_lang_sense_clarification": "жизнь, наличие, факт бытия"
                            },
                            {
                                "target_lang_word": "бытие",
                                "target_lang_sense_clarification": "жизнь, существование (высокий стиль)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "varlık",
                                "target_lang_sense_clarification": "var olma durumu, mevcudiyet"
                            },
                            {
                                "target_lang_word": "varoluş",
                                "target_lang_sense_clarification": "var olma olgusu, mevcudiyet"
                            },
                            {
                                "target_lang_word": "mevcudiyet",
                                "target_lang_sense_clarification": "bulunma, var olma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "指事物客观地处于某种状态或现实中"
                            },
                            {
                                "target_lang_word": "生存",
                                "target_lang_sense_clarification": "侧重于生命体的存活状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47581ac-1901-34db-9aab-f235e5ade685",
                    "sense_definition": "Empirical reality; the substance of the physical universe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers have long debated the true nature of <w>existence</w>.",
                            "target_lang_translations": {
                                "ru": "Философы долго спорили об истинной природе <w>бытия</w>.",
                                "tr": "Filozoflar uzun zamandır <w>varoluşun</w> gerçek doğasını tartışmaktadır.",
                                "zh": "哲学家们长期以来一直在争论<w>存在</w>的本质。"
                            }
                        },
                        {
                            "text": "He questioned whether the physical world is the only form of <w>existence</w>.",
                            "target_lang_translations": {
                                "ru": "Он задавался вопросом, является ли физический мир единственной формой <w>бытия</w>.",
                                "tr": "Fiziksel dünyanın <w>varoluşun</w> tek biçimi olup olmadığını sorguladı.",
                                "zh": "他质疑物理世界是否是<w>存在</w>的唯一形式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "being"
                    ],
                    "antonyms": [
                        "nothingness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмпирическая реальность; материя физической вселенной",
                        "tr": "Ampirik gerçeklik; fiziksel evrenin özü veya maddesi.",
                        "zh": "经验现实；物理宇宙的本质或实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бытие",
                                "target_lang_sense_clarification": "философская категория реальности"
                            },
                            {
                                "target_lang_word": "существование",
                                "target_lang_sense_clarification": "реальность, действительность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "varoluş",
                                "target_lang_sense_clarification": "felsefi anlamda var olma olgusu"
                            },
                            {
                                "target_lang_word": "varlık",
                                "target_lang_sense_clarification": "var olan her şey, nesnel gerçeklik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存在",
                                "target_lang_sense_clarification": "指客观世界的现实性"
                            },
                            {
                                "target_lang_word": "本体",
                                "target_lang_sense_clarification": "哲学上指事物的本质或存在本身"
                            }
                        ]
