                "senses": [
                    {
                        "sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                        "entry_id": "6a5272e7-9c84-30c4-b427-07bc59200faa",
                        "glosses": [
                            "1 000 Byte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc69097-db28-426b-bf50-8521e8cd533c",
                                "sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                                "text": "Diese Diskette hat ein Speichervolumen von 1 440 Kilobyte(s)."
                            },
                            {
                                "example_id": "62c7e6d9-9051-4cd8-877c-a49fbac1191d",
                                "sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                                "text": "„1 Kilobyte (KByte) müsste demnach 1000 Byte entsprechen, in der Praxis sind es jedoch 1024 Byte. Ein Megabyte (MByte) entspricht ebenfalls nicht 1.000.000 Bytes, sondern 1.048.576 Bytes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b739545a-afa4-32f9-b7ea-6096ae57bd80",
                        "entry_id": "6a5272e7-9c84-30c4-b427-07bc59200faa",
                        "glosses": [
                            "1 024 Byte (siehe Kibibyte)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c99e67b-8047-4b34-90ce-2604fd7c1c60",
                                "sense_id": "b739545a-afa4-32f9-b7ea-6096ae57bd80",
                                "text": "„1 Kilobyte (KByte) müsste demnach 1000 Byte entsprechen, in der Praxis sind es jedoch 1024 Byte. Ein Megabyte (MByte) entspricht ebenfalls nicht 1.000.000 Bytes, sondern 1.048.576 Bytes.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a84ffe8-4105-415f-9872-6df7adcc13a8",
                        "source_entry_id": "6a5272e7-9c84-30c4-b427-07bc59200faa",
                        "source_sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                        "target_lang_word": "kilobyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kilobyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e075747f-a47f-3d95-a89a-0832feb03666",
                                        "entry_id": "394bc8c8-9987-3851-bf85-20258cd73183",
                                        "glosses": [
                                            "One thousand (10³, or 1,000) bytes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f28c0ed5-c2fd-4890-89fe-6feccd6377b9",
                                                "sense_id": "e075747f-a47f-3d95-a89a-0832feb03666",
                                                "text": "The data word processor 606 handles the in-flow and out-flow of byte-oriented input/output data and interleaved signals at a rate of, for example, 500 kilobytes per second. Instruction processing rates of four to eight per microsecond are required for such a data flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f63b638-4b80-31dd-b948-afe877ac15dc",
                                        "entry_id": "394bc8c8-9987-3851-bf85-20258cd73183",
                                        "glosses": [
                                            "A kibibyte."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "967c8721-bc46-487a-a9a0-b32eefeeddef",
                                                "sense_id": "1f63b638-4b80-31dd-b948-afe877ac15dc",
                                                "text": "It is assumed herein that each block includes 32 bytes, each sector includes 1 kilobyte, the buffer memory 116 includes 4 kilobytes, and read data is represented by one double word or 64 bits, as one word in this case consists of 32 bits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
