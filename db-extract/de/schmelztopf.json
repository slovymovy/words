                    {
                        "sense_id": "9e1aec1a-ce06-3dff-9e31-f2fee1ba6b4b",
                        "entry_id": "a1024628-b746-348f-8736-5e6cc3b81b8f",
                        "glosses": [
                            "melting pot"
                        ],
