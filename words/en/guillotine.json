{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a696bc2-1685-372c-bf37-b2799a01e0b0",
                    "sense_definition": "A machine used for capital punishment by decapitation, having a heavy blade that drops down an upright frame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The French revolutionaries used the <w>guillotine</w> to execute thousands of political prisoners.",
                            "target_lang_translations": {
                                "zh": "法国大革命者用<w>断头台</w>处决了数以千计的政治犯。"
                            }
                        },
                        {
                            "text": "King Louis XVI was sentenced to death and sent to the <w>guillotine</w> in 1793.",
                            "target_lang_translations": {
                                "zh": "国王路易十六被判处死刑，并于1793年被送上了<w>断头台</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "send to the guillotine"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于斩首死刑的器械，由直立框架和沿其下落的重型刀片组成；断头台。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "断头台",
                                "target_lang_sense_clarification": "执行死刑的刑具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca67bef4-31b8-3dd3-910d-018a7872f6c4",
                    "sense_definition": "A device with a heavy blade used to trim or cut sheets of paper or the edges of books.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when trimming the leaflets with the paper <w>guillotine</w>.",
                            "target_lang_translations": {
                                "zh": "用<w>切纸机</w>裁切传单时要小心。"
                            }
                        },
                        {
                            "text": "The printing company bought a new <w>guillotine</w> to cut large volumes of card.",
                            "target_lang_translations": {
                                "zh": "这家印刷公司买了一台新的<w>裁纸机</w>来切割大量的卡纸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paper cutter"
                    ],
                    "common_phrases": [
                        "paper guillotine"
                    ],
                    "target_lang_definitions": {
                        "zh": "带有重型刀片、用于裁切纸张或书本边缘的切纸机。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "切纸机",
                                "target_lang_sense_clarification": "裁切纸张或书边的机械工具"
                            },
                            {
                                "target_lang_word": "裁纸机",
                                "target_lang_sense_clarification": "切纸或修整纸张边缘的设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e7cb5da-ba39-3b43-9138-2ff6fc5921c0",
                    "sense_definition": "A legislative procedure or motion that sets a strict time limit on debate before taking a vote.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government imposed a <w>guillotine</w> to speed up the passage of the controversial bill.",
                            "target_lang_translations": {
                                "zh": "政府推行了<w>限时辩论程序</w>，以加速这项争议法案的通过。"
                            }
                        },
                        {
                            "text": "Opposition members protested against the use of the <w>guillotine</w> during the debate.",
                            "target_lang_translations": {
                                "zh": "反对党成员在辩论期间对抗议使用<w>截止辩论动议</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cloture"
                    ],
                    "common_phrases": [
                        "guillotine motion"
                    ],
                    "target_lang_definitions": {
                        "zh": "议会中为限制辩论时间并强行付诸表决的程序或动议；终止辩论动议。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "截止辩论动议",
                                "target_lang_sense_clarification": "议会中限制辩论时间的动议"
                            },
                            {
                                "target_lang_word": "限时辩论程序",
                                "target_lang_sense_clarification": "强行限制辩论时间并投票的议会程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b59d76d-5f48-372f-a4f9-61a6467fa7ff",
                    "sense_definition": "A surgical instrument with a sliding blade used for removing tonsils or other small growths.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon used a specialized <w>guillotine</w> to excise the patient's tonsils.",
                            "target_lang_translations": {
                                "zh": "外科医生使用专门的<w>扁桃体切除器</w>切除了患者的扁桃体。"
                            }
                        },
                        {
                            "text": "Early twentieth-century doctors commonly relied on a tonsil <w>guillotine</w> during operations.",
                            "target_lang_translations": {
                                "zh": "二十世纪初的医生在手术中通常依赖扁桃体<w>切除器</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tonsillotome"
                    ],
                    "common_phrases": [
                        "tonsil guillotine"
                    ],
                    "target_lang_definitions": {
                        "zh": "带有滑动刀片、用于切除扁桃体等小增生物的外科手术器械；扁桃体切除器。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扁桃体切除器",
                                "target_lang_sense_clarification": "外科手术器械"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "624ac4ae-1d97-3d6c-8725-08e8c7e2b72b",
                    "sense_definition": "To execute someone by cutting off their head with a guillotine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several prominent nobles were <w>guillotined</w> during the Reign of Terror.",
                            "target_lang_translations": {
                                "zh": "在恐怖统治时期，几位显赫的贵族被<w>用断头台处决</w>。"
                            }
                        },
                        {
                            "text": "The rebel leader was captured and eventually <w>guillotined</w> in public.",
                            "target_lang_translations": {
                                "zh": "叛军首领被俘，并最终被公开<w>斩首</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "behead",
                        "decapitate"
                    ],
                    "target_lang_definitions": {
                        "zh": "用断头台斩首处决（某人）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用断头台处决",
                                "target_lang_sense_clarification": "通过断头台斩首"
                            },
                            {
                                "target_lang_word": "斩首",
                                "target_lang_sense_clarification": "切断头部处死"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c9a9756-1b5e-34fc-aa6a-9f2f139018c1",
                    "sense_definition": "To cut, trim, or slice something using a mechanical cutting device.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The printer will <w>guillotine</w> the sheets to fit the standard envelope size.",
                            "target_lang_translations": {
                                "zh": "印刷工会把纸张<w>裁切</w>成符合标准信封的尺寸。"
                            }
                        },
                        {
                            "text": "She carefully <w>guillotined</w> the edges of the newly bound book.",
                            "target_lang_translations": {
                                "zh": "她小心翼翼地把刚装订好的书边<w>切齐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trim"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用机械裁切设备裁切、修剪（纸张等）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "裁切",
                                "target_lang_sense_clarification": "用切纸设备修整或切开"
                            },
                            {
                                "target_lang_word": "切齐",
                                "target_lang_sense_clarification": "用机器切齐边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab65102f-c2e1-32e2-9506-ea0baaa85bfc",
                    "sense_definition": "To cut short or conclude a legislative debate by invoking a guillotine procedure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ministers decided to <w>guillotine</w> the debate to ensure the law passed before recess.",
                            "target_lang_translations": {
                                "zh": "部长们决定<w>强行终止</w>辩论，以确保法律在休会前通过。"
                            }
                        },
                        {
                            "text": "The ruling party voted to <w>guillotine</w> discussion on the contentious reform bill.",
                            "target_lang_translations": {
                                "zh": "执政党投票决定<w>限时结束</w>对这项争议性改革法案的讨论。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "guillotine a bill",
                        "guillotine debate"
                    ],
                    "target_lang_definitions": {
                        "zh": "在立法辩论中通过实行限时程序强行终止辩论。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "强行终止",
                                "target_lang_sense_clarification": "限制时间以提早结束辩论"
                            },
                            {
                                "target_lang_word": "限时结束",
                                "target_lang_sense_clarification": "通过议会限时动议终止讨论"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}