                                                "sense_id": "0f9253c3-0d0a-34a3-95d7-b8ea9a3090e0",
                                                "text": "―I’ve got someone on the line.\n―Who’s the caller?"
                                            },
                                            {
                                                "example_id": "28362a65-f5cd-4564-8f6b-785cae5643b4",
                                                "sense_id": "0f9253c3-0d0a-34a3-95d7-b8ea9a3090e0",
                                                "text": "Thaler was arrested in Orono last May when a caller reported that the car she was driving had a shattered rear window and a blown-out tire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0471aa8f-b23d-3e33-a630-9c3f08441baa",
