                                        "entry_id": "db33807c-72cc-300e-8cf4-89b4f10076ea",
                                        "glosses": [
                                            "Of or containing pebbles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d46815f-265a-422c-bff2-56a0aa96218a",
                                                "sense_id": "9c601528-042c-38ee-8ca9-cf90aed8c530",
                                                "text": "\"Ha,\" said Robin, \"comest thou from Locksley Town? Well do I know that fair place for miles about, and well do I know each hedgerow and gentle pebbly stream, and even all the bright little fishes therein, for there I was born and bred. Now, where goest thou with thy meat, my fair friend?\""
                                            },
                                            {
                                                "example_id": "eab460d8-3b09-4293-b4ba-dfcd15abd591",
                                                "sense_id": "9c601528-042c-38ee-8ca9-cf90aed8c530",
                                                "text": "The balance of that day we spent in continuing a minute and fruitless exploration of the monotonous coast. There was not another break in the frowning cliffs--not even another minute patch of pebbly beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f833938-3014-3eb4-af72-c66f5a8e259f",
                                        "entry_id": "db33807c-72cc-300e-8cf4-89b4f10076ea",
                                        "glosses": [
                                            "With a surface like that of pebbles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b194b7-ff84-48a4-9aa1-cbee46f74e1b",
                                                "sense_id": "7f833938-3014-3eb4-af72-c66f5a8e259f",
                                                "text": "Mr Rottcodd turned his pebbly eyes away."
                                            }
                                        ]
                                    }
                                ]
                            }
