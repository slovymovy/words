                        ],
                        "form": "pharmaciennes"
                    },
                    {
                        "form_id": "79267001-7fef-4d29-90ce-b5754f6e2aa8",
                        "entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                        "tags": [
                            "masculine"
                        ],
                        "form": "pharmacien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f363dc9-dffc-3ad0-af0f-db5aa86b522f",
                        "entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                        "glosses": [
                            "Celle qui exerce la pharmacie."
                        ],
                        "tags": [
                            "Métier",
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "f39b438d-0e50-480f-96e1-63c8c8a33286",
                                "sense_id": "4f363dc9-dffc-3ad0-af0f-db5aa86b522f",
                                "text": "C’est le cas par exemple d’une propriétaire d’une petite pharmacie proche d’un grand hôpital parisien (deux pharmaciennes, trois stagiaires et une femme de ménage) : diplômée de pharmacie et de biologie, elle a complètement informatisé la comptabilité, la gestion des stocks et des commandes, pour exercer des activités syndicales et pour s’investir dans les pathologies complexes en lien avec le transfert récent de la délivrance de certains médicaments des pharmacies d’hôpital aux officines (Entretien avec une pharmacienne propriétaire, juin 2006, Paris)."
                            },
                            {
                                "example_id": "22d8f59f-dfca-4759-9de6-59dbd0c8d1d1",
                                "sense_id": "4f363dc9-dffc-3ad0-af0f-db5aa86b522f",
                                "text": "Le service pharmaceutique y est le plus souvent assuré par une religieuse, la « sœur pharmacienne », certainement dévouée mais presque toujours dépourvue d’une formation « théorique » qui est remplacée par des connaissances empiriques liées à une (longue) pratique."
                            },
                            {
                                "example_id": "a99cf0f0-a8be-417c-8bb1-31d84c34b339",
                                "sense_id": "4f363dc9-dffc-3ad0-af0f-db5aa86b522f",
                                "text": "En 1978, le lendemain du réveillon, Danielle Judic, pharmacienne à Belle-Île, disparaissait sans laisser de trace."
                            }
                        ]
                    },
                    {
                        "sense_id": "1687d59a-6643-3fad-b6a4-463241b129b5",
                        "entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                        "glosses": [
                            "Épouse d’un pharmacien."
                        ],
                        "tags": [
                            "familiar",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5cf2d2-7521-4683-89f7-203b7d94ecb3",
                                "sense_id": "1687d59a-6643-3fad-b6a4-463241b129b5",
                                "text": "Qui se refuserait à une dépense d’un millier de roubles, quand il s’agit d’empêcher que, dans la ville, il ne soit dit que la capitainesse, la doctoresse, la pharmacienne, la négociante, la popesse avait une plus belle robe ?"
                            },
                            {
                                "example_id": "5466073d-16d3-4c4a-b4fa-03571bff62b5",
                                "sense_id": "1687d59a-6643-3fad-b6a4-463241b129b5",
                                "text": "Sur le point d’être saisi, M. Pasquier se réfugia dans la boutique du pharmacien dans le comptoir de duquel trônait la pharmacienne, petite boulotte très-coquette qui tâchait de dissimuler ses cheveux rouges sous une perruque blonde, frisée à la Titus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34335f30-ca09-4547-8dca-4dc97cbba95d",
                        "source_entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
                        "source_sense_description": "Femme qui exerce la pharmacie",
                        "target_lang_word": "Apothekerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apothekerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                        "entry_id": "e5517c9e-5a4a-36e9-91c9-58128c496414",
                                        "glosses": [
                                            "Fachfrau für Arzneimittel; typischerweise Inhaberin oder auch Angestellte einer Apotheke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167933f6-4a7c-4f1f-895f-0f22a41056c0",
                                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                                "text": "Ich lasse mich gern von einer Apothekerin beraten."
                                            },
                                            {
                                                "example_id": "404491e7-7a98-4174-97e2-53c42aae4adf",
                                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                                "text": "„Die Apothekerin öffnet den Anar und hält mir eine Kammer hin.“"
                                            },
                                            {
                                                "example_id": "5a3096e9-2676-4fc9-a12a-d7d33ac4bc81",
                                                "sense_id": "dea60afc-727a-3830-8aad-23ccc89d2cbc",
                                                "text": "„Die ungeheure Sammlung führt zugleich durch alle weiblichen Berufe, von der Blumenverkäuferin bis zur Juwelierin und Apothekerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "290ba18b-256a-4917-a48a-c9c9e3a904e9",
                        "source_entry_id": "6fd2be52-06bb-3ca5-8bdd-8495dbe54358",
