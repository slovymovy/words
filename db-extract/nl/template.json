                                        "sense_id": "74c1b2c8-df78-3db0-a5f6-513a16f45acd",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A strip of metal used in boiler-making, pierced with a series of holes, and serving as a guide in marking out a line of rivet-holes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a10d2e3f-0704-327a-9d17-cdce0609613d",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
