                            "prepositional"
                        ],
                        "form": "бра́тике"
                    },
                    {
                        "form_id": "8d25bd7b-53ef-42f7-a5f8-8a2d6947d489",
                        "entry_id": "fbadf683-f6e7-38ae-bd59-3930fd4aa6ef",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "бра́тиках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f45ac43f-2e67-3f85-b755-6aa99f77dbae",
                        "entry_id": "fbadf683-f6e7-38ae-bd59-3930fd4aa6ef",
                        "glosses": [
                            "уменьш. к брат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e076cd92-40de-4190-a894-9ab7d1c63aaf",
                                "sense_id": "f45ac43f-2e67-3f85-b755-6aa99f77dbae",
                                "text": "— Кто это тебя, несчастную, так размалевал? — Братики… — кротко отвечала маленькая"
                            }
                        ]
                    },
                    {
                        "sense_id": "f36a3b02-911e-361c-8fdb-79dc632b50bb",
                        "entry_id": "fbadf683-f6e7-38ae-bd59-3930fd4aa6ef",
                        "glosses": [
                            "ласк. к брат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a091ca92-eea3-4a17-806d-adb60cce4a5e",
                                "sense_id": "f36a3b02-911e-361c-8fdb-79dc632b50bb",
                                "text": "Мы все находились в доме: наш сосед, его жена, мама, сестричка, братик и я."
                            },
                            {
                                "example_id": "3a3cd9ab-d105-463c-a483-50c31b756d2a",
                                "sense_id": "f36a3b02-911e-361c-8fdb-79dc632b50bb",
                                "text": "— Я вот Митрий, а это мои братики малые."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8e9973b-2110-3694-bb6a-20251dd8fbbb",
                        "entry_id": "fbadf683-f6e7-38ae-bd59-3930fd4aa6ef",
                        "glosses": [
                            "употребляется как фамильярное или дружеское обращение к мужчине, юноше, мальчику"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec467976-0669-42eb-822c-4c356bea6f3d",
                                "sense_id": "b8e9973b-2110-3694-bb6a-20251dd8fbbb",
                                "text": "Как только обедня кончилась, выхожу я из церкви; вижу, впереди идет сельский мужик, по прозванию «братик»; поговорку он, знаете, эдакую имел, с кем бы ни говорил: с барином ли, с мужиком ли, с бабой ли, с мальчишкой ли, всем приговаривает: «братик»; а мужик эдакой правдивый: если уж что знает, так не потаит, да и лишнего не прибавит. 〈…〉 — Много, братик, болтают, — обереги бог всякого человека, — доподлинно я не знаю: за что купил, за то те и продаю."
                            },
                            {
                                "example_id": "5462e9cd-3fa8-4b0f-bbd8-08cd3c72ba5b",
                                "sense_id": "b8e9973b-2110-3694-bb6a-20251dd8fbbb",
                                "text": "Нас захлестнула толпа невысоких коренастых бородачей, и мы услыхали ободряющие слова: «Что, братики, или туго пришлось?»"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
