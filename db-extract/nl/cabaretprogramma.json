                "senses": [
                    {
                        "sense_id": "2ec669df-a996-3d25-b3d9-e9ad8e8150e3",
                        "entry_id": "36485d61-cd3d-3c08-95fd-9db2b541ce50",
                        "glosses": [
                            "kleinkunst voorstelling met grappige liedjes, toneelstukjes en voordrachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fd7cf0-1079-4717-8069-05fe4306178f",
                                "sense_id": "2ec669df-a996-3d25-b3d9-e9ad8e8150e3",
                                "text": "Van Faassen werd dankzij Sonneveld ook bekend als cabaretière. Hij vroeg haar in de jaren 60 voor zijn tweede theatershow. Ze voerden het cabaretprogramma 'Wim Sonneveld en Ina van Faassen' 650 keer op."
                            },
                            {
                                "example_id": "34a7fa10-1f7b-4a9a-b3be-3b7643ddc48b",
                                "sense_id": "2ec669df-a996-3d25-b3d9-e9ad8e8150e3",
                                "text": "Peter van Rooijen heeft de Wim Sonneveldprijs gewonnen. Dat heeft het Amsterdams Kleinkunst Festival bekendgemaakt. Tijdens de finale van de 25e editie in het DeLaMar Theater in Amsterdam wist de 28-jarige Van Rooijen met zijn cabaretprogramma 'Team Peter' de jury te overtuigen."
                            },
                            {
                                "example_id": "6102ba6e-8dd7-475a-9ce5-1633fee85b8b",
                                "sense_id": "2ec669df-a996-3d25-b3d9-e9ad8e8150e3",
                                "text": "Het schokkende filmpje dat onder middelbare scholieren in Terneuzen circuleert blijkt een opname te zijn voor een cabaretprogramma. De maker heeft zich bij de politie gemeld."
                            }
                        ]
                    }
                ],
