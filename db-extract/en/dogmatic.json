                                                "sense_id": "f41f40de-8ce4-3501-8651-b9b0607061f7",
                                                "text": "Marxismus není předkritickou, dogmatickou filosofií."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256e5525-b568-355d-9400-f90e5e3fa1c1",
                                        "entry_id": "5902da22-38df-3136-a89b-a13867763ab1",
                                        "glosses": [
                                            "který nepřipouští pochyby ani námitky, přesvědčený o své pravdě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5c2bc8-efa0-4ca7-b46c-f5c901a1a216",
                                                "sense_id": "256e5525-b568-355d-9400-f90e5e3fa1c1",
                                                "text": "Dogmatický komisař zvažuje, že odstoupí. „Nevím, jestli mám dost víry na to, nechat se pranýřovat za svá přesvědčení,“ řekl rádiu BBC."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2a1eecd-5091-43ad-921e-a21b20c28342",
