                ],
                "senses": [
                    {
                        "sense_id": "e1f7c953-97e0-3e83-b8cb-5cb1fb3fbf68",
                        "entry_id": "7278c00d-1a1c-3f21-8030-38ae716a92ca",
                        "glosses": [
                            "To heat excessively."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f2012260-2b90-4f57-ab75-ff0cae3311d3",
                                "sense_id": "e1f7c953-97e0-3e83-b8cb-5cb1fb3fbf68",
                                "text": "'Made one quite thankful to get back to the fug, though as a rule I think the way these trains are overheated is something scandalous'."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f5e6c1f-3a41-3ff0-94c3-065a6b8c95c9",
                        "entry_id": "7278c00d-1a1c-3f21-8030-38ae716a92ca",
                        "glosses": [
                            "To become excessively hot."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aea1b83d-40ca-341f-bb53-774fa8c2b1bd",
                        "entry_id": "7278c00d-1a1c-3f21-8030-38ae716a92ca",
                        "glosses": [
                            "To grow too quickly in an uncontrolled way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963b3db1-6bfd-4aa0-8f38-f631c0b5ca98",
                                "sense_id": "aea1b83d-40ca-341f-bb53-774fa8c2b1bd",
                                "text": "Dalio said that the Chinese economy was in danger of overheating, and somebody asked how a Chinese slowdown would affect the price of oil and other commodities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "663b0b0d-aa3a-4dfb-a6bb-e81107dedc61",
                        "source_entry_id": "7278c00d-1a1c-3f21-8030-38ae716a92ca",
                        "source_sense_description": "heat excessively",
                        "target_lang_word": "surchauffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surchauffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0d5a5f-2a33-3024-ade2-841eebf4e889",
                                        "entry_id": "62703ac4-18b9-31a1-8c83-83f8c479dbb4",
                                        "glosses": [
                                            "Chauffer à l’excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490dbd39-bc96-4cca-ba7a-0a22a344f5b5",
                                                "sense_id": "3e0d5a5f-2a33-3024-ade2-841eebf4e889",
                                                "text": "La suppression presque complète de l’oxyde de carbone dans la fabrication du gaz à l’eau, au moyen de la vapeur surchauffée est un fait expérimental qui a donné lieu à diverses interprétations sur lesquelles nous appuierons d'une manière spéciale."
                                            },
                                            {
                                                "example_id": "cbad6e2f-fcae-486e-b135-0ff450d441f7",
                                                "sense_id": "3e0d5a5f-2a33-3024-ade2-841eebf4e889",
                                                "text": "Et, surtout, conduire à une connexion au sol surchauffée entraînant un risque d’incendie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a1dacb5-13a8-41d4-bdd7-aa668aa25bba",
                        "source_entry_id": "7278c00d-1a1c-3f21-8030-38ae716a92ca",
                        "source_sense_description": "heat excessively",
                        "target_lang_word": "überhitzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überhitzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed39ec85-1b4a-3108-985b-7255329685ed",
                                        "entry_id": "03ec0147-d6bc-3f09-a1e0-360b63ff99ff",
                                        "glosses": [
                                            "zu stark erhitzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02f5b92-322a-4725-8d2e-1d1db446a50d",
                                                "sense_id": "ed39ec85-1b4a-3108-985b-7255329685ed",
                                                "text": "Beim Fahren ist es sinnvoll, eine bestimmte Drehzahl nicht dauerhaft zu überschreiten, da ansonsten der Motor überhitzt wird."
                                            },
                                            {
                                                "example_id": "0c2b4809-fcd4-44ab-b132-6def93cc989f",
                                                "sense_id": "ed39ec85-1b4a-3108-985b-7255329685ed",
                                                "text": "Wir überhitzten unseren Antrieb, sie überhitzten ihren Antrieb, und am Ende lief es gar nicht so sehr darauf hinaus, wer bei diesem Rennen der Schnellere war, sondern wer als Letztes in die Luft fliegen würde."
                                            },
                                            {
                                                "example_id": "63c37de3-50d5-4ff9-bbe6-f3ecde737cc2",
                                                "sense_id": "ed39ec85-1b4a-3108-985b-7255329685ed",
                                                "text": "Ja, sie überhitzten ihre Einbildungskraft so, daß es eine Weile gleich heißer Flugasche von Haus zu Haus getragen wurde, der Sintlinger, der Heiligenhofbauer, habe den Narren erwürgt und ihm dann zur Sühne für die Blutschuld durch sein Weib den seltsamen Denkstein setzen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1083b6c9-bda5-37cc-81e9-d3bdf37b6e68",
                                        "entry_id": "03ec0147-d6bc-3f09-a1e0-360b63ff99ff",
                                        "glosses": [
                                            "zu heiß werden; zu stark, übersteigert erregt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "intransitive",
                                            "participle",
                                            "perfect",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c21a38ae-ae54-440d-8906-5fb34c99586d",
                                                "sense_id": "1083b6c9-bda5-37cc-81e9-d3bdf37b6e68",
                                                "text": "Aus bisher unbekannter Ursache überhitzte ein Holzbrenner."
                                            },
                                            {
                                                "example_id": "b15c087e-3943-4636-953f-e7972a591bf9",
                                                "sense_id": "1083b6c9-bda5-37cc-81e9-d3bdf37b6e68",
                                                "text": "Weil Transformatoren überhitzten, musste das Braunschweiger Klinikum Salzdahlumer Straße auf Notstrom-Versorgung umschalten."
                                            },
                                            {
                                                "example_id": "e2748bc1-0236-4079-9f5b-3853ccb8585a",
                                                "sense_id": "1083b6c9-bda5-37cc-81e9-d3bdf37b6e68",
                                                "text": "Alle Quartale wieder streiten sich die Volkswirte, ob die deutsche Wirtschaft überhitzt oder nicht."
                                            },
                                            {
                                                "example_id": "6c1ff53e-57b3-4759-9a90-82116b1d2a05",
                                                "sense_id": "1083b6c9-bda5-37cc-81e9-d3bdf37b6e68",
                                                "text": "Wollte er, dass das Gerät sich überhitzte?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
