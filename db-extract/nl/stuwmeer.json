                                    {
                                        "sense_id": "8192f7d9-243f-328c-8752-b573631fba42",
                                        "entry_id": "c89712a9-72eb-3154-aff1-2ece0ddf3ef2",
                                        "glosses": [
                                            "To store or keep (something) in or as in a reservoir."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "reservoir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25aa379d-35b2-3916-a63e-b9e6b6546e52",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A place where anything is kept in store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd46bc1c-7248-434e-9fb1-2692d2b34ed3",
                                                "sense_id": "25aa379d-35b2-3916-a63e-b9e6b6546e52",
                                                "text": "Notwithstanding the way in which she had, in what she termed \"the delicacy of her feelings,\" contrived to pour the receipts of the fancy fair into one reservoir, the duke and several other persons complimented Lady Anne very much on the superior beauty and value of her articles,..."
                                            },
                                            {
                                                "example_id": "fb1c1482-3643-4e25-b034-3895d10e8054",
                                                "sense_id": "25aa379d-35b2-3916-a63e-b9e6b6546e52",
                                                "text": "The vehicle is fitted with Westinghouse electro-pneumatic brake, and also a Northey exhauster with vacuum chamber and auxiliary reservoir adjacent to the guard's compartment for use when hauling vehicles equipped with vacuum brake gear."
                                            },
                                            {
                                                "example_id": "5c62615d-eb28-4c2e-b023-fdfb957fb109",
                                                "sense_id": "25aa379d-35b2-3916-a63e-b9e6b6546e52",
                                                "text": "Within a printer cartridge, ink is typically stored in an ink reservoir and is deposited onto media through a print head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5b97159-295e-3593-a3e7-c66a75dd66ee",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A large natural or artificial lake used as a source of water supply."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "449fd10d-a1b6-3ad4-a7bd-afdfa577f82c",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A small intercellular space, often containing resin, essential oil, or some other secreted matter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc6a405d-ff4f-380a-aea6-433da8c18e5e",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A supply or source of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd971c49-be28-4e3d-94e1-7806d2a95b5f",
                                                "sense_id": "dc6a405d-ff4f-380a-aea6-433da8c18e5e",
                                                "text": "To replace them and also to provide a reservoir for relief trains, a certain amount of spare stock must be kept on hand."
                                            },
                                            {
                                                "example_id": "b8e71311-db79-43d4-9aa4-f48e36858918",
                                                "sense_id": "dc6a405d-ff4f-380a-aea6-433da8c18e5e",
                                                "text": "The goal is to draw on reservoirs of strength that defy rational thought, so you can wrench your poor, obsessed spirit away from work and orient it toward stuff that matters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f620c363-64c8-3910-95e7-df07efe95b9d",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A species that acts as host to a zoonosis when it is not causing acute illness in other susceptible species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347592b5-9108-4cf6-a0c4-f934ddbe612f",
                                                "sense_id": "f620c363-64c8-3910-95e7-df07efe95b9d",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola. A recent study explored the ecological variables that may contribute to bats’ propensity to harbor such zoonotic diseases by comparing them with another order of common reservoir hosts: rodents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4a6096-6ca0-3fd0-beef-38212a1a8e97",
                                        "entry_id": "48c13401-2e3d-359f-b485-80bcc9735232",
                                        "glosses": [
                                            "A \\\"black box\\\" component that receives an input signal to be read out and mapped by another process, as part of reservoir computing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
