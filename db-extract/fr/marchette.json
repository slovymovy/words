                        "glosses": [
                            "Petite marche qui abaisse les lices d’un métier à tisser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "576c6678-c9bb-3fb7-8212-696e68d32a4b",
