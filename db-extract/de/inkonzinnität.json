                "senses": [
                    {
                        "sense_id": "cd368661-b0a2-36ee-952b-cfbee6249fa5",
                        "entry_id": "d7be6dbe-428f-3b96-9af2-25fe84fa838c",
                        "glosses": [
                            "syntaktische Qualität der Unebenmäßigkeit"
                        ],
                        "tags": [
                            "Rhetorik",
                            "Satzbau",
                            "Stilkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "eb4e23b9-79ac-4b9e-b064-930f5e14cd07",
                                "sense_id": "cd368661-b0a2-36ee-952b-cfbee6249fa5",
                                "text": "„Unter Konzinnität und Inkonzinnität wird hier die in syntaktischer Hinsicht symmetrische bzw. asymmetrische Gestaltung der koordinierten (parallelen) Sätze oder Satzglieder verstanden.“"
                            },
                            {
                                "example_id": "f6314370-e996-463e-888b-c13aeb91b9bd",
                                "sense_id": "cd368661-b0a2-36ee-952b-cfbee6249fa5",
                                "text": "„Dabei mögen ihm dramaturgische Ungeschicklichkeiten, Motivationsschwächen oder auch Inkonzinnitäten unterlaufen sein, die aber erstens nicht ohne Parallelfälle im attischen Theater sind, zweitens auf anderen Ebenen unter Umständen Sinn ergeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d3ad5bfd-6fbd-3771-ab68-a88fd4e34511",
                        "entry_id": "d7be6dbe-428f-3b96-9af2-25fe84fa838c",
                        "glosses": [
                            "Ungefälligsein"
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "94e1c1e4-3777-4f6a-a981-d27972d914e9",
                                "sense_id": "d3ad5bfd-6fbd-3771-ab68-a88fd4e34511",
                                "text": "„In diesem Lc.-Text fällt die Inkonzinnität zwischen den beiden Beispielen aus dem Leben und der in V. 33 gegebenen Deutung auf. Jülicher will wegen dieser Inkonzinnität die Deutung Jesu absprechen und die ‚nicht besonders glückliche Formulierung‘ der Deutung dem Lc. zuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
