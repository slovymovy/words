                "senses": [
                    {
                        "sense_id": "3f4bef3d-b30f-3e1c-b518-9ae885cc9450",
                        "entry_id": "bca0e1a1-57ca-313f-b0a3-ae59befcbca3",
                        "glosses": [
                            "Techniker, der im Labor arbeitet, sich mit in Labors verwendeter Technik auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee7986c-3f40-43c4-82ff-561440d9f105",
                                "sense_id": "3f4bef3d-b30f-3e1c-b518-9ae885cc9450",
                                "text": "„In dem Raum, zu dem die Hintertür der Newington Avenue 718 gehört, nur ein paar Schritte von der Leiche entfernt, stellt Pellegrini, umringt von Detectives, Streifenpolizisten und Labortechnikern, die vom Regen durchnässte Tasche auf einen Küchentisch.“"
                            },
                            {
                                "example_id": "692b7820-f3d5-4bec-8b23-7c9f3e6be7bb",
                                "sense_id": "3f4bef3d-b30f-3e1c-b518-9ae885cc9450",
                                "text": "„Der Bunker war voller Menschen: Labortechniker und Fotografen, höhere Polizeibeamte aus drei Bezirken und von der Kriminalpolizei.“"
                            },
                            {
                                "example_id": "e9b5d5b4-8f4c-4de3-b44a-1ac52e84d4ac",
                                "sense_id": "3f4bef3d-b30f-3e1c-b518-9ae885cc9450",
                                "text": "„Labortechniker schwärmten überall aus, die das Grundstück nach mutmaßlichen Tatwaffen und Frauenkleidern untersuchen sollten; ein weiteres forensisches Team wurde ausgeschickt, um Junior Nashs Liebesnest nach Blutspuren und Fingerabdrücken zu untersuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
