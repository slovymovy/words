                        ],
                        "examples": [
                            {
                                "example_id": "d845dda7-5431-42a3-9896-4fd38f807311",
                                "sense_id": "81fb21b8-5816-33e0-b5c1-7c3dde22303e",
                                "text": "Le glycogéne est utilisé par les animaux pour stocker de l'énergie."
                            },
                            {
                                "example_id": "1ca183ef-28d8-4aed-a184-654d23a92e7d",
                                "sense_id": "81fb21b8-5816-33e0-b5c1-7c3dde22303e",
                                "text": "Pendant cette période le corps peut plus rapidement convertir les glucides en glycogène musculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d261bbaa-2864-4216-9062-bb5115d6e5bc",
