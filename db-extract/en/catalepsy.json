                    {
                        "translation_id": "84ce74f9-14ec-4a5f-92f3-c008b4927fcc",
                        "source_entry_id": "75d180e2-fac0-3b22-a700-150aa493d44a",
                        "source_sense_id": "aafd0885-ea2e-36b3-93dc-1f5d01a879a1",
                        "source_sense_description": "catalepsy",
                        "target_lang_word": "каталепси́я",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "каталепси́я",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2d5a7ed4-823e-36a0-8a24-06a5046c00f5",
                                        "entry_id": "dcad3c1b-f6c8-3afc-a3a0-3f8363839ed7",
                                        "glosses": [
                                            "мед. двигательное расстройство — застывание человека в принятой им или приданной ему позе, наблюдаемое при гипнозе и ряде психических заболеваний"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1dc1c9-8518-4a05-9cf9-d00ae0137093",
                                                "sense_id": "2d5a7ed4-823e-36a0-8a24-06a5046c00f5",
                                                "text": "Каталепсия, к примеру, является обычной формой гипнотического поведения, которое проявляется, как правило, в состоянии лёгкого транса и сохраняется в состоянии глубокого транса. Однако практика показывает, что у некоторых людей каталепсия никогда не проявляется самостоятельно ни в лёгком, ни в глубоком трансе."
                                            },
                                            {
                                                "example_id": "346b26eb-530a-495f-b731-99a4b33dd1bc",
                                                "sense_id": "2d5a7ed4-823e-36a0-8a24-06a5046c00f5",
                                                "text": "Результаты изучения экстрапирамидных симптомов у животных выявили, что кветиапин вызывает слабую каталепсию в дозе, эффективно блокирующей допаминовые D₂-рецепторы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b46642e4-fc24-3d81-9df1-19e6ba4bbd09",
                                        "entry_id": "dcad3c1b-f6c8-3afc-a3a0-3f8363839ed7",
                                        "glosses": [
                                            "мед. подверженность такому расстройству, болезненная предрасположенность к нему"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
