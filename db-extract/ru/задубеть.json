                "senses": [
                    {
                        "sense_id": "b2396eb1-019c-31d2-9b78-fb2838bb6101",
                        "entry_id": "3f2f75a3-3fda-3369-9353-a6ba4a7172d1",
                        "glosses": [
                            "разг. стать жёстким, твёрдым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c58e97cb-8b8d-4fce-ae19-3e16c33344ef",
                                "sense_id": "b2396eb1-019c-31d2-9b78-fb2838bb6101",
                                "text": "Костюм мой задубел, отяжелел, ботинки стали мокры, а складка на брюках разгладилась."
                            },
                            {
                                "example_id": "1c127d03-ca0b-4d9a-a51c-7f2e7f517bd1",
                                "sense_id": "b2396eb1-019c-31d2-9b78-fb2838bb6101",
                                "text": "Возможно, износились маслосъёмные кольца. Или маслоотражательные колпачки так задубели, что перестали уплотнять клапан."
                            }
                        ]
                    },
                    {
                        "sense_id": "57d0699d-968e-362e-852f-61053d9574e1",
                        "entry_id": "3f2f75a3-3fda-3369-9353-a6ba4a7172d1",
                        "glosses": [
                            "разг. закоченеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49060598-efa8-4e0a-a164-734851e999fe",
                                "sense_id": "57d0699d-968e-362e-852f-61053d9574e1",
                                "text": "Все в нём задубело, и руки, и ноги стали деревянными."
                            },
                            {
                                "example_id": "3c1e53e8-cb6a-4fda-8354-b90109de7c2d",
                                "sense_id": "57d0699d-968e-362e-852f-61053d9574e1",
                                "text": "Земля задубеет. Хорошо, когда погода ясная, тихая, мороз ― без снега."
                            }
                        ]
                    }
                ],
