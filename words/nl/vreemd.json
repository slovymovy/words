                                "ru": "Она посмотрела на меня со <w>странным</w> выражением глаз.",
                                "pl": "Spojrzała na mnie z <w>dziwnym</w> wyrazem oczu.",
                                "de": "Sie sah mich mit einem <w>seltsamen</w> Blick in ihren Augen an.",
                                "fr": "Elle m'a regardé avec un regard <w>bizarre</w> dans les yeux.",
                                "it": "Mi ha guardato con uno <w>strano</w> sguardo negli occhi.",
                                "cs": "Podívala se na mě se <w>zvláštním</w> pohledem v očích.",
                                "tr": "Gözlerinde <w>garip</w> bir bakışla bana baktı.",
                                "es": "Me miró con una mirada <w>extraña</w> en los ojos."
                            }
