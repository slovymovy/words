                                    {
                                        "sense_id": "a8c9bb7f-6848-3b1c-943d-ccc2d730c278",
                                        "entry_id": "e7529700-47c9-3c94-a623-d9a5ede7303c",
                                        "glosses": [
                                            "A servomechanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e76751-3f05-4417-8f3f-3a9ffe99be10",
                                                "sense_id": "a8c9bb7f-6848-3b1c-943d-ccc2d730c278",
                                                "text": "A Lockheed Type 6 remote servo adds a 1.9 multiplier to the pedal pressures and, at about £140, is rather cheaper than all the Girling single line remote servos I′ve seen advertised."
                                            },
                                            {
                                                "example_id": "589fb6f9-1600-49bc-926f-f57cbb17f496",
                                                "sense_id": "a8c9bb7f-6848-3b1c-943d-ccc2d730c278",
                                                "text": "If you are using Futaba servos with the application, make sure that you change the data values accordingly."
                                            },
                                            {
                                                "example_id": "f679cbeb-940b-4254-a289-3ffca4c320d9",
                                                "sense_id": "a8c9bb7f-6848-3b1c-943d-ccc2d730c278",
                                                "text": "The servo is an autonomic element of a control system: Setting a desired value of an output parameter makes a servo do its job independently of other factors as long as the specified value remains constant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94d96fae-2caa-3bbf-977f-e198ca42a680",
                                        "entry_id": "e7529700-47c9-3c94-a623-d9a5ede7303c",
                                        "glosses": [
                                            "A servomechanism.",
                                            "A servomotor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
