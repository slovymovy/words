                "senses": [
                    {
                        "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                        "entry_id": "e8da4bfb-8dc6-37fc-9472-4167f344be28",
                        "glosses": [
                            "Gebiet um einen Mobilfunkmast (genau: funktechnische Einrichtung), in dem die mobile Kommunikation mit Smartphones, Handys oder Tablets funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a09282d-b15d-4a95-ae59-ab979e99f3f7",
                                "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                                "text": "„Zwar verpflichtet das Gesetz die Staatsanwaltschaften dazu, die Betroffenen über die Erfassung ihrer Mobilfunkanschlüsse im Umfeld der Tatzeit in der Funkzelle zu benachrichtigen.“"
                            },
                            {
                                "example_id": "b2b24a36-eae4-4f9f-9f8a-f73440ac9f68",
                                "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                                "text": "[…] die sächsische Polizei [hatte] während der Proteste von und gegen Neonazis am 19. Februar Daten von Mobiltelefonen in mehreren Funkzellen in Dresden abgefragt und gespeichert."
                            },
                            {
                                "example_id": "d6d93a8f-bf5e-4ed7-9174-614a7c04a0d1",
                                "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                                "text": "„Es [Internet über Mobilfunk] handelt sich um ein sogenanntes shared Medium, sprich man teilt sich die Kapazität mit den anderen Usern, die in der gleichen Funkzelle momentan auf Empfang sind, ebenfalls Online-Dienste nutzen.“"
                            },
                            {
                                "example_id": "ae654631-e698-42b0-a2ed-545c744877e6",
                                "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                                "text": "Der Netzbetreiber gibt dabei [bei Funkzellenabfragen] auf Anfrage alle Handynummern heraus, die zu einem bestimmten Zeitpunkt in einer bestimmten Funkzelle eingebucht waren. Das BKA habe in der zweiten Jahreshälfte 2017 insgesamt 376 Mal davon Gebrauch gemacht, ein Jahr zuvor nur einmal."
                            },
                            {
                                "example_id": "17857c00-0397-4921-8f85-3a2deedfd332",
                                "sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                                "text": "[…] die inquisitorischen Fragen, die 700 Handybesitzer beantworten mussten, die sich in einer Funkzelle aufhielten, als eine Restpostenbörse von Brandstiftern abgefackelt wurde, sorgte für Staunen - und brachte Erhard Rex, Generalstaatsanwalt Schleswig-Holstein, den BigBrotherAward 2005 in der Kategorie „Kommunikation“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fb7229c-a248-4f23-a7cf-bb1874ced5e5",
                        "source_entry_id": "e8da4bfb-8dc6-37fc-9472-4167f344be28",
                        "source_sense_id": "af54b066-b710-3bfc-a81e-cb09c1e093a2",
                        "source_sense_description": "Gebiet um einen Mobilfunkmast für die mobile Kommunikation",
                        "target_lang_word": "cell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12df0304-be2b-39a3-bbca-ab8b12d4a495",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A single-room dwelling for a hermit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba13431-6375-495b-8058-cd2ee6a6975c",
                                                "sense_id": "12df0304-be2b-39a3-bbca-ab8b12d4a495",
                                                "text": "So, taking them apart into his cell, / He to that point fit speaches gan to frame […]."
                                            },
                                            {
                                                "example_id": "25502216-93e3-4b1e-aa03-793f99e27a9d",
                                                "sense_id": "12df0304-be2b-39a3-bbca-ab8b12d4a495",
                                                "text": "For three days he and his attendants had wandered in the forest without seeing a human form: but on the evening of the third they came to a cell, in which they found a venerable hermit in the agonies of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab2c278-0729-308c-8d78-5eecc2a138a8",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A small monastery or nunnery dependent on a larger religious establishment."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb1c4525-3074-33e9-ba30-4ebfe67cccdd",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A small room in a monastery or nunnery accommodating one person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d624dc99-262d-4096-9730-8e01f12442ef",
                                                "sense_id": "bb1c4525-3074-33e9-ba30-4ebfe67cccdd",
                                                "text": "Gregor Mendel must have spent a good amount of time outside of his cell."
                                            },
                                            {
                                                "example_id": "8ab42024-92af-42d7-95ae-b17b24d47f5d",
                                                "sense_id": "bb1c4525-3074-33e9-ba30-4ebfe67cccdd",
                                                "text": "A nunʼs bedroom is properly called a cell and is small, bare, and plain, without comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900aea24-39d2-35ad-acb3-f7d7866fc8d7",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A room in a prison or jail for one or more inmates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec065a55-27b3-472b-a6bc-4b47d457712a",
                                                "sense_id": "900aea24-39d2-35ad-acb3-f7d7866fc8d7",
                                                "text": "The combatants spent the night in separate cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94725bd7-2f9b-3ab7-bdda-0ca3fa565ce4",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "Each of the small hexagonal compartments in a honeycomb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "851c1767-5c93-325b-92ab-87d44f0be6bd",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "Any of various chambers in a tissue or organism having specific functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd9631f8-29e2-4b63-9123-67978ecb1027",
                                                "sense_id": "851c1767-5c93-325b-92ab-87d44f0be6bd",
                                                "text": "Each of the two cells or lobes of the anther is marked with a lateral line or furrow, running from top to bottom[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d79369c-c3ca-34e1-8681-79ee81f10a65",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "The discal cell of the wing of a lepidopteran insect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c25dedde-7c58-3773-8923-b29e581efc17",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "Specifically, any of the supposed compartments of the brain, formerly thought to be the source of specific mental capacities, knowledge, or memories."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d0b766-7431-4416-9817-29301e106397",
                                                "sense_id": "c25dedde-7c58-3773-8923-b29e581efc17",
                                                "text": "How soft the music of those village bells / […] With easy force it opens all the cells / Where mem'ry slept."
                                            },
                                            {
                                                "example_id": "a1917a1d-0b75-44db-9afc-e9deaaa18a7a",
                                                "sense_id": "c25dedde-7c58-3773-8923-b29e581efc17",
                                                "text": "[W]e shall feel still more contempt for the order of men, who cultivated their faculties, only to enable them to consolidate their power, by leading the ignorant astray; making the learning they concentrated in their cells, a more polished instrument of oppression."
                                            },
                                            {
                                                "example_id": "8d7dcd64-0c8d-44e3-9313-0815202368c6",
                                                "sense_id": "c25dedde-7c58-3773-8923-b29e581efc17",
                                                "text": "From cell to cell of his brain crept the one thought; and the wild desire to live, most terrible of all man's appetites, quickened into force each trembling nerve and fibre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511c3093-7ee2-3e17-96f6-4a5161507322",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A section or compartment of a larger structure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38485c40-79e3-364f-a657-afd1d6653612",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "Any small dwelling; a remote nook, a den."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a1d99c-3055-468c-ab8b-17dd225a5e1f",
                                                "sense_id": "38485c40-79e3-364f-a657-afd1d6653612",
                                                "text": "Thou seest but the order and policie of this little Cell [translating caveau] wherein thou art placed[…]."
                                            },
                                            {
                                                "example_id": "427136c9-3934-443b-b6a7-c3783bfba5ad",
                                                "sense_id": "38485c40-79e3-364f-a657-afd1d6653612",
                                                "text": "Not long shall honour'd Douglas dwell, / Like hunted stag, in mountain-cell[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b40695cc-cc63-384c-9f2c-3267c067c190",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A device which stores electrical power; used either singly or together in batteries; the basic unit of a battery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728dbf3f-40a2-42cc-a830-1cf6002c50cd",
                                                "sense_id": "b40695cc-cc63-384c-9f2c-3267c067c190",
                                                "text": "This MP3 player runs on 2 AAA cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711b8849-7499-3f95-ae1d-728cbaca91da",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "The basic unit of a living organism, consisting of a quantity of protoplasm surrounded by a cell membrane, which is able to synthesize proteins and replicate itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a57fabc-94dd-497c-a89d-735bf582c676",
                                                "sense_id": "711b8849-7499-3f95-ae1d-728cbaca91da",
                                                "text": "An American company has applied to experiment in Britain on Parkinson's disease sufferers by injecting their brains with cells from pigs."
                                            },
                                            {
                                                "example_id": "f4238d7d-feb0-4f61-88a9-abec2d17ce7e",
                                                "sense_id": "711b8849-7499-3f95-ae1d-728cbaca91da",
                                                "text": "In multicellular organisms, groups of cells form tissues and tissues come together to form organs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a510c4-f289-3941-b3e3-e8927b6ab205",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A small thunderstorm, caused by convection, that forms ahead of a storm front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd9455f-0e3a-4018-871d-d7516118cfcc",
                                                "sense_id": "21a510c4-f289-3941-b3e3-e8927b6ab205",
                                                "text": "There is a powerful storm cell headed our way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e9b4dd9-ad7c-3498-a60c-ca67b3d8b55b",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "The minimal unit of a cellular automaton that can change state and has an associated behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d37536-340a-436b-bb47-0bf1fe733ed5",
                                                "sense_id": "4e9b4dd9-ad7c-3498-a60c-ca67b3d8b55b",
                                                "text": "The upper right cell always starts with the color green."
                                            },
                                            {
                                                "example_id": "2fdce031-4c60-4fb3-958c-37f0aa6bca92",
                                                "sense_id": "4e9b4dd9-ad7c-3498-a60c-ca67b3d8b55b",
                                                "text": "Basically, I'm looking for a fast (the fastest?) way of updating grids, where each cell has to look at an arbitrary number of its neighbors."
                                            },
                                            {
                                                "example_id": "bc34055e-7e2e-4688-8de5-7366f2ce7753",
                                                "sense_id": "4e9b4dd9-ad7c-3498-a60c-ca67b3d8b55b",
                                                "text": "It is used for land-use change simulations, where the content of the cells surrounding a central cell defines how this cell is going to evolve (for example, a cell that is \"agriculture\" but has 3 urban neighbors will likely become urban, while if it is surrounded by forest or other agriculture cells, it will remain agriculture.)"
                                            },
                                            {
                                                "example_id": "6e633c3a-7440-40fb-a965-b4fa4d017189",
                                                "sense_id": "4e9b4dd9-ad7c-3498-a60c-ca67b3d8b55b",
                                                "text": "I've seen this space colloqually referred to as MAP (presumably since it maps a 3x3 neighborhood into a future cell state)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "643f4ee2-4b7a-3532-91ae-8aef3ce5dad2",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "In FreeCell-type games, a space where one card can be placed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1725bb7-716a-3fde-b469-2b07ef7d9b32",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A small group of people forming part of a larger organization, often an outlawed one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96deace-39a7-486e-98d6-1b3d842eed3e",
                                                "sense_id": "b1725bb7-716a-3fde-b469-2b07ef7d9b32",
                                                "text": "Those three fellows are the local cell of that organization."
                                            },
                                            {
                                                "example_id": "524ee78b-5b70-47cf-b52d-ef5ce54be1df",
                                                "sense_id": "b1725bb7-716a-3fde-b469-2b07ef7d9b32",
                                                "text": "Salarian intelligence field agents are grouped into an organization called the Special Tasks Group. STG operators work in independent cells, performing dangerous missions such as counter-terrorism, infiltration, reconnaissance, assassination, and sabotage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "353fca85-edf4-3025-af69-ab15a97d9e79",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A short, fixed-length packet, as in asynchronous transfer mode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac54c3f-32d4-4d92-ab64-f03dc4b8c6b9",
                                                "sense_id": "353fca85-edf4-3025-af69-ab15a97d9e79",
                                                "text": "Virtual Channel number 5 received 170 cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15f08cad-638e-38a7-8323-98a0954db42d",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
                                            "A region of radio reception that is a part of a larger radio network."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d8e487-e69d-4290-8471-6df6a244372c",
                                                "sense_id": "15f08cad-638e-38a7-8323-98a0954db42d",
                                                "text": "I get good reception in my home because it is near a cell tower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200ee1c3-0b01-3b6d-87fc-191ed149b54a",
                                        "entry_id": "fdff5173-48ae-3270-84c1-ab18a67e450f",
                                        "glosses": [
