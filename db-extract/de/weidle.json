                ],
                "senses": [
                    {
                        "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                        "entry_id": "79831f81-ec35-3de7-824f-4086a072afaa",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe62041d-13b0-41c2-ab90-46309e25ca73",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Frau Weidle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "283e74f8-1817-49d6-b8ad-0dbdc2b85efd",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Herr Weidle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f192cbcb-0666-4d2c-8288-1734da6e16e0",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Die Weidles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "221fa8eb-355c-4563-a04a-a90338c157ed",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Der Weidle trägt nie die Pullover, die die Weidle ihm strickt."
                            },
                            {
                                "example_id": "0aae31e2-d8b5-46ad-a9ed-319520e503b8",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weidle kommt, geht der Herr Weidle.“"
                            },
                            {
                                "example_id": "a385ef24-22ab-40da-aee3-d98cd5b84ff7",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Weidle kommt und geht."
                            },
                            {
                                "example_id": "c0746e26-f9da-4ecb-85ce-cf45e0d2bfc5",
                                "sense_id": "d34679fa-ec7b-38d7-9c1e-9487d1769096",
                                "text": "Weidles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
