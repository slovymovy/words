                ],
                "senses": [
                    {
                        "sense_id": "c03b5d10-f858-3094-8ea6-91df5b2a4038",
                        "entry_id": "3da6975b-ec5c-30e1-aa7b-5373fba73157",
                        "glosses": [
                            "Femme qui est, qui demeure auprès d’une autre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a53b681a-9a6b-3d57-8134-bb23d2a5c030",
                        "entry_id": "3da6975b-ec5c-30e1-aa7b-5373fba73157",
                        "glosses": [
                            "Cité (du genre féminin) dont le terroir est proche de celui d'une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95992c1a-e7c0-4439-b816-fb4f3cd67366",
                                "sense_id": "a53b681a-9a6b-3d57-8134-bb23d2a5c030",
                                "text": "Du même coup, Épernay passe de 4.000 habitants vers 1850 à 20.000 vers 1900, à 23.000 de nos jours, entraînant dans sa prospérité ses voisines Ay, Dizy, Magenta."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a5956d-c87d-467a-9f10-d16d22be13bc",
                        "source_entry_id": "3da6975b-ec5c-30e1-aa7b-5373fba73157",
                        "source_sense_id": "c03b5d10-f858-3094-8ea6-91df5b2a4038",
                        "source_sense_description": "Personne",
                        "target_lang_word": "Nachbarin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachbarin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                        "entry_id": "124be05d-915e-38c0-a28a-1416a614677d",
                                        "glosses": [
                                            "in unmittelbarer Nähe wohnende (weibliche) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be359638-756a-4ca5-84a9-7b424ebd2375",
                                                "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                                "text": "Meine Nachbarin lüftet jeden Morgen um halb neun ihr Schlafzimmer."
                                            },
                                            {
                                                "example_id": "82b6f73f-1b0c-4834-92ed-eb8d9debdf88",
                                                "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                                "text": "„Meine alte Nachbarin erzählte mir, dass sie im Krieg in den Bombennächten oft im Keller zusammensaßen, sich an den Händen berührten und im okkultistischen Stuhlkreis nach den Männern an der Front fragten.“"
                                            },
                                            {
                                                "example_id": "4e7da51c-239e-4c66-a743-bc0b3bf54eef",
                                                "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                                "text": "„Und im Wohnheim empfanden ihn Nachbarinnen als bedrohlich.“"
                                            },
                                            {
                                                "example_id": "6f24882d-c9f4-4d51-8f52-9dac7efbc6ec",
                                                "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                                "text": "„Der Unabhängigkeitstag kam, und die Nachbarinnen fanden sich für dieses Ereignis zusammen.“"
                                            },
                                            {
                                                "example_id": "e99b8705-fa5d-48bc-a7c1-ce18018d72e3",
                                                "sense_id": "47fc9b1b-82a4-3f6d-9732-74a5254313f4",
                                                "text": "„Die Nachbarin begann fassungslos zu weinen, die Hände gegen den Himmel gerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30c124c7-cc7c-3f55-a9e2-c0343a463033",
                                        "entry_id": "124be05d-915e-38c0-a28a-1416a614677d",
                                        "glosses": [
                                            "in unmittelbarer Nähe befindliche (weibliche) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ed8a5d-8380-4238-9658-8f7f271d1807",
                                                "sense_id": "30c124c7-cc7c-3f55-a9e2-c0343a463033",
                                                "text": "Hat deine Nachbarin wieder versucht, von dir abzuschreiben?"
                                            },
                                            {
                                                "example_id": "b8160b99-0a2c-427e-898c-e1734b6ce720",
                                                "sense_id": "30c124c7-cc7c-3f55-a9e2-c0343a463033",
                                                "text": "„Als er dann an meine Tür klopfte und mich noch im Hemd erblickte, drohte er mir, er werde meine Nachbarinnen hereinrufen, und ging, um mir einen Friseur zu schicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
