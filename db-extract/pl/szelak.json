                        "cross_references": [
                            {
                                "target_word": "shellac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b1d995-c69e-31fa-832c-307f1dd2261b",
                                        "entry_id": "e230ffa9-4bc5-3f84-bcc0-e0c664625125",
                                        "glosses": [
                                            "A processed secretion of the lac insect, Coccus lacca; used in polishes, varnishes etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a84a1c-7b75-4172-916d-8d0e5e032a24",
                                                "sense_id": "d7b1d995-c69e-31fa-832c-307f1dd2261b",
                                                "text": "But, she says, a wartime ban on recordings using shellac and vinyl kept the Walker version from being released."
                                            },
                                            {
                                                "example_id": "b9f450b5-0939-416a-8e30-6b7adf2f9a40",
                                                "sense_id": "d7b1d995-c69e-31fa-832c-307f1dd2261b",
                                                "text": "At the turn of the century, the ever-expanding electrical industry was running low on shellac, a resin secreted by the female lac bug which could be used as an insulating material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "033b7823-f409-3d87-a323-495c2df8e0da",
                                        "entry_id": "e230ffa9-4bc5-3f84-bcc0-e0c664625125",
                                        "glosses": [
                                            "A beating; a thrashing."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shellac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e730c2f-0632-3b1b-9635-56bac1ed7986",
                                        "entry_id": "a18a51ad-a37c-3dcc-a78d-36e44a2a00c8",
                                        "glosses": [
                                            "To coat with shellac."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "805920d1-4d0b-3cf8-843f-e6a7dc95954c",
                                        "entry_id": "a18a51ad-a37c-3dcc-a78d-36e44a2a00c8",
                                        "glosses": [
                                            "To beat; to thrash."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                        "entry_id": "a18a51ad-a37c-3dcc-a78d-36e44a2a00c8",
                                        "glosses": [
                                            "To inflict a heavy defeat upon."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e7919e-1e17-4073-9d0f-3f4e82a5cbad",
                                                "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                                "text": "In 1964 Goldwater ran rambunctiously, flat-out against government. He got shellacked."
                                            },
                                            {
                                                "example_id": "1bd4613a-ed57-43f6-87d3-393b81c0f51c",
                                                "sense_id": "a5bb64e4-7714-3687-a906-9cb7ce855fe0",
                                                "text": "In another the Mets were shellacked, 9-1, with a stray ninth-inning home run by Strawberry after two outs, preventing a shutout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
