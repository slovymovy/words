                        "cross_references": [
                            {
                                "target_word": "starkness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec2b8e95-8ed9-35d0-85db-9d27e006686d",
                                        "entry_id": "e870cd13-758c-3b71-b057-0435599e6e6c",
                                        "glosses": [
                                            "The state or quality of being stark."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c795e13a-a562-4970-be86-a3984c1f9101",
                                                "sense_id": "ec2b8e95-8ed9-35d0-85db-9d27e006686d",
                                                "text": "In the morning the framed photograph of the two of them, hanging on the sitting-room wall, was gone. The patch of wall where it had been hanging a hurtful rectangle of dusty starkness."
                                            },
                                            {
                                                "example_id": "9a69f61d-b438-4127-a474-181728887be2",
                                                "sense_id": "ec2b8e95-8ed9-35d0-85db-9d27e006686d",
                                                "text": "The power of the stories overrides everything else. The quiet starkness of the telling: […]"
                                            },
                                            {
                                                "example_id": "14499b95-828f-4e5d-b07c-bb63817069c3",
                                                "sense_id": "ec2b8e95-8ed9-35d0-85db-9d27e006686d",
                                                "text": "The starkness of the studies correlates with the rising number of people – especially Democrats – who see climate change as not just an issue but the issue of our times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b60a15-3a7b-33b8-abd1-61b2e312c7e8",
                                        "entry_id": "e870cd13-758c-3b71-b057-0435599e6e6c",
                                        "glosses": [
                                            "The result or product of being stark."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a04429a-bf3a-4ebf-9363-903a66b864f3",
                        "source_entry_id": "690a95ac-f131-31bb-983c-e2309d3e8730",
