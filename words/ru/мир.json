    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "880599be-574d-3294-a525-dad145bb6c3a",
                    "sense_definition": "Состояние спокойствия, согласия, отсутствие войны и вражды.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "peace_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы все хотим, чтобы на земле был <w>мир</w>.",
                            "target_lang_translations": {
                                "en": "We all want there to be <w>peace</w> on earth.",
                                "zh": "我们都希望地球上能有<w>和平</w>。"
                            }
                        },
                        {
                            "text": "После долгой ссоры в семье наконец наступил <w>мир</w>.",
                            "target_lang_translations": {
                                "en": "After a long quarrel, <w>peace</w> finally came to the family.",
                                "zh": "经过长时间的争吵，家里终于恢复了<w>和平</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "спокойствие",
                        "покой"
                    ],
                    "antonyms": [
                        "война"
                    ],
                    "common_phrases": [
                        "мир во всём мире",
                        "жить в мире",
                        "бороться за мир",
                        "сохранить мир"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of tranquility, harmony, and freedom from war or hostility.",
                        "zh": "一种平静、和谐、没有战争或敌对的状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "state of tranquility or absence of war"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "和平",
                                "target_lang_sense_clarification": "没有战争的和谐状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9557e92-06d5-32dd-807c-359b1f3a8897",
                    "sense_definition": "Земной шар, планета Земля, а также всё человеческое общество.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "universe_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот талантливый музыкант известен во всём <w>мире</w>.",
                            "target_lang_translations": {
                                "en": "This talented musician is known all over the <w>world</w>.",
                                "zh": "这位天才音乐家在全<w>世界</w>都很有名。"
                            }
                        },
                        {
                            "text": "Мой брат мечтает путешествовать и посмотреть весь <w>мир</w>.",
                            "target_lang_translations": {
                                "en": "My brother dreams of traveling and seeing the whole <w>world</w>.",
                                "zh": "我哥哥梦想着去旅行，看看整个<w>世界</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "во всём мире",
                        "объехать весь мир",
                        "страны мира",
                        "чемпион мира"
                    ],
                    "target_lang_definitions": {
                        "en": "The planet Earth and all human society.",
                        "zh": "地球及其上的人类社会。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "world",
                                "target_lang_sense_clarification": "the planet and its people"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "地球和人类社会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad40906-8439-35a8-a741-591ba15ff793",
                    "sense_definition": "Вселенная, всё существующее, всё, что нас окружает.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "universe_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёные пытаются понять, как возник наш <w>мир</w>.",
                            "target_lang_translations": {
                                "en": "Scientists are trying to understand how our <w>world</w> originated.",
                                "zh": "科学家们正试图了解我们的<w>世界</w>是如何起源的。"
                            }
                        },
                        {
                            "text": "Окружающий <w>мир</w> полон удивительных загадок и тайн.",
                            "target_lang_translations": {
                                "en": "The surrounding <w>world</w> is full of amazing riddles and secrets.",
                                "zh": "我们周围的<w>世界</w>充满了奇妙的谜题和秘密。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вселенная"
                    ],
                    "antonyms": [
                        "небытие"
                    ],
                    "common_phrases": [
                        "происхождение мира",
                        "картина мира",
                        "материальный мир"
                    ],
                    "target_lang_definitions": {
                        "en": "The universe, existence, or everything that surrounds us.",
                        "zh": "宇宙、存在或我们周围的一切。"
                    },
                    "translations": {
