                        "source_entry_id": "2fdd9dc9-a83c-3b4a-92c3-ff4468a22059",
                        "source_sense_id": "5cd98cdc-063a-361e-94c5-e4290b80499d",
                        "target_lang_word": "samoyède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samoyède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e524077-54d8-3106-b4bc-fbe772acefe5",
                                        "entry_id": "f81aa1de-a7a3-3168-9f49-549aa3176901",
                                        "glosses": [
                                            "Relatif aux Samoyèdes, peuple de Sibérie qui parle une langue finno-ougrienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2cb62d-de3f-4fe7-91bc-13cd5960ad96",
                                                "sense_id": "8e524077-54d8-3106-b4bc-fbe772acefe5",
                                                "text": "Les langues samoyèdes."
                                            },
                                            {
                                                "example_id": "8913fd88-016d-424a-86b9-aeb1bbc2cad5",
                                                "sense_id": "8e524077-54d8-3106-b4bc-fbe772acefe5",
                                                "text": "Souche samoyède, à laquelle appartiennent les petites tribus samoyèdes qui errent dans les vastes solitudes du gouvernement d’Arkhangel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "samoyède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                                        "entry_id": "d0c6ae11-c9a2-381b-b107-7c34ddca9217",
                                        "glosses": [
                                            "Chien polyvalent, voisin du loup, originaire de Sibérie, à poil épais, blanc, crème ou fauve."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af5026d-fe1b-4adf-bbef-e250a27d5d59",
                                                "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                                                "text": "Le samoyède était utilisé par la tribu des Samoyèdes (aujourd’hui essentiellement Nénètses) pour tirer les traîneaux notamment."
                                            },
                                            {
                                                "example_id": "8f4c362c-1a02-4b59-8080-c7daa2819c1a",
                                                "sense_id": "70588ad1-47b7-3948-9b54-7ccf4933521e",
                                                "text": "Le samoyède fait partie du groupe 5 du classement des races de chien par la société centrale canine ou SCC."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
