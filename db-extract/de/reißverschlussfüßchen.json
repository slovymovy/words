                        "sense_id": "e91aa587-32ce-34af-81d7-fd49b9661710",
                        "entry_id": "99336e62-1632-3003-9e66-059e042f2dc2",
                        "glosses": [
                            "ein Teil der Nähmaschine zum Vernähen von Reißverschlüssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf0779c-d794-4629-972c-c762124668e2",
                                "sense_id": "e91aa587-32ce-34af-81d7-fd49b9661710",
                                "text": "„Wähle das Reißverschlussfüßchen und entferne den Flachbett-Teil, um den Freiarm zu benutzen.“"
                            },
                            {
                                "example_id": "d5a01dce-fe89-412a-a70a-e7a36aca1422",
                                "sense_id": "e91aa587-32ce-34af-81d7-fd49b9661710",
                                "text": "„Reißverschlussfüßchen gehören selten zur Standardausstattung der Nähmaschine.“"
                            },
                            {
                                "example_id": "b75d7689-ca22-4f3c-9a55-40a9ec08f001",
                                "sense_id": "e91aa587-32ce-34af-81d7-fd49b9661710",
                                "text": "„Das Reißverschlussfüßchen einsetzen und mit 5 mm Abstand zur Umbruchkante entlang einer Seite des Reißverschlusses von oben (Ausschnittkante) nach unten steppen, den Reißverschluss dabei mitfassen.“"
                            },
                            {
                                "example_id": "d9021fc0-59c4-487c-98cd-52de96bc0e1e",
                                "sense_id": "e91aa587-32ce-34af-81d7-fd49b9661710",
                                "text": "„Ein Taschenfutterteil C rechts auf rechts passgenau darauflegen, feststecken und mithilfe eines Reißverschlussfüßchens feststeppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
