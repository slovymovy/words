                                            {
                                                "example_id": "cbe07a53-81c0-43b3-bc08-4bfc3d89c86b",
                                                "sense_id": "af95475b-ce39-334b-a153-84a88087388a",
                                                "text": "Het reclameblok wordt ook vaak gebruikt door filmmaatschappijen voor trailers van hun nieuwe films. Dit jaar zal Marvel Studio's de trailer van de superheldenfilm Black Panther delen."
                                            },
                                            {
                                                "example_id": "11b31515-26d0-41c2-97b7-077b533711d9",
                                                "sense_id": "af95475b-ce39-334b-a153-84a88087388a",
                                                "text": "Het eerste deel van de superheldenfilm kwam vorig jaar uit. De première van Deadpool 2 stond gepland voor juni volgend jaar. Het is niet duidelijk of de productie vertraging oploopt."
                                            }
                                        ]
