{
    "word": "betimes",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ed211b3b-620e-3fd6-bc89-8c35ad953122",
                "word": "betimes",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                        "entry_id": "ed211b3b-620e-3fd6-bc89-8c35ad953122",
                        "glosses": [
                            "In good season or time; early, especially in the morning; seasonably."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e97876f4-d1be-4259-96a4-c475cf8f2ef4",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "Behold, as wilde asses in the desart, goe they foorth to their worke, rising betimes for a pray: the wildernes yeeldeth food for them, and for their children."
                            },
                            {
                                "example_id": "8a28a430-9715-4c3c-a8b0-330b1a654a2d",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "They slept well that night and betimes next morning the mother of Alaeddin arose and went with her bowl to the King's court which she found closed."
                            },
                            {
                                "example_id": "97608446-a694-4fd6-a05a-9572de243a9a",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "“I’ll answer for it, that he hath faced both the Catalan and the Moor, in his time, young as he may seem. Thou knowest that the nobles are wont to carry their sons, as children, early into the fight, that they may learn the deeds of chivalry betimes.”"
                            },
                            {
                                "example_id": "f106c863-2bf0-4541-b58c-54ee75320843",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "Smart lad to slip betimes away\nFrom fields where glory does not stay."
                            },
                            {
                                "example_id": "59de5d20-f7db-487d-ad43-de357f933aaf",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "I was up betimes in the morning, but Holmes was afoot earlier still, for I saw him as I dressed, coming up the drive."
                            },
                            {
                                "example_id": "b554ec7a-42d1-48ba-9928-7d451df14d92",
                                "sense_id": "6529a83d-46cb-360a-992d-4e2e724690c1",
                                "text": "However they dined very early, for the winter dusk fell betimes at this season [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4501375-9f83-3df4-891f-0a9360c92179",
                        "entry_id": "ed211b3b-620e-3fd6-bc89-8c35ad953122",
                        "glosses": [
                            "In a short time, soon; quickly, forthwith."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02ee76b1-74a5-45a7-8a40-46bf23dbd6c3",
                                "sense_id": "a4501375-9f83-3df4-891f-0a9360c92179",
                                "text": "[O]ne prayed God right heartily aloud that He would send them betimes a knight that durst convoy them through this strait pass."
                            },
                            {
                                "example_id": "d19be807-8609-4ea8-8afc-74be033af5d4",
                                "sense_id": "a4501375-9f83-3df4-891f-0a9360c92179",
                                "text": "Reproving betimes with sharpness...and afterward showing forth an increase of love toward him whom thou hast reproved[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "572a8a74-c036-4c96-9b9e-813047b3b574",
                        "source_entry_id": "ed211b3b-620e-3fd6-bc89-8c35ad953122",
                        "source_sense_description": "in good season or time",
                        "target_lang_word": "beizeiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beizeiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                        "entry_id": "de31f9df-4883-3d63-ad30-8c8979c1b65f",
                                        "glosses": [
                                            "zur rechten Zeit; bevor es für ein bestimmtes Vorhaben zu spät ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be53167-7ce7-4f33-ae33-366b12b32d57",
                                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                                "text": "Wir sollten uns beizeiten auf den Weg machen, um nicht in das angekündigte Gewitter zu geraten."
                                            },
                                            {
                                                "example_id": "3fc8173b-8443-4c8e-b52a-a0b0b36e02a7",
                                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                                "text": "Wenn du morgen pünktlich sein willst, musst du beizeiten aufstehen, sonst wird alles so hektisch."
                                            },
                                            {
                                                "example_id": "a2bbc0ac-4514-470d-ab34-69cb1ef9f4eb",
                                                "sense_id": "303d3d4a-7cc9-3d7f-ad8f-1022eb096c21",
                                                "text": "Kümmere dich beizeiten um einen Ausbildungsplatz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
