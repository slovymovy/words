                "senses": [
                    {
                        "sense_id": "5c36ea5e-a494-381c-8388-d42544bc14f3",
                        "entry_id": "88cbde42-78f4-3235-b544-8df0fc18506d",
                        "glosses": [
                            "Erkrankung der Schleimhäute (in den Atmungsorganen, dem Mund oder Ähnlichem), die sich durch Rötung, Anschwellung und Schmerzen bemerkbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e06a592-04b2-4490-a27b-fd4ddd08d5ca",
                                "sense_id": "5c36ea5e-a494-381c-8388-d42544bc14f3",
                                "text": "„Eine strenge Qualitätskontrolle ist hier wichtig. Schließlich könnten sich auch Rückstände von Pflanzenschutzmitteln oder andere Verunreinigungen in den Kräutertee verirrt haben. Auch bei der Zubereitung lassen sich die Kräutertees nicht über einen Kamm scheren. Manche Tees mögen's heiß, manche kühler und manche überhaupt kalt wie zum Beispiel die Eibischwurzeln, die den Reiz bei Schleimhautentzündungen lindern. Die Wurzeln werden etwa eine halbe Stunde kalt angesetzt und erst vor dem Trinken erwärmt.“"
                            },
                            {
                                "example_id": "05c26230-e328-454f-b876-4eb89c20d122",
                                "sense_id": "5c36ea5e-a494-381c-8388-d42544bc14f3",
                                "text": "„Rund ein Fünftel der Bevölkerung leidet mindestens einmal im Leben an einer Schleimhautentzündung.“"
                            },
                            {
                                "example_id": "eb1e6647-9fbd-4143-af9b-0f0f3b44f182",
                                "sense_id": "5c36ea5e-a494-381c-8388-d42544bc14f3",
                                "text": "„So können die sehr schmerzhaften Schleimhautentzündungen in ihrer Schwere und Dauer erheblich reduziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
