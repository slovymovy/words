                                        "entry_id": "64c737c2-5f5e-3a63-b0d2-9da3b9a8b0a6",
                                        "glosses": [
                                            "Effectuer une triangulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0f3e04-49c2-4d54-bc75-40f59497fd37",
                                                "sense_id": "5798102a-9b60-369d-9b3b-18b602bf7b44",
                                                "text": "Jean Picard (1620-1682) commence à trianguler la France (Amiens - Malvoisine) en 1666."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da45aff-0a86-3682-8641-62435914ceb9",
                                        "entry_id": "64c737c2-5f5e-3a63-b0d2-9da3b9a8b0a6",
                                        "glosses": [
                                            "Situer quelqu’un géographiquement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5525de-3f2f-4cc2-965c-26777f2e4fc7",
                                                "sense_id": "3da45aff-0a86-3682-8641-62435914ceb9",
                                                "text": "À Paris, dès que vous dites dans quel coin vous vivez, les gens vous triangulent à partir des monuments à proximité et en déduisent des tas de trucs sur vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
