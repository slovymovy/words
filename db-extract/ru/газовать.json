                                        "entry_id": "d6d511bb-959e-3223-a6b3-15219e48f39b",
                                        "glosses": [
                                            "definizione mancante; se vuoi, aggiungila tu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4882909-ab35-4b2a-b064-a550cb121aa3",
