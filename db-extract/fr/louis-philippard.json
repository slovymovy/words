                "senses": [
                    {
                        "sense_id": "c92ae924-a70c-3758-a43b-df9bbb585f61",
                        "entry_id": "6d0b190c-6f73-3c0d-9b83-b91757273e96",
                        "glosses": [
                            "Celui qui soutenait Louis-Philippe ou qui soutient une monarchie constitutionnelle, s'appuyant sur la bourgeoisie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b734f74-6b0c-46f0-888e-63640a19de0f",
                                "sense_id": "c92ae924-a70c-3758-a43b-df9bbb585f61",
                                "text": "Les Louis-Philippards n'ont pas de place ici."
                            },
                            {
                                "example_id": "925b73c3-5859-4b2b-ac83-fd4246bcf87f",
                                "sense_id": "c92ae924-a70c-3758-a43b-df9bbb585f61",
                                "text": "Daumier montre à ses lecteurs ce qui se passe lorsque les louis-philippards se rendent à la revue et veulent rentrer chez eux. Ils sont trempés par l'eau qui tombe à foison."
                            }
                        ]
                    }
