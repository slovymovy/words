                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4fe5965-35da-34ec-838b-affae0c90e57",
                        "entry_id": "bba24a60-0786-35cd-a1e3-8a910d6ada86",
                        "glosses": [
                            "Gueulard, grande gueule, vociférant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2243b90d-5504-4655-8927-ce4428e3fc4c",
                                "sense_id": "f4fe5965-35da-34ec-838b-affae0c90e57",
                                "text": "Долго преследовал парень побитый\nБарина бранью своей ядовитой:\n«Мы-ста тебя взбутетеним дубьём\nВместе с горластым твоим холуём!»",
                                "translation": "Le garçon battu poursuivit longtemps\nSon maître de ses injures venimeuses :\n« Nous allons te battre à coups de gourdin,\nAinsi que ton laquais grande gueule ! »"
                            }
                        ]
                    }
                ],
