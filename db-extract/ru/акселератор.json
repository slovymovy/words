                                    {
                                        "sense_id": "1a78d51a-49f0-3453-9897-beb3a36a878c",
                                        "entry_id": "387ed505-5252-3026-9810-be98d3ae0a9e",
                                        "glosses": [
                                            "Adjuvant au mortier ou du béton, qui en accélère la prise."
