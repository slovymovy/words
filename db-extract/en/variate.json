                ],
                "translations": [
                    {
                        "translation_id": "76f28020-531d-42b5-87b5-c6cec471202b",
                        "source_entry_id": "c0d433f1-1d1f-3deb-8578-4b7935553b7a",
                        "source_sense_id": "da35aade-d886-33f8-994e-b314fc92407f",
                        "source_sense_description": "(veraltet) verändern",
                        "target_lang_word": "verändern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verändern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad677a8-b299-3d50-bc2a-37f1ea195485",
                                        "entry_id": "3724f409-ae65-3919-9b6f-942fa062deba",
                                        "glosses": [
                                            "etwas in seiner Art oder Beschaffenheit ändern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec75e08d-0397-406d-bb84-ce03d46f301e",
                                                "sense_id": "bad677a8-b299-3d50-bc2a-37f1ea195485",
                                                "text": "Er veränderte die Einstellungen."
                                            },
                                            {
                                                "example_id": "10578a23-39b5-46c1-986e-e0aaa202151d",
                                                "sense_id": "bad677a8-b299-3d50-bc2a-37f1ea195485",
                                                "text": "An einem Tatort darf nichts verändert werden, bis die Spurensicherung eintrifft."
                                            },
                                            {
                                                "example_id": "39f7f89b-ff5f-4ed3-b724-76434b3efafe",
                                                "sense_id": "bad677a8-b299-3d50-bc2a-37f1ea195485",
                                                "text": "„Die germanische Invasion veränderte dauerhaft die Machtstrukturen in Britannien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                        "entry_id": "3724f409-ae65-3919-9b6f-942fa062deba",
                                        "glosses": [
                                            "in seiner Art oder Erscheinung anders werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae96934-1c93-4fdf-a8b7-28679971dca2",
                                                "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                                "text": "Die Gestalt einer Amöbe verändert sich ständig."
                                            },
                                            {
                                                "example_id": "3b8f8206-c181-48a9-a5c2-2d8c708c7f55",
                                                "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                                "text": "Manche Forscher freilich gehen noch viel weiter: Sie glauben, dass sich das Gehirn sogar verändert – wenn es nur lang genug mit Informationen aus der digitalen Welt beschossen wird."
                                            },
                                            {
                                                "example_id": "991aa03c-1403-432a-b433-c01821f227f8",
                                                "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                                "text": "„Nicht nur Audi, die gesamte Autowelt hat sich seit Beginn des Jahrtausends verändert.“"
                                            },
                                            {
                                                "example_id": "d973d3c6-893a-4726-a673-0fbe59e7f599",
                                                "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                                "text": "„Rene Maria Rilke traf eine Frau, er veränderte seinen Namen, wurde Vegetarier, lief plötzlich barfuß herum und - so wie er - veränderten sich die Briefe, die er an sie schrieb.“"
                                            },
                                            {
                                                "example_id": "9fad1412-02af-4111-ae28-f75bae669d6c",
                                                "sense_id": "db6d6638-76e3-3a5a-83fb-c9f95c30276c",
                                                "text": "„Die Stadt Shenzhen veränderte sich in dieser Zeit rasant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "515abaaf-6c8e-3f83-916d-fca788ab214b",
                                        "entry_id": "3724f409-ae65-3919-9b6f-942fa062deba",
                                        "glosses": [
                                            "den Arbeitsplatz wechseln"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f96ea3ca-d4a7-45d1-82f0-6908e9d56f43",
                                                "sense_id": "515abaaf-6c8e-3f83-916d-fca788ab214b",
                                                "text": "Sie wollte sich beruflich verändern, weil sie eine Führungsaufgabe anstrebte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
