                        "sense_id": "e18dbcd4-f3ae-3c18-b441-587ea5ad7307",
                        "entry_id": "5552d3ea-688c-33b9-9200-c66d156d27d0",
                        "glosses": [
                            "diminutive of дешёвый (dešóvyj, “cheap”)"
                        ],
                        "tags": [
                            "colloquial",
