                "senses": [
                    {
                        "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                        "entry_id": "fd0f3dce-d221-39f7-97e7-1e4c88774ec3",
                        "glosses": [
                            "Feedback von Schülern in Bezug auf ihre Schule, den Unterricht oder Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9d2630-bcf0-4132-94a9-ffc507c397f9",
                                "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                                "text": "„Schülerrückmeldungen können darstellend (nonverbal), mündlich oder schriftlich erfolgen.“"
                            },
                            {
                                "example_id": "fe13ca8f-e234-45c0-8ff0-4ed837d4600b",
                                "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                                "text": "„Schülerrückmeldungen werden häufig vernachlässigt.“"
                            },
                            {
                                "example_id": "5071c1f9-373c-4096-b5aa-de2076298492",
                                "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                                "text": "„Dabei kommt dem Lernen aus den eigenen Praxiserfahrungen (z.B. anhand von Schülerrückmeldungen) für alle Kompetenzbereiche Relevanz zu.“"
                            },
                            {
                                "example_id": "fdbe986c-efe0-4097-8b43-581c70bcfede",
                                "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                                "text": "„Damit können gleichzeitig die gewählten Kriterien für eine motivierende Gestaltung von Arbeitsblättern anhand der Testergebnisse und positiven Schülerrückmeldungen als geeignet angenommen werden.“"
                            },
                            {
                                "example_id": "189c0f31-2e41-40e1-8fe3-bffad7a0ec62",
                                "sense_id": "bc3fff88-1e75-3ec1-aeb9-51995e2bb5f1",
                                "text": "„Der Lehrer hingegen kann mit Hilfe der Schülerrückmeldungen versuchen, seinen Unterricht so zu gestalten, dass möglichst viele Schüler die Lehrziele erreichen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
