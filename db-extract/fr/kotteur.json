                        "examples": [
                            {
                                "example_id": "cbe9a57b-3025-491e-b01b-59de3424351c",
                                "sense_id": "9d4ad2a8-77a6-3016-8bdf-a8bf6623b317",
                                "text": "Elle demande que le règlement voté soit revu et que l'éventuelle taxe à payer le soit par le propriétaire du logement de l'étudiant kotteur."
                            },
                            {
                                "example_id": "b476c2cf-169c-44e1-827c-13573c1cdc15",
                                "sense_id": "9d4ad2a8-77a6-3016-8bdf-a8bf6623b317",
                                "text": "Puis, c'est devenu une passion aussi, en vacances avec des amis. Alors que le four à micro-ondes et les plats préparés et surgelés sont souvent le quotidien des étudiants kotteurs, Paul Magnette se félicite d'avoir eu \"des parents et des grands-parents qui aimaient cuisiner et mangeaient beaucoup de légumes\"."
                            }
                        ]
                    }
