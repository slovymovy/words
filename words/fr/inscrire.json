    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9619b38-280c-35f4-b070-13a3c80cf742",
                    "sense_definition": "Enregistrer une personne ou noter une information sur une liste, un registre ou un document officiel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enregistrement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>inscrire</w> chaque nouvel élève sur le registre de l'école."
                        },
                        {
                            "text": "Pensez à <w>inscrire</w> votre adresse sur la première page de votre carnet."
                        }
                    ],
                    "synonyms": [
                        "enregistrer",
                        "noter"
                    ],
                    "antonyms": [
                        "désinscrire",
                        "radier",
                        "rayer",
                        "biffer"
                    ],
                    "common_phrases": [
                        "inscrire sur une liste",
                        "inscrire un enfant"
                    ]
                },
                {
                    "sense_id": "e10973cc-0b9b-35c4-b06d-c18b36b71bd0",
                    "sense_definition": "Graver, peindre ou tracer des mots sur une surface, un monument ou une plaque.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gravure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>inscrire</w> leurs deux prénoms au dos de la montre en or."
                        },
                        {
                            "text": "Les soldats ont voulu <w>inscrire</w> une devise sur le monument commémoratif."
                        }
                    ],
                    "synonyms": [
                        "graver"
                    ],
                    "common_phrases": [
                        "inscrire un nom",
                        "inscrire une devise"
                    ]
                },
                {
                    "sense_id": "eab02c48-ab73-301b-8f25-7cdce23539d6",
                    "sense_definition": "Marquer un but ou remporter des points lors d'une compétition sportive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant a réussi à <w>inscrire</w> deux buts spectaculaires avant la fin du match."
                        },
                        {
                            "text": "Notre équipe espère <w>inscrire</w> un point décisif lors de la prochaine manche."
                        }
                    ],
                    "synonyms": [
                        "marquer"
                    ],
                    "common_phrases": [
                        "inscrire un but",
                        "inscrire des points"
                    ]
                },
                {
                    "sense_id": "e93fc238-ab39-3b7a-9f8b-dc1d70db7e54",
                    "sense_definition": "Placer, intégrer ou situer un élément dans un cadre temporel, historique ou conceptuel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet écologique cherche à s'<w>inscrire</w> dans la durée pour protéger la planète."
                        },
                        {
                            "text": "Le gouvernement veut <w>inscrire</w> cette réforme dans le cadre des négociations européennes."
                        }
                    ],
                    "synonyms": [
                        "situer",
                        "intégrer"
                    ],
                    "common_phrases": [
                        "inscrire dans la durée",
                        "inscrire dans le cadre"
                    ]
                },
                {
                    "sense_id": "782af184-9a08-3f84-9903-9b2c1f1aefd1",
                    "sense_definition": "Tracer une figure géométrique à l'intérieur d'une autre de manière à ce qu'elles aient des points de contact.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous demande d'<w>inscrire</w> un triangle équilatéral dans un cercle parfait."
                        },
                        {
                            "text": "Il est difficile d'<w>inscrire</w> cette figure complexe à l'intérieur d'un rectangle."
                        }
                    ],
                    "common_phrases": [
                        "inscrire un polygone",
                        "inscrire un triangle"
                    ]
                }
            ]
        }
    ]
}