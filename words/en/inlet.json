                    }
                },
                {
                    "sense_id": "b8bd5fea-aca9-3acf-b0be-d71b153890f2",
                    "sense_definition": "To shape or hollow out the wooden stock of a firearm so that the metal parts fit neatly inside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gunsmith spent hours learning how to <w>inlet</w> the barrel securely into the walnut stock.",
                            "target_lang_translations": {
                                "ru": "Оружейник часами учился тому, как надежно <w>осадить</w> ствол в ореховую ложу."
                            }
                        },
                        {
                            "text": "It takes great precision to properly <w>inlet</w> the lock mechanism without damaging the wood.",
                            "target_lang_translations": {
                                "ru": "Требуется огромная точность, чтобы правильно <w>врезать</w> замочный механизм, не повредив дерево."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать выборку в ложе оружия для точной подгонки металлических деталей."
                    },
                    "translations": {
                        "ru": [
                            {
