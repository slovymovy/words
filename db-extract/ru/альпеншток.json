                                        "sense_id": "17c6e5cb-f8ce-365d-92a0-12cf571e4657",
                                        "entry_id": "7173a285-f30e-37b4-a34f-70d3b79ca019",
                                        "glosses": [
                                            "Stock für Bergwanderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a3bb3b-6de6-4f2a-9875-1696a00976d4",
                                                "sense_id": "17c6e5cb-f8ce-365d-92a0-12cf571e4657",
                                                "text": "„Nikolai und Claire traten zur Seite, um einer Familie Platz zu machen, die mit Rucksäcken und Bergstöcken den Weg bergab trottete.“"
                                            },
                                            {
                                                "example_id": "afcf4d29-0e3e-4401-970e-312dc4b2881a",
                                                "sense_id": "17c6e5cb-f8ce-365d-92a0-12cf571e4657",
                                                "text": "„Es gab Bücherregale mit herrlichen unlesbaren Büchern und – in einem Winkel – eine Flinte, ein Schmetterlingsnetz und einen Bergstock.“"
                                            },
                                            {
                                                "example_id": "8899afd5-be1e-41a6-a83f-dd1e88ff7656",
                                                "sense_id": "17c6e5cb-f8ce-365d-92a0-12cf571e4657",
                                                "text": "„Als Stock nahm Pécuchet einfach einen sechs Fuß hohen Bergstock mit langer Eisenspitze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
