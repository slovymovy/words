                        "glosses": [
                            "Action de détrousser, de voler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d258d02-abda-492d-a320-a8d4713041d5",
                                "sense_id": "38922bbc-cd45-3496-a74f-3cbd74d7a23d",
                                "text": "Ce raisonnement persuasif convainquit notre hôte et ses acolytes, qui se contentèrent pour cette fois des moyens de détroussement ordinaires permis aux aubergistes de toutes les contrées."
                            },
                            {
                                "example_id": "cf374d04-6c33-4aea-b3bd-a749a5823f6e",
                                "sense_id": "38922bbc-cd45-3496-a74f-3cbd74d7a23d",
                                "text": "Les administrateurs du Panama pouvaient se croire aux bouts de ces détroussements, lorsque la commission nommée pour étudier le projet de valeurs à lots se trouva partagée par moitié : cinq pour et cinq contre."
                            },
                            {
                                "example_id": "7e45a81e-93b0-4021-ab40-93f297d9c6e2",
                                "sense_id": "38922bbc-cd45-3496-a74f-3cbd74d7a23d",
                                "text": "Voilà trois semaines que je ne l’ai vue, ayant été appelé en province et en famille par un de ces partages à l’amiable qui ne laissent pas de rappeler à l’occasion quelque conciliabule de gentilshommes, après détroussement de diligence."
                            }
                        ]
                    }
