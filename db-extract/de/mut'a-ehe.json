                        "examples": [
                            {
                                "example_id": "821f869e-f782-4b60-87df-e8ef6b3d867b",
                                "sense_id": "6a2d1e65-b230-3059-9470-8d4a35d30913",
                                "text": "Ein Beispiel in diesem Zusammenhang ist das schiitische Konzept der Ehe auf kürzere oder längere Zeit (die sogenannte mut'a—Ehe, «Genußehe»)."
                            },
                            {
                                "example_id": "617a5540-d8f0-4b2e-8a21-f25ebbd88a09",
                                "sense_id": "6a2d1e65-b230-3059-9470-8d4a35d30913",
                                "text": "Obwohl die Mut'a-Ehe kein echtes Familienleben zustandebringen konnte, wurde die Frau als Ehefrau angesehen."
                            }
