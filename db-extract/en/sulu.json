                "senses": [
                    {
                        "sense_id": "be124bec-93ba-302f-9398-b890816fe7c4",
                        "entry_id": "f846b1ec-7969-3adb-aa3d-42a52c92cb02",
                        "glosses": [
                            "A member of a prominent Moro tribe, occupying the Sulu Archipelago."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e65c4965-70ae-4365-b127-cdc7c644509c",
                                "sense_id": "be124bec-93ba-302f-9398-b890816fe7c4",
                                "text": "That is the reason why the Sulu people have the right, and that they came to make the dredge (badja) to get the mother-of-pearl shell from the deep, because they can not see them."
                            },
                            {
                                "example_id": "78e3cda3-2da5-4f88-ade2-5a5bce9f53e2",
                                "sense_id": "be124bec-93ba-302f-9398-b890816fe7c4",
                                "text": "At the present time there are but few remains on the Island of Jolo of the past glory and civilization of the Sulu people."
                            },
                            {
                                "example_id": "c1c59378-9ab2-498f-b39a-73cc4e22442a",
                                "sense_id": "be124bec-93ba-302f-9398-b890816fe7c4",
                                "text": "If the Spaniards merely meant to subjugate the Sulu, suppressing piracy and lawlessness on the way and no more, they would have been applauded in many quarters."
                            }
                        ]
                    }
                ],
