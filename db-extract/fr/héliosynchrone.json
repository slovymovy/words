                                    {
                                        "sense_id": "79dacb97-b454-39c4-b9a7-c7c7f508a00f",
                                        "entry_id": "bf2244c9-a58e-34ae-8e73-2ae8279a7378",
                                        "glosses": [
                                            "Describing an orbit around the Earth where each passage in the same direction along a given latitude will occur throughout the year at the same true solar time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4c96e9-6905-4e96-98f1-82cfcc72bfc8",
                                                "sense_id": "79dacb97-b454-39c4-b9a7-c7c7f508a00f",
                                                "text": "A heliosynchronous orbit is an orbit [around the Earth] whose plane precesses by [a little less than] one degree a day around the line of the poles, thus keeping the same position in relation to the Earth-Sun line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a5a5bb-0071-325b-97a8-993d4f3e468e",
                                        "entry_id": "bf2244c9-a58e-34ae-8e73-2ae8279a7378",
                                        "glosses": [
                                            "Describing an orbit around the Sun in which the period of revolution is the same as the Sun's period of rotation."
                                        ],
