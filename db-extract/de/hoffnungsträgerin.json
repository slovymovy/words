                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712e6832-1d1d-4e6c-85a2-5f9c0cbd5537",
                                "sense_id": "856e1547-6e10-33f5-9ea5-c8b12a4138cf",
                                "text": "„Caputova hatte die Präsidentenwahl im März als Hoffnungsträgerin einer parteienübergreifenden Protestbewegung gegen Korruption und Amtsmissbrauch gewonnen […].“"
                            },
                            {
                                "example_id": "64fdfffc-6a9d-4d0b-b108-4bcdbe39b3b4",
                                "sense_id": "856e1547-6e10-33f5-9ea5-c8b12a4138cf",
                                "text": "„Außerdem fiel ihr mit frustriertem Stolz auf, dass die letzten Hoffnungsträgerinnen für das Buch ausschließlich Frauen waren: Margaret und Jane, Harriet und nun vielleicht Virginia Woolf.“"
                            }
                        ],
