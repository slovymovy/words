                        ],
                        "examples": [
                            {
                                "example_id": "9ccedb3f-3cd2-48d1-be65-768d61fc916f",
                                "sense_id": "a3d09dce-d38e-37e9-99fc-d36fc08db35e",
                                "text": "Het hitteschild beschermt de ruimtevaartuigen tegen de extreme hitte bij terugkeer in de atmosfeer.",
                                "translation": "The heat shield protects spacecraft from the extreme heat during re-entry into the atmosphere.",
                                "english": "The heat shield protects spacecraft from the extreme heat during re-entry into the atmosphere."
                            },
                            {
                                "example_id": "4e50a5ff-c54f-4791-82df-3672282134c0",
                                "sense_id": "a3d09dce-d38e-37e9-99fc-d36fc08db35e",
                                "text": "Het hitteschild is een essentieel onderdeel van de ruimtecapsule.",
                                "translation": "The heat shield is an essential component of the space capsule.",
                                "english": "The heat shield is an essential component of the space capsule."
                            },
                            {
                                "example_id": "6819df15-985d-4b0c-91c4-5ac88b60837e",
                                "sense_id": "a3d09dce-d38e-37e9-99fc-d36fc08db35e",
                                "text": "Tijdens de terugkeer naar de aarde, gloeit het hitteschild van de raket op door de wrijving met de atmosfeer.",
                                "translation": "During the return to Earth, the rocket's heat shield glows due to friction with the atmosphere.",
                                "english": "During the return to Earth, the rocket's heat shield glows due to friction with the atmosphere."
                            }
                        ]
                    }
                ],
