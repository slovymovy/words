                        "form": "réduplicatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ea4f66b-9a5c-3b2d-88e1-d677ed0d208a",
                        "entry_id": "c0af1895-dabc-3637-9e64-0880c0b82521",
                        "glosses": [
                            "Relatif à la réduplication, redoublé à l'identique, rédupliqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfedd334-ab12-4177-be4e-2fd6200f8c24",
                                "sense_id": "7ea4f66b-9a5c-3b2d-88e1-d677ed0d208a",
                                "text": "Quant aux réduplicatifs, on les formait, suivant le besoin, soit en parlant soit en écrivant"
                            }
                        ]
                    },
                    {
                        "sense_id": "60fb170d-8e23-3b66-9602-9f1a6b52acf0",
                        "entry_id": "c0af1895-dabc-3637-9e64-0880c0b82521",
                        "glosses": [
                            "Réitérateur, qui marque la répétition en parlant des verbes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55bcab1-d061-447f-a886-19df26b18d68",
                                "sense_id": "60fb170d-8e23-3b66-9602-9f1a6b52acf0",
                                "text": "Refaire, redire, redoubler sont des verbes réduplicatifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f62beee-385a-4ce5-8cdf-10ada73cf26f",
                        "source_entry_id": "c0af1895-dabc-3637-9e64-0880c0b82521",
                        "source_sense_description": "relatif à la réduplication",
                        "target_lang_word": "reduplicative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reduplicative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52967c99-e1f1-3aad-b653-c1a60474b35f",
                                        "entry_id": "568ee1b0-38f0-3317-8dfe-2f7adef02529",
                                        "glosses": [
                                            "Formed by redoubling; reduplicate, double"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ef0ed3-197f-40ba-a286-361b97d7c2c6",
                                                "sense_id": "52967c99-e1f1-3aad-b653-c1a60474b35f",
                                                "text": "The loss of the reduplicative syllable in the perfect is sufficiently accounted for by the same occurrence in almost all the modern, and even some of the ancient branches of the Indo-Germanic family."
                                            },
                                            {
                                                "example_id": "c0391e51-006f-433d-b7fe-613bd8b79061",
                                                "sense_id": "52967c99-e1f1-3aad-b653-c1a60474b35f",
                                                "text": "A hyphen (-) is generally used to indicate the boundary between the components of ordinary and reduplicative compounds in derivational morphology."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reduplicative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d77ebbe-9ab1-3464-903f-cad394f7bb3a",
                                        "entry_id": "f98f0045-3847-378b-9ddf-ea1334a6e7da",
                                        "glosses": [
                                            "A word obtained by the process of reduplication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7034858-d4d3-4645-850c-ed8053506fc8",
                                                "sense_id": "1d77ebbe-9ab1-3464-903f-cad394f7bb3a",
                                                "text": "Grammatically, Malay uses reduplication for plurals (burung = bird, burung-burung = birds) and thus repeated words are commonly heard in Malay speech; in contrast, in English reduplicatives are much less frequent and often involve phoneme modulation (ding-dong; wham-bam)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
