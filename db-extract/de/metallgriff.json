                "senses": [
                    {
                        "sense_id": "f026d8ab-8157-3138-8213-49aba63cd91a",
                        "entry_id": "42e47ffb-03ef-385e-94fe-6d42357d4483",
                        "glosses": [
                            "Griff aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676c46b1-8e42-4ec3-8e2d-a19ea121c336",
                                "sense_id": "f026d8ab-8157-3138-8213-49aba63cd91a",
                                "text": "„Er griff unter den Mantel, wo seine eigene Waffe in ihrem Halfter steckte, und schloss die rechte Hand um den geriffelten Metallgriff.“"
                            },
                            {
                                "example_id": "7077a498-6b7c-424f-86f3-7aa6f2fb5762",
                                "sense_id": "f026d8ab-8157-3138-8213-49aba63cd91a",
                                "text": "„Rapp entriss ihm die Pistole, holte damit aus und erwischte den Gegner mit dem schweren Metallgriff voll an der Stirn.“"
                            },
                            {
                                "example_id": "d7c020e1-dea9-4982-bef9-b76741591778",
                                "sense_id": "f026d8ab-8157-3138-8213-49aba63cd91a",
                                "text": "„Nun hob er die Augen, sah jedoch nicht sie an, sondern in die spiegelnden Glasplatten hinter dem Barkeeper, betrachtete auch die Reflexionen in den Glasflaschen und Glasregalen, sogar die Spiegelungen in den Metallgriffen der Zapfanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
