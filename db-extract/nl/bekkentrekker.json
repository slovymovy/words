                    {
                        "sense_id": "63aca7bb-5296-3952-b674-c9a977c15c2d",
                        "entry_id": "b8c98406-6c44-3bc2-b565-f8406bb38fbb",
                        "glosses": [
                            "iemand die voor de grap gekke gelaatsuitdrukkingen aanneemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c74002-f2ae-4660-bd2e-e70f592e2b7d",
                                "sense_id": "63aca7bb-5296-3952-b674-c9a977c15c2d",
                                "text": "Thomas Voeckler was vandaag weer een opvallende figuur in de etappe richting Lille. De gekke bekkentrekker hield zijn solovlucht voor bekeken op 15 kilometer van de streep, maar amuseerde zich rot, zo reageerde hij na afloop van de vierde rit."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfb232da-7780-3e8b-a790-348cc64898a3",
                        "entry_id": "b8c98406-6c44-3bc2-b565-f8406bb38fbb",
                        "glosses": [
                            "walging veroorzakend eten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2957ea97-936d-486c-9d01-1ac6e41fdc9f",
                                "sense_id": "dfb232da-7780-3e8b-a790-348cc64898a3",
                                "text": "\"Wat leuk dat deze oma's nog zo actief zijn,\" zeggen we nog opbeurend tegen elkaar. Tot we het eten proeven, dat zelfs in het meest ingedutte bejaardentehuis nog voor een opstand zou zorgen. De kaneelwijn blijkt een bekkentrekker, de koude pannenkoek met schimmelkaas en mossel zorgt voor een smakenpalet waar wij niet mee kunnen omgaan."
                            }
                        ]
                    }
