                                    {
                                        "sense_id": "81fe4ec3-eaf2-3a8d-ae7f-cd01fd02dc2f",
                                        "entry_id": "cac71f7d-912c-349d-a92d-f0ba1d96d7f8",
                                        "glosses": [
                                            "periode dat bloemen bloeien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25ed714-4930-49a1-9086-4341b33d4399",
                                                "sense_id": "81fe4ec3-eaf2-3a8d-ae7f-cd01fd02dc2f",
                                                "text": ",,Vorig jaar viel Pasen drie weken eerder en lag de temperatuur aanzienlijk lager. Nu viel het paasweekend, waarin altijd veel toeristen in het land zijn, samen met het hoogtepunt van de bloeiperiode en prachtig weer. 23 graden met stralende zon: dan willen mensen naar buiten. Genieten van wat momenteel het mooiste stukje van de wereld is.’’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311f0609-a310-3153-b1c3-15f97a8275b8",
                                        "entry_id": "cac71f7d-912c-349d-a92d-f0ba1d96d7f8",
                                        "glosses": [
                                            "succesvol tijdperk"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcb18055-3336-4ae4-9c77-999506c80a8e",
                                                "sense_id": "311f0609-a310-3153-b1c3-15f97a8275b8",
                                                "text": "Ongefundeerde belastingverlaging voor de rijken en bedrijven. Dat kan een gevaar zijn voor een evenwichtige wereldhandel. De bloeiperiode van de economie in de Verenigde Staten beschouwt hij nu als de zijne. Dat was dus niet onder Obama tot stand gekomen, nee het was Trump. Hoe hebben we ons zo kunnen vergissen?"
                                            },
                                            {
                                                "example_id": "ca655cd5-f99a-4998-9092-3dbfff25320d",
                                                "sense_id": "311f0609-a310-3153-b1c3-15f97a8275b8",
                                                "text": "Na de Tweede Wereldoorlog profileerde Vlissingen zich nog nadrukkelijker als arbeidersstad. Scheepswerf De Schelde maakt een bloeiperiode door. ,,De laatste jaren wordt Vlissingen steeds meer een stad van de dienstverlening”, zegt Van Druenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
