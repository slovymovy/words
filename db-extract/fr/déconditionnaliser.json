                "senses": [
                    {
                        "sense_id": "47c4292d-c2ad-3c18-adad-56c529f6de15",
                        "entry_id": "f9a2aa79-d1af-33b4-8c23-67e62c764437",
                        "glosses": [
                            "Faire perdre son caractère conditionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a77274-54df-481f-954a-a08f10508a09",
                                "sense_id": "47c4292d-c2ad-3c18-adad-56c529f6de15",
                                "text": "Pour en contrebalancer les effets les plus désastreux, tels que la reconduction de la combine, le renforcement de la temporalité de la rue et, surtout, le rejet de toute aide institutionnalisée, il s’agit de déconditionnaliser l’octroi des allocations et avantages divers aux personnes sans domicile fixe."
                            },
                            {
                                "example_id": "d482a069-12f3-4aed-b2c0-011c2341886b",
                                "sense_id": "47c4292d-c2ad-3c18-adad-56c529f6de15",
                                "text": "Le Canada devrait progressivement déconditionnaliser son programme d’aide bilatérale en permettant aux pays bénéficiaires de s’approvisionner auprès d’autres pays en développement et en les y encourageant."
                            }
                        ]
                    }
                ],
