                            "target_lang_translations": {
                                "pl": "Francuski malarz Jean-François <w>Millet</w> słynął ze swoich scen przedstawiających chłopów."
                            }
                        },
                        {
                            "text": "Mr. <w>Millet</w> arrived at the conference earlier than the other speakers.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Millet</w> przybył na konferencję wcześniej niż pozostali prelegenci."
                            }
