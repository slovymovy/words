                "senses": [
                    {
                        "sense_id": "608e388b-b546-3b22-b32b-78068bf3e85c",
                        "entry_id": "db18f553-b1ad-3269-b2f3-9ee2f325a6f5",
                        "glosses": [
                            "schamlose Frau, Schamlose"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75d9cb3f-8dc8-45d8-adae-a426b1652c01",
                        "source_entry_id": "db18f553-b1ad-3269-b2f3-9ee2f325a6f5",
                        "source_sense_id": "608e388b-b546-3b22-b32b-78068bf3e85c",
                        "source_sense_description": "schamlose Frau, Schamlose",
                        "target_lang_word": "schamlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schamlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "ohne Schamgefühl, die sittlichen Grenzen, die Regeln des Anstands verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8cbce5-1c66-486b-bdb3-66997c89cacc",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Diesmal wird sogar schamlos geflirtet."
                                            },
                                            {
                                                "example_id": "9e1bf7ce-0826-4ac1-9ca5-c350730760b4",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Durch die schamlose Performance scheint das Flair von Homosexualität, Perversität im Hochglanz, öffentlich zur Schau gestellter Nacktheit, Erotik und Befriedigung, … als Normalität und wird als Fest der Toleranz, Freiheit und Liebe gepriesen."
                                            },
                                            {
                                                "example_id": "8f98d42f-5d7e-47d2-919a-141785ebcacb",
                                                "sense_id": "dbc6c796-545c-38bf-885a-1b228144dc11",
                                                "text": "Wer seid Ihr, daß Ihr eine züchtige Frau, die, weiß Gott, nicht ihr freier Wille mit Euch zusammenführte, in Eure Arme zu fassen, ihr Ohr mit den schamlosen Anträgen roher Sinnlichkeit zu entweihen wagt?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                        "entry_id": "f60c6356-4d27-3867-b037-fa8552696e3e",
                                        "glosses": [
                                            "in der Handlungsweise die Rechte oder Gefühle anderer Menschen bewusst ignorierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dede07c-888a-4d20-a8cf-38bd8b760917",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Mit „Antikorruptionskampagnen“ versuchen sie jene Kader in den Griff zu bekommen, die sich schamlos bereichert haben – auch am Olympia-Projekt."
                                            },
                                            {
                                                "example_id": "be9803b6-fcf6-48ec-b74b-b220164bbe9a",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Die Farce erreichte ihren Gipfel, als Sudans Justizminister Reparationen für die Sklaverei forderte, während in seinem Land weiterhin schamlos Menschen versklavt werden."
                                            },
                                            {
                                                "example_id": "a992b06c-1b53-443a-a001-2b3922fefab8",
                                                "sense_id": "0b322b9f-0091-3e51-aa0a-6992fd1a8481",
                                                "text": "Der reiche Ausländer nutzt die Notsituation von Frauen und Kindern, die in Krisengebieten ums Überleben kämpfen, schamlos aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
