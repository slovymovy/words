                        "glosses": [
                            "That does not occur."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cbe933f-55e1-424f-892b-6c698ff55820",
                                "sense_id": "df9cfe1f-7ae5-3966-9726-cf321d77b78d",
                                "text": "It was none of these, for form does not occur, & enlightenment does not occur: how can the unoccurring be enlightened about the unoccurring?"
                            },
                            {
                                "example_id": "cff5709d-57a8-45d9-a4b8-3af3143721ad",
                                "sense_id": "df9cfe1f-7ae5-3966-9726-cf321d77b78d",
                                "text": "It is a kind of time that is simply and overwhelmingly there, laid out, unoccurring, and he lacks the inborn ability to reconceive this condition."
                            }
                        ]
                    }
