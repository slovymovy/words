                "senses": [
                    {
                        "sense_id": "ea9c7ed4-e0ca-3db7-a9e6-ac8671a2ac67",
                        "entry_id": "07b51b38-6516-35f1-8ff6-3d6fc6a5a53c",
                        "glosses": [
                            "bóg dróg, podróżnych, wędrowców, kupców, złodziei, pasterzy i wynalazców, utożsamiany z rzymskim Merkurym"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "71d12e09-3119-4bba-a8a7-093b742850a4",
                                "sense_id": "ea9c7ed4-e0ca-3db7-a9e6-ac8671a2ac67",
                                "text": "Atrybutami Hermesa były: kaduceusz, kapelusz o szerokim rondzie (petasos), skrzydlate sandały, sakiewka, owca, cyprys, migdałowiec i miód."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3e4779fe-f566-3d27-9af5-61244ce41a1e",
                        "entry_id": "07b51b38-6516-35f1-8ff6-3d6fc6a5a53c",
                        "glosses": [
                            "imię męskie; imię mitologiczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e16a1f8-37dd-4790-b424-c37add01c5cb",
                                "sense_id": "3e4779fe-f566-3d27-9af5-61244ce41a1e",
                                "text": "Mam na imię Hermes i jestem podróżnikiem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
