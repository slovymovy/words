                "senses": [
                    {
                        "sense_id": "13b1699c-c47c-3a3f-a040-60c3bb371c4a",
                        "entry_id": "3393c057-d9dc-3d8c-b5d0-fa0910567b85",
                        "glosses": [
                            "eine nicht so ertragreiche, aber qualitativ sehr hochwertige rote französische Rebsorte, die ursprünglich nur im Rhonetal kultiviert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b95572c-47d8-404c-8dcd-c06a6091a9aa",
                                "sense_id": "13b1699c-c47c-3a3f-a040-60c3bb371c4a",
                                "text": "„Die Syrah-Rebe hat so hohe Bedeutung erlangt und ist so begehrt, dass sie in die Nobilität der Weinwelt aufrückte und als Edelrebe bezeichnet wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c439a77-8965-3bec-8d66-771642840473",
                        "entry_id": "3393c057-d9dc-3d8c-b5d0-fa0910567b85",
                        "glosses": [
                            "ein Wein aus Trauben der Rebsorte Syrah"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129ce3a2-1099-4772-8102-01fd04fa5f49",
                                "sense_id": "6c439a77-8965-3bec-8d66-771642840473",
                                "text": "„Syrah-Weine haben meist ein kräftiges Johannisbeer-Aroma.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc858ec7-60a2-42ef-80ef-84332129c471",
                        "source_entry_id": "3393c057-d9dc-3d8c-b5d0-fa0910567b85",
                        "source_sense_id": "6c439a77-8965-3bec-8d66-771642840473",
                        "source_sense_description": "Weinbau: ein Wein aus Trauben der Rebsorte Syrah",
                        "target_lang_word": "syrah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syrah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                        "entry_id": "e6026a95-690b-31ac-8647-8a8e72c0f52a",
                                        "glosses": [
                                            "Cépage originaire des côtes du Rhône, mais maintenant utilisée dans le monde entier. Il donne un raisin noir à peau fine et à la pruine abondante. Il est issu du croisement entre la mondeuse blanche et le dureza (cépage à raisin noir)."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb13a545-c733-425e-9668-80275d4bcb24",
                                                "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                                "text": "Né d’une âpre syrah,\n D’un peu de carignan\n D’une terre solaire,\n Des mains d’un paysan,\n C’est avec ce vin là\n Qu’on dit qu’Ulysse a mis\n Le cyclope à genoux\n Et Circée dans son lit…"
                                            },
                                            {
                                                "example_id": "2a53c181-3a62-4a88-8a7e-15a2759a5a6b",
                                                "sense_id": "62a0b17c-b4ba-326d-bec3-749e00488929",
                                                "text": "Premier exportateur de denrées alimentaires du pays, l’Etat du Victoria est aussi l’une des principales terres vinicoles d’Australie, particulièrement réputée pour ses syrah, pinot noir et chardonnay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc75d131-9c88-3e93-b399-77d80c8483c7",
                                        "entry_id": "e6026a95-690b-31ac-8647-8a8e72c0f52a",
                                        "glosses": [
                                            "Vin tiré des raisins de ce cépage."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7911c6d8-ac02-4d80-9be0-eae951105fb1",
                                                "sense_id": "fc75d131-9c88-3e93-b399-77d80c8483c7",
                                                "text": "De même, le cahier des charges a été ouvert pour intégrer la syrah, adoptée habituellement dans le sud de la France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
