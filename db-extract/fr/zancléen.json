            {
                "entry_id": "b7363e33-4c14-36e1-9b9c-b95b4b90f52e",
                "word": "Zancléen",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9961fe75-6362-32ed-b6a8-5b4676c2629f",
                        "entry_id": "b7363e33-4c14-36e1-9b9c-b95b4b90f52e",
                        "glosses": [
                            "Étage stratigraphique du Pliocène dans le Cénozoïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82de44be-ce33-4ee1-b935-a5c26398387d",
                                "sense_id": "9961fe75-6362-32ed-b6a8-5b4676c2629f",
                                "text": "Le Zancléen est la première subdivision de l'époque du Pliocène. Elle s'étend de 5,333 à 3,600 millions d'années."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f3d8113-2fa8-4f68-a786-508dd3feb673",
                        "source_entry_id": "b7363e33-4c14-36e1-9b9c-b95b4b90f52e",
                        "source_sense_id": "9961fe75-6362-32ed-b6a8-5b4676c2629f",
                        "target_lang_word": "Zancleum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51adff3b-9704-4d77-a90a-c6141a438894",
                        "source_entry_id": "b7363e33-4c14-36e1-9b9c-b95b4b90f52e",
                        "source_sense_id": "9961fe75-6362-32ed-b6a8-5b4676c2629f",
                        "target_lang_word": "Zanclean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zanclean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dde7dc1-ecc7-346c-9688-3fb7748e35d6",
                                        "entry_id": "d8401d8a-8616-3d3e-bb77-34501c8cb065",
                                        "glosses": [
                                            "A geological subdivision, the earliest age of the Pliocene epoch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77c8b9c-6c22-4c3d-908c-51ff688fa251",
                                                "sense_id": "7dde7dc1-ecc7-346c-9688-3fb7748e35d6",
                                                "text": "1881, \"A. W. W.\", Notices of Memoirs: I.—Tertiary Geology of the Reggiano (Calabria), in Henry Woodward (editor), Geological Magazine, New Series, Decade 2, Volume 8, Trübner & Co., page 324,\nThe Pliocene is found at a much greater elevation than any of the other Tertiary series, reaching in the Zanclean to 1200 mètres above the sea, and as the conditions of deposition were quite different here from those which obtained in north Italy, the series in one part of the peninsula forms a complement to those in the other."
                                            },
                                            {
                                                "example_id": "a05db3fa-2609-4c21-88cd-ede618cd385f",
                                                "sense_id": "7dde7dc1-ecc7-346c-9688-3fb7748e35d6",
                                                "text": "In the first case the Early Pliocene coincides with the Zanclean and its upper boundary with the last occurrence of Globorotalia margaritae (Mazzei et al., 1978)."
                                            },
                                            {
                                                "example_id": "ab358b6f-7a1b-4f22-ac3e-f4762beaeedf",
                                                "sense_id": "7dde7dc1-ecc7-346c-9688-3fb7748e35d6",
                                                "text": "Warmer climates and sea level rises did not occur until the early Zanclean Pliocene (4.5 million years)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
