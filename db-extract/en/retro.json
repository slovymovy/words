                        "sense_id": "9c703064-1d98-380f-9852-8f054dd02bd6",
                        "entry_id": "80379c26-0a78-3e8f-bee5-ddb9d029de5f",
                        "glosses": [
                            "Of, or relating to, the past, past times, or the way things were."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3156d9-542f-48d9-bf87-94539468ec7a",
                                "sense_id": "9c703064-1d98-380f-9852-8f054dd02bd6",
                                "text": "Scientists say that while the public may think of the moon as a problem solved and a bit retro – the place astronauts visited a half-dozen times way back before Watergate and then abandoned with a giant \"meh\" from mankind – in fact, lunar studies is a vibrant enterprise that is yielding a wealth of surprises."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f3e4499-cf9c-39aa-93fa-b02170bf8e5a",
                        "entry_id": "80379c26-0a78-3e8f-bee5-ddb9d029de5f",
                        "glosses": [
                            "Affecting things past; retroactive, ex post facto."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f52d5d7-8fd5-4e93-a594-3342423e3b54",
                        "source_entry_id": "80379c26-0a78-3e8f-bee5-ddb9d029de5f",
                        "source_sense_description": "of, or relating to the past, past times, or the way things were",
                        "target_lang_word": "rétro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e515a5a6-bd8b-3f51-b193-afe4d64fed52",
                                        "entry_id": "e6964644-9218-3962-9fe7-5559ad1ed098",
                                        "glosses": [
                                            "Qui appartient au passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb64e46-86f4-4999-86ff-1b3b7b464a4c",
                                                "sense_id": "e515a5a6-bd8b-3f51-b193-afe4d64fed52",
                                                "text": "Il a un certain âge, des idées complètement rétro — un vrai facho, quoi. J’ai même quelquefois l’impression qu’il n’est pas dénazifié à cent pour cent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae93b40d-3956-37f6-b178-1ad93a644f60",
                                        "entry_id": "e6964644-9218-3962-9fe7-5559ad1ed098",
                                        "glosses": [
                                            "Se dit de quelque chose ou quelqu’un qui imite un style passé ou une mode révolue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2469fa-a77c-43af-a3c8-5bc9d89b1ecc",
                                                "sense_id": "ae93b40d-3956-37f6-b178-1ad93a644f60",
                                                "text": "La chanteuse rétro Nena Valverde sera la première à se produire dans une ambiance swing, cabaret et latino."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rétro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "909ca19c-dea0-3e55-a7fc-b46b28c0f957",
                                        "entry_id": "03b34377-5374-3ff4-b134-89c3ae3e5f32",
                                        "glosses": [
                                            "Qui revient en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a6ca7e9-5de8-455a-9c86-0de56ad3bd9d",
                                                "sense_id": "909ca19c-dea0-3e55-a7fc-b46b28c0f957",
                                                "text": "Ses boules à tête chercheuse tirant dans les coins, pourchassant celles de l'adversaire derrière un bassin, faisant la toupie, la roue et de beaux effets « rétro » avant d'aller, comme on dit sur le terrain, « faire téter le petit ». — (Le Point, 19 juill. 1976, p. 47, col. 3)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rétro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b63f24e7-9554-3c0b-84dd-9090e2a1a97a",
                                        "entry_id": "a9573ea9-3ac1-3766-805f-b135d59522a3",
                                        "glosses": [
                                            "Rétroviseur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474e13c5-b1e7-4fc9-b27a-eb0f20eba55d",
                                                "sense_id": "b63f24e7-9554-3c0b-84dd-9090e2a1a97a",
                                                "text": "Je prends le tunnel des Tuileries, c’est l’itinéraire, je descends doucement bicause la circule qui f’sait gribiche, y commence à faire du foin, à couiner dans les coins, je mate le rétro, z’auriez vu ses chasses sous les hublots : deux œufs au plat-paprika, vrai, je déconne pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
