                "senses": [
                    {
                        "sense_id": "52c445ee-4860-387f-929f-d681f4faa219",
                        "entry_id": "1a49d3dc-73e1-3054-b149-b4beabd89b23",
                        "glosses": [
                            "weibliche Person, die sich in einem Schwimmbad aufhält, das sich im Freien befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea89dfb-b29f-475d-8d75-5c6384b7909f",
                                "sense_id": "52c445ee-4860-387f-929f-d681f4faa219",
                                "text": "„Hatte das Bad bisher immer von 9 bis 20 Uhr offen, so ist der Zugang jetzt nur noch von 10 bis 19 Uhr möglich – bei gleichen Preisen. ‚Das ärgert einen schon. Wir gehen seit Jahren hierher‘, sagt eine regelmäßige Freibadbesucherin.“"
                            },
                            {
                                "example_id": "d01caa83-6b0e-4063-95bd-5a38a35dd364",
                                "sense_id": "52c445ee-4860-387f-929f-d681f4faa219",
                                "text": "„Langsam aber sicher müssen sich die Freibadbesucherinnen und -besucher auf das Saisonende einstellen […].“"
                            },
                            {
                                "example_id": "2423dc4a-d456-42ed-9a24-5519fc1445df",
                                "sense_id": "52c445ee-4860-387f-929f-d681f4faa219",
                                "text": "„Eine 19-jährige Freibadbesucherin hat geistesgegenwärtig reagiert und den kleinen Mann aus dem Wasser gezogen.“"
                            },
                            {
                                "example_id": "441ccf87-b659-40aa-a217-2e8b63c05451",
                                "sense_id": "52c445ee-4860-387f-929f-d681f4faa219",
                                "text": "„Eine andere Freibadbesucherin konnte das fünfjährige Mädchen, das noch nicht schwimmen kann, rechtzeitig aus dem Wasser holen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
