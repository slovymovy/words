                "senses": [
                    {
                        "sense_id": "04586541-5643-3221-b963-5e896bec60a0",
                        "entry_id": "7c4f5a09-c296-3fe2-a133-1f3a657c3485",
                        "glosses": [
                            "Damentoilette in Einrichtungen, in denen sich hauptsächlich Kinder aufhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b43dcc-b547-4f8a-912e-75e7e6f2be1a",
                                "sense_id": "04586541-5643-3221-b963-5e896bec60a0",
                                "text": "Jungs haben im Mädchenklo nichts verloren."
                            },
                            {
                                "example_id": "3c1bc0ed-c3c1-4c7a-90da-69e790349db2",
                                "sense_id": "04586541-5643-3221-b963-5e896bec60a0",
                                "text": "„Im Blaumann schleppt er das Gerüst für die Toilettenanlage durch den noch nackten Raum, der bald das Mädchenklo der Freien Schule Woltersdorf sein wird.“"
                            },
                            {
                                "example_id": "285bc67e-8ef9-4b58-a9ac-29d53a415335",
                                "sense_id": "04586541-5643-3221-b963-5e896bec60a0",
                                "text": "„Stück für Stück hat sich Martin das Mädchensein erkämpft. […] Mit dem stolzen Gang zum Mädchenklo, das er nun in der Hauptschule ganz offiziell benutzen darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
