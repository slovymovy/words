                        ],
                        "examples": [
                            {
                                "example_id": "7cef82ab-0f68-41dd-8841-1bd83f996688",
                                "sense_id": "0272a9f2-2382-3f74-9994-e502b031b818",
                                "text": "Les cryoglobulinémies décrites avec le VHA peuvent être monoclonales, polyclonales ou mixtes, de nature IgG, IgM, ou IgA. Elles seraient liées à une accumulation d’immunoglobulines dédialysées."
                            },
                            {
                                "example_id": "fa224f5c-4e2c-44cb-b7fa-e2e83cf2699c",
                                "sense_id": "0272a9f2-2382-3f74-9994-e502b031b818",
                                "text": "Une cryoglobulinémie pathologique peut être primaire ou secondaire à une autre affection."
                            }
                        ]
                    }
