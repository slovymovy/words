                "senses": [
                    {
                        "sense_id": "ba763ba4-4776-357b-88c6-688031844d19",
                        "entry_id": "fa12f48c-a0c2-3f1c-8d7c-dc3411e9647f",
                        "glosses": [
                            "Endphase in einer Partie Schach, in der außer den Königen nur noch ein oder mehrere Springer sowie Bauern auf dem Brett sind"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "90edf7d1-d16b-42f0-856d-12e562eef474",
                                "sense_id": "ba763ba4-4776-357b-88c6-688031844d19",
                                "text": "In Springerendspielen mit Springer gegen Bauern fällt es der Partei mit dem Springer oft schwer, ein Remis zu erreichen."
                            },
                            {
                                "example_id": "c01cd3de-134c-4230-8cb1-bed97c39a8ad",
                                "sense_id": "ba763ba4-4776-357b-88c6-688031844d19",
                                "text": "„Nach diesem kräftigem Schlussakkord ist das entstandene Springerendspiel leicht für Schwarz gewonnen.“"
                            },
                            {
                                "example_id": "b5ac0bba-89bb-4813-b990-6c38889464ef",
                                "sense_id": "ba763ba4-4776-357b-88c6-688031844d19",
                                "text": "„Das Springerendspiel ist natürlich völlig ausgeglichen, aber nun sollte Weiß zunächst mit dem König ins Zentrum laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
