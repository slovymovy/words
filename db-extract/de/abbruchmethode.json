                "senses": [
                    {
                        "sense_id": "df9c56a4-7ef4-3cd1-8f95-044c0871c90a",
                        "entry_id": "7c97081c-3aab-3ac9-8bd4-030bc61daa73",
                        "glosses": [
                            "bestimmte Art und Weise, etwas abzubrechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7ae6a5-fe45-4fe0-a6d8-91c18c10e56d",
                                "sense_id": "df9c56a4-7ef4-3cd1-8f95-044c0871c90a",
                                "text": "„Laut Aussage von Dipl.-Ing. Jörg Gnauert, von der Firma Himmel u. Papesch, ist diese Abbruchmethode wegen der Bahnstrecke unter der Brücke, schon ungewöhnlich, weil alle Teile der Brücke in Einzelteile zerlegt und mit zwei großen Autokränen nach oben abgehoben und anschließend mit einem Spezialbagger zerlegt werden.“"
                            },
                            {
                                "example_id": "3bfaa950-bc89-4a1d-ae14-7d05519bf78d",
                                "sense_id": "df9c56a4-7ef4-3cd1-8f95-044c0871c90a",
                                "text": "„Gerade für die rein mechanische Abbruchmethode in der frühen Schwangerschaft jedoch setzen sich Frauengruppen und -organisationen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
