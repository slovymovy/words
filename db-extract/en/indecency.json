    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                "word": "indecency",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "52051106-03ad-47b1-aa5f-4d83cdbcb7e4",
                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "indecencies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                        "glosses": [
                            "Lack of decency; the property or degree of being indecent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0c87a5-8997-4182-8dab-0df0ae0b4e49",
                                "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                                "text": "One sure sign of indecency is criticizing foreigners constantly, but remaining silent about the problems within your own land, or by your own people, or both."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a99de16-971b-35c1-a05d-6daa9e2debcf",
                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                        "glosses": [
                            "Something showing lack of decency; something (such as a word) that is indecent."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf78d38e-17fd-4d45-af8b-57d545950bde",
                        "source_entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                        "source_sense_description": "lack of decency",
                        "target_lang_word": "indécence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indécence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5616c3-c13d-3733-a643-ee12f72c4d56",
                                        "entry_id": "a541171e-0f6c-31e4-a8c1-27e2d301f396",
                                        "glosses": [
                                            "Caractère de ce qui est indécent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467ce63e-6fe1-433b-bea8-5d7d64ce70dc",
                                                "sense_id": "ec5616c3-c13d-3733-a643-ee12f72c4d56",
                                                "text": "Il y a de l’indécence dans sa tenue, dans ses propos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e86cb5-2a5a-3d92-acdd-5aa9a0ba3cf6",
                                        "entry_id": "a541171e-0f6c-31e4-a8c1-27e2d301f396",
                                        "glosses": [
                                            "Action ou propos indécent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa8141f8-4879-476e-a448-34451aa6b37d",
                                                "sense_id": "68e86cb5-2a5a-3d92-acdd-5aa9a0ba3cf6",
                                                "text": "Cette imagerie, désormais triomphante, […] ne laisse rien à deviner. Elle est franchement pornographique. Les petites polissonneries du siècle dernier semblent florianesques à côté d'une aussi grosse indécence."
                                            },
                                            {
                                                "example_id": "3b81c54e-6247-4003-8033-4ff1878ee560",
                                                "sense_id": "68e86cb5-2a5a-3d92-acdd-5aa9a0ba3cf6",
                                                "text": "Le chanoine se couvrit le visage d’une de ses mains.\n— Excusez-moi, mon père, dit Zénon. Non decet. Je ne commettrai plus l’indécence qui consiste à essayer de montrer les choses comme elles sont."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dfae3af-4821-4b47-9b67-17392f8ba035",
                        "source_entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                        "source_sense_description": "lack of decency",
                        "target_lang_word": "Unanständigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unanständigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "496e3930-6335-3848-b32a-450c1888712d",
                                        "entry_id": "477a9d3f-0421-35de-ad68-ca985415676d",
                                        "glosses": [
                                            "etwas gegen die guten Sitten Verstoßendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b1b4871-e239-49df-aca8-f5c020959d8f",
                                                "sense_id": "496e3930-6335-3848-b32a-450c1888712d",
                                                "text": "Bei dieser Art von Unanständigkeit verlor er jegliche Lust auf Romantik."
                                            },
                                            {
                                                "example_id": "fac24621-23c9-4a89-bba5-7a899e402415",
                                                "sense_id": "496e3930-6335-3848-b32a-450c1888712d",
                                                "text": "„Diese Verse, die ich trotz ihrer Unanständigkeit ausgezeichnet, witzig und gescheit fand, ließen mich hellauf lachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
