                "senses": [
                    {
                        "sense_id": "5272c448-7d3d-3f48-8225-4406beea36fb",
                        "entry_id": "99d0d258-8ad2-3416-a295-e72bb2d6a6e0",
                        "glosses": [
                            "Zeitalter zwischen dem Spätmittelalter (Mitte 13. Jahrhundert bis Ende 15. Jahrhundert) und dem Übergang vom 18. Jahrhundert zum 19. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07474b9-4d90-49c0-a5f7-550660c49466",
                                "sense_id": "5272c448-7d3d-3f48-8225-4406beea36fb",
                                "text": "„Die politischen Funktionen der Medien wurden bereits in der Frühmoderne deutlich.“"
                            },
                            {
                                "example_id": "42db6290-88f1-490b-8bf4-0a815163df5e",
                                "sense_id": "5272c448-7d3d-3f48-8225-4406beea36fb",
                                "text": "„In der Regel wird der grobe Zeitrahmen der Hexenverfolgungen in Europa auf den Übergang zur Frühmoderne 1450-1750 eingegrenzt, wobei es verfolgungsärmere und verfolgungsreichere Phasen gab.“"
                            },
                            {
                                "example_id": "7ad9027e-9d56-4454-ba9c-7122e90a5c20",
                                "sense_id": "5272c448-7d3d-3f48-8225-4406beea36fb",
                                "text": "„Eine große Veränderung des Krisenverständnisses fand nach Anbruch der Neuzeit in der Frühmoderne statt.“"
                            },
                            {
                                "example_id": "10210da9-2596-4dd8-927d-876fef3fe5c3",
                                "sense_id": "5272c448-7d3d-3f48-8225-4406beea36fb",
                                "text": "„Dem Mittelalter wird oftmals eine Dunkelheit attestiert, die die Frühmoderne abschütteln musste, um im übertragenen Sinne ins Licht gehen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
