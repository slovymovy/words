                                    {
                                        "sense_id": "0d5980a9-f51a-30aa-b98b-47095bfc9161",
                                        "entry_id": "671fa005-5256-36cc-9847-119aced2a32c",
                                        "glosses": [
                                            "An attractive, usually well-known, female model whose image has been featured on one or more magazine covers."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b4d5e8f-b73e-4d5b-95f2-3aa452400036",
                                                "sense_id": "0d5980a9-f51a-30aa-b98b-47095bfc9161",
                                                "text": "Whether it's in next-to-nothing swimsuits in Sports Illustrated or starring in ex-husband Billy Joel's rock videos or in countless boldface tabloid mentions, the quintessential California blond cover girl has become a fixture on the cultural landscape."
                                            },
                                            {
                                                "example_id": "ebf8c4a1-38b4-48e4-a484-e52324a3c646",
                                                "sense_id": "0d5980a9-f51a-30aa-b98b-47095bfc9161",
                                                "text": "She's sitting opposite a window that's gently breezing into her face, wafting her hair into cover-girl perfection and when I joke about this she roars with laughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
