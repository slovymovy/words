                            }
                        ]
                    },
                    {
                        "translation_id": "8c88156f-1974-426b-af81-7988646be103",
                        "source_entry_id": "f76656b6-142c-3dc1-ad42-020c1b5867f5",
                        "source_sense_id": "97535204-d938-3ea9-9837-07a20b1dd90e",
                        "target_lang_word": "populista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "846cfe53-c9a6-4966-a2f1-5548db8b8028",
                        "source_entry_id": "f76656b6-142c-3dc1-ad42-020c1b5867f5",
                        "source_sense_id": "97535204-d938-3ea9-9837-07a20b1dd90e",
                        "target_lang_word": "Populist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Populist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                        "entry_id": "e2908eec-c167-32c2-b000-0a32c8ffc02f",
                                        "glosses": [
                                            "Person, die ein Anhänger oder Vertreter des Populismus ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e118040c-31f8-4b62-bec9-4016c27c2142",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "In Europa sind eher Populisten am rechten politischen Spektrum erfolgreich, in Lateinamerika stehen sie links von der Mitte."
                                            },
                                            {
                                                "example_id": "78fd6bc3-37b4-49d2-97a8-7f88c37c0e13",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Entweder der Begriff Populist wird in einen neuen Kontext gestellt, oder aber er verschwindet gänzlich.“"
                                            },
                                            {
                                                "example_id": "7ef877cc-31f6-4433-b1ac-1ffce133d77b",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Dann könnte die Stunde des heute noch unbekannten Populisten schlagen.“"
                                            },
                                            {
                                                "example_id": "4c132121-6b08-4df8-99a4-934f945e6845",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Etwas unsicher auch Robert Misik in der Berliner TAZ: War der Populist Haider schwul oder bi? Und was geht uns das an?“"
                                            },
                                            {
                                                "example_id": "6fb52bf8-f967-45f9-8e58-0fb3a883f355",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Eines hat der Sportler Kohl mit dem Populisten Haider gemein: Er hat es mit Halbwahrheiten und perfiden Methoden an die Spitze geschafft.“"
                                            },
                                            {
                                                "example_id": "15dcfdcc-dacc-429b-b8e0-12df6e4d422d",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5314a414-ee8f-4609-b085-3fe550da21a4",
                        "source_entry_id": "f76656b6-142c-3dc1-ad42-020c1b5867f5",
                        "source_sense_id": "97535204-d938-3ea9-9837-07a20b1dd90e",
                        "target_lang_word": "популист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "популист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "752ee9c9-8854-3f16-8898-84214f894515",
                                        "entry_id": "708ca8db-66d5-3086-8bc1-a3978e6d3cb1",
                                        "glosses": [
                                            "полит. тот, кто использует популизм, склонен к популизму; деятель, ищущий популярности путём заигрывания с народными массами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f2aafc-7a91-49c7-b960-8e73b84cc660",
                                                "sense_id": "752ee9c9-8854-3f16-8898-84214f894515",
                                                "text": "Популисты строят свою риторику на акцентировании экономических и социальных интересов обычных людей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d67f365-7454-3455-83a5-4d6a51a22cfb",
                                        "entry_id": "708ca8db-66d5-3086-8bc1-a3978e6d3cb1",
                                        "glosses": [
                                            "истор. в США 1890-х — член фермерской партии, требовавшей наделения поселенцев землёй за счёт корпораций, снижения налогов, неограниченной чеканки монет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148552f4-0d16-4a7e-9969-443c5fed7d82",
                                                "sense_id": "5d67f365-7454-3455-83a5-4d6a51a22cfb",
                                                "text": "К 1900 партия популистов фактически прекратила своё существование."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
