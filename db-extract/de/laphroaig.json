                        "examples": [
                            {
                                "example_id": "2b4716aa-d5d9-4b91-ba9d-3d7088652a03",
                                "sense_id": "5c130525-b74f-3bf8-9e24-92ada1219a83",
                                "text": "Die Destillerie Laphroaig wurde 1815 gegründet."
                            },
                            {
                                "example_id": "18faa735-da7f-412c-a0ec-19a52799e5b5",
                                "sense_id": "5c130525-b74f-3bf8-9e24-92ada1219a83",
                                "text": "\"Laphroaig, pronounced \"La-froyg\", is an all-malt Scotch whisky from the remote island of Islay in the Western Isles of Scotland. Laphroaig is a Gaelic word, and means \"the beautiful hollow by the broad bay.\" In the making of Laphroaig, malted barley is dried over a peat fire. The smoke from this peat, found only on the island of Islay, gives Laphroaig its particularly rich flavour."
                            }
                        ],
