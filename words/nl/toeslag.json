            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12a0f449-733b-3338-abd6-8e3244fcf04a",
                    "sense_definition": "een financiële tegemoetkoming of uitkering van de overheid of werkgever voor specifieke kosten of situaties",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financiële ondersteuning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moeder kreeg een extra <w>toeslag</w> om te zorgen voor haar gehandicapte kind.",
                            "target_lang_translations": {
                                "en": "The mother received an extra <w>allowance</w> to care for her disabled child."
                            }
                        },
                        {
                            "text": "Veel mensen hebben recht op een maandelijkse <w>toeslag</w> voor hun zorgverzekering of huur.",
                            "target_lang_translations": {
                                "en": "Many people are entitled to a monthly <w>benefit</w> for their health insurance or rent."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijslag",
                        "toelage"
                    ],
                    "common_phrases": [
                        "recht op toeslag",
                        "toeslag aanvragen"
                    ],
                    "target_lang_definitions": {
                        "en": "a financial contribution or benefit from the government or employer for specific costs or situations"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "benefit",
                                "target_lang_sense_clarification": "government or insurance payment"
                            },
                            {
                                "target_lang_word": "allowance",
                                "target_lang_sense_clarification": "regular financial assistance"
                            },
                            {
                                "target_lang_word": "subsidy",
                                "target_lang_sense_clarification": "financial aid for specific costs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf1c14d2-b0c1-30c5-bd79-2c67a52418ce",
                    "sense_definition": "een extra bedrag dat bovenop de normale prijs of kosten betaald moet worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extra kosten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor het reizen tijdens de spits moet je soms een kleine <w>toeslag</w> betalen.",
                            "target_lang_translations": {
                                "en": "For traveling during rush hour, you sometimes have to pay a small <w>surcharge</w>."
                            }
                        },
                        {
                            "text": "Er geldt een <w>toeslag</w> voor zware pakketten die naar het buitenland worden verzonden.",
                            "target_lang_translations": {
                                "en": "There is a <w>supplement</w> for heavy packages sent abroad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een toeslag betalen",
                        "verplichte toeslag"
                    ],
                    "target_lang_definitions": {
                        "en": "an extra amount that must be paid on top of the normal price or costs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surcharge",
                                "target_lang_sense_clarification": "additional charge or tax"
                            },
                            {
                                "target_lang_word": "supplement",
