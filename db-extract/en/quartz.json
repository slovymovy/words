                "senses": [
                    {
                        "sense_id": "21649d5e-083e-3d3c-9a08-c00c1f2a1b10",
                        "entry_id": "a0b8cfd6-a2de-3653-8fa7-1369ed3fe031",
                        "glosses": [
                            "石英"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8faf3c-ca2d-4a40-8dfd-357274be5be4",
                                "sense_id": "21649d5e-083e-3d3c-9a08-c00c1f2a1b10",
                                "text": "The telescope and collimator have each an object-glass consisting of a single lens of quartz 1½ inch diameter and a focal length of 18½ inches for the sodium yellow light, but not more than 16 inches for the highest rays measured.",
                                "translation": "望遠鏡和準直器各有一個物鏡，由直徑1.5英寸的石英單透鏡組成，鈉黃光的焦距為18.5英寸，但測量的最高光線的焦距不超過16英寸。"
                            },
                            {
                                "example_id": "6f2c6805-f4de-4728-97a8-66dea7f72e25",
                                "sense_id": "21649d5e-083e-3d3c-9a08-c00c1f2a1b10",
                                "text": "Subsequently, the old Malay brought him the present specimen in a state of torpidity, telling him he had found it in a cavity of the quartz reef."
                            },
                            {
                                "example_id": "b5684b01-7ee1-44dc-9563-e5b95f2941eb",
                                "sense_id": "21649d5e-083e-3d3c-9a08-c00c1f2a1b10",
                                "text": "My meat eats me. Who waits at the gate? / Mother of quartz, your words writhe into my ear. / Renew the light, lewd whisper."
                            }
                        ]
                    },
                    {
                        "sense_id": "3427beaf-b4d3-3e11-b49c-17f5df42d275",
