                                    {
                                        "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                        "entry_id": "83f3870a-8931-33d3-af73-abf5494911be",
                                        "glosses": [
                                            "The state of two or more things existing together, usually in a temporal or spatial sense, with or without mutual interaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9e494d-0e23-42ba-b8c5-00a0bb57f743",
                                                "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                                "text": "The day of horror Israel has just experienced signals the end of the Netanyahu experiment in violent coexistence."
                                            },
                                            {
                                                "example_id": "070d633e-456d-4cac-83c5-b295bd16304d",
                                                "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                                "text": "While the PSOE’s leader and caretaker prime minister, Pedro Sánchez, argues that the act of clemency would help promote coexistence after the tumultuous political and territorial crisis of 2017, his opponents have decried the move as a cynical and self-serving means of remaining in power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe202ca9-099e-47dd-9e21-a7fd54309d4c",
                        "source_entry_id": "3252498e-d72e-3233-93d7-4e9ddb5f7240",
