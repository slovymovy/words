                                        "glosses": [
                                            "Eigenschaft, ängstlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4856475e-a9e7-43cf-be4b-9f01cebc0e53",
                                                "sense_id": "d9af7cb4-0ca8-31d5-9740-c1e2455d7866",
                                                "text": "„Ich konnte mir nicht schmeicheln, in Spanien irgend etwas ohne die Hilfe des Gesandten meiner Heimatstadt zu erreichen; dieser aber hätte in seiner Ängstlichkeit ohne den Brief, den ich ihm brachte, nie etwas zu tun gewagt.“"
                                            },
                                            {
                                                "example_id": "15816365-bcd6-4794-824c-3fd82e63dae6",
                                                "sense_id": "d9af7cb4-0ca8-31d5-9740-c1e2455d7866",
                                                "text": "„Nur erschien mit diesem auch eine gewisse Beklommenheit, eine Ängstlichkeit, die in demselben Maße zunahm, als er sich den Niederlassungen der Weißen näherte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
