                                                "sense_id": "e94c9bd3-2157-36bd-aba6-61c5b52b353d",
                                                "text": "Die Lunula ist meistens etwas heller, als der Rest des Nagels."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3a9327f5-3df2-3ee3-a0f4-4b1d88309040",
