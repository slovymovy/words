                            }
                        },
                        {
                            "text": "De politie kon de dief eindelijk bij zijn schouder <w>vastpakken</w>.",
                            "target_lang_translations": {
                                "en": "The police were finally able to <w>seize</w> the thief by his shoulder.",
                                "ru": "Полиция наконец смогла <w>схватить</w> вора за плечо."
                            }
