                        "entry_id": "b0cec565-8c06-32ef-969c-176d77ea8aeb",
                        "glosses": [
                            "Acronym of not emanating from main office, i.e. broadcast from some remote location instead."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
