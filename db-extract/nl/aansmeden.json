                    },
                    {
                        "sense_id": "018e9b29-8da5-3132-aaa2-4fe69afe66a7",
                        "entry_id": "080fd8cb-3c1f-37cd-aaf7-df966db5c49d",
                        "glosses": [
                            "zaken met elkaar verbinden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8b7e9cb0-2398-476f-96c8-12e5f043bd6e",
                                "sense_id": "018e9b29-8da5-3132-aaa2-4fe69afe66a7",
                                "text": "Onder dit gelukkig mijmeren en bij deze stille zelftevredenheid, waarin de ziel meer gevoelt dan het verstand zou kunnen uitdrukken, en waarin iedere schakel van het mogelijke zich zoo vrolijk aan de hoop van het waarschijnlijke laat aansmeden, trad onze Leydsche Wijsgeer het bosch van Monbalino in."
                            }
                        ]
                    }
