                ],
                "senses": [
                    {
                        "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                        "entry_id": "ddf23ffc-d516-316b-ae26-11e3fc39d2f1",
                        "glosses": [
                            "Wort, Äußerung bei Vollzug eines Schwurs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0ce832-34a1-4232-b1b7-c84696df998e",
                                "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                                "text": "„»Bitte, nicht die religiöse Formel«, sagt er entschieden in die ersten Schwurworte hinein, und der Vorsitzende entschuldigt sich kurz.“"
                            },
                            {
                                "example_id": "aa10411e-4d40-47b9-8909-2d3558481bc5",
                                "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                                "text": "„Als er sich bei der Verhaftung von Jesus mit dem Schwert wehrte, mochte er an die Schwurworte gedacht haben.“"
                            },
                            {
                                "example_id": "cedc5448-7236-47cd-95d6-f426b4a136ab",
                                "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                                "text": "„Sind die Schwurworte vom Kandidaten nachgesprochen, so küsst derselbe die Bibel, und erhält nun vom Meister einen Zirkel auf die Brust gesetzt, worauf jener drei Schläge tut, während ein Lied erklingt:…“"
                            },
                            {
                                "example_id": "64d6b70f-2738-4d8f-9aec-8899e0ec1715",
                                "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                                "text": "„Der HERR mache dich zum Anlass für ein Fluch- und Schwurwort in deinem Volk, indem der HERR deine Hüfte einfallen und deinen Bauch anschwellen lässt.“"
                            },
                            {
                                "example_id": "13ed2818-feca-497c-a71c-915e9f9655a4",
                                "sense_id": "ad3db16c-4365-3c55-a9c5-5b6c154d6ebe",
                                "text": "„Aber tausend Schwurwörter werden einen Lügner doch nicht glaubwürdiger machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
