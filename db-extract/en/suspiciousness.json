                "word": "suspiciousness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dae633ba-351c-36a4-aba6-30c856db8db2",
                        "entry_id": "919bc7cb-c0ae-36d5-8fbb-63f7f4cffd4a",
                        "glosses": [
                            "The state or quality of being suspicious in the sense of arousing suspicion."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b8b8ac09-4c5a-31ab-ba85-07b85dbe709c",
                        "entry_id": "919bc7cb-c0ae-36d5-8fbb-63f7f4cffd4a",
                        "glosses": [
                            "The state or quality of being suspicious in the sense of being distrustful or tending to suspect."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7624c59-4c04-4e6e-bab5-a9ba89cacf0f",
                        "source_entry_id": "919bc7cb-c0ae-36d5-8fbb-63f7f4cffd4a",
                        "source_sense_description": "state or quality of arousing suspicion",
                        "target_lang_word": "подозри́тельность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подозри́тельность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "417fb662-969d-3851-b2fc-1e011dc65288",
                                        "entry_id": "81b867bf-0306-3645-b7c8-b5fe2a809176",
                                        "glosses": [
                                            "свойство по значению прилагательного подозрительный; недоверчивость, склонность к возникновению, высказыванию подозрений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e52480-5b38-42ce-b5b1-42f217c4489b",
                                                "sense_id": "417fb662-969d-3851-b2fc-1e011dc65288",
                                                "text": "Любой контроль, доведенный до абсурда, излишняя подозрительность и недоверие к людям, занятым своим профессиональным делом, никогда к добру не приводят."
                                            },
                                            {
                                                "example_id": "64bb6830-8c38-453a-b72c-db01a00e7662",
                                                "sense_id": "417fb662-969d-3851-b2fc-1e011dc65288",
                                                "text": "Так повелось ещё с суровых времен всеобщей подозрительности, когда всюду чудились заговоры и покушения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383a1d51-b912-390e-a7ae-9d1de813fac6",
                                        "entry_id": "81b867bf-0306-3645-b7c8-b5fe2a809176",
                                        "glosses": [
                                            "редк. свойство по значению прилагательного подозрительный; сомнительность, способность вызывать подозрения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae44a92-583f-461e-87b3-03c736989808",
                                                "sense_id": "383a1d51-b912-390e-a7ae-9d1de813fac6",
                                                "text": "«Подозрительные» сделки сама кредитная организация обязана приостановить на два дня, а КФМ может заморозить операцию еще на пять дней, если результаты предварительной проверки подтверждают подозрительность сделки."
                                            },
                                            {
                                                "example_id": "031b21ae-cc9a-4c18-b72d-81291cb300d5",
                                                "sense_id": "383a1d51-b912-390e-a7ae-9d1de813fac6",
                                                "text": "Мобильик зазвонил ровно в восемь, и Сыщик схватил его, надеясь получить новость от агента, но звонил знакомый владелец магазина оружия, сообщал о подозрительной женщине, продававшей пистолет. Подозрительность состояла в том, что она согласилась на половину цены и рассрочку платежа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
