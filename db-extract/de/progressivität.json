                ],
                "senses": [
                    {
                        "sense_id": "e190a6b4-8ab8-3751-bb15-d39f4c463a87",
                        "entry_id": "45d125fb-0661-30d4-b1da-4a7d7b1e23d7",
                        "glosses": [
                            "Entwicklung nach vorne, Weiterentwicklung aus einem Zustand heraus in einen neuen Zustand hinein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082f72ba-92e1-4929-a97e-a222b7498eb4",
                                "sense_id": "e190a6b4-8ab8-3751-bb15-d39f4c463a87",
                                "text": "„Gerade die Progressivität der Entwicklung der letzten 150 Jahre verlangt verstärkt die Beachtung der Stellung der Frau in Gesellschaft und Kirche mit ihren spezifischen Fragen und Problemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                        "entry_id": "45d125fb-0661-30d4-b1da-4a7d7b1e23d7",
                        "glosses": [
                            "Eigenschaft, in weiterem Fortschreiten schneller zu wachsen"
                        ],
                        "tags": [
                            "Finanzwirtschaft",
                            "Steuern"
                        ],
                        "examples": [
                            {
                                "example_id": "5982db74-d7e6-465e-88fa-0e7ff8db3bb7",
                                "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                                "text": "„Das läßt schon erwarten, daß die Progressivität der Umlagebelastung sich verschärft. Und so ist es auch: Im Vergleich zwischen der leicht aufkommensstärkeren Gemeinde B gegenüber A wird die Belastung um das 2 1/2-fache höher.“"
                            },
                            {
                                "example_id": "f5d2d5d2-2425-4d36-a1ff-dfdeb5e9485c",
                                "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                                "text": "„Der Index der Progressivität reicht von 100 in reinen Grundrentensystemen (Irland und Neuseeland) bis zu einem negativen Wert in Schweden.“"
                            },
                            {
                                "example_id": "5b83e97c-911a-4d55-b901-396b630c94a0",
                                "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                                "text": "„Die leichte Progressivität. die im Übergang zu den Mittelschichten zu beobachten ist, erklärt sich aus der wachsenden Bedeutung der Einkommensteuer.“"
                            },
                            {
                                "example_id": "67cded89-9ac8-4434-870b-38f4639f0ed2",
                                "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                                "text": "„Ebenso wie in Italien ist es nicht geboten, dass jede einzelne Steuer nach einem progressiven Tarif bemessen wird, es genügt vielmehr, wenn der Effekt des Steuersystems als Ganzem Progressivität erkennen lässt.“"
                            },
                            {
                                "example_id": "e8e0ccda-47c8-4e04-a44f-d6e83aeba46d",
                                "sense_id": "1468f804-f302-331c-8503-5db5bb198941",
                                "text": "„Selbst für die Mehrwertsteuer ergibt sich eine gewisse Progressivität, da auch der Tarif dieser Steuer im Zeitablauf keineswegs unverändert bleibt, sondern von Zeit zu Zeit angehoben wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "23a490e2-78a9-3e30-965f-7fded42c3ecc",
                        "entry_id": "45d125fb-0661-30d4-b1da-4a7d7b1e23d7",
                        "glosses": [
                            "Geisteshaltung, die von Offenheit allem Neuen gegenüber gekennzeichnet ist; fortschrittliche Grundhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc5b0cf-704e-42b2-8543-e204cedd044f",
                                "sense_id": "23a490e2-78a9-3e30-965f-7fded42c3ecc",
                                "text": "„Progressivität meint eine gesellschaftskritische und politisch engagierte Haltung. Diese findet sich bei der Emanze, während die Tussie als angepasst und desinteressiert gilt.“"
                            },
                            {
                                "example_id": "220f3560-7606-49ca-94c9-a9d54fe5dc69",
                                "sense_id": "23a490e2-78a9-3e30-965f-7fded42c3ecc",
                                "text": "„Progressivität beschreibt ein Attribut, das neben dem Bestehenden Perspektiven einbezieht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
