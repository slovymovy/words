                "senses": [
                    {
                        "sense_id": "b22cd911-e8b1-3a03-955d-cabe4270c072",
                        "entry_id": "4426f924-858b-3ff8-a15f-b65cfd872a2c",
                        "glosses": [
                            "Eisenbahn, die in einem begrenzten, regionalen Bereich verkehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5f2f680-5ed4-4a0a-b9e8-639f25e9f0a9",
                                "sense_id": "b22cd911-e8b1-3a03-955d-cabe4270c072",
                                "text": "„Ich begleite ihn bis Stolp, denn die Kreisbahn verkehrt noch wie gewohnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "253618b8-579a-3b02-b9ca-60523fbd8d4d",
                        "entry_id": "4426f924-858b-3ff8-a15f-b65cfd872a2c",
                        "glosses": [
                            "Strecke/Verlauf in einem geschlossenen Kreis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22f35ad-af9c-4938-8edb-48550a11dd6a",
                                "sense_id": "253618b8-579a-3b02-b9ca-60523fbd8d4d",
                                "text": "Elektronen bewegen sich auf einer Kreisbahn um den Atomkern."
                            },
                            {
                                "example_id": "21b00b99-7314-4686-aacf-4d5a57fda619",
                                "sense_id": "253618b8-579a-3b02-b9ca-60523fbd8d4d",
                                "text": "„Die Erde beschreibt auf ihrem Weg um die Sonne keine perfekte Kreisbahn, sondern eine schwache Ellipse.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ad33f5f-a4e9-4a50-9e3c-93735820329c",
                        "source_entry_id": "4426f924-858b-3ff8-a15f-b65cfd872a2c",
                        "source_sense_id": "b22cd911-e8b1-3a03-955d-cabe4270c072",
                        "source_sense_description": "Eisenbahn, die in einem begrenzten, regionalen Bereich verkehrt",
                        "target_lang_word": "train régional",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2d81546d-81ec-4f29-adf5-fe374e759777",
                        "source_entry_id": "4426f924-858b-3ff8-a15f-b65cfd872a2c",
                        "source_sense_id": "253618b8-579a-3b02-b9ca-60523fbd8d4d",
                        "source_sense_description": "Strecke/Verlauf in einem geschlossenen Kreis",
                        "target_lang_word": "orbite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orbite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36619695-183e-3579-a381-bbae7b1beb65",
                                        "entry_id": "8e6182f3-da88-39f3-9295-b5dfbc7f78f7",
                                        "glosses": [
                                            "Cavité osseuse dans laquelle l’œil est placé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4309d4f0-5768-4057-8c12-391939f7a4fe",
                                                "sense_id": "36619695-183e-3579-a381-bbae7b1beb65",
                                                "text": "Mais, pâle, les cheveux hérissés, les yeux hors de leur orbite, les vêtements en désordre et les mains ensanglantées, cet homme passa près de moi sans me voir."
                                            },
                                            {
                                                "example_id": "88657e1f-e6b8-4d60-a20a-db837763fb26",
                                                "sense_id": "36619695-183e-3579-a381-bbae7b1beb65",
                                                "text": "Des fenêtres, là-haut, s'ouvrent, creuses et noires comme des orbites béantes dans le crâne d'un squelette."
                                            },
                                            {
                                                "example_id": "a92a859e-b0f3-461d-b318-6cd5256b6afa",
                                                "sense_id": "36619695-183e-3579-a381-bbae7b1beb65",
                                                "text": "Mes yeux, sous les paupières crispées, étaient traversées d'images de feu, de dessins géométriques lumineux, et je croyais les sentir s'arracher par saccades de leurs orbites, comme poussés de l'intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91fe3d1d-e085-3d8a-a63b-4c6a280b75a8",
                                        "entry_id": "8e6182f3-da88-39f3-9295-b5dfbc7f78f7",
                                        "glosses": [
                                            "Trajectoire elliptique ou circulaire décrite par un astre autour d’un autre ou du barycentre de plusieurs astres, sous l'effet de la gravitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a6267a-c3ad-46c8-91a5-7f47a52ef822",
                                                "sense_id": "91fe3d1d-e085-3d8a-a63b-4c6a280b75a8",
                                                "text": "Le plus souvent des observations ultérieures permettent de rectifier les erreurs d'un premier résultat : c'est ainsi qu'on avait cru d'abord que Nysa devait couper l’orbite de Mars, tandis qu elle est toujours à 15 millions de lieues au moins au-dessus de cette planète."
                                            },
                                            {
                                                "example_id": "f9252820-4ef9-4ded-8e74-6344f1147184",
                                                "sense_id": "91fe3d1d-e085-3d8a-a63b-4c6a280b75a8",
                                                "text": "Le mystère des perturbations de l’orbite de Mercure n'a finalement été élucidé qu'avec la théorie de la relativité générale proposée par Albert Einstein au début du XX^(ème) siècle."
                                            },
                                            {
                                                "example_id": "45100ead-8f47-4772-886f-290a1587b986",
                                                "sense_id": "91fe3d1d-e085-3d8a-a63b-4c6a280b75a8",
                                                "text": "Quand on mettra les cons sur orbite, t’as pas fini de tourner."
                                            },
                                            {
                                                "example_id": "bab82e35-cecd-45c9-800b-0e9afca25857",
                                                "sense_id": "91fe3d1d-e085-3d8a-a63b-4c6a280b75a8",
                                                "text": "Ce qui est plus complexe, c’est que les satellites voyagent sur des orbites, et certaines orbites sont plus sollicitées que d’autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a28af82-6846-355e-84bf-5885345f4956",
                                        "entry_id": "8e6182f3-da88-39f3-9295-b5dfbc7f78f7",
                                        "glosses": [
                                            "Influence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d6aa2cc-b0d0-4bda-ae24-3c16bd7f4739",
                                                "sense_id": "1a28af82-6846-355e-84bf-5885345f4956",
                                                "text": "Graviter dans l’orbite de quelqu’un."
                                            },
                                            {
                                                "example_id": "e98323c1-ceef-44c2-b778-5c5154a29838",
                                                "sense_id": "1a28af82-6846-355e-84bf-5885345f4956",
                                                "text": "À force de n’exister\nQu’à la solde du soleil\nLa Terre se lassera-t-elle\nDe la tenace orbite ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914d5e1c-3964-3d4e-89c3-0559d9563714",
                                        "entry_id": "8e6182f3-da88-39f3-9295-b5dfbc7f78f7",
                                        "glosses": [
                                            "Ensemble des éléments associés à un élément unique sous l’action d’un groupe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
