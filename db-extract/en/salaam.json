                                "target_senses": [
                                    {
                                        "sense_id": "67423b06-bb66-35a7-861d-46546fd9f652",
                                        "entry_id": "03edba36-b539-3e1d-a53a-37cedf4a63ec",
                                        "glosses": [
                                            "арабское приветствие, используемое мусульманами разных национальностей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06dcb7d-25e9-4674-a9ca-b7232921795c",
                                                "sense_id": "67423b06-bb66-35a7-861d-46546fd9f652",
                                                "text": "В одной руке его роза, другой держит пиалу горячего чаю. Салам, товарищи! Как поживайот?"
                                            }
                                        ]
