                    },
                    {
                        "translation_id": "b68dddfd-10f2-4ae8-bd1a-db2b44ef83ae",
                        "source_entry_id": "959eca88-aced-3656-a267-b43660204b93",
                        "source_sense_description": "the state of being vile",
                        "target_lang_word": "Niedertracht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niedertracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                        "entry_id": "22ffb778-a535-31f6-afe0-2bfe799fc86b",
                                        "glosses": [
                                            "eine Art zu denken und zu handeln, die bewusst böse ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db62f84-672f-4a2b-a035-4bb03a7d81a8",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "Aus purer Niedertracht hat sie einen Fleck auf mein weißes Kleid gemacht."
                                            },
                                            {
                                                "example_id": "cd18c3a1-287a-4191-92e5-330fda0ccf63",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "Sicherlich sitzt sie jetzt in ihrem Kämmerchen und denkt sich wieder eine Niedertracht aus."
                                            },
                                            {
                                                "example_id": "4852d0e4-160b-4ff5-9cb5-6bf471e59999",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "Das Jurastudium ist eine Niedertracht. Aber man studiert ja freiwillig."
                                            },
                                            {
                                                "example_id": "d7c3ab84-74b0-4b2d-ac32-53cee512e314",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "„Kohrs, ein stiller und ruhiger Mann, war wehrlos gegen solche Niedertracht.“"
                                            },
                                            {
                                                "example_id": "568be207-a6f8-4b0b-a491-423dac902ebe",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "„Das Problem war, dass sie in der ganzen Stadt wegen ihrer Niedertracht verhasst waren, und das wussten sie auch.“"
                                            },
                                            {
                                                "example_id": "7b557fee-03aa-4413-b7e9-37f9b35aa398",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "„Als mir Madame d'Urfé verzweifelt von diesem Hindernis berichtete, heuchelte ich tiefen Kummer, denn die Niedertracht der Tänzerin kam mir gerade recht, einmal, weil sie mir kein Verlangen mehr einflößte, und außerdem, weil ich voraussah, daß ich diese Lage ausnutzen konnte, um mich zu rächen und sie zu strafen.“"
                                            },
                                            {
                                                "example_id": "bd2af53a-bd01-4a77-b733-d0a450f3083e",
                                                "sense_id": "4050b229-1bdd-3299-8ad8-1e56d0bcae32",
                                                "text": "„So viel Geschick oder auch Niedertracht nahmen mich nicht gerade günstig für sie ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7712979-c268-4ba4-b001-2acc93aea4c1",
                        "source_entry_id": "959eca88-aced-3656-a267-b43660204b93",
                        "source_sense_description": "the state of being vile",
                        "target_lang_word": "Widerwärtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
