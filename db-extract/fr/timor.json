                "senses": [
                    {
                        "sense_id": "fcb5ea75-f47f-3236-94b0-97d78212348a",
                        "entry_id": "ffab20d5-37d8-3a2d-9da4-dd22fb7fe164",
                        "glosses": [
                            "Île de l’archipel indonésien partagée entre l’Indonésie et l’État de Timor oriental."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "f2fa16ae-6d2c-4d4f-bbf7-af0b8304dc40",
                                "sense_id": "fcb5ea75-f47f-3236-94b0-97d78212348a",
                                "text": "Les Hollandais supplantent les Portugais au début du XVIIᵉ (sauf au Timor), puis s’installent à Java, l’île la plus peuplée et la plus riche."
                            },
                            {
                                "example_id": "41a3db6a-b746-4e54-ae1f-aeb2729df3bd",
                                "sense_id": "fcb5ea75-f47f-3236-94b0-97d78212348a",
                                "text": "La secousse de magnitude 6,2, selon une estimation révisée de l'Institut de géophysique américain (USGS), s'est produite à une profondeur de 49 km vers 2 h 36 GMT, au large de la pointe orientale de l'île de Timor, qui est partagée entre le Timor oriental et l'Indonésie."
                            }
                        ]
                    },
                    {
                        "sense_id": "481d631a-4268-39f6-8f5b-aca13d86bda3",
                        "entry_id": "ffab20d5-37d8-3a2d-9da4-dd22fb7fe164",
                        "glosses": [
                            "Mer de l’océan indien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6ac8d6-1ad2-445b-991a-b78e645401d8",
                                "sense_id": "481d631a-4268-39f6-8f5b-aca13d86bda3",
                                "text": "De l'autre côté de la mer de Timor, en Australie, à Darwin, la secousse a été aussi violemment ressentie."
                            }
                        ]
                    }
                ],
                "translations": [
