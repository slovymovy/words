            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84fd74f1-5539-338c-a9ac-b7c488eac2f9",
                    "sense_definition": "Ustensile de cuisine métallique à fond plat et bords hauts, muni d'un manche pour la cuisson.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il verse de l'eau dans la <w>casserole</w> avant de la poser sur le feu."
                        },
                        {
                            "text": "Elle a acheté une nouvelle <w>casserole</w> en inox pour préparer le repas de ce soir."
                        }
                    ],
                    "synonyms": [
                        "poêlon"
                    ],
                    "common_phrases": [
