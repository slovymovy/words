                    },
                    {
                        "translation_id": "dcbc8e71-431a-4a0c-9224-baeac35b09b4",
                        "source_entry_id": "3d2a9c79-9fe7-3c6f-86fb-1a945f5a1e3f",
                        "source_sense_id": "58c04c73-7acb-32de-88bb-dbd8c508ec17",
                        "source_sense_description": "Mann höheren Alters",
                        "target_lang_word": "geezer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geezer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f0d7749-7f40-3851-9175-6333575ee0f3",
                                        "entry_id": "fe8acf7c-b901-30df-a013-7eb9acc6eecd",
                                        "glosses": [
                                            "A male person."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36762519-0a57-40d0-808a-3674cc07626a",
                                                "sense_id": "9f0d7749-7f40-3851-9175-6333575ee0f3",
                                                "text": "You are a silly young geezer."
                                            },
                                            {
                                                "example_id": "6f8157fd-6a3d-4146-8091-579549760d7d",
                                                "sense_id": "9f0d7749-7f40-3851-9175-6333575ee0f3",
                                                "text": "See the hoverboard-riding geezer? This close to payin' a G for a shot of my cousin Calvin's molars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                                        "entry_id": "fe8acf7c-b901-30df-a013-7eb9acc6eecd",
                                        "glosses": [
                                            "Someone affable but morally dubious; a wide boy."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09cf3e2b-7eb9-4e94-ace6-dcf88acefc22",
                                                "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                                                "text": "Geezers need excitement / If their lives don't provide 'em this, they incite violence / Common sense, simple common sense"
                                            },
                                            {
                                                "example_id": "9073d3d3-d98c-4fa5-ac72-c5c532f898e6",
                                                "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                                                "text": "He turned out to be a proper geezer who was willing to listen to my proposition that if he took the door at the Ministry, I would pay him £400 a month to mark my cards."
                                            },
                                            {
                                                "example_id": "230ecae8-cea0-406b-850f-f41387eb2191",
                                                "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                                                "text": "He was a bit of a geezer. Used to box with the Krays when he was a young 'un."
                                            },
                                            {
                                                "example_id": "dbc5f5c6-fa76-4b22-8337-d8f5ac68b63d",
                                                "sense_id": "28425607-d973-3258-923b-6988b5729a1f",
                                                "text": "When I'd first met Adam, at work when we were both 23, the fact that he seemed a little rough around the edges appealed to me. He was a bit of a geezer, a joker, one of the lads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a79230a0-c900-3b35-91ec-15af91e738f8",
                                        "entry_id": "fe8acf7c-b901-30df-a013-7eb9acc6eecd",
                                        "glosses": [
                                            "Term of address for a male."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784eb785-ded0-42cf-b804-a97ae677f1e6",
                                                "sense_id": "a79230a0-c900-3b35-91ec-15af91e738f8",
                                                "text": "Hi, geezer, you alright?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9a054f-a4f3-32de-9638-49ea16755278",
                                        "entry_id": "fe8acf7c-b901-30df-a013-7eb9acc6eecd",
                                        "glosses": [
                                            "An old person, usually a male, typically a cranky old man."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "informal",
                                            "mildly",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24be9be0-bccf-4e03-af37-4c9ac5b72007",
                                                "sense_id": "5d9a054f-a4f3-32de-9638-49ea16755278",
                                                "text": "In the right-hand division lay the two old geezers, as Sandy styled the landlord and his wife."
                                            },
                                            {
                                                "example_id": "cc0c6487-34b2-45c9-8e05-6b41236cc5bb",
                                                "sense_id": "5d9a054f-a4f3-32de-9638-49ea16755278",
                                                "text": "The technical term for a female geezer is \"old broad,\" but this is irrelevant, as nobody in Hollywood makes films about women over 55."
                                            },
                                            {
                                                "example_id": "03f2e910-b2ea-4922-8c70-28bdac94ac50",
                                                "sense_id": "5d9a054f-a4f3-32de-9638-49ea16755278",
                                                "text": "Why Geezer? Why would a fine arts gallery choose a name that conjures images of a grumpy old guy sitting on the front porch hollering, “get off my lawn”?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10bb995-d804-3fd6-b7cc-3549353b812d",
                                        "entry_id": "fe8acf7c-b901-30df-a013-7eb9acc6eecd",
                                        "glosses": [
                                            "Wife; old woman."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d379e4ac-47a6-44ab-b976-3af59e2e96ce",
                                                "sense_id": "c10bb995-d804-3fd6-b7cc-3549353b812d",
                                                "text": "He'd flirt and boat, but never wrote / A note to his old geezer."
                                            },
                                            {
                                                "example_id": "862c66aa-b618-463f-a6ae-4fd63d5e0670",
                                                "sense_id": "c10bb995-d804-3fd6-b7cc-3549353b812d",
                                                "text": "This frizzle-headed old geezer had a chin on her as rough well, as rough as her family, and they're rough 'uns."
                                            }
                                        ]
                                    }
                                ]
                            },
