                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>boots</w> of the fleet was assigned the least desirable patrol route.",
                            "target_lang_translations": {
