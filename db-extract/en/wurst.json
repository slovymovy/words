{
    "word": "wurst",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d772a1a2-a927-38ce-a170-f06c64f4a014",
                "word": "wurst",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75744a63-f512-4a5f-b92d-46679ac6a218",
                        "entry_id": "d772a1a2-a927-38ce-a170-f06c64f4a014",
                        "tags": [
                            "plural"
                        ],
                        "form": "wursts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                        "entry_id": "d772a1a2-a927-38ce-a170-f06c64f4a014",
                        "glosses": [
                            "A German- or Austrian-style sausage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c13b9e0-4684-4ae5-b28c-2db455690b14",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "If you pick up a package of liverwurst (German wurst, sausage), you may find that it contains, in addition to liver, nonfat dry milk, salt, corn syrup, flavorings (unspecified), sodium erythrobate, sodium nitrate, sodium nitrite, gelatin, and dextrose. The list reads like a list of chemicals for a laboratory experiment! If you wish to avoid “chemicals” in your food, wurst is one of the worst things you can buy."
                            },
                            {
                                "example_id": "ab67e053-b0f9-442a-b5da-70ef93beef40",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "We had a long walk ahead to Stuttgart. We stopped to eat at a little meat market just outside Augsburg. I bought a loaf of bread and chose a couple of packages of wurst. It really was good."
                            },
                            {
                                "example_id": "155da37f-f13b-4461-a7f8-e1f213081abc",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "Although the supermarket tannoy was bravely broadcasting Rigoletto, its meat counter was thick with wurst and its wine shelves loaded with Liebfraumilch."
                            },
                            {
                                "example_id": "f56729d2-84e5-4d31-80c1-c0e2b2b2014d",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "Sure, the map says it’s Italy, but after walking through the centuries-old market at Piazza Erbe (Obstplatz) and seeing one too many suspiciously Teutonic-looking locals munching wurst, you might think you’ve crossed the Austrian border."
                            },
                            {
                                "example_id": "d5c65d14-87a7-4cb5-b463-425a67b4051b",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "At an open-air flea market, we looked for Nazi memorabilia while munching wurst and drinking beer."
                            },
                            {
                                "example_id": "126592a1-a88c-4747-b20e-e64817b2e6fa",
                                "sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                                "text": "In summer, you're welcomed into a flower-decked garden set against a backdrop of ancient vineyards. You can fill up your platter with some of the best wursts and roast meats (especially the delectable pork), along with freshly made salads."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51e8bdd7-608d-4b90-bf7c-179ccf537713",
                        "source_entry_id": "d772a1a2-a927-38ce-a170-f06c64f4a014",
                        "source_sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                        "source_sense_description": "German- or Austrian-style sausage",
                        "target_lang_word": "wurst",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wurst",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "251971f0-a9d3-3272-bfe0-904213df1e30",
                                        "entry_id": "9242cbe0-91fc-31b2-8934-b1d44b48c593",
                                        "glosses": [
                                            "Saucisse alsacienne ou allemande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e223f86-8b42-4191-811a-e873f76b098a",
                                                "sense_id": "251971f0-a9d3-3272-bfe0-904213df1e30",
                                                "text": "Brasserie sympa pour boire une bière et manger une wurst locale."
                                            },
                                            {
                                                "example_id": "51efa33c-b908-43c3-8b47-45ab1d71f0ac",
                                                "sense_id": "251971f0-a9d3-3272-bfe0-904213df1e30",
                                                "text": "Elle est méconnaissable ! Son maquillage a lamentablement coulé et son beau chignon ne ressemble plus à rien ou peut- être si, à une choucroute électrocutée par la vue d’une wurst avariée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7182b6d2-5128-3772-afb3-be206e8fcc5e",
                                        "entry_id": "9242cbe0-91fc-31b2-8934-b1d44b48c593",
                                        "glosses": [
                                            "Nom donné par analogie de forme avec la saucisse à un véhicule de transport militaire de forme très allongé, utilisé au XVIII^(ème) siècle pour le transport des munitions et des artilleurs. Il se composait d’une grande caisse en longueur renfermant le matériel, possédant un dessus bombé sur lequel venaient s’asseoir les hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1640c6-d9ee-4f99-bdc6-246f93830292",
                                                "sense_id": "7182b6d2-5128-3772-afb3-be206e8fcc5e",
                                                "text": "Le wurst est un caisson plus petit et plus léger que le caisson ordinaire; il porte l’approvisionnement des bouches à feu de l’artillerie à cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1312582d-5b0b-3bed-bd96-86473019d4d6",
                                        "entry_id": "9242cbe0-91fc-31b2-8934-b1d44b48c593",
                                        "glosses": [
                                            "Calèche longue et découverte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c30c02-ee06-45cb-9b3b-65a8c49479af",
                                                "sense_id": "1312582d-5b0b-3bed-bd96-86473019d4d6",
                                                "text": "Le wurst s’enfonça dans un chemin étroit et couvert, et la calèche de la marquise passa, peu de minutes après, sur la grande route."
                                            },
                                            {
                                                "example_id": "df3ec7fe-2df8-485a-890f-097c340f2b00",
                                                "sense_id": "1312582d-5b0b-3bed-bd96-86473019d4d6",
                                                "text": "D’Allemagne fut importé le wurst, sorte de longue banquette à compartimens [sic], que les voyageurs enjambaient … . — (La revue des deux mondes, 1912)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23730c01-0447-4683-8d16-33ca63b419c1",
                        "source_entry_id": "d772a1a2-a927-38ce-a170-f06c64f4a014",
                        "source_sense_id": "59c8d1db-d466-3371-a8ca-97bf16950faa",
                        "source_sense_description": "German- or Austrian-style sausage",
                        "target_lang_word": "Wurst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wurst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a50f317-336b-3644-a1af-209339f85333",
                                        "entry_id": "0dd36138-e0fa-34c8-89af-f08c12cdc879",
                                        "glosses": [
                                            "längliches Fleischprodukt; meist eine Paste aus Tierfleisch in einen Tierdarm gepresst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399a69ca-7ed4-42b5-80c9-5aa0f2c8034f",
                                                "sense_id": "7a50f317-336b-3644-a1af-209339f85333",
                                                "text": "In einer größeren Gesellschaft von Professoren und Dozenten der Universitäts- und Weltstadt L. warf ich die Frage auf: Warum wird die Wurst vielmehr schief als gerade durchschnitten, so daß die Schnittfläche wie die Scheiben sich nicht kreisrund, sondern elliptisch (oval) darstellen?"
                                            },
                                            {
                                                "example_id": "ee546301-8189-419d-8237-42f0a80a03b2",
                                                "sense_id": "7a50f317-336b-3644-a1af-209339f85333",
                                                "text": "„Sie machten sie heiß und aßen sie mit dem Rest der Wurst ihres Trauzeugen Klotz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5529aa32-6612-31c7-aadd-c4339fe47ad4",
                                        "entry_id": "0dd36138-e0fa-34c8-89af-f08c12cdc879",
                                        "glosses": [
                                            "Aufschnitt aus Fleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d3d2ff-0d96-47eb-84de-7e503b43c5eb",
                                                "sense_id": "5529aa32-6612-31c7-aadd-c4339fe47ad4",
                                                "text": "Er stellte Wurst und Käse auf den Frühstückstisch."
                                            },
                                            {
                                                "example_id": "3578ff0a-74d7-416a-8bb0-0438dc799336",
                                                "sense_id": "5529aa32-6612-31c7-aadd-c4339fe47ad4",
                                                "text": "Die Brötchen waren mit Wurst belegt oder mit Hummus bestrichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "01d2471e-bf9d-3c06-a7b6-b9770155bc2e",
                                        "entry_id": "0dd36138-e0fa-34c8-89af-f08c12cdc879",
                                        "glosses": [
                                            "länglicher, wurstförmiger Gegenstand"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7112fea-fa26-4ee0-9627-985e50e11c09",
                                                "sense_id": "01d2471e-bf9d-3c06-a7b6-b9770155bc2e",
                                                "text": "Er drückte sich eine Wurst Zahnpasta auf die Bürste."
                                            },
                                            {
                                                "example_id": "e2c5fd87-37ee-4405-912c-1ae41154dae0",
                                                "sense_id": "01d2471e-bf9d-3c06-a7b6-b9770155bc2e",
                                                "text": "Aus dem Teig müssen Sie Würste formen."
                                            },
                                            {
                                                "example_id": "8d4c8098-f13d-472c-8d9e-115285eb1613",
                                                "sense_id": "01d2471e-bf9d-3c06-a7b6-b9770155bc2e",
                                                "text": "Der Nachbarshund hat im Treibhaus eine dicke Wurst hingelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
