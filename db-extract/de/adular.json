                                "example_id": "843be69b-9490-4f62-a4c2-a6ef2e80f286",
                                "sense_id": "55abcecb-8bdf-3b96-aafc-557c7cb07ef4",
                                "text": "„Adular kommt in alpinen Klüften vor, wo er metastabil, d. h. Al,Siungeordnet bei relativ niedrigen Temperaturen gewachsen ist.“"
                            }
