                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abribus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac01db28-2a0c-3489-9e3d-56560a9252d9",
                                        "entry_id": "84fbec9f-8220-3476-85be-a3e50053bda3",
                                        "glosses": [
                                            "Mobilier urbain permettant de protéger les usagers des intempéries aux arrêts des lignes d’autobus ou d’autocars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60de827a-1295-4392-a1e4-2670e0bb1b11",
                                                "sense_id": "ac01db28-2a0c-3489-9e3d-56560a9252d9",
                                                "text": "À l’arrêt de bus elle oubliait parfois de monter et restait assise sous l'abribus, perdue dans ses pensées."
                                            },
                                            {
                                                "example_id": "111b5fe5-cc1b-44af-81af-aea4c1fa7f57",
                                                "sense_id": "ac01db28-2a0c-3489-9e3d-56560a9252d9",
                                                "text": "J’ai attendu le bus alors qu’il pleuvait, et il n'y avait même pas d’abribus."
                                            },
                                            {
                                                "example_id": "fdc1ae29-e519-494e-8f57-5ead96f18c7f",
                                                "sense_id": "ac01db28-2a0c-3489-9e3d-56560a9252d9",
                                                "text": "Les bus ne circulant plus, elle s’assit sous un abribus un peu désert à cette heure de la nuit pour se protéger contre la petite averse qui continuait de tomber."
                                            },
                                            {
                                                "example_id": "e3359b37-ef25-4c3f-8e0c-0b67c456e0d1",
                                                "sense_id": "ac01db28-2a0c-3489-9e3d-56560a9252d9",
                                                "text": "Le GUD a appelé à casser du PD dans trois semaines. Le NPA appelle à casser les abribus en disant qu’il y a des violences qui seraient pas les mêmes. Eh bien moi, je veux ni abribus cassés, ni casser du PD, parce que ça c’est pas mon pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
