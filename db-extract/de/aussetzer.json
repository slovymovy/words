                        "sense_id": "c5ccb186-977f-3bc1-b16f-398e4522df8f",
                        "entry_id": "ffd98ea3-072c-32c7-95d7-bb716350a299",
                        "glosses": [
                            "plötzlicher, vorübergehender Ausfall oder Wegfall von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ad7edf-8129-4f2e-8b03-82b6f150da85",
                                "sense_id": "c5ccb186-977f-3bc1-b16f-398e4522df8f",
                                "text": "Jeder kennt wohl einen Aussetzer des Gedächtnisses."
                            },
                            {
                                "example_id": "9a46f770-8eef-4a8d-a5f2-f6f7c5013f22",
                                "sense_id": "c5ccb186-977f-3bc1-b16f-398e4522df8f",
                                "text": "Da muss ich einen Aussetzer gehabt haben."
                            },
                            {
                                "example_id": "018512ab-43ad-429b-a085-c011ad9e08f2",
                                "sense_id": "c5ccb186-977f-3bc1-b16f-398e4522df8f",
                                "text": "Er hatte einen 30 Sekunden langen Aussetzer, aber jetzt atmet er wieder normal."
                            },
                            {
                                "example_id": "cb7e49b6-f8a0-4742-b354-ce8ff2f172a7",
                                "sense_id": "c5ccb186-977f-3bc1-b16f-398e4522df8f",
                                "text": "Bei Extraschlägen des Herzens spürt man also einen Aussetzer, der von einem besonders kräftigen Herzschlag gefolgt wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
