                        "glosses": [
                            "kleine, knotenähnliche Verdickung"
                        ],
                        "tags": [
                            "North German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "45d300c1-0ad1-49e0-8a38-c3ab7d06fb4c",
                                "sense_id": "25e1bd54-b011-3c41-8c47-107f038a2a00",
                                "text": "„Bobby konnte den Knubbel in ihrem Bauch spüren.“"
                            }
