{
    "word_family": [
        "augur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f595f75-8c59-3649-a3a0-a1f2a6f5346c",
                    "sense_definition": "A tool used for boring holes in wood or other materials.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a sharp <w>auger</w> to create deep holes in the wooden beam.",
                            "target_lang_translations": {
                                "de": "Der Zimmermann benutzte einen scharfen <w>Holzbohrer</w>, um tiefe Löcher in den Holzbalken zu bohren."
                            }
                        },
                        {
                            "text": "He carefully turned the <w>auger</w> to bore through the thick timber.",
                            "target_lang_translations": {
                                "de": "Er drehte den <w>Bohrer</w> vorsichtig, um durch das dicke Holz zu dringen."
                            }
                        }
                    ],
                    "synonyms": [
                        "drill",
                        "gimlet"
                    ],
                    "common_phrases": [
                        "hand auger"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Werkzeug zum Bohren von Löchern in Holz oder andere Materialien."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Holzbohrer",
                                "target_lang_sense_clarification": "speziell für Holzarbeiten"
                            },
                            {
                                "target_lang_word": "Handbohrer",
                                "target_lang_sense_clarification": "allgemeines manuelles Bohrwerkzeug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcae73af-4c15-3474-8799-779d2121cb7c",
                    "sense_definition": "A large tool used to bore holes in the ground for posts or planting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used a heavy-duty <w>auger</w> to dig holes for the new fence posts.",
                            "target_lang_translations": {
                                "de": "Sie benutzten einen schweren <w>Erdbohrer</w>, um Löcher für die neuen Zaunpfosten zu graben."
                            }
                        },
                        {
                            "text": "The farmer operated the <w>auger</w> to prepare the soil for planting trees.",
                            "target_lang_translations": {
                                "de": "Der Landwirt bediente den <w>Erdbohrer</w>, um den Boden für das Pflanzen von Bäumen vorzubereiten."
                            }
                        }
                    ],
                    "synonyms": [
                        "post-hole digger"
                    ],
                    "common_phrases": [
                        "earth auger"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein großes Werkzeug zum Bohren von Löchern in den Boden, etwa für Pfosten oder zum Pflanzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Erdbohrer",
                                "target_lang_sense_clarification": "Werkzeug für Erdarbeiten"
                            },
                            {
                                "target_lang_word": "Pfahlbohrer",
                                "target_lang_sense_clarification": "speziell für Zaunpfosten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf947752-2550-31cd-8441-65c3577175db",
                    "sense_definition": "A flexible tool used by plumbers to clear blockages in pipes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber used a drain <w>auger</w> to remove the clog from the kitchen sink.",
                            "target_lang_translations": {
                                "de": "Der Klempner benutzte eine <w>Rohrreinigungsspirale</w>, um die Verstopfung im Küchenspülbecken zu entfernen."
                            }
                        },
                        {
                            "text": "He pushed the <w>auger</w> deep into the pipe to clear the obstruction.",
                            "target_lang_translations": {
                                "de": "Er schob die <w>Spirale</w> tief in das Rohr, um das Hindernis zu beseitigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "plumber's snake"
                    ],
                    "common_phrases": [
                        "drain auger"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein flexibles Werkzeug, das von Klempnern verwendet wird, um Verstopfungen in Rohren zu beseitigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rohrreinigungsspirale",
                                "target_lang_sense_clarification": "klassisches Werkzeug für Abflüsse"
                            },
                            {
                                "target_lang_word": "Abflussreiniger",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Werkzeug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "039c9626-3117-3420-904f-90ea8c811fd1",
                    "sense_definition": "A hollow drill used to extract cylindrical samples of soil or ice for scientific analysis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drilling_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists used an ice <w>auger</w> to collect core samples from the glacier.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler benutzten einen <w>Eisbohrer</w>, um Bohrkerne aus dem Gletscher zu entnehmen."
                            }
                        },
                        {
                            "text": "The research team analyzed the soil extracted by the <w>auger</w> to study climate history.",
                            "target_lang_translations": {
                                "de": "Das Forschungsteam analysierte den mit dem <w>Hohlbohrer</w> entnommenen Boden, um die Klimageschichte zu untersuchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "core drill"
                    ],
                    "common_phrases": [
                        "ice auger"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Hohlbohrer zur Entnahme zylindrischer Boden- oder Eisproben für wissenschaftliche Analysen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hohlbohrer",
                                "target_lang_sense_clarification": "technischer Begriff für Probenentnahme"
                            },
                            {
                                "target_lang_word": "Eisbohrer",
                                "target_lang_sense_clarification": "speziell für wissenschaftliche Eisbohrkerne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92be919c-783b-3283-9c6e-0c4b234e3726",
                    "sense_definition": "To drill a hole using a specialized tool.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>auger</w> holes for the foundation of the new building.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter begannen, Löcher für das Fundament des neuen Gebäudes zu <w>bohren</w>."
                            }
                        },
                        {
                            "text": "It is necessary to <w>auger</w> deep into the ground to reach the water table.",
                            "target_lang_translations": {
                                "de": "Es ist notwendig, tief in den Boden zu <w>bohren</w>, um den Grundwasserspiegel zu erreichen."
                            }
                        }
                    ],
                    "synonyms": [
                        "drill",
                        "bore"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Loch mit einem speziellen Werkzeug bohren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bohren",
                                "target_lang_sense_clarification": "allgemeine Tätigkeit des Bohrens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5116ed0-72d6-3545-a53e-257277e67ebe",
                    "sense_definition": "To move in a spiraling or twisting motion similar to a drill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small plane began to <w>auger</w> toward the ground after losing engine power.",
                            "target_lang_translations": {
                                "de": "Das kleine Flugzeug begann nach dem Ausfall des Motors spiralförmig Richtung Boden zu <w>trudeln</w>."
                            }
                        },
                        {
                            "text": "The debris continued to <w>auger</w> through the water until it hit the bottom.",
                            "target_lang_translations": {
                                "de": "Die Trümmerteile <w>wirbelten</w> weiter durch das Wasser, bis sie den Boden erreichten."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiral",
                        "twirl"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich in einer spiralförmigen oder drehenden Bewegung fortbewegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "spiralen",
                                "target_lang_sense_clarification": "sich spiralförmig bewegen"
                            },
                            {
                                "target_lang_word": "trudeln",
                                "target_lang_sense_clarification": "unkontrolliert spiralförmig abwärts bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "872cfc81-698c-35b1-ab3a-a8387ccec851",
                    "sense_definition": "To engage in daydreaming or idle thought.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would often <w>auger</w> during long meetings, lost in his own thoughts.",
                            "target_lang_translations": {
                                "de": "Er <w>hing</w> während langer Besprechungen oft seinen eigenen Gedanken nach."
                            }
                        },
                        {
                            "text": "Instead of working, she started to <w>auger</w> about her upcoming vacation.",
                            "target_lang_translations": {
                                "de": "Anstatt zu arbeiten, fing sie an, über ihren bevorstehenden Urlaub zu <w>tagträumen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "daydream",
                        "muse"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Rare usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich in Tagträumereien oder müßigen Gedanken verlieren."
                    },
                    "translations": {
                        "de": []
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0245c11c-9fe6-396b-b552-cd1fe6435760",
                    "sense_definition": "A surname of French origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical records mention a man named <w>Auger</w> who lived in the village.",
                            "target_lang_translations": {
                                "de": "Die historischen Aufzeichnungen erwähnen einen Mann namens <w>Auger</w>, der im Dorf lebte."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Auger</w> can trace their ancestry back to France.",
                            "target_lang_translations": {
                                "de": "Viele Menschen mit dem Nachnamen <w>Auger</w> können ihre Abstammung bis nach Frankreich zurückverfolgen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname französischer Herkunft."
                    },
                    "translations": {
                        "de": []
                    }
                }
            ]
        }
    ]
}