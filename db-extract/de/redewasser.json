                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2604b5c4-909a-4ea5-9372-0234ca42c4e0",
                                "sense_id": "4f2de175-bc77-3616-bc0e-09a59a03cd19",
                                "text": "„Der ‚Zentrale Verfassungszirkel‘ ist zu Ende. Ich hatte mal wieder reichlich Redewasser getrunken.“"
                            },
                            {
                                "example_id": "65bdd95b-f2a0-482c-a286-94abf4110f66",
                                "sense_id": "4f2de175-bc77-3616-bc0e-09a59a03cd19",
                                "text": "„Nur Helga hat Redewasser getrunken und unterhält uns alle mit.“"
                            },
                            {
                                "example_id": "4e07a01c-6fb4-4e4e-b5ca-ad4c7461afdf",
                                "sense_id": "4f2de175-bc77-3616-bc0e-09a59a03cd19",
                                "text": "„Dafür habe ich im Keller erstklassiges Redewasser, das löst jede Zunge.“"
                            },
                            {
                                "example_id": "3b6d4b0a-1757-4b42-b6e4-8189edd40423",
                                "sense_id": "4f2de175-bc77-3616-bc0e-09a59a03cd19",
                                "text": "„Und nicht nur den Damen der Schöpfung wird immer wieder unterstellt, dass sie Redewasser getrunken hätten.“"
                            },
                            {
                                "example_id": "bce5e379-a0a6-4dab-9aac-987585737467",
                                "sense_id": "4f2de175-bc77-3616-bc0e-09a59a03cd19",
                                "text": "„‚Dunnerkiel! Hat die man ein Redewasser am frühen Morgen!‘ dachte Wilm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
