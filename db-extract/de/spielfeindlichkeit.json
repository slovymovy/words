                ],
                "senses": [
                    {
                        "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                        "entry_id": "88a2c06b-6270-390e-9dc2-acc2f36bc1db",
                        "glosses": [
                            "Ablehnung der Tätigkeit des Spielens durch Personen, Gruppen oder Gesellschaften beziehungsweise widrige äußere Umstände für das Spielen durch die Umwelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b019bad-bc3a-4dd4-9932-8d87a354c40c",
                                "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                                "text": "„Die fortschreitenden Einschränkungen der Spielmöglichkeiten und das Anwachsen der Spielfeindlichkeit im Alltag tragen entscheidend zur Verkümmerung elementarer Spielfähigkeiten bei Kindern, Jugendlichen und Erwachsenen bei.“"
                            },
                            {
                                "example_id": "1998aff1-bfd1-432e-94f5-5d75979fffa2",
                                "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                                "text": "„Im Ergebnis neigte es zum Schutze der (schutzbedürftigen) Spielenden zu einer gewissen Spielfeindlichkeit, ohne den Wortlaut der entsprechenden Vorschriften zu überdehnen.“"
                            },
                            {
                                "example_id": "f619d50c-9376-4403-b6a3-ea2a06ded60c",
                                "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                                "text": "„Der Begriff des Spiels ist von Kindheit an mit keinem besonders guten Ruf gesegnet. Man könnte so weit gehen, zu behaupten, dass es im Alltagsgebrauch der Sprache eine gewisse Spielfeindlichkeit zu entdecken gäbe.“"
                            },
                            {
                                "example_id": "1a70ee8e-535e-450c-958c-320fc01e6e43",
                                "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                                "text": "„Wenn überhaupt von beiden Faktoren eine Spielfeindlichkeit ausgeht, dann muss es eine jeweils andere sein.“"
                            },
                            {
                                "example_id": "bbe5364d-8e13-41b6-8b8e-77b15bd25466",
                                "sense_id": "97306ea9-c46e-38e9-8a12-b1de0ad0c1a8",
                                "text": "„Keine ganz neue Erkenntnis, zugegeben, aber ein Statement, dass eine Eintönigkeit und Spielfeindlichkeit, eine Entdramatisierung behauptet, der häufige Zuschauer*innen [sic] und Leser*innen [sic] deutschsprachiger Theatertexte nicht leichtfertig widersprechen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
