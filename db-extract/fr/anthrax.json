        "fr-extract.jsonl": [
            {
                "entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                "word": "anthrax",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c75bc91-98d2-3c50-8af9-47dcb784bbf5",
                        "entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                        "glosses": [
                            "Infection staphylococcique de l’appareil glandulaire pilosébacé."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7223a581-c979-44da-96ff-1109720311b8",
                                "sense_id": "9c75bc91-98d2-3c50-8af9-47dcb784bbf5",
                                "text": "L’anthrax est une affection analogue au furoncle, dont il ne diffère que par le volume de la tumeur."
                            },
                            {
                                "example_id": "1ff0ec4f-2171-4b77-807e-446a10daecf2",
                                "sense_id": "9c75bc91-98d2-3c50-8af9-47dcb784bbf5",
                                "text": "L’expérience me permet d’affirmer que nous sommes incapables de discerner dans l’enchaînement des faits ce qui produira le bon ou le mauvais. J’ai vu des fluxions de poitrine guéries par des anthrax monstrueux, cancériformes et très dégoûtants."
                            },
                            {
                                "example_id": "4af93e37-0251-49bd-b98a-67dfd26a2364",
                                "sense_id": "9c75bc91-98d2-3c50-8af9-47dcb784bbf5",
                                "text": "J’ai failli mourir d’anthrax à l’intérieur des narines, le visage complètement déformé, ayant doublé de volume. Je fus sauvé lorsqu’on décida de m’injecter dans le nez des doses massives d’antibiotique."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e64155a-150b-3541-a431-eb0129d3aff0",
                        "entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                        "glosses": [
                            "Grenat, pierre dont l’éclat rappelle celui du charbon ardent. Grenat, spinelle rouge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84fad48e-67bc-38a9-b970-6319818bf5ec",
                        "entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                        "glosses": [
                            "Genre d’insectes diptères brachycères de la famille des Bombyliidae."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b06cea04-096f-3be8-82a6-983a0b814ac5",
                        "entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                        "glosses": [
                            "Maladie du charbon."
                        ],
                        "tags": [
                            "Parfois",
                            "sous l’influence de l’anglais"
                        ],
                        "examples": [
                            {
                                "example_id": "9080b157-88d0-4c5e-9670-e9586b528c1c",
                                "sense_id": "b06cea04-096f-3be8-82a6-983a0b814ac5",
                                "text": "Ce que les français appellent « maladie du charbon » est nommé anthrax par les anglophones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47a8873f-9be3-4869-88a6-7c10b2c76779",
                        "source_entry_id": "b0f6273a-30a4-388f-98c8-c2d4cdeceea1",
                        "target_lang_word": "carbuncle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbuncle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "A deep-red or fiery colored garnet or other dark red precious stone, especially when cut cabochon."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40970a0-fe51-487c-8095-bffde98c8951",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "With eyes like carbuncles, the hellish Pyrrhus […]"
                                            },
                                            {
                                                "example_id": "69ce4e3e-8954-4807-b0af-6089966857dc",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "And I will make thy windows of agates, and thy gates of carbuncles, and all thy borders of pleasant stones."
                                            },
                                            {
                                                "example_id": "811a9f14-66c1-4d4e-8074-6afc6ad5723a",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "His turban, or mandil [mandīl], was of finest white silk interwoven with gold, bestudded with pearl[s] and carbuncles; […]"
                                            },
                                            {
                                                "example_id": "4ce25388-4ee8-443d-9faa-cc48f87a3f7b",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "A piece of marigold or bay leaf was imbedded in the metal, and over it a carbuncle or chrysolite was placed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52aec426-78b2-3677-a6b6-4b4739830dd4",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "A charge or bearing supposed to represent the precious stone, with eight sceptres or staves radiating from a common centre; an escarbuncle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25045c8-bce7-3dd1-9328-88e02afc131f",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An abscess larger than a boil, usually with one or more openings draining pus onto the skin. It is usually caused by staphylococcal infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce63526-7272-3c66-b28e-189d34de7a68",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An unpopular or ugly building; an eyesore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
