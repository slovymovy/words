                            "comment": "Technical term used in mining."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Masa węgla pozostawiona w kopalni jako filar podtrzymujący strop.",
                        "nl": "Een steunkolom van steenkool die in een mijn blijft staan om het dak te stutten."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "filar",
                                "target_lang_sense_clarification": "element konstrukcyjny w kopalni"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "steunpilaar",
                                "target_lang_sense_clarification": "pilaar ter ondersteuning van het dak in een mijn"
                            },
                            {
                                "target_lang_word": "koolpijler",
                                "target_lang_sense_clarification": "pilaar van steenkool in een mijn"
                            }
                        ]
                    }
                }
            ]
        }
    ]
