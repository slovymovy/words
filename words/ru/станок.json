{
    "word_family": [
        "станочник",
        "станочный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "334ffc9d-934d-36f0-9f93-9b64cda3c343",
                    "sense_definition": "Приспособление для бритья со сменными лезвиями (безопасная бритва).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hygiene_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно купить новый бритвенный <w>станок</w> и пену для бритья.",
                            "target_lang_translations": {
                                "en": "I need to buy a new <w>razor</w> and shaving foam.",
                                "pl": "Muszę kupić nową <w>maszynkę do golenia</w> i piankę do golenia."
                            }
                        },
                        {
                            "text": "Этот одноразовый <w>станок</w> очень удобен в путешествиях.",
                            "target_lang_translations": {
                                "en": "This disposable <w>razor</w> is very convenient for traveling.",
                                "pl": "Ta jednorazowa <w>maszynka</w> jest bardzo wygodna w podróży."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бритвенный станок",
                        "одноразовый станок",
                        "лезвия для станка"
                    ],
                    "target_lang_definitions": {
                        "en": "A device for shaving with replaceable blades (safety razor).",
                        "pl": "Przyrząd do golenia z wymiennymi ostrzami lub żyletkami (maszynka do golenia)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "razor",
                                "target_lang_sense_clarification": "shaving tool"
                            },
                            {
                                "target_lang_word": "safety razor",
                                "target_lang_sense_clarification": "specific type"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "maszynka do golenia",
                                "target_lang_sense_clarification": "przyrząd do golenia"
                            },
                            {
                                "target_lang_word": "maszynka",
                                "target_lang_sense_clarification": "skrótowo: do golenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72d6d676-7dcb-32e7-9bfa-25a2ec87e2ab",
                    "sense_definition": "Машина или механизм для обработки различных материалов (металла, дерева) и изготовления изделий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На заводе установили новый токарный <w>станок</w> с программным управлением.",
                            "target_lang_translations": {
                                "en": "A new CNC <w>lathe</w> was installed at the factory.",
                                "pl": "W fabryce zainstalowano nową <w>tokarkę</w> sterowaną numerycznie."
                            }
                        },
                        {
                            "text": "Рабочий простоял у <w>станка</w> всю смену, вытачивая детали.",
                            "target_lang_translations": {
                                "en": "The worker stood at the <w>machine</w> all shift, turning parts.",
                                "pl": "Robotnik przestał przy <w>maszynie</w> całą zmianę, tocząc części."
                            }
                        }
                    ],
                    "common_phrases": [
                        "токарный станок",
                        "фрезерный станок",
                        "печатный станок",
                        "стоять у станка"
                    ],
                    "target_lang_definitions": {
                        "en": "A machine or mechanism for processing various materials (metal, wood) and manufacturing products.",
                        "pl": "Maszyna produkcyjna służąca do obróbki materiałów (np. metalu, drewna) i wytwarzania przedmiotów."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "machine tool",
                                "target_lang_sense_clarification": "industrial equipment"
                            },
                            {
                                "target_lang_word": "lathe",
                                "target_lang_sense_clarification": "for turning"
                            },
                            {
                                "target_lang_word": "machine",
                                "target_lang_sense_clarification": "general"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obrabiarka",
                                "target_lang_sense_clarification": "maszyna do obróbki skrawaniem lub plastycznej"
                            },
                            {
                                "target_lang_word": "maszyna",
                                "target_lang_sense_clarification": "urządzenie produkcyjne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cc93370-e3e5-3c56-b052-7d6b9e901ab9",
                    "sense_definition": "Специальная опора в виде горизонтального бруса для тренировок в балете или гимнастике.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Юные балерины каждый день начинают с разминки у <w>станка</w>.",
                            "target_lang_translations": {
                                "en": "Young ballerinas start every day with a warm-up at the <w>barre</w>.",
                                "pl": "Młode baletnice każdego dnia zaczynają od rozgrzewki przy <w>drążku</w>."
                            }
                        },
                        {
                            "text": "В танцевальном зале вдоль стены закреплён длинный деревянный <w>станок</w>.",
                            "target_lang_translations": {
                                "en": "A long wooden <w>barre</w> is fixed along the wall in the dance hall.",
                                "pl": "W sali tanecznej wzdłuż ściany zamocowany jest długi drewniany <w>drążek</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "хореографический станок",
                        "балетный станок",
                        "заниматься у станка"
                    ],
                    "target_lang_definitions": {
                        "en": "A special support in the form of a horizontal bar for training in ballet or gymnastics.",
                        "pl": "Poziomy drążek zamocowany przy ścianie, służący do ćwiczeń baletowych lub gimnastycznych."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "barre",
                                "target_lang_sense_clarification": "ballet"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "drążek",
                                "target_lang_sense_clarification": "baletowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77038828-b23b-3038-8b22-8120c9a8d873",
                    "sense_definition": "Основание или опора, на которой закрепляется артиллерийское орудие или пулемёт для ведения огня.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пулемётный <w>станок</w> обеспечивал устойчивость оружия при стрельбе очередями.",
                            "target_lang_translations": {
                                "en": "The machine gun <w>mount</w> ensured the weapon's stability when firing bursts.",
                                "pl": "<w>Podstawa</w> karabinu maszynowego zapewniała stabilność broni podczas strzelania seriami."
                            }
                        },
                        {
                            "text": "Солдаты быстро сняли орудие со <w>станка</w> и подготовили его к транспортировке.",
                            "target_lang_translations": {
                                "en": "The soldiers quickly removed the gun from the <w>mount</w> and prepared it for transport.",
                                "pl": "Żołnierze szybko zdjęli działo z <w>łoża</w> i przygotowali je do transportu."
                            }
                        }
                    ],
                    "synonyms": [
                        "лафет"
                    ],
                    "common_phrases": [
                        "пулемётный станок",
                        "орудийный станок",
                        "треножный станок"
                    ],
                    "target_lang_definitions": {
                        "en": "A base or support on which an artillery piece or machine gun is fixed for firing.",
                        "pl": "Podstawa lub podpora, na której montuje się działo artyleryjskie lub karabin maszynowy do prowadzenia ognia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "military"
                            },
                            {
                                "target_lang_word": "gun carriage",
                                "target_lang_sense_clarification": "mobile support"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podstawa",
                                "target_lang_sense_clarification": "do broni, karabinu maszynowego"
                            },
                            {
                                "target_lang_word": "łoże",
                                "target_lang_sense_clarification": "działa lub karabinu"
                            },
                            {
                                "target_lang_word": "laweta",
                                "target_lang_sense_clarification": "podstawa działa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c94d1319-e701-334d-b15b-0401cd8b25ea",
                    "sense_definition": "Специальная подставка или приспособление для закрепления чего-либо (например, в искусстве или ремесле).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скульптор поставил глиняную фигуру на вращающийся <w>станок</w>.",
                            "target_lang_translations": {
                                "en": "The sculptor placed the clay figure on a rotating <w>stand</w>.",
                                "pl": "Rzeźbiarz postawił glinianą figurę na obrotowy <w>kawalec</w>."
                            }
                        },
                        {
                            "text": "Переплётчик зажал книжный блок в деревянном <w>станке</w>, чтобы проклеить корешок.",
                            "target_lang_translations": {
                                "en": "The bookbinder clamped the book block in a wooden <w>press</w> to glue the spine.",
                                "pl": "Introligator zacisnął blok książki w drewnianej <w>prasie</w>, aby skleić grzbiet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скульптурный станок",
                        "ткацкий станок",
                        "переплётный станок"
                    ],
                    "target_lang_definitions": {
                        "en": "A special stand or device for fixing something (e.g., in art or craft).",
                        "pl": "Specjalna podstawka, stelaż lub urządzenie rzemieślnicze do mocowania obrabianego przedmiotu (np. w rzeźbiarstwie, introligatorstwie)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loom",
                                "target_lang_sense_clarification": "weaving"
                            },
                            {
