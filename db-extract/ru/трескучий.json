                ],
                "senses": [
                    {
                        "sense_id": "ed0d958a-2038-3c1b-9e85-d1448a5b3e0f",
                        "entry_id": "47df20a2-10fd-321e-a03f-513fce57533a",
                        "glosses": [
                            "сопровождаемый треском"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b954c2-093d-42aa-8f16-704c464f190e",
                                "sense_id": "ed0d958a-2038-3c1b-9e85-d1448a5b3e0f",
                                "text": "Белая молния озарила лесника с головы до ног; трескучий и короткий удар грома раздался тотчас вслед за нею."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc78d60c-70b1-3732-b8d8-76e7971adda0",
                        "entry_id": "47df20a2-10fd-321e-a03f-513fce57533a",
                        "glosses": [
                            "перен. бессодержательный, пустой, но шумный и высокопарный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "213770f3-1eff-4f50-8127-54183c7ed3d7",
                                "sense_id": "fc78d60c-70b1-3732-b8d8-76e7971adda0",
                                "text": "Идёт трескучий разговор об одной известной певице."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a5d617d-1a36-3197-8021-29d644920bbc",
                        "entry_id": "47df20a2-10fd-321e-a03f-513fce57533a",
                        "glosses": [
                            "перен. (о холоде) очень сильный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eda3b39-a9d3-4cb8-bef3-fff602826d6a",
                                "sense_id": "1a5d617d-1a36-3197-8021-29d644920bbc",
                                "text": "По мне всё равно, хоть бы и в трескучий мороз без шинели и без сапогов ходить, я перетерплю и всё вынесу."
                            }
                        ]
                    }
                ],
