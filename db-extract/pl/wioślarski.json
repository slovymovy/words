                "translations": [
                    {
                        "translation_id": "7ca3d1bb-86e0-435c-b8c7-3a6113542d84",
                        "source_entry_id": "56f4e08b-0830-35e2-8468-cecf7978becc",
                        "source_sense_id": "9d26c1a5-edad-3492-a2a6-a3ce2503f4f6",
                        "target_lang_word": "гребной",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гребной",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c9ffa8-673f-3612-8cc5-d89693717d19",
                                        "entry_id": "8c2fb900-c38e-335f-b246-e509c298a6df",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным гребля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d424282-4fef-47c3-a3af-5c7e471417da",
                                                "sense_id": "a0c9ffa8-673f-3612-8cc5-d89693717d19",
                                                "text": "Когда я был в Венеции, в день святого Марка, ― захотелось мне посмотреть на гребные гонки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14579b15-cd41-3fdc-8312-e86ad0224399",
                                        "entry_id": "8c2fb900-c38e-335f-b246-e509c298a6df",
                                        "glosses": [
                                            "передвигающийся путём отбрасывания воды с помощью различных приспособлений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57769f18-42b4-4255-8305-18ff16661e17",
                                                "sense_id": "14579b15-cd41-3fdc-8312-e86ad0224399",
                                                "text": "Пользуясь благоприятною погодою, мы посылали гребные суда ловить рыбу в разные места здешней губы и имели большой успех."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6889d5b-575c-34fa-a7a5-b44e8d60c921",
                                        "entry_id": "8c2fb900-c38e-335f-b246-e509c298a6df",
                                        "glosses": [
                                            "служащий для этой цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c68b043-f24d-4785-9a56-b168adf3fe48",
                                                "sense_id": "f6889d5b-575c-34fa-a7a5-b44e8d60c921",
                                                "text": "Передвижение аппарата под водой и маневрирование производятся с помощью гребного винта, уравнительной и дифферентной систем."
                                            },
                                            {
                                                "example_id": "f4102398-40e1-428a-abae-f2d57ca9aa1d",
                                                "sense_id": "f6889d5b-575c-34fa-a7a5-b44e8d60c921",
                                                "text": "Эта барка не походила на те, которые видела на родине Пелагея Прохоровна: она не имела палубы, была несколько овальнее, посредине её не было гребных вёсел."
                                            },
                                            {
                                                "example_id": "3c01f999-2dcd-4130-926e-d71ae93b9055",
                                                "sense_id": "f6889d5b-575c-34fa-a7a5-b44e8d60c921",
                                                "text": "Часто попадались рыбы под лопасти гребных колёс и вылетали из-под них оглушёнными."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
