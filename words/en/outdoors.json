{
    "word_family": [
        "outdoor",
        "outdooring"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9becfa72-537f-3a70-9d26-fb05e00deb58",
                    "sense_definition": "In the open air and not inside a building or house",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "outside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went <w>outdoors</w> to light up their cigarettes because smoking was not allowed inside.",
                            "target_lang_translations": {
                                "ru": "Они вышли <w>на улицу</w>, чтобы закурить, так как курение внутри было запрещено."
                            }
                        },
                        {
                            "text": "The children spent the whole afternoon playing <w>outdoors</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети провели весь день, играя <w>на свежем воздухе</w> в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "alfresco"
                    ],
                    "antonyms": [
                        "indoors"
                    ],
                    "common_phrases": [
                        "playing outdoors",
                        "sleeping outdoors",
                        "working outdoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "На открытом воздухе, вне здания или дома"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на улице",
                                "target_lang_sense_clarification": "вне помещения"
                            },
                            {
                                "target_lang_word": "на открытом воздухе",
                                "target_lang_sense_clarification": "под открытым небом"
                            },
                            {
                                "target_lang_word": "снаружи",
                                "target_lang_sense_clarification": "вне здания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79f9f560-3204-3386-a7df-d22437d7e87c",
                    "sense_definition": "The natural world or countryside away from cities and buildings",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves the <w>outdoors</w> for its freedom and fresh air.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>природу</w> за её свободу и свежий воздух."
                            }
                        },
                        {
                            "text": "The great <w>outdoors</w> offers many opportunities for hiking and camping.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>на природе</w> предлагает множество возможностей для походов и кемпинга."
                            }
                        }
                    ],
                    "synonyms": [
                        "great outdoors"
                    ],
                    "common_phrases": [
                        "the great outdoors",
                        "love the outdoors",
                        "explore the outdoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мир природы или сельская местность вдали от городов и зданий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "природа",
                                "target_lang_sense_clarification": "окружающий мир"
                            },
                            {
                                "target_lang_word": "открытый воздух",
                                "target_lang_sense_clarification": "естественная среда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1efebec-7ce1-3949-8db8-1eaf54a06113",
                    "sense_definition": "The area or environment that is outside of enclosed structures",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won't leave his house because he is afraid of the <w>outdoors</w>.",
                            "target_lang_translations": {
                                "ru": "Он не выходит из дома, потому что боится <w>открытого пространства</w>."
                            }
                        },
                        {
                            "text": "The transition from the warm room to the cold <w>outdoors</w> was a shock.",
                            "target_lang_translations": {
                                "ru": "Переход из теплой комнаты на холодную <w>улицу</w> стал шоком."
                            }
                        }
                    ],
                    "antonyms": [
                        "indoors"
                    ],
                    "common_phrases": [
                        "the cold outdoors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство или среда за пределами закрытых конструкций"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улица",
                                "target_lang_sense_clarification": "пространство вне дома"
                            },
                            {
                                "target_lang_word": "внешний мир",
                                "target_lang_sense_clarification": "пространство за стенами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ab0baf5-5c00-338f-9f59-4b64dfe1eb11",
                    "sense_definition": "Third-person singular simple present indicative of <w>outdoor</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect <w>outdoors</w> the living space by adding a large deck to the design.",
                            "target_lang_translations": {
                                "ru": "Архитектор <w>выносит</w> жилое пространство <w>наружу</w>, добавляя в проект большую террасу."
                            }
                        },
                        {
                            "text": "He <w>outdoors</w> his competition by hosting the event in a beautiful park.",
                            "target_lang_translations": {
                                "ru": "Он <w>переносит</w> соревнование <w>на открытый воздух</w>, проводя мероприятие в красивом парке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола, означающая перенос деятельности на открытый воздух"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносить на улицу",
                                "target_lang_sense_clarification": "организовывать вне помещения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}