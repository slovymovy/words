                "senses": [
                    {
                        "sense_id": "ac1398ac-ec5f-3f20-92cb-8b5553efaade",
                        "entry_id": "64e2cdc6-b2bd-3946-994e-5db75d4dd3c5",
                        "glosses": [
                            "das nur scheinbar Amtliche (Offizielle)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c7d53c-1f49-43af-a0cc-62010bd2b781",
                                "sense_id": "ac1398ac-ec5f-3f20-92cb-8b5553efaade",
                                "text": "„Was interessiert, kann thematisiert werden. Offiziosität verlangt keine feste Gruppe, aber die Anzahl der Konversanten ist überschaubar, andernfalls verschwindet die Offiziosität.“"
                            },
                            {
                                "example_id": "4f4a67f8-0a01-4fde-9010-c4414b6b9c62",
                                "sense_id": "ac1398ac-ec5f-3f20-92cb-8b5553efaade",
                                "text": "„Das Problem stand tatsächlich so: Ohne Offiziosität keine Informationen, ohne Informationen kein außenpolitisches Urteil. Verzichtete eine Zeitung vom Rang der ‚Kölnischen Zeitung‘ auf die Offiziosität, dann büßte sie auch ihre Bedeutung ein.“ (1939)"
                            },
                            {
                                "example_id": "284b4ad3-067f-4b75-9b3d-e4c255b55b3d",
                                "sense_id": "ac1398ac-ec5f-3f20-92cb-8b5553efaade",
                                "text": "„‚Ellenör‘ sieht bereits den Krieg zwischen Oesterreich und Ungarn erklärt; ‚Hon‘ versichert mit allem Nachdruck seiner Offiziosität: ‚Die ungarische Regierung wird vor der österreichischen nicht kapituliren.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d6a377bd-6775-34b6-9b1a-4c914dde1f07",
                        "entry_id": "64e2cdc6-b2bd-3946-994e-5db75d4dd3c5",
                        "glosses": [
                            "Dienstfertigkeit"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0d738124-0dc2-403a-8d79-d9d90b5454ec",
                                "sense_id": "d6a377bd-6775-34b6-9b1a-4c914dde1f07",
                                "text": "„‚Ellenör‘ sieht bereits den Krieg zwischen Oesterreich und Ungarn erklärt; ‚Hon‘ versichert mit allem Nachdruck seiner Offiziosität: ‚Die ungarische Regierung wird vor der österreichischen nicht kapituliren.‘“"
                            },
                            {
                                "example_id": "c2972ec4-850a-483d-9e73-9dc7bbb843f8",
                                "sense_id": "d6a377bd-6775-34b6-9b1a-4c914dde1f07",
                                "text": "„Bei dem Mandat erscheint die persönlich freundschaftliche Offiziosität als das durchschlagende Moment: Dienste ohne Entgelt zu leisten soll ich nicht gezwungen sein, sobald mir die Lust dazu vergeht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
