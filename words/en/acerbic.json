{
    "word_family": [
        "acerbity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2a8e124-1636-303e-b58c-486337839214",
                    "sense_definition": "Sharp, harsh, or biting in tone or manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sharp_tone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic is known for his <w>acerbic</w> wit and harsh reviews of new films.",
                            "target_lang_translations": {
                                "zh": "这位评论家以其<w>尖刻</w>的机智和对新片严厉的影评而闻名。",
                                "nl": "De criticus staat bekend om zijn <w>bijtende</w> humor en harde recensies van nieuwe films."
                            }
                        },
                        {
                            "text": "She made an <w>acerbic</w> comment that left everyone in the room feeling quite uncomfortable.",
                            "target_lang_translations": {
                                "zh": "她发表了一番<w>刻薄</w>的评论，让在场的所有人都感到非常不自在。",
                                "nl": "Ze maakte een <w>scherpe</w> opmerking waardoor iedereen in de kamer zich behoorlijk ongemakkelijk voelde."
                            }
                        }
                    ],
                    "synonyms": [
                        "acrimonious",
                        "scathing"
                    ],
                    "common_phrases": [
                        "acerbic wit",
                        "acerbic comment"
                    ],
                    "target_lang_definitions": {
                        "zh": "指语气或态度尖刻、辛辣、刻薄。",
                        "nl": "Scherp, bijtend of sarcastisch van toon of houding."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖刻",
                                "target_lang_sense_clarification": "形容言辞尖锐、刻薄。"
                            },
                            {
                                "target_lang_word": "辛辣",
                                "target_lang_sense_clarification": "形容言辞犀利、不留情面。"
                            },
                            {
                                "target_lang_word": "刻薄",
                                "target_lang_sense_clarification": "形容待人冷酷、言语尖酸。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "snerpend",
                                "target_lang_sense_clarification": "scherp of kwetsend van toon"
                            },
                            {
                                "target_lang_word": "bijtend",
                                "target_lang_sense_clarification": "fel en scherp bekritiserend"
                            },
                            {
                                "target_lang_word": "scherp",
                                "target_lang_sense_clarification": "vatbaar voor felle kritiek of sarcastisch"
                            },
                            {
                                "target_lang_word": "wrang",
                                "target_lang_sense_clarification": "bitter of schamper"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd598442-f75e-31ba-b5bf-77c914cf72ac",
                    "sense_definition": "Having a sour or bitter taste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>acerbic</w> flavor of the unripe fruit made it difficult to eat.",
                            "target_lang_translations": {
                                "zh": "这种未成熟水果的<w>酸涩</w>味道让人难以入口。",
                                "nl": "De <w>wrange</w> smaak van het onrijpe fruit maakte het moeilijk te eten."
                            }
                        },
                        {
                            "text": "Some people dislike the <w>acerbic</w> taste of certain types of dark coffee.",
                            "target_lang_translations": {
                                "zh": "有些人不喜欢某些深烘焙咖啡那种<w>苦涩</w>的味道。",
                                "nl": "Sommige mensen houden niet van de <w>bitterzure</w> smaak van bepaalde soorten donkere koffie."
                            }
                        }
                    ],
                    "synonyms": [
                        "acerb",
                        "acrid"
                    ],
                    "common_phrases": [
                        "acerbic taste"
                    ],
                    "target_lang_definitions": {
                        "zh": "指味道酸涩或苦涩。",
                        "nl": "Een zure of wrange, bittere smaak hebbend."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "酸涩",
                                "target_lang_sense_clarification": "形容味道既酸又涩。"
                            },
                            {
                                "target_lang_word": "苦涩",
                                "target_lang_sense_clarification": "形容味道苦而涩。"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wrang",
                                "target_lang_sense_clarification": "onaangenaam zuur of samentrekkend van smaak"
                            },
                            {
                                "target_lang_word": "bitterzuur",
                                "target_lang_sense_clarification": "tegelijk bitter en zuur van smaak"
                            },
                            {
                                "target_lang_word": "scherp",
                                "target_lang_sense_clarification": "zeer zuur of prikkelend van smaak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
