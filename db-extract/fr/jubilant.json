                ],
                "senses": [
                    {
                        "sense_id": "91a24ffd-1400-3793-95e2-4d3d425cf7f2",
                        "entry_id": "d1ad43dc-c93c-333d-8dd9-e679aff0b83f",
                        "glosses": [
                            "Qui jubile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583907f2-bcbe-471c-9fd0-70fa5a47b606",
                                "sense_id": "91a24ffd-1400-3793-95e2-4d3d425cf7f2",
                                "text": "Un air jubilant."
                            },
                            {
                                "example_id": "c2ae0a1b-73d1-4f9e-b72a-3868ae22a3ca",
                                "sense_id": "91a24ffd-1400-3793-95e2-4d3d425cf7f2",
                                "text": "Avec une terreur jubilante, la maison tout entière salue le train hurleur qui lui passe contre le flanc, dans le lacis des rails, au nord."
                            },
                            {
                                "example_id": "8e3f42b2-bd5c-4688-97fa-433b3bbc3c62",
                                "sense_id": "91a24ffd-1400-3793-95e2-4d3d425cf7f2",
                                "text": "Il a les mains dans les poches, il ne répond pas. Puis : « Quand on voyage on voit des gens. » La vieille dame rit : « T’en verras des beaux et des laids partout ! » Son visage reste jubilant pendant qu’elle regarde devant elle, cessant de parler. Le garçon ne sourit pas et fixe ses chaussures, appuyé à la paroi du train."
                            },
                            {
                                "example_id": "c2d471d4-55ee-4646-a38c-88b0c69a1c73",
                                "sense_id": "91a24ffd-1400-3793-95e2-4d3d425cf7f2",
                                "text": "Comment expliquer le succès inattendu de ce livre de 170 pages au charme fou, propice à une lecture jubilante ?"
                            }
                        ]
                    }
                ],
