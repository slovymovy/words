                "senses": [
                    {
                        "sense_id": "4a15279b-3921-35a8-989a-f5db2c81fc43",
                        "entry_id": "71ee8f78-a40e-37b6-9742-bab177db7708",
                        "glosses": [
                            "omslag van een boek, cd of tijdschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d720f6b-c2d7-4e0e-841b-2d4ab8df4723",
                                "sense_id": "4a15279b-3921-35a8-989a-f5db2c81fc43",
                                "text": "Wie staat er deze week op de cover van de Times."
                            },
                            {
                                "example_id": "c146cf5b-f53d-44cd-9038-09d58c78cfbc",
                                "sense_id": "4a15279b-3921-35a8-989a-f5db2c81fc43",
                                "text": "Verder speculeren was zinloos, omdat zijn kennis hiervan ophield bij de cover van modetijdschriften die bij de huisarts of tandarts lagen."
                            },
                            {
                                "example_id": "cafcbcc2-939b-4553-af38-185849ad896f",
                                "sense_id": "4a15279b-3921-35a8-989a-f5db2c81fc43",
                                "text": "Ze leek met haar hippe kleren, haar gracieuze gestalte en wapperende bruine haren veel op de Amerikaanse fotomodellen die je in die jaren vaker op de covers van de bladen bij de kiosk zag."
                            }
                        ]
                    },
                    {
                        "sense_id": "39d6abcd-78c7-37b5-847f-f37b6589ffb8",
                        "entry_id": "71ee8f78-a40e-37b6-9742-bab177db7708",
                        "glosses": [
                            "platenhoes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee48865-d205-42fb-94f1-b57f6d260a32",
                                "sense_id": "39d6abcd-78c7-37b5-847f-f37b6589ffb8",
                                "text": "De cover van Sgt. Pepper's Lonely Heartclub Band is haast nog beroemder dan de plaat zelf"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6c94d45-cc5b-38fe-899b-caf4fae6d441",
                        "entry_id": "71ee8f78-a40e-37b6-9742-bab177db7708",
                        "glosses": [
                            "nieuwe versie van een al langer bestaand lied, meestal ook gemaakt door een andere artiest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0202f3b6-404a-4b4f-a208-300e28c6c416",
                                "sense_id": "e6c94d45-cc5b-38fe-899b-caf4fae6d441",
                                "text": "De band speelt vooral covers op bruiloften en partijen."
                            },
                            {
                                "example_id": "0d468914-ab61-4626-a104-5381a1f8f6b0",
                                "sense_id": "e6c94d45-cc5b-38fe-899b-caf4fae6d441",
                                "text": "Heesters brak door op YouTube: op haar kanaal zong ze covers van beroemde liedjes en al snel kreeg ze veel volgers."
                            }
                        ]
                    }
                ],
