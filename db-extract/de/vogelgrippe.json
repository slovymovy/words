                                        "sense_id": "60545496-c6f8-3efe-b6c7-b426349c4eaa",
                                        "entry_id": "1e279b5e-7947-399f-82cd-e61013d33159",
                                        "glosses": [
                                            "Avian influenza."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eccf03ad-8d6c-433a-9ee0-63ba2f0ffe87",
                                                "sense_id": "60545496-c6f8-3efe-b6c7-b426349c4eaa",
                                                "text": "Authorities said the discovery of H5N9 bird flu in poultry came alongside the detection of the more common H5N1 strain on the same farm in Merced county, California, and that almost 119,000 birds on the farm had been killed since early December."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec5e60c4-dbe9-4f8f-ac3b-b0d9556457b8",
                        "source_entry_id": "1b8bac62-5d31-34ad-8b5a-dc24dc5a32f9",
                        "source_sense_id": "779e9efe-5ab3-39b1-803d-57ae5ae0aad7",
                        "target_lang_word": "avian influenza",
                        "target_lang_code": "en",
