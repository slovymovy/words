                        }
                    ]
                },
                {
                    "sense_id": "34b65e83-44d0-3aeb-b59d-b171fa19375c",
                    "sense_definition": "Das Austauschen von Küssen; das Berühren mit den Lippen als Zärtlichkeit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kuss_geben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das <w>Küssen</w> gilt in vielen Kulturen als ein natürlicher Ausdruck von Liebe und Nähe."
                        },
                        {
                            "text": "Beim <w>Küssen</w> schließen die meisten Menschen die Augen."
                        }
                    ],
                    "synonyms": [
                        "Knutschen"
                    ],
                    "common_phrases": [
                        "Spaß am Küssen haben"
                    ]
                },
                {
                    "sense_id": "40dfa965-bda2-3688-aab1-9b0b02f898b6",
                    "sense_definition": "Veraltete oder landschaftliche Nebenform von <w>Kissen</w>.",
                    "learner_level": "C2",
