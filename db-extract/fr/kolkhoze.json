                                        "glosses": [
                                            "A farming collective in the former Soviet Union."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c2d5ea4-0e82-4f09-80a4-9c03b0c0e911",
                                                "sense_id": "b4b1c7cf-9add-3949-9adf-1aa4125f08ef",
                                                "text": "And books were demanded of them, books on Russia, on sailors, on aeroplanes, on scientists, on metro-workers, on kolkhoz labourers, on women and schoolchildren and parachute heroes."
                                            }
                                        ]
                                    }
                                ]
