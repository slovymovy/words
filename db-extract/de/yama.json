                "senses": [
                    {
                        "sense_id": "5484a7c7-0506-3379-bc20-a8e9a81dd8fa",
                        "entry_id": "a8a9b36c-fba6-395c-b14a-051151a0b940",
                        "glosses": [
                            "Gott des Todes und des Rechtes (Dharmaraja)"
                        ],
                        "tags": [
                            "Hinduismus"
                        ],
                        "examples": [
                            {
                                "example_id": "39c45efc-f4ca-40f8-a328-ecc90f9c001d",
                                "sense_id": "5484a7c7-0506-3379-bc20-a8e9a81dd8fa",
                                "text": "„Da sah die gattentreue reine Königstochter den Todesgott, Yama, den ›König ewigen Rechts‹, wie er leibhaftig herankam. Der Mächtige war dunkelfarben wie blaue Lotosblüte und war in gelbes Gewand gekleidet. Er glich einer regenschweren blau-schwarzen Wolke, deren Leib von Blitzen wie Schlingpflanzen umwunden ist: schimmernd mit sonnenfarbenem Diadem und Ohrgehängen, mit schwerem Perlenschmuck auf der Brust und mit Ringen an den Armen. Seinen Schritten folgten Zeit und Tod.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
