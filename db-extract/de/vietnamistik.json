                                "target_senses": [
                                    {
                                        "sense_id": "99e69ac5-9b89-3226-ab70-32184068e94f",
                                        "entry_id": "2c4f8db4-a16f-317c-8e38-a3945e5fad74",
                                        "glosses": [
                                            "Ngành khoa học nghiên cứu về đất nước và con người Việt Nam (bao gồm văn hóa, lịch sử, ngôn ngữ, địa lý, kinh tế, chính trị, v.v.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7284aea-5680-4315-b883-2e9e1c05ad8d",
                                                "sense_id": "99e69ac5-9b89-3226-ab70-32184068e94f",
                                                "text": "Từ tốn mà không chậm chạp, kỹ lưỡng mà không bảo thủ, rành rẽ mà không khô khan, […] Đó là lời nhận xét mà GS sử học Lê Văn Lan dành cho GS Keith W. Taylor, nhà Việt Nam học người Mỹ."
                                            },
                                            {
                                                "example_id": "6cb1ef30-27e9-442e-ba7d-3cca77cebe16",
                                                "sense_id": "99e69ac5-9b89-3226-ab70-32184068e94f",
                                                "text": "Chính sách phát triển giáo dục, […] tạo thêm luận chứng khu vực học cho Việt Nam học, xây dựng đội ngũ chuyên ngành có hệ thống, xây dựng môi trường học thuật tạo điều kiện cho những nghiên cứu Việt Nam học đi vào chiều sâu, theo tôi, đó là các yếu tố nhất thiết cần có để Việt Nam học giữ vững vai trò khoa học cơ bản."
                                            },
                                            {
                                                "example_id": "c1165157-cef0-4945-8b9e-49025fa1cbc1",
                                                "sense_id": "99e69ac5-9b89-3226-ab70-32184068e94f",
                                                "text": "Từ sau thời điểm Đổi mới năm 1986, Việt Nam học trở thành một khoa học liên ngành dựa trên nền tảng Khu vực học nhằm đưa lại tri thức tổng hợp liên ngành về Việt Nam."
                                            },
                                            {
                                                "example_id": "14724b5e-a6d3-4416-a7ee-58a56d55ab32",
                                                "sense_id": "99e69ac5-9b89-3226-ab70-32184068e94f",
                                                "text": "Đây là một trong những trung tâm đào tạo sinh viên học tiếng Việt và các nhà Việt Nam học tương lai hàng đầu của Nga."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
