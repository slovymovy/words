                "senses": [
                    {
                        "sense_id": "e14ad992-2b33-38f2-bf34-467a33844c43",
                        "entry_id": "497213ec-8ac9-3eb1-bc83-9af65a47b2cb",
                        "glosses": [
                            "Variante de écarquiller."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "277a4e8b-efa1-3154-8fa6-96d247c0e0ee",
                        "entry_id": "497213ec-8ac9-3eb1-bc83-9af65a47b2cb",
                        "glosses": [
                            "Synonyme de écarter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b6c913-b582-45dd-99bf-66df9b6af5a5",
                                "sense_id": "277a4e8b-efa1-3154-8fa6-96d247c0e0ee",
                                "text": "Même tout écartillé dans Paris aux sept péchés\nMême en m'épivardant dans les quatre coins du temps\nComme une boule de pool qu'on fesse dedans"
                            },
                            {
                                "example_id": "ed701e40-fb4b-4d14-bf47-ed544240e2e3",
                                "sense_id": "277a4e8b-efa1-3154-8fa6-96d247c0e0ee",
                                "text": "Je sais ce que vous dites : « Mais c’est impossible ! On ne peut pas à la fois plaire aux militants antiavortement et aux féministes, aux défenseurs de la loi 21 et aux chantres du multiculturalisme ! Le pauvre monsieur O’Toole va fendre en deux ! »\nEh bien, vous ne perdez rien pour attendre !\nMême Luc Senay dans ses belles années n’arrivait pas à s’écartiller de la sorte !"
                            },
                            {
                                "example_id": "d93e1d5e-a990-4f7f-98e7-80b789ef379d",
                                "sense_id": "277a4e8b-efa1-3154-8fa6-96d247c0e0ee",
                                "text": "Au Québec, on écarquille les yeux, mais on écartille les jambes."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0595366-7a19-3029-aa22-d2bce954630d",
                        "entry_id": "497213ec-8ac9-3eb1-bc83-9af65a47b2cb",
                        "glosses": [
                            "Écarter les jambes lorsqu'on est assis dans un espace public et ainsi réduire l'espace des personnes assises à côté, équivalent de manspreading."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
