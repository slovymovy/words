                                        "entry_id": "f75d244d-ae00-3445-ad25-d330dfebc0b7",
                                        "glosses": [
                                            "zu einem Zeitpunkt, bevor ein bestimmter Vorgang oder ein Ereignis begonnen hat"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3169caad-b0f3-4317-8f92-95cab76ef90e",
                                                "sense_id": "6ff133d1-247a-3549-9295-9e69e7c72450",
                                                "text": "Ich möchte die Bedingungen für unsere Geschäftsbeziehung im Vorhinein geklärt haben."
                                            },
                                            {
                                                "example_id": "2c346856-2c91-4216-b99a-3482ae24cb37",
                                                "sense_id": "6ff133d1-247a-3549-9295-9e69e7c72450",
                                                "text": "Es war ihm schon im Vorhinein klar, dass der direkte Schlag aufs Grün ein hohes Risiko birgt, aber er war in Angriffsstimmung und versuchte es dennoch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e86ef8e3-6cbf-4a80-8b20-a21b94ec6363",
                        "source_entry_id": "3d55e4d7-93a6-3897-9ddc-a1db7b836fd8",
                        "source_sense_id": "7dd93403-3598-386e-aa3b-eefe8ba2d7bf",
                        "source_sense_description": "Avant le moment prévu",
                        "target_lang_word": "in advance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in advance",
