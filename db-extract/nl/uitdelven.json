                        "examples": [
                            {
                                "example_id": "1ffdaa5c-748c-47cb-810c-5f9497eadee3",
                                "sense_id": "6339e4e8-6635-3b66-b35a-9637956df5a8",
                                "text": "Het belangrijkste bouwmateriaal, leem, haalden Anke en Rien uit hun eigen weide. ‘Uit die put in de tuin: voorlopig een kikkerpoel, hopelijk ooit een zwemvijver. Voor onze grote woning gaan we de put gewoon verder uitdelven.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "85dcadb5-b271-360b-8ce5-f33a20ac7f8f",
                        "entry_id": "b846ec43-7a80-3455-9e9b-db153884d3da",
                        "glosses": [
                            "diepgravend onderzoeken"
                        ],
