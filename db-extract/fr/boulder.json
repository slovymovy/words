                                        "glosses": [
                                            "A large marble, in children's games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c01fbe-e41c-4bca-bc2c-6939119336c4",
                                                "sense_id": "685ea663-24d3-3197-9ade-7cd9ea8761b8",
                                                "text": "There were four sizes of marbles and we called them boulders, biggies, regulars, and teenies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e805c2c-155a-3212-a544-1c9097437f37",
