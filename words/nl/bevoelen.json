    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47dc150e-2a05-337b-9ee1-8d85515f10da",
                    "sense_definition": "iets of iemand herhaaldelijk of aandachtig aanraken om het te onderzoeken of te ervaren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bakker begon het verse brood te <w>bevoelen</w> om te controleren of de korst wel knapperig genoeg was.",
                            "target_lang_translations": {
                                "en": "The baker began to <w>feel</w> the fresh bread to check if the crust was crunchy enough."
                            }
                        },
                        {
                            "text": "Je kunt de stof van de gordijnen <w>bevoelen</w> om de kwaliteit van het materiaal zelf te beoordelen.",
                            "target_lang_translations": {
                                "en": "You can <w>touch</w> the fabric of the curtains to judge the quality of the material yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "betasten",
                        "aftasten",
                        "palperen"
                    ],
                    "common_phrases": [
                        "de stof bevoelen",
                        "het brood bevoelen",
                        "voorzichtig bevoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to touch something or someone repeatedly or attentively in order to examine or experience it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "to examine by touch"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to make physical contact with"
                            },
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "to touch or feel with the hands"
                            },
                            {
                                "target_lang_word": "palpate",
                                "target_lang_sense_clarification": "to examine medically by touch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd294708-8738-3670-941b-700d74b66030",
                    "sense_definition": "door middel van aanraking waarnemen of voelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het donker probeerde hij de muren te <w>bevoelen</w> om de uitgang van de kamer te vinden.",
                            "target_lang_translations": {
                                "en": "In the dark, he tried to <w>feel</w> the walls to find the exit of the room."
                            }
                        },
                        {
                            "text": "De arts begon de gezwollen enkel voorzichtig te <w>bevoelen</w> om de ernst van de blessure vast te stellen.",
                            "target_lang_translations": {
                                "en": "The doctor began to carefully <w>palpate</w> the swollen ankle to determine the severity of the injury."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanraken",
                        "voelen",
                        "tasten"
                    ],
                    "common_phrases": [
                        "een wond bevoelen",
                        "de muren bevoelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to perceive or feel through the sense of touch"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feel",
                                "target_lang_sense_clarification": "to perceive via the sense of touch"
                            },
                            {
                                "target_lang_word": "grope",
                                "target_lang_sense_clarification": "to feel about with the hands, especially in the dark"
                            },
                            {
                                "target_lang_word": "fumble",
                                "target_lang_sense_clarification": "to use the hands to find something blindly"
                            }
                        ]
                    }
                }
            ]
        }
