                "senses": [
                    {
                        "sense_id": "4056c264-53f5-3339-892d-91cfd1ce8e1a",
                        "entry_id": "a31d5bdd-746a-389d-9f32-1d5226fdcc0d",
                        "glosses": [
                            "прост. то же, что побороть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77073347-782e-4a70-a841-582e38ca870d",
                                "sense_id": "4056c264-53f5-3339-892d-91cfd1ce8e1a",
                                "text": "Почитайте Гоголя «Ночь перед Рождеством», как там Вакула-кузнец оборол черта, сел на него верхом и заставил лететь к царице за башмаками для своей невесты."
                            },
                            {
                                "example_id": "55e3228f-a70a-4a8c-96c0-faaebded4ea6",
                                "sense_id": "4056c264-53f5-3339-892d-91cfd1ce8e1a",
                                "text": "Но Давыдко тут же оборол бабью присказку своим присловьем: ― Однако и говорится: почин дороже овчин. А уж почин нынче куда с добром!"
                            }
                        ]
                    }
