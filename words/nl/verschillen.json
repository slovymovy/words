                    "sense_definition": "Niet hetzelfde zijn; afwijken van iets of iemand anders.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijzen kunnen per winkel sterk <w>verschillen</w>.",
                            "target_lang_translations": {
                                "en": "Prices can <w>vary</w> greatly per shop.",
                                "ru": "Цены могут сильно <w>различаться</w> в зависимости от магазина.",
                                "fr": "Les prix peuvent fortement <w>varier</w> d'un magasin à l'autre.",
                                "it": "I prezzi possono <w>variare</w> notevolmente da negozio a negozio.",
                                "pl": "Ceny mogą się znacznie <w>różnić</w> w zależności od sklepu.",
                                "de": "Die Preise können je nach Geschäft stark <w>variieren</w>.",
                                "cs": "Ceny se mohou v jednotlivých obchodech výrazně <w>lišit</w>.",
                                "tr": "Fiyatlar mağazaya göre büyük ölçüde <w>değişebilir</w>.",
                                "es": "Los precios pueden <w>variar</w> mucho según la tienda.",
                                "zh": "不同商店的价格可能会有很大<w>差异</w>。"
                            }
                        },
                        {
                            "text": "Mijn mening <w>verschilt</w> op dit punt van die van jou.",
                            "target_lang_translations": {
                                "en": "My opinion <w>differs</w> from yours on this point.",
                                "ru": "Мое мнение по этому вопросу <w>отличается</w> от твоего.",
                                "fr": "Mon opinion <w>diffère</w> de la tienne sur ce point.",
                                "it": "La mia opinione su questo punto <w>differisce</w> dalla tua.",
                                "pl": "Moje zdanie w tej kwestii <w>różni się</w> od twojego.",
                                "de": "Meine Meinung <w>unterscheidet</w> sich in diesem Punkt von deiner.",
                                "cs": "Můj názor se v tomto bodě <w>liší</w> od tvého.",
                                "tr": "Bu konuda benim fikrim seninkinden <w>farklı</w>.",
                                "es": "Mi opinión <w>difiere</w> de la tuya en este punto.",
                                "zh": "在这一点上，我的意见和你<w>不同</w>。"
                            }
                        },
                        {
                            "text": "De twee versies <w>verschilden</w> maar op een paar plaatsen.",
                            "target_lang_translations": {
                                "en": "The two versions <w>differed</w> in only a few places.",
                                "ru": "Две версии <w>отличались</w> лишь в нескольких местах.",
                                "fr": "Les deux versions ne <w>différaient</w> que sur quelques points.",
                                "it": "Le due versioni <w>differivano</w> solo in pochi punti.",
                                "pl": "Obie wersje <w>różniły się</w> tylko w kilku miejscach.",
                                "de": "Die beiden Versionen <w>unterschieden</w> sich nur an wenigen Stellen.",
                                "cs": "Obě verze se <w>lišily</w> pouze na několika místech.",
                                "tr": "İki versiyon sadece birkaç yerde <w>farklılık gösteriyordu</w>.",
                                "es": "Las dos versiones solo <w>diferían</w> en algunos puntos.",
                                "zh": "这两个版本仅在几处地方<w>有区别</w>。"
                            }
