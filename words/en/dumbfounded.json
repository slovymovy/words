{
    "word_family": [
        "dumbfound"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd1c15ed-cb5f-3573-94d1-bd7f7ae909e0",
                    "sense_definition": "Shocked and speechless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was <w>dumbfounded</w> by the magician's incredible final trick.",
                            "target_lang_translations": {
                                "zh": "观众被魔术师最后那不可思议的戏法弄得<w>目瞪口呆</w>。"
                            }
                        },
                        {
                            "text": "She stood <w>dumbfounded</w> and speechless when she heard the unexpected news.",
                            "target_lang_translations": {
                                "zh": "听到那个意想不到的消息时，她<w>惊呆</w>得说不出话来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "astounded",
                        "flabbergasted",
                        "shocked",
                        "speechless",
                        "stunned"
                    ],
                    "common_phrases": [
                        "completely dumbfounded",
                        "left dumbfounded"
                    ],
                    "target_lang_definitions": {
                        "zh": "因震惊而说不出话的；目瞪口呆的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "目瞪口呆",
                                "target_lang_sense_clarification": "形容因吃惊或害怕而发愣的样子。"
                            },
                            {
                                "target_lang_word": "惊呆",
                                "target_lang_sense_clarification": "形容因极度惊讶而发愣。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfc421de-4d87-3dea-990c-10d92510fa1f",
                    "sense_definition": "Simple past and past participle of <w>dumbfound</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden announcement <w>dumbfounded</w> everyone in the room.",
                            "target_lang_translations": {
                                "zh": "那个突如其来的公告让房间里的每个人都<w>惊呆</w>了。"
                            }
                        },
                        {
                            "text": "He was <w>dumbfounded</w> by the complexity of the task.",
                            "target_lang_translations": {
                                "zh": "任务的复杂程度让他感到<w>目瞪口呆</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使人震惊而说不出话（dumbfound的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……目瞪口呆",
                                "target_lang_sense_clarification": "使某人感到极度惊讶。"
                            },
                            {
                                "target_lang_word": "使……惊呆",
                                "target_lang_sense_clarification": "使某人因惊讶而不知所措。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}