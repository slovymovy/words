                "senses": [
                    {
                        "sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                        "entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                        "glosses": [
                            "Celle qui trait."
                        ],
                        "tags": [
                            "Métier",
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "b429edc6-40a7-475c-91b8-45c2229ef761",
                                "sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                                "text": "On est tous mêlés ; maîtres et valets, la fermière et les domestiques, le premier garçon de ferme et le petit gardeur de porcs, l’oncle Jean, Florimond le laboureur, Pierrouni le vacher, Jeanneton la trayeuse, et toutes les cousines qui ont mis leur plus large coiffe et d’énormes ceintures vertes."
                            }
                        ]
                    },
                    {
                        "sense_id": "61ba0f2c-6969-353f-9834-c073a2f9233d",
                        "entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                        "glosses": [
                            "Machine à traire les animaux d'élevage laitier (vaches, brebis, chèvres)."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "83ebbe27-169b-421d-ae5f-4132a647d3a9",
                                "sense_id": "61ba0f2c-6969-353f-9834-c073a2f9233d",
                                "text": "Les vaches, habituées aux ventouses happeuses des trayeuses, ruent des quatre sabots, envoyant balader dans les pailles noires les casseroles à lait parce que les doigts n'ont plus le tact, la manière, la caresse adéquate aux sollicitations du pis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb54a1eb-0e43-4a17-a6d9-33da43a65a05",
                        "source_entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                        "source_sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                        "source_sense_description": "Personne",
                        "target_lang_word": "Milchmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                        "entry_id": "98949ad5-1770-3ffc-ace6-2c33d618963f",
                                        "glosses": [
                                            "Berufsbezeichnung für junge Frauen, die Kühe melken, Milch verarbeiten und verkaufen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9469b7f8-a728-4464-a0a1-ca88b7ef7bdd",
                                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                                "text": "Den Milchmädchen kam in der historischen Milchindustrie eine wichtige Rolle zu."
                                            },
                                            {
                                                "example_id": "927fabb5-3b20-4576-aea2-6d574308f523",
                                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21964098-1081-4337-a575-cabea4ae2563",
                        "source_entry_id": "d37549e7-81d0-3717-81f1-74434ddb7e64",
                        "source_sense_id": "e91db047-652a-3f1d-ae2c-ee7fae0c4578",
                        "source_sense_description": "Personne",
                        "target_lang_word": "Melkerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melkerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf7e982f-fb3f-3923-91e8-c2b3ee09bfed",
                                        "entry_id": "9f1fb438-fbe1-3012-a6d8-fe51f897339c",
                                        "glosses": [
                                            "weibliche Person, die sich (beruflich) mit Melken beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3458352-4431-4a98-91c2-c91ab7d7c5ec",
                                                "sense_id": "cf7e982f-fb3f-3923-91e8-c2b3ee09bfed",
                                                "text": "„Im Suff ist die Melkerin Krotowa ausgerastet - und hat ihrem Mann mit der Holzaxt ein Bein abgehackt.“"
