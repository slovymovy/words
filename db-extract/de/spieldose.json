                                "target_senses": [
                                    {
                                        "sense_id": "c53392f6-04ac-313a-ae61-cb7a9dc2e0f0",
                                        "entry_id": "e3d04161-23cc-3b90-9b62-127bb99e5643",
                                        "glosses": [
                                            "automatische muziek instrument"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebcdf8e2-ce24-49c9-a0d9-dadc3a318f3c",
                                                "sense_id": "c53392f6-04ac-313a-ae61-cb7a9dc2e0f0",
                                                "text": "Ieder uur vindt er een vaderdag rondleiding plaats in Museum Speelklok. ,,Luister en geniet van de mooiste, vrolijkste en stoerste liedjes op de straatorgels en draaiorgels\", zo meldt het museum op haar website. Vaders worden uitgedaagd om de spieren te laten rollen bij een groot draaiorgel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "860c6502-34b4-398e-8004-8e4a0704da69",
                                        "entry_id": "e3d04161-23cc-3b90-9b62-127bb99e5643",
                                        "glosses": [
                                            "klok waarop men kan aflezen hoelang er nog gespeeld moet worden in een sport wedstrijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37bb7562-3e19-4434-928f-a51e25e0a7ad",
                                                "sense_id": "860c6502-34b4-398e-8004-8e4a0704da69",
                                                "text": "Met nog een halve minuut op de speelklok verdedigde Het Ravijn in de laatste periode een minieme voorsprong van 6-5. De aanval van Amersfoort werd onschadelijk gemaakt, waardoor zondagmiddag in Amersfoort de beslissing valt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
