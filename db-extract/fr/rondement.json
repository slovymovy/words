                                                "text": "Ik snel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66dfa040-0876-37f8-a841-a608028a9012",
                                        "entry_id": "ca2ad043-ae3b-31af-ac0d-d1324da1fcef",
