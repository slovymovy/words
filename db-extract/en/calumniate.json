                    }
                ],
                "senses": [
                    {
                        "sense_id": "057141c0-5afa-36da-91dd-fbbeae066694",
                        "entry_id": "1c0a3747-a09b-3d4c-803e-e047903b56d4",
                        "glosses": [
                            "To make hurtful untrue comments about."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bc00dcd-5719-4fb7-a977-a4bc705ceef2",
                                "sense_id": "057141c0-5afa-36da-91dd-fbbeae066694",
                                "text": "Hatred unto the truth did always falsely report and calumniate all godly men's doings."
                            },
                            {
                                "example_id": "e515d405-1634-40d5-9399-1b8ac431123e",
                                "sense_id": "057141c0-5afa-36da-91dd-fbbeae066694",
                                "text": "I missed her when she was not on the stage, in spite of the absorbing interest of that most calumniated and ill-used person, the Jew. (Speaking of Fanny Kemble as Portia)"
                            },
                            {
                                "example_id": "df7c9fcf-fd73-46f7-9dce-946263c36c27",
                                "sense_id": "057141c0-5afa-36da-91dd-fbbeae066694",
                                "text": "There are adherents of each of the four French parties—Legitimists, Orleanists, Imperialists, and Republicans—in this little mountain-town; and they all hate, loathe, decry, and calumniate each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f24383f-aa0d-376a-bcde-961369787710",
                        "entry_id": "1c0a3747-a09b-3d4c-803e-e047903b56d4",
                        "glosses": [
                            "To levy a false charge against, especially of a vague offense, with the intent to damage someone's reputation or standing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91233b97-fc25-4649-832c-a91307980a91",
                        "source_entry_id": "1c0a3747-a09b-3d4c-803e-e047903b56d4",
                        "source_sense_description": "to make hurtful untrue statements",
                        "target_lang_word": "calomnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calomnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Attaquer, blesser quelqu’un par des calomnies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559b23af-7710-455f-86dd-2229b57a89ac",
                                                "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                                "text": "Il aurait été exclu du groupe de Tiflis pour en avoir calomnié certains membres afin d'acquérir lui-même plus d'autorité."
                                            },
                                            {
                                                "example_id": "89e14aaf-658d-4d3f-8019-15f6514ba459",
                                                "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                                "text": "Qu’il avoue avoir calomnié la comtesse Ludwig de Godesberg, et je le laisse libre d’aller faire pénitence où il voudra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Critiquer en mal, en parlant des actions, des intentions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb67760f-816e-4232-a4e9-db78fce5e89d",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Si les pièces qu'on y insère n'ont pas toutes le même mérite, au moins est-on sûr de n'y jamais rencontrer de ces fades et plattes rimailles qui, tant de fois on servi de prétexte à calomnier la Poésie."
                                            },
                                            {
                                                "example_id": "9d230c0d-8283-4169-883d-c734a33c8393",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Haï, Épicure le fut et le sera parce qu'il est un des héros de l'humanité. […]. Et si, à sa suite, l'ensemble de l’épicurisme fut maudit, et calomnié comme libertinage dévergondé, c'est parce qu'il guérit de la peur dont tout pouvoir, religieux ou politique, a besoin !"
                                            },
                                            {
                                                "example_id": "9e8b909b-935a-4979-8b9e-5172bb52eeaa",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Se plaire à mentir et à calomnier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95815abe-792a-3171-ba39-85ae3e2d7681",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Dégrader, déqualifier la perception, ne pas rendre honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8cf789-e19f-468f-af86-fb2716815801",
                                                "sense_id": "95815abe-792a-3171-ba39-85ae3e2d7681",
                                                "text": "Puis l’idée me vint que cet homme était vêtu de cotonnade bleue, alors qu’un sauvage eût été nu, et d’après ce que j’essayai de me persuader qu’il était probablement d’un caractère très pacifique et que la morne férocité de son aspect le calomniait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58fc32e8-4555-4a25-ad7f-adb63b18738c",
                        "source_entry_id": "1c0a3747-a09b-3d4c-803e-e047903b56d4",
                        "source_sense_description": "to make hurtful untrue statements",
                        "target_lang_word": "verleumden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verleumden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90d915d8-9be8-3989-9c92-b5b68cf2db3c",
                                        "entry_id": "b6978c75-d76e-3db2-98c3-8a2c1aa25468",
                                        "glosses": [
                                            "eine unwahre (oder nicht zu beweisende) Behauptung über etwas oder eine andere Person verbreiten, die dessen oder deren Ansehen schadet"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "112054c5-d29e-4944-9676-2e3984663cf7",
                                                "sense_id": "90d915d8-9be8-3989-9c92-b5b68cf2db3c",
                                                "text": "„Jemand mußte Josef K. verleumdet haben, denn ohne daß er etwas Böses getan hätte, wurde er eines Morgens verhaftet.“"
                                            },
                                            {
                                                "example_id": "4917ba46-33a0-4662-8f96-197822ee0757",
                                                "sense_id": "90d915d8-9be8-3989-9c92-b5b68cf2db3c",
                                                "text": "„Dem gewöhnlichen Menschenverstande nach wird jemand verleumdet, wenn man ihn erdichteter Tatsachen bezichtigt; aber im außergewöhnlichen Verstand des Strafgesetzbuchs wird er verleumdet, wenn man ihm wirkliche Tatsachen vorwirft, Tatsachen, die bewiesen werden können, aber nur nicht auf eine exzeptionelle Art, nur nicht durch ein Urteil, durch eine amtliche Urkunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
