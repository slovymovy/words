                        "sense_id": "197640c1-f489-3191-bca9-328547e0017f",
                        "entry_id": "ca5b90a8-c8dd-3188-92ed-4cb0befae001",
                        "glosses": [
                            "A nation defined by or as seen through a shared culture, as opposed to other traits."
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "241e6b82-0f36-4b30-b76e-1740dd9ba724",
                                "sense_id": "197640c1-f489-3191-bca9-328547e0017f",
                                "text": "Und manche Intellektuelle hielten in West und Ost trotzig an der gemeinsamen Kulturnation fest – gegen die staatliche und ideologische Spaltung.",
                                "translation": "And many intellectuals in West and East [Germany] held defiantly on to the common cultural nation – against state and ideological division.",
                                "english": "And many intellectuals in West and East [Germany] held defiantly on to the common cultural nation – against state and ideological division."
                            }
                        ]
                    }
                ],
