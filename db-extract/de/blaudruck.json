                ],
                "senses": [
                    {
                        "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                        "entry_id": "91d3c7e0-603c-3a24-80f4-8338abd9b5e5",
                        "glosses": [
                            "Druckverfahren (ohne Plural), bei der eine weiße und blaue Musterung auf einem Stoff hergestellt wird, Ergebnis dieses Druckverfahrens"
                        ],
                        "tags": [
                            "auch (mit Plural)"
                        ],
                        "examples": [
                            {
                                "example_id": "0e5f32ac-03e7-4165-ab39-c7df62be9727",
                                "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                                "text": "„Die Cyanotypie wird auch Blaudruck genannt und ist ein fotografisches Verfahren, das auf der fotochemischen Bildung von «Berliner Blau» beruht.“"
                            },
                            {
                                "example_id": "25811f2b-f42e-44c5-a98c-681f2ee783fe",
                                "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                                "text": "„Darüber hinaus werden Kurse angeboten, bei denen man mehr über den Blaudruck erfährt und lernt, wie man mit Indigo, Papp und Modeln richtig umgeht.“"
                            },
                            {
                                "example_id": "25111329-bbea-49f9-9bda-ab3a5c071353",
                                "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                                "text": "„Die Frauenspersonen tragen an Werktagen im Sommer Kleider aus Baumwollenstoffen und Blaudruck und Pares und Zeugen.“"
                            },
                            {
                                "example_id": "389c8691-4280-4e85-86d1-850bea8a707f",
                                "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                                "text": "„Am Mittwoch hatte der Ausschuss beschlossen, den Blaudruck - eine auch in Deutschland verwendete jahrhundertealte Technik der Textilveredelung - aufzunehmen.“"
                            },
                            {
                                "example_id": "b56e810d-f874-4252-8a82-00d30638088b",
                                "sense_id": "ff68570b-bec5-3055-9911-bff38c534e6f",
                                "text": "Dieser Stoff ist sehr geeignet, um ihn für Blaudrucke zu nutzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
