        "fr-extract.jsonl": [
            {
                "entry_id": "69e88796-9fa5-3a52-9678-1ba71b749340",
                "word": "évolutionniste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d407889-6903-4f03-8853-5d0e05342631",
                        "entry_id": "69e88796-9fa5-3a52-9678-1ba71b749340",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "évolutionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c278df7-9295-36ee-b74a-d52aafbe4d88",
                        "entry_id": "69e88796-9fa5-3a52-9678-1ba71b749340",
                        "glosses": [
                            "Qui envisage la société comme en constante évolution par nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7503c0-c3b8-4792-bc48-a19964392bf4",
                                "sense_id": "2c278df7-9295-36ee-b74a-d52aafbe4d88",
                                "text": "De là il concluait à la nécessité de baser la politique et la propagande socialistes sur une conception plus évolutionniste de la société moderne."
                            },
                            {
                                "example_id": "9c3df12e-afe4-4c2e-a54d-1eb9f9ccd15d",
                                "sense_id": "2c278df7-9295-36ee-b74a-d52aafbe4d88",
                                "text": "Un courant soviétologique plus spécifiquement politologique met l'accent sur des processus de changement politique sui generis qui semblent indiquer une orientation évolutionniste incompatible avec les postulats des théories de la modernisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "09cd2020-0a58-3516-8159-f0874c4ddd6c",
                        "entry_id": "69e88796-9fa5-3a52-9678-1ba71b749340",
                        "glosses": [
                            "Qui renvoie à la théorie de l’évolution de Charles Darwin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dae8c2c-5813-4ec6-a47f-0eeb24222c1d",
                                "sense_id": "09cd2020-0a58-3516-8159-f0874c4ddd6c",
                                "text": "Et pourquoi l’approche évolutionniste serait-elle scientifique lorsqu’elle est appliquée à l’ensemble des espèces vivantes et non scientifique lorsqu’elle est appliquée au primate humain ?"
                            },
                            {
                                "example_id": "7253579d-58f8-4371-bcf4-6b4c9bf9434a",
                                "sense_id": "09cd2020-0a58-3516-8159-f0874c4ddd6c",
                                "text": "Octave Pirmez n'a pu prévoir Telhard de Chardin, ni le moment où les esprits les plus avancés à l'intérieur de l'Église se rallieraient à la thèse évolutionniste au moment où celle-ci cesserait d'être pour la science un dogme monolithique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad14de69-c7ef-417c-af2f-1403bc0f27f9",
                        "source_entry_id": "69e88796-9fa5-3a52-9678-1ba71b749340",
                        "target_lang_word": "evolutionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evolutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db13ae4-f80c-37ea-b5c5-3bb36d054af3",
                                        "entry_id": "eff1b340-a745-306e-95de-7fcf76e0e37f",
                                        "glosses": [
                                            "Of or relating to the biological theory of evolution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca65c389-4e7b-4cb8-b98f-d930cc3b39ff",
                                                "sense_id": "5db13ae4-f80c-37ea-b5c5-3bb36d054af3",
                                                "text": "The evolutionary history of marine mammals includes land-dwelling ancestors."
                                            },
                                            {
                                                "example_id": "9333ad17-9611-4dc5-9088-f091071fbe2f",
                                                "sense_id": "5db13ae4-f80c-37ea-b5c5-3bb36d054af3",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cae27ca-93be-3005-a861-7d86c7c1b5f6",
                                        "entry_id": "eff1b340-a745-306e-95de-7fcf76e0e37f",
                                        "glosses": [
                                            "Having formal similarities to the biological theory of evolution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f6497f-21ad-4324-92cf-01517e8fbe72",
                                                "sense_id": "3cae27ca-93be-3005-a861-7d86c7c1b5f6",
                                                "text": "The basic elements of an evolutionary growth theory are discussed in Section II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
