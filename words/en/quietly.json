                                "zh": "请<w>轻声</w>说话，以免打扰其他同学。"
                            }
                        },
                        {
                            "text": "He closed the door <w>quietly</w> to avoid waking the baby.",
                            "target_lang_translations": {
                                "ru": "Он <w>тихо</w> закрыл дверь, чтобы не разбудить ребёнка.",
                                "zh": "他<w>悄悄地</w>关上了门，以免吵醒婴儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "softly",
                        "silently"
                    ],
                    "antonyms": [
                        "loudly"
                    ],
                    "common_phrases": [
