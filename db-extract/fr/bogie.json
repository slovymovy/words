                                    {
                                        "sense_id": "7279ac22-8978-3451-a7f1-1e0dee35461d",
                                        "entry_id": "e0b707bc-fec5-3081-a7b8-0e9f954dcb1b",
                                        "glosses": [
                                            "Alternative spelling of bogey.",
                                            "A piece of dried mucus in or removed from the nostril."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef8390dd-f146-4363-899d-22a6b7609811",
                                                "sense_id": "7279ac22-8978-3451-a7f1-1e0dee35461d",
                                                "text": "Reluctantly Raj used his fingernail to prise away the bogie he had long since sneezed up there and popped it in his mouth."
                                            }
                                        ]
