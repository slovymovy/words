                "senses": [
                    {
                        "sense_id": "519bd801-814f-301e-8396-1cad784aa658",
                        "entry_id": "355c015f-60c7-3bd0-a5d9-2b0f68c1b0bb",
                        "glosses": [
                            "Handlung, welche die zentrale Binnenerzählung umschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b89154f1-3b04-494c-af46-519c9dc04150",
                                "sense_id": "519bd801-814f-301e-8396-1cad784aa658",
                                "text": "„Doch anders als in anderen Krimis bildet die Aufklärung der Umstände, die zum Tod geführt haben, nur die Rahmenhandlung der Geschichte.“"
                            },
                            {
                                "example_id": "24f7eb59-3029-459e-9d39-f204878875c6",
                                "sense_id": "519bd801-814f-301e-8396-1cad784aa658",
                                "text": "„Die Rahmenhandlung wird, wie in E. T. A. Hoffmanns Geschichtensammlung ‚Die Serapions-Brüder‘ (1819/21), von einer munteren Stammtisch-Runde getragen: Im \"tent\", einem Berliner Szene-Lokal, trifft der Biochemiker Eduard, ein Virus- und Weiber-Jäger mittleren Alters, regelmäßig zwei Männerfreunde, mit denen er sich betrinkt und die neuesten Leibeserfahrungen austauscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
