            {
                "entry_id": "f286b0f3-7d19-37a7-918a-237e50144f8f",
                "word": "tape-à-l’œil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                        "entry_id": "f286b0f3-7d19-37a7-918a-237e50144f8f",
                        "glosses": [
                            "Apparence éblouissante mais trompeuse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "85f01ee8-b056-40eb-9830-9bd006b6bb6e",
                                "sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                                "text": "C’est du tape-à-l’œil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63987568-10ff-4713-bbba-3b25b7d6cb2f",
                        "source_entry_id": "f286b0f3-7d19-37a7-918a-237e50144f8f",
                        "source_sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                        "target_lang_word": "Kitsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kitsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                        "entry_id": "18dce870-9e08-3678-b20f-8430904c92ca",
                                        "glosses": [
                                            "Objekt der Kunst, Musik oder Literatur, welches als klischeehaft und geschmacklos angesehen wird und keinen künstlerischen Wert hat"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1fcf1e-807f-4016-9149-d8a2e485a148",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "Bei dem Film hat der Regisseur keine Angst vor großer Emotion und vor einem Pathos, das vom Absturz in den bodenlosen Kitsch nur eine Handbreit entfernt ist."
                                            },
                                            {
                                                "example_id": "28dbda91-d4a8-4811-ab83-b39b9b45928e",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "„Der Begriff scheint Ende des vergangenen Jahrhunderts erstmals im Münchener Kunsthandel aufgetaucht und schon von Anfang an pejorativ im Gegensatz zur echten Kunst verwandt worden zu sein. Kitsch als Antipode der Kunst, als mißratener Nachkömmling, der aber dennoch glänzend zu verkaufen war. Kitsch transportiert Gefühle, er ist deshalb nicht formaläst[h]etisch zu beschreiben, sondern bestimmt sich vom Betrachter bzw. Benutzer her.“"
                                            },
                                            {
                                                "example_id": "eb47bb45-b60c-4eea-8191-59da81fef1fb",
                                                "sense_id": "55840da6-1104-3085-8203-e9e9581a177c",
                                                "text": "„Er wollte seinen Lesern einen Traum geben, in den sie sich flüchten konnten, was im Grunde schon wieder zu aufrichtig ist, um als Kitsch abgestempelt zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2058470-16e1-4268-9417-89ac1dc43707",
                        "source_entry_id": "f286b0f3-7d19-37a7-918a-237e50144f8f",
                        "source_sense_id": "cb09d4c8-b783-3114-8ec9-9f03ba5656a8",
                        "target_lang_word": "dikdoenerij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dikdoenerij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                        "entry_id": "3f11c222-ac6a-3272-95d3-d27d893ab36e",
                                        "glosses": [
                                            "op een manier praten of handelen waarbij je jezelf belangrijker voordoet dan je eigenlijk bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d1b525-e479-449b-bc11-4cf2fe6d773d",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "Het is Bouwmeester ten voeten uit. Ze zit het liefst op het water in haar bootje, ver weg van alle drukte en dikdoenerij. Trainen, racen, wedstrijden winnen. 'Ik wil de wereld domineren', zo luidt haar motto."
                                            },
                                            {
                                                "example_id": "76f7ff1c-0caf-4e0b-95b5-878ad981c5c1",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "De Venezolaanse president insinueert al langer dat de VS van plan zijn hem uit zijn macht te ontzetten, maar tot dusver gingen zijn beschuldigingen niet verder dan de gebruikelijke grootspraak en dikdoenerij."
                                            },
                                            {
                                                "example_id": "32701a79-8574-454f-a29a-57c08495d5d2",
                                                "sense_id": "f4d0630f-ab8a-3669-a0cf-be97f0e95970",
                                                "text": "Parra, die zichzelf een ’antipoëet’ noemde om afstand te nemen van literaire dikdoenerij, geldt als een van de belangrijkste dichters van de 20e eeuw in Zuid-Amerika."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
