                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18677c4b-0b68-4b3d-a65d-caa891bd7f3a",
                                "sense_id": "83f4646c-8475-3ab9-a27e-d7044ebfaefb",
                                "text": "Вытребованный окулист констатировал весьма серьезное поранение зрачка, заставляющее опасаться за целостность зрения."
                            }
                        ]
                    },
