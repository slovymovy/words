                "senses": [
                    {
                        "sense_id": "fef45109-7959-3a3d-bd66-13a458b08280",
                        "entry_id": "b0fd0518-1d84-3a9a-8d7b-55c617a8c590",
                        "glosses": [
                            "Kenntnis, die jemand durch wiederholte Praxis in einer Führungsposition bekommt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "8da778ea-15b4-4a47-b2fe-135b434eecd5",
                                "sense_id": "fef45109-7959-3a3d-bd66-13a458b08280",
                                "text": "„In der fachlichen Eignung seien die Bewerber im Wesentlichen gleich, ausschlaggebend seien Führungserfahrung und Führungskompetenz, die beim Beigeladenen am stärksten ausgeprägt seien.“"
                            },
                            {
                                "example_id": "eeec450a-65ac-43c5-acd7-e27dcc04886a",
                                "sense_id": "fef45109-7959-3a3d-bd66-13a458b08280",
                                "text": "„Die Wirtschaftspsychologen Uwe Peter Kanning und Philipp Fricke haben herausgefunden, dass Führungserfahrung offensichtlich unwichtig ist.“"
                            },
                            {
                                "example_id": "6fa5868a-071a-4be5-88bc-7dd71365ff07",
                                "sense_id": "fef45109-7959-3a3d-bd66-13a458b08280",
                                "text": "„Handelt es sich um eine Führungsfunktion ab A 15 bzw. BAT I a wird daneben noch eine dreijährige Führungserfahrung erwartet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14c420bd-91f9-3de9-8faa-3dd7ab52741f",
                        "entry_id": "b0fd0518-1d84-3a9a-8d7b-55c617a8c590",
                        "glosses": [
                            "belehrendes Erlebnis, das Erkenntnisse zu einer Sache einbringt wenn man Personal führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33bcc33-7afe-42aa-a4ba-e2dd849b356f",
                                "sense_id": "14c420bd-91f9-3de9-8faa-3dd7ab52741f",
                                "text": "„Wir ermöglichen es Führungskräften, sich auf Augenhöhe mit Gleichrangigen auszutauschen und von deren Führungserfahrungen zu profitieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
