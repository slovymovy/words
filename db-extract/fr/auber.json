                        "examples": [
                            {
                                "example_id": "cdbedc2e-6e17-4f54-8428-07c6aee54f61",
                                "sense_id": "0bb45d58-99f8-3305-959f-b9a7d2e7337e",
                                "text": "Son teint me redevient connu, Et, sur son front tout au baptême, Aube déjà l’air ingénu !"
                            },
                            {
                                "example_id": "7d5b4ea2-e777-494c-999c-2541e2d1c23d",
                                "sense_id": "0bb45d58-99f8-3305-959f-b9a7d2e7337e",
                                "text": "Je scrute la musique qui aube en stase de tout côté, frisant friande les amants de métal, notre chair acculée."
                            }
                        ]
