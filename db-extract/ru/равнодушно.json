                        "cross_references": [
                            {
                                "target_word": "indifferently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "356c24e6-1c71-3524-b749-7df174d87849",
                                        "entry_id": "5573add8-0fff-3616-9380-979a49eba749",
                                        "glosses": [
                                            "In an indifferent manner.",
                                            "Tolerably; passably."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0f02f9e-f4cf-3584-bb03-7e8663fb7bfa",
                                        "entry_id": "5573add8-0fff-3616-9380-979a49eba749",
                                        "glosses": [
                                            "In an indifferent manner.",
                                            "Without distinction; impartially, objectively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781d666e-852c-41fc-a576-971fc6b898b9",
                                                "sense_id": "f0f02f9e-f4cf-3584-bb03-7e8663fb7bfa",
                                                "text": "Uiew wel my Camp, and ſpeake indifferently,\nDoo not my captaines and my ſouldiers looke\nAs if they meant to conquer Affrica?"
                                            },
                                            {
                                                "example_id": "438206f5-101a-47c3-b184-e08d7670a864",
                                                "sense_id": "f0f02f9e-f4cf-3584-bb03-7e8663fb7bfa",
                                                "text": "And make diuiſion equally,\nOf each mans goods indifferently, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65dfc1f8-8ad8-3c93-9868-53b27665327c",
                                        "entry_id": "5573add8-0fff-3616-9380-979a49eba749",
                                        "glosses": [
                                            "In an indifferent manner.",
                                            "Without great care; without sufficient attention or thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419fd592-48a9-40b0-a022-00c022b6c970",
                                                "sense_id": "65dfc1f8-8ad8-3c93-9868-53b27665327c",
                                                "text": "They might have been lifted bodily out of an indifferently written American crime novel."
                                            },
                                            {
                                                "example_id": "7b28eb28-85f4-4760-a4f0-5d941f76ed9d",
                                                "sense_id": "65dfc1f8-8ad8-3c93-9868-53b27665327c",
                                                "text": "For the first ten years of nationalisation a further note of overall gloom was added by the depressing policy of unimaginative Regional colour schemes, indifferently applied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6e898d6-ba77-4405-b5a2-1a2af9002fe8",
                        "source_entry_id": "3d13a423-0ea4-35b8-af08-6754d303810b",
                        "source_sense_id": "a94a57f3-8ea4-30f8-8ece-23e29f494180",
