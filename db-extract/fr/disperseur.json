                        "examples": [
                            {
                                "example_id": "9ef2475f-5f71-48b8-8124-62d208927320",
                                "sense_id": "e3cf67a0-f9ec-3598-9293-1fbf1e70e66b",
                                "text": "Le disperseur est un agitateur industriel qui permet la dispersion de la poudre quand la fonction de dissolution n'est pas suffisante."
                            },
                            {
                                "example_id": "9ff8083f-038d-4d28-a570-58f89440049d",
                                "sense_id": "e3cf67a0-f9ec-3598-9293-1fbf1e70e66b",
                                "text": "Le disperseur de poudres de Clemex est un dispositif automatisé pour la dispersion de poudres sèches."
                            },
                            {
                                "example_id": "0c14d360-afd4-4a8e-8840-9248c5f4dd5f",
                                "sense_id": "e3cf67a0-f9ec-3598-9293-1fbf1e70e66b",
                                "text": "CEFA a repris la maîtrise du porteur du disperseur de mines antichars courte portée."
                            },
                            {
                                "example_id": "5ff86643-372d-4ba8-a9e5-dfbee8ee0277",
                                "sense_id": "e3cf67a0-f9ec-3598-9293-1fbf1e70e66b",
                                "text": "La présence d’un broyeur et un disperseur de paille sur les moissonneuses batteuses est indispensable."
