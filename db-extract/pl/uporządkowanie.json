                                "target_senses": [
                                    {
                                        "sense_id": "374b4d27-e3af-3cec-8801-ab12e9d472a3",
                                        "entry_id": "fb18e5cf-fd0e-3b63-9026-83eb44b07c7f",
                                        "glosses": [
                                            "Alternative form of systematization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08429586-4f59-423d-bc7d-c41a9c291520",
                                                "sense_id": "374b4d27-e3af-3cec-8801-ab12e9d472a3",
                                                "text": "With the exception of the Great Eastern Line, these embody the most complete systematisation of steam or diesel-operated main line services that has yet taken place in the country."
                                            },
                                            {
                                                "example_id": "36609251-5c27-409d-a65d-a05b3cd207b9",
                                                "sense_id": "374b4d27-e3af-3cec-8801-ab12e9d472a3",
                                                "text": "The abundance and original nature of the specimens prompted us to undertake a deep survey of both morphological and molecular traits aiming at a reliable systematisation of the new taxon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
