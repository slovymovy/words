                                                "sense_id": "ff910f2e-e329-3179-b7f3-400aea2e951b",
                                                "text": "„Der Nationalspieler laboriert an einer Reizung der linken Patellasehne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
