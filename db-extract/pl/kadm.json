                                        "entry_id": "57ae6259-9c07-3bef-ac7f-05cb1bc01f3e",
                                        "glosses": [
                                            "scheikundig element met symbool Cd en atoomnummer 48. Het is een zilvergrijs overgangsmetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe6b1bba-3985-4251-8c2b-4c40006b5dfb",
                                                "sense_id": "fb84a9f0-1e8c-3a64-9d29-5cf9d38bae3d",
                                                "text": "Op een lege pagina in het trail-register begon ik te schilderen. Mijn zus had me twee kleine blokjes waterverf meegegeven, indigo blauw en cadmium geel."
                                            }
                                        ]
                                    }
                                ]
