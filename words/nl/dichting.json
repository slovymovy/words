            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dfc5ba64-d23e-3d17-bc27-e89a163142b3",
                    "sense_definition": "Materiaal of onderdeel dat een opening of naad afsluit om lekkage van vloeistoffen of gassen te voorkomen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur verving de rubberen <w>dichting</w> van de wasmachine om de lekkage te stoppen.",
                            "target_lang_translations": {
                                "en": "The mechanic replaced the washing machine's rubber <w>seal</w> to stop the leak.",
                                "ru": "Мастер заменил резиновую <w>прокладку</w> стиральной машины, чтобы устранить протечку."
                            }
                        },
                        {
                            "text": "Door een versleten <w>dichting</w> ontsnapte er langzaam gas uit de leiding.",
                            "target_lang_translations": {
                                "en": "Due to a worn <w>gasket</w>, gas was slowly escaping from the pipe.",
                                "ru": "Из-за изношенного <w>уплотнения</w> из трубы медленно выходил газ."
                            }
                        }
                    ],
                    "synonyms": [
                        "afsluiting",
                        "sluiting"
                    ],
                    "common_phrases": [
                        "rubberen dichting"
                    ],
                    "target_lang_definitions": {
                        "en": "Material or component that closes an opening or joint to prevent leakage of fluids or gases.",
                        "ru": "Материал или деталь, герметично закрывающая отверстие или стык для предотвращения утечки жидкостей или газов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seal",
                                "target_lang_sense_clarification": "component or material preventing leakage"
                            },
                            {
                                "target_lang_word": "gasket",
                                "target_lang_sense_clarification": "mechanical seal between flat surfaces"
                            },
                            {
                                "target_lang_word": "packing",
                                "target_lang_sense_clarification": "filling material used to prevent leakage around pistons or shafts"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "прокладка",
                                "target_lang_sense_clarification": "уплотнительная деталь"
                            },
                            {
                                "target_lang_word": "уплотнение",
                                "target_lang_sense_clarification": "деталь или материал для герметизации"
                            },
                            {
                                "target_lang_word": "герметизация",
                                "target_lang_sense_clarification": "процесс или средство изоляции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a13c3716-d14e-31cf-9af1-1013bf8cfba5",
                    "sense_definition": "Iets wat verzonnen is; een product van de fantasie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fantasie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat hele verhaal over zijn adellijke afkomst bleek louter een <w>dichting</w> te zijn.",
                            "target_lang_translations": {
                                "en": "That whole story about his noble origins turned out to be pure <w>fabrication</w>.",
                                "ru": "Вся эта история о его дворянском происхождении оказалась чистым <w>вымыслом</w>."
                            }
                        },
                        {
                            "text": "Men wist niet of het historische feit betrof of slechts een literaire <w>dichting</w>.",
                            "target_lang_translations": {
                                "en": "People did not know whether it concerned historical fact or merely a literary <w>fiction</w>.",
                                "ru": "Никто не знал, идёт ли речь об историческом факте или всего лишь о литературном <w>вымысле</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "weinig gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something invented or fabricated; a product of the imagination.",
                        "ru": "Нечто придуманное; плод фантазии или воображения (устаревшее)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fiction",
                                "target_lang_sense_clarification": "fabricated story or product of imagination"
                            },
                            {
                                "target_lang_word": "fabrication",
