                    {
                        "sense_id": "b1b4fd74-5e05-32e2-81d5-b2b6db08ec95",
                        "entry_id": "b284bbf5-e28f-3b80-a8ca-7112bdca493a",
                        "glosses": [
                            "een lijst met wachtenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658a87b5-6949-4d38-b840-d3f3a1e770b1",
                                "sense_id": "b1b4fd74-5e05-32e2-81d5-b2b6db08ec95",
                                "text": "Wachtlijsten in de zorg zijn al jaren een probleem voor patiënten."
                            },
                            {
                                "example_id": "dbabcbcc-2d4e-4954-9841-bdc7c53eb090",
                                "sense_id": "b1b4fd74-5e05-32e2-81d5-b2b6db08ec95",
                                "text": "Ze adviseerde me direct mijn naam op de douchelijst te zetten omdat er al 25 mensen op de wachtlijst stonden."
                            },
                            {
                                "example_id": "33189d27-5c62-48fb-8440-45a9c126949c",
                                "sense_id": "b1b4fd74-5e05-32e2-81d5-b2b6db08ec95",
                                "text": "„De mensen hebben blijkbaar weer zin in een feestje...”, weet woordvoerder Rik van de Merwe. Zijn feest - Bevrijdingsdag Enschede op de Universiteit Twente - is deze donderdag met 15.000 bezoekers stijf uitverkocht. De wachtlijst loopt zelfs al flink op. Een alternatief is te vinden in Het Volkspark."
                            }
                        ]
                    }
