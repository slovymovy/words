                    {
                        "sense_id": "29f39142-aa81-3cb9-a1ba-543a57dbe97a",
                        "entry_id": "7c0c1882-d59a-34bd-82a0-0a33d63df0a5",
                        "glosses": [
                            "Initialism of Antideficiency Act."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "aba1ebfa-0603-4fd4-8ccc-7ca6f37551f4",
                                "sense_id": "29f39142-aa81-3cb9-a1ba-543a57dbe97a",
                                "text": "This information supplements (and should be read with) general guidance issued by the Office of Management and Budget (OMB) and the Office of Personnel Management (OPM) for administering an agency shutdown of operations due to a lapse in appropriations, consistent with the Antideficiency Act (ADA) (31 U.S.C. 1341-1342) and the pay, leave, and other relevant statutory authorities that apply to lapse-affected employees. […] “Excepted employees” may perform activities legally permitted as an exception to the ADA’s prohibitions on performing work during a lapse in appropriations, but may not be paid for that work until after the lapse is over."
                            }
                        ]
                    }
