                ],
                "senses": [
                    {
                        "sense_id": "d43c2da3-74ee-3579-bf47-5a2a7dd31ca0",
                        "entry_id": "1d99e456-3505-3e95-b6f1-41db74eaf7fd",
                        "glosses": [
                            "zoals in een spreekwoord genoemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73cfc41-4f7b-4f5e-ac6f-3262723733fe",
                                "sense_id": "d43c2da3-74ee-3579-bf47-5a2a7dd31ca0",
                                "text": "Creatieve personen zijn vaker risicozoekers en nieuwszoekers. Er is een welhaast spreekwoordelijk verband tussen extreme creativiteit en psychiatrische kwetsbaarheid, hoewel de publicaties hierover nogal eens methodologische vraagtekens opwerpen."
                            },
                            {
                                "example_id": "efbc8648-aee4-4077-acbb-4bcf3673aef2",
                                "sense_id": "d43c2da3-74ee-3579-bf47-5a2a7dd31ca0",
                                "text": "Frieda moest wél leren, haar geheugen was minder goed dan dat van haar zus, maar ze werkte bijna nooit. Ze was een spreekwoordelijke ondeugd, was snel afgeleid en vond alle meisjes in haar klas spannend en leuk."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c1461e5-23eb-3e33-951a-82d9fb47140a",
                        "entry_id": "1d99e456-3505-3e95-b6f1-41db74eaf7fd",
                        "glosses": [
                            "niet de letterlijke maar de figuurlijke betekenis betreffende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b96a215-4788-4a64-9689-0549903deee8",
                                "sense_id": "1c1461e5-23eb-3e33-951a-82d9fb47140a",
                                "text": "De kalender van 2018 is volledig gewijd aan 150 jaar Stork. Met twaalf prachtige foto's uit de spreekwoordelijke oude doos, per maand een. Zwart-wit uiteraard. Onder andere van een klas van de Wilhelminaschool uit 1912, het Vereenigingsgebouw en het Tuindorpbad. Maar vooral natuurlijk van het bedrijf zelf. Zoals bijgaande foto van de draaierij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a87b6b3-fd71-4596-86e9-eaee74f80014",
                        "source_entry_id": "1d99e456-3505-3e95-b6f1-41db74eaf7fd",
                        "source_sense_id": "d43c2da3-74ee-3579-bf47-5a2a7dd31ca0",
                        "source_sense_description": "volgens het spreekwoord",
                        "target_lang_word": "sprichwörtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprichwörtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd9e5cc1-c49a-3f14-8da0-a49de1d75d65",
                                        "entry_id": "0c39e004-ed04-3d37-a62b-5b5b24346dae",
                                        "glosses": [
                                            "in einer feststehenden Floskel verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "210dcaa0-784f-4508-8ac1-5bc6c1610241",
                                                "sense_id": "bd9e5cc1-c49a-3f14-8da0-a49de1d75d65",
                                                "text": "„Die einzige Ausnahme stellt ein Zitat aus Menander in 1Kor 15,33 dar, das allerdings zu dieser Zeit schon lange sprichwörtlich verwendet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4c545cf-8289-3387-aa07-d3a1578ae043",
                                        "entry_id": "0c39e004-ed04-3d37-a62b-5b5b24346dae",
                                        "glosses": [
                                            "als geradezu typisch angesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad5fb54-cd2e-438e-8066-1fd554191389",
                                                "sense_id": "c4c545cf-8289-3387-aa07-d3a1578ae043",
                                                "text": "„Die sprichwörtliche Liebe auf den ersten Blick wird es bei mir wohl nicht sein.“"
                                            },
                                            {
                                                "example_id": "73e560ee-2b55-45b4-8b33-6caeb1c464c4",
                                                "sense_id": "c4c545cf-8289-3387-aa07-d3a1578ae043",
                                                "text": "„Die afghanische Gastfreundschaft gilt als sprichwörtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41986243-720b-4a5e-ac6f-564ea78520c7",
                        "source_entry_id": "1d99e456-3505-3e95-b6f1-41db74eaf7fd",
                        "source_sense_id": "d43c2da3-74ee-3579-bf47-5a2a7dd31ca0",
                        "source_sense_description": "volgens het spreekwoord",
                        "target_lang_word": "proverbial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proverbial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Of, resembling, or expressed as a proverb, cliché, fable, or fairy tale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fed951a-931a-437a-897b-af7d35484931",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "The busyness of a beaver is proverbial."
                                            },
                                            {
                                                "example_id": "52425a17-eb01-4584-9eaf-0020c32a7e40",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "The beaver in this instance upheld the reputation of the proverbial one: her output was prodigious."
                                            },
                                            {
                                                "example_id": "74633683-f1c9-40a5-9c3f-63bb3dd937de",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "Doris: You're making me feel like the proverbial stepmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Optionally placed before an element of a well-known proverb or metaphor to emphasize that the element is not being used in a literal sense (see Usage notes below)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ac4928-f6de-4d5c-b14a-48df6aee009b",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "the proverbial smoking gun"
                                            },
                                            {
                                                "example_id": "be7af78b-78f0-4574-8ab2-0ba65d8737ab",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "the proverbial spilled milk"
                                            },
                                            {
                                                "example_id": "1d10cfe1-ff2b-44b4-a5a7-f86bd487d0ea",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "The visit was a warning shot across our proverbial bow"
                                            },
                                            {
                                                "example_id": "49723e52-d1d1-4619-8bbe-6b9c9b701e68",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "“We don’t like it, it’s the proverbial ‘crap sandwich’ that they talk about but what’s the best move from here and we think it’s the way to go,” said Rep. Mark Walker, chairman of the large group of fiscal conservatives known as the Republican Study Committee. […] “I think there is a growing consensus, whether it’s February or sometime, that we don’t want to be on this proverbial hamster wheel,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Widely known; famous; stereotypical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd3c75b-a2dc-4a15-a914-a44f4a5b6601",
                                                "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                                "text": "I grew up in a prefab house on Main Street in 1950s suburbia, the second and last child of a proverbial nuclear family."
                                            },
                                            {
                                                "example_id": "68aeca7a-0bdb-4caf-9d33-14b3458141af",
                                                "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                                "text": "Mr. Obama has presented himself as a fresh face, unsteeped in Washington and the proverbial “politics as usual.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proverbial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                        "entry_id": "a7bbc6ac-a5e7-3651-aa5a-9eafda10a3bb",
                                        "glosses": [
                                            "Used to replace a word that might be considered unacceptable in a particular situation, when using a well-known phrase."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd1671dc-d3b2-49a0-a0e2-8867a51b4c6c",
                                                "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                                "text": "I think we should be prepared in case the proverbial hits the fan."
                                            },
                                            {
                                                "example_id": "be2da191-bb3c-4048-8658-ca798265fbc1",
                                                "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                                "text": "Are you taking the proverbial?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49457137-affa-3449-a1f8-83515c1b5998",
                                        "entry_id": "a7bbc6ac-a5e7-3651-aa5a-9eafda10a3bb",
                                        "glosses": [
                                            "The groin or the testicles."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387fbfb0-57f0-4914-a6c1-94ceaf584c6f",
                                                "sense_id": "49457137-affa-3449-a1f8-83515c1b5998",
                                                "text": "You'll find they've got you by the proverbials."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
