                "senses": [
                    {
                        "sense_id": "75624d40-1a6d-37d1-bf9e-5d02d0200aeb",
                        "entry_id": "d565bf87-1453-30b2-8371-0ed1d683a7b5",
                        "glosses": [
                            "Alternative spelling of good-night."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "bb281666-40e8-4e2f-a354-7392aa2c4666",
                                "sense_id": "75624d40-1a6d-37d1-bf9e-5d02d0200aeb",
                                "text": "With each one goodnighted / Including the pup, / Baby is sleeping / Bottom up."
                            },
                            {
                                "example_id": "da249fdd-b98f-40ca-9880-dfbc061bda5d",
                                "sense_id": "75624d40-1a6d-37d1-bf9e-5d02d0200aeb",
                                "text": "Then he goodnighted me, I changed into pyjamas and in a trice was sleeping the sleep of the unjust, which is quite as dreamless as the sleep of the just if the unjust sleeper has a litre of Red Hackle on his bedside table."
                            },
                            {
                                "example_id": "cb61622c-ebc9-4426-aa95-4b1f79f6c1f6",
                                "sense_id": "75624d40-1a6d-37d1-bf9e-5d02d0200aeb",
                                "text": "After eight hours of intense viewing, o-o-hing, and scribbling down plant names and ideas, a spent group of participants returned to our cars, goodnighted, and went our separate ways."
                            }
                        ]
                    }
