        "nl-extract.jsonl": [
            {
                "entry_id": "76f8c801-03bd-3ead-aa9b-8e0fc7a3bbc9",
                "word": "screensaver",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ccf430ee-497a-42e4-856c-9ce2b7969a01",
                        "entry_id": "76f8c801-03bd-3ead-aa9b-8e0fc7a3bbc9",
                        "tags": [
                            "plural"
                        ],
                        "form": "screensavers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e4204e2-1b65-3b7a-b6f5-d7545b652ccd",
                        "entry_id": "76f8c801-03bd-3ead-aa9b-8e0fc7a3bbc9",
                        "glosses": [
                            "een afbeelding die zich over het beeld beweegt als de computer niet gebruikt wordt, maar niet is uitgezet, oorspronkelijk was de taak te voorkomen dat een beeld zich in de fosforlaag van het beeldscherm inbrandde"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "eaac5e5c-6b2e-444d-a83b-cc3305a4c71f",
                                "sense_id": "9e4204e2-1b65-3b7a-b6f5-d7545b652ccd",
                                "text": "Twintig jaar geleden flitsten ze op alle computers tevoorschijn als je collega’s waren gaan lunchen, maar tegenwoordig zie je ze niet meer en moeten de screensavers gered worden van de vergetelheid."
                            },
                            {
                                "example_id": "6408250a-20e1-40e9-870d-a965555802d1",
                                "sense_id": "9e4204e2-1b65-3b7a-b6f5-d7545b652ccd",
                                "text": "Voordat ik het weet, wordt gevraagd of ik al weer een tweede glas wil. Dat wil ik wel. Bij iedere slok gaan de rillingen door mijn lijf. Het feest van kleurtjes en vormpjes gaat door. 'Het lijkt een aaneenschakeling van screensavers en animated gifs', zeg ik tegen mezelf... niet heel anders dan het dagelijks leven dus' - ik ben webdesigner van beroep - en ik vind mezelf erg grappig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4614e5f1-9385-48b7-a7c6-e347b5f3e086",
                        "source_entry_id": "76f8c801-03bd-3ead-aa9b-8e0fc7a3bbc9",
                        "source_sense_id": "9e4204e2-1b65-3b7a-b6f5-d7545b652ccd",
                        "source_sense_description": "screensaver",
                        "target_lang_word": "screensaver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "screensaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffae72fb-7cde-3878-bf19-c19e99c75447",
                                        "entry_id": "1afa6a7d-ab81-3367-b982-26aab5f6a2ce",
                                        "glosses": [
                                            "A computer program that displays aesthetic patterns or images when the computer is not being used, originally intended to prevent screenburn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fef72be-39d8-47e2-9197-ed4f352644e6",
                                                "sense_id": "ffae72fb-7cde-3878-bf19-c19e99c75447",
                                                "text": "I configured my screensaver to appear after only two minutes, because I enjoyed watching it so much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                        "entry_id": "1afa6a7d-ab81-3367-b982-26aab5f6a2ce",
                                        "glosses": [
                                            "The background picture of a computer, smartphone, or similar mobile device."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab33eff-431f-45e2-a8ef-6157b137ab3d",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "But she changed her screensaver, which was a photo of Julian eating scrambled eggs—he was smiling, holding his fork away from himself, as if he were waving the eggs at her—and replaced it with a photo of Olivia, looking up from her desk […]"
                                            },
                                            {
                                                "example_id": "12de201d-0b58-4b26-8f0f-447e85d092f9",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "If he wanted praise, or sympathy, or the chance to talk over a sensitive subject, he turned to me. A friend told me that she sat down at her computer one day to discover that her husband had changed her screensaver to read: “Be nice to Lloyd."
                                            },
                                            {
                                                "example_id": "87def83c-b1b5-400f-ac54-94f02ac8376b",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "You can tell a lot about a person by the desk they keep. Her real name was Mary Stachowicz but we decided to call her Jenny Talia. It's funnier for us. She uses bulldog clips, which I think is a bit lesbiany, but I guess it's right for the character. Her screensaver is a picture of Cher, not the actual Cher, but her mother in fancy dress."
                                            },
                                            {
                                                "example_id": "c1e9dffc-d587-406a-81d5-c9d7752814c2",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "While we waited for Zac to be taken into surgery, I thought of all of his suffering up to this point […] It brought to mind the screensaver that Zac, a few months earlier, had changed his Ipod to."
                                            },
                                            {
                                                "example_id": "ae4f9f80-f855-4d2e-9fb4-685ad7afd402",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "When I arrived at the lab this morning he was back sitting in front of his computer, a million miles away, leaning forward on his elbows and staring into the depths of space. He has changed his screensaver again. The Orion nebula has been replaced with some other astronomical scape, far bleaker in its appearance but more realistic. It looks like the outermost edge of the universe."
                                            },
                                            {
                                                "example_id": "8410bc89-ed1e-454f-acf0-f4d5f0571867",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "I tiptoed over to Trent's nightstand and took his phone into the bathroom. I sat on the edge of the bathtub as I entered his code. When I saw that he'd changed his screensaver from our wedding picture to a picture of Diamond, my blood began to boil. I couldn't believe that he'd done that."
                                            },
                                            {
                                                "example_id": "667108f3-8aaf-4d30-ba10-3572934d5fdc",
                                                "sense_id": "6c41f908-af3d-3980-b9b2-0ca740e68969",
                                                "text": "She sat at the desk and opened the drawers, then looked up at the computer screen and gave a snort.\n “Sally has Alex's picture as her screensaver. Ha, you'd think she'd be worried he'd see it. […]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
