                {
                    "sense_id": "b98c3d71-490c-300b-b018-885edccfe1ae",
                    "sense_definition": "Ряд сцепленных друг с другом железнодорожных вагонов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Товарный <w>состав</w> медленно прибыл на главную станцию.",
                            "target_lang_translations": {
                                "en": "The freight <w>train</w> arrived slowly at the main station.",
                                "zh": "货运<w>列车</w>缓慢地抵达了主站。",
                                "de": "Der Güter<w>zug</w> kam langsam am Hauptbahnhof an."
                            }
                        },
                        {
                            "text": "Мы долго стояли на переезде, пропуская длинный железнодорожный <w>состав</w>.",
                            "target_lang_translations": {
                                "en": "We stood at the crossing for a long time, letting a long railway <w>train</w> pass.",
                                "zh": "我们在道口等了很久，让一列长长的铁路<w>列车</w>通过。",
                                "de": "Wir standen lange am Bahnübergang und ließen einen langen Eisenbahn<w>zug</w> passieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "поезд"
                    ],
                    "common_phrases": [
                        "подвижной состав",
                        "товарный состав",
                        "пассажирский состав"
                    ],
                    "target_lang_definitions": {
                        "en": "A number of railway carriages coupled together.",
                        "zh": "一系列相互连接的铁路车厢。",
                        "de": "Eine Reihe von miteinander gekoppelten Eisenbahnwagen."
