                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "bd55d09a-fcee-4e51-821f-5032b0033e7f",
                                "sense_id": "f23f35ee-1a22-307e-9884-f3e49c7422ac",
                                "text": "And a bit Welsh on your father's side. And a bit Irish. There's even some Chinese in there. You're a bitzer, Stevie."
                            }
                        ]
                    },
                    {
                        "sense_id": "086ca6de-ef13-3c5e-b396-1c0f4651f01b",
