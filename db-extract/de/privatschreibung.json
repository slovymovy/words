                "senses": [
                    {
                        "sense_id": "b35e5828-c292-31f2-afcc-984fddf1cc89",
                        "entry_id": "b81a76de-86c2-31ea-80e8-2c11518d8633",
                        "glosses": [
                            "von der Rechtschreibnorm abweichende Schreibweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f152af-ed82-402a-9b64-fb0073e97b7e",
                                "sense_id": "b35e5828-c292-31f2-afcc-984fddf1cc89",
                                "text": "„Das orthografische Chaos wird als »Privatschreibung« des Schülers beschönigt.“"
                            },
                            {
                                "example_id": "80d6ab2d-452c-44f1-a659-258add0b3a0f",
                                "sense_id": "b35e5828-c292-31f2-afcc-984fddf1cc89",
                                "text": "„Wenn wir den Rechtschreiblernprozess als einen qualitativen Entwicklungsprozess von einer Privatschreibung hin zur Erwachsenenschreibung betrachten, dann sind die verschiedenen Annäherungen (Privatschreibungen) der Kinder notwendige Entwicklungsschritte und sollten nicht als “falsch” markiert und als “Fehler” angesehen werden.“"
                            },
                            {
                                "example_id": "09d90bc7-4fdd-4c5f-9335-ce1a5af28371",
                                "sense_id": "b35e5828-c292-31f2-afcc-984fddf1cc89",
                                "text": "„Darum gibt es keine Fehler, sondern eben nur Privatschreibung.“"
                            },
                            {
                                "example_id": "034d86a5-a3f4-4ff9-b836-da98925b2c6b",
                                "sense_id": "b35e5828-c292-31f2-afcc-984fddf1cc89",
                                "text": "„Die Erstklässler haben das Recht auf \"Privatschreibung\", die sich teilweise sehr von der Rechtschreibung der Erwachsenen unterscheidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
