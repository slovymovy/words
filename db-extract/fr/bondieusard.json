                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5750ec89-6924-46d0-9084-1e61af6d5fae",
                        "source_entry_id": "7c3ca3c0-da28-346f-aaa5-a98d01261791",
                        "source_sense_id": "a668596f-df43-3d9d-af7e-36a917e45ecf",
