                        "sense_id": "0ff81202-494e-3747-a64c-f21df225de4f",
                        "entry_id": "3082bdb1-c335-3eb6-98af-439c2866d1a4",
                        "glosses": [
                            "dyscyplina zaliczana do sportów zimowych, polegająca na zjeżdżaniu sankami z toru sztucznego lub naturalnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd90831-52c8-486c-9c15-640d4dbfdca8",
                                "sense_id": "0ff81202-494e-3747-a64c-f21df225de4f",
                                "text": "Pierwsze mistrzostwa Polski w saneczkarstwie odbyły się w 1930 roku w Krynicy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd87af29-6e8f-4a0a-bebe-2470d6371981",
                        "source_entry_id": "3082bdb1-c335-3eb6-98af-439c2866d1a4",
                        "source_sense_id": "0ff81202-494e-3747-a64c-f21df225de4f",
                        "target_lang_word": "luge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aadc573-9c75-3294-bb87-bac8e1c7882e",
                                        "entry_id": "c3ee6324-8420-3817-af72-985b51e0a911",
                                        "glosses": [
                                            "A racing sled for one or two people that is ridden with the rider or riders lying on their back."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "227bd488-71ff-3c87-a5da-c1cbcd977da5",
                                        "entry_id": "c3ee6324-8420-3817-af72-985b51e0a911",
                                        "glosses": [
                                            "The sport of racing on luges."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8b543d4-7562-30fd-b214-cd9e85502460",
                                        "entry_id": "c3ee6324-8420-3817-af72-985b51e0a911",
                                        "glosses": [
                                            "A piece of bone, ice or other material with a channel down which a drink (usually alcoholic) can be poured into someone's mouth."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710a4cf7-93bf-4c78-8744-57376ab0147b",
                                                "sense_id": "b8b543d4-7562-30fd-b214-cd9e85502460",
                                                "text": "The luge was a block of ice, sometimes up to three-and-one-half feet long, which had narrow grooves etched into it. Alcohol was poured onto one end of the luge and as the alcohol traveled down the narrow grooves in the block of ice, it was cooled and then ran directly into the mouth of the waiting drinker on the other end."
                                            },
                                            {
                                                "example_id": "075fef66-ecb0-4769-8573-9d96d30d63ee",
                                                "sense_id": "b8b543d4-7562-30fd-b214-cd9e85502460",
                                                "text": "Kegs of beer were set up around every corner. There was also a liquor luge—a giant block of ice, slanted at a 45-degree angle and carved with a convenient path for shots to be poured down and into the mouths of anyone who was thirsty."
                                            },
                                            {
                                                "example_id": "c4bb32dc-382f-4cd7-a0e5-0d998dfa1138",
                                                "sense_id": "b8b543d4-7562-30fd-b214-cd9e85502460",
                                                "text": "From restaurant openings and closings to how to do a \"Bone Marrow Luge,\" you'll want to check him [Dave Cathey] out for the latest on the gastronomic scene."
                                            },
                                            {
                                                "example_id": "d00ec391-91ac-43f0-a49e-28f90e894dd0",
                                                "sense_id": "b8b543d4-7562-30fd-b214-cd9e85502460",
                                                "text": "The Torres opened their first location in 2010 in Boyle Heights—the area squished between Downtown and East L.A.—and on their Chef's Night Out, we captured some quality father–son time as each Armando showed the other his generation's Boyle Heights. For Junior that meant creative-Italian appetizing at Bestia (technically in the \"Arts District\") and something called a \"bone luge,\" where a sommelier pours sherry down your gullet via a recently scraped cow femur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77386dc9-e9e8-392c-99df-bb6d6985a655",
                                        "entry_id": "e89cf379-cd33-3550-a8a9-9d560b83528c",
                                        "glosses": [
                                            "To ride a luge; also, to participate in the sport of luge."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64a19380-e6ad-3827-810e-39556d76aa9c",
                                        "entry_id": "e89cf379-cd33-3550-a8a9-9d560b83528c",
                                        "glosses": [
                                            "To slide or slip down a slope."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0107cc84-2902-4e61-98e2-6235adcc9674",
                                                "sense_id": "64a19380-e6ad-3827-810e-39556d76aa9c",
                                                "text": "[Norman] Ollestad was only 11 when a small plane carrying him, his father and his father's girlfriend to a ski race slammed into the San Gabriel Mountains west of Los Angeles during a blizzard. […] After the girlfriend luged to her death halfway down the icy slope, Ollestad had to pick his way down alone, following the trail of her blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5ef60b-5cb0-4f08-ad4c-2e75c70cecce",
                        "source_entry_id": "3082bdb1-c335-3eb6-98af-439c2866d1a4",
                        "source_sense_id": "0ff81202-494e-3747-a64c-f21df225de4f",
                        "target_lang_word": "sledging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sledging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f39f2f-4b5a-318c-843c-1384a706adc4",
                                        "entry_id": "8ecadef3-2dca-3e83-8f5f-460c766afd44",
                                        "glosses": [
                                            "The act of using a sledge to travel over snow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a38ed6-ce09-460f-85bd-9aff4064c291",
                                                "sense_id": "c7f39f2f-4b5a-318c-843c-1384a706adc4",
                                                "text": "In 1831 the naval officer James Clark Ross led the British effort north by sledging out from his ice-bound ship, HMS Victory; after several weeks travelling with Inuit companions he succeeded in finding his compass needle sitting upright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b3c4a3-35d5-3a3e-802c-5f9d469a5c0f",
                                        "entry_id": "8ecadef3-2dca-3e83-8f5f-460c766afd44",
                                        "glosses": [
                                            "The act of using a sledgehammer to bend or crush an object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b01efca-e3ab-4f6a-846d-f591d4e6f8bc",
                                                "sense_id": "a4b3c4a3-35d5-3a3e-802c-5f9d469a5c0f",
                                                "text": "It is necessary, therefore, to force the ends to the proper curvature, either by sledging, or by some other equivalent means;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c59d13d-7c49-3e00-b428-ab6a5c96c508",
                                        "entry_id": "8ecadef3-2dca-3e83-8f5f-460c766afd44",
                                        "glosses": [
                                            "The practice of a fielder making insulting or comical references to an opposition batsman with the aim of distracting the batter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa1425d6-226a-4098-9a2c-448a3ba129f5",
                                                "sense_id": "1c59d13d-7c49-3e00-b428-ab6a5c96c508",
                                                "text": "Mind you, Wally wasn't bad at the sledging caper himself."
                                            }
                                        ]
                                    }
                                ]
                            },
