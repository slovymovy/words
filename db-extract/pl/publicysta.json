                                "target_senses": [
                                    {
                                        "sense_id": "c67f409e-7292-394d-a575-58022a249767",
                                        "entry_id": "7d2d370b-9c87-324d-8b5b-646b1b10db46",
                                        "glosses": [
                                            "Qui a trait au droit public."
                                        ],
                                        "tags": [],
