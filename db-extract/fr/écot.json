            {
                "entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                "word": "écot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c343463c-1a72-4f1c-8f9f-fb7ec9d194de",
                        "entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                        "tags": [
                            "plural"
                        ],
                        "form": "écots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6593b20b-fda8-3f70-9a02-b549b6f51122",
                        "entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                        "glosses": [
                            "Compagnie de gens qui mangent ou boivent ensemble dans une auberge, dans un cabaret."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c63a82-abbf-4fde-96ca-0c5b0824486e",
                                "sense_id": "6593b20b-fda8-3f70-9a02-b549b6f51122",
                                "text": "Vous chercheriez en vain chez eux nos cabinets particuliers et ces grandes salles où l’air circule librement, où les écots divers se coudoient en toute fraternité, où la joie communicative passe de table en table, formant à la longue un concert d’assourdissantes allégresses."
                            },
                            {
                                "example_id": "6c559150-e4c5-4ff1-a98d-1db6c2f62014",
                                "sense_id": "6593b20b-fda8-3f70-9a02-b549b6f51122",
                                "text": "— Ils étaient seuls à leur écot et buvaient de l’eau-de-vie."
                            },
                            {
                                "example_id": "f05ee8b3-f3fd-4199-93c0-e1ae651b4a83",
                                "sense_id": "6593b20b-fda8-3f70-9a02-b549b6f51122",
                                "text": "Ils se mirent en écot avec deux autres du bourg."
                            }
                        ]
                    },
                    {
                        "sense_id": "8262f504-d026-32fa-8063-a2ef613d249c",
                        "entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                        "glosses": [
                            "Part due par chaque personne lors d’une dépense commune, souvent un repas ou un divertissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3221935-e5af-48ed-823d-78a8b8a2559b",
                                "sense_id": "8262f504-d026-32fa-8063-a2ef613d249c",
                                "text": "J’ai payé mon écot."
                            },
                            {
                                "example_id": "bc7472ae-14ab-4f15-b8c1-4e7b4f608df2",
                                "sense_id": "8262f504-d026-32fa-8063-a2ef613d249c",
                                "text": "Chacun son écot."
                            },
                            {
                                "example_id": "02565312-abf1-40bc-9ade-54dae52efa7c",
                                "sense_id": "8262f504-d026-32fa-8063-a2ef613d249c",
                                "text": "Ne pouvant souffrir l’idée de laisser payer mon écot par M. d’Anquetil … je résolus de vendre une bague"
                            }
                        ]
                    },
                    {
                        "sense_id": "b236d00b-6f15-38ec-81d3-ed5a3fd88b39",
                        "entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                        "glosses": [
                            "Obligation financière ou contribution en général."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3414589a-1cb2-476a-a8f6-ab4435674539",
                                "sense_id": "b236d00b-6f15-38ec-81d3-ed5a3fd88b39",
                                "text": "Il a payé un écot pour pouvoir entrer."
                            },
                            {
                                "example_id": "1a7ee9b8-340b-4f70-a72e-8be594287b36",
                                "sense_id": "b236d00b-6f15-38ec-81d3-ed5a3fd88b39",
                                "text": "Chacun pourra apporter son écot à la construction du nouveau projet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f50c4b4-a0a6-43a5-851d-94caa071663d",
                        "source_entry_id": "5c8dddfe-acd2-3f30-bd26-ca4b0519e706",
                        "target_lang_word": "share",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "share",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a446dce-f90e-3926-a10d-97e8e23248ba",
                                        "entry_id": "c06d3860-585b-3ee4-9744-f7ebf6433ab0",
                                        "glosses": [
                                            "A portion of something, especially a portion given or allotted to someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28328a06-d87e-4fad-8f5f-7e4cbd508442",
                                                "sense_id": "5a446dce-f90e-3926-a10d-97e8e23248ba",
                                                "text": "Each of the robbers took a share of the loot."
                                            },
                                            {
                                                "example_id": "d9982342-3d33-44c0-82fe-7b1ddbca9654",
                                                "sense_id": "5a446dce-f90e-3926-a10d-97e8e23248ba",
                                                "text": "The TV programme was cancelled because it only gained a 10% share of that night's viewing audience."
                                            },
                                            {
                                                "example_id": "d90c7213-501c-462c-a90d-a1c8ae39749c",
                                                "sense_id": "5a446dce-f90e-3926-a10d-97e8e23248ba",
                                                "text": "SWR has more than its fair share of major national events. As well as the [Queen's] funeral and the coronation in the past 12 months, annual events include racing at Ascot, grand slam tennis at Wimbledon, and rugby internationals at Twickenham."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2ed15b-5654-3c8d-a076-c0d8eaa34a5c",
                                        "entry_id": "c06d3860-585b-3ee4-9744-f7ebf6433ab0",
                                        "glosses": [
                                            "A financial instrument that shows that one owns a part of a company that provides the benefit of limited liability."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "119f093c-f99b-37c3-bf39-d7567b24fdec",
                                        "entry_id": "c06d3860-585b-3ee4-9744-f7ebf6433ab0",
                                        "glosses": [
                                            "A configuration enabling a resource to be shared over a network."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "789bdfb9-7d7d-45c3-a88f-8dfc1fa0c958",
                                                "sense_id": "119f093c-f99b-37c3-bf39-d7567b24fdec",
                                                "text": "Upload media from the browser or directly to the file share."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ab0853-4777-3ad7-a47c-930441d2908b",
                                        "entry_id": "c06d3860-585b-3ee4-9744-f7ebf6433ab0",
                                        "glosses": [
                                            "The action of sharing something with other people via social media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a7e384-ce01-47b5-9907-98fc24e18a92",
                                                "sense_id": "b4ab0853-4777-3ad7-a47c-930441d2908b",
                                                "text": "Social media is supervisual, and there's nothing more shareable than images, so this is a way to increase shares and likes and follows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64ae8834-dc0e-3c2c-85ea-532bdd0e6104",
                                        "entry_id": "c06d3860-585b-3ee4-9744-f7ebf6433ab0",
                                        "glosses": [
                                            "The sharebone or pubis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85856f60-5c49-40e7-9731-cad27ee516bc",
                                                "sense_id": "64ae8834-dc0e-3c2c-85ea-532bdd0e6104",
                                                "text": "1606: translation by [[w:https://en.wikipedia.org/wiki/Philemon_Holland|Philemon Holland]] of [[w:https://en.wikipedia.org/wiki/Suetonius|Suetonius]], De vita Cæsarum [Domitian 17] — [H]ee stabbed him beneth in the very share neere unto his privie parts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "share",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a216c96b-5987-3d56-894c-4a0e301eed27",
                                        "entry_id": "7ddf0192-b2ee-38b8-8b5b-6cb9885073d0",
                                        "glosses": [
                                            "To give part of what one has to somebody else to use or consume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                        "entry_id": "7ddf0192-b2ee-38b8-8b5b-6cb9885073d0",
                                        "glosses": [
                                            "To have or use in common."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226e5121-fd12-49a2-955f-ae03ff868e75",
                                                "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                                "text": "to share a shelter with another"
                                            },
                                            {
                                                "example_id": "ed8e899e-324f-43d3-bbd0-1db5fb807ee1",
                                                "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                                "text": "They share a language."
                                            },
                                            {
                                                "example_id": "b4e0983b-0128-431c-8102-36b2d29a1c74",
                                                "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                                "text": "While Avarice and Rapine ſhare the Land."
                                            },
                                            {
                                                "example_id": "2932cfbb-ffaa-4c72-b114-268c00db84e5",
                                                "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "f7d12d0b-1499-4d74-9b0a-0b756a1c0da8",
                                                "sense_id": "bea8dfed-3a40-3b33-b661-3318adbcf6d0",
                                                "text": "The Kleine Scheidegg is quite a colony, with its railway station, shared by the Wengernalp and Jungfrau Railways, its commodious station buffet and two large hotels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1443545-6872-31c2-a314-bb4a6355f655",
                                        "entry_id": "7ddf0192-b2ee-38b8-8b5b-6cb9885073d0",
                                        "glosses": [
                                            "To divide and distribute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac31c390-0964-48bc-a63c-0372adecf0ce",
                                                "sense_id": "b1443545-6872-31c2-a314-bb4a6355f655",
                                                "text": "[S]uppose I ſhare my Fortune equally between my own Children, and a Stranger whom I take into my Protection; will that be a Method to unite them?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09c60309-b447-3bdc-b8af-43666c2979f9",
                                        "entry_id": "7ddf0192-b2ee-38b8-8b5b-6cb9885073d0",
                                        "glosses": [
                                            "To tell to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b33235-4eae-4269-8af9-84fcbf42d1f3",
                                                "sense_id": "09c60309-b447-3bdc-b8af-43666c2979f9",
                                                "text": "He shared his story with the press."
                                            },
                                            {
                                                "example_id": "8a212909-bde9-4b21-b6ab-4ff33b896df0",
                                                "sense_id": "09c60309-b447-3bdc-b8af-43666c2979f9",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […] offering services that let you[…]“share the things you love with the world” and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0145047-69a0-3f02-90e2-b2ef67c90aef",
                                        "entry_id": "7ddf0192-b2ee-38b8-8b5b-6cb9885073d0",
                                        "glosses": [
                                            "To allow public or private sharing of computer data or space in a network"
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "share",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "241a947d-c282-3566-ac98-00f39989aad1",
