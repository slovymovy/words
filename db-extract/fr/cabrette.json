                ],
                "senses": [
                    {
                        "sense_id": "5e5ebf3b-f351-3466-8b30-55a13b3bde77",
                        "entry_id": "f2d79bc7-6516-37e3-9856-abd690b8ec07",
                        "glosses": [
                            "Cornemuse d’Auvergne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b57f7ef-31c3-43d2-abe4-73655d6cdb31",
                                "sense_id": "5e5ebf3b-f351-3466-8b30-55a13b3bde77",
                                "text": "Soudain retentirent les premiers pleurs de la cabrette, puis les vielleux entrèrent dans la danse. Alors tous les habitants se mirent à frapper le sol à grands coups de sabots. La bourrée allait faire battre le cœur du village toute la nuit."
                            },
                            {
                                "example_id": "00e9c056-8645-4bd2-95b8-616bd5f05909",
                                "sense_id": "5e5ebf3b-f351-3466-8b30-55a13b3bde77",
                                "text": "\"Rasez le Puy de Dôme qu’on voie la mer !\"\", paru en 2002, est un album où plusieurs musiciens jouent de la cabrette."
                            },
                            {
                                "example_id": "5813cac4-c3e0-4aab-a091-768e889e42c3",
                                "sense_id": "5e5ebf3b-f351-3466-8b30-55a13b3bde77",
                                "text": "Moyennant un couple de cabrettes et six fioles de vin rosat, il fit cette affaire honteuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a1d61ce-5a82-3df2-b5ad-e96eeaa79632",
                        "entry_id": "f2d79bc7-6516-37e3-9856-abd690b8ec07",
                        "glosses": [
                            "Support pour cable de téléphérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edab8389-6448-4aee-8858-0ca0f8292bc9",
                                "sense_id": "6a1d61ce-5a82-3df2-b5ad-e96eeaa79632",
                                "text": "Il sera peut-être nécessaire de construire une cabrette supplémentaire : les câbles porteurs y seront fixés sur leur sabot d'appui au moyen d'un couvre-câble en tôle."
                            },
                            {
                                "example_id": "74ebceb2-87df-4177-8cfd-0b94610b7450",
                                "sense_id": "6a1d61ce-5a82-3df2-b5ad-e96eeaa79632",
                                "text": "La cabrette est le nom usuel donné au pylône qui soutient le câble."
                            }
                        ]
                    }
