{
    "word_family": [
        "slumpy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55c6bffa-8a37-3d7e-9e98-29eb34be951f",
                    "sense_definition": "A period of poor activity or performance",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team is currently in a major <w>slump</w> after losing five games in a row.",
                            "target_lang_translations": {
                                "ru": "Команда сейчас находится в глубоком <w>спаде</w> после пяти поражений подряд."
                            }
                        },
                        {
                            "text": "Economic growth hit a <w>slump</w> during the global financial crisis.",
                            "target_lang_translations": {
                                "ru": "Экономический рост <w>пошел на спад</w> во время мирового финансового кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic slump",
                        "performance slump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сутулая или опущенная поза"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутулость",
                                "target_lang_sense_clarification": "неправильная, сгорбленная осанка"
                            },
                            {
                                "target_lang_word": "поникшая поза",
                                "target_lang_sense_clarification": "положение тела, выражающее усталость или уныние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c6bffa-8a37-3d7e-9e98-29eb34be951f",
                    "sense_definition": "A slouching or drooping posture",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat with a tired <w>slump</w> in his shoulders after the long day.",
                            "target_lang_translations": {
                                "ru": "После долгого дня он сидел, <w>сутулясь</w> от усталости."
                            }
                        },
                        {
                            "text": "Correct your <w>slump</w> to avoid back pain while sitting at your desk.",
                            "target_lang_translations": {
                                "ru": "Исправьте свою <w>сутулость</w>, чтобы избежать болей в спине при работе за столом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сутулая или опущенная поза"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутулость",
                                "target_lang_sense_clarification": "неправильная, сгорбленная осанка"
                            },
                            {
                                "target_lang_word": "поникшая поза",
                                "target_lang_sense_clarification": "положение тела, выражающее усталость или уныние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "698e1e81-7a68-3278-ab77-46164d896f2b",
                    "sense_definition": "To decline or fall off in activity or performance",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stock market prices <w>slumped</w> significantly after the bad news was announced.",
                            "target_lang_translations": {
                                "ru": "Цены на фондовом рынке значительно <w>упали</w> после объявления плохих новостей."
                            }
                        },
                        {
                            "text": "Sales often <w>slump</w> during the quiet months of the year.",
                            "target_lang_translations": {
                                "ru": "Продажи часто <w>идут на спад</w> в спокойные месяцы года."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижаться или падать в активности или показателях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "резко снижаться в цене или объеме"
                            },
                            {
                                "target_lang_word": "идти на спад",
                                "target_lang_sense_clarification": "постепенно уменьшаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c83e7b2-9eff-3fdb-a8ea-d51c6660cbe6",
                    "sense_definition": "To collapse heavily or helplessly",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exhausted from the race, the runner <w>slumped</w> onto the grass.",
                            "target_lang_translations": {
                                "ru": "Измученный забегом, бегун <w>рухнул</w> на траву."
                            }
                        },
                        {
                            "text": "He <w>slumped</w> into his chair after hearing the shocking news.",
                            "target_lang_translations": {
                                "ru": "Он <w>осел</w> в кресло, услышав шокирующие новости."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело или беспомощно обрушиться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "резко упасть под действием тяжести или усталости"
                            },
                            {
                                "target_lang_word": "осесть",
                                "target_lang_sense_clarification": "медленно опуститься, например, в кресло"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e26d9601-c5f5-3e8c-80d2-2dbe2b4fc702",
                    "sense_definition": "To slouch or droop",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try not to <w>slump</w> while you are sitting at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Старайся не <w>сутулиться</w>, когда сидишь за обеденным столом."
                            }
                        },
                        {
                            "text": "The student <w>slumped</w> over his book, struggling to stay awake.",
                            "target_lang_translations": {
                                "ru": "Студент <w>сгорбился</w> над книгой, пытаясь не заснуть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сутулиться или опускать плечи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутулиться",
                                "target_lang_sense_clarification": "держать спину сгорбленной"
                            },
                            {
                                "target_lang_word": "горбиться",
                                "target_lang_sense_clarification": "сидеть или стоять с опущенными плечами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}