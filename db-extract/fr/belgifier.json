                "senses": [
                    {
                        "sense_id": "f9bf70c7-0827-32d8-8c06-4a4bd26337a9",
                        "entry_id": "eb045180-af19-3945-90d4-da47f20bb344",
                        "glosses": [
                            "Donner un caractère belge à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f905218-88c1-4a60-96f0-34b20716c03f",
                                "sense_id": "f9bf70c7-0827-32d8-8c06-4a4bd26337a9",
                                "text": "Sans vouloir enfreindre ses règlements, il me semble que du débat ouvert le mercredi 15 janvier, il ressort nettement que nous n’avons nul intérêt à « belgifier » le français."
                            },
                            {
                                "example_id": "260b6310-1e06-4a7a-b172-d414198a2f59",
                                "sense_id": "f9bf70c7-0827-32d8-8c06-4a4bd26337a9",
                                "text": "Si tu n’es pas totalement belgifié, tu en goûteras fort la verve nerveuse, l’observation piquante, le trait en coup de bistouri et la vis comica qui va toujours crescendo."
                            }
                        ]
                    }
                ],
