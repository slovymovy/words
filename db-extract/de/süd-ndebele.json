                        "entry_id": "9c6ef5e7-66bb-3690-ae25-df16a6523b07",
                        "glosses": [
                            "in den südafrikanischen Provinzen Gauteng, Mpumalanga und Limpopo gesprochene Sotho-Tswana-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c887e86-43a7-4d6a-b3c4-2011b567ba82",
                                "sense_id": "a013290f-522d-3d72-8e56-b8deb8a9c440",
                                "text": "Süd-Ndebele wird üblicherweise als Sotho-Tswana-Sprache innerhalb der Bantusprachen klassifiziert."
                            },
                            {
                                "example_id": "7f68c613-7fac-4ed5-9da3-7ab8c2e5be5a",
                                "sense_id": "a013290f-522d-3d72-8e56-b8deb8a9c440",
                                "text": "„Ein bekannter Aktivist für die Anerkennung von Nord-Ndebele als zwölfte offizielle Sprache Südafrikas rechtfertigt diese problematische Forderung […], indem er auf geringfügige lexikalische Unterschiede zwischen dieser Sprache und Süd-Ndebele hinweist (was unter dem Namen isiNdebele als eine der elf offiziellen Sprachen des Landes anerkannt ist).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
