                                        "entry_id": "f41f9589-9da2-39d4-864d-6cbe8e7b06cd",
                                        "glosses": [
                                            "A social gathering for entertainment and fun; a party."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66634ac-101f-4b46-86cf-ba518e98fe58",
                                                "sense_id": "dc16e087-4bd5-37cd-988d-6e8207aa4829",
                                                "text": "We are having a celebration at McDonald's for my dad's new job."
                                            },
                                            {
                                                "example_id": "fde3984d-df1d-4dec-b526-3758f246dba1",
                                                "sense_id": "dc16e087-4bd5-37cd-988d-6e8207aa4829",
