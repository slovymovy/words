                "senses": [
                    {
                        "sense_id": "25d03dce-5800-3175-91ac-3319031dbc7c",
                        "entry_id": "2f21d039-b7f9-3640-9bdb-979ccde764ef",
                        "glosses": [
                            "iets of iemand aanbidden als een god; iets of iemand te zeer waarderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a08d0ad-964b-4640-b12d-780309edf677",
                                "sense_id": "25d03dce-5800-3175-91ac-3319031dbc7c",
                                "text": "\"Het geestelijk leven is niet langer relevant. We hebben geen tijd en geduld meer en zijn bezeten van alles wat snel en nieuw is. Vandaar onze angst voor de dood, de grenzeloze behoefte om eeuwig jong te zijn, de verafgoding van de jeugd en de daaraan inherente infantilisering. Alles wat moeilijk is, is verdacht en elitair en moet vermeden worden\", aldus Biskop."
                            },
                            {
                                "example_id": "a17b094d-08ba-481c-87f7-8b8c6b6f3d0f",
                                "sense_id": "25d03dce-5800-3175-91ac-3319031dbc7c",
                                "text": "Sponsors maken handig gebruik van de verafgoding van grote voetbalsterren door regelmatig met nieuwe schoenen met een ander kleurtje te komen, tot onvrede van veel sporters."
                            }
                        ]
                    }
                ],
