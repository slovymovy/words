                        "source_entry_id": "b32535a2-91ab-3e6d-8ef2-cad2ea198a77",
                        "source_sense_id": "68c42a4a-807a-3260-b539-0106ddf66ce7",
                        "source_sense_description": "een soevereine staat in Zuid-Amerika (officieel de Federale Repuliek van Brazilië, 'República Federativa do Brasil'), met als officiële taal het Portugees",
                        "target_lang_word": "Brasilien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brasilien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                        "entry_id": "a3d1a5a8-c22f-3c0d-8f08-96495da8ab79",
                                        "glosses": [
                                            "das größte Land Südamerikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b363f692-a984-48e5-a615-c120a2505122",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "Brasilia ist die Hauptstadt von Brasilien."
                                            },
                                            {
                                                "example_id": "29b34a94-6c55-4f9a-8f14-b7c39ff5550a",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Brasiliens Landschaft ist geprägt von ausgedehnten Regenwäldern des Amazonas-Tieflands im Norden und Hochebenen, Hügeln und Gebirgen im Süden.“"
                                            },
                                            {
                                                "example_id": "8ec6ef6a-ad04-4e21-9e3b-72224256c71b",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "Aufgrund der Einwanderung gibt es in Brasilien zahlreiche Minderheitensprachen."
                                            },
                                            {
                                                "example_id": "303d281d-00ff-4db4-819d-15a5e1d73d3d",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Brasiliens Präsident Luiz Inácio Lula da Silva, der häufig als ‚Anti-Chávez‘ bezeichnet wird, sagte im Zusammenhang mit der globalen Finanzkrise: ‚Die Zeiten sind vorbei, in denen wir, die aufstrebenden Volkswirtschaften, vom Internationalen Währungsfonds abhängig waren. … Die Zeit ist vorbei, in der Lateinamerika keine eigene Stimme hatte.‘““"
                                            },
                                            {
                                                "example_id": "0c438002-2ca1-4b1f-8cad-246b0c13d14e",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                                            },
                                            {
                                                "example_id": "e7aaebb7-a98a-4a62-9e68-9911e97012c7",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Umweltschäden verursacht das Soja zudem auch in Brasilien.“"
                                            },
                                            {
                                                "example_id": "45c7434c-5d40-4674-8266-501493dcb2b3",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
