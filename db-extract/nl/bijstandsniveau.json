                        "examples": [
                            {
                                "example_id": "1d29e353-4251-433d-9cc3-7a48f8a7bc57",
                                "sense_id": "ed389b63-1f38-3773-a5d1-b5bfd42999c4",
                                "text": "Als mensen hun schulden niet betalen, mogen deurwaarders beslag leggen op het inkomen. Wettelijk moet een schuldenaar wel altijd minimaal negentig procent van het bijstandsniveau overhouden. Want ook mensen met flinke schulden hebben recht op voldoende geld om van te leven."
                            },
