        "fr-extract.jsonl": [
            {
                "entry_id": "eeb7b59e-f616-3a59-a857-c1866d0b4b27",
                "word": "Casablanca",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0da6cef5-1a4d-3725-9881-2eccdda55206",
                        "entry_id": "eeb7b59e-f616-3a59-a857-c1866d0b4b27",
                        "glosses": [
                            "Ville du Maroc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd9da1d-3909-4365-bcd7-3f485d85e798",
                                "sense_id": "0da6cef5-1a4d-3725-9881-2eccdda55206",
                                "text": "Si Casablanca, vue de la mer, a une mine plutôt rébarbative et farouche, elle se présente, au contraire, sous un aspect des plus riants aux voyageurs venant de l'intérieur. Entourée d'une ceinture de jardins aux épaisses frondaisons d'où s'élancent les silhouettes gracieuses de quelques palmiers, ses murs crénelés, ses terrasses plates, ses minarets, blanchis à la chaux, éblouissants sous le soleil africain, se détachent sur le bleu sombre de la rade, où gisent des bateaux à vapeur aux gros corps noirs et rouges et se balancent des voiliers aux formes sveltes et élégantes."
                            },
                            {
                                "example_id": "abdcc828-6410-440b-bcc3-505c716591c9",
                                "sense_id": "0da6cef5-1a4d-3725-9881-2eccdda55206",
                                "text": "Ainsi, le lit de l'Oued Bouskoura à Casablanca a vu s'établir de nombreuses populations à la suite de vagues d’exodes ruraux, ou le quartier Koulima à Tétouan, situé dans un point bas régulièrement touché par les inondations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d553242d-3535-4ac3-a1d6-f294e486e16f",
                        "source_entry_id": "eeb7b59e-f616-3a59-a857-c1866d0b4b27",
                        "source_sense_id": "0da6cef5-1a4d-3725-9881-2eccdda55206",
                        "target_lang_word": "Casablanca",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Casablanca",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                        "entry_id": "62e66e0e-00c3-31b0-9d21-81f3c3aaf8fc",
                                        "glosses": [
                                            "Großstadt in Marokko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e13d1c6-82af-414f-a340-a0b79f7ba553",
                                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                                "text": "„Er war 1952 in Casablanca geboren worden, zwei Jahre bevor seine Familie nach Israel ging.“"
                                            },
                                            {
                                                "example_id": "c5a950af-89b1-4db8-b97b-c662fcde9658",
                                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                                "text": "„Viele von ihnen waren orientalische Juden, deren Familien aus Bagdad, Casablanca oder Beirut stammten.“"
                                            },
                                            {
                                                "example_id": "617ad230-9334-4d20-a01f-0e090432a51c",
                                                "sense_id": "32839ed5-730b-30e5-9dc4-94470a819842",
                                                "text": "„Doch durch seinen Tod schien er ihm plötzlich näher zu rücken, und Knafo trauerte um ihn, denn damals in Casablanca hatte Max häufig mit ihm über sein Studium gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93255869-1130-4633-a15e-80fa4eeb1d5a",
                        "source_entry_id": "eeb7b59e-f616-3a59-a857-c1866d0b4b27",
