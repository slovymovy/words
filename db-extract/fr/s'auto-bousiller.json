                                "example_id": "53b45d31-6a9b-4587-acfb-71da54b0e1dc",
                                "sense_id": "7d60a9ee-ccfa-38dc-a9d6-2ab2e48622da",
                                "text": "On est fous, mais on évite de s'auto-bousiller la voix le jour même !"
