            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f5fbc55b-0c54-3e4d-a6f7-731496b62cdf",
                    "sense_definition": "An exclamation of grief, distress, or lamentation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>woe</w>, that we should live to see such a tragic day!",
                            "target_lang_translations": {
                                "pl": "O, <w>biada</w>, że przyszło nam dożyć tak tragicznego dnia!"
                            }
                        },
                        {
                            "text": "Alas and <w>woe</w>, the great library was completely destroyed by the fire.",
                            "target_lang_translations": {
                                "pl": "Ach, <w>biada</w>, wielka biblioteka została całkowicie zniszczona przez pożar."
                            }
