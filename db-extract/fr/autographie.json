                    {
                        "sense_id": "1058e808-190b-3bfc-9196-0be79e9e8125",
                        "entry_id": "f05b1ff3-f05b-3814-b045-98684e09bf46",
                        "glosses": [
                            "Art de reproduire l’écriture ou les dessins sur une matière qui en permet la reproduction, procédé de reproduction par impression d’un écrit, d’un dessin tracés avec une encre spéciale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4bb8ccc-eaeb-40e4-9c4f-51da90d016c1",
                                "sense_id": "1058e808-190b-3bfc-9196-0be79e9e8125",
                                "text": "Mais quand, à neuf heures et demie, Rabourdin examina sa minute, il aperçut d’autant mieux l’effet produit par les procédés de l’autographie, qu’il s’en était beaucoup occupé pour vérifier si les presses autographiques remplaceraient les expéditionnaires."
                            }
                        ]
