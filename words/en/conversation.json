    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                    "sense_definition": "An informal talk involving two people or a small group of people to exchange ideas, thoughts, or feelings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a very interesting <w>conversation</w> with my neighbor yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера у меня был очень интересный <w>разговор</w> с соседом.",
                                "zh": "昨天我和邻居进行了一次非常有趣的<w>谈话</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to hold a <w>conversation</w> in such a noisy room.",
                            "target_lang_translations": {
                                "ru": "В такой шумной комнате трудно поддерживать <w>беседу</w>.",
                                "zh": "在这么吵的房间里很难进行<w>交谈</w>。"
                            }
                        },
                        {
                            "text": "She tried to make <w>conversation</w> about the weather to break the silence.",
                            "target_lang_translations": {
                                "ru": "Она попыталась завязать <w>разговор</w> о погоде, чтобы нарушить тишину.",
                                "zh": "她试图找关于天气的话题来<w>交谈</w>，以打破沉默。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "discussion",
                        "dialogue",
                        "talk"
                    ],
                    "antonyms": [
                        "silence",
                        "monologue"
                    ],
                    "common_phrases": [
                        "have a conversation",
                        "start a conversation",
                        "make conversation",
                        "telephone conversation",
                        "hold a conversation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный разговор между двумя людьми или небольшой группой для обмена идеями, мыслями или чувствами.",
                        "zh": "指两人或小群体之间为了交流思想、想法或感受而进行的非正式谈话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "обмен словами, мнениями"
