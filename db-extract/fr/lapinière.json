                    }
                ],
                "senses": [
                    {
                        "sense_id": "450d75b0-14c9-30ba-872c-d5bb849d0bba",
                        "entry_id": "9850d714-475e-3481-aa29-af0a36ba6ba6",
                        "glosses": [
                            "Garenne, lieu où il y a beaucoup de lapins."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0405ef0-2de7-38bb-b985-157947512bad",
                        "entry_id": "9850d714-475e-3481-aa29-af0a36ba6ba6",
                        "glosses": [
                            "Clapier, lieu où l'on élève des lapins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50478469-99d0-4d86-9c4d-cb5d6dd12cbd",
                                "sense_id": "e0405ef0-2de7-38bb-b985-157947512bad",
                                "text": "Cette race de petits arrivistes se multipliait dans les beaux quartiers et dans les cités-dortoirs comme dans des lapinières."
                            },
                            {
                                "example_id": "9f38d7a0-0525-47d7-9f2a-a44f6d018c6b",
                                "sense_id": "e0405ef0-2de7-38bb-b985-157947512bad",
                                "text": "Soudain, claquement du côté de la lapinière : le vent vient de rabattre la porte contre le mur."
                            },
                            {
                                "example_id": "f48cbeb3-a55f-414f-b803-7108eda63269",
                                "sense_id": "e0405ef0-2de7-38bb-b985-157947512bad",
                                "text": "Nos lapinières sont constituées d’éléments préfabriqués en ciment armé vibré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ca4b1dd-eba4-4e82-94f9-8e8f5f6956f3",
                        "source_entry_id": "9850d714-475e-3481-aa29-af0a36ba6ba6",
                        "target_lang_word": "warren",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warren",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2747594-03dd-3200-a588-2b26428fc2ab",
                                        "entry_id": "a78e4aa9-07ee-314f-97ad-79437f10029c",
                                        "glosses": [
                                            "A system of burrows in which rabbits live."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e319e89c-020a-4f8b-bf0d-567bc8585a54",
                                                "sense_id": "d2747594-03dd-3200-a588-2b26428fc2ab",
                                                "text": "The largest warren in group 9 had 10 entrances in use and 11 not in use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab2b127-f0a6-3b6f-8433-07690eca3b39",
                                        "entry_id": "a78e4aa9-07ee-314f-97ad-79437f10029c",
                                        "glosses": [
                                            "A mazelike place of passages and/or rooms in which it's easy to lose oneself; especially one that may be overcrowded."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38fca717-14c5-4603-a024-da6ed0a5a220",
                                                "sense_id": "6ab2b127-f0a6-3b6f-8433-07690eca3b39",
                                                "text": "We piled into Manchester's car, leaving mine at the gallery, and crossed town, striking off the main road and into a warren of dirt roads and adobe."
                                            },
                                            {
                                                "example_id": "6ede33cb-f1e8-4bb9-a05c-991f1f709690",
                                                "sense_id": "6ab2b127-f0a6-3b6f-8433-07690eca3b39",
                                                "text": "Andrew had allowed her practically a free hand, and her interference had resulted in making the house a warren of rooms, connected by narrow corridors that meant much more work and worry for the housekeeper than the conventional model would have given."
                                            },
                                            {
                                                "example_id": "9e41966a-11ff-44e4-a4fa-101238afcdd7",
                                                "sense_id": "6ab2b127-f0a6-3b6f-8433-07690eca3b39",
                                                "text": "With demand having increased by almost 40% in the past ten years, overcrowding now threatens to reach occasionally dangerous levels on platforms and in the warren of narrow subterranean passageways between them and the surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a705ba3-a226-3dde-99e1-459c0cb1c303",
                                        "entry_id": "a78e4aa9-07ee-314f-97ad-79437f10029c",
                                        "glosses": [
                                            "The class of small game such as hare, pheasants, stoats, etc., as opposed to beasts of chase such as deer, bear, and foxes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5bd5ced-3e24-4ec9-b258-ad4a6f3c1967",
                                                "sense_id": "5a705ba3-a226-3dde-99e1-459c0cb1c303",
                                                "text": "A forest is a certen territorie of wooddy grounds and fruitfull pasrues, priviledged for wild beast and foules of forest, chase, and warren to rest and abide in, in the safe protection of the king for his princely delight and pleasure, which territorie of ground, so priviledged, is meered and bounded with unremoveable marks, meeres, and boundaries, either known by matter of record or els by presceription;"
                                            },
                                            {
                                                "example_id": "6e5d713f-0554-46fc-a6f3-67ea7c522295",
                                                "sense_id": "5a705ba3-a226-3dde-99e1-459c0cb1c303",
                                                "text": "Free warren is a franchise , erected for the preservation or custody ( which the word signifies ) of beasts and fowls of warren; which , being feræ naturæ , every one had a natural right to kill as he could : but upon the introduction of the forest laws, at the period of the Norman conquest, these animals being looked upon as royal game and the sole property of our savage monarchs, this franchise of free-warren was invented to protect them; by giving the grantee a sole and exclusive power of killing such game so far as his warren extended, on condition of his preventing other persons. A man therefore that has the franchise of a warren, is in reality no more than a royal gamekeeper; but no man, not even a lord of a manor, could by common law justify sporting on another's soil, unless he had the liberty of free-warren."
                                            },
                                            {
                                                "example_id": "956278ab-e3eb-40f5-a7fe-3255c0e365b8",
                                                "sense_id": "5a705ba3-a226-3dde-99e1-459c0cb1c303",
                                                "text": "Grouse are not birds of warren ( 2 ); and trespass on a free warren will not lie for shooting them ."
                                            },
                                            {
                                                "example_id": "f4f2187a-c2b4-4388-82da-0ca90b3da944",
                                                "sense_id": "5a705ba3-a226-3dde-99e1-459c0cb1c303",
                                                "text": "The franchise of free warren is to be claimed only by grant from the crown, or by prescription which supposes such a grant (n); and the effect of it is, to vest in the grantee a property in such wild animals or inferior specieis of game as are deemed to beasts and fowls of warren (0)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                        "entry_id": "a78e4aa9-07ee-314f-97ad-79437f10029c",
                                        "glosses": [
                                            "A place legally authorized for the keeping, breeding and hunting of beasts of warren, especially rabbits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0048770-da8b-491e-adfe-a21c86d5e3e9",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "Free warren is a franchise , erected for the preservation or custody ( which the word signifies ) of beasts and fowls of warren; which , being feræ naturæ , every one had a natural right to kill as he could : but upon the introduction of the forest laws, at the period of the Norman conquest, these animals being looked upon as royal game and the sole property of our savage monarchs, this franchise of free-warren was invented to protect them; by giving the grantee a sole and exclusive power of killing such game so far as his warren extended, on condition of his preventing other persons. A man therefore that has the franchise of a warren, is in reality no more than a royal gamekeeper; but no man, not even a lord of a manor, could by common law justify sporting on another's soil, unless he had the liberty of free-warren."
                                            },
                                            {
                                                "example_id": "099d025c-50dd-4a67-9744-4b049fec2202",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "And when the play was over, this John Adroyns in the evening departed from the market town to go home; and because he had there no change of clothing, he went forth in his devil's apparel; and his way lay through a warren of rabbits, belonging to a gentleman of the village, where he himself dwelt; at which time it happened that a priest, a vicar of the church, with two or three other idle fellows, brought with them a horse, a snare, and a ferret, to take the rabbits; and when the ferret was in the earth, and the snare set over the path where this John Adroyns should come, the priest and his fellows, seeing him coming, and considering they were in the devil's service, by stealing the rabbits though it was the devil indeed, ran away for fear."
                                            },
                                            {
                                                "example_id": "18e3e1af-cc7e-4373-9012-075d2b05cec1",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "Now warrenders tell us, and we are convinced of the fact from repeated experience, that if a wounded or dying rabbit get into a burrow, none of the living ones will ever pass it: they will die in their holes first; so that a single wounded or dead animal will cause the death of perhaps a score of their own kind in the same locality. This becomes a real loss to the proprietor of a warren."
                                            },
                                            {
                                                "example_id": "89ab2b21-184b-4d9f-9e4e-88d8fdf002f7",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "This warren is the flat at the summit of an exceedingly high mountain, and consists of, I think, the very worst land I ever saw in my life."
                                            },
                                            {
                                                "example_id": "90d19787-bc2d-46cf-9321-67bc01575348",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "As to the privileges of an owner of a free warren, he may not only prosecute a trespasser who is in pursuit of beasts and fowls of warren, whether he be a stranger in the locality, or a tenant of lands within the limits of the free warren, but he may also kill any dogs found hunting in his warren, whether they are doing damage at the time or not."
                                            },
                                            {
                                                "example_id": "4870bb0c-12cb-4e24-80ad-bba9d0ff9b80",
                                                "sense_id": "68eb0efe-ca33-34d2-a310-d75e4334a581",
                                                "text": "Commission of oyer and terminer to Robert de Morle, John de Shardelowe, William Giffard and John de Hemenhale, on complaint by Edward de Monte Acuto that Giles de Wyngefeld, Ranulph de Wyngefeld and other broke his part at Ersham, co. Norfolk, hunted therein and in his free warren, fished in his several fishery there, carried away fish and deer with hares and rabbits from his warren, and assaulted his men and servants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd329b7d-9f42-3c0b-99f5-b154c6a63046",
                                        "entry_id": "a78e4aa9-07ee-314f-97ad-79437f10029c",
                                        "glosses": [
                                            "The right to maintain and hunt an area of small beasts, similar to a free warren, but with certain limitations, such as restricting the right to hunt on parts of the land held by freeholders."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07675258-7237-4dcb-8e46-477c5826ef29",
                                                "sense_id": "fd329b7d-9f42-3c0b-99f5-b154c6a63046",
                                                "text": "Free-warren confers the property in wild animals, and that property may be claimed (a) in the land of another, to the exclusion of the owner of the soil; for in ancient times persons summoned to parliament often obtaine from the Crown grants of warren in their demesne lands, comprising such parts of their manors or honours as then were, or might come into their actual possession; but the grant of warren (b) to a party in all his demsne lands, does not extend over the lands of freeholders of the manor, as such grants are construed strictly."
                                            },
                                            {
                                                "example_id": "ee54657f-bdbc-4834-a669-ce2ced948904",
                                                "sense_id": "fd329b7d-9f42-3c0b-99f5-b154c6a63046",
                                                "text": "The defendant has pleaded a warren in gross: he does not make it appendant or appurtenant. He shews merely that Charles I. granted a free warren, as he might do."
                                            },
                                            {
                                                "example_id": "d39ed325-33f3-435a-ae00-60ed07f874fe",
                                                "sense_id": "fd329b7d-9f42-3c0b-99f5-b154c6a63046",
                                                "text": "Henry de Greye claims to have many franchises in Toveton by Charter of King Henry, that is to say a warren."
                                            },
                                            {
                                                "example_id": "0a24ee59-84d7-49f5-83bc-933bedfd79e4",
                                                "sense_id": "fd329b7d-9f42-3c0b-99f5-b154c6a63046",
                                                "text": "Warren grants contained prohibitions on fishing more frequently than forest grants did."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
