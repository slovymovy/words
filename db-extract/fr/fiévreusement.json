        "fr-extract.jsonl": [
            {
                "entry_id": "3f5b77ba-5553-3d70-9259-c4e839691d4d",
                "word": "fiévreusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa5b330c-6403-3bb3-a3b2-06e8b1385ba9",
                        "entry_id": "3f5b77ba-5553-3d70-9259-c4e839691d4d",
                        "glosses": [
                            "D’une manière fiévreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182c92db-cf32-4d2b-b233-838982fef5da",
                                "sense_id": "aa5b330c-6403-3bb3-a3b2-06e8b1385ba9",
                                "text": "L'inquiétude hautaine de cette organisation fiévreusement active [Napoléon 1ᵉʳ]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3098ded-edb9-35f4-8ca8-883b5747c0a8",
                        "entry_id": "3f5b77ba-5553-3d70-9259-c4e839691d4d",
                        "glosses": [
                            "Avec fièvre ; d'une manière fébrile ; avec fébrilité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "71a20043-77ed-48cf-a300-cd7678d78eb4",
                                "sense_id": "c3098ded-edb9-35f4-8ca8-883b5747c0a8",
                                "text": "Au début, les mines furent exploitées à ciel ouvert, on creusait au fur et à mesure une immense fondrière au fond de laquelle les nègres et les blancs travaillaient fiévreusement à extraire la terre diamantifère qui était remontée sur le sol au moyen de câbles d'acier […]."
                            },
                            {
                                "example_id": "560e090f-9f2a-4cbe-bc01-a7ef3b3fba5c",
                                "sense_id": "c3098ded-edb9-35f4-8ca8-883b5747c0a8",
                                "text": "Belmont Park est noir de monde. Et il arrive sans arrêt de nouveaux spectateurs, en bus, en voiture, en train. C'est une vague humaine, qui bat fiévreusement les entrées de l'hippodrome, […]."
                            },
                            {
                                "example_id": "e52b4bbe-9d94-4ad4-894a-016f7c0976f2",
                                "sense_id": "c3098ded-edb9-35f4-8ca8-883b5747c0a8",
                                "text": "Il alla engloutir son visage entre ses seins brûlants, puis il remonta vers ses aisselles qu’il inspira fiévreusement. Il plongea ensuite entre ses cuisses, là où la matrice avait le goût salé des embruns marins. Il but ses sucs à pleines gorgées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ccf0799-8940-4a57-bab3-30fbade413d3",
                        "source_entry_id": "3f5b77ba-5553-3d70-9259-c4e839691d4d",
                        "target_lang_word": "feverishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feverishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94eab0fa-269c-3744-ac55-8917c531697d",
                                        "entry_id": "64dfd729-cbfe-3bc3-9b6b-a9fbfae4f8d8",
                                        "glosses": [
                                            "With excitement and determination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef799ae4-bc9b-4c4f-8d05-14cdc07e19f6",
                                                "sense_id": "94eab0fa-269c-3744-ac55-8917c531697d",
                                                "text": "The US believes Israel has significantly weakened Hezbollah in strikes over the last week but is still working feverishly behind the scenes to try to convince it not to escalate further and launch a ground incursion into Lebanon over concerns the intensified fighting could spark a broader conflict engulfing the wider Middle East, officials told CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                        "entry_id": "64dfd729-cbfe-3bc3-9b6b-a9fbfae4f8d8",
                                        "glosses": [
                                            "With speed; rapidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a692c0-5395-459b-adc1-80c9ec540d67",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "In the outer room the two women knitted black wool feverishly."
                                            },
                                            {
                                                "example_id": "ca064fea-5204-46f9-8611-f861f28784f9",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "All the way to Styles, Mary talked fast and feverishly. It struck me that in some way she was nervous of Poirot’s eyes."
                                            },
                                            {
                                                "example_id": "2a3b089c-409c-424e-9c05-df8c29be78fc",
                                                "sense_id": "eedadb58-ccb7-38e8-9d90-9be822c7a77e",
                                                "text": "With nothing else to do, he carried the candle to the front room and began feverishly filling his pipe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0944ecf-2559-468f-bbf2-914f84035018",
                        "source_entry_id": "3f5b77ba-5553-3d70-9259-c4e839691d4d",
                        "target_lang_word": "excitedly",
