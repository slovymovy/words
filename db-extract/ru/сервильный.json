                                            {
                                                "example_id": "029a9de1-1d1c-4ad7-9602-fe9d3b60b217",
                                                "sense_id": "c391a9e1-406f-3ebd-afa5-96d4e9c362ed",
                                                "text": "British “subjects” (not citizens, note) are just that: gleefully servile to the monarchy’s institutionalised inequality..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d421971-ed66-3928-807d-862bbcaa01dc",
