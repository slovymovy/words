                        ],
                        "examples": [
                            {
                                "example_id": "131d4b5a-a496-4699-861e-d728064443f5",
                                "sense_id": "1a7b6dd0-c537-30ee-9886-80908b3ec2fa",
                                "text": "And for a moment it seemed that everything would be all right, that we were traveling back in time to that idyllic farm near a drinkwater town in Iowa, back to my boyhood, and that Mina would always smile up at me from her bed."
                            },
                            {
                                "example_id": "b809842f-9e10-44b0-8384-93d8a1e2b1e7",
                                "sense_id": "1a7b6dd0-c537-30ee-9886-80908b3ec2fa",
                                "text": "I'm surprised they have that kind of thing in a drinkwater place like this."
                            },
                            {
                                "example_id": "48fa4102-5d20-450f-9112-c31ba4d3a19d",
                                "sense_id": "1a7b6dd0-c537-30ee-9886-80908b3ec2fa",
                                "text": "“[...] Heard she killed two of them Jenson brothers in some drinkwater town in Kansas?”"
                            }
                        ]
                    }
