                                "zh": "您有没有照过镜子看看<w>您自己</w>？"
                            }
                        },
                        {
                            "text": "U moet goed voor <w>zichzelf</w> zorgen.",
                            "target_lang_translations": {
                                "en": "You must take good care of <w>yourself</w>.",
                                "ru": "Вы должны хорошо заботиться о <w>себе</w>.",
                                "pl": "Musi Pan/Pani dobrze dbać o <w>siebie</w>.",
                                "de": "Sie müssen gut für <w>sich selbst</w> sorgen.",
                                "fr": "Vous devez bien prendre soin de <w>vous-même</w>.",
                                "it": "Deve prendersi cura di <w>se stesso</w>.",
                                "cs": "Musíte se dobře starat o <w>sebe</w>.",
                                "tr": "<w>Kendinize</w> iyi bakmalısınız.",
                                "es": "Usted debe cuidar bien de <w>usted mismo</w>.",
                                "zh": "您一定要照顾好<w>您自己</w>。"
