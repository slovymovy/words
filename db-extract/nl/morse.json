                                    {
                                        "sense_id": "3733d611-6009-3de0-9a8f-1b6e7871f2b5",
                                        "entry_id": "056e04b6-222b-3b46-9d8a-d882ab50a537",
                                        "glosses": [
                                            "Zeichensystem zur Übermittlung von Buchstaben und Zeichen über größere Entfernungen, bestehend aus je spezifischen Kombinationen aus kurzen und langen Signalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a130367d-fcb4-49eb-a16b-b88aca189653",
                                                "sense_id": "3733d611-6009-3de0-9a8f-1b6e7871f2b5",
                                                "text": "Mit dem Morsecode wird ein Notrufsignal von dem in Seenot geratenen Schiff versendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4177deb1-ea2f-47bc-b893-d5fb24a6310d",
                        "source_entry_id": "7cc52095-dd43-36ea-8534-5a78729eec0a",
                        "source_sense_id": "4ed3785b-7c87-34bc-b5ff-3e7d40f2983f",
                        "source_sense_description": "seinalfabet",
                        "target_lang_word": "Morsealphabet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morsealphabet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3f3ff4-c3c7-3101-bfca-96fedf540d69",
                                        "entry_id": "1319ca1e-a3b7-3953-8d00-f70bb8bc0ac6",
                                        "glosses": [
                                            "System von Signalen, bei dem die Buchstaben durch je spezifische Kombinationen von kurzen und langen Impulsen wiedergegeben werden; die Wiedergabe kann akustisch, elektronisch oder optisch erfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbda5eb5-989a-4117-b219-95719c7dbd3a",
                                                "sense_id": "9c3f3ff4-c3c7-3101-bfca-96fedf540d69",
                                                "text": "„Samuel Morse hatte 1837 nicht nur den nach ihm benannten Morseapparat erfunden, sondern auch einen Vorschlag ausgearbeitet, wie man einen Text mit seinem Apparat in einfache elektrische Impulse umsetzen, das heißt codieren kann: das Morsealphabet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4727c515-e1e6-452c-af3e-d7b05d52275c",
                        "source_entry_id": "7cc52095-dd43-36ea-8534-5a78729eec0a",
                        "source_sense_id": "4ed3785b-7c87-34bc-b5ff-3e7d40f2983f",
                        "source_sense_description": "seinalfabet",
                        "target_lang_word": "Morsezeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morsezeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                        "entry_id": "b4ee2c04-19be-3c7e-9919-d41dc9e5bb26",
                                        "glosses": [
                                            "Zeichen, das zum Morsecode/Morsekode gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62848a99-a542-40d4-97ea-9322f2d4e5a5",
                                                "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                                "text": "Mithilfe der Morsezeichen wird ein Notrufsignal von dem in Seenot geratenen Schiff versendet."
                                            },
                                            {
                                                "example_id": "6a78db24-e64b-452e-894f-38bb4e6107f7",
                                                "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                                "text": "„So kann er ankommende Morsezeichen und mit dem freien Ohr zugleich auch Befehle aus dem Boot hören.“"
                                            },
                                            {
                                                "example_id": "7590e8e2-9ea6-472a-b77d-4098dce97bee",
                                                "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                                "text": "„Der Transfer von Morsezeichen erforderte jedoch Kabel oder starke Sender, die wiederum elektrischen Strom brauchten, und Telefone kamen nicht ohne Masten und Drähte aus.“"
                                            },
                                            {
                                                "example_id": "229599e2-a115-464e-ae59-96ee169af375",
                                                "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                                "text": "„Die Morsezeichen sind in bezug auf das Inventar der letzten kleinsten Einheiten ein besonders einfacher Fall.“"
                                            },
                                            {
                                                "example_id": "bbe94143-7127-4706-8ce3-209e122898fc",
                                                "sense_id": "09c9ee65-41a8-3e4b-a3ab-a47fb904cc53",
                                                "text": "„Schlumberger schrieb mit, was er an Morsezeichen hörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
