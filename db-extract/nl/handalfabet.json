                                        "entry_id": "52f3b4bb-6f89-3e24-a5a2-0b999e0ba84f",
                                        "glosses": [
                                            "von Gehörlosen genutztes Alphabet, bei dem mit den Fingern Buchstaben symbolisiert und somit Wörter buchstabiert werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d911543-ddc2-4b22-a85e-96425817202b",
                                                "sense_id": "9240095d-46b1-37c6-af37-6b5090e4d41d",
                                                "text": "Maria und Alfred benutzen das Fingeralphabet, um sich zu verständigen."
                                            },
                                            {
                                                "example_id": "86496f00-779a-4865-b68b-54170abbe1e6",
                                                "sense_id": "9240095d-46b1-37c6-af37-6b5090e4d41d",
                                                "text": "Das Fingeralphabet ist hilfreich bei der Verständigung zwischen zwei Menschen."
                                            },
                                            {
                                                "example_id": "262c4642-7a65-4c4b-b40e-135dd2c556bb",
                                                "sense_id": "9240095d-46b1-37c6-af37-6b5090e4d41d",
                                                "text": "„Gebärdensprachen und die damit verbundenen Fingeralphabete haben sich von Europa aus weltweit verbreitet.“"
                                            },
                                            {
                                                "example_id": "3a1caffc-cea7-4244-bdc4-f68fa3866592",
                                                "sense_id": "9240095d-46b1-37c6-af37-6b5090e4d41d",
                                                "text": "„Hartnäckig suchten sie in alten Schriften nach Beispielen für Fingeralphabete. Diese werden für unbekannte Begriffe benutzt, für die keine Gebärde geläufig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
