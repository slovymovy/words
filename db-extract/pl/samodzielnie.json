                    },
                    {
                        "translation_id": "be7f032b-995a-4549-ae4b-d762d757f596",
                        "source_entry_id": "59813c01-0e7c-3011-b5ff-dd16560bde71",
                        "source_sense_id": "57732e88-6e44-3280-a0a6-c3cc80ed42b4",
                        "target_lang_word": "alone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de701d9d-7063-39f6-9d98-a237e985b52c",
                                        "entry_id": "459a978a-f1fb-3768-b912-7d234f74a042",
                                        "glosses": [
                                            "By oneself, solitary."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f84c58fc-f9d7-4bc6-b66e-4ea1961db3ea",
                                                "sense_id": "de701d9d-7063-39f6-9d98-a237e985b52c",
                                                "text": "I can't ask for help because I am alone."
                                            },
                                            {
                                                "example_id": "1e5a105c-558f-42bb-95c5-75f8f0a5a327",
                                                "sense_id": "de701d9d-7063-39f6-9d98-a237e985b52c",
                                                "text": "It is not good that the man should be alone."
                                            },
                                            {
                                                "example_id": "fb5507b0-19d5-4a09-8115-801c5280c025",
                                                "sense_id": "de701d9d-7063-39f6-9d98-a237e985b52c",
                                                "text": "Alone on a wide, wide sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbee48e1-17ab-3724-8580-7f02a06a57fb",
                                        "entry_id": "459a978a-f1fb-3768-b912-7d234f74a042",
                                        "glosses": [
                                            "Lacking peers who share one's beliefs, experiences, practices, etc."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56aa70c9-9b5f-4809-8026-d7658f91bb59",
                                                "sense_id": "bbee48e1-17ab-3724-8580-7f02a06a57fb",
                                                "text": "Senator Craddock wants to abolish the estate tax, and she's not alone."
                                            },
                                            {
                                                "example_id": "92516b7f-ef85-4473-b65c-cef50340eac3",
                                                "sense_id": "bbee48e1-17ab-3724-8580-7f02a06a57fb",
                                                "text": "I always organize my Halloween candy before eating it. Am I alone in this?"
                                            },
                                            {
                                                "example_id": "ce9873e1-64fa-425d-b416-6c1db40d8fb6",
                                                "sense_id": "bbee48e1-17ab-3724-8580-7f02a06a57fb",
                                                "text": "Hungary's leader is not alone in eastern and southern Europe, where democratically elected populist strongmen increasingly dominate, deploying the power of the state and a battery of instruments of intimidation to crush dissent, demonise opposition, tame the media and tailor the system to their ends."
                                            },
                                            {
                                                "example_id": "a5115b8b-4c99-4c2a-a88f-eed144107fe7",
                                                "sense_id": "bbee48e1-17ab-3724-8580-7f02a06a57fb",
                                                "text": "If you’ve been feeling overwhelmed by it all, you’re not alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f52b32-1969-38d0-be10-382292cb3296",
                                        "entry_id": "459a978a-f1fb-3768-b912-7d234f74a042",
                                        "glosses": [
                                            "Apart from, or exclusive of, others."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe43465-184c-4208-a2e2-72101dc5adbd",
                                                "sense_id": "d6f52b32-1969-38d0-be10-382292cb3296",
                                                "text": "There are proofs enough in History, and first that beautiful Hynes, so much beloved by Charles the seventh King of France, who valued the alone possession of her Love at so high a rate, that[…]"
                                            },
                                            {
                                                "example_id": "dc063f3b-fcc4-4467-9999-5969a487a833",
                                                "sense_id": "d6f52b32-1969-38d0-be10-382292cb3296",
                                                "text": "God, […] by whose alone power and conversation we all live, and move, and have our being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01100ca7-9d52-3fe5-b78e-2b69f363125c",
                                        "entry_id": "459a978a-f1fb-3768-b912-7d234f74a042",
                                        "glosses": [
                                            "Mere; consisting of nothing further."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efb3910-773c-4c36-b513-d2f866ef2454",
                                                "sense_id": "01100ca7-9d52-3fe5-b78e-2b69f363125c",
                                                "text": "and therefore all Killing, Banishing, Fining, Imprisoning, and other such things, which Men are afflicted with, for the alone exercise of their Conscience, or difference in Worship or Opinion, proceedeth from the spirit of Cain, the Murderer, and is contrary to the Truth;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2fbdd4b-2812-36fd-b7bf-bb2a7d18df49",
                                        "entry_id": "459a978a-f1fb-3768-b912-7d234f74a042",
                                        "glosses": [
                                            "Unique; rare; matchless."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f9ddca1-7595-4635-8dd6-f955d849b690",
                                                "sense_id": "d2fbdd4b-2812-36fd-b7bf-bb2a7d18df49",
                                                "text": "Pardon me, Proteus, all I can is nothing / To her, whose worth makes other worthies nothing; / She is alone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84d33a50-a903-3de7-a48e-049654cc4231",
                                        "entry_id": "b71a04b3-d9f8-3934-81f9-d41add081d4b",
                                        "glosses": [
                                            "By oneself; apart from, or exclusive of, others; solo."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd25224d-3149-4735-80d0-192bb236a032",
                                                "sense_id": "84d33a50-a903-3de7-a48e-049654cc4231",
                                                "text": "She walked home alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be662aa-f4f2-3f9b-be41-269220c3032a",
                                        "entry_id": "b71a04b3-d9f8-3934-81f9-d41add081d4b",
                                        "glosses": [
                                            "Without outside help."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a907a66-d24a-470b-b6cf-e937f4184175",
                                                "sense_id": "8be662aa-f4f2-3f9b-be41-269220c3032a",
                                                "text": "The job was too hard for me to do alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa9b1345-249f-32d5-a116-e547f358ac44",
                                        "entry_id": "b71a04b3-d9f8-3934-81f9-d41add081d4b",
                                        "glosses": [
                                            "Focus adverb, typically modifying a noun and occurring immediately after it.",
                                            "Not permitting anything further; exclusively."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e381472-3c0b-46c6-aba0-75f37a436556",
                                                "sense_id": "aa9b1345-249f-32d5-a116-e547f358ac44",
                                                "text": "The president alone has the power to initiate a nuclear launch."
                                            },
                                            {
                                                "example_id": "cda9a7aa-1cea-4fc0-8d49-39f84674bff5",
                                                "sense_id": "aa9b1345-249f-32d5-a116-e547f358ac44",
                                                "text": "They must be told, that the ultimate authority, wherever the derivative may be found, resides in the People alone;"
                                            },
                                            {
                                                "example_id": "1e3bb5dd-a86e-4a31-8ace-b785b63fe503",
                                                "sense_id": "aa9b1345-249f-32d5-a116-e547f358ac44",
                                                "text": "The Senate (A.U.C. 514) decreed that the eldest son alone should bear his father's praenomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6b12a4-6210-30ba-81bf-768c8f121ebd",
                                        "entry_id": "b71a04b3-d9f8-3934-81f9-d41add081d4b",
                                        "glosses": [
                                            "Focus adverb, typically modifying a noun and occurring immediately after it.",
                                            "Not requiring anything further; merely."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05a29762-da56-4d51-83fc-d93451d95bf8",
                                                "sense_id": "eb6b12a4-6210-30ba-81bf-768c8f121ebd",
                                                "text": "Oral antibiotics alone won't clear the infection."
                                            },
                                            {
                                                "example_id": "b63da540-5407-46ae-8d51-82e6b89bbe29",
                                                "sense_id": "eb6b12a4-6210-30ba-81bf-768c8f121ebd",
                                                "text": "Except on matters of mere detail, there are perhaps no practical questions, even among those which approach nearest to the character of purely economical questions, which admit of being decided on economical premises alone."
                                            },
                                            {
                                                "example_id": "70fbf295-a05f-4ff3-ab86-40cd4ebea245",
                                                "sense_id": "eb6b12a4-6210-30ba-81bf-768c8f121ebd",
                                                "text": "In writing this tale I had in mind not alone to please my young readers, but also to give them a fair picture of life on the ocean as it is to-day,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                        "entry_id": "b71a04b3-d9f8-3934-81f9-d41add081d4b",
                                        "glosses": [
                                            "Focus adverb, typically modifying a noun and occurring immediately after it.",
                                            "Used to emphasize the size or extent of something by selecting a subset."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8cd6479-7bc4-48e8-9915-f6390c233f64",
                                                "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                                "text": "Her wardrobe is huge. She has three racks for blazers alone."
                                            },
                                            {
                                                "example_id": "dfdf360f-a15f-4749-8f5d-6e0034537c62",
                                                "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                                "text": "The first sentence alone sold me on the book."
                                            },
                                            {
                                                "example_id": "e5b862fc-3357-4b11-9950-07eb3e01712a",
                                                "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                                "text": "In the first place, though Lady Burton published comparatively little, she was a voluminous writer, and she left behind her such a mass of letters and manuscripts that the sorting of them alone was a formidable task."
                                            },
                                            {
                                                "example_id": "bc8820f0-3447-49b7-b468-dc46839b01ad",
                                                "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            },
                                            {
                                                "example_id": "85bcf838-d3db-4adb-972b-67840f83a1ab",
                                                "sense_id": "3cb2901f-8035-332b-bf4c-7a19d140c1f4",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
