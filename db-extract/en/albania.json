                                "target_senses": [
                                    {
                                        "sense_id": "1709349f-b75f-3dce-bdcc-a5064b0f593c",
                                        "entry_id": "0d7848ef-9905-39ee-8f16-c9386adabac7",
                                        "glosses": [
                                            "Pays de l’ouest de la péninsule des Balkans, au sud-est de l’Europe, bordé au nord par le Monténégro et la Serbie, à l’est par la Macédoine du Nord, au sud-est par la Grèce, et à l’ouest par la mer Ionienne et la mer Adriatique."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "babce727-bfa6-4864-8249-c6c779338ea6",
                                                "sense_id": "1709349f-b75f-3dce-bdcc-a5064b0f593c",
                                                "text": "En quelques années, l’Albanie est devenue un eldorado pour les architectes du monde entier."
                                            },
                                            {
                                                "example_id": "9ff88b27-490c-465d-bdf2-b553cb284493",
                                                "sense_id": "1709349f-b75f-3dce-bdcc-a5064b0f593c",
                                                "text": "En novembre 2019, plus de 50 personnes ont été tuées en Albanie dans un puissant séisme qui a également fait des milliers de sans-abri."
                                            },
                                            {
                                                "example_id": "4fb58332-c864-417d-ad3b-e7e3cacf8788",
                                                "sense_id": "1709349f-b75f-3dce-bdcc-a5064b0f593c",
                                                "text": "L’Albanie comprend une partie de la Macédoine, l’Illyrie et l’Épire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Albanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be886014-d26e-3e0a-8271-87d4f2035841",
                                        "entry_id": "6e9e7498-1102-318b-a9ce-0f963665f894",
                                        "glosses": [
                                            "Synonyme de Albanie caucasienne, royaume antique couvrant le territoire actuel de la république d’Azerbaïdjan, de la Géorgie et le sud du Daghestan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade28183-3451-4cf8-8d07-b277b31c2cde",
                                                "sense_id": "be886014-d26e-3e0a-8271-87d4f2035841",
                                                "text": "L’éloignement géographique de l’Albanie par rapport aux Empires romano-byzantin et iranien des dynasties parthe et sassanide, sa position stratégique – l’existence de voies de passage à travers le Caucase et Derbent que pouvaient emprunter des guerriers nomades – ont créé des conditions favorables à la sauvegarde de la souveraineté de l’État, à l’indépendance politique du pays entre le Iᵉʳ et le VIIIᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
