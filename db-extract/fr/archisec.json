                                "example_id": "ad41707b-213a-4781-bf81-9bf1c17246f9",
                                "sense_id": "26d0807a-f249-387e-91ff-2198970ec14e",
                                "text": "Aylin reposa le verre, désormais archisec, sur l’égouttoir, et poursuivit, prête à tout pour empêcher sa sœur de mettre à exécution son projet de grossesse dément."
                            },
                            {
                                "example_id": "00a0a59a-e024-4875-bf94-45721133bf84",
                                "sense_id": "26d0807a-f249-387e-91ff-2198970ec14e",
                                "text": "Tania était attablée devant elle, et s’amusait à décoller le bois archisec de la table avec les ongles."
                            },
                            {
                                "example_id": "8bc2e704-4b91-4b92-b5d7-8b92a2022071",
                                "sense_id": "26d0807a-f249-387e-91ff-2198970ec14e",
                                "text": "Ferme en bouche, avec une acidité fraîche et des tanins fermes et serrés, mais sans dureté, ce vin est archisec, de corps moyen, et affiche aussi de la minéralité."
                            }
                        ]
