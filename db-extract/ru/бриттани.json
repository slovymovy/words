                                    },
                                    {
                                        "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                        "entry_id": "dd3c8326-423e-3f2b-abc0-fffe330ceb53",
                                        "glosses": [
                                            "A gun dog of a particular breed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b794b64b-e8a0-4b90-a8a3-2b6dd7b714b5",
                                                "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                                "text": "A dish face is not desirable in the Brittany. A dished or upturned muzzle is considered a fault in the Redbone Coonhound."
                                            }
                                        ]
                                    }
