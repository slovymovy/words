        "fr-extract.jsonl": [
            {
                "entry_id": "1964a417-b775-3c46-b7da-3e65b0280068",
                "word": "travestissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "963fd155-65d7-4342-909c-169cf62b9a42",
                        "entry_id": "1964a417-b775-3c46-b7da-3e65b0280068",
                        "tags": [
                            "plural"
                        ],
                        "form": "travestissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6dd7c0b-d916-3808-95e5-50b5ad37c51c",
                        "entry_id": "1964a417-b775-3c46-b7da-3e65b0280068",
                        "glosses": [
                            "Port de vêtements associés au genre opposé au sien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7aebd41-170f-4d53-89e0-6a1422971ef7",
                                "sense_id": "f6dd7c0b-d916-3808-95e5-50b5ad37c51c",
                                "text": "Seule une minorité de transsexuels verse dans l’homosexualité ; par contre, ils sont presque tous des transvertis (ou travestis : femmes s'habillant en hommes et hommes s'habillant en femmes), encore que le travestissement ne soit pas obligatoirement l'expression d'un transsexualisme."
                            },
                            {
                                "example_id": "6e959048-86e5-49d1-bbe5-aec7651628ed",
                                "sense_id": "f6dd7c0b-d916-3808-95e5-50b5ad37c51c",
                                "text": "Négligée, mal connue, peu explorée, l'une des origines du travestissement est l'interdiction faite à la femme de circuler librement dans l'espace public."
                            },
                            {
                                "example_id": "98a4395c-451c-41d8-a340-d7816af428e9",
                                "sense_id": "f6dd7c0b-d916-3808-95e5-50b5ad37c51c",
                                "text": "Par contre, le cas du travestissement féminin – une femme qui s'habille en homme – est plus compliqué. Forestier remarque à juste titre que dans ce cas, l'association homosexuelle est vite et presque automatiquement faite."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef12a7b7-8eed-353d-a89b-ebe2bdafdd44",
                        "entry_id": "1964a417-b775-3c46-b7da-3e65b0280068",
                        "glosses": [
                            "Déguisement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8b260e-ada2-4656-9bde-a5dd0d9d9768",
                                "sense_id": "ef12a7b7-8eed-353d-a89b-ebe2bdafdd44",
                                "text": "Que veut dire ce travestissement, de Bracy ? demanda Fitzurze ; est-ce bien le temps des jeux de Noël et des mascarades, […]."
                            },
                            {
                                "example_id": "a7cb8472-3605-4275-80ad-d115434e0654",
                                "sense_id": "ef12a7b7-8eed-353d-a89b-ebe2bdafdd44",
                                "text": "Oh! parbleu, je ne veux voir dans ces menus travestissements, le plus souvent involontaires, aucune malignité: bien plutôt le désir d'aider quelqu'un qui n'est pas au courant des usages […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a421193-e847-41d6-b559-c7099a09887d",
                        "source_entry_id": "1964a417-b775-3c46-b7da-3e65b0280068",
                        "source_sense_description": "Port de vêtements associés au sexe opposé",
                        "target_lang_word": "transvestism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transvestism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "926f3d13-3a5a-3429-8982-145be8c6e0e6",
                                        "entry_id": "de282106-668d-36f7-9be6-36dab323e732",
                                        "glosses": [
                                            "The condition of being a transvestite."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed86c6f-c060-49c8-91bf-1359f91c9f64",
                                                "sense_id": "926f3d13-3a5a-3429-8982-145be8c6e0e6",
                                                "text": "Transexualism. Where the compulsive urge reaches beyond female vestments, and becomes an urge for gender (\"sex\") change, transvestism becomes \"transexualism.\" The term is misleading; actually, \"transgenderism\" is meant, because sexuality is not a major factor in primary transvestism. Psychologically, the transexual often differs from the simple cross-dresser; he is conscious at all times of a strong desire to be a woman, and the urge can be truly consuming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c420b94-f1df-3cef-a61b-5480d731711b",
                                        "entry_id": "de282106-668d-36f7-9be6-36dab323e732",
                                        "glosses": [
                                            "A paraphilia typically found in heterosexual males characterized by compulsively seeking and deriving sexual arousal from cross-dressing, especially if the urges and behavior cause the patient distress or social impairment."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d108f54a-b344-3cd6-9fb8-4da49e16dc98",
                                        "entry_id": "de282106-668d-36f7-9be6-36dab323e732",
                                        "glosses": [
                                            "sexual mimicry"
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
