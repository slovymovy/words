                ],
                "senses": [
                    {
                        "sense_id": "7896c9fe-c825-32a3-b93a-dc34cfad20d2",
                        "entry_id": "2bc38483-7d8e-30c6-b7df-1855a8f43ec2",
                        "glosses": [
                            "een fijnmazig net dat bedoeld is om muggen te weren gedurende de nachtrust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08adaeb6-0885-449c-a306-ec192e672d6f",
                                "sense_id": "7896c9fe-c825-32a3-b93a-dc34cfad20d2",
                                "text": "Nu ik onder een muskietennet slaapheb kan ik 's-nachts weer goed slapen."
                            },
                            {
                                "example_id": "023e765c-8144-4be3-8c63-b850733e2fd1",
                                "sense_id": "7896c9fe-c825-32a3-b93a-dc34cfad20d2",
                                "text": "‘Anderhalf jaar geleden zijn we tijdens een hete zomer, gewapend met een muskietennet, naar onze tuin verhuisd’, zegt Corny Wynen. ‘We hebben een grote tuinkamer met een afdak en zeilen die we naar beneden kunnen laten als het te koud is. Dat is ons zo bevallen dat we er zijn blijven liggen. In het begin gebruikten we een luchtmatras, na een tijd hebben we dat vervangen door een lattenbodem. Nu slapen we hier altijd. Ook als het giet of vriest.’"
                            },
                            {
                                "example_id": "e0c7decb-06af-492b-accf-2e25660e835e",
                                "sense_id": "7896c9fe-c825-32a3-b93a-dc34cfad20d2",
                                "text": "„Ik ben nu onderweg om producten voor hygiëne te kopen zoals zeep en tandenborstels. Daar is groot gebrek aan. Daarnaast ben ik op zoek naar muskietennetten. Vooral kinderen en zwangere vrouwen hebben ontzettend veel last van ontelbare muggenbeten.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "184662f4-a222-4072-9c2a-f81189e36f34",
                        "source_entry_id": "2bc38483-7d8e-30c6-b7df-1855a8f43ec2",
                        "source_sense_id": "7896c9fe-c825-32a3-b93a-dc34cfad20d2",
                        "target_lang_word": "mosquito net",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mosquito net",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7d2f427-b2c0-3cb4-be15-ea4b0daf0ba7",
                                        "entry_id": "6e5e89a8-1c4b-3802-91cb-0b386774dc1f",
                                        "glosses": [
                                            "A fine net, placed around a bed, in a window opening, etc., to provide protection against mosquitoes and other insects, and the diseases carried by them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f286db53-d1df-4a70-8e9c-8e98b83e0fc9",
                                                "sense_id": "f7d2f427-b2c0-3cb4-be15-ea4b0daf0ba7",
                                                "text": "Child-trouble widened her brown eyes as she turned them on the shrouded figure stiffly outlined by the sheet, now partly screened by the mosquito-net."
                                            },
                                            {
                                                "example_id": "86fad765-d759-4801-b4c9-97208ed2a3a8",
                                                "sense_id": "f7d2f427-b2c0-3cb4-be15-ea4b0daf0ba7",
                                                "text": "In the room the mosquito net was down, ghost-grey in the falling light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
