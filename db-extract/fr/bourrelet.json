                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2775acdf-a178-34a8-afce-dbdbc7b3cdfe",
                                        "entry_id": "0bef79a2-07c5-36de-8d9b-694836d1b26b",
                                        "glosses": [
                                            "Anything of little value used to fill up space."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "366f6782-26de-4218-b011-7c87d23d44f5",
                                                "sense_id": "2775acdf-a178-34a8-afce-dbdbc7b3cdfe",
                                                "text": "That magazine is mostly advertisements; the rest is padding."
                                            },
                                            {
                                                "example_id": "f4cc7725-18fa-44e1-8b24-23e0d36e1ac5",
                                                "sense_id": "2775acdf-a178-34a8-afce-dbdbc7b3cdfe",
                                                "text": "But to my intense surprise, on getting down early the next morning, and eagerly opening the newspapers, there was not a word about the arrest! There was a column of mere padding about “The Styles Poisoning Case,” but nothing further. It was rather inexplicable, but I supposed that, for some reason or other, Japp wished to keep it out of the papers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025bcc6a-aa61-3ac8-b713-c4239ef0d280",
                                        "entry_id": "0bef79a2-07c5-36de-8d9b-694836d1b26b",
                                        "glosses": [
                                            "The process of mordanting a fabric."
                                        ],
