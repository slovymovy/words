{
    "word_family": [
        "lapje",
        "lappenmand",
        "lappenpop",
        "lappendeken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39df3200-a9d1-3e13-8176-d10e4b1a5346",
                    "sense_definition": "een of meer lappen in of op iets zetten om het te repareren, met name bij kleding",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repareren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je die oude broek voor me <w>lappen</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>patch</w> those old trousers for me?"
                            }
                        },
                        {
                            "text": "Zij <w>lapte</w> de gaten in zijn ellebogen met stukjes leer.",
                            "target_lang_translations": {
                                "en": "She <w>patched</w> the holes in his elbows with pieces of leather."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kleding lappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To repair something, especially clothing, by putting one or more patches on it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to patch",
                                "target_lang_sense_clarification": "repairing fabric with patches"
                            },
                            {
                                "target_lang_word": "to mend",
                                "target_lang_sense_clarification": "general repair of clothing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b665c79-860e-34ad-a21d-6dbcb08e2122",
                    "sense_definition": "iets moeilijks voor elkaar krijgen of presteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindelijk, we hebben het dan toch <w>gelapt</w>!",
                            "target_lang_translations": {
                                "en": "Finally, we <w>pulled it off</w> after all!"
                            }
                        },
                        {
                            "text": "Ik wist niet of het zou lukken, maar hij heeft het weer <w>gelapt</w>.",
                            "target_lang_translations": {
                                "en": "I didn't know if it would work, but he <w>managed it</w> again."
                            }
                        }
                    ],
                    "synonyms": [
                        "flikken"
                    ],
                    "common_phrases": [
                        "het weer lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt met 'het'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To manage to achieve or perform something difficult, often used with 'it'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pull off",
                                "target_lang_sense_clarification": "succeeding in something difficult"
                            },
                            {
                                "target_lang_word": "to manage",
                                "target_lang_sense_clarification": "to succeed in doing something"
                            },
                            {
                                "target_lang_word": "to do it",
                                "target_lang_sense_clarification": "informal achievement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6333a625-50ab-3625-a466-93b844ff43f8",
                    "sense_definition": "iemand een gemene streek of een poets bakken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft hun een ellendige streek <w>gelapt</w>.",
                            "target_lang_translations": {
                                "en": "He <w>played</w> a miserable trick on them."
                            }
                        },
                        {
                            "text": "<w>Lap</w> me dat niet nog een keer, want dan word ik echt boos.",
                            "target_lang_translations": {
                                "en": "Don't <w>pull</w> that on me again, because then I'll get really angry."
                            }
                        }
                    ],
                    "synonyms": [
                        "flikken"
                    ],
                    "common_phrases": [
                        "een streek lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak in negatieve context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To play a mean trick or a practical joke on someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pull",
                                "target_lang_sense_clarification": "as in 'to pull a trick'"
                            },
                            {
                                "target_lang_word": "to play",
                                "target_lang_sense_clarification": "as in 'to play a trick'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b96cdc2b-5b98-3e54-b476-b7b33971ffdc",
                    "sense_definition": "geld bijleggen of gezamenlijk een bedrag betalen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moesten allemaal een tientje <w>lappen</w> voor het cadeau.",
                            "target_lang_translations": {
                                "en": "We all had to <w>chip in</w> ten euros for the gift."
                            }
                        },
                        {
                            "text": "Als iedereen een beetje <w>lapt</w>, kunnen we deze rekening betalen.",
                            "target_lang_translations": {
                                "en": "If everyone <w>chips in</w> a little, we can pay this bill."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel gebruik rondom geld"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To contribute money or pay an amount together with others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to chip in",
                                "target_lang_sense_clarification": "contributing money to a group fund"
                            },
                            {
                                "target_lang_word": "to cough up",
                                "target_lang_sense_clarification": "slang for paying money"
                            },
                            {
                                "target_lang_word": "to shell out",
                                "target_lang_sense_clarification": "to pay out money"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f69b374-af5e-3e12-9145-1950fb5b4bec",
                    "sense_definition": "schoonmaken met een zeemlap, meestal van ramen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is tijd om de ramen weer eens te <w>lappen</w>.",
                            "target_lang_translations": {
                                "en": "It's time to <w>wash</w> the windows again."
                            }
                        },
                        {
                            "text": "Hij was de hele middag bezig met het <w>lappen</w> van de ruiten.",
                            "target_lang_translations": {
                                "en": "He spent the whole afternoon <w>cleaning</w> the window panes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ramen lappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To clean with a chamois or cloth, usually referring to windows."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to wash",
                                "target_lang_sense_clarification": "specifically windows"
                            },
                            {
                                "target_lang_word": "to clean",
                                "target_lang_sense_clarification": "using a cloth or chamois"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03956d26-ee3a-3966-bbbe-6e6ce4dcb94c",
                    "sense_definition": "meervoud van <w>lap</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er liggen overal oude <w>lappen</w> stof in het atelier.",
                            "target_lang_translations": {
                                "en": "There are old <w>rags</w> of fabric lying everywhere in the studio."
                            }
                        },
                        {
                            "text": "Gebruik deze <w>lappen</w> om de tafel mee af te nemen.",
                            "target_lang_translations": {
                                "en": "Use these <w>cloths</w> to wipe down the table."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oude lappen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'lap'; pieces of cloth, rags, or patches of fabric."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rags",
                                "target_lang_sense_clarification": "old pieces of cloth"
                            },
                            {
                                "target_lang_word": "patches",
                                "target_lang_sense_clarification": "pieces of fabric for repair"
                            },
                            {
                                "target_lang_word": "cloths",
                                "target_lang_sense_clarification": "pieces of material for cleaning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "597fa984-b07e-3c9f-9931-c9e1312b09fc",
                    "sense_definition": "meervoud van <w>Lap</w>; leden van een inheems volk in het noorden van Scandinavië",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "volkeren",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "De <w>Lappen</w> leven van oudsher in het gebied dat Lapland wordt genoemd.",
                            "target_lang_translations": {
                                "en": "The <w>Lapps</w> have traditionally lived in the area called Lapland."
                            }
                        },
                        {
                            "text": "Tegenwoordig geven veel <w>Lappen</w> de voorkeur aan de naam Samen.",
                            "target_lang_translations": {
                                "en": "Nowadays, many <w>Lapps</w> prefer the name Sami."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "tegenwoordig vaak 'Samen' genoemd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'Lap'; members of an indigenous people in northern Scandinavia (now often considered dated)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Lapps",
                                "target_lang_sense_clarification": "dated term for the Sami people"
                            },
                            {
                                "target_lang_word": "Sami",
                                "target_lang_sense_clarification": "modern preferred term for the indigenous group"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}