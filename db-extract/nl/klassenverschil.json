                    {
                        "sense_id": "3230dbbe-a959-37d6-aa6e-15c44e3248be",
                        "entry_id": "37d9bec0-e66e-34ba-9f08-e25f45315790",
                        "glosses": [
                            "de verschillende belangen van mensen die horen tot andere sociaal economische klassen van de samenleving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8b28dd-0767-4e7e-be88-72ddd820a521",
                                "sense_id": "3230dbbe-a959-37d6-aa6e-15c44e3248be",
                                "text": "Het was een aanzienlijk verschil om zoals zijn zoon Karl uit de oorlog te komen als kapitein van de marinereservisten met een diploma van de Handelshogeschool en verzekerd te zijn van werk in het familiebedrijf of zoals haar zoon Hjalmar een afgedankte sergeant te zijn zonder verdere opleiding. Maar in principe was het hetzelfde, aan klassenverschillen kon je niet veel doen."
                            },
                            {
                                "example_id": "c035320b-4d5e-43c8-8a70-2931b97959f8",
                                "sense_id": "3230dbbe-a959-37d6-aa6e-15c44e3248be",
                                "text": "Boca en River werden beide opgericht in het arme stadsdeel La Boca, maar River Plate besloot te verhuizen naar het welvarende deel van de stad, Nuñez. Het klassenverschil is een van de voornaamste oorzaken van de haat en nijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "7008a80e-b935-3395-ae7e-d45b236a1e2e",
                        "entry_id": "37d9bec0-e66e-34ba-9f08-e25f45315790",
                        "glosses": [
                            "het verschil in kwaliteit van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb999ea-2e0d-419d-9847-96badbde3162",
                                "sense_id": "7008a80e-b935-3395-ae7e-d45b236a1e2e",
                                "text": "Toch wist Djokovic wel het klassenverschil duidelijk te maken. Hij treft in de tweede ronde de Amerikaan Denis Kudla."
                            },
                            {
                                "example_id": "81f65581-e927-433d-91ff-9b0f433808bf",
                                "sense_id": "7008a80e-b935-3395-ae7e-d45b236a1e2e",
                                "text": "Het klassenverschil uitte zich direct in de eerste vier minuten, waarin Oranje tegen een 3-0 achterstand aanliep. De ploeg van bondscoach Van der Meer gaf zich niet zomaar gewonnen en knokte zich terug naar 5-5."
                            }
                        ]
                    }
