                            {
                                "example_id": "e50213d2-1633-46be-ace3-9de103c914b5",
                                "sense_id": "ecaf3e55-ea12-3362-a3c7-8c8e816b1a5f",
                                "text": "„Wenig später steuerte Moussa auf eine winzige Insel zu und legte die Piroge in eine Einbuchtung, die gerade groß genug für den Bug war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
