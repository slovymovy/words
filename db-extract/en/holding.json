                "senses": [
                    {
                        "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "Something that one owns, especially stocks and bonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12a3f88-5b35-4f6d-9cc2-cd72a0c2bade",
                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                "text": "Although this survey lists only a small number of representative materials in the Hoover Library's Baltic Collection, a comprehensive view of the library's holdings can be gained from the Hoover Institution's card catalog or its printed equivalent"
                            },
                            {
                                "example_id": "adedc33d-51e9-4431-bfb4-3ddeff8b781b",
                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                "text": "Italy's right-wing prime minister was about to cure his biggest headache by selling the state's holding in a troubled airline, Alitalia."
                            },
                            {
                                "example_id": "071245d6-a060-416c-9f34-8a6e7f4ebe8d",
                                "sense_id": "f5e39ae6-9e1e-32b7-8f54-d3fc59512fdd",
                                "text": "The defender at third position is supposed to keep the partner informed of his holdings in that suit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e51ec0e1-5e69-3d99-b500-2525fe427db6",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "A determination of law made by a court."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bb1f0086-d965-3ad4-bdf2-1f48b5da9cfd",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "A tenure; a farm or other estate held of another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2215f754-ddec-4594-83ac-1ebc47aaa835",
                                "sense_id": "bb1f0086-d965-3ad4-bdf2-1f48b5da9cfd",
                                "text": "Take again\nFrom this my hand, as holding of the Pope\nYour sovereign greatness and authority."
                            }
                        ]
                    },
                    {
                        "sense_id": "9169b69e-0218-34d2-9e5a-fe27be6512e5",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "Logic; consistency."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1abc7368-bc30-46ff-9525-f869e8503b78",
                                "sense_id": "9169b69e-0218-34d2-9e5a-fe27be6512e5",
                                "text": "This has no holding,\nTo swear by him whom I protest to love\nThat I will work against him."
                            }
                        ]
                    },
                    {
                        "sense_id": "de43fdd5-f53c-3857-b2dd-443ad0971f7d",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "A foul consisting of impermissibly restricting the movement of an opposing player with the hands or stick."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "731321bd-602d-3088-9dfd-ef49b1ddc032",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "The burden or chorus of a song."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f0660d45-1284-4d38-b696-4cc1f1089e0f",
                                "sense_id": "731321bd-602d-3088-9dfd-ef49b1ddc032",
                                "text": "Make battery to our ears with the loud music;\nThe while I'll place you; then the boy shall sing.\nThe holding every man shall beat as loud\nAs his strong sides can volley."
                            }
                        ]
                    },
                    {
                        "sense_id": "47221ec9-471a-352e-8006-f148a87a4d33",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "That which holds, binds, or influences; hold; influence; power."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "63843b90-30af-4089-98cd-668ce23a4466",
                                "sense_id": "47221ec9-471a-352e-8006-f148a87a4d33",
                                "text": "This is one of the principal holdings of that destructive system, which has endeavoured to unhinge all the virtuous, honourable, and useful connexions in the kingdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "789efa73-f731-341f-af87-e10b7089c0f7",
                        "entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "glosses": [
                            "A holding company, or other kind of company (by back-translation from Russian холдинг (xolding))."
                        ],
                        "tags": [
                            "nonstandard"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50a78dad-a4b4-4ffd-984b-0d96852ce023",
                        "source_entry_id": "7a166a98-dd67-324a-8328-12b33c03ef58",
                        "source_sense_description": "something that one owns, especially stocks and bonds",
                        "target_lang_word": "possession",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possession",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4de4f550-8443-33c9-890e-c57ddf0b733a",
                                        "entry_id": "3005f188-2838-39af-b69b-4e898b9ff5d5",
                                        "glosses": [
                                            "Jouissance, faculté actuelle de disposer ou de jouir d’un bien."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fce2994-0bd2-475e-b436-964cd67fb6fd",
                                                "sense_id": "4de4f550-8443-33c9-890e-c57ddf0b733a",
                                                "text": "La possession et l’exploitation du sol par indivis, rationnelle, juste, féconde, nécessaire même, tant que la société exploitante n’excède pas les limites d’une proche parenté, - père, mère, aïeul et aïeule, enfants, beaux-fils et belles-filles, domestiques, oncles et tantes ; - est aussi solide que la famille même."
                                            },
                                            {
                                                "example_id": "cf63338a-39ac-44a4-a568-d7f72fb29b12",
                                                "sense_id": "4de4f550-8443-33c9-890e-c57ddf0b733a",
                                                "text": "Au moment où il se présenta, Alice, qui l’avait vu venir, entrait aussi dans la salle, où son père et ses trois assidus discutaient à grand fracas sur le parti qu’il y avait à prendre pour rentrer en possession du diamant volé."
                                            },
                                            {
                                                "example_id": "a2ff90b1-b62f-487b-8fcc-7b2b1a8fe0a3",
                                                "sense_id": "4de4f550-8443-33c9-890e-c57ddf0b733a",
                                                "text": "Mais quand l’Église, profitant de l’effondrement de la puissance romaine et du désarroi provoqué à travers les Gaules par les invasions barbares, s’installa dans le pays sans que nul n’y prît garde, son premier soin fut de s’assurer de la possession des terres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b512d78a-37b9-3ad2-8f63-ed5f1d8dcc26",
                                        "entry_id": "3005f188-2838-39af-b69b-4e898b9ff5d5",
                                        "glosses": [
                                            "Rapport possessif ou analogue à la possession, exprimé par les adjectifs possessifs comme ma, les pronoms possessifs comme le mien, les adpositions comme de, les verbes comme avoir, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6da6272e-212e-336e-8f43-ec33ce889777",
                                        "entry_id": "3005f188-2838-39af-b69b-4e898b9ff5d5",
                                        "glosses": [
                                            "Terres possédées par un État ou par un particulier."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5edb6b3d-ec50-4d0e-b74b-1a210463008b",
                                                "sense_id": "6da6272e-212e-336e-8f43-ec33ce889777",
                                                "text": "Dans ce but il demanda à la régence d’Ensisheim communication de l’engagement pris par les parties guerroyantes de respecter les possessions autrichiennes, ainsi que les villes impériales."
                                            },
                                            {
                                                "example_id": "6b2a67fa-6967-4c50-b89f-094b64eb81a2",
                                                "sense_id": "6da6272e-212e-336e-8f43-ec33ce889777",
                                                "text": "Probablement dans un temps assez rapproché, la Russie cédera ses possessions américaines au gouvernement des Etats-Unis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b8d149-b217-3606-a6b3-8b4e206b841c",
                                        "entry_id": "3005f188-2838-39af-b69b-4e898b9ff5d5",
                                        "glosses": [
                                            "Jouissance de certains plaisirs, de certaines choses qu’on a recherchées avec ardeur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2e2b72-a142-43b9-aabb-10974f591e2d",
                                                "sense_id": "49b8d149-b217-3606-a6b3-8b4e206b841c",
                                                "text": "La musique […] emplit tout d’une caresse nostalgique. Ici sur un tressautement appliqué de java, là, sur la houle passionnée et la lente possession de danses moins animales."
                                            },
                                            {
                                                "example_id": "633e975a-acc6-4554-8b04-a7a8d3f2cc40",
                                                "sense_id": "49b8d149-b217-3606-a6b3-8b4e206b841c",
                                                "text": "La possession diminue ordinairement le prix des choses qu’on a le plus désirées. La possession n’a fait qu’augmenter son amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "525debbb-45f0-3380-9c0a-e1fc06e7c29b",
                                        "entry_id": "3005f188-2838-39af-b69b-4e898b9ff5d5",
                                        "glosses": [
                                            "État d’un homme qu’on dit possédé par le démon."
                                        ],
                                        "tags": [
                                            "Théologie chrétienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40ede325-fc30-495c-b069-f697c333effc",
                                                "sense_id": "525debbb-45f0-3380-9c0a-e1fc06e7c29b",
                                                "text": "La possession diffère de l’obsession en ce que, dans la possession, le démon est censé agir au-dedans, et que, dans l’obsession, il est censé agir au-dehors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
