                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo naszych starań, szef przyjął naszą propozycję bardzo <w>chłodno</w>.",
                            "target_lang_translations": {
                                "en": "Despite our efforts, the boss received our proposal very <w>coldly</w>.",
                                "ru": "Несмотря на наши старания, начальник принял наше предложение очень <w>прохладно</w>.",
                                "nl": "Ondanks onze inspanningen ontving de baas ons voorstel heel <w>koeltjes</w>.",
                                "de": "Trotz unserer Bemühungen nahm der Chef unseren Vorschlag sehr <w>kühl</w> auf.",
                                "fr": "Malgré nos efforts, le patron a accueilli notre proposition très <w>fraîchement</w>.",
                                "it": "Nonostante i nostri sforzi, il capo ha accolto la nostra proposta molto <w>freddamente</w>.",
                                "cs": "I přes naši snahu šéf přijal náš návrh velmi <w>chladně</w>.",
                                "tr": "Çabalarımıza rağmen, patron teklifimizi çok <w>soğuk bir şekilde</w> karşıladı.",
                                "es": "A pesar de nuestros esfuerzos, el jefe acogió nuestra propuesta muy <w>fríamente</w>.",
                                "zh": "尽管我们付出了努力，老板对我们的提议还是反应得非常<w>冷淡</w>。"
                            }
                        },
                        {
                            "text": "Po kłótni rozmawiali ze sobą bardzo <w>chłodno</w> przez kilka dni.",
                            "target_lang_translations": {
                                "en": "After the argument, they spoke to each other very <w>frostily</w> for a few days.",
                                "ru": "После ссоры они разговаривали друг с другом очень <w>холодно</w> в течение нескольких дней.",
                                "nl": "Na de ruzie praatten ze een paar dagen lang erg <w>afstandelijk</w> met elkaar.",
                                "de": "Nach dem Streit sprachen sie einige Tage lang sehr <w>distanziert</w> miteinander.",
                                "fr": "Après la dispute, ils se sont parlé très <w>froidement</w> pendant plusieurs jours.",
                                "it": "Dopo il litigio si sono parlati <w>con molta freddezza</w> per diversi giorni.",
                                "cs": "Po hádce spolu několik dní mluvili velmi <w>chladně</w>.",
                                "tr": "Kavgadan sonra birkaç gün boyunca birbirleriyle çok <w>mesafeli</w> konuştular.",
                                "es": "Después de la discusión, se hablaron muy <w>con frialdad</w> durante unos días.",
                                "zh": "吵架后，他们一连几天都非常<w>冷淡地</w>交谈。"
                            }
