                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a8ffdf2-d8e3-3769-9a00-bdc63541fdd0",
                        "entry_id": "0838b3dc-14ab-3406-b1c0-48593e281a01",
                        "glosses": [
                            "Noirceur"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1a805b90-7811-4451-bf6b-a09962c7b308",
                                "sense_id": "3a8ffdf2-d8e3-3769-9a00-bdc63541fdd0",
                                "text": "Le suffixe -té a lutté, sans succès, contre le suffixe -ement dans aveugleté ; contre -eur dans laideté, dans noireté éliminé au profit de noirceur dont la formation a subi l’influence de noircir"
                            },
                            {
                                "example_id": "bd801e92-2fdd-440c-a409-1608a17d05da",
                                "sense_id": "3a8ffdf2-d8e3-3769-9a00-bdc63541fdd0",
                                "text": "… qui brille par plaques vitrières deux corbeaux freux leur plumage luisant avec un reflet irisé de pétrole sous la noireté du noir."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e86508f-fe5e-3fda-b21f-67a8ddd29262",
                        "entry_id": "0838b3dc-14ab-3406-b1c0-48593e281a01",
                        "glosses": [
                            "Obscurité, tombée de la nuit, ténèbres."
                        ],
                        "tags": [
                            "Ouest",
                            "Québec",
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "3418f166-fa90-4370-83ec-e8e8e58fc861",
                                "sense_id": "1e86508f-fe5e-3fda-b21f-67a8ddd29262",
                                "text": "Il est rentré chez lui à la noireté."
                            }
                        ]
                    },
                    {
                        "sense_id": "eedf4a3d-4523-378f-89ca-2aeec297e57f",
                        "entry_id": "0838b3dc-14ab-3406-b1c0-48593e281a01",
                        "glosses": [
                            "Le fait d'être mélanoderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212d28be-958e-45c9-9ef6-24f56750caa3",
                                "sense_id": "eedf4a3d-4523-378f-89ca-2aeec297e57f",
                                "text": "Heureusement qu'elle n'est pas noire ; la noireté trouble forcément l'ordre public : elle se voit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "496d6034-a00d-49cb-997c-c7f5dc98e2c2",
                        "source_entry_id": "0838b3dc-14ab-3406-b1c0-48593e281a01",
                        "target_lang_word": "blackness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d08040a7-41c2-33ac-888d-808e91cdcee7",
                                        "entry_id": "11fcdaa9-2cf1-3cd7-9dda-68bd7735f94c",
                                        "glosses": [
                                            "The state or quality of being black in colour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c0ef4c-aafe-4863-81ce-bf536be6a3d0",
                                                "sense_id": "d08040a7-41c2-33ac-888d-808e91cdcee7",
                                                "text": "The blackness of outer space comes from the lack of anything to reflect light rather than the absence of light."
                                            },
                                            {
                                                "example_id": "2ca5ba4a-34f8-47d4-ba02-32c222c2a807",
                                                "sense_id": "d08040a7-41c2-33ac-888d-808e91cdcee7",
                                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a26551e-6fc1-334b-9f2f-d1204291132f",
                                        "entry_id": "11fcdaa9-2cf1-3cd7-9dda-68bd7735f94c",
                                        "glosses": [
                                            "Any space that such colour pervades."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83edd928-8802-4452-aaf1-670c63701411",
                                                "sense_id": "4a26551e-6fc1-334b-9f2f-d1204291132f",
                                                "text": "Out of the blackness came some flickers of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3250c18-ad15-3859-96af-ef3718f24371",
                                        "entry_id": "11fcdaa9-2cf1-3cd7-9dda-68bd7735f94c",
                                        "glosses": [
                                            "Darkness, gloominess; depression."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa4e7217-cca1-3d9a-9ee5-06719c3ba7d8",
                                        "entry_id": "11fcdaa9-2cf1-3cd7-9dda-68bd7735f94c",
                                        "glosses": [
                                            "The quality of being evil or dismal."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9133aa35-0273-4031-a0b0-dcb60de80d17",
                                                "sense_id": "fa4e7217-cca1-3d9a-9ee5-06719c3ba7d8",
                                                "text": "She had seen so much of the blacker side of human nature that blackness no longer startled her as it should do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a2a578-a473-3d5a-b36e-6e290bc018c2",
                                        "entry_id": "11fcdaa9-2cf1-3cd7-9dda-68bd7735f94c",
                                        "glosses": [
                                            "The state of being of African descent."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ec3e35-b7b9-4f43-8f3f-5f8c7f951af0",
                                                "sense_id": "e4a2a578-a473-3d5a-b36e-6e290bc018c2",
                                                "text": "“Black Panther” is a stunning visual and cultural achievement that takes superhero cinema where it’s never gone before by not being afraid to embrace its blackness."
                                            }
                                        ]
                                    },
                                    {
