                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7835f0b0-3cc5-401f-8032-ea7a569f3187",
                                                "sense_id": "86ce7608-735c-3106-83a7-46844d672443",
                                                "text": "Reinhardt gebruikte zijn laatste jaren - vóór hij aan een hartaanval bezweek die hij volgens Gabe waarschijnlijk als een zegen beschouwde - om schilderijen te maken die op het oog monochromatisch zwart, vlak en volkomen mat waren, niets duidde erop dat er een penseel aan te pas was gekomen."
                                            },
                                            {
                                                "example_id": "de3fe13d-506b-457f-87ad-b3e1676d683f",
                                                "sense_id": "86ce7608-735c-3106-83a7-46844d672443",
                                                "text": "Sloan wilde tijdens zijn citytrip door New York de geometrische stratenpatronen en omvang van de stad capteren zonder in clichés te vervallen. Hij besliste zijn monochromatische beelden te manipuleren om zo de geometrie in de verf te zetten."
                                            }
                                        ]
                                    },
