                "senses": [
                    {
                        "sense_id": "002f5a35-e4d8-30d9-894b-103c27ba3b63",
                        "entry_id": "0b6bddfb-e23e-336e-983d-fb248a0e4573",
                        "glosses": [
                            "Rougir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48d649f-9583-48fb-b0ba-3e0488f4bbdf",
                                "sense_id": "002f5a35-e4d8-30d9-894b-103c27ba3b63",
                                "text": "Pour se maintenir, pour aboutir, il devra user de mimétisme, rougir, dérougir, rerougir, selon que les circonstances l’exigeront, restant d’ailleurs toujours bleu dans son cœur."
                            },
                            {
                                "example_id": "b7382d25-94e3-45c3-aa1b-81f510baf954",
                                "sense_id": "002f5a35-e4d8-30d9-894b-103c27ba3b63",
                                "text": "C'est alors que tu m'as écrit, les lettres ont été flâner à Thozée, à Namur, à Bruxelles, [4] il y avait tellement longtemps qu'elles couraient les chemins comme de simples gueuses, que j'ai rerougi, rougeoli, veux-je dire, de leur répondre !"
                            }
                        ]
                    }
                ],
