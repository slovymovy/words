                                "target_senses": [
                                    {
                                        "sense_id": "f9cb1bfd-1381-365e-9b80-4ff19d35a265",
                                        "entry_id": "d4e1313b-89e9-3c73-a422-4f289cd9a5e4",
                                        "glosses": [
                                            "вид одежды для нижней части ног — короткий чулок из плотной ткани, верхний край которого не достигает колена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ba5869-69cc-41cc-bde7-837082bf72ef",
                                                "sense_id": "f9cb1bfd-1381-365e-9b80-4ff19d35a265",
                                                "text": "Ни комнаты, ни вещей его не опечатывали, потому что, во-первых, не было наследников, а во-вторых, оставалось очень немного наследства, именно: пучок гусиных перьев, десть белой казённой бумаги, три пары носков, две-три пуговицы, оторвавшиеся от панталон, и уже известный читателю капот."
                                            },
                                            {
                                                "example_id": "f28cd3e3-f2a1-4f37-b8ad-bdf05f6cf6f7",
                                                "sense_id": "f9cb1bfd-1381-365e-9b80-4ff19d35a265",
                                                "text": "Живость характера, мешавшая ему посвятить себя какому-нибудь одному делу, постоянно кидала его в разные концы страны и теперь привела в Старгород без носков, без ключа, без квартиры и без денег."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "носок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30766d63-96e3-3424-915f-f63804582645",
                                        "entry_id": "13423489-a723-3950-a874-cdf1d554b49a",
                                        "glosses": [
                                            "передний конец обуви, чулка или носка [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de658a90-e32f-47d7-aff0-cb38dcdfc4c0",
                                                "sense_id": "30766d63-96e3-3424-915f-f63804582645",
                                                "text": "Ботинки с острыми носками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c686cdc-5d98-3d42-8d58-de8405c19471",
                                        "entry_id": "13423489-a723-3950-a874-cdf1d554b49a",
                                        "glosses": [
                                            "передняя часть ступни человека, обычно — кончики пальцев ноги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b871f9-9d37-4b7b-847a-4c9ce530b415",
                                                "sense_id": "3c686cdc-5d98-3d42-8d58-de8405c19471",
                                                "text": "Балерина поднялась на носки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682e060d-7b07-3d08-a45f-2bf98f2e9352",
                                        "entry_id": "13423489-a723-3950-a874-cdf1d554b49a",
                                        "glosses": [
                                            "выдающаяся, заострённая часть какого-либо предмета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ff38d9-cccb-40f2-934b-976854e34916",
                                                "sense_id": "682e060d-7b07-3d08-a45f-2bf98f2e9352",
                                                "text": "В убранном положении предкрылок плотно входит в специальное углубление в носке крыла и своим наружным профилем образует полный профиль крыла."
                                            }
                                        ]
                                    }
                                ]
