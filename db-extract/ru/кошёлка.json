                "senses": [
                    {
                        "sense_id": "8b47a7fe-ff5f-34ff-8bb1-caa287aa1feb",
                        "entry_id": "d4584276-93dd-3925-bb7d-f7487de8af3c",
                        "glosses": [
                            "разг. плетёная сумка, корзина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1414bdb0-2c67-4d65-8808-8c30147bb3f4",
                                "sense_id": "8b47a7fe-ff5f-34ff-8bb1-caa287aa1feb",
                                "text": "Холодно снаружи ― тепло внутри, кошёлка у Елизаветы Юрьевны была набита гостинцами для Ермаковых и для себя."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e77ad2d-02c1-3278-b2a8-67ed13a8dc52",
                        "entry_id": "d4584276-93dd-3925-bb7d-f7487de8af3c",
                        "glosses": [
                            "перен., бран. женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb7b3d4-b505-4c82-a669-dece355371c3",
                                "sense_id": "1e77ad2d-02c1-3278-b2a8-67ed13a8dc52",
                                "text": "Он разбираться не стал, а дал тётке пинка: ― Пошла вон, кошёлка!"
                            }
                        ]
                    }
                ],
