                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protège-dent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05ebd477-a904-3ad0-9a67-77a568e38969",
                                        "entry_id": "138663e0-b588-3d3a-bff8-56ba010bcddd",
                                        "glosses": [
                                            "Pièce en matière synthétique moulée que l'on porte dans la bouche pour se protéger les dents lors de certaines activités sportives présentant un risque pour la denture (rugby, boxe, hockey sur glace, football américain, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0764355a-dc53-45aa-92ac-1cf7d621c31a",
                                                "sense_id": "05ebd477-a904-3ad0-9a67-77a568e38969",
                                                "text": "Tout protège-dent tombant au sol doit être soigneusement lavé avant d'être réutilisé."
                                            },
                                            {
                                                "example_id": "7d3f46b7-522b-49a6-9d08-fc465d9f78b7",
                                                "sense_id": "05ebd477-a904-3ad0-9a67-77a568e38969",
                                                "text": "Les boxeurs sont munis de protège-dents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9114516-2551-4b89-b3bc-5d735891f27f",
                        "source_entry_id": "69e1d296-2659-36f9-b373-93c4efd74821",
                        "source_sense_id": "5636a896-f64e-34fc-81cb-fbc994ecc263",
                        "source_sense_description": "device",
                        "target_lang_word": "Aufbissschiene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c6cea69-480e-411b-b286-4e8d60d7e853",
                        "source_entry_id": "69e1d296-2659-36f9-b373-93c4efd74821",
                        "source_sense_id": "5636a896-f64e-34fc-81cb-fbc994ecc263",
                        "source_sense_description": "device",
                        "target_lang_word": "Mundschutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mundschutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b790c05-639b-357f-af28-38c644e7073a",
                                        "entry_id": "7bfa4c33-a292-3ede-b533-615d9f2f98b1",
                                        "glosses": [
                                            "Gesichts-Halbmaske aus mehreren Papier- beziehungsweise Vliesschichten, die mit Binde- oder Gummibändern am Hinterkopf oder hinter den Ohren fixiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad0fde8-6fd0-4e83-b59e-42b1d217910d",
                                                "sense_id": "0b790c05-639b-357f-af28-38c644e7073a",
                                                "text": "„Nachdem ich meine Hände gereinigt habe, befestige ich den Mundschutz, der von einem Gummiband gehalten wird.“"
                                            },
                                            {
                                                "example_id": "36f6b136-6bde-443e-94cf-1d088231cf0b",
                                                "sense_id": "0b790c05-639b-357f-af28-38c644e7073a",
                                                "text": "„Bis es genug Masken gebe, helfe ein selbstgenähter Mundschutz, wenn man draußen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4841059e-695f-3f40-b56f-330e11d57b84",
                                        "entry_id": "7bfa4c33-a292-3ede-b533-615d9f2f98b1",
                                        "glosses": [
                                            "Vorrichtung zum Schutz vor Sportverletzungen im Mund- und Nasenbereich, etwa beim Bodyflying, Boxen oder Motorsport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc441ef8-6024-4a89-aa1d-fd0ee49bf40f",
                                                "sense_id": "4841059e-695f-3f40-b56f-330e11d57b84",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
