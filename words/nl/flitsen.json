            "pos": "verb",
            "senses": [
                {
                    "sense_id": "686cea38-272c-3f66-a5ec-68ffef12c03a",
                    "sense_definition": "zich zeer snel voortbewegen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "snelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wielrenners van de Tour de France <w>flitsen</w> voorbij.",
                            "target_lang_translations": {
                                "en": "The Tour de France cyclists <w>flash</w> by."
                            }
                        },
                        {
                            "text": "Ik zag een snelle sportwagen over de snelweg <w>flitsen</w>.",
                            "target_lang_translations": {
                                "en": "I saw a fast sports car <w>whiz</w> across the highway."
                            }
                        }
                    ],
                    "synonyms": [
                        "snorren",
                        "zoeven",
                        "vliegen"
                    ],
                    "antonyms": [
                        "slenteren",
                        "kruipen"
                    ],
                    "common_phrases": [
                        "voorbij flitsen",
                        "langs flitsen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move very quickly or at high speed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flash",
                                "target_lang_sense_clarification": "moving past very quickly"
                            },
                            {
                                "target_lang_word": "to whiz",
                                "target_lang_sense_clarification": "moving with a rushing sound"
                            },
                            {
                                "target_lang_word": "to zip",
                                "target_lang_sense_clarification": "moving rapidly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "454d5427-071e-346c-956d-873ea52a7ab5",
                    "sense_definition": "een kortstondig, fel licht geven of veroorzaken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bliksem begon te <w>flitsen</w> boven de donkere velden.",
                            "target_lang_translations": {
                                "en": "Lightning began to <w>flash</w> over the dark fields."
                            }
                        },
                        {
                            "text": "Om in het donker foto's te kunnen maken moet je <w>flitsen</w>.",
                            "target_lang_translations": {
                                "en": "To take photos in the dark, you have to <w>flash</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerlichten",
                        "bliksemen"
                    ],
                    "common_phrases": [
                        "fel flitsen"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce or emit a brief, bright light"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flash",
                                "target_lang_sense_clarification": "emitting light or using a camera flash"
                            },
                            {
                                "target_lang_word": "to flicker",
                                "target_lang_sense_clarification": "briefly shining"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be03e807-4b23-316d-bdd6-c0e57dde46b5",
                    "sense_definition": "het plotseling en kortstondig verschijnen van gedachten of beelden in de geest",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De herinneringen aan die vakantie <w>flitsten</w> door mijn hoofd.",
                            "target_lang_translations": {
                                "en": "Memories of that holiday <w>flashed</w> through my head."
                            }
                        },
                        {
                            "text": "Er <w>flitste</w> een vreemde gedachte door hem heen tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "A strange thought <w>flashed</w> through him during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "schieten"
                    ],
                    "common_phrases": [
                        "door het hoofd flitsen",
                        "door de geest flitsen"
                    ],
                    "target_lang_definitions": {
                        "en": "The sudden and brief appearance of thoughts or images in the mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flash",
                                "target_lang_sense_clarification": "thoughts appearing suddenly"
                            },
                            {
                                "target_lang_word": "to dart",
                                "target_lang_sense_clarification": "moving quickly through the mind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41f4ee46-bf59-3434-bba0-6e5f0d4c9f0b",
                    "sense_definition": "met een snelheidscamera een foto maken van een verkeersovertreder",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben gisteren op de ringweg <w>geflitst</w> omdat ik te hard reed.",
                            "target_lang_translations": {
                                "en": "I was <w>flashed</w> on the ring road yesterday because I was speeding."
                            }
                        },
                        {
                            "text": "De politie staat daar vaak te <w>flitsen</w> bij de tunnel.",
                            "target_lang_translations": {
                                "en": "The police are often there <w>flashing</w> speeders near the tunnel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geflitst worden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in the context of traffic fines."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take a photo of a traffic offender with a speed camera"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flash",
                                "target_lang_sense_clarification": "being caught by a speed camera"
                            },
                            {
                                "target_lang_word": "to get a ticket",
                                "target_lang_sense_clarification": "colloquial result of being flashed"
                            }
                        ]
                    }
                }
            ]
        },
