                        ],
                        "examples": [
                            {
                                "example_id": "0cd9fd38-7447-4432-98d5-fc30b36f8a6a",
                                "sense_id": "63ec0d25-b2fb-3625-b251-4bfdc4141e89",
                                "text": "Kraandrijver verongelukt bij lossen Pelican I: Tijdens loswerkzaamheden van de Pelican I in Vlissingen-Oost is gisteravond een 39-jarige kraanmachinist uit Heinkenszand verongelukt. De machinist was op een hoogte van ongeveer veertig meter bezig met het lossen van het schip toen de arm van de kraan door nog onbekende oorzaak brak. Dat heeft de politie van Vlissingen bevestigd."
                            },
                            {
                                "example_id": "33045946-9bc5-40bd-a2c6-4083fa8148de",
                                "sense_id": "63ec0d25-b2fb-3625-b251-4bfdc4141e89",
                                "text": "Hij heeft een klus ver van huis, aan de Poolse grens. Zand afgraven voor de papierindustrie. Niettemin staat Wim Weenk (50) uit Geesteren in de startblokken voor de zestiende Elfstedentocht. „Als ie komt, ben ik d’r klaar voor. Ik heb de schaatsen bij me”, zegt de kraandrijver uit het Borculose kerkdorp. Hij kwam in de laatste editie als laatste over de finish, tien tellen voor middernacht."
                            }
                        ]
                    }
