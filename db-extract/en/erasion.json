                        "entry_id": "f8d1303e-8b3e-3092-8493-93f35fbf7519",
                        "glosses": [
                            "The act of erasing; a rubbing out or obliteration; erasure."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0af5a2af-d7ba-4049-88b0-2b4d5c1bb7b8",
                                "sense_id": "3bfc2242-c960-3c7e-8676-ed40790da3e1",
                                "text": "If erasions are found in a text occuring verbatim in another author who continues the material erased, then without a doubt that first author in the particular instance is not original."
                            },
                            {
                                "example_id": "ddc3a854-0ce9-4573-80c7-9b437774d834",
                                "sense_id": "3bfc2242-c960-3c7e-8676-ed40790da3e1",
                                "text": "[…] followed by the low level driving energy to said heating means for effecting the erasion of the data recorded on the thermal recording media;"
                            },
                            {
                                "example_id": "84b37427-51bf-4c21-99a0-0721d72a778a",
                                "sense_id": "3bfc2242-c960-3c7e-8676-ed40790da3e1",
                                "text": "The erasion of symbol pixels after recognition is, correspondingly, separated into two cases."
                            }
                        ]
                    },
                    {
                        "sense_id": "54a3511b-add8-3c51-b278-569c0d3a5d25",
                        "entry_id": "f8d1303e-8b3e-3092-8493-93f35fbf7519",
                        "glosses": [
                            "The surgical removal of tissue by scraping."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e68ea604-c81d-4a90-b5fc-bede7afc07aa",
                                "sense_id": "54a3511b-add8-3c51-b278-569c0d3a5d25",
                                "text": "A very considerable time must elapse before an operation can assert that a case of excision or erasion of the knee is thoroughly successful."
                            },
                            {
                                "example_id": "e22cdc32-fc54-4348-a23d-fe4f38e0d4f2",
                                "sense_id": "54a3511b-add8-3c51-b278-569c0d3a5d25",
                                "text": "The method of erasion—scraping off the epidermis until the papillary layer of the skin is laid bare—is now most requently used in this country."
                            },
                            {
                                "example_id": "2e5d42d3-32a3-4ff5-9049-3015c5c37b05",
                                "sense_id": "54a3511b-add8-3c51-b278-569c0d3a5d25",
                                "text": "If caseation has taken place it should be treated as elsewhere, by means of incision and erasion; the skin being sutured and the wound kept aseptic when possible."
                            },
                            {
                                "example_id": "e188ecd8-6c75-4084-837f-e4ac7abeaaed",
                                "sense_id": "54a3511b-add8-3c51-b278-569c0d3a5d25",
                                "text": "Mr. Wright advocates erasion in children in preference to excision on the grounds that there is less interference with the growth of the limb, and mobility may be preserved."
                            }
                        ]
                    }
