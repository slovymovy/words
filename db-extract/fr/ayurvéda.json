                                "target_senses": [
                                    {
                                        "sense_id": "0cbd0be3-2deb-3474-96c7-ce05f8eb32da",
                                        "entry_id": "03de6210-3a4d-3bac-bce1-a5e5debb68fd",
                                        "glosses": [
                                            "traditionelle indische Gesundheitslehre und Gesundheitspflege, die auf der Lehrbuchsammlung des Ayurveda beruht und darauf abzielt, ein Gleichgewicht zwischen Körper und Geist herzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670a7b5d-3c1c-49e8-99c1-f4caf3a12a5d",
                                                "sense_id": "0cbd0be3-2deb-3474-96c7-ce05f8eb32da",
                                                "text": "„Also kam sie und ließ sich auch vom Kopfschütteln ihrer Eltern und Freunde nicht beirren. Zwei Wochen Yoga oder Ayurweda in Indien, das wäre vermittelbar gewesen. Aber in einem Sterbehaus in Kalkutta helfen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50d2dc81-7be1-4dc3-8570-33c58fd1f7d2",
                        "source_entry_id": "a9948006-66b9-3a31-920e-6118fdf85f4d",
                        "target_lang_word": "Ayurveda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ayurveda",
