                        "entry_id": "636a9abe-34a6-3b22-95cd-c0570adfbe72",
                        "glosses": [
                            "Gesamtheit der Utensilien (Stricknadeln, …), die zum Stricken benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a88589-ec36-4dc5-8e51-cc5a69f25b79",
                                "sense_id": "04df9a9c-b1ee-3d11-88d5-177d03cf6dc2",
                                "text": "„Ebba saß auf der Torfkiste und hatte ihr Strickzeug zur Hand genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "adf55df6-c4dd-3591-aa03-21b34224e3b2",
                        "entry_id": "636a9abe-34a6-3b22-95cd-c0570adfbe72",
                        "glosses": [
                            "etwas, das gestrickt wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9f6c67-223a-4d7f-8aa1-3af6eb899fe6",
                                "sense_id": "adf55df6-c4dd-3591-aa03-21b34224e3b2",
                                "text": "„Ebba saß auf der Torfkiste und hatte ihr Strickzeug zur Hand genommen.“"
                            },
                            {
                                "example_id": "5d215e14-f979-48a6-9612-87c9b725028a",
                                "sense_id": "adf55df6-c4dd-3591-aa03-21b34224e3b2",
                                "text": "„Einige Male schaute sie auf das Strickzeug, das auf ihrem Schoß lag, die Nadeln bewegten sich in einem gleichmäßigen Rhythmus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
