                    {
                        "sense_id": "5aba0ec9-5869-3b7f-9351-26e9d8b4004f",
                        "entry_id": "4fcc07b6-2e4e-3aaa-ad91-c141442d6655",
                        "glosses": [
                            "iemand die met het lijf een meester toebehoort: een onvrije, slaaf of horige"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b0ac29-40fc-4394-a4b6-122dffeab31f",
                                "sense_id": "5aba0ec9-5869-3b7f-9351-26e9d8b4004f",
                                "text": "De vader van Peter Kropotkin was de eigenaar van ongeveer 1200 mannelijke lijfeigenen en ongeveer evenveel vrouwen. De eigenaar van de lijfeigenen was diegene die besloot wie met wie trouwde, waardoor veel gedwongen huwelijken gesloten werden. Ook kwam het vaak voor dat lijfeigenen werden verkocht of vergokt"
                            }
                        ]
                    }
                ],
