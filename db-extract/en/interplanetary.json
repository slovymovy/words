                                "target_senses": [
                                    {
                                        "sense_id": "ce40b409-057f-31fe-bcaa-0c23fec8ad98",
                                        "entry_id": "03284c2b-3e6f-38fa-a574-c9fcb2d56797",
                                        "glosses": [
                                            "tussen de planeten"
