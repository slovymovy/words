{
    "word_family": [
        "blood",
        "shed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2cf9dc9-05f9-3457-9a54-204f2ffa78f5",
                    "sense_definition": "The act of causing blood to flow, often through violence or injury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peace treaty was signed to avoid further <w>bloodshed</w> in the region.",
                            "target_lang_translations": {
                                "zh": "签署和平条约是为了避免该地区发生进一步的<w>流血</w>冲突。"
                            }
                        },
                        {
                            "text": "The revolution resulted in heavy <w>bloodshed</w> across the entire country.",
                            "target_lang_translations": {
                                "zh": "这场革命导致全国各地发生了严重的<w>流血</w>事件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodletting"
                    ],
                    "common_phrases": [
                        "avoid bloodshed",
                        "prevent bloodshed"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因暴力或伤害导致流血的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流血",
                                "target_lang_sense_clarification": "指身体受伤流血或暴力冲突造成的流血事件。"
                            },
                            {
                                "target_lang_word": "血腥",
                                "target_lang_sense_clarification": "形容充满暴力和流血的场面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31db9170-304b-303c-9e54-aac679abfce0",
                    "sense_definition": "Large-scale slaughter or destruction of life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history of the war is marked by terrible <w>bloodshed</w> and suffering.",
                            "target_lang_translations": {
                                "zh": "那场战争的历史充满了可怕的<w>屠杀</w>与苦难。"
                            }
                        },
                        {
                            "text": "Political <w>bloodshed</w> often follows the collapse of a stable government.",
                            "target_lang_translations": {
                                "zh": "稳定的政府倒台后，往往会伴随着政治<w>屠杀</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodbath",
                        "carnage"
                    ],
                    "common_phrases": [
                        "widespread bloodshed"
                    ],
                    "target_lang_definitions": {
                        "zh": "大规模的屠杀或生命毁灭。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屠杀",
                                "target_lang_sense_clarification": "指大规模的杀戮行为。"
                            },
                            {
                                "target_lang_word": "血流成河",
                                "target_lang_sense_clarification": "形容死伤惨重，流血极多。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e4340a-85ff-31b8-ab7e-c50ebb38ce27",
                    "sense_definition": "The shedding of one's own blood, specifically referring to the death of Christ.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sermon focused on the <w>bloodshed</w> of Christ as a sacrifice for humanity.",
                            "target_lang_translations": {
                                "zh": "布道重点讲述了基督为人类<w>流血牺牲</w>的事迹。"
                            }
                        },
                        {
                            "text": "The religious text describes the <w>bloodshed</w> on the cross in great detail.",
                            "target_lang_translations": {
                                "zh": "宗教文献详细描述了他在十字架上<w>流血</w>的情景。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指基督为人类牺牲而流血。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流血牺牲",
                                "target_lang_sense_clarification": "特指宗教语境下为了救赎而付出的生命代价。"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "obsolete theological sense"
                        }
                    ]
                },
                {
                    "sense_id": "b39f8820-2215-3f91-bf1f-f876282b07d8",
                    "sense_definition": "A condition where the eye appears red due to broken blood vessels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>bloodshed</w> in the patient's eye after the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生后，医生检查了病人眼部的<w>充血</w>情况。"
                            }
                        },
                        {
                            "text": "Severe eye strain can sometimes lead to visible <w>bloodshed</w> in the white of the eye.",
                            "target_lang_translations": {
                                "zh": "严重的眼部疲劳有时会导致眼白处出现明显的<w>充血</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指因血管破裂导致眼睛充血的状况。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "充血",
                                "target_lang_sense_clarification": "指眼部血管扩张或破裂导致的红肿状态。"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "obsolete; the modern word is 'bloodshot'"
                        }
                    ]
                }
            ]
        }
    ]
}