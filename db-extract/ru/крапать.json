                "senses": [
                    {
                        "sense_id": "b227faa7-400f-323a-b334-4c4e4c0ab42e",
                        "entry_id": "3908c564-260c-325e-8cc5-eb2c39b2b19e",
                        "glosses": [
                            "падать мелкими редкими каплями (о дожде)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9296dbac-8dca-41f1-8709-3089522812b0",
                                "sense_id": "b227faa7-400f-323a-b334-4c4e4c0ab42e",
                                "text": "Дождь перестал крапать."
                            },
                            {
                                "example_id": "2a00f9a7-80bd-4a8e-8f4a-8f3a6376c4eb",
                                "sense_id": "b227faa7-400f-323a-b334-4c4e4c0ab42e",
                                "text": "Как увидишь его, страх и трепет и краплет пот?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bb353f53-ee8c-324c-8cd1-abde2a37e2df",
                        "entry_id": "3908c564-260c-325e-8cc5-eb2c39b2b19e",
                        "glosses": [
                            "покрывать что-либо крапинами"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b742c27-0ef9-3c3c-abf4-f46f065931b1",
                        "entry_id": "3908c564-260c-325e-8cc5-eb2c39b2b19e",
                        "glosses": [
                            "то же, что кропать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fbf6d0-74a9-4d16-8e88-beb943a2ba1c",
                                "sense_id": "0b742c27-0ef9-3c3c-abf4-f46f065931b1",
                                "text": "В детстве он крапал в лицейском журнале стишки и опубликовал первую главу книги о летающих обезьянах."
                            }
                        ]
                    },
