                "senses": [
                    {
                        "sense_id": "53af942c-6a42-322c-8be2-aedc0850e414",
                        "entry_id": "c0d457d4-f50a-38fa-80cf-5ddb54b0ae75",
                        "glosses": [
                            "Donner un caractère festif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49e4b43-6be2-4a1e-b595-af38eaf730e8",
                                "sense_id": "53af942c-6a42-322c-8be2-aedc0850e414",
                                "text": "Il ne faudrait pas qu'ils y trouvent prétexte à \"festiviser\" la ville."
                            },
                            {
                                "example_id": "f4798beb-f736-40db-96b1-41b6b34d0729",
                                "sense_id": "53af942c-6a42-322c-8be2-aedc0850e414",
                                "text": "Quoiqu'il en soit, j'ai décidé de « festiviser » mes pulls gris les plus ternes, et de leur donner un peu de pep's!"
                            },
                            {
                                "example_id": "fb17dbf7-518c-49fd-bc39-791df7466f68",
                                "sense_id": "53af942c-6a42-322c-8be2-aedc0850e414",
                                "text": "Pour le jour même, une assoc de jongleurs devrait être présent pour \"festiviser\" la manif."
                            }
                        ]
                    }
                ],
