                                        "glosses": [
                                            "Gâter par la grêle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f869b6-db03-458a-a6fb-c02bbca4c754",
                                                "sense_id": "8ce285be-7a5e-3c9c-bb42-901c3e7e4e03",
                                                "text": "Dans ma région, tous les grands vignobles ont été grêlés."
                                            }
