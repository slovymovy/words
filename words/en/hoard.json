{
    "word_family": [
        "hoarder",
        "hoarding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf0578e1-d520-3c30-94cb-44bd3c9942ec",
                    "sense_definition": "To collect and store a large amount of something for one's own private use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people <w>hoard</w> food and supplies in case of an emergency.",
                            "target_lang_translations": {
                                "fr": "Certaines personnes <w>accumulent</w> de la nourriture et des provisions en cas d'urgence."
                            }
                        },
                        {
                            "text": "The dragon is known to <w>hoard</w> gold and jewels in its mountain cave.",
                            "target_lang_translations": {
                                "fr": "Le dragon est connu pour <w>amasser</w> de l'or et des bijoux dans sa grotte de montagne."
                            }
                        }
                    ],
                    "synonyms": [
                        "amass"
                    ],
                    "antonyms": [
                        "declutter"
                    ],
                    "common_phrases": [
                        "hoard supplies",
                        "hoard money"
                    ],
                    "target_lang_definitions": {
                        "fr": "Accumuler et stocker une grande quantité de quelque chose pour son usage privé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "accumuler",
                                "target_lang_sense_clarification": "Action de rassembler des objets ou des ressources en grande quantité."
                            },
                            {
                                "target_lang_word": "amasser",
                                "target_lang_sense_clarification": "Réunir des biens ou des richesses, souvent avec une intention de conservation."
                            },
                            {
                                "target_lang_word": "thésauriser",
                                "target_lang_sense_clarification": "Accumuler des richesses ou des biens de manière excessive ou secrète."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deb027b8-9a2c-3440-bcd1-3ed6c71ec634",
                    "sense_definition": "To keep information or memories in one's mind for future use.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collecting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tends to <w>hoard</w> every small detail of her childhood in her memory.",
                            "target_lang_translations": {
                                "fr": "Elle a tendance à <w>emmagasiner</w> chaque petit détail de son enfance dans sa mémoire."
                            }
                        },
                        {
                            "text": "He likes to <w>hoard</w> interesting facts to share during conversations.",
                            "target_lang_translations": {
                                "fr": "Il aime <w>accumuler</w> des faits intéressants à partager lors des conversations."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Garder des informations ou des souvenirs dans son esprit pour un usage futur."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "emmagasiner",
                                "target_lang_sense_clarification": "Enregistrer des connaissances ou des souvenirs dans sa mémoire."
                            },
                            {
                                "target_lang_word": "accumuler",
                                "target_lang_sense_clarification": "Rassembler des faits ou des détails de manière progressive."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed573dbd-3956-34d1-a674-8be1b0bf2296",
                    "sense_definition": "A hidden or private supply of items or money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The squirrel kept a secret <w>hoard</w> of nuts for the winter.",
                            "target_lang_translations": {
                                "fr": "L'écureuil gardait une <w>réserve</w> secrète de noisettes pour l'hiver."
                            }
                        },
                        {
                            "text": "Archaeologists discovered a large <w>hoard</w> of ancient coins buried underground.",
                            "target_lang_translations": {
                                "fr": "Les archéologues ont découvert un important <w>trésor</w> de pièces anciennes enterré sous terre."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hidden hoard",
                        "gold hoard"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une réserve cachée ou privée d'objets ou d'argent."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "trésor",
                                "target_lang_sense_clarification": "Ensemble de richesses ou d'objets précieux mis en réserve."
                            },
                            {
                                "target_lang_word": "magot",
                                "target_lang_sense_clarification": "Somme d'argent économisée et cachée, souvent de manière familière."
                            },
                            {
                                "target_lang_word": "réserve",
                                "target_lang_sense_clarification": "Stock de provisions ou d'objets conservés pour plus tard."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9bffd64c-3673-3d71-9ab8-60db94cd3fc0",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Hoard</w> family has lived in this town for many generations.",
                            "target_lang_translations": {
                                "fr": "La famille Hoard vit dans cette ville depuis de nombreuses générations."
                            }
                        },
                        {
                            "text": "Mr. <w>Hoard</w> is our new neighbor.",
                            "target_lang_translations": {
                                "fr": "Monsieur Hoard est notre nouveau voisin."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un nom de famille."
                    },
                    "translations": {
                        "fr": []
                    }
                }
            ]
        }
    ]
}