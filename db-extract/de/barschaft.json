                                                "example_id": "ff712713-4783-4adb-9c0f-a69211f9f07e",
                                                "sense_id": "da32e194-0efa-3dbb-bdd0-d1358e473d18",
                                                "text": "It might have been supposed that, given a girl rapidly becoming good-looking, comfortably circumstanced, and for the first time in her life commanding ready money, she would go and make a fool of herself by dress."
                                            },
                                            {
                                                "example_id": "90cc1793-7134-4747-9480-cbdd2506ad06",
                                                "sense_id": "da32e194-0efa-3dbb-bdd0-d1358e473d18",
                                                "text": "Lane: [Gravely.] There were no cucumbers in the market this morning, sir. I went down twice.\nAlgernon: No cucumbers!\nLane: No, sir. Not even for ready money."
                                            },
                                            {
                                                "example_id": "e8ec64e0-2407-4b99-b19a-00023e463f48",
                                                "sense_id": "da32e194-0efa-3dbb-bdd0-d1358e473d18",
                                                "text": "It made one sorry to see the extraordinary quantity of cattle, horses, goats, and other things, as houses and estates all sold for less than nothing, in their anxiety to set out on the road and have some ready money in their hands to help the 'holy Councillor' in his mad enterprise."
                                            },
                                            {
                                                "example_id": "df9cc2c3-1eab-4c19-8256-cfc5db90f868",
                                                "sense_id": "da32e194-0efa-3dbb-bdd0-d1358e473d18",
                                                "text": "Any of the fettlers were better off in respect to ready-money than he was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4069bffc-f43d-449c-a613-3302280fa283",
                        "source_entry_id": "96c8530b-6a7e-3766-a0c2-984e662e8274",
                        "source_sense_id": "0764953c-b26a-3b47-bd6b-00e357ed00c5",
                        "source_sense_description": "das gesamte Bargeld, das jemand besitzt",
                        "target_lang_word": "argent liquide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argent liquide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c04edb0f-6a91-39f5-bf0e-a6777d614d33",
                                        "entry_id": "97d4d18f-ea92-3f20-a72a-6c37eff9f862",
                                        "glosses": [
                                            "Argent immédiatement utilisable, car sous forme de monnaie (pièces ou billets de banque)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7cdb0a-f9e6-4cdd-a1bb-45fce29b2966",
                                                "sense_id": "c04edb0f-6a91-39f5-bf0e-a6777d614d33",
                                                "text": "Ce petit hobereau débuta avec presque rien et s’acquit promptement la réputation de pique-assiette : mais à sa mort il possédait quelque cent mille roubles d’argent liquide."
                                            }
                                        ]
