                    {
                        "translation_id": "49989cdc-c149-4389-ae5a-636da25e769c",
                        "source_entry_id": "98c73c76-8cca-3168-bff2-fdac3058ac8c",
                        "target_lang_word": "tödlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tödlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                        "entry_id": "12d6027f-de94-3ac7-85dd-195d0bca7e42",
                                        "glosses": [
                                            "zum Tod führend; den Tod zur Folge habend"
                                        ],
                                        "tags": [
                                            "auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7311671-022f-4df9-8509-b3a06cbc0599",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Die Überschwemmungen und Erdrutsche in der vergangenen Woche im Bundesstaat Rio sind die tödlichste Naturkatastrophe [= die Naturkatastrophe mit den meisten Todesopfern] in Brasilien seit 1900.“"
                                            },
                                            {
                                                "example_id": "3abbf7f2-d9e9-4e92-8237-787ca8956862",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Nach der tödlichen Messerattacke auf einen Familienvater aus Herda (Wartburgkreis) hat der verdächtige 18-Jährige die Tat gestanden.“"
                                            },
                                            {
                                                "example_id": "f734bb8f-8fb2-4b90-9d1d-62cb65b1df58",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "[Nordirland, 2009:] „Am Montag wurde ein Polizist bei einem Feuerüberfall tödlich verwundet.“"
                                            },
                                            {
                                                "example_id": "e6c275f6-2438-4c40-8d65-42b762783ddd",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Ein britischer Basejumper ist am Montag im Lauterbrunnental in der Schweiz tödlich verunglückt.“"
                                            },
                                            {
                                                "example_id": "81ac80d7-f908-448c-8959-785a7f0234b2",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Kinder sind ausgeprägte Sinnsucher; insofern ist auch bei diesem unglückseligen Vorfall zunächst nicht von einem Wegwerfen des Lebens auszugehen, sondern von einer – wenn auch hilflosen, vielleicht pervertierten- Sinnsuche, die in einem tödlichen Unfall endete.“"
                                            },
                                            {
                                                "example_id": "53646f57-6d7f-4056-ad25-0ac1e95258aa",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Ihre Prozesse aber führen sie mit tödlich bitterem Haß und mit wahnwitziger Gier, Rache zu nehmen und Schaden zu tun […].“"
                                            },
                                            {
                                                "example_id": "224de428-49af-47b9-b2c8-c169fe0f644c",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "21222cea-0d3b-4f94-a1ed-d4845f5634be",
                                                "sense_id": "0699057d-86d3-32e6-b926-9a26f1946166",
                                                "text": "„In immer mehr Gärten bearbeiten [Mähroboter] den Rasen. Für Igel endet das oft tödlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcef3437-b930-3e2e-8280-872ef8c488a0",
                                        "entry_id": "12d6027f-de94-3ac7-85dd-195d0bca7e42",
                                        "glosses": [
                                            "ausgeprägt; heftig"
                                        ],
                                        "tags": [
                                            "nur attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d8abf0c-4595-468c-8202-22d128ee36a8",
                                                "sense_id": "dcef3437-b930-3e2e-8280-872ef8c488a0",
                                                "text": "Zunächst ist die Fahrt von tödlicher Langeweile geprägt, doch als Mann einen riesigen Tanklaster überholt […] wird die bisher recht unspektakuläre Reise zum reinen Horrortrip."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8e8c1b6-adb9-303e-b8d7-ddf264afb85b",
                                        "entry_id": "12d6027f-de94-3ac7-85dd-195d0bca7e42",
                                        "glosses": [
                                            "sehr; in heftiger Weise"
                                        ],
                                        "tags": [
                                            "nur adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b39584a-f753-4979-a59d-f734e9ca05ec",
                                                "sense_id": "c8e8c1b6-adb9-303e-b8d7-ddf264afb85b",
                                                "text": "Die Kinder langweilten sich auf der langen Fahrt tödlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
