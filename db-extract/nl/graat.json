                                                "sense_id": "89735056-723c-3395-a0d5-eafc53ac48f6",
                                                "text": "Ich habe mir die Gräten gebrochen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
