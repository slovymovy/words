{
    "word_family": [
        "prizewinner",
        "prizefight",
        "prizeworthy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ae9f62d-558f-3d03-af68-dcdf000d2f43",
                    "sense_definition": "An award or reward given to the winner of a competition or contest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was very happy to win the first <w>prize</w> in the school art competition.",
                            "target_lang_translations": {
                                "ru": "Она была очень счастлива выиграть первый <w>приз</w> в школьном художественном конкурсе."
                            }
                        },
                        {
                            "text": "The <w>prize</w> money will be shared equally among all the team members.",
                            "target_lang_translations": {
                                "ru": "<w>Призовые</w> деньги будут разделены поровну между всеми членами команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "prise"
                    ],
                    "antonyms": [
                        "penalty",
                        "punishment"
                    ],
                    "common_phrases": [
                        "win a prize",
                        "prize money",
                        "first prize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награда или поощрение, вручаемое победителю соревнования или конкурса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приз",
                                "target_lang_sense_clarification": "награда в состязании"
                            },
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "за заслуги или победу"
                            },
                            {
                                "target_lang_word": "премия",
                                "target_lang_sense_clarification": "денежное или материальное поощрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0d75d64-feec-370c-8a0a-0bca5a93fe6e",
                    "sense_definition": "Something very valuable that is worth working hard to achieve or obtain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "valuable_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many athletes, an Olympic gold medal is the ultimate <w>prize</w> of their career.",
                            "target_lang_translations": {
                                "ru": "Для многих атлетов олимпийская золотая медаль — это главная <w>награда</w> в их карьере."
                            }
                        },
                        {
                            "text": "The young diplomat kept his eyes on the <w>prize</w> during the difficult negotiations.",
                            "target_lang_translations": {
                                "ru": "Молодой дипломат не упускал из виду свою <w>цель</w> во время трудных переговоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eyes on the prize",
                        "ultimate prize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то очень ценное, ради чего стоит усердно работать или чего стоит добиваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "ценный результат усилий"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "заветный результат"
                            },
                            {
                                "target_lang_word": "трофей",
                                "target_lang_sense_clarification": "ценное достижение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ace1b65-a61e-3461-893f-816f279d09ab",
                    "sense_definition": "A reward or sum of money that is won by luck or chance, such as in a lottery.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "award",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He couldn't believe he had won the top <w>prize</w> in the national lottery.",
                            "target_lang_translations": {
                                "ru": "Он не мог поверить, что выиграл главный <w>приз</w> в национальной лотерее."
                            }
                        },
                        {
                            "text": "The raffle offers a <w>prize</w> draw every Saturday for all ticket holders.",
                            "target_lang_translations": {
                                "ru": "Лотерея предлагает <w>розыгрыш</w> призов каждую субботу для всех владельцев билетов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prize draw",
                        "lottery prize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награда или сумма денег, выигранная благодаря удаче или случаю, например, в лотерее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выигрыш",
                                "target_lang_sense_clarification": "в лотерее или игре"
                            },
                            {
                                "target_lang_word": "приз",
                                "target_lang_sense_clarification": "случайная награда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acf483b2-3c40-31eb-8cf1-395d558a7fc0",
                    "sense_definition": "An enemy ship or property captured at sea during a war.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naval crew brought the captured merchant vessel back to port as a <w>prize</w> of war.",
                            "target_lang_translations": {
                                "ru": "Экипаж военного корабля привел захваченное торговое судно обратно в порт в качестве военного <w>трофея</w>."
                            }
                        },
                        {
                            "text": "The captain claimed the enemy frigate as his <w>prize</w> after the long battle.",
                            "target_lang_translations": {
                                "ru": "Капитан объявил вражеский фрегат своим <w>призом</w> после долгого сражения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prize of war"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вражеский корабль или имущество, захваченное в море во время войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приз",
                                "target_lang_sense_clarification": "морской трофей"
                            },
                            {
                                "target_lang_word": "трофей",
                                "target_lang_sense_clarification": "военная добыча"
                            },
                            {
                                "target_lang_word": "добыча",
                                "target_lang_sense_clarification": "захваченное силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "075cb82e-2b2c-3850-a7ba-800fd779c466",
                    "sense_definition": "A tool used as a lever to move or open something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a heavy iron bar as a <w>prize</w> to lift the stone slab.",
                            "target_lang_translations": {
                                "ru": "Он использовал тяжелый железный прут в качестве <w>рычага</w>, чтобы поднять каменную плиту."
                            }
                        },
                        {
                            "text": "The worker adjusted the <w>prize</w> to get a better grip on the wooden crate.",
                            "target_lang_translations": {
                                "ru": "Рабочий поправил <w>рычаг</w>, чтобы получше зацепить деревянный ящик."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, используемый в качестве рычага для перемещения или открытия чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "приспособление для поднятия тяжестей"
                            },
                            {
                                "target_lang_word": "лом",
                                "target_lang_sense_clarification": "инструмент для вскрытия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be95cd6d-b301-35cf-bf2b-d76d9224db3f",
                    "sense_definition": "To value something very highly or to have a lot of respect for it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In our culture, we <w>prize</w> honesty and hard work above all other qualities.",
                            "target_lang_translations": {
                                "ru": "В нашей культуре мы <w>ценим</w> честность и трудолюбие превыше всех остальных качеств."
                            }
                        },
                        {
                            "text": "She <w>prized</w> her independence and refused to let anyone make decisions for her.",
                            "target_lang_translations": {
                                "ru": "Она <w>дорожила</w> своей независимостью и не позволяла никому принимать решения за нее."
                            }
                        }
                    ],
                    "synonyms": [
                        "prise"
                    ],
                    "antonyms": [
                        "despise",
                        "disregard"
                    ],
                    "common_phrases": [
                        "highly prized"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень высоко ценить что-либо или относиться к чему-либо с большим уважением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценить",
                                "target_lang_sense_clarification": "дорожить чем-либо"
                            },
                            {
                                "target_lang_word": "высоко ставить",
                                "target_lang_sense_clarification": "придавать большое значение"
                            },
                            {
                                "target_lang_word": "дорожить",
                                "target_lang_sense_clarification": "относиться с любовью и заботой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9bb37e8-40c8-3819-b506-7260e041b699",
                    "sense_definition": "To use force or a tool to pull something apart or open.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The burglars tried to <w>prize</w> open the window with a screwdriver.",
                            "target_lang_translations": {
                                "ru": "Грабители пытались <w>вскрыть</w> окно с помощью отвертки."
                            }
                        },
                        {
                            "text": "It was difficult to <w>prize</w> the secret information out of the reluctant witness.",
                            "target_lang_translations": {
                                "ru": "Было трудно <w>вытянуть</w> секретную информацию из неохотно идущего на контакт свидетеля."
                            }
                        }
                    ],
                    "synonyms": [
                        "prise"
                    ],
                    "common_phrases": [
                        "prize open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать силу или инструмент, чтобы раздвинуть или открыть что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вскрывать",
                                "target_lang_sense_clarification": "с помощью рычага"
                            },
                            {
                                "target_lang_word": "выламывать",
                                "target_lang_sense_clarification": "применяя силу"
                            },
                            {
                                "target_lang_word": "отжимать",
                                "target_lang_sense_clarification": "инструментом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bd950e3-5f4c-300c-b49e-becb395ae646",
                    "sense_definition": "Describing something that has won a competition or is good enough to win one.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer proudly displayed his <w>prize</w> bull at the county fair.",
                            "target_lang_translations": {
                                "ru": "Фермер с гордостью демонстрировал своего <w>лучшего</w> быка на окружной ярмарке."
                            }
                        },
                        {
                            "text": "She grew a <w>prize</w> pumpkin that weighed more than fifty kilograms.",
                            "target_lang_translations": {
                                "ru": "Она вырастила <w>первоклассную</w> тыкву, которая весила более пятидесяти килограммов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prize winning",
                        "prize bull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает что-то, что выиграло соревнование или достаточно хорошо, чтобы победить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "высшего качества"
                            },
                            {
                                "target_lang_word": "лучший",
                                "target_lang_sense_clarification": "достойный награды"
                            },
                            {
                                "target_lang_word": "выставочный",
                                "target_lang_sense_clarification": "о животных или растениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8debc8b-fa25-372e-bdb0-6362df87eccd",
                    "sense_definition": "Used to emphasize that someone or something is a complete or extreme example of a quality, often a negative one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>prize</w> idiot after realizing he had forgotten his own birthday.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>набитым</w> дураком, осознав, что забыл про собственный день рождения."
                            }
                        },
                        {
                            "text": "That was a <w>prize</w> example of how not to manage a business meeting.",
                            "target_lang_translations": {
                                "ru": "Это был <w>классический</w> пример того, как не следует проводить деловую встречу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prize idiot",
                        "prize fool"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for emphasis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания того, что кто-то или что-то является полным или крайним примером качества, часто отрицательного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первостатейный",
                                "target_lang_sense_clarification": "выдающийся в своем роде"
                            },
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "для усиления"
                            },
                            {
                                "target_lang_word": "законченный",
                                "target_lang_sense_clarification": "о негативных качествах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}