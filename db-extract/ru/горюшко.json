                        "examples": [
                            {
                                "example_id": "f32f90c4-a9b9-4af2-8785-7d1d5ac79bcd",
                                "sense_id": "96bbf547-52a6-3673-863a-fec7437191a9",
                                "text": "Вот я безотлучно в хлеву живу — и горюшка мало!"
                            },
                            {
                                "example_id": "157be79d-b2c7-4c8a-82af-52deeb18a45e",
                                "sense_id": "96bbf547-52a6-3673-863a-fec7437191a9",
                                "text": "Егорушка, да ништо ты умер! Ой, горюшко, ― уж и рученьки холодные."
                            },
                            {
                                "example_id": "2efeafd4-bbfb-4d2b-87d7-927d085f3fd9",
                                "sense_id": "96bbf547-52a6-3673-863a-fec7437191a9",
                                "text": "Хлебнул я горюшка с этим дитём."
                            }
                        ]
                    }
