                                "target_senses": [
                                    {
                                        "sense_id": "0ad135b0-eaf7-3121-b406-5fa0bfa78254",
                                        "entry_id": "61e80d14-eeda-3b18-950b-d5f2ca336beb",
                                        "glosses": [
                                            "Of or pertaining to sweat; caused by sweat; characterised by the production of sweat."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f12cb5e0-3557-435b-b157-5a5062b83e83",
                                                "sense_id": "0ad135b0-eaf7-3121-b406-5fa0bfa78254",
                                                "text": "sudoral eruptions"
                                            },
                                            {
                                                "example_id": "9be2b2b2-b166-486b-8ed0-7874e8949e21",
                                                "sense_id": "0ad135b0-eaf7-3121-b406-5fa0bfa78254",
                                                "text": "If an individual sweat profusely, even though he is in the plenitude of health, these special sudoral efflorescences will be observed: they will at times be very painful, and may bear the aspect of measles, roseola, urticaria &c."
                                            },
                                            {
                                                "example_id": "daf4f8a3-7028-412a-9326-fd412641a034",
                                                "sense_id": "0ad135b0-eaf7-3121-b406-5fa0bfa78254",
                                                "text": "1875, Prof. Vulpian, Physiology—The Action of Jaborandi and of Atropine upon the Perspiration, Saint Louis Clinical Record, Volumes 1-2, page 38 (of volume 2),\nI think that the same reasoning applies to the action of atropine and jaborandi upon the sudoral secretion."
                                            },
                                            {
                                                "example_id": "d03f2edb-98bc-43ee-8388-d4dc57e1df68",
                                                "sense_id": "0ad135b0-eaf7-3121-b406-5fa0bfa78254",
                                                "text": "The average duration of sudoral typhoid is therefore about five weeks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
