            "senses": [
                {
                    "sense_id": "fb92559a-616f-3ff1-be99-d8ed34f586bd",
                    "sense_definition": "Sentiment de sa propre valeur, estime et respect légitime de soi-même.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a refusé cette offre humiliante par simple <w>amour-propre</w> et respect pour son travail."
                        },
                        {
                            "text": "Un minimum d'<w>amour-propre</w> est indispensable pour surmonter les échecs et avancer dans la vie."
                        }
                    ],
                    "synonyms": [
                        "auto-estime",
                        "fierté"
                    ],
                    "common_phrases": [
                        "avoir de l'amour-propre",
                        "manquer d'amour-propre",
                        "garder son amour-propre"
                    ]
                },
                {
                    "sense_id": "733e9b39-1b47-39eb-9415-2421a440652d",
                    "sense_definition": "Opinion trop avantageuse de soi-même, vanité ou susceptibilité attachée à sa personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette remarque désobligeante a profondément blessé son <w>amour-propre</w> devant tous ses collègues."
                        },
                        {
                            "text": "Il a refusé d'admettre son erreur par pur <w>amour-propre</w> et orgueil mal placé."
                        }
                    ],
                    "synonyms": [
                        "orgueil",
                        "susceptibilité",
                        "vanité"
                    ],
                    "common_phrases": [
                        "blesser l'amour-propre",
                        "flatter l'amour-propre",
                        "question d'amour-propre"
                    ]
                },
                {
                    "sense_id": "7703f167-aa3e-3ae5-a364-8c82eb3f917a",
                    "sense_definition": "Préoccupation exclusive de sa propre personne et de son intérêt personnel au détriment d'autrui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poussé par un <w>amour-propre</w> excessif, il ne se souciait guère du sort de ses compagnons."
                        },
                        {
                            "text": "Dans ce texte philosophique, l'<w>amour-propre</w> désigne la recherche constante et exclusive de ses intérêts."
                        }
                    ],
                    "synonyms": [
                        "égocentrisme",
                        "égoïsme",
                        "individualisme"
                    ]
                }
            ]
        }
