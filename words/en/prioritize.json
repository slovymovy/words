{
    "word_family": [
        "priority",
        "prioritization"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a21fafcd-fc0f-3763-97e2-d4f73151201b",
                    "sense_definition": "To treat something as more important than other things and deal with it first.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>prioritize</w> your health over working late hours.",
                            "target_lang_translations": {
                                "zh": "你应该<w>优先考虑</w>健康，而不是熬夜工作。"
                            }
                        },
                        {
                            "text": "Successful students learn to <w>prioritize</w> their tasks to meet deadlines.",
                            "target_lang_translations": {
                                "zh": "成功的学生学会<w>优先处理</w>任务以按时完成工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prefer",
                        "rank"
                    ],
                    "antonyms": [
                        "marginalize"
                    ],
                    "common_phrases": [
                        "prioritize tasks",
                        "prioritize needs"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某事视为比其他事物更重要，并优先处理。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "优先考虑",
                                "target_lang_sense_clarification": "指在决策或行动中将某事置于首位。"
                            },
                            {
                                "target_lang_word": "优先处理",
                                "target_lang_sense_clarification": "指在时间或资源分配上先解决某项任务。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca2fb89d-a8fd-3951-b01a-e5e2648f5542",
                    "sense_definition": "To organize a list of items based on their level of importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>prioritize</w> the list of repairs needed for the building.",
                            "target_lang_translations": {
                                "zh": "请将大楼所需的维修项目<w>按重要性排序</w>。"
                            }
                        },
                        {
                            "text": "Managers must <w>prioritize</w> projects to ensure the team stays focused.",
                            "target_lang_translations": {
                                "zh": "经理必须对项目<w>按重要性排序</w>，以确保团队保持专注。"
                            }
                        }
                    ],
                    "synonyms": [
                        "order",
                        "arrange"
                    ],
                    "common_phrases": [
                        "prioritize list"
                    ],
                    "target_lang_definitions": {
                        "zh": "根据重要程度对一系列项目进行排序。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "按重要性排序",
                                "target_lang_sense_clarification": "指根据轻重缓急对清单进行整理。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}