                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "harować",
                                "target_lang_sense_clarification": "w czasie przeszłym: harował, harowała"
                            },
                            {
                                "target_lang_word": "ciężko pracować",
                                "target_lang_sense_clarification": "w czasie przeszłym: ciężko pracował, pracowała"
                            },
                            {
                                "target_lang_word": "mozolić się",
                                "target_lang_sense_clarification": "w czasie przeszłym: mozolił się, mozoliła się"
                            },
                            {
                                "target_lang_word": "trudzić się",
                                "target_lang_sense_clarification": "w czasie przeszłym: trudził się, trudziła się"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d0c97db-9712-3740-885b-2bce179db8bf",
                    "sense_definition": "produced or done with great effort, difficulty, or strain; not natural or spontaneous",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effortful_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient sat upright because of his slow and <w>labored</w> breathing.",
                            "target_lang_translations": {
                                "pl": "Pacjent siedział prosto z powodu powolnego i <w>ciężkiego</w> oddechu."
                            }
                        },
                        {
                            "text": "Her <w>labored</w> explanation made it obvious that she was hiding something from us.",
                            "target_lang_translations": {
                                "pl": "Jej <w>wymuszone</w> wyjaśnienia jasno wskazywały, że coś przed nami ukrywa."
                            }
                        }
                    ],
                    "synonyms": [
                        "forced",
                        "strained",
                        "ponderous"
                    ],
                    "antonyms": [
                        "effortless",
                        "natural",
                        "easy"
                    ],
                    "common_phrases": [
                        "labored breathing",
                        "labored breath"
                    ],
                    "target_lang_definitions": {
                        "pl": "wykonywany z wielkim trudem, wysiłkiem lub nienaturalny, wymuszony"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ciężki",
                                "target_lang_sense_clarification": "o oddechu lub wysiłku"
                            },
                            {
                                "target_lang_word": "wymuszony",
                                "target_lang_sense_clarification": "nienaturalny, nieszczery"
                            },
                            {
                                "target_lang_word": "utrudniony",
                                "target_lang_sense_clarification": "np. oddech, ruch"
                            },
                            {
                                "target_lang_word": "wysilony",
                                "target_lang_sense_clarification": "zrobiony ze zbyt wielkim wysiłkiem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
