                                        "sense_id": "e29848ea-e7ab-3806-8ca3-32234ca128c4",
                                        "entry_id": "2f3a6e2b-1017-32cc-91cd-a8eacf53cc01",
                                        "glosses": [
                                            "An administrative division of an area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a3319b-6cd1-4aea-b98d-bef6c3466a4a",
                                                "sense_id": "e29848ea-e7ab-3806-8ca3-32234ca128c4",
                                                "text": "‘I understand that the district was considered a sort of sanctuary,’ the Chief was saying. ‘An Alsatia like the ancient one behind the Strand, or the Saffron Hill before the First World War.[…]’"
                                            },
                                            {
                                                "example_id": "41dda824-a88d-4b86-b0f8-f45fe2fa4349",
                                                "sense_id": "e29848ea-e7ab-3806-8ca3-32234ca128c4",
