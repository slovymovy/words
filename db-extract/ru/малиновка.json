                                        "entry_id": "ed810f45-3884-3dcf-913e-7a99ed62e748",
                                        "glosses": [
                                            "Any of various passerine birds (about 100 species) of the families Muscicapidae, Turdidae and Petroicidae (formerly Eopsaltriidae), typically with a red breast.",
                                            "A European robin, Erithacus rubecula."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154945f6-6d3b-4525-a05d-e045312595a8",
                                                "sense_id": "1a473cb6-5acf-3c53-989d-e9d6cfe13df4",
                                                "text": "As they turned into Hertford Street they startled a robin from the poet's head on a barren fountain, and he fled away with a cameo note."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6cd1333-8219-3b13-ae4f-2ce82eef0def",
                                        "entry_id": "ed810f45-3884-3dcf-913e-7a99ed62e748",
                                        "glosses": [
