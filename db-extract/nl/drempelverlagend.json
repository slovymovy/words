                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675b5868-51a5-472d-933d-fd2cc5fdb4f3",
                                "sense_id": "5d3f5695-e74a-38c4-9e20-d96f5657fde3",
                                "text": "Diëtiste Ans Menger: „Zo’n open dag is drempelverlagend voor de mensen. Bij een diëtist hebben ze vaak het beeld van iemand die achter een tafeltje met een vinger zwaait wat allemaal niet mag. Nu heb je direct contact en mensen, zoals hier in het verzorgingshuis, weten wie je bent en maken makkelijker een afspraak.”"
                            },
                            {
                                "example_id": "a2a22d08-b0dd-4512-960a-a639010a38f8",
                                "sense_id": "5d3f5695-e74a-38c4-9e20-d96f5657fde3",
                                "text": "De Orde van Advocaten vindt dat 'no cure, no pay' drempelverlagend kan werken voor mensen die hun recht nu niet zoeken omdat ze de advocaatkosten te hoog vinden."
                            },
                            {
                                "example_id": "5f66911d-145d-4c8c-81fe-487fdd33c29b",
                                "sense_id": "5d3f5695-e74a-38c4-9e20-d96f5657fde3",
                                "text": "Het hof volgt de uitspraak van een van de deskundigen, die concludeerde dat het medicijn mogelijk drempelverlagend heeft gewerkt, maar van een delier of toxische vergiftiging was geen sprake."
                            }
                        ]
                    }
