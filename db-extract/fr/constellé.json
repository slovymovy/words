                                "target_senses": [
                                    {
                                        "sense_id": "9882cf76-0bca-31a2-9b8a-f4cf9c8a134f",
                                        "entry_id": "3d7dd8fd-217e-3fb4-a0bf-95106bee2cd1",
                                        "glosses": [
                                            "астрон. относящийся к небесному телу, выглядящему как светящаяся точка на небесном своде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c097d7c-bca1-45d9-8ce7-90d8583d2722",
                                                "sense_id": "9882cf76-0bca-31a2-9b8a-f4cf9c8a134f",
                                                "text": "Распахнутая звёздная карта не так уж сильно как будто изменилась с тех пор, как финикийцы или египтяне впервые вышли в Атлантику."
                                            },
                                            {
                                                "example_id": "20b65de1-14b4-41cb-b6f9-6a9baf2b5acc",
                                                "sense_id": "9882cf76-0bca-31a2-9b8a-f4cf9c8a134f",
                                                "text": "Звёздное скопление."
                                            },
                                            {
                                                "example_id": "c8f93bb0-9152-421f-8f0e-79542a7a6657",
                                                "sense_id": "9882cf76-0bca-31a2-9b8a-f4cf9c8a134f",
                                                "text": "Звёздная система."
                                            },
                                            {
                                                "example_id": "d206af5b-48ba-4c5f-87c8-b9255da2a1dc",
                                                "sense_id": "9882cf76-0bca-31a2-9b8a-f4cf9c8a134f",
                                                "text": "Звёздные кучи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eda1f00-2d49-3132-b77f-2a86339d9eff",
                                        "entry_id": "3d7dd8fd-217e-3fb4-a0bf-95106bee2cd1",
                                        "glosses": [
                                            "астрон. относящийся к периоду вращения или обращения космического тела относительно далёких звёзд, принимаемых за инерциальную систему отсчёта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "724e889b-4a41-422d-b40b-4074644c866b",
                                                "sense_id": "4eda1f00-2d49-3132-b77f-2a86339d9eff",
                                                "text": "Звёздные сутки."
                                            },
                                            {
                                                "example_id": "122d3372-4715-4f5b-a287-7ab2904262dd",
                                                "sense_id": "4eda1f00-2d49-3132-b77f-2a86339d9eff",
                                                "text": "Звёздный месяц."
                                            },
                                            {
                                                "example_id": "c7e894b8-2a1c-4ea6-997c-8be2e3ef39da",
                                                "sense_id": "4eda1f00-2d49-3132-b77f-2a86339d9eff",
                                                "text": "Звёздный год."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2cafbce-10bb-39d7-b188-c372e2819348",
                                        "entry_id": "3d7dd8fd-217e-3fb4-a0bf-95106bee2cd1",
                                        "glosses": [
                                            "покрытый, усеянный звёздами; со множеством звёзд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525f9829-a196-4905-b4b8-6d3f2537f330",
                                                "sense_id": "a2cafbce-10bb-39d7-b188-c372e2819348",
                                                "text": "Ночь была тихой и звёздной."
                                            },
                                            {
                                                "example_id": "4d72b1fe-fbba-43e3-86fc-8f1e6972f308",
                                                "sense_id": "a2cafbce-10bb-39d7-b188-c372e2819348",
                                                "text": "Г. Проницательный был прославлен фразой: «Оорт первый взглянул на звёздное небо и заметил, что Галактика вращается»."
                                            },
                                            {
                                                "example_id": "f44be012-38e9-488f-ba4f-8c7d21dd334a",
                                                "sense_id": "a2cafbce-10bb-39d7-b188-c372e2819348",
                                                "text": "Светящееся звёздное пространство океаном повисло над головой Иоганна, он окунулся в белый мрак облачности, а потом в тёмные сумерки ночи."
                                            },
                                            {
                                                "example_id": "28bf17e4-23e2-4b38-82ad-f5964dedc3bc",
                                                "sense_id": "a2cafbce-10bb-39d7-b188-c372e2819348",
                                                "text": "Над ним, обрезанный тёмными тенями ветвей, мерцал звёздный туман, клубясь по высокому, неистово синему своду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32709082-84ac-365c-8abc-d99468eecd90",
                                        "entry_id": "3d7dd8fd-217e-3fb4-a0bf-95106bee2cd1",
                                        "glosses": [
                                            "перен. относящийся к знаменитостям, известным личностям"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df8fca9e-f978-32fd-b048-70c33bf6858e",
                                        "entry_id": "3d7dd8fd-217e-3fb4-a0bf-95106bee2cd1",
                                        "glosses": [
                                            "поэт. украшенный звёздами, с изображением звёзд"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
