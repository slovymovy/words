                                    {
                                        "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                        "entry_id": "5b41c3dc-278d-3d42-bca6-44d6410096d9",
                                        "glosses": [
                                            "so, dass man es körperlich wahrnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab8f933-8fff-408a-a034-4c421c6593fe",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "Der Schlag war zwar schwach, aber noch spürbar."
                                            },
                                            {
                                                "example_id": "132ba6bb-c18f-40e9-a276-17fe53866136",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "Es wird zu spürbaren Kürzungen der Sozialleistungen kommen."
                                            },
                                            {
                                                "example_id": "ae131761-2520-4f5d-a62a-18d326bdc357",
                                                "sense_id": "9ac78cfe-0c72-3967-a6e6-90ed5e91b1eb",
                                                "text": "„Die spürbarsten Einschnitte für Normalverdiener gibt es beim Elterngeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ba8dc88f-a38c-3df7-a5a7-e4bc2b818ded",
