{
    "word_family": [
        "explicitly",
        "explicitness",
        "explicate",
        "explication"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                    "sense_definition": "Stated clearly and in detail, leaving no room for confusion or doubt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I gave <w>explicit</w> instructions for him to stay here, but he followed me anyway.",
                            "target_lang_translations": {
                                "ru": "Я дал ему <w>чёткие</w> указания оставаться здесь, но он всё равно пошёл за мной."
                            }
                        },
                        {
                            "text": "The manager provided an <w>explicit</w> statement regarding the new safety protocols to ensure everyone understood.",
                            "target_lang_translations": {
                                "ru": "Менеджер сделал <w>недвусмысленное</w> заявление относительно новых протоколов безопасности, чтобы все всё поняли."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "direct",
                        "specific",
                        "unambiguous",
                        "unequivocal"
                    ],
                    "antonyms": [
                        "implicit",
                        "vague",
                        "ambiguous",
                        "implied"
                    ],
                    "common_phrases": [
                        "explicit instructions",
                        "explicit statement",
                        "explicit detail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изложенный ясно и подробно, не оставляющий места для путаницы или сомнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёткий",
                                "target_lang_sense_clarification": "ясный и точный"
                            },
                            {
                                "target_lang_word": "явный",
                                "target_lang_sense_clarification": "определённый и недвусмысленный"
                            },
                            {
                                "target_lang_word": "подробный",
                                "target_lang_sense_clarification": "содержащий все детали"
                            },
                            {
                                "target_lang_word": "недвусмысленный",
                                "target_lang_sense_clarification": "имеющий только одно значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                    "sense_definition": "Describing or showing graphic material, such as violence or sex, in a very direct way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "content_rating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was rated R because it contained several scenes with <w>explicit</w> language and violence.",
                            "target_lang_translations": {
                                "ru": "Фильму был присвоен рейтинг R, так как в нём было несколько сцен с <w>откровенной</w> лексикой и насилием."
                            }
                        },
                        {
                            "text": "Parents are often warned about <w>explicit</w> content in modern music and television shows.",
                            "target_lang_translations": {
                                "ru": "Родителей часто предупреждают об <w>откровенном</w> контенте в современной музыке и телешоу."
                            }
                        }
                    ],
                    "synonyms": [
                        "raunchy",
                        "overt"
                    ],
                    "common_phrases": [
                        "explicit content",
                        "explicit language",
                        "explicit scenes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий или показывающий графические материалы, такие как насилие или секс, в очень прямой и открытой форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "содержащий непристойные или шокирующие детали"
                            },
                            {
                                "target_lang_word": "графичный",
                                "target_lang_sense_clarification": "детально изображённый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "112b7670-c421-32ab-8dd2-c5e2d7ab7a2a",
                    "sense_definition": "The final words of a manuscript or early printed book.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textual_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar examined the <w>explicit</w> to determine the date the scribe finished the work.",
                            "target_lang_translations": {
                                "ru": "Учёный изучил <w>эксплицит</w>, чтобы определить дату, когда писец закончил работу."
                            }
                        },
                        {
                            "text": "Unlike the opening incipit, the <w>explicit</w> often contains a short prayer of thanks from the author.",
                            "target_lang_translations": {
                                "ru": "В отличие от начального инципита, <w>эксплицит</w> часто содержит краткую благодарственную молитву автора."
                            }
                        }
                    ],
                    "antonyms": [
                        "incipit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in the context of historical manuscripts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительные слова рукописи или ранней печатной книги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эксплицит",
                                "target_lang_sense_clarification": "термин в палеографии для обозначения концовки текста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}