                            {
                                "example_id": "12849d8d-663b-4d92-be4b-ac1d00cb90b0",
                                "sense_id": "6a02915e-ac05-39b8-b671-f481af9caf7f",
                                "text": "De kat zoekt een nieuw baasje of bazinnetje."
                            },
                            {
                                "example_id": "3a07e3bf-670c-4ad0-9f0f-3a6712284bae",
                                "sense_id": "6a02915e-ac05-39b8-b671-f481af9caf7f",
                                "text": "Aan de bar dronk ik samen met de bazin van het café een biertje."
                            },
                            {
                                "example_id": "269a7bcd-962f-4831-bcf4-b23d76703b19",
                                "sense_id": "6a02915e-ac05-39b8-b671-f481af9caf7f",
                                "text": "Met zijn linkerhand hield Isaac de kip stil op de houten vloer. Ze maakte een gedempt tokgeluidje en zocht verwoed naar de koelte van de tas van haar bazin."
                            }
                        ]
                    }
