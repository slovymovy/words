{
    "word_family": [
        "hike",
        "hiker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5daa97fb-1d9d-3a7a-a8fc-e1e90ad360bd",
                    "sense_definition": "Walking in the countryside for pleasure or sport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to go <w>hiking</w> in the mountains this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы планируем пойти в <w>поход</w> в горы в эти выходные.",
                                "zh": "我们计划这个周末去山上<w>徒步</w>。"
                            }
                        },
                        {
                            "text": "You need sturdy boots for <w>hiking</w> on rough terrain.",
                            "target_lang_translations": {
                                "ru": "Вам нужны прочные ботинки для <w>пеших походов</w> по пересеченной местности.",
                                "zh": "在崎岖的地形上<w>徒步</w>时，你需要结实的靴子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trekking",
                        "rambling",
                        "walking"
                    ],
                    "common_phrases": [
                        "go hiking",
                        "hiking trail",
                        "hiking boots",
                        "hiking trip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пешие прогулки или путешествия по сельской местности или горам ради удовольствия или спорта.",
                        "zh": "为了娱乐或运动而在乡村或山区进行的徒步旅行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похо́д",
                                "target_lang_sense_clarification": "организованное путешествие или дальняя прогулка"
                            },
                            {
                                "target_lang_word": "пе́ший тури́зм",
                                "target_lang_sense_clarification": "вид активного отдыха и спорта"
                            },
                            {
                                "target_lang_word": "прогу́лка",
                                "target_lang_sense_clarification": "длительная ходьба на природе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徒步旅行",
                                "target_lang_sense_clarification": "指在自然环境中进行的远足活动"
                            },
                            {
                                "target_lang_word": "远足",
                                "target_lang_sense_clarification": "指长距离的步行活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faa8dc1f-af4a-389d-a589-620a6a2ed9e7",
                    "sense_definition": "The act of raising something sharply, especially prices or costs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>hiking</w> of interest rates surprised the market.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>повышение</w> процентных ставок удивило рынок.",
                                "zh": "利率的突然<w>提高</w>让市场感到意外。"
                            }
                        },
                        {
                            "text": "Consumers complained about the <w>hiking</w> of fuel prices.",
                            "target_lang_translations": {
                                "ru": "Потребители жаловались на <w>повышение</w> цен на топливо.",
                                "zh": "消费者对燃料价格的<w>上涨</w>表示不满。"
                            }
                        }
                    ],
                    "synonyms": [
                        "raising",
                        "increasing"
                    ],
                    "antonyms": [
                        "lowering",
                        "decreasing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по резкому увеличению чего-либо, особенно цен или расходов.",
                        "zh": "指大幅度提高某物，尤指价格或成本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повыше́ние",
                                "target_lang_sense_clarification": "увеличение уровня или стоимости"
                            },
                            {
                                "target_lang_word": "взви́нчивание",
                                "target_lang_sense_clarification": "резкое и значительное повышение цен"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提高",
                                "target_lang_sense_clarification": "指价格或水平的上升"
                            },
                            {
                                "target_lang_word": "涨价",
                                "target_lang_sense_clarification": "特指价格的上涨"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dad614ad-475a-3120-a75b-12c1daba75c8",
                    "sense_definition": "Present participle and gerund of <w>hike</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>hiking</w> through the forest right now.",
                            "target_lang_translations": {
                                "ru": "Они сейчас <w>идут в походе</w> через лес.",
                                "zh": "他们现在正在森林里<w>徒步</w>。"
                            }
                        },
                        {
                            "text": "The company is <w>hiking</w> up the subscription fees next month.",
                            "target_lang_translations": {
                                "ru": "Компания <w>повышает</w> абонентскую плату в следующем месяце.",
                                "zh": "公司下个月要<w>提高</w>订阅费用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hiking up"
                    ],
                    "traits": [
