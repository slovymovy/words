                        "examples": [
                            {
                                "example_id": "1b0848db-32eb-4e9d-aabe-c16b2efe0798",
                                "sense_id": "052a27b0-09f6-3221-bd48-195fd88034e1",
                                "text": "De gezondheidstoestand van de twee Belgische soldaten die woensdagochtend gewond zijn geraakt in Mali, wordt beschouwd als “geruststellend”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33fd6d4d-ac2a-4d37-adcf-a5310eab1816",
                        "source_entry_id": "b31d4ac6-e139-3f54-8479-9aee68356269",
                        "source_sense_id": "052a27b0-09f6-3221-bd48-195fd88034e1",
                        "source_sense_description": "het volledige fysieke, spirituele en sociale welzijn",
                        "target_lang_word": "Gesundheitszustand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesundheitszustand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                        "entry_id": "c78e2894-706c-33ef-8d15-4f954c77318a",
                                        "glosses": [
                                            "Zustand der Gesundheit einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a5aadb-e6d8-4c4c-af00-ef592f0aa086",
                                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                                "text": "Sein Gesundheitszustand ist stabil, wir müssen den Patienten aber weiter beobachten."
                                            },
                                            {
                                                "example_id": "c0358f3b-d7a2-47d7-b2d3-1296601b8c8f",
                                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                                "text": "„Der erschütterte Gesundheitszustand fast aller Kulturvölker der Gegenwart hat seine Ursache im Genuß entwerteter und künstlich verfeinerter Nahrung.“"
                                            },
                                            {
                                                "example_id": "0bf9deab-525d-4b41-b732-e4e6d96fc50f",
                                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                                "text": "„Im Februar 1854 verschlechterte sich sein Gesundheitszustand in dramatischer Weise.“"
                                            },
                                            {
                                                "example_id": "5a810903-4120-4830-9c69-8d066dc1a1f1",
                                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                                "text": "„Die Mutter war an seinem Gesundheitszustand nicht unschuldig.“"
                                            },
                                            {
                                                "example_id": "b84e788e-4325-4304-9ee7-9c31ace5bb3e",
                                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                                "text": "„Hoffmanns Gesundheitszustand ist schlecht, sein Organismus so angegriffen, daß er die Notwendigkeit fühlt, eine Erholungsreise in die Schlesischen Berge zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
