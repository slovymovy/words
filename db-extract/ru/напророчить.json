                    }
                ],
                "translations": [
                    {
                        "translation_id": "156335a2-75df-48e5-b4d2-d72cdf50a1a2",
                        "source_entry_id": "e9ee4187-5833-3a36-8cea-3ce8d7cbe69c",
                        "source_sense_id": "f7a6ecf2-0532-347c-af25-873bdaa6556b",
                        "target_lang_word": "prédire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31580483-7995-31fe-b62c-d0c7926f9774",
                                        "entry_id": "b90718d5-efd9-30b0-aa98-8c5641af7db6",
                                        "glosses": [
                                            "Prophétiser ; annoncer par inspiration divine ce qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed7cd75-fd79-4434-a62a-487041681349",
                                                "sense_id": "31580483-7995-31fe-b62c-d0c7926f9774",
                                                "text": "Les prophètes ont prédit la venue de Jésus-Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b74f4f3e-feea-36bf-a1a5-0e875a4afb9d",
                                        "entry_id": "b90718d5-efd9-30b0-aa98-8c5641af7db6",
                                        "glosses": [
                                            "Annoncer par une prétendue divination qu’une chose doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3c34c9-d58b-42d0-8e54-049b36ec6270",
                                                "sense_id": "b74f4f3e-feea-36bf-a1a5-0e875a4afb9d",
                                                "text": "Je vous demande pardon, mademoiselle , mais il y a aussi des Bohémiennes qui disent la bonne aventure; et elles m'ont prédit que j'aurais deux femmes. Ma première femme est morte, j'ai envie d'en prendre une autre : […]."
                                            },
                                            {
                                                "example_id": "d6f414eb-5eb9-4b19-8183-f5563126ef2b",
                                                "sense_id": "b74f4f3e-feea-36bf-a1a5-0e875a4afb9d",
                                                "text": "Sang-diou ! baronne, dites à cette fille que je ferai sa fortune quand je serai roi de France, comme me le prédisent les astrologues."
                                            },
                                            {
                                                "example_id": "2074dcb3-da35-4490-834e-bdcbd0444296",
                                                "sense_id": "b74f4f3e-feea-36bf-a1a5-0e875a4afb9d",
                                                "text": "Nous avons une bonne dizaine d'années devant nous pour contrer les effets toxiques des prédictions des millénaristes, des bonimenteurs religieux et des prophètes de malheur de toutes sortes qui prédisent un grand cataclysme pour l'an 2000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                                        "entry_id": "b90718d5-efd9-30b0-aa98-8c5641af7db6",
                                        "glosses": [
                                            "Annoncer par des règles certaines une chose qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f6fc48d-f732-429a-b701-c1b56d5bdac0",
                                                "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                                                "text": "Prédire une éclipse."
                                            },
                                            {
                                                "example_id": "020f0017-80fa-4c69-8dcf-ee0b8c6bcd12",
                                                "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                                                "text": "Prédire les grandes marées."
                                            },
                                            {
                                                "example_id": "dfd254da-082a-4d6c-9143-f774098cb04c",
                                                "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                                                "text": "Affirmer qu’on ne sait pas prédire, aujourd'hui, les séismes - réalité, hélas! douloureuse - ne signifie pas que nous ayons renoncé à les prédire un jour."
                                            },
                                            {
                                                "example_id": "bba9424b-5229-407c-be7b-49fc20abd032",
                                                "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                                                "text": "Comment les climatologues pourraient-ils prédire le temps qu’il fera dans 20, 50 ou 100 ans?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                                        "entry_id": "b90718d5-efd9-30b0-aa98-8c5641af7db6",
                                        "glosses": [
                                            "Dire ce qu’on prévoit, par raisonnement et par conjecture, devoir arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ca4258-20a2-412f-a76e-33648b61cfb9",
                                                "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                                                "text": "L'avenir est à ceux qui savent le prédire. Se réformer, c'est se conformer à l'évolution irrésistible et lente des sociétés en marche vers le but inconnu."
                                            },
                                            {
                                                "example_id": "4481a582-ecd0-47d4-acfa-70ecb60bf298",
                                                "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                                                "text": "Voltaire a eu tort de prédire sa disparition en un siècle. La Bible continue son époustouflante odyssée éditoriale, parfois plus lucrative qu’on l’imagine."
                                            },
                                            {
                                                "example_id": "795c8850-8bd5-4989-9144-20743631597a",
                                                "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                                                "text": "Personne ne peut prédire ce qu’il faudra faire à l’avenir pour développer de nouveaux marchés ou se démarquer de la concurrence […]."
                                            },
                                            {
                                                "example_id": "b05d8ffc-1c61-4b7b-b123-fd393661e444",
                                                "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                                                "text": "Au quotidien The Globe and Mail, à Toronto, les commentateurs grimpaient aux rideaux, montaient aux barricades, prédisaient l'érosion, la balkanisation imminente du Canada. Ici ? Presque rien, si peu, bof. Étonnant, non ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e3ab120-5d18-3c48-b652-1d0100b1fc20",
                                        "entry_id": "b90718d5-efd9-30b0-aa98-8c5641af7db6",
                                        "glosses": [
                                            "Présager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8309de0a-58e7-499f-9587-4561a72d1b3b",
                                                "sense_id": "7e3ab120-5d18-3c48-b652-1d0100b1fc20",
                                                "text": "Au crépuscule, le soleil rouge saignait sur la place, comme s’il prédisait l’horrible massacre."
                                            },
                                            {
                                                "example_id": "da16f7af-aa5b-4a1b-a45a-0cf7306149f1",
                                                "sense_id": "7e3ab120-5d18-3c48-b652-1d0100b1fc20",
                                                "text": "L'officier lui prédit un avenir glorieux, et la mère de Méhul conserva toute sa vie le souvenir de cet horoscope."
                                            },
                                            {
                                                "example_id": "feee49cf-9b33-425f-b16e-139830cfafd7",
                                                "sense_id": "7e3ab120-5d18-3c48-b652-1d0100b1fc20",
                                                "text": "Partout dans le monde les manuels scolaires sont quelque peu malmenés, dans des sens divers : les chantres de l'électronique en prédisent la disparition au profit du multimédia ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4461c06-7b96-48bf-a9bd-53bd2aedce0f",
                        "source_entry_id": "e9ee4187-5833-3a36-8cea-3ce8d7cbe69c",
                        "source_sense_id": "f7a6ecf2-0532-347c-af25-873bdaa6556b",
                        "target_lang_word": "prophétiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prophétiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "966bd40b-ee6f-3f01-9a5c-90af8671e2ee",
                                        "entry_id": "6601f8ff-cc2a-383b-81a9-adce9bed8abf",
                                        "glosses": [
                                            "Prédire l’avenir par inspiration divine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b267cf4-0931-4227-b64b-928087496111",
                                                "sense_id": "966bd40b-ee6f-3f01-9a5c-90af8671e2ee",
                                                "text": "Les patriarches ont prophétisé la venue de Jésus-Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e993a3-1a57-3789-ae52-0f8eec080770",
                                        "entry_id": "6601f8ff-cc2a-383b-81a9-adce9bed8abf",
                                        "glosses": [
                                            "Dans le style biblique, ce verbe peut avoir pour complément d’objet direct les gens ou les nations à qui l’on adresse des prophéties qui les concernent."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d2e9616-eae2-4055-ae08-5456ebe26236",
                                                "sense_id": "34e993a3-1a57-3789-ae52-0f8eec080770",
                                                "text": "N’écoutez pas les paroles des prophètes qui vous prophétisent !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904cc05d-5948-3dbd-96f5-755aa9d8872d",
                                        "entry_id": "6601f8ff-cc2a-383b-81a9-adce9bed8abf",
                                        "glosses": [
                                            "Prévoir et dire d’avance ce qui doit arriver."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3804af09-9f20-4ead-950f-a32ea868f0fe",
                                                "sense_id": "904cc05d-5948-3dbd-96f5-755aa9d8872d",
                                                "text": "Le grand-père prit le marmot, il le baisa, le trouva délicieux et ravissant ; il lui parla le parler des nourrices, prophétisa que ce poupard deviendrait plus grand que lui, glissa des flatteries à l’adresse de son fils Hulot, et rendit l’enfant à la grosse Normande chargée de le tenir."
                                            },
                                            {
                                                "example_id": "d5c42c9d-1d1d-4de2-a32b-7afc39f408e4",
                                                "sense_id": "904cc05d-5948-3dbd-96f5-755aa9d8872d",
                                                "text": "Il avait tant fureté, réuni tant d’indices, qu’il aurait pu prophétiser le spectacle qu’offriraient les nouveaux quartiers en 1870."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "705eaca2-f534-44d5-b2d1-591e32356a9e",
                        "source_entry_id": "e9ee4187-5833-3a36-8cea-3ce8d7cbe69c",
                        "source_sense_id": "f7a6ecf2-0532-347c-af25-873bdaa6556b",
                        "target_lang_word": "augurer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "augurer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                        "entry_id": "711fa4e6-54e0-3c6c-8afe-053c33fdd0e9",
                                        "glosses": [
                                            "Pressentir par certaines observations que l’on a faites ou d’après certains signes que l’on a remarqués."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0d38e9-3287-4d19-9486-be58ca076df0",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Je n’augure rien de mauvais pour cette nuit."
                                            },
                                            {
                                                "example_id": "222db9eb-a823-43f5-b801-446238c696a4",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "L’histoire, bien comprise, fait voir que la guerre évolue toujours dans un certain sens, et que cette direction, cent fois reproduite, facile à démêler en somme à travers les broussailles et les enchevêtrements historiques, est propre à nous faire augurer sa future disparition après sa raréfaction graduelle."
                                            },
                                            {
                                                "example_id": "0af58cad-8ce9-4dec-8cff-6fb362b8f046",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Aussi les malins de la région auguraient-ils que l’argent ne manquait point à la Croix-Rompue."
                                            },
                                            {
                                                "example_id": "ef1cb97c-5574-4e6d-831a-fb4d5ec52544",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Jouissons de l’heure présente, songea-t-il, car j’augure à certains signes que le temps nous est désormais étroitement mesuré."
                                            },
                                            {
                                                "example_id": "6cf4866a-a4cd-407a-8e69-50ee4206c4e8",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Je voudrais bien savoir ce que vous augurez de mon avenir ; mais vos honnêtes camarades m’ont enlevé ma montre et ma bourse, et vous n’êtes pas sorcier à prophétiser gratis."
                                            },
                                            {
                                                "example_id": "400dd023-586d-48a3-b763-24a34e9ed687",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Oui, oui, quand je serai desséchée par l’égoïsme et corrompue par la flatterie ! Voilà ce que vous voulez dire, voilà ce que vous augurez de moi !"
                                            },
                                            {
                                                "example_id": "4db13c01-bdd1-4c68-9e12-b721ba8d30e9",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Tant que dura cette lecture, Rhéa garda la tête baissée et ne put retenir ses larmes. On en augura de suite qu’elle se sentait perdue devant des témoignages aussi indiscutables de ses torts d’épouse."
                                            },
                                            {
                                                "example_id": "6af3f946-3302-43cd-820c-a6d7020a55ff",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Ma Julie, prends garde à toi ; mieux elle augurait de ta raison, plus elle craignait pour ton cœur."
                                            },
                                            {
                                                "example_id": "86853cbe-4884-411e-94e6-3b11ae28cb52",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Les cinq maîtres d’Inès voyant une aussi belle ordonnance, augurèrent bien du maître et de la maîtresse de la maison."
                                            },
                                            {
                                                "example_id": "b1c52b70-4130-45f2-a447-823206c17301",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Elle augurait favorablement d’un homme éprouvé par de longs malheurs."
                                            },
                                            {
                                                "example_id": "809d67ae-4c30-4c92-bb32-d8a0f377d914",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Si l’on t’envoie en ambassade, j’augure mal de tes succès."
                                            },
                                            {
                                                "example_id": "8b2a92b7-6250-47d1-bd80-155a4802f577",
                                                "sense_id": "3f31ff9a-0a37-3eb5-9bab-ebb0f52a4988",
                                                "text": "Voulez-vous me permettre d’ajouter que ce qui me fait bien augurer de ce voyage, au moins pour ses résultats pratiques, c’est la présence de mon ami M. le vicomte de Sainte-Austreberthe ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
