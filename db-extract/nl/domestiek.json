                "word_linkages": []
            },
            {
                "entry_id": "1043fabd-b3f1-3dd5-b0dd-f92a9eeb3b7a",
                "word": "domestiek",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "085e4966-01e5-394c-8fa1-c45488ce2d4e",
                        "entry_id": "1043fabd-b3f1-3dd5-b0dd-f92a9eeb3b7a",
                        "glosses": [
                            "huisknecht, huisbediende, bediende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e414c3-9089-4fab-bfbc-e4988f498275",
                                "sense_id": "085e4966-01e5-394c-8fa1-c45488ce2d4e",
                                "text": "Een domestiek van de gezant werd op straat zo uitgejouwd en bedreigd dat ze de ambassade weer in vluchtte. Diezelfde middag zou De la Tour du Pin zijn geloofsbrieven aan de raadpensionaris aanbieden. Toen hij - zonder strik - naar zijn koets liep, stond daar een menigte van zo'n vijftig man."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38a195eb-a8b3-4cfa-8dfb-414df61e3602",
                        "source_entry_id": "1043fabd-b3f1-3dd5-b0dd-f92a9eeb3b7a",
                        "source_sense_id": "085e4966-01e5-394c-8fa1-c45488ce2d4e",
