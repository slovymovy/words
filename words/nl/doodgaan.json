                    "semantic_group_id": "sterven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De planten in de tuin waren allemaal <w>doodgegaan</w> door de droogte.",
                            "target_lang_translations": {
                                "en": "The plants in the garden had all <w>died</w> because of the drought."
                            }
                        },
                        {
                            "text": "Iedereen moet op een dag <w>doodgaan</w> maar we praten er liever niet over.",
                            "target_lang_translations": {
                                "en": "Everyone has to <w>die</w> one day, but we prefer not to talk about it."
