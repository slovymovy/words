            "senses": [
                {
                    "sense_id": "7e4efaf2-66bf-34f2-8c82-99ff383de66f",
                    "sense_definition": "Poser un objet quelque part après l'avoir porté ou tenu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "poser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>dépose</w> ses clés sur la table dès qu'il rentre à la maison."
                        },
                        {
                            "text": "Vous pouvez <w>déposer</w> vos valises dans l'entrée avant de monter."
                        }
                    ],
                    "synonyms": [
                        "poser",
                        "placer"
                    ],
                    "antonyms": [
                        "ramasser",
                        "soulever"
                    ],
                    "common_phrases": [
