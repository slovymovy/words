                        "glosses": [
                            "Without glory; unglorious"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf984a0-ff5c-4d62-8bf2-2ff0d9c04f9f",
                                "sense_id": "da2002da-21e0-3fe5-9ecf-8854da4bae85",
                                "text": "Beside the record of His life, the history of Cyrus, the annals of Cæsar, appear mean — gloriless."
                            },
                            {
                                "example_id": "6905922e-0133-4487-a21d-28f006f6647c",
                                "sense_id": "da2002da-21e0-3fe5-9ecf-8854da4bae85",
                                "text": "That is precisely where so many of us are-trapped in our own cisterns, stuck in a gloryless life and a gloryless church."
                            }
                        ]
                    }
                ],
