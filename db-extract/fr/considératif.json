                    {
                        "sense_id": "e7109468-3ba3-3f27-879e-1db6a338bebd",
                        "entry_id": "9090a078-2a67-33be-8a45-9f8284dd7ce4",
                        "glosses": [
                            "Qui considère, qui réfléchit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62466e4c-8dfc-4941-911f-26c20014820c",
                                "sense_id": "e7109468-3ba3-3f27-879e-1db6a338bebd",
                                "text": "Cette foi qui fait le passage de l’état considératif à l’état contemplatif."
                            },
                            {
                                "example_id": "387f2620-fd77-4683-aef7-72d43d45fe1a",
                                "sense_id": "e7109468-3ba3-3f27-879e-1db6a338bebd",
                                "text": "Comme il y en a tousjours qui sont fort consideratifs, ceux-là repliquerent qu’ils appercevoyent bien le danger apparent, neantmoins que la salvation leur estoit cachée."
                            },
                            {
                                "example_id": "a475d0cd-407b-43a0-8736-1fe6644f375b",
                                "sense_id": "e7109468-3ba3-3f27-879e-1db6a338bebd",
                                "text": "Et l’autre, lent et consideratif comme un Fabius, opina hazardeusement."
                            },
                            {
                                "example_id": "e62caa4d-57db-45fd-a581-016eedb074a0",
                                "sense_id": "e7109468-3ba3-3f27-879e-1db6a338bebd",
                                "text": "Le prince, ennuié de voir les eaux entre son chemin et lui [son adversaire], et le voiant trop consideratif pour passer, lui voulut toucher à la main."
                            }
                        ]
                    }
                ],
