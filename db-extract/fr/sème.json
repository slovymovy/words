                    }
                ],
                "senses": [
                    {
                        "sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                        "entry_id": "dfc25b32-a197-355a-90b7-64526a70cd73",
                        "glosses": [
                            "Unité minimale de sens apparaissant dans l’analyse d’un signifié."
                        ],
                        "tags": [
                            "Sémiotique"
                        ],
                        "examples": [
                            {
                                "example_id": "1e56957d-e7e8-4ef8-8cd4-d236f3c18544",
                                "sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                                "text": "Un mot contient un ou plusieurs sèmes."
                            },
                            {
                                "example_id": "8bb586f2-3aca-40c2-b8ee-75612cdc70dc",
                                "sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                                "text": "Le mot chaise et le mot fauteuil contiennent tous les deux le sème « où l’on s’assoit », mais seul fauteuil a celui « avec des bras »."
                            },
                            {
                                "example_id": "9f6e0435-b439-44d2-a469-b59c91c593e2",
                                "sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                                "text": "Les sèmes nucléaires proviennent du « noyau » de la signification."
                            },
                            {
                                "example_id": "916bce7f-0ee3-4b6b-ae78-383eb0459852",
                                "sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                                "text": "Ce qui constitue le pavor, le terror, dans les souvenirs, c’est que l’enfance est irréparable, et que ce qui en est la part irréparable fut la part amplificatrice, fougueuse, et constructive. Nous ne pouvons que remuer ces dépôts « sémantiques sans significations », ces sèmes asèmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20977bb9-10af-4d7f-b7d5-38c86eb4ebf4",
                        "source_entry_id": "dfc25b32-a197-355a-90b7-64526a70cd73",
                        "source_sense_id": "18261311-b462-3bf9-93c9-579061d75b5b",
                        "target_lang_word": "Sem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                        "entry_id": "fc70cbcd-9c31-3dde-9363-1156d7a36907",
                                        "glosses": [
                                            "kleinster, nicht weiter zerlegbarer Bestandteil der Bedeutung eines Wortes oder Morphems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4149ba79-894a-4234-9798-83e165bd3fa2",
                                                "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                                "text": "[erwachsen], [weiblich] sind Seme, die zur Beschreibung der Bedeutung von Wörtern wie „Frau“ oder „Löwin“ verwendet werden können."
                                            },
                                            {
                                                "example_id": "b9dc4380-1dad-497a-bdd3-dcd73dbde6d4",
                                                "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                                "text": "Die Menge der Seme eines Wortes oder Morphems bildet ihr Semem, ihre Bedeutung."
                                            },
                                            {
                                                "example_id": "44f8dc7d-ddb5-452d-935e-dfc2c0feb2b2",
                                                "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                                "text": "„Der nächste Schritt bestand darin, nicht nur ein Wortfeld, sondern auch die Bedeutung eines Lexems selbst, ein Semem, als Struktur zu verstehen, und zwar aufgebaut aus den einzelnen Semen.“"
                                            },
                                            {
                                                "example_id": "c4ea207d-2690-49cb-b158-ef7e6ed42e15",
                                                "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                                "text": "„Das Konzept der Seme geht davon aus, daß sich Beschreibungseinheiten für kleinere und kleinste Einheiten der Bedeutungen (sowohl der Langue als auch der Parole) aus der Zerlegung realer sprachlicher Einheiten ableiten lassen.“"
                                            },
                                            {
                                                "example_id": "3bbdebe8-9caa-41ec-bcf6-8e6b32cfe50e",
                                                "sense_id": "11cc7978-5069-3869-a972-cd24ea8e07dc",
                                                "text": "„Bei Verneinung der Frage schließt sich entweder eine Frage nach der Art der Differenzen an, oder es folgen so viele Kommutationsproben mit den gleichen Wörtern, aber nunmehr anderen Kontexten, bis der Linguist zur Formulierung von Semen in der Lage ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
