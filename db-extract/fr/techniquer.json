                "senses": [
                    {
                        "sense_id": "df3ecdde-a496-3436-be57-118c41e3f6f2",
                        "entry_id": "b3cda5c4-6750-329f-8ba7-b4d0f60b0c72",
                        "glosses": [
                            "Munir (un patient) d’équipements techniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2ba2c6-cf5b-4692-bd22-a77b7e170795",
                                "sense_id": "df3ecdde-a496-3436-be57-118c41e3f6f2",
                                "text": "Aides-soignantes, infirmières et médecins, ils sont huit à « techniquer » le malade. Ils branchent sondes et cathéters."
                            },
                            {
                                "example_id": "a1d4b34d-42ca-4fc7-801e-1003ebc613c3",
                                "sense_id": "df3ecdde-a496-3436-be57-118c41e3f6f2",
                                "text": "Techniquer des blessés lourds est une chose, les évacuer en est une autre."
                            },
                            {
                                "example_id": "4cf3efc0-bf2a-4d2e-8dec-7a3d0caa74d3",
                                "sense_id": "df3ecdde-a496-3436-be57-118c41e3f6f2",
                                "text": "Ils « techniquent » le malade. Ils branchent sondes et cathéters ainsi que divers appareils pour la préparation à l'anesthésie, ... (site ouest-france.fr)"
                            }
                        ]
                    },
                    {
                        "sense_id": "d285f724-65e3-3ef2-9253-5470b322c830",
                        "entry_id": "b3cda5c4-6750-329f-8ba7-b4d0f60b0c72",
                        "glosses": [
                            "Appliquer des actions techniques à des prélèvements médicaux (par exemple, la centrifugation, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b81e81e-0d75-4669-92d2-8f15b7057859",
                                "sense_id": "d285f724-65e3-3ef2-9253-5470b322c830",
                                "text": "Le rôle de l’interne n'est pas de « techniquer » les prélèvements."
                            },
                            {
                                "example_id": "d5415894-32ce-4a7f-b05e-fec66e175499",
                                "sense_id": "d285f724-65e3-3ef2-9253-5470b322c830",
                                "text": "Quand j’amène des gaz du sang à techniquer en urgence."
                            },
                            {
                                "example_id": "ad359475-dff4-454a-a82e-75f8147ef82b",
                                "sense_id": "d285f724-65e3-3ef2-9253-5470b322c830",
                                "text": "Les techniciens de nuit sont également amenés à techniquer des prélèvements de Microbiologie en plus de la Biologie Médicale."
                            }
                        ]
                    },
                    {
                        "sense_id": "15cd2ea3-9395-386a-976d-8ab3a33d96a4",
                        "entry_id": "b3cda5c4-6750-329f-8ba7-b4d0f60b0c72",
                        "glosses": [
                            "Soumettre (une chose) à des tests techniques afin d'avérer des éléments, des faits, utiles à une enquête de police."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77633239-7abc-4a0b-a8a5-d2a9ca7e8d98",
                                "sense_id": "15cd2ea3-9395-386a-976d-8ab3a33d96a4",
                                "text": "Le chariot de la nounou a été remisé dans la réserve du magasin. L'Identité judiciaire est en route pour le techniquer."
                            }
                        ]
                    }
                ],
