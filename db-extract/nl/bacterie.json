                    {
                        "form_id": "55d10c21-8151-4cc6-9251-ca61514631a2",
                        "entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "bacterietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                        "entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
                        "glosses": [
                            "ééncellig micro-organisme dat zich snel kan vermenigvuldigen en rotting, gisting en ziekte kan veroorzaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5e3cc1-01e2-4051-9c6e-9cd76c5db61b",
                                "sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                                "text": "Een verkoudheid wordt meestal veroorzaakt door een virus en niet door een bacterie."
                            },
                            {
                                "example_id": "9d33978d-d4cd-4367-9c4e-0f5fa34529e9",
                                "sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                                "text": "Eén long, waarin een mysterieuze bacterie zich had genesteld, hing als een verschrompelde vrucht in de borstkas. Nu was de tweede aan de beurt."
                            },
                            {
                                "example_id": "b3a7c932-5c9d-4847-9335-5251a60ed943",
                                "sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                                "text": "Waarom moest juist zíj een bacterie oplopen waartegen de moderne, medische wetenschap machteloos stond?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "409c6ebc-3bea-45e6-931d-082f3ae48ae1",
                        "source_entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
                        "source_sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                        "target_lang_word": "Bakterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                        "entry_id": "6611b21e-6a12-3337-97c8-c3a76e7d9a67",
                                        "glosses": [
                                            "sich teilendes, einzelliges, prokaryotisches Lebewesen ohne Zellkern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d430dd50-02c4-4091-833f-057624ed4551",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Ihr Körper ist voll von Bakterien, genau so wie alles andere auf der Erde. Bakterien leben in der Erde, der Luft, dem Wasser sowohl an der Außen- und Innenseite unseres Körpers.“"
                                            },
                                            {
                                                "example_id": "f7157112-ae98-42ad-85e6-e1f04ea202fc",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Bakterien können genetisch so verändert werden, dass sie grundlegende logische Funktionen wie ein Computerchip ausführen können.“"
                                            },
                                            {
                                                "example_id": "8d40873e-b48d-4f43-9755-df7be61dd267",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Offene Brandwunden sind ein idealer Nährboden für Bakterien und infizieren sich oft.“"
                                            },
                                            {
                                                "example_id": "38007959-4168-49bb-8e8d-7886a655cffc",
                                                "sense_id": "f39a814c-3144-34e8-92d9-39c9d78955b3",
                                                "text": "„Da ich mich nie an Haltestangen festhalte, der Bakterien wegen, muss ich ausbalacieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61ecb322-7b96-33a2-abb2-cb78b88ee15c",
                                        "entry_id": "6611b21e-6a12-3337-97c8-c3a76e7d9a67",
                                        "glosses": [
                                            "eine der drei Domänen des aktuellen biologisch-taxonomischen Systems"
                                        ],
                                        "tags": [
                                            "jargon",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b50b2e4-20bc-4e85-a844-e889459943d1",
                                                "sense_id": "61ecb322-7b96-33a2-abb2-cb78b88ee15c",
                                                "text": "„Bakterien sind wie die Archaeen Prokaryoten, das bedeutet, ihre DNA ist nicht in einem vom Cytoplasma durch eine Doppelmembran abgegrenzten Zellkern enthalten wie bei Eukaryoten, sondern bei ihnen liegt die DNA wie bei allen Prokaryoten frei im Cytoplasma, und zwar zusammengedrängt in einem engen Raum, dem Nucleoid (Kernäquivalent). “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b119cf89-f9c6-490f-8fd9-aed110a8f619",
                        "source_entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
                        "source_sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                        "target_lang_word": "bacterium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bacterium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7494944c-e36d-3073-8dee-dae0e4050184",
                                        "entry_id": "dd45ca34-b60b-367d-9540-d19ad105c1e9",
                                        "glosses": [
                                            "A single-celled organism with cell walls but no nucleus or organelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9fecd3d-6930-438f-bfd0-cbce4283392e",
                                                "sense_id": "7494944c-e36d-3073-8dee-dae0e4050184",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4a9fed2-d0a1-418e-b3ad-2e30562bde8e",
                        "source_entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
                        "source_sense_id": "18ea440f-90ab-3aac-98a1-bb4785746fca",
                        "target_lang_word": "bactérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bactérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39f40bef-cff4-36cd-a964-8e092c681432",
                                        "entry_id": "bb323cf3-5151-3bcc-a5e3-803f3319ce47",
                                        "glosses": [
                                            "Micro-organisme unicellulaire et sans noyau compartimenté ni organites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09bd6bb8-ca40-4940-85eb-a29ce5d3dfca",
                                                "sense_id": "39f40bef-cff4-36cd-a964-8e092c681432",
                                                "text": "Selon les chercheurs, des protéines produites par certaines bactéries intestinales, identifiées dans le sang des personnes atteintes, modifieraient l'interaction entre le système immunitaire et le système nerveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec7e7a0-9eba-3a8e-85b4-39c4428a2294",
                                        "entry_id": "bb323cf3-5151-3bcc-a5e3-803f3319ce47",
                                        "glosses": [
                                            "Eubactérie, organisme procaryote distinct des archébactéries."
                                        ],
                                        "tags": [
                                            "À partir de 1977"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f418c3b-3229-45ed-8b80-5a1fea8b4713",
                                                "sense_id": "dec7e7a0-9eba-3a8e-85b4-39c4428a2294",
                                                "text": "A partir d'un échantillon du sol prélevé là où s'écoulaient des ruissellements émanant d'une fabrique de molinate, près d'Estoril, l'équipe a identifié un groupe de bactéries très intéressantes car dégradant totalement le molinate en résidus non toxiques. Parmi ces bactéries, une seule bactérie, Gulosibacter molinativorax, inconnue jusqu'alors, avait un rôle essentiel dans la décontamination du molinate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a447b713-1033-4fb1-9de0-6008a68ce047",
                        "source_entry_id": "86934022-2ecd-3bb1-a28d-f19a78fee6fe",
