{
    "word_family": [
        "daze",
        "dazedly",
        "dazedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "373325bb-8f6e-3743-b590-4ea8ebc35fb2",
                    "sense_definition": "In a state of shock or confusion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dazed</w> survivor wandered through the streets after the earthquake.",
                            "target_lang_translations": {
                                "zh": "地震后，那位<w>茫然</w>的幸存者在街上徘徊。"
                            }
                        },
                        {
                            "text": "He felt <w>dazed</w> and confused after the sudden accident.",
                            "target_lang_translations": {
                                "zh": "突如其来的事故让他感到<w>发懵</w>且困惑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "bewildered",
                        "disoriented"
                    ],
                    "antonyms": [
                        "alert",
                        "focused"
                    ],
                    "common_phrases": [
                        "dazed look",
                        "dazed state"
                    ],
                    "target_lang_definitions": {
                        "zh": "处于震惊或困惑的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茫然",
                                "target_lang_sense_clarification": "形容神情失落、不知所措的样子。"
                            },
                            {
                                "target_lang_word": "发懵",
                                "target_lang_sense_clarification": "口语，形容头脑昏沉、反应迟钝。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3f2b89d-fe17-3179-b2ea-0eb463c337db",
                    "sense_definition": "Stunned or entranced.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience sat <w>dazed</w> by the incredible performance.",
                            "target_lang_translations": {
                                "zh": "观众被那场精彩的表演<w>惊呆</w>了。"
                            }
                        },
                        {
                            "text": "She remained <w>dazed</w> by the beauty of the sunset.",
                            "target_lang_translations": {
                                "zh": "她依然被落日的美景所吸引而<w>出神</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stunned",
                        "entranced",
                        "mesmerized"
                    ],
                    "target_lang_definitions": {
                        "zh": "因惊叹或入迷而发呆。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "惊呆",
                                "target_lang_sense_clarification": "形容因极度惊讶而发愣。"
                            },
                            {
                                "target_lang_word": "出神",
                                "target_lang_sense_clarification": "形容因入迷而发呆。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfe19022-d82c-3cf4-a913-02b99577c1dd",
                    "sense_definition": "Simple past and past participle of <w>daze</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright flash <w>dazed</w> the spectators for a moment.",
                            "target_lang_translations": {
                                "zh": "强烈的闪光让观众瞬间<w>眩晕</w>了。"
                            }
                        },
                        {
                            "text": "He was <w>dazed</w> by the unexpected news.",
                            "target_lang_translations": {
                                "zh": "他被这突如其来的消息<w>惊呆</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到眩晕或困惑（daze的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……眩晕",
                                "target_lang_sense_clarification": "指因强光或冲击导致头脑不清。"
                            },
                            {
                                "target_lang_word": "使……发愣",
                                "target_lang_sense_clarification": "指因突发事件导致人不知所措。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}