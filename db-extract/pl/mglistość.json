                        "cross_references": [
                            {
                                "target_word": "turbidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e724105f-91e4-3958-9dfe-095f4992aa90",
                                        "entry_id": "ef1c7708-da6c-3c72-83bc-82c04650b42b",
                                        "glosses": [
                                            "The state of being turbid; turbidness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15744492-47df-4a01-9925-4514942ed53c",
                                                "sense_id": "e724105f-91e4-3958-9dfe-095f4992aa90",
                                                "text": "The variables we considered include solar irradiance and turbidity, which are relevant to the symbiont photosynthesis and yearly minimum temperature, representing potential limiting factors for the holobiont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7167db8d-fc86-39be-bac2-16cd96a2a536",
                                        "entry_id": "ef1c7708-da6c-3c72-83bc-82c04650b42b",
                                        "glosses": [
                                            "The measure of transparency of a fluid (units of measurement include Nephelometric Turbidity Unit (NTU))."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86497b17-3660-441a-9024-8c48dd80c73a",
                                                "sense_id": "7167db8d-fc86-39be-bac2-16cd96a2a536",
                                                "text": "Over a 5 days period beginning on November 21, 2011 and ending on November 26, 2011 we deployed an array of hydrodynamic and sediment dynamic sensors on a tripod frame, including two turbidity sensors, two pore water pressure sensors, one sea gauge wave tide recorder, one kinemometer, and one acoustic erosion measuring instrument (Fig. 21.2)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b97be04a-f605-4afc-8975-09da28fe3a4a",
                        "source_entry_id": "edb378f6-dc20-33c8-8dd1-44c3bcf05789",
                        "source_sense_id": "104befa7-0d8d-34d2-9e43-9cf28d38223a",
                        "target_lang_word": "туманность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "туманность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "295173bc-df58-3f89-b9d8-07d787a9da9e",
                                        "entry_id": "1331dba6-5e2c-3f65-859a-7f490101798a",
                                        "glosses": [
                                            "свойство по значению прилагательного туманный, непрозрачность вследствие наличия тумана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1752e060-d3a6-42d5-b76f-a12b8328db46",
                                                "sense_id": "295173bc-df58-3f89-b9d8-07d787a9da9e",
                                                "text": "Голубой полусвет, пробиваясь сквозь опущенные кружевные занавесы, сообщал необыкновенно нежный, воздушный оттенок лицам и какую-то эфемерную туманность всем окружающим предметам…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e506034-7783-3b02-8592-c7bc5c6e53d3",
                                        "entry_id": "1331dba6-5e2c-3f65-859a-7f490101798a",
                                        "glosses": [
                                            "перен. безжизненность, невыразительность, тусклость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12e0eda-4e90-4392-821d-7e96641bd820",
                                                "sense_id": "3e506034-7783-3b02-8592-c7bc5c6e53d3",
                                                "text": "Туманность взгляда."
                                            },
                                            {
                                                "example_id": "f93b8a72-7760-49f0-a227-a2e4d68cbdb7",
                                                "sense_id": "3e506034-7783-3b02-8592-c7bc5c6e53d3",
                                                "text": "Две барышни ― и обе стихи писали. Одна ― с туманностью, с меланхолией, другая ― со страстностью, с натуральностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a98939-9fd3-342c-8516-836ee3ba1115",
                                        "entry_id": "1331dba6-5e2c-3f65-859a-7f490101798a",
                                        "glosses": [
                                            "перен. неясность, непонятность, запутанность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a395b4-2d2b-4c25-a658-251e4d60cc0c",
                                                "sense_id": "c3a98939-9fd3-342c-8516-836ee3ba1115",
                                                "text": "…они разглагольствуют о какой-то особой «сложности» нашего времени, а отсюда ― о сложности, как необходимом качестве современной поэзии. Этим они оправдывают туманность и смысловую нечёткость собственных строк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c57cdc5-3cf6-37bd-85d4-d227ae9370da",
                                        "entry_id": "1331dba6-5e2c-3f65-859a-7f490101798a",
                                        "glosses": [
                                            "астрон. межзвёздное облако, состоящее из пыли, газа и плазмы, выделяющееся своим излучением или поглощением по сравнению с окружающей его межзвёздной средой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b6a3c7-4160-4c8c-b8fd-3e366cce837e",
                                                "sense_id": "0c57cdc5-3cf6-37bd-85d4-d227ae9370da",
                                                "text": "Карта туманностей."
                                            },
                                            {
                                                "example_id": "919748da-4d63-4ad8-8c4c-7884afbc02b1",
                                                "sense_id": "0c57cdc5-3cf6-37bd-85d4-d227ae9370da",
                                                "text": "Крабовидная туманность."
                                            }
                                        ]
                                    },
