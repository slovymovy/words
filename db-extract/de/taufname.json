                ],
                "senses": [
                    {
                        "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                        "entry_id": "642efe88-08dc-3979-a9b3-8cbd811aa851",
                        "glosses": [
                            "Vorname, den man bei der (christlichen) Taufe erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9fd2645-53bc-4f3d-b102-8c381d251c64",
                                "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                                "text": "Er hört auf den Taufnamen Christian."
                            },
                            {
                                "example_id": "cd6ef551-d338-45d4-a84f-eb160ab3ef9f",
                                "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                                "text": "Beim Adel und bei der Ritterschaft finden wir fremde Taufnamen vom Beginn des 13. Jahrh. an, bald auch bei dem nachahmungsbeflissenen Stadtvolk."
                            },
                            {
                                "example_id": "5003b94c-b455-4040-909a-506464bd3f24",
                                "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                                "text": "„Der Vater war selten nüchtern, doch wenn es hin und wieder mal vorkam, benutzte er den Taufnamen des Sohnes.“"
                            },
                            {
                                "example_id": "40cbcc7e-e46c-4ce8-be9f-471424f796b8",
                                "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                                "text": "„Der Taufname des kleinen Tafari lautet Haile Selassi, »Kraft der Dreifaltigkeit«.“"
                            },
                            {
                                "example_id": "50ead6c8-1b3f-492e-b15a-ce8497c0a78c",
                                "sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                                "text": "„Sie hätte sich gern Preato genannt, denn das war ihr Familienname, aber ihre Freunde nannten sie Giulietta, das war ihr Taufname, und er ist hübsch genug, um zu der Geschichte zu passen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96020b2f-c115-4126-9723-8b5e152d7508",
                        "source_entry_id": "642efe88-08dc-3979-a9b3-8cbd811aa851",
                        "source_sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                        "source_sense_description": "Vorname, den man bei der (christlichen) Taufe erhält",
                        "target_lang_word": "Christian name",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christian name",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117bfc90-75e2-30b0-a419-30f7857a6fc2",
                                        "entry_id": "fdba49db-92e7-3153-aa96-77707193de7d",
                                        "glosses": [
                                            "A first name formally given to a child at a Christian baptism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1613aba4-6aca-32a6-9ebc-e2d01023172b",
                                        "entry_id": "fdba49db-92e7-3153-aa96-77707193de7d",
                                        "glosses": [
                                            "Any forename."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94d65e32-b934-4f2e-99a8-630f353f3205",
                                                "sense_id": "1613aba4-6aca-32a6-9ebc-e2d01023172b",
                                                "text": "This was all overheard by Miss Dashwood; and in the whole of the sentence, in his manner of pronouncing it, and in his addressing her sister by her christian name alone, she instantly saw an intimacy so decided, a meaning so direct, as marked a perfect agreement between them."
                                            },
                                            {
                                                "example_id": "2e8b4b3c-661a-4692-af20-2017f0931c09",
                                                "sense_id": "1613aba4-6aca-32a6-9ebc-e2d01023172b",
                                                "text": "On 8th November Anthony cabled them, ‘Your great-grandson Randal Lewis Casson arrived to-day. Both well,’ and we sent, ‘Congratulations on becoming great-grandparents.’ Anthony and Janneke had kept the proposed Christian names a complete secret, and we were all so touched that they had chosen two which belonged so much to the family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c9f00c-2e55-3728-b690-5e8a39d110eb",
                                        "entry_id": "fdba49db-92e7-3153-aa96-77707193de7d",
                                        "glosses": [
                                            "An English given name, particularly for ethnic Chinese who usually have a separate Chinese name."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "576668cc-ca06-3230-9213-f4be3b616097",
                                        "entry_id": "fdba49db-92e7-3153-aa96-77707193de7d",
                                        "glosses": [
                                            "A baptismal name or confirmation name used in religious contexts, but not part of the legal name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61fac1b7-52d9-41c5-a094-4c28532cca97",
                                                "sense_id": "576668cc-ca06-3230-9213-f4be3b616097",
                                                "text": "At the convent he is known as \"Andrew.\" This is Shin's baptismal name. Korean Catholics baptized as infants take on a Christian name which also acts as their confirmation name."
                                            },
                                            {
                                                "example_id": "1a547330-0c24-4773-b2cf-156a8c9dacce",
                                                "sense_id": "576668cc-ca06-3230-9213-f4be3b616097",
                                                "text": "Many of these, however, thoughtfully join their given names with a hyphen, or even write them solid, so that Lee Soo Man may present himself as Soo-Man Lee or Sooman Lee. A Korean who is a Christian will additionally take a Christian name, and so our Mr Lee may present himself as Noah Lee."
                                            },
                                            {
                                                "example_id": "39a5a07b-4d6a-4e04-bfca-d4973e918201",
                                                "sense_id": "576668cc-ca06-3230-9213-f4be3b616097",
                                                "text": "An Chung-gun (baptized Thomas as his Christian name), Korean 'national hero,' who assassinated the Japanese Prime Minister and was a criminal from the Japanese point of view[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d41639-ec49-4456-aacf-d2fb84b38639",
                        "source_entry_id": "642efe88-08dc-3979-a9b3-8cbd811aa851",
                        "source_sense_id": "2ccf21f1-c5ce-3249-bbe5-719fb3775194",
                        "source_sense_description": "Vorname, den man bei der (christlichen) Taufe erhält",
                        "target_lang_word": "nom de baptême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nom de baptême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b475519-437b-3b98-abbd-5fb577fa6629",
                                        "entry_id": "a613917f-0981-384c-bb6a-9cfe110d9cdd",
                                        "glosses": [
                                            "Prénom donné à une personne lorsqu’elle se fait baptiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3411195f-1094-406a-8716-a28673939345",
                                                "sense_id": "4b475519-437b-3b98-abbd-5fb577fa6629",
                                                "text": "— Guillaume ! s’écria Régine en lâchant son guidon d’une main.\nElle s’interrompit, hésitante. C’était la première fois qu’elle l’appelait par son nom de baptême. Et ils furent tous quatre très étonnés de constater la façon cérémonieuse dont ils se traitaient malgré leurs relations anciennes.\n— Tu as absolument raison, nous sommes stupides avec nos « Monsieur » et nos « Madame ». Moi, cela ne me gênera pas du tout d’appeler ton mari Pascal."
                                            },
                                            {
                                                "example_id": "8a04af85-1467-4066-87dd-15f0eba305ac",
                                                "sense_id": "4b475519-437b-3b98-abbd-5fb577fa6629",
                                                "text": "Le nom de famille français est bien, conformément à la formule exprimée par D. Kremer, la « forme définitive de ce qui était à l'origine un nom second » ou surnom accolé au nom de baptême, apparu à l'orée du second millénaire."
                                            },
                                            {
                                                "example_id": "543b4a16-b6d0-4219-a4a2-b5d9d91a2104",
                                                "sense_id": "4b475519-437b-3b98-abbd-5fb577fa6629",
                                                "text": "La première glace une fois rompue, c’était devenu tout de suite entre nous trois une grande amitié, sentimentale au possible ; nous nous appelions même par nos noms de baptême, ce qui est tout à fait contraire aux belles manières des collèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2c7308e-5aff-314d-b2af-f72607387a63",
                                        "entry_id": "a613917f-0981-384c-bb6a-9cfe110d9cdd",
                                        "glosses": [
                                            "Prénom donné à un enfant après sa naissance et souvent avant son baptême chrétien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34adb48b-5734-37a1-a92f-d8139e466b8c",
                                        "entry_id": "a613917f-0981-384c-bb6a-9cfe110d9cdd",
                                        "glosses": [
                                            "Nom personnel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
