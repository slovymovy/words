                    {
                        "translation_id": "be0fbebb-51cd-4d8d-a467-6865b514f022",
                        "source_entry_id": "00a953ee-439b-318b-8f9e-fc5c0254d09a",
                        "source_sense_description": "person who practices a profession or art",
                        "target_lang_word": "praticien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praticien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b77c7898-444c-3c17-b6a8-8bc26811a46d",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Celui qui a la connaissance et l’usage des moyens pratiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62ac407-4602-40ab-aa2d-1209e573581c",
                                                "sense_id": "b77c7898-444c-3c17-b6a8-8bc26811a46d",
                                                "text": "— C’est ainsi que, criminaliste praticien, je fus invité par le gouvernement serbe à me rendre en Serbie […]"
                                            },
                                            {
                                                "example_id": "363e6ed1-af56-4304-879b-53a231616580",
                                                "sense_id": "b77c7898-444c-3c17-b6a8-8bc26811a46d",
                                                "text": "Il est plus praticien que théoricien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e23e5d-93d6-3a65-b697-b9c5c0451ffa",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Celui qui connaît la manière de procéder en justice."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28430c6-f5b2-4c4c-b0fe-fa573bca7fcc",
                                                "sense_id": "21e23e5d-93d6-3a65-b697-b9c5c0451ffa",
                                                "text": "Le praticien, vulgairement appelé recors, est l’homme de justice par hasard, il est là pour assister l’exécution des jugements, c’est pour les affaires civiles, un bourreau d’occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4862defc-5b20-363f-aec3-68378b70b6f0",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Médecin qui soigne les malades, par opposition à ceux qui se consacrent à l’étude théorique des maladies et aux recherches de laboratoire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0c008b-6d4f-4413-b346-d830b0cdb2af",
                                                "sense_id": "4862defc-5b20-363f-aec3-68378b70b6f0",
                                                "text": "Je vous joins ici une anecdote pas banale : lors d'une visite chez un praticien, en lui donnant ma carte vitale, assez sèchement, il m'a dit :\n— Ce n'est pas la carte vitale de votre mère que je vous demande mais la vôtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c7bd9b0-0912-398e-ad4f-e6f3ee42d5f0",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Toute autre pratiquant d’une profession médicale qui soigne des patients."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57409ac4-7bdf-3753-8e5d-92b047dab5e3",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Celui qui s’est plus livré à la pratique de son art qu’à la théorie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1a0553e-d7a4-3991-b5d4-4b85ea4f06fa",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Ouvrier qui met au point une statue de marbre ou de pierre, d’après le modèle de l’artiste."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ae3bb34-a318-3346-ab53-2b79d7b2312a",
                                        "entry_id": "8bbf7ef5-1c06-355e-9c6f-6502f24693ba",
                                        "glosses": [
                                            "Personne pratiquant les arts martiaux, aussi nommée martialiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6114320-650a-47f9-a5e5-09d7dc8e8255",
