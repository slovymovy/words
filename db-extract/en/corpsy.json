                        "glosses": [
                            "Resembling a corpse; resembling that of a corpse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f5b15f-4ec0-4414-8c1d-4d95ba05bd36",
                                "sense_id": "748414cb-d3e2-39c3-bee9-7f6b79045c86",
                                "text": "But I must acknowledge there was something truly corpsy in the solemnity with which he would “lay out” a clean shirt."
                            },
                            {
                                "example_id": "c13b5ccc-be46-4ea4-90e9-3d66b5d52438",
                                "sense_id": "748414cb-d3e2-39c3-bee9-7f6b79045c86",
                                "text": "How it came back to me! That peculiar feeling—it was only a feeling, you couldn't describe it as an activity—that we used to call 'Church'. The sweet corpsy smell, the rustle of Sunday dresses, the wheeze of the organ and the roaring voices […]"
                            },
                            {
                                "example_id": "c481f00f-1e6b-4bbe-afb1-b9ed33b80b56",
                                "sense_id": "748414cb-d3e2-39c3-bee9-7f6b79045c86",
                                "text": "Christmas Eve Father took us into town to see the shops lit up. Every lamp post had a fir tree tied to it—not corpsy old trees but fresh cut firs."
                            }
                        ]
                    }
