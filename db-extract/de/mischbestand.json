                                "example_id": "e72b7924-a49f-465e-8e77-942f93336404",
                                "sense_id": "ef7af550-c41f-33e3-b211-6c26dd205d40",
                                "text": "„Kiefern nahmen im Reinbestand um 28 % zu, im Mischbestand hingegen um 21 % ab.“"
                            },
                            {
                                "example_id": "4000fce0-7147-422f-bcdb-1fd932ddd372",
                                "sense_id": "ef7af550-c41f-33e3-b211-6c26dd205d40",
                                "text": "Man hat in der Realität ja nicht nur reine Fichten- oder Kiefernbestände vor sich, sondern meist Mischbestände mit verschiedenen Holzarten und Altersklassen."
                            }
                        ],
