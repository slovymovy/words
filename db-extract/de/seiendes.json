                "senses": [
                    {
                        "sense_id": "80639ba1-14e2-3d18-a4d1-28679ad6e122",
                        "entry_id": "0fe497dd-4ee8-35b0-b1ed-5f13985c1247",
                        "glosses": [
                            "etwas (Einzelnes), das ist; alles, was ist; die Gesamtheit des Existierenden"
                        ],
                        "tags": [
                            "mit unbestimmtem Artikel",
                            "mit bestimmtem Artikel meist"
                        ],
                        "examples": [
                            {
                                "example_id": "448cdcdd-26dd-475a-8ce3-c025350fb1ae",
                                "sense_id": "80639ba1-14e2-3d18-a4d1-28679ad6e122",
                                "text": "Das Sein und das Seiende stehen in einem dialektischen Verhältnis zueinander."
                            },
                            {
                                "example_id": "9defa4c2-c9ed-48c9-a402-103e0fe67ba7",
                                "sense_id": "80639ba1-14e2-3d18-a4d1-28679ad6e122",
                                "text": "Die Erkenntnistheorie sichert die Wahrheitsbefähigung unseres Geistes, der das Seiende erfassen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e44a9dda-29ca-437d-a5e5-bac15c99dd23",
                        "source_entry_id": "0fe497dd-4ee8-35b0-b1ed-5f13985c1247",
                        "source_sense_id": "80639ba1-14e2-3d18-a4d1-28679ad6e122",
