                "senses": [
                    {
                        "sense_id": "3583834f-a32f-3d37-9a6b-eab8341986a9",
                        "entry_id": "436dbc18-5061-3b14-9326-1056ccd85b21",
                        "glosses": [
                            "dotyczący Brna, związany z Brnem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a3fbf5-3b61-4ec6-968b-b06ff3aaaee4",
                                "sense_id": "3583834f-a32f-3d37-9a6b-eab8341986a9",
                                "text": "Na cześć skutecznej obrony w 1653 roku w każdym brneńskim kościele wisi obraz Matki Bożej […]"
                            },
                            {
                                "example_id": "a16464f8-24c7-4237-8287-e141ec091c90",
                                "sense_id": "3583834f-a32f-3d37-9a6b-eab8341986a9",
                                "text": "Brno jest pełne lokalnych patriotów, którzy dumni są z tego, że potrafią mówić brneńską hantyrką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0600fb65-5afa-4c28-b1ad-6ba78aff3532",
                        "source_entry_id": "436dbc18-5061-3b14-9326-1056ccd85b21",
                        "source_sense_id": "3583834f-a32f-3d37-9a6b-eab8341986a9",
                        "target_lang_word": "brněnský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brněnský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "41306c32-c067-3a1d-981d-4492af255d16",
                                        "entry_id": "635e0303-da2c-31f0-845b-21fc355fbd8b",
                                        "glosses": [
                                            "vztahující se k Brnu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47f0c40-ba42-4b56-8bba-8c04e2b736aa",
                                                "sense_id": "41306c32-c067-3a1d-981d-4492af255d16",
                                                "text": "Po brněnském metru zadarmo, vstupu do zoologické zahrady zadarmo, po slevě na hrací automaty a prostitutky tu je další zvýhodnění Ukrajinců."
                                            },
                                            {
                                                "example_id": "b0b0993d-6e31-4a9c-b529-a7d51679d104",
                                                "sense_id": "41306c32-c067-3a1d-981d-4492af255d16",
                                                "text": "Kauza se následně dostala před brněnské přísežné s dotazem, jak má být dotyčná potrestána. Byla totiž dopadena bezprostředně po vraždě se zabitým dítětem, takže bylo evidentní, že ho musela utopit sama. Stávající brněnští přísežní se v plné radě vyjádřili k potrestání dopadené ženy, aniž by dospěli k jednotnému stanovisku."
                                            }
                                        ]
                                    }
                                ]
