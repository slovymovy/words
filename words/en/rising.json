    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ee95262-3cb0-3646-9911-fb64f23206c0",
                    "sense_definition": "Moving upwards or increasing in quantity, rate, or level.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rising</w> sun painted the sky in shades of orange and pink.",
                            "target_lang_translations": {
                                "ru": "<w>Восходящее</w> солнце окрасило небо в оранжевые и розовые тона."
                            }
                        },
                        {
                            "text": "We are concerned about the <w>rising</w> costs of electricity this winter.",
                            "target_lang_translations": {
                                "ru": "Мы обеспокоены <w>растущими</w> ценами на электроэнергию этой зимой."
                            }
                        }
                    ],
                    "antonyms": [
                        "falling"
                    ],
                    "common_phrases": [
                        "rising costs",
                        "rising sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся вверх или увеличивающийся в количестве, темпе или уровне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растущий",
                                "target_lang_sense_clarification": "увеличивающийся в объеме или количестве"
                            },
                            {
                                "target_lang_word": "восходящий",
                                "target_lang_sense_clarification": "движущийся вверх, например, о солнце или тренде"
                            }
                        ]
