                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b35155e-8978-453f-a20c-04dbfbcfe921",
                                "sense_id": "9d445f93-accb-35f6-aa3c-58c5891f54da",
                                "text": "Elle avisa une table qui se libérait d’une paire de punkettes et s’y installa, l’épaulette contre la vitre."
                            },
                            {
                                "example_id": "83ce7166-8087-4e71-93a9-716debef4a64",
                                "sense_id": "9d445f93-accb-35f6-aa3c-58c5891f54da",
                                "text": "Les accoutrements, moitié Stevie Nicks moitié Courtney Love, genre punkettes de luxe, ne peuvent que séduire l’amateur de bas résille."
                            },
                            {
                                "example_id": "bd16c7f0-c6a2-4702-884e-d99b78a87920",
                                "sense_id": "9d445f93-accb-35f6-aa3c-58c5891f54da",
                                "text": "… Bonnie, la petite punkette de l’Ontario, …."
                            }
                        ]
                    }
