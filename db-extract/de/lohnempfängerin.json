                "senses": [
                    {
                        "sense_id": "ced791cf-4bcc-3a48-abe0-b8e829c866ee",
                        "entry_id": "8083236f-4c5d-3f7c-b6af-3be9e038355c",
                        "glosses": [
                            "weibliche Person, die für eine geleistete Arbeit als Arbeiterin entlohnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3fdd24a-cc6f-40af-bdf0-8c8525bc304f",
                                "sense_id": "ced791cf-4bcc-3a48-abe0-b8e829c866ee",
                                "text": "„Ein junges Mädchen wie Sie ist schon nach ein paar Stunden als werktätige Lohnempfängerin irgendwo untergekrochen!“"
                            },
                            {
                                "example_id": "158ff7d2-07db-4c47-86ca-bb69a11687ce",
                                "sense_id": "ced791cf-4bcc-3a48-abe0-b8e829c866ee",
                                "text": "„Eine solche finanzielle Abhängigkeit bestand nicht für die Arbeiterfrau, die selber Lohnempfängerin war.“"
                            },
                            {
                                "example_id": "c15fa680-215b-42c8-a4dc-a4f242669bcd",
                                "sense_id": "ced791cf-4bcc-3a48-abe0-b8e829c866ee",
                                "text": "„Trotzdem ist jede dritte Lohnempfängerin in diesem Teil der Welt eine Hausarbeiterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
