                "senses": [
                    {
                        "sense_id": "24c89438-a9c4-334f-be54-ff14b0217d35",
                        "entry_id": "69556dcb-3370-3970-8e34-c84971d249f2",
                        "glosses": [
                            "nasiąknięty smołą, zawierający smołę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362beb2d-ea31-4db2-bbdd-a4fba39074a8",
                                "sense_id": "24c89438-a9c4-334f-be54-ff14b0217d35",
                                "text": "(…) dwa smolne łuczywa ogień obejmował boży, zażegniętą żagiew podano dziewczynie, która żywo i zręcznie pod stos ją podłożyła"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d43bce8d-e45f-4a2a-8f4b-c2b3048aac1c",
                        "source_entry_id": "69556dcb-3370-3970-8e34-c84971d249f2",
                        "source_sense_id": "24c89438-a9c4-334f-be54-ff14b0217d35",
                        "target_lang_word": "tarry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f81d535d-a921-3946-89eb-d22063155368",
                                        "entry_id": "146116b6-b450-3d8a-9706-78b9e5722fa7",
                                        "glosses": [
                                            "To delay; to be late or tardy in beginning or doing anything."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3f21e9-fef6-4da7-94f5-6e9e2ad5188c",
                                                "sense_id": "f81d535d-a921-3946-89eb-d22063155368",
                                                "text": "I believe with perfect faith in the coming of the Messiah; and even though he may tarry, nonetheless, I wait every day for his coming."
                                            },
                                            {
                                                "example_id": "e4f200ce-7af3-4b8f-8ea7-258a09c3b61a",
                                                "sense_id": "f81d535d-a921-3946-89eb-d22063155368",
                                                "text": "For the vision is yet for an appointed time, but at the end it shall speak, and not lie: though it tarry, wait for it; because it will surely come, it will not tarry."
                                            },
                                            {
                                                "example_id": "4fd2cd15-4ead-4509-85ca-49920a7f415c",
                                                "sense_id": "f81d535d-a921-3946-89eb-d22063155368",
                                                "text": "But so was Face, crouched before the fire in her banana skins, and so was Mug, smoking a cigarette and saying as he flicked the ash: “Why doth the bridegroom tarry?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d8e24e9-486b-3813-b050-57f87f66d61b",
                                        "entry_id": "146116b6-b450-3d8a-9706-78b9e5722fa7",
                                        "glosses": [
                                            "To linger in expectation of something or until something is done or happens."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e6bc83-c07e-4b1e-873e-06554572041b",
                                                "sense_id": "5d8e24e9-486b-3813-b050-57f87f66d61b",
                                                "text": "And, thinking of to-morrow, when the church would rise up, singing, under the booming Sunday light, he thought of the light for which they tarried, which, in an instant, filled the soul, causing […] the new-born in Christ to testify: Once I was blind and now I see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3edea149-98a2-3489-a3c9-14adb641e5bb",
                                        "entry_id": "146116b6-b450-3d8a-9706-78b9e5722fa7",
                                        "glosses": [
                                            "To abide, stay or wait somewhere, especially if longer than planned."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a5b55d-d499-491a-8957-98e75e49b821",
                                                "sense_id": "3edea149-98a2-3489-a3c9-14adb641e5bb",
                                                "text": "[...] I have Thoughts to tarry a ſmall Matter in Town, to learn ſomewhat of your Lingo firſt, before I croſs the Seas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b66698-9b49-3844-b2b2-e15ba0c71776",
                                        "entry_id": "146116b6-b450-3d8a-9706-78b9e5722fa7",
                                        "glosses": [
                                            "To stay somewhere temporarily."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75534eb3-fee4-499f-b7a3-df1d2fbd9eee",
                                                "sense_id": "63b66698-9b49-3844-b2b2-e15ba0c71776",
                                                "text": "In this by-place of nature, there abode, in a remote period of American history, that is to say, some thirty years since, a worthy wight of the name of Ichabod Crane; who sojourned, or, as he expressed it, \"tarried,\" in Sleepy Hollow[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712cbf27-5687-3289-b641-408dd03e70a2",
                                        "entry_id": "146116b6-b450-3d8a-9706-78b9e5722fa7",
                                        "glosses": [
                                            "To wait for; to stay or stop for; to allow to linger."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c994835a-f440-4da9-94d1-4ec88cb30c5c",
                                                "sense_id": "712cbf27-5687-3289-b641-408dd03e70a2",
                                                "text": "Fly, fly, my lord. There is no tarrying here."
                                            },
                                            {
                                                "example_id": "57c930f1-0ffc-4831-b638-baf6b9fc8635",
                                                "sense_id": "712cbf27-5687-3289-b641-408dd03e70a2",
                                                "text": "He that will have a cake out of the wheat must needs tarry the grinding."
                                            },
                                            {
                                                "example_id": "6322cd5b-97f4-4a47-8fa3-053b54c85f22",
                                                "sense_id": "712cbf27-5687-3289-b641-408dd03e70a2",
                                                "text": "\"If I had heard otherwise,\" said the old man, looking up with a stern and menacing countenance, \"you should have heard of it too.\" And he plodded on his way, tarrying no farther question."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c76162f2-756b-3cd1-8876-22bca04f1ecb",
                                        "entry_id": "7a2b2347-a12a-30b6-aad1-dfc48331c768",
                                        "glosses": [
                                            "A sojourn."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d5e570-56df-3537-821c-e11c82fe3635",
                                        "entry_id": "60de7983-df62-3c11-865a-5d49139c1a9c",
                                        "glosses": [
                                            "Resembling tar."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab0d6c5-0177-4a9d-9194-8a157ac429c3",
                                                "sense_id": "e2d5e570-56df-3537-821c-e11c82fe3635",
                                                "text": "And he led the way from the station, stopping once to gloat over the sunset across Trafalgar Square, and again to inhale the tarry scent of the warm wood-paving, which was perfume to his nostrils as the din of its traffic was music to his ears, before we came to one of those political palaces which permit themselves to be included in the list of ordinary clubs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77e2a132-0ed1-3e2e-a312-83c3348f6c49",
                                        "entry_id": "60de7983-df62-3c11-865a-5d49139c1a9c",
                                        "glosses": [
                                            "Covered with tar."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
