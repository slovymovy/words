                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unleaded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb275228-1f6d-3060-b24a-93d36a4abfd8",
                                        "entry_id": "c5127565-32c2-3985-b0ad-53748173cac2",
                                        "glosses": [
                                            "An unleaded fuel."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6dba7f4-5aa9-45c9-ba55-ab9d95a6b5e1",
                                                "sense_id": "cb275228-1f6d-3060-b24a-93d36a4abfd8",
                                                "text": "Because one of the unleadeds just might turn out to be the right gasoline for your car. By right, I mean the one that gives you the best balance between price and performance."
                                            },
                                            {
                                                "example_id": "8ebbaa8b-6255-40c1-8309-d4c2eabadcc9",
                                                "sense_id": "cb275228-1f6d-3060-b24a-93d36a4abfd8",
                                                "text": "Check the pumps and you'll see some economy unleadeds with octane (antiknock) ratings as low as 86; some quality unleadeds rate as high as 89."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fcb3fca-9495-349c-8a3b-23947c9bff68",
                                        "entry_id": "c5127565-32c2-3985-b0ad-53748173cac2",
                                        "glosses": [
                                            "Decaffeinated coffee."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac96ab6-9b64-4c26-8eea-871032357cb4",
                                                "sense_id": "9fcb3fca-9495-349c-8a3b-23947c9bff68",
                                                "text": "And while you may enjoy your morning coffee buzz, caffeine is active in the bloodstream for up to nine hours, so it is best to switch to unleaded after noon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7f7f54-8fd8-3a68-abea-e71c96f669ad",
                                        "entry_id": "c5127565-32c2-3985-b0ad-53748173cac2",
                                        "glosses": [
