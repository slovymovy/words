                    {
                        "translation_id": "f2125a2a-1b1f-4903-a382-3d32b5e96c6a",
                        "source_entry_id": "823b7f88-21d2-3d26-9336-dfbb1ef9ae14",
                        "source_sense_id": "22e90755-e06e-3edc-90a3-e8bf1574bb14",
                        "target_lang_word": "clay",
                        "target_lang_code": "en",
