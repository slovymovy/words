                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c457d48a-94cf-432b-90db-5c604607f0ef",
                        "source_entry_id": "9163b2f5-df36-3732-aaa8-8715193f8d7f",
                        "source_sense_id": "d0d066e8-619b-377e-bed6-122137d7b368",
