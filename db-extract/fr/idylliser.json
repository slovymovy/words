                "senses": [
                    {
                        "sense_id": "af5e613f-b8ec-3d0b-9360-3ad8cefe40ce",
                        "entry_id": "d1388728-6a22-3929-aae1-e2363856180a",
                        "glosses": [
                            "Représenter sous un jour idyllique."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fab695-01fb-4478-8888-f4f7f22313d0",
                                "sense_id": "af5e613f-b8ec-3d0b-9360-3ad8cefe40ce",
                                "text": "Si les hommes savaient encore aimer les femmes, si les femmes connaissaient leur rôle et s'y tenaient pour le remplir tout entier, on aurait une cité idéale, fondée sur la plus délicate interprétation des bonnes lois de nature. Je sais que j’idyllise un peu la conception de M. Fouquier : qu'il me pardonne cette fantaisie."
                            }
                        ]
                    }
