                                        "examples": [
                                            {
                                                "example_id": "35cd6d05-c14c-4665-a0e6-85fc87d33895",
                                                "sense_id": "41d30136-eca9-3055-b122-af538ae37328",
                                                "text": "Die Tierfamilie der Kängurus ist in Australien endemisch."
