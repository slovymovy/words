                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01af145-2a23-4aaf-a57c-46943dcafe4b",
                                                "sense_id": "dd9f9cd0-e52f-3911-947c-58485e95914d",
                                                "text": "Pazourek, ačkoliv je tvrdý a při užívání někdy překonává svou břitkostí a užitnými vlastnostmi současný skalpel, je křehký."
