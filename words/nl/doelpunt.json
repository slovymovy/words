                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pele scoorde het enige <w>doelpunt</w> van de wedstrijd.",
                            "target_lang_translations": {
                                "ru": "Пеле забил единственный <w>гол</w> в матче.",
                                "en": "Pele scored the only <w>goal</w> of the match.",
                                "pl": "Pele strzelił jedynego <w>gola</w> w meczu.",
                                "de": "Pele erzielte das einzige <w>Tor</w> des Spiels.",
                                "fr": "Pelé a marqué le seul <w>but</w> du match.",
                                "it": "Pelé ha segnato l'unico <w>gol</w> della partita.",
