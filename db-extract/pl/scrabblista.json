                                        "entry_id": "84aed827-a70e-31b6-9582-aa093e728cff",
                                        "glosses": [
                                            "A player of the word game Scrabble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99841bc7-6107-4485-ad36-65086ccf2294",
                                                "sense_id": "471b2c1d-c7c1-32c8-a35e-007258b742b4",
                                                "text": "More specifically, Scrabblers are diehard, competitive, and occasionally cutthroat players who treat the game like it's chess or baseball..."
                                            }
