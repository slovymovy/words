                "senses": [
                    {
                        "sense_id": "3581810e-4932-341a-824e-a11eab11cb7f",
                        "entry_id": "62e6b7ae-d3eb-33ff-b3f8-4429b9b05113",
                        "glosses": [
                            "(verzierte) Hohlform, in die frische Butter gefüllt wird und so eine ansprechende und regelmäßige Form erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8db576-7d37-42a9-864c-9fd98a8192b5",
                                "sense_id": "3581810e-4932-341a-824e-a11eab11cb7f",
                                "text": "„Häufig waren die gekerbten Buttermodel für festliche Gelegenheiten, wie Weihnachten, Ostern, Almabtrieb, aber auch bei Hochzeiten in Verwendung.“"
                            },
                            {
                                "example_id": "92334bc3-7d8d-42e4-a33c-862e9c617b69",
                                "sense_id": "3581810e-4932-341a-824e-a11eab11cb7f",
                                "text": "„Jetzt kann die Butter geformt werden – es gibt wunderschöne Buttermodeln mit alten, traditionellen Mustern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
