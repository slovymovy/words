                "senses": [
                    {
                        "sense_id": "be9c5163-73c1-3d49-967a-c0c0a9971f06",
                        "entry_id": "1023d80e-c5b4-3d15-8cdf-f7f6ab55a8d7",
                        "glosses": [
                            "Diagramme à colonnes : diagramme où les catégories sont sur l’axe horizontal et leur valeur représentée par l’extension des colonnes (barres verticales) vers le haut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b9ee7f-7123-420c-9ac6-e641248db3db",
                                "sense_id": "be9c5163-73c1-3d49-967a-c0c0a9971f06",
                                "text": "Das Balkendiagramm hat gegenüber dem Säulendiagramm den Vorteil, dass es mehr Platz für die waagerechte Beschriftung der Kategorien bietet.",
                                "translation": "Le diagramme à barres (horizontales) a l’avantage par rapport au diagramme à colonnes d’offrir plus de place pour le marquage horizontal des catégories."
                            }
                        ]
                    }
