                    {
                        "sense_id": "6758c29a-5763-3dcb-a706-5f001799e650",
                        "entry_id": "a92203f3-9299-37d4-a13d-67fc10b48450",
                        "glosses": [
                            "The Bombing of Dresden."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "b0216c3e-0417-49f5-b04a-b59082190480",
                                "sense_id": "6758c29a-5763-3dcb-a706-5f001799e650",
                                "text": "The actual total hardly matters: if Dresden was indeed a war crime, just one death would make it so."
                            },
                            {
                                "example_id": "81cc770e-8398-49ae-b558-82c24b332835",
                                "sense_id": "6758c29a-5763-3dcb-a706-5f001799e650",
                                "text": "‘Father, you saw the papers, when Dresden happened. You see the papers today. People are seeing the cost of this, truly. Now that we know the consequences, countries will not use it.’"
                            }
                        ]
                    }
                ],
