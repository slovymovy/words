                        "glosses": [
                            "Danseuse de salsa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435aafaa-e77e-4c6f-aeac-1eb63273b18b",
                                "sense_id": "e21b0f40-c128-35a5-9393-1db9e7a68402",
                                "text": "Il y a les salseros et les salseras (danseurs et danseuses de salsa) débutants, qui mettent en pratique ce qu’ils ont appris en cours. Et il y a les danseurs professionnels, qui s’élancent les premiers et entraînent les hésitants."
                            },
                            {
                                "example_id": "5a97b8fd-22f1-47a4-9b1e-4fea37507911",
                                "sense_id": "e21b0f40-c128-35a5-9393-1db9e7a68402",
                                "text": "Les quais de Seine sont bien agités depuis le 14 juin dernier… Les salseros et les salseras sont de retour pour faire vibrer la capitale au rythme des musiques latines."
                            }
                        ]
                    }
