                                                "example_id": "49d96407-4df3-43d2-b26d-17e6e73a35be",
                                                "sense_id": "a6d9b511-9e59-3d2b-8cd0-806ba582c055",
                                                "text": "My becomings kill me, when they do not eye well to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f889f9be-953d-3764-98e0-2d1c0790936b",
                                        "entry_id": "78111720-7949-3e78-9327-fd2a6b991e26",
                                        "glosses": [
                                            "To remove the reproductive buds from (potatoes)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfae48f6-0b69-4765-b510-bcf28a23fed4",
                                                "sense_id": "f889f9be-953d-3764-98e0-2d1c0790936b",
                                                "text": "Once the potatoes have been rumbled they require 'eyeing' with a turning knife or hand peeler."
                                            },
                                            {
                                                "example_id": "732e5ed4-1925-4eb4-80a3-4f3492c92c1c",
                                                "sense_id": "f889f9be-953d-3764-98e0-2d1c0790936b",
                                                "text": "My first assignment was eyeing old potatoes. The Siegler brothers would buy potatoes so old they looked like an octopus. My job was to make them look presentable and, of course, sellable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1887b77a-4a54-34a0-9dca-f317457550da",
                                        "entry_id": "78111720-7949-3e78-9327-fd2a6b991e26",
                                        "glosses": [
                                            "To allow (fish eggs) to develop so that the black eye spots are visible."
