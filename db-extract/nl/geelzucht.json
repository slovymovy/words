                "senses": [
                    {
                        "sense_id": "2884b2ed-32e3-3235-9bb0-f95b0a6d65f4",
                        "entry_id": "5c07cde5-32d2-3d45-b0e7-1ae6b78ddc3a",
                        "glosses": [
                            "een gelige gelaatskleur hebben, gewoonlijk als gevolg van hepatitis"
                        ],
                        "tags": [],
