                ],
                "senses": [
                    {
                        "sense_id": "d0de273f-37bc-36c6-ae92-0d74b08df861",
                        "entry_id": "3a0a7eb0-5f51-3f92-a77f-2a9f08fede1f",
                        "glosses": [
                            "Composante de base et contractile des myofibrilles du muscle strié, composée de myosine, d'actine et de titine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5830045c-a996-410d-a88f-8ec1156170dc",
                                "sense_id": "d0de273f-37bc-36c6-ae92-0d74b08df861",
                                "text": "La fibre musculaire d'un biceps peut contenir plus de 100 000 sarcomères."
                            },
                            {
                                "example_id": "bd2a698b-e8f0-469a-8a9a-229daf089f7e",
                                "sense_id": "d0de273f-37bc-36c6-ae92-0d74b08df861",
                                "text": "Les myofibrilles des muscles lisses ne sont pas regroupées en sarcomères."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b486a71d-f055-4787-b4c1-82013713faeb",
                        "source_entry_id": "3a0a7eb0-5f51-3f92-a77f-2a9f08fede1f",
                        "source_sense_id": "d0de273f-37bc-36c6-ae92-0d74b08df861",
                        "target_lang_word": "sarcomere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcomere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aec67c0-56ad-33cf-903f-512c2e93cbaf",
                                        "entry_id": "7163165a-9bf6-3801-8186-24eebdb32ee8",
                                        "glosses": [
                                            "The contractile unit of the myofibril of a striated muscle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bacfc098-240d-4bc8-a7ed-2e720162681a",
                                                "sense_id": "9aec67c0-56ad-33cf-903f-512c2e93cbaf",
                                                "text": "1997, Kenneth Axen, Kathleen Vermitsky Axen, The Princeton Review Physiology Coloring Workbook, Princeton Review Publishing, Random House, page 51,\nThe sarcomere determines the amount of overlap between the actin and myosin filaments and thus, the number of cross-bridges that participate in a given contraction. Since each cross bridge contributes to the contraction, sarcomeres generate their maximal force when their contraction employs the maximal number of cross-bridges between the actin and myosin filaments."
                                            },
                                            {
                                                "example_id": "37bc0c53-036d-4731-a921-ebc2c19ec530",
                                                "sense_id": "9aec67c0-56ad-33cf-903f-512c2e93cbaf",
                                                "text": "Specific proteins are responsible for the bands and zones within each sarcomere."
                                            },
                                            {
                                                "example_id": "bc9a3245-33e1-4877-8224-8fd446a008c6",
                                                "sense_id": "9aec67c0-56ad-33cf-903f-512c2e93cbaf",
                                                "text": "Of particular importance was the confirmation that the sarcomere lengths are instantaneously unstable for any reasonable assignment of parameters and number of sarcomeres, even as low as 100."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
