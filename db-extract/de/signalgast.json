                "senses": [
                    {
                        "sense_id": "62e1f0f9-ecf8-30a9-add3-4c317a00f9a8",
                        "entry_id": "615d2ea9-2231-3a6b-8e55-0fb6d272b464",
                        "glosses": [
                            "Matrose, der nach Anweisung eines höheren Besatzungsmitglieds optische Zeichen mit Hilfe von Flaggen oder Licht gibt oder empfängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300861bf-8111-46c5-b7a0-fffa345ec278",
                                "sense_id": "62e1f0f9-ecf8-30a9-add3-4c317a00f9a8",
                                "text": "„Die Mannschaftsräume waren klein und bis zur Unerträglichkeit überfüllt, alles war da zusammengewürfelt: Matrosen, Heizer, Signalgasten und Funker.“"
                            },
                            {
                                "example_id": "61778266-0552-47bf-aa4d-d4fbf5db7ec2",
                                "sense_id": "62e1f0f9-ecf8-30a9-add3-4c317a00f9a8",
                                "text": "„Ein kaltblütiger Signalgast hatte die Bomben aufgenommen, zwei empfingen sogar ein schwärzliches Licht von der Morgensonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
