                "senses": [
                    {
                        "sense_id": "b7c38b95-d3c7-3dd6-aca9-c88db800b398",
                        "entry_id": "5fdfa1dc-edae-394d-85f5-ea918a6d28a3",
                        "glosses": [
                            "Donner un caractère oulipien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e58fef-6632-41c6-884a-f1e543b4061f",
                                "sense_id": "b7c38b95-d3c7-3dd6-aca9-c88db800b398",
                                "text": "Ou encore : constituer un « panel représentatif » et réinventer avec ceux qui le constituent la forme conventionnelle de l’entretien, l’oulipianiser un peu."
                            },
                            {
                                "example_id": "16838356-d457-49da-a42a-389545e47f89",
                                "sense_id": "b7c38b95-d3c7-3dd6-aca9-c88db800b398",
                                "text": "L'auteur, d'une certaine façon, sous-entend que l'on pourrait ajouter des contraintes sémantiques à la forme proposée, « l'oulipianiser » en quelque sorte."
                            },
                            {
                                "example_id": "e4ad790d-cea4-4806-9bec-794b983ff761",
                                "sense_id": "b7c38b95-d3c7-3dd6-aca9-c88db800b398",
                                "text": "Fin juillet et début août, pour les fans d'Oulipo et ceux qui ont une envie d'oulipianiser au début de l'été !"
                            }
                        ]
                    }
