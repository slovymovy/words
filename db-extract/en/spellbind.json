                "translations": [
                    {
                        "translation_id": "807eb10f-fa93-438e-8771-a8de3699a50e",
                        "source_entry_id": "7b7c91d5-3c29-33c4-b7db-199d247b2af3",
                        "source_sense_id": "62f98652-6213-3edd-9f3b-20da272af777",
                        "target_lang_word": "迷惑",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "迷惑",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                        "entry_id": "79f5a851-bac5-345f-b17a-f88519ce074d",
                                        "glosses": [
                                            "迷惘的，不明事理的"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ef70b6-dfa7-499d-8830-a4681bba17ba",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "百姓迷惑而國家不治。"
                                            },
                                            {
                                                "example_id": "d76a5a63-c6a7-4599-b0d8-c0e9a64ae9a9",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "百姓迷惑而国家不治。"
                                            },
                                            {
                                                "example_id": "5bc712b2-e3b3-4ea0-9d68-d1bb448547e0",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "曾煩毒以迷惑兮，羌孰可與言己？"
                                            },
                                            {
                                                "example_id": "b1f5fafd-fed2-4d49-a3cb-5c1330bec458",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "曾烦毒以迷惑兮，羌孰可与言己？"
                                            },
                                            {
                                                "example_id": "39b1b8eb-faac-406b-ad7d-490a58e3a646",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "經山谷間，迷惑失道。"
                                            },
                                            {
                                                "example_id": "b3f807d3-7285-4d4d-b9bb-247718772295",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "经山谷间，迷惑失道。"
                                            },
                                            {
                                                "example_id": "c3780301-75cd-4f90-85da-b2cdbeb881d9",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "周萍迷惑地望着父親同侍萍。"
                                            },
                                            {
                                                "example_id": "179941cd-118a-40a3-be4f-9bd17e2d8eac",
                                                "sense_id": "eec4ae61-dc5d-3105-99d4-16df0566489f",
                                                "text": "周萍迷惑地望着父亲同侍萍。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "迷惑",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                        "entry_id": "cac65a02-530b-3014-ae01-dc452bed1f5d",
                                        "glosses": [
                                            "使人迷失、疑惑"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef9eb8a-4b4a-406c-bd06-8c20a2b3c0af",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "这岛子确实有股迷惑人的力量。"
                                            },
                                            {
                                                "example_id": "bd31c020-7ace-440f-98ac-9c3501a02711",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "變易國常，擅創為令，迷或其君。"
                                            },
                                            {
                                                "example_id": "c68eb1a7-fb3a-4d50-881b-082c6663c842",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "变易国常，擅创为令，迷或其君。"
                                            },
                                            {
                                                "example_id": "4bd0c4c5-409a-4746-86af-f21695a585e7",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "矯言偽行，以迷惑天下之主。"
                                            },
                                            {
                                                "example_id": "2f700944-2db1-428a-a04d-cd572a40fadc",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "矫言伪行，以迷惑天下之主。"
                                            },
                                            {
                                                "example_id": "548fe57b-8075-483e-bf84-055910e447d9",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "這二妖，乃是多年的龜精，一雌一雄，慣迷惑少年男女。"
                                            },
                                            {
                                                "example_id": "59755e4f-66a0-45e6-8f07-33b253bab107",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "这二妖，乃是多年的龟精，一雌一雄，惯迷惑少年男女。"
                                            },
                                            {
                                                "example_id": "f945221c-383e-4d09-bee1-accff89d5205",
                                                "sense_id": "9540b23e-f179-3d46-b1a3-10fd83934c02",
                                                "text": "這島子確實有股迷惑人的力量。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b990ef3-1663-4742-a98f-b51745817c65",
                        "source_entry_id": "7b7c91d5-3c29-33c4-b7db-199d247b2af3",
