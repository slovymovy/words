                        "glosses": [
                            "politische Bewegung und Einstellung zur Vereinigung aller arabischen Völker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d06a36-4c3b-4e92-a233-2ccac1ad9f38",
                                "sense_id": "1f322ecf-338b-3376-b0d9-1023e7c45470",
                                "text": "„Die Strahlkraft des ägyptischen Panarabismus unter Gamal Abd al-Nasser und die Sympathie vieler Araberinnen und Araber für den Sozialismus stellten die Legitimität der Golfmonarchien zunehmend infrage.“"
                            },
                            {
                                "example_id": "6f2ae256-a740-48a1-8eef-314c46ca6385",
                                "sense_id": "1f322ecf-338b-3376-b0d9-1023e7c45470",
                                "text": "„So etwas war neu und beflügelte den Panarabismus auch in der Region von Aden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
