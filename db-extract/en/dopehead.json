                    {
                        "translation_id": "5e845617-9e2f-4f62-9cdc-994e6543b15d",
                        "source_entry_id": "68305dbd-4250-337a-badf-a6d1ee44517f",
                        "source_sense_id": "2a0f5e5a-9289-341b-921b-f920f9902a47",
