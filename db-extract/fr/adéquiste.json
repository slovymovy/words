                        "entry_id": "d9337cdc-e7f1-31ba-ba2c-0f56c18d462e",
                        "glosses": [
                            "Qui se rapporte à l’Action démocratique du Québec."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "f649553f-f710-475d-801d-2d7367437af8",
                                "sense_id": "d5486b6d-3918-338b-acf4-78410bdd0501",
                                "text": "Une candidate adéquiste, un député adéquiste, le chef adéquiste."
                            },
                            {
                                "example_id": "6b280b49-c80c-4d61-bd7d-453343a60c6b",
                                "sense_id": "d5486b6d-3918-338b-acf4-78410bdd0501",
                                "text": "La vision adéquiste a déjà charmé une partie du milieu des affaires québécois, qui délaisse le PLQ de Jean Charest pour aller vers le parti le plus « libéral » à ses yeux."
                            },
                            {
                                "example_id": "a2dc267b-4e12-4936-9861-a68cb2022144",
                                "sense_id": "d5486b6d-3918-338b-acf4-78410bdd0501",
                                "text": "MM. Poulin et Charest s’interpellent comme « des amis », affirme-t-on dans les cercles adéquistes."
                            }
                        ]
                    }
                ],
