                            }
                        },
                        {
                            "text": "Ik ga morgen samen met mijn <w>moeder</w> winkelen.",
                            "target_lang_translations": {
                                "ru": "Завтра я иду по магазинам вместе с <w>мамой</w>.",
                                "en": "I am going shopping with my <w>mother</w> tomorrow.",
