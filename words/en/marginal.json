                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers struggled to grow crops on such <w>marginal</w> land.",
                            "target_lang_translations": {
                                "ru": "Фермеры изо всех сил пытались вырастить урожай на такой <w>малопродуктивной</w> земле.",
