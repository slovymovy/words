                                        "entry_id": "55ee1d05-4f56-3ecd-8adb-b64c427cbc5b",
                                        "glosses": [
                                            "The state or quality of being sparse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf29659-0c25-4952-87ab-dd72c34962b8",
                                                "sense_id": "1e0600d5-de85-3179-aef6-84e7bdb9faf1",
                                                "text": "The sparseness of the hair on his head made him long for his full-haired youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cbcbf9-2b4b-3d5b-b205-65d86ba57a6e",
                                        "entry_id": "55ee1d05-4f56-3ecd-8adb-b64c427cbc5b",
                                        "glosses": [
                                            "The result or product of being sparse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e42d5ece-94e3-4bad-b698-05ab342c2497",
                        "source_entry_id": "018a7f8f-32e9-3c98-8988-0ade73c01a6e",
                        "source_sense_id": "075e3502-9d40-31d6-9c53-872fd4fb37d0",
                        "target_lang_word": "vacuity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "056b9686-6b3a-3048-866d-d6a0f4f8b318",
                                        "entry_id": "297449b3-145e-3d9e-ac2f-015d231a37fe",
                                        "glosses": [
                                            "Emptiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19820700-96b9-46e5-a6ce-72ca3e1ad2a9",
                                                "sense_id": "056b9686-6b3a-3048-866d-d6a0f4f8b318",
                                                "text": "The meanes I use to suppresse this frenzy, and which seemeth the fittest for my purpose, is to crush, and trample this humane pride and fiercenesse under foot, to make them feele the emptinesse, vacuitie, and no worth of man[…]."
                                            },
                                            {
                                                "example_id": "6a14ddd4-f3be-46f8-a151-d103c2670479",
                                                "sense_id": "056b9686-6b3a-3048-866d-d6a0f4f8b318",
                                                "text": "to find so sensible a breach or vacuity in the course of the passions, by means of this breach in the connexion of ideas[…]."
                                            },
                                            {
                                                "example_id": "ac818d86-afb9-4e82-b3e2-e93051067f7e",
                                                "sense_id": "056b9686-6b3a-3048-866d-d6a0f4f8b318",
                                                "text": "The Baronet was not more animated than ordinarily—there was a happy vacuity about him which enabled him to face a dinner, a death, a church, a marriage, with the same indifferent ease."
                                            },
                                            {
                                                "example_id": "c0b5dd74-f8fe-4123-a782-a3d5a23bea8a",
                                                "sense_id": "056b9686-6b3a-3048-866d-d6a0f4f8b318",
                                                "text": "At first glance, Saltburn is classic clash-of-the-classes fare: a tale of social strata, moral vacuity and the seductions of wealth, with a poor boy ushered into his rich friend's kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "369e0a54-1656-324c-8530-8338e7534628",
                                        "entry_id": "297449b3-145e-3d9e-ac2f-015d231a37fe",
                                        "glosses": [
                                            "Physical emptiness, an absence of matter; vacuum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c0a38fc-4a24-32e4-890d-550d08ab7d85",
