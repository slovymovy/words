                "senses": [
                    {
                        "sense_id": "ca540f93-31f8-3449-816f-6e700c03ce1d",
                        "entry_id": "6e0c0d57-5425-32ca-a5da-9ba2a0083cd4",
                        "glosses": [
                            "Pfeife einer Orgel aus Holz oder Metall, bei der ein hörbarer Ton dadurch erzeugt wird, dass ein durch einen schmalen Spalt in die Pfeife geblasener Luftstrom auf eine scharf zulaufende Kante, das Labium, die ‚Lippe‘, trifft, von diesem abgelenkt wird und zu schwingen beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611b157e-c503-466b-b037-2823f15dc8e9",
                                "sense_id": "ca540f93-31f8-3449-816f-6e700c03ce1d",
                                "text": "Die Labialpfeife erzeugte einen wohlklingenden Ton."
                            },
                            {
                                "example_id": "a2ce6e67-a808-410a-8c3c-c6120b01d7f8",
                                "sense_id": "ca540f93-31f8-3449-816f-6e700c03ce1d",
                                "text": "Der von einer Labialpfeife erzeugte Ton hängt davon ab, aus welchem Material sie besteht."
                            },
                            {
                                "example_id": "01408391-1c1c-411d-ac8b-b89938afb1df",
                                "sense_id": "ca540f93-31f8-3449-816f-6e700c03ce1d",
                                "text": "Die Orgel verfügt über 20 Labialpfeifen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
