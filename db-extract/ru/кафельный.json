                    }
                ],
                "senses": [
                    {
                        "sense_id": "471a0709-0480-358f-859c-89c8229b8f64",
                        "entry_id": "eed74155-d06d-39d8-b7ef-4cfd22e52537",
                        "glosses": [
                            "облицованный кафелем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b58a3c3-3a4a-4aad-8b84-02e6338aaaed",
                                "sense_id": "471a0709-0480-358f-859c-89c8229b8f64",
                                "text": "В сумраке запущенной кухни белел кафельный пол, выщербленный от колки дров."
                            },
                            {
                                "example_id": "78ddd8f4-23a5-46b7-82ec-c2272e37b29f",
                                "sense_id": "471a0709-0480-358f-859c-89c8229b8f64",
                                "text": "В комнатах также высились по углам кафельные печи: центральное отопление было в то время редкостью."
                            },
                            {
                                "example_id": "5e51de9d-bd3b-4da4-aee8-5e6b4ccfee3e",
                                "sense_id": "471a0709-0480-358f-859c-89c8229b8f64",
                                "text": "После тюрьмы я приобрёл привычку часами мокнуть в горячей воде, меж голубоватых кафельных стен."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f60842-0575-3139-8f08-c39942f7f549",
                        "entry_id": "eed74155-d06d-39d8-b7ef-4cfd22e52537",
                        "glosses": [
