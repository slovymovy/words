                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms features a golden eagle <w>rising</w> above the shield.",
                            "target_lang_translations": {
                                "ru": "На гербе изображен золотой орел, <w>взлетающий</w> над щитом."
                            }
