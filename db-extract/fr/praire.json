                "forms": [
                    {
                        "form_id": "af848822-e080-4cff-8ca3-d610be28425c",
                        "entry_id": "493650b7-0cd4-39e3-afd8-bcc63f4a8681",
                        "tags": [
                            "plural"
                        ],
                        "form": "praires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "241dbb5f-8bef-3426-b7dc-0762876d5c33",
                        "entry_id": "493650b7-0cd4-39e3-afd8-bcc63f4a8681",
                        "glosses": [
                            "Coquillage bivalve se trouvant (entre autres) sur les bords de la Méditerranée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebde6da5-8eae-4d38-96fd-63bbf034cb1e",
                                "sense_id": "241dbb5f-8bef-3426-b7dc-0762876d5c33",
                                "text": "La praire est un coquillage bivalve qui rappelle un peu la palourde, sauf que la coquille, plus bombée, présente des stries concentriques très marquées."
                            },
                            {
                                "example_id": "54936ee6-fe20-4830-aa1e-023c51f0e8ca",
                                "sense_id": "241dbb5f-8bef-3426-b7dc-0762876d5c33",
                                "text": "Sur certains points les plus fréquentés de Marseille, on étale les coquillages les plus savoureux, les plus appétissants : les moules, les clovisses, les oursins, les praires, les huîtres."
                            },
                            {
                                "example_id": "297e29a6-6fdf-47d9-adad-a8c157a7b42e",
                                "sense_id": "241dbb5f-8bef-3426-b7dc-0762876d5c33",
                                "text": "Tandis que, garante de ma clandestinité, la télévision de la loge beuglait sans que je l’entende des insanités pour cerveaux de praires, je me pâmais, les larmes aux yeux, devant les miracles de l’Art."
                            },
                            {
                                "example_id": "ba0b3df3-4e9a-48b1-b950-666a448ea893",
                                "sense_id": "241dbb5f-8bef-3426-b7dc-0762876d5c33",
                                "text": "La grapette à main est préconisée pour les coques, les palourdes et les praires — le couteau étant toléré pour ces deux dernières."
                            }
                        ]
                    }
                ],
