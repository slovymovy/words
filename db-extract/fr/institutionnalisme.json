                        "entry_id": "64b467e1-7dc2-3c62-b385-b60a0f3b0f82",
                        "glosses": [
                            "Doctrine économique qui prône le rôle joué par les institutions dans l’activité économique."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "b5b0d4b5-f18c-45fb-923e-a3b7a3f2fbc0",
                                "sense_id": "15c17868-3c0c-399d-aeed-fb5d60c0c17e",
                                "text": "C’est aux États-Unis que l’institutionalisme a eu son plus grand rayonnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5805d59e-13e2-3b26-a717-81070c6e9431",
                        "entry_id": "64b467e1-7dc2-3c62-b385-b60a0f3b0f82",
                        "glosses": [
                            "Adhésion envers ce qui est institué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b289b499-71a3-435b-8303-e5c902553f22",
                                "sense_id": "5805d59e-13e2-3b26-a717-81070c6e9431",
                                "text": "Le Christ n'avait ni fondé, ni prévu l’Église […]. Pour les uns elle représentait, avec son institutionalisme rigide, une trahison de son message."
                            }
                        ]
                    }
                ],
