                                        "sense_id": "23de9c16-225d-3a3a-9acd-539eb76176b3",
                                        "entry_id": "50699d60-3da1-3ee0-bd4e-c2cdf3dc4eef",
                                        "glosses": [
                                            "The condition of being visible."
                                        ],
                                        "tags": [
