                    {
                        "form_id": "f6aa26a6-2a8f-47a0-be6e-f4d53dd21619",
                        "entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reskripte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b4aff62-f8e6-3827-9dc0-b627f92c7e7e",
                        "entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                        "glosses": [
                            "schriftlicher, amtlicher Erlass"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "616d434e-3846-4c29-a620-3c8e4795b129",
                                "sense_id": "6b4aff62-f8e6-3827-9dc0-b627f92c7e7e",
                                "text": "„Ferner verbot Trajan die Beachtung anonymer Denunziationen und schließlich endete das Reskript mit einem Bekenntnis, […]: Ein allzu inquisitorisches Verhalten seitens des Staates werde dem Geist der Epoche nicht gerecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "577bc8ad-7eb4-3202-9144-80e314b725e0",
                        "entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                        "glosses": [
                            "päpstlicher oder bischöflicher Entscheid in einzelnen Rechtsfällen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27442506-8a2e-474d-95bd-7404c3663462",
                        "source_entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                        "source_sense_id": "6b4aff62-f8e6-3827-9dc0-b627f92c7e7e",
                        "target_lang_word": "rescript",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rescript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41c2d45e-e004-3b86-b780-bd83ff1b9b69",
                                        "entry_id": "a929cff9-4257-36a7-a4f2-b0c147fa0fe7",
                                        "glosses": [
                                            "A clarification of a point of law by a monarch issued upon formal consultation by a lower magistrate."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d0d8db-0be0-4406-a246-10f1b4b44f83",
                                                "sense_id": "41c2d45e-e004-3b86-b780-bd83ff1b9b69",
                                                "text": "\"'In order that the people may know of my decision, I request you to prepare at once an imperial rescript that I may broadcast to the nation.'\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1851e81-e8e4-3750-ba76-6ce92025d893",
                                        "entry_id": "a929cff9-4257-36a7-a4f2-b0c147fa0fe7",
                                        "glosses": [
                                            "An ad hoc reply of a pope to some specific question of canon law or morality, without precedential force, sometimes (improper) inclusive of decretals which serve as precedents in canon law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb28f85d-966b-4154-9845-d0a54b546e7b",
                                                "sense_id": "e1851e81-e8e4-3750-ba76-6ce92025d893",
                                                "text": "Decretals... ought, properly speaking, to be distinguished, on the one hand from constitutions... enacted by the Pope sua sponte without reference to any particular case, and on the other hand from rescripts... which apply only to special circumstances or individuals, and constitute no general precedent. But this nomenclature is not strictly observed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1170a542-ee63-3f56-a37b-09655c213243",
                                        "entry_id": "a929cff9-4257-36a7-a4f2-b0c147fa0fe7",
                                        "glosses": [
                                            "A duplicate copy of a legal document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c695fe2-f8fd-3e19-bbdd-22a6e68262ab",
                                        "entry_id": "a929cff9-4257-36a7-a4f2-b0c147fa0fe7",
                                        "glosses": [
                                            "A rewriting, a document copied or written again."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rescript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9710a0e6-a5cf-3fc9-abb3-a745efbbd32a",
                                        "entry_id": "23b03f1e-9a6e-3ef4-b3f2-11d53a389966",
                                        "glosses": [
                                            "To script again or anew."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66cf3127-2b48-4d09-b0be-99efb012d396",
                                                "sense_id": "9710a0e6-a5cf-3fc9-abb3-a745efbbd32a",
                                                "text": "We're rescripting some popular British TV shows for an American audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a69fbc-5912-4107-a855-ed63ecfaff53",
                        "source_entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                        "source_sense_id": "6b4aff62-f8e6-3827-9dc0-b627f92c7e7e",
                        "target_lang_word": "rescrit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rescrit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                                        "glosses": [
                                            "Interprétation officielle d’un texte donnée par l’Administration sur la demande d’un administré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c3458b-6597-4005-843c-5b3226bad21a",
                                                "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                                                "text": "Les industriels dont nous avons parlé étaient, bien entendu, des libérés admis aux droits civiques de la Nouvelle-Galles du Sud, après expiration de leur peine, ou même avant, par rescrit du gouverneur."
                                            },
                                            {
                                                "example_id": "bdd14faa-abe9-4d0f-951c-a53929ebf03e",
                                                "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                                                "text": "Un contribuable peut solliciter de l’administration fiscale un rescrit, c’est à dire une réponse formelle de l’administration à une question sur l’interprétation d’un texte fiscal (question de législation) ou sur l’interprétation de la situation de fait au regard du droit fiscal (rescrit général)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc89c2df-b88f-34f2-960d-ccb59845e6e3",
                                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                                        "glosses": [
                                            "Réponse de l’empereur aux questions adressées par les gouverneurs, les magistrats."
                                        ],
                                        "tags": [
                                            "Droit romain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c6479b-e640-467e-bb70-86ef4c38a966",
                                                "sense_id": "dc89c2df-b88f-34f2-960d-ccb59845e6e3",
                                                "text": "Après de longs et tristes débats, Idace obtint de l’empereur Gratien un rescrit qui bannit de toute terre les hérétiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13a9f88d-30b3-3446-b44a-cc0bbadd7029",
                                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                                        "glosses": [
                                            "Réponse du pape sur toute question de théologie, pour servir de décision ou de loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887047be-5ccc-4bbd-a50f-74793071540a",
                                                "sense_id": "13a9f88d-30b3-3446-b44a-cc0bbadd7029",
                                                "text": "[…] lettres, sur parchemin, munies du sceau de cire de l'évêque de Paris, Ranulphe d’Hombloniere, datées de 1281, le jeudi précédant la fête des Palmes (19 mars 1282, nouveau style), et portant vidimus du rescrit précité adressé à Philippe [III], roi des Francs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db39a973-e205-457d-935d-c9fe9080dbeb",
                        "source_entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
