                ],
                "senses": [
                    {
                        "sense_id": "edf531ef-9ba4-3ea1-9eba-dd848c3f6b42",
                        "entry_id": "63ea3750-f659-3b93-b5be-1448e06e50ce",
                        "glosses": [
                            "Vorbau vor einem Zelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a97ced-8e3d-46dd-921d-022846d20b3f",
                                "sense_id": "edf531ef-9ba4-3ea1-9eba-dd848c3f6b42",
                                "text": "„Das Vorzelt scheint die Funktion einer Wohnküche zu erfüllen.“"
                            },
                            {
                                "example_id": "00efd028-1109-4308-b79e-bb4d4f299e5d",
                                "sense_id": "edf531ef-9ba4-3ea1-9eba-dd848c3f6b42",
                                "text": "„Abends setzt sich der Papa mit der Gaslampe ins Vorzelt, trinkt bis tief in die Nacht mehrere Flaschen Rosé, raucht unzählige halbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afdf3c81-323c-4eb8-9362-375afb0c70ed",
                        "source_entry_id": "63ea3750-f659-3b93-b5be-1448e06e50ce",
                        "source_sense_id": "edf531ef-9ba4-3ea1-9eba-dd848c3f6b42",
                        "source_sense_description": "Vorbau vor einem Zelt",
                        "target_lang_word": "auvent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auvent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                        "entry_id": "ca937beb-7e5d-37a8-946c-d452ac3a18ac",
                                        "glosses": [
                                            "Petit toit en saillie, aménagé ordinairement au-dessus des entrées de bâtiments, pour protéger de la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57b1106-ed7b-4a17-a392-ac79046cadb7",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Il y avait beau temps, au lavoir communal ou sous les auvents d’aisseaux qu’on échangeait d’oreille à oreille de petites réflexions et qu’on se faisait part d’observations particulières."
                                            },
                                            {
                                                "example_id": "8367fe9f-4674-448d-b6d1-07d36af0b109",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Comme aux très anciennes bâtisses, l’auvent du toit dévale presque jusqu'au sol, en guise de hangar."
                                            },
                                            {
                                                "example_id": "8f0a5cac-5ed8-4b23-bb8b-c5ac339c2f2f",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Il prit un sac plié sur une des cages à lapins alignées sous le petit auvent fiché au flanc de la maison, et se dirigea vers la remise pour y faire provision de foin."
                                            },
                                            {
                                                "example_id": "058ed747-054c-415b-a593-1ac4a7571134",
                                                "sense_id": "d4aa7a2d-7ee3-3592-b0e0-11af7b8d4d0d",
                                                "text": "Bien protégés, les passants réfugiés en dessous des auvents transformés pour la cause en abris provisoires, contemplaient le garçon qui accélérait sa marche en maugréant du fait qu’il n’avait, pour une fois, pas emporté de parapluie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
