                "translations": [
                    {
                        "translation_id": "001c15a5-41d0-4fcd-81c3-a6b548a17eb8",
                        "source_entry_id": "8a392e1c-5c43-3483-bef4-625bd1d92362",
                        "source_sense_id": "77a5fed4-c785-3956-9cbc-1ddc2d9681b6",
                        "source_sense_description": "EDV: Standard für drahtloses lokales Computernetzwerk",
                        "target_lang_word": "Wi-Fi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87d3aca4-7c28-3678-bacd-955f81a1e7e3",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "Any of several standards for short-range wireless data transmission (IEEE 802.11)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "Wireless networking using one of these standards."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e838584-707c-45f3-a120-eb803f6320bd",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "Mimi gave Fifi access to her Wi-Fi."
                                            },
                                            {
                                                "example_id": "6e157132-62dc-45fd-a5f7-1d14f99fe341",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "He couldn't connect to the Wi-Fi in this area."
                                            },
                                            {
                                                "example_id": "f48f2c2d-fd03-4a29-bc2d-a028139498ee",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "This coffee shop has Wi-Fi for its customers."
                                            },
                                            {
                                                "example_id": "18b0837d-a0c1-45bd-8f7b-75b5633ac1ff",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "He asked me if I knew the Wi-Fi password."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fdf7698-a097-3920-9b7b-3ca5520e3d65",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "The capability to connect to a Wi-Fi network."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0679164f-4486-4a2a-b5e8-cd5440876a3d",
                                                "sense_id": "6fdf7698-a097-3920-9b7b-3ca5520e3d65",
                                                "text": "The refrigerator cost 1000 more dollars just because it had Wi-Fi, and I'm thinking \"this is ridiculous\"!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97bd8a43-b8c5-3010-bb03-7f8cdbe7a331",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "A Wi-Fi network."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                        "entry_id": "1c6439e9-55e2-319f-a0b8-9fc7791d470a",
                                        "glosses": [
                                            "To equip with Wi-Fi; to Wi-Fi enable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ccd02bc-ea90-4c49-a247-c3a0fb765f88",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "What type of electronics will be immune from being Wi-Fied?"
                                            },
                                            {
                                                "example_id": "b220397b-4614-4fc1-90ae-10d2098697ce",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "The biggest market may be Wi-Fi-ing people's homes."
                                            },
                                            {
                                                "example_id": "f87197ab-6d7b-4b3f-b91b-fa0d29fe5fd0",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "To Wi-Fi or Not to Wi-Fi?"
                                            },
                                            {
                                                "example_id": "b6b88d1a-6d38-4dba-a28f-694724013134",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "There was no point in being off the grid if the vehicle you drove was Wi-Fied to it with every turn of the wheels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                        "entry_id": "1c6439e9-55e2-319f-a0b8-9fc7791d470a",
                                        "glosses": [
                                            "To connect to the internet using Wi-Fi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2065b6fd-12f9-4e1f-aedd-05b91e7c78b4",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "The hotel manager even claims he's seen Red Sox problem child Manny Ramirez Wi-Fi-ing in the lobby on his Palm."
                                            },
                                            {
                                                "example_id": "1587aa11-3c24-45a3-a02c-5deb0d54ec84",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "Perhaps someone sees you typing in confidential information while you are \"Wi-Fi-ing\" in a hotel lobby or a crowded airport waiting area."
                                            },
                                            {
                                                "example_id": "4e61c59e-d810-4488-8930-9ca766050175",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "If Addison and Steele were alive and holding court at Starbucks, they'd be Wi-Fi-ing into a joint blog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "518d369a-d8d5-4ad7-8704-bf3ae2a1822b",
                        "source_entry_id": "8a392e1c-5c43-3483-bef4-625bd1d92362",
                        "source_sense_id": "77a5fed4-c785-3956-9cbc-1ddc2d9681b6",
                        "source_sense_description": "EDV: Standard für drahtloses lokales Computernetzwerk",
                        "target_lang_word": "Wi-Fi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "856f6ac1-9268-3e67-afdd-5ebc1fbdc756",
                                        "entry_id": "ffd7fa5e-b35b-3f62-879a-1f1496513681",
                                        "glosses": [
                                            "Technologie permettant de relier sans fil plusieurs appareils informatiques (ordinateur, routeur, smartphone, etc.) au sein d’un réseau informatique."
                                        ],
                                        "tags": [
                                            "Couche physique",
                                            "Couche liaison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f947f4e-751e-4996-87ef-1cf1f03586f3",
                                                "sense_id": "856f6ac1-9268-3e67-afdd-5ebc1fbdc756",
                                                "text": "Aujourd’hui, chacun calé dans sa bulle électromagnétique de Wi-Fi, c’est une autre vie qui commence. Une incarcération chez soi, dans laquelle il sera possible d’avoir accès à tout sans jamais voir personne - pas même son facteur."
                                            },
                                            {
                                                "example_id": "5899355e-cde5-42d1-bb0b-5293873950ba",
                                                "sense_id": "856f6ac1-9268-3e67-afdd-5ebc1fbdc756",
                                                "text": "Le Wi-Fi est une de ces technologies qui va permettre, au bureau comme à la maison, de connecter des ordinateurs entre eux sans avoir de fil à traîner : pas de câble à passer dans les murs, pas de bureau à déplacer."
                                            },
                                            {
                                                "example_id": "21ef4c7b-5224-42ea-8a02-a64353311059",
                                                "sense_id": "856f6ac1-9268-3e67-afdd-5ebc1fbdc756",
                                                "text": "Si vous lisez en face NON, c’est que la Wi-Fi n’est pas activée. Touchez cette ligne pour la mettre en service et lire OUI."
                                            },
                                            {
                                                "example_id": "5779d6a6-cbbc-4bb7-a2e9-c8b1b34fd10b",
                                                "sense_id": "856f6ac1-9268-3e67-afdd-5ebc1fbdc756",
                                                "text": "– Excusez-moi, j’aurais aimé avoir des infos sur les haut-parleurs qu’on peut connecter en Wi-Fi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a290007a-8a8c-30b2-917a-f5d8beee11c2",
                                        "entry_id": "cce9aaa6-078b-3621-aa3b-73636d343ba5",
                                        "glosses": [
                                            "Relatif au Wi-Fi, à la Wi-Fi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9ef750-29dd-4a4f-8ca5-784104e755fa",
                                                "sense_id": "a290007a-8a8c-30b2-917a-f5d8beee11c2",
                                                "text": "Il est à noter qu’il existe encore de nombreux points d’accès non sécurisés chez les particuliers. Plus de 20 pour cent des réseaux ne sont pas sécurisés. Il se pose le problème de la responsabilité du détenteur de la connexion Wi-Fi lorsque l’intrus réalise des actions illégales sur Internet, comme par exemple télécharger du contenu piraté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
