                "senses": [
                    {
                        "sense_id": "3229bb74-8546-3dae-b802-2821b60cd171",
                        "entry_id": "d27505af-a7ea-39e6-8c44-5fafc03e41f2",
                        "glosses": [
                            "een grote militaire eenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb418de-274e-430b-ad72-05ec6daba51c",
                                "sense_id": "3229bb74-8546-3dae-b802-2821b60cd171",
                                "text": "Toen hij Mack zag en de details van zijn ondergang vernam, begreep hij dat de helft van de campagne verloren was, begreep hij hoe moeilijk de situatie van de Russische legermacht was en maakte hij zich een levendige voorstelling van wat het leger te wachten stond en van de rol die hij erin zou moeten spelen."
                            },
                            {
                                "example_id": "561e123e-4a04-41d7-aaa9-3da97b92382a",
                                "sense_id": "3229bb74-8546-3dae-b802-2821b60cd171",
                                "text": "Gibraltar, in het uiterste zuiden van Spanje, werd in 1704 veroverd door een Brits-Nederlandse legermacht. Bij de Vrede van Utrecht in 1713 werd afgesproken dat Gibraltar voor eeuwig Brits grondgebied is. Spanje heeft herhaaldelijk aanspraak gemaakt op het stukje grond van amper vijf vierkante kilometer."
                            }
                        ]
                    }
                ],
                "translations": [
