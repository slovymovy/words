                "senses": [
                    {
                        "sense_id": "1418135d-88bf-3ec2-b6fb-4bb802494b15",
                        "entry_id": "17ae97d0-1833-39d9-a776-141569861343",
                        "glosses": [
                            "verheiratete Frau am fünfundzwanzigsten Jahrestag ihrer Hochzeit (Silberhochzeit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164e4b85-b816-409f-8f00-813bf090b8dd",
                                "sense_id": "1418135d-88bf-3ec2-b6fb-4bb802494b15",
                                "text": "„An ihrem Ehrentag sollten die »Silberbraut« und der »Silberbräutigam« […] nicht mit den Vorbereitungen der Festlichkeit belastet sein.“"
                            },
                            {
                                "example_id": "34262b6f-1c8c-4e8e-8988-ef9fc61d3cda",
                                "sense_id": "1418135d-88bf-3ec2-b6fb-4bb802494b15",
                                "text": "„[…] Die Silberbräute von einst [wären] nach einem mehr oder weniger lustigen Eheleben und als Mütter oft schon erwachsener Kinder nicht auf die Idee gekommen, sich [zur Eheerneuerung] in ein weißes Kleid zu quetschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
