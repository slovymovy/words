                "translations": [
                    {
                        "translation_id": "5a3d4ca2-8665-4721-a586-94bfd21c2b2f",
                        "source_entry_id": "4b7c6426-8688-375a-a7c9-e29407c46c4d",
                        "source_sense_id": "a14e00f7-6cc0-3a8b-8140-03d24999ae81",
                        "target_lang_word": "bitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb430f79-588b-3834-9f67-ccbd2bf48db3",
                                        "entry_id": "05445b2a-d1ec-3eb0-8036-6eed66e479d7",
                                        "glosses": [
                                            "Having an acrid taste (usually from a basic substance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a9f8da-c004-4856-9f22-a086af0aa62a",
                                                "sense_id": "bb430f79-588b-3834-9f67-ccbd2bf48db3",
                                                "text": "The coffee tasted bitter."
                                            },
                                            {
                                                "example_id": "5aa9397b-258f-4caa-9d72-d737b805a619",
                                                "sense_id": "bb430f79-588b-3834-9f67-ccbd2bf48db3",
                                                "text": "Long after his cigar burnt bitter, he sat with eyes fixed on the blaze. When the flames at last began to flicker and subside, his lids fluttered, then drooped; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs and ball-gown kneeling on the hearth[…]."
                                            },
                                            {
                                                "example_id": "3a7c70d6-cbc8-4bcf-a1a3-e5bcfcc6f19d",
                                                "sense_id": "bb430f79-588b-3834-9f67-ccbd2bf48db3",
                                                "text": "A few types of molecules get sensed by receptors on the tongue. Protons coming off of acids ping receptors for \"sour.\" Sugars get received as \"sweet.\" Bitter, salty, and the proteinaceous flavor umami all set off their own neural cascades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b842b0-5b06-3273-b841-ca0aad70d373",
                                        "entry_id": "05445b2a-d1ec-3eb0-8036-6eed66e479d7",
                                        "glosses": [
                                            "Harsh, piercing, acerbic or stinging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791a3b3c-ff72-4b77-8c2d-b22f8e93b4fb",
                                                "sense_id": "35b842b0-5b06-3273-b841-ca0aad70d373",
                                                "text": "It was at the end of February, […] when the world was cold, and a bitter wind howled down the moors […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3cce06-d304-32f2-9956-23ce4bda1739",
                                        "entry_id": "05445b2a-d1ec-3eb0-8036-6eed66e479d7",
                                        "glosses": [
                                            "Hateful or hostile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14155d3f-3045-4998-925a-fab5268090fa",
                                                "sense_id": "ab3cce06-d304-32f2-9956-23ce4bda1739",
                                                "text": "They're bitter enemies."
                                            },
                                            {
                                                "example_id": "ed7c46a4-492e-4350-b71a-02fe30790864",
                                                "sense_id": "ab3cce06-d304-32f2-9956-23ce4bda1739",
                                                "text": "Tottenham have not won in the Premier League at Emirates Stadium for 12 years, with Arsenal losing just one of their last 29 home league games against their bitter rivals."
                                            },
                                            {
                                                "example_id": "3dee0e68-823d-472a-bf55-3204bc9e1bfd",
                                                "sense_id": "ab3cce06-d304-32f2-9956-23ce4bda1739",
                                                "text": "He inveighed against the folly of making oneself liable for the debts of others; vented many bitter execrations against the brother; and concluded with wishing something could be done for the unfortunate family."
                                            },
                                            {
                                                "example_id": "4ae8b4c0-a9a4-4f3c-bd0b-7d2e8574194c",
                                                "sense_id": "ab3cce06-d304-32f2-9956-23ce4bda1739",
                                                "text": "Husbands, love your wives, and be not bitter against them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c2e7f4-25e9-3e32-86e5-7351237911ed",
                                        "entry_id": "05445b2a-d1ec-3eb0-8036-6eed66e479d7",
                                        "glosses": [
                                            "Cynical and resentful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "568a6ed8-ed10-4ffc-87f6-01fd551266e7",
                                                "sense_id": "45c2e7f4-25e9-3e32-86e5-7351237911ed",
                                                "text": "I've been bitter ever since that defeat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d4bd8d8-13e4-33a3-97cf-eebbea041490",
                                        "entry_id": "ab9b3c27-9221-3657-9537-4be8d609fad4",
                                        "glosses": [
                                            "A liquid or powder, made from bitter herbs, used in mixed drinks or as a tonic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afdb1c06-bdc5-4464-aab3-61355b2a0671",
                                                "sense_id": "4d4bd8d8-13e4-33a3-97cf-eebbea041490",
                                                "text": "Thus I begin: \"All is not gold that glitters,\n\"Pleasure seems sweet, but proves a glass of bitters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d1c684-c99c-3e1b-ba08-deaea65efd0a",
                                        "entry_id": "ab9b3c27-9221-3657-9537-4be8d609fad4",
                                        "glosses": [
                                            "A type of beer heavily flavored with hops."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2d1446c-1fe5-32fc-9e8a-717206eecbd7",
                                        "entry_id": "ab9b3c27-9221-3657-9537-4be8d609fad4",
                                        "glosses": [
                                            "A turn of a cable about the bitts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5951b7-d280-36ac-a05b-a8a99651c46f",
                                        "entry_id": "a5135181-f1bb-3353-98af-0dc12c89fc20",
                                        "glosses": [
                                            "To make bitter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d0bf969-1716-4ddd-9498-598683a4583e",
                                                "sense_id": "8b5951b7-d280-36ac-a05b-a8a99651c46f",
                                                "text": "bittered with the hop"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca74e93-80c2-339c-ab9a-b8ced1fc0b81",
                                        "entry_id": "8e14de5e-f5e8-3927-a40d-af7f0b76d2c2",
                                        "glosses": [
                                            "A hardware system whose architecture is based around units of the specified number of bits (binary digits)."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb6aa066-0976-43ff-bc88-4207567b033f",
                                                "sense_id": "4ca74e93-80c2-339c-ab9a-b8ced1fc0b81",
                                                "text": "However, 16-bitters are far more expensive than the 8-bit variety. And, unfortunately, have only a handful of business applications software packages that really take advantage of them."
                                            },
                                            {
                                                "example_id": "95532fd5-dcad-46d3-a50a-c30224901315",
                                                "sense_id": "4ca74e93-80c2-339c-ab9a-b8ced1fc0b81",
                                                "text": "The company believes that the 32-bit market will almost equal that of 16-bitters by the end of the decade. Chip maker Zilog Inc., not a major player in the 16-bit arena, is even more bullish about 32-bitters as it readies its own version for market."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c11e5c8c-3878-446f-ada3-0ef0a97139b0",
                        "source_entry_id": "4b7c6426-8688-375a-a7c9-e29407c46c4d",
                        "source_sense_id": "a14e00f7-6cc0-3a8b-8140-03d24999ae81",
                        "target_lang_word": "bitterly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitterly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97001bf9-3fc7-3b60-b38a-3086665e8495",
                                        "entry_id": "b67d8142-4459-3adc-b037-92b99435459a",
                                        "glosses": [
                                            "In a bitter manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd7d437a-c869-4bad-b679-5aedc2554566",
                                                "sense_id": "97001bf9-3fc7-3b60-b38a-3086665e8495",
                                                "text": "Judge Short had gone to town, and Farrar was off for a three days' cruise up the lake. I was bitterly regretting I had not gone with him when the distant notes of a coach horn reached my ear, and I descried a four-in-hand winding its way up the inn road from the direction of Mohair."
                                            },
                                            {
                                                "example_id": "ad8a9b44-814b-46b2-b22b-99f551cc7118",
                                                "sense_id": "97001bf9-3fc7-3b60-b38a-3086665e8495",
                                                "text": "Heidi threw herself down beside Clara's chair and began to cry bitterly."
                                            },
                                            {
                                                "example_id": "9bd94de1-eb2a-4d95-b35e-a326bc1b80df",
                                                "sense_id": "97001bf9-3fc7-3b60-b38a-3086665e8495",
                                                "text": "Liverpool's £58m strikeforce of Andy Carroll and Luis Suarez scored the goals that settled the Merseyside derby at Goodison Park - but Everton were left complaining bitterly about Jack Rodwell's controversial early red card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0759b316-7977-377f-b098-322a2122572d",
                                        "entry_id": "b67d8142-4459-3adc-b037-92b99435459a",
                                        "glosses": [
                                            "Extremely"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a222c35b-a9ec-4513-ad90-4e56a915c93b",
                                                "sense_id": "0759b316-7977-377f-b098-322a2122572d",
                                                "text": "On a bitterly cold evening at Wembley, the Lionesses knew only victory would be enough to keep alive Team GB's hopes of competing in Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
