                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "779b42fa-95ba-483c-82d1-806bec16021f",
                                "sense_id": "9e917514-d766-38fb-83a1-7b03fe9b417c",
                                "text": "Die Futterrüben oder auch Runkeln genannt sind als leicht lagerfähiges Saftfutter hauptsächlich für Rindvieh lange sehr verbreitet gewesen, allerdings hat der Mais in den letzten Jahrzehnten den Runkeln den Rang abgelaufen."
                            },
                            {
                                "example_id": "8076a839-8e24-44bf-8d10-a218fe54cae5",
                                "sense_id": "9e917514-d766-38fb-83a1-7b03fe9b417c",
                                "text": "Die Ernte der Runkeln erfolgt meist Ende Oktober bevor Nachtfröste kommen."
                            },
                            {
                                "example_id": "bc3dda48-b177-44d0-8902-148f20d68fcc",
                                "sense_id": "9e917514-d766-38fb-83a1-7b03fe9b417c",
                                "text": "Statt Halloween-Kürbisse werden in Thüringen nämlich Runkeln geschnitzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
