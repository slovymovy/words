{
    "word_family": [
        "spelen",
        "tegenspeler",
        "medespeler",
        "speelveld",
        "uitspeelbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9b15866-31c4-34de-89e0-c07b5b1fd641",
                    "sense_definition": "Een spel of wedstrijd tot het einde toe spelen, of een game volledig voltooien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gameplay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil dit spannende computerspel vanavond nog <w>uitspelen</w>.",
                            "target_lang_translations": {
                                "en": "I want to <w>finish</w> this exciting computer game tonight."
                            }
                        },
                        {
                            "text": "We moeten de wedstrijd rustig <w>uitspelen</w> om de winst veilig te stellen.",
                            "target_lang_translations": {
                                "en": "We need to calmly <w>play out</w> the match to secure the win."
                            }
                        }
                    ],
                    "synonyms": [
                        "voltooien",
                        "afmaken"
                    ],
                    "common_phrases": [
                        "een spel uitspelen",
                        "de wedstrijd uitspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To play a game or match until the very end, or to fully complete a video game."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to beat",
                                "target_lang_sense_clarification": "a video game"
                            },
                            {
                                "target_lang_word": "to finish",
                                "target_lang_sense_clarification": "a game or match"
                            },
                            {
                                "target_lang_word": "to play out",
                                "target_lang_sense_clarification": "a match to the end"
                            },
                            {
                                "target_lang_word": "to complete",
                                "target_lang_sense_clarification": "a game"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f503cfd-c4d3-30ef-9eea-1854e1ffabf8",
                    "sense_definition": "Een sportwedstrijd spelen op het terrein of in het stadion van de tegenstander.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Volgende week moeten we <w>uitspelen</w> tegen de koploper van de competitie.",
                            "target_lang_translations": {
                                "en": "Next week we have to <w>play away</w> against the league leaders."
                            }
                        },
                        {
                            "text": "Het is altijd lastiger om een wedstrijd <w>uit</w> te <w>spelen</w> dan thuis.",
                            "target_lang_translations": {
                                "en": "It is always more difficult to <w>play away</w> than at home."
                            }
                        }
                    ],
                    "antonyms": [
                        "thuisspelen"
                    ],
                    "common_phrases": [
                        "een wedstrijd uitspelen",
                        "moeten uitspelen tegen"
                    ],
                    "target_lang_definitions": {
                        "en": "To play a sports match away, on the opponent's field or stadium."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to play away",
                                "target_lang_sense_clarification": "on the opponent's ground"
                            },
                            {
                                "target_lang_word": "to play an away game",
                                "target_lang_sense_clarification": "sports"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37e6d22e-30cf-3220-8ace-3007578fab94",
                    "sense_definition": "Een tegenstander passeren of uitschakelen door middel van een behendige beweging, dribbel of pass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_tactics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De spits wist de verdediger knap <w>uit</w> te <w>spelen</w> en scoorde direct.",
                            "target_lang_translations": {
                                "en": "The striker managed to skillfully <w>outplay</w> the defender and scored immediately."
                            }
                        },
                        {
                            "text": "Met een snelle pass kon hij de hele defensie in één keer <w>uitspelen</w>.",
                            "target_lang_translations": {
                                "en": "With a quick pass, he was able to <w>bypass</w> the entire defense in one go."
                            }
                        }
                    ],
                    "synonyms": [
                        "passeren",
                        "omspelen",
                        "uitschakelen"
                    ],
                    "common_phrases": [
                        "de verdediging uitspelen",
                        "een tegenstander uitspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bypass or eliminate an opponent through a skillful move, dribble, or pass."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to outplay",
                                "target_lang_sense_clarification": "an opponent or defense"
                            },
                            {
                                "target_lang_word": "to bypass",
                                "target_lang_sense_clarification": "a defender or defense"
                            },
                            {
                                "target_lang_word": "to beat",
                                "target_lang_sense_clarification": "a defender in sports"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}