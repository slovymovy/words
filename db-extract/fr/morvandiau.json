                    }
                ],
                "senses": [
                    {
                        "sense_id": "53c4d184-8a7f-314b-8665-665acbd68066",
                        "entry_id": "d1a5d3ce-b82d-33c2-9a68-904ddb431b2a",
                        "glosses": [
                            "Morvandeau."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ec46af1e-d54f-45fc-a5b4-72af8541d721",
                                "sense_id": "53c4d184-8a7f-314b-8665-665acbd68066",
                                "text": "Cependant j’entends une femme qui dit : « Voilà un petit Morvandiau qui prie le bon Dieu de bon cœur. » — (Jean-Roch Coignet, Les Cahiers du capitaine Coignet → lire en ligne)"
                            },
                            {
                                "example_id": "3305ccbb-cae5-4be6-a0fc-bd95f0e2a8a0",
                                "sense_id": "53c4d184-8a7f-314b-8665-665acbd68066",
                                "text": "Elle parle beaucoup par proverbes, maman. Des proverbes noirs, méchants, désespérés. Des proverbes de Morvandiaux ronge-raves, croquants fourbus, battus, cocus au long des siècles, bêtes à chagrin, sacs à misère, tannés recuits comme charbon de bois, tout en os et en tendons, moustaches tombantes, sourcils froncés, croquants de la Nièvre où la terre est plus basse que partout ailleurs."
                            },
                            {
                                "example_id": "37021b4e-26dd-41ed-ae0a-752af5e3fb51",
                                "sense_id": "53c4d184-8a7f-314b-8665-665acbd68066",
                                "text": "Les adverbes « soudain » ou « brusquement » ne sont jamais utilisés par les Morvandiaux qui leur préfèrent, de loin, la locution « tout par un coup » […]"
                            },
                            {
                                "example_id": "8882dfd3-7f65-41e2-a5e1-89c26c4c90fa",
                                "sense_id": "53c4d184-8a7f-314b-8665-665acbd68066",
                                "text": "Pour assurer une défense plus appropriée aux nouveaux moyens de l’attaque, le Morvandiau décide d'en doubler la surface et de dresser une forteresse en forme d’étoile, la fameuse enceinte pentagonale."
                            }
                        ]
                    }
                ],
