                "senses": [
                    {
                        "sense_id": "c0b5263c-ce86-3d24-a715-2f37fff0bbb6",
                        "entry_id": "b4f25081-ff8c-3bac-8306-7ca8559f5e23",
                        "glosses": [
                            "Épouse d’un cheik."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4515cf95-8907-4144-a43a-72d169dc3ed1",
                                "sense_id": "c0b5263c-ce86-3d24-a715-2f37fff0bbb6",
                                "text": "Réputée pour être l’une des femmes les plus influentes du monde arabe, la cheika est envoyée spéciale de l’Unesco pour l’éducation de base et l’enseignement supérieur, et préside la Fondation du Qatar."
                            },
                            {
                                "example_id": "945e42b9-ec19-4078-a028-737067fa7e50",
                                "sense_id": "c0b5263c-ce86-3d24-a715-2f37fff0bbb6",
                                "text": "Il s’agit bien d’un contrat qui avait été obtenu par les Belges au Qatar grâce aux liens d’amitié de Philippe et Mathilde avec la cheika Bint Nasser, et qui a mal tourné."
                            }
                        ]
                    }
                ],
