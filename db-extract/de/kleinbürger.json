                "senses": [
                    {
                        "sense_id": "0f0b63e4-086f-3b55-af37-ad7a58c96f83",
                        "entry_id": "cd6397f5-0280-3c2e-afe1-ccdad9d7b4b1",
                        "glosses": [
                            "Person, die dem Kleinbürgertum, einer Gruppe mit vergleichsweise niedrigem Sozialstatus, angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec06957-1693-4844-b2eb-e57ffa74c87f",
                                "sense_id": "0f0b63e4-086f-3b55-af37-ad7a58c96f83",
                                "text": "„Zwei junge Kleinbürger trieben ihre Scherze mit zwei nüsseknackenden Bauernmädchen.“"
                            },
                            {
                                "example_id": "ec710c4c-01b0-44aa-8d9b-a0e81129e779",
                                "sense_id": "0f0b63e4-086f-3b55-af37-ad7a58c96f83",
                                "text": "„Die Inflation ist das beherrschende Thema des Geschehens, lapidar wird von den ansteigenden Selbstmorden der durch die Geldentwertung in den Ruin gestürzten Kleinbürger berichtet.“"
                            },
                            {
                                "example_id": "e663588e-422b-4b85-a21f-d5fa40da7d1b",
                                "sense_id": "0f0b63e4-086f-3b55-af37-ad7a58c96f83",
                                "text": "„Die SPD glaubte, Rücksicht auf den Konservatismus des Kleinbürgers nehmen zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
