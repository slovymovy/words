                        "form": "die Barschheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3e81d17-a8e8-3dc0-b5b6-15e413925794",
                        "entry_id": "8296d518-e1cd-3420-90b9-1a4c5f4aea55",
                        "glosses": [
                            "grobe, ruppige, wenig feinfühlige Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2fe8f1-80a2-416a-937b-c9c8e0cd3f4e",
                                "sense_id": "c3e81d17-a8e8-3dc0-b5b6-15e413925794",
                                "text": "„Besorgte Fragen nach seiner Gesundheit wies er damals mit bewährter Barschheit ab.“"
                            },
                            {
                                "example_id": "af1e632f-fcde-4db7-91ff-70d2cf22de43",
                                "sense_id": "c3e81d17-a8e8-3dc0-b5b6-15e413925794",
                                "text": "„An seine Barschheit gewöhnt, maß Ansgar seinen Worten keine Bedeutung bei und hielt den Waffenmeister auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df0787b4-4d61-3092-8c00-c74e42845fac",
                        "entry_id": "8296d518-e1cd-3420-90b9-1a4c5f4aea55",
                        "glosses": [
                            "grobe Handlung oder Äußerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982c51bf-871b-4bb2-a925-5b74020f6f45",
                                "sense_id": "df0787b4-4d61-3092-8c00-c74e42845fac",
                                "text": "„Der eine rief seine vaterländischen Parolen in formvollendetem Französisch, der andere seine Barschheiten in breitem Sächsisch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8071702f-883b-4cf0-8e6c-2c16a9e2580d",
                        "source_entry_id": "8296d518-e1cd-3420-90b9-1a4c5f4aea55",
                        "source_sense_id": "c3e81d17-a8e8-3dc0-b5b6-15e413925794",
                        "source_sense_description": "grobe, ruppige, wenig feinfühlige Art",
                        "target_lang_word": "brusqueness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brusqueness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8bbb71-6260-3301-9be0-380f05c579ba",
                                        "entry_id": "2b2e316b-c15f-3cf8-831c-f11709a1cb05",
                                        "glosses": [
                                            "The state or quality of being brusque; brusque behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed4a9f2b-617f-4ace-8935-1c3df32acd13",
                                                "sense_id": "fc8bbb71-6260-3301-9be0-380f05c579ba",
                                                "text": "Syed Hassan felt somewhat ashamed of his brusqueness, his rudeness, his boasting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6f6104c-82ad-48f5-b413-23ab7552d79d",
                        "source_entry_id": "8296d518-e1cd-3420-90b9-1a4c5f4aea55",
                        "source_sense_id": "df0787b4-4d61-3092-8c00-c74e42845fac",
                        "source_sense_description": "grobe Handlung oder Äußerung",
                        "target_lang_word": "incivility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incivility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4dc23c0-7f2f-3e97-986c-70a06cfb5df5",
                                        "entry_id": "c40edc78-9e5a-3b04-8ad7-1855f680e022",
                                        "glosses": [
                                            "The state of being uncivil; lack of courtesy; rudeness in manner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99dd9e0e-1181-40a1-bc05-f9fd394164dd",
                                                "sense_id": "b4dc23c0-7f2f-3e97-986c-70a06cfb5df5",
                                                "text": "Courtezan. How say you now? is not your husband mad? / Adriana. His incivility confirms no less."
                                            },
                                            {
                                                "example_id": "daa8d53a-d119-4949-87a8-74e88cc0019e",
                                                "sense_id": "b4dc23c0-7f2f-3e97-986c-70a06cfb5df5",
                                                "text": "1668, David Lloyd, Memoires of the Lives, Actions, Sufferings, and Deaths of those Noble, Reverend, and Excellent Personages that suffered by Death, Sequestration, Decimation, and otherwise for the Protestant Religion, London: Samuel Speed, “The Life and Death of Robert Berkley,” p. 96,\nBeat on proud Billows, Boreas blow,\nSwell curled Waves, high as Jove’s roof,\nYour incivility doth show,\nThat Innocence is tempest proof."
                                            },
                                            {
                                                "example_id": "ecb9fddf-8851-4a5f-8fab-43cd8de5743a",
                                                "sense_id": "b4dc23c0-7f2f-3e97-986c-70a06cfb5df5",
                                                "text": "Little did Mr. Willoughby imagine, I suppose, when his looks censured me for incivility in breaking up the party, that I was called away to the relief of one whom he had made poor and miserable […]"
                                            },
                                            {
                                                "example_id": "d97857aa-c056-47b6-acbc-842f6e7107c1",
                                                "sense_id": "b4dc23c0-7f2f-3e97-986c-70a06cfb5df5",
                                                "text": "[S]he could not bear incivility to her guests, to young men in particular, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef2aead8-bbce-3964-9c2d-972d008efe71",
                                        "entry_id": "c40edc78-9e5a-3b04-8ad7-1855f680e022",
                                        "glosses": [
                                            "Any act of rudeness or ill-breeding."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "787a76e0-da6b-4300-a217-5fb68ab1ef80",
                                                "sense_id": "ef2aead8-bbce-3964-9c2d-972d008efe71",
                                                "text": "Latona, in her flight from Juno, is churlishly intreated by the Lycian pesants, and denied the publique benefit of water: for which incivility these bawling Clownes are changed into croaking froggs, and confined unto that Lake for ever."
                                            },
                                            {
                                                "example_id": "b3362ea2-ff3d-4631-b108-706a9258ab20",
                                                "sense_id": "ef2aead8-bbce-3964-9c2d-972d008efe71",
                                                "text": "In truth, vve thought it (coming immediately from an infected place) an hazardous incivilitie, to put our ſelves upon them; for if any ſiniſter accident had fallen out about the ſame time (for Coincidents are not alvvaies Cauſes) vve ſhould have rued it for ever."
                                            },
                                            {
                                                "example_id": "7d4669ae-87e7-4384-966c-be0214441b17",
                                                "sense_id": "ef2aead8-bbce-3964-9c2d-972d008efe71",
                                                "text": "Mr. Lovelace, for three days together, sent twice each day to inquire after my brother’s health; and, altho’ he received rude, and even shocking returns, he thought fit, on the fourth day, to make in person the fame inquiries; and received still greater incivilities from my two uncles, who happen’d to be both there."
                                            },
                                            {
                                                "example_id": "d8e3f5b0-c0b1-49cf-9b3b-74a71cfc9837",
                                                "sense_id": "ef2aead8-bbce-3964-9c2d-972d008efe71",
                                                "text": "When my poor Sidebottom was alive, if there had been any unpleasantness between us during the day … I have shaken him at night to wake him up, that he might receive my pardon for an incivility said or done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899f8844-0743-3707-9bd4-36843cb76628",
                                        "entry_id": "c40edc78-9e5a-3b04-8ad7-1855f680e022",
                                        "glosses": [
                                            "Lack of civilization; a state of rudeness or barbarism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90327c2-bd36-4766-a32c-baa5ef016438",
                                                "sense_id": "899f8844-0743-3707-9bd4-36843cb76628",
                                                "text": "BEAT on, proud billows; Boreas blow; / Swell, curled waves, high as Jove's roof; / Your incivility doth ſhow, / That innocence is tempeſt proof; / Though ſurly Nereus frown, my thoughts are calm; / Then ſtrike, Affliction, for thy wounds are balm. [Attributed to Roger L'Estrange (1616–1704).]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
