                    {
                        "translation_id": "3e1a0482-35c7-4803-9a17-84053b11b2e9",
                        "source_entry_id": "562d3238-44d9-3318-8f12-96c31bf290dd",
                        "source_sense_id": "4194f2d2-be42-3557-a6d5-8ef322362261",
                        "target_lang_word": "ρεσιτάλ",
