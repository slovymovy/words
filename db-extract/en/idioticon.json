                                    {
                                        "sense_id": "fc6eecd5-786e-3be6-bf7d-685c37a92a4e",
                                        "entry_id": "15862131-fa8d-3935-9fa3-47d2ef18fcd3",
                                        "glosses": [
                                            "Wörterbuch, das den Wortschatz einer Mundart (eines Dialekts) erfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0555e2-95af-46e1-9de8-cd988eac14ff",
                                                "sense_id": "fc6eecd5-786e-3be6-bf7d-685c37a92a4e",
                                                "text": "„So wurden im 18. Jahrhundert Synonym- und Mundartwörterbücher geschrieben.“"
                                            },
                                            {
                                                "example_id": "78609140-1025-4c09-a404-2e44f24b8308",
                                                "sense_id": "fc6eecd5-786e-3be6-bf7d-685c37a92a4e",
                                                "text": "„Schon im 18. Jahrhundert entstanden Mundartwörterbücher für einzelne Landschaften…“"
                                            },
                                            {
                                                "example_id": "a255a125-3d1f-4d12-a7f8-2dfc2914372a",
                                                "sense_id": "fc6eecd5-786e-3be6-bf7d-685c37a92a4e",
                                                "text": "„Damit werden auch die Mundartwörterbücher beziehungsweise Idiotiken zu Instrumenten, die die deutsche Sprache insgesamt fördern, indem sie sie bereichern.“"
                                            },
                                            {
                                                "example_id": "f61b8119-0285-4a09-9a5d-d147b1d05f41",
                                                "sense_id": "fc6eecd5-786e-3be6-bf7d-685c37a92a4e",
                                                "text": "„Die leistungsfähigste strukturalistische Darstellungsform für dialektale Lexika ist nicht die Sprachkarte, sondern das Mundartwörterbuch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
