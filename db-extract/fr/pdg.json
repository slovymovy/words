                    {
                        "sense_id": "461000b8-a09c-3ce5-bd8e-d666a228ac67",
                        "entry_id": "cfe5de8f-4891-31f4-80e6-6ee5a3502d5c",
                        "glosses": [
                            "Président-directeur général, présidente-directrice générale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e4bdd5-1f3f-45f6-b818-bc81a1541b80",
                                "sense_id": "461000b8-a09c-3ce5-bd8e-d666a228ac67",
                                "text": "Catherine Guillouard, la PDG de la RATP, va quitter ses fonctions, « pour raisons personnelles », ont annoncé, jeudi, le gouvernement et l’entreprise publique."
                            },
                            {
                                "example_id": "8fa72fd9-983b-420d-aab6-b24b1d6dcd56",
                                "sense_id": "461000b8-a09c-3ce5-bd8e-d666a228ac67",
                                "text": "D’une dissidence à l’autre, Touly s’émeut également de ce que Mme Messier, épouse du plénipotentiaire PDG de Vivendi, puisse toucher quelques subsides de l’auguste maison."
                            },
                            {
                                "example_id": "7ed3157b-86f0-4afb-bec1-e826e2ffb17f",
                                "sense_id": "461000b8-a09c-3ce5-bd8e-d666a228ac67",
                                "text": "Le gens s'imaginent qu'après avoir eu un rôle de ministre, il faut que tu sois PDG de quelque chose."
                            },
                            {
                                "example_id": "22dd2262-5d49-4442-bc1b-b2c2feeea909",
                                "sense_id": "461000b8-a09c-3ce5-bd8e-d666a228ac67",
                                "text": "Les PDG des grandes entreprises qui s’érigent aujourd’hui comme contre-pouvoirs défendent le capitalisme d’abord et avant tout, et l’instabilité politique, c’est mauvais pour les affaires."
                            }
                        ]
                    }
