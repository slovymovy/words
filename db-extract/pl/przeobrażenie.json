                ],
                "translations": [
                    {
                        "translation_id": "618122fc-7e36-4520-949d-401c3bd3171e",
                        "source_entry_id": "64970a1c-13d5-39ce-a146-66ca42a05f62",
                        "source_sense_id": "e2d19a6f-acf2-3757-907a-58f1550a8ed8",
                        "target_lang_word": "metamorphosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metamorphosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba270cb-d9a6-3729-bf7e-18cd83294e38",
                                        "entry_id": "78581eab-4feb-3e16-8d29-1d6cc07bb744",
                                        "glosses": [
                                            "A transformation, such as one performed by magic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c05d2efd-ac6a-45ab-a541-85e35f3788a8",
                                                "sense_id": "7ba270cb-d9a6-3729-bf7e-18cd83294e38",
                                                "text": "With Severne she along doth go, / Her Metamorphosis to show ; / And makes the wand’ring Wy declaim / In honour of the British name."
                                            },
                                            {
                                                "example_id": "049778bc-82f5-4e89-a6bd-37b058d38bae",
                                                "sense_id": "7ba270cb-d9a6-3729-bf7e-18cd83294e38",
                                                "text": "I wonder’d at ſuch a Metamorphoſis in ſo ſhort a time, he told me, ’twas for the death of his Wife, that Nature had thus antedated his Years ; ’tis true, that a weighty ſetled ſorrow is of that force, that beſides the contraction of the Spirits, it will work upon the radical moiſture, and dry it up, ſo that the Hair can have no moiſture at the Root."
                                            },
                                            {
                                                "example_id": "d271cc0a-8fdb-4063-b340-6e2e65b14852",
                                                "sense_id": "7ba270cb-d9a6-3729-bf7e-18cd83294e38",
                                                "text": "Where is the gloriously-decisive change, / Metamorphosis the immeasurable / Of human clay to divine gold, we looked / Should, in some poor sort, justify its price ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61158e5-1dcf-3e71-b1a5-a5a33bfb9155",
                                        "entry_id": "78581eab-4feb-3e16-8d29-1d6cc07bb744",
                                        "glosses": [
                                            "A noticeable change in character, appearance, function, or condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d991cd01-976b-44e7-aae1-c59423bf6f73",
                                                "sense_id": "e61158e5-1dcf-3e71-b1a5-a5a33bfb9155",
                                                "text": "The station has been refurbished both at ground level and below ground, where the wide, fluorescently lit platforms are an almost unrecognisable metamorphosis of the dingy, reeking Low Level of old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06bb9a1-8272-3045-bb2e-8df18bbecffd",
                                        "entry_id": "78581eab-4feb-3e16-8d29-1d6cc07bb744",
                                        "glosses": [
                                            "A change in the form and often habits of an animal after the embryonic stage during normal development (e.g. the transformation of a caterpillar into a butterfly or a tadpole into a frog)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8969e48f-f2fb-33f1-bc6d-35c1f208c309",
                                        "entry_id": "78581eab-4feb-3e16-8d29-1d6cc07bb744",
                                        "glosses": [
                                            "A change, usually degenerative, in the structure of a specific body tissue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4620ae68-840b-4f6c-a2c1-3ad2857b891a",
                        "source_entry_id": "64970a1c-13d5-39ce-a146-66ca42a05f62",
                        "source_sense_id": "e2d19a6f-acf2-3757-907a-58f1550a8ed8",
                        "target_lang_word": "Verwandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06f3f52a-536b-3764-a8b5-f43604f70704",
                                        "entry_id": "c61c16fe-7508-33e5-9485-a59fc359811d",
                                        "glosses": [
                                            "die Veränderung, das Umformen von etwas, sowohl physisch als auch psychisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c1bb4da-8714-46df-bea5-260fd244a086",
                                                "sense_id": "06f3f52a-536b-3764-a8b5-f43604f70704",
                                                "text": "Die Verwandlung war somit vollständig abgeschlossen."
                                            },
                                            {
                                                "example_id": "f8d023bf-592e-4e4d-b7d8-b0cc4fe2c6e1",
                                                "sense_id": "06f3f52a-536b-3764-a8b5-f43604f70704",
                                                "text": "„Eine unheimliche Verwandlung ging in Miss Carey vor.“"
                                            },
                                            {
                                                "example_id": "ecd11d26-1f79-404a-8b25-1d1df37849f8",
                                                "sense_id": "06f3f52a-536b-3764-a8b5-f43604f70704",
                                                "text": "„Das späte Echo der Verwandlung der Welt in der Hippiekultur der Sechzigerjahre des 20. Jahrhunderts hat dem Romantizismus des Novalis seine Abgründigkeit genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
