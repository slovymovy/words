                        "cross_references": []
                    },
                    {
                        "translation_id": "fe781f63-b9fb-4401-bd35-cda8d1453541",
                        "source_entry_id": "83d90a6f-7fc4-3141-afb4-553472f545c7",
                        "source_sense_id": "51bd696c-1e8a-3506-bd79-39a12d5d657b",
                        "target_lang_word": "Bromberg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bromberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                                        "glosses": [
                                            "eine Stadt in Polen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ac4cbf-d471-42ba-87be-5e102136e26b",
                                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                                "text": "Ich wohne gern in Bromberg."
                                            },
                                            {
                                                "example_id": "b5afc4ab-0928-4d0c-98a2-b3bc960ed54a",
                                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                                            },
                                            {
                                                "example_id": "30bf7c4b-dee6-4cc5-9473-83820e8ca326",
                                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                                "text": "„Bis November 1939 wurden in Bromberg und Umgebung ungefähr 5.000 Polen und Juden erschossen.“"
                                            },
                                            {
                                                "example_id": "53887d8b-02a8-48a7-a402-d757e0a392da",
                                                "sense_id": "c18304f1-a0fd-389c-b5c9-b1fa824bbb80",
                                                "text": "„Nach der Rast fuhren wir sehr gemütlich in Richtung Osten bis in die Nähe von Bromberg (Bydgoszcz).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                                        "glosses": [
                                            "eine Marktgemeinde in Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a68526-05b4-491e-97cb-b2d9b071c402",
                                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                                            },
                                            {
                                                "example_id": "b8a53db7-4577-4473-8f18-34c054e524c6",
                                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                                "text": "„Im Zuge der neuen Partnerschaft hat sich die Marktgemeinde Bromberg neben der Umrüstung der veralteten Quecksilberdampflampen auf moderne und effiziente LED-Leuchten auch für die Sanierung der Einspeisestellen, entschlossen.“"
                                            },
                                            {
                                                "example_id": "5af62d90-a69c-46a5-9641-02b811111978",
                                                "sense_id": "b16c11c1-daab-3782-8205-7af225a7e6da",
                                                "text": "Ich wohne gern in Bromberg."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                        "entry_id": "e24dd7b4-6287-311e-80a8-315aec9f5632",
                                        "glosses": [
                                            "eine Katastralgemeinde von Grafenschlag, Österreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed6fd84-843a-496e-9852-e12259a73181",
                                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                                "text": "Ich wohne gern in Bromberg."
                                            },
                                            {
                                                "example_id": "6c9af3d9-a5bc-45c0-8f8e-78255392d05f",
                                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                                "text": "Das heutige Bromberg unterscheidet sich von dem vergangener Zeiten."
                                            },
                                            {
                                                "example_id": "aba0d178-1dec-4b39-8fb2-204a84817cf3",
                                                "sense_id": "e0f75db6-0d5b-3118-998e-b05866f2b962",
                                                "text": "„Der Landschaftsteich Grafenschlag befindet sich in der Nähe der Katastralgemeinde Bromberg und ist in den Sommermonaten der beliebteste Badeplatz in der Gemeinde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bromberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                        "entry_id": "ce701d0d-c1da-3504-8d9e-4421cc4a3ee1",
                                        "glosses": [
                                            "eine Erhöhung in Freiburg im Breisgau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3893e46-08fe-4107-9009-fe01957a097a",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "Wir waren heute auf dem Bromberg."
                                            },
                                            {
                                                "example_id": "3b0a0db3-f904-45ca-9398-466b191ae3c7",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "„Oberhalb der Wiehre, auf dem Bromberg, gibt es einen als ‚Schlössle‘ getarnten Wasserhochbehälter mit Ausblick auf die Stadt.“"
                                            },
                                            {
                                                "example_id": "8a24425a-5091-4d50-899e-4ed10a20f0c2",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "„Von besonderem Interesse sind an dieser Stelle drei relativ dicht beieinanderliegende Pingen am Nordhang des Bromberges oberhalb des Sternwaldecks.“"
                                            },
                                            {
                                                "example_id": "5370958a-97f0-4d7a-9517-1de6749156e0",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "„Mit anwachsender Bevölkerung begann die Stadt, das Wasser aus den verschiedenen Quellen am Fuße des Brombergs in verschiedenen Brunnenstuben zu sammeln.“"
                                            },
                                            {
                                                "example_id": "21f5f32f-c7bf-4d87-811f-efb85b57aff4",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "„Ende des 18. Jahrhunderts rückte die Bebauung an den Fuß des Bromberges heran und verdichtete sich in der Folgezeit […]“"
                                            },
                                            {
                                                "example_id": "31ae42bb-8239-4acd-b5d2-440224e7f884",
                                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                                "text": "„Die Verbreitung des Grauspechtes umfasst nahezu sämtliche Waldflächen des Vogelschutzgebietes sowie die angrenzenden, noch intakten Streuobstwiesen im Bereich des Bromberges […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bromberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                        "entry_id": "7fbc0a60-564d-37b3-aea0-b77388f01ce0",
                                        "glosses": [
                                            "deutschsprachiger Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ceeb62-8516-4f1b-bb55-434f7b8f1e33",
                                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                                "text": "Herr Bromberg ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "d14ae1b7-80ac-45e6-a171-11d86f035c03",
                                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                                "text": "Herr Bromberg heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "9c530710-43bc-4722-bc7a-a43111e5e04c",
                                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                                "text": "Frau Bromberg liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "625c5c85-a3fa-4990-97fe-4aae762b319f",
                                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                                "text": "Die Brombergs lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1176c54d-ff7b-46d4-a1b5-f2dadcbf8582",
                        "source_entry_id": "83d90a6f-7fc4-3141-afb4-553472f545c7",
