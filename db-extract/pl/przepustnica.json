                "senses": [
                    {
                        "sense_id": "f49cb94f-a0e5-3256-b0d8-36e69e9e15d7",
                        "entry_id": "298107c2-93dd-3356-9d91-148753ea545c",
                        "glosses": [
                            "w silniku tłokowym: urządzenie regulujące dopływ powietrza, mieszanki paliwowej, pary wodnej do cylindrów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80fd90b-dd9a-4812-8320-bf76cdff9929",
                                "sense_id": "f49cb94f-a0e5-3256-b0d8-36e69e9e15d7",
                                "text": "Otrzą­sam się w kok­pi­cie i otwie­ram prze­pust­nicę. Pędzimy ku celowi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1e53ab2f-927f-3f3e-9af8-325f9f39b45e",
                        "entry_id": "298107c2-93dd-3356-9d91-148753ea545c",
                        "glosses": [
                            "w parowozie: urządzenie do otwierania i zamykania dopływu pary wodnej z kotła do silnika parowego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a06425f6-5116-3a57-a72f-d837a60e7175",
                        "entry_id": "298107c2-93dd-3356-9d91-148753ea545c",
