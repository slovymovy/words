                        "examples": [
                            {
                                "example_id": "59d913ed-221a-4626-9981-4f681d344124",
                                "sense_id": "44d04981-a35a-382a-97f6-c416fce2d52f",
                                "text": "Произошёл небольшой переполох: курица заорала и, хлопая крыльями, попыталась взлететь."
                            },
                            {
                                "example_id": "59a2dbb9-f259-4c3a-8312-24cf0789166b",
                                "sense_id": "44d04981-a35a-382a-97f6-c416fce2d52f",
                                "text": "Ой, дядя фокусник, вы настоящий волшебник, ― хлопая в ладоши, обрадовался Тимка."
                            },
                            {
                                "example_id": "097a089f-eb4e-4ec5-aca2-7d27348ff486",
                                "sense_id": "44d04981-a35a-382a-97f6-c416fce2d52f",
                                "text": "Какие? ― не понял комендант, хлопая покрасневшими веками."
                            }
                        ]
                    }
