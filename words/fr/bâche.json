                {
                    "sense_id": "0fa9299a-6523-343b-94fb-538829fe3ac2",
                    "sense_definition": "Grande pièce de toile imperméable ou de plastique servant à protéger des objets contre les intempéries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant l'arrivée de l'orage, nous avons étendu une grande <w>bâche</w> sur le tas de bois."
                        },
                        {
                            "text": "Le camion transporte du sable recouvert d'une solide <w>bâche</w> pour éviter les projections."
                        }
                    ],
                    "synonyms": [
                        "banne",
                        "couverture"
                    ],
                    "common_phrases": [
