                "translations": [
                    {
                        "translation_id": "0e8170e0-f907-4e4b-8526-737ace568570",
                        "source_entry_id": "1a88133d-8a52-337a-9d67-403138f70e2a",
                        "source_sense_id": "1115e4d0-15d9-34a5-9a67-129c77043167",
