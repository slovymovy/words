                "senses": [
                    {
                        "sense_id": "c8e2bb00-1795-3fe9-9c59-7d99d5fdcd02",
                        "entry_id": "3a6ef655-6bde-3c37-9205-362b79b37dc6",
                        "glosses": [
                            "papieren omslag voor brieven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98642714-f625-4503-a046-48308d55bce7",
                                "sense_id": "c8e2bb00-1795-3fe9-9c59-7d99d5fdcd02",
                                "text": "Stuur deze bon in een ongefrankeerde envelop naar het volgende adres."
                            },
                            {
                                "example_id": "feb36853-7255-4239-915f-86bd2d21e036",
                                "sense_id": "c8e2bb00-1795-3fe9-9c59-7d99d5fdcd02",
                                "text": "Moet de postzegel altijd rechtsboven, of komt een envelop ook aan als de zegel er willekeurig opgeplakt zit?"
                            },
                            {
                                "example_id": "79cfdf0e-880b-4134-ab22-09df59bcb8ed",
                                "sense_id": "c8e2bb00-1795-3fe9-9c59-7d99d5fdcd02",
                                "text": "Vóór het vergeten woord was er nog een ander woord. Het arriveerde in het scriptorium in een gebruikte envelop, het oude adres doorgestreept en daarvoor in de plaats geschreven: Dr. Murray, Sunnyside, Oxford."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d6de2fd-c861-3db7-a6bf-200bcca92287",
                        "entry_id": "3a6ef655-6bde-3c37-9205-362b79b37dc6",
                        "glosses": [
                            "totaalbedrag voor een bepaald doel beschikbaar gesteld aan een ontvanger die daarbinnen zelf de precieze besteding kan bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c4a336-2c3d-4f52-9982-f176c5b77fc3",
                                "sense_id": "2d6de2fd-c861-3db7-a6bf-200bcca92287",
                                "text": "Wij zijn nagegaan hoe in Nederland door de verantwoordelijke autoriteiten invulling is gegeven aan de vertaling van de nationale envelop in nationale programma’s."
                            }
                        ]
                    }
