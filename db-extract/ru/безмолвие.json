                        "form": "безмо́лвиях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1537d5c2-6988-3f5c-88da-3840b107a2f2",
                        "entry_id": "fe032a74-fcea-3f71-b1f3-c60ebaf4be3f",
                        "glosses": [
                            "полная, ничем не нарушаемая тишина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e57515-e3b5-4303-8e53-5a0b952feb05",
                                "sense_id": "1537d5c2-6988-3f5c-88da-3840b107a2f2",
                                "text": "Величайшее безмолвие царило окрест. Сдавалось, что всяческое звучание глохнет в густой воде и тяжком воздухе пустыни."
                            }
                        ]
                    },
                    {
                        "sense_id": "50431ec4-3e7d-304a-b626-d672a36739c0",
                        "entry_id": "fe032a74-fcea-3f71-b1f3-c60ebaf4be3f",
                        "glosses": [
                            "полное молчание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ee8da1-0aa8-47aa-b57d-707fd93204b8",
                                "sense_id": "50431ec4-3e7d-304a-b626-d672a36739c0",
                                "text": "В комнате продолжалось мёртвое безмолвие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc6799dc-e4cf-4a1c-aa7f-67d7493a8379",
                        "source_entry_id": "fe032a74-fcea-3f71-b1f3-c60ebaf4be3f",
                        "source_sense_description": "полная, ничем не нарушаемая тишина",
                        "target_lang_word": "silence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The absence of any sound."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9bcd0c-9eb5-4a42-8cc6-9c844d0617e5",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "When the motor stopped, the silence was almost deafening."
                                            },
                                            {
                                                "example_id": "55f6e3a1-ad11-465b-8d1e-32a0b17508d3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "Words like violence break the silence / Come crashing in into my little world"
                                            },
                                            {
                                                "example_id": "f11718a4-2404-489e-9b2a-eb196fdc5117",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "deadly silence"
                                            },
                                            {
                                                "example_id": "4c778e96-2828-4717-a7f5-491620ff76b3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "in silence"
                                            },
                                            {
                                                "example_id": "1402b33c-c922-47e2-bd6e-3316b118f6a3",
                                                "sense_id": "fbd59a30-ef59-3a49-bf2c-36459034b51c",
                                                "text": "total silence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "The act of refraining from speaking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a4d136-34e0-4fec-a582-41819f990e2b",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "\"You have the right to silence,\" said the police officer."
                                            },
                                            {
                                                "example_id": "e38411d7-6f70-40ec-a029-1b668c373688",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "5f8e0dcd-8df2-4fc8-90e0-9974119d6c83",
                                                "sense_id": "6a2ec69f-b9b4-3827-ba1b-4b5d082f3bca",
                                                "text": "1832, Daniel Webster, \"a convention\", quoted in The History of the Union, and of the Constitution by Charles Chauncey Burr\nThe administration itself keeps a profound silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                        "entry_id": "bfd0d6b4-da8d-3952-94be-4dc0780406f9",
                                        "glosses": [
                                            "Refraining from speaking, for purposes of prayer or meditation; especially, a form of worship practiced by the Society of Friends (Quakers) during meetings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17096e73-6e24-4588-8f91-aab14aa09f14",
                                                "sense_id": "ed8ec1e9-32ee-387d-8b3c-8788b5cfd486",
                                                "text": "During silence a message came to me that there was that of God in every person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To make (someone or something) silent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2e0b35-6617-4043-a25a-200d9f863d09",
                                                "sense_id": "a8ca1bef-0bba-326b-b09d-7e6768927a71",
                                                "text": "Can you silence the crowd, so we can start the show?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To repress the expression of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a04f3a-f79b-43be-a841-8802eb939503",
                                                "sense_id": "4f2d8b6c-68c1-3d3d-9ac5-948a0b72d637",
                                                "text": "Women, as well as children, have their thoughts or emotions routinely silenced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To suppress criticism, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d57b6d-8215-490a-8606-c89f43a97eb2",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the critics."
                                            },
                                            {
                                                "example_id": "c8d49075-a871-4704-990b-c82bb381132b",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "Silence the doubters."
                                            },
                                            {
                                                "example_id": "fadea5db-5b6e-4724-b010-18bc1ec516ce",
                                                "sense_id": "f4b8e26b-b630-383e-8be4-f19c5e36e999",
                                                "text": "A state ideology, mixing nationalism, and basic Marxist economics, going under the name \"Juche\", was constructed, and Kim Il-sung effectively silenced, disposed of and cleared away any opposition, isolating the country and exercising an iron grip on the military, the state media and the government and party organs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eddaa1e-dda3-3515-8efa-538a35bf9294",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To block gene expression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                        "entry_id": "6c009991-ec3c-34a0-a698-4d65b665e00b",
                                        "glosses": [
                                            "To murder."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a563b42b-754c-460d-b62d-0122ed55464b",
                                                "sense_id": "675239fb-397f-36c9-a893-402323f248c0",
                                                "text": "They, and others through the years, believed Ruby must have acted on his own since there was no logic to the supposition that anyone could trust an uncontrollable, unreliable loudmouth like Ruby to silence Oswald."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                        "entry_id": "565984bd-5465-331e-b152-f00c679e5a31",
                                        "glosses": [
                                            "Be silent."
                                        ],
                                        "tags": [
                                            "imperative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7762bc1f-2471-4b82-ae6b-0bd15df27f94",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "Silence! Enough of your insolence!"
                                            },
                                            {
                                                "example_id": "628a136e-3da6-475a-a532-29daac5f5485",
                                                "sense_id": "6c235d9c-32c4-3cc2-8c53-eb7d00f19d55",
                                                "text": "(in response to laughter from the audience)\nSilence! I kill you!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
