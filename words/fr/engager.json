            "senses": [
                {
                    "sense_id": "e6d44576-3f2c-32e4-9de3-1d16d276f2ad",
                    "sense_definition": "Recruter ou embaucher une personne pour un travail ou une fonction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise souhaite <w>engager</w> un nouvel ingénieur pour diriger ce projet important."
                        },
                        {
                            "text": "Le directeur a décidé d'<w>engager</w> du personnel supplémentaire pour la saison estivale."
                        }
                    ],
                    "synonyms": [
                        "embaucher",
                        "recruter"
                    ],
                    "antonyms": [
                        "licencier",
                        "renvoyer"
                    ],
                    "common_phrases": [
                        "engager du personnel",
                        "engager un avocat"
                    ]
                },
                {
                    "sense_id": "0b1ff8ec-a3fe-3e79-9d58-0a42af95f9a6",
                    "sense_definition": "Commencer ou entamer une action, une démarche ou un échange.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commencement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voisin a essayé d'<w>engager</w> la conversation pendant le trajet en train."
                        },
                        {
                            "text": "La justice a décidé d'<w>engager</w> des poursuites contre les responsables de l'accident."
                        }
                    ],
                    "synonyms": [
                        "entamer",
                        "amorcer",
                        "commencer"
                    ],
                    "antonyms": [
                        "clore",
                        "terminer"
                    ],
                    "common_phrases": [
                        "engager la conversation",
                        "engager des poursuites",
                        "engager des négociations"
                    ]
                },
                {
                    "sense_id": "abc64f5d-44b3-3b3e-9ee1-229f0ae85b11",
                    "sense_definition": "Lier une personne par une promesse, un contrat ou une obligation formelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En signant ce document, le président <w>engage</w> sa responsabilité devant toute l'assemblée."
                        },
                        {
                            "text": "Ce simple accord verbal n'<w>engage</w> en rien les participants pour l'avenir."
