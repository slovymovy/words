                "senses": [
                    {
                        "sense_id": "75ba9d7d-09b2-3c53-a0e6-140ffe5a4853",
                        "entry_id": "98eb4d20-4e72-376e-8e10-be366dd37f00",
                        "glosses": [
                            "Beobachtung, dass beim Zerspritzen von Wassertropfen freie Elektrizität auftritt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "24a66d6d-3e8e-4b19-bd8e-796cbb73e1fa",
                                "sense_id": "75ba9d7d-09b2-3c53-a0e6-140ffe5a4853",
                                "text": "„Die Existenz des Wasserfalleffekts bildet hiernach einen direkten Nachweis der elektrischen Natur der Molekularkräfte, der Oberflächenspannung und des Normaldrucks.“"
                            },
                            {
                                "example_id": "89b1c5cc-cfd6-45e8-9f13-db5f0dc17728",
                                "sense_id": "75ba9d7d-09b2-3c53-a0e6-140ffe5a4853",
                                "text": "„Die Abschätzung der Bedeutung des Wasserfalleffekts für das Gewitter erfordert Extrapolationen. Man hat in ihm andere Temperaturverhältnisse, andere Tropfengrößen und andere Geschwindigkeiten.“"
                            },
                            {
                                "example_id": "aa377461-9c6b-44c0-b2bf-88a80d16933a",
                                "sense_id": "75ba9d7d-09b2-3c53-a0e6-140ffe5a4853",
                                "text": "„Bei dem 1892 von LENARD näher untersuchten Wasserfalleffekt entstehen aus einem ungeladenen Wassertropfen beim Zerplatzen positive und negative Teile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f944f26a-39a6-3e3e-b04d-e61d5af29cda",
                        "entry_id": "98eb4d20-4e72-376e-8e10-be366dd37f00",
                        "glosses": [
                            "optische Täuschung, bei der man eine gegenläufige Bewegung zu sehen glaubt, wenn man auf eine weiße Fläche schaut, nachdem man eine Bewegung wie zum Beispiel die eines fahrenden Zuges oder fließenden Wassers gesehen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fd0c609-aef1-4be0-ad9f-aa0d047b7408",
                                "sense_id": "f944f26a-39a6-3e3e-b04d-e61d5af29cda",
                                "text": "„Er »sah« […] auch nicht den sogenannten Wasserfalleffekt, der sich normalerweise nach Bewegungswahrnehmungen einstellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
