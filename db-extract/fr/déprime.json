                "senses": [
                    {
                        "sense_id": "700263cb-c664-39a5-a9a1-5b54509fa4c2",
                        "entry_id": "912c0077-34d4-3643-a232-2fbdcdb02c70",
                        "glosses": [
                            "Baisse de moral et aversion d’activité pouvant affecter le comportement, les émotions et le bien-être physique d’un individu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77dae06-cf3b-44c3-bdc4-9f7d57e461c5",
                                "sense_id": "700263cb-c664-39a5-a9a1-5b54509fa4c2",
                                "text": "Il rentra ensuite à Milan, en proie à une déprime persistante, toujours décidé, selon ses dires, à abandonner la carrière théâtrale."
                            }
                        ]
                    },
                    {
                        "sense_id": "98323ba7-49c8-3b5e-ab47-36bc448ac48c",
                        "entry_id": "912c0077-34d4-3643-a232-2fbdcdb02c70",
                        "glosses": [
                            "Perte de joie de vivre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "978a9085-b4be-43d5-b5d6-b99a60e8df01",
                                "sense_id": "98323ba7-49c8-3b5e-ab47-36bc448ac48c",
                                "text": "- Je ne soupçonnais pas la Méditerranée capable d’inspirer tant de déprime, lui reproché-je. Tu étais si désopilant, avant."
                            }
                        ]
                    }
                ],
