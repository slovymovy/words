                "senses": [
                    {
                        "sense_id": "a264126d-c374-31f0-af02-476d10b0c1cf",
                        "entry_id": "c2746c9a-defc-3eac-940c-3a5ace286b92",
                        "glosses": [
                            "Rauch, der durch die Verbrennung von Holz der Buche entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e83bf6-a93e-42c3-8954-859d5f99ea29",
                                "sense_id": "a264126d-c374-31f0-af02-476d10b0c1cf",
                                "text": "„Buchenholzrauch wird zum Räuchern und damit Aromatisieren und Haltbarmachen von geräucherten Wurstwaren verwendet.“"
                            },
                            {
                                "example_id": "acefa928-3158-4db3-b157-dbbfae7fb4f7",
                                "sense_id": "a264126d-c374-31f0-af02-476d10b0c1cf",
                                "text": "„Zarte Räucherung auf kalten Buchenholzrauch verleiht unseren geräucherten Tofu-Sorten einen herzhaften und delikaten Geschmack.“"
                            },
                            {
                                "example_id": "88fdb795-5725-464f-90d4-0f81fe2154e4",
                                "sense_id": "a264126d-c374-31f0-af02-476d10b0c1cf",
                                "text": "„Die Fenchelsalami, ursprünglich aus Italien, ist eine feinpikante Salamispezialität, die über Buchenholzrauch reift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
