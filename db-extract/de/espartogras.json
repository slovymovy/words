                "senses": [
                    {
                        "sense_id": "13bedcf8-2199-3143-98f9-011aff0151da",
                        "entry_id": "05e25fbb-c7e1-3a48-9b6f-8f0e4a0ddd4b",
                        "glosses": [
                            "im westlichen und südlichen Mittelmeerraum verbreitete Grasart, deren Blattfasern unter anderem zur Herstellung von Seilen und Papier verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341f6695-42a9-462c-97ee-b4bee8a39dbb",
                                "sense_id": "13bedcf8-2199-3143-98f9-011aff0151da",
                                "text": "„‚Espardenyes‘ - die früher traditionell aus dem Espartogras geflochten wurden - heißen die Espadrilles im Katalanischen.“"
                            },
                            {
                                "example_id": "23eb30a4-c810-4b34-9e08-ebb571978d6a",
                                "sense_id": "13bedcf8-2199-3143-98f9-011aff0151da",
                                "text": "„Pedro Blanco und sein Bruder Jesús sind Meister des fast ausgestorbenen Handwerks mit Espartogras, dem eine große Zukunft vorausgesagt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
