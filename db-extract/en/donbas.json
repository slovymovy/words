                    {
                        "translation_id": "e3557211-fc06-491a-b843-26c079ae6eb3",
                        "source_entry_id": "e6fc812c-9469-38e3-ba6b-82180027f90b",
                        "source_sense_description": "an industrial region in eastern Ukraine.",
                        "target_lang_word": "Donbass",
                        "target_lang_code": "fr",
