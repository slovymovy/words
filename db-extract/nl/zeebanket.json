                                        "entry_id": "45354def-e929-3423-af5c-4bf7d770827b",
                                        "glosses": [
                                            "essbares Meeresgetier, ohne Algen, Säugetiere oder Wirbeltiere wie zum Beispiel die Fische"
                                        ],
