                        "examples": [
                            {
                                "example_id": "c3b07baa-6ed9-431a-bc68-a31a02ecc8f6",
                                "sense_id": "cc261150-9104-358c-9966-a18e021373ea",
                                "text": "De eigenaar van het schilderij is een nakomeling van de man die op het schilderij is te zien, etser Leopold Löwenstam. Die maakte kopieën van de werken van de kunstenaar. Het beeldrecht van de werken van de schilder was volgens Maas soms nog duurder dan de werken zelf."
                            },
                            {
                                "example_id": "7090c4bd-ad23-498e-83a7-fac77f1a50f7",
                                "sense_id": "cc261150-9104-358c-9966-a18e021373ea",
                                "text": "Volgens Di Modica maakt het beeldje inbreuk op zijn copyright en beeldrecht. Hij noemt het een reclamestunt, omdat het meisje werd ontworpen door een reclamebureau en betaald is door een beursbedrijf. \"Dit is helemaal geen symbool.\" Di Modica denkt na over een gang naar de rechter."
                            },
                            {
                                "example_id": "1f9b07fd-4170-4058-8787-ea0712c11cd6",
                                "sense_id": "cc261150-9104-358c-9966-a18e021373ea",
                                "text": "\"Het waren de moderne en vrije jaren 70 in Catalonië met Johan, die naast een geweldige speler ook een voorvechter was van de rechten van spelers, een pionier op het gebied van beeldrecht. Herinnert u zich de verfreclames van Bruguer?\""
                            }
                        ]
