                    {
                        "translation_id": "84e52b28-4a84-42ce-b3d7-11dc5574ebc1",
                        "source_entry_id": "095305d6-d289-3c07-a807-71100e2848be",
                        "source_sense_id": "6a0f7a0a-6a1e-37f5-8406-9873162eda46",
                        "source_sense_description": "historische landstreek in de Tsjechische Republiek",
                        "target_lang_word": "Bohême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bohême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac8c4e27-b457-330c-9cfd-b6993dfc84b9",
                                        "entry_id": "8ed8e8b8-36c4-3182-a26f-3bbb0760a880",
                                        "glosses": [
                                            "Région occidentale de la Tchéquie."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482b8494-44e9-4322-8a29-1af7fea359b9",
                                                "sense_id": "ac8c4e27-b457-330c-9cfd-b6993dfc84b9",
                                                "text": "Les murailles, comme le nom de la chambre l’indiquait, étaient tapissées de cuir de Bohême gaufré de fleurs chimériques et de ramages extravagants découpant sur un fond de vernis d’or leurs corolles, rinceaux et feuilles enluminées de couleurs à reflets métalliques luisant comme du paillon."
                                            },
                                            {
                                                "example_id": "b4d50a43-59b7-44ff-a1fe-932c1729556b",
                                                "sense_id": "ac8c4e27-b457-330c-9cfd-b6993dfc84b9",
                                                "text": "Comme un flot grossi par la fonte\nDes glaciers grondants,\nQuand l'eau de ta bouche remonte\nAu bord de tes dents,\nJe crois boire un vin de Bohême,\nAmer et vainqueur,\nUn ciel liquide qui parsème\nD’étoiles mon cœur !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bohême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ced36ca5-6e39-39f6-ab6d-1ee4d9ec9c0f",
                                        "entry_id": "d9e8914c-b459-3d9d-adad-b4ee2bb657e2",
                                        "glosses": [
                                            "Tchèque, habitant de la Bohême."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b70d579c-61ff-4ec2-b3ea-021036e516a9",
                                                "sense_id": "ced36ca5-6e39-39f6-ab6d-1ee4d9ec9c0f",
                                                "text": "Le Bohême intrépide."
                                            },
                                            {
                                                "example_id": "0c7e7b57-69c0-42c7-9c45-f95b4a32d49e",
                                                "sense_id": "ced36ca5-6e39-39f6-ab6d-1ee4d9ec9c0f",
                                                "text": "Tout à coup un mendiant se dressa devant lui, dans le brouillard. C’était un Bohême à barbe tressée, avec des anneaux d’argent aux deux bras et les prunelles flamboyantes."
                                            },
                                            {
                                                "example_id": "98d01811-7d49-4c49-81ac-6259199a35f7",
                                                "sense_id": "ced36ca5-6e39-39f6-ab6d-1ee4d9ec9c0f",
                                                "text": "Les Bohêmes démoniaques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
