                "senses": [
                    {
                        "sense_id": "6b1f477a-2de5-32be-a72f-e9adbd5db7b5",
                        "entry_id": "9208b83c-606d-3578-b2a9-c8237333c9dc",
                        "glosses": [
                            "lautes Brüllen aus Freude über einen Sieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3cb5772-363f-474a-a204-5c92de381516",
                                "sense_id": "6b1f477a-2de5-32be-a72f-e9adbd5db7b5",
                                "text": "„In England war Fußballeuropameisterschaft. Rumpel-Deutschland stand im Finale gegen die edlen Tschechen. Seit meiner Kindheit verstört mich (west-)deutsches Siegesgebrüll; die DDR benahm sich in dieser Sportart dezenter.“"
                            },
                            {
                                "example_id": "e365c4d9-e7bf-405a-bc5f-0c6c6b3b4b52",
                                "sense_id": "6b1f477a-2de5-32be-a72f-e9adbd5db7b5",
                                "text": "„Gegen zwei Uhr erwachte Billinger: das wilde Geschrei, das aus dem Lager scholl, sowohl die Schreckensrufe der so unvermutet aus dem Schlaf Geschreckten, als das Siegesgebrüll der Beduinen verursachte ein so großes Getöse, daß es bis in die entfernte Höhle vernehmbar wurde.“"
                            },
                            {
                                "example_id": "082868f3-3898-4d54-9156-7339ad885d42",
                                "sense_id": "6b1f477a-2de5-32be-a72f-e9adbd5db7b5",
                                "text": "„Während der Nazijahre schrieb Jarnach ‚Musik mit Mozart‘ und das ‚Amrumer Tagebuch‘, dessen seelenwunde Elegie und düsterer Sturmreigen so gar nicht zum Siegesgebrüll der NS-Wochenschau passen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
