                                        "sense_id": "337b870b-cfa2-3cbb-91c9-037f2bdf7a1b",
                                        "entry_id": "491bc3e1-5eb1-343d-b87a-b57d467819f5",
                                        "glosses": [
                                            "That acts as a bridge (in many contexts)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884baec3-8bf6-4303-bb7c-46c6227c5926",
                                                "sense_id": "337b870b-cfa2-3cbb-91c9-037f2bdf7a1b",
                                                "text": "Loading and unloading between platform and train are carried out at the busier stations by means of fork-lift trucks and at smaller points by bridging boards or lifting platforms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bridging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb02d9c-7e3f-355c-8e53-3bf1bc048b72",
                                        "entry_id": "f1d75d1f-6761-3678-8985-0c5872678b44",
                                        "glosses": [
                                            "The act of building a bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cdf226-7286-4864-82bb-ae480a78cb37",
                                                "sense_id": "3bb02d9c-7e3f-355c-8e53-3bf1bc048b72",
                                                "text": "With him were 60,000 combat engineers for multiple bridgings of the river, and hundreds of thousands of tons of supplies, landing craft, and amphibious vehicles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a489a9-aa63-3200-a6e9-ae2b4aa8c1c6",
                                        "entry_id": "f1d75d1f-6761-3678-8985-0c5872678b44",
                                        "glosses": [
                                            "The system of bracing used between floor or other timbers to distribute the weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e3537e-9bd3-44a3-91aa-5430ee06d8a6",
                                                "sense_id": "e4a489a9-aa63-3200-a6e9-ae2b4aa8c1c6",
                                                "text": "All the joists and bridgings of the mezzanine floor to have stout double herringbone strutting not more than 6 feet apart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e72af83f-79a1-48b0-9235-2fb74d6f62aa",
                        "source_entry_id": "c3ca1864-ca9f-3d80-82f7-626f4a4997c6",
                        "source_sense_description": "intervention médicale",
                        "target_lang_word": "Bypass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bypass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46532546-579b-3216-a366-74bdeb0cca68",
                                        "entry_id": "6a34dd2f-41a5-3936-82b3-4e84dd73db2e",
                                        "glosses": [
                                            "parallel zur Hauptströmung verlaufende Umführung eines Abschnittes, mit dem Zweck der Umgehung desselben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3baa103c-179c-4178-88fb-43abdce8ea1a",
                                                "sense_id": "46532546-579b-3216-a366-74bdeb0cca68",
                                                "text": "„Bei der Entkopplung ist die Schnittstelle(z.B.hydraulische Weiche, Wärmeübertrager, Bypass, differenzdruckarmer Verteiler) zwischen zwei hintereinander geschalteten Strömungskreisen so gestaltet,das seine vernachlässigbare Druckdifferenz ansteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f6289cc-62ed-3a8f-b230-bfe8bc1078f5",
                                        "entry_id": "6a34dd2f-41a5-3936-82b3-4e84dd73db2e",
                                        "glosses": [
                                            "parallele Injizierung oder Rückführung von etwas, in den hauptsächlichen Stoffstrom, zur Mischung mit dem Selbigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e482cc8-063d-419f-b899-63c0752d7c39",
                                                "sense_id": "0f6289cc-62ed-3a8f-b230-bfe8bc1078f5",
                                                "text": "„Ein Bypass ist eine Umgehungsleitung, die von der Druckseite des Ventilators zurück zur Saugseite führt. Wird der Bypass geöffnet, strömt nur noch ein Teil der Luft an die Stelle, die eigentlich von der Lüftungsanlage versorgt wird, der Rest strömt auf die Saugseite zurück.“"
                                            },
                                            {
                                                "example_id": "2f7d44e5-139c-4f89-a7e6-f843ca507608",
                                                "sense_id": "0f6289cc-62ed-3a8f-b230-bfe8bc1078f5",
                                                "text": "„Weiterhin lassen die Untersuchungsergebnisse den Schluss zu, dass vor dem Hintergrund der im Rahmen der mechanisch-biologischen Abfallbehandlung herrschenden Randbedingungen, wie z.B. die hohen relativen Luftfeuchtigkeiten des Abgases, die Installation der Ionisation im Bypass und der biologischen Stufe nachgeschaltet als vergleichsweise günstigere Alternative erscheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd2b84af-3d8c-34ca-a5f1-7a57574c2eef",
                                        "entry_id": "6a34dd2f-41a5-3936-82b3-4e84dd73db2e",
                                        "glosses": [
                                            "Kondensator zur Funkentstörung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6082e83c-6842-3670-bb32-2b3ad45d65ec",
                                        "entry_id": "6a34dd2f-41a5-3936-82b3-4e84dd73db2e",
                                        "glosses": [
                                            "Überbrückung eines krankhaft veränderten Abschnittes eines Blutgefäßes oder der Luftröhre; Einpflanzung eines Ersatzstückes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5056ded-303a-4b1c-bf4a-cf2a686f1992",
                                                "sense_id": "6082e83c-6842-3670-bb32-2b3ad45d65ec",
                                                "text": "„Ein Bypass hingegen erfordert eine größere OP: Ein gesundes Blutgefäß muss aus dem Bein oder der Brustwand entnommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d47fb928-3fe3-3ac7-9bfe-08459589d4d5",
                                        "entry_id": "6a34dd2f-41a5-3936-82b3-4e84dd73db2e",
                                        "glosses": [
                                            "Ersatzstück, durch das das umgeleitete Blut fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbe4c65c-d61d-4f1f-8a37-702c54079852",
                                                "sense_id": "d47fb928-3fe3-3ac7-9bfe-08459589d4d5",
                                                "text": "„Drei Bypässe soll er bekommen, sein Herz soll stillgelegt und an die Herz-Lungen-Maschine angeschlossen werden.“"
                                            },
                                            {
                                                "example_id": "0a3cbc7d-73a9-4492-b776-7ce368aa7517",
                                                "sense_id": "d47fb928-3fe3-3ac7-9bfe-08459589d4d5",
                                                "text": "„1997, dreizehn Jahre nach Sandys erstem Bypass, waren er und Marcus in New Jersey gewesen, um seinen Sohn Jonathan zu besuchen, als Sandy plötzlich Brustschmerzen bekam und kurzatmig wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
