                    {
                        "sense_id": "56411efb-9c04-377e-b89e-6708c5352500",
                        "entry_id": "b4e15a61-ee62-3407-b66d-967c31d5b6c5",
                        "glosses": [
                            "spezielle Form der Ribonukleinsäure, kurz RNA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7a499b-d236-4224-a183-3dd29a7c5379",
                                "sense_id": "56411efb-9c04-377e-b89e-6708c5352500",
                                "text": "„Messenger-RNAs sind Kopien von unseren Genen, die für bestimmte Proteine codieren. Sie sind die Blaupausen, aus denen in einer Zelle schließlich Enzyme, Strukturproteine oder Signalmoleküle entstehen.“"
                            },
                            {
                                "example_id": "5b5481e3-8883-438c-ada0-b94091530ca8",
                                "sense_id": "56411efb-9c04-377e-b89e-6708c5352500",
                                "text": "Die Messenger-RNA ist die Matrize für die Proteinsynthese, also für die Translation."
                            }
                        ],
                        "sense_index_json": "\"1\""
