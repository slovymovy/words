                        "entry_id": "0a01715e-5154-3e35-beb1-3e9b5369d16d",
                        "glosses": [
                            "Eigenschaft, keine spezifische Ursache zu haben"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64a1af75-93bc-30e8-a067-552fe0ee33eb",
                        "entry_id": "0a01715e-5154-3e35-beb1-3e9b5369d16d",
                        "glosses": [
                            "etwas, das ohne spezifische Ursache (zufällig) zustande kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af143023-a900-4d1c-a076-b633e37d2453",
                                "sense_id": "64a1af75-93bc-30e8-a067-552fe0ee33eb",
                                "text": "„In seinen früheren Schlachten hatte er nur an solche Zufälligkeiten gedacht, die seinen Erfolg sichern konnten, jetzt aber drängte sich ihm eine unendliche Menge unheilbringender Zufälligkeiten auf, und es war ihm, als müssten alle diese Möglichkeiten zu Ereignissen werden.“"
                            },
                            {
                                "example_id": "c36a0a30-03a9-41af-940d-a076f00e1787",
                                "sense_id": "64a1af75-93bc-30e8-a067-552fe0ee33eb",
                                "text": "„Mir brachten sie die fürchterlichste Qual – anderen werden sie vielleicht nicht mehr scheinen als groteske Zufälligkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
