        "fr-extract.jsonl": [
            {
                "entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
                "word": "prêle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36b3227d-3841-46ab-8abd-9268a48930f7",
                        "entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "prêles"
                    },
                    {
                        "form_id": "f2f7254b-360c-4409-9010-65c967abc8d0",
                        "entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
                        "tags": [],
                        "form": "prèle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                        "entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
                        "glosses": [
                            "Plante cryptogame à tige striée et rude au toucher, munie de rameaux grêles, à petites feuilles écailleuses, disposées en collerette sur des nœuds à intervalles réguliers, à sporanges groupés en épi terminal, dont certaines espèces sont utilisées pour leurs propriétés astringente, hémostatique ou diurétique et que l’on trouve dans les lieux humides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7527d569-6a94-4bc8-8c92-5ffaed4eca4a",
                                "sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                                "text": "Valentine … sommeillait à demi, cachée, à ce qu'elle croyait, par les hautes tiges de la prêle de rivière."
                            },
                            {
                                "example_id": "54f9904c-eb23-484b-93b1-8e36d38a3f74",
                                "sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                                "text": "De chaque côté, à droite, à gauche, des étangs sont là, qui communiquent avec le ruisseau par de minces canaux engorgés d’herbes aquatiques, des canaux où parfois les brochets s’engagent. On les voit naviguer dans le fouillis des lentilles d’eau, des prêles, des cardamines, des cirses, flore touffue et mystérieuse, qui reste vivace et verte malgré l’hiver."
                            },
                            {
                                "example_id": "7ca89c1e-d8e2-4d79-8ad5-6787c4dbd66a",
                                "sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                                "text": "Dans les dépressions où leur puissance était grande, les prêles ont protégé les roches meubles sous-jacentes, tandis que l’érosion déblayait celles-ci là où cette couverture protectrice était absente ou moins épaisse."
                            },
                            {
                                "example_id": "5f787560-bcad-4c6b-bb91-e254bb5d3ffd",
                                "sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                                "text": "L’herbe à coton, l’élégante linaigrette, semait ses houppes soyeuses, les bourgeons précoces de l’airelle bleue des marais pointaient ça et là. Les prêles dressaient leurs épis bruns au cœur même du tapis de sphaignes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34ceec56-966b-4b03-84ee-6d38560e7096",
                        "source_entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
                        "source_sense_id": "7f45e4c4-0e60-3081-8b65-d8c5a5a93854",
                        "target_lang_word": "Schachtelhalm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schachtelhalm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4567ac5-b2ee-3ac4-bf20-2d3b898271c8",
                                        "entry_id": "95fd9bc4-0481-3b85-b847-ea33038fbbbd",
                                        "glosses": [
                                            "Abteilung (Division) im Reich der Pflanzen (Sphenophyta) mit einer Gattung Equisetum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec6bad6c-f1c8-42f6-bcab-b978e06e5956",
                                                "sense_id": "f4567ac5-b2ee-3ac4-bf20-2d3b898271c8",
                                                "text": "Der Riesen-Schachtelhalm (Equisetum telmateia) ist die größte einheimische Schachtelhalm-Art, die in Europa und im westlichen Nordamerika verbreitet ist."
                                            },
                                            {
                                                "example_id": "e4e0ebc7-f8df-496f-8921-56d7e2694bb6",
                                                "sense_id": "f4567ac5-b2ee-3ac4-bf20-2d3b898271c8",
                                                "text": "Alle Schachtelhalme haben ein röhrenförmigen Stamm, der einen zentralen Markhohlraum besitzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "131be39f-0078-3c0f-b8cc-dc6c6efd3192",
                                        "entry_id": "95fd9bc4-0481-3b85-b847-ea33038fbbbd",
                                        "glosses": [
                                            "Pflanze aus dieser einen Gattung Equisetum"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "462b77ed-7bc0-4575-a79e-f93b126123bd",
                        "source_entry_id": "f253739a-accb-301d-91cb-2d2531a9e0a2",
