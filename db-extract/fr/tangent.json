                        "entry_id": "c9500ea5-4606-3f05-924d-961f2da35704",
                        "glosses": [
                            "Qui touche une ligne ou une surface en un seul point en faisant avec elle un angle nul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d9cba9-1e49-42e4-bfcf-336e458d5f25",
                                "sense_id": "da64b3c9-b952-3e41-b446-c0ee13aa51cc",
                                "text": "Un plan tangent à une sphère."
                            },
                            {
                                "example_id": "4a33ada4-b14f-410e-845b-c274c194d98c",
                                "sense_id": "da64b3c9-b952-3e41-b446-c0ee13aa51cc",
                                "text": "Deux courbes tangentes en un point."
                            }
                        ]
                    },
                    {
                        "sense_id": "2de99b87-e1ee-3798-9122-aa9798777fc5",
                        "entry_id": "c9500ea5-4606-3f05-924d-961f2da35704",
                        "glosses": [
                            "Qui est près de réussir quelque chose ; qui approche de justesse d’un résultat."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b7db6573-bf96-4c08-a6c4-982f6d073dd5",
                                "sense_id": "2de99b87-e1ee-3798-9122-aa9798777fc5",
                                "text": "S’il obtient ce poste, ce sera tangent."
                            }
                        ]
                    }
