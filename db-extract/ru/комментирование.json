                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfdd2f07-effd-3b33-9142-d94758cf137e",
                                        "entry_id": "42a653e1-d178-32e7-950e-a583165ee28e",
                                        "glosses": [
                                            "The use of comments in source code."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f3f9805-1572-43a1-971a-91be335685de",
                                                "sense_id": "bfdd2f07-effd-3b33-9142-d94758cf137e",
                                                "text": "In-program commentation is another level of documentation that is compulsory, with standards being set regarding what should be included in source code."
                                            }
