                        "examples": [
                            {
                                "example_id": "f44ec407-57ff-4ca9-94e3-a42fe9852662",
                                "sense_id": "315221b1-8ea4-3701-b307-c17a2df4cc82",
                                "text": "Les plus grands cristaux de milarite ont été trouvés, dans les fentes alpines suisses des Val Giuv, Tavetsch, Strimthal et autres dans le canton des Grisons, et le glacier de Fieschergletscher, dans le canton du Valais."
                            },
                            {
                                "example_id": "73111086-88cc-45b8-b98f-0a85b0797155",
                                "sense_id": "315221b1-8ea4-3701-b307-c17a2df4cc82",
                                "text": "Toujours en Suisse, au Fieschergletscher, la milarite se présente en beaux cristaux, atteignant 25 mm, associés à l’axinite et à la bavénite."
                            }
                        ]
                    }
