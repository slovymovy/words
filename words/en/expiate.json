{
    "word_family": [
        "expiation",
        "expiatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "517a4c0b-b65e-30e3-a97d-acd8cc5181bb",
                    "sense_definition": "To make amends or provide compensation for a wrongdoing or sin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "atonement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hoped that his hard work would <w>expiate</w> the mistakes he made in his youth."
                        },
                        {
                            "text": "She tried to <w>expiate</w> her guilt by donating a large portion of her salary to charity."
                        }
                    ],
                    "synonyms": [
                        "atone",
                        "compensate",
                        "redeem"
                    ]
                },
                {
                    "sense_id": "a34247e4-40d7-36b8-8ed0-cc8d10ee7a2b",
                    "sense_definition": "To remove the feeling of guilt or the state of being guilty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "atonement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ritual was intended to <w>expiate</w> the community of its collective shame."
                        },
                        {
                            "text": "He sought a spiritual path to <w>expiate</w> his conscience after the tragic accident."
                        }
                    ],
                    "synonyms": [
                        "absolve",
                        "cleanse"
                    ]
                },
                {
                    "sense_id": "42790861-535d-3b4d-82c7-f20cc497bb26",
                    "sense_definition": "To purify or sanctify something through religious or sacred ceremonies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "purification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient priests would <w>expiate</w> the temple before the start of the holy festival."
                        },
                        {
                            "text": "They performed a ceremony to <w>expiate</w> the sacred grounds after the disturbance."
                        }
                    ],
                    "synonyms": [
                        "purify",
                        "sanctify"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a historical or religious context."
                        }
                    ]
                },
                {
                    "sense_id": "120e9c73-4596-3f0c-8d69-48b9efb60c31",
                    "sense_definition": "To bring something to a final conclusion or end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote of his desire for death to <w>expiate</w> his long and weary days."
                        },
                        {
                            "text": "The final chapter serves to <w>expiate</w> the long narrative of the king's reign."
                        }
                    ],
                    "synonyms": [
                        "conclude",
                        "terminate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is no longer common in modern English."
                        }
                    ]
                }
            ]
        }
    ]
}