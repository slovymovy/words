                    {
                        "translation_id": "2a849b1f-50da-436a-9c37-c706b467ffe3",
                        "source_entry_id": "960885f3-3342-3d36-ab11-a5e6d070830e",
                        "source_sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
                        "source_sense_description": "ein bewegtes Band, das zum Transport dient",
                        "target_lang_word": "conveyor belt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conveyor belt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb4782c-2ae1-3176-9367-b46c3fa81289",
                                        "entry_id": "17a5e143-067d-3e18-8cca-c6c9f54b7a7c",
                                        "glosses": [
                                            "A continuous flexible band moved by a series of rollers to transport objects or material from one place to another, especially within a factory or mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e593d29-0538-4120-be60-f707d4c59242",
                                                "sense_id": "4bb4782c-2ae1-3176-9367-b46c3fa81289",
                                                "text": "Some stone was being loaded into standard gauge wagons by means of a portable conveyor belt."
                                            },
                                            {
                                                "example_id": "73d1937a-a68b-4eaf-8316-caf4db801e7f",
                                                "sense_id": "4bb4782c-2ae1-3176-9367-b46c3fa81289",
                                                "text": "BR success in establishing this new \"Company\" train service follows a year's operation of a conveyor-belt traffic in car parts between the Ford plant at Dagenham and the firm's recently-opened £30m Merseyside factory at Halewood, where Ford Corsairs, Capris and Anglias are manufactured."
                                            },
                                            {
                                                "example_id": "5cf4896d-c9ac-4b5d-96db-9ec2d66745fe",
                                                "sense_id": "4bb4782c-2ae1-3176-9367-b46c3fa81289",
                                                "text": "Buckinghamshire Council has received proposals from HS2 Ltd to install a conveyor belt near Small Dean, Wendover. [...] The conveyor belt would be in place for two years and is estimated to remove the need for some 200 lorries per day."
                                            }
                                        ]
                                    }
                                ]
                            }
