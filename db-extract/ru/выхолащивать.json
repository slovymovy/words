                    },
                    {
                        "sense_id": "947fc032-6810-3bbc-9e5a-5c5df17794af",
                        "entry_id": "5e60f34b-de60-3960-b784-dde0e642c44e",
                        "glosses": [
                            "to deprive (a theory, a doctrine etc.) of vivacity"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65013d7-e273-4027-a532-379ba89ac7d2",
                                "sense_id": "947fc032-6810-3bbc-9e5a-5c5df17794af",
                                "text": "Из маркси́зма я́вными софи́змами выхола́щивают его́ революцио́нную живу́ю ду́шу, в маркси́зме признаю́т всё, кро́ме революцио́нных средств борьбы́, про́поведи и подгото́вки их, воспита́ния масс и́менно в э́том направле́нии.",
                                "translation": "By means of obvious sophism the living revolutionary soul is ripped out of Marxism, in which everything is accepted except the revolutionary methods of struggle, their propaganda and preparation, and the education of the masses for that purpose.",
                                "english": "By means of obvious sophism the living revolutionary soul is ripped out of Marxism, in which everything is accepted except the revolutionary methods of struggle, their propaganda and preparation, and the education of the masses for that purpose."
                            }
                        ]
                    }
