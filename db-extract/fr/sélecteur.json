                                        "sense_id": "55ab802f-2428-3033-ba5a-39bbcbab73bf",
                                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                                        "glosses": [
                                            "One who or that which operates a switch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da92cc0-647b-4273-805d-2ea3227a2dcf",
                                                "sense_id": "55ab802f-2428-3033-ba5a-39bbcbab73bf",
                                                "text": "They all love frugality and conservation; they are manic savers of bits of string and switchers-off of lights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                                        "glosses": [
                                            "One who or that which switches, that is, changes in some way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5834d3-b26c-4b54-8b15-df0bff8d7568",
                                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                                "text": "career switcher"
                                            },
                                            {
                                                "example_id": "93505a65-c071-4b81-ae46-0e23352fe6b5",
                                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                                "text": "Switch to Acme brand razors for a closer shave! For a limited time, we'll pay you to be a switcher!"
                                            },
                                            {
                                                "example_id": "187452aa-cf80-44ac-b84c-32039feb7378",
                                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                                "text": "As a career switcher, I diligently attended all the company presentations on campus, and quickly settled on sales and trading. My prior position was in hospital sales."
                                            },
                                            {
                                                "example_id": "d28dbbc7-3e42-48da-a9e6-37fde11d84e8",
                                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                                "text": "In short, the task switcher gives you a way to jump directly to another app, without a layover at the Home screen first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d602b91-5d74-3bae-97b0-08994df81e27",
                                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                                        "glosses": [
                                            "A switchmode power supply."
                                        ],
