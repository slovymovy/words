                "senses": [
                    {
                        "sense_id": "a889be60-2616-3bb6-82b0-5ca870392e14",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "Someone who spits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7480d5da-3408-4530-ba85-7119382c9fcd",
                                "sense_id": "a889be60-2616-3bb6-82b0-5ca870392e14",
                                "text": "Fines will be issued to spitters who spit wantonly in public."
                            },
                            {
                                "example_id": "ad267160-8668-4b61-b250-b5cfd0edff2b",
                                "sense_id": "a889be60-2616-3bb6-82b0-5ca870392e14",
                                "text": "After the SARS outbreak in 2003, China, Hong Kong, and Taiwan launched campaigns to discourage public spitting by issuing fines to public spitters."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9941bc1-04e3-3abc-ba9d-bad1d2b1f2e7",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "Someone who spits.",
                            "Someone who spits out semen during oral sex."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "09d8a1a1-c928-3e2b-889a-3c102eb39ae9",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "Rapper, emcee."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9ce873c-7e61-44e5-a1c4-936b458e0ac1",
                                "sense_id": "09d8a1a1-c928-3e2b-889a-3c102eb39ae9",
                                "text": "On the stage with the RZA to the Gravediggaz\nGZA used to say I was his favorite spitter"
                            },
                            {
                                "example_id": "8fc9d26c-08c1-4a9c-a7b6-b67c922f05fb",
                                "sense_id": "09d8a1a1-c928-3e2b-889a-3c102eb39ae9",
                                "text": "What you tryna be Vito? Well there's rules to this shit\nDon't get clapped, y'all ain't real spitters, y'all lips chapped"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee1b40a6-bb8c-384d-aac2-c4feb44b2c64",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "Synonym of spitting cobra."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4f834b85-09e9-3358-a0b8-ea41cf7f54bf",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "A small shower (of rain), a spatter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b120298-5e76-43fc-8937-c789860b90a6",
                                "sense_id": "4f834b85-09e9-3358-a0b8-ea41cf7f54bf",
                                "text": "A zigzag of lightning fretted the eastern horizon in a brilliant greenish flash, sharply outlining the sea-line; and, as a solemn, hollow, distant peal reverberated, a spitter of rain fell. There was not a breath of wind, and the whack-whacking and spits of flame from the warships came threatening over the darkening sea."
                            },
                            {
                                "example_id": "37c521a2-820d-4000-9987-b6a446ce1f4d",
                                "sense_id": "4f834b85-09e9-3358-a0b8-ea41cf7f54bf",
                                "text": "[A] spitter of rain hit the leaves, increasing to a drenching rush."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a6246c6-b0dc-3533-ae08-c724b3b1a7f7",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "Synonym of spitball."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42052d78-f77d-4cf5-acdc-970737c9d33c",
                                "sense_id": "2a6246c6-b0dc-3533-ae08-c724b3b1a7f7",
                                "text": "Coach says no throwing any spitters."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9a02f95-c7ba-311a-830d-6a63485efd1d",
                        "entry_id": "df67ef5e-31c6-35aa-a8de-3cc29cb6a7e3",
                        "glosses": [
                            "An improvised and portable spittoon, typically a beverage bottle repurposed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3300045-ff61-425f-820b-fca2c9c8070a",
                                "sense_id": "d9a02f95-c7ba-311a-830d-6a63485efd1d",
                                "text": "with a spitter in the console of his Camaro"
