                    "frequency": "Low",
                    "semantic_group_id": "headpiece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Roman statues often depicted emperors wearing a simple cloth <w>diadem</w>."
                        },
                        {
                            "text": "The museum displays a silk <w>diadem</w> embroidered with pearls and precious stones."
                        }
                    ],
                    "synonyms": [
                        "circlet",
                        "headband"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often refers to ancient or historical headbands"
                        }
                    ]
                },
                {
                    "sense_id": "abc77132-e5ca-3a8d-bd3c-47cab4418a38",
                    "sense_definition": "Regal power, sovereignty, or supreme imperial authority, symbolized by a crown.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ambitious general sought to seize the imperial <w>diadem</w> for himself."
                        },
                        {
                            "text": "Centuries of war weakened the prestige and authority of the <w>diadem</w>."
                        }
                    ],
                    "synonyms": [
                        "monarchy",
                        "royalty",
                        "sovereignty"
                    ],
                    "common_phrases": [
                        "imperial diadem"
                    ],
                    "traits": [
