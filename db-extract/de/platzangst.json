        "tr-extract.jsonl": [
            {
                "entry_id": "150dea50-7568-33d2-b851-550af7478f79",
                "word": "Platzangst",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "16c46137-ed22-4170-832f-9b180a1d8095",
                        "entry_id": "150dea50-7568-33d2-b851-550af7478f79",
                        "tags": [
                            "genitive"
                        ],
                        "form": "Platzangst"
                    },
                    {
                        "form_id": "e3c73765-de40-4513-88e3-63ab79218c81",
                        "entry_id": "150dea50-7568-33d2-b851-550af7478f79",
                        "tags": [
                            "plural"
                        ],
                        "form": "Platzängste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47f53357-b2f0-35a3-8393-593161706ec8",
                        "entry_id": "150dea50-7568-33d2-b851-550af7478f79",
                        "glosses": [
                            "agorafobi"
                        ],
                        "tags": [
                            "fobiler"
                        ],
                        "examples": [
                            {
                                "example_id": "b952e438-91c6-457f-bfc4-34fd9b90ddec",
                                "sense_id": "47f53357-b2f0-35a3-8393-593161706ec8",
                                "text": "Wegen seiner Platzangst geht Karl auf kein Festival.",
                                "translation": "Klostrofobisi sebebiyle Karl hiçbir festivale gitmiyor."
                            }
                        ]
                    },
                    {
                        "sense_id": "b347eb9f-5557-3661-a041-792d41ae410a",
                        "entry_id": "150dea50-7568-33d2-b851-550af7478f79",
                        "glosses": [
                            "klostrafobi"
                        ],
                        "tags": [
                            "günlük konuşma"
                        ],
                        "examples": [
                            {
                                "example_id": "5379549d-cb4e-461b-b267-eaa25054620a",
                                "sense_id": "b347eb9f-5557-3661-a041-792d41ae410a",
                                "text": "Er leidet unter Platzangst, selbst Aufzüge bereiten ihm Angst.",
                                "translation": "Klostrofobisi var ve asansörler bile onu korkutuyor."
                            },
                            {
                                "example_id": "1df7540a-239e-4864-b754-25192ce61dba",
                                "sense_id": "b347eb9f-5557-3661-a041-792d41ae410a",
                                "text": "„Er kroch durch die niedrigsten Schächte, bis er sich an seine Platzangst gewöhnt hatte wie an einen nicht nachlassenden, allmählich jedoch erträglichen Schmerz.“",
                                "translation": "Sanki sürekli ama yavaş yavaş katlanılabilir bir acıymış gibi klostrofobisine alışana kadar en alttaki kuyulardan emekleyerek geçti."
                            },
                            {
                                "example_id": "7dda3d23-7b7b-4207-b42f-5599d20dc8ca",
                                "sense_id": "b347eb9f-5557-3661-a041-792d41ae410a",
                                "text": "„Ich versuchte, durch gedankliche Ablenkungsmanöver der sich heranpirschenden Platzangst zu entgehen.“",
                                "translation": "Beni takip eden klostrofobiden kaçınmak için zihnî dikkat dağıtıcıları kullanmaya çalıştım."
                            }
                        ]
                    }
                ],
