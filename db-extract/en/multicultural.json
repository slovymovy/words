                    },
                    {
                        "translation_id": "a39f011b-75d6-4588-8721-d323990fede0",
                        "source_entry_id": "a711c7e4-3a9e-364f-8f6c-a1e3f848bfb2",
                        "source_sense_description": "relating to several different cultures",
                        "target_lang_word": "multicultureel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
