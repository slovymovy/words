                        "glosses": [
                            "einem Kasten ähnelnd, wie ein Kasten aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18185f0c-4f07-4416-ae7d-17eb4d15184a",
                                "sense_id": "6e9afbc7-341b-313a-b177-c527ebfab253",
                                "text": "„Mittels einer weiteren Vorrichtung, eines kastenartigen Kristalls, der ein schimmerndes, blütenförmiges Feld ausstrahlte, wurden weitere Vertreter jenes ovalschädeligen, gesichtslosen Wesens unterdrückt, bei denen es sich allem Anschein nach um Sklavenarbeiter handelte.“"
                            }
                        ],
