                "senses": [
                    {
                        "sense_id": "3e0635bd-08b0-39b7-a0a3-923cb30c2090",
                        "entry_id": "cbccaf71-b7e9-34e6-be44-10a2fcf05ed9",
                        "glosses": [
                            "Long couteau à lame effilée et légèrement courbe, parfois repliable, en usage dans le monde hispanoaméricain."
                        ],
                        "tags": [
                            "Coutellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "5b2c2108-d6f2-4b8d-af21-12c6d6974efb",
                                "sense_id": "3e0635bd-08b0-39b7-a0a3-923cb30c2090",
                                "text": "Ces navajas, d’un goût arabe et barbare très caractéristique, ont des manches de cuivre découpé dont les jours laissent voir des paillons rouges, verts ou bleus ; des niellures grossières, mais enlevées vivement, enjolivent la lame faite en forme de poisson et toujours très-aiguë."
                            },
                            {
                                "example_id": "52e67489-8c33-4835-ad35-3a2e3cf5348c",
                                "sense_id": "3e0635bd-08b0-39b7-a0a3-923cb30c2090",
                                "text": "Une large ceinture de laine rouge lui sanglait les reins, et il en avait tiré une navaja valencienne qui, ouverte, atteignait la longueur d’un sabre."
                            },
                            {
                                "example_id": "cfd5396a-81a3-4edc-b0a0-9a8caf0413c5",
                                "sense_id": "3e0635bd-08b0-39b7-a0a3-923cb30c2090",
                                "text": "LA MÈRE : le Fils a emporté ma navaja. C'est une bonne lame. Je la lui ai confiée cette nuit."
                            }
                        ]
                    }
                ],
