                        ],
                        "form": "марокка́нских"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c4f832a-00a0-3241-8b2b-849eeca593e5",
                        "entry_id": "704bc229-9aaa-3f41-bd8d-538468a7965c",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными марокканцы, Марокко"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3f95b99-cd0b-481f-85c4-db57ae6c888a",
                        "source_entry_id": "704bc229-9aaa-3f41-bd8d-538468a7965c",
                        "source_sense_id": "5c4f832a-00a0-3241-8b2b-849eeca593e5",
                        "target_lang_word": "marokkanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marokkanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "145436e6-c125-358c-9412-ae118f6d535d",
                                        "entry_id": "b44f3749-a9ab-350d-b29a-492d7b8e5e09",
                                        "glosses": [
                                            "Marokko betreffend, aus Marokko kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056c37b5-a78d-4e79-8ccf-1474cd4a73e2",
                                                "sense_id": "145436e6-c125-358c-9412-ae118f6d535d",
                                                "text": "„Die Behörden müssen die Zeitung verbieten. Sie schadet den islamischen Werten der marokkanischen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "f2d27dc7-07fd-445b-85e5-cd9309e53bc6",
                                                "sense_id": "145436e6-c125-358c-9412-ae118f6d535d",
                                                "text": "Sie grenzen jenes Gemeinwesen ein, das Kenner des Maghreb als die „marokkanischste aller Städte\" bezeichnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                        "entry_id": "b44f3749-a9ab-350d-b29a-492d7b8e5e09",
                                        "glosses": [
                                            "auf die in Marokko gesprochene Varietät des Arabischen (Marokkanisch-Arabisch) bezogen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62122bab-6f9c-4167-8f9a-e0c554fda03a",
                                                "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                                "text": "„Im Gegensatz zu allen anderen Schülern der untersuchten Gruppe strukturierte Marouane seine marokkanische Version der Geschichte weitaus stärker als dessen französische Fassung.“"
                                            },
                                            {
                                                "example_id": "2237e8ea-3e1e-4e7a-8967-1f7317cadc12",
                                                "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                                "text": "„In den ersten drei Texten zu einer Bildergeschichte transferiert sie Formen von der mündlichen deutschen zur mündlichen marokkanischen und von der mündlichen deutschen zur schriftlichen deutschen Version […]“"
                                            },
                                            {
                                                "example_id": "7bcc66d2-8380-4a64-a058-69620c8061b0",
                                                "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                                "text": "„Soweit nicht anders vermerkt, sind die obigen Formen marokkanisch.“"
                                            },
                                            {
                                                "example_id": "48f76738-f1b5-4aae-b898-f42545a240df",
                                                "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                                "text": "„Zunächst werden wir uns mit der Theorie auseinandersetzen, daß der marokkanische Text eine Vollform, wenn nicht den Urtext des Romance darstellt, dies besonders wegen seines logischen Ablaufs.“"
                                            },
                                            {
                                                "example_id": "0dc3c50c-4b7b-4090-9e5c-0a129cead94f",
                                                "sense_id": "b40cafdc-0d69-33d1-950a-dd3edf29084a",
                                                "text": "„Das Deutsche und das marokkanische Arabisch eignen sich deshalb gut zur Untersuchung dieser Fragestellung, weil sie unterschiedliche morphologische Systeme aufweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
