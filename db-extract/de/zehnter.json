                                    },
                                    {
                                        "sense_id": "7fdee01a-4815-3787-a600-8e49a13f5447",
                                        "entry_id": "428d0998-249a-3335-b45f-1131037ee7af",
                                        "glosses": [
                                            "One of ten equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c9fcdc-b37f-45e1-a839-0965c5ba1ed4",
                                                "sense_id": "7fdee01a-4815-3787-a600-8e49a13f5447",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a60d69c-aefd-34be-a8d8-a8c155705f6d",
                                        "entry_id": "428d0998-249a-3335-b45f-1131037ee7af",
                                        "glosses": [
                                            "The interval between any tone and the tone represented on the tenth degree of the staff above it, as between one of the scale and three of the octave above; the octave of the third."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b1a953-bce9-3b33-97c7-1d877af003de",
                                        "entry_id": "428d0998-249a-3335-b45f-1131037ee7af",
                                        "glosses": [
                                            "A temporary aid issuing out of personal property, and granted to the king by Parliament; formerly, the real tenth part of all the movables belonging to the subject."
