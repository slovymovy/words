                "senses": [
                    {
                        "sense_id": "08fb27a7-da42-3870-9f89-397d18d1ae26",
                        "entry_id": "e6d0e482-7caa-3aa9-bec5-5ec9584dfa35",
                        "glosses": [
                            "een bakstenen gevel van een smal huis (drie, soms twee, ramen breed) met twee hoeken van 90° aan de top die opgevuld zijn met zandstenen ornamenten, zogenaamde klauwstukken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff0cf11-79cc-4a4d-8359-ae834d910afa",
                                "sense_id": "08fb27a7-da42-3870-9f89-397d18d1ae26",
                                "text": "Toen de spelersboot voorbij was, en de voetballers alweer neerhurkten voor de volgende brugboog, bleven we nog even naar de halsgevel van ons vroegere huis staan kijken."
                            },
                            {
                                "example_id": "7581558b-4c6f-4849-ab58-9b34320257b7",
                                "sense_id": "08fb27a7-da42-3870-9f89-397d18d1ae26",
                                "text": "Het huis –met karakteristieke halsgevel– stamt uit circa 1640 en is volgens Exalto bezit geweest van baljuws, schouten en burgemeesters. „De eerst bekende bewoner was Johan van Lodensteijn. Of-ie familie was van Jodocus heb ik helaas niet kunnen achterhalen.”"
                            }
                        ]
                    }
