                        "entry_id": "87c187ce-567a-395e-a30e-33287ac47ba1",
                        "glosses": [
                            "A believer of monotheism, the doctrine that there is a single divine being in the universe."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1d02611-c39a-4893-bd4d-d376b25e4256",
