                        "form": "endiablée"
                    },
                    {
                        "form_id": "023a3c15-b5b7-473b-a9a9-e49d2c85710f",
                        "entry_id": "c59dcfc4-99c3-3f0e-9054-d770dafa7985",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "endiablées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "948119df-f5e9-3de4-89b5-4f6960a9e70f",
                        "entry_id": "c59dcfc4-99c3-3f0e-9054-d770dafa7985",
                        "glosses": [
                            "Qui est comme possédé du démon."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ba3e4d5b-d324-49c1-a5d3-b7cdfabf17bf",
                                "sense_id": "948119df-f5e9-3de4-89b5-4f6960a9e70f",
                                "text": "Que vit-il ? l’endiablé maraudeur qui, à cheval sur le mur, pêchait effrontément ses canards à la ligne dans la mare de la basse-cour."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce27f99d-7f5c-3ea2-86a4-8e1059f01b42",
                        "entry_id": "c59dcfc4-99c3-3f0e-9054-d770dafa7985",
                        "glosses": [
                            "Qui tient du diable par la vivacité, l’ardeur, l’impétuosité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b89b516-bc4e-44b1-88ea-de946bdeb2fc",
                                "sense_id": "ce27f99d-7f5c-3ea2-86a4-8e1059f01b42",
                                "text": "Gallifet était aussi éloigné du cléricalisme que du nationalisme. Des innombrables coups de boutoir qu'il distribuait à la ronde avec un esprit endiablé il réservait une bonne part aux cagots et aux patriotards."
                            },
                            {
                                "example_id": "12167ed0-cddf-4dbb-9996-4ba6152fdbc6",
                                "sense_id": "ce27f99d-7f5c-3ea2-86a4-8e1059f01b42",
                                "text": "C’est un enfant endiablé, rien ne peut le discipliner."
                            },
                            {
                                "example_id": "bcf2b709-5f1d-48bc-a154-a2bfc51a932e",
                                "sense_id": "ce27f99d-7f5c-3ea2-86a4-8e1059f01b42",
                                "text": "Le linguiste contemporain travaille sur un matériau dont la part la plus passionnante est en train de disparaître sous ses yeux au rythme toujours plus endiablé de la mondialisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "151aacff-695e-302b-9696-956f9f3541be",
                        "entry_id": "c59dcfc4-99c3-3f0e-9054-d770dafa7985",
                        "glosses": [
                            "Effréné."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "58098616-f366-494d-be31-2253f52a6aea",
                                "sense_id": "151aacff-695e-302b-9696-956f9f3541be",
                                "text": "Le nain Ilioucha était parmi eux, hilare, effréné, grotesque, se livrant à un kozatchok endiablé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97d2f893-9a6c-44fd-ac9f-2b999cf89cf4",
                        "source_entry_id": "c59dcfc4-99c3-3f0e-9054-d770dafa7985",
                        "target_lang_word": "possessed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
