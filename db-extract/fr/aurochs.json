        "fr-extract.jsonl": [
            {
                "entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
                "word": "aurochs",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1bfd9959-8383-4664-aa21-3e39f404edc7",
                        "entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "auroch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af979399-bca5-3916-99bc-ded9b12cc3e9",
                        "entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
                        "glosses": [
                            "Espèce de taureau sauvage, ancêtre probable des bovins actuels, à présent disparu et qu’on appelle aussi « bœuf urus » et « ure » (surtout dans les mots croisés)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4580ab3e-b87f-4aa2-ab77-49cd9ba525c1",
                                "sense_id": "af979399-bca5-3916-99bc-ded9b12cc3e9",
                                "text": "Durant tout le Néolithique, les bovins, les moutons, les porcs, les chiens, mais aussi les cerfs, les sangliers et les aurochs participent, sous des formes différenciées mais de manière fondamentale, au domaine du sacré."
                            },
                            {
                                "example_id": "57755e26-5878-4d4c-a7a6-41e94c5dd868",
                                "sense_id": "af979399-bca5-3916-99bc-ded9b12cc3e9",
                                "text": "Avec à peu près deux mètres au garrot, l’aurochs présentait une taille plus importante que les races actuelles de bovins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf283ad0-8f39-4e66-9d19-620f3e279965",
                        "source_entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
                        "source_sense_id": "af979399-bca5-3916-99bc-ded9b12cc3e9",
                        "target_lang_word": "Auerochse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auerochse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef816dc-4983-34fc-81fa-e69b8d3cf401",
                                        "entry_id": "ca47bfb6-5992-3983-895b-40b195a90ac5",
                                        "glosses": [
                                            "ein ausgestorbenes Wildrind, Stammform des Hausrinds"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05bc5809-85c9-4469-95da-62cfeb883b9e",
                                                "sense_id": "9ef816dc-4983-34fc-81fa-e69b8d3cf401",
                                                "text": "Der letzte Auerochse starb im Jahre 1627."
                                            },
                                            {
                                                "example_id": "cffca9bf-6f46-4cb8-8ea7-4238028a7ce8",
                                                "sense_id": "9ef816dc-4983-34fc-81fa-e69b8d3cf401",
                                                "text": "„Sein verwüsteter Park ist heute ein Sportgelände für junge kommunistische Arbeiter, und aus seinem Forst sind die letzten Auerochsen, die sich dort bis in die ersten Kriegsjahre noch gehalten hatten, seit langem verschwunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d260df8-87fb-4a05-a779-a735df701a68",
                        "source_entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
                        "source_sense_id": "af979399-bca5-3916-99bc-ded9b12cc3e9",
                        "target_lang_word": "Ur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe0c26a-5339-39b5-80da-7412393aa5b8",
                                        "entry_id": "616e12a4-4777-3a0f-a2dc-5f1bd405f277",
                                        "glosses": [
                                            "der Auerochse, ein ausgerottetes Wildrind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312a215f-0a54-45fb-96c7-3e707ddcf00d",
                                                "sense_id": "1fe0c26a-5339-39b5-80da-7412393aa5b8",
                                                "text": "Der letzte Ur starb im Jahre 1627."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f13b0755-20f8-357d-aa3e-7f4116fd3e89",
                                        "entry_id": "45ef1811-d88e-39f4-a008-8605d1122f91",
                                        "glosses": [
                                            "sumerische Stadt im heutigen Irak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2843eadc-3a31-4f6d-897b-589b06cebb55",
                                                "sense_id": "f13b0755-20f8-357d-aa3e-7f4116fd3e89",
                                                "text": "„Es ging um die Zikkurats von Babylon, die terrassenartig angelegten Türme, die rund um Ur am Euphrat erbaut worden waren.“"
                                            },
                                            {
                                                "example_id": "73a84236-ab3b-4d81-b3de-146981228b72",
                                                "sense_id": "f13b0755-20f8-357d-aa3e-7f4116fd3e89",
                                                "text": "„Ich habe die Totenstadt in einer engen Schlucht entdeckt. Sie ist älter als die Grundmauern von Ur oder die älteste Pyramide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8304474c-da56-4cd0-a131-118d0481f3de",
                        "source_entry_id": "af55cf5b-a71c-3ac3-b29d-4d62d4287fae",
