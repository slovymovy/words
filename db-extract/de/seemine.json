                "senses": [
                    {
                        "sense_id": "10d50eb1-cd6d-30bc-9622-1bb9c95a6432",
                        "entry_id": "d43513b4-baac-3f5c-b140-c6294bb5583f",
                        "glosses": [
                            "in Gewässern gegen Schiffe und U-Boote eingesetzte Sprengladung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e16a59f-6c49-4789-a439-9d05058da659",
                                "sense_id": "10d50eb1-cd6d-30bc-9622-1bb9c95a6432",
                                "text": "„Ein Minenleger ist ein Kriegsschiff, das auf die Verlegung von Seeminen spezialisiert ist.“"
                            },
                            {
                                "example_id": "d25cc5f6-0cc6-4417-8207-48d6ff68c182",
                                "sense_id": "10d50eb1-cd6d-30bc-9622-1bb9c95a6432",
                                "text": "„Was die Minen anbelangt, haben die Tommies gleich zweierlei Sorten zu bieten: Seeminen, die von ihren U-Booten bis vor die Küste gekarrt werden, und Grundminen mit magnetischen und akustischen Zündern, die nachts von Flugzeugen abgeworfen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
