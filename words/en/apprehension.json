                    "frequency": "Middle",
                    "semantic_group_id": "fear_and_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden wave of <w>apprehension</w> as she walked into the dark, empty building."
                        },
                        {
                            "text": "Despite her growing <w>apprehension</w>, she decided to go ahead with the presentation."
                        }
                    ],
                    "synonyms": [
                        "alarm",
                        "misgiving",
                        "qualm",
                        "trepidation"
                    ],
                    "common_phrases": [
