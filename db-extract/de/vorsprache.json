                        "source_sense_id": "1ca3d42d-4dad-3f8b-9454-72681a925707",
                        "target_lang_word": "perusal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perusal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                        "entry_id": "268bec8e-d11b-35e5-a78e-382337500f51",
                                        "glosses": [
                                            "The act or process of perusing, or an instance of it.",
                                            "Studying something carefully; a careful study."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b44a382-5bac-41ca-92cf-dc42c6089d32",
                                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                                "text": "Please find attached the relevant documents for your perusal."
                                            },
                                            {
                                                "example_id": "3aa16b0f-2ff5-4cb5-a110-3ffcc66f2038",
                                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                                "text": "Having therefore no assistance but from general grammar, I applied myself to the perusal of our writers;"
                                            },
                                            {
                                                "example_id": "ecc6d757-0f72-48d8-951f-414595dc9418",
                                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                                "text": "These were business hours, and a feeling of loneliness crept over him, perhaps germinated by his sight of the illustrated papers, and accentuated by an attempted perusal of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa3507e-5277-3448-8ca6-ce636e8b0b7f",
                                        "entry_id": "268bec8e-d11b-35e5-a78e-382337500f51",
                                        "glosses": [
                                            "The act or process of perusing, or an instance of it.",
                                            "Giving something a cursory scan; a cursory scan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea89a318-3c25-4f79-8c38-92bdf74daa2f",
                        "source_entry_id": "273c37a6-484b-36d5-95ab-3b931e6c1378",
                        "source_sense_id": "1ca3d42d-4dad-3f8b-9454-72681a925707",
                        "target_lang_word": "visit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd626ff7-f66f-331f-9a76-93e3945575cc",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To habitually go to (someone in distress, sickness etc.) to comfort them. (Now generally merged into later senses, below.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd444e0a-7e18-311b-8cd4-a9dad35289c5",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To go and meet (a person) as an act of friendliness or sociability."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8615a3de-e8f7-4b99-aa70-39735167ae94",
                                                "sense_id": "dd444e0a-7e18-311b-8cd4-a9dad35289c5",
                                                "text": "She decided to visit her grandparents for Christmas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793a2e91-bdc1-3045-8b7a-c3cd5cab008e",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "Of God: to appear to (someone) to comfort, bless, or chastise or punish them. (Now generally merged into later senses, below.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eea4881-a7d2-4d8b-bdc8-c56a79550f27",
                                                "sense_id": "793a2e91-bdc1-3045-8b7a-c3cd5cab008e",
                                                "text": "[God] hath visited and redeemed his people."
                                            },
                                            {
                                                "example_id": "f9d2c9c4-d681-4fff-8bf0-cccdf5e35ec9",
                                                "sense_id": "793a2e91-bdc1-3045-8b7a-c3cd5cab008e",
                                                "text": "Then she arose with her daughters in law, that she might return from the country of Moab: for she had heard in the country of Moab how that the Lord had visited his people in giving them bread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dbd9da7-e0fb-363e-80d1-d8dbe01e2e5b",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To punish, to inflict harm upon (someone or something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1335d8e5-f72c-4076-8f40-31ec766b5fda",
                                                "sense_id": "8dbd9da7-e0fb-363e-80d1-d8dbe01e2e5b",
                                                "text": "Her life was spared by the clemency of the emperor, but he visited the pomp and treasures of her palace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e029ed4-d034-32b1-8fcb-046f8d595669",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "Of a sickness, misfortune etc.: to afflict (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40fe64c-e2bf-422a-8f78-9259ed8fc322",
                                                "sense_id": "9e029ed4-d034-32b1-8fcb-046f8d595669",
                                                "text": "There used to be a sharp contest as to where the effigy was to be made, for the people thought that the house from which it was carried forth would not be visited with death that year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c701b40b-05ac-312f-a21a-36ff7194e09d",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To inflict punishment, vengeance for (an offense) on or upon someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0fc5928-ab2c-461b-ab2f-d11fe84171f6",
                                                "sense_id": "c701b40b-05ac-312f-a21a-36ff7194e09d",
                                                "text": "05-032 was right about one thing: there is only one way to defeat the enemy, and that is to visit utter annihilation on it."
                                            },
                                            {
                                                "example_id": "893e7270-0a4b-4693-9a31-5f9e576845c6",
                                                "sense_id": "c701b40b-05ac-312f-a21a-36ff7194e09d",
                                                "text": "If this were an Ibsen play, we would be thinking of the sins of one generation being visited upon another, he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f5a332-a925-3d8a-aeff-61d8c7e4450c",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To go to (a shrine, temple etc.) for worship. (Now generally merged into later senses, below.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d96d232-087d-38f8-8a96-670cd0453fb4",
                                        "entry_id": "1af9cb34-3d87-35ad-8182-6e318301daba",
                                        "glosses": [
                                            "To go to (a place) for pleasure, on an errand, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4500375c-b47d-46b9-ae45-2d0d6c3edf74",
                                                "sense_id": "7d96d232-087d-38f8-8a96-670cd0453fb4",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            },
                                            {
                                                "example_id": "884d03e6-d74d-4047-a639-661528195fc0",
                                                "sense_id": "7d96d232-087d-38f8-8a96-670cd0453fb4",
                                                "text": "Each year, millions of people visit the 4,570-meter-high Baishui Glacier in southern China."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e9d575-705d-3952-9b8f-72920aedde06",
                                        "entry_id": "50540b3b-7662-3e56-8e4c-c1a29b524f1d",
                                        "glosses": [
                                            "A single act of visiting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7843b894-87fb-49ff-ae72-daec78a5432e",
                                                "sense_id": "b4e9d575-705d-3952-9b8f-72920aedde06",
                                                "text": "Next time you're in Manchester, give me a visit."
                                            },
                                            {
                                                "example_id": "203cd0f4-bbd0-47e2-bcbe-5888bd64a8e5",
                                                "sense_id": "b4e9d575-705d-3952-9b8f-72920aedde06",
                                                "text": "We paid a quick visit to James on the way up to Scotland."
                                            },
                                            {
                                                "example_id": "2ee66735-b86c-4748-977c-d710bbe2bf9c",
                                                "sense_id": "b4e9d575-705d-3952-9b8f-72920aedde06",
                                                "text": "There was some laughter, and Roddle was left free to expand his ideas on the periodic visits of cowboys to the town. “Mason Rickets, he had ten big punkins a-sittin' in front of his store, an' them fellers from the Upside-down-F ranch shot 'em up […].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42648d3b-ad38-3f51-86a1-9ab4faadffbc",
                                        "entry_id": "50540b3b-7662-3e56-8e4c-c1a29b524f1d",
                                        "glosses": [
                                            "A meeting with a doctor at their surgery or the doctor's at one's home."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b9ef0b1-8975-42f2-8193-1636f5c8d14c",
                        "source_entry_id": "273c37a6-484b-36d5-95ab-3b931e6c1378",
                        "source_sense_id": "1ca3d42d-4dad-3f8b-9454-72681a925707",
                        "target_lang_word": "lectura",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lectura",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "72464942-60c4-38f1-a5fb-9b8fe597c561",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Acción de leer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "999c3094-5039-40fc-96c2-ea1d9f58e7b8",
                                                "sense_id": "72464942-60c4-38f1-a5fb-9b8fe597c561",
                                                "text": "Mariano Rosas me exigió que repitiera la lectura de los artículos que estipulaban la entrega de yeguas, yerba, azúcar, tabaco, etc., diciéndome que quería que todos los indios se enterasen bien de la paz que se iba a hacer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4655ab8-13d7-3ba5-954c-9792f39eee05",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Aquello que ha sido o puede ser leído."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9103a795-0c1d-4ced-bc48-7cbed17d5997",
                                                "sense_id": "e4655ab8-13d7-3ba5-954c-9792f39eee05",
                                                "text": "O el trato de ciertas personas, o lecturas revolucionarias, o quizás desaires que no creía merecer, lleváronle al partido exaltado."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "75845721-1dbf-3cb1-be2d-9e83002a9bdd",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Explicación o elección del sentido dado a un texto, argumento o hecho."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d514afda-bb6e-4937-b582-40e9a87b646e",
                                                "sense_id": "75845721-1dbf-3cb1-be2d-9e83002a9bdd",
                                                "text": "Partiendo de una lectura abusiva y parcial del artículo 3 del Estatuto, que habla del catalán como «lengua propia de Cataluña» -afirmación de carácter general y no jurídico-, se quiere invalidar el principio jurídico que el mismo articulado define a renglón seguido al afirmar que el castellano es también lengua oficial de Cataluña."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3556e356-b425-33fb-a4c6-f4b4f281e9ec",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Exposición oral de un tema formal ante un tribunal por un aspirante a un título académico o cargo laboral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a307967f-b1f8-4b28-babd-382646a325d5",
                                                "sense_id": "3556e356-b425-33fb-a4c6-f4b4f281e9ec",
                                                "text": "Concluido el ensayo, entregará cada opositor su escrito al Secretario del Tribunal, y este al Presidente para la lectura en sesión pública, ."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c5daf86c-9380-3c20-9447-1e51cda7ae9a",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Proceso por el que se accede a una información de la memoria."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "376549d3-0e53-34d1-aefb-c5135680dc26",
                                        "entry_id": "32292d74-7cea-3052-82cf-d204c7235346",
                                        "glosses": [
                                            "Proceso de enseñanza y aprendizaje de las habilidades necesarias para ser capaz de leer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2cee4f-a70e-4dc1-aec7-e0ae471b2b22",
                                                "sense_id": "376549d3-0e53-34d1-aefb-c5135680dc26",
                                                "text": "Método de lectura en quince cuadros, por Bonifax , joven español residente en Montevideo, publiquélo en 1841 a mis expensas, para hacer conocer en el país, y fue adoptado en colegios y escuelas con buen éxito para la enseñanza primaria."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
