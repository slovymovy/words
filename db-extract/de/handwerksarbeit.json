                "senses": [
                    {
                        "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                        "entry_id": "aa99454e-273a-38a7-9577-fa5e1fba7861",
                        "glosses": [
                            "Tätigkeit, bei der man Gegenstände manuell herstellt und bearbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ced091f-447a-4a55-aa2b-bda46d95e082",
                                "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                                "text": "„Früher gab es in der Feld- und Handwerksarbeit immer schon viele sich ständig wiederholenden Tätigkeiten.“"
                            },
                            {
                                "example_id": "d56dbd73-908b-410a-93eb-149fb830f377",
                                "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                                "text": "„Ist das nicht mehr möglich, werden neue Bleche nach alten Plänen und in traditioneller Handwerksarbeit hergestellt.“"
                            },
                            {
                                "example_id": "34aee926-4f64-42f9-933f-2b53f8504751",
                                "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                                "text": "„Sie legen Wert auf präzise Ausführung der Handwerksarbeit und originalgetreue Schnitte.“"
                            },
                            {
                                "example_id": "840fadf9-ddd7-462b-9ece-605d9e31088f",
                                "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                                "text": "„Handwerksarbeit ist überwiegend Handarbeit, wenngleich die Anwendung von Kleinmaschinen zunimmt.“"
                            },
                            {
                                "example_id": "0d3c3de7-1c38-4380-bfa3-12cc9998cdfd",
                                "sense_id": "5e7b7fa7-1b2a-3cdc-9cf4-3f848c2b3565",
                                "text": "„Von der Sklavenarbeit zur Bauernarbeit, zur Handwerksarbeit bis zur industriellen Arbeit und Computerarbeit ist ein differenzierter historischer Weg zurückgelegt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
