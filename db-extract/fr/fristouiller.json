                        "entry_id": "6fb7aaba-8d69-3c95-8fee-7ae934cec727",
                        "glosses": [
                            "Préparer (des choses à manger, par exemple un repas pantagruélique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d899d8fb-b371-4280-a4a7-79c942887e34",
                                "sense_id": "b84afb19-e034-3d49-9df5-9a3ca8c01045",
                                "text": "Je me demande quel poison chinois ce cuisinier est encore en train de fristouiller…"
                            },
                            {
                                "example_id": "de48933a-1ade-4c8d-af62-5989e4029671",
                                "sense_id": "b84afb19-e034-3d49-9df5-9a3ca8c01045",
                                "text": "On y plume, on y tisonne, on y fristouille un festin d’enfer."
                            }
                        ]
