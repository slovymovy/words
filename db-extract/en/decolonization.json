                "entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
                "word": "decolonization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b6bc2f62-d4c4-42cf-9bb2-2f776e67924f",
                        "entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
                        "tags": [
                            "plural"
                        ],
                        "form": "decolonizations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d74b4e0-cb0f-31d9-96d2-85d8834f5246",
                        "entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
                        "glosses": [
                            "The freeing of a colony etc from dependent status by granting it independence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f647ffc0-7df0-3d48-8066-11411e3c668a",
                        "entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
                        "glosses": [
                            "The reverse of colonization, i.e. granting back autonomy to a group."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b2cb2685-237c-4696-9676-fa866e4efec3",
                                "sense_id": "f647ffc0-7df0-3d48-8066-11411e3c668a",
                                "text": "But what does decolonisation have to do with place names? Place names are the meeting points of history and geography that shape part of our identities."
                            }
                        ]
                    },
                    {
                        "sense_id": "a96182f7-609c-3b29-a182-ce595e41677f",
                        "entry_id": "aa1f1dd4-5712-3d32-9219-dbe7b867cbc2",
                        "glosses": [
                            "The elimination of a colony of pathogens from the body of a patient, especially antibiotic-resistant pathogens."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e685b47c-226f-46fa-8210-2c07a1d5e130",
