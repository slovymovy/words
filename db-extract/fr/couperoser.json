                        "glosses": [
                            "Donner de la couperose à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25afe821-06f9-415e-934e-cbd5d4220e3c",
                                "sense_id": "9dcd7739-130e-3979-8017-849d49bad76d",
                                "text": "Il m’a radicalement guérie de ces odieuses rougeurs qui me couperosaient le teint et me faisaient ressembler à une paysanne."
                            },
                            {
                                "example_id": "5c913149-b518-481b-b872-a5da12122870",
                                "sense_id": "9dcd7739-130e-3979-8017-849d49bad76d",
                                "text": "Mme de Senonches (Zéphirine) était grande et belle, mais couperosée déjà par une certaine ardeur de foie qui la faisait passer pour une femme exigeante."
                            }
                        ]
                    }
