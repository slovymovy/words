        "fr-extract.jsonl": [
            {
                "entry_id": "698294ca-e3cf-3be1-818d-75e2cc407abc",
                "word": "топырить",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f881076-20af-3fdf-86ac-ca3a0c518277",
                        "entry_id": "698294ca-e3cf-3be1-818d-75e2cc407abc",
                        "glosses": [
                            "Dresser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd9f9312-21c1-4898-b530-2b49a56c9477",
                                "sense_id": "6f881076-20af-3fdf-86ac-ca3a0c518277",
                                "text": "…он рассказал обо всем этом Кунте, сидя у себя на кухне и топыря к очажному огню свои огромные, искусанные пчелами руки.",
                                "translation": "il raconta tout cela à Kunta, assis dans sa cuisine et levant ses énormes mains piquées par les abeilles vers le feu de l'âtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dbf12df-c8fd-3aa0-8736-d861888c0815",
                        "entry_id": "698294ca-e3cf-3be1-818d-75e2cc407abc",
                        "glosses": [
                            "Pointer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8109408f-ad95-4296-915d-dd0f18a383b9",
                                "sense_id": "1dbf12df-c8fd-3aa0-8736-d861888c0815",
                                "text": "Мы смотрели тупо и невнятно, не могли произнести сряду несколько слов, чтобы не впасть в одышку, топырили губы и как-то нелепо шевелили ими, точно сбираясь сосать собственный язык.",
                                "translation": "Nous regardions d'un air vide et inarticulé, nous ne pouvions pas prononcer plusieurs mots d'affilée sans devenir essoufflés, nous faisions la moue et remuions nos lèvres d'une manière absurde, comme si nous étions sur le point de sucer notre propre langue."
                            }
                        ]
                    }
                ],
