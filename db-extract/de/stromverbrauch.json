                ],
                "senses": [
                    {
                        "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                        "entry_id": "9094f464-1b68-31ed-9d99-877a815d6277",
                        "glosses": [
                            "Verwendung von elektrischer Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f907e1-e3f7-4f4f-bd7c-0d26da0631c0",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "Wir werden mit einem hohen Stromverbrauch rechnen müssen, jetzt wo der Winter so kalt ist."
                            },
                            {
                                "example_id": "e629adbd-4116-4863-866a-103e92a618e3",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Ende Oktober ordneten die Amerikaner an, den Stromverbrauch um 30 Prozent zu drosseln.“"
                            },
                            {
                                "example_id": "b5419fab-559b-4dc6-aaf2-c250a27faa4b",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Nach Angaben der Bundesnetzagentur hat der Stromverbrauch in Deutschland 2022 leicht abgenommen, insgesamt um 4,0 Prozent auf 484,2 Terrawattstunden.“"
                            },
                            {
                                "example_id": "6deb1b0c-8806-4741-a7b1-f92a6f74f296",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "Die Spitzenzeiten des Stromverbrauchs liegen am Morgen und am frühen Abend."
                            },
                            {
                                "example_id": "e8391f6a-d21d-4e0f-bcf9-bbda90912d5d",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "[Die Straßenbeleuchtung ist] „für mehr als 40 Prozent des Stromverbrauchs der französischen Gemeinden verantwortlich.“"
                            },
                            {
                                "example_id": "9c13b61d-ebad-4603-9815-dbfceadcc41f",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Das EWZ, der Stromversorger der Stadt Zürich, misst den Stromverbrauch in der Stadt tagesaktuell.“"
                            },
                            {
                                "example_id": "921f5238-f5b8-4911-a0a1-02f1c5fd202e",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Aktuell meldet der Stromnetzbetreiber Swissgrid den Stromverbrauch der Schweiz nur monatlich und mit Verzögerung.“"
                            },
                            {
                                "example_id": "50a44064-e0df-4f5a-821e-225541f32308",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Der höhere Stromverbrauch vieler Privathaushalte hat mit Corona zu tun.“"
                            },
                            {
                                "example_id": "fd4cd2c8-b6e7-4026-84d6-f6e2d07c0ed1",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Gesamtschweizerisch ist der Stromverbrauch leicht zurückgegangen.“"
                            },
                            {
                                "example_id": "5f44d23a-fe1b-4b61-9adc-e2a58e3be5fd",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Die etwa 50.000 Rechenzentren, die es in Deutschland gibt, haben im Jahr 2018 ungefähr 14 Terawattstunden Strom verbraucht. Das entspricht dem jährlichen Stromverbrauch der Stadt Berlin.“"
                            },
                            {
                                "example_id": "a844c022-9059-4d5f-b07f-9a4b11a9ec80",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "[Spanien:] „Seit Lampen im öffentlichen Raum nicht mehr ununterbrochen strahlen und Grenzwerte für Klimaanlagen gelten, sinkt der Stromverbrauch.“"
                            },
                            {
                                "example_id": "60cd0c05-1c3f-470d-8182-70624c7b310f",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Grundlage für die angegebenen Preise ist ein Musterhaushalt mit einem Stromverbrauch von 4.000 Kilowattstunden (kWh) pro Jahr.“"
                            },
                            {
                                "example_id": "0fb9dfb8-9584-4999-8b9c-19ca9e6c2351",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„Dagegen landeten zwei Labore aus den Life Sciences bei vier Tonnen CO₂-Äquivalente. Aber auch hier waren Flugreisen und Stromverbrauch die zentralen Verursacher.“"
                            },
                            {
                                "example_id": "1a366cbe-f3f2-4de4-9e20-5d8257e81d9f",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "„In Deutschland gibt es mittlerweile knapp zwei Millionen Photovoltaikanlagen. […] Ein Großteil der Anlagen ist auf Dächern installiert und deckt damit, zumindest in Teilen, den Stromverbrauch der Hausbewohner.“"
                            },
                            {
                                "example_id": "4de957f8-8c78-4485-bfb7-bae7ba39a8e0",
                                "sense_id": "63afa86a-1c4b-3921-9283-f22db116c21f",
                                "text": "[In Deutschland] „soll im Jahr 2030 80 Prozent des Stromverbrauchs aus erneuerbaren Quellen gedeckt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                        "entry_id": "9094f464-1b68-31ed-9d99-877a815d6277",
                        "glosses": [
                            "Angabe über den Bedarf eines elektrischen Geräts an Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea290398-02a6-4e65-b8cf-8ec8200b7eac",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "Dieses Gerät hat einen sehr hohen Stromverbrauch."
                            },
                            {
                                "example_id": "354cf797-b6b6-49c2-b9eb-0dbacb248e6c",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "[Die Wohngemeinschaft führte] „eine lebhafte Diskussion darüber, wessen Computer denn den höchsten Stromverbrauch verursacht“ […]."
                            },
                            {
                                "example_id": "64643946-c7a7-42b3-a74a-7b065846497d",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "„In den vergangenen 30 Jahren hat sich der Wasser- und Stromverbrauch von Geschirrspülmaschinen deutlich verringert.“"
                            },
                            {
                                "example_id": "5aeb9a76-95bb-44bc-948f-80bd2f391714",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "„Der Stromverbrauch pro Spülvorgang ist auf weniger als die Hälfte gesunken, der Wasserverbrauch von etwa 50 Litern auf weniger als 15 Liter.“"
                            },
                            {
                                "example_id": "ff5f3a27-2d91-433f-9a4f-02659e5b8c16",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "„Sie sparen Strom mit sauberen Geräten. Beispielsweise steigt der Stromverbrauch im Eisfach pro fünf Millimeter Eis um 30 Prozent.“"
                            },
                            {
                                "example_id": "913c1f54-d31c-4ab4-a21c-19548c61ee8e",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "„Generell haben ältere Backrohre einen deutlich höheren Stromverbrauch. Für häufiges Backen oder Braten ist ein A+++ Gerät, wegen der höchsten Energieeffizienz, die beste Wahl.“"
                            },
                            {
                                "example_id": "7d02979a-186f-43fc-a9cb-a0cee09dba3b",
                                "sense_id": "9e7b7bd5-482a-389c-884b-aa41a7e78238",
                                "text": "„Grundsätzlich können handelsübliche Wärmepumpen Heiztemperaturen von über 70 Grad erzeugen und damit auch ungedämmte Häuser mit alten Heizköpern heizen. Doch der Stromverbrauch für den Antrieb ist dann deutlich höher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
