                            }
                        ]
                    },
                    {
                        "translation_id": "bb85f7de-8dff-4ba3-94c2-d4da64ce14e5",
                        "source_entry_id": "f5edaef0-ab9a-35a0-b514-6eaf3aefc863",
                        "source_sense_id": "34c1b2e6-2bf2-32c1-ab4d-e8f3745f663a",
                        "target_lang_word": "Seljukian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seljukian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                                        "entry_id": "adc844d2-5fd0-3c76-b566-1ac4b22c5a23",
                                        "glosses": [
                                            "Synonym of Seljuk, of or related to Seljuk, his dynasty, their empire, or their period of rule."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd890465-428e-4926-80fa-3c97848f57e4",
                                                "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                                                "text": "Romanus at once took the field against the Seljukian hordes, who were now devastating Cappadocia with fiendish cruelty, and had just captured Caesarea and plundered the shrine of St. Basil."
                                            },
                                            {
                                                "example_id": "8cd4d8e0-1714-4f17-b6d7-4bbeee8e652b",
                                                "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                                                "text": "This was the time when the Seljukian Empire in West Asia was dissolved by Mongol invasions, thus causing the out-migration of Seljukian artisans and craftsmen, many of whom found refuge in India under the Khiljis..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Seljukian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "860c47d2-41eb-32fa-8ce5-e013a52ab4cb",
                                        "entry_id": "949af4d9-eb6a-307f-b497-a162918245a5",
                                        "glosses": [
                                            "Synonym of Seljuk, a member of the Seljuk dynasty or person of their empire."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28c71f6d-8d5f-4892-b2f7-800961346523",
                                                "sense_id": "860c47d2-41eb-32fa-8ce5-e013a52ab4cb",
                                                "text": "Zingis came down upon the Seljukians, and Timour came down upon the Ottomans."
                                            },
                                            {
                                                "example_id": "57843d47-80a7-4047-abca-4d6fbcd2c03b",
                                                "sense_id": "860c47d2-41eb-32fa-8ce5-e013a52ab4cb",
                                                "text": "Living a nomadic life under the leadership of Suleyman Shah, Kai tribe was involved in many battled with Mongol on one hand and Turkmens on the other hand, and at the same time, it had disagreements with Seljukians and suffered famine, drought, and diseases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
