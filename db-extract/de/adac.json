                        "sense_id": "11fc2ca3-5c76-3e2f-956f-91c8b30413e2",
                        "entry_id": "6084c534-a6a7-3b80-9194-89c70b50ec19",
                        "glosses": [
                            "Automobile club général d'Allemagne, , association automobile de l'Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d13e835f-686a-44f9-81a6-9b3382a86b7c",
                                "sense_id": "11fc2ca3-5c76-3e2f-956f-91c8b30413e2",
                                "text": "Stauprognosen kriegen Sie beim ADAC.",
                                "translation": "Vous obtiendrez des prévisions sur embouteillages auprès de l'ADAC."
                            },
                            {
                                "example_id": "2f9b1c91-6e37-492d-8af3-04673e1e11e5",
                                "sense_id": "11fc2ca3-5c76-3e2f-956f-91c8b30413e2",
                                "text": "Der ADAC empfiehlt Autofahrerinnen und Autofahrern, lieber abends statt morgens zu tanken. Am günstigsten ist Kraftstoff demnach in der Regel zwischen 18 und 19 Uhr sowie zwischen 21 und 22 Uhr.",
                                "translation": "L'ADAC recommande aux automobilistes de faire le plein le soir plutôt que le matin. Le carburant est généralement le moins cher entre 18 et 19 heures et entre 21 et 22 heures."
                            }
                        ]
                    }
