                                "target_senses": [
                                    {
                                        "sense_id": "875175c3-1bb8-3283-88c8-41e849bd67dd",
                                        "entry_id": "be25a219-805e-3a6e-a414-2f2c246391e9",
                                        "glosses": [
                                            "Action de freiner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a37159a-c621-42e6-b368-5223da15f7b1",
                                                "sense_id": "875175c3-1bb8-3283-88c8-41e849bd67dd",
                                                "text": "Un freinage un peu brusque."
                                            },
                                            {
                                                "example_id": "b92214d4-c476-4d9e-89ee-b0d773ba4f26",
                                                "sense_id": "875175c3-1bb8-3283-88c8-41e849bd67dd",
                                                "text": "Il se rétablit par un autre soubresaut et déclenche le freinage d’urgence, en appuyant violemment sur un champignon rouge."
                                            },
                                            {
                                                "example_id": "9825c036-372d-4e2e-8567-a68df6aa10fe",
                                                "sense_id": "875175c3-1bb8-3283-88c8-41e849bd67dd",
                                                "text": "Durant le travail de démontage d'un arbre, tout élagueur devrait notamment gérer les risques liés à la chute des branches et morceaux de tronc qu'il coupe : un système de cordes et poulies retenues par un cylindre de freinage permet de réaliser ce travail avec un niveau de sécurité élevé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
