                "senses": [
                    {
                        "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                        "entry_id": "17e0e6aa-1d07-3424-a18a-7066ee85da87",
                        "glosses": [
                            "Frau mit übernatürlichen Kräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e05c59-4281-420e-b4fa-0e6141726d43",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„Eine kubanische Hexerin prophezeit der Autorin, die unter Liebeskummer leidet, dass die «Afrikanische Königin» ihr helfen wird, das «Glück zu finden».“"
                            },
                            {
                                "example_id": "fabf49b1-c910-434b-8011-a58706faa408",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„‚Wenn die Spieler schreien oder doof stehen, dann geht’s nicht‘, zwitscherte sie jüngst. ‚Bin auch keine Hexerin.‘“"
                            },
                            {
                                "example_id": "6e8aa6a8-b698-441d-aeaa-4b49b5a3a7da",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„Auch wenn er durch seine Großmutter, einer vermeintlichen ‚Hexerin‘, bedroht werden sollte, besteht diesbezüglich eine Schutzfähigkeit und –willigkeit des Herkunftsstaates bzw. stünde es ihm frei, sich in einem anderen Landesteil niederzulassen.“"
                            },
                            {
                                "example_id": "f523df77-a7c9-43e6-bc49-6659185da963",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„Eine Dunkle Laterne und ’ne Erpresserin und ’ne Heck … Hexerin – das war sie.“"
                            },
                            {
                                "example_id": "45547fa4-b618-4531-bc25-2b6a5ba61cb7",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„Stephanie schrie, als die Hexerin sie hochhob und auf den Boden schleuderte.“"
                            },
                            {
                                "example_id": "46a6621b-fdc5-4418-bfdb-622f584f6319",
                                "sense_id": "f54a8814-e2da-3b3e-b03f-33230850d235",
                                "text": "„Sieht man oft Hexerinnen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
