        "fr-extract.jsonl": [
            {
                "entry_id": "87399a75-98ef-3d6e-a761-ada6614463f5",
                "word": "valoche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0db625e5-2c95-4eb8-a532-0e45f64de4a2",
                        "entry_id": "87399a75-98ef-3d6e-a761-ada6614463f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "valoches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df0fff58-f1f6-3db3-bb3c-43c441141725",
                        "entry_id": "87399a75-98ef-3d6e-a761-ada6614463f5",
                        "glosses": [
                            "Valise."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "be3960b4-85cb-4a21-8c84-d235e6a9f82d",
                                "sense_id": "df0fff58-f1f6-3db3-bb3c-43c441141725",
                                "text": "La porte de la cuisine, qui donnait sur l'escalier de service, je l’ai calée avec la valoche."
                            },
                            {
                                "example_id": "31bb3d31-5dab-4f73-b212-514884a01f57",
                                "sense_id": "df0fff58-f1f6-3db3-bb3c-43c441141725",
                                "text": "Gabriel stoppe également, se retourne, pose la valoche et se met à espliquer^([sic])."
                            },
                            {
                                "example_id": "04c8cd35-a823-491f-aeac-6aca335d21bb",
                                "sense_id": "df0fff58-f1f6-3db3-bb3c-43c441141725",
                                "text": "Elle me regardait avec une muette imploration de chien, serrant la poignée de sa petite valoche avec résolution, le front obstiné sous ses cheveux noisette, si désireuse de bien faire, et on la sentait vraiment décidée à venir à bout de tous les obstacles."
                            },
                            {
                                "example_id": "9fa1c79b-21a0-4207-82ac-394e7c309671",
                                "sense_id": "df0fff58-f1f6-3db3-bb3c-43c441141725",
                                "text": "J’ai pris ma valoche en haut du placard pour la faire chuter sur le lit défait. J’ai enfourné mes affaires, pêle-mêle. D’une main, j’ai empoigné la poignée de ma valoche et de l’autre le bouton de porte."
                            }
                        ]
                    },
                    {
                        "sense_id": "33ae5ab3-1d9c-31a6-97ea-c8f4a9824943",
                        "entry_id": "87399a75-98ef-3d6e-a761-ada6614463f5",
                        "glosses": [
                            "Quelqu’une des poches qui se forment sous les yeux par suite de fatigue."
                        ],
                        "tags": [
                            "familiar",
                            "plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dc717a96-5209-4c04-bb09-65141bace340",
                                "sense_id": "33ae5ab3-1d9c-31a6-97ea-c8f4a9824943",
                                "text": "Faut voir ces messieurs ! Leur barbe a poussé, ils sont un tantinet plus sales que la veille, et ils ont sous les yeux des valoches de représentants en édredons !"
                            },
                            {
                                "example_id": "ef5ac0cf-0e53-4ca1-87c5-ae127ff5bded",
                                "sense_id": "33ae5ab3-1d9c-31a6-97ea-c8f4a9824943",
                                "text": "Mon ami Serge ressemblait à Arno, le chanteur belge, le cheveu en pétard, des valoches sous les yeux, des yeux de chien battu, mais bien nourri quand même."
                            }
                        ]
                    }
                ],
