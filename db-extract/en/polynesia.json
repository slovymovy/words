                    {
                        "translation_id": "dda124d5-eaeb-40d9-96e8-6c565f2ff36c",
                        "source_entry_id": "9c497011-d4c7-393f-ae17-cc0480e48b12",
                        "source_sense_id": "084c5ce6-8340-316f-98e3-0204fb69cbe3",
                        "source_sense_description": "part of Oceania",
                        "target_lang_word": "Polynésie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polynésie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5867aefe-dcc3-3430-9767-de5e21648905",
                                        "entry_id": "2b9356b5-5ca9-3b67-abc5-eff8ac65b102",
                                        "glosses": [
                                            "L’une des trois régions de l’Océanie, large groupement d’îles situées dans le centre et le sud de l’océan Pacifique."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508fc988-9460-44ee-b016-60b9057d76bb",
                                                "sense_id": "5867aefe-dcc3-3430-9767-de5e21648905",
                                                "text": "L'homme primitif, […], ne savait mettre en usage que des os, des cailloux, des débris de silex, et c'est avec ces matériaux qu'il fabriquait ses armes grossières et ses rares ustensiles, ainsi que le font encore quelques peuplades sauvages de la Polynésie."
                                            },
                                            {
                                                "example_id": "5a301271-b553-476d-a73d-4ddc08e19343",
                                                "sense_id": "5867aefe-dcc3-3430-9767-de5e21648905",
                                                "text": "Il allait en Polynésie, à Tahiti, juste au bout du monde, de l’autre côté de la terre, et son voyage devait durer quatre ans, ce qui représentait près de la moitié de ma propre vie, autant dire une durée presque sans fin…"
                                            },
                                            {
                                                "example_id": "010a0a66-28d2-4940-934d-9b7d9d1545d9",
                                                "sense_id": "5867aefe-dcc3-3430-9767-de5e21648905",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad44a6d5-db1f-4b47-ba6d-2769d0254ba5",
                        "source_entry_id": "9c497011-d4c7-393f-ae17-cc0480e48b12",
                        "source_sense_id": "084c5ce6-8340-316f-98e3-0204fb69cbe3",
                        "source_sense_description": "part of Oceania",
                        "target_lang_word": "Polynesien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polynesien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                        "entry_id": "b5f963c6-4bc4-3965-9c76-b0543976d54d",
                                        "glosses": [
                                            "eine Reihe von Inselgruppen im Pazifik, die sich in einem annähernden Dreieck von Neuseeland im äußersten Südwesten Richtung Nordosten bis nach Hawaii und der Osterinsel im Osten erstrecken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe750ecc-0976-4d07-b5a6-eca568753f17",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "Das Palmerston-Atoll liegt in Polynesien."
                                            },
                                            {
                                                "example_id": "af3cb0f7-d7f4-48c5-adaf-a6fbd9cf59ad",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Tokelau, Teil der Inselwelt Polynesiens, gilt als eines der abgelegensten Länder der Welt.“"
                                            },
                                            {
                                                "example_id": "9d6a74fd-ab75-4b50-a5e0-636170de4ac7",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Der Norweger Thor Heyerdahl überquerte mit einem Floß von Südamerika aus den Pazifik. Nach drei Monaten landete er in Polynesien - wie angeblich vor ihm schon die Inka.“"
                                            },
                                            {
                                                "example_id": "2c6d8a82-509c-4b04-ba31-23bc521435e4",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Der Brotfruchtbaum stammt aus den richtigen Tropen, dort wo es ganzjährig warm und feucht ist. Seine Heimat ist Polynesien, dort wird er auch sehr gern als Park- und Schattenbaum angebaut, weil er eine wunderbar ausladende Krone hat und vor allem auch wunderschöne Blätter.“"
                                            },
                                            {
                                                "example_id": "9d5703c2-7cee-4280-b4ff-75d8d23a2790",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Auf den kleinen Tropeninseln Mikronesiens gab es schließlich 2007 den ersten größeren Zika-Ausbruch mit etwa 100 Infizierten. 2013 brach die Krankheit in Polynesien aus - hier wurden knapp 9000 Fälle gemeldet.“"
                                            },
                                            {
                                                "example_id": "bd32fde5-1a39-40f1-86fd-130734bc0894",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Zwischen 1960 und 1996 führte Frankreich insgesamt 210 Nuklearversuche durch, anfangs in der damaligen Kolonie Algerien, dann im Übersee-Departement Polynesien.“"
                                            },
                                            {
                                                "example_id": "b9dc7991-a3df-4c22-ae0a-c22cba633b70",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Am 2. Juli 1966 führte Frankreich den ersten Atomtest im Pazifik durch – in seinem Übersee-Département Polynesien. In den Atolls von Mururoa und Fangataufa fanden in den folgenden 30 Jahren insgesamt 193 weitere Tests statt.“"
                                            },
                                            {
                                                "example_id": "088e7458-b382-4c7b-99f6-551985c2a84f",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Der Maler Paul Gauguin wird Frankreich und das bürgerliche Leben, das er so verachtet, aber auch seine Familie – er hat Frau und fünf Kinder – hinter sich lassen und nach Polynesien reisen.“"
                                            },
                                            {
                                                "example_id": "80ff9365-c836-4cd2-8c30-2d54757bacdc",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„[…] Hawaiianer, wie Eddie, wussten, dass ihre Vorfahren in ganz Polynesien herumgesegelt waren und dass sie die ursprünglichen Siedler in Hawaii gewesen waren.“"
                                            },
                                            {
                                                "example_id": "1b142b0d-2bdf-41f1-8b66-729427bc4a6b",
                                                "sense_id": "c75c3aed-fc3d-3e3c-a199-b789ecc2cea6",
                                                "text": "„Erste Belege für Tätowierungen finden sich in Afrika, Polynesien und Asien aus der Zeit von ungefähr 500 vor Christus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
