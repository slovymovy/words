                                        "entry_id": "44681338-d3e0-3452-a235-72af0a3fc7b3",
                                        "glosses": [
                                            "Bâtiment où on entrepose à l’abri des intempéries les véhicules de transport terrestres, maritimes ou aériens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244378a9-7562-4471-8e1c-801d70640db7",
                                                "sense_id": "65e4d9f4-6844-3040-b6ad-69f467482347",
                                                "text": "La place Kléber, du matin au soir, n’est plus qu’un garage ouvert où se parquent des centaines d’automobiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fc7a98-8060-3740-9ea3-3b27bdbfa824",
                                        "entry_id": "44681338-d3e0-3452-a235-72af0a3fc7b3",
                                        "glosses": [
                                            "Action de mettre des wagons à l’abri ou en réserve sur une partie de la voie ferrée disposée à cet effet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1717d46d-4248-4c89-bc3f-3c049c247afa",
                                                "sense_id": "27fc7a98-8060-3740-9ea3-3b27bdbfa824",
                                                "text": "Garage du train sur sa voie de garage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f5efb67-3a42-3382-9525-379b08f3e628",
                                        "entry_id": "44681338-d3e0-3452-a235-72af0a3fc7b3",
                                        "glosses": [
                                            "Action de mettre à l'abri tout type de véhicule de transport."
