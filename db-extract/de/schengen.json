                                "example_id": "294c0442-7476-4652-9ee7-247e8c2a33f5",
                                "sense_id": "7308e438-4b7f-3cf1-920f-2d56c867b7ee",
                                "text": "Schengen liegt in Luxemburgs Süden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af79df54-b05e-4040-afc0-cb2a3dbbf4e7",
                        "source_entry_id": "308f261b-8f3e-3d35-bb54-4096564b5a9c",
                        "source_sense_id": "7308e438-4b7f-3cf1-920f-2d56c867b7ee",
                        "source_sense_description": "eine Gemeinde in Luxemburg",
                        "target_lang_word": "Schengen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schengen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "061812f6-d754-3fc7-96ef-a5f4e061a2ee",
                                        "entry_id": "083589df-24d3-3ac7-899b-4755d0d7936d",
                                        "glosses": [
                                            "A town in southeastern Luxembourg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77a948e8-3bd9-3ff5-be0e-d307266d226e",
                                        "entry_id": "083589df-24d3-3ac7-899b-4755d0d7936d",
                                        "glosses": [
                                            "The Schengen Agreement: a treaty between countries in continental Europe abolishing mutual border controls and standardizing visa policy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71af599c-d972-49cc-909d-c4127dbb9b7f",
                                                "sense_id": "77a948e8-3bd9-3ff5-be0e-d307266d226e",
                                                "text": "As is the case for the other Member States participating in Schengen, Greece issues, on the one hand, Schengen uniform visas, and on the other, national long-stay visas for stays exceeding three months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37e6239-c2ce-31e5-a797-220e2236b967",
                                        "entry_id": "083589df-24d3-3ac7-899b-4755d0d7936d",
                                        "glosses": [
                                            "The Schengen Area; the area over which the Schengen Agreement applies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612e8c5c-5d95-45fa-bd9f-f7e81dbd4856",
                                                "sense_id": "a37e6239-c2ce-31e5-a797-220e2236b967",
                                                "text": "One of the requirements in Schengen, quite practically, is that you have configure airports so that you can separate out your air travellers from those who are travelling within Schengen and those who are not."
                                            },
                                            {
                                                "example_id": "e9873235-ceb5-499f-9795-ad8d234f0c2a",
                                                "sense_id": "a37e6239-c2ce-31e5-a797-220e2236b967",
                                                "text": "Risk indicators avoid the need for checks of police databases for all persons entering Schengen"
                                            },
                                            {
                                                "example_id": "bc3ceec9-5290-48a5-b7e5-fbd0a345e54c",
                                                "sense_id": "a37e6239-c2ce-31e5-a797-220e2236b967",
                                                "text": "The Elysée said it was not aware of Abu-Sitta’s being refused entry to France but a spokesperson told Le Monde: “When it’s a question of a Schengen refuse, the border police can’t do much about it.”"
                                            },
                                            {
                                                "example_id": "9eda4b64-ba55-4d82-abdc-ca978e3e782c",
                                                "sense_id": "a37e6239-c2ce-31e5-a797-220e2236b967",
                                                "text": "The Cameroonian’s case is unique as many Africans denied Schengen visas rarely appeal or contest the decisions in court."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
