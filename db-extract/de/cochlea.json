                "senses": [
                    {
                        "sense_id": "0641297a-b99c-33c7-9f7f-08cdac6fe602",
                        "entry_id": "591e33fa-00fd-319e-a09f-271c0c666ca2",
                        "glosses": [
                            "schneckenförmiger Abschnitt des Innenohrs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9284926-a77c-4421-bee8-b9ac0f09269d",
                                "sense_id": "0641297a-b99c-33c7-9f7f-08cdac6fe602",
                                "text": "„Sie werden mechanisch über die Gehörknöchelchen des Mittelohrs auf die Schnecke (Cochlea) im Innenohr übertragen.“"
                            },
                            {
                                "example_id": "9f565d82-2890-49dc-af39-ec32addcbc3b",
                                "sense_id": "0641297a-b99c-33c7-9f7f-08cdac6fe602",
                                "text": "„Indem es Schall in elektrische Impulse umwandelt und diese dann über Elektroden in der Cochlea weiterleitet, stimuliert das CI [Cochlea-Implantat] direkt den Hörnerv, statt wie herkömmliche Hörgeräte den Schall zu verstärken und ins Ohr zu leiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
