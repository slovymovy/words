                                        "sense_id": "8684f8d2-4b8c-3507-ae99-3d73bb057d26",
                                        "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                                        "glosses": [
                                            "A vicious female monster from Greek mythology with sharp fangs and hair of living, venomous snakes. One of the three sisters: Medusa, Stheno and Euryale"
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                                        "entry_id": "7ea44963-98b7-3c82-a868-1225dc0473bf",
                                        "glosses": [
                                            "An intimidating, ugly, or disgusting woman; anything hideous or horrid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0009738-978c-4087-8f39-df384ef645a6",
                                                "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                                                "text": "I'll shrowd this Gorgon from all humane view."
                                            },
                                            {
                                                "example_id": "4bfc769e-e1d5-4d3f-9377-ec26cac2e708",
                                                "sense_id": "b7bde9c6-cbce-31db-b08a-06ae976e3054",
                                                "text": "Swilling martinis and spewing venom, Phyllis is a particularly unappetizing gorgon, telling us at one point that an acquaintance of hers is aroused by the Heimlich maneuver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gorgon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d580f69-a5fd-3d38-8061-c6e7bcabfc8f",
                                        "entry_id": "3e22b41e-428e-385b-8e46-9febe9ff20e9",
                                        "glosses": [
                                            "Like a gorgon; very ugly or terrifying."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
