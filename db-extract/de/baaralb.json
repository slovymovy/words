                ],
                "senses": [
                    {
                        "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                        "entry_id": "c5c4f3ea-c7f0-3654-9031-d303bb0ac3aa",
                        "glosses": [
                            "Hügelland im westlichsten Teil der Schwäbischen Alb in Baden-Württemberg, Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "3d49c4b9-56d4-44ca-919b-485c0858087b",
                                "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                                "text": "„Das Vogelschutzgebiet umfasst die Wutachschlucht mit ihrem Reichtum an Tier- und Pflanzenarten, die angrenzende Hochfläche der Baar sowie Teile der namensgebenden Baaralb.“"
                            },
                            {
                                "example_id": "2dd06edd-f73d-4c34-8907-5213e1d6fcc5",
                                "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                                "text": "„Seit zehn Jahren werden Teile der Baar und der Baaralb aufgrund ihrer gesamtstaatlichen Bedeutung für den Naturschutz vom das Bundesamt für Naturschutz mit Mitteln des Bundesumweltministeriums gefördert, zudem fließt Geld vom Land Baden-Württemberg.“"
                            },
                            {
                                "example_id": "8c8bc795-99df-405c-9722-f35595bfa0fd",
                                "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                                "text": "„Es liegt in den Naturräumen „Hohe Schwabenalb“, „Baaralb“ und „Oberes Donautal“ und betrifft die Landkreise Sigmaringen und Zollernalb.“"
                            },
                            {
                                "example_id": "4528bd80-ede0-44b4-a592-7df17523eb72",
                                "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                                "text": "„Der Panoramaweg bietet großartige Blicke auf Aasen, die Baaralb, den Randen, die Alpen, den Schwarzwald mit dem Feldberg, nur wenige Schritte weiter über die Ostbaar, die Länge, den Wartenberg, Osterberg und Himmelberg.“"
                            },
                            {
                                "example_id": "78a25d9d-75ef-4295-92d2-f3cd581c434f",
                                "sense_id": "195cc936-aaee-3039-95d0-f8284677c3f3",
                                "text": "„Allesamt gelegen zwischen der Baaralb im Westen, der Zollernalb im Norden, dem Donautal im Süden und der Ulmer Alb im Osten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
