                    {
                        "form_id": "23eb7189-12af-4c01-ab2a-4228a018430b",
                        "entry_id": "f793d7b6-2aae-394f-b8b7-f854084872e2",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Keuschheit"
                    },
                    {
                        "form_id": "9d319d7b-8f74-4aed-984d-7189d23b941d",
                        "entry_id": "f793d7b6-2aae-394f-b8b7-f854084872e2",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Keuschheit"
                    },
                    {
                        "form_id": "0d8981be-567e-45df-96e4-1e69d8a88fa6",
                        "entry_id": "f793d7b6-2aae-394f-b8b7-f854084872e2",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Keuschheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                        "entry_id": "f793d7b6-2aae-394f-b8b7-f854084872e2",
                        "glosses": [
                            "bewusster Verzicht auf sexuelle Aktivität aus moralischen oder religiösen Gründen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640508a0-87fc-44e2-b134-98e3fbdfe434",
                                "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                                "text": "Bei der Aufnahme in einen Orden geloben Mönche und Nonnen Gehorsam, Armut und Keuschheit."
                            },
                            {
                                "example_id": "14421b0b-708e-45d4-b331-b525ca8c2cf6",
                                "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                                "text": "„Die einzige Ausnahme scheint der Gouverneur selbst gewesen zu sein - doch das mag an Lücken in den Aufzeichnungen liegen, nicht daran, dass man im Gouverneurspalast der Keuschheit frönte.“"
                            },
                            {
                                "example_id": "05dba6a8-5e94-4429-8545-8f0e8cdd99fd",
                                "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                                "text": "„Solomon versichert dem Mönch, dass er die letzten Tage mit uns verbracht habe und zumindest für diesen Zeitraum für unsere Keuschheit garantieren könne.“"
                            },
                            {
                                "example_id": "bc7b7edb-ba49-4e72-9806-c91973281929",
                                "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                                "text": "„Sie kann auf Keuschheit oder auf Scham oder auf einer Mischung von beiden beruhen.“"
                            },
                            {
                                "example_id": "9e0163cb-a666-422a-86bc-24e7d7680d9a",
                                "sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
                                "text": "„Die Religion verlangte Keuschheit – ein Wort, das schon als solches zu gegenteiligen Gedanken und Phantasien verführte: wer keusch sein soll, muß wissen, was unkeusch ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93283e1f-7c4f-48d0-a61e-655eba84be4c",
                        "source_entry_id": "f793d7b6-2aae-394f-b8b7-f854084872e2",
                        "source_sense_id": "d24d3cb7-6e81-335f-9d3b-6e17bcafd5fb",
