                ],
                "senses": [
                    {
                        "sense_id": "dfe5a1ee-7a2e-36d7-afd0-01c072d62ee5",
                        "entry_id": "70664e5e-f4db-3dd2-83d5-a40cb1ebe5af",
                        "glosses": [
                            "die Sprache, die in der Dichtung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e293b87-e0ff-46bf-93f0-a3806fb7f21e",
                                "sense_id": "dfe5a1ee-7a2e-36d7-afd0-01c072d62ee5",
                                "text": "„Die Dichter geistlicher Inhalte bemühen sich auch in der klassischen Zeit nicht um die mittelhochdeutsche Dichtersprache, sondern ziehen regionale Sprachformen vor.“"
                            },
                            {
                                "example_id": "8be668bf-4bac-4baa-ade2-8daf7f5c35da",
                                "sense_id": "dfe5a1ee-7a2e-36d7-afd0-01c072d62ee5",
                                "text": "„Unter den Schöpfern der neuen Dichtersprache, dazu aber auch der wissenschaftlichen, kritischen Prosa ist auch LESSING zu nennen.“"
                            },
                            {
                                "example_id": "2c939811-4425-41c8-9b99-91f93e5299de",
                                "sense_id": "dfe5a1ee-7a2e-36d7-afd0-01c072d62ee5",
                                "text": "„Die barocke Dichtersprache bricht gegen das Ende des 17. Jahrhunderts ab.“"
                            },
                            {
                                "example_id": "c27e3791-8081-46ae-baa5-0ad0a1ae3aa8",
                                "sense_id": "dfe5a1ee-7a2e-36d7-afd0-01c072d62ee5",
                                "text": "„Dennoch ist die Sprache von Michael Gordon schon eine recht ordentliche Vorstufe für die spätere echte Dichtersprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
