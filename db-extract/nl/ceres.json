                    },
                    {
                        "translation_id": "6e6cf55f-e120-4be4-87c6-27b063dc999b",
                        "source_entry_id": "e0685303-6e68-3dfa-a199-cbbe19c32696",
                        "source_sense_id": "d59758c6-2057-375e-81c9-8eb4e78c86a1",
                        "target_lang_word": "Cérès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cérès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0059bb43-64e8-3d1f-978a-01e2fa88e9dc",
                                        "entry_id": "63252513-76b6-349d-948b-64f181113b6b",
                                        "glosses": [
                                            "Déesse romaine de l’agriculture, des moissons et de la fécondité ; fille de Saturne."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d15f6714-3bfb-4460-bdc5-12b8313ca7cc",
                                                "sense_id": "0059bb43-64e8-3d1f-978a-01e2fa88e9dc",
                                                "text": "On ouvrit la séance par un sacrifice à Cérès. Des prêtres immolèrent un jeune cochon, et de son sang purifièrent l’enceinte."
                                            },
                                            {
                                                "example_id": "6a9bc8f5-2ee2-4452-b7c8-6d65b981d33f",
                                                "sense_id": "0059bb43-64e8-3d1f-978a-01e2fa88e9dc",
                                                "text": "J’aurai l’impression de rendre hommage à Cérès, déesse de la fécondité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dccdcff-8d08-333f-adaa-561162302cda",
                                        "entry_id": "63252513-76b6-349d-948b-64f181113b6b",
                                        "glosses": [
                                            "Blé ; pain."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369ba768-640f-4c01-8b09-a736484832d5",
                                                "sense_id": "8dccdcff-8d08-333f-adaa-561162302cda",
                                                "text": "Les Grecs, qui chérissaient les fleurs, ignorèrent toujours l’art de les cultiver et de les embellir ; ils les cultivaient dans les champs et les recevaient simples des mains de la nature. On. vit les Romains prendre, avec les arts de la Grèce, le goût des fleurs, et même une passion si vive pour les couronnes, qu’on fut obligé d’en défendre l’usage aux particuliers. Ces maîtres du monde ne cultivèrent que les violettes et les roses, et des champs entiers, couverts de ces fleurs, empiétèrent bientôt sur les droits de Cérès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7899a22b-c3f1-3513-b48c-18f698b47243",
                                        "entry_id": "63252513-76b6-349d-948b-64f181113b6b",
                                        "glosses": [
                                            "(Par antonomase) Belle femme blonde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "137ff734-8ad8-41e0-9ea1-79e0d34c77db",
                                                "sense_id": "7899a22b-c3f1-3513-b48c-18f698b47243",
                                                "text": "Il peut aussi varier dans sa couleur suivant ce qu’on y aura rajouté de son, à l’inspiration d’une de ces belles Cérès, comme les appelle Métérié, accroupies en leurs voiles, leurs pains tièdes et moelleux, comme doit être leur corps, devant elles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d061be6-66b1-3527-8b33-ebfae6981b01",
                                        "entry_id": "63252513-76b6-349d-948b-64f181113b6b",
                                        "glosses": [
                                            "Timbres-poste français ou portugais représentant la déesse romaine."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1dd7a24-2814-4e5d-a2a1-209f3b24f259",
                                                "sense_id": "2d061be6-66b1-3527-8b33-ebfae6981b01",
                                                "text": "Enfin, le type dérivé de la Cérès de Barre de 1849, avec des valeurs de 1,75 à 3 francs, initialement prévu pour le tarif de la lettre simple […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cérès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26b69b00-4d71-384f-a101-ee661fa4230b",
                                        "entry_id": "2f597669-c0ab-3ee9-b81f-7e726892fa02",
                                        "glosses": [
                                            "Plus gros corps céleste de la ceinture d’astéroïdes située entre Mars et Jupiter, considéré comme une planète naine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad49a83-c377-4fe7-8c6d-7bd9657598aa",
                                                "sense_id": "26b69b00-4d71-384f-a101-ee661fa4230b",
                                                "text": "Les planètes sont au nombre de onze : Mercure, Vénus, la Terre, Mars, Cérès, Pallas, Junon, Vesta, Jupiter, Saturne et Uranus."
                                            },
                                            {
                                                "example_id": "c578aef3-0d10-4b60-bab8-bf2efe2b5828",
                                                "sense_id": "26b69b00-4d71-384f-a101-ee661fa4230b",
                                                "text": "En outre, Cérès, le plus grand astéroïde, orbite autour du Soleil quinze fois plus près que Pluton ne le fait, bien que le diamètre de cette planète soit trois fois supérieur à celui de cet astéroïde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
