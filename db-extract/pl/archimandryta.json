                "senses": [
                    {
                        "sense_id": "634f03f1-7729-34e0-8d15-3fb7a3cb67d2",
                        "entry_id": "820ca58f-86a3-3604-a477-f3af4dcd933c",
                        "glosses": [
                            "w okresie wczesnego chrześcijaństwa: opiekun klasztorów na terenie danej diecezji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd11812-a404-4ae3-930a-6cd18c82eadf",
                                "sense_id": "634f03f1-7729-34e0-8d15-3fb7a3cb67d2",
                                "text": "W liście do mnichów i archimandrytów Jerozolimy cesarz Marcjan obiecał śledztwo w sprawie czynów, których mieli się dopuścić Samarytanie przeciwko chrześcijanom, w tym plądrowania kościołów i majątków chrześcijan, a także zabójstw"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4dd00d0c-46d4-3cd1-8187-cdb11e8f81ea",
                        "entry_id": "820ca58f-86a3-3604-a477-f3af4dcd933c",
                        "glosses": [
                            "przełożony klasztoru w katolickich Kościołach wschodnich"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4ae85df-e82f-4d63-a925-65b438ca8e00",
                        "source_entry_id": "820ca58f-86a3-3604-a477-f3af4dcd933c",
                        "source_sense_id": "634f03f1-7729-34e0-8d15-3fb7a3cb67d2",
                        "target_lang_word": "archimandrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archimandrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                                        "glosses": [
                                            "The superior of a large monastery, or group of monasteries, in the Orthodox Church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f3c2b1-cb8e-4c8c-9ac5-9626d9f49bfb",
                                                "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                                                "text": "My predecessors generally preferred to live and work in the monastery proper, but I like the solitude of the caves. I have been an archimandrite, here at Pskov, since 1915 and a humble monk for twenty years before that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb13177e-308e-3f61-8778-aa63bcf1738a",
                                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                                        "glosses": [
                                            "An honorary title sometimes given to a monastic priest."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4259209f-d375-4f1c-bb36-bdbe8f49b605",
                        "source_entry_id": "820ca58f-86a3-3604-a477-f3af4dcd933c",
                        "source_sense_id": "634f03f1-7729-34e0-8d15-3fb7a3cb67d2",
