                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                        "entry_id": "05b2a689-5b20-345d-8891-b1b1ef5e1439",
                        "glosses": [
                            "das nachfolgende Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da405bcf-1235-466f-ae8d-6933e13e46ca",
                                "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                                "text": "Die Urlaubstage sind auf das Folgejahr zu übertragen."
                            },
                            {
                                "example_id": "54ac93eb-57f2-4733-ab84-7df98f31e995",
                                "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                                "text": "Nur 8,6 Prozent der Vollzeitbeschäftigten im Niedriglohnsektor gelang es, im Folgejahr einen besser bezahlten Job zu finden."
                            },
                            {
                                "example_id": "c1230e9d-6c0f-425a-9a6b-5cba5d491eb1",
                                "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                                "text": "Erst Ende 2007 wurde bekannt, dass er bereits Anfang Januar des Folgejahres seinen Pass erhalten sollte, was dann auch geschah."
                            },
                            {
                                "example_id": "91ed17a9-e7ef-4803-8ab3-de87499be70f",
                                "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                                "text": "„Aber doch zog man in den Folgejahren lange hin und her, bezog Quartiere und räumte sie wieder, plünderte und erhob willkürlich Kontributionen, um den murrenden Truppen etwas Sold zahlen zu können.“"
                            },
                            {
                                "example_id": "29821d3b-8cd2-41a2-b210-e925eead6748",
                                "sense_id": "7f30c085-7723-3c8e-8ed6-d19a7659e0ca",
                                "text": "„In den Folgejahren kristallisierten sich die Konturen der neu angestrebten Ordnung allmählich heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
