                        "examples": [
                            {
                                "example_id": "ac28bff2-ea1a-43fc-b327-2df4e3ce65f0",
                                "sense_id": "2b193ca4-a6de-3d77-a91e-a89f4ab71a70",
                                "text": "Sans doute lui fallait-il ce voyage aux confins du marasme, fallait-il qu’il s’inocule cette dose décapante de fiel, qu’il s’autoavilisse, se piétine pour enfin s’ébrouer et oublier l’intolérable injustice."
                            },
                            {
                                "example_id": "2f4e7c15-003d-4e22-978e-0530292f3e2a",
                                "sense_id": "2b193ca4-a6de-3d77-a91e-a89f4ab71a70",
                                "text": "On suit son parcours par flash-backs, de l’enfant de la Ddass surdoué jusqu’à l’adolescent gauchisant, odieux et génial, et à l’adulte autoavili, déchu, marginal."
                            }
                        ]
