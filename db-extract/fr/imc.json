                                "target_senses": [
                                    {
                                        "sense_id": "fd6e2c67-d85d-3054-8f3e-c5bb06156707",
                                        "entry_id": "30838dd1-2026-38ad-83e3-894a51d73623",
                                        "glosses": [
                                            "Initialism of body mass index."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b32bae1-1337-403b-bb1a-8d25c66d78f3",
                                                "sense_id": "fd6e2c67-d85d-3054-8f3e-c5bb06156707",
                                                "text": "The Federal Obesity Clinical Guidelines define underweight as a BMI of 18 or less, overweight as a BMI of 25 to 29.9 and obesity as a BMI of 30 and above."
                                            },
                                            {
                                                "example_id": "8b0c846e-3799-4484-92aa-0adb721fccf2",
                                                "sense_id": "fd6e2c67-d85d-3054-8f3e-c5bb06156707",
                                                "text": "Wrong, says a new study, which has found that among adults 18 to 90 across the BMI continuum, having an apple shape increased the risk of death -- particularly death from cardiovascular disease.\nEven at BMIs above 30, where obesity begins, men and women whose waist-to-hip ratio identified them as more pear-shaped were less likely to die -- of any cause and of cardiovascular causes -- than those with similar BMIs who were apple-shaped."
                                            },
                                            {
                                                "example_id": "6cbf2499-dea8-485c-981f-d0c988d515b2",
                                                "sense_id": "fd6e2c67-d85d-3054-8f3e-c5bb06156707",
                                                "text": "In the bivariate analysis carried out by subgroups, we did not find statistically significant differences (p < 0.05) between bionaïve or bioexperienced patients, patients with BMI < 30 or BMI > 30 in relation to the efficacy variables (PASI and BSA) and analyzed PROs (VAS pruritus and DLQI)."
                                            }
                                        ]
                                    },
