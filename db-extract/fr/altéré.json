                    {
                        "sense_id": "6deb09c3-7d50-38c4-8972-b745bad3fb11",
                        "entry_id": "b1e73c99-e5d0-3089-abfc-f67fd55f582a",
                        "glosses": [
                            "Assoiffé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293a918d-a396-4839-8461-c01bf8ba5cb1",
                                "sense_id": "6deb09c3-7d50-38c4-8972-b745bad3fb11",
                                "text": "Bellombre avait appelé ses valets, qui couvrirent la nappe d’assiettes et de pots à large panse, à la grande jubilation de Blazius altéré de naissance, dont la soif était toujours éveillée, même aux heures nocturnes."
                            },
                            {
                                "example_id": "60aadd7b-de88-4385-97bf-ce9ff66db868",
                                "sense_id": "6deb09c3-7d50-38c4-8972-b745bad3fb11",
                                "text": "Laisse-moi respirer longtemps, longtemps, l'odeur de tes cheveux, y plonger tout mon visage, comme un homme altéré dans l'eau d'une source …"
                            }
                        ]
                    }
                ],
