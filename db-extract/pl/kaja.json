                ],
                "translations": [
                    {
                        "translation_id": "1aaf56ef-7afb-415f-803e-b4cd04300120",
                        "source_entry_id": "e43586be-2f18-31bf-bb2a-276c35a93635",
                        "source_sense_id": "236072e6-ac8f-33b3-83a5-575ada1e3119",
