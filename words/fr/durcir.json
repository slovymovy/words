                },
                {
                    "sense_id": "2fee70dd-a384-3c7f-9e2f-fd3d7a3414bc",
                    "sense_definition": "Donner un aspect plus sévère ou froid à l'expression d'un visage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette coupe de cheveux très courte a tendance à <w>durcir</w> les traits de son visage.",
                            "target_lang_translations": {
                                "en": "This very short haircut tends to <w>harden</w> her facial features.",
                                "ru": "Эта очень короткая стрижка <w>огрубляет</w> черты её лица.",
                                "de": "Dieser sehr kurze Haarschnitt neigt dazu, ihre Gesichtszüge zu <w>verhärten</w>.",
                                "es": "Este corte de pelo muy corto tiende a <w>endurecer</w> los rasgos de su rostro.",
                                "zh": "这种极短的发型往往让她的面部线条显得<w>僵硬</w>。"
                            }
                        },
                        {
                            "text": "La colère et la fatigue finissent par <w>durcir</w> son regard d'ordinaire si bienveillant.",
                            "target_lang_translations": {
                                "en": "Anger and fatigue eventually <w>harden</w> his normally kindly gaze.",
                                "ru": "Гнев и усталость в конце концов <w>ожесточают</w> его обычно такой добрый взгляд.",
                                "de": "Zorn und Erschöpfung lassen seinen sonst so gütigen Blick schließlich <w>verhärten</w>.",
                                "es": "La ira y el cansancio acaban por <w>endurecer</w> su mirada, habitualmente tan bondadosa.",
                                "zh": "愤怒和疲惫最终让他平日里那和善的目光变得<w>冷峻</w>。"
                            }
                        }
                    ],
