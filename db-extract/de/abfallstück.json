                                "example_id": "a9f2bf99-6b65-47cb-a542-43d4e7c3f298",
                                "sense_id": "346e342b-9b83-3f04-a412-12ed3edea073",
                                "text": "Auf der Straße liegt ein großes Abfallstück."
                            },
                            {
                                "example_id": "fa5d6ea8-ca87-45bb-8272-bb99731bf109",
                                "sense_id": "346e342b-9b83-3f04-a412-12ed3edea073",
                                "text": "Jeden morgen entsorge ich verschiedene Abfallstücke."
                            },
                            {
                                "example_id": "d75f8324-259a-489f-b948-6359e5de0ac3",
                                "sense_id": "346e342b-9b83-3f04-a412-12ed3edea073",
                                "text": "„Von der Raumstation Mir entschwebten während der ersten zehn Jahre mehr als 200 Abfallstücke, die meisten davon Müllsäcke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
