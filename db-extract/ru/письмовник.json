                        "source_entry_id": "22e0066e-0b03-3e76-a0b2-5912e8981773",
                        "target_lang_word": "letter-writer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "letter-writer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf80f5d-1527-329b-a7ee-0fb3e841bcbc",
                                        "entry_id": "840773b7-37ce-3e3e-98b6-908e7b1b244f",
                                        "glosses": [
                                            "Alternative form of letter writer."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "letter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6b2a3d-8fcd-4805-ade4-5e41988fa09f",
                                                "sense_id": "2cf80f5d-1527-329b-a7ee-0fb3e841bcbc",
                                                "text": "The Indian letter-writers, awaiting clients, fresh paper and carbons rolled into their machines, greeted Victor Crabbe with smiles and waved hands."
                                            },
                                            {
                                                "example_id": "158873d3-f8b4-435d-a7af-bca4364b920f",
                                                "sense_id": "2cf80f5d-1527-329b-a7ee-0fb3e841bcbc",
                                                "text": "The people behind this offensive charge are revolutionaries wishing that once again America would become a nation of letter-writers."
                                            },
                                            {
                                                "example_id": "176b5288-382b-4179-9f10-ffc7e6315df6",
                                                "sense_id": "2cf80f5d-1527-329b-a7ee-0fb3e841bcbc",
                                                "text": "We add to the chorus of letter-writers praising the current Morning Sun play at The New Mexico Actors Lab, here in Santa Fe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23939e95-8c01-4226-a6c1-c120c06a8459",
                        "source_entry_id": "22e0066e-0b03-3e76-a0b2-5912e8981773",
                        "target_lang_word": "Briefsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briefsteller",
