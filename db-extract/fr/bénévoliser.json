                "senses": [
                    {
                        "sense_id": "f3771bcf-dcbf-3d8b-a98e-6b86e8698d9f",
                        "entry_id": "cce5d805-0eed-3e0e-b876-868e69c7d56e",
                        "glosses": [
                            "Donner un caractère bénévole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a840749f-fc9a-4d97-a600-18b5a286a593",
                                "sense_id": "f3771bcf-dcbf-3d8b-a98e-6b86e8698d9f",
                                "text": "Pour pallier ces défections, la sécurité routière vient de « bénévoliser » les agents de son propre service, alors que la situation de bénévole s’apprécie en particulier au regard de l’absence de rémunération et de l’inexistence d’un quelconque lien de subordination entre le bénévole et l’organisation auprès de laquelle il s’engage."
                            },
                            {
                                "example_id": "9486b2d3-c18d-4a5c-a3b2-666cdbb44b40",
                                "sense_id": "f3771bcf-dcbf-3d8b-a98e-6b86e8698d9f",
                                "text": "On reviendra bénévoliser avec un grand plaisir."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a4f16b4-461d-33c4-8c67-146e678fcf9e",
                        "entry_id": "cce5d805-0eed-3e0e-b876-868e69c7d56e",
                        "glosses": [
                            "Avoir une activité bénévole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb6eb1cf-71ea-47ba-878b-e88e97a376b5",
                                "sense_id": "6a4f16b4-461d-33c4-8c67-146e678fcf9e",
                                "text": "Sinon, moi aussi il m'arrive de bénévoliser, mais dans un cadre non marchand."
                            }
                        ]
                    }
