                                        "glosses": [
                                            "To intoxicate oneself with alcohol. (This entry is a translation hub.)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e8434e-3673-4606-b6fb-58bf15ba4ac7",
                                                "sense_id": "03cab101-88da-32fd-92a4-7e1f7b93c96b",
                                                "text": "I'm going out tonight to get drunk."
                                            },
                                            {
                                                "example_id": "cd8f5f79-b035-4ebf-bc8c-c1bdbe1aa4df",
                                                "sense_id": "03cab101-88da-32fd-92a4-7e1f7b93c96b",
                                                "text": "Would I take someone here for a first date? No. Would I go here for a cheap bite? Also no, but would I go here to get drunk on the cheap? Absolutely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f83d32-8f2d-3859-90d6-59bd09cbe291",
