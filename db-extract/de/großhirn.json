                        "source_sense_id": "a5ad06c8-ee11-351f-bb7f-acfe07adac18",
                        "source_sense_description": "Anatomie: vorderer, größter Teil des Gehirns",
                        "target_lang_word": "cerebrum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cerebrum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5041bdf3-61e6-3299-9290-92e7c8119372",
                                        "entry_id": "48da42d4-b458-341d-a8aa-ae507a99166c",
                                        "glosses": [
                                            "The principal and most anterior part of the brain in vertebrates, which is located in the front area of the skull and divided into two hemispheres, left and right, separated by a fissure. In humans it is the largest part of the brain and is responsible for the integration of complex sensory functions and the initiation and coordination of voluntary activity, and the higher mental functions such as consciousness, thought, reason, emotion, and memory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10382423-ce02-4045-8ffe-b0a315b6b42e",
                        "source_entry_id": "4655c313-9561-3dea-afdb-343ce688bf61",
                        "source_sense_id": "a5ad06c8-ee11-351f-bb7f-acfe07adac18",
                        "source_sense_description": "Anatomie: vorderer, größter Teil des Gehirns",
