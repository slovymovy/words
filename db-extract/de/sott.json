                    }
                ],
                "senses": [
                    {
                        "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                        "entry_id": "7f82bf2a-7b90-30de-afcf-2dfa99277974",
                        "glosses": [
                            "schwarzer, schmieriger Rückstand (aus Kohlenstoff), der bei unvollständiger Verbrennung von Biomasse übrig bleibt"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb184bc-4ad2-4df4-9f33-93be3bd29cd3",
                                "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                                "text": "„Den Seiten des Herdes bleibt man am beſten fern, ſonſt klebt man gar zu leicht an dem teerigen ‚Sott‘ feſt, der in dickflüſſigen Rinnſalen nicht nur das Innere, ſondern teilweiſe auch das Äußere des geräumigen Herdloches bedeckt.“"
                            },
                            {
                                "example_id": "1ad086c3-9179-459e-8012-a3a5b93f556c",
                                "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                                "text": "„‚[…] Der Schornstein zog nicht mehr, die Küche qualmte, und nach jedem Regen lief der Sott die Wände runter. Meine Frau war verzweifelt‘, sagt Otto Palm.“"
                            },
                            {
                                "example_id": "46cce7e6-d6e3-43eb-a8e7-deb81a96cff2",
                                "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                                "text": "„Alle von der Uniform nicht bedeckten Hautpartien blieben tagelang schwarz und schmierig, eingefärbt von Sott und Smog aus rund 900 lodernden Ölquellen.“"
                            },
                            {
                                "example_id": "2bd6219f-c30f-4d9b-8677-10b635d39822",
                                "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                                "text": "„Dreieinhalb Jahre später glitzern die Prachtbauten der Herrscherfamilie, befreit vom klebrigen Sott der Rauchschwaden, wieder im Vorkriegsglanz.“"
                            },
                            {
                                "example_id": "d3a19a0a-f6ed-4917-9abb-f31bdac18225",
                                "sense_id": "02862dd1-1bac-399f-9989-c8e0a55fbed0",
                                "text": "„Der Bus bläst ihm den schwarzen Sott direkt ins Gesicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
