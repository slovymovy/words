    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a18bf25-46bd-3bf1-843d-2fe572056e8b",
                    "sense_definition": "Serrer ou attacher avec une corde, un lien ou une courroie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attacher_physiquement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier doit <w>lier</w> ces branches pour éviter qu'elles ne tombent par terre."
                        },
                        {
                            "text": "Il utilise une ficelle solide pour <w>lier</w> un paquet avant de l'envoyer par la poste."
                        }
                    ],
                    "synonyms": [
                        "attacher"
                    ],
                    "antonyms": [
                        "délier"
                    ],
                    "common_phrases": [
                        "lier un paquet",
                        "lier les mains"
                    ]
                },
                {
                    "sense_id": "34f9fc36-4cb9-3fa5-bdcf-58c27e36c6dd",
                    "sense_definition": "Établir un rapport logique, causal ou abstrait entre des faits ou des idées ; unir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unir_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs tentent de <w>lier</w> ces deux phénomènes pour mieux comprendre la situation."
                        },
                        {
                            "text": "Son succès actuel est étroitement <w>lié</w> à ses nombreux efforts passés."
                        }
                    ],
                    "synonyms": [
                        "relier"
                    ],
                    "common_phrases": [
                        "être lié à"
                    ]
                },
                {
                    "sense_id": "33ee92bc-659c-3e65-8518-2f87576e1ce2",
                    "sense_definition": "Unir des personnes par des relations d'amitié, d'intérêt ou d'affection.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux camarades ont rapidement réussi à <w>lier</w> amitié dès la rentrée des classes."
                        },
                        {
                            "text": "Elle a toujours eu des difficultés à se <w>lier</w> avec les nouveaux arrivants."
                        }
                    ],
                    "common_phrases": [
                        "lier amitié",
                        "se lier d'amitié"
                    ]
                },
                {
                    "sense_id": "60eec450-1ad7-3b31-bf91-3eac0a40892a",
                    "sense_definition": "Astreindre ou obliger quelqu'un par une promesse, un serment ou un contrat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce contrat officiel va <w>lier</w> les deux entreprises pour les trois prochaines années."
                        },
                        {
                            "text": "L'avocat a rappelé qu'il était <w>lié</w> par le secret professionnel le plus strict."
                        }
                    ],
                    "common_phrases": [
                        "lié par un contrat",
                        "lié par une promesse"
                    ]
                },
                {
                    "sense_id": "b5ee2924-802a-353d-88c5-8ec0af41258e",
                    "sense_definition": "Donner de la consistance ou épaissir un liquide ou une sauce.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef cuisinier ajoute un peu de fécule pour <w>lier</w> la sauce à feu doux."
                        },
                        {
                            "text": "Il faut remuer la préparation constamment jusqu'à ce qu'elle commence à se <w>lier</w>."
                        }
                    ],
                    "common_phrases": [
                        "lier une sauce"
                    ]
                }
            ]
        }
    ]
