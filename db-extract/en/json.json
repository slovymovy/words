                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1a8b65d-8f3f-473f-98cd-d5709c0b28c7",
                        "entry_id": "646c24d6-17d5-395d-8e13-6a67f1c924ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "JSONs"
