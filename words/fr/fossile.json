    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e866f2f-35c0-307e-b98b-9f5ebaa82427",
                    "sense_definition": "Reste ou empreinte d'un organisme végétal ou animal conservé dans une roche sédimentaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "paleontologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ont découvert un <w>fossile</w> d'ammonite pendant leur promenade sur la plage rocheuse."
                        },
                        {
                            "text": "Ce musée d'histoire naturelle expose des squelettes entiers et de nombreux <w>fossiles</w> marins."
                        }
                    ],
                    "common_phrases": [
                        "fossile vivant"
                    ]
                },
                {
                    "sense_id": "45d1b12a-69ac-3f75-a179-129170aee65c",
                    "sense_definition": "Personne très âgée ou attachée à des idées totalement dépassées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur refuse d'écouter les jeunes et passe pour un vieux <w>fossile</w> auprès de son équipe."
                        },
                        {
                            "text": "Ses idées rétrogrades sur la société montrent qu'il est devenu un véritable <w>fossile</w>."
                        }
                    ],
                    "synonyms": [
                        "débris",
                        "vieux croûton"
                    ],
                    "common_phrases": [
                        "vieux fossile"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier et péjoratif"
                        }
                    ]
                },
                {
                    "sense_id": "27eee323-24f9-3999-94f6-193f72617c5a",
                    "sense_definition": "En Belgique, étudiant qui refuse de participer aux rites du baptême et au folklore estudiantin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'université, les étudiants qui refusent le baptême sont souvent désignés comme des <w>fossiles</w>."
                        },
                        {
                            "text": "Il n'a jamais voulu rejoindre le cercle folklorique et est resté un <w>fossile</w> durant toutes ses études."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Belgique"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "argot estudiantin"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "082ae1c4-283e-35ab-a872-701ef87ab931",
                    "sense_definition": "Qui appartient à une époque géologique ancienne et s'est conservé dans la roche, ou qui en est extrait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "paleontologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La transition écologique vise à remplacer l'énergie <w>fossile</w> par des ressources durables et propres."
                        },
                        {
                            "text": "Les géologues ont étudié des couches <w>fossiles</w> contenant des traces de fougères disparues."
                        }
                    ],
                    "common_phrases": [
                        "énergie fossile",
                        "combustible fossile"
                    ]
                },
                {
                    "sense_id": "35f24850-c7e3-3850-835b-09bfdfdb0321",
                    "sense_definition": "Qui est extrait des entrailles de la terre, en parlant d'un minéral.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce traité ancien de chimie, le sel gemme était couramment qualifié de sel <w>fossile</w>."
                        },
                        {
                            "text": "Les auteurs du dix-huitième siècle désignaient la houille comme un charbon <w>fossile</w> extrait du sol."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sens ancien"
                        }
                    ]
                }
            ]
        }
    ]
