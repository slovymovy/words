                        "glosses": [
                            "Annuler une dot, entièrement ou en partie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557c9a66-40bf-41de-a4f0-bad41165b4bc",
                                "sense_id": "231344c9-9e67-375b-96f7-fa69c53a40ae",
                                "text": "La Réforme n’a ni établi ni doté l’Église, mais elle l’a considérablement dédotée, — car ce sont en bonne partie des dons faits par ses ancêtres royaux, ainsi que par d’autres pieux fondateurs, en vue d’applications religieuses, que Henri VIII s’est donné la fantaisie de reprendre, — et elle a plutôt établi la suprématie de la couronne."
                            },
                            {
                                "example_id": "97b2b161-ddf6-447a-9d23-1ceaf7ac8d75",
                                "sense_id": "231344c9-9e67-375b-96f7-fa69c53a40ae",
                                "text": "Tu t'es simplement dédotée."
                            },
                            {
                                "example_id": "42ec7bc1-66ba-48bd-87be-6c0d6260254e",
                                "sense_id": "231344c9-9e67-375b-96f7-fa69c53a40ae",
                                "text": "Et pour le mythe, je cherche plutôt à me dédoter."
                            }
                        ]
                    }
