                "senses": [
                    {
                        "sense_id": "97c4a4dc-5075-3bc2-be2a-1fe7ff4ea226",
                        "entry_id": "08fd4418-3d2e-3408-9f28-e701509561c2",
                        "glosses": [
                            "verminderte Zirkulation der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "190383c1-0174-446c-a60c-76f1bdf0736f",
                                "sense_id": "97c4a4dc-5075-3bc2-be2a-1fe7ff4ea226",
                                "text": "„In den meisten Weinkellern finden sich gewölbte Decken, Sie haben den Vorteil, dass sich kein Lüftungsstau bildet und so die Luft optimal zirkulieren kann.“"
                            },
                            {
                                "example_id": "dce25dd8-e59f-44d5-acca-1dac91d2ff58",
                                "sense_id": "97c4a4dc-5075-3bc2-be2a-1fe7ff4ea226",
                                "text": "„Der Weinkeller gibt dem Wein, was er zur vollendeten Reifung braucht, denn tief unter der Erde besteht ein weitestgehend konstantes Lagerklima – es ist ruhig und dunkel, zudem gibt es keinen Lüftungsstau, da die Raumluft gut zirkulieren kann.“"
                            },
                            {
                                "example_id": "ce55419f-5dc0-4887-b127-4d550d5ce235",
                                "sense_id": "97c4a4dc-5075-3bc2-be2a-1fe7ff4ea226",
                                "text": "„Auf diese Weise wird ein Lüftungsstau verhindert, die warme Abluft steigt direkt in die obere Mitte des Gewölbes und wird durch ein Rohr nach außen geleitet.“"
                            },
                            {
                                "example_id": "5fcc0b74-58d0-4739-8e13-dbbbf0271fb3",
                                "sense_id": "97c4a4dc-5075-3bc2-be2a-1fe7ff4ea226",
                                "text": "„Darüber hinaus kommt es bei dieser Art von Gewölbekeller nicht zu Lüftungsstaus und eine Schimmelbildung ist ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
