                "senses": [
                    {
                        "sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                        "entry_id": "d290cef4-5542-3ac0-ab13-94ce21fbadf0",
                        "glosses": [
                            "bildende Kunst: bildhafte Darstellung eines Rundtanzes, den der Tod mit jedem Menschen zu jeder Zeit tanzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9bee65-50d2-4171-b809-5ffc30a5f8fc",
                                "sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                                "text": "Totentänze findet man in der sakralen Kunst schon seit dem 14. Jahrhundert."
                            },
                            {
                                "example_id": "cfdac016-21c8-4bea-a235-98c65d4a6ce2",
                                "sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                                "text": "Auch andere Kunstrichtungen befassten sich mit dem Motiv des Totentanzes."
                            },
                            {
                                "example_id": "a5f98292-2a24-4727-af7b-cbabbaa0607a",
                                "sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                                "text": "„Der Körper hing verkehrt herum und schwang im Rhythmus des Zuges vor und zurück, ganz im Einklang mit seinen drei Genossen: ein obszöner Totentanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbc42053-25a0-4442-a98f-9d836960670f",
                        "source_entry_id": "d290cef4-5542-3ac0-ab13-94ce21fbadf0",
                        "source_sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                        "target_lang_word": "danse macabre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danse macabre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e886a08-8d7f-38d7-9c6c-5d78deba8ca4",
                                        "entry_id": "e814e12a-6aff-3f68-87a2-d05eaaa864e4",
                                        "glosses": [
                                            "A conventional subject in art, literature and drama, or a particular work in that style, in which death (in the form of a putrid corpse, skeleton, the Grim Reaper, etc) is shown leading people to the grave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab7dda9-d460-4788-a7f0-b685ab5aea4c",
                        "source_entry_id": "d290cef4-5542-3ac0-ab13-94ce21fbadf0",
                        "source_sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
                        "target_lang_word": "danse macabre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danse macabre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17cad07b-71f4-3f5a-9fda-d49a75fc09e4",
                                        "entry_id": "096683aa-509e-3a41-8a25-24c723403c27",
                                        "glosses": [
                                            "Allégorie picturale fréquente au Moyen Âge, représentant la mort entraînant dans une même danse des squelettes d’êtres humains de toutes conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffcaa3b-9ee4-42b2-a9b3-f4b29121ac51",
                                                "sense_id": "17cad07b-71f4-3f5a-9fda-d49a75fc09e4",
                                                "text": "Une danse macabre était peinte sur le mur de ce cimetière. Ses yeux s'arrêtèrent sur la Mort et se fixèrent longtemps sur cette figure railleuse et terrible à la fois."
                                            },
                                            {
                                                "example_id": "c1735ada-921f-4bfb-a87d-5b9ff7dfb222",
                                                "sense_id": "17cad07b-71f4-3f5a-9fda-d49a75fc09e4",
                                                "text": "Les os ou songe-creux venaient des ossuaires\nEn danse macabre aux plis de mon cervelet"
                                            },
                                            {
                                                "example_id": "e8b35987-6cda-45e1-a5c5-9b91d61f72a5",
                                                "sense_id": "17cad07b-71f4-3f5a-9fda-d49a75fc09e4",
                                                "text": "Mais son originalité c'est qu'elle présente un rare ensemble de peintures murales datant de la fin du XVᵉ et du début XVᵉ : le dict des trois morts et des trois vifs précède une immense danse macabre sur près de 25 mètres."
                                            },
                                            {
                                                "example_id": "86c25f22-390d-4ec2-8cb0-383844bb8ca8",
                                                "sense_id": "17cad07b-71f4-3f5a-9fda-d49a75fc09e4",
                                                "text": "Cet homme étrange, énigme vivante, avec sa pâleur et sa maigreur de spectre, semblait fait exprès pour être le violoneux sublime et funèbre d'une gigantesque danse macabre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "477fc081-1511-4752-a297-248d56ff8c10",
                        "source_entry_id": "d290cef4-5542-3ac0-ab13-94ce21fbadf0",
                        "source_sense_id": "001b53e2-e4d9-36e6-8705-498b96d9ca21",
