                        "examples": [
                            {
                                "example_id": "0093f5e5-7409-4975-8a95-99048bbce563",
                                "sense_id": "9e184709-3ff8-31ab-96d4-67dc1e3542b8",
                                "text": "„Die einen vertreten den Standpunkt, Geschlechtslust sei der Gesundheit des Menschen dienlich und förderlich, die anderen behaupten das Gegenteil, sie sei abträglich und schädlich.“"
                            },
                            {
                                "example_id": "1344d010-6583-4f04-b235-4222296164d5",
                                "sense_id": "9e184709-3ff8-31ab-96d4-67dc1e3542b8",
                                "text": "„Wer all dies verachte und ausschließlich auf ein Maximum an individueller Geschlechtslust bedacht sei, der gelange zum Einklang mit sich selbst und demonstriere die unbedingte, natürliche Freiheit seiner Person als spontanes Erlebnis.“"
                            }
                        ],
