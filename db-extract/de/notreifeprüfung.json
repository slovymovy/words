                ],
                "senses": [
                    {
                        "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                        "entry_id": "785279fa-f0e1-3a5a-8c53-bb0a8eedad71",
                        "glosses": [
                            "vorzeitiges Abitur (in Kriegszeiten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ea5af2-ac72-41b5-af26-9eaf9f057f33",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„Max Isaak besucht das Trarbacher Gymnasium und schließt wegen des Ersten Weltkrieges im Herbst 1914 mit einer Notreifeprüfung ab.“"
                            },
                            {
                                "example_id": "f57d5c04-f068-48e8-865a-58750e7ccb16",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„Im Mai 1918 legte er die Notreifeprüfung ab, um als Fahnenjunker in das Feldartillerie-Regiment Großherzog in Karlsruhe einzutreten.“"
                            },
                            {
                                "example_id": "46e5bf04-da98-4d9d-8d37-2e0cfc553b45",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„Dort besuchte er das Realgymnasium und bestand im Juni 1917 die Notreifeprüfung.“"
                            },
                            {
                                "example_id": "a0b0ab87-9cdc-4da5-84cd-3b7124f7b4df",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„Von 20 Oberprimanern meldeten sich nach einer Notreifeprüfung 18 freiwillig, dazu 10 Unterprimaner, acht Obersekundaner und sieben Untersekundaner.“"
                            },
                            {
                                "example_id": "60ced059-69fc-40fd-9445-f0bd2c11bc5a",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„August 1914 wurden Notreifeprüfungen mit abgekürztem Verfahren ermöglicht.“"
                            },
                            {
                                "example_id": "5ad95452-fa91-4f79-a2ae-17cd7f5ec47c",
                                "sense_id": "8c556d3f-5e84-33a0-bd6e-27ff5740d460",
                                "text": "„Für Schüler, die zur Wehrmacht oder zum Reichsarbeitsdienst eingezogen wurden, wurden Notreifeprüfungen durchgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
