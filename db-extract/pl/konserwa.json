                                        "entry_id": "e7bb443e-cd1c-3e72-bc70-e089cab6cf87",
                                        "glosses": [
                                            "A malleable, ductile, metallic element, resistant to corrosion, with atomic number 50 and symbol Sn."
                                        ],
