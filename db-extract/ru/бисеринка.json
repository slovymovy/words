                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "Various small, round solid objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51cfb50-0a01-4902-850f-b1223c29f954",
                                                "sense_id": "70dbf9b3-5b07-3097-a165-1d766c8bc0d5",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3299b01b-977d-3d92-a02f-349a4f673bb7",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small drop of water or other liquid."
                                        ],
