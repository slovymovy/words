        "fr-extract.jsonl": [
            {
                "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                "word": "sérénité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "843d395a-7502-4a57-8430-8646f49d5bb2",
                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "tags": [
                            "plural"
                        ],
                        "form": "sérénités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4fc6ddf-0e5e-3ee2-9abb-4a52dc26623a",
                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "glosses": [
                            "État du temps, de l’air qui est serein."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a81805-b6ad-40e6-a9cf-affc572e717c",
                                "sense_id": "a4fc6ddf-0e5e-3ee2-9abb-4a52dc26623a",
                                "text": "La sérénité de l’air, du temps, du ciel."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "glosses": [
                            "Tranquillité, calme, absence de trouble ou d’agitation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "02c97fbb-82f7-403f-9339-62836cb661ac",
                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                "text": "Brusquement, il poussa une porte, entra, et vit Giselle debout, si calme, une telle sérénité dans ses yeux, où il n'y avait ni crainte, ni défi, ni pas même du dédain, qu'il s'arrêta, pâle comme un mort."
                            },
                            {
                                "example_id": "fb0e42de-e1b2-4b66-b6b7-bfbea3eec847",
                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                "text": "Il siégeait, au fond, sur une banquette, et fumait un cigare. Une indéniable sérénité se reflétait sur ses traits. Peut-être était-ce l’apaisante influence du cigare […]"
                            },
                            {
                                "example_id": "7d945b38-bc3a-4900-86c2-468fd44734eb",
                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d’une grande sérénité dans l’affirmation. Ledit Poignant ne s’en est pas tenu là : à une portée de fusil du tombeau de Merlin, l’« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                            },
                            {
                                "example_id": "59f7d103-94f2-4b84-9cdb-daaa35047de7",
                                "sense_id": "eb233c18-8922-35f7-bc21-c37be425f318",
                                "text": "Rien ne trouble la sérénité de ses jours, rien ne trouble le calme dont il jouit."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa1a4a6e-f509-3c06-8748-c5fa2b2e6552",
                        "entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "glosses": [
                            "Titre honorifique qu’on donnait à quelques souverains et à quelques princes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb8a122e-23e2-49ab-b027-f50fcd19da6d",
                                "sense_id": "fa1a4a6e-f509-3c06-8748-c5fa2b2e6552",
                                "text": "On traitait le doge de Venise, le doge de gênes de Sérénité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f099513-6526-4c25-af16-082ecc4f7313",
                        "source_entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "target_lang_word": "Gelassenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelassenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52daa3a8-dd10-3ef9-aedc-251d85f1ee92",
                                        "entry_id": "d8905682-ddd4-3775-8d2f-22ca96174a8e",
                                        "glosses": [
                                            "maßvolle Haltung, innere Ruhe, seelisches Gleichgewicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f009fb6-50e4-4a00-abc9-f045afd3c127",
                                                "sense_id": "52daa3a8-dd10-3ef9-aedc-251d85f1ee92",
                                                "text": "„Die Gelassenheit ist eine anmutige Form des Selbstbewusstseins. (Marie von Ebner-Eschenbach)“"
                                            },
                                            {
                                                "example_id": "6984d7f1-7c72-4b3e-8106-3f9decf33869",
                                                "sense_id": "52daa3a8-dd10-3ef9-aedc-251d85f1ee92",
                                                "text": "„Zum erstenmal in meinem Leben wurde ich mir der Einsamkeit bewußt, in der wir von der Wiege bis zum Grabe unseren Weg gehen müssen. Eine bittere Erkenntnis zu Anfang. Man braucht lange, bis man sich mit ihr abgefunden hat. Hat man sich aber mit ihr abgefunden, so erwächst daraus eine stolze Gelassenheit gegenüber den Wechselfällen des Lebens. Wie weit war ich noch davon entfernt!“"
                                            },
                                            {
                                                "example_id": "1e536cf7-d019-4efd-b859-46c70b85c68c",
                                                "sense_id": "52daa3a8-dd10-3ef9-aedc-251d85f1ee92",
                                                "text": "„Von steter Fröhlichkeit und Ausdauer vom ersten bis zum letzten Augenblicke, war Jukundi dennoch die Ruhe und Gelassenheit selbst; immer sah man ihn teilnehmend an jeder allgemeinen Freude und an jeder besonderen Ausführung, ausharrend und hilfreich, nie überlaut oder gar betrunken.“"
                                            },
                                            {
                                                "example_id": "4f174641-0c10-4966-a0b3-397175df5cc5",
                                                "sense_id": "52daa3a8-dd10-3ef9-aedc-251d85f1ee92",
                                                "text": "„Sie stellte sich ihre Gelassenheit wieder her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4eb91c-c6b8-31b2-b456-edccbcbd31d2",
                                        "entry_id": "d8905682-ddd4-3775-8d2f-22ca96174a8e",
                                        "glosses": [
                                            "unbeteiligte Haltung, gedankliche Ferne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d9e729-2553-4600-a7a9-295b20c953f9",
                                                "sense_id": "6f4eb91c-c6b8-31b2-b456-edccbcbd31d2",
                                                "text": "„Es ist erstaunlich, mit welcher Gelassenheit die Sprecher der Wirtschaft diese Fehlentwicklung hinnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a33445d-aa3a-4b5a-9bb3-5fea398665c3",
                        "source_entry_id": "a2c25331-ffeb-36e4-ae0d-0e240b75d391",
                        "target_lang_word": "serenity",
