                "translations": [
                    {
                        "translation_id": "724a9df2-bf82-4b77-8251-5aea0cac0934",
                        "source_entry_id": "ce9c1b18-eb08-3e87-a25a-17a59096ab93",
                        "source_sense_description": "собака",
                        "target_lang_word": "Spürhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spürhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d63d1e9a-472b-36ce-bc3c-51bd1024a69e",
                                        "entry_id": "7234aa23-5ab2-3d5b-a1ae-e592600e119c",
                                        "glosses": [
                                            "für bestimmte Dienste (zum Aufspüren gesuchter Personen, Tiere oder Gegenstände) spezialisierter Hund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06a56a7f-d22b-4138-9797-21639b2b65d7",
                                                "sense_id": "d63d1e9a-472b-36ce-bc3c-51bd1024a69e",
                                                "text": "Spürhunde werden zum Beispiel dafür eingesetzt, verstecktes Rauschgift aufzufinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c433b218-088d-4533-9759-d945540463b4",
                        "source_entry_id": "ce9c1b18-eb08-3e87-a25a-17a59096ab93",
                        "source_sense_description": "человек",
                        "target_lang_word": "Spürnase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spürnase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                        "entry_id": "29e5a7bf-a061-3472-981c-20709e05860d",
                                        "glosses": [
                                            "sehr empfindliche/gute Nase (beispielsweise eines Hundes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b68f37b3-398f-45a1-aeb0-2baa0ab71a01",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Dass Hunde großartige Spürnasen sind, ist schon lange bekannt.“"
                                            },
                                            {
                                                "example_id": "2ddecfed-b52f-44f3-a73a-9303cc3b96ea",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Trüffelsuche in Lothringen – […] Dabei kommen speziell abgerichtete Hunde mit besonderen Spürnasen zum Einsatz.“"
                                            },
                                            {
                                                "example_id": "f86a7ddc-b148-40da-b064-1b8d671ac9ee",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„[…] eine Familie [suchte] einen Führer samt Hund oder Schwein mit feiner Spürnase für eine ganz spezielle Tour im Piemont, und zwar für die Trüffelsuche.“"
                                            },
                                            {
                                                "example_id": "24e4f363-7d50-4f34-a3f0-26515c5b5cba",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Spürnase Rufus und Polizeihauptmeister Sielaff trainieren täglich für die Aufnahmeprüfung zur Hundeschule bei der Bundespolizei.“"
                                            },
                                            {
                                                "example_id": "783716e2-603d-4d94-9f56-b2d9981eaa66",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Beim zweiten Anlauf funktioniert Rufus' Spürnase einwandfrei, er zeigt den Sprengstoff vorschriftsgemäß an.“"
                                            },
                                            {
                                                "example_id": "2835ac22-c850-4e81-95c3-9c352f81881a",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Mit seiner feinen Spürnase kann der Schäferhund sogar Vermisste oder Sprengstoff aufspüren!“"
                                            },
                                            {
                                                "example_id": "cdd0e521-009f-4588-952d-b318c602f7f2",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Joschi ist der einzige Lawinen-Suchhund in Baden-Württemberg. Wenn Menschen von Schneemassen verschüttet werden, ist seine Spürnase gefragt.“"
                                            },
                                            {
                                                "example_id": "74ac9142-41be-4c28-b9ef-f00c433d1c33",
                                                "sense_id": "553adfc8-aba1-334e-a591-a65c3ac13f7f",
                                                "text": "„Flintstone heißt der erste und bislang auch einzige zertifizierte Archäologie-Hund Europas! Mit seiner Spürnase erschnüffelt er vor allem eines: menschliche Knochen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                        "entry_id": "29e5a7bf-a061-3472-981c-20709e05860d",
                                        "glosses": [
                                            "ein feines Gespür für etwas/jemanden (beispielsweise für geschäftliche Gelegenheiten) oder ein besonderer Instinkt für das Entdecken oder die Aufklärung von etwas (beispielsweise eines Polizisten, ein Verbrechen aufzuklären)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db8583f-4885-45cc-b463-379db4f81805",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„[Der Verleger Peter Graf] hat sich in den vergangenen Jahren als Spürnase für vergessene oder übersehene Bücher einen Namen gemacht - an erster Stelle mit \"Blutsbrüder\" von Ernst Haffner.“"
                                            },
                                            {
                                                "example_id": "21b8249c-0be6-465f-b445-a5dc64e0aaf5",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Doch Robert Davidson, der Direktor von Sandstone Press, muss eine gute Spürnase gehabt haben. Denn bereits ein Jahr bevor die Krimis des deutschen Autors Volker Kutscher für das Fernsehen adaptiert wurden, erwarb er die Rechte an der englischsprachigen Version der Bücher.“"
                                            },
                                            {
                                                "example_id": "ac583aed-2819-4b0a-b605-9e2c0487244f",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Was er anpackt, wird zum Hit. Seine musikalische Spürnase entdeckte unter Abertausenden von mehr oder weniger Talentierten den deutschen Superstar von morgen.“"
                                            },
                                            {
                                                "example_id": "0a8f44d3-7648-40f4-83e9-833b76a27516",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Tage Alter Musik Regensburg – […] Wer die Stars der Szene von morgen erleben möchte, geht nach Regensburg: Die Veranstalter haben eine sehr gute Spürnase.“"
                                            },
                                            {
                                                "example_id": "23cb9ad0-4e65-460d-a6fd-0b7b825c5618",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Seit ihrer Gründung im Jahr 1985 haben die Musiker des Ensembles, das sich der historischen Aufführungspraxis zutiefst verpflichtet fühlt, eine sichere Spürnase gezeigt.“"
                                            },
                                            {
                                                "example_id": "0652462a-9456-4e18-b03b-e80c04a4934b",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Seine Spürnase hat ihn zu einem künftigen Jazzstar nach dem anderen geführt. Siggi Loch hat Klaus Doldinger, Nils Landgren und Esbjörn Svensson gefördert und das unabhängige Label ACT gegründet.“"
                                            },
                                            {
                                                "example_id": "4f3757be-ecfa-49be-b5f7-4e5b6deaec64",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Wie findet man eigentlich gute Pilzplätze? Wolfgang Bachmeier hat dafür eine Spürnase.“"
                                            },
                                            {
                                                "example_id": "b8e85dd6-fc5b-4b01-859f-85588ec3acdd",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Man kann mit Fug und Recht behaupten, dass das \"goEast\"-Festival in Wiesbaden eine gute Spürnase besitzt.“"
                                            },
                                            {
                                                "example_id": "078c3e06-3141-448a-8843-ff025b8e98d9",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Der Vater beschloss, sich selbstständig zu machen […]. Er bewies damit eine gute unternehmerische Spürnase, denn die Entwicklung von Klebstoffen und technischen Sprays entwickelte sich ab den 1960er-Jahren rasant.“"
                                            },
                                            {
                                                "example_id": "ece0b6cc-e092-461e-b72f-a51dfccbff72",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "[US-Forscher: Schiff von Kolumbus gefunden: … der US-Meeres-Archäologe Barry Clifford] „ist nicht irgendwer, sondern eine anerkannte Spürnase was Schiffswracks anbelangt.“"
                                            },
                                            {
                                                "example_id": "e1c08206-46bd-4155-a2a3-ef6fe78d8601",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Ninas Bruder Matteo [verschwindet] spurlos. Eine große Suchaktion beginnt, und dank Henris Spürnase taucht der Vermisste in einem abgeschlossenen Raum der Schule wieder auf.“"
                                            },
                                            {
                                                "example_id": "8de8b404-3b1d-4251-9990-9cb31d744dba",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Mit hochmodernen Techniken versuchen Stimmexperten, Rechtsmediziner oder Molekularbiologen Verbrechen aufzuklären, Tatorte zu analysieren, Abläufe zu rekonstruieren. Doch Spürnase, Kombinationsgabe und Experimentierfreude sind nach wie vor wichtig, um dem Täter auf die Spur zu kommen.“"
                                            },
                                            {
                                                "example_id": "fae4a376-cd79-4803-9441-499128d55e1d",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Eine gute Spürnase, Geduld und eine hohe Frustrationstoleranz – das sind die wichtigsten Voraussetzungen für einen Genealogen, der erfolgreich sein möchte.“"
                                            },
                                            {
                                                "example_id": "cce5aaca-b5b4-4492-a749-d0cc17ef8bd7",
                                                "sense_id": "da9f7b87-52fe-330d-8c5a-41c81a86bb93",
                                                "text": "„Auf die Schliche kam dem Trick nun – nein, nicht eine aufmerksame Spürnase. Sondern der Google-Algorithmus, der Anzeigen überprüft und verdächtige meldet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
