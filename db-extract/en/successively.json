    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                "word": "successively",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                        "entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                        "glosses": [
                            "In a serial or successive manner; one following another."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2f6369fc-3f0c-4de6-a1a0-289dba6790e4",
                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                "text": "Allan was first William Buddicom's and then Trevithick's second-in-command, at Edge Hill and at Crewe successively, for the period of 13½ years from February, 1840, to September, 1853, when he left Crewe to become Superintendent of the Scottish Central Railway."
                            },
                            {
                                "example_id": "7ae1ba82-13f9-4986-89d0-77d43bc9645e",
                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                "text": "My last to you was of Oct. 8 by the Count de Moustier. Yours of July 18. Sep. 6. & Oct. 24. have been successively received, yesterday, the day before & three or four days before that."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77af21ae-d5e0-48da-b9af-d02f1e19c0c2",
                        "source_entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                        "source_sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                        "source_sense_description": "in a serial manner",
                        "target_lang_word": "achtereenvolgens",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achtereenvolgens",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "210f5ba0-32f4-397b-ba12-9d31febf8ee5",
                                        "entry_id": "ab938164-d259-313f-bfbe-ebf6ad5ee05e",
                                        "glosses": [
                                            "één voor één."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf71c026-82cc-4b4a-b4d8-3e7b491cec53",
                                                "sense_id": "210f5ba0-32f4-397b-ba12-9d31febf8ee5",
                                                "text": "Hij noemde achtereenvolgens alle staten van de VS op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71073b5a-59a1-3db5-957e-3493dd9f0c22",
                                        "entry_id": "ab938164-d259-313f-bfbe-ebf6ad5ee05e",
                                        "glosses": [
                                            "in een bepaalde volgorde van voren naar achteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0daef036-d713-4e9b-96fb-eb039ee9094e",
                                                "sense_id": "71073b5a-59a1-3db5-957e-3493dd9f0c22",
                                                "text": "Als je iemand wil bellen draait u achtereenvolgens het landnummer, het kengetal en als laatste het abonneenummer."
                                            },
                                            {
                                                "example_id": "4046b9d1-d658-418b-9d0a-dff436a2ef4f",
                                                "sense_id": "71073b5a-59a1-3db5-957e-3493dd9f0c22",
                                                "text": "Hij keek naar rechts en zag vanuit zijn ooghoek achtereenvolgens: een paar dure zwarte gympen, een stel lange dunne benen in een grijze pantalon, een lange zwarte parka, en twee in elkaar gevouwen handen, zoals men heeft bij een plechtige gebeurtenis. Daar pauzeerden zijn ogen even, verwonderd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
