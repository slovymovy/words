                                    {
                                        "sense_id": "121cc04b-840c-3845-ab6b-7440eda2d790",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "The act or state of continuing or being continued; uninterrupted extension or succession"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "That which extends, increases, supplements, or carries on."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cdb2635-3a0e-41e1-af95-37828ffc251e",
                                                "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                                "text": "the continuation of a story"
                                            },
                                            {
                                                "example_id": "115c6f1f-dc6d-448f-9991-703435722bc8",
                                                "sense_id": "eb76ec63-9264-3fec-9d8c-e736b071c0cb",
                                                "text": "The series' continuation was commercially if not artistically successful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceaeabf5-86be-394e-a21b-b8d42a9ad346",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "A representation of an execution state of a program at a certain point in time, which may be used at a later time to resume the execution of the program from that point."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f009211b-9755-4435-bc9c-1087091989ce",
                                                "sense_id": "ceaeabf5-86be-394e-a21b-b8d42a9ad346",
                                                "text": "Whenever a Scheme expression is evaluated a continuation exists that wants the result of the expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e097f73b-8db9-343b-bd1b-fb7ce11226f7",
                                        "entry_id": "82ddece0-4989-3ea5-b320-352117e5ab27",
                                        "glosses": [
                                            "A successful shot that, despite a foul, is made with a single continuous motion beginning before the foul, and that is therefore valid in certain forms of basketball."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dff9c17c-68ac-4f3f-8e6e-47e77950864d",
                        "source_entry_id": "14900584-6b2c-3cb6-b579-8744cde98bc6",
                        "source_sense_id": "d7b2cbaf-1593-3406-af37-ae585dc1ac5c",
                        "source_sense_description": "het voortzetten van iets",
                        "target_lang_word": "continuation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a896dea-aafd-3a0c-911c-7eeb32a75d68",
                                        "entry_id": "6d695cd2-409c-3e85-8b32-80dae18b155e",
                                        "glosses": [
                                            "Action de continuer ou de se continuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbddad31-ae9b-413a-8107-6219988171fc",
                                                "sense_id": "2a896dea-aafd-3a0c-911c-7eeb32a75d68",
                                                "text": "Il fallait, aussi, substituer aux grandes percées, rocades ou radiales, la continuation du réseau viaire parisien, en abandonnant la multitude d’alignements nouveaux envisagés à la période précédente et dont le résultat le plus tangible avait été la création de ces « dents creuses » qui déparent tant de rues parisiennes, sans espoir de voir l’alignement général de la voie réalisé dans un délai raisonnable."
                                            },
                                            {
                                                "example_id": "890e333c-479e-443f-85bf-904702280e17",
                                                "sense_id": "2a896dea-aafd-3a0c-911c-7eeb32a75d68",
                                                "text": "Lorsque, […], la continuation du voyage commencé devient impossible, le marin payé au mois reçoit les salaires dus pour le temps qu’il a servi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f07c7376-e1cd-3fb9-ab56-c0a9fca13eb0",
                                        "entry_id": "6d695cd2-409c-3e85-8b32-80dae18b155e",
                                        "glosses": [
                                            "Le fait d’être continué, de se continuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a70cbfd-0f15-4547-b99d-7166242c1aa5",
                                                "sense_id": "f07c7376-e1cd-3fb9-ab56-c0a9fca13eb0",
                                                "text": "Si je raisonne objectivement, je suis obligé de constater la concomitance évidente entre la persistance du sentiment religieux dans une grande partie de la population et la continuation d’une natalité qui, […], demeure malgré tout très belle."
                                            },
                                            {
                                                "example_id": "6a6f9b18-9767-4c4a-8345-14f48590bdf0",
                                                "sense_id": "f07c7376-e1cd-3fb9-ab56-c0a9fca13eb0",
                                                "text": "Le secteur appelle ainsi une fois de plus les pouvoirs publics à l’organisation d’une réunion \"d’urgence\" avec la médecine du travail et les syndicats pour trouver les bonnes procédures pour une continuation de l’activité, dans la mesure du possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a015dce8-cceb-3b77-84ae-d20253553c63",
                                        "entry_id": "6d695cd2-409c-3e85-8b32-80dae18b155e",
                                        "glosses": [
                                            "Suite d’instructions qui reste à être exécutée par un système à un moment précis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdabeb2-8893-40c3-95f5-bc09e5650d61",
                                                "sense_id": "a015dce8-cceb-3b77-84ae-d20253553c63",
                                                "text": "Dans certains langages de programmation, les continuations peuvent être manipulées explicitement en tant qu’objets du langage à part entière : on peut stocker la continuation courante dans une variable que l’on peut donc manipuler en tant que telle ; puis plus loin, on peut restaurer la continuation, ce qui a pour effet de dérouter l’exécution du programme actuel vers le futur que l’on avait enregistré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
