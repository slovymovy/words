                "senses": [
                    {
                        "sense_id": "e09af7c5-bcfc-3d41-8576-0f250995e651",
                        "entry_id": "2c3a618c-f6ec-3c01-95d0-bff02e32c2db",
                        "glosses": [
                            "Faire devenir du pidgin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b0ecba9-0323-4bd2-b626-b999bc300391",
                                "sense_id": "e09af7c5-bcfc-3d41-8576-0f250995e651",
                                "text": "Alors que c'est leur connaissance du sango, fort limitée, qui les appauvrit, eux, les obligeant à pidginiser leur variante de sango afin de «se faire comprendre», (...)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2b9301c-55a6-3aea-aec9-c76a0b5df647",
                        "entry_id": "2c3a618c-f6ec-3c01-95d0-bff02e32c2db",
                        "glosses": [
                            "Devenir du pidgin."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "9f163f4b-7031-400b-b954-11e9dac3751c",
                                "sense_id": "e2b9301c-55a6-3aea-aec9-c76a0b5df647",
                                "text": "Le français peut-il être ainsi galvaudé au risque de se pidginiser ?"
                            },
                            {
                                "example_id": "69a38f5f-840a-487d-8a92-9b00dd0ff062",
                                "sense_id": "e2b9301c-55a6-3aea-aec9-c76a0b5df647",
                                "text": "Alors l'anglais rayonnera de nouveau en tant que langue de culture au lieu de se \"pidginiser\", comme aujourd'hui."
                            }
                        ]
                    }
