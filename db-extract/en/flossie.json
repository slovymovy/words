                        "sense_id": "79d74964-ebe7-3cda-94a4-24b5bb543526",
                        "entry_id": "99536553-b3a2-35fe-9b9e-54e9ea29ef40",
                        "glosses": [
                            "A diminutive of the female given name Florence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790783f1-6fde-4991-afa9-2b6f9df8d4b8",
                                "sense_id": "79d74964-ebe7-3cda-94a4-24b5bb543526",
                                "text": "'Otto's at a conference about Free Open-Source Software. It's his big passion. That's why we called the baby Flossie―F-O-S-S. The French geeks stuck an 'L' in for femininity.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "dae6a92b-f0ba-34ad-a841-9736a99de8d6",
                        "entry_id": "99536553-b3a2-35fe-9b9e-54e9ea29ef40",
                        "glosses": [
                            "A diminutive of the female given name Flora."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc147bc-2c77-42da-b198-9e507689758e",
                                "sense_id": "dae6a92b-f0ba-34ad-a841-9736a99de8d6",
                                "text": "\"Big School is more fun than Primary School,\" said Flossie to her mother as they both sat at the kitchen table, eating their lunch together. \"Isn't it, Mum?\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b7957451-f3d3-3f0d-8e97-1011199cd603",
                "word": "flossie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e3146b1b-9360-449d-b0c9-1baebb198525",
                        "entry_id": "b7957451-f3d3-3f0d-8e97-1011199cd603",
                        "tags": [
                            "plural"
                        ],
                        "form": "flossies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f62704c-6d5b-3bab-b3f8-3f0e79a5f102",
                        "entry_id": "b7957451-f3d3-3f0d-8e97-1011199cd603",
                        "glosses": [
                            "A sexually promiscuous person (usually a woman); a sex worker, prostitute."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f59971c2-e7f7-4515-86c8-5a8e8ea75714",
                                "sense_id": "3f62704c-6d5b-3bab-b3f8-3f0e79a5f102",
                                "text": "Has all the essential qualities of manhood from standing on the street corner flirting with pretty flossies to arguing with his professors on disputed points of psychology"
                            },
                            {
                                "example_id": "aa4d6af5-001a-457a-8664-36e383cbf143",
                                "sense_id": "3f62704c-6d5b-3bab-b3f8-3f0e79a5f102",
                                "text": "There are about 200 male and female “flossies” who come to the University of Texas solely for a good time, Dr. Robert E. Vinson, presi­dent of the university, declar­ed"
                            },
                            {
                                "example_id": "4bad39cb-dbd4-4bb8-9db5-3d781095a806",
                                "sense_id": "3f62704c-6d5b-3bab-b3f8-3f0e79a5f102",
                                "text": "Somehow all decent men seem to become entangled with a Flossie in their youth. The more decent they are, the flossier the Flossies."
                            },
                            {
                                "example_id": "8bf1d1f6-2325-4121-b14d-e6b8fd7e1396",
                                "sense_id": "3f62704c-6d5b-3bab-b3f8-3f0e79a5f102",
                                "text": "‘Not tonight, lovey. I’ve seen better flossies on the battlefields of France and they came cheaper too.’"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
