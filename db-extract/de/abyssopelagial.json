                "senses": [
                    {
                        "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                        "entry_id": "a03c6ee6-98b3-32fb-a796-a1e8efb986ac",
                        "glosses": [
                            "lichtlose Wasserschicht des Meeres, die von 4.000 Metern bis 6.000 Metern Tiefe reicht"
                        ],
                        "tags": [
                            "Biogeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "8934f842-b642-46d2-abc5-7711e137c222",
                                "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                                "text": "Die im Abyssopelagial lebenden Tiefsee-Anglerfische und Riesenkalmare müssen Temperaturen nahe dem Gefrierpunkt sowie Drücken von bis zu 600 bar standhalten."
                            },
                            {
                                "example_id": "08cd2d68-41f5-4121-a156-c511595c96fb",
                                "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                                "text": "Nicht nur, dass es im Abyssopelagial stockdunkel ist, auch die Temperaturen liegen hier nahe dem Gefrierpunkt, bis auf einige wenige Gebiete, in denen hydrothermale Schlote das Wasser auf über 400° Celsius aufheizen."
                            },
                            {
                                "example_id": "e431e2f1-b979-46a0-877b-26a8e1641461",
                                "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                                "text": "Die Strukturen der Populationen im Hadal und Abyssopelagial sind zwar noch wenig untersucht, aber es zeichnet sich ab, dass Abundanz und Diversität hier extrem gering sind."
                            },
                            {
                                "example_id": "dddeef54-c36e-49c8-96e4-07053fffa619",
                                "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                                "text": "Für das Plankton im Meso-, Bathy- und Abyssopelagial gibt es keine verlässlichen Daten, doch scheint das gesamte Plankton in einem Netzhol vom Boden bis zu 200 Metern Wassertiefe durchschnittlich auch nur zwischen 0,1 und 1 Gramm Kohlenstoff pro Quadratmeter zu wiegen."
                            },
                            {
                                "example_id": "34e5f4a6-9365-4461-bd8d-6a41a0bf1df7",
                                "sense_id": "6e1bf2dc-91b2-39b2-a05c-7184e599df41",
                                "text": "Um die potentielle Aufnahme von Nitrat durch Bakterien in der Tiefsee zu bestimmen, wurden Wasserproben von Oberflächengewässern bis zum Bathy- und Abyssopelagial an 51 Stationen eines latitudinalen Transekts von der arktischen bis zur subantarktischen ozeanographischen Provinz des Atlantik genommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
