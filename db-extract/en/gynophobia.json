    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "20017f18-4766-3257-bec0-76fc04e09e5a",
                "word": "gynophobia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42bdcce1-899f-3dc3-a059-6dc9b2ca0f7a",
                        "entry_id": "20017f18-4766-3257-bec0-76fc04e09e5a",
                        "glosses": [
                            "Fear of or aversion to women or girls."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61b46975-a17c-49d5-a546-ddbd0277631b",
                                "sense_id": "42bdcce1-899f-3dc3-a059-6dc9b2ca0f7a",
                                "text": "I fear both kinds. I must admit to gynophobia – the general fear of women – and, in particular, venustraphobia – the fear of beautiful women."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecbaecea-aca1-46d8-a422-bd58b1096cf9",
                        "source_entry_id": "20017f18-4766-3257-bec0-76fc04e09e5a",
                        "source_sense_id": "42bdcce1-899f-3dc3-a059-6dc9b2ca0f7a",
                        "source_sense_description": "fear or hatred of women",
                        "target_lang_word": "gynophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gynophobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c977222-982c-361b-95cb-58c7af7b8a40",
                                        "entry_id": "9c0d790b-395d-3781-94a0-a8ae4a1fa7c2",
                                        "glosses": [
                                            "Haine, aversion ou mépris à l’encontre des femmes."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3cffca6-419a-4d62-bfd1-cd6c75e3e27e",
                                                "sense_id": "9c977222-982c-361b-95cb-58c7af7b8a40",
                                                "text": "Des violences plurielles excluent non seulement les sportives, mais aussi certains sportifs : de la « gynophobie » à l'homophobie, l'apartheid sexuel ne concerne pas seulement les femmes, ce que nous pourrions appeler une « gynophobie », mais également les gays, les lesbiennes et les transsexuels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d279ea54-e858-4cab-b3b8-e344fbe9c68c",
