                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f623394-5777-3e7e-a079-65a1360e2269",
                        "entry_id": "353f6a8a-87c4-31c5-9a61-36047bb67e91",
                        "glosses": [
                            "Organe de protection électromécanique, voire électronique, dont la fonction est d’interrompre le courant électrique en cas de surcharge, ou d'anomalie sur un circuit électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1920d711-5e69-4ce9-bcde-6de5a459bed8",
                                "sense_id": "5f623394-5777-3e7e-a079-65a1360e2269",
                                "text": "En revanche si l’ampérage toléré par le disjoncteur (la somme des équipements électriques qu'il peut supporter) est trop faible, générant des sautes de plomb fréquentes, il peut s'agir du fait que vous ayez omis de préciser à l'électricien que vous utiliserez de nombreux équipements électriques."
                            },
                            {
                                "example_id": "e8611b0e-4599-4cba-bc11-25b8ee11967d",
                                "sense_id": "5f623394-5777-3e7e-a079-65a1360e2269",
                                "text": "Une bonne installation haute tension avec disjoncteurs à bain d'huile, doit être conçue de manière à ce que les fumées ne puissent pas pénétrer dans les couloirs de manœuvre ni dans les salles des barres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b3a3f1c-c9cb-4ad8-840d-bee41b5054e4",
