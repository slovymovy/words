    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd9122fc-f39a-3622-a817-646dacc2d87b",
                    "sense_definition": "To dislodge or throw someone from a seat, especially from horseback or a bicycle.",
