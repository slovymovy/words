{
    "word_family": [
        "indifferent",
        "indifferently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de990e00-d921-3dc4-9660-7bec3d0ef936",
                    "sense_definition": "A lack of interest, concern, or sympathy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apathy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public showed total <w>indifference</w> to the new political campaign.",
                            "target_lang_translations": {
                                "zh": "公众对这项新的政治运动表现出了完全的<w>冷漠</w>。"
                            }
                        },
                        {
                            "text": "His <w>indifference</w> to the suffering of others was deeply concerning to his friends.",
                            "target_lang_translations": {
                                "zh": "他对他人苦难的<w>漠不关心</w>让他的朋友们深感担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unconcern"
                    ],
                    "common_phrases": [
                        "show indifference",
                        "total indifference"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事缺乏兴趣、关心或同情。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "指对人或事缺乏感情，态度冷淡。"
                            },
                            {
                                "target_lang_word": "漠不关心",
                                "target_lang_sense_clarification": "形容对人或事一点也不关心。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f444eaa-e3f2-3a51-aa04-1b3a0d65594b",
                    "sense_definition": "A lack of enthusiasm or excitement about something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apathy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team played with <w>indifference</w> throughout the entire match.",
                            "target_lang_translations": {
                                "zh": "整个比赛过程中，队员们都表现得十分<w>冷淡</w>。"
                            }
                        },
                        {
                            "text": "She greeted the news of her promotion with surprising <w>indifference</w>.",
                            "target_lang_translations": {
                                "zh": "她对升职的消息表现得令人惊讶地<w>无动于衷</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "greet with indifference"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事缺乏热情或兴奋感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷淡",
                                "target_lang_sense_clarification": "指态度不热情，不积极。"
                            },
                            {
                                "target_lang_word": "无动于衷",
                                "target_lang_sense_clarification": "指心里一点儿也没有触动，不为所动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc199469-40a1-3131-9fcc-60afdb8c26b5",
                    "sense_definition": "A relaxed, calm, or unconcerned attitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "apathy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He viewed the chaos around him with a strange <w>indifference</w>.",
                            "target_lang_translations": {
                                "zh": "他以一种奇怪的<w>泰然处之</w>的态度看待周围的混乱。"
                            }
                        },
                        {
                            "text": "Her <w>indifference</w> to the rules made her seem very cool and collected.",
                            "target_lang_translations": {
                                "zh": "她对规则的<w>超然</w>态度让她看起来非常冷静沉着。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种放松、冷静或不担心的态度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "泰然处之",
                                "target_lang_sense_clarification": "形容在紧急或混乱情况下依然冷静，不当回事。"
                            },
                            {
                                "target_lang_word": "超然",
                                "target_lang_sense_clarification": "指置身事外，不被外界干扰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a27db88c-7273-307a-8052-46118583ce1b",
                    "sense_definition": "The quality of being unbiased or impartial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impartiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge maintained complete <w>indifference</w> while hearing the evidence.",
                            "target_lang_translations": {
                                "zh": "法官在听取证据时保持了完全的<w>中立</w>。"
                            }
                        },
                        {
                            "text": "True justice requires an <w>indifference</w> to the social status of the parties involved.",
                            "target_lang_translations": {
                                "zh": "真正的正义要求对当事人的社会地位保持<w>不偏不倚</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "不偏不倚、公正无私的品质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "中立",
                                "target_lang_sense_clarification": "指不偏向任何一方。"
                            },
                            {
                                "target_lang_word": "不偏不倚",
                                "target_lang_sense_clarification": "形容公正，不偏袒任何一方。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8211dc7b-db8d-3724-99de-b6801dc58e8e",
                    "sense_definition": "The general state of being indifferent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "apathy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>indifference</w> of the administration led to many complaints from the staff.",
                            "target_lang_translations": {
                                "zh": "管理层的<w>冷漠</w>导致了员工的许多抱怨。"
                            }
                        },
                        {
                            "text": "She could not hide her <w>indifference</w> toward the outcome of the meeting.",
                            "target_lang_translations": {
                                "zh": "她无法掩饰自己对会议结果的<w>冷漠</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "处于冷漠的一般状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冷漠",
                                "target_lang_sense_clarification": "指一种普遍的、持续的冷淡状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f9ba4cb-8ccf-3405-b6f5-330befd59489",
                    "sense_definition": "A philosophical state where differences are not perceived or are considered non-existent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impartiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the universe exists in a state of absolute <w>indifference</w>.",
                            "target_lang_translations": {
                                "zh": "这位哲学家认为宇宙处于一种绝对的<w>无差别</w>状态。"
                            }
                        },
                        {
                            "text": "He explored the <w>indifference</w> between the mind and the physical world.",
                            "target_lang_translations": {
                                "zh": "他探讨了心灵与物质世界之间的<w>无差别</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种哲学状态，认为事物之间没有区别或区别不存在。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无差别",
                                "target_lang_sense_clarification": "指事物之间没有本质的区别。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}