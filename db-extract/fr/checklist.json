                        "sense_id": "774ccd29-188c-3591-ad37-faf6b60b38ca",
                        "entry_id": "9c94a4e1-a569-37ef-8a1b-545fa20f8366",
                        "glosses": [
                            "Liste de tâches ou de vérifications à effectuer."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "9e6ed9e9-40ab-4d1a-aa3f-0697f131740e",
                                "sense_id": "774ccd29-188c-3591-ad37-faf6b60b38ca",
                                "text": "Benjamin prit place dans la bulle, à côté du pilote, ajusta son casque de vol et régla le laryngophone, pendant que le second maître, un happeur gainé de plastique transparent à la main, finissait d'égrener sa check-list avant le départ."
                            },
                            {
                                "example_id": "62005c80-5b12-4a84-bdc5-efa1cbb3ca29",
                                "sense_id": "774ccd29-188c-3591-ad37-faf6b60b38ca",
                                "text": "Dans sa tête, une check-list commençait à se mettre en place."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "539a06e6-5307-4c30-a2a6-74eb3c15b374",
                        "source_entry_id": "9c94a4e1-a569-37ef-8a1b-545fa20f8366",
                        "source_sense_id": "774ccd29-188c-3591-ad37-faf6b60b38ca",
