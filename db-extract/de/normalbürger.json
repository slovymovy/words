                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c488aa-cd55-4948-85d7-e71444ca4cbd",
                                "sense_id": "5b187809-b9a0-340c-ac37-c6e209f2fde1",
                                "text": "„Auch der Normalbürger kann sich dort über seine Themen umfassend informieren, neue Werke und Gattungen kennenlernen.“"
                            },
                            {
                                "example_id": "74e19bb5-0bd8-47b1-bc9d-33d49b0f65de",
                                "sense_id": "5b187809-b9a0-340c-ac37-c6e209f2fde1",
                                "text": "„Früher ließen die Yakuza die Normalbürger in Ruhe, doch das ist lange her.“"
                            }
                        ],
