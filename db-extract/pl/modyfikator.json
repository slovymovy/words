                        "translation_id": "ec33e17c-188f-4f1d-a858-3ca0ee084530",
                        "source_entry_id": "808ee769-3645-3480-acaf-0e7aa3d73165",
                        "source_sense_id": "982e91d4-84e0-37ba-97ef-a5d7d99e0597",
                        "target_lang_word": "модификатор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "модификатор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9e620b-e94d-37d6-9ac2-c7833e57174d",
                                        "entry_id": "58cf2fed-7d0f-3801-bf6e-f6001ea163f0",
                                        "glosses": [
                                            "спец. то, что изменяет состав, структуру, функцию чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4120de-6c1f-4c2d-a5f3-d28062b5ec29",
                                                "sense_id": "fd9e620b-e94d-37d6-9ac2-c7833e57174d",
                                                "text": "Они соединены со вселенной исключительно через трубу информационного терминала, прокачивающего сквозь их мозги поток ментальных химикатов, удобрений и модификаторов, производимых политтехнологами."
                                            },
                                            {
                                                "example_id": "9327e379-1e94-4a1c-a5ed-afef36e4f94c",
                                                "sense_id": "fd9e620b-e94d-37d6-9ac2-c7833e57174d",
                                                "text": "Модификатор значения."
                                            },
                                            {
                                                "example_id": "fd3c229a-dad3-4647-b901-f12dcdd2417f",
                                                "sense_id": "fd9e620b-e94d-37d6-9ac2-c7833e57174d",
                                                "text": "Модификатор структуры металла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "356185ec-2554-364e-a06e-452717a75a6c",
                                        "entry_id": "58cf2fed-7d0f-3801-bf6e-f6001ea163f0",
                                        "glosses": [
                                            "комп. информ. преобразователь (параметры, формула, программное приложение) моделей при 3D-моделировании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6498170a-0fd9-433b-a6d1-a2456a1840f1",
                                                "sense_id": "356185ec-2554-364e-a06e-452717a75a6c",
                                                "text": "Если в запросе один тип объекта используется в различных ролях, то применяется числовой модификатор."
                                            },
                                            {
                                                "example_id": "2c735154-c36c-4662-b0d1-50ace28aed9a",
                                                "sense_id": "356185ec-2554-364e-a06e-452717a75a6c",
                                                "text": "Можно перемещать, вращать и масштабировать подобъект Gizmo, тем самым изменяя его воздействие на объект; y Center (Центр) — точка или ось, относительно которой действует модификатор."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
