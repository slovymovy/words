                                        "glosses": [
                                            "A rhetorical device or element in which a speaker or writer retracts a word that has been spoken and substitutes a stronger or more suitable word; often done for emphasis or sarcasm."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
