                        "glosses": [
                            "Empanner rapidement en essayant de garder le maximum de vitesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5878ad6-8bd4-4ace-bfa7-7db97eefdf6c",
                                "sense_id": "db3b72b8-dd08-3dff-a7c0-0c07149fe50f",
                                "text": "J’ai fait une erreur à Madère : au lieu d’aller chercher une aile de mouette à l’ouest de Madère, j’ai jibé."
                            },
                            {
                                "example_id": "9fe7efc1-9c7d-4531-be71-26eccb7b982e",
                                "sense_id": "db3b72b8-dd08-3dff-a7c0-0c07149fe50f",
                                "text": "Comment apprendre à jiber."
                            },
                            {
                                "example_id": "8faf6f8a-b4d4-4712-8d86-a0519c9afc79",
                                "sense_id": "db3b72b8-dd08-3dff-a7c0-0c07149fe50f",
                                "text": "Manœuvrer la planche avec de la vitesse et jiber."
                            }
                        ]
                    }
