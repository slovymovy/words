                        "glosses": [
                            "benaming van het teken waarmee een onderdeel van een opsomming wordt aangegeven: •"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "884cad56-273d-493b-815c-3b85a52a08c3",
                                "sense_id": "db62910e-b1c8-33aa-a813-75793e5d984f",
                                "text": "De gedachte erachter is dat de essentie van de tekst in het origineel moeilijk te vatten is; Van Hooff gebruikt zelfs bullets om de soms wat kronkelige inhoud te ontwarren."
                            },
                            {
                                "example_id": "d282ac65-7bf2-4a8f-8cc7-93dce0d28e4f",
                                "sense_id": "db62910e-b1c8-33aa-a813-75793e5d984f",
                                "text": "Bij elk trefwoord vinden we wat grammaticale informatie (lidwoord, meervoud, hoofdtijden, soms de woordsoort), de betekenissen (voorafgegaan door een bullet (•), zo heet dit teken in dit boek), eventueel een citaat uit de Vlaamse pers (met bronvermelding) als illustratie en heel af en toe een afbeelding van een advertentie of een stukje krantenartikel."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a77b3c6-ecc9-308d-bb48-fb107890caa6",
                        "entry_id": "eba964f8-2216-3981-b5a9-3646ed38772a",
                        "glosses": [
                            "onderdeel van een reeks te behandelen onderwerpen"
                        ],
                        "tags": [
