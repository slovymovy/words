                "senses": [
                    {
                        "sense_id": "20899608-d6c6-3d76-8ff0-2762aef97080",
                        "entry_id": "b04aa261-1176-362a-b227-c2741cfad058",
                        "glosses": [
                            "глядеть на себя в зеркало, рассматривать своё отражение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edb63b3-7c72-4c89-9ed6-d553417a5ef5",
                                "sense_id": "20899608-d6c6-3d76-8ff0-2762aef97080",
                                "text": "Мария любила смотреться на себя в зеркало: ей нравилось разглядывать своё лицо, изящный макияж на светлой коже, бережно уложенные светлые волосы."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab6dba80-337b-3880-91a8-748dd1f58fb0",
                        "entry_id": "b04aa261-1176-362a-b227-c2741cfad058",
                        "glosses": [
                            "выглядеть, производить определённое зрительное впечатление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89deb91a-1fe9-4ad5-9087-c9a6a5a6052e",
                                "sense_id": "ab6dba80-337b-3880-91a8-748dd1f58fb0",
                                "text": "Старый дом, впрочем, смотрелся вполне респектабельно."
                            }
                        ]
                    },
