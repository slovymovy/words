                        "glosses": [
                            "Internaliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "854766ca-b8ac-4127-8298-1e1d6134de00",
                                "sense_id": "103c4030-f60f-3f04-b399-017e27e62003",
                                "text": "En cas d'échec d'une opération d'infogérance, la tentation est grande de réinternaliser."
                            },
                            {
                                "example_id": "12f2e149-e4f1-48fe-846d-8bda2b8eba40",
                                "sense_id": "103c4030-f60f-3f04-b399-017e27e62003",
                                "text": "Il faudra aussi toujours activer le chiffrement, réinternaliser/désexternaliser les données, par exemple les commentaires, ne pas empêcher les utilisateurs de protéger leur vie privée, et plein d’autres choses."
                            }
                        ]
