        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ada0ed17-ef5c-36a4-a111-46468ded4bec",
                    "sense_definition": "To take part in a trip or organized journey; to travel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "journey_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>expeditioned</w> through the remote valleys for several weeks.",
                            "target_lang_translations": {
                                "ru": "Они <w>путешествовали с экспедицией</w> по отдаленным долинам в течение нескольких недель.",
                                "zh": "他们在偏远的山谷中<w>探险</w>了几个星期。",
                                "es": "Ellos <w>hicieron una expedición</w> por los valles remotos durante varias semanas.",
                                "tr": "Birkaç hafta boyunca uzak vadilerde <w>keşif gezisi yaptılar</w>.",
                                "de": "Sie <w>unternahmen</w> mehrere Wochen lang <w>Expeditionen</w> durch die abgelegenen Täler."
                            }
                        },
                        {
                            "text": "The researchers <w>expeditioned</w> to the island to study its wildlife.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>отправились в экспедицию</w> на остров для изучения его дикой природы.",
                                "zh": "研究人员<w>考察</w>了该岛，以研究其野生动物。",
                                "es": "Los investigadores <w>hicieron una expedición</w> a la isla para estudiar su vida silvestre.",
                                "tr": "Araştırmacılar yaban hayatını incelemek için adaya <w>sefer düzenlediler</w>.",
                                "de": "Die Forscher <w>reisten</w> auf <w>Expedition</w> zur Insel, um deren Tierwelt zu studieren."
                            }
