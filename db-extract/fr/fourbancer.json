                "senses": [
                    {
                        "sense_id": "96cfe687-b37e-3d5f-a87a-6d916591187d",
                        "entry_id": "5549043d-37bc-3354-abf5-a197228f3eba",
                        "glosses": [
                            "Bricoler, faire des petits travaux de manière inefficace."
                        ],
                        "tags": [
                            "Ouest et Centre"
                        ],
                        "examples": [
                            {
                                "example_id": "f04e41d3-3dda-4c1f-ab49-0dd01e02481f",
                                "sense_id": "96cfe687-b37e-3d5f-a87a-6d916591187d",
                                "text": "L'été , les réveils étaient exquis ; je fourbançais dans la chambre , en manches de chemise , fumant ma première pipe dont la fumée s'envolait dans un blond rayon de soleil, …"
                            }
                        ]
                    },
                    {
                        "sense_id": "84c9043a-7a87-3770-bf64-fa428f369734",
                        "entry_id": "5549043d-37bc-3354-abf5-a197228f3eba",
                        "glosses": [
                            "Manigancer."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2743c53c-0e15-4755-b078-649aad30c4e4",
                                "sense_id": "84c9043a-7a87-3770-bf64-fa428f369734",
                                "text": "… par exemple, où il est là, dans son coin, à marmotter et à gesticuler pour lui seul, savez-vous ce qu'il fourbance ? Eh bien! il étudie."
                            }
                        ]
                    }
