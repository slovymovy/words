                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navy <w>appareled</w> the ships to fight in the coming war.",
                            "target_lang_translations": {
                                "ru": "Флот <w>снарядил</w> корабли для участия в грядущей войне.",
                                "de": "Die Marine <w>rüstete</w> die Schiffe <w>aus</w>, um im bevorstehenden Krieg zu kämpfen."
                            }
