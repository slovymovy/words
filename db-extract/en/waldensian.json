                    {
                        "translation_id": "8d07c4fd-96f2-491b-a78c-77e160800edb",
                        "source_entry_id": "fc676a98-3479-3d46-8294-a46d21a95a02",
                        "source_sense_id": "fb432138-3a62-3f29-94e6-c5a005a2e0b9",
                        "source_sense_description": "one who holds the doctrines of the Waldenses",
                        "target_lang_word": "Waldenser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldenser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43d5df11-3ba3-3eaf-98f8-4da1840eef26",
                                        "entry_id": "377e6d54-5053-3771-9d75-938aa8d49751",
                                        "glosses": [
                                            "Anhänger einer protestantisch reformierten Kirche, die das Evangelium verkündet und ein urchristliches Gemeinschaftsleben in Armut anstrebt, insbesondere in Italien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b185dd92-000f-4fb1-805e-f4b3aab95d34",
                                                "sense_id": "43d5df11-3ba3-3eaf-98f8-4da1840eef26",
                                                "text": "Die Waldenser wurden von der katholischen Kirche als Ketzer verfolgt."
                                            },
                                            {
                                                "example_id": "e1f86f8c-234a-4476-b1c0-00d849a3acb5",
                                                "sense_id": "43d5df11-3ba3-3eaf-98f8-4da1840eef26",
                                                "text": "Ein Waldenser ist ein Angehöriger einer Laienbewegung."
                                            },
                                            {
                                                "example_id": "9c252ba3-adab-4659-bdb8-9664573c49df",
                                                "sense_id": "43d5df11-3ba3-3eaf-98f8-4da1840eef26",
                                                "text": "„Da die Hussiten etwa zwei Jahrzehnte lang imstande waren, ihr Land gegen katholische Kreuzzugsheere zu verteidigen, brauchten die Waldenser, die sich unter das Dach der hussitischen Kirche geflüchtet hatten, zumindest in dieser Zeit die Inquisition nicht mehr zu fürchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
