{
    "word_family": [
        "haggle",
        "haggler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b384f1a-30c1-3aba-ae76-fdeacd37464c",
                    "sense_definition": "The act of negotiating the price of something in a persistent or petty way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of <w>haggling</w>, we finally agreed on a price for the antique table.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов <w>торга</w> мы наконец договорились о цене на антикварный стол.",
                                "nl": "Na uren van <w>afdingen</w> werden we het eindelijk eens over een prijs voor de antieke tafel."
                            }
                        },
                        {
                            "text": "The constant <w>haggling</w> over small details made the business meeting last much longer than expected.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>торг</w> из-за мелких деталей заставил деловую встречу длиться гораздо дольше, чем ожидалось.",
                                "nl": "Het constante <w>gesteggel</w> over kleine details zorgde ervoor dat de zakelijke bijeenkomst veel langer duurde dan verwacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "bargaining",
                        "bartering"
                    ],
                    "common_phrases": [
                        "intense haggling",
                        "endless haggling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс упорного или мелочного торга о цене чего-либо.",
                        "nl": "Het proces van aanhoudend of kleingeestig onderhandelen over de prijs van iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торг",
                                "target_lang_sense_clarification": "процесс обсуждения цены"
                            },
                            {
                                "target_lang_word": "торговля",
                                "target_lang_sense_clarification": "процесс спора о стоимости"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "afdingen",
                                "target_lang_sense_clarification": "het proces van onderhandelen over de prijs"
                            },
                            {
                                "target_lang_word": "pingelen",
                                "target_lang_sense_clarification": "informeel onderhandelen over kleine bedragen"
                            },
                            {
                                "target_lang_word": "marchanderen",
                                "target_lang_sense_clarification": "formeel of figuurlijk onderhandelen of schipperen"
                            }
                        ]
                    }
                }
            ]
        },
