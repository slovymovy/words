                    },
                    {
                        "translation_id": "19a650c6-5d95-4132-98c0-c07c7fd8ddad",
                        "source_entry_id": "53944444-bbf3-3fb9-8f8b-2eb454869d4e",
                        "source_sense_description": "начинать действовать враждебно по отношению к кому-либо, чему-либо; выступать с резкой критикой, нападками",
                        "target_lang_word": "losziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "losziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "286c8c31-73d4-38fb-87bb-6368563b5335",
                                        "entry_id": "a06dce2f-ca08-3976-b7a2-d6fb52b1d6cb",
                                        "glosses": [
                                            "zu einer gemeinsamen amüsanten Unternehmung aufbrechen"
                                        ],
                                        "tags": [
                                            "intransitiv, umgangssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a53ff7e-510c-45a8-8297-610d16a50e7e",
                                                "sense_id": "286c8c31-73d4-38fb-87bb-6368563b5335",
                                                "text": "Bei der Verleihung der Emmy Awards am Montagabend klärte er die Journalisten über den Stand der Dinge auf: „Sie sind einfach losgezogen und haben geheiratet und ich weiß nicht, wo das Problem liegt.“"
                                            },
                                            {
                                                "example_id": "4085a4c3-090e-4dd1-b991-08b3bfc3698f",
                                                "sense_id": "286c8c31-73d4-38fb-87bb-6368563b5335",
                                                "text": "Der Pensionist aus dem Bezirk Linz-Land war am Montag zum Pilzesammeln in den Wald gefahren, hatte sein Auto neben der Fahrbahn abgestellt und war zu Fuß losgezogen."
                                            },
                                            {
                                                "example_id": "d9cfbdf8-1852-4568-9067-21800fdc7733",
                                                "sense_id": "286c8c31-73d4-38fb-87bb-6368563b5335",
                                                "text": "Mit seinem Großvater ist er als Kind losgezogen um das Hirscherufen zu lernen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91aa1e5c-5d79-3a72-bff1-95a977e3d173",
                                        "entry_id": "a06dce2f-ca08-3976-b7a2-d6fb52b1d6cb",
                                        "glosses": [
                                            "sich über jemanden oder etwas schimpfend äußern"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dba886b-d6ab-4387-a17e-eaee1cbdfb44",
                                                "sense_id": "91aa1e5c-5d79-3a72-bff1-95a977e3d173",
                                                "text": "Es waren Laien, welche schon bisher jene Beschwerden auch in Betreff kirchlicher Dinge auf Reichstagen vorgebracht hatten und welche jetzt in Flugschriften gegen kirchliche Verderbnisse und Bedrückungen loszogen."
                                            },
                                            {
                                                "example_id": "4e9fd1c8-1247-4c89-818a-d3e4a0b0193c",
                                                "sense_id": "91aa1e5c-5d79-3a72-bff1-95a977e3d173",
                                                "text": "Seine Kollegen fingen indessen an über ihn loszuziehen, denn sie hielten die Kur für Quacksalberei und machten das Publikum ahnden, daß er ein großer Scharlatan sein, und werden würde."
                                            },
                                            {
                                                "example_id": "627a126b-578d-4c46-9a9d-444056750d07",
                                                "sense_id": "91aa1e5c-5d79-3a72-bff1-95a977e3d173",
                                                "text": "Ueberaus ungeduldig wurde er, wenn die englischen Zeitungen gegen ihn loszogen; diese merkten sich dies aber gar wohl und sparten nichts, was ihn ärgern konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
