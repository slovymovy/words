                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2748a3bd-9fcc-43a1-ac8c-b46965d78010",
                                "sense_id": "b2980999-aa1f-3776-9ce8-058b8174e4a9",
                                "text": "Een slordige honderd onbewoonde eilanden worden geëxploiteerd als hotel. Als vuistregel geldt: één eiland, één resort, iets wat de Malediven een unieke en daarmee ook populaire vakantiebestemming maakt."
                            },
                            {
                                "example_id": "368002d6-d908-4674-848c-d3c896928ef7",
                                "sense_id": "b2980999-aa1f-3776-9ce8-058b8174e4a9",
                                "text": "Thailand is een steeds meergekozen vakantiebestemming."
                            },
                            {
                                "example_id": "676a271c-fcc8-4dd1-aa5b-bc86812147f1",
                                "sense_id": "b2980999-aa1f-3776-9ce8-058b8174e4a9",
                                "text": "Vluchten naar de populairste vakantiebestemmingen in Zuid-Europa mogen van de werkgroep blijven (ook als er maar weinig handel mee wordt gedreven), net als een aantal bestemmingen in landen waarmee Nederland een speciale band heeft, zoals Suriname, Curaçao en Indonesië."
                            }
                        ]
                    }
