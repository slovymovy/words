                "senses": [
                    {
                        "sense_id": "b45ef2c1-682f-3da2-8e23-9f275296d367",
                        "entry_id": "459e1891-5136-3121-a4d7-a7fbe994ba4c",
                        "glosses": [
                            "Gebet zu einer Weihe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f98b1b-b9ab-4a94-b902-06139134bdf4",
                                "sense_id": "b45ef2c1-682f-3da2-8e23-9f275296d367",
                                "text": "„Der Bischof breitet die Hände aus und singt oder spricht, während die Weihekandidaten vor ihm knien, das Weihegebet.“"
                            },
                            {
                                "example_id": "73681e89-3aee-4cfb-92e0-7786af3754fd",
                                "sense_id": "b45ef2c1-682f-3da2-8e23-9f275296d367",
                                "text": "„Das Sakrament der Weihe gliedert sich in drei Stufen: die Weihe zum Diakon, die Weihe zum Priester und die Weihe zum Bischof. In allen drei Weihestufen wird das Sakrament durch die schweigende Handauflegung und durch das Weihegebet gespendet.“"
                            },
                            {
                                "example_id": "3427167c-cd61-4656-b101-d51ad57a9284",
                                "sense_id": "b45ef2c1-682f-3da2-8e23-9f275296d367",
                                "text": "„Bei der Bischofsweihe wird dem neugeweihten Bischof das Haupt gesalbt. Danach erhält er das Evangelienbuch als Zeichen seiner Verkündigungsvollmacht überreicht, welches beim Weihegebet über sein Haupt gehalten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
