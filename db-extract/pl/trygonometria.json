                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff1e4c65-a7d3-4683-b85a-5c0d3cf4d92d",
                        "source_entry_id": "a30cf6da-fe5e-3ace-8cd3-42cfdaa733a7",
                        "source_sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                        "target_lang_word": "trigonométrie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigonométrie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                        "entry_id": "e7b2e0a1-c3fb-3035-8d26-c58400fa05c7",
                                        "glosses": [
                                            "Méthode de calcul relative aux éléments du triangle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4228c0e-5f07-4cb3-b3a5-31233b305923",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "Trigonométrie rectiligne, celle qui est relative aux triangles rectilignes."
                                            },
                                            {
                                                "example_id": "a077efba-773c-4106-8f04-3d74ee092461",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "Trigonométrie sphérique, celle qui enseigne à calculer les triangles sphériques."
                                            },
                                            {
                                                "example_id": "83d2bc43-eeaa-4f06-94df-edb5463f011a",
                                                "sense_id": "c14719c5-6782-344e-8c86-393d01dc8194",
                                                "text": "La trigonométrie est de la plus grande nécessité dans la pratique ; c’est par son secours qu’on vient à bout de la plûpart des opérations de la géométrie pratique, & de l’astronomie. Sans cette science nous ignorerions encore la circonférence de la terre, les distances & les mouvemens des astres ; nous ne pourrions point prédire leurs éclipses, &c."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d1ef8ad-34a9-4a23-a3cd-efe594ef481d",
                        "source_entry_id": "a30cf6da-fe5e-3ace-8cd3-42cfdaa733a7",
                        "source_sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                        "target_lang_word": "Trigonometrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trigonometrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                        "entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                                        "glosses": [
                                            "Teilgebiet, das sich mit der Berechnung und Bestimmung der fehlenden unbekannten Größen (Winkel, Seitenlängen) eines gegebenen Dreiecks beschäftigt"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b787eec3-e378-4b5c-bd25-83c5195815b9",
                                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                                "text": "Während die klassische Geometrie mit algebraischen Funktionen operiert, arbeitet die Trigonometrie mit transzendenten Funktionen."
                                            },
                                            {
                                                "example_id": "cae3c0ea-8c42-4c6c-b1a3-966de457b636",
                                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                                "text": "in der (Anwendung der) Trigonometrie benutzte man in den sechziger Jahren noch Tabellenwerke anstelle der heute üblichen Taschenrechner mit trigonometrischen Funktionen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
