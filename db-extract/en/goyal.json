                "senses": [
                    {
                        "sense_id": "ea936adb-aa2e-3d5c-9f58-1f41c86dc373",
                        "entry_id": "a3138a0a-68f9-3829-af37-21a7c3bd9338",
                        "glosses": [
                            "Alternative form of goyle."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "2cef7bcf-49b4-4404-b0b5-e44304d15366",
                                "sense_id": "ea936adb-aa2e-3d5c-9f58-1f41c86dc373",
                                "text": "’Twas thrown in a goyal of thick bushes, four hundred paces from the road. But he who found it saw a glint of the brass, amid the leaves."
                            },
                            {
                                "example_id": "5eb39c7f-b6fb-4be1-a7f3-d44007e4dc24",
                                "sense_id": "ea936adb-aa2e-3d5c-9f58-1f41c86dc373",
                                "text": "We were come to a long deep “goyal,” as they call it on Exmoor, a word whose fountain and origin I have nothing to do with."
                            },
                            {
                                "example_id": "8558062a-7ad1-4dc4-bccf-e9c3b189493c",
                                "sense_id": "ea936adb-aa2e-3d5c-9f58-1f41c86dc373",
                                "text": "These, though known for their valour and their breed, were whimpering in a cluster at the head of a deep dip or goyal, as we call it, upon the moor, some slinking away and some, with starting hackles and staring eyes, gazing down the narrow valley before them. \"The company had come to a halt, more sober men, as you may guess, than when they started. The most of them would by no means advance, but three of them, the boldest, or it may be the most drunken, rode forward down the goyal."
                            }
                        ]
                    }
