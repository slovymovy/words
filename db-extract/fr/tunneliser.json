                                "sense_id": "8ab03ae5-587c-3cdf-b06e-079755a875c4",
                                "text": "Comment tunneliser le tout vers un autre proxy ?"
                            },
                            {
                                "example_id": "801ff0a4-6dd9-403b-aec2-f8076f415da4",
                                "sense_id": "8ab03ae5-587c-3cdf-b06e-079755a875c4",
                                "text": "De toute facon, de nos jours c’est de plus en plus recommandé de tunneliser et d’encrypter tout."
                            },
                            {
                                "example_id": "043240be-a9a6-4fab-ac5f-14cc574c4832",
                                "sense_id": "8ab03ae5-587c-3cdf-b06e-079755a875c4",
                                "text": "Il permet de tunneliser et/ou proxyser des connexions TCP ou UDP via un tunnel chiffré."
                            }
                        ]
