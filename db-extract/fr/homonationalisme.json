                                "example_id": "5f5c32ca-47ad-455e-8959-200872c66d37",
                                "sense_id": "7ef5b288-b32b-38a0-b6bb-2bb1dff689a7",
                                "text": "Derrière ces manifestations d'homonationalisme, il y a le problème de l'universalisme occidental qui voudrait imposer ses valeurs."
                            }
                        ]
                    }
                ],
