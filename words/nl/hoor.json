                                "ru": "Ты тоже <w>слышишь</w> этот странный звук в коридоре?",
                                "it": "<w>Senti</w> anche tu quello strano rumore nel corridoio?"
                            }
                        },
                        {
                            "text": "Misschien <w>hoor</w> je het nieuws morgen wel op de radio.",
                            "target_lang_translations": {
                                "en": "Maybe you will <w>hear</w> the news on the radio tomorrow.",
                                "ru": "Может быть, завтра ты <w>услышишь</w> новости по радио.",
                                "it": "Forse <w>sentirai</w> la notizia domani alla radio."
                            }
                        }
                    ],
                    "target_lang_definitions": {
