                "senses": [
                    {
                        "sense_id": "84ed20a3-4db4-38b1-b070-7aaa4b972f1d",
                        "entry_id": "c0bd9430-383f-3d05-803e-82543ab707c5",
                        "glosses": [
                            "Stadt in Kolumbien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323b8d1e-eb72-444c-b094-f1e455d01b95",
                                "sense_id": "84ed20a3-4db4-38b1-b070-7aaa4b972f1d",
                                "text": "„Die Amerikaner schätzten die jährliche Gesamtmenge auf fünf- bis sechshundert Kilo, als die Polizei 1975 in Cali auf über sechshundert Kilo in einem einzigen Flugzeug stieß.“"
                            },
                            {
                                "example_id": "17ea1b4a-afe7-4c29-9a46-03c515a6e4de",
                                "sense_id": "84ed20a3-4db4-38b1-b070-7aaa4b972f1d",
                                "text": "„Wann warst du das letzte Mal in Cali?“"
                            },
                            {
                                "example_id": "177e1a25-abf7-4077-ae0d-168af43758bf",
                                "sense_id": "84ed20a3-4db4-38b1-b070-7aaa4b972f1d",
                                "text": "„In Kolumbien trugen die rivalisierenden Kartelle von Cali und Medellín einen offenen Kampf um die Kontrolle des Kokainhandels und der Transportrouten aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
