                "senses": [
                    {
                        "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                        "entry_id": "0c39d3b9-cc9d-3f10-b2ca-dff4cedbfcf4",
                        "glosses": [
                            "selbst angetriebenes Straßenfahrzeug mit körperlich hohem Plasteanteil"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "b1aaa421-a417-4862-9954-fb9f0065b128",
                                "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                                "text": "„Vor allem die Franzosen, Engländer und Amerikaner liebten Plastikautos.“"
                            },
                            {
                                "example_id": "90db60a5-7875-4d82-b1e7-014cfefbd296",
                                "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                                "text": "„Modellbau: Vom Plastikauto bis zum Prototyp.“"
                            },
                            {
                                "example_id": "15530852-6d00-4510-b360-d119910e5da0",
                                "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                                "text": "„Ein Plastikauto! Stimmt, aber eines mit Pfeffer unter der Haube. Mit dem “ForFour” wollte sich Smart 2004 ein weiteres Standbein im Kleinwagenmarkt schaffen. Das Experiment wurde nach knapp zwei Jahren wegen Erfolglosigkeit eingestellt.“"
                            },
                            {
                                "example_id": "7eb6a4f3-525a-4966-8ef4-40b7c363e4c7",
                                "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                                "text": "„Fahren wir also bald Plastikautos? \"Dass ganz auf Metall verzichtet werden kann, ist kaum vorstellbar\", sagt Chemie-Professor Martin Möller von der RWTH Aachen.“"
                            },
                            {
                                "example_id": "ae7427ee-4b89-46b1-a4ca-ad0a89c136af",
                                "sense_id": "e23a15fd-c991-3a90-b5cb-975ba2a333b6",
                                "text": "„Plastikauto mit Charme - 1991: Der letzte Trabant läuft vom Band.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                        "entry_id": "0c39d3b9-cc9d-3f10-b2ca-dff4cedbfcf4",
                        "glosses": [
                            "Spielzeug oder kleines Fahrzeug aus Plaste für Kinder, das wie [1] aussieht"
                        ],
                        "tags": [
                            "Spiel"
                        ],
                        "examples": [
                            {
                                "example_id": "c93594d5-5236-42b2-89fa-93aa365f0c24",
                                "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                                "text": "„40 Jahre Bobby-Car - Ein rotes Plastikauto erobert die Welt.“"
                            },
                            {
                                "example_id": "ce864c76-b6f8-4f99-8f54-e3d64e245cfb",
                                "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                                "text": "„In der klassischen Ausführung ein rotes, knapp 60 Zentimeter langes und 40 Zentimeter hohes vierrädriges Plastikauto.“"
                            },
                            {
                                "example_id": "390ffc94-2e2d-411c-8d2f-a6a572a9e8f6",
                                "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                                "text": "„Rechts ein kleines Plastikauto aus meiner eigenen Sammlung aus den frühen 60er Jahren. Den Hersteller konnte ich allerdings nicht identifizieren. Mittlerweile werden auch diese frühen Plastikautos von Sammlern gesucht.“"
                            },
                            {
                                "example_id": "54838ce4-07f1-430d-bcc8-44383821c4b4",
                                "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                                "text": "„Plastikauto mit Werbeaufdruck der Firma Hammer aus Lüdenscheid “"
                            },
                            {
                                "example_id": "6b2303cb-48c5-49f2-9b1a-1517e6d47742",
                                "sense_id": "a54a0097-f2c3-30e7-ac71-ebc70334f2d4",
                                "text": "„Miguel (2J.) untersucht derweil lieber sein rotes Plastikauto.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
