                "senses": [
                    {
                        "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                        "entry_id": "ebefd2b7-5c5d-3637-9813-913cac58f9ad",
                        "glosses": [
                            "Großstadt in Afghanistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affed724-6a23-4830-ada5-c9bd01050f65",
                                "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                                "text": "„Auf eigenen Wunsch hin wurde er im Garten seines Hauses im afghanischen Jalalabad beigesetzt.“"
                            },
                            {
                                "example_id": "323ac95f-8b8d-4767-abea-aca6a8c24bf4",
                                "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                                "text": "„So richteten sie Besatzungseinheiten in Ghazni, Kandahar, Jalalabad, Charikar und Bamyan ein.“"
                            },
                            {
                                "example_id": "f13e06f5-64e3-4978-83db-91815cc817fd",
                                "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                                "text": "„Vor dem Einnicken hatte er sich Hammonds Satellitentelefon geliehen, um Pete Grauer in Jalalabad zu kontaktieren und ihm den Stand der Dinge mitzuteilen.“"
                            },
                            {
                                "example_id": "a50b10bb-e840-4ad5-b228-15b0b96f557a",
                                "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                                "text": "„Er erholte sich dort von einer Verletzung am Bauch durch Granatsplitter, die ihn in Jalalabad getroffen hatten.“"
                            },
                            {
                                "example_id": "4ec636d6-8848-49d9-89ee-e2345f354337",
                                "sense_id": "b98bda22-c892-32ad-81bd-2f3741c04801",
                                "text": "„Im Osten, an der Grenze zu Pakistan, gab es drei Paschtunen-Provinzen unter der unabhängigen Kontrolle eines Rats (Schura) von Mudschaheddin-Befehlshabern mit Sitz in Jalalabad.“"
                            }
                        ],
