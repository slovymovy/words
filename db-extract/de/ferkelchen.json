                        "examples": [
                            {
                                "example_id": "01a8dfb6-92ed-42aa-8d94-9df576ae8178",
                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                "text": "Ich sah ein Ferkelchen auf dem Bauernhof meines Großonkels herumlaufen."
                            },
                            {
                                "example_id": "9c683827-409f-4ab3-b397-a923cf3e7f07",
                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                "text": "„Mit vielen schönen Bildern von Zuchtbullen und süßen Ferkelchen will die Grüne Woche in Berlin die Verbraucher von einer gesunden Landwirtschaft überzeugen.“"
                            },
                            {
                                "example_id": "4baf9e5c-c2f0-4d5d-8e1a-20e85b694961",
                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                "text": "„Heimlicher Hauptdarsteller ist übrigens Ferkelchen, das Hausschwein der von Tausendschlags.“"
                            },
                            {
                                "example_id": "1955b97c-6148-41b2-8b45-4b4454feb9e8",
                                "sense_id": "2b706b22-b5fa-33e3-9764-e476afec40c5",
                                "text": "„Die Prinzessin, die doch gar zu gern das Ferkelchen gehabt hätte, ließ dem Jungen seinen Willen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
