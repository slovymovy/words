                                            {
                                                "example_id": "14f4518c-c356-4330-9cca-a476510233a0",
                                                "sense_id": "c7c31dc6-f3ea-3a2e-9079-b04e8d692d90",
                                                "text": "Brunel's associations with the area have left a few examples of his handiwork or teaching in South Wales."
                                            },
                                            {
                                                "example_id": "180bbdcb-9743-4d84-b5b1-f4b6dd110aee",
                                                "sense_id": "c7c31dc6-f3ea-3a2e-9079-b04e8d692d90",
                                                "text": "As a primary architect of the draft Constitution that emerged from Philadelphia in 1787, Madison substantially bore the burden of defending his handiwork in his home state."
                                            }
