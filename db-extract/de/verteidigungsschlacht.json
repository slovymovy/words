                "senses": [
                    {
                        "sense_id": "ab2afd3b-4c51-3132-9730-533238075198",
                        "entry_id": "1950aa9c-bbe1-3d4f-8e94-115894d2d29c",
                        "glosses": [
                            "Zum Zwecke der Verteidigung geführte Schlacht"
                        ],
                        "tags": [
                            "Kriegsführung"
                        ],
                        "examples": [
                            {
                                "example_id": "b4bf1a9e-97d6-4d07-a736-fe4c31f239e2",
                                "sense_id": "ab2afd3b-4c51-3132-9730-533238075198",
                                "text": "„So wurde die große Verteidigungsschlacht der Bewohner von Zion komplett am Computer entworfen.“"
                            },
                            {
                                "example_id": "fbb8da20-147c-4da1-817c-25bce66b62d1",
                                "sense_id": "ab2afd3b-4c51-3132-9730-533238075198",
                                "text": "„Mit ihrer Aktion im Mai greifen chinesische Hacker nun zum sechsten Mal in einer von ihnen so genannten virtuellen Verteidigungsschlacht ausländische Web-Seiten an.“"
                            },
                            {
                                "example_id": "d89c13e2-de67-45d7-81ff-e154ce205a5f",
                                "sense_id": "ab2afd3b-4c51-3132-9730-533238075198",
                                "text": "„Nach dem Dammbruch der Erregung hat das Immunsystem der Vernunft erst einmal jede Verteidigungsschlacht verloren.“"
                            },
                            {
                                "example_id": "42c341a5-099d-46e3-809f-b0fa323cfbf2",
                                "sense_id": "ab2afd3b-4c51-3132-9730-533238075198",
                                "text": "„Joschka Fischer hat sich längst in die höheren Gefilde des Welt-Staatsmanns verabschiedet und glänzt in den Verteidigungsschlachten um Hartz IV durch auffällige Abwesenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
