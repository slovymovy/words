                "senses": [
                    {
                        "sense_id": "a88bc337-8a1a-313d-a375-85942ff9206b",
                        "entry_id": "b991cffb-c0f2-327a-9097-ca5ffad81acc",
                        "glosses": [
                            "Laut, der durch Reibung mittels Verengung des Artikulationskanals erzeugt wird. Eine besondere Untergruppe sind die so genannten Zischlaute (Sibilanten) wie [s] und [z]."
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "6241c98f-6002-4e8d-967d-1f2157695cc5",
                                "sense_id": "a88bc337-8a1a-313d-a375-85942ff9206b",
                                "text": "[f] in dem Wort \"Hefe\" ist ein Reibelaut."
                            },
                            {
                                "example_id": "d7a52f7c-9941-46c9-8ef3-4cfdf0d49f66",
                                "sense_id": "a88bc337-8a1a-313d-a375-85942ff9206b",
                                "text": "„Die Substitutionen der Reibelaute lassen sich noch immer zu 79 % mit der Anwendung jeweils nur eines phonologischen Prozesses beschreiben (...).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
