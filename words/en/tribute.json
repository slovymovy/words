                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдавать или платить что-либо в знак уважения или подчинения.",
                        "tr": "Saygı veya boyun eğme işareti olarak bir şey sunmak veya ödemek.",
                        "zh": "作为尊重或顺从的标志而给予或支付某物。"
                    },
                    "translations": {
