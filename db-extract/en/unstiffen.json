                        "glosses": [
                            "To remove the stiffness from; to relax; to make pliant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f423cdc-db10-4f72-8e7e-fce285ab9c60",
                                "sense_id": "43820aaa-183f-3a99-9fd2-a9b936e09e88",
                                "text": "We stopped here about ten o'clock this morning, and I was so tired and stiff after the long night wedged in tight in the railway carriage that I got out to get some air and unstiffen myself, instinctively clutching my fiddle-case; and a Bavarian officer on the platform, watching the train with some soldiers, saw me and came over to me at once and demanded to see my papers."
                            }
                        ]
