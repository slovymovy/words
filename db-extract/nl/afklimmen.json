        "nl-extract.jsonl": [
            {
                "entry_id": "87703d05-249c-3cf9-9982-dfb4792d13b4",
                "word": "afklimmen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a34239c4-51de-3ceb-9e16-31b3553ace3d",
                        "entry_id": "87703d05-249c-3cf9-9982-dfb4792d13b4",
                        "glosses": [
                            "afdalen waarbij men ook de handen moet gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b5cb24a-1d21-400c-a272-d72ccb43edc8",
                                "sense_id": "a34239c4-51de-3ceb-9e16-31b3553ace3d",
                                "text": "Ik had bij die benoeming van mijn hoge ladder moeten afklimmen, afstand moeten nemen en moeten beseffen dat het niet iedereen is gegeven thuis te raken in dit vak."
                            },
                            {
                                "example_id": "85baa258-f9b7-47ce-89e0-7ffed10bdf11",
                                "sense_id": "a34239c4-51de-3ceb-9e16-31b3553ace3d",
                                "text": "Tijdens de jaarlijkse diploma-uitreikingen blééf Laurens van der Graaff het podium op- en afklimmen; geen docent werd zo vaak door eindexamenkandidaten gevraagd hun 'afscheidspraatje' te verzorgen als hij."
                            },
                            {
                                "example_id": "7de78574-266b-4155-8684-42fdf99ce93d",
                                "sense_id": "a34239c4-51de-3ceb-9e16-31b3553ace3d",
                                "text": "Mag ik een blik op de motor werpen? Ik zei geen ja en geen nee, zelf kon ik alleen de achterbank op en afklimmen en wist niet eens wat je moest doen om een blik op de motor te werpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c84211c-e92b-4f5c-87cc-f26cf40188f8",
                        "source_entry_id": "87703d05-249c-3cf9-9982-dfb4792d13b4",
                        "source_sense_id": "a34239c4-51de-3ceb-9e16-31b3553ace3d",
