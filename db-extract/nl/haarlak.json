                "translations": [
                    {
                        "translation_id": "02500d91-6102-437c-b4be-4fb30c3e6280",
                        "source_entry_id": "812b80c1-b8f7-396b-bbb0-db64eb6d7c07",
                        "source_sense_id": "84b2f95a-db05-398c-90b3-bb7cabd8e1ec",
                        "target_lang_word": "Haarspray",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarspray",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4be40112-04fa-302d-88ec-f125a4f85995",
                                        "entry_id": "db99c1b0-7b9a-3876-9c96-baad3ae0e55a",
                                        "glosses": [
                                            "Spray, mit dem Haare in der gewünschten Form stabilisiert werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98d6cc3-ef7d-4090-9260-11144d1f0abf",
                                                "sense_id": "4be40112-04fa-302d-88ec-f125a4f85995",
                                                "text": "„Auf der anderen Seite sorgen Lockenstab, Papilloten und Unmengen an Haarspray dafür, dass man hin und wieder den Eindruck hat, die Damen wären nicht mit dem Kopf beim Friseur, sondern mit den Fingern in der Steckdose gelandet.“"
                                            },
                                            {
                                                "example_id": "adf3840c-d32a-46c4-b9f7-c22eb983aa88",
                                                "sense_id": "4be40112-04fa-302d-88ec-f125a4f85995",
                                                "text": "„Ich rieche Haarspray und drehe mich um.“"
                                            },
                                            {
                                                "example_id": "e479e7b0-8c00-4620-88d4-2461e01ac685",
                                                "sense_id": "4be40112-04fa-302d-88ec-f125a4f85995",
                                                "text": "„Doch stattdessen bekomme ich nur eine Überdosis Haarspray und verschwinde unter der Chemiewolke, die aus meiner Krause eine glatte Matte macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41bc8f9c-5fc3-4355-86b1-7ed54d7545da",
                        "source_entry_id": "812b80c1-b8f7-396b-bbb0-db64eb6d7c07",
                        "source_sense_id": "84b2f95a-db05-398c-90b3-bb7cabd8e1ec",
