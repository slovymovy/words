                "senses": [
                    {
                        "sense_id": "21d59fb0-4bbf-3a88-85e8-4a0efd22adfb",
                        "entry_id": "b12b9906-ffb1-3400-b936-d35e563a6b00",
                        "glosses": [
                            "Leuchte, bei der im Inneren eine Flüssigkeit auf- und absteigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7945ca7b-12b3-4c6b-947c-e123906d8a10",
                                "sense_id": "21d59fb0-4bbf-3a88-85e8-4a0efd22adfb",
                                "text": "„Eine besonders effektvolle Kategorie von Tischlampen sind die Lavalampen. Dabei handelt es sich um mit Flüssigkeit gefüllte Lampen, die den Aufstieg flüssiger Lava imitieren.“"
                            },
                            {
                                "example_id": "13289191-e170-4347-bf73-db119f8c16b5",
                                "sense_id": "21d59fb0-4bbf-3a88-85e8-4a0efd22adfb",
                                "text": "„Wer eine Weile auf eine Lavalampe starrt, gerät irgendwann in einen psychedelischen Zustand, in dem er nur noch Farben und Formen wahrnimmt und die Zeit vergisst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
