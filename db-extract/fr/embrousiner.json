                "senses": [
                    {
                        "sense_id": "a6416b2e-69fe-3c81-ac2d-9cc9d1808b84",
                        "entry_id": "16505f4d-ecf1-30cd-b9cc-2893cae0014c",
                        "glosses": [
                            "Embrouiller, rendre patraque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509e0511-41d7-4772-ab42-4265f0770f12",
                                "sense_id": "a6416b2e-69fe-3c81-ac2d-9cc9d1808b84",
                                "text": "Les politiques, eux, bien que leur entourage soit aussi dans la panade, ils ne pensent quʼà nous embrousiner avec leurs craques."
                            },
                            {
                                "example_id": "2a8311e6-a604-4097-b9ef-b9901ff71f17",
                                "sense_id": "a6416b2e-69fe-3c81-ac2d-9cc9d1808b84",
                                "text": "Bah oui je tourne autour du pot parce que je me dis que si tu m'as vu j'ai pas à venir t'embrousiner le cerveau avec ça."
                            },
                            {
                                "example_id": "2c742037-1f84-4c39-a9e2-b2c4e913007d",
                                "sense_id": "a6416b2e-69fe-3c81-ac2d-9cc9d1808b84",
                                "text": "J’aime débourronner moins être embrousiné."
                            }
                        ]
                    }
