                        "examples": [
                            {
                                "example_id": "ec6844e4-cb0f-47e1-8187-b75702d0c76f",
                                "sense_id": "3b36c228-eca8-30ed-95c1-d3d78089aeff",
                                "text": "De Spaanse prinses Cristina heeft voor het eerst getuigd in het fraudeproces tegen haar en haar man. Op vragen van haar advocaat antwoordde ze dat haar man over het geld ging."
                            },
                            {
                                "example_id": "56cbfc95-60bc-422b-852a-b39dd9d21fe5",
                                "sense_id": "3b36c228-eca8-30ed-95c1-d3d78089aeff",
                                "text": "Ecclestone had zelf al herhaaldelijk aangegeven dat hij niet van plan is terug te treden. Afgelopen jaar was de Brit wel even ontheven van zijn functie. Dat was ten tijde van een fraudeproces in Duitsland, waar Ecclestone terecht stond voor omkoping. Hij kocht de strafzaak af voor 75 miljoen euro."
                            },
                            {
                                "example_id": "95475e67-aad6-4cd1-b7cb-5cb1acb42a2f",
                                "sense_id": "3b36c228-eca8-30ed-95c1-d3d78089aeff",
                                "text": "Alle 23 verdachten waren aanwezig in de rechtszaal, onder wie een groot aantal ziekenhuisdirecteuren. De verdachten worden beschuldigd van 91 strafbare feiten, waaronder corruptie, het aannemen van steekpenningen en fraude. De Poolse justitie noemt dit fraudeproces \"een zaak zonder precedent\"."
                            }
                        ]
