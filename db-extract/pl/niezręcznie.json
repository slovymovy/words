                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dc56f06-8aaf-4179-9bab-5efd2b481ef7",
                        "source_entry_id": "1300a65a-962f-367d-8438-4276108e63d9",
                        "source_sense_id": "260fc387-709d-339d-8a86-0daf4da4fcc8",
                        "target_lang_word": "clumsily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clumsily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                                        "entry_id": "3762d3c9-e72e-3fa9-a53a-b271e5d81ed0",
                                        "glosses": [
                                            "In a clumsy manner or way; without care or finesse, often hurriedly or awkwardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e387bb-3104-413c-ae85-c06e41debd15",
                                                "sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                                                "text": "But, bowing with sketchily joined hands, they smiled their way clumsily out, down to the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb668680-eabb-429b-ba77-9789ecd93bb8",
                        "source_entry_id": "1300a65a-962f-367d-8438-4276108e63d9",
                        "source_sense_id": "260fc387-709d-339d-8a86-0daf4da4fcc8",
                        "target_lang_word": "lourdement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lourdement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18eb7b32-887d-399f-b66a-89d4dccc6f35",
                                        "entry_id": "df71f91d-f595-35e3-91fd-3b73fb064e03",
                                        "glosses": [
                                            "D’une manière lourde, gauche, sans finesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f180903-6e13-45d6-be5b-04140f5ba618",
                                                "sense_id": "18eb7b32-887d-399f-b66a-89d4dccc6f35",
                                                "text": "Hier matin, vous n'êtes pas allé marcher avec le club, comme tous les mercredis. Comme par hasard, c'est le jour où votre voisin se fait assassiner. Il insista lourdement sur ce dernier mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667dd4a3-31f0-34ec-90d2-4a68176ecb65",
                                        "entry_id": "df71f91d-f595-35e3-91fd-3b73fb064e03",
                                        "glosses": [
                                            "D’une manière qui marque un esprit lourd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf23d3a-623e-4926-b3dc-532c10a2aaf3",
                                                "sense_id": "667dd4a3-31f0-34ec-90d2-4a68176ecb65",
                                                "text": "Le jour naissait. Feempje se dressa sur son séant et ne reprit lourdement ses esprits qu'après quelques minutes."
                                            },
                                            {
                                                "example_id": "0dd205ff-21a1-4f7e-8ed4-e19fc0aea500",
                                                "sense_id": "667dd4a3-31f0-34ec-90d2-4a68176ecb65",
                                                "text": "Jamais si lourdement a-t-on pu se méprendre ?"
                                            },
                                            {
                                                "example_id": "17e0cf74-d591-41c5-bd73-c12f34a6207c",
                                                "sense_id": "667dd4a3-31f0-34ec-90d2-4a68176ecb65",
                                                "text": "Et lourdement tranquille, Entouré de bouffons et d’insipides jeux, Quand il avait dîné, croyait son peuple heureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3574162f-f172-39c1-8f7c-b4f91a6d7855",
                                        "entry_id": "df71f91d-f595-35e3-91fd-3b73fb064e03",
                                        "glosses": [
                                            "D’une manière lourde, avec tout le poids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881fcd05-67b3-4002-96cf-c71ea5a0e45e",
                                                "sense_id": "3574162f-f172-39c1-8f7c-b4f91a6d7855",
                                                "text": "À peine s’est-elle montrée, que brandissant le crucifix à deux mains, de toute la hauteur de mes bras, je le laisse retomber lourdement sur la tête de Carmen."
                                            },
                                            {
                                                "example_id": "f45d2cdd-a24d-4a96-b97e-2e53bbf91be5",
                                                "sense_id": "3574162f-f172-39c1-8f7c-b4f91a6d7855",
                                                "text": "Mais l’autre couchée sur son lit, gémissante et douloureuse, ne se souleva qu’avec peine pour retomber bientôt lourdement sur sa couche."
                                            },
                                            {
                                                "example_id": "540f1366-c76c-4609-81b6-4e6b42497730",
                                                "sense_id": "3574162f-f172-39c1-8f7c-b4f91a6d7855",
                                                "text": "Lourdement, balayant de ses larges plis le plateau, la masse du velum rouge dégringola du cintre avant de remonter, pour retomber et se relever de nouveau."
                                            },
                                            {
                                                "example_id": "e0ccc8f6-1ac5-4531-8890-98a49829b54f",
                                                "sense_id": "3574162f-f172-39c1-8f7c-b4f91a6d7855",
                                                "text": "Vous voilà donc pris, homme de bien ! ah ! je vous mettrai en lieu d’où vous ne tomberez pas si lourdement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "495d014d-88ad-3e67-96c7-dacb28778e1d",
                                        "entry_id": "df71f91d-f595-35e3-91fd-3b73fb064e03",
                                        "glosses": [
                                            "D’une façon qui pèse sur le corps."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5f4837-92d0-487c-89a1-534e1e396bfe",
                                                "sense_id": "495d014d-88ad-3e67-96c7-dacb28778e1d",
                                                "text": "Suis-je mieux nourri et plus lourdement vêtu ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e82240d-8580-4ede-a6bc-2b2ae9b867a2",
                        "source_entry_id": "1300a65a-962f-367d-8438-4276108e63d9",
