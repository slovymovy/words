                "senses": [
                    {
                        "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                        "entry_id": "c734382d-a98b-3eee-9d70-c61333e300aa",
                        "glosses": [
                            "messbar strömendes Luftvolumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a11b90b7-6457-4bdc-ad08-f18dd6bd730d",
                                "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                                "text": "„Beim Nachweis zum Feuchteschutz muss zunächst der erforderliche Lüftungsvolumenstrom zum Abtransport der Feuchte mit dem vorhandenen Lüftungsvolumenstrom infolge Infiltration der Gebäudehülle verglichen werden.“"
                            },
                            {
                                "example_id": "15e76e90-a671-4faa-9856-3180ba193511",
                                "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                                "text": "„Die eingesetzten Belüftungsventile müssen den gleichen Lüftungsvolumenstrom wie die zu ersetzende rohrleitungsgebundene Lüftungsmaßnahme ermöglichen.“"
                            },
                            {
                                "example_id": "6d5a6f35-1523-4ccf-9f2e-ba3512b6d415",
                                "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                                "text": "„Sofern ein ausreichendes Lüften durch manuelles Fensteröffnen dem Bewohner nicht zugemutet werden kann, muss über eine lüftungstechnische Maßnahme der erforderliche Lüftungsvolumenstrom sichergestellt werden.“"
                            },
                            {
                                "example_id": "45dd9d67-faf1-47d6-bee3-fee7681cbdbe",
                                "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                                "text": "„Der Lüftungsvolumenstrom liegt bei etwa 2000 m³/h (entspricht einem Luftwechsel von ca. 0,9 h/1).“"
                            },
                            {
                                "example_id": "3631407b-6432-4854-a946-e03713987eb3",
                                "sense_id": "05abaebc-c473-3953-9a9a-8b61b18744e8",
                                "text": "„Der Lüftungsvolumenstrom einer raumlufttechnischen Anlange wird gemäß ÖNORM B 8110-6:2007 wie folgt ermittelt: v mech = n L,RLT· V v.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
