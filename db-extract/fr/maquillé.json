            {
                "entry_id": "0832df07-7f42-3ebb-ac47-89960a942423",
                "word": "maquillé",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a4d4facc-6e3c-4b6e-b087-4e8124045f37",
                        "entry_id": "0832df07-7f42-3ebb-ac47-89960a942423",
                        "tags": [
