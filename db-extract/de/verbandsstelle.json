                "senses": [
                    {
                        "sense_id": "9d9840cc-1d51-3008-80d1-2606e1530201",
                        "entry_id": "78f8ccb9-9a68-3ef3-9854-b9b31ff12bcf",
                        "glosses": [
                            "Ort, an dem Verletzte behandelt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a743aea4-d2ab-4935-afa3-f8d03d546826",
                                "sense_id": "9d9840cc-1d51-3008-80d1-2606e1530201",
                                "text": "„Als Erstes trug er Verwundete zur Verbandsstelle im Kloster.“"
                            },
                            {
                                "example_id": "d35697ad-e43f-41e5-a669-3421421a053e",
                                "sense_id": "9d9840cc-1d51-3008-80d1-2606e1530201",
                                "text": "„Er wollte hier eine Verbandsstelle sowie einen Befehlsstand einrichten und die Amerikaner zurückschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eebea5d1-d084-3b4e-9f22-9573d9e08a9a",
                        "entry_id": "78f8ccb9-9a68-3ef3-9854-b9b31ff12bcf",
                        "glosses": [
                            "Ort, an dem ein Verband vertreten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e75dfe0-08ef-4395-8817-2d4e41d14975",
                                "sense_id": "eebea5d1-d084-3b4e-9f22-9573d9e08a9a",
                                "text": "„Es gibt den Vorstand, die Verbandsstelle und viele Kleingruppen.“"
                            },
                            {
                                "example_id": "f86af80f-bec7-48f4-b71d-dc8a459b1a34",
                                "sense_id": "eebea5d1-d084-3b4e-9f22-9573d9e08a9a",
                                "text": "„Betriebe und Innungen können sich das Board als auch das Holzhaus der Zimmerer kostenlos von der Verbandsstelle leihen.“"
                            },
                            {
                                "example_id": "8af2880b-b6a9-441b-8ae6-88dc77dd369f",
                                "sense_id": "eebea5d1-d084-3b4e-9f22-9573d9e08a9a",
                                "text": "„Diese waren aber schon vor Wochen in der Verbandsstelle eingegangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
