                "senses": [
                    {
                        "sense_id": "8c737025-7270-3071-92de-ad11ab3d13ee",
                        "entry_id": "1871f555-df44-3a1f-b502-a3f5c8eb446f",
                        "glosses": [
                            "Vérifier qu’une porte est ouverte ou fermée, appuyer sur la clinche."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "4ac8e3d8-214a-4ab7-9043-95115fde17b4",
                                "sense_id": "8c737025-7270-3071-92de-ad11ab3d13ee",
                                "text": "Selon la lourdeur de la porte et le type de clinche, le nombre de ferme-portes, ce système ne fait pas nécessairement clincher la porte."
                            },
                            {
                                "example_id": "cd24775f-f553-4c30-bef7-edbb21d92f64",
                                "sense_id": "8c737025-7270-3071-92de-ad11ab3d13ee",
                                "text": "Lorsque je suis allée lui réouvrir la porte pour le libérer, j'ai eu une sacrée surprise…: il avait réussi à clincher les portes, avait bouffé tout le papier WC, s'était acharné sur une chaussure, attrapé du linge dans la manne de la SDB, et avait commencé à bouffer le papier peint du hall"
                            }
                        ]
                    }
