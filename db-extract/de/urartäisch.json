                    {
                        "sense_id": "e9c21559-da7f-36eb-989f-3520a37894d0",
                        "entry_id": "c9f0ec4e-bd6b-3b84-998d-5c0862fb5512",
                        "glosses": [
                            "die urartäische Sprache; eine hurro-urartäische Sprache, die in der Zeit von etwa 1. Jahrtausend bis etwa 7. Jh. v. Chr. im Gebiet des heutigen Ost-Anatoliens und Armeniens gesprochen wurde; mit dem Hurritischen verwandt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a11f62-2f29-4f26-9d34-fdf5ed769441",
                                "sense_id": "e9c21559-da7f-36eb-989f-3520a37894d0",
                                "text": "Urartäisch ist mit dem Hurritischen nahe verwandt."
                            },
                            {
                                "example_id": "8b0f2e3b-63cd-496e-bb0a-23d0f9397476",
                                "sense_id": "e9c21559-da7f-36eb-989f-3520a37894d0",
                                "text": "Im Urartäischen gibt es einen bestimmten Artikel, der als Suffix vor die Kasusendung tritt."
                            },
                            {
                                "example_id": "0ca04c84-69e6-4051-942a-0acdc99db7e0",
                                "sense_id": "e9c21559-da7f-36eb-989f-3520a37894d0",
                                "text": "Die Urartäischen Hieroglyphen sind noch nicht entziffert worden."
                            }
                        ],
