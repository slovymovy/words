                    }
                ],
                "senses": [
                    {
                        "sense_id": "c36fffbd-2d4f-3433-8474-9866a08fcd47",
                        "entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "glosses": [
                            "The reporting of news, especially by an eyewitness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "93ace526-6820-3e57-ad57-7fbb77f70244",
                        "entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "glosses": [
                            "News or information that has been reported; media coverage of a topic or event."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "daba064e-dc54-3a16-97eb-353cb4431dfc",
                        "entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "glosses": [
                            "Information supplied in a report."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9755ac62-cdac-4643-855c-aafc1da6f8e2",
                                "sense_id": "daba064e-dc54-3a16-97eb-353cb4431dfc",
                                "text": "In addition, as far as we were aware, there were no published data that quantified real-life speech practices in Singapore beyond census reportage[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4fd63a7-e35b-4873-aeff-df2778918fd3",
                        "source_entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "source_sense_description": "reporting of news, especially by an eyewitness",
                        "target_lang_word": "reportage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reportage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42547af5-0eae-393e-a5c3-12466d2136ac",
                                        "entry_id": "cdb8a466-1453-3533-a0dd-c160b6b49d2a",
                                        "glosses": [
                                            "Action de recueillir des nouvelles pour en rendre compte dans un journal ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f5c4689-864c-41fc-9765-03137a39fb5f",
                                                "sense_id": "42547af5-0eae-393e-a5c3-12466d2136ac",
                                                "text": "[…]… quel incident de voyage… quelle matière à chronique !… Et voyez jusqu’où peut aller la surexcitation cérébrale d’un reporter en quête de reportage ; […]."
                                            },
                                            {
                                                "example_id": "dfed5ba1-a4c5-4c9c-9675-1d41493d26fe",
                                                "sense_id": "42547af5-0eae-393e-a5c3-12466d2136ac",
                                                "text": "Jamais je n'aurais obtenu un semblable résultat en m'obstinant à croupir dans les marécages du reportage et du chroniquage à tant la ligne."
                                            },
                                            {
                                                "example_id": "0d44bac2-a082-4ba5-a0ad-506458ef2434",
                                                "sense_id": "42547af5-0eae-393e-a5c3-12466d2136ac",
                                                "text": "Mais Amélie […] était tout à l’excitation de ce reportage, à l’exhumation du passé, à la rencontre de ces francs-maçons mystérieux, dont elle ne savait guère que ce qu'en racontaient les journaux dans leurs « marronniers » annuels sur les « frères trois points ». Y avait-il des « sœurs » maçonnes pendant la guerre ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133e99df-5043-36c4-bdcb-0d06b556b03f",
                                        "entry_id": "cdb8a466-1453-3533-a0dd-c160b6b49d2a",
                                        "glosses": [
                                            "Diffusion de ces nouvelles dans un média."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f99a16e0-8ca6-4425-a0c9-bf4a9dd72cfc",
                                                "sense_id": "133e99df-5043-36c4-bdcb-0d06b556b03f",
                                                "text": "Son reportage plein d’affabulations décrivait de faux héros opposés à des administratifs tatillons et avides de pouvoirs. Sous le titre allusif « le poids de l'administration », il taillait un costume sur mesure à Si Omar […]."
                                            },
                                            {
                                                "example_id": "429c45ae-5e17-4cc2-8af6-586c92cff548",
                                                "sense_id": "133e99df-5043-36c4-bdcb-0d06b556b03f",
                                                "text": "Une immense joie s'empare de toute l'Italie, alimentée par les reportages dithyrambiques des journalistes embeded, comme on dirait aujourd'hui. La presse chante la victoire de la civilisation européenne sur obscurantisme des musulmans […]."
                                            },
                                            {
                                                "example_id": "a996997e-615f-4d3a-af2d-18cc1f2a8893",
                                                "sense_id": "133e99df-5043-36c4-bdcb-0d06b556b03f",
                                                "text": "Ces reportages, c'est toujours la même chose : des soldats, des curés et l'homme de la rue, ce fameux homme de la rue, serpent de mer et tarte à la crème des journalistes en mal de copie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reportage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a5e7dd9-ee1c-35b4-83a7-151449a8940a",
                                        "entry_id": "f9473cd0-c317-3228-aca6-c4c9d84f3e70",
                                        "glosses": [
                                            "Dîme foncière : moitié de la dîme, reportagium."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c75ed2c-da9a-4531-86c2-9826552e3797",
                                                "sense_id": "0a5e7dd9-ee1c-35b4-83a7-151449a8940a",
                                                "text": "reportage, moitié de la dîme, due quand la terre est cultivée par le dépendant d’un autre seigneur ou l’habitant d’une autre paroisse"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fe8ef85-2e9f-4fb6-8a7d-dc6a7b05bf0b",
                        "source_entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "source_sense_description": "reporting of news, especially by an eyewitness",
                        "target_lang_word": "Berichterstattung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berichterstattung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f755be7a-3155-3d9d-9561-9f3ef05cfe16",
                                        "entry_id": "af6cc0f5-d037-3c04-8ec8-5dbacf0d7b00",
                                        "glosses": [
                                            "Information einer bestimmten Gruppe oder der Allgemeinheit über einen bestimmten Sachverhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77675082-1c69-4ffc-a595-fdff2785c1aa",
                                                "sense_id": "f755be7a-3155-3d9d-9561-9f3ef05cfe16",
                                                "text": "„Die Berichterstattung über mögliche Hintergründe und Folgen in den Viersener Zeitungen ebbte ab; Themen wie die Unruhen in Albanien rückten in den Vordergrund.“"
                                            },
                                            {
                                                "example_id": "8f4211ac-55a7-4080-bb97-3f4942f24609",
                                                "sense_id": "f755be7a-3155-3d9d-9561-9f3ef05cfe16",
                                                "text": "„Stattdessen sage ich ihnen manchmal, dass die Berichterstattung in westlichen Medien vielleicht etwas Aufmerksamkeit auf ihre Probleme lenke und dass sich dadurch hoffentlich langfristig etwas für sie verändern werde.“"
                                            },
                                            {
                                                "example_id": "0eb8ddd2-2de7-4882-b706-fd0287090eb1",
                                                "sense_id": "f755be7a-3155-3d9d-9561-9f3ef05cfe16",
                                                "text": "„Natürlich erhoffe ich mir von meinem Wutausbruch, dass die Vorgesetzten an mögliche Folgen für ihre Laufbahn denken, falls die Berichterstattung allzu negativ ausfällt, aber am Ende ist es wohl mehr Mitleid, warum sich ein Biologe seufzend bereiterklärt, uns immerhin an den Rand des Sperrbezirks zu führen.“"
                                            },
                                            {
                                                "example_id": "1da380e0-f083-4dfc-a1e0-b76e9990c2e0",
                                                "sense_id": "f755be7a-3155-3d9d-9561-9f3ef05cfe16",
                                                "text": "„Manchmal erlaubten sie sich Scherze über den Tag ihrer Hochzeit, über die Berichterstattung in der Regenbogenpresse und ihre tadellose Darbietung, bevor sie in die Flitterwochen fuhren, wo sie wieder zu ihrem ursprünglichen Leben zurückfanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eb1c750-5df8-499b-95a3-1f5e3525c4a7",
                        "source_entry_id": "60b36967-e231-32dc-b26f-756c0396efe9",
                        "source_sense_description": "reporting of news, especially by an eyewitness",
                        "target_lang_word": "reportaż",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reportaż",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6a353772-faa4-3b6c-b22c-6705b88fe164",
                                        "entry_id": "82b93b61-1f1b-34f3-b0a3-d8eb558a050d",
                                        "glosses": [
                                            "gatunek prozy publicystycznej będący opisem zdarzeń znanych autorowi z własnej obserwacji"
                                        ],
                                        "tags": [
                                            "publ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7288da9-d3b2-451b-b5ff-7ee9006e9b37",
                                                "sense_id": "6a353772-faa4-3b6c-b22c-6705b88fe164",
                                                "text": "Tamtymi reportażami dotyczącymi kobiet w trudnych sytuacjach życiowych zyskała ogromną popularność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
