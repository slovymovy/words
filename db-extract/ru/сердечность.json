                    },
                    {
                        "translation_id": "ac161682-4b66-4152-b128-600fe167b984",
                        "source_entry_id": "17a4caa2-ecff-307e-a2f9-78cd36a7e3ee",
                        "source_sense_id": "1d2f207f-649f-302f-ac55-2189f482260d",
                        "target_lang_word": "cordialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                        "entry_id": "bb893b3f-690c-346b-9e85-12dfce28c585",
                                        "glosses": [
                                            "Affection dont les manifestations attestent la sincérité, la vivacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2470dab5-4124-4573-b078-fafb34468f3c",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "La plus franche cordialité régnait entre nous. Je passai là d’excellentes heures."
                                            },
                                            {
                                                "example_id": "d38dab9b-6bd4-47b0-8bd6-9995dde452e1",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Le bruit des voix, des carafes, des fourchettes, et des gosiers qui poussaient le bœuf vers les estomacs, cette rumeur de cordialité qui monte d’une table où les bonnes entrées n’empêchent pas les conversations, leur tapait un peu dans la tête."
                                            },
                                            {
                                                "example_id": "6bde5b34-f0f6-4cab-b000-188e115b82fa",
                                                "sense_id": "a7c94f75-353c-3afe-8823-f9af0789631f",
                                                "text": "Lorsqu’au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu’elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a6778d-0aec-47c7-9bf9-a725d1f9bc72",
                        "source_entry_id": "17a4caa2-ecff-307e-a2f9-78cd36a7e3ee",
                        "source_sense_id": "1d2f207f-649f-302f-ac55-2189f482260d",
                        "target_lang_word": "chaleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "452b067f-2d73-32a2-a8b7-01969ddd6a65",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Qualité de ce qui est chaud, sensation produite par un corps chaud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2c2b01-3c7a-431a-9c98-cd23f24f221c",
                                                "sense_id": "452b067f-2d73-32a2-a8b7-01969ddd6a65",
                                                "text": "Chaleur naturelle."
                                            },
                                            {
                                                "example_id": "0ca1aea4-419a-4ed7-bb43-6f413426b2be",
                                                "sense_id": "452b067f-2d73-32a2-a8b7-01969ddd6a65",
                                                "text": "Chaleur vitale."
                                            },
                                            {
                                                "example_id": "4ffccd74-5db5-4417-bf61-294d47bb8164",
                                                "sense_id": "452b067f-2d73-32a2-a8b7-01969ddd6a65",
                                                "text": "Chaleur animale."
                                            },
                                            {
                                                "example_id": "e0020a69-ba6d-4556-a028-572d11c85a1e",
                                                "sense_id": "452b067f-2d73-32a2-a8b7-01969ddd6a65",
                                                "text": "Chaleur solaire, rayonnante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd26314e-64e3-33ae-8ec5-341e311acc70",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Sensation de chaud qui ordinairement est incommode."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157fc5ad-0130-4eb2-9390-3a90dd0911b3",
                                                "sense_id": "cd26314e-64e3-33ae-8ec5-341e311acc70",
                                                "text": "Avez-vous parfois enduré cette trinité de supplices : la faim, la soif, la chaleur ?... Avez-vous eu en même temps l’estomac creux, le gosier sec, le crâne en feu ?"
                                            },
                                            {
                                                "example_id": "b2d2371f-7860-4229-81fb-377000654c70",
                                                "sense_id": "cd26314e-64e3-33ae-8ec5-341e311acc70",
                                                "text": "A Éphèse, les premières grosses chaleurs estivales échauffent les esprits. Dans les églises, dans les rues, sur les places publiques, évêques, prêtres et moines, nestoriens et cyrilliens se prennent à partie et s'invectivent en termes crus. La situation devient intenable."
                                            },
                                            {
                                                "example_id": "56e5509a-b52c-462a-8ba9-38e00051877c",
                                                "sense_id": "cd26314e-64e3-33ae-8ec5-341e311acc70",
                                                "text": "Il apparaît assez tardivement , comme la plupart des hygrophores, préférant la fraîcheur des pluies automnales aux chaleurs de la fin de l'été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc10d946-c83c-3f58-afb7-f4a079e430c6",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Température produite par l’action du soleil, du feu ou de toute autre cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a80a2d-ac5a-4972-aa24-81d29ea57a3b",
                                                "sense_id": "fc10d946-c83c-3f58-afb7-f4a079e430c6",
                                                "text": "Il s’agit de faire face à la bobologie courante, mais également aux malaises et déshydratations potentielles liées aux fortes chaleurs qui auront lieu pendant l’intégralité du festival."
                                            },
                                            {
                                                "example_id": "7b5a0c10-74cf-4798-93b9-0156e426bf45",
                                                "sense_id": "fc10d946-c83c-3f58-afb7-f4a079e430c6",
                                                "text": "Quand l'orge est bien germée, on la porte dans une étuve à courant d'air chaud, appelée touraille ; la chaleur arrête immédiatement la germination."
                                            },
                                            {
                                                "example_id": "b36799e4-d365-48a8-9ae9-f673f437470d",
                                                "sense_id": "fc10d946-c83c-3f58-afb7-f4a079e430c6",
                                                "text": "Dernièrement, j’avais eu la maladresse de m’enrhumer en pleine chaleur. Voilà pourtant ce que c’est que de devenir vieux : on ne peut résister à rien."
                                            },
                                            {
                                                "example_id": "6dd5fe23-7984-444d-9f28-ad2c7c5ffec5",
                                                "sense_id": "fc10d946-c83c-3f58-afb7-f4a079e430c6",
                                                "text": "À la fin de la huitième lune, une chaleur lourde s'étendit sur la vieille cité et ramena avec elle une effrayante recrudescence de puanteur ambiante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c19045ca-5125-36a7-ba06-52b2bd3b87de",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Énergie calorifique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5bf7b1-a1bf-4925-aa21-419c73d9df21",
                                                "sense_id": "c19045ca-5125-36a7-ba06-52b2bd3b87de",
                                                "text": "Si la chaleur cosmique diminue, c'est donc que le monde n'a pas toujours existé, sans quoi, […], il y a longtemps qu'elle serait complétement usée."
                                            },
                                            {
                                                "example_id": "19df6b2e-2935-4c6b-8f56-6467d1b643c1",
                                                "sense_id": "c19045ca-5125-36a7-ba06-52b2bd3b87de",
                                                "text": "Le renforcement des alizés depuis vingt ans y a créé un énorme réservoir de chaleur, « les eaux chaudes y forment une couche plus épaisse », explique Cazenave. Est-ce un effet du changement climatique ? Mystère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Ardeur, feu, véhémence des passions, des sentiments ou de ce qui sert à les manifester."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8511b82-d6a3-418e-9256-4ed4de8bad64",
                                                "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                                                "text": "Dans la chaleur du combat, dans le feu de l'action."
                                            },
                                            {
                                                "example_id": "139c5705-4484-428b-9c1a-5b86c340aeab",
                                                "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                                                "text": "Bientôt il entendit ses domestiques qui revenaient en se disputant avec une sorte de chaleur."
                                            },
                                            {
                                                "example_id": "ed782267-96d6-4132-9625-580acb7b501c",
                                                "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                                                "text": "Mais je me figurais que tout le monde savait ça à Paris, que toute la France s’en était émue du moment que Médée, lui-même, s’emballait avec tant de chaleur en m’en parlant."
                                            },
                                            {
                                                "example_id": "54035258-f134-48e9-85f8-e90d3104064c",
                                                "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                                                "text": "C'est José, un Marseillais pure laine, plein de chaleur, d'une quarantaine d'années, qui nous a accompagné pendant notre séjour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a367a34-f90d-3a6a-8328-3b0f43ced956",
                                        "entry_id": "28abbcbf-baf9-31c9-b6dd-8b818046dc28",
                                        "glosses": [
                                            "Œstrus, état d’une femelle qui souhaite s'accoupler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c06687a8-c64f-4afa-b06b-613ed5b97c2b",
                                                "sense_id": "6a367a34-f90d-3a6a-8328-3b0f43ced956",
                                                "text": "«Les pandas vivent seuls et n'aiment pas beaucoup la compagnie des autres. Sauf pendant les quelques jours par an où la femelle est en chaleur», a indiqué M. Frost Bertelsen."
                                            },
                                            {
                                                "example_id": "12cb339d-3986-4eb1-8af7-03c829fd5f27",
                                                "sense_id": "6a367a34-f90d-3a6a-8328-3b0f43ced956",
                                                "text": "Gueuse en chaleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
