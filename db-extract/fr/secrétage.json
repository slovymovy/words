                "senses": [
                    {
                        "sense_id": "d48157b7-72b6-3462-80f0-0c5d17ad67de",
                        "entry_id": "70085c0d-9242-3ad8-b002-acacb3f448ed",
                        "glosses": [
                            "Action de garder quelque chose secrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c71cb7ee-f1fa-453b-bd51-a085f04a0b7c",
                                "sense_id": "d48157b7-72b6-3462-80f0-0c5d17ad67de",
                                "text": "M. le Président est devenu maître dans l'art du secrétage, si j'ai bien compris."
                            }
                        ]
                    },
                    {
                        "sense_id": "f54a7056-3719-3dac-8f34-c846adc3aaa8",
                        "entry_id": "70085c0d-9242-3ad8-b002-acacb3f448ed",
                        "glosses": [
                            "Procédé par lequel le nitrate de mercure(II) et d’autres sels sont employés pour faciliter le feutrage des peaux de lapin en vue de la fabrication de chapeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c44c180-0736-4636-9976-7d7e6dcc3625",
                                "sense_id": "f54a7056-3719-3dac-8f34-c846adc3aaa8",
                                "text": "Le secrétage effectué, le poil est coupé et peut être travaillé."
                            },
                            {
                                "example_id": "b5f15a21-8dbc-4199-8061-5253346b579c",
                                "sense_id": "f54a7056-3719-3dac-8f34-c846adc3aaa8",
                                "text": "Les peaux qui ont subi le secrétage au nitrate de mercure présentent le danger de l'intoxication par ce métal."
                            },
                            {
                                "example_id": "76734428-9178-40cb-85dc-5fb522b66b43",
                                "sense_id": "f54a7056-3719-3dac-8f34-c846adc3aaa8",
                                "text": "Tous les hygiénistes connaissent les dangers de l’industrie du secrétage des poils. Tous savent que c'est en imprégnant les peaux couvertes de poils avec une solution de nitrate de mercure et en les desséchant à l’étuve qu'on transforme ces poils en un tissu solide et léger, le feutre des chapeaux par exemple."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e58b1a9f-b31c-42a5-9688-c0d1a5bc26ba",
                        "source_entry_id": "70085c0d-9242-3ad8-b002-acacb3f448ed",
                        "source_sense_description": "Procédé",
                        "target_lang_word": "secretage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secretage",
