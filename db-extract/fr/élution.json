                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd42651c-b24a-4180-83a9-e98c42da3e3c",
                                "sense_id": "86ab7b3c-d739-3d02-80ac-4abaa8562c04",
                                "text": "Placer la plaque verticalement dans la cuve à élution de manière à ce que l’éluant n’atteigne pas les dépôts d’échantillon sur la ligne de base."
                            },
                            {
                                "example_id": "78d7d295-43fb-45d6-913d-564a05946273",
                                "sense_id": "86ab7b3c-d739-3d02-80ac-4abaa8562c04",
                                "text": "Lorsque le gradient de concentration de l’éluant est tel que le coefficient de partage du composé élué croît au cours de l’élution, il en résulte un retard à l’apparition du pic en bas de la colonne."
                            }
                        ]
