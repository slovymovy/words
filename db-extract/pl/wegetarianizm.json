                        "entry_id": "1a353a0f-3417-331e-b398-4ecd2e799a3f",
                        "glosses": [
                            "sposób odżywiania się charakteryzujący się wyłączeniem z posiłków produktów mięsnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
