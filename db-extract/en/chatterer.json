                ],
                "senses": [
                    {
                        "sense_id": "39a5fd07-a10a-3e66-94d4-5ea5d976c219",
                        "entry_id": "24dbe721-03a3-33b2-af51-6f732cc52ff7",
                        "glosses": [
                            "A person who chatters; a chatterbox."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c260a87-95fa-4ef9-9a6f-b9a783c664cd",
                                "sense_id": "39a5fd07-a10a-3e66-94d4-5ea5d976c219",
                                "text": "Yes, I am a chatterer, indeed, to interrupt you so often, Monsieur."
                            },
                            {
                                "example_id": "f4f6a416-b24f-4edf-a8e6-60da68496e8f",
                                "sense_id": "39a5fd07-a10a-3e66-94d4-5ea5d976c219",
                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers,[…]the chlorotic squatters on huge yachts, the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosus,[…]!”"
                            },
                            {
                                "example_id": "391f5347-b184-4ad4-a1c1-4f87d0eacc00",
                                "sense_id": "39a5fd07-a10a-3e66-94d4-5ea5d976c219",
                                "text": "Indeed the difficulty was to get him to stop talking, for, like all squirrels, he was a chatterer."
                            }
                        ]
                    },
                    {
                        "sense_id": "497db3df-c863-3597-831d-9bbf33c64a65",
                        "entry_id": "24dbe721-03a3-33b2-af51-6f732cc52ff7",
                        "glosses": [
                            "Any of several passerine birds, mostly from South America; especially the cotingas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673f2d91-2828-4ec3-a853-9c48fa6541ca",
                                "sense_id": "497db3df-c863-3597-831d-9bbf33c64a65",
                                "text": "Why is the variegated chatterer of South America also called the bell-bird?"
                            },
                            {
                                "example_id": "8e3567d5-e659-4017-8094-6f72cb2551c3",
                                "sense_id": "497db3df-c863-3597-831d-9bbf33c64a65",
                                "text": "The flight of the Chatterer bears much resemblance to that of the starling."
                            }
                        ]
                    }
                ],
