                    "frequency": "VeryLow",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every single <w>jot</w> and tittle of the contract was examined by the legal team."
                        },
                        {
                            "text": "The old scribe insisted that not a <w>jot</w> should be altered from the text."
                        }
                    ],
                    "synonyms": [
                        "iota",
                        "tittle"
                    ],
                    "common_phrases": [
                        "jot and tittle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically or in fixed biblical expressions."
                        }
                    ]
                },
                {
                    "sense_id": "7e027ab7-033b-3e5c-8640-7529f510264e",
                    "sense_definition": "A brief moment or instant of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to delay his departure even for a <w>jot</w>."
                        },
                        {
                            "text": "She paused not a <w>jot</w> before delivering her reply."
