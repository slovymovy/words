                                    },
                                    {
                                        "sense_id": "e910ab0a-9723-3597-833d-1d04db46bd5d",
                                        "entry_id": "67772e89-eb46-32b2-a0e6-4e1bb322364f",
                                        "glosses": [
                                            "Falta de dedicación para hacer las cosas como corresponde."
                                        ],
                                        "tags": [
                                            "por extensión"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8c4c8330-6a59-36a7-af11-dbb8e8c6c65f",
                                        "entry_id": "67772e89-eb46-32b2-a0e6-4e1bb322364f",
                                        "glosses": [
                                            "Acción reparable o desatención que desdice de aquel que la ejecuta, o de aquel a quien ofende o perjudica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249d6504-6ce9-417b-9851-7fc08e9a7a15",
                                                "sense_id": "8c4c8330-6a59-36a7-af11-dbb8e8c6c65f",
                                                "text": "De magnánimos es llevar con mansedumbre los descuidos."
                                            }
