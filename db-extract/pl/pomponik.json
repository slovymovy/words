                                            {
                                                "example_id": "718a308f-b5b0-4814-8710-7ed2aad29b0e",
                                                "sense_id": "da371220-2c5f-3195-adc4-d15df4a0e87a",
                                                "text": "You've been cabling, twisting, popcorning and bobbling. See, we told you that they weren't so hard."
                                            }
                                        ]
