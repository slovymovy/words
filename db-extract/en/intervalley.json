                        "examples": [
                            {
                                "example_id": "37136154-f54a-403f-9298-5c29e4787d1f",
                                "sense_id": "916dcdf3-9f80-39fe-b112-ba8299345074",
                                "text": "At the outer margins of the intervalleys the sagebrush type is modified by an admixture of grasses and weeds, of which wheat bunch grass, wild geranium, lupine, balsam root, and giant wild rye are most conspicuous."
                            },
                            {
