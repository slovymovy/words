                {
                    "sense_id": "ecae658b-329c-387f-a5eb-40d7bff2b06d",
                    "sense_definition": "Rendre ou devenir plus sévère, plus ferme ou intransigeant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "severite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face au refus des négociateurs, le directeur a décidé de <w>durcir</w> le ton.",
                            "target_lang_translations": {
                                "en": "Faced with the negotiators' refusal, the director decided to <w>harden</w> his tone.",
                                "ru": "Столкнувшись с отказом участников переговоров, директор решил <w>ужесточить</w> тон.",
                                "de": "Angesichts der Weigerung der Unterhändler beschloss der Direktor, den Ton zu <w>verschärfen</w>.",
                                "es": "Ante la negativa de los negociadores, el director decidió <w>endurecer</w> el tono.",
                                "zh": "面对谈判代表的拒绝，主任决定语气<w>强硬</w>一些。"
                            }
                        },
                        {
                            "text": "Le gouvernement souhaite <w>durcir</w> les règles pour limiter les fraudes.",
                            "target_lang_translations": {
                                "en": "The government wants to <w>toughen</w> the rules to curb fraud.",
                                "ru": "Правительство намерено <w>ужесточить</w> правила, чтобы пресечь мошенничество.",
                                "de": "Die Regierung will die Regeln <w>verschärfen</w>, um Betrügereien einzudämmen.",
                                "es": "El Gobierno quiere <w>endurecer</w> las reglas para limitar los fraudes.",
                                "zh": "政府希望<w>收紧</w>规则，以遏制欺诈行为。"
                            }
                        }
                    ],
                    "antonyms": [
                        "adoucir"
                    ],
                    "common_phrases": [
                        "durcir le ton",
                        "durcir les règles",
                        "durcir sa position"
                    ],
                    "target_lang_definitions": {
                        "en": "To make or become stricter, firmer or more uncompromising.",
                        "ru": "Делать или становиться строже, жёстче или непреклонным.",
                        "de": "Strenger, fester oder unnachgiebiger machen oder werden.",
                        "es": "Hacer más severo, firme o intransigente, o volverse así.",
                        "zh": "使规则、态度等变得更严格、更坚决，或变得更加强硬。"
                    },
