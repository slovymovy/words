                    {
                        "sense_id": "6ffe66ed-ff97-33f0-a019-6bcb837cc1db",
                        "entry_id": "ca944252-c944-376f-92f2-b138cfae1a3b",
                        "glosses": [
                            "Qui n’a pas été vengé."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "63768dac-978b-4225-acce-2ca7fc68e5c2",
                                "sense_id": "6ffe66ed-ff97-33f0-a019-6bcb837cc1db",
                                "text": "C'est par moi que tu meurs, et tu resteras invengé."
                            },
                            {
                                "example_id": "e66be7e0-a561-41fe-9515-0892f932e660",
                                "sense_id": "6ffe66ed-ff97-33f0-a019-6bcb837cc1db",
                                "text": "Un si grand courage,issu du désespoir, s'empara de chacun, qu'ils se croyaient vainqueurs dans la mesure où ils ne mourraient pas invengés."
                            },
                            {
                                "example_id": "7225843c-7d47-41f6-b0d2-9cf329c4bd53",
                                "sense_id": "6ffe66ed-ff97-33f0-a019-6bcb837cc1db",
                                "text": "Le narrateur exprime face à l’audace de son père un sentiment mêlé d'admiration et de crainte, puisqu’il devient pour les familles des victimes invengées une cible idéale."
                            }
                        ]
                    }
