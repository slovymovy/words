                                        "glosses": [
                                            "Sucre blanc obtenu par cristallisation du sirop et dessiccation des cristaux, et dont les grains sont plus gros que ceux du sucre semoule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc134da-08e8-462c-99d9-6d870cf19868",
                                                "sense_id": "e3bfa2f5-a7ec-3a96-ac55-cb4fdfcf7382",
                                                "text": "Le sucre cristallisé, issu de la cristallisation du sirop, entre dans la préparation des confitures, des pâtes de fruits et des décors de pâtisserie. C'est le sucre le moins cher."
                                            },
                                            {
                                                "example_id": "bc64e089-54da-42f3-95a4-6722226e7852",
                                                "sense_id": "e3bfa2f5-a7ec-3a96-ac55-cb4fdfcf7382",
                                                "text": "Le sucre cristallisé s’obtient après concentration des jus dans des étuves par la formation de cristaux de sucre dans des centrifugeuses."
                                            }
                                        ]
                                    }
