                    {
                        "sense_id": "763086c9-e11d-35dc-98dc-18fede6c6bda",
                        "entry_id": "8810252b-41eb-37fe-acce-6c26fe159838",
                        "glosses": [
                            "Wort, das aus zwei oder mehr Silben besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b409615-ac5a-4e44-aa57-ae16e5cdf72d",
                                "sense_id": "763086c9-e11d-35dc-98dc-18fede6c6bda",
                                "text": "„Hat eine Silbe im Mehrsilber ein Graphem im Endrand, so wird sie kurz gelesen…“"
                            },
                            {
                                "example_id": "d9858a5f-9d5c-4609-b28f-9b9414b5db2f",
                                "sense_id": "763086c9-e11d-35dc-98dc-18fede6c6bda",
                                "text": "„Zählen Sie die Wörter mit drei und mehr Silben (Mehrsilber).“"
                            },
                            {
                                "example_id": "67e837f2-6aaa-4307-82b1-b2c014176c63",
                                "sense_id": "763086c9-e11d-35dc-98dc-18fede6c6bda",
                                "text": "„Auch in Mehrsilbern kann es Silben geben, die nicht einem Fuß zugewiesen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
