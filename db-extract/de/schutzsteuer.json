                ],
                "senses": [
                    {
                        "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                        "entry_id": "21997331-506e-31bc-b8fb-cfcf058ab4d9",
                        "glosses": [
                            "Abgabe (Steuer), um im Gegenzug eine Leistung, zum Beispiel Sicherheit (Schutz) zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b1423e-55f6-4230-a890-5be51fc2edc9",
                                "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                                "text": "„Die Schutzsteuer war neben der Nahrungssteuer und Tandelmarktsteuer eine besondere Abgabe, mit deren Einhebung und Verrechnung sich das Steueramt befasste, denn die genannten Abgaben waren so genannte kommunale Zuschläge, von welchen besonders der Staat profitierte.“"
                            },
                            {
                                "example_id": "762e6122-8e5e-4622-bca4-255a4db12301",
                                "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                                "text": "„Schutzsteuer [dschizya] ist eine Sondersteuer, für erwachsene Männer unter den Leuten des Buches [ahl-ul-kitab], die unter islamischer Herrschaft leben, falls sie nicht an der Verteidigung des Landes teilnehmen wollen.“"
                            },
                            {
                                "example_id": "e0eb7994-3ce2-4ea6-bf8d-785a919e5e10",
                                "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                                "text": "„Christen in der syrischen Stadt Al Qaryatayn müssen offenbar dem „Islamischen Staat“ (IS) eine Schutzsteuer zahlen.“"
                            },
                            {
                                "example_id": "f4ee95b6-2791-4fa6-84de-0e38dc7a4047",
                                "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                                "text": "„Wird das Mühlengeschäft nicht vom Eigenthümer selbst, sondern von einem Werkführer betrieben, so zahlt dieser nach seiner Eigenschaft die Gewerbe- oder Schutzsteuer.“ (1861)"
                            },
                            {
                                "example_id": "499a33b5-1ade-472e-b671-04ad65df93ad",
                                "sense_id": "935bdf1f-ef5d-323e-b535-b930027c1f08",
                                "text": "„Diese Schutzsteuern wurden vom Gemeindevorsteher ausgehandelt und kollektiv am St. Martinstag (11. November) bezahlt. Innerhalb jeder Gemeinde mussten die Gemeindemitglieder ihr Vermögen unter Eid deklarieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
