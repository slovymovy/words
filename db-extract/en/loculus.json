                        ]
                    },
                    {
                        "translation_id": "84ac3317-6d7f-4219-a8b9-6c546d0c25ad",
                        "source_entry_id": "7fec0a13-7210-30e0-ad31-3ecb69064041",
                        "source_sense_description": "botany: cavity of a compound ovary",
                        "target_lang_word": "lóculo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lóculo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b9b6a5d6-b84b-3518-b4a3-506b508616ca",
                                        "entry_id": "d852b3fa-7360-313e-9475-948f35411cc9",
                                        "glosses": [
                                            "Pequeña cavidad u orificio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac6e528-a3a1-4afb-b9d5-902590255390",
                                                "sense_id": "b9b6a5d6-b84b-3518-b4a3-506b508616ca",
                                                "text": "«Lóculo: cavidad pequeña»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78e2030e-dadb-3ca4-b679-e6783023881d",
                                        "entry_id": "d852b3fa-7360-313e-9475-948f35411cc9",
                                        "glosses": [
                                            "Cavidad o compartimiento del ovario en el órgano femenino vegetal (parte de la flor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f847d8-f1d3-476c-b982-83f5567f1f9c",
                                                "sense_id": "78e2030e-dadb-3ca4-b679-e6783023881d",
                                                "text": "«Flor—. Hermafrodita, actinomorfa o zigomorfa. El androceo con 6 estambres, a veces menos de 6. El gineceo presenta ovario súpero, trilocular con uno hasta muchos óvulos en cada lóculo»."
                                            },
                                            {
                                                "example_id": "98c0a91a-7343-4bdf-9933-4b5e7e492c0f",
                                                "sense_id": "78e2030e-dadb-3ca4-b679-e6783023881d",
                                                "text": "«Las cavidades o celdas que posee el ovario en su interior, se llaman lóculos y como en los carpelos, puede ser desde unilocular hasta policarpelar»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6960fa6a-ee76-36b6-af5c-03bf93289f6d",
                                        "entry_id": "d852b3fa-7360-313e-9475-948f35411cc9",
                                        "glosses": [
                                            "Espacio labrado en la roca, de unos dos metros de profundidad, donde se sepultaba un cadáver en las catacumbas de la antigua Roma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0973b29-c840-4890-be1b-de11863cd091",
                                                "sense_id": "6960fa6a-ee76-36b6-af5c-03bf93289f6d",
                                                "text": "«En esta cella o lóculo yacía el cuerpo de Santiago según las fuentes medievales antes aducidas: lo que estas no nos dicen con claridad es si el sepulcro era un sarcófago o una fosa abierta en el pavimento»."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
