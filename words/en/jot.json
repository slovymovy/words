                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With an unexpected <w>jot</w>, the carriage stopped in the muddy ditch."
                        },
                        {
                            "text": "The sudden <w>jot</w> of the horse shook the rider nearly off the saddle."
                        }
                    ],
                    "synonyms": [
                        "bump"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete sense denoting a physical jerk."
                        }
                    ]
                }
            ]
        }
    ]
