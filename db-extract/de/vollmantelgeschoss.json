                "senses": [
                    {
                        "sense_id": "a2cba53e-8ae9-32a4-bbc3-cf38b3b52182",
                        "entry_id": "cdd349af-bb69-32be-90d9-1efd71a06b71",
                        "glosses": [
                            "Projektil mit einem Kupfer-, Tombak- oder Eisenmantel um einen Hartbleikern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b73e697-07a2-4fba-8cf8-d48fbcfca77a",
                                "sense_id": "a2cba53e-8ae9-32a4-bbc3-cf38b3b52182",
                                "text": "„Vollmantelgeschosse können den Körper eines Menschen durchdringen und weiterfliegen, und manchmal treffen sie auch noch die Person, die hinter der ersten steht.“"
                            },
                            {
                                "example_id": "9481f63b-0976-48e3-a61c-0276fa4ad0fa",
                                "sense_id": "a2cba53e-8ae9-32a4-bbc3-cf38b3b52182",
                                "text": "„Die Geschosse, die Oswald verwendet hat, waren Vollmantelgeschosse.“"
                            },
                            {
                                "example_id": "1fa7de88-b0ef-49eb-baae-b6ac5fc9d2c2",
                                "sense_id": "a2cba53e-8ae9-32a4-bbc3-cf38b3b52182",
                                "text": "„Er schwitzte weniger vor Anstrengung als bei dem Gedanken, dass ihn jeden Augenblick ein Suchscheinwerfer treffen konnte, dicht gefolgt von einem großkalibrigen Vollmantelgeschoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
