                                    {
                                        "sense_id": "9375c48e-825a-3df9-a443-38ce83156219",
                                        "entry_id": "00d30656-3f94-3246-90ee-e4e97beef20f",
                                        "glosses": [
                                            "Wearing spectacles (glasses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3927d76b-b4b6-4af6-b588-8b4a8019f4a2",
                                                "sense_id": "9375c48e-825a-3df9-a443-38ce83156219",
                                                "text": "The Commissioner, ascetic-looking, an Oxford graduate, narrow-shouldered and elderly, tired-eyed and bespectacled like the scholar he was, like the scientist he was, shrugged his shoulders."
                                            },
                                            {
                                                "example_id": "119cd37a-655f-43dd-b5a7-c62acfcfddca",
                                                "sense_id": "9375c48e-825a-3df9-a443-38ce83156219",
                                                "text": "Solanka was uninterested in this bow-tied, bespectacled, markedly un-Jedi-knight-like young man, and as a former science-fiction buff despised the lowbrow space opera of the Star Wars cycle."
                                            },
                                            {
                                                "example_id": "1e184e23-cab4-4a05-8154-3c96bf9aa21c",
                                                "sense_id": "9375c48e-825a-3df9-a443-38ce83156219",
                                                "text": "The choristers were as bespectacled as the audience. Are Protestants more bespectacled than Catholics because of too much Bible reading?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
