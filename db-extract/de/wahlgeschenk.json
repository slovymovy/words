                "senses": [
                    {
                        "sense_id": "8dc636f6-cc8b-3b2b-9e6f-627470cb0425",
                        "entry_id": "4351d057-be6a-32e8-949f-6b879426616f",
                        "glosses": [
                            "Einführung einer Vergünstigung durch eine regierende politische Partei, kurz bevor sie sich der Wiederwahl stellen muss, mit dem Ziel, so die Gunst der Wähler zu erlangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932effc7-8f08-47e4-ba46-044c8a9ca1c8",
                                "sense_id": "8dc636f6-cc8b-3b2b-9e6f-627470cb0425",
                                "text": "„Die Abwrackprämie wird damit als das bisher teuerste Wahlgeschenk in die deutsche Geschichte eingehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34de97f3-82a7-37a8-b75b-d9f81fcbc273",
                        "entry_id": "4351d057-be6a-32e8-949f-6b879426616f",
                        "glosses": [
                            "Werbegeschenk, das von einer politischen Partei während des Wahlkampfs an einen Bürger ausgegeben wird"
                        ],
                        "tags": [
                            "besonders österreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e9f4fac2-aa43-480b-809e-6f9cd61c8737",
                                "sense_id": "34de97f3-82a7-37a8-b75b-d9f81fcbc273",
                                "text": "„\"Wir verteilen hier nur die offiziellen Wahlgeschenke, wie Kugelschreiber oder Flyer\", sagt Mario Mautner, burgenländischer FP-Spitzenkandidat für die EU-Wahlen, im Gespräch mit derStandard.at.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
