                ],
                "senses": [
                    {
                        "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                        "entry_id": "a113c5a4-70f1-3a9a-a2d0-9736fe913e25",
                        "glosses": [
                            "aus Silikon, Latex oder Kunststoff hergestelltes flexibles Behältnis in Kelchform mit Stiel, das von menstruierenden Frauen zum Auffangen des Menstruationssekretes in die Vagina eingeführt wird und dort durch die Scheidenmuskulatur sowie einen Unterdruck vor dem Muttermund gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "913cd567-7586-459a-b419-e3f35dfc8835",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Für viele Frauen macht die Verwendung einer Menstruationstasse die Menstruation deutlich angenehmer, da die Tasse bis zu zwölf Stunden in der Scheide verbleiben kann und zudem keine Scheidentrockenheit wie bei Tampons oder Geruchsbildung wie bei Binden auftritt."
                            },
                            {
                                "example_id": "9dba5a27-db18-416d-90e4-42e25a3b58ad",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Menstruationstassen werden in verschiedenen Formen, Farben, Größen und Materialien produziert, um den individuellen Bedürfnissen und Vorlieben möglichst vieler Frauen gerecht zu werden."
                            },
                            {
                                "example_id": "b390aac2-a064-41df-a26f-d3b6165859d2",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Im Vergleich zu anderen Produkten der Monatshygiene sind Menstruationstassen in Deutschland immer noch recht unbekannt."
                            },
                            {
                                "example_id": "198f8f37-ce76-415e-a41c-9f5b0be562c0",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Bei der Verwendung einer Menstruationstasse können am Anfang Schwierigkeiten in der Handhabung auftreten, da die Techniken des Einführens und Entfernens erst mit etwas Erfahrung ohne Probleme anzuwenden sind."
                            },
                            {
                                "example_id": "7bd4d89a-81e4-4a1c-a54d-a94a62514b1c",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Für das Einführen in die Scheide existieren mehrere Falttechniken, die die Ausdehnung der Menstruationstasse zum Teil stark verkleinern."
                            },
                            {
                                "example_id": "f1a91435-5261-4b35-b637-38832539d988",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Nutzerinnen der wiederverwendbaren Menstruationstassen schätzen an ihnen, dass Müll vermieden wird und Kosten für den Kauf von Tampons und Binden gespart werden."
                            },
                            {
                                "example_id": "5b563f4f-e3a6-4cc8-b057-75d1dbda76f6",
                                "sense_id": "43dcbf12-977d-3d55-a792-f555cbd8f616",
                                "text": "Bis eine Frau die für sie optimale Menstruationstasse in dem immer größer werdenden Angebot gefunden hat, muss sie unter Umständen mehrere Modelle testen oder eine Beratung in Anspruch nehmen, bei der anhand der Anzahl vaginaler Geburten, des Muttermundstands während der Menstruation, vorhandener Allergien und anderer Kriterien eine Empfehlung abgegeben wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
