                "senses": [
                    {
                        "sense_id": "b7f29633-8e81-35e5-91ca-35fa89ce8e0d",
                        "entry_id": "d90d5f1b-4ea2-371c-9b1b-ab73e4937438",
                        "glosses": [
                            "instrument om de tijd aan te wijzen op basis van de schaduw van een voorwerp, meestal een staaf, die door de zon wordt gegeven."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "74a1b68e-3c1e-39c2-922b-6457a3c94fee",
                        "entry_id": "d90d5f1b-4ea2-371c-9b1b-ab73e4937438",
                        "glosses": [
                            "een libel uit het geslacht Trithemis van echte libellen uit de familie van de korenbouten (Libellulidae)"
                        ],
                        "tags": [
                            "libellen"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fac8334-b97a-4f43-a9d9-dcbc3d16fd50",
                        "source_entry_id": "d90d5f1b-4ea2-371c-9b1b-ab73e4937438",
                        "target_lang_word": "Sonnenuhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenuhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec33d88d-efff-391c-b494-59a41df2c6cd",
                                        "entry_id": "de66cc34-bcf0-3b19-be83-aa02a92a89a9",
                                        "glosses": [
                                            "astronomisches Gerät, das den Stand der Sonne am Himmel zu einer genäherten Zeitangabe nutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f2071c-25a1-4a15-adf6-a4f00df7121f",
                                                "sense_id": "ec33d88d-efff-391c-b494-59a41df2c6cd",
                                                "text": "Sofern die Sonnenuhr so konstruiert ist, dass sie bei Sonnenhöchststand 12 Uhr anzeigt, gibt sie die so genannte wahre Ortszeit an."
                                            },
                                            {
                                                "example_id": "eb1c8ae8-a56d-45a8-90e1-2e76e011c4d9",
                                                "sense_id": "ec33d88d-efff-391c-b494-59a41df2c6cd",
                                                "text": "„Die dicht vor dem Salon gelegene Gartenanlage bestand aus einem Rondeel mit Sonnenuhr, um das herum, in meist dreieckigen und von Buchsbaum eingefaßten Beeten, allerlei Sommerblumen blühten: Reseda und Rittersporn und Lilien und Levkojen.“"
                                            },
                                            {
                                                "example_id": "0009b941-0851-4582-851f-1ed1aa91e669",
                                                "sense_id": "ec33d88d-efff-391c-b494-59a41df2c6cd",
                                                "text": "„Zur Stundenmessung dienen neben der nur nachts möglichen Sternobservation die Sonnenuhr und die Wasseruhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d912a265-152f-4252-b5a2-16ba66aa3eea",
                        "source_entry_id": "d90d5f1b-4ea2-371c-9b1b-ab73e4937438",
                        "target_lang_word": "sundial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sundial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24a7e9f9-1564-3e2c-8d12-dc5050319143",
                                        "entry_id": "078f44fa-ac40-35d8-ba07-84805fc9caf1",
                                        "glosses": [
                                            "A device measuring the time of day by the position of a shadow cast by a pole or plate (gnomon) upon an engraved series of marks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f53ce6-3da0-4e8f-bc9b-57cf34ed8568",
                                                "sense_id": "24a7e9f9-1564-3e2c-8d12-dc5050319143",
                                                "text": "The birdbath includes a small gnomon that acts as a sundial with markings on the basin if it's aligned correctly with the sun."
                                            },
                                            {
                                                "example_id": "d5f2d95f-8e80-4199-a300-2ffe48673f50",
                                                "sense_id": "24a7e9f9-1564-3e2c-8d12-dc5050319143",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there.\n\"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            },
                                            {
                                                "example_id": "1ffa7312-617f-42ff-8200-947f8c001d96",
                                                "sense_id": "24a7e9f9-1564-3e2c-8d12-dc5050319143",
                                                "text": "The shop carries more than a dozen sundials, mostly of bronze, plus an astrolabe ($650) of wrought iron."
                                            },
                                            {
                                                "example_id": "ffacc208-fb0c-4f6c-a982-8d0e28fe5f6b",
                                                "sense_id": "24a7e9f9-1564-3e2c-8d12-dc5050319143",
                                                "text": "It was Oxford now—the matriculation photograph, posed in the stony front quad at Corpus, the pelican on top of the sundial appearing to sit on the head of the lanky, begowned chemist at the centre of the back row."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a37848b8-3afd-47b6-bb7a-e36e61b77575",
                        "source_entry_id": "d90d5f1b-4ea2-371c-9b1b-ab73e4937438",
                        "target_lang_word": "cadran solaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadran solaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87d3b2f0-0a03-3c9a-ac73-d068050647a6",
                                        "entry_id": "865a1279-e4b9-3a01-9319-7ef2e1943485",
                                        "glosses": [
                                            "Instrument servant à mesurer le temps grâce à l’ombre d’un style projetée par le Soleil sur une surface plane."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23cb35ad-7327-4376-ac72-4c5ad2678fa9",
                                                "sense_id": "87d3b2f0-0a03-3c9a-ac73-d068050647a6",
                                                "text": "Quelle main sacrilège tourna sur son socle la dalle d’ardoise du cadran solaire, qui marque midi à deux heures moins le quart ?"
                                            },
                                            {
                                                "example_id": "80900074-3eae-4a63-8e16-d4ce4ebfa9bf",
                                                "sense_id": "87d3b2f0-0a03-3c9a-ac73-d068050647a6",
                                                "text": "Que ma mémoire fonctionne comme le cadran solaire qui n’indique que les heures ensoleillées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
