                                    {
                                        "sense_id": "3b1fc887-7b4a-362f-99a3-791dc15150b9",
                                        "entry_id": "715e1727-0e98-3630-be62-7918fd946d69",
                                        "glosses": [
                                            "The person who does the prompting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0196a3d5-b33c-4cda-9216-1d0917eeb57a",
                                                "sense_id": "3b1fc887-7b4a-362f-99a3-791dc15150b9",
                                                "text": "The loud ringing of the prompter's bell made her spring suddenly away; and two of his companions, each taking an arm, hurried him away also. How glad would he have been to have left the party: his thoughts were in a tumult; duties and inclinations warred together—nay, his very sense of right was confounded."
                                            }
                                        ]
                                    },
