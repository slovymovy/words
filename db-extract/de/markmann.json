                ],
                "senses": [
                    {
                        "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                        "entry_id": "65b82156-ee76-34a1-b131-26a041dc14f3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a124696a-2736-4c7d-a482-cd69b695975c",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Frau Markmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c733c0d4-7a58-470d-bec2-e59d962ed927",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Herr Markmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "09ad5ce7-3864-4d45-b13c-442714a4263e",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Die Markmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7cd9e6ca-70f3-42ab-b47a-75b4c78327d9",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Der Markmann trägt nie die Schals, die die Markmann ihm strickt."
                            },
                            {
                                "example_id": "e74081c9-cb59-4f7e-9dce-ea256b2f2ebf",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Markmann kommt, geht der Herr Markmann.“"
                            },
                            {
                                "example_id": "c9160051-6ff3-46dd-b9f0-3af4f0bc50b2",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Markmann kommt und geht."
                            },
                            {
                                "example_id": "165f90b9-9d44-452d-9d26-733ac576dd3e",
                                "sense_id": "cfa60d91-271f-30f5-9b9e-d4026afa6338",
                                "text": "Markmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
