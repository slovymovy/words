                                    {
                                        "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                        "entry_id": "53286b9d-7fc6-384a-a95e-8cc8e252044e",
                                        "glosses": [
                                            "Ancienne monnaie d’argent allemande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f34e59b-7444-449a-ba31-3029b7d75b9d",
                                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                                "text": "Lorsqu’on sut que madame Malibran, allant ramasser des thalers en Allemagne, allait passer à deux lieues de Nancy, M. de Sanréal eut l’idée d’organiser un concert."
                                            },
                                            {
                                                "example_id": "aa5ac1fe-c677-4791-b1cb-6667e78b1e8d",
                                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                                "text": "3 000 thalers d’argent à l’effigie de Marie-Thérèse, impératrice d’Autriche — ils n’acceptent pas d’autre monnaie — qu’il fallut acheter à Aden."
                                            },
                                            {
                                                "example_id": "e277e875-a530-4401-b514-a058d8d398c6",
                                                "sense_id": "dded97e3-800f-360b-80c8-fd448cc79820",
                                                "text": "C’est pourquoi, se sentant indigné, il s’avança vers le bohémien, lui mit un thaler dans la main, et, le prenant bras dessus bras dessous, lui dit : « Je te retiens pour cette nuit de Noël ; arrive ! »"
                                            }
                                        ]
                                    }
