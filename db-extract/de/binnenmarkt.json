                ],
                "senses": [
                    {
                        "sense_id": "c5c81aab-b5b6-3090-ab28-3a9664a90198",
                        "entry_id": "c6db4093-3d5a-3c62-b57e-843e3d77d3b1",
                        "glosses": [
                            "Wirtschaftsraum mit bestimmten geographischer Grenzen, in dem Waren, Dienstleistungen, Kapital und Arbeitnehmer frei verkehren können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f9fcc9-ad29-43f7-b8b4-155617fbab47",
                                "sense_id": "c5c81aab-b5b6-3090-ab28-3a9664a90198",
                                "text": "„Gemeinsam sind Deutschland und Österreich von Europas Binnenmarkt abhängig: Rund zwei Drittel der Exporte der beiden Staaten gehen in die Europäische Union.“"
                            },
                            {
                                "example_id": "f7fa19c1-66eb-4228-ab66-6fa6dd6731da",
                                "sense_id": "c5c81aab-b5b6-3090-ab28-3a9664a90198",
                                "text": "„Wenn die Briten [nach dem Brexit] nicht mehr im Binnenmarkt sind, gelten die Regeln der Welthandelsorganisation.“"
                            },
                            {
                                "example_id": "6317fe2d-6185-4336-bfc5-ee8c754c884b",
                                "sense_id": "c5c81aab-b5b6-3090-ab28-3a9664a90198",
                                "text": "„Erst dann, wenn der deutsche Binnenmarkt durch die Abschaffung der vielen Zollgrenzen eine bestimmte Größe erreicht, könne so etwas wie Industrialisierung in Deutschland stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b7e4817-cbb0-4483-802e-2afec28a3f4b",
                        "source_entry_id": "c6db4093-3d5a-3c62-b57e-843e3d77d3b1",
