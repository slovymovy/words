                "senses": [
                    {
                        "sense_id": "74489ad1-2974-35b8-8fc1-c2a5a649a4b8",
                        "entry_id": "5766258e-d7eb-303f-8db4-9b28a8e3862a",
                        "glosses": [
                            "Freundschaft zwischen Männern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae10e02-fe64-4d67-ad2f-f54446cc6ad0",
                                "sense_id": "74489ad1-2974-35b8-8fc1-c2a5a649a4b8",
                                "text": "Die echte Männerfreundschaft ist selten, wer sie gefunden hat, sollte sich bemühen sie nicht zu verlieren."
                            },
                            {
                                "example_id": "bfe50012-f36b-408c-90a1-d4bf4c0cc3fa",
                                "sense_id": "74489ad1-2974-35b8-8fc1-c2a5a649a4b8",
                                "text": "„Bei der Luftwaffe entstanden Männerfreundschaften, ein jeder sprang für den anderen ein, und alle bewunderten die tollen Flieger mit ihren Maschinen.“"
                            }
                        ],
