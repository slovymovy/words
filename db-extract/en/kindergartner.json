                    {
                        "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                        "entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
                        "glosses": [
                            "A child who attends a kindergarten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c37748b-b396-4862-ad5b-1f9e1e314917",
                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                "text": "I partnered the older kids with my kindergartners and let everyone get a taste of teaching or learning from someone different."
                            },
                            {
                                "example_id": "d86529c6-d43e-4742-91a5-11b83d4cbdf2",
                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                "text": "All 50 states have had school immunization requirements since the beginning of the 1980s, with incoming kindergartners needing shots to protect against diseases including measles, polio and tetanus. No states require a Covid-19 vaccine for schoolchildren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c42ff377-b0e7-46f6-9046-9fb840fc0bd2",
                        "source_entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
                        "source_sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
