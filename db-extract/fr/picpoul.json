                "senses": [
                    {
                        "sense_id": "79fe86f1-996c-397e-9b27-5a98054ef05c",
                        "entry_id": "ef1f9823-3a59-3302-82f7-6d7fd9d0a9f9",
                        "glosses": [
                            "Ce nom est utilisé, selon les régions, en tant que synonyme du cépage folle blanche. Au catalogue des espèces il n'y a aucun picpoul tout court mais : picpoul blanc, picpoul gris et picpoul noir. Le cépage calitor est parfois nommé picpoul sorbier"
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "54cebdc4-2f7e-4504-b0a6-14bd1ffcad5f",
                                "sense_id": "79fe86f1-996c-397e-9b27-5a98054ef05c",
                                "text": "Les vignes de vin de consommation courante sont installées, principalement, dans la plaine d’inondation et sur les terrasses […] Le Picpoul est planté sur les terrasses."
                            },
                            {
                                "example_id": "2a7447ed-a7a5-4275-ae22-6d450c92bf1b",
                                "sense_id": "79fe86f1-996c-397e-9b27-5a98054ef05c",
                                "text": "Le picpoul local ne dépareille pas dans le seau à champagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "f71cd292-f3c1-3239-9d7d-07f4b0334298",
                        "entry_id": "ef1f9823-3a59-3302-82f7-6d7fd9d0a9f9",
                        "glosses": [
                            "Vin blanc obtenu avec ce cépage."
                        ],
