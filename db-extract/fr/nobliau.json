                ],
                "senses": [
                    {
                        "sense_id": "226bb362-a53e-36ab-9524-a3568c93eb3c",
                        "entry_id": "de9d5090-cdce-3c46-9b71-75cdbcaec4b1",
                        "glosses": [
                            "Un noble, un gentilhomme qui n'a que sa noblesse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef656b0-dccd-42f9-8283-846a3f295653",
                                "sense_id": "226bb362-a53e-36ab-9524-a3568c93eb3c",
                                "text": "Un monde de petits nobliaux, labourant l’épée au côté."
                            },
                            {
                                "example_id": "83c6efbe-a7e2-439f-b9c0-d73370070403",
                                "sense_id": "226bb362-a53e-36ab-9524-a3568c93eb3c",
                                "text": "Les filles de nobliaux seront absorbées par les roturiers enrichis… et les fils des hobereaux démocratiseront leur nom et s'associeront à leurs beaux-pères industriels, s'excusant dans les réunions d'être « nés nobles. »"
                            },
                            {
                                "example_id": "a9c885c8-c363-408c-9ab4-9b3a590ac0e7",
                                "sense_id": "226bb362-a53e-36ab-9524-a3568c93eb3c",
                                "text": "Celle-ci, qui se montrait glaciale avec les petits nobliaux que le voisinage de Féterne la forçait à fréquenter …"
                            },
                            {
                                "example_id": "dc955f3e-690b-412e-acfa-298c03c6f490",
                                "sense_id": "226bb362-a53e-36ab-9524-a3568c93eb3c",
                                "text": "Alexis Slavsky, artiste peintre, était Français à la deuxième génération, croisement du sang bleu d’un nobliau polonais et du sang vermeil d’une belle Juive russe."
                            }
                        ]
                    }
                ],
