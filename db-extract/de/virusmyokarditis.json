                ],
                "senses": [
                    {
                        "sense_id": "770616bd-a1d1-369d-93e9-02a4bd438a1d",
                        "entry_id": "349e0e9b-0928-3ffd-859e-1b2993f97a03",
                        "glosses": [
                            "Entzündung des Herzmuskels, die durch ein Virus verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d54b51-e211-42c8-860e-76a148859635",
                                "sense_id": "770616bd-a1d1-369d-93e9-02a4bd438a1d",
                                "text": "„‚Als Todesursache‘, gab Avenarius bekannt, ‚hat der Sachverständige eine durch Viren ausgelöste Entzündung der Herzmuskulatur (Virusmyokarditis) festgestellt. […]‘“"
                            },
                            {
                                "example_id": "32e651d1-8628-4a0e-930a-2f7fa8cc9a4f",
                                "sense_id": "770616bd-a1d1-369d-93e9-02a4bd438a1d",
                                "text": "„Klinisch scheint die Virusmyokarditis in einem weit überwiegenden Prozentsatz durch CoxsackieB-Viren, Adenoviren und Parvovirus B19 hervorgerufen zu werden.“"
                            },
                            {
                                "example_id": "2c93fde8-c542-4fbd-9ce0-4cd6b6c77a10",
                                "sense_id": "770616bd-a1d1-369d-93e9-02a4bd438a1d",
                                "text": "„Mit dem Rückgang der bakteriellen wie auch der bakteriellallergischen Myokarditis (Rheumatismus, Scharlach u.a.) ist in den letzten Jahren die Virusmyokarditis immer mehr in den Vordergrund getreten.“"
                            },
                            {
                                "example_id": "664512c1-5e92-4778-8d94-e0c3d1b4fdfe",
                                "sense_id": "770616bd-a1d1-369d-93e9-02a4bd438a1d",
                                "text": "„Obwohl vieles dafür spricht, daß die Virusmyokarditis in eine dilatative Kardiomyopathie übergeben kann, ist bislang unklar, ob die Virusinfektion bzw. eine fortbestehende komplette oder inkomplette Virusreplikation allein die Progression initiiert oder ob ein autoimmunologischer Mechanismus für den progredienten Verlauf verantwortlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
