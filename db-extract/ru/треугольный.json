                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8c4825-f353-4002-bd4a-c71038c0cc3c",
                                                "sense_id": "9172a405-7657-33ca-b8fc-bc561c494214",
                                                "text": "Der Hut aus dem Lied „Mein Hut, der hat drei Ecken“ ist dreieckig."
                                            },
                                            {
                                                "example_id": "24da657c-96d4-436e-8745-de7d09fe8bf6",
                                                "sense_id": "9172a405-7657-33ca-b8fc-bc561c494214",
                                                "text": "„Typisch für die meist aus Feuerstein und anderen feinkörnigen Gesteinsarten hergestellten Faustkeile ist die durch beiderseitige Abschläge hergestellte dreieckige bis birnenförmige Form.“"
                                            }
                                        ],
