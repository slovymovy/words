        "pl-extract.jsonl": [
            {
                "entry_id": "caf1521b-ad7b-34cc-9819-0a8bf8c9d0f5",
                "word": "szwank",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d0c729f-ba55-323f-aea3-7536da35f5fe",
                        "entry_id": "caf1521b-ad7b-34cc-9819-0a8bf8c9d0f5",
                        "glosses": [
                            "krzywda, ujma, uszkodzenie, strata"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5bae3762-7624-4e3d-bb84-719bf771acb8",
                                "sense_id": "3d0c729f-ba55-323f-aea3-7536da35f5fe",
                                "text": "Boję się, żebyś z żalu na zdrowiu szwanku nie poniosła"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "df6632ac-6073-307c-aecc-27d5ba79b3f4",
                        "entry_id": "caf1521b-ad7b-34cc-9819-0a8bf8c9d0f5",
                        "glosses": [
                            "cięcie, uderzenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "67f567f1-4a22-487e-9108-a51fc6eee91e",
                                "sense_id": "df6632ac-6073-307c-aecc-27d5ba79b3f4",
                                "text": "Począł umykać do swojej godpody, lecz dościgniony, (…) po wielu odebranych szwankach, tamże zabity poległ"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e81547c-2818-40e2-95c5-9a199b310dc2",
                        "source_entry_id": "caf1521b-ad7b-34cc-9819-0a8bf8c9d0f5",
                        "source_sense_id": "3d0c729f-ba55-323f-aea3-7536da35f5fe",
                        "target_lang_word": "ущерб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ущерб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd012d11-a94c-3f3a-9931-15ba7286ccae",
                                        "entry_id": "a635fba3-58f1-3332-a08b-3fee4a81db9b",
                                        "glosses": [
                                            "урон, потеря, убыток (материальный или моральный)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf3fd5e-9aaf-467f-b710-188560f13953",
                                                "sense_id": "bd012d11-a94c-3f3a-9931-15ba7286ccae",
                                                "text": "Работа разложения делала своё дело, и прежнее прочное и цельное миросозерцание терпело видимые ущербы."
                                            },
                                            {
                                                "example_id": "f8b10448-3cea-486d-89e0-013f92f37618",
                                                "sense_id": "bd012d11-a94c-3f3a-9931-15ba7286ccae",
                                                "text": "Феликс Помада умер от перепоя, когда сын его был ещё в третьем классе; но его смерть не произвела никакого ущерба в труженическом бюджете вдовы, и она, собирая зёрнышко к зёрнышку, успела накопить около ста рублей, назначавшихся на отправку Юстина в Харьковский университет."
                                            },
                                            {
                                                "example_id": "f9e888a1-8eba-44c9-bac4-08681c4adce8",
                                                "sense_id": "bd012d11-a94c-3f3a-9931-15ba7286ccae",
                                                "text": "Простите мою горячность, но я не могу действовать в ущерб здравому смыслу и убеждению."
                                            },
                                            {
                                                "example_id": "35018efa-5800-4f2e-bcda-6e8a4f615113",
                                                "sense_id": "bd012d11-a94c-3f3a-9931-15ba7286ccae",
                                                "text": "Да не забудь, скажи ей от меня, что за это дело я сама взялась, сама, и от всего моего сердца, и чтоб она была спокойна, и что гордости её ущербу не будет…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabda898-3929-3618-be48-a2cc9fec5098",
                                        "entry_id": "a635fba3-58f1-3332-a08b-3fee4a81db9b",
                                        "glosses": [
                                            "перен. вид, фаза убывающей луны в виде серпа, который постепенно уменьшается"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdb147e-b1fc-480c-9862-1bc811501886",
                                                "sense_id": "dabda898-3929-3618-be48-a2cc9fec5098",
                                                "text": "К полнолунию идут на войну; при ущербе луны отступают."
                                            },
                                            {
                                                "example_id": "29246db4-934d-40bf-9be7-32ddf70b38fc",
                                                "sense_id": "dabda898-3929-3618-be48-a2cc9fec5098",
                                                "text": "Хотел он бежать в ту же ночь. Ночи были тёмные, — ущерб месяца."
                                            },
                                            {
                                                "example_id": "653e8d7c-7685-4b56-a156-305b7de49c99",
                                                "sense_id": "dabda898-3929-3618-be48-a2cc9fec5098",
                                                "text": "Но ракета быстро мчалась к востоку, и фаза уменьшалась, Земля принимала понемногу вид огромной вогнутой Луны в ущербе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7464fb-3e12-3529-84a9-ba1f26c99906",
                                        "entry_id": "a635fba3-58f1-3332-a08b-3fee4a81db9b",
                                        "glosses": [
                                            "юр. имущественный и неимущественный вред, причиненный противоправными действиями или бездействием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a143be0e-fdbc-4896-a806-1aa6a89f94da",
                                                "sense_id": "ea7464fb-3e12-3529-84a9-ba1f26c99906",
                                                "text": "При умышленном нарушении обязательств по договору адвокат несёт ответственность в полном объёме ущерба."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
