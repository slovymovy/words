                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ab74ce6-6019-499b-a7ed-6d8e13cf7bb7",
                                                "sense_id": "e597d969-5dfb-3f54-a51c-cfb6e55a0796",
                                                "text": "Рабочий посёлок."
                                            },
                                            {
                                                "example_id": "f8a8ea88-08dd-45dd-bc85-e0a730dffc18",
                                                "sense_id": "e597d969-5dfb-3f54-a51c-cfb6e55a0796",
                                                "text": "Она-де горожанка, руки у неё не рабочие, она не знает, что делать в огороде, со скотиной не умеет обращаться, доить не умеет, и при этом перечислении матушка заметно оживилась и повеселела."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43567ab-6301-3467-aaf2-a7fdf6f3dde7",
                                        "entry_id": "3655fe7f-6309-3279-8563-394ee9754dec",
                                        "glosses": [
                                            "находящийся в работе; предварительный, пробный, черновой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b849a8-dbd3-4f32-9dab-4ccec42d9fa9",
                                                "sense_id": "c43567ab-6301-3467-aaf2-a7fdf6f3dde7",
                                                "text": "Рабочий вариант."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc9b5424-c92b-3ae2-a2b4-43da2329c389",
                                        "entry_id": "3655fe7f-6309-3279-8563-394ee9754dec",
                                        "glosses": [
                                            "способный нормально работать, функционировать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9f9e94-a75a-4053-ae25-19f1f3808ff2",
                                                "sense_id": "bc9b5424-c92b-3ae2-a2b4-43da2329c389",
                                                "text": "А что, этот план вполне рабочий!"
                                            },
                                            {
                                                "example_id": "383b4985-3b40-41d0-b9f4-82a3af3afdf2",
                                                "sense_id": "bc9b5424-c92b-3ae2-a2b4-43da2329c389",
                                                "text": "У тебя случайно не завалялся какой-нибудь телефон, пусть старенький, но чтобы рабочий."
                                            }
                                        ]
                                    }
                                ]
                            },
