                        "cross_references": [
                            {
                                "target_word": "anastomose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc73128-5bd3-3f0a-ae18-372b9c94ba93",
                                        "entry_id": "58bf1f6b-f8df-309b-84e7-3f9817d4c739",
                                        "glosses": [
                                            "Embouchure d’un vaisseau dans un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c26838-3c09-4c99-b1a3-e20cbe262a7d",
                                                "sense_id": "ecc73128-5bd3-3f0a-ae18-372b9c94ba93",
                                                "text": "L’anastomose des veines, des artères."
                                            },
                                            {
                                                "example_id": "4f2f26f0-b796-4355-9202-3125962c61d1",
                                                "sense_id": "ecc73128-5bd3-3f0a-ae18-372b9c94ba93",
                                                "text": "Par ailleurs, la perte du réservoir rectal après anastomose colorectale très basse ou anastomose colo-anale directe est souvent responsable de troubles de l’exonération et d’une augmentation de fréquence des selles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2192de08-030d-3e5e-b77b-ea54f75a05e1",
                                        "entry_id": "58bf1f6b-f8df-309b-84e7-3f9817d4c739",
                                        "glosses": [
                                            "Communication entre deux conduits de même nature ou entre deux nerfs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5831f33c-5c59-4eb8-9f3d-ca8d60194af9",
                                                "sense_id": "2192de08-030d-3e5e-b77b-ea54f75a05e1",
                                                "text": "Les perforations sont rares, de 0,1 à 0,3 % des procédures, avec un risque majoré en cas d’entéroscopie par voie basse, de sténose liée à une maladie de Crohn, d’anastomose intestinale récente ou de lymphome traité par radiothérapie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3593d19c-3fd1-3831-a8d7-552510482ce0",
                                        "entry_id": "58bf1f6b-f8df-309b-84e7-3f9817d4c739",
                                        "glosses": [
                                            "Réunion de différents canaux, de cours d'eau."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f1105d-775c-4964-bdca-e258092d8c9c",
                                                "sense_id": "3593d19c-3fd1-3831-a8d7-552510482ce0",
                                                "text": "Après avoir traversé le canton de Beauvais le Thérain rentre dans celui de Nivillers un peu au dessus de Wagicourt et forme dans les prairies de Therdonne diverses anastomoses dont quelques unes sont d'anciens fossés de limites."
                                            },
                                            {
                                                "example_id": "94fa6221-1bb1-4091-a84e-611fbe7688f4",
                                                "sense_id": "3593d19c-3fd1-3831-a8d7-552510482ce0",
                                                "text": "Dans une plaine immense, cinquante à cent lits séparés ou liés se croisent, enchevêtrés par de multiples anastomoses ; tout canal y peut faire obstacle et tout barrage passage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f1ca2bf-80cf-3537-ae53-906fb4daf113",
                                        "entry_id": "58bf1f6b-f8df-309b-84e7-3f9817d4c739",
                                        "glosses": [
                                            "Interveinure reliant les lames de certains champignons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
