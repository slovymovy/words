                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2621ac-ae0b-4191-8b63-80b0a1b8e612",
                                                "sense_id": "2b6708e5-b3de-32eb-a397-284d33b106bf",
                                                "text": "Das apikale Sprossmeristem einiger Monocotyledonen (Poaceen, Elodea) und Eudicotyledonen (Hippuris) ist hingegen schmal und gestreckt, die Scheitelspitze stark vom jüngsten Knoten absetzend."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
