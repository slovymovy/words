                                "example_id": "856472ef-2730-4872-aef9-06c973b4dfe0",
                                "sense_id": "4f87d4d8-13f4-375e-96b4-bf5f85d2b5d5",
                                "text": "Pour hasher un mot de passe en PHP, on peut utiliser plusieurs fonctions que je vous présente ci-dessous."
                            },
