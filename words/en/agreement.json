                            },
                            {
                                "target_lang_word": "porozumienie",
                                "target_lang_sense_clarification": "wzajemne ustalenie lub konsensus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39846f39-e1e1-309f-9833-7a99b9c08553",
                    "sense_definition": "A state where several parties share the same view, opinion, or feeling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am in complete <w>agreement</w> with your proposal.",
                            "target_lang_translations": {
                                "ru": "Я полностью <w>согласен</w> с вашим предложением.",
                                "zh": "我完全<w>同意</w>你的提议。",
                                "pl": "Jestem w pełnej <w>zgodzie</w> z twoją propozycją."
                            }
                        },
                        {
                            "text": "She nodded her head in <w>agreement</w> as he spoke.",
                            "target_lang_translations": {
                                "ru": "Она кивнула в знак <w>согласия</w>, пока он говорил.",
                                "zh": "他说话时，她点头表示<w>赞同</w>。",
                                "pl": "Kiwnęła głową na <w>zgodę</w>, gdy on mówił."
                            }
