                                "example_id": "e9f7f626-6f63-474d-9684-760644b10445",
                                "sense_id": "f87f6823-4c6b-38d9-b326-03fe546753b1",
                                "text": "Lituanie - Estonie : les tigres baltiques."
                            }
                        ]
                    }
                ],
                "translations": [
