                ],
                "senses": [
                    {
                        "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                        "entry_id": "50f61416-303c-30da-acae-d6215c584054",
                        "glosses": [
                            "Menge an Energie (= Kalorien), die ein (menschlicher oder tierischer) Körper verbraucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca926617-b2b5-483e-97f7-4366a0434e2a",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "Wer abnehmen will, sollte seinen Kalorienverbrauch erhöhen."
                            },
                            {
                                "example_id": "0922eb1d-4d79-48be-b68c-afd9f16e7442",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "Die Trackingwatch zeigt dir die am Tag zurückgelegten Schritte, den Puls und den Kalorienverbrauch an."
                            },
                            {
                                "example_id": "a6c939bd-1149-4763-839a-82dc70fc739c",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Die sogenannten Tracker zeichnen die Anzahl der Schritte auf, berechnen die zurückgelegte Strecke und ermitteln den Kalorienverbrauch.“"
                            },
                            {
                                "example_id": "df748c7a-d8b8-4297-85f3-d7a7e43cb670",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "Seit ich verletzt bin, ist mein Kalorienverbrauch stark gesunken, ich habe zwei Kilogramm zugelegt."
                            },
                            {
                                "example_id": "1f7fd376-83b0-4061-ab66-9898853b72b8",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "Der Kalorienverbrauch eines Tour de France-Fahrers ist enorm: bis zu 9.000 kcal benötigt ein Fahrer pro Tag."
                            },
                            {
                                "example_id": "fe0b7de7-ad4b-426d-81f2-f68a10c25c6c",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Bei reichlicher und intensiver körperlicher Aktivität ist der Kalorienverbrauch entsprechend gesteigert.“"
                            },
                            {
                                "example_id": "51f72e72-643e-49c1-a69c-f591e4f22800",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Die gute Nachricht ist, dass der Ruheumsatz, also der Kalorienverbrauch in Ruhe, nicht zwangsläufig im Alter abnimmt. Das Zauberwort heißt \"Bewegung\".“"
                            },
                            {
                                "example_id": "86be27cb-cbf3-4f36-87c0-c4be9f512243",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Als Frau in den mittleren Jahren, in denen der Appetit leider nicht zusammen mit dem Kalorienverbrauch sinkt, will ich mich mal wieder ans Abnehmen wagen.“"
                            },
                            {
                                "example_id": "ee16d2ce-9d10-404a-850f-1229e2daf24b",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "[Beim Abnehmen geht es] „»immer um die Bilanz von Kalorienzufuhr und Kalorienverbrauch. Idealerweise ist es so, dass sie weniger Kalorien zu sich nehmen und mehr Kalorien verbrennen.«“"
                            },
                            {
                                "example_id": "a44466b7-aefc-43f1-b5da-fe2f8b03566a",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Wer fit werden und dabei noch abnehmen will, legt ein besonderes Augenmerk auf den Kalorienverbrauch.“"
                            },
                            {
                                "example_id": "fb21236c-f8f8-4174-89a8-7d7e5f73e102",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Zumba besteht aus Elementen lateinamerikanischer Tänze wie Salsa, Merengue, Samba oder Cumbia. […] Das Ganze soll so schweißtreibend sein, dass man angeblich bis zu 1000 Kalorien pro Stunde verliert. […] Zum hohen Kalorienverbrauch sollen weitere angenehme Nebenwirkungen wie festere Pobacken und ein straffer Bauch hinzukommen.“"
                            },
                            {
                                "example_id": "559ef30b-aba7-4273-bfbd-13957de3a55d",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Übergewicht – Wer zu viel Gewicht auf die Waage bringt, erhöht das Schlaganfall-Risiko um das Zwei- bis Dreifache. Daher sollte die tägliche Kalorienaufnahme möglichst dem täglichen Kalorienverbrauch entsprechen.“"
                            },
                            {
                                "example_id": "74725e3f-8edc-4ad5-a968-9991e1c49456",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "[Die Wissenschaftler halten] „den Kalorienverbrauch für den Schlüsselmechanismus, der das Risiko für Herz-Kreislauf-Erkrankungen reduziert.“"
                            },
                            {
                                "example_id": "ccbfb633-9bc9-457e-af7c-d0fb410da5db",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "„Hatte der durchschnittliche Kalorienverbrauch in Deutschland im Jahre 1936 mit 3113 Kalorien noch über der vom Völkerbund empfohlenen Norm von 3000 Kalorien am Tag gelegen, so war er bis zum Frühjahr 1945 allmählich auf 2010 abgesunken, um 1946 bei 1451 täglichen Kalorien einen Tiefstand zu erreichen, der regional und lokal sogar noch unterschritten wurde.“"
                            },
                            {
                                "example_id": "80c6c0bd-6acb-4c83-b999-ede0374cf7df",
                                "sense_id": "23e9f364-ab78-3b73-80d8-8e370a5ee334",
                                "text": "[Erster Weltkrieg:] „Der kontinuierlich gestiegene Kalorienverbrauch der Kaiserzeit, die erstmals alle Menschen in Deutschland satt gemacht hatte, stürzte ab. Der Hunger nahm weite Teile Europas in den Würgegriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
