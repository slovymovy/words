                "senses": [
                    {
                        "sense_id": "da41f189-e340-3d72-a693-7dee7b5b8304",
                        "entry_id": "b82de132-1e7e-3f57-95c3-c60274674f0e",
                        "glosses": [
                            "Rendre présent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a8eafd-2525-4df8-8dcd-78731e3f4153",
                                "sense_id": "da41f189-e340-3d72-a693-7dee7b5b8304",
                                "text": "Pour présentifier l'absence du verrou, je dois m'orienter vers le verrou lui-même."
                            },
                            {
                                "example_id": "60c9b599-7a84-4599-a373-2dae1c8e2bd1",
                                "sense_id": "da41f189-e340-3d72-a693-7dee7b5b8304",
                                "text": "Au contraire, pour présentifier l'absence, je dois avoir d'emblée dévoilé l'étant qui manque."
                            },
                            {
                                "example_id": "932280f1-867c-48a3-b9e4-552e764163b1",
                                "sense_id": "da41f189-e340-3d72-a693-7dee7b5b8304",
                                "text": "Et soudain, en pleine guerre, au cœur des pires dangers, cette mère des hontes et des craintes se présentifiait à moi tout autre, par l’amour que lui vouait un extraordinaire magicien."
                            }
                        ]
                    }
