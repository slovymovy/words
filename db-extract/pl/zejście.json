                            {
                                "example_id": "7895b31b-9c45-4c99-afc2-e68f2136a2e9",
                                "sense_id": "be493711-ccaa-3877-9c88-44d384a112ba",
                                "text": "Podczas zejścia ze Świnicy zginął tragicznie Józef Szaniawski."
