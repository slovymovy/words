                "senses": [
                    {
                        "sense_id": "f8edaa0a-37b1-35de-a563-3d6931302b88",
                        "entry_id": "ed23d216-a660-38fc-a591-7e06c056dd47",
                        "glosses": [
                            "To swallow greedily or in large amounts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8c56fe-2c98-416e-8c91-bf46cb4f0dff",
                                "sense_id": "f8edaa0a-37b1-35de-a563-3d6931302b88",
                                "text": "Nothing pesters the body and mind sooner than to be still fed, to eat and ingurgitate beyond all measure, as many do."
                            }
                        ]
                    },
                    {
                        "sense_id": "35c1a1d7-036a-388c-aa7f-80281350318f",
                        "entry_id": "ed23d216-a660-38fc-a591-7e06c056dd47",
                        "glosses": [
                            "To swallow up, as in a gulf."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8c72b94d-2ba8-4166-bef8-21a39d2580bc",
                                "sense_id": "35c1a1d7-036a-388c-aa7f-80281350318f",
                                "text": "If a man do but once set his appetite upon it [pleasure], let him ingurgitate himself never so deep into it, yet shall he never be able to fill his desire with it."
                            }
                        ]
                    }
                ],
