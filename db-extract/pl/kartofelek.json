                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fcfefd5-db66-488a-9371-0def6a6a4b77",
                        "source_entry_id": "2bbe41dd-d267-35aa-9eb9-114b8b54217b",
                        "source_sense_id": "22bcbf11-dea4-39a0-b28e-ffbf232ec27a",
                        "target_lang_word": "баядерка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "баядерка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa52ce0-2d57-36e3-b5a3-4d4a17c5313e",
                                        "entry_id": "0ac74dc7-24dc-36bb-ac12-1b09aaa0ff1c",
                                        "glosses": [
                                            "устар. уменьш.-ласк. к баядера; индийская храмовая танцовщица и певица || восточная танцовщица"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52695960-7cd6-4d58-adde-dd833b69a6ca",
                                                "sense_id": "aaa52ce0-2d57-36e3-b5a3-4d4a17c5313e",
                                                "text": "Но удивительнее всего была сама Инна. Она стояла посреди комнаты в настоящем шёлковом костюме баядеры с двумя круглыми вставками для груди, на голых от колена ногах были надеты широкие туфли без задников, между туникой и шароварами белела полоска живота, а тонкие, чуть-чуть смуглые руки обвивали широкие медные браслеты. Она сосала сахар, намоченный в одеколоне, чтобы зрачки были больше и ярче. Признаюсь, я немного смутился, хотя часто видел таких баядерок в храмах Бенареса и Дели."
                                            },
                                            {
                                                "example_id": "a7861f4c-08e5-4c16-bf78-01b1b0c0aecc",
                                                "sense_id": "aaa52ce0-2d57-36e3-b5a3-4d4a17c5313e",
                                                "text": "Обеды в семейных домах сменялись пирами в загородных садах, где под звук тамбурина шемахинских баядерок вокруг стола ходили азарпеш да турий рог, через край переливаясь красною струёй кахетинского."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a431ed07-8aa7-3e95-be25-ec30119a8e4e",
                                        "entry_id": "0ac74dc7-24dc-36bb-ac12-1b09aaa0ff1c",
                                        "glosses": [
                                            "устар., перен. женщина лёгкого поведения, куртизанка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b401249-cd42-4072-b2ad-b7cd196e0411",
                                                "sense_id": "a431ed07-8aa7-3e95-be25-ec30119a8e4e",
                                                "text": "Я постигаю в женщине слабость; могу представить, что страсть может увлечь её; но поместить в свою голову мысль об этом глубоком, расчётливом, бесстрастном разврате — это выше сил моих! Я видел в Турции одну баядерку: она вынула из-под подушки своей вески и медленно взвешивала предлагаемые ей червонцы, надбавляя цены, глядя в очи путника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c99bd2-4ab0-3a10-9281-84799610e0f2",
                                        "entry_id": "0ac74dc7-24dc-36bb-ac12-1b09aaa0ff1c",
                                        "glosses": [
                                            "спец. сорт полосатой полушерстяной ткани"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2e65a60-6f5b-35a3-942d-7fbf9fdb12a8",
                                        "entry_id": "0ac74dc7-24dc-36bb-ac12-1b09aaa0ff1c",
                                        "glosses": [
                                            "изделие из такой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f551280-abfa-40f8-a256-1de639895eb9",
                                                "sense_id": "d2e65a60-6f5b-35a3-942d-7fbf9fdb12a8",
                                                "text": "А вечером на танцах он увидел девушку, которую себе намечтал, пока вез вигоневую баядерку на пяти пуговицах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70a91535-4e5d-4698-94c2-56bf4dda077f",
                        "source_entry_id": "2bbe41dd-d267-35aa-9eb9-114b8b54217b",
                        "source_sense_id": "22bcbf11-dea4-39a0-b28e-ffbf232ec27a",
                        "target_lang_word": "картошка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "картошка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "319b019b-17f9-3607-81bb-ae951a7fb3c8",
                                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                                        "glosses": [
                                            "разг. то же, что картофель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff8ade6-82a3-4942-929f-7d6fa0365029",
                                                "sense_id": "319b019b-17f9-3607-81bb-ae951a7fb3c8",
                                                "text": "Уже был один никем не замеченный мороз: почернела ботва на картошке, брусника стала мягкая, горькая рябина ― сладкая и зелёная клюква ― багрово-красная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9925d82-b592-3339-a057-a087e761e890",
                                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                                        "glosses": [
                                            "разг., то же, что картофелина"
                                        ],
                                        "tags": [
                                            "иногда неисч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7365e7-b7fc-4c06-8db4-eac53f0e8a67",
                                                "sense_id": "a9925d82-b592-3339-a057-a087e761e890",
                                                "text": "Он достал опять складной ножик, разрезал на своей ладони картошку на равные две половины, посыпал соли из тряпки и поднёс Пьеру."
                                            }
                                        ]
                                    },
                                    {
