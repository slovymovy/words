                    {
                        "form_id": "0dd3abd0-be35-4a57-ac94-ad2e199b0551",
                        "entry_id": "d7e3d1cd-31b5-3f09-b4ac-45e5e429da49",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Erwachsenenalter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "570a66a4-4f02-3f3e-892e-93a4baef926b",
                        "entry_id": "d7e3d1cd-31b5-3f09-b4ac-45e5e429da49",
                        "glosses": [
                            "Altersabschnitt, der gewöhnlich mit dem 19. Lebensjahr beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e36030-f4df-48c9-964f-e106617eac27",
                                "sense_id": "570a66a4-4f02-3f3e-892e-93a4baef926b",
                                "text": "„Psychosoziale Faktoren aus den frühen kindlichen Lebensphasen könnten Hirnfunktionen verändern, womit möglicherweise eine erhöhte Vulnerabilität verbunden ist, welche zur Erklärung des späteren psychischen Erkrankens (möglicherweise erst im Erwachsenenalter) beiträgt.“"
                            },
                            {
                                "example_id": "b75314ac-6489-4258-a045-9a7e4c972808",
                                "sense_id": "570a66a4-4f02-3f3e-892e-93a4baef926b",
                                "text": "„Den erhält das Kind von seiner Mutter oder von einem Priester, aber es erfährt ihn erst im Erwachsenenalter, und auch dann nur, wenn man es dieses Namens für würdig erachtet.“"
                            },
                            {
                                "example_id": "85743c35-1012-480e-9b34-65fbefadee9d",
                                "sense_id": "570a66a4-4f02-3f3e-892e-93a4baef926b",
                                "text": "„Abgesehen von Ola, Sara und mir war niemand aus Finneide anwesend, niemand von der Grundschule oder der Realschule in Hemnes, die meisten hatten Leif offenbar erst im Erwachsenenalter kennengelernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54406566-2811-45fc-bbb4-56e31ef22df1",
                        "source_entry_id": "d7e3d1cd-31b5-3f09-b4ac-45e5e429da49",
                        "source_sense_id": "570a66a4-4f02-3f3e-892e-93a4baef926b",
                        "source_sense_description": "Alter eines Erwachsenen",
                        "target_lang_word": "adulthood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adulthood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5276445-6020-3466-a818-ff2d182be251",
                                        "entry_id": "95a66ac8-c2ac-360e-9ec4-c04f9765226d",
                                        "glosses": [
                                            "The state or condition, for humans and other animals, of physical and psychological maturity: being an adult."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e38f672-9b1d-471a-96f2-030291126580",
                                                "sense_id": "e5276445-6020-3466-a818-ff2d182be251",
                                                "text": "Meronyms: young adulthood; emerging adulthood (sometimes construed as coordinate)"
                                            },
                                            {
                                                "example_id": "e1d68248-8350-411d-a3a3-4d56da41b252",
                                                "sense_id": "e5276445-6020-3466-a818-ff2d182be251",
                                                "text": "Adulthood enables us to survive in the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                        "entry_id": "95a66ac8-c2ac-360e-9ec4-c04f9765226d",
                                        "glosses": [
                                            "The time period of a person's majority, following puberty and lasting until death."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d8e76f-b8d4-49ce-913c-b514b499de90",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "Meronyms: young adulthood; emerging adulthood (sometimes construed as coordinate)"
                                            },
                                            {
                                                "example_id": "cb1cbf3e-11c7-41cd-9b68-1de9694bf568",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "The boy entered adulthood by undergoing a rite of passage."
                                            },
                                            {
                                                "example_id": "da92da1c-bf27-4c1d-b9a3-285e1902796c",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "The things learned in childhood affect us throughout our adulthood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
