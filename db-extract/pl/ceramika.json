                        "entry_id": "905d3f92-53fb-330c-8305-36e4b1fa5fb3",
                        "glosses": [
                            "dziedzina sztuki, rzemiosła i przemysłu; sztuka wyrabiania przedmiotów z wypalonej gliny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76aefee8-b9ca-4c3d-98fe-9edc1f531935",
                                "sense_id": "63ce62de-82c6-32a4-ab20-7b7687694db1",
                                "text": "Zwłaszcza że w Pałacu Kultury, gdzie mama prowadziła pracownię rzeźby i ceramiki, o tej porze roku trwała właśnie przerwa świąteczna i wykręt, że czasu brak, odpadał sam przez się"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
