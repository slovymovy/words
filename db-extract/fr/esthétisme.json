                "senses": [
                    {
                        "sense_id": "8a0fd21b-020c-3269-af27-08ff588b27ea",
                        "entry_id": "ac8ca5c8-6f5a-358c-b2ac-8ca36245f068",
                        "glosses": [
                            "Courant artistique et littéraire anglais du dernier quart du XIXᵉ siècle, repris en France vers 1890-1900."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb268865-0e93-3fa8-9a9c-c4fd13c09b8a",
                        "entry_id": "ac8ca5c8-6f5a-358c-b2ac-8ca36245f068",
                        "glosses": [
                            "Tendance à évaluer les choses du seul point de vue esthétique, le beau étant alors considéré comme une valeur absolue."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "db0ea137-164f-487a-832c-5ed8972b5b18",
                                "sense_id": "fb268865-0e93-3fa8-9a9c-c4fd13c09b8a",
                                "text": "La distance créée par le vieillissement du texte est certes goûtée et entre dans le jeu de l’esthétique littéraire. Mais, s’il faut répéter cette évidence, elle est aussi et d’abord subie. Elle est source d’incompréhension."
                            }
                        ]
                    },
                    {
                        "sense_id": "babfc268-ca84-3804-8426-0764bf937e46",
                        "entry_id": "ac8ca5c8-6f5a-358c-b2ac-8ca36245f068",
                        "glosses": [
                            "Jugement particulier sur les caractéristiques de ce qui est beau ou non."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2b302e37-faf9-43b3-b035-89a1c43f3f6a",
                                "sense_id": "babfc268-ca84-3804-8426-0764bf937e46",
                                "text": "« Défendre la liberté du langage musical contre tous les esthétismes tyranniques », telle était la devise du groupe « Zodiaque », fondé en 1947 par Maurice Ohana."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e75581-5def-435d-bdaf-55b2f6d250a4",
                        "source_entry_id": "ac8ca5c8-6f5a-358c-b2ac-8ca36245f068",
                        "target_lang_word": "aestheticism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aestheticism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cce9e1e2-d434-3302-9d72-7140c03c07c8",
                                        "entry_id": "e1039116-9f35-3eaf-afa8-105f4f4057c8",
                                        "glosses": [
                                            "A doctrine which holds aesthetics or beauty as the highest ideal or most basic standard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b4fb1c-34ff-490d-9793-2a14d0017f8c",
                                                "sense_id": "cce9e1e2-d434-3302-9d72-7140c03c07c8",
                                                "text": "He went over his canvases with disgust and anger, unable to see virtue in any one of them. Even his sacred Oyster Girl went back on him. The creature of a vitiated æstheticism, he could only suppose that conceit had played an abominable trick on his eyesight."
                                            },
                                            {
                                                "example_id": "e4426527-1ef6-4bbd-b122-2b20b7f74e7a",
                                                "sense_id": "cce9e1e2-d434-3302-9d72-7140c03c07c8",
                                                "text": "Born the most sensitive of children into an unhappy family that misreared and misschooled him, Rilke recoiled into introspectiveness and dilletante^([sic]) aestheticism, and long remained there; the world, or outwardness, was what had hurt him, was the enemy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
