                                "target_senses": [
                                    {
                                        "sense_id": "e2d1db65-9808-31dc-a4c7-0e0bcb23f2d2",
                                        "entry_id": "ad87db12-74bc-3bdf-9502-bcb81120a08e",
                                        "glosses": [
                                            "Sicherung des weiteren Fortbestehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d56623-bed9-44e1-9335-1c1310c4ffdd",
                                                "sense_id": "e2d1db65-9808-31dc-a4c7-0e0bcb23f2d2",
                                                "text": "Die Erhaltung des Regenwaldes ist für viele Tierarten wichtig."
                                            },
                                            {
                                                "example_id": "e825492f-bf27-441f-847f-af3f22447ebe",
                                                "sense_id": "e2d1db65-9808-31dc-a4c7-0e0bcb23f2d2",
                                                "text": "„In den Jahren zwischen 1816 und 1828 kamen Instandhaltungsmaßnahmen nicht in Gang, zum einen aufgrund des Widerstandes des Domänenpächters und zum anderen, weil diese Erhaltungen aus verschiedenen staatlichen Fonds hätten bezahlt werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72a227c8-6ee0-37ed-92b2-275ee60bfb02",
                                        "entry_id": "ad87db12-74bc-3bdf-9502-bcb81120a08e",
                                        "glosses": [
                                            "Ernährung, Versorgung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f186e8ad-1527-4e76-957c-76d4f6db1326",
                                                "sense_id": "72a227c8-6ee0-37ed-92b2-275ee60bfb02",
                                                "text": "Die Erhaltung ihrer sechs Kinder überfordert Jessica und Dennis zunehmend."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
