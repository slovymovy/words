                        "form_id": "9b3b8fce-88a1-4876-9c8d-505b2254751e",
                        "entry_id": "a2314301-68c8-3791-91cb-e490b97297d3",
                        "tags": [
                            "animate",
                            "canonical",
                            "masculine",
                            "plural"
                        ],
                        "form": "ста́рцев"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00ab35db-463c-32c4-a663-5ea3eed8b1c6",
                        "entry_id": "a2314301-68c8-3791-91cb-e490b97297d3",
                        "glosses": [
                            "genitive/accusative plural of ста́рец (stárec)"
                        ],
                        "tags": [
                            "accusative",
                            "form-of",
                            "genitive",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "223363e9-e81a-4b20-823b-db1890e8b73c",
                                "sense_id": "00ab35db-463c-32c4-a663-5ea3eed8b1c6",
                                "text": "Ибо фарисеи и все Иудеи, держась предания старцев, не едят, не умыв тщательно рук…"
                            }
                        ]
                    }
                ],
