                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c9759002-a575-484c-a163-d9a4f578406b",
                        "entry_id": "8aa8bde1-9e60-3f15-8bd5-4836f5bd570d",
                        "tags": [
                            "plural"
                        ],
                        "form": "tufas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d237735b-1c5f-31ec-a0c8-4b614c943519",
                        "entry_id": "8aa8bde1-9e60-3f15-8bd5-4836f5bd570d",
                        "glosses": [
                            "Calcareous lime deposited by precipitation from a body of water, such as a hot spring."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b8c2d56-ffe3-4ac6-aeba-d380c6f20fcf",
                                "sense_id": "d237735b-1c5f-31ec-a0c8-4b614c943519",
                                "text": "B.J. Szabo presented the results of a survey of the tufa mounds that border Pyramid Lake indicating that uranium-series methods can be used to approximate the ages of such tufa deposits. In the Pyramid Lake Basin, tufas less than 50,000 years old contain large quantities of excess thorium, and the error in age estimates made using uranium-series methods is not small enough to confirm results from ¹⁴C determinations."
                            },
                            {
                                "example_id": "a6450a2d-ec11-4330-9cf1-650a49f9101a",
                                "sense_id": "d237735b-1c5f-31ec-a0c8-4b614c943519",
                                "text": "Resedimented tufas also contribute where erosion has washed detritus from other hillside tufa deposits."
                            },
                            {
                                "example_id": "e9a9ef85-1c77-4479-880a-4096dd732881",
                                "sense_id": "d237735b-1c5f-31ec-a0c8-4b614c943519",
                                "text": "The tufas at Tianshengqiao have different shapes in different development stages and in different structural sections."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e634465-161c-34ed-a5e3-7726faad77dc",
                        "entry_id": "8aa8bde1-9e60-3f15-8bd5-4836f5bd570d",
                        "glosses": [
                            "A variety of volcanic rock, tuff."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a345bb00-55a5-410c-a911-8a30d70ae770",
                                "sense_id": "6e634465-161c-34ed-a5e3-7726faad77dc",
                                "text": "1825, \"Oliver Oldschool\" (Joseph Dennie), John Elihu Hall (editors), The Port Folio, page 426,\nThis again is followed by a bed of stony tufa of a reddish colour, containing fragments of a spongy lava, amphigone, pyroxene, mica, and common lava; and, like the former, traversed by argillaceous veins."
                            }
                        ]
                    }
                ],
