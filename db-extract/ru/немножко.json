                                "sense_id": "831d18b3-5100-3ad4-8479-cfbed01526ac",
                                "text": "А теперь — немножко музыки!"
                            }
                        ]
                    },
                    {
                        "sense_id": "631f3ea2-79b8-392f-89d3-0aa24818318b",
                        "entry_id": "75962f1b-c08c-36b8-bc06-76764f548946",
