                                        "glosses": [
                                            "A telephone conference, an arranged phone call between more than two parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5638b9-8d59-4334-b6c1-b8dde4a1f2e0",
                                                "sense_id": "8cdb0a21-56cc-3bc4-ab64-870d8559880e",
                                                "text": "The four of us should have a teleconference next week."
                                            }
                                        ]
                                    },
