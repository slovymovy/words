                        ],
                        "examples": [
                            {
                                "example_id": "e83a42f5-e514-4a7d-be33-42f360aa9865",
                                "sense_id": "c0da9b87-ef9c-3ac4-9f53-962662868a94",
                                "text": "Avant la bataille de Raphia (217 a.C.), l’armée d’Antiochos III comptait 62,000 soldats de l’infanterie, parmi lesquels se trouvaient 5,000 mercenaires recrutés en Grèce centrale, 1,500 Crétois et 1,000 Néocrétois c’est-à-dire environ 12 % de l’ensemble des soldats."
                            }
                        ]
                    }
