{
    "word_family": [
        "aardig",
        "aardigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f9caed8-bb47-3425-a187-3938cb675250",
                    "sense_definition": "onvriendelijk of gemeen in gedrag",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doe niet zo <w>onaardig</w> tegen je moeder!",
                            "target_lang_translations": {
                                "it": "Non essere così <w>sgarbato</w> con tua madre!"
                            }
                        },
                        {
                            "text": "Het is erg <w>onaardig</w> om anderen uit te lachen.",
                            "target_lang_translations": {
                                "it": "È molto <w>scortese</w> ridere degli altri."
                            }
                        }
                    ],
                    "synonyms": [
                        "gemeen"
                    ],
                    "antonyms": [
                        "aardig"
                    ],
                    "common_phrases": [
                        "onaardig gedrag"
                    ],
                    "target_lang_definitions": {
                        "it": "Che si comporta in modo sgarbato, scortese o cattivo verso gli altri."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sgarbato",
                                "target_lang_sense_clarification": "riferito a un comportamento poco gentile o maleducato"
                            },
                            {
                                "target_lang_word": "scortese",
                                "target_lang_sense_clarification": "riferito a una mancanza di cortesia o modi bruschi"
                            },
                            {
                                "target_lang_word": "cattivo",
                                "target_lang_sense_clarification": "riferito a un'intenzione malevola o comportamento meschino"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe498a6a-3e47-38e1-a242-dc61845fecd2",
                    "sense_definition": "niet goed of onvoldoende",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is geen <w>onaardig</w> resultaat voor een eerste poging.",
                            "target_lang_translations": {
                                "it": "È un risultato <w>niente male</w> per un primo tentativo."
                            }
                        },
                        {
                            "text": "Het plan is niet <w>onaardig</w> maar het kan beter.",
                            "target_lang_translations": {
                                "it": "Il piano non è <w>discreto</w>, ma può migliorare."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen onaardig resultaat"
                    ],
                    "target_lang_definitions": {
                        "it": "Non del tutto negativo, discreto o accettabile, spesso usato in forma litotica."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "discreto",
                                "target_lang_sense_clarification": "riferito a qualcosa di qualità accettabile o buona"
                            },
                            {
                                "target_lang_word": "niente male",
                                "target_lang_sense_clarification": "espressione idiomatica per indicare che qualcosa è positivo o soddisfacente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}