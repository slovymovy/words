                    },
                    {
                        "form_id": "5d45e4f4-a9eb-4a31-970e-b8baac06fef8",
                        "entry_id": "e90ba84e-6a58-3617-ab3f-88957825a01c",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind wassergetrieben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                        "entry_id": "e90ba84e-6a58-3617-ab3f-88957825a01c",
                        "glosses": [
                            "durch die Kraft des Wassers angetrieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7852c4a7-39ab-438f-ac51-3dda76fe272d",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Er baute eine wassergetriebene Mühle.“"
                            },
                            {
                                "example_id": "d591a3cb-176d-45b1-a31f-42bc84e1ca8e",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Im Unterschied dazu war aber die wassergetribene Getreidemühle schon in der Karolingerzeit weit verbreitet.“"
                            },
                            {
                                "example_id": "a7f623b3-2371-47df-979f-3e2051af3588",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Bereits am Beginn des 14. Jahrhunderts waren wassergetriebene Anlagen u.a. in der Oberpfalz, in der Steiermark, in Mähren und der Niederlausitz in Betrieb.“"
                            },
                            {
                                "example_id": "3c825233-c319-4f6b-a382-30ef2219550e",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Die zahlreichen Bäche und Flüsse boten sich für den Bau wassergetriebener Anlagen an.“"
                            },
                            {
                                "example_id": "d03c4f5f-ae20-4451-9087-daa2f645a153",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Mit der Einführung der wassergetriebenen Hämmer und Blasebälge wanderten die Hammerwerke an die Fließgewässer und das Erz musste teilweise aus großen Entfernungen herangeholt werden.“"
                            },
                            {
                                "example_id": "74b22a46-2547-41d1-91bd-323d802290ed",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Das Ausschmieden der teigigen Luppe erfolgte mit wassergetriebenen Hämmern.“"
                            },
                            {
                                "example_id": "eb96abb7-9b5b-4d42-b6ef-cbffaf99fe4d",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Der Antrieb der Gebläse erfolgte zunächst sicher durch Muskelkraft und später durch eine wassergetriebene Antriebswelle.“"
                            },
                            {
                                "example_id": "528c78b0-04dc-4792-9df4-727a4d3191dc",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Die Nutzung der Wasserkraft hat in Norwegen eine lange Tradition und war Grundlage der Industrialisierung des Landes. Auf einfache Wassermühlen folgten wassergetriebene Generatoren und später kleinere und größere Wasserkraftwerke zur Gewinnung elektrischer Energie.“"
                            },
                            {
                                "example_id": "7d9a4ddf-e8bc-4290-87ce-30633bf2d4e9",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Nur wenige Mühlen der Ozarks verließen sich auf einfache Wasserräder von geringem Wirkungsgrad, die meisten verfügten über einen Mühlteich mit Gerinne und eine wassergetriebene Turbine.“"
                            },
                            {
                                "example_id": "422635ca-dd21-4545-814a-739afc7a39f1",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "[Nepal:] […] „das Land, das aus den Himalaya-Flüssen schon 74 Prozent seines Stroms bezieht, nahm erst in letzter Zeit wieder 60 wassergetriebene Mühlen in Betrieb.“"
                            },
                            {
                                "example_id": "e9e06e40-d81b-49ad-b97a-8cdb34eb95fc",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Die wassergetriebene Spinnmaschine, die Arkwright in Cromford einsetzte, war mit seinem zierlich gedrechselten Patentmodell nicht mehr zu vergleichen.“"
                            },
                            {
                                "example_id": "e42942ed-fa11-43e2-bbf0-ad9f4323f275",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Als dort kaum noch Zinn aus den Bergwerken kam, wurden die wassergetriebenen Pochwerke, mit denen das Zinn aus dem Stein gelöst wurde, umgebaut zu Drehwerken“ […]."
                            },
                            {
                                "example_id": "670ca51d-e361-4c44-b407-ac016d726849",
                                "sense_id": "f7724257-b22b-3dbc-9e33-4fb88846a3c1",
                                "text": "„Da ist zu sehen, wie die Edelsteinschleifer auf niedrigen Schemeln auf dem Bauch vor den großen, wassergetriebenen Sandsteinrädern in den Schleifereien liegen und im eiskalten Wasser harte körperliche Arbeit verrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
