                                            {
                                                "example_id": "de4b7594-237d-429c-a742-0393237c0b19",
                                                "sense_id": "c4e3f371-6df4-3d4d-9c0b-df3755122120",
                                                "text": "Ich habe einen elektrischen Schlag bekommen."
                                            }
