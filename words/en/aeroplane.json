{
    "word_family": [
        "aeroplanist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0f77d53c-10f0-30ce-8834-1473d5f50bb7",
                    "sense_definition": "A powered heavier-than-air aircraft with fixed wings.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aircraft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aeroplane</w> landed safely at the airport after a long flight.",
                            "target_lang_translations": {
                                "zh": "长途飞行后，<w>飞机</w>安全降落在机场。"
                            }
                        },
                        {
                            "text": "Many passengers boarded the <w>aeroplane</w> for their summer vacation.",
                            "target_lang_translations": {
                                "zh": "许多乘客登上了<w>飞机</w>去度暑假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "airplane"
                    ],
                    "common_phrases": [
                        "board an aeroplane",
                        "aeroplane flight"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由动力驱动、比空气重且具有固定机翼的飞行器。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "飞机",
                                "target_lang_sense_clarification": "指一般的固定翼航空器。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5421b262-d567-3677-94b1-65df65ed0782",
                    "sense_definition": "An aerodynamic surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aerodynamics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wing's <w>aeroplane</w> design helps generate lift during flight.",
                            "target_lang_translations": {
                                "zh": "机翼的<w>翼型</w>设计有助于在飞行中产生升力。"
                            }
                        },
                        {
                            "text": "Engineers studied the <w>aeroplane</w> to improve the aircraft's efficiency.",
                            "target_lang_translations": {
                                "zh": "工程师们研究了这种<w>翼型</w>以提高飞机的效率。"
                            }
                        }
                    ],
                    "synonyms": [
                        "airfoil"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于产生升力的空气动力学表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翼型",
                                "target_lang_sense_clarification": "指机翼的横截面形状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4dbee36-3d31-3372-bc1c-103818fe85e6",
                    "sense_definition": "A type of nymphalid butterfly known for its slow gliding flight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butterfly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare <w>aeroplane</w> butterfly glided gracefully through the forest canopy.",
                            "target_lang_translations": {
                                "zh": "那只稀有的<w>滑翔蝶</w>优雅地滑过森林树冠。"
                            }
                        },
                        {
                            "text": "Observers watched the <w>aeroplane</w> as it landed on a nearby flower.",
                            "target_lang_translations": {
                                "zh": "观察者们注视着那只<w>滑翔蝶</w>落在附近的花朵上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种以缓慢滑翔飞行方式著称的蛱蝶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑翔蝶",
                                "target_lang_sense_clarification": "指蛱蝶科中飞行姿态如滑翔的蝴蝶。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74b937fa-fee8-351a-840d-b9f95ea326ca",
                    "sense_definition": "To travel by means of an aeroplane.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "travel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>aeroplane</w> across the country to save time.",
                            "target_lang_translations": {
                                "zh": "为了节省时间，他们决定<w>乘飞机</w>横跨全国。"
                            }
                        },
                        {
                            "text": "It is much faster to <w>aeroplane</w> than to take the train.",
                            "target_lang_translations": {
                                "zh": "<w>乘飞机</w>比坐火车快得多。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "乘坐飞机旅行。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乘飞机",
                                "target_lang_sense_clarification": "指通过搭乘飞机的方式进行交通出行。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42d52d9d-35e8-31c5-9133-cd6b3fa898c5",
                    "sense_definition": "To transport something using an aeroplane.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had to <w>aeroplane</w> the urgent medical supplies to the remote village.",
                            "target_lang_translations": {
                                "zh": "公司必须将紧急医疗物资<w>空运</w>到偏远村庄。"
                            }
                        },
                        {
                            "text": "They <w>aeroplaned</w> the heavy equipment to the construction site.",
                            "target_lang_translations": {
                                "zh": "他们将重型设备<w>空运</w>到了施工现场。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用飞机运输货物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "空运",
                                "target_lang_sense_clarification": "指通过航空方式运输物资。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}