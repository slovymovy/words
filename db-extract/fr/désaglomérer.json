                "senses": [
                    {
                        "sense_id": "8affb2f5-3581-3932-a29c-98bd73d55627",
                        "entry_id": "b8085ce1-6925-352c-8674-be256a6e86eb",
                        "glosses": [
                            "Ancienne variante orthographique de désagglomérer (séparer ce qui était aggloméré)"
                        ],
                        "tags": [],
                        "note": "Si vous avez ce mot à écrire, mettez deux g",
                        "examples": [
                            {
                                "example_id": "1a463a2a-5a76-4d1e-bdc3-12dd12908725",
                                "sense_id": "8affb2f5-3581-3932-a29c-98bd73d55627",
                                "text": "'Qu'y a-t-il donc à faire ? la réponse paraît facile : désaglomérer, faire comme les abeilles : essaimer; créer des colonies, de nouveaux centres de populations; défricher ; faire produire la terre ; en un mot, reporter vers l'agriculture les bras inoccupés. — (Journal d'agriculture pratique, 1849)"
                            },
                            {
                                "example_id": "423a596e-e75c-499d-bee0-c43463a8dd06",
                                "sense_id": "8affb2f5-3581-3932-a29c-98bd73d55627",
                                "text": "'La poudre ainsi désaglomérée tombe sur le support en plexiglas®, en formant un demi-cône. — (Julien Tea, Évaluation de la coulabilité des poudres – comparaison de méthodes de mesure, 2015, accessible sur https://hal.univ-lorraine.fr/hal-01732354/document)"
                            },
                            {
                                "example_id": "a3333785-98b5-4f90-b188-eae9eb45b2cd",
                                "sense_id": "8affb2f5-3581-3932-a29c-98bd73d55627",
                                "text": "'Les fonctions PYLENGO® développées par PYLOTE s'appuient sur un dénominateur commun fort : des particules minérales sphériques et désaglomérées. — (site www.biomedicalalliance.com)"
                            }
                        ]
                    }
