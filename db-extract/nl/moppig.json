                        "source_sense_description": "op een grappige, vrolijke manier",
                        "target_lang_word": "funny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "521133ab-1a71-3a26-bc28-42af3742ca63",
                                        "entry_id": "2d3b8f46-35cb-3353-87b1-2fb5a78bd9e8",
                                        "glosses": [
                                            "Amusing; humorous; comical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32cdf7d-67fa-4559-8031-8112e7257c31",
                                                "sense_id": "521133ab-1a71-3a26-bc28-42af3742ca63",
                                                "text": "When I went to the circus, I only found the clowns funny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b0d030-9cdc-3a32-a2d5-2cc85594f4d2",
                                        "entry_id": "2d3b8f46-35cb-3353-87b1-2fb5a78bd9e8",
                                        "glosses": [
                                            "Strange or unusual, often in an unpleasant way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186c08e5-e7cb-4ee6-8362-3dd594aa821c",
                                                "sense_id": "39b0d030-9cdc-3a32-a2d5-2cc85594f4d2",
                                                "text": "The milk smelt funny so I poured it away."
                                            },
                                            {
                                                "example_id": "63207b84-fc33-40dd-9889-aaa3d7ecd3fc",
                                                "sense_id": "39b0d030-9cdc-3a32-a2d5-2cc85594f4d2",
                                                "text": "I've got a funny feeling that this isn't going to work."
                                            },
                                            {
                                                "example_id": "81683634-f05f-4252-8411-c318e2fe2398",
                                                "sense_id": "39b0d030-9cdc-3a32-a2d5-2cc85594f4d2",
                                                "text": "Oh it's a funny time of year / There'll be no blossom on the trees"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390597c5-a01b-3fad-bd72-70c311d45a34",
                                        "entry_id": "2d3b8f46-35cb-3353-87b1-2fb5a78bd9e8",
                                        "glosses": [
                                            "Showing unexpected resentment."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c6dde4-9d75-46ed-8fd7-08ce72e180a0",
                                                "sense_id": "390597c5-a01b-3fad-bd72-70c311d45a34",
                                                "text": "'Moved in where?' Sam asked Brona in confusion. 'What boyfriend?'\n'Glen,' Brona said quietly. 'You met him a while ago, remember? He only moved in last week. I was going to tell you but […] I thought you might be funny about it, that's all.'"
                                            },
                                            {
                                                "example_id": "b10fd68e-be7c-4f15-af20-eef42e1898b0",
                                                "sense_id": "390597c5-a01b-3fad-bd72-70c311d45a34",
                                                "text": "Ash would have been happy to sit and stare at Viv all day, but when he saw the other guys staring at his sister, too, he got funny about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250fe9b7-c02f-38c1-ab96-7822652db1c4",
                                        "entry_id": "2d3b8f46-35cb-3353-87b1-2fb5a78bd9e8",
                                        "glosses": [
                                            "Homosexual; gay."
                                        ],
                                        "tags": [
                                            "Jamaica",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f308cf4c-3d12-4387-836d-a5ee2f240908",
                                                "sense_id": "250fe9b7-c02f-38c1-ab96-7822652db1c4",
                                                "text": "Funny man ah get drop like a bad habit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "funny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c024e8-9920-3f05-a645-bf26f03769b6",
                                        "entry_id": "a1a7994d-d810-3d66-a903-a306015912bd",
                                        "glosses": [
                                            "A joke."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a6a2fd-720f-4666-a53b-c2e09f997ee4",
                                                "sense_id": "d3c024e8-9920-3f05-a645-bf26f03769b6",
                                                "text": "After church I am met by a dear parishioner who says, \"Got a funny for you. Father.\" Now I'll have \"funnies,\" so I can reply. \"Got one for you too, Mary!\""
                                            },
                                            {
                                                "example_id": "b34b125f-f0eb-40b9-9268-69b2ef5e0d4a",
                                                "sense_id": "d3c024e8-9920-3f05-a645-bf26f03769b6",
                                                "text": "Everyone would be sitting on big fluffy white clouds singing songs, telling funnies and just enjoying the day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a896537-093f-3c09-8f06-c659c3f104ce",
                                        "entry_id": "a1a7994d-d810-3d66-a903-a306015912bd",
                                        "glosses": [
                                            "A comic strip."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2f0540-0809-4617-8f43-9f04817c85d6",
                                                "sense_id": "2a896537-093f-3c09-8f06-c659c3f104ce",
                                                "text": "Chic Young, who created his funny funny, “Blondie,” in 1930, and kept it the most popular comic strip in the world right through the unfunny generation, was quick to see the difference between the innocent funnies and the new generation of comics that started after the Second World War:"
                                            },
                                            {
                                                "example_id": "efca1e77-b4cc-4d8f-8e20-620d37476371",
                                                "sense_id": "2a896537-093f-3c09-8f06-c659c3f104ce",
                                                "text": "The artist gave priority to “Mark Trail,” usually spending at least eight hours a day on it, then working at night on “The Ryatts,” a funny that featured the foibles of a family much like his own, which included four children."
                                            },
                                            {
                                                "example_id": "052398d5-a531-4e88-bcc3-bbbf12076969",
                                                "sense_id": "2a896537-093f-3c09-8f06-c659c3f104ce",
                                                "text": "His father was more likely to listen to the radio, although he would read the Sunday funnies, and his grandmother would only read the Italian language paper she picked up at the corner candy store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94577968-c20a-3a0e-9d43-39710910a41a",
                                        "entry_id": "a1a7994d-d810-3d66-a903-a306015912bd",
                                        "glosses": [
                                            "Humor in general."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0186c9ff-b927-43e3-a7f3-c3e7cd30c9ef",
                                                "sense_id": "94577968-c20a-3a0e-9d43-39710910a41a",
                                                "text": "Where's the funny? Your meme sucks."
                                            },
                                            {
                                                "example_id": "4adfe9b5-4669-4108-b8ef-0edfbceefa5d",
                                                "sense_id": "94577968-c20a-3a0e-9d43-39710910a41a",
                                                "text": "Finally, the funny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "funny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faf04f69-9ae6-3c08-80a4-890e499edb8e",
                                        "entry_id": "4e549c24-6d27-346b-a5ac-625e3331123c",
                                        "glosses": [
                                            "In an unusual manner; strangely."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23416e32-d740-4759-8b21-dd7cae49f42b",
                                                "sense_id": "faf04f69-9ae6-3c08-80a4-890e499edb8e",
                                                "text": "She was breathing funny now."
                                            },
                                            {
                                                "example_id": "4961f5bc-a346-43f4-882f-c05231d54cb1",
                                                "sense_id": "faf04f69-9ae6-3c08-80a4-890e499edb8e",
                                                "text": "At this the farmer gets to breathing funnier, hiccuping, little stray burps roll out—uncontrolled, we’re talking here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c5a760-46fc-3053-ba22-ffb7931f6e65",
                                        "entry_id": "4e549c24-6d27-346b-a5ac-625e3331123c",
                                        "glosses": [
                                            "In a manner seen as being typical of a homosexual, or indicating homosexuality."
                                        ],
                                        "tags": [
                                            "Jamaica",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "363ff1c1-7fa6-4f9d-92a8-04308b07e465",
                                                "sense_id": "28c5a760-46fc-3053-ba22-ffb7931f6e65",
                                                "text": "Dem nuh waan nuh honey, dem only waan di money. Dat’s how me know seh dem bwoy deh all a move funny."
                                            },
                                            {
                                                "example_id": "88ad965c-7ef2-432e-8f03-f10fd969301a",
                                                "sense_id": "28c5a760-46fc-3053-ba22-ffb7931f6e65",
                                                "text": "He walked away, pushing the napkin in his pink pants pockets. By the way, he dresses and walks funnier out of school. He likes tight feminine colored clothes and walks like he is holding a stick between his butt cheeks. You probably wouldn’t notice him if you didn't hear his voice and looked him in the eye. Jenna assumed he liked men."
                                            },
                                            {
                                                "example_id": "911f6e7e-2a15-48df-9f06-b80532f2a70d",
                                                "sense_id": "28c5a760-46fc-3053-ba22-ffb7931f6e65",
                                                "text": "Nuff boy move funny just fi get money."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "funny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2f9d03-d075-39ae-9de3-716566f42ca1",
                                        "entry_id": "d7d45fe4-ee78-3145-a1e7-6f9b27376765",
                                        "glosses": [
                                            "A narrow, clinker-built double-ender for sculling."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cea5b9-32c1-4a0f-a682-89c4ea29adea",
                                                "sense_id": "0b2f9d03-d075-39ae-9de3-716566f42ca1",
                                                "text": "I myself recollect the funnies at Eton, which were certain little boats, capable of containing one person only, who, like an Indian in his canoe, was constantly obliged to balance himself, with such critical nicety, that the least mistake was certain of producing a ducking."
                                            },
                                            {
                                                "example_id": "04f01346-a231-4a3c-a8d7-c7a695403851",
                                                "sense_id": "0b2f9d03-d075-39ae-9de3-716566f42ca1",
                                                "text": "As I do not belong to the boat-club, I always row by myself in a funny […] or at least go in a two-oared boat, with some friend with whom I should otherwise be walking."
                                            },
                                            {
                                                "example_id": "64681655-9e52-4a88-a887-3bea0e764a46",
                                                "sense_id": "0b2f9d03-d075-39ae-9de3-716566f42ca1",
                                                "text": "We were going to have a go in one of the double scull ‘funnies’ that could be had from the Rowing Club in the harbour, but he is off up the line tomorrow to rejoin his old Battery."
                                            },
                                            {
                                                "example_id": "2fe3b1ca-6d38-47c1-b46c-3212c13eb3e5",
                                                "sense_id": "0b2f9d03-d075-39ae-9de3-716566f42ca1",
                                                "text": "There was a great market for leisure boats, too: no wherries any longer, but whole fleets of punts, rowing gigs, funnies, skiffs, whiffs and randans […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12dfdb80-4bde-4b88-80d5-b686355806a6",
                        "source_entry_id": "8658ec1f-b86a-3899-91d2-8c755325cafc",
