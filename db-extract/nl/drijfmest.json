        "nl-extract.jsonl": [
            {
                "entry_id": "768c7da5-8146-3a3d-999a-d67ba18e6cd0",
                "word": "drijfmest",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cba65a4a-97fe-31ec-bdbf-bc3010ede1ba",
                        "entry_id": "768c7da5-8146-3a3d-999a-d67ba18e6cd0",
                        "glosses": [
                            "vloeibaar mengsel van de uitwerpselen van vee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd0c544-e8a6-409e-9781-1cf69d9ed7f4",
                                "sense_id": "cba65a4a-97fe-31ec-bdbf-bc3010ede1ba",
                                "text": "Een groep ganzen schuimt het weiland af. Het weiland is geelgroen; het is nog niet geïnjecteerd met drijfmest, zoals de omringende weilanden. Die zijn geelgroen met donkerbruine strepen."
                            },
                            {
                                "example_id": "5e436088-7b02-4b30-bb1c-0ac1a5c0264c",
                                "sense_id": "cba65a4a-97fe-31ec-bdbf-bc3010ede1ba",
                                "text": "Het is technisch mogelijk om de vervuilende drijfmest uit de veehouderij binnen tien jaar in te zetten voor onder meer het opwekken van energie en natuurlijke bemesting. Dat staat in een rapport, dat vandaag werd gepubliceerd door de boerenorganisatie LTO Nederland en Natuur & Milieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1f5c44b-f523-4d60-b76a-2885a0a7a16e",
                        "source_entry_id": "768c7da5-8146-3a3d-999a-d67ba18e6cd0",
                        "source_sense_id": "cba65a4a-97fe-31ec-bdbf-bc3010ede1ba",
                        "source_sense_description": "vloeibaar mengsel van de uitwerpselen van vee",
                        "target_lang_word": "slurry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slurry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f57c5e8b-1c5e-311b-b696-26adc5c2d92a",
                                        "entry_id": "48719f0c-4d73-3415-b841-9ad7f80cfde9",
                                        "glosses": [
                                            "Any flowable suspension of small particles in liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c904c568-28db-4d85-93ea-a654976ec233",
                                                "sense_id": "f57c5e8b-1c5e-311b-b696-26adc5c2d92a",
                                                "text": "1981, National Research Council (U.S.) Committee on Animal Nutrition, Feeding Value of Ethanol Production By-products, page 26,\nWhile little information is available, it probably is similar to spent brewers yeast slurry."
                                            },
                                            {
                                                "example_id": "32cf4b0a-b2d1-453d-89e1-d00a63ebe924",
                                                "sense_id": "f57c5e8b-1c5e-311b-b696-26adc5c2d92a",
                                                "text": "The most important application of fluid flow techniques in the mineral processing industry is the transportation of slurries. Whenever solid materials are in particulate form transportation in the form of a slurry is possible."
                                            },
                                            {
                                                "example_id": "ef52f322-6cb1-4b21-9f26-83817abf0d20",
                                                "sense_id": "f57c5e8b-1c5e-311b-b696-26adc5c2d92a",
                                                "text": "Magnesium hydroxide slurry consists of an aqueous suspension of particulate magnesium hydroxide. The principle sources of slurry are from seawater- or brine-produced magnesium hydroxide, natural brucite, or from the slaking of magnesium oxide powder. Magnesium hydroxide slurry is gaining in popularity as a replacement for caustic soda and lime in waste-water treatment applications."
                                            },
                                            {
                                                "example_id": "a2540714-dbc1-4abf-86bb-017046d6cc77",
                                                "sense_id": "f57c5e8b-1c5e-311b-b696-26adc5c2d92a",
                                                "text": "2011, Wan Renpu, Petroleum Industry Press staff (translators), Advanced Well Completion Engineering, page 259,\nThe other properties of cement slurry and set cement are also related closely to cement slurry density."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5a5798-3ac7-351c-a8f0-ecdd74770981",
                                        "entry_id": "48719f0c-4d73-3415-b841-9ad7f80cfde9",
                                        "glosses": [
                                            "Liquid waste from some types of mining, such as mountain top removal mining, usually very toxic and stored nearby in large dams."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc38ee39-acb5-44f1-8151-ab0ebbdf87da",
                                                "sense_id": "fb5a5798-3ac7-351c-a8f0-ecdd74770981",
                                                "text": "Slurry tailings ponds are by far the major type of containment facilities for slurry tailings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24266bd1-8a55-3cfe-85e5-f835be47dce1",
                                        "entry_id": "48719f0c-4d73-3415-b841-9ad7f80cfde9",
                                        "glosses": [
                                            "A mixture of animal waste, other organic material and sometimes water, stored in a slurry pit and used as fertilizer; also used in combination, as pig slurry, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031579c1-250c-4e1e-969f-041dad1fcf98",
                                                "sense_id": "24266bd1-8a55-3cfe-85e5-f835be47dce1",
                                                "text": "In the Netherlands, the most problematic agricultural waste is liquid pig manure or pig slurry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b36b66b8-40ee-3b05-a54c-cb2bd8cd8f0c",
                                        "entry_id": "48719f0c-4d73-3415-b841-9ad7f80cfde9",
                                        "glosses": [
                                            "A thickener."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
