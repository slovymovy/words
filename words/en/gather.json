{
    "word_family": [
        "gathering",
        "gatherer",
        "regather",
        "ingathering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dbfdf8c-4f44-3a9a-a6aa-4fe34d3e9df8",
                    "sense_definition": "To bring together things that are scattered or separate into one place or group.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bent down to <w>gather</w> the scattered papers from the floor.",
                            "target_lang_translations": {
                                "ru": "Она наклонилась, чтобы <w>собрать</w> разбросанные по полу бумаги.",
                                "zh": "她弯下腰，把地板上散落的纸张<w>收集</w>起来。",
                                "de": "Sie bückte sich, um die verstreuten Papiere vom Boden aufzu<w>sammeln</w>."
                            }
                        },
                        {
                            "text": "We need to <w>gather</w> information before making a decision.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>собрать</w> информацию перед принятием решения.",
                                "zh": "在做决定之前，我们需要<w>搜集</w>信息。",
                                "de": "Wir müssen Informationen <w>sammeln</w>, bevor wir eine Entscheidung treffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "round up",
                        "assemble",
                        "collect"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter",
                        "distribute"
                    ],
                    "common_phrases": [
                        "gather information",
                        "gather dust",
                        "gather evidence",
                        "gather resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать разбросанные или отдельные вещи в одно место или группу.",
                        "zh": "将分散或分开的事物集中到一处或一组。",
                        "de": "Dinge, die verstreut oder getrennt sind, an einen Ort oder in eine Gruppe bringen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "объединять, коллекционировать"
                            },
                            {
                                "target_lang_word": "собрать",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收集",
                                "target_lang_sense_clarification": "将分散的东西汇集在一起"
                            },
                            {
                                "target_lang_word": "搜集",
                                "target_lang_sense_clarification": "多指搜集信息或资料"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sammeln",
                                "target_lang_sense_clarification": "Gegenstände oder Informationen zusammenbringen"
                            },
                            {
                                "target_lang_word": "zusammensuchen",
                                "target_lang_sense_clarification": "verstreute Dinge mühsam finden und zusammenbringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7179108e-391e-3983-9d9f-ecd8327a5a3b",
                    "sense_definition": "To come together as a group; to congregate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People began to <w>gather</w> around the street performer to watch the show.",
                            "target_lang_translations": {
                                "ru": "Люди начали <w>собираться</w> вокруг уличного артиста, чтобы посмотреть представление.",
                                "zh": "人们开始在街头艺人周围<w>聚集</w>起来观看表演。",
                                "de": "Die Leute begannen, sich um den Straßenkünstler zu <w>versammeln</w>, um die Show zu sehen."
                            }
                        },
                        {
                            "text": "The whole family will <w>gather</w> for dinner on Sunday.",
                            "target_lang_translations": {
                                "ru": "Вся семья <w>соберётся</w> на ужин в воскресенье.",
                                "zh": "周日全家人将<w>聚</w>在一起吃晚饭。",
                                "de": "Die ganze Familie wird am Sonntag zum Abendessen <w>zusammenkommen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "assemble",
                        "meet"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "gather around",
                        "gather together",
                        "gather round"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться вместе группой; сходиться.",
                        "zh": "作为群体聚在一起；聚集。",
                        "de": "Als Gruppe zusammenkommen; sich versammeln."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "встречаться, сходиться"
                            },
                            {
                                "target_lang_word": "собраться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聚集",
                                "target_lang_sense_clarification": "人或物汇集"
                            },
                            {
                                "target_lang_word": "集合",
                                "target_lang_sense_clarification": "按要求聚在一起"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich versammeln",
                                "target_lang_sense_clarification": "sich an einem Ort treffen"
                            },
                            {
                                "target_lang_word": "zusammenkommen",
                                "target_lang_sense_clarification": "sich treffen, um gemeinsam etwas zu tun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b347d48-c914-37ae-a860-2c6dfe032190",
                    "sense_definition": "To collect plants, fruits, or crops from nature or a garden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the forest to <w>gather</w> mushrooms for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы пошли в лес <w>собирать</w> грибы на ужин.",
                                "zh": "我们去森林里<w>采摘</w>蘑菇做晚餐。",
                                "de": "Wir gingen in den Wald, um Pilze für das Abendessen zu <w>sammeln</w>."
                            }
                        },
                        {
                            "text": "Farmers work hard to <w>gather</w> the harvest before the rain starts.",
                            "target_lang_translations": {
                                "ru": "Фермеры усердно трудятся, чтобы <w>собрать</w> урожай до начала дождей.",
                                "zh": "农民们努力工作，赶在下雨前<w>收割</w>庄稼。",
                                "de": "Die Bauern arbeiten hart, um die Ernte einzubringen, bevor der Regen einsetzt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gather crops",
                        "gather wood",
                        "gather flowers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирать растения, фрукты или урожай.",
                        "zh": "从自然界或花园中采集植物、水果或农作物。",
                        "de": "Pflanzen, Früchte oder Ernte aus der Natur oder einem Garten sammeln."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "урожай, грибы, ягоды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "采摘",
                                "target_lang_sense_clarification": "指采摘果实、花朵或蘑菇"
                            },
                            {
                                "target_lang_word": "收割",
                                "target_lang_sense_clarification": "指收割庄稼"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sammeln",
                                "target_lang_sense_clarification": "Pilze, Beeren oder Vorräte ernten"
                            },
                            {
                                "target_lang_word": "ernten",
                                "target_lang_sense_clarification": "landwirtschaftliche Erzeugnisse einbringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6ed4ae8-1863-3b5a-953f-73c0c216ccee",
                    "sense_definition": "To gradually increase in amount, magnitude, or force over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train began to <w>gather</w> speed as it left the station.",
                            "target_lang_translations": {
                                "ru": "Поезд начал <w>набирать</w> скорость, отходя от станции.",
                                "zh": "火车离开车站时开始<w>增加</w>速度。",
                                "de": "Der Zug begann, an Geschwindigkeit zu <w>gewinnen</w>, als er den Bahnhof verließ."
                            }
                        },
                        {
                            "text": "Over the years, he had <w>gathered</w> a large collection of rare coins.",
                            "target_lang_translations": {
                                "ru": "За эти годы он <w>собрал</w> большую коллекцию редких монет.",
                                "zh": "多年来，他<w>积累</w>了大量的稀有硬币收藏。",
                                "de": "Über die Jahre hatte er eine große Sammlung seltener Münzen <w>aufgebaut</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulate",
                        "accrue",
                        "add up"
                    ],
                    "antonyms": [
                        "dissipate",
                        "lose"
                    ],
                    "common_phrases": [
                        "gather speed",
                        "gather momentum",
                        "gather strength",
                        "gather pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно увеличиваться в количестве, величине или силе.",
                        "zh": "随时间推移逐渐增加数量、程度或力量。",
                        "de": "Allmählich an Menge, Größe oder Kraft zunehmen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "скорость, силу"
                            },
                            {
                                "target_lang_word": "накапливать",
                                "target_lang_sense_clarification": "аккумулировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积累",
                                "target_lang_sense_clarification": "逐渐聚集"
                            },
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "程度或力量的提升"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufbauen",
                                "target_lang_sense_clarification": "allmählich entwickeln oder steigern"
                            },
                            {
                                "target_lang_word": "ansammeln",
                                "target_lang_sense_clarification": "über Zeit hinweg mehr werden lassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3665423b-ff3c-3aa6-8480-d481494bd046",
                    "sense_definition": "To understand or conclude something based on available information or context.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From his silence, I <w>gathered</w> that things had not gone well.",
                            "target_lang_translations": {
                                "ru": "По его молчанию я <w>понял</w>, что дела шли не очень хорошо.",
                                "zh": "从他的沉默中，我<w>推断</w>出事情进展得并不顺利。",
                                "de": "Aus seinem Schweigen <w>schloss</w> ich, dass die Dinge nicht gut gelaufen waren."
                            }
                        },
                        {
                            "text": "I <w>gather</w> you are not interested in joining us for lunch.",
                            "target_lang_translations": {
                                "ru": "Я <w>так понимаю</w>, вам не интересно пообедать с нами.",
                                "zh": "我<w>认为</w>你对和我们一起吃午饭不感兴趣。",
                                "de": "Ich <w>nehme an</w>, Sie haben kein Interesse daran, mit uns zu Mittag zu essen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "I gather that",
                        "from what I gather",
                        "as I gather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать или делать вывод на основе имеющейся информации.",
                        "zh": "根据现有信息或语境理解或推断某事。",
                        "de": "Etwas auf Basis verfügbarer Informationen oder des Kontextes verstehen oder schlussfolgern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "делать вывод"
                            },
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "приходить к заключению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推断",
                                "target_lang_sense_clarification": "根据已知情况得出结论"
                            },
                            {
                                "target_lang_word": "认为",
                                "target_lang_sense_clarification": "基于所见所闻的看法"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schließen",
                                "target_lang_sense_clarification": "eine Schlussfolgerung ziehen"
                            },
                            {
                                "target_lang_word": "annehmen",
                                "target_lang_sense_clarification": "eine Vermutung aufstellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35dceb2a-7188-3cbf-ad4c-3ad725356158",
                    "sense_definition": "To pull or draw parts of a garment or object closer around oneself or together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>gathered</w> the shawl tightly about her shoulders to keep warm.",
                            "target_lang_translations": {
                                "ru": "Она плотно <w>запахнула</w> шаль на плечах, чтобы согреться.",
                                "zh": "她把披肩紧紧地<w>裹</w>在肩上以保暖。",
                                "de": "Sie <w>raffte</w> den Schal fest um ihre Schultern, um sich warm zu halten."
                            }
                        },
                        {
                            "text": "He <w>gathered</w> the loose ends of the rope into a neat coil.",
                            "target_lang_translations": {
                                "ru": "Он <w>собрал</w> свободные концы веревки в аккуратный моток.",
                                "zh": "他把绳子松散的末端<w>收拢</w>成一个整齐的圆圈。",
                                "de": "Er <w>band</w> die losen Enden des Seils zu einem ordentlichen Ring zusammen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gather up",
                        "gather close"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притягивать или подбирать части одежды или предмета ближе к себе или друг к другу.",
                        "zh": "将衣服或物体的部分拉向自己或聚拢在一起。",
                        "de": "Teile eines Kleidungsstücks oder Gegenstands näher an sich heran oder zusammenziehen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "подтягивать концы"
                            },
                            {
                                "target_lang_word": "запахивать",
                                "target_lang_sense_clarification": "одежду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裹紧",
                                "target_lang_sense_clarification": "将衣物拉紧在身上"
                            },
                            {
                                "target_lang_word": "收拢",
                                "target_lang_sense_clarification": "将散开的东西聚在一起"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "raffen",
                                "target_lang_sense_clarification": "Stoff oder Kleidung in Falten legen"
                            },
                            {
                                "target_lang_word": "zusammenbinden",
                                "target_lang_sense_clarification": "Enden oder Teile mit einem Band fixieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ace74618-5643-386e-b7c4-891d0dd35fe4",
                    "sense_definition": "To sew fabric in a way that creates small folds or pleats to reduce its width.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>gather</w> the skirt at the waist to make it fit properly.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>присборить</w> юбку на талии, чтобы она сидела правильно.",
                                "zh": "你需要把裙子腰部<w>抽褶</w>，这样才合身。",
                                "de": "Du musst den Rock an der Taille <w>kräuseln</w>, damit er richtig sitzt."
                            }
                        },
                        {
                            "text": "The sleeves were <w>gathered</w> at the cuffs for a decorative effect.",
                            "target_lang_translations": {
                                "ru": "Рукава были <w>присборены</w> на манжетах для декоративного эффекта.",
                                "zh": "袖口处经过<w>打褶</w>处理，以达到装饰效果。",
                                "de": "Die Ärmel waren an den Manschetten für einen dekorativen Effekt <w>gerafft</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gather the fabric",
                        "gather a seam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сшивать ткань так, чтобы образовались мелкие складки.",
                        "zh": "缝制布料时通过抽褶使其产生细小褶皱以减小宽度。",
                        "de": "Stoff so nähen, dass kleine Falten oder Plissees entstehen, um die Breite zu verringern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присбаривать",
                                "target_lang_sense_clarification": "делать складки"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "в сборку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打褶",
                                "target_lang_sense_clarification": "缝纫中制作褶皱"
                            },
                            {
                                "target_lang_word": "抽褶",
                                "target_lang_sense_clarification": "通过抽线形成褶皱"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kräuseln",
                                "target_lang_sense_clarification": "Stoff durch Einreihen in kleine Falten legen"
                            },
                            {
                                "target_lang_word": "raffen",
                                "target_lang_sense_clarification": "Stoff durch Nähte in Falten legen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85cbfb4f-b963-3cf9-8e04-03aac5fcf1bb",
                    "sense_definition": "A fold or pucker in fabric made by pulling a thread to tighten it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sewing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dress features a small <w>gather</w> at the back for a better fit.",
                            "target_lang_translations": {
                                "ru": "Платье имеет небольшую <w>сборку</w> сзади для лучшей посадки.",
                                "zh": "这件裙子背部有一个小的<w>褶皱</w>，使穿着更合身。",
                                "de": "Das Kleid hat eine kleine <w>Raffung</w> am Rücken für eine bessere Passform."
                            }
                        },
                        {
                            "text": "Check the <w>gather</w> on the curtain to ensure the pleats are even.",
                            "target_lang_translations": {
                                "ru": "Проверьте <w>сборку</w> на шторе, чтобы убедиться, что складки ровные.",
                                "zh": "检查窗帘上的<w>抽褶</w>，确保褶皱均匀。",
                                "de": "Überprüfen Sie die <w>Kräuselung</w> am Vorhang, um sicherzustellen, dass die Falten gleichmäßig sind."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Складка или сборка на ткани, образованная стягиванием нити.",
                        "zh": "通过拉紧线在布料上形成的褶皱。",
                        "de": "Eine Falte oder Kräuselung im Stoff, die durch das Anziehen eines Fadens entsteht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сборка",
                                "target_lang_sense_clarification": "на ткани"
                            },
                            {
                                "target_lang_word": "складка",
                                "target_lang_sense_clarification": "элемент одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "褶皱",
                                "target_lang_sense_clarification": "布料上的折痕"
                            },
                            {
                                "target_lang_word": "抽褶",
                                "target_lang_sense_clarification": "缝纫工艺形成的褶"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "die Raffung",
                                "target_lang_sense_clarification": "das Ergebnis des Raffens"
                            },
                            {
                                "target_lang_word": "die Kräuselung",
                                "target_lang_sense_clarification": "kleine Falten im Stoff"
                            }
