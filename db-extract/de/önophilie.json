                    {
                        "form_id": "01cc519d-6384-4fcf-a4ab-f1a5a54ba6a5",
                        "entry_id": "ee620049-a3a3-3fdf-892e-514dc71a6bd9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Önophilie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                        "entry_id": "ee620049-a3a3-3fdf-892e-514dc71a6bd9",
                        "glosses": [
                            "Liebe, Freundschaft zum Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5cf092-c91a-41fc-8d12-0dad16488105",
                                "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                                "text": "„Noch die sehr kurze 7. Vita zitiert dieses Machwerk in abgeänderter, auf die Önophilie des Papstes anspielender Form.“"
                            },
                            {
                                "example_id": "2d5f435f-517d-44c6-ba8a-8bd417c086f2",
                                "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                                "text": "„Zur Önophilie fehle ihnen die ausschließliche Leidenschaft ebenso wie zum Schachspiel, eine Frau verteile ihre Zuneigung auf die gesamte Umgebung.“"
                            },
                            {
                                "example_id": "8fe2af19-5555-4c0b-b14d-2514e8ca7554",
                                "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                                "text": "„Seine Önophilie ist eine Form von Sublimierung: Auf diesem Gebiet kann er unbeschwert den Experten geben.“"
                            },
                            {
                                "example_id": "a300dabe-7bea-492e-b69b-8c608f83c66a",
                                "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                                "text": "„Als wir noch jung […] und unerfahren waren, aber schon von dem nie mehr verheilenden Virus der Önophilie schwer infiziert, da machten wir natürlich unseren ersten Besuch in Bordelais […]“"
                            },
                            {
                                "example_id": "0f600199-dbbc-4d9e-90fd-ae4e02477504",
                                "sense_id": "1d6f2927-eec8-3567-8910-2d6af527a5f4",
                                "text": "„Auch wenn die Önophilie oftmals geradezu dogmatische Züge annimmt, gibt es doch grundlegende, durch den gesunden Menschenverstand geprägte Richtlinien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
