    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2caa1fb5-2edc-32c5-8041-d6193a663abc",
                "word": "maidenhair",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6599e106-ab2f-428e-b724-dcb928c5c743",
                        "entry_id": "2caa1fb5-2edc-32c5-8041-d6193a663abc",
                        "tags": [
                            "plural"
                        ],
                        "form": "maidenhairs"
