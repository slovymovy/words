                        ],
                        "form": "^((h muet))\\ɔ.tɛs\\"
                    },
                    {
                        "form_id": "22ff563f-f423-4448-995d-ca537f7d15e3",
                        "entry_id": "bd349223-e722-3720-ac21-2c1851a29bd6",
                        "tags": [
