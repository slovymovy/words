                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e007ba62-d435-426d-a87b-bc6182f2fb93",
                                                "sense_id": "fa3050bb-de84-3929-b4b1-742d2170be31",
                                                "text": "Wadley in Berkshire is situate in a vale, though not so fertile a soil as some vales afford […]."
                                            },
                                            {
                                                "example_id": "a97dc532-7968-4de4-8d13-aae989fa686e",
                                                "sense_id": "fa3050bb-de84-3929-b4b1-742d2170be31",
                                                "text": "Pleasure situate in hill and dale."
                                            },
