                        "source_sense_id": "5285f0bf-02e4-34cb-a6ef-c6602624a483",
                        "source_sense_description": "overzicht van de onderwerpen of hoofdstukken in een boek",
                        "target_lang_word": "Inhaltsverzeichnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inhaltsverzeichnis",
                                "target_lang_code": "de",
