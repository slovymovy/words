                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0b7486e-fc01-341d-ab4a-8fea116db7f2",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Régler l'exécution d'une action, l'organiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a15730-87c0-4d89-9c19-2f1730669d4b",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger une manœuvre, une opération, une expédition."
                                            },
                                            {
                                                "example_id": "1496ff72-c93b-4028-80f2-7b2c09ea611c",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger un chantier, des travaux, des recherches."
                                            },
                                            {
                                                "example_id": "3110ea97-efbf-4120-a7a7-58e90227027f",
                                                "sense_id": "be34f571-0984-3222-8e10-f019adcaabf7",
                                                "text": "Diriger un débat, une conversation, un interrogatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Commander, administrer un organisme, une institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e24805-61d2-4e03-955a-3b3be3d71c72",
                                                "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                                "text": "Diriger un hôpital, un théâtre, une école."
                                            },
                                            {
                                                "example_id": "5f6f9a86-2ede-4bc7-beff-1117795f6ef7",
                                                "sense_id": "4cdae4fd-a2ca-38f3-b4b9-5113015d2c88",
                                                "text": "Il dirige une PME de 150 personnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Exercer une autorité sur un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c53f92-889c-4d07-999d-cdb242954146",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une nation."
                                            },
                                            {
                                                "example_id": "b23a3d3f-78d6-4df8-80b5-96fa3a55c372",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une armée, une classe, une équipe."
                                            },
                                            {
                                                "example_id": "d630ed84-85da-4f5d-964b-f928fe3c688d",
                                                "sense_id": "7ded2456-1165-35df-affa-d949d9f33382",
                                                "text": "Diriger une chorale, un orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Conduire en exerçant un pouvoir, un commandement.",
                                            "Exercer une autorité intellectuelle ou morale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e89019-9984-4f96-aa6f-3bffdde9d72d",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Diriger un élève dans son travail, un étudiant dans ses recherches."
                                            },
                                            {
                                                "example_id": "c5ce6669-1621-439b-b27b-5fc592b92e0d",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Diriger la conscience de quelqu’un."
                                            },
                                            {
                                                "example_id": "5318a5d1-748e-4a6f-b020-78575deec635",
                                                "sense_id": "690fe8e9-459a-369a-9b5a-8666547cf555",
                                                "text": "Au bout de ces dix ans, elle sera au commencement de l’âge mûr, et si elle ne trouve pas un prêtre pour s’occuper d’elle exclusivement sous prétexte de diriger sa conscience, elle est ennuyée et malheureuse jusqu’à la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db35fad-2feb-4537-b302-da597f659365",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Pour remettre la machine en mouvement, on dirige d'abord l'arbre moteur dans le sens du vent, puis on écarte les voiles afin de garnir de nouveau les ailes."
                                            },
                                            {
                                                "example_id": "57621d29-a73a-416b-a0d1-f431f41edb20",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger ses pas, sa course, son vol vers quelque endroit."
                                            },
                                            {
                                                "example_id": "07d67eef-288f-4e2e-bdb1-bd319955f31e",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger ses regards sur un objet, vers un objet."
                                            },
                                            {
                                                "example_id": "b16ae697-a60f-4e22-a039-ecff257173bf",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "Diriger son attention sur quelque chose."
                                            },
                                            {
                                                "example_id": "9553d2c6-ddcb-4073-9117-fb3fe66d5395",
                                                "sense_id": "e71e7b67-bbee-3b35-82b7-3a724121b25c",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté.",
                                            "Guider vers un point donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af70ec3f-4997-4648-be96-413104469d7f",
                                                "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                                "text": "Diriger un navire vers le port."
                                            },
                                            {
                                                "example_id": "f11e3c49-0ae2-4f15-a481-9a1a001691c3",
                                                "sense_id": "dfb008e8-27a8-3c53-8f01-6f505522635e",
                                                "text": "Diriger un avion vers la piste d'atterrissage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Orienter dans un certain sens ou d’un certain côté.",
                                            "Fixer ou envoyer dans une direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1aa5157-defd-44e6-885b-6c206447c42f",
                                                "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                                "text": "On écrivit au maire d’Allemant qui répondit qu'en effet le capitaine Bordes-Pagès avait été transporté le 9 Septembre à Allemant et que de là on l’avait dirigé sur Linthes."
                                            },
                                            {
                                                "example_id": "15c352cc-50cf-4326-927a-2161d72112df",
                                                "sense_id": "7e59f761-9f3e-3359-8a56-55a0e33157fb",
                                                "text": "Pour le tango, la salle était plongée dans l'obscurité, et deux petits projecteurs dirigeaient leurs faisceaux sur la boule à facettes qui tournait lentement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Poursuivre, accuser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f76d24b-5b68-49fe-86eb-fac66eb652a6",
                                                "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                                "text": "Diriger une accusation."
                                            },
                                            {
                                                "example_id": "3c6f0b67-3a4a-454c-a1ac-b5fea2a51b00",
                                                "sense_id": "60c75879-c827-34f6-b1dd-25d558a32716",
                                                "text": "Des poursuites furent dirigées contre lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7513a129-0f7b-3997-853f-a79d84d7bdf1",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Aller vers."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085871cf-d5fa-4df2-82b0-7f3751d3e244",
                                                "sense_id": "7513a129-0f7b-3997-853f-a79d84d7bdf1",
                                                "text": "[…] : il attendait, près du portant de gauche, le moment de se diriger du pas d'un homme qui rêve dans la direction de Jimmy, son partenaire, dont la mimique exprimait aussitôt une singulière jubilation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498a1e3c-4e8a-39f3-ac9a-c2c2d71f766e",
                                        "entry_id": "797a2c9c-22c3-3f5c-8129-f06d48d35851",
                                        "glosses": [
                                            "Trouver la bonne direction, trouver son chemin."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe37daf-380c-480a-8b84-2654ce744a83",
                                                "sense_id": "498a1e3c-4e8a-39f3-ac9a-c2c2d71f766e",
                                                "text": "Elle peine à se diriger dans l'obscurité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62e973f4-7567-457b-b93c-9e48450bf2a4",
                        "source_entry_id": "d1cb43c3-6001-37df-80a9-87964ec4e573",
                        "target_lang_word": "gouverner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gouverner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Diriger une embarcation à l’aide d’un gouvernail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96591f85-bb22-490f-9b66-3866dcd5c0fe",
                                                "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                                "text": "Vers 13 heures, je hisse la trinquette et le tourmentin et, comme le vent augmente, j'amène la grand'voile et laisse le Firecrest se gouverner seul sous voilure avant."
                                            },
                                            {
                                                "example_id": "88381f5a-90fe-4b8b-bb90-7b6a2576f0a6",
                                                "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                                "text": "Gouverner un vaisseau, une barque."
                                            },
                                            {
                                                "example_id": "07ee32df-f537-4e1f-bb5e-cef8e30b0179",
                                                "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                                "text": "Gouverner au plus près."
                                            },
                                            {
                                                "example_id": "432da476-d0ad-4111-ad1b-ce43123bf118",
                                                "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                                "text": "Gouverner à la lame, fuir vent arrière par un gros temps, pour éviter de recevoir des lames."
                                            },
                                            {
                                                "example_id": "526cee84-bed0-40be-869f-0ab94bfda7ed",
                                                "sense_id": "b2bc2ccb-4351-3734-bef6-6699ab2429cb",
                                                "text": "C’est lui qui gouverne la barque, c’est lui qui a la conduite de l’entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2e98ef-ab30-37ff-8f09-e5de2cfa8ee3",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Se dit de l’embarcation elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe53303c-22e7-4604-8922-28070fa2091b",
                                                "sense_id": "fb2e98ef-ab30-37ff-8f09-e5de2cfa8ee3",
                                                "text": "Ce bâtiment, ce bateau est désemparé, il ne gouverne plus."
                                            },
                                            {
                                                "example_id": "8d302d5c-6e05-4c40-97a7-bbb43839b467",
                                                "sense_id": "fb2e98ef-ab30-37ff-8f09-e5de2cfa8ee3",
                                                "text": "Gouverner sur son ancre, se dit lorsqu’un vaisseau étant au mouillage, dans une rivière, l’action du courant lui imprime des mouvements de rotation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e742217-0c9a-34df-a933-d03be8c3871a",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Conduire un moyen de transport."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2507e65-d497-41f1-88d8-df4c760cfc57",
                                                "sense_id": "8e742217-0c9a-34df-a933-d03be8c3871a",
                                                "text": "Gouverner un cheval, un attelage."
                                            },
                                            {
                                                "example_id": "7d5452df-4b73-40fa-bfb1-ad986837b033",
                                                "sense_id": "8e742217-0c9a-34df-a933-d03be8c3871a",
                                                "text": "Gouverner un ballon, un avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Diriger la conduite de choses ou de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af76557e-4829-430a-b153-9001bd8e62db",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Si le succès de sa morale n'a pas égalé le triomphe de sa politique, c'est qu'il est plus difficile, comme il est plus beau, d'améliorer les hommes que de les gouverner."
                                            },
                                            {
                                                "example_id": "5bb73128-131a-45cc-9cf3-7e049f689bdb",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Cependant les femmes de Lima gouvernent les hommes parce qu’elles leur sont bien supérieures en intelligence et en force morale."
                                            },
                                            {
                                                "example_id": "84728519-9664-470b-833f-4f7c812ab707",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Ce n'est rien d'ordonner des actes, si préalablement on n'est pas maître des pensées ; pour gouverner le monde des corps, il faut dominer celui des esprits."
                                            },
                                            {
                                                "example_id": "69284f44-9a10-45e5-b015-2838b6c73235",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Il ressentit une véritable joie à la pensée qu’il avait peut-être une tumeur mortelle, qu’il n’allait plus avoir à s’occuper de rien, que c’était la maladie qui allait le gouverner, faire de lui son jouet, jusqu’à la fin prochaine."
                                            },
                                            {
                                                "example_id": "2b2fe61f-3ab3-4a67-81d7-f7e2b0fbd3a8",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Une fois de plus il constata qu’il gouvernait son cœur aussi mal que possible."
                                            },
                                            {
                                                "example_id": "2a0c44d2-6500-49ba-bdea-a127763b6566",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Il s’est toujours gouverné sagement."
                                            },
                                            {
                                                "example_id": "99b4578c-83ff-4e0d-b36f-776b2f20714c",
                                                "sense_id": "818acbec-da6b-3d8e-81cd-71a9206f4125",
                                                "text": "Les ministres gouvernent sous leur responsabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46df3812-578c-3294-8835-f5d85d787e5e",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Diriger un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9d9e1c-073f-48ed-8f77-0301d128084d",
                                                "sense_id": "46df3812-578c-3294-8835-f5d85d787e5e",
                                                "text": "Martov ne condamnait pas la révolution d'Octobre, mais la monopolisation du pouvoir par le Parti bolchévique et sa façon de gouverner, la « commissariocratie »."
                                            },
                                            {
                                                "example_id": "808dd8aa-aee5-43ca-b260-f74faf9e3c12",
                                                "sense_id": "46df3812-578c-3294-8835-f5d85d787e5e",
                                                "text": "« Gouverner, c’est prévoir », disait l’historien Adolphe Thiers. « Gouverner, c’est résister », clamait Valéry Giscard d’Estaing. « Gouverner, c’est choisir », écrivait le duc de Lévis. « Gouverner, c’est mécontenter », croyait Anatole France."
                                            },
                                            {
                                                "example_id": "a0f477bf-e677-4c45-8346-f0873f723600",
                                                "sense_id": "46df3812-578c-3294-8835-f5d85d787e5e",
                                                "text": "À la tête d’un commando ultraresserré à l’Élysée, patron d’une majorité pléthorique à l’Assemblée nationale, il a cru bon de gouverner seul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7244d329-9f27-3915-ace1-9bb5b1ff481f",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Apporter des soins à une chose pour la maintenir en bon état, pour qu’elle ne périsse pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d57a8030-910e-47c2-a5be-59703cc0f774",
                                                "sense_id": "7244d329-9f27-3915-ace1-9bb5b1ff481f",
                                                "text": "Cette fille de ferme gouverne bien la basse-cour."
                                            },
                                            {
                                                "example_id": "b13418b2-e471-4059-89c6-2682acfa6186",
                                                "sense_id": "7244d329-9f27-3915-ace1-9bb5b1ff481f",
                                                "text": "[…], et il serait à préférer qu'on le construisît ainsi que le fourneau d'une forme carrée plutôt que ronde ; cette disposition convient mieux pour l'ajustement dans les douves de la chaudière ; le feu est plus facile à tiser et à gouverner ; […]."
                                            },
                                            {
                                                "example_id": "483ae5ff-6d99-4b07-9839-bd5b05603795",
                                                "sense_id": "7244d329-9f27-3915-ace1-9bb5b1ff481f",
                                                "text": "Il s’entend à gouverner le vin, à gouverner une cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6a79e0-5a62-3fd3-a9df-27a08eb09e68",
                                        "entry_id": "7c9c8b4b-057a-3f89-8f91-3b5379abeecc",
                                        "glosses": [
                                            "Régir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
