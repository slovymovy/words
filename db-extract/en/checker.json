                    {
                        "sense_id": "4949b4c5-9461-38d9-b483-2edcd998ebc7",
                        "entry_id": "d2207402-df59-3523-acc0-0c7f2332010c",
                        "glosses": [
                            "One who or that which checks or verifies something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae502575-a9de-4644-8df2-f964fff74031",
                                "sense_id": "4949b4c5-9461-38d9-b483-2edcd998ebc7",
                                "text": "So, keep in mind that Microsoft Word’s Spelling tool is as much a “typo” tool as a checker of spelling."
                            }
                        ]
                    },
                    {
                        "sense_id": "aff7c54a-4c39-32d4-ba94-3de1f7cc9031",
                        "entry_id": "d2207402-df59-3523-acc0-0c7f2332010c",
                        "glosses": [
                            "One who makes a check mark."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59cacc08-214c-40f1-8e03-3b4d3817bb5c",
                                "sense_id": "aff7c54a-4c39-32d4-ba94-3de1f7cc9031",
                                "text": "\"Essentially,\" said a senior vice president of the FHLBB of Dallas, \"we were checkers of boxes.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "34fb46ac-7e48-37d7-802d-79f224a72b15",
                        "entry_id": "d2207402-df59-3523-acc0-0c7f2332010c",
                        "glosses": [
                            "The clerk who tallies cost of purchases and accepts payment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067c7975-ddfd-408e-a7e5-e393669070a3",
                                "sense_id": "34fb46ac-7e48-37d7-802d-79f224a72b15",
                                "text": "There was a long line at the grocery store because the checker was so slow."
                            },
                            {
                                "example_id": "40273b1c-a297-4a7a-98cd-748d5985abe6",
                                "sense_id": "34fb46ac-7e48-37d7-802d-79f224a72b15",
                                "text": "Bud Brown said something to the checker he was supervising; she had been craning around to see what was happening. She flushed and began to run her calculator again."
                            }
                        ]
                    },
                    {
                        "sense_id": "34dfc1a8-5f8e-32f5-8500-aa7148177bae",
                        "entry_id": "d2207402-df59-3523-acc0-0c7f2332010c",
                        "glosses": [
                            "One who hinders or stops something."
                        ],
                        "tags": [],
                        "examples": []
                    }
