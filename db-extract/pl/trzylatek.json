                "translations": [
                    {
                        "translation_id": "3f5baf5c-bbc0-4dce-a38e-44bf9aa8604d",
                        "source_entry_id": "f1f95ab2-037f-3d90-9dee-455df9b276db",
                        "source_sense_id": "95921d73-b59f-3bcf-b1ec-88354b360dcd",
                        "target_lang_word": "Dreijähriger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreijähriger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                        "entry_id": "9cfd1277-3f05-314b-ad5e-d4931037167a",
                                        "glosses": [
                                            "Junge im Alter von drei Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba99b11-8e2a-42d9-8ea4-72a6a6ca5458",
                                                "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                                "text": "Der Dreijährige besucht den Kindergarten."
                                            },
                                            {
                                                "example_id": "3a2a921f-5b22-480d-a3bf-c94f981d4524",
                                                "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                                "text": "„Dafür, dass Noah gerade erst mit der Eingewöhnung fertig war, als der Lockdown kam, marschiert der Dreijährige extrem entspannt in die Kita.“"
                                            },
                                            {
                                                "example_id": "0b40ac4f-2bd9-4c6f-8b92-92948c772a11",
                                                "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                                "text": "„Ein 25 Jahre alter Vater ist mit seinen drei Kindern auf einem Tretboot unterwegs, als der Dreijährige ins Wasser fällt.“"
                                            },
                                            {
                                                "example_id": "aaf421dc-fb1e-440b-b8af-7ec5d0ba345f",
                                                "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                                "text": "„Die Vorwürfe wegen fahrlässiger Tötung hatten sich hauptsächlich gegen zwei Ärztinnen des Klinikums Hanau gerichtet, wo der Dreijährige kurz vor seinem Tod wegen einer geplanten Rachenmandel-Operation vorgestellt worden war, wie die Staatsanwaltschaft Hanau am Dienstag mitteilte.“"
                                            },
                                            {
                                                "example_id": "d90e9b9b-46d8-4a77-bb2b-610d0cbfabc7",
                                                "sense_id": "e9a89a42-fa84-3e55-8b20-037f4ac56159",
                                                "text": "„Auch habe er als etwa Dreijähriger gerne Lämmchen mit Hafer gefüttert, allerdings auch einen halbjährigen Säugling, zu dem er sich »geschlichen« habe und dem er, als er »in der Wiege recht bauernmäßig das Maul aufsperrte«, Hafer in jenes Maul gestopft habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
