{
    "word_family": [
        "stuff",
        "stuffing",
        "stuffy",
        "stuffer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28b2bb4c-37da-376b-a0c2-3eb1382e0b67",
                    "sense_definition": "Filled with a mixture of ingredients, such as breadcrumbs, herbs, or meat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We prepared a delicious <w>stuffed</w> turkey for the holiday dinner.",
                            "target_lang_translations": {
                                "ru": "Мы приготовили вкусную <w>фаршированную</w> индейку к праздничному ужину.",
                                "nl": "We hebben een heerlijke <w>gevulde</w> kalkoen bereid voor het kerstdiner."
                            }
                        },
                        {
                            "text": "She ordered <w>stuffed</w> peppers with rice and vegetables at the restaurant.",
                            "target_lang_translations": {
                                "ru": "Она заказала в ресторане <w>фаршированные</w> перцы с рисом и овощами.",
                                "nl": "Ze bestelde in het restaurant <w>gevulde</w> paprika's met rijst en groenten."
                            }
                        }
                    ],
                    "synonyms": [
                        "filled"
                    ],
                    "common_phrases": [
                        "stuffed peppers",
                        "stuffed turkey",
                        "stuffed mushrooms",
                        "stuffed chicken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный смесью ингредиентов, например, сухарями, зеленью или мясом.",
                        "nl": "Gevuld met een mengsel van ingrediënten, zoals broodkruimels, kruiden of vlees."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаршированный",
                                "target_lang_sense_clarification": "о еде"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gevuld",
                                "target_lang_sense_clarification": "algemeen gebruikt voor eten met een vulling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54710333-19d1-3409-b4a4-32dc43185c7c",
                    "sense_definition": "Full or packed tightly with material or objects.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "filled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl hugged her favorite <w>stuffed</w> bear tightly while she slept.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка во сне крепко обнимала своего любимого <w>плюшевого</w> медведя.",
                                "nl": "Het kleine meisje knuffelde haar favoriete <w>opgevulde</w> beer stevig terwijl ze sliep."
                            }
                        },
                        {
                            "text": "Customs officers looked closely through the <w>stuffed</w> suitcase at the airport.",
                            "target_lang_translations": {
                                "ru": "Таможенники в аэропорту внимательно осмотрели <w>набитый</w> чемодан.",
                                "nl": "De douanebeambten keken op het vliegveld nauwkeurig door de <w>propvolle</w> koffer."
                            }
                        }
                    ],
                    "synonyms": [
                        "packed",
                        "filled",
                        "crammed"
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "stuffed animal",
                        "stuffed toy",
                        "stuffed suitcase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный или плотно набитый материалом или предметами.",
                        "nl": "Vol of strak opgevuld met materiaal of voorwerpen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набитый",
                                "target_lang_sense_clarification": "плотно заполненный"
                            },
                            {
                                "target_lang_word": "плюшевый",
                                "target_lang_sense_clarification": "об игрушках"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gevuld",
                                "target_lang_sense_clarification": "vol met voorwerpen"
                            },
                            {
                                "target_lang_word": "opgevuld",
                                "target_lang_sense_clarification": "bijvoorbeeld bij knuffels of kussens"
                            },
                            {
                                "target_lang_word": "propvol",
                                "target_lang_sense_clarification": "van een tas of koffer: tot de rand vol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e85621e4-3171-3b99-9d90-9db86f1ca640",
                    "sense_definition": "Feeling completely full after eating a large amount of food.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "satiated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot eat another bite of dessert because I am absolutely <w>stuffed</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу съесть ни кусочка десерта, потому что я абсолютно <w>сыт</w>.",
                                "nl": "Ik kan geen hapje dessert meer op, want ik zit echt <w>propvol</w>."
                            }
                        },
                        {
                            "text": "After the huge meal, everyone felt happy but completely <w>stuffed</w>.",
                            "target_lang_translations": {
                                "ru": "После сытного обеда все чувствовали себя счастливыми, но совершенно <w>объевшимися</w>.",
                                "nl": "Na de enorme maaltijd voelde iedereen zich gelukkig maar helemaal <w>verzadigd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "full",
                        "satiated"
                    ],
                    "antonyms": [
                        "hungry",
                        "starving"
                    ],
                    "common_phrases": [
                        "feel stuffed",
                        "completely stuffed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий сильную сытость после большого количества еды.",
                        "nl": "Helemaal vol zitten na het eten van een grote hoeveelheid voedsel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объевшийся",
                                "target_lang_sense_clarification": "переевший"
                            },
                            {
                                "target_lang_word": "сытый",
                                "target_lang_sense_clarification": "не голодный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verzadigd",
                                "target_lang_sense_clarification": "formeel voor genoeg gegeten hebben"
                            },
                            {
                                "target_lang_word": "propvol",
                                "target_lang_sense_clarification": "informeel voor erg vol zitten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71b9fe6d-a951-3fbd-a057-64c874309da7",
                    "sense_definition": "Extremely tired or exhausted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tired",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel really <w>stuffed</w> after running that marathon yesterday.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя очень <w>уставшим</w> после вчерашнего марафона.",
                                "nl": "Ik voel me echt <w>uitgeput</w> na het lopen van die marathon gisteren."
                            }
                        },
                        {
                            "text": "He was too <w>stuffed</w> to go out for dinner after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>вымотан</w>, чтобы идти ужинать после долгого рабочего дня.",
                                "nl": "Hij was te <w>afgemat</w> om na een lange werkdag nog uit eten te gaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhausted",
                        "worn out",
                        "knackered",
                        "beat"
                    ],
                    "antonyms": [
                        "energetic"
                    ],
                    "common_phrases": [
                        "feel stuffed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in British or Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно уставший или истощенный.",
                        "nl": "Extreem moe of uitgeput."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уставший",
                                "target_lang_sense_clarification": "утомленный"
                            },
                            {
                                "target_lang_word": "вымотанный",
                                "target_lang_sense_clarification": "без сил"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitgeput",
                                "target_lang_sense_clarification": "zeer vermoeid"
                            },
                            {
                                "target_lang_word": "afgemat",
                                "target_lang_sense_clarification": "geen energie meer hebben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6736c1a1-bb66-3fe7-a991-885431e49138",
                    "sense_definition": "Broken, not working properly, or in a difficult situation with no easy solution.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "broken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My computer is <w>stuffed</w>, so I need to buy a new one immediately.",
                            "target_lang_translations": {
                                "ru": "Мой компьютер <w>сломан</w>, поэтому мне нужно немедленно купить новый.",
                                "nl": "Mijn computer is <w>kapot</w>, dus ik moet direct een nieuwe kopen."
                            }
                        },
                        {
                            "text": "If we miss the last train home tonight, we are truly <w>stuffed</w>.",
                            "target_lang_translations": {
                                "ru": "Если мы сегодня опоздаем на последний поезд домой, мы точно <w>влипли</w>.",
                                "nl": "Als we vanavond de laatste trein naar huis missen, zijn we echt <w>de klos</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "broken",
                        "ruined",
                        "busted"
                    ],
                    "antonyms": [
                        "functional",
                        "working"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сломанный, нерабочий или находящийся в безвыходной ситуации.",
                        "nl": "Stuk, werkt niet goed, of in een moeilijke situatie zonder makkelijke oplossing."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломанный",
                                "target_lang_sense_clarification": "нерабочий"
                            },
                            {
                                "target_lang_word": "влипший",
                                "target_lang_sense_clarification": "в беде"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kapot",
                                "target_lang_sense_clarification": "niet werkend"
                            },
                            {
                                "target_lang_word": "de klos",
                                "target_lang_sense_clarification": "in een lastige situatie zitten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "548d5b27-6ba1-3ddd-be87-3e17c524e116",
                    "sense_definition": "The past tense and past participle of <w>stuff</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>stuffed</w> all her dirty clothes into the washing machine.",
                            "target_lang_translations": {
                                "ru": "Она <w>запихнула</w> всю свою грязную одежду в стиральную машину.",
                                "nl": "Ze heeft al haar vuile kleren in de wasmachine <w>gepropt</w>."
                            }
                        },
                        {
                            "text": "The cushion is <w>stuffed</w> with soft feathers to make it comfortable.",
                            "target_lang_translations": {
                                "ru": "Подушка <w>набита</w> мягкими перьями для удобства.",
                                "nl": "Het kussen is <w>gevuld</w> met zachte veren om het comfortabel te maken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола 'набивать' или 'запихивать'.",
                        "nl": "De verleden tijd en voltooid deelwoord van 'vullen' of 'proppen'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набил",
                                "target_lang_sense_clarification": "наполнил"
                            },
                            {
                                "target_lang_word": "запихнул",
                                "target_lang_sense_clarification": "положил с силой"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gevuld",
                                "target_lang_sense_clarification": "voltooid deelwoord van vullen"
                            },
                            {
                                "target_lang_word": "gepropt",
                                "target_lang_sense_clarification": "met kracht ergens in geduwd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}