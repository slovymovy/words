                "senses": [
                    {
                        "sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                        "entry_id": "d977f7a7-f34b-3cd7-904d-6e6c50b8bdef",
                        "glosses": [
                            "Grad der Bekanntheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab29ea5f-7fd4-484d-b05b-4467e272bf3a",
                                "sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                                "text": "„Der Bekanntheitsgrad lässt sich mit sämtlichen Instrumenten der Kommunikationspolitik beeinflussen.“ (2008)"
                            },
                            {
                                "example_id": "33cd16c4-2765-4d9f-87d1-23c50f53a0c7",
                                "sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                                "text": "„Die Versuche zerfallen also nach dem Bekanntheitsgrade der Objecte bis hierher in sechs Abstufungen: …“ (1900)"
                            },
                            {
                                "example_id": "4652a8a6-57c6-412c-8cbe-bc0d3fccb9b8",
                                "sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                                "text": "„In den vergangenen fünfzehn Jahren habe ich in dieser Region durch meine Fernsehauftritte als Kulturkritiker einen gewissen Bekanntheitsgrad erreicht, und deswegen kommen sie in mein Seminar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99b7d1cf-2492-4fe9-a070-e7a31aeb6636",
                        "source_entry_id": "d977f7a7-f34b-3cd7-904d-6e6c50b8bdef",
                        "source_sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                        "source_sense_description": "Grad der Bekanntheit",
                        "target_lang_word": "notoriété",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notoriété",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f553869d-689a-3835-93fa-e1cdf346371a",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "Connaissance générale, publique, d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e411087-0a07-4a5c-a383-344a951805a4",
                                                "sense_id": "f553869d-689a-3835-93fa-e1cdf346371a",
                                                "text": "Le clergé réuni reconnut la force du plaidoyer, ainsi que la notoriété des circonstances sur lesquelles il se fondait […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "État d’une personne fort connue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7206449e-afd3-49f5-9429-33baef33a5ec",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "Ah ! le temps joyeux de la stupidité, de pharisaïsme à rebours où les petits messieurs pressés se hissaient paisiblement sur la crête de la notoriété. Tous des faiseurs, tous des faisans."
                                            },
                                            {
                                                "example_id": "9336ca83-2bb9-489f-b0cf-e8e9aa10d058",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "La notoriété médiatique de la photo y repose sur ses qualités de documentarité (elle fait document) et de testimonialité (elle atteste)."
                                            },
                                            {
                                                "example_id": "9dbb9624-5ce9-441c-ab80-d9555aa00671",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "Cet événement, qui jouit d'une réputation internationale, présente des oeuvres issues des nouveaux courants artistiques ; l'occasion est donc belle de faire valoir la complexité de mon travail et d'accroître ma notoriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c619c8-a5d1-3da7-a047-1d3c1e790c52",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "Personne connue, célébrité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21269bb9-f9d2-4b8a-95f4-067cefed500e",
                                                "sense_id": "43c619c8-a5d1-3da7-a047-1d3c1e790c52",
                                                "text": "Tu voulais voir ton nom cité parmi les notoriétés, le soir de la « générale » au Châtelet…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c55763de-5409-4b69-912e-b6a39bfb6c18",
                        "source_entry_id": "d977f7a7-f34b-3cd7-904d-6e6c50b8bdef",
                        "source_sense_id": "22499075-b20d-3fd2-8900-ba6f677ac30b",
                        "source_sense_description": "Grad der Bekanntheit",
                        "target_lang_word": "popularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "popularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                        "entry_id": "4e03122c-252e-36ea-801c-23b52d8d1641",
                                        "glosses": [
                                            "Faveur publique ; crédit parmi le peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec3a247-9c8b-460b-a8ee-5bc76caf37a6",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Le capital sympathie associé au vautour fauve ne menace pas vraiment la popularité de l’ours brun ou du pottock (le poney basque), pour ne parler que des animaux des pentes pyrénéennes."
                                            },
                                            {
                                                "example_id": "8c360c5a-1e81-4857-9deb-9ff02ba71c52",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Néanmoins, à l'occasion d'une pétition qui réclamait le rappel des bannis indistinctement, il s'exprima en des termes violemment improbatifs, qui lui valurent un jour de popularité à la cour ; mais il paraît qu'en cette occasion, le Maréchal n'avait pas suffisamment pesé ses paroles, […]."
                                            },
                                            {
                                                "example_id": "37c6d28e-b33b-4e5d-a6e8-6696cabeff78",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Quant au duc d’Orléans, il jouissait de peu de popularité et de peu d’influence. C’était l’homme des petites menées ; il rabaissait à sa taille les choses dont il s’occupait."
                                            },
                                            {
                                                "example_id": "820ac12b-2f9e-4dd4-a78a-8eb3aa21a48f",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Mais sa popularité ne survit pas à son mariage avec Marina, Polonaise et catholique, qui amène à la Cour une suite de gentilshommes de son pays dont l’attitude conquérante irrite les Moscovites."
                                            },
                                            {
                                                "example_id": "8080f117-abc1-4465-ab11-7d1d14180d1e",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Laurier n’était pas seulement, et à la fois, un dictateur par tempérament, un riche propriétaire foncier et un puissant industriel (…), mais c’était aussi un personnage populaire, fort habile à cultiver l’art de la popularité."
                                            },
                                            {
                                                "example_id": "920102f2-4102-46f3-a6c7-1166f1eda4e2",
                                                "sense_id": "00fd0095-025d-3d41-acd9-ecdc609f59f2",
                                                "text": "Je ne serai jamais populaire. La popularité, c'est pour les filles qui portent des serre-têtes assortis à leurs robes et traînent avec des filles qui portent aussi des serre-têtes assortis à leurs robes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ffbc5b-5765-3967-8e8f-90212d7b9356",
                                        "entry_id": "4e03122c-252e-36ea-801c-23b52d8d1641",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7381ae6a-70da-45dc-8004-4dc7a1e0840a",
                                                "sense_id": "c7ffbc5b-5765-3967-8e8f-90212d7b9356",
                                                "text": "La bourgeoisie, les commerçants retirés, les avocats, les notaires, tout le petit monde aisé et ambitieux qui peuple la ville neuve, tâche de donner quelque vie à Plassans. Ceux-là vont aux soirées de M. le sous-préfet et rêvent de rendre des fêtes pareilles. Ils font volontiers de la popularité, appellent un ouvrier « mon brave », parlent des récoltes aux paysans, lisent les journaux, se promènent le dimanche avec leurs dames."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
