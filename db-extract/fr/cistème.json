                                    {
                                        "sense_id": "33194e43-2a2f-3492-8ffa-05a1ab549d40",
                                        "entry_id": "af32acb9-3b8d-3978-bb8c-7bd674dbf802",
                                        "glosses": [
                                            "A system or societal structure that privileges cisgender people and marginalizes transgender people."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "696687d1-4682-4efd-8754-5a816e51edc0",
                                                "sense_id": "33194e43-2a2f-3492-8ffa-05a1ab549d40",
                                                "text": "It is this toilet cistem that served to cement the spatially constructed division between man and woman that is still present today."
                                            },
                                            {
                                                "example_id": "a6812209-f074-4683-8e4e-7a2679bb2d1c",
                                                "sense_id": "33194e43-2a2f-3492-8ffa-05a1ab549d40",
                                                "text": "I can think of no better role model for a transgender individual, particularly one looking to tackle the \"cistem\" of health care."
                                            },
                                            {
                                                "example_id": "ddb83965-be37-4250-be26-d6ecaa2654a9",
                                                "sense_id": "33194e43-2a2f-3492-8ffa-05a1ab549d40",
                                                "text": "Capital High’s school culture is seemingly accepting to the LGBTQIA+ population, yet it is also one saturated by a white heteropatriarchal cistem, and continued education and activism are required to combat this."
                                            }
                                        ]
                                    }
                                ]
                            }
