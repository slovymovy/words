                ],
                "senses": [
                    {
                        "sense_id": "a06a730d-2eaa-37e1-aed9-e5ca0abf1471",
                        "entry_id": "26001593-3908-3ef4-a389-0c6404d4cfb5",
                        "glosses": [
                            "Faire naître, élever un incident, des incidents dans le cours d’un procès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18bd45cd-cc18-4b6f-9609-7e8be64bf091",
                                "sense_id": "a06a730d-2eaa-37e1-aed9-e5ca0abf1471",
                                "text": "On incidentait sur la manière de nous juger."
                            }
                        ]
                    },
                    {
                        "sense_id": "9370ad12-93f2-314a-9266-302d5b42293c",
                        "entry_id": "26001593-3908-3ef4-a389-0c6404d4cfb5",
                        "glosses": [
                            "Chicaner, faire des objections peu importantes, élever de mauvaises difficultés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a33d8c-80f1-4ef7-8945-de01637e7ee6",
                                "sense_id": "9370ad12-93f2-314a-9266-302d5b42293c",
                                "text": "Il faut considérer comme le ministre incidente sur chaque parole des promesses de Jésus-Christ."
                            },
                            {
                                "example_id": "a586348a-718f-4bc8-a25c-fa880ff7b40d",
                                "sense_id": "9370ad12-93f2-314a-9266-302d5b42293c",
                                "text": "Deviez-vous incidenter sur des choses si communes ?"
                            },
                            {
                                "example_id": "03e6e1f9-d37b-4db9-a4a3-611fac5b5e1e",
                                "sense_id": "9370ad12-93f2-314a-9266-302d5b42293c",
                                "text": "Comme ils reçoivent l'eucharistie à genoux, rien ne les empêche d'y reconnaître, ni d'y adorer Jésus-Christ présent dans le même esprit que nous faisons ; après cela, nous incidenter sur la transsubstantiation est une chicane peu digne d'eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "548273fd-ffec-3d57-af7b-3d7752d08877",
                        "entry_id": "26001593-3908-3ef4-a389-0c6404d4cfb5",
                        "glosses": [
                            "Interrompre, marquer par un incident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d0826f1-6573-48a6-961c-602806525ff8",
                                "sense_id": "548273fd-ffec-3d57-af7b-3d7752d08877",
                                "text": "Une de nos dernières audiences correctionnelles a été incidentée par une affaire aussi grave que douloureuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7c0956a-a252-37b6-bd93-9a2e916c0ac7",
                        "entry_id": "26001593-3908-3ef4-a389-0c6404d4cfb5",
                        "glosses": [
                            "Provoquer des incidents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9053bb34-d281-4236-b295-53295476145a",
                                "sense_id": "d7c0956a-a252-37b6-bd93-9a2e916c0ac7",
                                "text": "Cela nous donnait souvent l’imprévu de nuits passées en plein champ, ou sous le toit ouvert d’une grange ; mais ce qui achevait d’incidenter notre excursion, c’est que ni l’un ni l’autre nous ne savions un mot d’allemand."
                            }
                        ]
                    }
                ],
