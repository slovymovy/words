                                                "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "5aa8e6c9-f368-418e-adc3-c8d21f601ab5",
                                                "sense_id": "98dd3e70-5165-3104-993a-8811220678b0",
                                                "text": "Er sammelt leidenschaftlich gerne Postkarten."
                                            },
