                "senses": [
                    {
                        "sense_id": "5a427580-5ed3-30a3-b4b0-bc27a358c123",
                        "entry_id": "8aa3b9fc-8e19-3823-8f9a-600833f686ba",
                        "glosses": [
                            "Substance (minérale, biologique, organique, radioactive…) polluante (et donc altéragène biologique, physique ou chimique) présente dans des concentrations très faibles dans l’eau (de l’ordre du microgramme ou du nanogramme par litre), dans l’air ou le sol, et qui peut avoir une action toxique ou écotoxique pour tout ou partie des organismes ou l’écosystème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e696ee6f-f5e1-49a5-9a3d-82fe21d6d990",
                                "sense_id": "5a427580-5ed3-30a3-b4b0-bc27a358c123",
                                "text": "Lorsque le mot « micropolluant » est utilisé, il est de suite associé à des « activités humaines polluantes »."
                            },
                            {
                                "example_id": "37158ddf-5ff4-46ff-a9ee-612180714feb",
                                "sense_id": "5a427580-5ed3-30a3-b4b0-bc27a358c123",
                                "text": "Invisibles à l’œil nu, ces micropolluants sont emportés dans les eaux pluviales et usées qui se déversent dans les stations de traitement où ils ne font finalement que passer."
                            },
                            {
                                "example_id": "1779f6ab-7191-4717-b0b3-dee8e939ea9b",
                                "sense_id": "5a427580-5ed3-30a3-b4b0-bc27a358c123",
                                "text": "Ces dispositifs sont donc peu utilisés dans les laboratoires pour les analyses de micropolluants organiques."
                            }
                        ]
                    }
                ],
