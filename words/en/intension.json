                {
                    "sense_id": "2fd0e55e-20e3-3a75-8763-8198d998676e",
                    "sense_definition": "The internal content or inherent properties that define a word, concept, or symbol, as opposed to the real-world objects it designates.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic_and_linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal logic, the <w>intension</w> of a concept determines which objects fall under its definition."
                        },
                        {
                            "text": "Philosophers often contrast the <w>intension</w> of a term with its real-world extension."
                        }
                    ],
                    "synonyms": [
                        "connotation",
                        "comprehension"
                    ],
                    "antonyms": [
                        "extension"
                    ],
                    "common_phrases": [
                        "intension and extension"
                    ]
                },
                {
                    "sense_id": "1658454a-80bb-3e19-8ad8-1d8aba82b568",
                    "sense_definition": "The degree, quality, or process of being or becoming intense; intensity.",
