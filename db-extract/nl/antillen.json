                                    {
                                        "sense_id": "e84ddb68-a9f7-3c42-8aea-37b009ef2ab9",
                                        "entry_id": "13896689-ff05-35da-bf21-160b27c537a0",
                                        "glosses": [
                                            "Ensemble d’îles, situé dans la mer des Caraïbes, dans le golfe du Mexique (cayos cubains) et dans l'océan Atlantique et bordé au sud par l’Amérique du Sud, à l'ouest par la péninsule du Yucatán et au nord-ouest par la Floride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a771024-85dc-4383-a73a-d1b0507d0af4",
                                                "sense_id": "e84ddb68-a9f7-3c42-8aea-37b009ef2ab9",
                                                "text": "Ces trésors végétaux viennent de Madère, des Canaries, des Antilles, des îles Juan Fernandez ou encore d’Hawaï."
                                            },
                                            {
                                                "example_id": "06f1b8b6-c8f4-49a1-810a-002e4bf44695",
                                                "sense_id": "e84ddb68-a9f7-3c42-8aea-37b009ef2ab9",
                                                "text": "Chacun leur tour, les copilotes dirigent le bateau jusqu’aux Caraïbes, puis vers le Cap-Vert, avant de fendre l’Atlantique vers les Antilles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
