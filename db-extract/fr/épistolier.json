                        "tags": [
                            "feminine"
                        ],
                        "form": "épistolière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                        "entry_id": "66e89da1-a12b-396a-8445-be06f43c536b",
                        "glosses": [
                            "Celui qui écrit beaucoup de lettres, qui excelle dans l’art de les écrire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce43ff99-ed04-4233-bc01-b1efb5a5e936",
                                "sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                                "text": "Deux lettres de l’épistolier célèbre qu’était Nicolas Heinsius ouvrent le choix des lettres de ses amis à Roland qui terminent les lettres philosophiques."
                            },
                            {
                                "example_id": "984b5ec1-ac0e-45a5-b021-522ce004f1df",
                                "sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                                "text": "Outre ces qualités communes, si l’on observe dans les portraits le contexte immédiat de la mention d’un talent d’épistolier, on en relève d’autres, plus spécifiques, qui permettent de distinguer les différents auteurs de lettre et de cerner des styles."
                            },
                            {
                                "example_id": "36e7efe0-49ce-41d4-8b43-9f6a8e836d2d",
                                "sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                                "text": "Leblanc aime exagérer, ça fait aussi partie de la personnalité de ce sympathique et infatigable épistolier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1c733ea-8dae-4365-aa21-b75507247475",
                        "source_entry_id": "66e89da1-a12b-396a-8445-be06f43c536b",
                        "source_sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                        "target_lang_word": "Briefschreiber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briefschreiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8170b905-c4c3-3c49-9ead-666866266a34",
                                        "entry_id": "4e0b4cca-0dd1-3fa4-bb96-a1a79f35d4cd",
                                        "glosses": [
                                            "Person, die Briefe schreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46339541-36fa-4175-ab90-30c24ba2e920",
                                                "sense_id": "8170b905-c4c3-3c49-9ead-666866266a34",
                                                "text": "„Nun aber kam der Brief, zweiundvierzig Jahre nach der ausgelassenen Lesung und vierzig Jahre nachdem der Briefschreiber seine Albertine kennengelernt hatte.“"
                                            },
                                            {
                                                "example_id": "2da4343d-80b0-47af-9f2b-3a8cdb66d0c0",
                                                "sense_id": "8170b905-c4c3-3c49-9ead-666866266a34",
                                                "text": "„Karin antwortete ganz ehrlich, sie hoffe, dass die Briefe den Briefschreiber widerspiegeln.“"
                                            },
                                            {
                                                "example_id": "6da48bf6-8fc6-48ba-aa23-ea5245eab2d9",
                                                "sense_id": "8170b905-c4c3-3c49-9ead-666866266a34",
                                                "text": "„Zu allen Zeiten schon – und wenn man sagt zu allen Zeiten, dann wenigstens seit dem Mittelalter – waren staatliche Stellen daran interessiert, zu erfahren, was sich Briefschreiber gegenseitig zu berichten hatten.“"
                                            },
                                            {
                                                "example_id": "cd3dbf01-3b5c-44af-8fcd-c1a6e270906e",
                                                "sense_id": "8170b905-c4c3-3c49-9ead-666866266a34",
                                                "text": "„Dennoch wird der national gesinnte Briefschreiber deutscher Zunge den Entschluss unseres Landesvaters bedauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76692dfd-b023-42c3-b846-b6c346e749be",
                        "source_entry_id": "66e89da1-a12b-396a-8445-be06f43c536b",
                        "source_sense_id": "25ab8174-af8c-3c45-906b-ffeffd8c0556",
                        "target_lang_word": "Briefschreiberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
