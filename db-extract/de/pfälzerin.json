                "senses": [
                    {
                        "sense_id": "9ca79165-9d1c-363d-b4ad-85e0933e3e4c",
                        "entry_id": "ca424fdb-0b39-3a14-ab5a-74d1a7e05b3e",
                        "glosses": [
                            "weibliche Person, die aus der Pfalz stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81aebb4a-626f-46b9-bfe1-c14b96a8431f",
                                "sense_id": "9ca79165-9d1c-363d-b4ad-85e0933e3e4c",
                                "text": "Eine Bekannte von mir ist Pfälzerin."
                            },
                            {
                                "example_id": "6d3a2ef3-3736-44c9-a23f-fd28884b3c5f",
                                "sense_id": "9ca79165-9d1c-363d-b4ad-85e0933e3e4c",
                                "text": "„Vor einigen Monaten hätte sich die 19-jährige Pfälzerin nicht vorstellen können, jemals eine Schusswaffe in der Hand zu halten, jetzt kneift sie das rechte Auge zu und nimmt mit dem linken das 200 Meter weit entfernte Ziel durch das Fernrohr ins Visier.“"
                            },
                            {
                                "example_id": "3d80044e-5394-4dca-87f8-6912ec7866e9",
                                "sense_id": "9ca79165-9d1c-363d-b4ad-85e0933e3e4c",
                                "text": "„Die gebürtige Pfälzerin, die bis vor drei Jahren für den 1. FC Saarbrücken in der Zweiten Bundesliga aktiv war […], ist stolz auf die Fortschritte, die ihre Spielerinnen in den vergangenen Monaten gemacht haben.“"
                            },
                            {
                                "example_id": "2f9ff53c-bb86-4290-8884-f80442f3d366",
                                "sense_id": "9ca79165-9d1c-363d-b4ad-85e0933e3e4c",
                                "text": "„Die Pfälzerin wird künftig wohl als Polizei-Oberkommissarin arbeiten, ‚wie und wo, darüber ist noch nicht gesprochen worden‘, sagte Welte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
