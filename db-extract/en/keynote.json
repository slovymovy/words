                                        "entry_id": "13cdc585-cbcb-33ac-a1d5-e1d63711fb82",
                                        "glosses": [
                                            "hohe Gesangs-Stimmlage bei Männern (zwischen Bariton und Countertenor)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73f5c67-1b4e-428e-a771-0d3cd5d9fc8e",
                                                "sense_id": "b4007e4f-8e09-3782-9c8b-7ee42dd7e286",
                                                "text": "„Die Bezeichnung Tenor bildete sich mit der beginnenden Mehrstimmigkeit heraus, als man die Stimme, die den Cantus firmus hielt, Tenor nannte, während die umspielenden Gegenstimmen Contratenor hießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13855abc-b60a-3cfe-bf98-1f052ef02764",
                                        "entry_id": "13cdc585-cbcb-33ac-a1d5-e1d63711fb82",
                                        "glosses": [
                                            "ein Sänger in der Stimmlage von [1]"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02aa2907-448e-4c86-9c4f-ffcee2c2c5bb",
                                                "sense_id": "13855abc-b60a-3cfe-bf98-1f052ef02764",
                                                "text": "„Beniamino Gigli war einer der größten Tenöre seiner Zeit und galt als legitimer Nachfolger von Enrico Caruso.“"
                                            },
                                            {
                                                "example_id": "fd708c9a-735e-40a1-bc3d-d2872e6ff5f0",
                                                "sense_id": "13855abc-b60a-3cfe-bf98-1f052ef02764",
                                                "text": "„Der schlanke Richard S., ein Bariton, trifft auf dem Wege zur Bühnenprobe den gewichtigen Tenor Leo Slezak.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f38823b-9c29-30e3-a63d-abb61857eaa7",
                                        "entry_id": "13cdc585-cbcb-33ac-a1d5-e1d63711fb82",
                                        "glosses": [
                                            "eine Stimmlage von Musikinstrumenten (Tenorhorn, Tenorsaxophon)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9827753a-e6f2-39f6-87a7-cbf2c1664d2c",
                                        "entry_id": "13cdc585-cbcb-33ac-a1d5-e1d63711fb82",
                                        "glosses": [
                                            "die in der mehrstimmigen Musik des 13. bis 16. Jahrhunderts den cantus firmus tragende Stimme"
                                        ],
                                        "tags": [
