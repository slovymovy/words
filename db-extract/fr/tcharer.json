                "senses": [
                    {
                        "sense_id": "c9659636-3978-3b5d-b6cf-f20477b1142f",
                        "entry_id": "32a547b9-80db-34e7-a1fc-32c9cfb1e8af",
                        "glosses": [
                            "Parler."
                        ],
                        "tags": [
                            "Sud de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "81d2beba-225a-4fc7-b4fe-5264099bd5a5",
                                "sense_id": "c9659636-3978-3b5d-b6cf-f20477b1142f",
                                "text": "Pour tcharer de tout et de rien : (...)"
                            },
                            {
                                "example_id": "3a77212a-365a-4ba1-85c0-163d5c976e33",
                                "sense_id": "c9659636-3978-3b5d-b6cf-f20477b1142f",
                                "text": "si vous me trouvez connectée ici c'est que je viens tcharer, et participer à une discussion,( si j'ai une idée dessus, et si j'ai envie d'en parler......"
                            },
                            {
                                "example_id": "b388c009-ba26-4f22-917d-5dab1a125605",
                                "sense_id": "c9659636-3978-3b5d-b6cf-f20477b1142f",
                                "text": "On peut tcharer littérature, arts, photo, ciné. On peut jacter sur les autres."
                            },
                            {
                                "example_id": "b1c470d9-e641-40e1-86bd-7ea1a802d3a7",
                                "sense_id": "c9659636-3978-3b5d-b6cf-f20477b1142f",
                                "text": "Et j'ai timidement osé :\n— Elles parlent pas ?\n— Pas besoin ! a tranché Saïd, c'est par en bas qu'elles tcharent, pas vrai les filles !"
                            }
                        ]
                    }
