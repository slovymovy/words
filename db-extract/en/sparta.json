                                "target_senses": [
                                    {
                                        "sense_id": "8def3a36-2f01-3359-9df4-5e2e710e1d27",
                                        "entry_id": "caf3db5e-352c-3bc2-89fb-5e4a842054fa",
                                        "glosses": [
                                            "Ancienne ville grecque du Péloponnèse, capitale de la Laconie et l’une des cités-États les plus puissantes de la Grèce antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d100325-6559-41dd-808a-6328e14b162b",
                                                "sense_id": "8def3a36-2f01-3359-9df4-5e2e710e1d27",
                                                "text": "À Sparte, le vol était pratiqué et honoré : c’était une institution hiératique, un complément indispensable à l’éducation de tout Lacédémonien sérieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "165cbe41-7b42-4c61-81e5-f0d438da3a36",
                        "source_entry_id": "9c272146-466c-3771-b218-bb671db961d1",
                        "source_sense_description": "ancient city-state in southern Greece",
                        "target_lang_word": "Sparta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sparta",
