{
    "word_family": [
        "время",
        "временной",
        "временный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b17a902a-b82a-3424-89be-cb5f06d0da5e",
                    "sense_definition": "в момент или отрезок времени, соответствующий норме или наилучший для чьих-либо дальнейших действий; своевременно, к должному сроку",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд прибыл <w>вовремя</w>.",
                            "target_lang_translations": {
                                "de": "Der Zug kam <w>pünktlich</w> an."
                            }
                        },
                        {
                            "text": "Студент пришел на экзамен <w>вовремя</w>.",
                            "target_lang_translations": {
                                "de": "Der Student kam <w>pünktlich</w> zur Prüfung."
                            }
                        }
                    ],
                    "synonyms": [
                        "своевременно"
                    ],
                    "antonyms": [
                        "невовремя"
                    ],
                    "common_phrases": [
                        "прийти вовремя",
                        "вернуться вовремя"
                    ],
                    "target_lang_definitions": {
                        "de": "Zu einem Zeitpunkt, der den Erwartungen entspricht oder ideal für eine Handlung ist; fristgerecht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rechtzeitig",
                                "target_lang_sense_clarification": "Betont, dass etwas genau zur richtigen Zeit geschieht, bevor es zu spät ist."
                            },
                            {
                                "target_lang_word": "pünktlich",
                                "target_lang_sense_clarification": "Bezieht sich auf das Einhalten einer vereinbarten oder festgesetzten Uhrzeit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fec9de8-6fb9-37be-ad83-3b9fe485d6f4",
                    "sense_definition": "кстати, в подходящий, удобный момент",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Вовремя</w> сказанное слово очень помогло в этой сложной ситуации.",
                            "target_lang_translations": {
                                "de": "Ein <w>zur rechten Zeit</w> gesagtes Wort hat in dieser schwierigen Situation sehr geholfen."
                            }
                        },
                        {
                            "text": "Друг пришел очень <w>вовремя</w> и помог мне с тяжелыми сумками.",
                            "target_lang_translations": {
                                "de": "Mein Freund kam sehr <w>gelegen</w> und half mir mit den schweren Taschen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вовремя сказать"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem passenden, günstigen oder hilfreichen Moment."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gelegen",
                                "target_lang_sense_clarification": "Beschreibt einen Moment, der sehr gut in die Situation passt."
                            },
                            {
                                "target_lang_word": "zur rechten Zeit",
                                "target_lang_sense_clarification": "Eine idiomatische Wendung für einen Moment, der genau richtig kommt."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}