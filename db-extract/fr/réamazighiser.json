                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db6a293-cefa-4d16-97a5-644c64393360",
                                "sense_id": "3e9aed34-860d-3211-92f0-c3c510abd4e9",
                                "text": "Si les autochtones ont décidé de réamazighiser leur pays les immigrés doivent soit s'y conformer soit retourner d'où ils prétendent venir."
                            },
                            {
                                "example_id": "c6b7efdc-7a90-4668-94c5-26ba9cd95217",
                                "sense_id": "3e9aed34-860d-3211-92f0-c3c510abd4e9",
                                "text": "Réamazighiser la nation marocaine doit être dorénavant un débat national qui constitue le fil conducteur vers la résolution des crises de TAMEZEGHA."
                            }
                        ]
