                "senses": [
                    {
                        "sense_id": "9dfed3e3-241b-3bae-85eb-e1e415c2b8dd",
                        "entry_id": "eb025e8f-6d7b-3b3c-8f55-a045ba8fb99a",
                        "glosses": [
                            "Störung des Gehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0c250d-fe7d-496c-bc95-c4d4db5b6c72",
                                "sense_id": "9dfed3e3-241b-3bae-85eb-e1e415c2b8dd",
                                "text": "„Ausgedehnte Läsionen des Stimlappens fiihren zu einem organischen Psychosyndrom mit Antriebsarmut, psychomotorischer Hemmung und Veränderung des effektiven Erlebens. Zusätzlich wird häufig eine Dysbasie beobachtet.“"
                            },
                            {
                                "example_id": "7295c8d7-6562-4bdd-b670-c2934abd661f",
                                "sense_id": "9dfed3e3-241b-3bae-85eb-e1e415c2b8dd",
                                "text": "„Daß beim sogenannten Rollversuch ein grober klinischer Anhaltspunkt für den Grad der intermittierenden Dysbasie zu erhalten ist, wird später besprochen (s. S. 56).“"
                            },
                            {
                                "example_id": "bcd7469f-93de-4db2-be23-e0c27a844908",
                                "sense_id": "9dfed3e3-241b-3bae-85eb-e1e415c2b8dd",
                                "text": "„Dagegen kann sich echte Phlebosklerose der Beine mit ebenso echter arteriosklerotischer Dysbasie vereinigen […].““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
