{
    "word_family": [
        "overwhelming",
        "overwhelmingly",
        "overwhelmed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4eb3661e-857e-3ae6-90b8-a9ff6ec1af5d",
                    "sense_definition": "To affect someone's emotions so strongly that they cannot think clearly or react easily",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news of her promotion began to <w>overwhelm</w> her with pure joy.",
                            "target_lang_translations": {
                                "ru": "Внезапная новость о повышении начала <w>переполнять</w> её чистой радостью."
                            }
                        },
                        {
                            "text": "It is common to <w>overwhelm</w> with guilt when you feel responsible for a mistake.",
                            "target_lang_translations": {
                                "ru": "Часто чувство вины может <w>захлестнуть</w>, когда чувствуешь ответственность за ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "grip"
                    ],
                    "antonyms": [
                        "underwhelm"
                    ],
                    "common_phrases": [
                        "overwhelm with guilt",
                        "overwhelm with joy",
                        "completely overwhelm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно воздействовать на чьи-либо эмоции, так что человек не может ясно мыслить или адекватно реагировать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переполнять",
                                "target_lang_sense_clarification": "о сильных чувствах, таких как радость или гордость"
                            },
                            {
                                "target_lang_word": "захлёстывать",
                                "target_lang_sense_clarification": "о внезапном и сильном наплыве эмоций"
                            },
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "полностью завладевать вниманием и чувствами"
                            },
                            {
                                "target_lang_word": "овладевать",
                                "target_lang_sense_clarification": "о чувстве, которое берет верх над человеком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "750064ee-7834-3a5a-9c49-e1b06ad471f9",
                    "sense_definition": "To defeat or overpower someone completely using superior force or numbers",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army managed to <w>overwhelm</w> the enemy defenses within a few hours.",
                            "target_lang_translations": {
                                "ru": "Армии удалось <w>подавить</w> оборону противника в течение нескольких часов."
                            }
                        },
                        {
                            "text": "They used <w>overwhelming</w> force to ensure the rebellion was stopped quickly.",
                            "target_lang_translations": {
                                "ru": "Они использовали <w>подавляющую</w> силу, чтобы быстро остановить восстание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overwhelm the enemy",
                        "overwhelm with force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью победить или подавить кого-либо, используя превосходящую силу или численность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "силой или авторитетом"
                            },
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "наносить полное поражение в бою"
                            },
                            {
                                "target_lang_word": "сокрушать",
                                "target_lang_sense_clarification": "уничтожать сопротивление превосходящей силой"
                            },
                            {
                                "target_lang_word": "пересиливать",
                                "target_lang_sense_clarification": "оказываться сильнее в физическом или моральном плане"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1d88f48-8d54-36c4-b425-a9cfd1f960e9",
                    "sense_definition": "To cover or bury something completely, especially by a great volume of water",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "submerge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A massive wave rose up to <w>overwhelm</w> the small fishing boat.",
                            "target_lang_translations": {
                                "ru": "Огромная волна поднялась и <w>захлестнула</w> маленькую рыбацкую лодку."
                            }
                        },
                        {
                            "text": "The rising flood waters threaten to <w>overwhelm</w> the coastal village.",
                            "target_lang_translations": {
                                "ru": "Поднимающиеся паводковые воды грозят <w>затопить</w> прибрежную деревню."
                            }
                        }
                    ],
                    "synonyms": [
                        "swamp"
                    ],
                    "common_phrases": [
                        "overwhelm the boat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью накрыть или затопить что-либо, особенно большим объемом воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захлёстывать",
                                "target_lang_sense_clarification": "о волнах, накрывающих судно или берег"
                            },
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "о стихии, скрывающей что-либо под собой"
                            },
                            {
                                "target_lang_word": "затапливать",
                                "target_lang_sense_clarification": "покрывать водой большую территорию"
                            },
                            {
                                "target_lang_word": "накрывать",
                                "target_lang_sense_clarification": "о волне, обрушивающейся сверху"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a08cac51-73c6-3238-8ab1-5bd877c03493",
                    "sense_definition": "To place something over another thing so as to cover or surround it",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions say to <w>overwhelm</w> a broader pipe about the first one.",
                            "target_lang_translations": {
                                "ru": "В инструкции сказано <w>насадить</w> более широкую трубу поверх первой."
                            }
                        },
                        {
                            "text": "He carefully tried to <w>overwhelm</w> the container to seal the mixture inside.",
                            "target_lang_translations": {
                                "ru": "Он осторожно попытался <w>перекрыть</w> контейнер, чтобы запечатать смесь внутри."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This physical sense of covering is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить что-либо поверх другого предмета, чтобы полностью закрыть или окружить его"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "накладывать один слой на другой"
                            },
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "окружать со всех сторон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2792b4f3-7271-3e2a-8bee-f1a02c71c51f",
                    "sense_definition": "The state or feeling of being completely overcome by stress, emotions, or tasks",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a deep breath to manage the <w>overwhelm</w> she felt at work.",
                            "target_lang_translations": {
                                "ru": "Она сделала глубокий вдох, чтобы справиться с <w>подавленностью</w>, которую чувствовала на работе."
                            }
                        },
                        {
                            "text": "The sheer amount of data can lead to a sense of <w>overwhelm</w> for new students.",
                            "target_lang_translations": {
                                "ru": "Огромный объем данных может вызвать чувство <w>перегруженности</w> у новых студентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of overwhelm",
                        "feeling of overwhelm"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a noun primarily in psychological or self-help contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или чувство полной подавленности стрессом, эмоциями или объемом задач"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавленность",
                                "target_lang_sense_clarification": "состояние эмоционального груза"
                            },
                            {
                                "target_lang_word": "перегруженность",
                                "target_lang_sense_clarification": "состояние, когда задач слишком много"
                            },
                            {
                                "target_lang_word": "избыток эмоций",
                                "target_lang_sense_clarification": "ощущение, что чувства бьют через край"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}