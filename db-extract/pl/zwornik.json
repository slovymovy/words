                        "target_lang_word": "Schlussstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlussstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02314382-abc3-35a7-bd5d-cd6f4ba98377",
                                        "entry_id": "80e09e6e-8d30-300e-a02f-3badab35883c",
                                        "glosses": [
                                            "der keilförmige, häufig verzierte Stein im Scheitel eines Bogens oder eines Gewölbes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf06876-f19a-4cbc-aef2-b19a795e0de4",
                                                "sense_id": "02314382-abc3-35a7-bd5d-cd6f4ba98377",
                                                "text": "Der Schlussstein von Fensterbögen ist manchmal mit einem Gesicht oder Wappen verziert."
                                            },
                                            {
                                                "example_id": "b4a9c2c8-638c-4422-96a7-59a0cc4cb52e",
                                                "sense_id": "02314382-abc3-35a7-bd5d-cd6f4ba98377",
                                                "text": "Die Schlusssteine der Fensterbögen an der Außenfassade bilden Rinderschädel, die durch die Verwitterungen wie angefressen und noch unheimlicher wirken."
                                            },
                                            {
                                                "example_id": "df2ea123-6b98-46d2-9c80-f71de8134897",
                                                "sense_id": "02314382-abc3-35a7-bd5d-cd6f4ba98377",
                                                "text": "Die Herstellung eines solchen Gerüstes aus Holz stellt erhebliche Anforderungen an die handwerklichen Fähigkeiten der Zimmerleute, denn das gesamte Gewicht des Steinmaterials muss bis zu dem Moment in dem der Schlussstein gesetzt wird vom Gerüst getragen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "97578d34-2c5f-3ccf-86bb-1eb88de97054",
                                        "entry_id": "80e09e6e-8d30-300e-a02f-3badab35883c",
                                        "glosses": [
                                            "eine Aktion oder eine Tatsache, die einen Abschluss oder eine Vollendung bedeutet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05acd9f6-f792-488d-ab0e-ef793b8d0243",
                                                "sense_id": "97578d34-2c5f-3ccf-86bb-1eb88de97054",
                                                "text": "Das geisterhafte Teilchen [das Higgs-Boson] zu finden wäre der größte Triumph der Teilchenphysik: der Schlussstein des Standardmodells."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
