                ],
                "senses": [
                    {
                        "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                        "entry_id": "b8575c01-c8b7-32b7-b4b1-3b5f7aa9b120",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b4de92-5d51-4371-bdbb-383628a94410",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Frau Giebert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "81f142fa-c86c-49fc-bb21-20680772ed6f",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Herr Giebert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e70d45d6-03fe-4467-9197-9cf027c45f02",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Die Gieberts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a8e548f6-7f7f-426f-a382-91c6dd699bb5",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Der Giebert trägt nie die Schals, die die Giebert ihm strickt."
                            },
                            {
                                "example_id": "da8ca55c-f916-47a1-8723-b21cf5035283",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giebert kommt, geht der Herr Giebert.“"
                            },
                            {
                                "example_id": "47966385-00ba-42e5-995d-e811d0df059d",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Giebert kommt und geht."
                            },
                            {
                                "example_id": "8c4a007a-4075-48c9-aba9-ea1598e11511",
                                "sense_id": "d0aeaff7-e5cb-3c06-850d-a465a3b4fe6c",
                                "text": "Gieberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
