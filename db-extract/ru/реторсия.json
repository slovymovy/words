                                    {
                                        "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                        "entry_id": "4ac25def-a252-3e42-afe6-e2a7d8f39507",
                                        "glosses": [
                                            "Maßnahme, die sich gegen etwas richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf68cea0-73dd-480f-b206-566dbba9396c",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "Alle getroffenen Gegenmaßnahmen haben nicht ausgereicht, um das Unglück zu verhindern."
                                            },
                                            {
                                                "example_id": "1b01ab7d-c8f7-48e5-ba2b-ffe64ff720ac",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "„Und welche Strategien und Gegenmaßnahmen hält die Weltraummedizin bereit, um die Gesundheit von Raumfahrern bei Reisen zum Mars bestmöglich zu schützen?“"
                                            },
                                            {
                                                "example_id": "36eb8e50-4a9f-452c-a4be-16367d5d27ef",
                                                "sense_id": "4d4aa28d-48f1-300c-a352-02a86be9eda6",
                                                "text": "„Für die Stadtväter der betroffenen Gebiete ergab sich das Problem, Gegenmaßnahmen zu treffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
