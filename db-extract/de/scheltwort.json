                        ],
                        "form": "die Scheltworte"
                    },
                    {
                        "form_id": "c1843096-6c4c-4e3f-a528-286814e828f3",
                        "entry_id": "46a9ddde-8348-347b-85f4-6f30ed81793f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Scheltwörter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                        "entry_id": "46a9ddde-8348-347b-85f4-6f30ed81793f",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person in milder Form kritisiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7146fde-019e-4f0e-a766-4350993f0313",
                                "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                                "text": "„Und doch ist das G e f l ü g e l t e W o r t von dem Schlagwort, worunter ich außer dem synonymen Stichwort diejenigen Schelt-, Spott-, Hohn-, Witz- und Kraftworte auch inbegreife,…offenbar zu unterscheiden.“"
                            },
                            {
                                "example_id": "b32929d2-d07c-4744-bac7-d3a9375be3c2",
                                "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                                "text": "Ladendorf (1906) nennt unter anderen „Dividendenschlucker“ und „Kastengeist“ als Scheltworte:"
                            },
                            {
                                "example_id": "af035abc-c848-4393-9aff-b6c84da7cc5a",
                                "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                                "text": "„Sie entwickelten deshalb keine Unarten und keine Zerstörungslust, nie hörte man ein Scheltwort, und nie wurde ein Kind geschlagen.“"
                            },
                            {
                                "example_id": "530bdada-92d9-4d0c-9a67-b5b9e4003d57",
                                "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                                "text": "„Es will Plattdeutschen und Hochdeutschen einen Einblick in die Vielfalt plattdeutscher Schimpf- und Scheltwörter geben und wird jeden Leser zum Schmunzeln bringen.“"
                            },
                            {
                                "example_id": "7921fa15-d93a-4de1-8ef3-435658f51ba6",
                                "sense_id": "822ab317-584c-33a4-b50f-8527668b9826",
                                "text": "„Gefühlswert besitzen auch diejenigen Wörter, die als Schimpf- und Scheltwörter verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
