                                "example_id": "bb294b18-039a-4fe5-8623-52bce83d0de2",
                                "sense_id": "14600a81-e3fb-3361-a7c9-0d0eed7581aa",
                                "text": "Bono, chanteur légendaire du groupe irlandais U2 publie son autobiographie \"Surrender\" (Fayard)."
