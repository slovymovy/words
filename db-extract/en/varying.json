                    {
                        "translation_id": "fed521c8-cc6b-498d-9a35-35ab9938ab7e",
                        "source_entry_id": "1767e232-775a-3639-9205-1ab0df35f0a0",
                        "source_sense_id": "787cbc25-1461-3c94-bd41-7d4de82ac33b",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "unterschiedlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterschiedlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                        "entry_id": "c7ce3887-529d-373c-9b60-980c87335f65",
                                        "glosses": [
                                            "nach verschiedener Art, auf verschiedene Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24768e7c-ac9e-4e6a-bf5d-94eb4a144852",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "Unter meinen Freunden gibt es ganz unterschiedliche Temperamente."
                                            },
                                            {
                                                "example_id": "2f238476-7df7-40da-b1da-aa65cc2a800c",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„In seiner Zeit bei den Vereinten Nationen hat er die Kunst perfektioniert, die unterschiedlichsten Menschen zum Konsens zu bringen und Gegner einzubinden.“"
                                            },
                                            {
                                                "example_id": "a2399997-89f4-498b-a4e7-c6d59bf33ee3",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„Während der langen Entstehungsgeschichte des Lebens haben sich Millionen unterschiedlicher Spezies entwickelt.“"
                                            },
                                            {
                                                "example_id": "a04da2f3-234f-4a90-9a5b-e2c1681ffb0f",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„Der Vorteil einer progressiven Kapitalsteuer liegt darin, mit den unterschiedlichsten Situationen auf flexible, konsistente, vorhersehbare Weise umgehen zu können, […].“"
                                            },
                                            {
                                                "example_id": "8f2ae793-d08f-4b07-b02a-6ee8a13fa614",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c466e590-2930-48c6-8f4a-a14bfbab7011",
                        "source_entry_id": "1767e232-775a-3639-9205-1ab0df35f0a0",
                        "source_sense_id": "787cbc25-1461-3c94-bd41-7d4de82ac33b",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "verschieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "nicht gleich, andere Eigenschaften habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae64a33-6330-4d1e-9048-3fa293d17620",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "Wir zwei sind sehr verschieden."
                                            },
                                            {
                                                "example_id": "e707d657-92e3-4c6e-bce9-647529ca6318",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "Die beiden Brüder sind charakterlich so verschieden, dass sie verschiedener kaum sein könnten."
                                            },
                                            {
                                                "example_id": "f043420e-395f-4a02-9e65-70f95d374fc6",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "„Man kann nicht sagen, daß eine Vergiftung stets diese und nur diese Erscheinungen aufweist, denn sie äußert sich auf die verschiedenste Weise, aber alle vorhanden gewesenen Erscheinungen lassen sich am ungezwungensten grade durch eine Vergiftung erklären.“"
                                            },
                                            {
                                                "example_id": "f0e2e2e1-8b73-4190-8f37-7e03f553ca8b",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "„Vorrichtungen zum Abgeben von Warnzeichen mit aufeinanderfolgenden, verschieden hohen Tönen dürfen, außer in den in den Abs. 5 und 6 angeführten Fällen, nur mit Bewilligung des Landeshauptmannes angebracht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68bcb9a5-17d9-3a30-a1f6-65638fc5a14f",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "nicht der-/die-/dasselbe, nicht identisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770523d1-2cd7-4be3-982a-3618b6e13064",
                                                "sense_id": "68bcb9a5-17d9-3a30-a1f6-65638fc5a14f",
                                                "text": "„Tyson, der sich rühmte, in einer einzigen Nacht mit 24 verschiedenen Frauen geschlafen zu haben …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82606750-cdb1-3f31-adfe-42709a8f422a",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "mehrere (gleichgültig, ob gleich oder unterscheidbar)"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4612062b-b2a1-4bb6-a064-a9f61e47e5e6",
                                                "sense_id": "82606750-cdb1-3f31-adfe-42709a8f422a",
                                                "text": "Ich habe verschiedene Dinge eingepackt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
