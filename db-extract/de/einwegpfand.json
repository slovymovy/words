                "senses": [
                    {
                        "sense_id": "3b70e6cc-e85c-3353-8383-a2e85accfa88",
                        "entry_id": "d3bb979b-02ac-3441-9d05-46d09c650a61",
                        "glosses": [
                            "auf Einwegverpackungen erhobenes Pfand"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4f072a1d-8487-4185-8e63-eece8eaa0c8f",
                                "sense_id": "3b70e6cc-e85c-3353-8383-a2e85accfa88",
                                "text": "„In unserem nördlichen Nachbarland hat die rot-grüne Regierung unter Gerhard Schröder im Jahr 2003 das Einwegpfand eingeführt, um Mehrwegsysteme zu fördern.“"
                            },
                            {
                                "example_id": "a9eb85f1-ea52-4a28-bae1-9895976c2f28",
                                "sense_id": "3b70e6cc-e85c-3353-8383-a2e85accfa88",
                                "text": "„Das Einwegpfand hat nichts gebracht - der Anteil klassischer Pfandflaschen geht immer mehr zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
