                "senses": [
                    {
                        "sense_id": "428fc758-25d6-3e2d-b9db-d7718bf372c8",
                        "entry_id": "b506b15b-e3e0-3a91-a5ce-84d7abb959f2",
                        "glosses": [
                            "истор. верховный орган судебной и политической власти в Древних Афинах"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76911bc8-4405-3fbd-8e3c-9558736aa30b",
                        "entry_id": "b506b15b-e3e0-3a91-a5ce-84d7abb959f2",
                        "glosses": [
                            "перен. ирон. судилище"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23549e8-eab4-45f2-a540-bdacd6b093dc",
                                "sense_id": "76911bc8-4405-3fbd-8e3c-9558736aa30b",
                                "text": "Я стал понимать, что нет силы, способной изменить тот образ моей личности, который сложился в каком-то наивысшем третейском ареопаге, где решаются людские судьбы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68eda31b-a3e2-4d82-bf30-869ea6ab7545",
                        "source_entry_id": "b506b15b-e3e0-3a91-a5ce-84d7abb959f2",
                        "source_sense_description": "в обоих смыслах",
                        "target_lang_word": "Areopagus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Areopagus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fabe92a4-b9e8-3021-aff9-5193a4a7272d",
                                        "entry_id": "ce052ef8-0ed9-3dd0-a619-21de7682de47",
                                        "glosses": [
                                            "The supreme judicial and legislative council of ancient Athens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe62835-ad14-49ab-aaa1-73073b9774c8",
                                                "sense_id": "fabe92a4-b9e8-3021-aff9-5193a4a7272d",
                                                "text": "When the great emergencies of the state required his presence and attention, he was engaged in conversation with the philosopher Plotinus, wasting his time in trifling or licentious pleasures, preparing his initiation to the Grecian mysteries, or soliciting a place in the Areopagus of Athens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09b656d6-b985-3d55-9a1c-fe200017f3c2",
                                        "entry_id": "ce052ef8-0ed9-3dd0-a619-21de7682de47",
                                        "glosses": [
                                            "A prominent rock outcropping located northwest of the Acropolis in Athens, Greece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b87200ce-13d7-4c5a-9e10-4488d173bfda",
                                                "sense_id": "09b656d6-b985-3d55-9a1c-fe200017f3c2",
                                                "text": "All hands were on deck, all the afternoon, with books and maps and glasses, trying to determine which “narrow rocky ridge” was the Areopagus, which sloping hill the Pnyx, which elevation the Museum Hill, and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
