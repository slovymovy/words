                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c452424-9619-3f94-8e5e-f80eb2e49aff",
                        "entry_id": "31447d12-1510-34a4-9455-e574a7b1aa85",
                        "glosses": [
                            "Mensch, der sich stark mit anthropomorphen Tieren identifiziert oder anderweitig Gefallen an ihnen findet, Anhänger von [1]"
                        ],
                        "tags": [
                            "Selbstbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "be63367e-5302-408b-9887-f7b68c872681",
                                "sense_id": "6c452424-9619-3f94-8e5e-f80eb2e49aff",
                                "text": "Die „Fursuits“ werden unter anderem vom Furry selbst hergestellt und haben mitunter sehr viel Detailreichtum."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17f98fae-56e0-40ce-90fa-b38f1e68eaa2",
                        "source_entry_id": "31447d12-1510-34a4-9455-e574a7b1aa85",
                        "source_sense_id": "a6e4bfde-a438-3905-9387-dc18c0bfaf61",
                        "source_sense_description": "Subkultur von anthropomorphen Tieren",
                        "target_lang_word": "furry fandom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6cab408f-b165-418f-8a6e-c629af2c9860",
                        "source_entry_id": "31447d12-1510-34a4-9455-e574a7b1aa85",
                        "source_sense_id": "6c452424-9619-3f94-8e5e-f80eb2e49aff",
                        "source_sense_description": "Anhänger der Furry-Kultur",
                        "target_lang_word": "furry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9f93db-1c71-360a-aa7e-6128a9114734",
                                        "entry_id": "31ec09b2-a2e7-386d-ac25-b454584be7c7",
                                        "glosses": [
                                            "Covered with fur, or with something resembling fur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8659a6-b8a2-4da9-bf52-5180e6ff3777",
                                                "sense_id": "0a9f93db-1c71-360a-aa7e-6128a9114734",
                                                "text": "His treatment of our furry friends was nothing short of appalling."
                                            },
                                            {
                                                "example_id": "14cd8c1d-7950-4e3a-876c-098d3b61c96f",
                                                "sense_id": "0a9f93db-1c71-360a-aa7e-6128a9114734",
                                                "text": "There were certain cages you felt you had to pass on tiptoe, noting some aged Fellow whispering endearments into a snow-leopardess’s furry ear."
                                            },
                                            {
                                                "example_id": "daa92855-fbac-4015-8a74-b46c11f0bc43",
                                                "sense_id": "0a9f93db-1c71-360a-aa7e-6128a9114734",
                                                "text": "Hard to believe that, until recently, this furriest of floor coverings had been written off as the ultimate home-furnishing faux pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c94483-7319-35ae-a676-2de84b73dc08",
                                        "entry_id": "31ec09b2-a2e7-386d-ac25-b454584be7c7",
                                        "glosses": [
                                            "Resembling or characteristic of fur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f32516-59bd-472d-9e03-d89ed598be38",
                                                "sense_id": "79c94483-7319-35ae-a676-2de84b73dc08",
                                                "text": "a furry texture"
                                            },
                                            {
                                                "example_id": "1bdfe502-6150-436f-a5f5-c5817586af49",
                                                "sense_id": "79c94483-7319-35ae-a676-2de84b73dc08",
                                                "text": "a furry smell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65dd996b-3b4b-3c5f-bade-7e5745b47f96",
                                        "entry_id": "31ec09b2-a2e7-386d-ac25-b454584be7c7",
                                        "glosses": [
                                            "Of or related to the furry fandom or subculture."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "furry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99e3399-cbbc-385c-a1c1-e9c7650d1403",
                                        "entry_id": "8b22afff-0df9-3705-8b5c-138e3a678a45",
                                        "glosses": [
                                            "Someone who identifies with or as an animal character with human-like characteristics (an anthropomorphic animal character)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a245ebc-7722-36f8-b9df-0e75323f48dc",
                                        "entry_id": "8b22afff-0df9-3705-8b5c-138e3a678a45",
                                        "glosses": [
                                            "An anthropomorphic animal character of this kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941be1de-5f81-4d23-b3fc-4892f0b69936",
                                                "sense_id": "8a245ebc-7722-36f8-b9df-0e75323f48dc",
                                                "text": "What percentage of furries are wolves?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                        "entry_id": "8b22afff-0df9-3705-8b5c-138e3a678a45",
                                        "glosses": [
                                            "Any member of the furry fandom or subculture (including those without fursonas)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f2167f-c834-4bf2-b09a-c6bb55705403",
                                                "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                                "text": "The furry had designed an elaborate costume."
                                            },
                                            {
                                                "example_id": "3ae2c839-fd8b-487f-9e9a-dd79babd8a83",
                                                "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                                "text": "Especially interesting in this regard are furries with more than one fursona. […] Consider, for instance, how Muse describes his two fursonas: My two current sonas are a bat and a rabbit."
                                            },
                                            {
                                                "example_id": "e5d72db8-c110-49fc-9d8a-5c6083b0738a",
                                                "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                                "text": "While members of the fandom seem to use \"fandom\" in a formal capacity explicitly to describe particular interest in forms of art, it is also used less formally to refer to all members of the furry community regardless of artistic involvement and commitment to a fursona."
                                            },
                                            {
                                                "example_id": "2b342ba0-3632-4456-914a-d04fafb75cf9",
                                                "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                                "text": "24 per cent of respondents of the 1,011 results did not have a fursona at all. This shows that having a fursona is still in the majority but it opens up questions as to why a significant minority do not have them but still consider themselves a Furry."
                                            },
                                            {
                                                "example_id": "be88ac07-7d1d-48fc-9888-91372cdad190",
                                                "sense_id": "3e1b3f20-7530-3b81-ad0b-a635bc4f13f2",
                                                "text": "Many young people are also reevaluating what once constituted cringe, attributing use of the term to unacknowledged bigotry more than just a rejection of sincerity. Some niche communities, such as furries, anime fans, and fetish groups, who were once mocked on social media, have since amassed cultural power that has launched them into the mainstream."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
