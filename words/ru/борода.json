            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8f8e134-0f90-3be9-8072-67956b9a2614",
                    "sense_definition": "Волосяной покров на нижней части лица.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hair_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У моего дедушки длинная седая <w>борода</w>.",
                            "target_lang_translations": {
                                "en": "My grandfather has a long grey <w>beard</w>.",
                                "fr": "Mon grand-père a une longue <w>barbe</w> blanche."
                            }
                        },
                        {
                            "text": "Он решил отпустить <w>бороду</w> во время отпуска.",
                            "target_lang_translations": {
                                "en": "He decided to grow a <w>beard</w> during his vacation.",
                                "fr": "Il a décidé de se laisser pousser la <w>barbe</w> pendant les vacances."
                            }
                        }
                    ],
                    "common_phrases": [
                        "густая борода",
                        "отпустить бороду",
                        "сбрить бороду",
                        "рыжая борода",
                        "борода лопатой"
                    ],
                    "target_lang_definitions": {
                        "en": "Hair growth on the lower part of the face.",
                        "fr": "Ensemble des poils recouvrant la partie inférieure du visage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beard",
                                "target_lang_sense_clarification": "facial hair"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "barbe",
                                "target_lang_sense_clarification": "poils du visage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af9766cd-0aff-310c-8a16-c85d7324a110",
                    "sense_definition": "Пучок длинной шерсти под мордой у некоторых животных.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "hair_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый козёл сердито тряс своей <w>бородой</w>.",
