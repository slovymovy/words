                        "target_lang_word": "Kämmerchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kämmerchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                        "entry_id": "613f7f6a-cf24-3640-9064-8fc128fd4c0c",
                                        "glosses": [
                                            "kleine Kammer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fba5ec5-ff96-4db9-90b2-fd74b0a218b7",
                                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                                "text": "In seinem Kämmerchen sammelt er seinen Unrat."
                                            },
                                            {
                                                "example_id": "9321f0ed-82a0-4af4-bc51-fceb073f1508",
                                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                                "text": "„Um im Kämmerchen durch die Dachluke den Schloßturm sehen zu können, mußte ich auf die Kommode klettern.“"
                                            },
                                            {
                                                "example_id": "3fa2dc2c-9695-43a8-8329-e3315cfe5e8e",
                                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                                "text": "„Die Rückkehr Secondas ließ auf sich warten, und da der Aufenthalt im Gasthaus Hoffmanns letzte Mittel aufgezehrt hat, mietet er sich mit Mischa in einem möblierten Kämmerchen ein, einer Künstlermansarde im vierten Stock eines Hauses am Alten Markt.“"
                                            },
                                            {
                                                "example_id": "e147f575-b6c3-423e-b916-ea40d1650d4a",
                                                "sense_id": "5ab329c9-b39b-305f-b087-8372eba22c2f",
                                                "text": "„Als ich durch Bettinas Kämmerchen ging, um in mein Zimmer zurückzukehren, und auf ihrem Bett ihre Tasche liegen sah, überkam mich das Verlangen, hineinzublicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f821e1-37bc-4b8b-8e54-6134400564e5",
                        "source_entry_id": "ed8cfd23-f662-3bd4-b85e-8d22df2def8d",
                        "source_sense_id": "0ffe0c39-c278-3245-b306-3763eb3cf2fe",
                        "source_sense_description": "das Kämmerchen, die Abstellkammer",
                        "target_lang_word": "Abstellkammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abstellkammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26691e26-882f-3b53-ac6b-13537d3a49a7",
                                        "entry_id": "efa578fc-2ca7-3b54-b48c-6f91442efed9",
                                        "glosses": [
                                            "ein Raum, in dem man nur selten oder nicht verwendete Gegenstände aufbewahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4994c7-5de9-490e-bf2e-95c00076ad3b",
                                                "sense_id": "26691e26-882f-3b53-ac6b-13537d3a49a7",
                                                "text": "„Die Abstellkammern sind bis zur Decke mit eisernen Schubladen gefüllt, randvoll mit Akten.“"
                                            },
                                            {
                                                "example_id": "114ddb2f-b0e1-4e4d-9eec-3d493fd8818f",
                                                "sense_id": "26691e26-882f-3b53-ac6b-13537d3a49a7",
                                                "text": "„Mittwochs und samstags wird immer geputzt. Die Männer holen morgens den Mopp aus der Abstellkammer, die Kinder werden zum Wischen eingeteilt.“"
                                            },
                                            {
                                                "example_id": "4a8db01b-a954-4837-b72d-32bd69f4f7f8",
                                                "sense_id": "26691e26-882f-3b53-ac6b-13537d3a49a7",
                                                "text": "„Weibliche Künste interessierten dagegen weniger: Handarbeiten erwähnen die Quellen nur selten, die Spinnräder verstaubten meist in den Abstellkammern.“"
                                            },
                                            {
                                                "example_id": "7cf71a8d-ccf5-4b7c-aa04-c12e1821138e",
                                                "sense_id": "26691e26-882f-3b53-ac6b-13537d3a49a7",
                                                "text": "„Die werden einfach im Keller oder in der Abstellkammer gelagert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4114389e-6258-4426-acba-d74e31f0fe59",
                        "source_entry_id": "ed8cfd23-f662-3bd4-b85e-8d22df2def8d",
                        "source_sense_id": "0ffe0c39-c278-3245-b306-3763eb3cf2fe",
                        "source_sense_description": "das Kämmerchen, die Abstellkammer",
                        "target_lang_word": "Kabuff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabuff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                        "entry_id": "0d80aa17-5c22-3872-be85-4d335688662c",
                                        "glosses": [
                                            "kleiner dunkler Nebenraum, Abstellraum oder winziges Zimmer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee389eb-8103-47cb-8fd3-0c110d063d48",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "„Wenn ich mein winziges Kabuff von Büro in Midtown Manhattan wirklich einmal verließ, dann, um mich in meinen Zufluchtsort zurückzuziehen, meine Wohnung im Erdgeschoss eines schiefen, weißen, über und über mit Efeu bewachsenen Sandsteinhauses in Cobble Hill, Brooklyn.“"
                                            },
                                            {
                                                "example_id": "6b0a046b-6238-4b15-97bd-e6a5fe367df3",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "Hol doch schon mal die Koffer aus dem Kabuff."
                                            },
                                            {
                                                "example_id": "33f1102f-558c-41ab-b224-898e979444dd",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "Wer ein Kabuff hat, der kann sich freuen. Wer allerdings in einem Kabuff wohnt, hat es weniger gut getroffen."
                                            },
                                            {
                                                "example_id": "685655c3-9f04-43ad-baf5-85e03986faf0",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "Wenn sie an ihrem Roman schrieb, saß sie stundenlang in ihrem Kabuff und kam nur dann und wann heraus, um eine neue Tasse Tee zu holen."
                                            },
                                            {
                                                "example_id": "537bbc65-b011-4d20-9d9a-248244ed6a54",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "„Aber Lea war, wenn das Gebrüll erscholl, jedesmal wieder aufgefahren aus federleichtem Schlaf, war über den Flur und durch das Wohnzimmer vor das Kabuff geeilt.“"
                                            },
                                            {
                                                "example_id": "9a2d3d0f-a203-48e5-b43d-d252d83f6b0f",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "„Er redete und dachte in ihrer Sprache, gebrauchte ihr Rotwelsch, nannte die Garderobe ein ›Kabuff‹.“"
                                            },
                                            {
                                                "example_id": "0d0043ba-2ab0-4707-b1fc-1618b83ca735",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "„Am 10. Jänner wird das Geheimnis gelüftet und eine Bar mit dem äußerst originellen Namen Kabuff eröffnet.“"
                                            },
                                            {
                                                "example_id": "67d809c3-5fdd-4dd5-89b0-d7e41ed12e30",
                                                "sense_id": "5641e025-316e-3b8e-8f5b-b30cbd50f2c9",
                                                "text": "„Sie gehört den Japanern, was an sich nichts Besonderes ist. Aber sie wird auch von den Japanern geleitet, was bedeutet, dass alle Programmierer weiße Hemden tragen und pünktlich um acht Uhr morgens anfangen und in kleinen Kabuffs sitzen und an Konferenzen teilnehmen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
