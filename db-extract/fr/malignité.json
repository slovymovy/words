        "fr-extract.jsonl": [
            {
                "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                "word": "malignité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a78f6cf1-89d5-4dea-85d8-781d0016e7ac",
                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "tags": [
                            "plural"
                        ],
                        "form": "malignités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "glosses": [
                            "Disposition à faire du mal à autrui, à en penser, à en dire du mal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ed9a17-4ac6-4ee8-b683-17e0ae8dae41",
                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                "text": "On prétend qu’on est moins malheureux quand on ne l’est pas seul. Mais, selon Zoroastre, ce n’est pas par malignité, c’est par besoin."
                            },
                            {
                                "example_id": "abd52f52-791a-4d1e-b235-7e60f0f4f51b",
                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                "text": "La malignité du siècle, du cœur humain."
                            },
                            {
                                "example_id": "b6c0402f-508d-483a-8074-e1f2e426cd6d",
                                "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                                "text": "La malignité du sort, de la fortune."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "glosses": [
                            "Qualité nuisible, dangereuse que renferme une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa3bacf-396a-4951-a843-d710bf030372",
                                "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                                "text": "Je lui accordai sincèrement tout ce qu'il souhaitait, et je le priai de plaindre la malignité de mon sort, qui me faisait profiter si mal des conseils d'un ami si vertueux."
                            },
                            {
                                "example_id": "e64c6b9a-6db7-40d6-8d0a-2f4f2ec06308",
                                "sense_id": "bf86f163-35ad-3bfd-a5c0-a6e87460f0e8",
                                "text": "Donc, la cessation d'une épidémie ne tient pas à ce que le principe morbifique existant a perdu de sa malignité, mais à l’immunité acquise par la population où elle vient de sévir, combinée avec l’extinction rapide du principe même."
                            }
                        ]
                    },
                    {
                        "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                        "entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "glosses": [
                            "Disposition à plaisanter, à s’égayer aux dépens d’autrui."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "405dcbed-3349-4dc9-9e8d-5669c795dee3",
                                "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                                "text": "Il ne peut s’empêcher d’exercer sa malignité, même sur ceux qui lui sont le plus chers."
                            },
                            {
                                "example_id": "050e05eb-ee6d-4d57-b5d8-4fae20d90f3d",
                                "sense_id": "4713735c-d97c-3585-9532-ae4116b4caca",
                                "text": "Ce fut une revue amusante, une critique pittoresque des mots familiers, des travers et des attitudes de chacun. Encore un usage où l’esprit satirique et la malignité propres au caractère lorrain trouvent leur compte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0bff0d4-b252-419f-a4bb-01e9e3510831",
                        "source_entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "target_lang_word": "fiendishness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiendishness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cdb1cb3-2205-31ab-b9d4-a55f3256b1f3",
                                        "entry_id": "cc67018c-f11d-360a-92e3-03c2d51d7935",
                                        "glosses": [
                                            "The quality of being fiendish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ebb80da-6709-440e-b6e0-a35382165a3a",
                                                "sense_id": "8cdb1cb3-2205-31ab-b9d4-a55f3256b1f3",
                                                "text": "He added, “I didn’t give enough credit to the fiendishness of the C.I.A.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "324ccbd3-3347-4cc2-b513-8375b6b7f0e0",
                        "source_entry_id": "7ae688b2-7d46-32d0-9237-82f84a260db8",
                        "target_lang_word": "malignity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malignity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90ab4d37-6ee0-3675-ac06-5a819188b250",
                                        "entry_id": "3f2f5463-fa95-3b98-9a87-53705bbc0f22",
                                        "glosses": [
                                            "The quality of being malign or malignant; badness, evilness, monstrosity, depravity, maliciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef41e367-f288-46ad-840e-66b02fa0e988",
                                                "sense_id": "90ab4d37-6ee0-3675-ac06-5a819188b250",
                                                "text": "He had some advantage in the difference of our weapons; for his sword, as I recollect, was longer than mine, […] His obvious malignity of purpose never for a moment threw him off his guard, and he exhausted every feint and strategem proper to the science of defence; while, at the same time, he mediated the most desperate catastrophe to our rencounter."
                                            },
                                            {
                                                "example_id": "06588ed3-de5b-4727-bd42-48e67b3d8680",
                                                "sense_id": "90ab4d37-6ee0-3675-ac06-5a819188b250",
                                                "text": "His enjoyment of the spectacle I furnished, as he sat with his arms folded on the table, shaking his head at me and hugging himself, had a malignity in it that made me tremble."
                                            },
                                            {
                                                "example_id": "e64e529d-3177-4a6d-8e69-41d7dfded526",
                                                "sense_id": "90ab4d37-6ee0-3675-ac06-5a819188b250",
                                                "text": "On the door-threshold Mina turned, and her eyes fastened on Woona in concentrated malignity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf8c544-1634-39b1-8848-8464d2542f62",
                                        "entry_id": "3f2f5463-fa95-3b98-9a87-53705bbc0f22",
                                        "glosses": [
                                            "A non-benign cancer; a malignancy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "011d8db2-af35-45c7-a85d-f71d7614b958",
                                                "sense_id": "3cf8c544-1634-39b1-8848-8464d2542f62",
                                                "text": "The absence of any histological sign of malignity in the primary tumor and in the metastases, as observed in our patient, is remarkable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de27cc6-430c-3c30-92a3-90c102b3a648",
                                        "entry_id": "3f2f5463-fa95-3b98-9a87-53705bbc0f22",
                                        "glosses": [
                                            "A group of goblins."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d4fa8a6-e881-4c28-9617-ea5724daa7fa",
                                                "sense_id": "0de27cc6-430c-3c30-92a3-90c102b3a648",
                                                "text": "There was a whole malignity‡ of goblins up on the roof, but if you wanted your clacks to fly fast, you didn’t use the term out loud."
                                            },
                                            {
                                                "example_id": "7a7df9ba-eac3-4747-a2d5-dd3ee8f5d46b",
                                                "sense_id": "0de27cc6-430c-3c30-92a3-90c102b3a648",
                                                "text": "A malignity of goblins chattered loudly, some of them standing on their table."
                                            },
                                            {
                                                "example_id": "fd9228b4-e524-4c35-9546-2471bc834046",
                                                "sense_id": "0de27cc6-430c-3c30-92a3-90c102b3a648",
                                                "text": "As a malignity of goblins giggled drunkenly in a corner booth, Fabian and I approached the table with Isaac and Hakim."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
