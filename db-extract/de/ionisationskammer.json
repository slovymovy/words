                ],
                "senses": [
                    {
                        "sense_id": "417e93b3-3ebc-39d7-8a29-8c8268196300",
                        "entry_id": "10345ade-f438-3b58-b31b-1c2cbe798823",
                        "glosses": [
                            "für Ionisationsvorgänge vorgesehener Raum in einer technischen Anlage in dem Ionisationsgeräte wirken"
                        ],
                        "tags": [
                            "Luft"
                        ],
                        "examples": [
                            {
                                "example_id": "ea30a3df-519b-4501-bdd6-a7b3fbfda4f3",
                                "sense_id": "417e93b3-3ebc-39d7-8a29-8c8268196300",
                                "text": "Die Ionisationskammer in einem Lüftungsgerät ist zumeist eine Leerteil oder die Umluft-/Mischluftkammer in die die Ionisationsgeräte, zur Ionisation der Luft, eingebaut werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e845f5a6-9589-3546-b491-7e919beddeaf",
                        "entry_id": "10345ade-f438-3b58-b31b-1c2cbe798823",
                        "glosses": [
                            "mit Gas befülltes Gerät zum Messen der Strahlungsstärke radioaktiver Stoffe mit Hilfe der von ihnen erzeugten Ionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d12dc51-9b56-462b-93d4-0cd405beb746",
                                "sense_id": "e845f5a6-9589-3546-b491-7e919beddeaf",
                                "text": "„Eine der ältesten Detektoren für ionisierende Strahlen ist die Ionisationskammer.“"
                            },
                            {
                                "example_id": "43ecad26-12a2-4065-a6ee-32047b527275",
                                "sense_id": "e845f5a6-9589-3546-b491-7e919beddeaf",
                                "text": "„Dieses reichert sich in dem Behälter an und kann mit Hilfe eines kleinen Ventilators leicht von dem Thoriumsalz abgetrennt und in die Ionisationskammer geblasen werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ff2965ad-168e-3cf5-a9ec-a45e395a1521",
                        "entry_id": "10345ade-f438-3b58-b31b-1c2cbe798823",
                        "glosses": [
                            "Gerät zur Erzeugung und Nachweis von Röntgenstrahlen; Funktionsweise einer Röntgenröhre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3016309-f896-4345-b834-3b3c4c5c0a5e",
                                "sense_id": "ff2965ad-168e-3cf5-a9ec-a45e395a1521",
                                "text": "„Röntgenstrahlung kann auch in einer Ionisationskammer nachgewiesen werden, wobei hier nur die durch Strahlung erzeugte Ionenmenge gemessen wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "30287e41-acd2-3169-a112-34df45946a26",
                        "entry_id": "10345ade-f438-3b58-b31b-1c2cbe798823",
                        "glosses": [
                            "Kammer, in der Strahlung zu therapeutischen Zwecken erzeugt und gezielt eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87d4d53f-686b-4c6c-8f70-3a1a00697324",
                                "sense_id": "30287e41-acd2-3169-a112-34df45946a26",
                                "text": "„Weitere Untersuchungen wurden angestellt, um eine geeignete Flüssigkeit als sensitives Medium der Ionisationskammer zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
