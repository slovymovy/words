                                        "examples": [
                                            {
                                                "example_id": "0c5b495f-c88c-407d-b0fe-7750b15e2559",
                                                "sense_id": "e1cfa619-e201-3581-9df3-b852429d8921",
                                                "text": "Differential biochemical or physiological characteristics which correlate with aerogenesis at elevated incubation temperatures will be adapted towards a fecal coliform procedure and towards converting a total coliform procedure under development to give a fecal coliform count as well."
                                            }
