                        "sense_id": "aaaeb266-4db3-3e72-96de-955e381951a1",
                        "entry_id": "15549379-5b2c-3131-b9a2-d328fef0c9aa",
                        "glosses": [
                            "Non plausible, qui provoque l’incrédulité."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3a4fd61d-5c50-4485-b5ed-a4580393a89b",
                                "sense_id": "aaaeb266-4db3-3e72-96de-955e381951a1",
                                "text": "(…) mais aussi des facteurs compensatoires empêchant systématiquement ces causes d'affleurer au niveau des phénomènes, est à rejeter: une compensation soutenue et exacte nous paraît intuitivement implausible (…)"
                            },
                            {
                                "example_id": "98ed46e8-26f0-4015-bd80-69dcae0cc9dd",
                                "sense_id": "aaaeb266-4db3-3e72-96de-955e381951a1",
                                "text": "Une telle hypothèse est implausible."
                            },
                            {
                                "example_id": "ad681891-93b9-45cd-9112-9ec5865e0132",
                                "sense_id": "aaaeb266-4db3-3e72-96de-955e381951a1",
                                "text": "Cette allégation, souvent répétée, est implausible."
                            },
                            {
                                "example_id": "119c2248-f8f4-4f04-a946-44d94fab0972",
                                "sense_id": "aaaeb266-4db3-3e72-96de-955e381951a1",
                                "text": "L’assertion qu’il a « confondu une droite avec un objet réel » est implausible eu égard à ce que nous savons de Platon, des géomètres grecs, et d’Aristote lui-même."
                            }
                        ]
                    }
