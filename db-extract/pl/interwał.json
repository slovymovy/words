                                            {
                                                "example_id": "94ef9902-8030-4f6c-a077-c4ecb75cfde7",
                                                "sense_id": "232ec9a6-fb62-3315-bf7f-182450e06639",
                                                "text": "„Die neue Walddörferbahn war den Bahnanbindungen anderer Villensiedlungen in vielerlei Hinsicht überlegen, weil sie als Zweig der Hamburger Hochbahn lästiges Umsteigen vermeiden half und in noch kürzeren Intervallen als die Kleinbahn in die Innenstadt fuhr.“"
                                            },
                                            {
                                                "example_id": "f27b5eea-ca8e-4d94-bada-e7dddf436d4a",
                                                "sense_id": "232ec9a6-fb62-3315-bf7f-182450e06639",
                                                "text": "„Die Busse verkehren pünktlich und in relativ kurzen Intervallen.“"
                                            },
                                            {
                                                "example_id": "1922a8f3-341f-44e5-8835-a70c151bdb96",
                                                "sense_id": "232ec9a6-fb62-3315-bf7f-182450e06639",
                                                "text": "„Von 13 bis 19 Uhr wird das Intervall zwischen Karlsplatz und Aspernstraße von fünf auf drei Minuten und 45 Sekunden verkürzt.“"
                                            },
                                            {
                                                "example_id": "b36462ad-8c37-4ba1-b778-354159c1b6dc",
                                                "sense_id": "232ec9a6-fb62-3315-bf7f-182450e06639",
                                                "text": "„Durch den Einsatz von Wagen mit einem 50 Prozent grösseren Fassungsvermögen lassen sich die Intervalle zwischen den Kursen von 7,5 auf 10 Minuten vergrössern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e086910-5f5f-4b96-b332-9580ac500225",
                        "source_entry_id": "b3924ce1-0893-3950-8af5-2a88e1c1e98e",
                        "source_sense_id": "c90c6cd5-89e6-315c-9b23-b97844107d22",
                        "target_lang_word": "интервал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "интервал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1e069b21-7bb8-3f65-a1eb-006fa5506293",
                                        "entry_id": "2ac6d321-4514-327a-b7c2-32b63448284f",
                                        "glosses": [
                                            "книжн. расстояние, пространство между объектами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1367d6-05b9-4686-8803-06dd0f5bfce6",
                                                "sense_id": "1e069b21-7bb8-3f65-a1eb-006fa5506293",
                                                "text": "Присел у постели, немного взволнованный, одновременно и хмурый, и робкий, стараяся позой владеть: сохранить интервал меж собой и Лизашею."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2c8026-4a52-3e80-a049-638be45aa58e",
                                        "entry_id": "2ac6d321-4514-327a-b7c2-32b63448284f",
                                        "glosses": [
                                            "перерыв, промежуток времени"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af604dd4-8959-444e-a491-ed1c18701656",
                                                "sense_id": "fa2c8026-4a52-3e80-a049-638be45aa58e",
                                                "text": "Из Санкт-Петербурга в сторону Москвы вышли два поезда с интервалом 10 мин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a005c1d-97f7-3df4-b1ec-dd1a7446e04c",
                                        "entry_id": "2ac6d321-4514-327a-b7c2-32b63448284f",
                                        "glosses": [
                                            "муз. разность по высоте между двумя звуками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47e867c-5bed-4ccc-b181-ade283d39ea1",
                                                "sense_id": "2a005c1d-97f7-3df4-b1ec-dd1a7446e04c",
                                                "text": "У нас была такая игра: выбросить звук одновременно, как карту, — каждая свой, и слушать, в какой они сплетаются интервал — терция, секунда, секста."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1f6312-7c78-3c1b-9061-2ab7c43ce906",
                                        "entry_id": "2ac6d321-4514-327a-b7c2-32b63448284f",
                                        "glosses": [
                                            "физ. множество всех значений, заключённых между определёнными границами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e967d63-be29-4328-b953-9bf0f9364365",
                                                "sense_id": "ec1f6312-7c78-3c1b-9061-2ab7c43ce906",
                                                "text": "Они установили, что существует наименее опасный интервал скоростей перемещения груза по поверхности льда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4cc081f-9aaf-3236-840f-f1c41e0dfe21",
                                        "entry_id": "2ac6d321-4514-327a-b7c2-32b63448284f",
                                        "glosses": [
                                            "воен. расстояние между рядами войск, между войсковыми частями, движущимися колоннами и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13423c8c-3855-427d-a23e-80991fe56c1c",
                                                "sense_id": "b4cc081f-9aaf-3236-840f-f1c41e0dfe21",
                                                "text": "Интервал есть военный термин, означающий порожнее место между рядами, шеренгами и пр."
                                            },
                                            {
                                                "example_id": "21a342ec-5ef7-4712-a7dd-3a534dbeadfa",
                                                "sense_id": "b4cc081f-9aaf-3236-840f-f1c41e0dfe21",
                                                "text": "Вступив в интервал между пехотою, взвод остановился и с четверть часа дожидался сбора всей колонны и выезда начальника."
                                            },
                                            {
                                                "example_id": "ce90edf6-7b39-4762-8be6-d0061e74cbd0",
                                                "sense_id": "b4cc081f-9aaf-3236-840f-f1c41e0dfe21",
                                                "text": "Из-за трубачей на серых конях ему виден небольшой интервал между полками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
