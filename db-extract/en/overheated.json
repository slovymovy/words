                "senses": [
                    {
                        "sense_id": "541e57a4-d6b7-305d-bd74-f1df3ec8b3d9",
                        "entry_id": "28962808-cc36-3321-93a9-5bca444bc651",
                        "glosses": [
                            "Excessively heated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21fd3815-72b7-4e8d-8a54-d93dea5d7bf5",
                                "sense_id": "541e57a4-d6b7-305d-bd74-f1df3ec8b3d9",
                                "text": "Been getting tired of my motor running / Feeling overheated 'cause my life keeps coming / My heart has been troubled by the speed of love"
                            },
                            {
                                "example_id": "22b65eaf-66e9-4134-88bc-429d6a44174b",
                                "sense_id": "541e57a4-d6b7-305d-bd74-f1df3ec8b3d9",
                                "text": "He was hooked immediately by the overheated imagery, the overblownness of it all. No writer he read had ever communicated that feeling of an incomprehensible madness."
                            },
                            {
                                "example_id": "ed8c5a96-f083-412f-bfbf-ddc7e27b3e93",
                                "sense_id": "541e57a4-d6b7-305d-bd74-f1df3ec8b3d9",
                                "text": "He finds, not “demigods” but “a combative group of exhausted, drunken, broken, petty, partisan, scheming, squabbling, bloviating, sensory-deprived, underoxygenated, fed-up, talked-out, overheated delegates so distraught they threatened violence, secession."
                            }
                        ]
                    }
