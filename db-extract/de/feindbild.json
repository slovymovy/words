                        ],
                        "form": "das Feindbild"
                    },
                    {
                        "form_id": "94d16790-ce59-4604-b692-d94542131b9c",
                        "entry_id": "f9242b2a-1f8f-3ef4-8383-dc8520fb368c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Feindbilder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                        "entry_id": "f9242b2a-1f8f-3ef4-8383-dc8520fb368c",
                        "glosses": [
                            "vorurteilsbeladenes Konzept eines erklärten Gegners von einer Gruppe von Menschen gleicher Gesinnung oder Ausrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9621685a-eac4-4aa2-80cc-38b1bd58c823",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "Es sind also nicht nur ausgewiesene Nazis, die das Feindbild vom „reichen, parasitären“ Juden weiter verbreiten."
                            },
                            {
                                "example_id": "64e6148f-9020-489e-a26a-178081d7e37d",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„SED und Stasi hatten fast paranoide Angst vor Kritik. Feste Feindbilder und Schwarz-Weiß-Denken prägten ihr Denken.“"
                            },
                            {
                                "example_id": "61d945c1-f5dc-4dae-b073-c836d986e636",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„So wie die damalige Bundeskanzlerin Angela Merkel in der Flüchtlingskrise vor acht Jahren das zentrale Feindbild der AfD war, so sind es Bundeswirtschaftsminister Robert Habeck und die Grünen heute.“"
                            },
                            {
                                "example_id": "04b171b2-0d62-4804-8649-bcfaddc148e9",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Die AfD ist recht erfolgreich darin, in populistischer Manier Feindbilder aufzubauen, „Wir gegen die“, und vermeintlich einfache Lösungen zu präsentieren.“"
                            },
                            {
                                "example_id": "5604ec4d-abb6-40e8-b4d5-28b14730d9af",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Systematisch wurde im Rahmen einer Studie aufgearbeitet, aus welchen Motiven und in welcher Form die Polizei im Rechtsrock zum Feindbild erhoben wird.“"
                            },
                            {
                                "example_id": "1ca0d81a-2921-48c1-8cb7-7b662a4d7c2f",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Die Weltgesundheitsorganisation ist wie so viele andere Staatengemeinschaften ein Feindbild.“"
                            },
                            {
                                "example_id": "25945e39-d85b-45bb-a195-d229f3d80ae5",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Feindbilder sind nicht nur Organisationen, sondern auch konkrete Personen, die für die vermeintliche „Diktatur“ stehen. Bundesgesundheitsminister Karl Lauterbach (SPD) gehört dazu,“ […]."
                            },
                            {
                                "example_id": "ccacebac-5309-4942-af78-15c7aa810c9a",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Als Feindbilder sehen die Grauen Wölfe die kurdische Arbeiterpartei PKK, welche auf einschlägigen Webseiten als „Babymörder“ bezeichnet wird, und jegliche Kurden, welche eine „Gefahr“ für die Türkei darstellen.“"
                            },
                            {
                                "example_id": "424fa906-ab1b-4f97-a64c-4f0c8f482e9d",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Ebenfalls als Feindbilder gelten des Weiteren Juden, Christen, Armenier, Griechen, Kommunisten, Freimaurer, Israel bzw. „Zionisten“, die EU, der Vatikan und die Vereinigten Staaten.“"
                            },
                            {
                                "example_id": "54688c15-ef0b-4f0a-af60-963fa3512208",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Nicht nur in Ostpreußen, auch in Litauen stellten die Soldaten der Roten Armee ein gefürchtetes Feindbild dar.“"
                            },
                            {
                                "example_id": "7df06203-f4da-4f4d-ab07-2cdf94f26d5c",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Wenn die Mehrheit zum Feindbild wird, dann wird das Feindbild uninteressant.“"
                            },
                            {
                                "example_id": "2233a49d-c9cd-4d13-a4c2-ba9467305c98",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Womit täglich im Stundentakt die güllegefüllten Tankwagen über die Ringstraßen der Stadt donnern; was zu Protesten der lärm- und geruchsbelästigten Bevölkerung führt; weshalb Lukas Piontek für viele Leute zum Feindbild geworden ist.“"
                            },
                            {
                                "example_id": "64a3d3a8-6378-45e5-b8c0-026a820506d1",
                                "sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                                "text": "„Manche Vertreter der Friedenspädagogik äußern die Auffassung, es genüge, Vorurteile zu „hinterfragen“ und Feindbilder „abzubauen“, um den Konflikt zwischen Ost und West zum Verschwinden zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3fe6ad5-a9b3-43ea-9eea-8ae9ab46f258",
                        "source_entry_id": "f9242b2a-1f8f-3ef4-8383-dc8520fb368c",
                        "source_sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
