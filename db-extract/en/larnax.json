                "senses": [
                    {
                        "sense_id": "7787e68f-7f69-3214-970d-64282e3185ae",
                        "entry_id": "495ccede-7529-39f8-a206-145695460b63",
                        "glosses": [
                            "A small closed coffin, box or cinerary urn often used as a container for human remains in Ancient Greece."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b0477bbf-11f0-4d1c-a069-034de0731ae2",
                                "sense_id": "7787e68f-7f69-3214-970d-64282e3185ae",
                                "text": "In a chamber tomb at Milatos, Mr. Evans discovered in 1899 a painted larnax or sarcophagus, on which there is figured a great Mycenæan body shield."
                            },
                            {
                                "example_id": "f932858a-5d2b-4ecc-81ca-780b141e26c6",
                                "sense_id": "7787e68f-7f69-3214-970d-64282e3185ae",
                                "text": "The borders found on the sarcophagus also occur in similar positions on the terracotta larnakes."
                            },
                            {
                                "example_id": "84891603-0bff-47bc-bebd-75e839bfc686",
                                "sense_id": "7787e68f-7f69-3214-970d-64282e3185ae",
                                "text": "Burial in larnaxes was first practiced in Crete in the Early Minoan period (EM) and its popularity grew in the Middle Minoan period (MM)."
                            },
                            {
                                "example_id": "32767ebf-2224-47aa-802f-78e17e525759",
                                "sense_id": "7787e68f-7f69-3214-970d-64282e3185ae",
                                "text": "Black painted band on the upper surface of the larnax rim, extended below the rim, both inside and outside."
                            }
                        ]
                    }
                ],
