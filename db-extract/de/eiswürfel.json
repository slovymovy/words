                "senses": [
                    {
                        "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                        "entry_id": "7b106cd6-5622-3f10-947c-1cc2abd65616",
                        "glosses": [
                            "gefrorener Block aus Wasser, zum Kühlen von Getränken oder Wunden verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb7cecb-0fdc-4ac5-af95-cd29dacacc1e",
                                "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                                "text": "Kannst Du mir noch einen Eiswürfel in meinen Drink geben?"
                            },
                            {
                                "example_id": "76f170dd-f1d1-46d9-92d6-712932c9c434",
                                "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                                "text": "„Val fand Joes Idee irgendwie aufregend - wenn auch undurchführbar -, aber Bobby, der sich einen Eiswürfel im Mund hin- und herschob, war nicht so leicht zu überzeugen.“"
                            },
                            {
                                "example_id": "eaad1144-ec8b-4f18-8d2a-ce3c1a8609db",
                                "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                                "text": "„Er nimmt Eiswürfel aus einem silbernen Kühler, er scheint sie sorgsam auszusuchen, und er redet, während er uns den Rücken zuwendet.“"
                            },
                            {
                                "example_id": "b089fc30-8c6c-493c-b1c2-60a0717a9c49",
                                "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                                "text": "„Die Eiswürfel klirrten in seinem Glas.“"
                            },
                            {
                                "example_id": "f1fd8120-5030-4780-934f-43ff0db70252",
                                "sense_id": "fe93b031-d59d-3a91-86be-0bde73b80bce",
                                "text": "„Dann ging er zu einem Eisschrank und zog ein Tablett mit Eiswürfeln hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
