                "senses": [
                    {
                        "sense_id": "db9f3ca0-4e41-3948-b806-55494a90da8d",
                        "entry_id": "19d3c899-ae21-3564-9c1d-55cb5ce3d88b",
                        "glosses": [
                            "Familie der Käfer"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "c3c994de-635c-4b12-a0b0-f11e5f5fb5f6",
                                "sense_id": "db9f3ca0-4e41-3948-b806-55494a90da8d",
                                "text": "„Typische Pflanzenfresser werden mit einer sehr bedeutenden Anzahl verschiedener Arten von der Familie der Blattkäfer (Chrysomelidae) gestellt.“"
                            },
                            {
                                "example_id": "c93fab3f-28ec-43de-8c58-329b83c1d386",
                                "sense_id": "db9f3ca0-4e41-3948-b806-55494a90da8d",
                                "text": "„Das gleiche Isoxazolin-Derivat war bereits aus dem Wehrsekret von einigen Blattkäfer-Arten aus der Familie der Chrysomeliden bekannt [138—141].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86c32a7b-b7be-3a73-bda6-9bb9197d0a0a",
                        "entry_id": "19d3c899-ae21-3564-9c1d-55cb5ce3d88b",
                        "glosses": [
                            "Bezeichnung für einen nicht definierten Vertreter aus der Familie von [1]"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
