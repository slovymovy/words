                        "entry_id": "d61ebe01-1ce0-3d83-8488-dc13064e8d04",
                        "glosses": [
                            "Relatif au yoga."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0af706c-5bb0-4c26-b7a2-28b0613a2c1e",
                                "sense_id": "af27d541-8f2e-300b-a681-ce3511774a29",
                                "text": "Elle permettra de s’essayer aux divers genres de respiration yogiste à l’aide desquels on peut arriver en communication plus intime avec les plans élevés et notamment avec l’astral."
                            }
                        ]
                    }
