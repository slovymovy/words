                                        "sense_id": "d84ba9aa-0b3a-3f36-9a25-978b72f84fc0",
                                        "entry_id": "812b4e80-8463-3809-80f5-ad81e069140b",
                                        "glosses": [
                                            "A biohacker who uses cybernetic implants or biochemicals to enhance or change their own body."
