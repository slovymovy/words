                            "masculine"
                        ],
                        "form": "disjoints"
                    },
                    {
                        "form_id": "16660330-1a56-438d-a725-16451f5ed2ca",
                        "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "disjointe"
                    },
                    {
                        "form_id": "8aa10379-2939-476f-ada2-8f09d99a152e",
                        "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "disjointes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                        "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "glosses": [
                            "Qui n’est plus joint, collé ou rattaché à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21d2e14-b35d-4988-8f90-8588890b672d",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "Et ce jour-là, leurs pierres grises, disjointes, mangées de soleil, mouchetées de lichen, me donnèrent pour la première fois de ma vie l'impression mal définie de la vétusté des choses ; la vague conception des durées antérieures à moi-même, du temps passé."
                            },
                            {
                                "example_id": "3db05199-be9e-42a9-925e-0ba48eeeeb7c",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "Elle voyait de plus en plus clair dans la pièce, que de minces filets de soleil éclairaient, à travers les fentes des vieux volets disjoints."
                            },
                            {
                                "example_id": "da23cff0-6920-4143-88f3-e4be9ca820a7",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "L’autre porte en bois, vermoulue, disjointe, s’encastrait dans les soubassements de cette partie de l’hôtel et ouvrait sur un escalier aboutissant à une cave où l’on avait entassé toutes sortes de vieux meubles inutiles."
                            },
                            {
                                "example_id": "ae172e32-dcfc-4cdc-9af8-24fa97f7f76a",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "Frileuse de sommeil, elle se tenait ce matin sur le perron aux marches disjointes, qui chancellent sous le pas comme les pierres mal assurées qui marquent le gué d’un ruisseau…"
                            },
                            {
                                "example_id": "940e9676-029d-446d-a435-89b6597444a8",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "Le père Morin roule des tonneaux si disjoints, qu’ils ne gardent pas même l’eau de pluie, et il en distribue les cercles aux petits enfants."
                            },
                            {
                                "example_id": "bb89d5c3-53a2-46ac-8cb0-15a257254ac2",
                                "sense_id": "df7759cb-2344-3963-98fb-b0bb6d4d04b1",
                                "text": "Je ne sais pas raccorder ces images à celles que j’ai gardées de l’enfance, au halo jauni dans lequel je les trouve, elles en sont résolument disjointes."
                            }
                        ]
                    },
                    {
                        "sense_id": "80f6c129-eaa5-3d33-8a2c-5c28346ba0cb",
                        "entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "glosses": [
                            "Qui n’ont pas d’élément en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ae0b44-fe5a-4f57-abf7-40a1d4d55a11",
                                "sense_id": "80f6c129-eaa5-3d33-8a2c-5c28346ba0cb",
                                "text": "Une permutation σ se décompose d’une manière unique à l’ordre près en un produit de cycles disjoints commutant entre eux deux à deux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ef255e7-9000-442a-9f71-6f6e67b726fd",
                        "source_entry_id": "d8b50792-cf07-3b2c-9dbc-bb6c8ff3dafb",
                        "target_lang_word": "disjoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disjoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "691a3243-f479-32ff-80d8-29ecc9cb223d",
                                        "entry_id": "06b8add7-60f0-3a51-85bd-8582243068a4",
                                        "glosses": [
                                            "Not smooth or continuous; disjointed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6f97d7-95ae-4c5f-b37c-ce1e28445075",
                                                "sense_id": "691a3243-f479-32ff-80d8-29ecc9cb223d",
                                                "text": "Azure, a chevron disjoint or broken in the head or - BROKMALE. Per fesse gules and sable , a chevron rompu counterchanged - ALLEN, Sheriff of London"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7333fd38-44d8-3c54-9540-c9a44b63dbd5",
                                        "entry_id": "06b8add7-60f0-3a51-85bd-8582243068a4",
                                        "glosses": [
                                            "Of two or more sets, having no members in common; having an intersection equal to the empty set."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "disjoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb6ec8c-fdf7-38d5-9e2b-9e2080974330",
                                        "entry_id": "d116ebcd-ce29-3098-b58d-2fd87c7234a7",
                                        "glosses": [
                                            "To render disjoint; to remove a connection, linkage, or intersection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78bba50-1018-47fd-ab2e-5b6eb1530b02",
                                                "sense_id": "8bb6ec8c-fdf7-38d5-9e2b-9e2080974330",
                                                "text": "Near-synonyms: unjoin; disassemble, take apart"
                                            },
                                            {
                                                "example_id": "a7961372-43ee-4e55-91e6-0cc694bb4156",
                                                "sense_id": "8bb6ec8c-fdf7-38d5-9e2b-9e2080974330",
                                                "text": "to disjoint limbs; to disjoint bones; to disjoint poultry by carving"
                                            },
                                            {
                                                "example_id": "8c79a1fb-2354-45c0-8e2b-8d52a010a2db",
                                                "sense_id": "8bb6ec8c-fdf7-38d5-9e2b-9e2080974330",
                                                "text": "Are there not Poiſons, Racks, and Flames, and Swords; / That Emma thus muſt die by Henry’s Words? / Yet what could Swords or Poiſon, Racks or Flame, / But mangle and disjoint this brittle Frame? / More fatal Henry’s Words; they murder Emma’s Fame."
                                            },
                                            {
                                                "example_id": "d7cfc6d8-de47-41db-a92a-912402904dfb",
                                                "sense_id": "8bb6ec8c-fdf7-38d5-9e2b-9e2080974330",
                                                "text": "As over some half-ruined wall, / Disjointed and about to fall, / Fresh woodbines climb and interlace, / And keep the loosened stones in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094f0a6e-4653-33f0-81e6-ea3be90b6a11",
                                        "entry_id": "d116ebcd-ce29-3098-b58d-2fd87c7234a7",
                                        "glosses": [
                                            "To break the natural order and relations of; to make incoherent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48be6f7e-15cd-4253-bf77-572eb105eff0",
                                                "sense_id": "094f0a6e-4653-33f0-81e6-ea3be90b6a11",
                                                "text": "a disjointed speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87bf8b6e-c99e-3570-a798-3e34d005cc25",
                                        "entry_id": "d116ebcd-ce29-3098-b58d-2fd87c7234a7",
                                        "glosses": [
                                            "To fall into pieces."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84bc3c6b-ed82-41fe-b4c4-fc35a5d0de58",
                                                "sense_id": "87bf8b6e-c99e-3570-a798-3e34d005cc25",
                                                "text": "But let the frame of things dis-ioynt, / Both the Worlds ſuffer, / Ere we will eate our Meale in feare, and ſleepe / In the affliction of theſe terrible Dreames, / That ſhake vs Nightly : Better be with the dead, / Whom we, to gayne our peace, haue ſent to peace, / Then on the torture of the Minde to lye / In reſtleſſe extaſie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
