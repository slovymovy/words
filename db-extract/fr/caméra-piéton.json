                "senses": [
                    {
                        "sense_id": "178e7870-937d-3a43-ad5b-3c54dffb9bd5",
                        "entry_id": "1d5b659e-1090-3680-b940-518ecc1bac8d",
                        "glosses": [
                            "Caméra portée sur la poitrine ou sur l’épaule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab047212-f360-4d61-9983-a030d7e9a6f8",
                                "sense_id": "178e7870-937d-3a43-ad5b-3c54dffb9bd5",
                                "text": "Le 26 octobre, lors d’un comité interministériel délocalisé aux Mureaux (Yvelines) dix ans après les émeutes urbaines, le Premier ministre, Manuel Valls, a annoncé pour début 2016 la généralisation des « caméras-piéton » sur les policiers."
                            },
                            {
                                "example_id": "391d8b46-1157-4562-be48-63fcff78d610",
                                "sense_id": "178e7870-937d-3a43-ad5b-3c54dffb9bd5",
                                "text": "Plusieurs modèles de « caméras-piétons » avaient ainsi été testés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce947f2e-f932-4fb6-ba2c-6d6541662180",
                        "source_entry_id": "1d5b659e-1090-3680-b940-518ecc1bac8d",
                        "source_sense_id": "178e7870-937d-3a43-ad5b-3c54dffb9bd5",
                        "target_lang_word": "body camera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "body camera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "512208c4-5c1d-3192-91a9-69d5ba99ce3c",
                                        "entry_id": "4f0be26a-efea-35de-820a-c6b4537cc64d",
                                        "glosses": [
                                            "A video recording system worn on the body, typically used by law enforcement officers to record their interactions with the public, and gather video evidence at crime scenes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56041a5-2aab-44ba-9ecb-13bf0aa0c657",
                                                "sense_id": "512208c4-5c1d-3192-91a9-69d5ba99ce3c",
                                                "text": "How would we ensure that there are common-sense protections and exceptions for law enforcement officers if they are required to wear body cameras? How would privacy considerations for law enforcement, suspects, and the general public be taken into account in instituting the use of body cameras?"
                                            },
                                            {
                                                "example_id": "bb0d649f-329b-438b-99bc-0683d970e200",
                                                "sense_id": "512208c4-5c1d-3192-91a9-69d5ba99ce3c",
                                                "text": "The Phoenix Police Department began a body camera study in 2013, funded under the Bureau of Justice Assistance Smart Policing Initiative."
                                            },
                                            {
                                                "example_id": "dc0dfb6d-6f7f-45ce-8f96-b2cc752dc0ef",
                                                "sense_id": "512208c4-5c1d-3192-91a9-69d5ba99ce3c",
                                                "text": "The untallied but growing number of people wearing body cameras now includes not just police but also hospital workers and others who aren’t law enforcement officers."
                                            },
                                            {
                                                "example_id": "8ce60d2d-43d8-4c63-9ad9-f36a63ad1509",
                                                "sense_id": "512208c4-5c1d-3192-91a9-69d5ba99ce3c",
                                                "text": "Virgin Trains is to equip station and onboard staff with 250 more body cameras, in a bid to further reduce assaults on its staff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dfe7cda-bc16-4a4f-97a0-a6de7fda4d32",
                        "source_entry_id": "1d5b659e-1090-3680-b940-518ecc1bac8d",
                        "source_sense_id": "178e7870-937d-3a43-ad5b-3c54dffb9bd5",
                        "target_lang_word": "bodycam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bodycam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faf0061e-cd2d-3fa7-bfea-1c63855fcbe7",
                                        "entry_id": "9e150faa-f609-3494-b65e-108a39382d72",
                                        "glosses": [
                                            "A body camera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9b8d53-1774-40f5-8354-3b112b13f614",
                                                "sense_id": "faf0061e-cd2d-3fa7-bfea-1c63855fcbe7",
                                                "text": "I'll wear a bodycam – a copcam, which I'll have to get from the SPD."
                                            },
                                            {
                                                "example_id": "ed786c1a-6167-4de9-8dc6-9cbc81db9965",
                                                "sense_id": "faf0061e-cd2d-3fa7-bfea-1c63855fcbe7",
                                                "text": "The use of bodycams has been mooted for years and the English FA was given permission by the International Football Association Board (IFAB), the body that determines the rules of the game, to begin a trial in February."
                                            },
                                            {
                                                "example_id": "b6ef99d8-1062-4287-8ffb-963b69c11595",
                                                "sense_id": "faf0061e-cd2d-3fa7-bfea-1c63855fcbe7",
                                                "text": "The sheriff’s office released a compilation of bodycam footage Friday from deputies at the scene that shows them handcuffing Earl and pinning him down for more than 20 minutes as he struggles and repeatedly shouts for help."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
