                        "translation_id": "a5b6abd1-9ff9-4b97-bcd5-f200eab94bde",
                        "source_entry_id": "74f8b605-b651-3263-b87b-cececdbf93a9",
                        "source_sense_id": "90c261b9-e1c9-3eff-a10d-7fe74ff93729",
                        "source_sense_description": "Spiel, speziell Computerspiel: Joystick",
                        "target_lang_word": "Joystick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joystick",
