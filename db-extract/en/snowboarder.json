                    },
                    {
                        "translation_id": "efb4aa6a-bed5-4d66-9062-f5af2fa8e11d",
                        "source_entry_id": "7338a73b-bc8e-38a9-a697-edc6efc771a6",
                        "source_sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                        "source_sense_description": "someone who snowboards",
                        "target_lang_word": "Snöber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snöber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                        "entry_id": "c0a477bd-1a9a-31c6-b391-44b92905dc1d",
                                        "glosses": [
                                            "(männliche) Person, die mit einem Snowboard durch den Schnee gleitet; Person, die snowboardet"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71bbfc7a-2ce4-442c-a283-f03cc801d9e8",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Damit will Raichle den höheren Ansprüchen gerecht werden, welche die Snöber heute an das Material stellen.“"
                                            },
                                            {
                                                "example_id": "f12ac77b-c142-4fec-b71f-dcf4cf149d9b",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Neben Tourenfahrern sind es heute immer mehr Variantenfahrer, «Snöber» beispielsweise, die auf frischen Hängen ein besonderes Erlebnis suchen.“"
                                            },
                                            {
                                                "example_id": "4fa90871-384f-41cc-adfb-18b528808a67",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Und wer sich zu den Snöbern zählen will, muss kräftig mittun in der Verballhornung ehemals englischer Ausdrücke. Zur «Uniform» eines Snöbers gehören speziell grosse Schlümpfe, bei denen der Hosenboden knapp oderhalb der Knie angesetzt sein darf.“"
                                            },
                                            {
                                                "example_id": "315dc3c9-233a-4711-b0fb-99fbc74c47d0",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Ansonsten stand ungetrübten Schneefreuden nichts im Weg, was auch für die Snöber und Snöberinnen galt.“"
                                            },
                                            {
                                                "example_id": "8d960c6f-e4ff-4939-9d70-97cc0b4f1c82",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Im Zeitalter der Carver und Snöber sind die Pisten flach und breit geworden.“"
                                            },
                                            {
                                                "example_id": "7aa5d415-caaf-4169-917b-aa0b36fc5323",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Auf Plasmabildschirmen, die überall im Atrium hängen, stürzen sich wagemutige Snöber in die Tiefe, begleitet von sphärischem Trip-Pop-Sound, der aus den Lautsprechern wabert.“"
                                            },
                                            {
                                                "example_id": "2f73cef6-43b9-49a3-86fb-50d4fb601787",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Doch selbst die klirrende Kälte vermochte die Hochstimmung der Pistenflitzer, Snöber und Schneehäschen nicht zu beeinträchtigen.“"
                                            },
                                            {
                                                "example_id": "1acceae5-65ce-4080-85bc-710001dfae41",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Oder hat die Hanf-Initiative die lokale Snowboarder-Community mobilisiert? Besagt das Klischee doch, dass Skifahrer saufen und Snöber kiffen.“"
                                            },
                                            {
                                                "example_id": "2d4cb719-d9bb-4cb4-aed3-af2929412bb7",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Wer als Snöber, Schneeschuhläufer oder Skitourengänger unterwegs ist, sollte sich bewusst sein, dass er damit nicht nur sich selber in Gefahr begibt.“"
                                            },
                                            {
                                                "example_id": "ca3ea1b5-1e40-4783-9488-ab3ccb72493f",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Die Pisten für alle begeisterten Skifahrer, Snöber und Schlittler sind geöffnet.“"
                                            },
                                            {
                                                "example_id": "853e375a-caa3-4ccc-9468-f40b8d1d8bae",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„«Das ist ja ein Wahnsinn», sagt er, während neben ihm ein Snöber einen Backflip produziert.“"
                                            },
                                            {
                                                "example_id": "b914c67a-497d-4ac7-9cf7-34816320753c",
                                                "sense_id": "908e34d2-835a-3e19-b2f0-74cae90cef23",
                                                "text": "„Im Skigebiet St-Luc-Chandolin sind 65 km Pisten präpariert, Snöber vergnügen sich im Snowpark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b554e83-29ff-4d0d-b87a-bf1b25b470c2",
