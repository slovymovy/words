                        "entry_id": "2b9d02dd-3484-32a6-bbd7-f196e2269c3b",
                        "glosses": [
                            "A person who drives an automobile, particularly for commuting."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "850a2bf3-58e1-4ed2-bae3-f3ff3b06bcb3",
                                "sense_id": "835bb9dc-41c2-3a53-b519-bf76fdcc76d8",
                                "text": "Motorcycles can go where cars can’t. Obscure places, remote singletrack trails, off-road tracks too narrow for four wheels – on a bike, you can literally go anywhere and access places no car ever would feeling like an explorer and discovering wild spots off-limits for cagers."
                            }
                        ]
