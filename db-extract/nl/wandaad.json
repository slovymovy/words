                        "target_lang_word": "Untat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                        "entry_id": "38c4b2df-80f2-35d3-877b-356ed5ec1f48",
                                        "glosses": [
                                            "grauenvolle, verwerfliche Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0776524-dfd7-43e6-96bf-78a358d52cbc",
                                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                                "text": "„Sie gingen aufs Forum, und Lucretia berichtete dem Volk von der Untat des Königssohnes.“"
                                            },
                                            {
                                                "example_id": "08e677ed-ebf3-4f14-9652-22ba27f11e7a",
                                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                                "text": "„Und das findet man noch schlimmer als die Untat.“"
                                            },
                                            {
                                                "example_id": "532c9609-cd0d-4c70-92da-12550e195bf8",
                                                "sense_id": "7bd70a3f-f6a7-3e36-8c1a-6e7e788cee98",
                                                "text": "„Gleichwohl muss dem Nachspüren einer nationalen Tragödie – und um eine solche handelt es sich bei der ethnischen Säuberung der ehemaligen Ostgebiete – heute nicht mehr unterstellt werden, damit deutsche Untaten relativieren zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a7f5686-e0ae-4a48-b6a9-dff90e9d1f8e",
                        "source_entry_id": "f9e2ee13-cda4-31ef-b9fd-df6b25d52348",
                        "source_sense_id": "dd418df3-0455-3f37-b904-f74b0a550ae3",
                        "source_sense_description": "een misdaad, een slechte of gruwelijke handeling",
                        "target_lang_word": "misdeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                        "entry_id": "cb81d770-210a-38f3-97a7-abc61ccdb480",
                                        "glosses": [
                                            "That which was done that should not have been, ranging from any sin or moral offense to various degrees of crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d345cc99-bdae-4a40-b3ad-d09ab30d3750",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "The petty misdeeds of his youth came back to haunt him when he ran for political office and his character was smeared."
                                            },
                                            {
                                                "example_id": "7d90b864-53ab-423c-b7d8-aa3803e2a5e0",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "These [putting feet on seats and leaving rubbish behind] are officially among the worst habits revealed by staff working on Northern's trains and at stations. Other bugbears include playing music through loudspeakers, not giving way to passengers getting off the train and actually illegal activities such as fare evasion and vaping in enclosed spaces. The list of misdeeds was released by the operator on March 3 to coincide with Employee Appreciation Day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e69aedd7-b983-4f22-8632-ce26f24c7426",
                        "source_entry_id": "f9e2ee13-cda4-31ef-b9fd-df6b25d52348",
                        "source_sense_id": "dd418df3-0455-3f37-b904-f74b0a550ae3",
                        "source_sense_description": "een misdaad, een slechte of gruwelijke handeling",
                        "target_lang_word": "outrage",
