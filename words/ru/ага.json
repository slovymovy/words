                {
                    "sense_id": "97c62f4a-af9b-3e50-b545-7f36ff2a15de",
                    "sense_definition": "Звук, сопровождающий резкое физическое движение, усилие или смех.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лесоруб с громким «<w>ага</w>» опустил топор на бревно.",
                            "target_lang_translations": {
                                "en": "The lumberjack brought the axe down on the log with a loud \"<w>hah</w>\".",
                                "nl": "De houthakker liet de bijl op de boomstam neerkomen met een luide \"<w>hah</w>\".",
                                "pl": "Drwal z głośnym „<w>ha</w>” opuścił siekierę na kłodę.",
                                "de": "Der Holzfäller ließ die Axt mit einem lauten „<w>ha</w>“ auf den Baumstamm niedersausen.",
                                "fr": "Le bûcheron a abattu sa hache sur la bûche avec un <w>hop</w> sonore.",
                                "it": "Il boscaiolo ha abbassato l'ascia sul tronco con un forte «<w>ah</w>».",
                                "cs": "Dřevorubec s hlasitým „<w>hup</w>“ spustil sekeru na poleno.",
                                "tr": "Oduncu, yüksek bir «<w>ha</w>» sesiyle baltayı kütüğe indirdi.",
                                "es": "El leñador bajó el hacha sobre el tronco con un fuerte «<w>ja</w>».",
                                "zh": "樵夫大喝一声“<w>哈</w>”，把斧头猛地劈向原木。"
                            }
                        },
                        {
                            "text": "Он весело смеялся, выкрикивая «<w>ага</w>, <w>ага</w>».",
                            "target_lang_translations": {
                                "en": "He laughed merrily, shouting \"<w>aha</w>, <w>aha</w>\".",
                                "nl": "Hij lachte vrolijk en riep \"<w>aha</w>, <w>aha</w>\".",
                                "pl": "Śmiał się wesoło, wykrzykując „<w>ha</w>, <w>ha</w>”.",
                                "de": "Er lachte fröhlich und rief „<w>haha</w>, <w>haha</w>“.",
                                "fr": "Il riait joyeusement en criant « <w>ha</w>, <w>ha</w> ».",
                                "it": "Rideva allegramente, gridando «<w>ah</w>, <w>ah</w>».",
                                "cs": "Vesele se smál a vykřikoval „<w>cha, cha</w>“.",
                                "tr": "Neşeyle gülüyor, «<w>ha</w>, <w>ha</w>» diye bağırıyordu.",
                                "es": "Él se reía alegremente, gritando «<w>ja, ja</w>».",
                                "zh": "他开心地笑着，嘴里喊着“<w>哈</w>，<w>哈</w>”。"
                            }
                        }
                    ],
                    "synonyms": [
