                                "example_id": "c6f9656b-b02b-4227-838a-d1edf07db9a1",
                                "sense_id": "7dd37459-6d3b-38c0-b8b8-c81c86eb13b5",
                                "text": "„Sie erlitten dreimal so häufig Krankenhausinfektionen, Schlaganfälle, Herzinfarkte oder Nierenversagen.“"
                            }
