                        "source_sense_id": "b3778e19-c077-339b-a809-8881df9e2712",
                        "target_lang_word": "Zange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e002a632-2841-3d10-81f9-67714689786f",
                                        "entry_id": "3c8f87dd-7a93-3daf-b529-0b73a19d45dd",
                                        "glosses": [
                                            "ein Werkzeug aus zwei ineinandergreifenden Backen, welche nach unten hin für die händische Bedienung als Schenkel verlängert sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d2d59e-0b71-4fa6-ab8b-169b540bbcd6",
                                                "sense_id": "e002a632-2841-3d10-81f9-67714689786f",
                                                "text": "Für diesen Nagel brauche ich mal die Zange."
                                            },
                                            {
                                                "example_id": "56fb0db4-58a4-4610-8a95-a72acf3210f5",
                                                "sense_id": "e002a632-2841-3d10-81f9-67714689786f",
                                                "text": "„Frau Joos stand hinter der Theke und ordnete mit einer silbernen Zange Pralinen in Kristallschalen.“"
                                            },
                                            {
                                                "example_id": "e4a75780-4d11-4e2a-8468-2d21b75e8be4",
                                                "sense_id": "e002a632-2841-3d10-81f9-67714689786f",
                                                "text": "„Lampe, sich seiner Pflicht bewußt, entwindet Papin behutsam die Zaange, um nach den Resten der Scherbe im Topf zu forschen .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "453bf15e-1270-4b81-9890-794da829c27b",
                        "source_entry_id": "8bb5b485-085f-3f2f-8cc5-2a2ae94cc96a",
                        "source_sense_id": "b3778e19-c077-339b-a809-8881df9e2712",
                        "target_lang_word": "клещи",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "клещи",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8b882af-cfd6-3d7c-94b4-901a2a9b9d77",
                                        "entry_id": "cca498c7-f453-345c-bb0a-7d37e78ad438",
                                        "glosses": [
                                            "щипцы для захвата, зажима чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570d88cf-15ce-46e7-add3-35e6a31cddc2",
                                                "sense_id": "f8b882af-cfd6-3d7c-94b4-901a2a9b9d77",
                                                "text": "Берите молотки, берите клещи и зубила, берите всё, что нужно, чтобы расклепать цепи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bed20f4c-ccce-378c-91a7-98a593192053",
                                        "entry_id": "cca498c7-f453-345c-bb0a-7d37e78ad438",
                                        "glosses": [
                                            "перен., воен. манёвр, заключающийся в охвате войск противника одновременно с двух сторон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5b55ae-2683-4e04-8762-959e1029d5de",
                                                "sense_id": "bed20f4c-ccce-378c-91a7-98a593192053",
                                                "text": "Решили: отбивая фронтовые атаки противника, одновременно взять его в клещи с флангов конницей и танками."
                                            },
                                            {
                                                "example_id": "cac01a47-0980-490e-b77b-8cbaea11df61",
                                                "sense_id": "bed20f4c-ccce-378c-91a7-98a593192053",
                                                "text": "Армию ещё можно было спасти, но он не мог отступить без приказа; когда же командующий Северо-Западным фронтом Жилинский отдал этот приказ — за двумя корпусами и пехотной дивизией уже сомкнулись германские клещи…"
                                            }
                                        ]
                                    }
                                ]
                            },
