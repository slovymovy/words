                            {
                                "example_id": "f5babd8e-3dec-42e7-b087-9c9b5e337af2",
                                "sense_id": "da5bc951-eda4-33e7-9632-2f170206058d",
                                "text": "Ontwikkelaars kunnen geld uit het fonds lenen voor bijvoorbeeld grondsanering of het uitkopen van bedrijven die op de locatie gevestigd zijn. Want het bouwen op lastige plekken is een risico voor ontwikkelaars, vaak zijn er hoge kosten mee gemoeid."
                            },
                            {
                                "example_id": "8fd4793b-4e11-43bc-9a13-bf3a57db7987",
                                "sense_id": "da5bc951-eda4-33e7-9632-2f170206058d",
                                "text": "Als de vaten zijn opgeruimd, kan de grondsanering beginnen. Onderzoek moet uitwijzen tot hoe diep de verontreinigde grond afgegraven moet worden."
                            }
                        ]
                    }
