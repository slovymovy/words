                        "examples": [
                            {
                                "example_id": "c6b70ddb-13ec-4353-82c5-5f622d92c404",
                                "sense_id": "45b1d9f4-7327-337e-adf7-37608fc791ba",
                                "text": "Macy Gray hoeft niet veel te doen om aantrekkelijk te zijn. De lange zangeres in haar gouden jurk, met een kroon van afro-haar, en haar expressieve mimiek is bezienswaardig – zeker als ze wordt omringd door vier muzikanten in kostuum en fluorescerend roze pruik. Gray heeft een karakteristieke, zachte stem. Ze koert meer dan ze zingt."
                            },
                            {
                                "example_id": "565c94de-f42c-4c01-ab01-fc7571c4675f",
                                "sense_id": "45b1d9f4-7327-337e-adf7-37608fc791ba",
                                "text": "Ze droeg haar haar niet meer in een vlecht, maar had het laten knippen in een nieuwe coupe, het begin van een afro."
                            }
                        ]
                    }
