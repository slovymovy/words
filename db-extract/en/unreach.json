                        "sense_id": "972ff1cd-66df-3546-88a6-b85a0b033b78",
                        "entry_id": "4e71f575-f5ab-30fb-bc32-bf0e389a5c85",
                        "glosses": [
                            "To fail to reach"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c52f6f84-27b3-49ac-910a-a509525692c7",
                                "sense_id": "972ff1cd-66df-3546-88a6-b85a0b033b78",
                                "text": "To reach the Self, then, one has simply to 'unreach' all objects. The Self is ever-manifest, self-revealing."
                            },
                            {
                                "example_id": "d93bd01d-7eb1-479b-8928-b4391a22b216",
                                "sense_id": "972ff1cd-66df-3546-88a6-b85a0b033b78",
                                "text": "We go over ground that we have traversed many times before, and reach conclusions only to unreach them again, and the whole ends, as usual, in floods of tears and mutual professions of esteem."
                            }
                        ]
                    }
