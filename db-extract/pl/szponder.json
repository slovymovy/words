                "senses": [
                    {
                        "sense_id": "ac9fbb00-504a-332d-976d-162f3dc16b7d",
                        "entry_id": "494dbefa-5b3c-3fea-91fb-37b885739949",
                        "glosses": [
                            "mięso z mięśnia naramiennego bydła, wykrawany z dolnego odcinka żeber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a23d36c-9ce8-4db6-9588-28a2a2775a17",
                                "sense_id": "ac9fbb00-504a-332d-976d-162f3dc16b7d",
                                "text": "Do peklowania najlepsza jest krzyżowa z kwiatem i szponder czyli żeberko"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "29b15bf2-5239-34ea-8997-eb5af7cbe7a1",
                        "entry_id": "494dbefa-5b3c-3fea-91fb-37b885739949",
                        "glosses": [
                            "potrawa ze szpondru (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0441239-5d9c-41c0-888f-c07f6ac6198e",
                                "sense_id": "29b15bf2-5239-34ea-8997-eb5af7cbe7a1",
                                "text": "Teraz dopiero uczuł głód. Po barszczu ze śmietaną zamówił tłusty szponder"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b687714e-39f0-30ac-984a-c565ee96bace",
                        "entry_id": "494dbefa-5b3c-3fea-91fb-37b885739949",
                        "glosses": [
                            "roczny wieprz karmiony na szynkę"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "5a0d6066-b223-30cf-bd9f-2014c142362b",
                        "entry_id": "494dbefa-5b3c-3fea-91fb-37b885739949",
                        "glosses": [
                            "boczek"
                        ],
                        "tags": [
                            "Lviv",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "91b32ce1-46e5-4386-9a53-29ef18cac47e",
                                "sense_id": "5a0d6066-b223-30cf-bd9f-2014c142362b",
                                "text": "Czasami, gdy przy większym natłoku w jatce musiała pomóc przy obsłudze klijentów, umiała zmusić się do krajania polędwicy czy szpondru, ale wątróbki, flaków, czy lekkich nie wzięłaby do ręki za żadne skarby"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
