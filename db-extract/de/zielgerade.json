                                "target_senses": [
                                    {
                                        "sense_id": "5792eb20-94dd-3775-851c-0165c6fdd3f7",
                                        "entry_id": "f9a94dda-7834-3384-9f8b-2cdead93ceef",
                                        "glosses": [
                                            "Synonym of home stretch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8b3ace-1a11-479d-8827-e4fe1ba718b3",
                                                "sense_id": "5792eb20-94dd-3775-851c-0165c6fdd3f7",
                                                "text": "Now, nearly ready to spawn, they are returning to the mouth of the Columbia for the final stretch -- back up the rivers to spawning grounds where they will mate, creating future runs of fall chinook."
                                            },
                                            {
                                                "example_id": "b352b68c-b861-4868-8c58-8223a48387bf",
                                                "sense_id": "5792eb20-94dd-3775-851c-0165c6fdd3f7",
                                                "text": "But her polling data predicted a tight race, so she decided to air a nasty attack piece on her opponent in the final stretch of the campaign."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f33982fa-b00c-4655-b97c-895523cf115a",
                        "source_entry_id": "bb5e83b7-c4e0-3afe-8260-55fcefbcd07e",
                        "source_sense_id": "9ddb9456-3585-32fb-bb30-d5dbb98f9530",
                        "source_sense_description": "Sport: das letzte Teilstück einer Rennbahn vor dem Ziel",
                        "target_lang_word": "dernière ligne droite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dernière ligne droite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c588c1ea-b2c4-3476-92af-c9e473aeee1f",
                                        "entry_id": "50cb5b1b-6097-3348-a891-85bc2f45a604",
                                        "glosses": [
                                            "Dernière partie la plus intense d’une épreuve."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5762407-7d17-4842-b50a-124429c19d6b",
                                                "sense_id": "c588c1ea-b2c4-3476-92af-c9e473aeee1f",
                                                "text": "En dehors du temps nécessaire pour voter le budget de l'an prochain (et à moins de tenir des sessions extraordinaires, ce à quoi les parlementaires rechigneront afin de rester auprès de leurs électeurs dans la dernière ligne droite), il ne reste aux députés que quatre à cinq mois « parlementairement » utiles."
                                            },
                                            {
                                                "example_id": "22ee3721-7744-43a7-9966-b6ba163e7cb8",
                                                "sense_id": "c588c1ea-b2c4-3476-92af-c9e473aeee1f",
                                                "text": "Cette « dernière ligne droite » est souvent celle durant laquelle les tâches sont les plus « concentrées » et sans aucune marge de sécurité : […]."
                                            },
                                            {
                                                "example_id": "615c7291-839d-4c95-b8b0-69d63bb06988",
                                                "sense_id": "c588c1ea-b2c4-3476-92af-c9e473aeee1f",
                                                "text": "Oui assurent ses plus fidèles lieutenants : il était en train de regagner du terrain dans la dernière ligne droite, son positionnement de fin de campagne commençant à faire mouche dans l'opinion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
