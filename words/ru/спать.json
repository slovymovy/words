    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f7f3fa8-7bd1-34dd-ac4c-8a7aee695776",
                    "sense_definition": "Находиться в состоянии сна, отдыхать с закрытыми глазами.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sleep_literal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я очень устал и хочу поскорее лечь <w>спать</w>.",
                            "target_lang_translations": {
                                "en": "I am very tired and want to go to <w>sleep</w> as soon as possible.",
                                "zh": "我太累了，想尽快去<w>睡觉</w>。"
                            }
                        },
                        {
                            "text": "Маленький ребёнок крепко <w>спал</w> в своей кроватке.",
                            "target_lang_translations": {
                                "en": "The small child was <w>sleeping</w> soundly in his crib.",
                                "zh": "小孩子在婴儿床里<w>睡</w>得很香。"
                            }
                        },
                        {
                            "text": "Обычно я ложусь <w>спать</w> не раньше полуночи.",
                            "target_lang_translations": {
                                "en": "Usually I go to <w>sleep</w> no earlier than midnight.",
                                "zh": "我通常午夜之后才<w>睡觉</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "бодрствовать"
                    ],
                    "common_phrases": [
                        "ложиться спать",
                        "крепко спать",
                        "хотеть спать",
                        "долго спать"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a state of sleep, to rest with closed eyes.",
                        "zh": "处于睡眠状态，闭眼休息。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleep",
                                "target_lang_sense_clarification": "general state of rest"
                            },
                            {
                                "target_lang_word": "be asleep",
                                "target_lang_sense_clarification": "state of sleeping"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡觉",
                                "target_lang_sense_clarification": "进入睡眠状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "846c6b6f-b488-369a-9424-31e5bae833e9",
                    "sense_definition": "Иметь половую связь, состоять в интимных отношениях с кем-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intimacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они начали <w>спать</w> вместе через месяц после знакомства.",
                            "target_lang_translations": {
                                "en": "They started <w>sleeping</w> together a month after meeting.",
                                "zh": "他们认识一个月后就开始<w>睡觉</w>了。"
                            }
                        },
                        {
                            "text": "Он никогда не <w>спал</w> с замужними женщинами.",
                            "target_lang_translations": {
                                "en": "He never <w>slept</w> with married women.",
                                "zh": "他从不和已婚女性<w>睡觉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сношаться",
                        "жить"
                    ],
                    "common_phrases": [
                        "спать с кем-то",
                        "перестать спать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have a sexual connection, to be in an intimate relationship with someone.",
                        "zh": "与某人发生性关系，处于亲密关系中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleep with",
                                "target_lang_sense_clarification": "euphemism for sexual intercourse"
                            },
                            {
                                "target_lang_word": "sleep together",
                                "target_lang_sense_clarification": "to have sex"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡觉",
                                "target_lang_sense_clarification": "性交的委婉说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a73c2a-0621-36ef-9ad5-7af8906b80ff",
                    "sense_definition": "Проявлять бездействие, нерасторопность или отсутствие бдительности; быть вялым и пассивным.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вратарь <w>спал</w> на воротах и пропустил лёгкий мяч.",
                            "target_lang_translations": {
                                "en": "The goalkeeper was <w>asleep</w> in the goal and let in an easy ball.",
                                "zh": "守门员在门前<w>睡着</w>了，漏掉了一个简单的球。"
                            }
                        },
                        {
                            "text": "Не <w>спи</w>, а то упустишь свой единственный шанс!",
                            "target_lang_translations": {
                                "en": "Don't <w>sleep</w>, or you'll miss your only chance!",
                                "zh": "别<w>睡着</w>了，不然你会错过唯一的机会！"
                            }
                        }
                    ],
                    "synonyms": [
                        "бездействовать",
                        "тормозить",
                        "вафлю жевать"
                    ],
                    "antonyms": [
                        "бдеть",
                        "суетиться"
                    ],
                    "common_phrases": [
                        "хватит спать",
                        "не спать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "disapproving"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To show inaction, slowness, or lack of vigilance; to be sluggish and passive.",
                        "zh": "表现出不作为、迟钝或缺乏警惕；懒散且被动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be asleep",
                                "target_lang_sense_clarification": "metaphorical: to be inattentive or careless"
                            },
                            {
                                "target_lang_word": "sleep",
                                "target_lang_sense_clarification": "to miss an opportunity due to inaction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡着",
                                "target_lang_sense_clarification": "比喻：注意力不集中或粗心大意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8d50ab8-4a00-3255-9e98-951525d48191",
                    "sense_definition": "Находиться в тишине и неподвижности, в нерабочем состоянии (о природе, местности, технике).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stillness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой вся природа <w>спит</w> под толстым слоем снега.",
                            "target_lang_translations": {
                                "en": "In winter, all nature <w>sleeps</w> under a thick layer of snow.",
                                "zh": "冬天，整个大自然都在厚厚的积雪下<w>沉睡</w>。"
                            }
                        },
                        {
                            "text": "Древний вулкан давно <w>спит</w> и не представляет опасности.",
                            "target_lang_translations": {
                                "en": "The ancient volcano has been <w>sleeping</w> for a long time and poses no danger.",
                                "zh": "这座古老的火山早已<w>沉睡</w>，不再构成威胁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "покоиться",
                        "бездействовать"
                    ],
                    "common_phrases": [
                        "город спит",
                        "лес спит",
                        "природа спит"
                    ],
                    "target_lang_definitions": {
                        "en": "To be silent and motionless, in a non-working state (about nature, terrain, machinery).",
                        "zh": "处于静止和沉默状态，非工作状态（指自然、地形或机器）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleep",
                                "target_lang_sense_clarification": "poetic: of nature or machinery"
                            },
                            {
                                "target_lang_word": "lie dormant",
                                "target_lang_sense_clarification": "of volcanoes or plants"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉睡",
                                "target_lang_sense_clarification": "诗意：指自然界或机器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f2d1e18-c4f0-31e3-bbb7-1bc9ce66be71",
                    "sense_definition": "Быть мёртвым, покоиться в земле.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Герои войны вечно <w>спят</w> в братской могиле.",
                            "target_lang_translations": {
                                "en": "The war heroes <w>sleep</w> eternally in the mass grave.",
                                "zh": "战争英雄们在烈士墓中<w>长眠</w>。"
                            }
                        },
                        {
                            "text": "Пусть он спокойно <w>спит</w> в сырой земле.",
                            "target_lang_translations": {
                                "en": "May he <w>sleep</w> peacefully in the damp earth.",
                                "zh": "愿他在潮湿的土地下安详地<w>长眠</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "покоиться",
                        "спать вечным сном"
                    ],
                    "common_phrases": [
                        "спокойно спать"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "poetic/high style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be dead, to rest in the earth.",
                        "zh": "死亡，安息于地下。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleep",
                                "target_lang_sense_clarification": "poetic/euphemism for death"
                            },
                            {
                                "target_lang_word": "rest",
                                "target_lang_sense_clarification": "euphemism: rest in peace"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长眠",
                                "target_lang_sense_clarification": "诗意/委婉语：指死亡"
                            }
                        ]
                    }
                }
            ]
        }
    ]
