    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35134fb4-660c-369c-b23e-eae8b758c238",
                    "sense_definition": "zeer snel lopen, vaak met een specifiek doel of een bepaalde richting",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de bel ging, begon het kind direct naar de voordeur te <w>hollen</w>.",
                            "target_lang_translations": {
                                "en": "When the bell rang, the child immediately started to <w>run</w> to the front door."
                            }
                        },
                        {
                            "text": "Hij is gisteren heel snel naar huis <w>gehold</w> omdat het begon te regenen.",
                            "target_lang_translations": {
                                "en": "He <w>dashed</w> home very quickly yesterday because it started to rain."
                            }
                        }
                    ],
                    "synonyms": [
                        "rennen"
                    ],
                    "antonyms": [
                        "slenteren",
                        "wandelen"
                    ],
                    "common_phrases": [
                        "naar huis hollen",
                        "naar binnen hollen"
                    ],
                    "target_lang_definitions": {
                        "en": "to run very fast, often with a specific goal or in a certain direction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to move swiftly on foot"
                            },
                            {
                                "target_lang_word": "dash",
                                "target_lang_sense_clarification": "to run a short distance very quickly"
                            },
                            {
                                "target_lang_word": "race",
                                "target_lang_sense_clarification": "to run at full speed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f32c851e-b066-3537-81ad-27c48af1848f",
                    "sense_definition": "zich zeer snel voortbewegen zonder specifieke bestemming of als fysieke inspanning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rennen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen hebben de hele middag in de tuin rond liggen <w>hollen</w>.",
                            "target_lang_translations": {
                                "en": "The children have been <w>running around</w> in the garden all afternoon."
                            }
                        },
                        {
                            "text": "Hij heeft het hele stuk <w>gehold</w> om zijn conditie te verbeteren.",
                            "target_lang_translations": {
                                "en": "He <w>ran</w> the entire way to improve his fitness."
                            }
                        }
                    ],
                    "synonyms": [
                        "rennen",
                        "hardlopen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "hard hollen",
                        "rond hollen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move very quickly without a specific destination or as physical exercise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "to move quickly for exercise or play"
                            },
                            {
                                "target_lang_word": "run around",
                                "target_lang_sense_clarification": "to move about quickly in various directions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c6ff605-c790-3222-9acd-dcecc3658d5d",
                    "sense_definition": "iets hol maken door de binnenkant te verwijderen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uithollen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ambachtsman begon het hout voorzichtig te <w>hollen</w> voor de nieuwe kano.",
                            "target_lang_translations": {
