                        "glosses": [
                            "organisatie die opkomt voor de belangen van boeren die werkzaam zijn in de landbouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3674f52-2534-4eaf-874b-78c1784aed53",
                                "sense_id": "f3b51b66-6d06-3d21-9279-4611792e9244",
                                "text": "\"Boeren, ook schapenhouders, hebben er groot belang bij om hittestress bij hun dieren te voorkomen\", zegt een woordvoerder van landbouworganisatie LTO. \"We roepen onze leden op om te anticiperen op hitte zoals deze.\" LTO benadrukt dat het de betrouwbaarheid van de steekproef van Wakker Dier niet kan beoordelen."
                            },
                            {
                                "example_id": "7db78e7c-4d5c-4e27-99d7-3c6cbfdbf6de",
                                "sense_id": "f3b51b66-6d06-3d21-9279-4611792e9244",
                                "text": "Léon Faassen, bestuurslid van landbouworganisatie LTO Nederland noemt het akkoord van het Europees Parlement in een reactie \"ambitieus\". \"We zien het als een stapje in de goede richting, waarbij boeren en tuinders terecht beloond worden voor de acties die zij ondernemen. Het is goed dat er nu een realistische deal ligt, waarbij de Green Deal met haar hoge doelstellingen niet bekostigd wordt met boerengeld.\""
                            }
                        ]
                    }
