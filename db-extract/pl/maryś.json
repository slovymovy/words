                                "sense_id": "6a593b58-ad16-3d52-9cb6-ee16b8f72130",
                                "text": "Maryś, moja Maryś, cóżeś za niechluja, że przy mojej mamie trzymasz mnie za ramię"
                            },
                            {
                                "example_id": "3340b244-f8bb-46ef-b229-551124ccfacb",
                                "sense_id": "6a593b58-ad16-3d52-9cb6-ee16b8f72130",
                                "text": "Siekiera, motyka, piłka, gwóźdź, / Puść się ze mną, Maryś, puść."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
