                "senses": [
                    {
                        "sense_id": "7248a5f5-efb8-3236-bfbd-3db1552949f6",
                        "entry_id": "23dad4f5-47f4-3dbf-92c4-cc87c5286caa",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff62c7cb-b4bf-4ac8-99e6-2a30adeb0d55",
                                "sense_id": "7248a5f5-efb8-3236-bfbd-3db1552949f6",
                                "text": "Der Ausflug mit Achilleus letzte Woche war großartig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                        "entry_id": "23dad4f5-47f4-3dbf-92c4-cc87c5286caa",
                        "glosses": [
                            "in der griechischen Mythologie ein beinahe unverwundbarer Held der Griechen (Achaier) vor Troja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d39d29a6-a134-4e10-bd58-4c30b486ab31",
                                "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                                "text": "Der Held Achilleus war der Sage nach nur an der Ferse verwundbar."
                            },
                            {
                                "example_id": "03c65816-c878-45a4-bba0-bce085f466cb",
                                "sense_id": "0dc69beb-28f8-3ece-b5ac-d025a5f78694",
                                "text": "„Singe den Zorn, o Göttin, des Peleiaden Achilleus […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19518a22-67ab-43b9-850f-61a4a3d15102",
                        "source_entry_id": "23dad4f5-47f4-3dbf-92c4-cc87c5286caa",
                        "source_sense_id": "7248a5f5-efb8-3236-bfbd-3db1552949f6",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Achilles",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achilles",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                        "entry_id": "187fc4af-e49c-36b6-a257-d12f41171962",
                                        "glosses": [
                                            "A mythical semidivine hero, the son of Peleus by the nereid Thetis, and prince of the Myrmidons, who features in the Iliad as a central character and the foremost warrior of the Achaean (Greek) camp."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a6084a-b7c1-480c-93f3-e6aedf6d3d4a",
                                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                                "text": "Achilles! a drayman, a porter, a very camel."
                                            },
                                            {
                                                "example_id": "35441561-e4f8-4ece-93da-89a1150688e4",
                                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                                "text": "Achilles’ wrath, to Greece the direful spring\nOf woes unnumber’d, heavenly goddess, sing!"
                                            },
                                            {
                                                "example_id": "dbb4ac5b-7792-4a66-9405-d286fe34a672",
                                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                                "text": "If once the lamentation is heard, it will ring out again, of the short-lived Achilles, of the leaf-like change and vicissitude of the human race, of the decay of the heroic age."
                                            },
                                            {
                                                "example_id": "1e012a24-c852-4bd1-8cb0-44b2cd32fa99",
                                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                                "text": "In the last third of the Iliad, Achilles’ beloved companion, Patroklos, and his bitter enemy, Hektor, die wearing Achilles’ armor, their deaths prefiguring Achilles’ own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f94a9c4-40a7-3139-b889-41d864ae1875",
                                        "entry_id": "187fc4af-e49c-36b6-a257-d12f41171962",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbb7665d-2ab6-3d9f-98d2-ed9006102b51",
                                        "entry_id": "187fc4af-e49c-36b6-a257-d12f41171962",
                                        "glosses": [
                                            "The Greek camp Trojan asteroid 588 Achilles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
