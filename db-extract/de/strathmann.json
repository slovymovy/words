                "senses": [
                    {
                        "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                        "entry_id": "d98b715d-54b2-3c2d-bf4f-368f21775d3b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d4b726-1621-48a5-a3f3-de42f67b53a4",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Frau Strathmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9e4d4b35-e4f1-4bc7-b5d2-34de85a56932",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Herr Strathmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe0405e0-39dd-44be-b89e-76b0544a84f5",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Die Strathmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d71b18b1-3615-443d-9c11-1103fcb0f90b",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Der Strathmann trägt nie die Schals, die die Strathmann ihm strickt."
                            },
                            {
                                "example_id": "40f9b3ce-c274-4f73-99c4-bd1501ab044e",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Strathmann kommt, geht der Herr Strathmann.“"
                            },
                            {
                                "example_id": "fea2f75a-7b47-45e2-88da-2ec7ca2512b7",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Strathmann kommt und geht."
                            },
                            {
                                "example_id": "55e2bdd6-ee39-4c1d-af54-8b29116db1f6",
                                "sense_id": "95054e9f-1f3e-3b92-a712-513f865e0a62",
                                "text": "Strathmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
