                "senses": [
                    {
                        "sense_id": "eb194ad2-bd15-36b7-a9db-f49433f5fb86",
                        "entry_id": "b29628f6-0bf4-34a6-bf15-24ec5b1471da",
                        "glosses": [
                            "funkcjonariusz Urzędu Bezpieczeństwa (UB); później także Służby Bezpieczeństwa"
                        ],
                        "tags": [
                            "colloquial",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "f440d3a3-ac0b-4e45-9e89-0d826140cac2",
                                "sense_id": "eb194ad2-bd15-36b7-a9db-f49433f5fb86",
                                "text": "Uważają, że to nie ubek Iksiński ich skrzywdził, lecz władza państwa, którego obywatelami byli i są…"
                            },
                            {
                                "example_id": "ccac80a0-5f9b-48fe-b17d-88bea6dc2291",
                                "sense_id": "eb194ad2-bd15-36b7-a9db-f49433f5fb86",
                                "text": "„Co ty, kurwa, wiesz o zabijaniu?” – to zdanie byłego ubeka, Franza Maurera, odmieniane na dziesiątki sposobów (…) stało się ukochanym cytatem używanym przez młodzież przy lada okazji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
