                "senses": [
                    {
                        "sense_id": "7d848833-3bcd-3b6f-ad0c-5a1aaf623431",
                        "entry_id": "fb787ce9-f283-3033-802c-195c0f543e72",
                        "glosses": [
                            "That which drains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e8675a-7903-4eff-9898-e2ca0212eaf0",
                                "sense_id": "7d848833-3bcd-3b6f-ad0c-5a1aaf623431",
                                "text": "The radical shift in mentality is even more necessary when analysts see Education simply as a drainer of resources."
                            },
                            {
                                "example_id": "7cdf939b-d2f9-40d3-b9a2-8efba154f244",
                                "sense_id": "7d848833-3bcd-3b6f-ad0c-5a1aaf623431",
                                "text": "I know that poor form is one of the biggest drainers of energy, so even though I slowed down significantly I made a very conscious effort to maintain good form."
                            }
                        ]
                    },
                    {
                        "sense_id": "21f628fb-0a71-33d3-b20b-77e49c938dea",
                        "entry_id": "fb787ce9-f283-3033-802c-195c0f543e72",
                        "glosses": [
                            "A frame or rack for allowing washed crockery etc to dry naturally."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c7bde1d4-da26-3394-8c7a-5dd3b311d941",
                        "entry_id": "fb787ce9-f283-3033-802c-195c0f543e72",
                        "glosses": [
