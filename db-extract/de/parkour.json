                        ]
                    },
                    {
                        "translation_id": "a2f89678-f70b-46a9-9796-654183b758b4",
                        "source_entry_id": "67d50750-b063-302f-85a5-4fe17d86769b",
                        "source_sense_id": "8462e3d8-3dfa-33be-b951-5cadef2043a4",
                        "source_sense_description": "Sportart",
                        "target_lang_word": "parkour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parkour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3ccd55-5833-3b02-84d9-d9f7a8d69741",
                                        "entry_id": "8cfde5d0-bbb2-319e-860e-505e63e00a89",
                                        "glosses": [
                                            "An athletic discipline, in which practitioners traverse any environment in the most efficient way possible using their physical abilities, and which commonly involves running, jumping, vaulting, rolling, flipping, and other similar physical movements."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a29d788c-6af0-3225-a886-0f20f5b8c8f9",
                                        "entry_id": "8cfde5d0-bbb2-319e-860e-505e63e00a89",
                                        "glosses": [
                                            "A course in which a player has to step on blocks, each placed almost in front of another block but reachable, following a pattern to the end."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201233ec-48eb-4bbb-8330-0f15b7900e73",
                                                "sense_id": "a29d788c-6af0-3225-a886-0f20f5b8c8f9",
                                                "text": "He was invited to do a parkour competition in Minecraft."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parkour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8497075c-39d7-399e-aaf0-8363da8e2f0f",
                                        "entry_id": "1dcb7d0f-e4b4-38cb-b9f6-958f72ab72d7",
                                        "glosses": [
                                            "To freerun; to use parkour (to move over)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b71826b-b5c6-454c-b773-416f1831c795",
                                                "sense_id": "8497075c-39d7-399e-aaf0-8363da8e2f0f",
                                                "text": "It's about running at 100mph through the world, then parkouring up an exploding cube van that's 100ft in the air, bouncing off it and hitting the wall and keeping on going."
                                            },
                                            {
                                                "example_id": "8dd0930d-d1a5-4ad0-b46c-d3ef5ea42d18",
                                                "sense_id": "8497075c-39d7-399e-aaf0-8363da8e2f0f",
                                                "text": "They had parkoured seven roofs, clambered down a mango tree, and crossed over the bridge in the back of a donkey cart, unnoticed even by the driver."
                                            },
                                            {
                                                "example_id": "e3c7c469-bd45-4835-9dae-141d8ed0555c",
                                                "sense_id": "8497075c-39d7-399e-aaf0-8363da8e2f0f",
                                                "text": "The daring Ukrainian can be found on his website dangling off of tall buildings with one hand, scaling bridges and parkouring through urban landscapes in search of a personal thrill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe85d888-7b56-40e2-9285-5f6344794264",
                        "source_entry_id": "67d50750-b063-302f-85a5-4fe17d86769b",
                        "source_sense_id": "8462e3d8-3dfa-33be-b951-5cadef2043a4",
                        "source_sense_description": "Sportart",
                        "target_lang_word": "parkour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parkour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f2ed623-19b2-3107-bc11-1ce62be527f6",
                                        "entry_id": "8bc1c9a7-3dee-3096-8d11-b33a5d60a6ed",
                                        "glosses": [
                                            "Discipline sportive combinant la course, le saut d’obstacles, l’escalade, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00eff71-11ed-42b9-97cd-9b43b59333e0",
                                                "sense_id": "2f2ed623-19b2-3107-bc11-1ce62be527f6",
                                                "text": "Comme de nombreux subway surfeurs, les Berlin Kidz pratiquent d’autres disciplines urbaines : le parkour (qui consiste à franchir des obstacles urbains et à sauter sur les toits et les murs), le graffiti, le tatouage, le skateboard et l’urbex (la visite de lieux abandonnés, souvent difficiles et interdits d’accès)."
                                            },
                                            {
                                                "example_id": "833400b2-7aca-4fbd-bef0-27aa7136564c",
                                                "sense_id": "2f2ed623-19b2-3107-bc11-1ce62be527f6",
                                                "text": "D’après les dernières informations divulguées, le jeune homme était un adepte de parkour, une discipline qui consiste à utiliser le décor urbain pour réaliser des figures acrobatiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
