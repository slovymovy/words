                            {
                                "example_id": "80b0b34b-e59b-45ee-b507-effc0423ec6c",
                                "sense_id": "db34c0f7-0db0-31ba-96ad-af6a93d23cda",
                                "text": "Bij Leferinks methode worden microstructuren gemengd met stamcellen. De stamcellen kapselen de microstructuren van epoxyhars of polymelkzuur in. Zo ontstaat sterk weefsel dat veel groter is dan tot nu toe mogelijk was."
                            },
                            {
                                "example_id": "fe14ecc2-d4fc-4002-b12a-5a0827344337",
                                "sense_id": "db34c0f7-0db0-31ba-96ad-af6a93d23cda",
                                "text": "Anonieme conservatoren lieten gisteren door de Britse krant The Guardian optekenen dat de baard met een sneldrogende epoxyhars is vastgelijmd."
                            }
                        ]
                    }
                ],
