                        "entry_id": "a8e8ba2b-5f49-3332-81ce-018c6b793ee1",
                        "glosses": [
                            "een kring aangebracht in een touw of band"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd17e510-83d8-4389-81eb-6b977e9b510f",
                                "sense_id": "504430ff-3580-3c92-9f29-6cd49920a85c",
                                "text": "Er zit een lusje aan om het op te kunnen hangen."
                            },
                            {
                                "example_id": "8a69583c-f43d-4f07-bde6-42dda33f9aa8",
                                "sense_id": "504430ff-3580-3c92-9f29-6cd49920a85c",
                                "text": "Toen was het mijn beurt en ik bond een steen aan een lang stuk touw, hield de grote lussen in mijn linkerhand, gaf een harde slinger en liet los."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cb28fbb-6762-3352-bc4c-125d5d47026a",
                        "entry_id": "a8e8ba2b-5f49-3332-81ce-018c6b793ee1",
                        "glosses": [
                            "een seriematige herhaling."
                        ],
                        "tags": [],
                        "examples": [
                            {
