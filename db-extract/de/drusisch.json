                ],
                "senses": [
                    {
                        "sense_id": "add247f2-5b45-3c81-a322-9ac3005934bf",
                        "entry_id": "f68e2dbc-d4ed-3a50-ba6b-6c25ede94cda",
                        "glosses": [
                            "die Drusen betreffend, zu ihnen gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b56d3e5-14d1-41a0-bc59-df32b761ab4b",
                                "sense_id": "add247f2-5b45-3c81-a322-9ac3005934bf",
                                "text": "„Rogers musste an ein libanesisches Sprichwort denken, das ihm ein drusischer Freund beigebracht hatte.“"
                            },
                            {
                                "example_id": "edaba00a-dcf2-4606-9c75-fd62f69770d6",
                                "sense_id": "add247f2-5b45-3c81-a322-9ac3005934bf",
                                "text": "„Da Angehöriger der drusischen und später auch sunnitischen Dynastien dieses Fürstentums, das sich Emirat Libanonberg nannte und von 1516 bis 1840 bestand, immer wieder zur maronitischen Religion übertraten, wuchs der Einfluss der Maroniten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
