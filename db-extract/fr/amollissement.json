                "senses": [
                    {
                        "sense_id": "673be71f-5998-3a37-ac2c-937f16682867",
                        "entry_id": "8303a9a8-40ea-354d-a731-93c3c175e76d",
                        "glosses": [
                            "Action d’amollir ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61b83a2d-f551-4e8b-b040-1dc34b75d656",
                                "sense_id": "673be71f-5998-3a37-ac2c-937f16682867",
                                "text": "L’amollissement de la cire."
                            },
                            {
                                "example_id": "7f6d5627-d51e-49b2-8d5f-67c7923bd074",
                                "sense_id": "673be71f-5998-3a37-ac2c-937f16682867",
                                "text": "— Il se signa deux fois comme un homme qui se méfie de l’amollissement inaccoutumé d’un cœur qui, en de telles occasions, ressemblait en dureté à l’acier de son épée."
                            },
                            {
                                "example_id": "027418d8-d654-4644-8174-5fd214e8e492",
                                "sense_id": "673be71f-5998-3a37-ac2c-937f16682867",
                                "text": "— Elle avait des désirs infinis de bonheur, des tendresses brusques qui la traversaient, des révélations de poésies surhumaines, et un tel amollissement des nerfs et du cœur, qu’elle pleurait sans savoir pourquoi."
                            }
                        ]
                    }
                ],
