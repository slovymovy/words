                                        "entry_id": "fbb72e68-6be7-38e8-a16e-c2d4b0333f27",
                                        "glosses": [
                                            "Of any reddish hue from bright pink to the color of ruddy cheeks in a light-skinned person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04af6889-bc82-4832-b31a-68f61acb7db1",
                                                "sense_id": "770dcb3c-56a8-30e0-8f5c-b17a573aa037",
                                                "text": "If I close my eyes I can see Marie today as I saw her then. Round, rosy face, snub nose, dark hair piled up in a chignon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885007c0-82ca-3b53-935f-243585755148",
                                        "entry_id": "fbb72e68-6be7-38e8-a16e-c2d4b0333f27",
                                        "glosses": [
                                            "Otherwise resembling a rose, as for example in scent of perfume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47fc8f05-232e-3bc5-b9b5-6181d66dff1e",
                                        "entry_id": "fbb72e68-6be7-38e8-a16e-c2d4b0333f27",
                                        "glosses": [
                                            "Optimistic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rosy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f77d67b-cf01-30aa-bd93-4df24fa0f8eb",
