                "senses": [
                    {
                        "sense_id": "0ca86716-2f76-3901-b24e-5c0cf0cae1ab",
                        "entry_id": "32cdba10-6009-3b39-a532-f11395ae39a1",
                        "glosses": [
                            "vom Bundestag beauftragt weibliche Person, die die Wahrung der Grundrechte in der Bundeswehr überwacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11954962-a92d-4266-a6e1-d9a1fe64ba24",
                                "sense_id": "0ca86716-2f76-3901-b24e-5c0cf0cae1ab",
                                "text": "„Claire Marienfeld, Wehrbeauftragte des Deutschen Bundestages, wird am 19. Juni zu einem Besuch in Lübeck erwartet.“"
                            },
                            {
                                "example_id": "09eee281-6df0-4053-aa68-aec7d789ef4b",
                                "sense_id": "0ca86716-2f76-3901-b24e-5c0cf0cae1ab",
                                "text": "„Jedenfalls sind weder im Verteidigungsministerium noch bei der Wehrbeauftragten des Deutschen Bundestages Klagen oder Disziplinarfälle oder gar Gerichtsverfahren in Sachen Anrede bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
