                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "net",
                                "target_lang_sense_clarification": "açık ve kesin"
                            },
                            {
                                "target_lang_word": "belirgin",
                                "target_lang_sense_clarification": "kesinleşmiş, netleşmiş"
                            },
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "şüpheye yer bırakmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8369c142-b990-3b82-888d-7de31967e7ed",
                    "sense_definition": "Такой, который можно точно охарактеризовать или обозначить.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "identifiable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция разыскивает человека без <w>определённого</w> места жительства.",
                            "target_lang_translations": {
                                "tr": "Polis, <w>belirli</w> bir ikametgahı olmayan bir kişiyi arıyor."
                            }
                        },
                        {
                            "text": "Каждая деталь в механизме выполняет свою <w>определённую</w> роль.",
                            "target_lang_translations": {
                                "tr": "Mekanizmadaki her parça kendine özgü <w>belirli</w> bir rolü yerine getirir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "без определённого места жительства"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tam olarak tanımlanabilen veya nitelendirilebilen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "belirli",
                                "target_lang_sense_clarification": "tanımlanmış, kendine has"
                            },
                            {
                                "target_lang_word": "belli",
                                "target_lang_sense_clarification": "saptanmış"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3d5637c-6072-3b01-a0c4-3ccc53ff7ce2",
                    "sense_definition": "Несомненный, безусловный, очевидный.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obvious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В его поведении наметился <w>определённый</w> прогресс, который заметили все учителя.",
                            "target_lang_translations": {
                                "tr": "Davranışlarında tüm öğretmenlerin fark ettiği <w>belirgin</w> bir ilerleme görüldü."
                            }
                        },
                        {
                            "text": "Это был <w>определённый</w> успех для всей нашей молодой научной команды.",
                            "target_lang_translations": {
                                "tr": "Bu, tüm genç bilim ekibimiz için <w>kesin</w> bir başarıydı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "определённый прогресс",
                        "определённый успех"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Şüphe götürmez, kesin, bariz, gözle görülür."
