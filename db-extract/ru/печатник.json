                "senses": [
                    {
                        "sense_id": "2a37d7bb-16a7-3e49-a86c-bbd6af5d4649",
                        "entry_id": "63651383-2f0c-3055-8995-ae438cee1860",
                        "glosses": [
                            "работник полиграфической промышленности, специалист печатного дела"
                        ],
                        "tags": [],
