            "senses": [
                {
                    "sense_id": "5fa0aef4-979a-3d8c-a247-b1d15175cb84",
                    "sense_definition": "Отношение между людьми, имеющими общих предков.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kinship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они подтвердили свое <w>родство</w> с помощью генетического теста.",
                            "target_lang_translations": {
                                "pl": "Potwierdzili swoje <w>pokrewieństwo</w> za pomocą testu genetycznego."
                            }
                        },
                        {
                            "text": "Дальнее <w>родство</w> не помешало им стать близкими друзьями.",
                            "target_lang_translations": {
                                "pl": "Dalekie <w>pokrewieństwo</w> nie przeszkodziło im zostać bliskimi przyjaciółmi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "кровное родство",
                        "близкое родство"
                    ],
                    "target_lang_definitions": {
                        "pl": "Relacja między ludźmi posiadającymi wspólnych przodków; pokrewieństwo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pokrewieństwo",
                                "target_lang_sense_clarification": "ogólne określenie więzi rodzinnych"
                            },
                            {
                                "target_lang_word": "więzy krwi",
                                "target_lang_sense_clarification": "podkreślenie biologicznego charakteru relacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bc7d625-8b00-37f5-b901-98988eec5c0c",
                    "sense_definition": "Сходство или близость по содержанию, свойствам или признакам.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Между этими двумя картинами чувствуется явное духовное <w>родство</w>.",
                            "target_lang_translations": {
                                "pl": "Między tymi dwoma obrazami czuć wyraźne duchowe <w>pokrewieństwo</w>."
                            }
                        },
                        {
                            "text": "Стиль писателя подчеркивает <w>родство</w> его идей с философией классиков.",
                            "target_lang_translations": {
                                "pl": "Styl pisarza podkreśla <w>pokrewieństwo</w> jego idei z filozofią klasyków."
                            }
                        }
                    ],
                    "synonyms": [
                        "сходство",
                        "близость"
                    ],
                    "antonyms": [
                        "различие"
                    ],
                    "common_phrases": [
                        "духовное родство"
                    ],
                    "target_lang_definitions": {
                        "pl": "Podobieństwo lub bliskość pod względem treści, właściwości lub cech."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pokrewieństwo",
                                "target_lang_sense_clarification": "używane w kontekście idei lub cech charakteru"
                            },
                            {
                                "target_lang_word": "bliskość",
                                "target_lang_sense_clarification": "podobieństwo duchowe lub intelektualne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaeb3cde-31e3-38f3-bb35-b767c3133b78",
                    "sense_definition": "Совокупность родственников, родня.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kinship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На свадьбу собралось все многочисленное <w>родство</w> со стороны жениха.",
                            "target_lang_translations": {
                                "pl": "Na wesele zebrała się cała liczna <w>rodzina</w> ze strony pana młodego."
                            }
                        },
                        {
                            "text": "Все <w>родство</w> приехало поздравить юбиляра с праздником.",
                            "target_lang_translations": {
                                "pl": "Cała <w>rodzina</w> przyjechała złożyć jubilatowi życzenia z okazji święta."
                            }
                        }
                    ],
                    "synonyms": [
