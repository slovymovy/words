                            "singular"
                        ],
                        "form": "der Fußnähe"
                    },
                    {
                        "form_id": "89b16216-30b5-4a7f-be95-02b3f1d2eb6d",
                        "entry_id": "b0ddd6d3-7173-31d5-bd47-aa9a28f45720",
                        "tags": [
                            "accusative",
