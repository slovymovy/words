                        "glosses": [
                            "Costume trois pièces."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "74a981a6-17bf-42ad-9ecb-17fdcb4aa7a0",
                                "sense_id": "636a7738-563b-3758-a9a3-1e31ca649b3d",
                                "text": "Il porte un trois-pièces de banquier, une montre enchâssée dans une gourmette en or et des lunettes Ray Ban fantaisie."
                            },
                            {
                                "example_id": "611ab0ad-27d5-42ef-a90e-e8e0484f8b65",
                                "sense_id": "636a7738-563b-3758-a9a3-1e31ca649b3d",
                                "text": "Lui-même portait un trois-pièces anthracite et une cravate qui aurait fait honneur à un membre de la Chambre des Communes."
                            },
                            {
                                "example_id": "21038509-66d0-43a5-b367-bdedd2361e92",
                                "sense_id": "636a7738-563b-3758-a9a3-1e31ca649b3d",
                                "text": "Il est vêtu d’un trois-pièces de serge noire d’une élégance sobre, mais en l’observant mieux, on devine en lui un ancien militaire mal à l’aise dans son costume civil."
                            }
                        ]
                    },
                    {
