                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee371c47-7e46-48c0-847b-6c9e9ad268d5",
                        "entry_id": "0d98cdbd-ea8c-3df4-811e-02daa1c5438d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "acrobatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
                        "entry_id": "0d98cdbd-ea8c-3df4-811e-02daa1c5438d",
                        "glosses": [
                            "Relatif aux acrobates et aux acrobaties, étant physiquement difficile ou dangereux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c245a897-a196-4a1c-adfa-38a58c79a062",
                                "sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
                                "text": "Ce fut ensuite, par les meilleurs danseurs de l’île, une hupahupa d’une virtuosité inouïe, avec des contorsions presque acrobatiques."
                            },
                            {
                                "example_id": "144cf85d-7b14-436b-a5bb-7d8bbeead36e",
                                "sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
                                "text": "Cette démonstration unique dans les annales sera complétée par des exhibitions acrobatiques des deux as de la Djiquitovka, Serge et Michel Pakhomoff, rois de la haute voltige à cheval."
                            },
                            {
                                "example_id": "922a0569-8a52-4609-906c-c4b00b5f2202",
                                "sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
                                "text": "Réaliser des manœuvres acrobatiques sur une voie ouverte à la circulation publique est désormais puni d'une amende forfaitaire de 68 € et d'un retrait de 2 points de permis."
                            },
                            {
                                "example_id": "19003492-4004-493d-b0f9-7f649a7e0a90",
                                "sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
                                "text": "Parfait produit de la boîte scénique à trois dimensions, [Rostand] tente cependant quelque chose. Et c’est l’alexandrin acrobatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef38705e-5c5a-4300-b7c4-c0fd4e5e4eab",
                        "source_entry_id": "0d98cdbd-ea8c-3df4-811e-02daa1c5438d",
                        "source_sense_id": "4d6d83e7-d53e-3cbb-8474-1288af872239",
