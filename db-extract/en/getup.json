                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e408bc-c5a1-493e-b1c4-4f4c4ef7b54c",
                                                "sense_id": "d8e2039d-dcd1-3b93-9389-526cc68cc254",
