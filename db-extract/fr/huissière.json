                                    {
                                        "sense_id": "11dc4009-ab1d-3754-8ce2-bfcf8b3bc999",
                                        "entry_id": "77af923f-4b36-3b26-8b64-1137f7774fb8",
                                        "glosses": [
                                            "A person, in a church, cinema etc., who escorts people to their seats."
                                        ],
