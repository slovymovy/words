                        ],
                        "examples": [
                            {
                                "example_id": "77575440-c14d-4696-9b56-88401bd46e18",
                                "sense_id": "1c5fdf3c-37a1-33d6-8d33-8e9d3c595a11",
                                "text": "Mijn dochter, die van jongs af aan al in de dojo rondloopt, heeft op de middelbare school één keer meegemaakt dat een jongen haar wilde betasten. Met een simpele, maar resolute afwering, heeft ze hem duidelijk gemaakt dit niet meer te doen."
                            }
                        ]
