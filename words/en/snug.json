{
    "word_family": [
        "snugly",
        "snugness",
        "snuggle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34b2ff0d-192c-32f5-b19f-9944e792c919",
                    "sense_definition": "Warm and comfortable; cozy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>snug</w> tucked up in my warm bed.",
                            "target_lang_translations": {
                                "tr": "Sıcak yatağımda <w>rahat</w> bir şekilde kıvrılmış hissediyordum.",
                                "cs": "Cítil jsem se <w>útulně</w>, zachumlaný ve své teplé posteli."
                            }
                        },
                        {
                            "text": "The cat found a <w>snug</w> spot by the fireplace to sleep.",
                            "target_lang_translations": {
                                "tr": "Kedi uyumak için şöminenin yanında <w>sıcak</w> bir yer buldu.",
                                "cs": "Kočka si našla <w>útulné</w> místo u krbu, kde mohla spát."
                            }
                        }
                    ],
                    "synonyms": [
                        "cosy",
                        "comfy",
                        "cozy"
                    ],
                    "common_phrases": [
                        "snug bed",
                        "snug spot"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıcak ve rahat; konforlu.",
                        "cs": "Teplý a pohodlný; útulný."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıcak",
                                "target_lang_sense_clarification": "Sıcak ve konforlu bir ortam için kullanılır."
                            },
                            {
                                "target_lang_word": "rahat",
                                "target_lang_sense_clarification": "Konforlu ve huzurlu bir durum için kullanılır."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "útulný",
                                "target_lang_sense_clarification": "Pro popis příjemného a pohodlného prostředí."
                            },
                            {
                                "target_lang_word": "pohodlný",
                                "target_lang_sense_clarification": "Pro popis stavu komfortu a klidu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071a4376-3f2b-31c7-88a6-74fd64aa2467",
                    "sense_definition": "Close-fitting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jacket has a <w>snug</w> fit around the shoulders.",
                            "target_lang_translations": {
                                "tr": "Ceket omuzlarda <w>tam oturan</w> bir yapıya sahip.",
                                "cs": "Bunda má v ramenou <w>přiléhavý</w> střih."
                            }
                        },
                        {
                            "text": "These boots are a bit too <w>snug</w> for my feet.",
                            "target_lang_translations": {
                                "tr": "Bu botlar ayaklarım için biraz fazla <w>dar</w>.",
                                "cs": "Tyto boty jsou na mé nohy trochu moc <w>těsné</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight-fitting",
                        "form-fitting"
                    ],
                    "common_phrases": [
                        "snug fit"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vücuda tam oturan, dar.",
                        "cs": "Těsně přiléhající, dobře padnoucí."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tam oturan",
                                "target_lang_sense_clarification": "Giysinin vücuda tam uyum sağlaması durumu."
                            },
                            {
                                "target_lang_word": "dar",
                                "target_lang_sense_clarification": "Vücudu saran veya sıkı olan giysiler için kullanılır."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přiléhavý",
                                "target_lang_sense_clarification": "Pro oblečení, které těsně obepíná tělo."
                            },
                            {
                                "target_lang_word": "těsný",
                                "target_lang_sense_clarification": "Pro věci, které jsou až příliš upnuté."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7be63ac-e60a-372b-93ab-211324c2257a",
                    "sense_definition": "Close; concealed; not exposed to notice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spies decided to lie <w>snug</w> until the danger passed.",
                            "target_lang_translations": {
                                "tr": "Casuslar tehlike geçene kadar <w>gizli</w> kalmaya karar verdiler.",
                                "cs": "Špioni se rozhodli zůstat <w>v ústraní</w>, dokud nebezpečí nepomine."
                            }
                        },
                        {
                            "text": "They kept their plans <w>snug</w> from the rest of the team.",
                            "target_lang_translations": {
                                "tr": "Planlarını ekibin geri kalanından <w>gizli</w> tuttular.",
                                "cs": "Své plány udrželi <w>v tajnosti</w> před zbytkem týmu."
                            }
                        }
                    ],
                    "synonyms": [
                        "hidden",
                        "concealed"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gizli, saklı; dikkat çekmeyen.",
                        "cs": "Skrytý, utajený; nenápadný."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gizli",
                                "target_lang_sense_clarification": "Gözlerden uzak veya saklı durumlar için kullanılır."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "skrytý",
                                "target_lang_sense_clarification": "Pro věci nebo osoby, které nejsou vidět."
                            },
                            {
                                "target_lang_word": "v ústraní",
                                "target_lang_sense_clarification": "Pro stav, kdy někdo zůstává mimo pozornost."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f8b7ae0-83c7-3e3c-9e23-3f4536037fdb",
                    "sense_definition": "Satisfactory or adequate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "satisfactory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to earn a <w>snug</w> living from his small shop.",
                            "target_lang_translations": {
                                "tr": "Küçük dükkanından <w>yeterli</w> bir geçim sağlamayı başardı.",
                                "cs": "Ze svého malého obchodu si dokázal zajistit <w>slušné</w> živobytí."
                            }
                        },
                        {
                            "text": "The company reported a <w>snug</w> profit for the fiscal year.",
                            "target_lang_translations": {
                                "tr": "Şirket mali yıl için <w>tatmin edici</w> bir kâr bildirdi.",
                                "cs": "Společnost vykázala za fiskální rok <w>uspokojivý</w> zisk."
                            }
                        }
                    ],
                    "synonyms": [
                        "adequate",
                        "satisfactory"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yeterli, tatmin edici.",
                        "cs": "Uspokojivý nebo dostatečný."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yeterli",
                                "target_lang_sense_clarification": "İhtiyacı karşılayan miktarda veya düzeyde."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dostatečný",
                                "target_lang_sense_clarification": "Pro vyjádření míry, která stačí k pokrytí potřeb."
                            },
                            {
                                "target_lang_word": "slušný",
                                "target_lang_sense_clarification": "Pro vyjádření uspokojivé úrovně příjmu nebo zisku."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82364c58-dc49-3276-a218-af0d97033baa",
                    "sense_definition": "A small, comfortable back room in a pub.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the <w>snug</w> to enjoy our drinks away from the crowd.",
                            "target_lang_translations": {
                                "tr": "Kalabalıktan uzaklaşıp içeceklerimizin tadını çıkarmak için <w>özel odaya</w> oturduk.",
                                "cs": "Seděli jsme v <w>salonku</w>, abychom si užili pití mimo dav."
                            }
                        },
                        {
                            "text": "The pub's <w>snug</w> is the perfect place for a quiet conversation.",
                            "target_lang_translations": {
                                "tr": "Pub'ın <w>özel odası</w> sessiz bir sohbet için mükemmel bir yer.",
                                "cs": "Hospodský <w>salonek</w> je ideálním místem pro tichý rozhovor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British and Irish pubs."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Publarda bulunan küçük, özel ve rahat oda.",
                        "cs": "Malá, útulná zadní místnost v hospodě."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "özel oda",
                                "target_lang_sense_clarification": "Publarda daha sakin ve özel oturma alanı."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "salonek",
                                "target_lang_sense_clarification": "Menší oddělená místnost v restauraci či hospodě."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "247299e7-b7e1-3e7b-a928-9384078b6a8d",
                    "sense_definition": "To snuggle or nestle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy likes to <w>snug</w> against its mother for warmth.",
                            "target_lang_translations": {
                                "tr": "Yavru köpek ısınmak için annesine <w>sokulmayı</w> sever.",
                                "cs": "Štěně se rádo <w>tulí</w> k matce, aby se zahřálo."
                            }
                        },
                        {
                            "text": "She <w>snugged</w> into the blankets on the cold winter night.",
                            "target_lang_translations": {
                                "tr": "Soğuk kış gecesinde battaniyelerin içine <w>sokuldu</w>.",
                                "cs": "Za chladné zimní noci se <w>zachumlala</w> do dek."
                            }
                        }
                    ],
                    "synonyms": [
                        "nestle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sokulmak, kıvrılıp yatmak.",
                        "cs": "Tulit se nebo se přitisknout."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sokulmak",
                                "target_lang_sense_clarification": "Isınmak veya rahat etmek için birine veya bir şeye yakın durmak."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "tulit se",
                                "target_lang_sense_clarification": "Pro vyjádření blízkosti za účelem tepla nebo pohodlí."
                            },
                            {
                                "target_lang_word": "zachumlat se",
                                "target_lang_sense_clarification": "Pro pohodlné usazení se do přikrývek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aff7d020-a71e-3f2d-8fa1-6d0ab4207ab5",
                    "sense_definition": "To make secure or snug.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>snugged</w> the rope to ensure the boat would not drift.",
                            "target_lang_translations": {
                                "tr": "Teknenin sürüklenmemesi için halatı <w>sabitledi</w>.",
                                "cs": "Lano <w>upevnil</w>, aby zajistil, že loď neodpluje."
                            }
                        },
                        {
                            "text": "She <w>snugged</w> her gear into the pack before starting the hike.",
                            "target_lang_translations": {
                                "tr": "Yürüyüşe başlamadan önce ekipmanını çantasına <w>sıkıca yerleştirdi</w>.",
                                "cs": "Před zahájením túry si své vybavení <w>pevně uložila</w> do batohu."
                            }
                        }
                    ],
                    "synonyms": [
                        "secure"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sabitlemek, sıkıca yerleştirmek.",
                        "cs": "Zajistit, upevnit nebo pevně umístit."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sabitlemek",
                                "target_lang_sense_clarification": "Bir şeyi güvenli bir şekilde yerine oturtmak veya bağlamak."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "upevnit",
                                "target_lang_sense_clarification": "Pro bezpečné zajištění předmětu."
                            },
                            {
                                "target_lang_word": "utáhnout",
                                "target_lang_sense_clarification": "Pro zajištění lana nebo popruhu."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}