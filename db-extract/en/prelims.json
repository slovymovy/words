                        "glosses": [
                            "The preliminary front matter of a book; all content preceding the main text or work itself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf7abb4-d602-418d-b3d3-a0d545080168",
                                "sense_id": "50d70275-e240-3070-b1c7-fa263e647b6d",
                                "text": "A book usually consists of three sections: preliminary matter (also called prelims or front matter), the main text, and end matter. All books have some kind of prelims, all have a text, and most works of non-fiction have end matter."
                            }
                        ]
                    },
