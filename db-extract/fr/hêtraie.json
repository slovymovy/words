                                        "entry_id": "165fb95d-fcf3-304d-9f69-5f890bbecc46",
                                        "glosses": [
                                            "Wald, der vorwiegend aus Buchen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf8eebb-238b-451a-ba67-44efd6f6d94e",
                                                "sense_id": "490eccbc-38d5-3560-b2fe-cc29bdb83839",
                                                "text": "Oben im Buchenwald gibt es eine alte Holzhütte."
                                            },
                                            {
                                                "example_id": "4700357c-b821-45b4-a616-9a3bb41d3c0d",
                                                "sense_id": "490eccbc-38d5-3560-b2fe-cc29bdb83839",
                                                "text": "„Drüben stieg ein dünner Buchenwald an.“"
