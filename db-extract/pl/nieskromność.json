                        "target_lang_word": "immodestie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immodestie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a37fb18-58c0-38c8-80b8-47961339b058",
                                        "entry_id": "e49f7158-fd23-3b50-823a-08c89ca9cc89",
                                        "glosses": [
                                            "Manque de modestie, de bienséance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e564b8-0ebe-4c5b-823b-0b867be2cbb5",
                                                "sense_id": "0a37fb18-58c0-38c8-80b8-47961339b058",
                                                "text": "Plus grand et plus large d’épaules que mon moi européen, l’Américain pèse 6 kilos de plus, vit au grand air, ne craignant pas l’alcool et plein d’immodestie."
                                            },
                                            {
                                                "example_id": "c961d03b-c23a-47fa-8fc8-8654686b16ca",
                                                "sense_id": "0a37fb18-58c0-38c8-80b8-47961339b058",
                                                "text": "C’est une chose honteuse que l’immodestie de la plupart des chrétiens à l’église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c48a279-01d2-3d71-bad4-a291423ec090",
                                        "entry_id": "e49f7158-fd23-3b50-823a-08c89ca9cc89",
                                        "glosses": [
                                            "Manque de pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac2740e3-1339-4f00-827b-381831233d70",
                                                "sense_id": "2c48a279-01d2-3d71-bad4-a291423ec090",
                                                "text": "L’immodestie des regards."
                                            },
                                            {
                                                "example_id": "9d7a1060-769f-404b-afa7-12932cc2f346",
                                                "sense_id": "2c48a279-01d2-3d71-bad4-a291423ec090",
                                                "text": "L’immodestie dans la manière de s’habiller."
                                            },
                                            {
                                                "example_id": "a5473917-f27a-469d-9c63-59c4c8b8a662",
                                                "sense_id": "2c48a279-01d2-3d71-bad4-a291423ec090",
                                                "text": "Aujourd’hui, en pays de nègres, une figure nue, noire s’entend, n’effarouche point la pudeur. En Italie, de chaque tas de décombres sortaient des dieux et des déesses qu’il fallait admirer malgré leur immodestie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
