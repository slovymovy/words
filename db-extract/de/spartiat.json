                "senses": [
                    {
                        "sense_id": "0a0c326b-44d1-36b7-8b1c-289d44266ef7",
                        "entry_id": "0e1f2d97-a7f6-352a-a8ee-5503010c2d95",
                        "glosses": [
                            "vollberechtigter Bürger Spartas"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1a7ffe92-1d12-4b28-b6db-506a299b6771",
                                "sense_id": "0a0c326b-44d1-36b7-8b1c-289d44266ef7",
                                "text": "„Zur Sicherung der Herrschaft über Lakonien wurde jeder Spartiat benötigt: Dafür waren die Spartiaten von jeglicher Arbeit befreit, dies um den Preis der konsequenten Militarisierung ihres ganzen Lebens.“"
                            },
                            {
                                "example_id": "7ef97c27-9dad-4f3a-8183-51bf1957d388",
                                "sense_id": "0a0c326b-44d1-36b7-8b1c-289d44266ef7",
                                "text": "„Die Aussage, dass Spartiaten ihren Posten nicht verlassen dürfen und auf diesem bis zum Tod kämpfen, ist eines der tragenden Elemente bei der Konstruktion spartanischen Heldentums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "543aa765-0691-4be4-b26b-4ab5955846bc",
                        "source_entry_id": "0e1f2d97-a7f6-352a-a8ee-5503010c2d95",
                        "source_sense_id": "0a0c326b-44d1-36b7-8b1c-289d44266ef7",
                        "source_sense_description": "historisch: vollberechtigter Bürger Spartas",
                        "target_lang_word": "Spartiate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spartiate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                        "entry_id": "ec565c79-5011-373f-b37c-ec27f366413d",
                                        "glosses": [
                                            "A Spartan, especially a full citizen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e546ec-e657-42f9-9c23-7a13e3e5f77f",
                                                "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                                "text": "And this is a copie of the epiſtles, that the Spartiates ſent."
                                            },
                                            {
                                                "example_id": "9a2b1907-747b-470f-9905-816d63a4566e",
                                                "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                                "text": "Aristotle recognises only one thousand families of the ancient Spartiates; […]"
                                            },
                                            {
                                                "example_id": "b48dda43-f3a7-4e46-b22b-e980164cccc7",
                                                "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                                "text": "Other Spartiates commanded troops, but only a king or his regent could normally lead out the Spartan army and the forces of the Peloponnesian League."
                                            },
                                            {
                                                "example_id": "5e4f2a8d-64f5-46bb-83fb-bf51dcf9282a",
                                                "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                                "text": "Inside, the Spartiates interrupted a tense family drama. Although the voices fell silent at the approach of the two Spartiates, they came into the kitchen to find Chryse in tears, Melissa looking self-righteous, Pelopidas looking beaten, and Laodice and Polychares both angry, while poor Kleon tried to make himself invisible in a corner."
                                            },
                                            {
                                                "example_id": "3da6bc0a-2aca-4d66-b34e-a922f0b703f6",
                                                "sense_id": "df255135-36af-3f0c-b0cc-c316148c07dd",
                                                "text": "Every year Sparta would formally declare war on its neighbor so that any Spartiate (as full citizens were called—only the child of two Spartiates might become one) could commit murder legally; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
