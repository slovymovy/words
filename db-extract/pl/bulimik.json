                "senses": [
                    {
                        "sense_id": "515af5b4-19be-3ff4-a3cb-473b206d9823",
                        "entry_id": "20ea3986-759b-3ed2-91ab-bff6697ff737",
                        "glosses": [
                            "mężczyzna cierpiący na bulimię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f41c995-0415-4a15-944d-0f6d9388c382",
                                "sense_id": "515af5b4-19be-3ff4-a3cb-473b206d9823",
                                "text": "Zazwyczaj w wyniku terapii osoba uzależniona od jedzenia jest cyklicznie i bulimikiem, i anorektykiem. Także inne uzależnienia – od jedzenia, ćwiczeń, zakupów lub pracy każą poszukiwać innych przyczyn nałogu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d430b7f2-1fb8-4b7a-84a2-2f14429f242e",
                        "source_entry_id": "20ea3986-759b-3ed2-91ab-bff6697ff737",
                        "source_sense_id": "515af5b4-19be-3ff4-a3cb-473b206d9823",
                        "target_lang_word": "bulimic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulimic",
