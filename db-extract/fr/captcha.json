                        "examples": [
                            {
                                "example_id": "a7b77c81-2165-4be0-a0ee-6cdd6f3f11ff",
                                "sense_id": "ab8d2159-3ccb-3eb3-894f-7a32dc5e8939",
                                "text": "Au moment de la signature, aucun code d'identification veillant à écarter les robots spammeurs ne nous a été demandé. L'absence de ce test de vérification, appelé \"captcha\", fait que \"n'importe qui peut automatiser le remplissage de ce formulaire, gonflant ainsi le chiffre artificiellement\", estime le chercheur en cybersécurité Baptiste Robert, joint par franceinfo."
                            }
                        ]
