    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "eb27fc43-b9aa-3b1f-8e7e-e74afb4ff21a",
                "word": "overbow",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a215adfd-2cb1-38aa-a0b5-8c80ff86f8fb",
                        "entry_id": "eb27fc43-b9aa-3b1f-8e7e-e74afb4ff21a",
                        "glosses": [
                            "Extending beyond the bow (front of a ship)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "38c72fce-cf78-4315-a7f8-b93f8a379bd1",
                                "sense_id": "a215adfd-2cb1-38aa-a0b5-8c80ff86f8fb",
                                "text": "It has a lifting capacity of 2000 short tons with fixed boom in overbow position."
                            },
                            {
                                "example_id": "fb42679f-98fa-4b40-b8f3-8bd3762f095f",
                                "sense_id": "a215adfd-2cb1-38aa-a0b5-8c80ff86f8fb",
                                "text": "MIBSPA claims that every type of offshore system can utilise the MIB coupling including submerged and floating hoses, overbow and integration into a specific manufacturer's system."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
