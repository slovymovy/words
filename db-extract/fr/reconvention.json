                "senses": [
                    {
                        "sense_id": "272c4907-a3a3-390d-acdc-1e4a922bd774",
                        "entry_id": "56fc4dcd-3ce1-3890-bd2b-0a66b5277b89",
                        "glosses": [
                            "Action, demande que l’on forme contre celui qui a lui-même formé une demande le premier, et devant le même juge."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "a7ff2276-5ed4-4d54-87fb-f69ed045527e",
                                "sense_id": "272c4907-a3a3-390d-acdc-1e4a922bd774",
                                "text": "La reconvention n’est admise que lorsque la demande du défendeur a de la connexité avec la demande principale."
                            },
                            {
                                "example_id": "08f83b4a-61b5-4c62-bf1b-a75253705d9b",
                                "sense_id": "272c4907-a3a3-390d-acdc-1e4a922bd774",
                                "text": "On ne fait exception que pour le cas où la demande reconventionnelle du demandeur découle du même principe et procède du même titre servant de fondement à la reconvention du défendeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d61dd19-c49d-4ed7-8e61-1ca64a64ded6",
                        "source_entry_id": "56fc4dcd-3ce1-3890-bd2b-0a66b5277b89",
                        "source_sense_id": "272c4907-a3a3-390d-acdc-1e4a922bd774",
