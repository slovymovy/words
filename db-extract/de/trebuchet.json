                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trebuchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2df66130-20d0-31cd-a266-26b8c907ed43",
                                        "entry_id": "8a912ec9-371d-3152-a965-c0b4196bdfc2",
                                        "glosses": [
                                            "A medieval siege engine consisting of a large pivoting arm heavily weighted on one end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96451c07-2791-4944-80c0-e9bbb10c69f0",
                                                "sense_id": "2df66130-20d0-31cd-a266-26b8c907ed43",
                                                "text": "Medieval trebuchets are said to have been capable of launching 90-kg projectiles over distances of more than 300 meters."
                                            },
                                            {
                                                "example_id": "5dd271f4-8ca7-4e98-ae78-efa8efaa22e1",
                                                "sense_id": "2df66130-20d0-31cd-a266-26b8c907ed43",
                                                "text": "With counterweight trebuchets at its disposal, a besieging force at last had the advantage in sieges, and it was probably the appearance of the trebuchet which prompted the changes in castle design from the mid-twelfth century onwards which were described in the previous chapter: the move from rectangular to round or multiform towers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1754321b-623d-3833-8c8a-a764f2d31564",
                                        "entry_id": "8a912ec9-371d-3152-a965-c0b4196bdfc2",
                                        "glosses": [
                                            "A torture device for dunking suspected witches by means of a chair attached to the end of a long pole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trebuchet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb44ed3b-ff47-3cb5-b2b7-221f784270dd",
                                        "entry_id": "8df32b0e-95fb-3d3a-a5fd-9d574de1419c",
                                        "glosses": [
                                            "To shoot with a trebuchet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab41601-7881-44d1-bfbf-9b4ffffb8756",
                        "source_entry_id": "12c7c014-7648-3545-ac0a-4b23b565eb5d",
                        "source_sense_id": "c834c36e-f1da-3a35-816d-2acd861ea511",
                        "source_sense_description": "Belagerungsmaschine mit Gegengewicht, die im Mittelalter gegen Burgen eingesetzt wurde",
                        "target_lang_word": "trébuchet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trébuchet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7860b9a-1a65-3936-99c4-ea9a126a261c",
                                        "entry_id": "f2867970-3693-386f-bff9-f9bbe3012667",
                                        "glosses": [
                                            "Engin militaire offensif à contre-poids utilisé au Moyen Âge pour le siège des places fortifiées, souvent confondu avec la catapulte."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97f50fa7-604c-3862-bb39-643c41ceb62a",
                                        "entry_id": "f2867970-3693-386f-bff9-f9bbe3012667",
                                        "glosses": [
                                            "Piège à oiseaux, en forme de cage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa700ea-309d-44be-9103-f834911b4d93",
                                                "sense_id": "97f50fa7-604c-3862-bb39-643c41ceb62a",
                                                "text": "Cet oiseau a donné dans le trébuchet, a été pris au trébuchet."
                                            },
                                            {
                                                "example_id": "969d8af9-c8fb-42c4-9643-df4f37946240",
                                                "sense_id": "97f50fa7-604c-3862-bb39-643c41ceb62a",
                                                "text": "Au commencement de l'automne, Firmin dit : \"Ça y est, j'ai placé mon trébuchet. La planche est graissée. Maintenant, le premier qui touche aux ficelles, dans la trappe ! Il n'y a plus qu'à attendre.\""
                                            },
                                            {
                                                "example_id": "277f0d02-9742-4db1-8c0b-b54cdeed7cc9",
                                                "sense_id": "97f50fa7-604c-3862-bb39-643c41ceb62a",
                                                "text": "Raboliot chassait toujours, car il fallait manger, colletait, furetait, posait des trébuchets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b95e3e-756b-3431-9f19-2b5cad83d4ed",
                                        "entry_id": "f2867970-3693-386f-bff9-f9bbe3012667",
                                        "glosses": [
                                            "Petite balance comportant deux plateaux suspendus à un fléau et destinée à peser avec précision de faibles quantités de matière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a64818ed-401c-4191-93e9-8bbefb0713ad",
                                                "sense_id": "91b95e3e-756b-3431-9f19-2b5cad83d4ed",
                                                "text": "Une antique Remington occupait l’extrémité d’une table, voisinant avec un registre ouvert et tout ce qu’il fallait pour écrire, plus un cendrier débordant de mégots, une petite lampe à abat-jour vert, un téléphone, un trébuchet sensible comme une midinette, une loupe d’horloger, une pierre de touche, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c767006-cd53-3b0a-be93-9402205e2605",
                                        "entry_id": "f2867970-3693-386f-bff9-f9bbe3012667",
                                        "glosses": [
                                            "Dispositif, appelé souvent « crochet », qui permet de capturer une dame adverse en donnant deux pièces."
                                        ],
                                        "tags": [
                                            "Jeu de dames"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "326f6858-bff3-4b9c-af37-5127feea2914",
                                                "sense_id": "1c767006-cd53-3b0a-be93-9402205e2605",
                                                "text": "les Blancs gagnent en offrant leur dame par 49-38. les Noirs sont alors obligés de prendre 2 pièces. Ce piège est appelé Trébuchet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
