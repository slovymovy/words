                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be704b1-c1af-4912-bcdb-5025390c41c6",
                                                "sense_id": "a672a4d6-57f3-3d81-a2aa-fa4312fb2680",
                                                "text": "Het beleg van Leningrad in de Tweede Wereldoorlog duurde vanaf 8 september 1941 tot 27 januari 1944. Hierbij kwamen ruim één miljoen burgers om (voornamelijk van honger en kou) naast nog eens 300.000 Russische soldaten. Daarmee groeide dit beleg uit tot een van de bloedigste veldslagen uit de wereldgeschiedenis"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
