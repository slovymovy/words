                        "entry_id": "8dd2c1c0-2ea9-314d-8dd1-ffc05dfe4008",
                        "glosses": [
                            "een voorwerp, meest in de vorm van een metalen staaf, die de opening van een deur verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af750665-cd25-4bfe-ac28-373aa43dfda5",
                                "sense_id": "f81bb8dd-d631-3fe0-b6dd-290c7caee3bd",
                                "text": "Deze stevige grendel maakt vrijwel onmogelijk de bankkluis te kraken."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f28b17e-4e74-3f5e-beb8-37bde4934597",
                        "entry_id": "8dd2c1c0-2ea9-314d-8dd1-ffc05dfe4008",
                        "glosses": [
                            "deel van een geweer waarmee men het geweer sluit zodat de patronen afgesloten zitten en het geweer klaar is om gebruikt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85fbea2-f526-4b1a-bd3c-d96644880e85",
                                "sense_id": "7f28b17e-4e74-3f5e-beb8-37bde4934597",
                                "text": "Opa pakte er meteen een, kreeg een doosje met munitie van de winkelbediende, keerde het doosje om en sloeg er hard mee op de toonbank zodat het openbarstte, greep een vuistvol patronen, drukte ze bliksemsnel in het geweer en duwde de grendel dicht."
                            }
                        ]
                    }
