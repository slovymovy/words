                "translations": [
                    {
                        "translation_id": "8e1c62d5-e59d-422d-81fb-20e33bc66f35",
                        "source_entry_id": "9f6c60e4-3739-3f45-b709-a2a5290f995b",
                        "source_sense_id": "806af346-7e84-3c14-baa9-b4c85f10bc4e",
