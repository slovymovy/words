{
    "word_family": [
        "elephantine",
        "elephantiasis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e69e148-4154-3cf5-a3ca-be5ed4ff8870",
                    "sense_definition": "A very large grey mammal with a long trunk, large ears, and tusks, native to Africa and Asia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>elephant</w> used its trunk to pick up a peanut from the ground.",
                            "target_lang_translations": {
                                "ru": "<w>Слон</w> использовал свой хобот, чтобы поднять с земли арахис.",
                                "zh": "<w>大象</w>用它的鼻子从地上捡起了一颗花生。"
                            }
                        },
                        {
                            "text": "We saw a herd of wild <w>elephants</w> during our safari in Kenya.",
                            "target_lang_translations": {
                                "ru": "Мы видели стадо диких <w>слонов</w> во время сафари в Кении.",
                                "zh": "我们在肯尼亚游猎时看到了一群野生<w>大象</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "African elephant",
                        "Asian elephant",
                        "white elephant",
                        "elephant in the room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень крупное серое млекопитающее с длинным хоботом, большими ушами и бивнями, обитающее в Африке и Азии.",
                        "zh": "一种体型非常巨大的灰色哺乳动物，长有长鼻子、大耳朵和象牙，原产于非洲和亚洲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слон",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "слониха",
                                "target_lang_sense_clarification": "самка слона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大象",
                                "target_lang_sense_clarification": "最常用的动物名称"
                            },
                            {
                                "target_lang_word": "象",
                                "target_lang_sense_clarification": "书面语或生物学分类中的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6d0a028-319f-3ce1-91df-f39a3a0662d7",
                    "sense_definition": "A word spoken after each number when counting seconds to ensure the count takes the correct amount of time.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To time the exposure correctly, count one <w>elephant</w>, two <w>elephant</w>.",
                            "target_lang_translations": {
                                "ru": "Чтобы правильно засечь время экспозиции, считайте: один <w>слон</w>, два <w>слона</w>.",
                                "zh": "为了准确计时曝光时间，请数：一<w>大象</w>，二<w>大象</w>。"
                            }
                        },
                        {
                            "text": "The children played hide and seek and counted to ten <w>elephant</w>.",
                            "target_lang_translations": {
                                "ru": "Дети играли в прятки и считали до десяти <w>слонов</w>.",
                                "zh": "孩子们玩捉迷藏，数到了十<w>大象</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "one elephant",
                        "two elephant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, произносимое после каждого числа при отсчете секунд для соблюдения правильного ритма.",
                        "zh": "在数秒计时时，为了确保计时的准确性，在每个数字后所加的词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слон",
                                "target_lang_sense_clarification": "используется при счете секунд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大象",
                                "target_lang_sense_clarification": "用于计时节奏的词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "374af8a9-808c-345b-ab88-02f592209b3e",
                    "sense_definition": "Something that is extremely large, heavy, or difficult to manage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unfinished building became a huge <w>elephant</w> that the city could not afford to fix.",
                            "target_lang_translations": {
                                "ru": "Недостроенное здание превратилось в огромную <w>махину</w>, которую город не мог позволить себе отремонтировать.",
                                "zh": "这座未完工的建筑成了一个巨大的<w>累赘</w>，城市根本负担不起维修费用。"
                            }
                        },
                        {
                            "text": "Moving that cast-iron stove was a real <w>elephant</w> of a task.",
                            "target_lang_translations": {
                                "ru": "Передвинуть эту чугунную печь было <w>адски тяжелой</w> задачей.",
                                "zh": "搬动那个铸铁炉子真是一项<w>艰巨</w>的任务。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то чрезвычайно большое, тяжелое или трудное для управления.",
                        "zh": "指极其庞大、沉重或难以处理的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махина",
                                "target_lang_sense_clarification": "перен. о чем-то огромном"
                            },
                            {
                                "target_lang_word": "громадина",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庞然大物",
                                "target_lang_sense_clarification": "形容体积巨大且笨重"
                            },
                            {
                                "target_lang_word": "累赘",
                                "target_lang_sense_clarification": "形容难以处理或负担沉重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0633fbbd-1bc6-3524-a1e0-a1b8f9b7743b",
                    "sense_definition": "A specific large size of paper, typically measuring 23 by 28 inches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect printed the draft on a sheet of <w>elephant</w>.",
                            "target_lang_translations": {
                                "ru": "Архитектор распечатал чертеж на листе формата <w>элефант</w>.",
                                "zh": "建筑师把草图打印在了一张<w>大幅纸</w>上。"
                            }
                        },
                        {
                            "text": "He ordered a ream of <w>elephant</w> for the special poster project.",
                            "target_lang_translations": {
                                "ru": "Он заказал стопку бумаги <w>элефант</w> для специального проекта плаката.",
                                "zh": "他为那个特殊的海报项目订购了一令<w>大幅纸</w>。"
                            }
                        }
                    ],
