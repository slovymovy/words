                    },
                    {
                        "sense_id": "1986068c-7577-3f39-92ab-4e16df84ad41",
                        "entry_id": "65f01ef0-aeb5-3e35-8a18-52d632ea3124",
                        "glosses": [
                            "Intervenant professionnel pour les conseils en écobiologie dans la construction de bâtiments."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "bb33ea29-1453-4045-887a-22c4145cb99d",
                                "sense_id": "1986068c-7577-3f39-92ab-4e16df84ad41",
                                "text": "Les écobiologistes de la construction conçoivent des cadres de vie à la fois sains et durables."
                            },
                            {
                                "example_id": "c16c2176-78d6-42db-bba1-5466203c8bae",
                                "sense_id": "1986068c-7577-3f39-92ab-4e16df84ad41",
                                "text": "Les écobiologistes de la construction s’y connaissent en matière de construction saine et écologique. Elles ou ils conseillent la maîtrise d’ouvrage et les architectes les informent de façon pertinente sur les types de constructions écologiques."
                            }
                        ]
