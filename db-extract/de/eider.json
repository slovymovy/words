                                "example_id": "e77ce77b-680d-40ba-a78c-95d8d48e46fd",
                                "sense_id": "c44e7fce-81a7-35ee-9594-30dcac8f8458",
                                "text": "„Die Eider war bis zur Völkerwanderung wahrscheinlich die Sprachgrenze zwischen westgermanischen Angeln und Jüten einerseits und Sachsen andererseits.“"
                            },
