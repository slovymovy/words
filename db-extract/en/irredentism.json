                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "128b08bb-fd24-450e-9d54-f1a7786dabc0",
                        "entry_id": "92623df5-534d-322f-b6b1-4d82e715efb8",
                        "tags": [
                            "plural"
                        ],
                        "form": "irredentisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d8405ff-e4e5-3864-9a8f-87e5e8b16bb1",
                        "entry_id": "92623df5-534d-322f-b6b1-4d82e715efb8",
                        "glosses": [
                            "A nationalistic doctrine advocating the annexation of foreign lands with historic or ethnic links."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "60dba28d-aaf9-4d1a-bf71-5f5fa0998d95",
                                "sense_id": "2d8405ff-e4e5-3864-9a8f-87e5e8b16bb1",
                                "text": "Ukraine became a major concern to [Stalin’s] “fortress builders” on the eve of World War II. The defensive bulwark seemed to have developed into a large crack – the threat of Ukrainian irredentism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f362a67-06a4-4cb1-aeb0-99298582f511",
                        "source_entry_id": "92623df5-534d-322f-b6b1-4d82e715efb8",
                        "source_sense_id": "2d8405ff-e4e5-3864-9a8f-87e5e8b16bb1",
