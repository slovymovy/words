                            },
                            {
                                "target_word": "halt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a1b4dd-5b90-3eb5-a9ca-26d334b565f2",
                                        "entry_id": "33abd3a8-fc8b-3a16-a01c-b36494ed6fcb",
                                        "glosses": [
                                            "To stop marching."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "422bd3cd-7d68-3f32-b784-a1ca95d60905",
                                        "entry_id": "33abd3a8-fc8b-3a16-a01c-b36494ed6fcb",
                                        "glosses": [
                                            "To stop either temporarily or permanently."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3f867c-b7b0-415e-a16b-038c4693126b",
                                                "sense_id": "422bd3cd-7d68-3f32-b784-a1ca95d60905",
                                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c5d88d-a119-3cda-8814-f2adc41936d9",
                                        "entry_id": "33abd3a8-fc8b-3a16-a01c-b36494ed6fcb",
                                        "glosses": [
                                            "To bring to a stop."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b306622-df0f-37eb-991c-c9c8a9c770c7",
                                        "entry_id": "33abd3a8-fc8b-3a16-a01c-b36494ed6fcb",
                                        "glosses": [
                                            "To cause to discontinue."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a051414-834b-4c81-99a9-8e97392a8e13",
                                                "sense_id": "4b306622-df0f-37eb-991c-c9c8a9c770c7",
                                                "text": "The contract negotiations halted operations for at least a week."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c07426e0-4fae-33f1-a870-384e9b1a6fd6",
                                        "entry_id": "7ade36f1-a8d2-3dde-9424-55fb0f9cb840",
                                        "glosses": [
                                            "A cessation, either temporary or permanent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c30934-edf6-44f6-ac34-ab73c60220b0",
                                                "sense_id": "c07426e0-4fae-33f1-a870-384e9b1a6fd6",
                                                "text": "The contract negotiations put a halt to operations."
                                            },
                                            {
                                                "example_id": "1b0c4d36-2ea7-4945-aaef-a58b73566fe7",
                                                "sense_id": "c07426e0-4fae-33f1-a870-384e9b1a6fd6",
                                                "text": "Without any halt they marched."
                                            },
                                            {
                                                "example_id": "3a15d0b4-384c-4a6e-a72f-adc3d1b562ec",
                                                "sense_id": "c07426e0-4fae-33f1-a870-384e9b1a6fd6",
                                                "text": "Because most diesel failures can be traced to electrical faults, minor in themselves but often difficult to pin-point, any unscheduled halt during a trial run is often the signal for the frenzied unfolding of wiring diagrams and the appearance of an impressive array of voltmeters and circuit testers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f4d3a9a-1f23-3332-afdb-d1df02e04a41",
                                        "entry_id": "7ade36f1-a8d2-3dde-9424-55fb0f9cb840",
                                        "glosses": [
                                            "A minor railway station (usually unstaffed) in the United Kingdom."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683a859d-6ce9-4a44-a4fb-4380b8b798bf",
                                                "sense_id": "9f4d3a9a-1f23-3332-afdb-d1df02e04a41",
                                                "text": "The halt itself never achieved much importance, even with workers coming to and from the adjacent works."
                                            },
                                            {
                                                "example_id": "54234d6e-341e-4f0d-a076-f3309c8197ab",
                                                "sense_id": "9f4d3a9a-1f23-3332-afdb-d1df02e04a41",
                                                "text": "The highest point on the line is at milepost 21¾, 367 ft. above sea level. Here there is a halt named Kilmakerrill, after which the line descends to Manorhamilton (24¾ miles)."
                                            },
                                            {
                                                "example_id": "e3974e30-36dd-4368-bfe9-c0fde43525cd",
                                                "sense_id": "9f4d3a9a-1f23-3332-afdb-d1df02e04a41",
                                                "text": "On once more we swung, bumping uneasily along in the antique narrow-gauge coach, with gloomy woods and gathering night outside, shouts and songs (and quacks) inside—this was not at all the sort of train ordained by the logical strategists in Paris—then grinding to a stop at a mysterious halt which was no more than a nameboard in the pinewoods, without even a footpath leading to it, but nevertheless with a solitary passenger stolidly waiting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d6e8644-8471-31b9-b436-f6598b4a5638",
                                        "entry_id": "9d89b44d-2bb3-302f-b3ba-23f7df1619e3",
                                        "glosses": [
                                            "Lame, limping."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "693c3b07-2d0b-499c-99f3-0365809bb3a3",
                                                "sense_id": "8d6e8644-8471-31b9-b436-f6598b4a5638",
                                                "text": "It is better for the to goo halt into lyfe, then with ij. fete to be cast into hell […]"
                                            },
                                            {
                                                "example_id": "f276dbf8-1a03-48bd-ac37-ae5061f119ba",
                                                "sense_id": "8d6e8644-8471-31b9-b436-f6598b4a5638",
                                                "text": "Bring in hither the poor, and the maimed, and the halt, and the blind."
                                            }
                                        ]
                                    }
                                ]
