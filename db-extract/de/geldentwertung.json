                "senses": [
                    {
                        "sense_id": "7a8bccc4-2922-36d3-af5e-baad1c0e5508",
                        "entry_id": "3840a4e3-a2a1-32d2-b909-2a3bac021b1a",
                        "glosses": [
                            "das Herabsetzen des Geldes im Wert, der Verlust an Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47461c4b-6554-43a8-9caf-3f5c4dc3f010",
                                "sense_id": "7a8bccc4-2922-36d3-af5e-baad1c0e5508",
                                "text": "„Durch die ständige Geldentwertung sind sie sinnlos geworden.“"
                            },
                            {
                                "example_id": "4610b1db-cd15-4bd5-a0ea-f84d5cbea73b",
                                "sense_id": "7a8bccc4-2922-36d3-af5e-baad1c0e5508",
                                "text": "„Die massive Geldentwertung der Reichsmark seit Beginn des Ersten Weltkrieges führte in diesen Jahren zu einer Verarmung großer Teile der deutschen Mittelschicht.“"
                            },
                            {
                                "example_id": "d0caa15f-fc8b-4d9b-a2bf-2c7cc7448db9",
                                "sense_id": "7a8bccc4-2922-36d3-af5e-baad1c0e5508",
                                "text": "„Die Inflation ist das beherrschende Thema des Geschehens, lapidar wird von den ansteigenden Selbstmorden der durch die Geldentwertung in den Ruin gestürzten Kleinbürger berichtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
