        "nl-extract.jsonl": [
            {
                "entry_id": "9aad8b30-ad90-3db9-99fb-28683a5105c5",
                "word": "nanny",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cedf10fb-40e8-4b8c-8037-2083219812be",
                        "entry_id": "9aad8b30-ad90-3db9-99fb-28683a5105c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "nanny's"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                        "entry_id": "9aad8b30-ad90-3db9-99fb-28683a5105c5",
                        "glosses": [
                            "vrouw die zorgt voor de kinderen van haar opdrachtgevers"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "42accd4a-ef72-42c1-b0f0-e09f914cdcd5",
                                "sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                                "text": ",,Ons meisje is geboren\", aldus Ferri. De acteur maakte de komst van zijn dochter in februari bekend. Hij en zijn levenspartner waren toen ruim een jaar samen. Afgelopen zomer stapten de twee in het huwelijksbootje. Noële runt een eigen bemiddelingsbedrijf voor gezinnen die een nanny zoeken."
                            },
                            {
                                "example_id": "21a27e01-94ac-4bd6-87eb-0ce7cbc588cd",
                                "sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                                "text": "Mel B en Stephen zetten vorig jaar na een huwelijk van tien jaar een punt achter hun relatie. De zangeres stelde destijds dat ze jarenlang is mishandeld door haar man. Ook beweerde ze dat hij en hun nanny jarenlang een affaire hadden."
                            },
                            {
                                "example_id": "c30df174-ec81-4cd0-9158-d4c66b24936b",
                                "sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                                "text": "Lonah Chemtai Salpeter verhuisde negen jaar geleden naar Israël om nanny te zijn voor een Keniaanse ambassadeur, trouwde met een Israëlische man en komt pas sinds dit jaar voor haar nieuwe land uit."
                            },
                            {
                                "example_id": "afd87801-adf6-4305-bfc3-567d0a647f8f",
                                "sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                                "text": "Paul Newman speelt met zijn dochtertje, zijn vrouw Joanne Woodward (Three Faces of Eve) maakt foto's van hen en 's ochtends vind je ze om 7 uur aan het ontbijt, met de nanny, een dikke gezellige negerin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "653362eb-d4b8-4bbf-95c8-677abb837a78",
                        "source_entry_id": "9aad8b30-ad90-3db9-99fb-28683a5105c5",
                        "source_sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                        "source_sense_description": "vrouw die zorgt voor de kinderen van haar opdrachtgevers",
                        "target_lang_word": "nanny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A child's nurse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a6722e-c032-4263-a1ac-5f5975a48afb",
                                                "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime. Their bases were on a level with the pavement outside, a narrow way which was several feet lower than the road behind the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d800a96a-5b42-31d1-a3ee-bac5aaaf915e",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A grandmother."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef24633a-8647-382e-8c6f-1a7c96dc2eb0",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A godmother."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A female goat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62bd591f-2731-4c42-8022-a9ccb5a517e8",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Breeding is a consuming goal, and the ascendance of the sex drive is nearly as apparent in the behavior of a mountain goat billy. So given over is he to following and defending a succession of nannies as he searches for one in heat (estrus), he loses interest in food altogether; […]"
                                            },
                                            {
                                                "example_id": "180f85b6-5af6-44f9-a531-64c1308e88c4",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Nannies and billies look very similar, both having dangerously sharp, curved black horns."
                                            },
                                            {
                                                "example_id": "db5af42b-6090-40a8-b7fa-0e3e61ea01da",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "A farmer friend keeps a video camera in the barn so she can turn on her goat cam and observe her animals at any time of the day or night. A baby monitor picks up the sounds of a nanny when she goes into labor—if the nanny is one who changes the usual pitch of her voice or nervously bleats during kidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7301c6-1ab7-328d-9b65-c3531393e62b",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "Synonym of sylvester (“device for pulling out pit props”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nanny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c8c326-9c61-36d6-a61c-ff0b1ffac308",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To serve as a nanny."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To treat like a nanny's charges; to coddle."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6849c3a5-27a9-4513-904e-3b96e4c2974b",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "In real life, says a Democratic campaign aide, members of Congress are too nannied by staff to stride about hatching plots, one-on-one."
                                            },
                                            {
                                                "example_id": "379e9d60-c44d-4a06-848c-8a34b7650a43",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "All politicians seem worried. After 40-plus years of being nannied by the EU they are now faced with having to stand on their own two feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83057d94-02e9-4e3f-8497-76224002c65c",
                        "source_entry_id": "9aad8b30-ad90-3db9-99fb-28683a5105c5",
                        "source_sense_id": "05228a2b-c4bc-3e27-9030-c73c69bc138a",
                        "source_sense_description": "vrouw die zorgt voor de kinderen van haar opdrachtgevers",
                        "target_lang_word": "nounou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nounou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0705fb0-f161-391d-a25c-6c4fcd3e18ee",
                                        "entry_id": "7e43c43b-7a45-36e2-b7fd-f2192390707f",
                                        "glosses": [
                                            "Personne qui garde un ou plusieurs enfants de façon professionnelle ou occasionnellement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42e68ce5-a188-4df2-9e2c-1a73092343f7",
                                                "sense_id": "b0705fb0-f161-391d-a25c-6c4fcd3e18ee",
                                                "text": "[…] un grand jardin public au bas des Champs-Élysées, avec des nurses anglaises et des nounous alsaciennes, […]"
                                            },
                                            {
                                                "example_id": "16755daa-3144-4b7d-9a61-522adf0a9c4b",
                                                "sense_id": "b0705fb0-f161-391d-a25c-6c4fcd3e18ee",
                                                "text": "Travailler pour payer la nounou, est-ce bien utile? Quand arrive un enfant, puis deux, puis trois... le calcul est parfois vite fait : entre les frais de garde, de cantine, de baby-sitter, sans compter la fatigue et le stress, on se demande parfois s’il est encore bien utile de s’entêter à travailler pour un gain somme toute plutôt modique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nounou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e5b080-3ab3-3f54-86a7-7dec56ffdb4a",
                                        "entry_id": "20da8d27-cdc2-3bd8-adba-fa30872b78cb",
                                        "glosses": [
                                            "Nom donné dans les îles Marquises à un petit insecte piqueur volant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb5c637-e3a2-4b67-9e80-01271a0ab533",
                                                "sense_id": "b0e5b080-3ab3-3f54-86a7-7dec56ffdb4a",
                                                "text": "Le nono ou nounou est la plaie de Nuka-Hiva pour les excursionnistes ; j'ai souvent été la victime de ces petits moucherons dont la piqûre est venimeuse, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e7fb8a-716b-37cb-8abc-c065582ca4a2",
                                        "entry_id": "20da8d27-cdc2-3bd8-adba-fa30872b78cb",
                                        "glosses": [
                                            "Nom donné au Mozambique à un insecte ravageur des cultures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "645d0466-d78e-495c-92e0-fcc5bd393460",
                                                "sense_id": "e3e7fb8a-716b-37cb-8abc-c065582ca4a2",
                                                "text": "Les Noirs l'appellent le «Nounou». C'est un fléau pour les champs de haricots et de maïs (un peu comme les hannetons chez nous)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nounou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fca5b38-24bb-3833-ba3f-7cf18c278734",
                                        "entry_id": "64f94c0b-0b0d-34da-ab7d-87d100f909d9",
                                        "glosses": [
                                            "Flocon de poussière, de poils. Mimi, mouton de poussière, chaton."
                                        ],
                                        "tags": [
                                            "Nord"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c95361c6-d40f-414c-87bb-31ab83be5a45",
                                                "sense_id": "4fca5b38-24bb-3833-ba3f-7cf18c278734",
                                                "text": "La semaine dernière, lassée que Bébédoux en ressorte couvert de nounous de poussière, et pleine d'un allant plutôt rare, je me suis mise à aspirer sous mon lit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
