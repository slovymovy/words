                ],
                "translations": [
                    {
                        "translation_id": "1553c1f1-0b3c-43b9-8bd1-9141f2d1e76b",
                        "source_entry_id": "eb6f0321-3e09-380d-b1fe-e8b6178e77e2",
                        "target_lang_word": "conspirateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                        "entry_id": "905f292e-d6a8-3765-b9a5-f8e9e8ec7457",
                                        "glosses": [
                                            "Qui conspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953f4699-3c94-416a-8bd5-2bd6c1c045f2",
                                                "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                                "text": "La phalange conspiratrice."
                                            },
                                            {
                                                "example_id": "102e747b-7415-4b54-a390-39f3f2ab88f5",
                                                "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                                "text": "Se penchant vers moi avec un air conspirateur, il a murmuré : « Je mets déjà en pratique la plupart de ces principes, mais ma femme avait vraiment besoin d’entendre cela. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                        "entry_id": "d13ac5ba-dcbb-3945-8511-a179eb8e31b0",
                                        "glosses": [
                                            "Celui qui conspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403c44e1-ccb6-49bf-a7fd-1b2b3baa313a",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Une prompte enquête, instruite par le coroner Mac-Ma-Hong, révéla que le conspirateur n’était pas le meurtrier ; la machine à désélectrocuter n’étant pas encore inventée, on inhuma le malheureux innocent."
                                            },
                                            {
                                                "example_id": "067d1e9c-90a1-4a5c-8d7f-f9fabddebf0d",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Cette sauvage sortie fut réprimée par Cérizet, qui dit à la revendeuse un de ces chut ! prolongés auxquels obéissent tous les conspirateurs."
                                            },
                                            {
                                                "example_id": "806b43bc-c4e6-4b43-9fc7-ca8e244db3f0",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Les sections de la fière cité de Marseille ont bien mérité de la patrie, législateurs; elles ont désagonisé l’esprit public, septembrisé par une faction liberticide; et s’armant de la pique redoutable, elles ont terrassé les insolens conspirateurs qui étaient dans leur sein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43efa64-4a44-4b1e-8cca-c5a8b0e28ea7",
                        "source_entry_id": "eb6f0321-3e09-380d-b1fe-e8b6178e77e2",
                        "target_lang_word": "comploteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comploteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                                        "entry_id": "b81b0943-fdfe-3c2b-9081-2d0e4085cce1",
                                        "glosses": [
                                            "Personne qui complote, qui fait partie d'un complot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eff5313-558e-418c-9190-3d6f471c638f",
                                                "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                                                "text": "La lecture de son message ainsi que la présidence de séance échoient à un élu du groupe Le Pen, Édouard Frédéric-Dupont, le vieux comploteur du 6 février 1934. C'est l'occasion d'un coup médiatique qui n'a rien d'improvisé."
                                            },
                                            {
                                                "example_id": "386794ec-a233-4b2c-ba1b-d9ae666c0c28",
                                                "sense_id": "79d43e9c-3a19-3624-b3da-3831f532a25d",
                                                "text": "Un mafieux, un assassin, un comploteur doit toujours craindre l’existence cachée d’un semblable prêt à le supplanter à la moindre occasion : c’est dans l'ordre des choses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "712e9987-0bef-4950-91fa-831666db23b7",
                        "source_entry_id": "eb6f0321-3e09-380d-b1fe-e8b6178e77e2",
                        "target_lang_word": "conjuré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc7a1227-c291-3423-b58a-a1f23649d9eb",
                                        "entry_id": "ded6a432-a6ad-33e2-b328-32f258cd3701",
                                        "glosses": [
                                            "Celui qui fait partie d’une conjuration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05452900-2dca-4ff1-9435-1e3aaa7e063a",
                                                "sense_id": "bc7a1227-c291-3423-b58a-a1f23649d9eb",
                                                "text": "Un instant avant le meurtre, Claude suivait l'empereur; les conjurés l'écartèrent pêle-mêle avec la foule, il s'en fut dans une salle voisine, de là entendit du tumulte, eut peur, et alla se cacher; […]."
                                            },
                                            {
                                                "example_id": "7e7f912b-50d7-4973-8697-8c7ea4fbdbe6",
                                                "sense_id": "bc7a1227-c291-3423-b58a-a1f23649d9eb",
                                                "text": "Le président du Conseil jeta, très sagement à mon sens, une pelletée de terre sur cet embryon de conspiration. Après tout, les conjurés n'étaient pas passés aux actes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conjuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a10695f6-94d8-3b9a-87e3-c4b7c596ae32",
                                        "entry_id": "98d6fe6e-3a2f-3807-a6c6-70740c2f4712",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe conjurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
