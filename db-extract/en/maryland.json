                "senses": [
                    {
                        "sense_id": "7902d41c-0d7e-377d-bffa-ad26a41588b9",
                        "entry_id": "678d4d90-71f4-3cf3-a584-2c12a1954941",
                        "glosses": [
                            "A state of the United States; named for Queen Mary, queen consort of England, Scotland and Ireland. Capital: Annapolis. Largest city: Baltimore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8ade84-88e8-46da-9bda-71bf426b01b4",
                                "sense_id": "7902d41c-0d7e-377d-bffa-ad26a41588b9",
                                "text": "On the invitation list: Govs. Andy Beshear of Kentucky, Tim Walz of Minnesota, J.B. Pritzker of Illinois, Gretchen Whitmer of Michigan, Tony Evers of Wisconsin, Josh Shapiro of Pennsylvania, Roy Cooper of North Carolina, Wes Moore of Maryland and Michelle Lujan Grisham of New Mexico."
                            }
                        ]
                    },
                    {
                        "sense_id": "47f40755-b1a8-38b6-a936-c6b9927723d3",
                        "entry_id": "678d4d90-71f4-3cf3-a584-2c12a1954941",
                        "glosses": [
                            "A former colony of England, from 1632 to 1707, and of Great Britain, from 1707 to 1776, roughly matching the present state."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
