{
    "word_family": [
        "round",
        "roundabout",
        "roundness"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "3c1b57d6-a403-3293-a1a4-cd884c2b333a",
                    "sense_definition": "Forming a circle or closed curve containing something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "circular path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a gold chain <w>around</w> her neck.",
                            "target_lang_translations": {
                                "ru": "Она носила золотую цепочку <w>вокруг</w> шеи."
                            }
                        },
                        {
                            "text": "The children sat <w>around</w> the campfire to sing songs.",
                            "target_lang_translations": {
                                "ru": "Дети сидели <w>вокруг</w> костра и пели песни."
                            }
                        }
                    ],
                    "synonyms": [
                        "environ"
                    ],
                    "common_phrases": [
                        "around the campfire",
                        "around her neck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образуя круг или замкнутую кривую вокруг чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "круговое расположение"
                            },
                            {
                                "target_lang_word": "круго́м",
                                "target_lang_sense_clarification": "со всех сторон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35a8fa08-e905-3c52-ade3-56e09168365b",
                    "sense_definition": "Near in time or space; in the vicinity of.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I left the house <w>around</w> ten this morning.",
                            "target_lang_translations": {
                                "ru": "Я вышел из дома <w>около</w> десяти утра."
                            }
                        },
                        {
                            "text": "I think I left my keys somewhere <w>around</w> here.",
                            "target_lang_translations": {
                                "ru": "Думаю, я оставил ключи где-то <w>здесь</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around here",
                        "around ten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Близко по времени или в пространстве; поблизости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́коло",
                                "target_lang_sense_clarification": "приблизительно"
                            },
                            {
                                "target_lang_word": "вблизи́",
                                "target_lang_sense_clarification": "недалеко"
                            },
                            {
                                "target_lang_word": "приме́рно",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed859996-cf05-37ad-ad2b-1bced7bda84b",
                    "sense_definition": "At or to various places within or throughout an area.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pages from the notebook were scattered <w>around</w> the room.",
                            "target_lang_translations": {
                                "ru": "Страницы из блокнота были разбросаны <w>по</w> всей комнате."
                            }
                        },
                        {
                            "text": "The estate agent showed me <w>around</w> the property.",
                            "target_lang_translations": {
                                "ru": "Агент по недвижимости показал мне <w>всё</w> имение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around the room",
                        "around the office"
                    ],
                    "target_lang_definitions": {
                        "ru": "В различных местах внутри или по всей площади."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по",
                                "target_lang_sense_clarification": "распределение по площади"
                            },
                            {
                                "target_lang_word": "везде́",
                                "target_lang_sense_clarification": "повсюду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0efb69f8-c1d7-3010-9b61-61bbcdb7678f",
                    "sense_definition": "Following the perimeter of a specified area and returning to the starting point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "circular path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked <w>around</w> the football field for exercise.",
                            "target_lang_translations": {
                                "ru": "Мы ходили <w>вокруг</w> футбольного поля для разминки."
                            }
                        },
                        {
                            "text": "She went <w>around</w> the track fifty times.",
                            "target_lang_translations": {
                                "ru": "Она пробежала <w>по</w> дорожке пятьдесят кругов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around the track",
                        "around the field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следуя по периметру определенной области и возвращаясь в исходную точку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "по периметру"
                            },
                            {
                                "target_lang_word": "по пери́метру",
                                "target_lang_sense_clarification": "вдоль границы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "554ecb14-1686-3470-ac60-68dd143ee6b9",
                    "sense_definition": "Following a path which curves near an object, with the object on the inside of the curve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "circular path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road took a brief detour <w>around</w> the large rock formation.",
                            "target_lang_translations": {
                                "ru": "Дорога сделала небольшой крюк <w>вокруг</w> большой скалы."
                            }
                        },
                        {
                            "text": "He carefully drove <w>around</w> the corner.",
                            "target_lang_translations": {
                                "ru": "Он осторожно повернул <w>за</w> угол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around the corner",
                        "around the rock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следуя по пути, который изгибается рядом с объектом, оставляя объект внутри изгиба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "огибая"
                            },
                            {
                                "target_lang_word": "в обхо́д",
                                "target_lang_sense_clarification": "минуя препятствие"
                            },
                            {
                                "target_lang_word": "за",
                                "target_lang_sense_clarification": "поворот за угол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0fcb6f2-4a1e-34a5-8efe-e2099622765c",
                    "sense_definition": "Centred upon; regarding or concerning a specific topic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could use some clarification <w>around</w> the new rules.",
                            "target_lang_translations": {
                                "ru": "Нам не помешали бы разъяснения <w>относительно</w> новых правил."
                            }
                        },
                        {
                            "text": "There has been a lot of controversy <w>around</w> the handling of personal information.",
                            "target_lang_translations": {
                                "ru": "Было много споров <w>вокруг</w> обращения с личной информацией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around the rules",
                        "controversy around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосредоточенный на чем-либо; касающийся или относящийся к определенной теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "о теме обсуждения"
                            },
                            {
                                "target_lang_word": "относи́тельно",
                                "target_lang_sense_clarification": "касательно"
                            },
                            {
                                "target_lang_word": "каса́тельно",
                                "target_lang_sense_clarification": "в отношении чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3a7daa09-db3e-3d0b-87f2-f5e87991d3f2",
                    "sense_definition": "Nearly; approximately; about.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "approximation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An adult elephant weighs <w>around</w> five tons.",
                            "target_lang_translations": {
                                "ru": "Взрослый слон весит <w>около</w> пяти тонн."
                            }
                        },
                        {
                            "text": "<w>Around</w> a thousand people attended the concert.",
                            "target_lang_translations": {
                                "ru": "Концерт посетили <w>приблизительно</w> тысяча человек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "around a thousand",
                        "around five tons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почти; приблизительно; около."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́коло",
                                "target_lang_sense_clarification": "приблизительное количество"
                            },
                            {
                                "target_lang_word": "приме́рно",
                                "target_lang_sense_clarification": "почти столько"
                            },
                            {
                                "target_lang_word": "приблизи́тельно",
                                "target_lang_sense_clarification": "неточно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a5b4176-999e-3676-b72d-c568bf51ee36",
                    "sense_definition": "So as to partially or completely rotate; so as to face in the opposite direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turn <w>around</w> at the end of this street.",
                            "target_lang_translations": {
                                "ru": "Развернитесь <w>кругом</w> в конце этой улицы."
                            }
                        },
                        {
                            "text": "She spun <w>around</w> a few times in her new dress.",
                            "target_lang_translations": {
                                "ru": "Она несколько раз покрутилась <w>вокруг</w> своей оси в новом платье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "turn around",
                        "spin around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, чтобы частично или полностью повернуться; лицом в противоположную сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круго́м",
                                "target_lang_sense_clarification": "поворот на 180 градусов"
                            },
                            {
                                "target_lang_word": "наза́д",
                                "target_lang_sense_clarification": "в обратную сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "056fcfc2-642e-3580-b37c-1ad7450282ab",
                    "sense_definition": "From place to place or in various directions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look <w>around</w> and see what you find.",
                            "target_lang_translations": {
                                "ru": "Посмотри <w>вокруг</w> и увидишь, что найдешь."
                            }
                        },
                        {
                            "text": "There are rumors going <w>around</w> that the company is bankrupt.",
                            "target_lang_translations": {
                                "ru": "Ходят <w>слухи</w>, что компания обанкротилась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "look around",
                        "going around"
                    ],
                    "target_lang_definitions": {
                        "ru": "С места на место или в различных направлениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "по сторонам"
                            },
                            {
                                "target_lang_word": "туда́-сюда́",
                                "target_lang_sense_clarification": "в разные стороны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdf9fd68-694c-34d3-a5ef-ee588851424a",
                    "sense_definition": "So as to form a circle or trace a circular path.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "circular path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High above, vultures circled <w>around</w>.",
                            "target_lang_translations": {
                                "ru": "Высоко в небе <w>кружили</w> грифы."
                            }
                        },
                        {
                            "text": "The wheels of the car spun <w>around</w> in the mud.",
                            "target_lang_translations": {
                                "ru": "Колеса машины <w>вращались</w> в грязи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "circled around",
                        "spun around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, чтобы образовать круг или следовать по круговому пути."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по кру́гу",
                                "target_lang_sense_clarification": "круговое движение"
                            },
                            {
                                "target_lang_word": "круго́м",
                                "target_lang_sense_clarification": "вращаясь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ea01940-db80-384a-afdc-4fd41e1e6b6e",
                    "sense_definition": "So as to surround or be near.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everybody please gather <w>around</w> for the announcement.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, соберитесь <w>вокруг</w> для объявления."
                            }
                        },
                        {
                            "text": "There isn't another house for miles <w>around</w>.",
                            "target_lang_translations": {
                                "ru": "На мили <w>вокруг</w> нет ни одного другого дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gather around",
                        "miles around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так, чтобы окружить или находиться рядом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вокру́г",
                                "target_lang_sense_clarification": "окружая"
                            },
                            {
                                "target_lang_word": "круго́м",
                                "target_lang_sense_clarification": "в окрестности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3b3c3c6-a344-3b4c-a22f-ffedf6e46541",
                    "sense_definition": "Used with verbs to indicate repeated or continuous action in various locations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I asked <w>around</w>, and no-one really liked it.",
                            "target_lang_translations": {
                                "ru": "Я <w>поспрашивал</w> людей, и никому это особо не понравилось."
                            }
                        },
                        {
                            "text": "Shopping <w>around</w> can get you a better deal.",
                            "target_lang_translations": {
                                "ru": "Если <w>поискать</w> в разных магазинах, можно найти более выгодное предложение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ask around",
                        "shop around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется с глаголами для обозначения повторяющегося или продолжительного действия в разных местах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повсю́ду",
                                "target_lang_sense_clarification": "в разных местах"
                            },
                            {
                                "target_lang_word": "там-сям",
                                "target_lang_sense_clarification": "разг. в разных местах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b1a7a9c-9545-395e-ba62-5667e3e4110c",
                    "sense_definition": "From one state to an opposite one; bringing about awareness or agreement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new coach really turned things <w>around</w> for the team.",
                            "target_lang_translations": {
                                "ru": "Новый тренер действительно <w>изменил</w> ситуацию в команде к лучшему."
                            }
                        },
                        {
                            "text": "The patient was unconscious but the doctor brought him <w>around</w> quickly.",
                            "target_lang_translations": {
                                "ru": "Пациент был без сознания, но врач быстро привел его <w>в себя</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "turn things around",
                        "bring him around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Из одного состояния в противоположное; приведение в сознание или к согласию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в чу́вства",
                                "target_lang_sense_clarification": "о сознании"
                            },
                            {
                                "target_lang_word": "ина́че",
                                "target_lang_sense_clarification": "изменить ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a31e79b0-cf99-3dae-8337-2f2633e98a7b",
                    "sense_definition": "Used with certain verbs to suggest unproductive or idle activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't just sit <w>around</w> all day doing nothing.",
                            "target_lang_translations": {
                                "ru": "Не сиди <w>просто так</w> весь день без дела."
                            }
                        },
                        {
                            "text": "They were just messing <w>around</w> in the backyard.",
                            "target_lang_translations": {
                                "ru": "Они просто <w>валяли дурака</w> на заднем дворе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sit around",
                        "mess around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts to describe wasting time."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется с определенными глаголами для обозначения непродуктивной или праздной деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без де́ла",
                                "target_lang_sense_clarification": "праздно"
                            },
                            {
                                "target_lang_word": "про́сто так",
                                "target_lang_sense_clarification": "без цели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdd8acda-20b2-3f28-9f06-64c91e13b1bd",
                    "sense_definition": "Present in the vicinity; available.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is Clare <w>around</w> today?",
                            "target_lang_translations": {
                                "ru": "Клэр сегодня <w>на месте</w>?"
                            }
                        },
                        {
                            "text": "I'll be <w>around</w> if you need any help.",
                            "target_lang_translations": {
                                "ru": "Я буду <w>рядом</w>, если тебе понадобится помощь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "be around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in spoken English to mean present."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствующий поблизости; доступный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на ме́сте",
                                "target_lang_sense_clarification": "присутствует"
                            },
                            {
                                "target_lang_word": "ря́дом",
                                "target_lang_sense_clarification": "поблизости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "718c399b-7ae3-3397-9920-209700d32adb",
