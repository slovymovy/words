                        "sense_id": "9141a922-5d1b-3830-ba6c-847f7a5ededa",
                        "entry_id": "0a25a348-469b-33a0-8b7a-cd7feaa3f359",
                        "glosses": [
                            "To promise more than is delivered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f4286d6-078a-4141-814a-33830529a5df",
                                "sense_id": "9141a922-5d1b-3830-ba6c-847f7a5ededa",
                                "text": "We don't want to overpromise."
                            },
                            {
                                "example_id": "4b4d091f-fe2d-4283-9640-d34784cbdf8b",
                                "sense_id": "9141a922-5d1b-3830-ba6c-847f7a5ededa",
                                "text": "So rather than posh skin creams that overpromise, a good brow job gives instant results."
                            },
                            {
                                "example_id": "1e6651b5-17f2-4552-90c3-7578b907d414",
                                "sense_id": "9141a922-5d1b-3830-ba6c-847f7a5ededa",
                                "text": "Hope Hicks, one of the President’s longest-serving aides, warned Parscale against touting ticket request numbers, reminding him that the number one rule in politics is not to overpromise and underdeliver, a source familiar with the matter said."
                            },
                            {
                                "example_id": "9f69b4a7-c3a6-4c7d-891c-1afb3ebbc29f",
                                "sense_id": "9141a922-5d1b-3830-ba6c-847f7a5ededa",
                                "text": "\"[...] If the economy has tanked... then we don't want to over-promise and under-deliver.\""
                            }
                        ]
                    }
