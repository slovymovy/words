                                    {
                                        "sense_id": "035146d1-ef2a-3b29-900c-bda0664481c5",
                                        "entry_id": "fec8de5a-d44e-3927-bc6d-e30b02409cce",
                                        "glosses": [
                                            "staatenbildendes Insekt der Familie Formicidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbabfadc-b8be-4e67-ba05-89b2214d1d45",
                                                "sense_id": "035146d1-ef2a-3b29-900c-bda0664481c5",
                                                "text": "Die Ameisen bildeten eine Straße mitten durch die Küche."
                                            },
                                            {
                                                "example_id": "4407b3a5-50cd-446c-a3e5-d1b6d588440d",
                                                "sense_id": "035146d1-ef2a-3b29-900c-bda0664481c5",
                                                "text": "„Demographen beobachten ähnliche Phänomene, wenn sie untersuchen, wie Populationen von Ameisen, Lemmingen oder Menschen anwachsen.“"
                                            },
                                            {
                                                "example_id": "d042aeca-a229-4f85-a2a5-c97b2d407609",
                                                "sense_id": "035146d1-ef2a-3b29-900c-bda0664481c5",
                                                "text": "„Erst durch das Hinterfragen und Reflektieren, durch Werterkenntnis und Sinnzuweisung unterscheiden sich die Extremleistungen des Menschen wesentlich von denen der Lachse, Ameisen, Bergziegen oder Zugvögel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce904664-8f4a-3596-a9a2-bff8cd53108a",
                                        "entry_id": "fec8de5a-d44e-3927-bc6d-e30b02409cce",
