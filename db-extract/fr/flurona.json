                                "target_senses": [
                                    {
                                        "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                        "entry_id": "9735b7cf-147d-3630-b5a3-2274fd8cfc79",
                                        "glosses": [
                                            "A rare double infection of influenza and COVID-19."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b71ad81-3f80-4d10-8ada-824cff705574",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "Her case is first documented in the world but doctors believe there could be more 'flurona' infections in the country."
                                            },
                                            {
                                                "example_id": "d46413b0-b4a1-4198-bfb5-d16c88aa6782",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "The woman who has been admitted to hospital with ‘flurona’ is pregnant and unvaccinated"
                                            },
                                            {
                                                "example_id": "cd5f9b8a-f04b-46c5-b367-f78711be520d",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "Israel has recorded the first case of a rare mixture of two diseases, influenza and coronavirus, dubbed “flurona”."
                                            },
                                            {
                                                "example_id": "32a6bed8-39a8-4296-9aa8-a79a08d45538",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "The first case of Flurona – a mixture of coronavirus and flu – has been found in a young pregnant woman."
                                            },
                                            {
                                                "example_id": "5a757d8e-e35d-4f55-9561-f40b699e5ed8",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "The identified case of “flurona,” as some have dubbed it, was relatively mild, according to doctors at Beilinson."
                                            },
                                            {
                                                "example_id": "a3f98595-3ace-4af9-9146-51b09530b9b6",
                                                "sense_id": "5bbd6642-a473-30e2-a86d-238e0a01d3ac",
                                                "text": "Amid the rising number of Omicron cases, Israel has recently detected another infection known as ‘Flurona.’ Flurona is a combined infection of coronavirus and influenza.\nAs per the latest reports, health experts detected the first case of flurona in a pregnant woman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
