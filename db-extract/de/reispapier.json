                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ca2b984-82f2-3ad9-9e36-7b0a48aa4fac",
                        "entry_id": "853aa925-7aa9-3e5f-87a9-653ffd5ed55f",
                        "glosses": [
                            "aus dem Wurzelmark von Reis oder ähnlichen Pflanzen hergestelltes Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5248d2d-16f8-47a2-ba88-3ff3ca287626",
                                "sense_id": "1ca2b984-82f2-3ad9-9e36-7b0a48aa4fac",
                                "text": "„Ich half auf den Feldern und in den Küchen, lief ständig mit einem verkohlten Stöckchen und Reispapier herum, zeichnete unbeholfene Kinderbilder.“"
                            },
                            {
                                "example_id": "7e0a9936-ffe0-40b9-be3f-3b446a0a09c8",
                                "sense_id": "1ca2b984-82f2-3ad9-9e36-7b0a48aa4fac",
                                "text": "„Die Haut des Märtyrers war glatt und fein wie Reispapier, sein Haar glänzte schwarz und seidig wie das Fell eines Panthers, und seine dunklen, tränenfeuchten Augen blickten unendlich milde drein, so als ahnten sie bereits die bevorstehende Tragödie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70dd44ce-7010-4ada-96cf-9df9f7dc3e65",
