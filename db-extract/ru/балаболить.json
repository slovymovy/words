                    }
                ],
                "senses": [
                    {
                        "sense_id": "e438274c-beac-3cc4-a2c8-4a72baddfbcb",
                        "entry_id": "73f952f9-b3c2-3ead-a9cb-31e2618cf13f",
                        "glosses": [
                            "разг. говорить пустяки; болтать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597521e4-3413-42e2-9b56-2f5ffc6e4abb",
                                "sense_id": "e438274c-beac-3cc4-a2c8-4a72baddfbcb",
                                "text": "— Обещаю, что ни один волос не упадёт с вашей головы, если вы не будете трепыхаться и балаболить."
                            }
                        ]
                    },
                    {
                        "sense_id": "deb1cc78-8ca7-3563-aa8f-ae7f52790b5e",
                        "entry_id": "73f952f9-b3c2-3ead-a9cb-31e2618cf13f",
                        "glosses": [
                            "мол., жарг., : много говорить, болтать; тараторить"
                        ],
                        "tags": [
                            "с кем?, о чём?; что?"
                        ],
                        "examples": [
                            {
                                "example_id": "6b65f230-61af-4218-9d8c-0dae7345c87e",
                                "sense_id": "deb1cc78-8ca7-3563-aa8f-ae7f52790b5e",
                                "text": "— Как ты не устаёшь балаболить? Столько уже лишнего наплёл!"
                            },
                            {
                                "example_id": "63e85ff4-81ff-47d6-bfd5-7ae494cf18d5",
                                "sense_id": "deb1cc78-8ca7-3563-aa8f-ae7f52790b5e",
                                "text": "— Хватит вам балаболить, водка стынет. Ну, будем живы!"
                            }
                        ]
                    },
                    {
                        "sense_id": "21d7e12d-10e8-3f96-bd63-813d653dbb12",
                        "entry_id": "73f952f9-b3c2-3ead-a9cb-31e2618cf13f",
                        "glosses": [
                            "крим. жарг. выбалтывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b09ce6-9fc7-4c4c-9912-187ced742875",
                                "sense_id": "21d7e12d-10e8-3f96-bd63-813d653dbb12",
                                "text": "Сутенёры заметают следы[.] — Ну сначала нас всех собрали в Кишинёве, — с акцентом балаболила самая сисястая — Катя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ae4ae2-0d95-4466-b263-92e51ca1ba39",
                        "source_entry_id": "73f952f9-b3c2-3ead-a9cb-31e2618cf13f",
                        "source_sense_description": "говорить пустяки; болтать",
                        "target_lang_word": "chatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "Talk, especially meaningless or unimportant talk."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e171e5-318a-43fb-978c-0d25da73b0ff",
                                                "sense_id": "f85ca0b6-dd3a-3506-b15f-0f8dc696c496",
                                                "text": "Although hardly coming under my theme, I cannot omit this: \"Against a woman's chatter: Taste at night fasting a root of radish, that day the chatter cannot harm thee.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc2605-3980-3119-8c62-fb5c7008afd7",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The sound of talking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72b03cd0-281f-32f5-9152-581da9a557aa",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of a Eurasian magpie, Pica pica."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The vocalisations of various birds or other animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "214c9d92-da3a-4904-83fe-c557ab7484f0",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The hare cried and complained of the terrible February cold and the disgusting chatter of the owls[.]"
                                            },
                                            {
                                                "example_id": "e1d5138f-31ff-44ba-81bc-b421baa784a7",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "At dawn and at sunset the howler monkeys screamed together and the parakeets broke into shrill chatter, but during the hot hours of the day only the full drone of insects, like the beat of a distant surf, filled the ear, while nothing moved amid the solemn vistas of stupendous trunks, fading away into the darkness which held us in."
                                            },
                                            {
                                                "example_id": "345459e4-375a-48fe-92c6-99e98018933a",
                                                "sense_id": "db44ac2f-a088-3519-8464-ac264d1ec9fe",
                                                "text": "The wind rose as the earth darkened, so that fading chatters of woodland animals were countered by the strengthening sounds of waving trees […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "An intermittent noise, as from vibration."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e2d543-0fec-4429-89cf-ea0d32e2fe89",
                                                "sense_id": "66a27350-ef10-3911-98ce-437a3befd249",
                                                "text": "Proper brake adjustment will help to reduce the chatter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "In national security, the degree of communication between suspect groups and individuals, used to gauge the degree of expected terrorist activity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a811908-7320-4dfa-a4a5-8e6e8d94d1c9",
                                                "sense_id": "61010195-9eef-350b-8561-bc507a46ef2c",
                                                "text": "The NSA is concerned about increased chatter between known terror groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131a1b05-3719-3e98-864c-60d0b8c84c76",
                                        "entry_id": "73c75052-15a6-3ffd-b129-04fcd0a7b668",
                                        "glosses": [
                                            "The situation where a drill or similar tool vibrates and tears the material rather than cutting it cleanly."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To talk idly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b50502d4-151b-4013-a637-785d90577d79",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "They knitted and chattered the whole time."
                                            },
                                            {
                                                "example_id": "52901761-1456-4f98-a346-c27a6186dff8",
                                                "sense_id": "7e0f1f2d-4edb-364f-98c0-eddbddc1f577",
                                                "text": "That teacheth trickes eleuen and twentie long, / To tame a ſhrew, and charme her chattering tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To make a noise by rapid collisions."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923acaea-15da-4199-a7dc-e73ed1fb39aa",
                                                "sense_id": "8b26fbf5-2412-3f5a-a621-c8a53ad3bd27",
                                                "text": "He was so cold that his teeth were chattering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                        "entry_id": "b47829c6-7743-3509-a518-b32db18309a4",
                                        "glosses": [
                                            "To utter sounds which somewhat resemble language, but are inarticulate and indistinct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc7f89b-f55f-4808-8037-f252cc1237a3",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "The jay makes answer, as the magpie chatters with delight."
                                            },
                                            {
                                                "example_id": "24f2a94d-9047-4076-9bde-bd056c2cdfe7",
                                                "sense_id": "3d687982-9e42-3e61-825e-7f023636a8cb",
                                                "text": "Is your cat intently staring out the window at a bird on a branch and “chattering” in a kind of shaky, high-pitched, breathy way? If so, she is expressing excitement at what she's observing (or maybe the desire to attack what she sees as prey)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "599b4609-7d6c-3e56-8cac-d0c4010e3afc",
                                        "entry_id": "6318f1d0-f98f-3e57-b127-3645d75e8ae9",
                                        "glosses": [
                                            "One who chats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b71c1d8-abbf-3c80-8048-91ffd49d2eb3",
                                        "entry_id": "6318f1d0-f98f-3e57-b127-3645d75e8ae9",
                                        "glosses": [
                                            "A user of chat rooms."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6527e415-644c-451e-80aa-743d7db842da",
                                                "sense_id": "4b71c1d8-abbf-3c80-8048-91ffd49d2eb3",
                                                "text": "During the chat sessions, two outreach team members would engage in a conversation about the topic chosen for that event in the main chat room and entice other chatters to join in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b00fb7-538b-45c2-9fe7-25308432959d",
                        "source_entry_id": "73f952f9-b3c2-3ead-a9cb-31e2618cf13f",
                        "source_sense_description": "говорить пустяки; болтать",
                        "target_lang_word": "jabber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jabber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d710209-d913-3165-89af-0ef19cb56556",
                                        "entry_id": "8dcdff97-56f2-3ebe-9be6-d829ad669640",
                                        "glosses": [
                                            "To talk rapidly, indistinctly, or unintelligibly; to utter gibberish or nonsense."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf63acf-e816-4d29-b150-b63de46f84f4",
                                                "sense_id": "3d710209-d913-3165-89af-0ef19cb56556",
                                                "text": "1829, James Hogg, The Shepherd’s Calendar, New York: A.T. Goodrich, Volume I, Chapter 9, “Mary Burnet,” p. 184,\nAllanson made some sound in his throat, as if attempting to speak, but his tongue refused its office, and he only jabbered."
                                            },
                                            {
                                                "example_id": "7bc84dac-9f11-43d6-b03c-39db9467112f",
                                                "sense_id": "3d710209-d913-3165-89af-0ef19cb56556",
                                                "text": "“What are you jabbering about, shipmate?” said I."
                                            },
                                            {
                                                "example_id": "e0c499c6-95ef-40db-a499-4562ef4abd1b",
                                                "sense_id": "3d710209-d913-3165-89af-0ef19cb56556",
                                                "text": "The noise of their battle with Numa had drawn an excited horde of savages from the nearby village, and a moment after the lion’s death the two men were surrounded by lithe, ebon warriors, gesticulating and jabbering—a thousand questions that drowned each ventured reply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1281f6a-3d76-310c-99ef-4fdaf4d082f3",
                                        "entry_id": "8dcdff97-56f2-3ebe-9be6-d829ad669640",
                                        "glosses": [
                                            "To utter rapidly or indistinctly; to gabble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab506a7d-b124-4152-95ba-50e2ea0dcefb",
                                                "sense_id": "c1281f6a-3d76-310c-99ef-4fdaf4d082f3",
                                                "text": "She had Lord James' collar in one big fist and she pounded the table with the other and talked a blue streak. Nobody could make out plain what she said, for she was mainly jabbering Swede lingo, but there was English enough, of a kind, to give us some idee."
                                            },
                                            {
                                                "example_id": "656103e6-7961-43d5-9e3b-9b7538eeb92f",
                                                "sense_id": "c1281f6a-3d76-310c-99ef-4fdaf4d082f3",
                                                "text": "He wept very little, but when he wept he howled aloud, and jabbered wild abuse, threats and recriminations through the wet torrent of his howling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jabber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac11dbf-0080-3f48-89b4-afbf953b0441",
                                        "entry_id": "79b9e11f-7d90-3143-a409-ae872ec8fcbf",
                                        "glosses": [
                                            "Rapid or incoherent talk, with indistinct utterance; gibberish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14ac854-c3d8-4d39-a8f7-007b22c8ff3f",
                                                "sense_id": "cac11dbf-0080-3f48-89b4-afbf953b0441",
                                                "text": "1735, Jonathan Swift, Gulliver’s Travels, in The Works of Jonathan Swift, edited by George Faulkner, Dublin, 1735, Volume 3, A Letter from Capt. Gulliver to his Cousin Sympson, pp. v-vi,\nAnd, is there less Probability in my Account of the Houyhnhnms or Yahoos, when it is manifest as to the latter, there are so many Thousands even in this City, who only differ from their Brother Brutes in Houyhnhnmland, because they use a Sort of a Jabber, and do not go naked."
                                            },
                                            {
                                                "example_id": "5fb219a7-4296-40f4-b627-29f946642e0e",
                                                "sense_id": "cac11dbf-0080-3f48-89b4-afbf953b0441",
                                                "text": "Two tongues from the depths,\nAlike only as a yellow cat and a green parrot are alike,\nFling their staccato tantalizations\nInto a wildcat jabber\nOver a gossamer web of unanswerables."
                                            },
                                            {
                                                "example_id": "c35ea159-0c1a-4e34-9ca3-8064d14c1123",
                                                "sense_id": "cac11dbf-0080-3f48-89b4-afbf953b0441",
                                                "text": "Mark Pauline has a good line of gab, in his elliptical, left-handed fashion. He's at relative rhetorical ease with classy theoretical jabber such as emergent behavior, cyborganics, chaos theory, transparent interfaces, artificial life, and the machinic phylum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jabber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f729aa-e25e-34d2-8776-d1fae28dfddb",
                                        "entry_id": "5b804dd9-3914-3dc1-9fc1-7bb98c934ce1",
                                        "glosses": [
                                            "One who or that which jabs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6047d0d-7d09-43ac-b3ab-cf0d20e97622",
                                                "sense_id": "a7f729aa-e25e-34d2-8776-d1fae28dfddb",
                                                "text": "Have the boys box, one jabbing and the other practicing the methods of boxing a jabber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a590ea-6b20-3fd5-91f4-d514cfdd33df",
                                        "entry_id": "5b804dd9-3914-3dc1-9fc1-7bb98c934ce1",
                                        "glosses": [
                                            "One who administers a hypodermic injection."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4684bc-fd6d-42bb-9eb2-442b12719eb8",
                                                "sense_id": "93a590ea-6b20-3fd5-91f4-d514cfdd33df",
                                                "text": "Like Claire, these “secret jabbers” are keeping it private even from their closest family and friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e45fcc-f27f-3e46-9442-4ffb20b49516",
                                        "entry_id": "5b804dd9-3914-3dc1-9fc1-7bb98c934ce1",
                                        "glosses": [
                                            "A kind of hand-operated corn planter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ef702e-c385-4944-a320-25b2896b893b",
                                                "sense_id": "f1e45fcc-f27f-3e46-9442-4ffb20b49516",
                                                "text": "The jabber was the most popular hand-operated corn planter ever devised. […] Inset shows jaws closed for jabbing (left) and open for depositing kernels (right)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
