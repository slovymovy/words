            {
                "entry_id": "5d1f074e-0aa2-3d06-9aa4-294638cb2368",
                "word": "dickens",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c292de4f-73a1-35d4-8b72-789ca152f206",
                        "entry_id": "5d1f074e-0aa2-3d06-9aa4-294638cb2368",
                        "glosses": [
                            "The devil."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "b9e0b472-4b57-4a59-a03c-0f1780a7c8b8",
                                "sense_id": "c292de4f-73a1-35d4-8b72-789ca152f206",
                                "text": "She can go to the dickens for what she said."
                            },
                            {
                                "example_id": "ced24ae1-3734-4ac4-ab21-d3cbc9ea4958",
                                "sense_id": "c292de4f-73a1-35d4-8b72-789ca152f206",
                                "text": "You scared the dickens out of me."
                            },
                            {
                                "example_id": "060c1053-c4ff-450a-b75d-8121b927e4f8",
                                "sense_id": "c292de4f-73a1-35d4-8b72-789ca152f206",
                                "text": "“Four weeks ago, I was sitting down for breakfast with my beautiful wife, Evie. Evie and I were sitting down with our two beautiful little boys, Connor and C-C-- Cah-- ristopher, and Christopher looks up to me-- he's six years old and full of the dickens--”"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d49ea97-9cc8-3779-ba98-971aafd61074",
                        "entry_id": "5d1f074e-0aa2-3d06-9aa4-294638cb2368",
                        "glosses": [
                            "In the phrase the dickens (Used as an intensifier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4767127-c541-4141-a86f-3dfbeabbe596",
                                "sense_id": "7d49ea97-9cc8-3779-ba98-971aafd61074",
                                "text": "Why the dickens did he do that?"
                            },
                            {
                                "example_id": "0dfb60c0-9585-49bb-936d-99ff10bb045f",
                                "sense_id": "7d49ea97-9cc8-3779-ba98-971aafd61074",
                                "text": "We had the dickens of a row."
                            },
                            {
                                "example_id": "37bd2e5e-b951-42f2-9aeb-d5ad9652b7c5",
                                "sense_id": "7d49ea97-9cc8-3779-ba98-971aafd61074",
                                "text": "For quotations using this term, see the dickens."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c41e9ab-10f2-39f0-810e-e7553b1d7b1e",
                        "entry_id": "5d1f074e-0aa2-3d06-9aa4-294638cb2368",
                        "glosses": [
                            "A disturbance or row."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0ae77e-0476-48af-ab39-9398d4f6ed19",
                                "sense_id": "1c41e9ab-10f2-39f0-810e-e7553b1d7b1e",
                                "text": "Hugh considered saying, Then I guess I'll just have to kick you a few times instead, you frog son of a bitch. Then he thought of that fat bastard Keeton, handing him a pink slip for kicking up dickens in the local tavern."
                            },
                            {
                                "example_id": "28dfe98c-a8ea-4f9c-855a-d472ed01a6c0",
                                "sense_id": "1c41e9ab-10f2-39f0-810e-e7553b1d7b1e",
                                "text": "And lastly, thanks to my children, Dutch and Tallulah, for allowing me to see the magic of everything I love about popular culture anew through their eyes. This one is for you two dickens!"
                            }
                        ]
                    }
                ],
