                        "examples": [
                            {
                                "example_id": "086f5f76-6058-4088-ba37-0aed3ca2f373",
                                "sense_id": "96f9ec98-71df-3db4-ba46-ffebf0de3430",
                                "text": "Hagelkruisen plaatste men sedert de vroege middeleeuwen op kruispunten van landwegen, ter afwering van hagel en onweer."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c5fdf3c-37a1-33d6-8d33-8e9d3c595a11",
