                "translations": [
                    {
                        "translation_id": "ff8e1095-ffb8-415c-99a1-e1ddde132a50",
                        "source_entry_id": "1cb5c45c-d6ee-3400-8831-3c08d5b107f9",
                        "source_sense_description": "превращать из дикого состояния в культурное",
                        "target_lang_word": "cultivate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cultivate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd286f24-659b-377a-ba5f-366f9a4eb5f7",
                                        "entry_id": "a2b39661-f0b0-3b0f-a2fb-d2e5855a9f73",
                                        "glosses": [
                                            "To grow plants, notably crops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d2c787-cf1c-4447-b7a4-861f95485734",
                                                "sense_id": "fd286f24-659b-377a-ba5f-366f9a4eb5f7",
                                                "text": "Most farmers in this region cultivate maize."
                                            },
                                            {
                                                "example_id": "2323c93a-2343-4b52-91f8-41f369426f86",
                                                "sense_id": "fd286f24-659b-377a-ba5f-366f9a4eb5f7",
                                                "text": "So unhealthy is this valley, which is the home of large game, that whole kraals full of people who have tried to cultivate the rich land, have died in it of fever, or fled away leaving their crops unreaped."
                                            },
                                            {
                                                "example_id": "03d3a414-a825-4f9a-b9c1-7242b79f1de7",
                                                "sense_id": "fd286f24-659b-377a-ba5f-366f9a4eb5f7",
                                                "text": "My hobby is gathering the spores of some of the most delicious of the wild varieties of mushrooms, such as morels, giant puffballs and woods oysters, then cultivating them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                                        "entry_id": "a2b39661-f0b0-3b0f-a2fb-d2e5855a9f73",
                                        "glosses": [
                                            "To nurture; to foster; to tend."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab4d6d2-c9af-4b03-b5ff-e43ab43dc8fb",
                                                "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                                                "text": "They tried to cultivate an interest in learning among their students."
                                            },
                                            {
                                                "example_id": "566e6b05-aa50-4939-b104-41a2c2c36c83",
                                                "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                                                "text": "Left also to himself by guardians[…] he cultivated more his imagination than his judgment"
                                            },
                                            {
                                                "example_id": "904edfbc-aaa7-4897-a593-94b8cdc892d8",
                                                "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                                                "text": "The mix of ballet vocabulary, modern techniques and African steps is familiar, but the extent to which Mr. Rhoden packs — and overpacks — phrases, cultivates warp-speed delivery and hyperextends every possible hip jut and arabesque is, thank goodness, something special to Complexions."
                                            },
                                            {
                                                "example_id": "dce5133e-df18-4780-998e-1bbe9552f776",
                                                "sense_id": "049ea093-2d07-321e-9cba-8401ad229673",
                                                "text": "[…] after four years in which President Donald J. Trump had cultivated Mr. Johnson and expressed sympathy for Britain in its bitter divorce with the European Union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa4e04e-1276-3a52-86ae-fa72f9ea4705",
                                        "entry_id": "a2b39661-f0b0-3b0f-a2fb-d2e5855a9f73",
                                        "glosses": [
                                            "To turn or stir soil in preparation for planting or as a method of weed control between growing crop plants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56e5c627-ff47-48f0-bedd-787009665798",
                        "source_entry_id": "1cb5c45c-d6ee-3400-8831-3c08d5b107f9",
