                            }
                        ]
                    }
                },
                {
                    "sense_id": "5893dcba-a159-3f15-8530-de4025e11623",
                    "sense_definition": "A formal legal document that contains the fundamental laws and principles of a state or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_framework",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers spent months drafting the <w>constitution</w> for the new republic.",
                            "target_lang_translations": {
                                "ru": "Юристы потратили месяцы на разработку проекта <w>конституции</w> для новой республики.",
                                "zh": "律师们花了几个月的时间为这个新共和国起草<w>宪法</w>。"
                            }
                        },
                        {
                            "text": "You can find the full text of the legal <w>constitution</w> in the national archives.",
                            "target_lang_translations": {
                                "ru": "Полный текст юридической <w>конституции</w> можно найти в национальных архивах.",
                                "zh": "你可以在国家档案馆找到该法律<w>宪法</w>的全文。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal constitution",
                        "draft a constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный юридический документ, содержащий основные законы и принципы государства или группы.",
                        "zh": "包含国家或团体基本法律和原则的正式法律文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конституция",
                                "target_lang_sense_clarification": "текст юридического документа"
                            },
                            {
                                "target_lang_word": "устав",
                                "target_lang_sense_clarification": "свод правил организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宪法",
                                "target_lang_sense_clarification": "国家法律文件"
                            },
                            {
                                "target_lang_word": "章程",
                                "target_lang_sense_clarification": "正式的组织规则文件"
                            }
                        ]
                    }
