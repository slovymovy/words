                    {
                        "translation_id": "d9474d52-c773-43cf-80b3-22f393e96edb",
                        "source_entry_id": "0564fd86-601e-38e9-8254-9f7409aef91d",
                        "source_sense_id": "127b10fa-526f-3b15-a24a-766326a4f179",
                        "source_sense_description": "small cardboard box in which matches are kept",
                        "target_lang_word": "luciferdoos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luciferdoos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "13042ea9-821b-3b97-aab2-f726d7d51d9f",
                                        "entry_id": "dd9d8f65-532c-388f-97db-56e0515478e4",
                                        "glosses": [
                                            "een doos met lucifers meestal ook voorzien van een vlak waaraan men de lucifers door wrijven kan aansteken, meestal in de verkleinvorm lucifersdoosje gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650eebe4-25b8-44b2-9c06-c44af748ef1f",
                                                "sense_id": "13042ea9-821b-3b97-aab2-f726d7d51d9f",
                                                "text": "Twee jaar geleden verbaasde Sony Ericsson iedereen met de X10 mini, een Android-telefoon die zo klein was dat het bijna onbruikbaar werd. De Xperia mini blijft op de maat van een luciferdoos, maar oef: het is net iets groter geworden."
                                            },
                                            {
                                                "example_id": "cc2dfbfa-f84d-49ea-b384-a92ced12c211",
                                                "sense_id": "13042ea9-821b-3b97-aab2-f726d7d51d9f",
                                                "text": "De ontwerpers zelf noemen het een luciferdoos. Afgezien dan van de lucifers lijkt die vergelijking aardig te kloppen. Het huis dat vlak voor de bebouwde kom van Hengevelde opdoemt, langs de weg naar Bentelo, ligt als een platte doos in het landschap. Wie er langskomt, kijkt vanzelf opzij. Moderne architectuur op het platteland springt nog altijd meer in het oog dan in de grote stad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e04cd0c-62b9-4809-96b4-1d95a68cd810",
                        "source_entry_id": "0564fd86-601e-38e9-8254-9f7409aef91d",
                        "source_sense_id": "127b10fa-526f-3b15-a24a-766326a4f179",
