                "senses": [
                    {
                        "sense_id": "0dbf9031-da8c-3c12-989c-b103f5eec577",
                        "entry_id": "3e977283-fd70-3486-86fd-2008cd6de4ca",
                        "glosses": [
                            "Officier royal ou seigneurial des Eaux et Forêts, chargé de juger en première instance les délits et malversations commis dans les bois dont il a la charge."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": [
                            {
                                "example_id": "5cc51e56-3e35-4bff-adae-d99d5b942478",
                                "sense_id": "0dbf9031-da8c-3c12-989c-b103f5eec577",
                                "text": "En 79, nous vous avons fait gruyer de la forêt de Senart."
                            },
                            {
                                "example_id": "a9ed8ce0-e27d-4d72-809e-984970e6b3b5",
                                "sense_id": "0dbf9031-da8c-3c12-989c-b103f5eec577",
                                "text": "Les revenus des forêts sont assez soigneusement consignés par écrit ; le moindre denier gagné ou dépensé doit être justifié par le gruyer auprès des responsables des finances ducales."
                            },
                            {
                                "example_id": "7ab8a815-d532-4247-babf-bc9fd3432b17",
                                "sense_id": "0dbf9031-da8c-3c12-989c-b103f5eec577",
                                "text": "Après le rattachement de la Comté au royaume de France (1678), la forêt de Chaux entre dans \"le monde moderne\" de l'administration française. Un grand maître des Eaux et Forêts, une ribambelle d'huissiers, d'arpenteurs et d'autres maîtres remplacent les gruyers d'autrefois pour \"surveiller et inspecter les bois\"."
                            }
                        ]
                    }
