                ],
                "senses": [
                    {
                        "sense_id": "de062eeb-5a34-33ae-9f3d-befa37c6e221",
                        "entry_id": "9821a96e-f3ff-30cf-90f8-03d44a8c230d",
                        "glosses": [
                            "женск. к индиец; жительница или уроженка Индии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3a79a0-a31a-44ce-8a1b-75a061fd8004",
                                "sense_id": "de062eeb-5a34-33ae-9f3d-befa37c6e221",
                                "text": "Так вот, эта еврейская индианка в зарисовке представляется абсолютной параноичкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "30078696-dac7-3922-9855-0341e586847d",
                        "entry_id": "9821a96e-f3ff-30cf-90f8-03d44a8c230d",
                        "glosses": [
                            "женск. к индеец; представительница коренного населения Америки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ea68bf-3e27-40fb-9c2e-8c90eb7c6208",
                                "sense_id": "30078696-dac7-3922-9855-0341e586847d",
                                "text": "Там жила одна милая, способная и даже относительно образованная девушка-индианка, ирокезского племени."
                            },
                            {
                                "example_id": "45f72e34-cf33-4c70-8a45-4d03ced7a24a",
                                "sense_id": "30078696-dac7-3922-9855-0341e586847d",
                                "text": "Возле индейца сидела старая индианка с опухшей ногой."
                            }
                        ]
                    }
                ],
                "translations": [],
