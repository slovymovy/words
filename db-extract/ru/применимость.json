                                        "sense_id": "0b2f941a-37f2-3ae7-8397-0477c985fd32",
                                        "entry_id": "7d507125-1467-3354-a0c4-51bb3ee4aabb",
                                        "glosses": [
                                            "iets dat praktisch te gebruiken is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
