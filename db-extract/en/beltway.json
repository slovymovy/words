                    },
                    {
                        "sense_id": "c5697bff-aa62-3e5a-a923-15d8f32b9b2d",
                        "entry_id": "aa904dec-0497-319b-b63e-d857c413eb86",
                        "glosses": [
                            "The expressway that surrounds another city."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "995f34e0-156a-3f1a-a286-eb9254fba2a2",
                        "entry_id": "aa904dec-0497-319b-b63e-d857c413eb86",
                        "glosses": [
                            "The US federal government and policy and lobbying organizations, located in Washington, D.C."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "503cee9f-c852-4b73-b259-39e8757de363",
                                "sense_id": "995f34e0-156a-3f1a-a286-eb9254fba2a2",
                                "text": "But given that it takes 60 votes to beat a filibuster and 66 to override a veto, and given that the GOP has since added four hard-right senators to its total, it’s safe to say that nothing will be happening inside the Beltway anytime soon."
                            },
                            {
                                "example_id": "4cb18fd0-3b71-4afc-b5ff-8cd6394ff122",
                                "sense_id": "995f34e0-156a-3f1a-a286-eb9254fba2a2",
                                "text": "While not the entirety of the reason why the Beltway struggles to shed its imperial hubris and adapt to the new multipolar world, (much of that is simply complacency) understanding democratism’s hold over the governing elite is vital for explaining the unique hostility found in so much of foreign policy commentary towards a soberer and more realistic appraisal of the world."
                            }
                        ]
                    }
