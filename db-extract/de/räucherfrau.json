                "senses": [
                    {
                        "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                        "entry_id": "4d059d1c-71a9-3d94-aba9-60037d3a1495",
                        "glosses": [
                            "kleine weibliche Figur aus zwei Teilen, auf deren unteren Teil eine kleine Räucherkerze gestellt wird, auf den der innen hohle obere Teil gesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8130cd6-9d9f-4adc-a7f3-954a0f4abdba",
                                "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                                "text": "„Was nur selten dabei ist: Räucherfrauen.“"
                            },
                            {
                                "example_id": "a06146bd-4958-472d-950b-377c2b0652de",
                                "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                                "text": "„Doch warum gibt es weniger Räucherfrauen als -männer?“"
                            },
                            {
                                "example_id": "11546330-c4ac-4796-a4c4-f81824a90415",
                                "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                                "text": "„Chemnitz ist migrantisch, postkolonial und hat mit eigens kreierten Räucherfrauen eine Vision für die Neuauflage von Traditionen.“"
                            },
                            {
                                "example_id": "3eee2a12-5c4d-4125-90e2-5c48403e4e28",
                                "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                                "text": "„Die Räuchermänner aber auch Räucherfrauen verkörpern die verschiedensten Handschriften und Werkstätten des Erzgebirges aus den zurückliegenden Jahrzehnten.“"
                            },
                            {
                                "example_id": "ad0bed56-d183-4276-a833-29033c4da1aa",
                                "sense_id": "aec1a758-5e3c-39ac-9daa-e86c6f15f22f",
                                "text": "„Reichl und seine knapp 50 Mitarbeiter umfassende Belegschaft hoffen auf einen ähnlichen großen Erfolg wie mit Räucherfrau Angela Merkel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
