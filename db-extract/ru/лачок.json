                "senses": [
                    {
                        "sense_id": "01a2b193-84c8-3002-812d-9f330bde6b58",
                        "entry_id": "6093fa67-9adf-367d-a4e1-6a645380654e",
                        "glosses": [
                            "уменьш.-ласк. к лак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44186f6e-bdf2-4366-a141-a86b7fc2866c",
                                "sense_id": "01a2b193-84c8-3002-812d-9f330bde6b58",
                                "text": "Моисеенко и тут нас выручил, он взял старый рубаночек, покрыл его лачком, и в самом темном углу, в паутине, прибил."
                            },
                            {
                                "example_id": "3f38f00f-1bd8-4f7e-83b5-ae38b60c1a40",
                                "sense_id": "01a2b193-84c8-3002-812d-9f330bde6b58",
                                "text": "Такой лачок, понятно, не в лавках покупали, а сами варили."
                            }
                        ]
                    }
