                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7e6d61d-a94e-3684-873b-71bef441b61b",
                        "entry_id": "8554aa64-1a64-381f-85c7-25ede4a5c02c",
                        "glosses": [
                            "het slaperiger, en rustiger worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65526fd8-6625-4e09-bbe2-70ff7e61f147",
                                "sense_id": "a7e6d61d-a94e-3684-873b-71bef441b61b",
                                "text": "In zo'n ogenblik van versuffing of onoplettendheid blijkt dat ik nog steeds, of meer dan ooit, rekening houd met een terugkeer van Tonio in ons midden."
                            },
                            {
                                "example_id": "7cc615a8-dce1-499e-b27d-55f679a7283b",
                                "sense_id": "a7e6d61d-a94e-3684-873b-71bef441b61b",
                                "text": "Vrieskou of niet, John Jansen van Galen houdt van wandelen. In zijn nieuwe boek Wandelparadijs Nederland schrijft hij over het \"wandelwalhalla\" dat Nederland met zijn \"polderjungle\" is. Hij en Rob Trip praten over Johns favoriete wandelgebied en het \"aangenaam soort versuffing\" dat hij voelt als hij de landschappen in zich opneemt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbfaf336-4b16-4eeb-930f-6648651865ab",
                        "source_entry_id": "8554aa64-1a64-381f-85c7-25ede4a5c02c",
                        "source_sense_id": "a7e6d61d-a94e-3684-873b-71bef441b61b",
                        "source_sense_description": "het slaperiger, en rustiger worden",
                        "target_lang_word": "swoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba257899-d0d8-384f-9158-f62ab427f3f1",
                                        "entry_id": "26d497b3-9ec7-33aa-8fc7-bbbba60ca296",
                                        "glosses": [
                                            "A faint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1d34d5-ee49-42a3-976b-7894efd0e043",
                                                "sense_id": "ba257899-d0d8-384f-9158-f62ab427f3f1",
                                                "text": "She dandled it, and dancet it up and doune, / Not ceasing till she rais'd it from his swoune."
                                            },
                                            {
                                                "example_id": "b0a931cd-885b-4e15-8483-c9e6e2b00541",
                                                "sense_id": "ba257899-d0d8-384f-9158-f62ab427f3f1",
                                                "text": "\"I felt my strength fading away, and I was in a half swoon. How long this horrible thing lasted I know not, but it seemed that a long time must have passed before he took his foul, awful, sneering mouth away. I saw it drip with the fresh blood!\""
                                            },
                                            {
                                                "example_id": "96972628-ae1b-4684-91ec-e7ec47ec14d1",
                                                "sense_id": "ba257899-d0d8-384f-9158-f62ab427f3f1",
                                                "text": "As he drew near the throne, a rushing whirlwind arose in the corner of the hall and, lo! from the roof beams floated down a monstrous black serpent that coiled itself up on the very seat of majesty. The Emperor fell in a swoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc42a19-156b-3175-b350-656035fc31c6",
                                        "entry_id": "26d497b3-9ec7-33aa-8fc7-bbbba60ca296",
                                        "glosses": [
                                            "An infatuation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333fb089-4f7a-3237-908f-794897f6b8ed",
                                        "entry_id": "96664ad2-d7a9-3d76-acb5-714ede7a0306",
                                        "glosses": [
                                            "To faint, to lose consciousness."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7cac302-10cf-486d-ab12-c3f9b0fa9c91",
                                                "sense_id": "333fb089-4f7a-3237-908f-794897f6b8ed",
                                                "text": "I threw myself down on the island ground, like a dead man, and drowned in desolation swooned away, nor did I return to my senses till next morning, when the sun rose and revived me."
                                            },
                                            {
                                                "example_id": "9c69c2aa-e429-4efc-8f0e-81d57aa92608",
                                                "sense_id": "333fb089-4f7a-3237-908f-794897f6b8ed",
                                                "text": "I dropped the vessel quickly to a lower level. Nor was I a moment too soon. The girl had swooned."
                                            },
                                            {
                                                "example_id": "ec12c145-385c-4652-bd26-e52cc1f22719",
                                                "sense_id": "333fb089-4f7a-3237-908f-794897f6b8ed",
                                                "text": "He's got more than just mad skill / He's got a beaver tail and a bill. / And the women swoon whenever they hear him say…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd1ba7c-3b3c-3fa0-bfea-cb8fceee4131",
                                        "entry_id": "96664ad2-d7a9-3d76-acb5-714ede7a0306",
                                        "glosses": [
                                            "To be overwhelmed by emotion, especially infatuation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d236d5c1-5fd0-3970-9cd7-545dcf1f762f",
                                        "entry_id": "96664ad2-d7a9-3d76-acb5-714ede7a0306",
                                        "glosses": [
                                            "To overwhelm with emotion, especially infatuation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60300ff1-d76c-4c1f-8b12-7288aa762a07",
                                                "sense_id": "d236d5c1-5fd0-3970-9cd7-545dcf1f762f",
                                                "text": "That plush mustache of yours has completely swooned me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c40539-2cd0-3efd-8444-931a045d0a31",
                                        "entry_id": "96664ad2-d7a9-3d76-acb5-714ede7a0306",
                                        "glosses": [
                                            "To make a moan, sigh, or some other sound expressing infatuation or affection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19e046d-3e61-4366-a842-a87b821ebc7d",
                                                "sense_id": "85c40539-2cd0-3efd-8444-931a045d0a31",
                                                "text": "The girls swooned at the picture of their favorite actor."
                                            },
                                            {
                                                "example_id": "ca5ca85c-4dc0-4e0c-ae0e-60eb0fa9fd26",
                                                "sense_id": "85c40539-2cd0-3efd-8444-931a045d0a31",
                                                "text": "2013 (November 2), Pinky, 10 minutes into episode 25 (\"The Spy Who Slimed Me\") of TV series \"Pac-Man and the Ghostly Adventures\" per closed captions\n[Swoons] For sure. He's totally dreamy. Uh--but my heart still belongs to you, Pac-ums."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
