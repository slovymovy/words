                "senses": [
                    {
                        "sense_id": "501d2bfc-2733-37c2-8282-ba54b9f782fd",
                        "entry_id": "fe0b6fb8-b191-3738-b7e5-67b61d60ef66",
                        "glosses": [
                            "przekazanie prywatnym właścicielom mienia państwowego lub komunalnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b473e58-8ffc-44f3-9066-cb284ac9c9d5",
                                "sense_id": "501d2bfc-2733-37c2-8282-ba54b9f782fd",
                                "text": "W chwili obecnej, ze względu na zastrzeżenia Ministra Skarbu Państwa, trwa kontrola procesu prywatyzacji ww. spółek, prowadzona przez Najwyższą Izbę Kontroli oraz Departament Kontroli MSP."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb6275fd-987c-4334-ac93-d81fecc93671",
                        "source_entry_id": "fe0b6fb8-b191-3738-b7e5-67b61d60ef66",
                        "source_sense_id": "501d2bfc-2733-37c2-8282-ba54b9f782fd",
                        "target_lang_word": "privatisation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privatisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bafe3fc-d7fd-370d-afd3-3afafe8b52e7",
                                        "entry_id": "4f0770eb-b3a3-3095-be49-e5be6d997f44",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of privatization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59c535c-648c-4842-b162-acea92763262",
                                                "sense_id": "2bafe3fc-d7fd-370d-afd3-3afafe8b52e7",
                                                "text": "Some people have argued that it is our membership of the European Union which helped create the messy privatisation and everything that ensued. However, this is not the case. As mentioned above, it was the Conservative government which devised the complex structure of privatisation that emphasised the separation far beyond what was needed to follow EU rules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca063d28-e706-495c-9e4b-8f2462ee7c63",
                        "source_entry_id": "fe0b6fb8-b191-3738-b7e5-67b61d60ef66",
                        "source_sense_id": "501d2bfc-2733-37c2-8282-ba54b9f782fd",
                        "target_lang_word": "privatization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privatization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                        "entry_id": "fd1a9699-5ab9-3b43-967d-8c8ed0ca70f0",
                                        "glosses": [
                                            "The transfer of a company or organization from government to private ownership and control."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cac8263-dc9c-4da6-b3b9-f597dc12e1bf",
                                                "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                                "text": "Coordinate term: denationalization"
                                            },
                                            {
                                                "example_id": "000f76e3-3e37-4c0c-ad92-108172daa596",
                                                "sense_id": "8bb4dfd7-4b0e-3543-9bed-e4d27a06ae5a",
                                                "text": "The party, moreover, facilitates the accumulation of private fortunes and industrial empires by its foremost members and collaborators through ‘privatization’ and other measures, thereby intensifying centralization of economic affairs and government in an increasingly narrow group that may for all practical purposes be termed the national socialist elite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001367b8-dda9-38d9-b19a-9113a36a3941",
                                        "entry_id": "fd1a9699-5ab9-3b43-967d-8c8ed0ca70f0",
                                        "glosses": [
                                            "The rendering of a thought or an idea, as private in scope."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d7ca92-d392-44e8-8e11-27bf90acf492",
                                                "sense_id": "001367b8-dda9-38d9-b19a-9113a36a3941",
                                                "text": "Questioning the privilege of biology went hand in hand with a challenge to the privatization of the family and the notion that parents own children and may therefore treat them however they choose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
