                                "example_id": "9cad8bde-f5a1-4cf6-b2db-32f15effe358",
                                "sense_id": "f348cce8-c61f-387f-bd1c-3884990c34fe",
                                "text": "Vos waarschuwde de VVD ervoor een machtspartij te worden. Volgens hem is het ideologische kompas van de VVD \"op hol geslagen\"."
                            },
