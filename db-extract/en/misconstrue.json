                "senses": [
                    {
                        "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                        "entry_id": "9ad47e9d-a0ff-32ef-a422-d884ec8a927d",
                        "glosses": [
                            "To interpret erroneously, to understand incorrectly; to misunderstand."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e4514d6f-fda8-4db9-bcca-b6832d6157b4",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "His words were misconstrued as an insult."
                            },
                            {
                                "example_id": "57bd33fa-125a-4ea8-8fd7-54a1aebbf8d6",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "It’s easy to misconstrue her silence as agreement."
                            },
                            {
                                "example_id": "94c26ca5-1c25-4db8-8c3b-05c3fda6f282",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "misconstrue the meaning"
                            },
                            {
                                "example_id": "5d611e13-95ba-4a4f-8c8b-db6cef2a7b43",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "misconstrue someone’s intentions"
                            },
                            {
                                "example_id": "f9d9e129-17a5-402e-b3b3-c802d8b859d2",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "misconstrue remarks"
                            },
                            {
                                "example_id": "c6078777-6aff-4789-a202-d849d84bc09a",
                                "sense_id": "8ef8a1d9-78a3-3dd4-89e2-50aa81645780",
                                "text": "1975: Paul Simon, 50 Ways to Leave Your Lover from the album Still Crazy after All These Years.\n[…] furthermore, I hope my meaning won’t be lost or misconstrued […]"
                            }
                        ]
