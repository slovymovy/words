                "senses": [
                    {
                        "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                        "entry_id": "eae0a823-60cc-3541-b0cb-dbd864b4f200",
                        "glosses": [
                            "Angehöriger einer jugendlichen Subkultur mit betonter Ablehnung bürgerlicher Normen und Lebensformen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6683633e-db17-411c-a276-682eddb189f0",
                                "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                                "text": "Die Gammler erregten seinerzeit viel Aufsehen und ernteten fast nur Ablehnung."
                            },
                            {
                                "example_id": "64fe31f8-45f8-45d1-881e-d42705044b94",
                                "sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                                "text": "„Die ehemals Beklagte wendete dagegen ein, daß die Klägerin die Beklagte als »Trottel« und den Mitinhaber des von der ehemals Beklagten geführten Fahrschulunternehmens als »Depp«, »Hippie« und »Gammler«, der »blöd genug« gewesen sei, »der Beklagten auch noch Geld zu geben«, bezeichnet habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b7ff911-5854-4e59-b4eb-cf87d9965e1c",
                        "source_entry_id": "eae0a823-60cc-3541-b0cb-dbd864b4f200",
                        "source_sense_id": "1d3bc410-c13a-3f71-bd00-834cf92e6c83",
                        "source_sense_description": "Angehöriger einer jugendlichen Subkultur mit betonter Ablehnung bürgerlicher Normen und Lebensformen",
                        "target_lang_word": "vagrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d32e552-4109-3809-80d9-4ebddf581974",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "A person who wanders from place to place; a nomad, a wanderer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "A person without settled employment or habitation who usually supports himself or herself by begging or some dishonest means; a tramp, a vagabond."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617d0f3a-5c09-4ae8-a016-7de86e2444cd",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "Every morning before work, I see that poor vagrant around the neighbourhood begging for food."
                                            },
                                            {
                                                "example_id": "a909486c-cf91-408a-8778-d6d2c8f79d81",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "If it appear to the Juſtice by the confeſſion of the Vagrant, or by the Oath of one Witneſs, that he had no lawful Settlement ſince his Birth, and that he hath committed Acts of Vagrancy, or hath been a common Beggar, or Vagrant, for two Years laſt paſt, [...] then inſtead of puniſhing him, the Juſtice, or Juſtices, may bind him Apprentice for ſeven Years to the Perſon who apprehends him, or to any other Perſon who will receive him, and employ him in Great Britain, or in any of his Majeſty's Plantations."
                                            },
                                            {
                                                "example_id": "bc76b4f7-36c7-437c-8e50-c78aa752de5b",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "'Tis the cruel gripe / That lean hard-handed poverty inflicts, / The hope of better things, the chance to win, / The wiſh to ſhine, the thirſt to be amuſed, / That at the found of Winter's hoary wing, / Unpeople all our counties, of ſuch herds, / Of flutt'ring, loit'ring, cringing, begging, looſe / And wanton vagrants, as make London, vaſt / And boundleſs as it is, a crowded coop."
                                            },
                                            {
                                                "example_id": "f747cbc8-90fa-4270-98a9-1f557cdd7ec6",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "The most prominent body of delinquents in the rural districts are vagrants, and these vagrants appear to consist of two classes: first, the habitual depradators, house-breakers, horse-stealers, and common thieves; secondly, of vagrants, properly so called, who seek alms as mendicants."
                                            },
                                            {
                                                "example_id": "769b5b8e-05c5-4294-9b70-3a4d18445bae",
                                                "sense_id": "2f975353-6a2d-30e0-be00-11be022dcf88",
                                                "text": "Among vagrants are to be found thieves of every description, as well as a numerous host of the rankest impostors. [...] A great number amongst these daring impostors have been brought up vagrants from their infancy, and such as are bred up to it are naturally the most clever in acts of thieving, or in imposing upon the public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c35d04d-346e-312c-bc4c-925fe10e7b19",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "Vagrans egista, a widely distributed Asian butterfly of the family Nymphalidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd0d74a4-7769-369f-a324-2e3f7de6e82c",
                                        "entry_id": "f570d583-671f-3d10-9124-ffaf1ab2e2e0",
                                        "glosses": [
                                            "An animal, typically a bird, found outside its species' usual range."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vagrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6210b7-938e-3fb1-a0d9-b13a8c72f9ef",
                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Wandering from place to place, particularly when without any settled employment or habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81aad9e-3e82-4e0e-8027-8dc16eb80e07",
                                                "sense_id": "fd6210b7-938e-3fb1-a0d9-b13a8c72f9ef",
                                                "text": "a vagrant beggar"
                                            },
                                            {
                                                "example_id": "9d2a6161-19fa-4e41-b4fb-4c0f8300db0c",
                                                "sense_id": "fd6210b7-938e-3fb1-a0d9-b13a8c72f9ef",
                                                "text": "[A]ll and every idle, looſe and diſſolute perſon and perſons, which from and after the firſt day of July, One thouſand ſix hundred fifty ſeven, ſhall be found and taken within the Commonwealth of England, vagrant and wandring from his or their uſual place of living or abode, and ſhall not have ſuch good and ſufficient cauſe or buſineſs for ſuch his or their travelling or wandring, [...] ſhall be proceeded againſt and puniſhed as Rogues, Vagabonds and Sturdy Beggers within the ſaid Statute, [...]",
                                                "translation": "Julian calendar",
                                                "english": "Julian calendar"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d25e4a1-c84e-344b-baa8-3bae69ffbae5",
                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Of or pertaining to a vagabond or vagrant, or a person fond of wandering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                        "entry_id": "633607b6-f66e-3042-ac45-a964152cbc01",
                                        "glosses": [
                                            "Moving without a certain direction; roving, wandering; also, erratic, unsettled."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e7af44-2f50-4e40-896a-95da0759fdec",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "Let Prudence yet obſtruct thy venturous way; / And take good heed, what men will think and ſay: / That beauteous Emma vagrant courſes took; / Her father's houſe and civil life forſook; / That, full of youthful blood, and fond of man; / She to the wood-land with an exile ran."
                                            },
                                            {
                                                "example_id": "01d539a6-2ce0-48e1-bd25-f20b1337c0dd",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "While leading this vagrant and miserable life, Johnson fell in love."
                                            },
                                            {
                                                "example_id": "01bbd930-2292-4979-adad-b8f7abcceb38",
                                                "sense_id": "8b6e6497-309e-3bbe-bab5-9ecaa48f7965",
                                                "text": "I'll ply the fire with kindling / And pull the blankets to my chin / I'll lock the vagrant winter out / And I'll bolt my wandering in"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
