                                "target_senses": [
                                    {
                                        "sense_id": "7d626a8c-a221-3f83-9198-b2b116eb67d7",
                                        "entry_id": "9ea29313-f6a9-3815-a76d-7b452a2fc0e7",
                                        "glosses": [
                                            "infolge kultureller Überfeinerung entartet und ohne Kraft oder Widerstandsfähigkeit, im Verfall begriffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fff988e-0ee8-4109-8ed6-c05518b42dc6",
                                                "sense_id": "7d626a8c-a221-3f83-9198-b2b116eb67d7",
                                                "text": "Der dekadente Lebensstil der führenden Schichten Roms war mitschuld am Niedergang der römischen Republik."
                                            },
                                            {
                                                "example_id": "1f540791-f07e-43cb-9482-7428248c6ea4",
                                                "sense_id": "7d626a8c-a221-3f83-9198-b2b116eb67d7",
                                                "text": "„Wir haben Angst, dekadent und hedonistisch zu wirken.“"
                                            },
                                            {
                                                "example_id": "ad20f0cb-8053-4ec0-8842-36a91391437e",
                                                "sense_id": "7d626a8c-a221-3f83-9198-b2b116eb67d7",
                                                "text": "Aber dann hat mich eine Vision vom koksenden Schicky-Micky-Koch, der ständig dekadentere Speisenakrobatik zelebrieren muss um, wie man neudeutsch sagt, >trendy< zu sein, ganz schnell auf den Boden der Realität zurückgebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
