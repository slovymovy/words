                "senses": [
                    {
                        "sense_id": "04ef574c-e527-3808-94e9-0ce935d7e81e",
                        "entry_id": "e7ba7a11-4b80-373c-951c-f4e691e84228",
                        "glosses": [
                            "Balancement d’un astre autour de son axe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d2a71d-a953-4cb8-8147-495faf86e492",
                                "sense_id": "04ef574c-e527-3808-94e9-0ce935d7e81e",
                                "text": "Ainsi donc, la Lune montre sans cesse la même face à la Terre ; cependant, pour être exact, il faut ajouter que, par suite d’un certain balancement du nord au sud et de l’ouest à l’est appelé « libration », elle laisse apercevoir un peu plus de la moitié de son disque, soit les cinquante-sept centièmes environ."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec1baffd-15cd-3a18-aad9-583d3a60437a",
                        "entry_id": "e7ba7a11-4b80-373c-951c-f4e691e84228",
                        "glosses": [
                            "Balancement régulier, tel que celui d’un pendule."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
