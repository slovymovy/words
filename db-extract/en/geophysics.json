                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44bc98f9-1a23-4ee3-a230-50a132d786b8",
                        "source_entry_id": "247bf4a2-7b03-3ad9-98ff-960a0083281a",
                        "source_sense_id": "f0f8fb16-b82f-39bd-aa04-76bf63c31651",
                        "source_sense_description": "branch of earth science",
                        "target_lang_word": "géophysique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géophysique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc2a498-1c99-3ac5-aea4-183cec589ca4",
                                        "entry_id": "15f5e00c-12b2-3a50-a577-c106ebc2366a",
                                        "glosses": [
                                            "Relatif à la physique de la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc85016b-8e5e-41de-816e-f42d79187061",
                                                "sense_id": "ecc2a498-1c99-3ac5-aea4-183cec589ca4",
                                                "text": "La prospection géophysique est basée sur des phénomènes de pesanteur, de conductibilité électrique, de magnétisme, d’élasticité"
                                            },
                                            {
                                                "example_id": "a2ba48ab-edd5-43d2-95de-13bdb1e4f44a",
                                                "sense_id": "ecc2a498-1c99-3ac5-aea4-183cec589ca4",
                                                "text": "Le Préfet du Tarn, en complément d’une étude géophysique, a demandé également une étude de structure du viaduc."
                                            },
                                            {
                                                "example_id": "f7fc6e5f-2113-4525-8958-eb1fc6905665",
                                                "sense_id": "ecc2a498-1c99-3ac5-aea4-183cec589ca4",
                                                "text": "Leur étude, publiée ce jeudi 16 mai dans la revue Communications Earth & Environment, décrit la découverte, grâce à l’œil aguerri de Ghoneim, de la branche sur des photographies satellites, ainsi que la vérification géophysique de son cours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "géophysique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbe6c18-8d74-3aa8-b969-b745d7efd676",
                                        "entry_id": "43d1a417-5407-3179-a4c3-560cfde226ba",
                                        "glosses": [
                                            "Étude de la Terre par des méthodes quantitatives physiques (géothermie, magnétisme, sismologie, radioactivité, etc.)"
                                        ],
                                        "tags": [
                                            "Géophysique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4526612-bff4-4834-99f3-76bedc705c9c",
                                                "sense_id": "4bbe6c18-8d74-3aa8-b969-b745d7efd676",
                                                "text": "La licence STUE forme notamment aux métiers de la géologie et de la géophysique."
                                            },
                                            {
                                                "example_id": "aa1a17ae-563d-49f6-b73e-fe867a1d9aa7",
                                                "sense_id": "4bbe6c18-8d74-3aa8-b969-b745d7efd676",
                                                "text": "En géophysique, on soustrait très souvent la contrainte moyenne, c’est-à-dire la pression, afin de mettre en évidence les contraintes supplémentaires s’exerçant sur les matériaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d405b2a-c81f-4085-9fcd-96cce7ebb124",
                        "source_entry_id": "247bf4a2-7b03-3ad9-98ff-960a0083281a",
                        "source_sense_id": "f0f8fb16-b82f-39bd-aa04-76bf63c31651",
                        "source_sense_description": "branch of earth science",
                        "target_lang_word": "Geophysik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geophysik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                                        "glosses": [
                                            "Wissenschaft von den physikalischen Eigenschaften und Vorgängen der Erdkruste und des Erdinnern"
                                        ],
                                        "tags": [
                                            "im engeren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea743b0b-a646-444f-a3c2-fdc5b6ae1018",
                                                "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                                "text": "„Mit der Entdeckung der Röntgenbeugung konnte man die mineralogische Zusammensetzung auch von feinkristallinen Gesteinen bestimmen, mit der Entwicklung der Geophysik gewann man erstmals Erkenntnisse über das Innere der Erde.“"
                                            },
                                            {
                                                "example_id": "fca111e3-5100-44bc-9446-1c226b7a88b7",
                                                "sense_id": "925c9981-3b45-3c4f-97c3-1a484bd027df",
                                                "text": "„Savage und Peterson fanden 1963 mit Hilfe der Geophysik heraus, das sich der obere Teil des Gletschers schneller als der untere Teil bewegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff2e4754-8aec-3345-9f55-26ed0f2bd752",
                                        "entry_id": "c51446b3-a14f-3a17-b0cd-ee23a9afbeeb",
                                        "glosses": [
                                            "zusätzlich zu ^([1]) Physik der Ozeane und der Atmosphäre"
                                        ],
                                        "tags": [
                                            "im erweiterten Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db973487-8dca-447a-a198-10f01bec61e8",
                                                "sense_id": "ff2e4754-8aec-3345-9f55-26ed0f2bd752",
                                                "text": "Im Studium der Geophysik kann man auch Vorlesungen zur tropische und subtropische Meteorologie besuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
