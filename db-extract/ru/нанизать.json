                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0bb498f7-d51e-3e36-b611-6e4a45e9eb01",
                        "entry_id": "41ebde09-78cf-3c4e-87ac-60a0b27f2b35",
                        "glosses": [
                            "перен. подобрать, присоединить что-либо друг к другу (слова, фразы, мысли и т. п.)"
                        ],
                        "tags": [],
