                        "form": "die Hexerei"
                    },
                    {
                        "form_id": "455fd20f-a207-429d-96e2-c8ea9c2da8c5",
                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hexereien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "glosses": [
                            "Handlung einer Person, der unterstellt wird, über magische Kräfte zu verfügen und diese in der Regel zum Nachteil anderer einzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b476363-468a-4bff-8d72-dff40a9765c7",
                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                "text": "„Es gibt durchaus mehrere Theorien über den Ursprung des Hexenwahns und der daraus erwachsenen Verfolgung von Frauen, die der Hexerei beschuldigt worden sind.“"
                            },
                            {
                                "example_id": "bc64f4bc-56d3-4c10-989f-131d1d9aff85",
                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                "text": "„Denn dieses Ausnahmeverfahren versagte jeder wegen Hexerei angeklagten Person das Recht auf eine ordnungsgemäße Verteidigung, die sonst allen anderen Angeklagten im ordentlichen Gerichtsverfahren zustand.“"
                            },
                            {
                                "example_id": "f9f2511c-4c06-46dd-b114-5ccef688599d",
                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                "text": "„Der Roszkower Rabbi hatte erklärt, es sei verboten, bei so etwas mitzumachen, weil das Hexerei sei.“"
                            },
                            {
                                "example_id": "633ad1eb-776f-4214-ba99-860eaeb4ceb4",
                                "sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                                "text": "„Er soll die letzten der Hexerei verdächtigen Frauen aus dem Kerker befreit haben, bevor es zu einem Prozess kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                        "entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "glosses": [
                            "unerwartet/ungewöhnlich erfolgreiche Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b40a610-0e9a-40b8-9a51-07bb4d20719b",
                                "sense_id": "695cec1e-60f2-3c85-86b6-19e071f8b999",
                                "text": "Es grenzt an Hexerei, dass das Fest trotz der geringen Vorbereitungszeit noch organisiert werden konnte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d3bcf77-2f6c-43b8-b72e-7907719dbf5f",
                        "source_entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "source_sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                        "target_lang_word": "witchcraft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witchcraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "The practice of witches; magic, sorcery, or the use of supernatural powers to influence or predict events."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031100e1-0263-460d-a595-01e215d26163",
                                                "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                                "text": "Wiccans believe in a modernised form of witchcraft."
                                            },
                                            {
                                                "example_id": "a7307344-675b-47f0-89c2-530daa610843",
                                                "sense_id": "a7944a7f-31ba-336d-86dd-33473b966891",
                                                "text": "Such witchcraft has no power now to show itself, because the people don't believe in it any more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb7a9d1-2e0f-3297-9301-688327943c7b",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "Black magic; the use of witchcraft for evil means."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17498fa9-4eb5-4e41-9081-23441a520601",
                                                "sense_id": "9fb7a9d1-2e0f-3297-9301-688327943c7b",
                                                "text": "The Bible warns against the use of witchcraft and sorcery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873f70a4-e1c6-3aa1-9ef2-24e8bd2944f4",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "Something, such as an advanced technology, that seems almost magical."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef02ce52-a674-4133-bfab-44680e503d88",
                                                "sense_id": "873f70a4-e1c6-3aa1-9ef2-24e8bd2944f4",
                                                "text": "There can be no denying that the more than 100 exhibiting companies and divisions also gave full play to examples of their latest technological witchcraft, as befits the foremost US aerospace event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68351f39-13ad-3355-b787-43614ddf667c",
                                        "entry_id": "1b5b571d-709c-3dac-841c-4735d7f9adaa",
                                        "glosses": [
                                            "An irresistible or seemingly magical influence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59a102e0-be78-4001-968f-b38c91e60fd0",
                        "source_entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "source_sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                        "target_lang_word": "witchery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "witchery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                                        "glosses": [
                                            "Witchcraft."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ad2205-876f-4d21-9f1e-63449c7b75c2",
                                                "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                                                "text": "You are right to some extent in what you say. In the olden days people had a stronger belief in all kinds of witchery; now they pretend not to believe in it, that they may be looked upon as sensible and educated people, as you say."
                                            },
                                            {
                                                "example_id": "9263c4e9-ddb9-4bdd-ad2d-0de8ee85ba4b",
                                                "sense_id": "12e43936-e886-3c01-aea6-542f3030d6d6",
                                                "text": "They are determined that I shall be burnt as a witch; and they sent their doctor to cure me; but he was forbidden to bleed me because the silly people believe that a witch’s witchery leaves her if she is bled; so he only called me filthy names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc6a98c-832b-3442-8c0e-5120e6be6a64",
                                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                                        "glosses": [
                                            "An act of witchcraft."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6565e4-4199-4396-9a96-80c87986064b",
                                                "sense_id": "edc6a98c-832b-3442-8c0e-5120e6be6a64",
                                                "text": "It may be they know something of the witcheries of this woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                        "entry_id": "e3db965c-2227-3c76-ab60-a901d7179f38",
                                        "glosses": [
                                            "Allure, charm, magic."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2060b525-b097-46f5-8611-fe89fd4ea1fb",
                                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                                "text": "At noon, when by the forest's edge / He lay beneath the branches high, / The soft blue sky did never melt / Into his heart,—he never felt / The witchery of the soft blue sky!"
                                            },
                                            {
                                                "example_id": "e921aceb-3e1b-4d7b-a1cb-02c0c4b18ff3",
                                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                                "text": "I am influenced—conquered; and the influence is sweeter than I can express; and the conquest I undergo has a witchery beyond any triumph I can win."
                                            },
                                            {
                                                "example_id": "f4ca59e1-0c77-4b8c-96c5-4316738f2553",
                                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                                "text": "He beheld the scene in his mind’s eye, through the witchery of many intervening years, and faintly illuminated it as if with starlight instead of this broad glow of moonshine."
                                            },
                                            {
                                                "example_id": "1032487b-61a4-47b4-a336-2267bc0c28b4",
                                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                                "text": "The witchery of the dawn turned the grey river-reaches to purple, gold, and opal; and it was as though the lumbering dhoni crept across the splendors of a new heaven."
                                            },
                                            {
                                                "example_id": "1c37709a-fe7c-4dcc-96e2-7bfa8e871903",
                                                "sense_id": "e1d95a30-64a3-3ffc-93c0-8c9818223fae",
                                                "text": "[A]lready his imagination, leaping ahead of the engagement ring, the betrothal kiss and the march from Lohengrin, pictured her at his side in some scene of old European witchery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb6994a8-4332-420f-8cb7-d8d4bfdb0c41",
                        "source_entry_id": "871ba13b-2a21-31e8-ad8a-8b9cf0addd6f",
                        "source_sense_id": "0c708a39-1caf-3853-a19e-089e4a2698ef",
                        "target_lang_word": "sorcellerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcellerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                                        "glosses": [
                                            "Art des sorciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726a90ec-1616-4c01-9ff2-f980083af20d",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "On vous dira que le diable seul a pu produire de telles pierres, et l’on vous intentera un procès en sorcellerie."
                                            },
                                            {
                                                "example_id": "3ce2d49a-b41b-473f-b1c0-4c0f16b4eacc",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "Comme Katrina Van Tassel, dans Sleepy Hollow, Mercredi possède un don de sorcellerie qu’elle a hérité de sa mère."
                                            },
                                            {
                                                "example_id": "1e6b1fb3-d755-4bd2-9415-9998b55ae908",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "Dans la logique mentale de leur temps, les magistrats l’accusent et la condamnent de « sorcellerie », crime pour lequel le bourreau l’énuque avec la « hart » de la potence (corde d’infamie)."
                                            },
                                            {
                                                "example_id": "e9644a58-bcc8-49da-aa57-eec850aa5432",
                                                "sense_id": "379cbc59-fcb4-3abe-9da8-b8576b75a612",
                                                "text": "« J’ai l’impression d’être entré dans une maison hantée de fête foraine. » Kara essuya ses yeux humides et regarda autour d’elle. La minuscule boutique était bourrée d’articles de sorcellerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                                        "entry_id": "2f4a25d5-4647-3dfb-92b0-56f15b7d4536",
                                        "glosses": [
                                            "Pratiques des sorciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f348c27a-5592-4671-9fb5-b1a690248f85",
                                                "sense_id": "c83d2c89-834c-38f5-a246-f0431c161f13",
                                                "text": "Leur pouvoir était illimité; ils guérissaient les malades abandonnés des médecins, rendaient fécondes les terres stériles, arrêtaient les épidémies de bestiaux, mais ils n’étaient point toujours d’humeur à ces sorcelleries bienfaisantes, et, plus volontiers, ils se servaient de leur puissance magique pour tourmenter les hommes et les bêtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
