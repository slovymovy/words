                "senses": [
                    {
                        "sense_id": "fd1b5aa5-23fa-3865-8307-2e3e021ad837",
                        "entry_id": "00bccd45-b540-35eb-a61e-f8bd31b7c8f0",
                        "glosses": [
                            "für die Abfertigung zu zahlende Gebühr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "646adeb1-672c-4c49-b75a-a57a79420126",
                                "sense_id": "fd1b5aa5-23fa-3865-8307-2e3e021ad837",
                                "text": "„Stellt der Streckensatz das Entgelt für die Beförderung als solche dar, so dient die Abfertigungsgebühr der Bezahlung der der eigentlichen Beförderung vorhergehenden und sie beschließenden Tätigkeit der einzelnen Bahnen.“"
                            },
                            {
                                "example_id": "cd9d9576-6f08-4045-b825-666f867e24b8",
                                "sense_id": "fd1b5aa5-23fa-3865-8307-2e3e021ad837",
                                "text": "„Für Leichen, die auf öffentliche Kosten und im öffentlichen Interesse unter erleichterten Bedingungen befördert werden, wird die Fracht zum Satze von 0∙20 M. für den Wagen und das Kilometer ohne Erhebung einer Abfertigungsgebühr, in besonderen Fällen auch nach den Sätzen der allgemeinen Stückgutklasse unter Annahme eines Gewichtes von 300 kg für die Sendung berechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
