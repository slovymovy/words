                "senses": [
                    {
                        "sense_id": "720d5047-8f5a-3462-a3f2-3c14e3767cb3",
                        "entry_id": "33610144-906e-3856-81e9-6763240660c4",
                        "glosses": [
                            "nicht mehr verwendetes und für die Entsorgung bestimmtes Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a4f413-88da-40cd-adbd-5f9fa0274dfb",
                                "sense_id": "720d5047-8f5a-3462-a3f2-3c14e3767cb3",
                                "text": "„Aber Polaroid-Photographen nehmen bisher in Kauf, daß sie die Bilder einzeln mit kräftigem Ruck aus der Kamera zerren müssen, daß die Aufnahmen anfangs eine glitschige, empfindliche Oberfläche haben, Farbphotos eine Minute Entwicklungszeit brauchen und von jedem Film ein Wust Abfallpapier und Negativfolien übrigbleibt.“"
                            },
                            {
                                "example_id": "16f441c0-d191-4866-b951-e155ce7ebee9",
                                "sense_id": "720d5047-8f5a-3462-a3f2-3c14e3767cb3",
                                "text": "„In Ihrer Einsamkeit kneteten Sie aus Abfallpapier eine Schlafstelle für Ihre Puppe Marlene.“"
                            },
                            {
                                "example_id": "8c78d077-2f64-4eda-a183-3930a34588f2",
                                "sense_id": "720d5047-8f5a-3462-a3f2-3c14e3767cb3",
                                "text": "„Insgesamt wurden etwa 1.000 nordkoreanische Ballons mit Müll, Zigarettenstummeln, Stofffetzen und Abfallpapier in verschiedenen Teilen Südkoreas entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
