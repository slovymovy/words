                ],
                "senses": [
                    {
                        "sense_id": "e2355b9a-10b4-306c-9692-a5bb6fc264a8",
                        "entry_id": "c6d853f3-66a0-38ed-b3a5-1796b6a5f2e9",
                        "glosses": [
                            "Infanterist bei der zur Seekriegsführung bestimmten Streitkräften eines Staates (Marine)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e1fcf8-8b2c-4371-bda9-c6d8769774ea",
                                "sense_id": "e2355b9a-10b4-306c-9692-a5bb6fc264a8",
                                "text": "„Armeesoldaten und Marineinfanteristen drängten sich an den Tischen, ihre Gewehre lagen unter den Hockern.“"
                            },
                            {
                                "example_id": "dbc9f5ce-b440-4cce-9f06-a1f193abec77",
                                "sense_id": "e2355b9a-10b4-306c-9692-a5bb6fc264a8",
                                "text": "„Überall herrschte Chaos, als Krankenwagen, Feuerwehr, Soldaten der libanesischen Armee und Marineinfanteristen vor der ausgebombten Botschaft aufeinandertrafen.“"
                            },
                            {
                                "example_id": "9bc93495-c97a-42df-83d1-11f94f005a34",
                                "sense_id": "e2355b9a-10b4-306c-9692-a5bb6fc264a8",
                                "text": "„Und Hunderte von uniformierten Matrosen und Marineinfanteristen fielen in die Innenstadt von Los Angeles ein, bewaffnet mit Totschlägern und Baseballknüppeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
