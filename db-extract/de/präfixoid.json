                ],
                "senses": [
                    {
                        "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                        "entry_id": "0ef10204-3fa9-39b1-ab4f-c4d4c76c0c1a",
                        "glosses": [
                            "grammatisches Morphem, das in seiner Form einem Lexem gleicht, aber nicht die Bedeutung dieses Lexems hat. Es wird wie ein Präfix für die Ableitung verwendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20402046-e1ef-4b46-9910-90847f6e0af8",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "In dem Lexem \"Riesenfest\" ist \"Riesen-\" ein Präfixoid; es sieht aus wie das Substantiv \"Riese\" (großer Mensch, Sagenfigur), hat aber nicht diese Bedeutung. Es bedeutet stattdessen hier \"sehr gelungenes, sehr großes (Fest)\"."
                            },
                            {
                                "example_id": "640e8725-9423-46af-9c3d-f74cee164b7e",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "„Der Oberbegriff von Suffixoid und Präfixoid ist Affixoid.“"
                            },
                            {
                                "example_id": "287476f7-419b-4733-a772-ce20aa2f1520",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "„Präfixoide werden definiert wie Suffixoide, d.h. Reihenbildung ist entscheidend und eine Veränderung der Bedeutung gegenüber dem frei verwendeten Wort.“"
                            },
                            {
                                "example_id": "c4b13321-b956-4904-bdd4-b41c791f0a20",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "Zu den abtrennbaren Verbpartikeln heißt es: „Sie werden als Produkte der Präfigierung, der Komposition, der Zusammenrückung oder einer eigens für sie angesetzten Wortbildungsart namens Konstitution angesehen; ihre Ersteinheiten werden als Präfixe, Präfixoide, Partikel oder Wörter verstanden.“"
                            },
                            {
                                "example_id": "830bf5a4-2145-4eb7-b0ac-4211f64b10cc",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "„Zu den Präfixoiden gehört die offene Klasse der Augmentativa, der Vergrößerungsbildungen…“"
                            },
                            {
                                "example_id": "b5091b67-334a-460d-bd0d-c9063e598304",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "„Das Präfixoid hat seine wörtliche Bedeutung eingebüßt und dient nun der Steigerung.“"
                            },
                            {
                                "example_id": "d4bdbee0-a451-4517-9b35-5ccb1e4a7244",
                                "sense_id": "13c5935e-89e3-3e3a-b0da-3002bc3f3b7c",
                                "text": "Morpheme wie „affen-“, „arsch-“, „bitter-“, „blitz-“, „bomben-“, „Fabel-“, „grund-“, „haupt-“, „Heiden-“, „Höllen-“, „hoch-“, „hunde-“, „hunds-“, „kreuz-“, „Mist-“, „mords-“, „Nobel-“, „pfunds-“, „riesen-“, „Riesen-“, „sau-“, „scheiß-“, „spitzen-“, „stink-“ und „stock-“ sind Präfixoide."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
