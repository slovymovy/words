                "senses": [
                    {
                        "sense_id": "4031677b-f697-3ce0-944d-b6ef55b0c1ad",
                        "entry_id": "5164c59c-afe5-33dc-b47a-aa578743e6e8",
                        "glosses": [
                            "osoba prowadząca pseudohodowlę; osoba rozmnażająca nierodowodowe psy lub koty w niewłaściwy sposób i bez należytej wiedzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7613a9f7-5603-4fae-9e75-e2780d3eba71",
                                "sense_id": "4031677b-f697-3ce0-944d-b6ef55b0c1ad",
                                "text": "Pseudohodowcą nazywamy każdą osobę doprowadzającą do rozrodu psów bez rodowodu w celach zarobkowych. Osoby takie bardzo często traktują zwierzęta jak towar, a rozmnażanie ich jak świetny sposób na business"
                            },
                            {
                                "example_id": "0a061f6d-061a-450f-a7b9-c09601890b01",
                                "sense_id": "4031677b-f697-3ce0-944d-b6ef55b0c1ad",
                                "text": "Niestety, polskie prawo nie zabrania rozmnażania nierodowodowych zwierząt dla zysku. Jedynym sposobem powstrzymania pseudohodowców jest zmniejszenie popytu na ich działalność"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
