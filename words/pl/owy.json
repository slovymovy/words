                    "frequency": "Low",
                    "semantic_group_id": "zaimek wskazujący",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspomniał o <w>owej</w> książce, którą czytaliśmy w zeszłym roku na zajęciach z literatury.",
                            "target_lang_translations": {
                                "ru": "Он упомянул о <w>той</w> книге, которую мы читали в прошлом году на занятиях по литературе."
                            }
                        },
                        {
                            "text": "Nikt nie wiedział, co dokładnie wydarzyło się w <w>owym</w> czasie w tamtym odległym mieście.",
                            "target_lang_translations": {
                                "ru": "Никто не знал, что именно произошло в <w>то</w> время в том далеком городе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "w owym czasie",
                        "w owej chwili"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane głównie w literaturze lub języku podniosłym"
