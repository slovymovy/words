                                        "glosses": [
                                            "спец. насыпь или вал на берегах для предохранения от затопления или размывания или для удержания воды в водохранилище"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd89775b-a933-4f7d-af95-3af727fcea41",
                                                "sense_id": "820c4db4-e775-3592-adcf-cce41e010619",
                                                "text": "Мурманск, город мой широкоплечий, // Грудью дамб улёгся на залив."
                                            }
