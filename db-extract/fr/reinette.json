        "fr-extract.jsonl": [
            {
                "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                "word": "reinette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43d7afae-ffaa-4c40-93df-c16a4bb5f2a1",
                        "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "reinettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                        "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                        "glosses": [
                            "Pomme à peau tachetée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b830d21a-286f-4f16-8d43-1448f7b893c0",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "Dans le nombre des pommes, les seules bonnes à garder pour l’hiver sont : […] ; mais celles qui doivent avoir la préférence sur toutes les autres, ce sont les reinettes d’Angleterre dorées, les reinettes blanches, les reinettes du Canada, les reinettes franches, reinettes grises, reinettes grises de Ranville, qui résistent aux plus grands froids."
                            },
                            {
                                "example_id": "89dfa48a-c620-4dfe-acb6-98c7ba750a81",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "elles étaient de peaux différentes, les pommes d’api au berceau, les rambourgs avachies, les calvilles en robe blanche, les canadas sanguines, les châtaigniers couperosées, les reinettes blondes, piquées de rousseur."
                            },
                            {
                                "example_id": "da610a66-fb82-41f3-9363-65c7a05b6fec",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "Sa petite figure à poils rares et blonds, ridée et racornie comme une pomme de reinette, disparaissait sous un chapeau de toile cirée doublé de feutre ;"
                            },
                            {
                                "example_id": "5368301d-6927-4f89-be95-03869d5566a9",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "Parfois la porte de l’école s’entrebâillait sur Mme Lévêque, douce et déjà ridée comme une reinette de décembre."
                            },
                            {
                                "example_id": "a3db64fc-12f0-49ad-bf40-d192d77b6a4e",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "Reinette blanche, grise"
                            },
                            {
                                "example_id": "64a1c98f-849a-4c94-bd32-8de433999266",
                                "sense_id": "c2681259-1848-3550-b875-585a00b77831",
                                "text": "Reinette d’Angleterre, du Canada."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa3a3cf5-2dc5-3b4d-9725-eca0d379d516",
                        "entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                        "glosses": [
                            "Une des espèces de petites grenouilles vertes (ou d'autres couleurs), souvent arboricoles, de la famille des hylidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1dcb5e-95c0-4dc6-9817-47b2432ea10c",
                                "sense_id": "aa3a3cf5-2dc5-3b4d-9725-eca0d379d516",
                                "text": "Tout autour, le chant des reinettes emplissait la nuit d’une seule note liquide qui ne s’interrompait jamais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b47c51f-2f97-4286-86a2-e8cccf9cbc69",
                        "source_entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                        "target_lang_word": "Renette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Renette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4386b020-d59d-329f-acbb-2c78b0d29185",
                                        "entry_id": "dd9c866a-23fe-359a-afd4-cdc15b715ff0",
                                        "glosses": [
                                            "Gruppe von Apfelsorten, zum Beispiel Cox Orangenrenette, Kanadarenette, Landsberger Renette"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e90a42e-da52-49c1-a3c0-5533bf08731f",
                                                "sense_id": "4386b020-d59d-329f-acbb-2c78b0d29185",
                                                "text": "„Besondere Erwähnung verdienen die Erfolge in der Obstkultivierung, und zwar von zwei noch bis in jüngste Zeit in Streuobstwiesen und an öffentlichen Verkehrswegen angebauten Apfelsorten: der Grauen französischen Renette und dem Borsdorfer Apfel (Sternschulte)..“"
                                            },
                                            {
                                                "example_id": "21895e8c-c5a6-4786-ac35-a9e9e1b7823e",
                                                "sense_id": "4386b020-d59d-329f-acbb-2c78b0d29185",
                                                "text": "Rote Renetten - Apfel in Gestalt und Größe verschieden, meist klein, flachkugelförmig, zuweilen mit flachen Erhabenheiten auf der Kelchwölbung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Renette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c21e08a2-7cee-3f36-a79c-94d41d8fde67",
                                        "entry_id": "8823eae6-fa29-3b3f-b535-3d7344e472fa",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ada6ca-5821-449c-a6a2-bd390af2b12f",
                                                "sense_id": "c21e08a2-7cee-3f36-a79c-94d41d8fde67",
                                                "text": "Seit Kurzem erlernt Renette das Turnen mit dem Rhönrad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e543b4a0-eee3-4323-a4f3-d7f0b6bb36de",
                        "source_entry_id": "307c331f-b104-3d58-bdf0-5ad4c8c715c1",
                        "target_lang_word": "reinette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reinette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9538f9-264e-35b6-a30d-7efce0963a33",
                                        "entry_id": "1da1482a-8e82-33da-9b1d-fe21ffbb6336",
                                        "glosses": [
                                            "Any of various kinds of apple, mostly of French origin, characterized by russeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63c7c1c-ef0f-4d58-ad5b-a0c80591c7ab",
                                                "sense_id": "eb9538f9-264e-35b6-a30d-7efce0963a33",
                                                "text": "Make choice of some small reinette apples, pare them, and prick them thoroughly with a coarse needle to render them as absorbent as possible; put them into a jar to stand inside a saucepan of boiling water, […]"
                                            },
                                            {
                                                "example_id": "639a281c-f1da-475d-9818-dc771734d1d4",
                                                "sense_id": "eb9538f9-264e-35b6-a30d-7efce0963a33",
                                                "text": "Then a flameproof casserole dish–preferably the flat type peculiar to Normandy–should be lined with sliced apple and onion. Reinette apples are supposed to be the best."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
