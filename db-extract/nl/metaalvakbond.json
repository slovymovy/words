                        "examples": [
                            {
                                "example_id": "caf24e8e-f89e-4bca-abbc-3e95e6f9293a",
                                "sense_id": "e9ef31da-5526-3e8e-8820-760312e2b2a5",
                                "text": "Bij de Fiat-fabriek in Zuid-Italië hebben de werknemers gisteravond vier uur gestaakt. De staking was uitgeroepen door de metaalvakbond om te protesteren tegen een nieuwe ontslagwet die het makkelijker maakt om werknemers te ontslaan."
                            },
                            {
                                "example_id": "3abc537c-2a98-425d-9ec5-b7d7a4ae4266",
                                "sense_id": "e9ef31da-5526-3e8e-8820-760312e2b2a5",
                                "text": "Voor Saab breken misschien wel beslissende uren aan. De Zweedse metaalvakbond geeft Saab tot morgenmiddag drie uur de tijd om de achterstallige salarissen te betalen. Is er dan niet betaald, dan is de kans groot dat de bond deze week nog het faillissement aanvraagt van de autofabrikant. Een gesprek met correspondent Rolien Creton."
                            }
                        ]
