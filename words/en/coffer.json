{
    "word_family": [
        "cofferdam"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70a15e31-a290-3602-835f-aaae95e5f7f0",
                    "sense_definition": "A strong chest or box used for keeping money or valuables safe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family kept their most precious jewels locked inside an ancient wooden <w>coffer</w>.",
                            "target_lang_translations": {
                                "ru": "Семья хранила свои самые драгоценные украшения запертыми в древнем деревянном <w>сундуке</w>."
                            }
                        },
                        {
                            "text": "He carefully placed the gold coins into the heavy <w>coffer</w> and turned the key.",
                            "target_lang_translations": {
                                "ru": "Он осторожно опустил золотые монеты в тяжелый <w>ларец</w> и повернул ключ."
                            }
                        }
                    ],
                    "synonyms": [
                        "strongbox"
                    ],
                    "common_phrases": [
                        "heavy coffer",
                        "wooden coffer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный сундук или ящик, используемый для безопасного хранения денег или ценностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сундук",
                                "target_lang_sense_clarification": "для хранения ценностей"
                            },
                            {
                                "target_lang_word": "ларец",
                                "target_lang_sense_clarification": "небольшой декоративный ящик"
                            },
                            {
                                "target_lang_word": "сейф",
                                "target_lang_sense_clarification": "прочный металлический ящик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2e6af94-7196-3b7a-beea-a40a2e42e81e",
                    "sense_definition": "A supply or store of money, often belonging to an organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "funds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local government had to cut public services because the city <w>coffers</w> were empty.",
                            "target_lang_translations": {
                                "ru": "Местным властям пришлось сократить государственные услуги, потому что городская <w>казна</w> была пуста."
                            }
                        },
                        {
                            "text": "Generous donations from local businesses helped to replenish the charity's <w>coffers</w>.",
                            "target_lang_translations": {
                                "ru": "Щедрые пожертвования местных предприятий помогли пополнить <w>кассу</w> благотворительной организации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "empty coffers",
                        "replenish the coffers",
                        "government coffers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запас или хранилище денежных средств, часто принадлежащих организации или государству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "казна",
                                "target_lang_sense_clarification": "государственная или организации"
                            },
                            {
                                "target_lang_word": "фонды",
                                "target_lang_sense_clarification": "денежные средства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b898363d-85c7-328d-b056-90804cd5a158",
                    "sense_definition": "An ornamental sunken panel in a ceiling or dome.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed the cathedral dome with a beautiful geometric <w>coffer</w> pattern.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал купол собора с красивым геометрическим узором из <w>кессонов</w>."
                            }
                        },
                        {
                            "text": "Water damage had stained each plaster <w>coffer</w> in the historic library ceiling.",
                            "target_lang_translations": {
                                "ru": "Протечка воды оставила пятна на каждом гипсовом <w>кессоне</w> на потолке исторической библиотеки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ceiling coffer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical architectural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративная углубленная панель в потолке или куполе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кессон",
                                "target_lang_sense_clarification": "архитектурный элемент потолка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "990752b7-9877-338d-9882-7d0610960516",
                    "sense_definition": "A watertight enclosure pumped dry to permit construction or repairs below the waterline; a cofferdam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers constructed a temporary <w>coffer</w> to repair the bridge foundation.",
                            "target_lang_translations": {
                                "ru": "Инженеры построили временную <w>перемычку</w> для ремонта фундамента моста."
                            }
                        },
                        {
                            "text": "Water was pumped out of the <w>coffer</w> so the workers could lay the concrete.",
                            "target_lang_translations": {
                                "ru": "Из <w>коффердама</w> откачали воду, чтобы рабочие могли уложить бетон."
                            }
                        }
                    ],
                    "synonyms": [
                        "caisson"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "engineering term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водонепроницаемое ограждение, из которого откачивается вода для проведения строительных или ремонтных работ ниже уровня воды; коффердам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коффердам",
                                "target_lang_sense_clarification": "водонепроницаемая перемычка"
                            },
                            {
                                "target_lang_word": "кессон",
                                "target_lang_sense_clarification": "в гидротехническом строительстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8ef2e52-21ea-3cbe-9eff-b335f15a051e",
                    "sense_definition": "A trench dug in the bottom of a dry moat, and extending across it, to enable the besieged to defend it with raking fire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defenders dug a deep <w>coffer</w> across the dry moat to halt the enemy advance.",
                            "target_lang_translations": {
                                "ru": "Обороняющиеся вырыли глубокий <w>коффер</w> поперек сухого рва, чтобы остановить продвижение противника."
                            }
                        },
                        {
                            "text": "Soldiers fired from the safety of the <w>coffer</w> at the attackers crossing the ditch.",
                            "target_lang_translations": {
                                "ru": "Солдаты вели огонь из безопасного <w>коффера</w> по нападающим, пересекающим ров."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical military term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Траншея, вырытая на дне сухого рва и проходящая через него, чтобы осажденные могли защищать его продольным огнем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коффер",
                                "target_lang_sense_clarification": "оборонительный ров в фортификации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8c02771-1b4f-3a28-a7c7-54b80bebc30f",
                    "sense_definition": "To put money or valuables in a coffer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant would <w>coffer</w> his daily earnings before locking up the shop.",
                            "target_lang_translations": {
                                "ru": "Купец обычно <w>запирал в сундук</w> свою дневную выручку перед тем, как закрыть лавку."
                            }
                        },
                        {
                            "text": "They chose to <w>coffer</w> the gold coins rather than deposit them in a bank.",
                            "target_lang_translations": {
                                "ru": "Они предпочли <w>спрятать в сейф</w> золотые монеты, вместо того чтобы положить их в банк."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Класть деньги или ценности в сундук или сейф."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирать в сундук",
                                "target_lang_sense_clarification": "прятать ценности"
                            },
                            {
                                "target_lang_word": "класть в казну",
                                "target_lang_sense_clarification": "сохранять деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11ddebd6-7ca8-3292-99a1-7b7632880df7",
                    "sense_definition": "To decorate something, especially a ceiling, with sunken panels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders decided to <w>coffer</w> the library ceiling to give it a classic look.",
                            "target_lang_translations": {
                                "ru": "Строители решили <w>украсить кессонами</w> потолок библиотеки, чтобы придать ему классический вид."
                            }
                        },
                        {
                            "text": "It is difficult to <w>coffer</w> a dome without precise geometric calculations.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>сделать кессонным</w> купол без точных геометрических расчетов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coffer a ceiling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "architectural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать что-либо, особенно потолок, углубленными панелями (кессонами)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кессонировать",
                                "target_lang_sense_clarification": "украшать потолок углублениями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c7a5af30-a71b-3164-a17b-f675d9e3d883",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Professor <w>Coffer</w> to deliver the keynote lecture at the conference.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили профессора <w>Коффера</w> выступить с пленарным докладом на конференции."
                            }
                        },
                        {
                            "text": "The historical documents were signed by a man named Thomas <w>Coffer</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были подписаны человеком по имени Томас <w>Коффер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коффер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}