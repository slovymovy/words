                                        "entry_id": "aed5fa92-c106-308f-85bf-89bc9a22c8de",
                                        "glosses": [
                                            "Celle qui calomnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2033d62b-ff45-4052-8149-e8e8f51488d4",
                                                "sense_id": "c6e06537-7d59-3707-9b1e-fbb9c51b19e5",
                                                "text": "La génération précédente n’aurait certes pas appelé la police, mais la calomniatrice aurait été rossée, ou aurait eu son sobriquet pour l’hiver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
