                                    {
                                        "sense_id": "45eabadc-fdbf-3c00-8480-659b6ff8e224",
                                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                                        "glosses": [
                                            "Qualifie un terme qui conserve le même sens dans des emplois différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a4588c-75fb-4e90-b74e-8c049aba5e3f",
                                                "sense_id": "45eabadc-fdbf-3c00-8480-659b6ff8e224",
                                                "text": "Les seuls termes dont le sens généalogique reste univoque sont « père », « mère », « fils », « fille », « frère », « sœur », « époux » et « épouse »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80144316-f0c3-3ffc-a90e-f69b385ee5eb",
                                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                                        "glosses": [
                                            "Qualifie une relation qui ne s’exerce que dans un sens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f494bcdb-11c2-3c05-8112-bcfbd04e63d8",
                                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                                        "glosses": [
                                            "Qualifie un symptôme qui ne se rencontre que dans une seule maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc107520-8676-4783-b3c6-1ca8006923e3",
                                                "sense_id": "f494bcdb-11c2-3c05-8112-bcfbd04e63d8",
                                                "text": "La psychorigidité forme un couple bien assorti avec l’égocentrisme qui peut se définir comme un rapport privilégié, voire univoque à soi, à ses préoccupations, différent de ce que l'on entend communément par égoïsme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93281223-366c-3aee-ba4c-a5faedacb127",
                                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                                        "glosses": [
                                            "Qui n’admet qu'une seule interprétation ; non ambigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e04dd9e-2b60-4420-bfd5-923d12da6a98",
                                                "sense_id": "93281223-366c-3aee-ba4c-a5faedacb127",
                                                "text": "La volonté de Beckett avait été univoque ; il avait fait interdire ce travestissement par un tribunal hollandais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
