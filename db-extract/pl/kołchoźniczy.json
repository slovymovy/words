                                "example_id": "cc590614-5389-4d0f-845f-583e23f8d840",
                                "sense_id": "34014f9a-911c-3e5b-ba2a-239e8c9754ac",
                                "text": "Moja babcia nie lubiła koncelebr, mówiła, że to msze „kołchoźnicze”."
                            }
