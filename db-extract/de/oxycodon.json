                                "target_senses": [
                                    {
                                        "sense_id": "d287bb6b-0f6a-3d3a-ad3f-30944298546e",
                                        "entry_id": "765c0d71-af58-32fe-a3de-aa0a9252f821",
                                        "glosses": [
                                            "An addictive, semisynthetic opioid (trademark OxyContin) that is similar to morphine in effect and structure; C₁₈H₂₁NO₄."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9900be6-2e3d-49a6-b207-ba6dd52bc401",
                                                "sense_id": "d287bb6b-0f6a-3d3a-ad3f-30944298546e",
                                                "text": "They ingest Ambien, Seroquel, LSD, Adderall, Oxycodone, cocaine, Flexeril, Percocet, psilocybin mushrooms and codeine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f1cda95-77e0-44c6-8be5-c4474843d043",
                        "source_entry_id": "e344acd4-d396-3a7c-824a-92357585c478",
                        "source_sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
