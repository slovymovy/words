                        "source_sense_id": "c17befb6-1539-369a-bfde-d0476c8d1d3b",
                        "target_lang_word": "anaphylaxis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphylaxis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f98b67f-5f45-38dd-a835-e4a7f13fc5e7",
                                        "entry_id": "6b8555fe-9641-306c-b8dc-cf915619374e",
                                        "glosses": [
                                            "Extreme sensitivity to a substance such as a foreign protein or drug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                        "entry_id": "6b8555fe-9641-306c-b8dc-cf915619374e",
                                        "glosses": [
                                            "A severe and rapid systemic allergic reaction to an allergen, causing a constriction of the trachea, preventing breathing; anaphylactic shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7aeb6-354b-401c-8063-404779ab0abe",
                                                "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                                "text": "“Anyone who has experienced or witnessed an anaphylaxis reaction knows it can be very stressful deciding when to inject epinephrine to themselves or a child and often delay,” Dr. Jonathan Spergel, chief of the allergy program at Children’s Hospital of Philadelphia, said in a news release from ARS Pharmaceuticals."
                                            },
                                            {
                                                "example_id": "76e29d7f-2d3a-438f-930b-dcd2c27e2559",
                                                "sense_id": "c3d88bb6-2545-34b5-a6af-c3580bf6b2c9",
                                                "text": "He said a bite could send someone into anaphylaxis, which is a narrowing of the airways and lowering of blood pressure, within minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6522a6e9-ce33-499a-ab87-46e349938793",
                        "source_entry_id": "7b67a40b-2160-3d10-9ea0-77312e8873e8",
                        "source_sense_id": "c17befb6-1539-369a-bfde-d0476c8d1d3b",
                        "target_lang_word": "anafilaxia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anafilaxia",
