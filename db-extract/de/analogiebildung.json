                ],
                "senses": [
                    {
                        "sense_id": "60424911-2062-30f2-bcf3-d4905c0eb3b8",
                        "entry_id": "93801f30-603e-3e30-aeb9-f0ebcfb90fe6",
                        "glosses": [
                            "Bildung einer sprachlichen Einheit nach dem Vorbild einer anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dac4f053-011d-4234-a247-d7e064d22a21",
                                "sense_id": "60424911-2062-30f2-bcf3-d4905c0eb3b8",
                                "text": "„An die Beobachtung einzelner Analogiebildungen knüpfen Köpckes Überlegungen zur Erklärung der Testdaten an, die zur Ausbildung seines Schemamodells führen.“"
                            },
                            {
                                "example_id": "06b01589-c94d-40c7-802c-7a5bf87dba82",
                                "sense_id": "60424911-2062-30f2-bcf3-d4905c0eb3b8",
                                "text": "„Der Darstellung von Hermanns Untersuchungen soll noch eine kurze Wiedergabe der Klassifikation der Analogiebildungen angefügt werden, damit ein Vergleich mit den früheren Versuchen ermöglicht wird.“"
                            },
                            {
                                "example_id": "3f8738ac-a303-4ae3-8a68-3cbff1426064",
                                "sense_id": "60424911-2062-30f2-bcf3-d4905c0eb3b8",
                                "text": "„Bei diesen Analogiebildungen war zu beachten, daß Modus und Person/Numerus getrennte Allomorphe aufweisen, daß Präsenz und Präteritum mit ablautenden Lexemen gebildet werden, daß Konjunktiv Präsens und Konjunktiv Präteritum unterschiedliche Allomorphe besitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                        "entry_id": "93801f30-603e-3e30-aeb9-f0ebcfb90fe6",
                        "glosses": [
                            "vergleichendes Vorgehen, vergleichbares Geschehen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d6c8ea49-97ae-4479-8c52-4ff6560ffc3b",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„Dabei kann auch die Analogiebildung Hilfe leisten.“"
                            },
                            {
                                "example_id": "d1869b5a-27e6-467d-8289-fed7a3cdeefc",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„Daß die in beiden Typen übereinstimmende Gliederung der Extremitäten als Analogiebildung allein aufgefaßt werden kann, liegt auf der Hand.“"
                            },
                            {
                                "example_id": "3d3bd8bc-9c88-4870-960a-bcc549140a9c",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„Wirklich glücklich ist da nur, wer über genug kulturelle Halbbildung verfügt, um sich den Fall gewissermaßen durch historische Analogiebildungen vom Leib zu halten.“"
                            },
                            {
                                "example_id": "2068c57a-c90d-4764-a573-366db5898814",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„[Beim ‚Öxit‘] handelt sich es sich um eine unreflektierte Analogiebildung zu ‚Grexit‘ bzw. ‚Brexit‘, das in den Medien den früheren Ausdruck ‚Austritt aus der EU‘ ersetzt hat. [, so die Jury]“"
                            },
                            {
                                "example_id": "5c77f52a-b871-4ef8-9056-8e6d1c8f63ec",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„Das bloß rechtspolitisch Erwünschte vermag dagegen der ergänzenden Rechtsfindung durch Analogiebildung nicht als ausreichende Grundlage zu dienen […]“"
                            },
                            {
                                "example_id": "d1753853-ae54-461f-9594-07998b0a11e2",
                                "sense_id": "3638382f-4302-3c3f-96cf-1ace59370a4e",
                                "text": "„Die Analogiebildung ist aber nur der erste Schritt und schafft bloß ein Reservoir an möglichen Stereotypen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
