                        "examples": [
                            {
                                "example_id": "e70ed002-b429-4208-bfc4-837cafd499e8",
                                "sense_id": "472ae8e8-427b-33ea-8703-8872bcbfc2c1",
                                "text": "En 1950, les pneumaticiens français produisent significativement plus de pneus pour véhicules utilitaires et moins de pneus tourismes qu’avant guerre"
                            },
                            {
                                "example_id": "5a165759-393d-45f0-8d29-55035a055109",
                                "sense_id": "472ae8e8-427b-33ea-8703-8872bcbfc2c1",
                                "text": "Le pneumaticien de Clermont-Ferrand a entrepris depuis cinq ans une métamorphose silencieuse."
                            },
                            {
                                "example_id": "bea3ba37-278a-44b0-a9cd-80590902544e",
                                "sense_id": "472ae8e8-427b-33ea-8703-8872bcbfc2c1",
                                "text": "Ce membre du réseau de pneumaticiens Eurotyre vend des pneumatiques de toutes sortes en plusieurs marques (Continental, Michelin, etc.), et très régulièrement en promotion."
                            }
                        ]
