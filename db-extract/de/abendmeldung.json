                        "glosses": [
                            "Meldung oder Nachricht, die am Abend übermittelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caab2c5b-77a3-4493-ba66-c87d15ba2d7d",
                                "sense_id": "8780ca6e-e835-3df6-8c17-e56ee4e59a38",
                                "text": "„In den Papieren findet sich auch die Abendmeldung des Infanterieregiments 9 vom 28. Juni mit dem Satz: »Gefangene wurden nicht gemacht, da die Soldaten des Regiments sich, nachdem sie die bestialischen Verstümmelungen an ihren Kameraden gesehen hatten, hierzu nicht in der Lage sahen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0001ab14-918b-37fb-94e5-828df7d0d948",
                        "entry_id": "918e2133-2bd5-3091-befb-c2bb6058168a",
                        "glosses": [
                            "Sendung, die abends ausgestrahlt wird und in der aktuelle Nachrichten vermittelt werden"
                        ],
                        "tags": [
                            "meistens im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e40001dd-3da2-4590-abf0-1b0e3a3c5f29",
                                "sense_id": "0001ab14-918b-37fb-94e5-828df7d0d948",
                                "text": "„Ich hörte im offenen Wagen sitzend die Abendmeldungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
