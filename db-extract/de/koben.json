                                        "sense_id": "da02682e-b03d-3527-993e-cc1ee15a0441",
                                        "entry_id": "84f62533-39ae-3881-ae49-ea01276fbbd0",
                                        "glosses": [
                                            "To write (an article, a book, etc.)."
