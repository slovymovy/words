        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cac349a-b0f2-3d2b-a2d4-beda86d9d455",
                    "sense_definition": "Autre nom du trèfle incarnat, plante fourragère annuelle cultivée pour le bétail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agriculteur a semé du <w>farouche</w> dans cette parcelle pour nourrir son troupeau.",
                            "target_lang_translations": {
                                "en": "The farmer sowed some <w>crimson clover</w> in this field to feed his herd.",
                                "ru": "Фермер посеял <w>клевер инкарнатный</w> на этом участке, чтобы прокормить своё стадо.",
                                "de": "Der Landwirt hat auf dieser Parzelle <w>Inkarnatklee</w> gesät, um seine Herde zu füttern.",
                                "es": "El agricultor sembró <w>trébol encarnado</w> en esta parcela para alimentar a su rebaño.",
                                "zh": "农夫在这块地里播种了<w>深红车轴草</w>，用来喂养他的畜群。"
                            }
                        },
                        {
                            "text": "Au printemps, les vaches se régalent du <w>farouche</w> semé à l'automne dans la prairie.",
                            "target_lang_translations": {
                                "en": "In spring the cows feast on <w>crimson clover</w> sown in autumn in the meadow.",
                                "ru": "Весной коровы лакомятся <w>клевером инкарнатным</w>, посеянным осенью на лугу.",
                                "de": "Im Frühjahr fressen die Kühe mit Genuss den im Herbst auf der Wiese gesäten <w>Inkarnatklee</w>.",
                                "es": "En primavera, las vacas disfrutan del <w>trébol encarnado</w> sembrado en otoño en la pradera.",
                                "zh": "春天里，奶牛们津津有味地吃着秋天在草场上播种的<w>深红车轴草</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trèfle incarnat"
                    ],
                    "target_lang_definitions": {
                        "en": "Another name for crimson clover, an annual forage plant grown as fodder for livestock.",
                        "ru": "Другое название инкарнатного клевера, однолетнего кормового растения, выращиваемого для скота.",
                        "de": "Anderer Name für den Inkarnatklee, eine einjährige Futterpflanze, die als Viehfutter angebaut wird.",
                        "es": "Otro nombre del trébol encarnado, planta forrajera anual que se cultiva como alimento para el ganado.",
                        "zh": "即深红车轴草，一种一年生饲料植物，用来喂养牲畜。"
                    },
                    "translations": {
                        "en": [
