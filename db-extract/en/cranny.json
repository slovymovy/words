                        "source_sense_description": "small, narrow opening, fissure, crevice, or chink",
                        "target_lang_word": "Spalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                        "entry_id": "28d545b2-93ab-380a-b03d-4bd3bc4fe0d0",
                                        "glosses": [
                                            "eine rissförmige Öffnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89410b7a-44ed-4b64-8a68-05ca1eddd94b",
                                                "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                                "text": "Die Tür steht einen Spalt offen."
                                            },
                                            {
                                                "example_id": "a2ccd976-a356-43a3-901c-5f2a005e38f0",
                                                "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                                "text": "„Als sie uns die Tür öffnet, haben wir Mühe, unseren Koffer durch den kleinen Spalt ins Vorzimmer zu zwängen.“"
                                            },
                                            {
                                                "example_id": "cc601910-04b3-4bbd-9b7c-dbd22ab8c29d",
                                                "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                                "text": "„Er öffnete die Tür einen Spalt, um nach mir zu schauen.“"
                                            },
                                            {
                                                "example_id": "7cf56596-dc0a-4932-95fd-88c13c478b5a",
                                                "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                                "text": "„In der Antwort, die ich ihr sofort schickte, wies ich sie an, sie solle unverzüglich ihrer Freundin mitteilen, sie habe sie durch den Spalt im Gespräch mit einer Maske gesehen.“"
                                            },
                                            {
                                                "example_id": "611ce873-d552-48a2-acf8-728d34d303e4",
                                                "sense_id": "5e108d8d-4bbe-3c5c-94b6-45a4ba4ad603",
                                                "text": "„Bjarkis Tür stand einen Spalt offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Spalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbc6be39-4b5e-32f6-882b-df89b1675c6d",
                                        "entry_id": "86e569de-c29e-36c7-be0a-afc178fb75fa",
                                        "glosses": [
                                            "eine Stadt in Bayern, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b570d46e-be43-493c-b2f9-96b3c48c8bec",
                                                "sense_id": "fbc6be39-4b5e-32f6-882b-df89b1675c6d",
                                                "text": "Spalt liegt in Deutschlands Südosten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23c08d3f-8ae6-40ce-a742-9fc420065afd",
                        "source_entry_id": "15713321-bb07-3ee9-94cc-4e74b68c6ed4",
                        "source_sense_description": "small, narrow opening, fissure, crevice, or chink",
                        "target_lang_word": "Versteck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                        "entry_id": "6f1b8dc4-300f-3eeb-87cc-ae81bbf8715f",
                                        "glosses": [
                                            "Ort, Stelle, wo man sich oder etwas vor anderen verbergen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deddf6a6-c5d1-4340-b930-95395619cedb",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "Die Kinder haben im Gebüsch ein Versteck."
                                            },
                                            {
                                                "example_id": "2e128d79-b079-4c31-9234-25b96edba5df",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Der einzige Mensch, der mich in meinem Versteck besucht, ist Berut.“"
                                            },
                                            {
                                                "example_id": "11609448-1964-48dc-8469-0d1330a74492",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Er kam die Stufen herunter und betrat den Gartenweg, der direkt zu meinem Versteck führte.“"
                                            },
                                            {
                                                "example_id": "47f9f8f5-7b7a-4833-b8f3-6601d06ec8ac",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Dann trat er aus seinem Versteck hervor und schritt rasch und geräuschlos die Treppe hinunter.“"
                                            },
                                            {
                                                "example_id": "fbcb197a-7044-41dc-9f25-f1c6f9eac396",
                                                "sense_id": "170c6082-3570-3dbc-9a31-c0db9eb2f3ff",
                                                "text": "„Aus seinen Fragen entnahm ich, daß er der Mann war, den ich in Handschellen hatte abführen sehen von meinem Versteck auf dem Dach aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
