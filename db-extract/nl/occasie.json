                        "sense_id": "d4f452a5-a478-39da-b54b-4b75cd94e9ef",
                        "entry_id": "985e2b3f-a51c-3328-8b6b-6a0b46ed5bbd",
                        "glosses": [
                            "mogelijkheid, kans, gelegenheid"
