                    }
                ],
                "senses": [
                    {
                        "sense_id": "08d8b87b-472b-39b1-b26a-1c9a62a9f39a",
                        "entry_id": "bb8c4c81-94c1-3dee-9d89-b2afe4f6eac0",
                        "glosses": [
                            "aannemelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418e8fd6-3a52-4080-b9e2-9390a5242504",
                                "sense_id": "08d8b87b-472b-39b1-b26a-1c9a62a9f39a",
                                "text": "U geeft best een acceptabele verklaring voor de verdwenen 700 miljoen euro, maar of het nu de echte waarheid is wil ik toch verder laten onderzoeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "606409bf-e1d4-3933-aef4-a8804fa6b245",
                        "entry_id": "bb8c4c81-94c1-3dee-9d89-b2afe4f6eac0",
                        "glosses": [
                            "aanvaardbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc013ff-ea80-4108-b595-4acec2eb3971",
                                "sense_id": "606409bf-e1d4-3933-aef4-a8804fa6b245",
                                "text": "Poetin probeert met een koloniale oorlog Oekraïne te heroveren en de Oekraïense identiteit uit te roeien. Net als Stalin, de dictator die hij als een “efficiënte manager” ziet, acht hij het doden van burgers acceptabel. In tegenstelling tot Stalin erkent Poetin de Oekraïense identiteit niet eens."
                            },
                            {
                                "example_id": "f632599b-e472-4609-b2ff-15d0dd8333fb",
                                "sense_id": "606409bf-e1d4-3933-aef4-a8804fa6b245",
                                "text": "Het voorstel wat u doet is niet helemaal wat ik wil, maar ik kan er wel mee leven het is wel acceptabel."
                            },
                            {
                                "example_id": "6b20d31e-b3c6-460b-afea-a7cd6c84fcb2",
                                "sense_id": "606409bf-e1d4-3933-aef4-a8804fa6b245",
                                "text": "Quick was vaker afwezig dan me acceptabel leek en bleef dan maar een paar uurtjes. Wij hoorden bij de onderzoeksafdeling van het gebouw, niet bij de kunstafdeling aan de voorkant, in Jermyn Street, dus het was altijd rustig. Ik miste Quicks aandacht."
                            },
                            {
                                "example_id": "683f05de-1f40-40f8-a39b-278d8827c859",
                                "sense_id": "606409bf-e1d4-3933-aef4-a8804fa6b245",
                                "text": "Als je het voor elkaar kreeg dat ze zich eens fatsoenlijk kleedden en vaker douchten, en goed rechtop gingen staan en naar je luisterden zonder stom te doen, dan zouden ze absoluut acceptabel zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42180fc6-2c6f-4041-b8e4-c24023378096",
                        "source_entry_id": "bb8c4c81-94c1-3dee-9d89-b2afe4f6eac0",
                        "target_lang_word": "akzeptabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akzeptabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8762ee6b-ab38-3285-a174-a8e0cef5e0d0",
                                        "entry_id": "24685d37-e9f4-3174-aa64-b22531ec7041",
                                        "glosses": [
                                            "in einer Weise, dass man es akzeptieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a2b96e-b630-4210-8347-449cc37609f8",
                                                "sense_id": "8762ee6b-ab38-3285-a174-a8e0cef5e0d0",
                                                "text": "Der Preis des Produktes ist akzeptabel."
                                            },
                                            {
                                                "example_id": "6b0273c3-7953-4e17-b99d-41a83f5481d9",
                                                "sense_id": "8762ee6b-ab38-3285-a174-a8e0cef5e0d0",
                                                "text": "„Wasserstoff ist schneller getankt als Akkus geladen, und mit den 600 Liter fassenden Tanks, wie sie der Brennstoffzellenbus Toyota Sora nutzt, schafft man auch akzeptable Reichweiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
