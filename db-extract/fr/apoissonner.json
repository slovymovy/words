                ],
                "senses": [
                    {
                        "sense_id": "cd018386-37d8-3791-8a9e-cf919d69ecfd",
                        "entry_id": "de01f5ec-b1b3-3f6e-8b7c-4116d75abcb4",
                        "glosses": [
                            "Empoissonner, peupler de poissons en vue de la pêche."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d983348-a1fb-4b0f-8c00-10afb5b8b8d7",
                                "sense_id": "cd018386-37d8-3791-8a9e-cf919d69ecfd",
                                "text": "Dans les étangs que l’on veut continuer de tenir en eau, on y doit mettre le tiers moins de ce qu’on y avoit mis la premiere fois, il y en a qui en mettent autant, & si on ne le veut apoissonner qu’à un an, il y faut mettre des panneaux & n’y en mettre que la moitié."
                            },
                            {
                                "example_id": "5c79de11-34dc-45af-8561-7d35953380f8",
                                "sense_id": "cd018386-37d8-3791-8a9e-cf919d69ecfd",
                                "text": "Pour pêche à deux ans aussi bien qu’à un an, il est plus avantageux d’apoissonner avant l’hiver qu’après, s’il n’y a aucun empéchement."
                            }
                        ]
                    }
                ],
