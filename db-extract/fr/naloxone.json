                                        "entry_id": "10470af5-6012-3721-bd4e-222e31ec6540",
                                        "glosses": [
                                            "Wirkstoff, der als Gegenmittel gegen Opiate und Opioide verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bac7c92-3380-4435-a067-0ae2b67334ea",
                                                "sense_id": "dc05dea6-e9a3-3ebd-b7db-4f9b975ff680",
                                                "text": "„Endorphin-Effekte können durch den Opiatantagonisten Naloxon blockiert werden.“"
                                            }
