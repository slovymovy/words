                    }
                ],
                "senses": [
                    {
                        "sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                        "entry_id": "9c5158a6-dfbb-3ad4-b364-1ee73d2757da",
                        "glosses": [
                            "Wind aus dem Süden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ece3a2-ea75-442c-baaa-2b39548a7ada",
                                "sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                                "text": "„Im ersten Frühjahr jagt der Südwind mit wilder Wucht über die Berge, der rauft die Dächer ab Jahr für Jahr; […]“"
                            },
                            {
                                "example_id": "edcd9f6c-0eba-4073-9eeb-aa300f3e3dad",
                                "sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                                "text": "„Als wir uns bei leichtem Südwind der Mündung des Ärmelkanals näherten, sichteten wir ein Segel in unserem Kielwasser, das uns Hand über Hand einholte.“"
                            },
                            {
                                "example_id": "8b19a0ba-8279-4507-a06a-af0d3b433897",
                                "sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                                "text": "„Als sich gegen Abend ein heftiger Südwind erhob, befahl ich, vor ihm herzusegeln, selbst wenn er sich noch verstärke.“"
                            },
                            {
                                "example_id": "e648356b-e665-4cbf-8bbc-3c7606b4bb90",
                                "sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                                "text": "„Gegen Mittag jedoch fing ein starker Südwind an vom Strome heraufzuwehen, und die Kraft der Sonne, die selbst Januartage in diesem Lande zu so herrlich milden Erscheinungen macht, hatte allmählich die Atmosphäre in eine zitternd-elastische Bewegung versetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6e1bb78-aacd-4930-a338-3045526b80e8",
                        "source_entry_id": "9c5158a6-dfbb-3ad4-b364-1ee73d2757da",
                        "source_sense_id": "bdf57584-b5d0-3e99-b5a4-abfcc224761f",
                        "source_sense_description": "Wind aus dem Süden",
                        "target_lang_word": "south wind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "south wind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "634542e3-054d-3365-80f2-ccae5b7b9418",
                                        "entry_id": "ea97789e-8459-3566-99dd-18d74aef39c3",
                                        "glosses": [
                                            "A wind blowing from the south."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272def78-9ee9-423a-a573-8a3bb8327f77",
                                                "sense_id": "634542e3-054d-3365-80f2-ccae5b7b9418",
                                                "text": "The watry Southwinde, from the seabord coste / Upblowing, doth disperse the vapour lo'ste, / And poures it selfe forth in a stormy showre [...]."
                                            },
                                            {
                                                "example_id": "af8d9f92-8f41-4e9c-9545-752129b307b8",
                                                "sense_id": "634542e3-054d-3365-80f2-ccae5b7b9418",
                                                "text": "Snow-melting south winds and rain below 2,400m have marred much of the fantastic early-season base and created off-piste avalanche risk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
