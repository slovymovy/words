                "senses": [
                    {
                        "sense_id": "95422c46-f6d1-3421-b0db-65c8a0617f7f",
                        "entry_id": "6938b0c9-9f73-3975-a36f-ebfbdafa2b46",
                        "glosses": [
                            "etwas, das als für einen Ort, eine Gegend besonders prägend/typisch empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35524084-b11c-4a61-85c2-3da4576f7b2f",
                                "sense_id": "95422c46-f6d1-3421-b0db-65c8a0617f7f",
                                "text": "„Aus seiner Kinderzeit in Neuruppin war ihm das Niederdeutsch der Nordmark besonders vertraut, und er benutzte es gern, um seinen Dorfbewohnern sprachlich ein Lokalkolorit zu geben.“"
                            },
                            {
                                "example_id": "3184e009-ce23-4d3c-bd7f-293fe971f3d8",
                                "sense_id": "95422c46-f6d1-3421-b0db-65c8a0617f7f",
                                "text": "„Auch bei der Gebärde für Sonntag schwingt Lokalkolorit mit: Im Norden erinnert sie mit der streichenden flachen Hand an der Brust an ein frisch gebügeltes Sonntagshemd, im Süden an betende Hände.“"
                            },
                            {
                                "example_id": "9d19d8df-facc-441d-a7b0-4f892f8b8c4f",
                                "sense_id": "95422c46-f6d1-3421-b0db-65c8a0617f7f",
                                "text": "„Gekauft wurde das Buch wegen der sicheren Präsentation Berliner Lokalkolorits.“"
                            },
                            {
                                "example_id": "d5a0da9a-d59a-4e17-b603-ed98c1dbb37f",
                                "sense_id": "95422c46-f6d1-3421-b0db-65c8a0617f7f",
                                "text": "„Lokalkolorit ist da nichts, nur was er in der eigenen Phantasie gefunden hat, angeregt durch Plutarch, »1001 Nacht«, Du Halde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
