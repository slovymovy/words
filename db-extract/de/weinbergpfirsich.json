                                        "glosses": [
                                            "Pêche produite en plein vent et qui vient à maturité à l’époque des vendanges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f0964e-8af1-41fa-ab6e-e99bcad475d6",
                                                "sense_id": "6ce327ed-a2dc-3cd8-ab84-250d483bc6b4",
                                                "text": "[…] cette même lumière exaspérée d’onze heures, qui mûrissait tôt les pommes, les fruits des ronces, et ces pêches de vigne qu’on appelle, pour cause, des durons."
                                            }
