                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Ik heb echt medelijden met je."
                                            },
                                            {
                                                "example_id": "69aa8d38-694c-4177-a300-0b1eb1167494",
                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Ze beschouwde ze niet langer als de problemen van rijke vrouwen, maar begon, in haar eigen ellendige toestand, tot haar eigen verbazing, medelijden met haar te krijgen."
                                            },
                                            {
                                                "example_id": "13db5de0-d833-49e5-906a-221c56c09628",
                                                "sense_id": "8bb3dc66-64fd-3994-8f15-8b10b766756b",
                                                "text": "Een vrouwenstem, dus niet de nukkige eigenaar die me zonder medelijden naar de kerk stuurde."
                                            }
