                "senses": [
                    {
                        "sense_id": "d0a642b8-d3fc-3dd6-a3d2-9b5e42d3eecf",
                        "entry_id": "79f11288-a3bc-3253-8cd4-e537b3f948f3",
                        "glosses": [
                            "de dunk die men van zichzelf heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab38b006-cb8e-47b5-9510-58ef1f7a246a",
                                "sense_id": "d0a642b8-d3fc-3dd6-a3d2-9b5e42d3eecf",
                                "text": "Door die gebeurtenis liep zijn zelfbeeld een flinke deuk op."
                            },
                            {
                                "example_id": "2b245411-8a25-4696-b37f-550218e9c7e5",
                                "sense_id": "d0a642b8-d3fc-3dd6-a3d2-9b5e42d3eecf",
                                "text": "`Onze gasten kunnen gerust slapen in de wetenschap dat hun vertrekken duchtig worden bewaakt; zei Montebello. `Om zich toegang te verschaffen tot de bovenverdiepingen dient men te passeren tussen de hybride verschijningsvorm van de angst en het verraderlijk spinnende poesje dat voor raadselen stelt, die respectievelijk staan voor het weinig realistische zelfbeeld van de man en het wezen van de vrouw, als u het mij toestaat u te amuseren met mijn dilettantisme op het gebied van de symboliek."
                            },
                            {
                                "example_id": "1a41a2b1-ed34-41c4-892a-64f2e3a0b8a0",
                                "sense_id": "d0a642b8-d3fc-3dd6-a3d2-9b5e42d3eecf",
                                "text": "Mensen voelen zich persoonlijk aangesproken, zegt Çankaya, en schieten daardoor in het defensief. Bovendien: ‘Het Nederlandse zelfbeeld staat ons in de weg. Nederland zou een open en tolerant land zijn. Als een buitenstaander die je met moeite als gelijke kunt beschouwen je vervolgens vertelt dat er racisme is in Nederland, dan wordt er aan dat zelfbeeld gemorreld.’"
                            }
                        ]
                    }
                ],
