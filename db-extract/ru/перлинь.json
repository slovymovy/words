                "senses": [
                    {
                        "sense_id": "f409ae8b-f276-33fc-a53a-42f9b12a893f",
                        "entry_id": "42fc0974-1ccf-3f9f-bb11-b211e1cd04d6",
                        "glosses": [
                            "морск. корабельный трос 10—15 сантиметров в окружности для буксировки и швартовки судов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2465a5f-c905-4520-a97a-c663e560aa24",
                                "sense_id": "f409ae8b-f276-33fc-a53a-42f9b12a893f",
                                "text": "Тросы от 4 до 6 дюймов в окружности называют перлинями, от 6 до 13 дюймов кабельтовами, толще 13 дюймов — канатами, а тонкие тросы из особо хорошей пеньки, толщиною в 1 дюйм и менее, называют линями."
                            },
                            {
                                "example_id": "73e3fbdc-cc7d-4f2c-b1dc-a75a386c94a2",
                                "sense_id": "f409ae8b-f276-33fc-a53a-42f9b12a893f",
                                "text": "На баржу был заведён перлинь."
                            }
                        ]
                    }
