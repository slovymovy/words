{
    "word_family": [
        "думать",
        "придумать",
        "задумать",
        "обдумать",
        "выдумка",
        "выдумщик"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "02344687-2ea0-3af1-afae-3f80f353d1c4",
                    "sense_definition": "Создать что-то новое, изобрести или разработать идею.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёный смог <w>выдумать</w> новый способ очистки воды.",
                            "target_lang_translations": {
                                "en": "The scientist was able to <w>invent</w> a new method for water purification."
                            }
                        },
                        {
                            "text": "Инженер решил <w>выдумать</w> механизм для экономии энергии.",
                            "target_lang_translations": {
                                "en": "The engineer decided to <w>devise</w> a mechanism for saving energy."
                            }
                        }
                    ],
                    "synonyms": [
                        "изобрести",
                        "придумать"
                    ],
                    "common_phrases": [
                        "выдумать способ",
                        "выдумать механизм"
                    ],
                    "target_lang_definitions": {
                        "en": "To create something new, invent, or develop an idea."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "invent",
                                "target_lang_sense_clarification": "to create or design something that has not existed before"
                            },
                            {
                                "target_lang_word": "devise",
                                "target_lang_sense_clarification": "to plan or invent a complex procedure, system, or mechanism"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93f25414-23d0-3ec6-b518-7c2821d6c52f",
                    "sense_definition": "Сочинить небылицу, ложь или вымышленную историю.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он решил <w>выдумать</w> оправдание своему опозданию.",
                            "target_lang_translations": {
                                "en": "He decided to <w>make up</w> an excuse for his lateness."
                            }
                        },
                        {
                            "text": "Не стоит <w>выдумать</w> небылицы о своих друзьях.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>fabricate</w> tall tales about your friends."
                            }
                        }
                    ],
                    "synonyms": [
                        "сочинить",
                        "нафантазировать",
                        "выдумать историю"
                    ],
                    "common_phrases": [
                        "выдумать историю",
                        "выдумать оправдание"
                    ],
                    "target_lang_definitions": {
                        "en": "To make up a falsehood, a lie, or a fictional story."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make up",
                                "target_lang_sense_clarification": "to invent a story or excuse, often to deceive"
                            },
                            {
                                "target_lang_word": "fabricate",
                                "target_lang_sense_clarification": "to invent something false, typically with the intent to deceive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7907a989-e9bb-3ced-ab2d-f31f1422e315",
                    "sense_definition": "Задумать что-либо необычное или неожиданное.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Что ты опять <w>выдумать</w> решил в этот раз?",
                            "target_lang_translations": {
                                "en": "What have you decided to <w>come up with</w> this time?"
                            }
                        },
                        {
                            "text": "Опять он <w>выдумал</w> какую-то странную затею.",
                            "target_lang_translations": {
                                "en": "He has <w>hatched</w> some strange scheme again."
                            }
                        }
                    ],
                    "synonyms": [
                        "затеять",
                        "задумать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To conceive of something unusual or unexpected."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come up with",
                                "target_lang_sense_clarification": "to produce an idea or plan, often something surprising"
                            },
                            {
                                "target_lang_word": "hatch",
                                "target_lang_sense_clarification": "to devise a plan or plot, often secret or unusual"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}