                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беркут",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cb036c85-5e20-3af3-90a8-0fe02426dfb0",
                                        "entry_id": "c0f027ce-fbdb-3db6-9792-c735e8ffdb40",
                                        "glosses": [
                                            "крупная хищная птица семейства ястребиных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e39462b-ffaf-4603-8e00-07e37006232b",
                                                "sense_id": "cb036c85-5e20-3af3-90a8-0fe02426dfb0",
                                                "text": "Только с хищностью упорною // Их [лебедей] медлительный отлёт // Над твердынею подзорною // Дикий беркут стережёт."
                                            },
                                            {
                                                "example_id": "d2e11b02-a731-4d6b-844b-165044ff34cb",
                                                "sense_id": "cb036c85-5e20-3af3-90a8-0fe02426dfb0",
                                                "text": ".. непременно и там увидит его зоркий до невероятности чёрный беркут (степной орёл), огромнейший и сильнейший из всех хищных птиц, похожий на копну сена, почерневшую от дождя, когда сидит на стогу или на сурчине, — увидит и, зашумев как буря, упадёт на бедного зайца внезапно из облаков, унесёт в длинных и острых когтях на далёкое расстояние и, опустясь на удобном месте, съест почти всего, с шерстью и мелкими костями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
