                "senses": [
                    {
                        "sense_id": "27da9e0f-2757-369f-85d8-326f39b0b7ae",
                        "entry_id": "5a470f55-27f6-38c8-8aff-33ee7b90e80c",
                        "glosses": [
                            "Dach, das an den Seiten des Hauses - wo sich sonst der Giebel befindet - abgeschrägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0d2a2e-1b60-403a-a93e-fb866af3d34e",
                                "sense_id": "27da9e0f-2757-369f-85d8-326f39b0b7ae",
                                "text": "„Mir gefällt ein Walmdach mit einer Schräge von etwa 20 Grad sehr.“"
                            },
                            {
                                "example_id": "d5626306-0aaf-42ad-89a3-14d8f9a6c3c2",
                                "sense_id": "27da9e0f-2757-369f-85d8-326f39b0b7ae",
                                "text": "„Das Walmdach besitzt an allen vier Seiten eine geneigte Dachfläche und kann dadurch dem Wind besser standhalten - warum es etwa in Norddeutschland besonders beliebt ist.“"
                            },
                            {
                                "example_id": "44271961-5eca-4c1e-9948-9e16d7a9daa2",
                                "sense_id": "27da9e0f-2757-369f-85d8-326f39b0b7ae",
                                "text": "„Der H-förmig erbauten dreigeschossigen Villa mit Walmdächern schließt sich ein großer, geschlossener Wirtschaftshof mit Wohnräumen für Bedienstete, Küche, Werkstätten, Garagen und Ställen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
