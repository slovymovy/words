                {
                    "sense_id": "c958ee08-80a9-379e-852f-456ba3384bcc",
                    "sense_definition": "An English surname derived from a nickname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author Ellery <w>Queen</w> is famous for mystery novels.",
                            "target_lang_translations": {
                                "ru": "Писатель Эллери <w>Куин</w> знаменит своими детективными романами.",
                                "zh": "作家埃勒里·<w>奎因</w>以推理小说闻名。"
                            }
