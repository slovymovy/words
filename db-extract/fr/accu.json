        "fr-extract.jsonl": [
            {
                "entry_id": "d32a7897-83d3-35b5-b9f3-7ac94384c82e",
                "word": "accu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d890a90-cbb3-4633-8c51-00b201ee6f70",
                        "entry_id": "d32a7897-83d3-35b5-b9f3-7ac94384c82e",
                        "tags": [
                            "plural"
                        ],
                        "form": "accus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29d37c9e-c52d-3b92-bfc0-baf0137a8055",
                        "entry_id": "d32a7897-83d3-35b5-b9f3-7ac94384c82e",
                        "glosses": [
                            "Accumulateur destiné à fournir de l’électricité."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3c14cb65-4bae-4a84-815d-13253d2e9382",
                                "sense_id": "29d37c9e-c52d-3b92-bfc0-baf0137a8055",
                                "text": "J’ai un chargeur d’accus qui me servait autrefois pour charger mes accus pour appareil de T. S. F."
                            }
                        ]
                    },
                    {
                        "sense_id": "e56f12a1-40e9-3ec6-81b9-1ee6957eede3",
                        "entry_id": "d32a7897-83d3-35b5-b9f3-7ac94384c82e",
                        "glosses": [
                            "Réserve d'énergie qu’une personne détient en elle-même."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "36e6f250-981c-4150-bf45-9e671d905fba",
                                "sense_id": "e56f12a1-40e9-3ec6-81b9-1ee6957eede3",
                                "text": "« N’est-ce pas un peu trop tôt pour publier un nouveau livre ? Vous avez rudement déchargé vos accus pour La Colère. Êtes-vous certain d’avoir eu le temps de le recharger ?… »"
                            },
                            {
                                "example_id": "b802a038-2052-45fe-abe0-9bdd6669ed75",
                                "sense_id": "e56f12a1-40e9-3ec6-81b9-1ee6957eede3",
                                "text": "Il plongeait sans arrêt d’un rocher en forme de pyramide. Il faisait même le saut de l’ange de manière très gracieuse. Le plongeon avait toujours eu pour lui une grande importance et un pouvoir thérapeutique. C’était le meilleur moyen – m’expliquait-il – de « se recharger les accus »."
                            }
                        ]
                    }
                ],
