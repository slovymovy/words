                                "zh": "<w>任何人</w>只要想学，都能学会弹吉他。",
                                "es": "<w>Cualquiera</w> puede aprender a tocar la guitarra si quiere.",
                                "fr": "<w>N'importe qui</w> peut apprendre à jouer de la guitare s'il le veut."
                            }
                        },
                        {
                            "text": "Это задание настолько простое, что <любой> с ним справится.",
                            "target_lang_translations": {
                                "en": "This task is so simple that <w>anyone</w> can handle it.",
                                "zh": "这项任务太简单了，<w>任何人</w>都能搞定。",
                                "es": "Esta tarea es tan sencilla que <w>cualquiera</w> puede hacerla.",
                                "fr": "Cette tâche est si simple que <w>n'importe qui</w> peut la réussir."
                            }
                        }
                    ],
                    "synonyms": [
                        "кто угодно",
                        "каждый"
                    ],
                    "antonyms": [
                        "никто"
                    ],
                    "common_phrases": [
                        "любой желающий"
                    ],
                    "target_lang_definitions": {
                        "en": "Any person; whoever.",
                        "zh": "指代任何人，无论谁。",
                        "es": "Cualquier persona; quien sea.",
                        "fr": "Désigne une personne quelconque, peu importe qui."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anyone",
                                "target_lang_sense_clarification": "any person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何人",
                                "target_lang_sense_clarification": "指代任何一个人"
                            },
                            {
                                "target_lang_word": "谁都",
                                "target_lang_sense_clarification": "强调无论谁都可以"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cualquiera",
                                "target_lang_sense_clarification": "referido a una persona indeterminada"
                            },
                            {
                                "target_lang_word": "quien sea",
                                "target_lang_sense_clarification": "énfasis en que no importa la identidad"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "n'importe qui",
                                "target_lang_sense_clarification": "indique une personne indifférente"
                            },
                            {
                                "target_lang_word": "quiconque",
                                "target_lang_sense_clarification": "toute personne, quel que soit l'individu"
                            }
                        ]
                    }
                }
            ]
        },
