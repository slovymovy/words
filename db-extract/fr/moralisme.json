        "fr-extract.jsonl": [
            {
                "entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                "word": "moralisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e964de5b-9a3d-4b75-9235-f565699fe9de",
                        "entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "moralismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f35e739c-b0f4-3b91-b47b-31a60a170ca2",
                        "entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "glosses": [
                            "Forme intégriste ou formaliste de l’attachement à la morale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef9d184-a6bf-4a52-9c21-9173cc6d8255",
                                "sense_id": "f35e739c-b0f4-3b91-b47b-31a60a170ca2",
                                "text": "Dans les jardins d'Europe, et jusque chez les peuples les plus naturels, en Italie et en Espagne, l'indécrottable moralisme petit-bourgeois a représenté le progrès, l'humanité, le courage militaire, en personnages hideux."
                            },
                            {
                                "example_id": "99ee0099-6cca-4671-9985-a74c2745dd9f",
                                "sense_id": "f35e739c-b0f4-3b91-b47b-31a60a170ca2",
                                "text": "Si l’idée de déflétrir notre nature équivaut à transformer nos besoins, à ne pas les satisfaire en l’état, il peut sembler que le danger moral que l’on encourt est celui d’un moralisme idéaliste, d’oublier les besoins de l’autre en l’état."
                            },
                            {
                                "example_id": "cab9c31b-fc9a-4bbe-a00b-ba11c253e84c",
                                "sense_id": "f35e739c-b0f4-3b91-b47b-31a60a170ca2",
                                "text": "La morale aboutit à la nature cultivée; le moralisme équivaut à une amputation."
                            }
                        ]
                    },
                    {
                        "sense_id": "d53a4577-3b54-30cd-a2cb-468ce75d1b00",
                        "entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "glosses": [
                            "Doctrine ou attitude qui érige la morale en absolu et affirme la prééminence des valeurs morales sur les autres valeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccfde5d1-172c-44cf-8b5b-069e719e8608",
                                "sense_id": "d53a4577-3b54-30cd-a2cb-468ce75d1b00",
                                "text": "Nul en effet, si ce n’est Bourdaloue peut-être, ne représente plus parfaitement que l’auteur des Essais de morale [Pierre Nicole] ce moralisme chrétien (…) qui va dominer pendant la seconde moitié du XVIIe siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f02c5fee-e07a-4970-932f-3488b90aa534",
                        "source_entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "source_sense_description": "attachement fort à la morale",
                        "target_lang_word": "Moralismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moralismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "388b7bc5-5817-3018-91bb-12e8d2951a7d",
                                        "entry_id": "dcd14e6c-dd72-398b-9a9f-47ce3df46f1b",
                                        "glosses": [
                                            "Einstellung von jemandem, auf der Einhaltung moralischer Prinzipien zu bestehen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8de121ba-928c-3fd9-8252-b2cb8bf009f4",
                                        "entry_id": "dcd14e6c-dd72-398b-9a9f-47ce3df46f1b",
                                        "glosses": [
                                            "übertriebener moralischer Anspruch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b511ecc0-9d16-43a6-8108-9759311f58c0",
                                                "sense_id": "8de121ba-928c-3fd9-8252-b2cb8bf009f4",
                                                "text": "„Man muss sie aber vor dem kostenlosen Moralismus Nachgeborener schützen, gelegentlich auch vor dem rechthaberischen Rigorismus von Zeitgenossen, die rechtzeitig beiseite springen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "736f4d07-1b37-421d-b928-e5f637f4d705",
                        "source_entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "source_sense_description": "attachement fort à la morale",
                        "target_lang_word": "moralism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moralism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27b00426-7890-3ddb-8b46-2db235847123",
                                        "entry_id": "e01deac3-e818-3d64-95fe-6aceaff48414",
                                        "glosses": [
                                            "The act or practice of moralizing (making moral reflections or judging the morality of others)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4740b961-4cd1-4cba-984b-8568cf12b672",
                                                "sense_id": "27b00426-7890-3ddb-8b46-2db235847123",
                                                "text": "1937, Helen Foster Snow (as Nym Wales), “The Modern Chinese Literary Movement” in Edgar Snow (ed.), Living China: Modern Chinese Short Stories, New York: Reynal & Hitchcock, p. 337,\nThe Romantic movement […] struggled for ‘art for art’s sake’ against the old moralism and didacticism […]"
                                            },
                                            {
                                                "example_id": "b4f31be5-1771-411f-8738-6261e21fc7a5",
                                                "sense_id": "27b00426-7890-3ddb-8b46-2db235847123",
                                                "text": "It is a bitter fact of life that, despite the air of pious moralism that chokes this cramped town, a rich man’s mistress still counts for more than a hungry saint."
                                            },
                                            {
                                                "example_id": "5ce2e93a-8838-4b55-8f7b-4b091553bc63",
                                                "sense_id": "27b00426-7890-3ddb-8b46-2db235847123",
                                                "text": "2011, Donald Weinstein, Savonarola: The Rise and Fall of a Renaissance Prophet, New Haven: Yale University Press, Chapter 1, p. 8,\nReared by conventionally pious parents, Girolamo also imbibed more than a little of his grandfather’s dour moralism along with his Latin lessons, Bible studies, and Saint Thomas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4807f44a-48dc-3dd2-ad9c-1f228326002a",
                                        "entry_id": "e01deac3-e818-3d64-95fe-6aceaff48414",
                                        "glosses": [
                                            "A maxim or saying believed by the speaker to embody a moral truth; an instance of moralizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9476cda-d42e-49a0-bd96-0548ae880427",
                                                "sense_id": "4807f44a-48dc-3dd2-ad9c-1f228326002a",
                                                "text": "There was a delicious spice of worldliness in the topics of conversation which was quite refreshing to him, accustomed as he was to the somewhat droning moralisms of his “congenial friends.”"
                                            },
                                            {
                                                "example_id": "1bb48274-14cf-4ef8-86ee-be208e544d75",
                                                "sense_id": "4807f44a-48dc-3dd2-ad9c-1f228326002a",
                                                "text": "Now is your chance, Europe. […] paddle your own canoe on a new sea, while clever America lies on her muck-heaps of gold, strangled in her own barbed wire of shalt-not ideals and shalt-not moralisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a4dca86-3a44-3621-8c5b-fe217f134bcb",
                                        "entry_id": "e01deac3-e818-3d64-95fe-6aceaff48414",
                                        "glosses": [
                                            "Religious practice that focuses on morality while placing little emphasis on doctrine or the metaphysical; adherence to a system of morality with little or no reference to religion."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2852fe-3633-4824-9297-f52fdfe4c46f",
                                                "sense_id": "8a4dca86-3a44-3621-8c5b-fe217f134bcb",
                                                "text": "That thin, colorless protestantism of her fathers had faded into a nameless moralism. She had no Christ before whom she could pour her adoration and love. Instead, she had taken to herself a man; and now the clay of his being was crumbling in her hands...."
                                            },
                                            {
                                                "example_id": "28de0f35-47fa-4a18-b548-46cc08598bd6",
                                                "sense_id": "8a4dca86-3a44-3621-8c5b-fe217f134bcb",
                                                "text": "The scientific superiority of liberal theology, it is now said, is indeed incontestable, but its theological position is weak, for its moralism and humanism lack insight into the dæmonic character of human existence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e71a8c5-9a6a-4835-8236-372c2bbb2fbe",
                        "source_entry_id": "2be73c56-f33e-3f6d-aaad-5937884f62c8",
                        "source_sense_description": "attachement fort à la morale",
                        "target_lang_word": "moralismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moralismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5feb3d64-1c19-3a8c-99c7-dd096e71eb30",
                                        "entry_id": "3480c6c9-2849-352a-8d01-f76ff16ab72a",
                                        "glosses": [
                                            "Actitud o doctrina que defiende y exalta los valores morales (las normas de buena conducta establecidas en una sociedad, cultura, época o grupo)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2137247d-1a63-3b26-b3c3-399114292a0d",
                                        "entry_id": "3480c6c9-2849-352a-8d01-f76ff16ab72a",
                                        "glosses": [
                                            "Actitud o tendencia a valorar y juzgar solo lo moral y lo inmoral de algo o de alguien, reduciendo la posibilidad de otras maneras de entenderlo, percibirlo o analizarlo."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e75ac630-6594-4dbe-84bc-392b79c86d34",
                                                "sense_id": "2137247d-1a63-3b26-b3c3-399114292a0d",
                                                "text": "entre moralidad y moralismo [hay], una contraposición tajante, porque el moralismo establece las reglas para los demás, mientras la moralidad establece las reglas para uno mismo"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
