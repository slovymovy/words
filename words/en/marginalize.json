            "senses": [
                {
                    "sense_id": "bfb810be-3baf-3194-8223-3d9dd40b41ec",
                    "sense_definition": "To treat a person, group, or concept as insignificant or peripheral, pushing them to the margins of society or discussion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government policies continue to <w>marginalize</w> minority communities across the country."
                        },
                        {
                            "text": "Activists fear that urban redevelopment projects will further <w>marginalize</w> low-income families."
                        }
                    ],
                    "synonyms": [
                        "alienate",
                        "invisibilize",
                        "peripheralize",
                        "sideline"
                    ],
                    "antonyms": [
                        "accept",
                        "prioritize"
                    ],
                    "common_phrases": [
                        "marginalize communities",
                        "marginalize vulnerable groups"
                    ]
                },
                {
                    "sense_id": "896faece-75f4-3b3e-82fb-541f6c24dfb8",
                    "sense_definition": "To integrate out or sum over certain variables in a joint probability distribution to obtain a marginal distribution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Statisticians often need to <w>marginalize</w> out nuisance parameters from the likelihood function."
                        },
                        {
                            "text": "We can <w>marginalize</w> over the hidden states to evaluate the total probability of the observed data."
                        }
                    ],
