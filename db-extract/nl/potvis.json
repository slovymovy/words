                        "entry_id": "811cd054-4612-33d1-919e-2c9592bbafaf",
                        "glosses": [
                            "bepaald soort zeezoogdier, Physeter macrocephalus uit de familie der potvissen (Physeteridae), de grootste soort tandwalvis\\nDe wetenschappelijke naam van de soort werd in 1758 gepubliceerd door Carl Linnaeus"
                        ],
                        "tags": [
                            "walvisachtigen"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7016c8a-0053-4219-8ea6-addbe8fcd608",
                        "source_entry_id": "811cd054-4612-33d1-919e-2c9592bbafaf",
                        "source_sense_id": "3846370b-a619-312c-bfec-382af3a7f024",
                        "source_sense_description": "bepaald soort zeezoogdier, Physeter macrocephalus",
                        "target_lang_word": "Pottwal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pottwal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                        "entry_id": "75dec7a1-97e4-3394-b7bc-fcb5c8bca006",
                                        "glosses": [
                                            "größter Zahnwal, wissenschaftlich: Physeter macrocephalus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d52b8b93-c321-41b5-be57-de99825b10c6",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Pottwale besitzen - wie alle Zahnwale - ein unpaares, einzelnes Blasloch."
                                            },
                                            {
                                                "example_id": "442f434b-4a56-44b6-bfa7-0bdc2aceaceb",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "„Schweinswale sind im Vergleich mit Pottwalen oder Blauwalen Zwerge.“"
                                            },
                                            {
                                                "example_id": "9deafe81-35ec-4306-8ebb-4b03f00fabc2",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Wissenschaftler haben nun errechnet, dass die Ausscheidungen eines Pottwals dazu beitragen, pro Jahr die Menge an Kohlendioxid auszugleichen, die dem Ausstoß von etwa 40.000 Autos entspricht."
                                            },
                                            {
                                                "example_id": "91aeda00-8c04-478b-82b6-8e5a0dde12ce",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "Im Pazifik wurden [… von japanischen Walfängern] insgesamt 190 Wale gefangen, darunter Zwerg-, Sei- und Pottwale."
                                            },
                                            {
                                                "example_id": "867c455d-683e-4dd7-989f-2d1f8e09c308",
                                                "sense_id": "cbed7070-869e-3232-880d-bb5eea000487",
                                                "text": "„2015 wurde ein Pottwal an einem der isländischen schwarzen Strände angespült, rund dreißig Autominuten von Vík entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0af31a3-8cfb-49bc-88e4-9dd61d4fa28d",
                        "source_entry_id": "811cd054-4612-33d1-919e-2c9592bbafaf",
