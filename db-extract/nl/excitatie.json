                        "target_lang_word": "excitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of exciting or putting in motion; the act of rousing up or awakening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b55be7-01ad-4e94-8e39-8c33cdc31bce",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Generator excitation is obtained by a combination of the separately-excited and self-excited fields, and the output is controlled by a resistance in the separate field circuit adjusted by the load regulator under the control of the engine governor."
                                            },
                                            {
                                                "example_id": "9c530a0c-874e-4898-a825-ba8c3dca4835",
                                                "sense_id": "67410905-0938-3de7-bf65-adf17a2fedc6",
                                                "text": "Wheelslip automatically causes the main generator field excitation to be reduced; the load regulator is forced back to minimum excitation and, if operating in one of the two stages of traction motor field divert, causes reversion to full field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The act of producing excitement (stimulation); also, the excitement produced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffbb3a1-b831-4068-bab2-29a8ebaff0ae",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "Baiae: An ancient Roman pleasure resort [...]. It was the focal point of all kinds fo erotic experiments, unbridled debauchery, amorous intrigues and excitations, sexual encounters and aberrations."
                                            },
                                            {
                                                "example_id": "c352e121-5ac0-4f92-8c7d-22be807ca3b9",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "I'm pickin' up good vibrations / She's giving me the excitations."
                                            },
                                            {
                                                "example_id": "85ea7e11-9fa1-476f-9fa2-43268af24465",
                                                "sense_id": "23b155b5-0dda-3a27-b060-bc3be0e7f708",
                                                "text": "The erotics of composition are essential to the process, some prereflective excitation and orientation, some sense that your own little verse-craft can dock safe and sound at the big quay of language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a003819-b22e-3285-9684-a3f308d08bdf",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "The activity produced in an organ, tissue, or part, such as a nerve cell, as a result of stimulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dbd18c0-b028-347c-aaef-b40cea738f2d",
                                        "entry_id": "90173339-811c-344d-b6c1-1a5517652f5f",
                                        "glosses": [
                                            "A transition of a nucleus, atom or molecule to an excited state by the absorption of a quantum of energy; the opposite of relaxation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b85248c-f7fa-409b-824f-bff5493cd9c6",
                        "source_entry_id": "6a805c22-f03e-3309-acbe-9a19fd753d95",
                        "source_sense_id": "2b26ca36-9792-3524-b1ef-41577b04b814",
                        "source_sense_description": "opgewondenheid",
                        "target_lang_word": "excitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d778e423-7e24-317d-9a41-2c3830189d5d",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "Action d’exciter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce11a28-533b-44b0-b7d3-5d5996d554ab",
                                                "sense_id": "d778e423-7e24-317d-9a41-2c3830189d5d",
                                                "text": "Pendant ce temps, dans la cité géante, le mouvement insurrectionnel échappait à tout contrôle. […]. Au début, la rébellion ne se manifesta que par des vociférations isolées, des harangues sur les places et des excitations dans la presse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169385a6-ae0c-32d6-ad61-44d1c64c6d6f",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "État de ce qui est excité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46f31b3-e066-4a53-96fb-178b654f4e28",
                                                "sense_id": "169385a6-ae0c-32d6-ad61-44d1c64c6d6f",
                                                "text": "Il se fâcha contre lui-même, lutta contre cette excitation dont il ne dissimulait pas la nature, presque toute matérielle."
                                            },
                                            {
                                                "example_id": "d71b9d84-2ed1-47e9-bd56-394d9b8f8f6d",
                                                "sense_id": "169385a6-ae0c-32d6-ad61-44d1c64c6d6f",
                                                "text": "J'arrivai à Bruxelles quand éclata la nouvelle que des tanks russes encerclaient Budapest. Noircissant encore le tableau, pourtant déjà sombre, mon jovial chauffeur de taxi s'écriait : « Les Russes foutent là-dedans des bombes au phosphore ; ça brûle ; faut voir ça ! » Le brave homme était emporté lui aussi, non certes par l’enthousiasme, car il craignait les Russes, mais par cette espèce d'excitation quasi joyeuse qu'inspirent aux trois quarts des gens un bel incendie ou un bel accident de chemin de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "880d4c5a-2e31-3b00-bb94-969bcf6fa138",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "Action exercée sur un organisme qui déclenche une réponse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa78b82-ee45-4a6a-b29f-081b6f6e1731",
                                                "sense_id": "880d4c5a-2e31-3b00-bb94-969bcf6fa138",
                                                "text": "Excitation de l’organisme. Excitation locale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b456cddf-7033-3e99-94a9-edadb7694883",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "État d’activité anormalement intense des fonctions physiques ou psychiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff44063a-2802-4a0e-94a2-76377aa77219",
                                                "sense_id": "b456cddf-7033-3e99-94a9-edadb7694883",
                                                "text": "Excitation intellectuelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d6e7094-c502-3b01-ab5b-258cb4bf6fe1",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "Action tendant à provoquer une réaction, une modification d’état, une stimulation ou un sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e451f87-c58f-4778-bb1b-a6421aa90b8b",
                                                "sense_id": "5d6e7094-c502-3b01-ab5b-258cb4bf6fe1",
                                                "text": "Excitation à la débauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb0c364b-d73d-3bc0-81bc-4851d95717ab",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "Production d’un flux d’induction dans un circuit magnétique, au moyen d’un courant électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fab6c8-9267-4940-9cf9-e52772afb3a0",
                                                "sense_id": "fb0c364b-d73d-3bc0-81bc-4851d95717ab",
                                                "text": "Les électro-aimants inducteurs N, S, N, S, etc., sont pourvus d'un enroulement de fil unique, dont le sens alterne de l'un à l'autre; les noyaux de ces electros sont en fer doux ou en fonte; le courant d’excitation est fourni par une petite dynamo à courant continu, du type supérieur Gramme, montée sur le même arbre que l'inducteur de l'alternateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8c318a-0396-3e5a-b228-6cd2faf72ef9",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "(Radiocommunication) Production d’oscillations électriques dans un circuit électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c9a8187-d0a4-3032-a3fd-af70bf34c75f",
                                        "entry_id": "85b3448b-6f59-31df-9964-0d513cf0c8d6",
                                        "glosses": [
                                            "Absorption d’une quantité d’énergie qui provoque une modification d’état."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c5faa4-9867-45da-be73-7287b5499dfc",
                                                "sense_id": "4c9a8187-d0a4-3032-a3fd-af70bf34c75f",
                                                "text": "Au delà de 10⁷ Hz, la masse des électrons est elle-même trop importante pour que ceux-ci puissent suivre l’excitation, et le matériau a alors un comportement diélectrique semblable à celui du vide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
