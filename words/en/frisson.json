    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ace00135-d764-38ad-a026-c44eb364dcf6",
                    "sense_definition": "A brief, sudden sensation of excitement, fear, or pleasure, often felt as a physical shudder or chill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excitement_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>frisson</w> of fear ran through the audience during the intense climax.",
                            "target_lang_translations": {
                                "ru": "В напряжённый момент кульминации по залу пробежала внезапная <w>дрожь</w> страха."
                            }
                        },
                        {
                            "text": "Whenever the eerie melody began to play, she felt a distinct <w>frisson</w> down her spine.",
                            "target_lang_translations": {
                                "ru": "Каждый раз, когда начинала звучать эта жуткая мелодия, у неё по спине пробегали отчётливые <w>мурашки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver",
                        "thrill",
                        "tremor"
                    ],
                    "common_phrases": [
                        "frisson of excitement",
                        "frisson of fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое, внезапное ощущение возбуждения, страха или удовольствия, часто физически ощущаемое как дрожь или мурашки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "физическое ощущение озноба, содрогания от эмоций"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "волнительное ощущение, внутренняя дрожь"
                            },
                            {
                                "target_lang_word": "мурашки",
                                "target_lang_sense_clarification": "ощущение покалывания или озноба по коже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01cfeb12-6583-3b4f-a94d-dfcde87c3067",
                    "sense_definition": "A sudden surge of emotional excitement or anticipation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "excitement_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected arrival of the celebrity caused a noticeable <w>frisson</w> in the ballroom.",
                            "target_lang_translations": {
                                "ru": "Неожиданное появление знаменитости вызвало заметное <w>оживление</w> в бальном зале."
                            }
                        },
                        {
                            "text": "He felt a <w>frisson</w> just as the presenter opened the envelope to announce the winner.",
                            "target_lang_translations": {
                                "ru": "Он ощутил <w>трепет</w>, как только ведущий вскрыл конверт, чтобы объявить победителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "surge",
                        "rush"
                    ],
                    "common_phrases": [
                        "cause a frisson",
                        "feel a frisson"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный прилив эмоционального возбуждения, волнения или предвкушения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнение",
                                "target_lang_sense_clarification": "эмоциональное оживление, возбуждение"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "эмоциональный подъем, благоговейное или напряженное чувство"
                            },
                            {
                                "target_lang_word": "оживление",
                                "target_lang_sense_clarification": "всплеск эмоций среди людей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}