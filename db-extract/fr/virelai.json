                    {
                        "sense_id": "f37e81d9-3724-349a-8f5f-e7ca356bd8ad",
                        "entry_id": "54c2d72a-7036-3c22-bf41-5a49dc46f852",
                        "glosses": [
                            "Ancienne petite pièce de poésie française, qui est toute sur deux rimes et composée de vers courts, avec des refrains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1480af81-b235-488f-94e9-54f1449f48b1",
                                "sense_id": "f37e81d9-3724-349a-8f5f-e7ca356bd8ad",
                                "text": "Au moment où nous revenons à eux, ce couple joyeux s’était mis à chanter un virelai dans lequel le bouffon soutenait le refrain, …."
                            },
                            {
                                "example_id": "5a5eabf4-1380-42e7-86dc-e98abb49d208",
                                "sense_id": "f37e81d9-3724-349a-8f5f-e7ca356bd8ad",
                                "text": "Mouillebouche : – Moi ?… rien… je respirais la brise embaumée du soir… en murmurant un virelai moderne…"
                            },
                            {
                                "example_id": "38321002-0475-424e-8ac6-d6348be4c702",
                                "sense_id": "f37e81d9-3724-349a-8f5f-e7ca356bd8ad",
                                "text": "On l’entendait déclamer d’une voix grave des virelais et des odes latines."
                            }
                        ]
                    }
                ],
