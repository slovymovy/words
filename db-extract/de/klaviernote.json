                        "entry_id": "1a2540e7-8491-3674-84b2-e54cf14efdb9",
                        "glosses": [
                            "Note, die auf einem Klavier gespielt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a133eae5-b27d-429e-8958-7150ee4df4c2",
                                "sense_id": "de1c1c79-4f94-3390-ad07-228564a5f3a7",
                                "text": "„Ich habe viele Noten gekauft, ich habe jede Menge Klaviernoten, und früher habe ich sie gelesen und gespielt, und zwar schlecht.“"
                            },
                            {
                                "example_id": "edbdc616-2fed-4162-9004-dd63259f6358",
                                "sense_id": "de1c1c79-4f94-3390-ad07-228564a5f3a7",
                                "text": "„Einst hatte er die Fürstin wiederholt zurechtgewiesen, wie sie eine gewisse Klaviernote mit einem bestimmten Finger greifen müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
