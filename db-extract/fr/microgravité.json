                "senses": [
                    {
                        "sense_id": "ce79c1a3-61a5-3fe1-857f-373be8918166",
                        "entry_id": "0c5e40e0-e43a-33a8-bc70-c02f20241543",
                        "glosses": [
                            "Micropesanteur."
                        ],
                        "tags": [],
                        "note": "C’est le sens le plus largement attesté",
                        "examples": [
                            {
                                "example_id": "98765da7-da5d-4725-bcf8-6ab6f2dcb99a",
                                "sense_id": "ce79c1a3-61a5-3fe1-857f-373be8918166",
                                "text": "L’exposition à la microgravité constitue également une situation privilégiée pour l’étude du contrôle de l’orientation posturale."
                            }
                        ]
                    },
                    {
                        "sense_id": "33a5bb5a-8460-36d5-ac03-bdf57febdeb0",
                        "entry_id": "0c5e40e0-e43a-33a8-bc70-c02f20241543",
                        "glosses": [
                            "Se dit de la résultante de l’ensemble des forces d’origine gravitationnelle auxquelles est soumis un corps, lorsqu’elle est très faible par rapport à la pesanteur à la surface de la Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bbfd464-6757-4708-8580-02a649c4da11",
                                "sense_id": "33a5bb5a-8460-36d5-ac03-bdf57febdeb0",
                                "text": "«Il y a de nombreuses expériences sur les effets de la microgravité sur le corps humain, ce qui pourrait s’avérer utile dans des missions prolongées vers Mars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e756ad5f-ab9e-4802-8d18-1447c332c0e4",
                        "source_entry_id": "0c5e40e0-e43a-33a8-bc70-c02f20241543",
                        "target_lang_word": "microgravity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microgravity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0111bb20-a441-363a-b359-5581f9401c86",
                                        "entry_id": "6554dfd0-a34a-31e6-8562-9bfd83798bb5",
                                        "glosses": [
                                            "A state of very low acceleration between two free floating objects, as found in sustained freefall, in orbit, or in interstellar space."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6822de5e-7ce6-46a4-ae93-57f525092b76",
                                                "sense_id": "0111bb20-a441-363a-b359-5581f9401c86",
                                                "text": "In microgravity their arteries are thickening and stiffening and the muscle of the heart weakening and shrinking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
