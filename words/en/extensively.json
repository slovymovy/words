{
    "word_family": [
        "extensive",
        "extend",
        "extension",
        "extent",
        "extensible"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a35401ed-a6b5-3745-a451-52bdecb36890",
                    "sense_definition": "In a way that covers a large area or has a wide scope.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has traveled <w>extensively</w> throughout Europe and Asia to learn about different cultures.",
                            "target_lang_translations": {
                                "ru": "Она <w>много</w> путешествовала по Европе и Азии, чтобы узнать о разных культурах.",
                                "nl": "Ze heeft <w>uitgebreid</w> door Europa en Azië gereisd om meer te leren over verschillende culturen.",
                                "tr": "Farklı kültürleri öğrenmek için Avrupa ve Asya'yı <w>geniş çapta</w> gezdi."
                            }
                        },
                        {
                            "text": "The professor has read <w>extensively</w> on the subject of ancient history.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>много</w> читал по предмету древней истории.",
                                "nl": "De professor heeft <w>uitgebreid</w> gelezen over het onderwerp oude geschiedenis.",
                                "tr": "Profesör, antik tarih konusunda <w>kapsamlı bir şekilde</w> okumalar yapmıştır."
                            }
                        }
                    ],
                    "synonyms": [
                        "widely",
                        "broadly"
                    ],
                    "antonyms": [
                        "narrowly"
                    ],
                    "common_phrases": [
                        "travel extensively",
                        "read extensively",
                        "write extensively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, который охватывает большую область или имеет широкий размах.",
                        "nl": "Op een manier die een groot gebied beslaat of een brede reikwijdte heeft.",
                        "tr": "Geniş bir alanı kapsayacak veya geniş bir kapsama sahip olacak şekilde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широко",
                                "target_lang_sense_clarification": "касательно охвата или распространения"
                            },
                            {
                                "target_lang_word": "много",
                                "target_lang_sense_clarification": "касательно количества действий (например, путешествий)"
                            },
                            {
                                "target_lang_word": "обширно",
                                "target_lang_sense_clarification": "касательно пространства или глубины знаний"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitgebreid",
                                "target_lang_sense_clarification": "met een grote reikwijdte of op grote schaal"
                            },
                            {
                                "target_lang_word": "op grote schaal",
                                "target_lang_sense_clarification": "betrekking hebbend op de omvang van een activiteit"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kapsamlı bir şekilde",
                                "target_lang_sense_clarification": "geniş bir alanı veya konuyu içerecek biçimde"
                            },
                            {
                                "target_lang_word": "geniş çapta",
                                "target_lang_sense_clarification": "büyük bir ölçekte veya yaygın olarak"
                            },
                            {
                                "target_lang_word": "yoğun olarak",
                                "target_lang_sense_clarification": "epeyce veya çokça (seyahat, okuma vb.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15ac05b1-f082-3543-a641-4d6b8e4e3328",
                    "sense_definition": "To a large degree or amount; substantially.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old library was <w>extensively</w> damaged by the fire and required major repairs.",
                            "target_lang_translations": {
                                "ru": "Старая библиотека была <w>сильно</w> повреждена пожаром и требовала капитального ремонта.",
                                "nl": "De oude bibliotheek was <w>aanzienlijk</w> beschadigd door de brand en vereiste grote reparaties.",
                                "tr": "Eski kütüphane yangında <w>büyük ölçüde</w> hasar gördü ve kapsamlı bir onarım gerektirdi."
                            }
                        },
                        {
                            "text": "This new software has been <w>extensively</w> tested to ensure it works correctly.",
                            "target_lang_translations": {
                                "ru": "Это новое программное обеспечение было <w>тщательно</w> протестировано, чтобы гарантировать его правильную работу.",
                                "nl": "Deze nieuwe software is <w>intensief</w> getest om te garanderen dat deze correct werkt.",
                                "tr": "Bu yeni yazılım, düzgün çalıştığından emin olmak için <w>ayrıntılı bir şekilde</w> test edildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "substantially",
                        "greatly",
                        "considerably",
                        "heavily"
                    ],
                    "antonyms": [
                        "minimally",
                        "slightly",
                        "little"
                    ],
                    "common_phrases": [
                        "extensively damaged",
                        "extensively tested",
                        "extensively renovated",
                        "extensively researched"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени или объеме; существенно.",
                        "nl": "In grote mate of hoeveelheid; aanzienlijk.",
                        "tr": "Büyük ölçüde veya miktarda; önemli derecede."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "о степени воздействия или повреждения"
                            },
                            {
                                "target_lang_word": "значительно",
                                "target_lang_sense_clarification": "существенно, в большой степени"
                            },
                            {
                                "target_lang_word": "тщательно",
                                "target_lang_sense_clarification": "подробно и глубоко (например, о проверках)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "intensief",
                                "target_lang_sense_clarification": "met veel aandacht of ingrepen"
                            },
                            {
                                "target_lang_word": "aanzienlijk",
                                "target_lang_sense_clarification": "in grote mate of hoeveelheid"
                            },
                            {
                                "target_lang_word": "grondig",
                                "target_lang_sense_clarification": "zeer zorgvuldig en diepgaand"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "büyük ölçüde",
                                "target_lang_sense_clarification": "önemli oranda veya derecede"
                            },
                            {
                                "target_lang_word": "kapsamlıca",
                                "target_lang_sense_clarification": "ayrıntılı ve etraflı bir şekilde (test, araştırma vb.)"
                            },
                            {
                                "target_lang_word": "ciddi şekilde",
                                "target_lang_sense_clarification": "ağır ya da yüksek derecede (hasar vb.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
