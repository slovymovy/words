                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "970d9b01-98f6-3fb3-8371-5166a3be543d",
                                        "entry_id": "c5c77dd7-93b8-3aca-bf65-35a927b07727",
                                        "glosses": [
                                            "A lump of soft or sticky material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a38484-7e7c-4997-a21f-a80a5dc989d0",
                                                "sense_id": "970d9b01-98f6-3fb3-8371-5166a3be543d",
                                                "text": "1952, The Glass Industry, Volume 33, Ashlee Publishing Company, page 309,\nThese inventors have discovered that gobs may be fed at widely spaced times without allowing the glass to flow during the interval but instead flushes out the chilled glass which accumulates during the dwell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ad66da-cfb7-3686-aed5-347b63539101",
                                        "entry_id": "c5c77dd7-93b8-3aca-bf65-35a927b07727",
                                        "glosses": [
                                            "Saliva or phlegm."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e7abc69-18d4-4d75-bcc9-0a3170e4e491",
                                                "sense_id": "05ad66da-cfb7-3686-aed5-347b63539101",
                                                "text": "He spat a big ball of gob on to the pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29873eb-3004-3a0d-89ec-a8edf2945cd2",
                                        "entry_id": "c5c77dd7-93b8-3aca-bf65-35a927b07727",
                                        "glosses": [
                                            "A whoopie pie."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "regional"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f82cc49-1927-3542-a41f-472ac010c41a",
                                        "entry_id": "3f56b615-02ec-35ec-a1c3-695692a2493d",
                                        "glosses": [
                                            "To gather into a lump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6556504-eed7-4c73-998c-f2b593402f74",
                                                "sense_id": "2f82cc49-1927-3542-a41f-472ac010c41a",
                                                "text": "1997 March, William G. Tapply, How to Catch a Trout on a Sandwich, Field & Stream, page 60,\nI liked to gob up two or three worms on a snelled hook, pinch three or four split shot onto the leader, and plunk it into the dark water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab89dc7-963f-3314-8822-20d4c00d0697",
                                        "entry_id": "3f56b615-02ec-35ec-a1c3-695692a2493d",
                                        "glosses": [
                                            "To spit, especially to spit phlegm."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a11768-efc2-38f5-a8bb-92c2af9825ba",
                                        "entry_id": "73753a95-a2ef-3f70-805b-9c42b97343e0",
                                        "glosses": [
                                            "The mouth."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "036274e4-0033-4c1c-b8ef-2c30131d2c43",
                                                "sense_id": "12a11768-efc2-38f5-a8bb-92c2af9825ba",
                                                "text": "He′s always stuffing his gob with fast food."
                                            },
                                            {
                                                "example_id": "145a0133-8ec4-4c6f-972e-b08ef9ad994d",
                                                "sense_id": "12a11768-efc2-38f5-a8bb-92c2af9825ba",
                                                "text": "Oi, you, shut your gob!"
                                            },
                                            {
                                                "example_id": "1e16b3a1-436e-4709-9eeb-1747d5453737",
                                                "sense_id": "12a11768-efc2-38f5-a8bb-92c2af9825ba",
                                                "text": "She's got such a gob on her – she's always gossiping about someone or other."
                                            },
                                            {
                                                "example_id": "cbbfca6a-8c18-456e-96dc-5e645ecc2eda",
                                                "sense_id": "12a11768-efc2-38f5-a8bb-92c2af9825ba",
                                                "text": "Now washing you will be like washing a goth / All that black lipstick around their gobs"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f44f543e-44e6-3461-a443-79464436af9e",
                                        "entry_id": "f48bdd4b-f639-3657-93dd-f0a28e4872aa",
                                        "glosses": [
                                            "Waste material in old mine workings, goaf."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90ad8b1b-885e-437a-84b6-a3492e375ef0",
                                                "sense_id": "f44f543e-44e6-3461-a443-79464436af9e",
                                                "text": "This consisted in wheeling gob back to the most distant part of the stope and filling up the sets right up to the roof."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e550f18-d906-3725-bfca-4342d6cac493",
                                        "entry_id": "b7881074-72ba-34c2-9525-e17a328300bc",
                                        "glosses": [
                                            "To pack away waste material in order to support the walls of the mine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                        "entry_id": "abbe43f4-f892-3e01-8ea7-42263f75edb5",
                                        "glosses": [
                                            "A sailor."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ec710e-d5e3-4426-9ff0-4cbf039fe3f6",
                                                "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                                "text": "Well I have taken the oath of allegiance for 4 years service anywhere in the world and am now a real 'gob' in the U. S. Navy."
                                            },
                                            {
                                                "example_id": "92fa1776-54e3-41a4-b99f-57a8a4a91ed8",
                                                "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                                "text": "If it weren't for the Fleet I should scarcely be able to endure it. Gobs are always amusing, as you know."
                                            },
                                            {
                                                "example_id": "2ce3de27-6626-4ebf-9c96-32af3da2b2eb",
                                                "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                                "text": "Full-cut, dashing \"gob\" slacks with back pocket."
                                            },
                                            {
                                                "example_id": "77b59350-c940-43b9-839d-efc41a5abff1",
                                                "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                                "text": "1944 November, Fitting the Gob to the Job, Popular Mechanics, page 18,\nFor the first time in history, new warship crews are virtually “prefabricated” by modern methods of fitting the gob to the job."
                                            },
                                            {
                                                "example_id": "918151e3-3168-4148-b906-cdd57a00ba8b",
                                                "sense_id": "34e64e5c-0659-3cf1-90a6-1a034c73a440",
                                                "text": "1948 June, Fred B. Barton, Mending Broken Gobs, The Rotarian, page 22,\nTaking a safe average of 2,000 rehabilitated young gobs a year, that′s a total of 100,000 years of salvaged manhood, a target worth shooting at."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "824179e2-b4bd-32d1-bcfe-ac3764617bce",
                                        "entry_id": "b4060e02-de8d-3b0c-aae5-5262573598a7",
                                        "glosses": [
                                            "(nautical)"
                                        ],
                                        "tags": [
                                            "empty-gloss",
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084ab8f0-7a9b-4a8b-8290-0882f9edd3bf",
                                                "sense_id": "824179e2-b4bd-32d1-bcfe-ac3764617bce",
                                                "text": "To save having to enter the locks at a crawl — not seamanlike in the strong cross-winds we often experienced ― I rigged a quarter-rope as described for stopping her, in addition to a gob-rope that I could immediately haul on to convert the quarter rope into a conventional stern line to hold her alongside after we had stopped."
                                            },
                                            {
                                                "example_id": "001c20b5-ff9f-4767-a999-6a92128a578a",
                                                "sense_id": "824179e2-b4bd-32d1-bcfe-ac3764617bce",
                                                "text": "The towing point can be a bullnose up forward, a tow bitt aft, a staple, a towing hook, or a gob line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
