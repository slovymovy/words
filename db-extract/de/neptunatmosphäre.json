                ],
                "senses": [
                    {
                        "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                        "entry_id": "0ae4954f-4e0e-3e89-ab42-79d9234c8c0e",
                        "glosses": [
                            "Atmosphäre des Planeten Neptun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec2c5d4-0998-4d60-bac5-abe0c795dce4",
                                "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                                "text": "„Die Astronomen um Paul Hartogh vom Max-Planck-Institut für Sonnensystemforschung im niedersächsischen Katlenburg-Lindau schließen das aus der Verteilung von Kohlenmonoxid in der Neptunatmosphäre, die mit ‚Herschel‘ sichtbar wird und sich nur durch einen Kometeneinschlag erklären lässt.“"
                            },
                            {
                                "example_id": "22c00fc0-f50d-4857-b703-5cb2384b418f",
                                "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                                "text": "„Die obere, wärmere Region der Neptunatmosphäre besteht im wesentlichen aus molekularem und atomarem Wasserstoff mit einer geringen Beimischung von Helium.“"
                            },
                            {
                                "example_id": "dcba2a80-bba8-47dc-8c9f-dcd5d5535f0d",
                                "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                                "text": "„Das Aufblitzen des Sternes ermöglichte es auch, den Methangehalt der vorwiegend aus Wasserstoff bestehenden Neptunatmosphäre zu bestimmen.“"
                            },
                            {
                                "example_id": "044e72e2-7858-4e1d-93f7-da669ee4455a",
                                "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                                "text": "„Diese größere innere Wärmequelle scheint auch dafür verantwortlich zu sein, daß die Neptunatmosphäre ‚aktiver‘ ist als die des Uranus (was sich auch in einer stärkeren Durchmischung äußert).“"
                            },
                            {
                                "example_id": "b718461e-ef78-4dd1-af06-b047aeb2a63e",
                                "sense_id": "bda34424-0291-39e9-b242-e93c01121540",
                                "text": "„Wie bei Uranus ist das Vorhandensein von Methan in der Neptunatmosphäre durch Untersuchung des Spektrums festgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
