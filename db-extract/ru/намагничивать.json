                                                "example_id": "e717ccb8-709c-40c8-91fc-ad2201ae0683",
                                                "sense_id": "a68e605e-792a-3695-8311-fc984eee3902",
                                                "text": "La petite grimace qui accompagne ses dires me tire un ricanement, puis je remarque qu’elle se force à ne pas zieuter plus bas que mon visage, aimantant son regard au mien."
                                            },
                                            {
                                                "example_id": "fb97cc11-ebac-4c20-a923-bda4e7b1fc3a",
                                                "sense_id": "a68e605e-792a-3695-8311-fc984eee3902",
