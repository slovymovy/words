{
    "word_family": [
        "amphoric",
        "amphoral"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b07aab0-6aa9-36f9-84db-343802c6851c",
                    "sense_definition": "A large two-handled clay jar or vessel with a narrow neck, used in ancient Greece and Rome to store and transport oil, wine, and other liquids.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists uncovered an ancient <w>amphora</w> containing traces of preserved olive oil."
                        },
                        {
                            "text": "The museum display included a beautifully decorated Greek <w>amphora</w> from the fifth century BC."
                        }
                    ],
                    "common_phrases": [
                        "Greek amphora",
                        "Roman amphora",
                        "ancient amphora"
                    ]
                },
                {
                    "sense_id": "5f7d9bb6-aa5a-3bc4-8974-2671419e513d",
                    "sense_definition": "An ancient Roman unit of liquid measure, equivalent to the capacity of about twenty-six liters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchants recorded their wine trade using the Roman <w>amphora</w> as the standard measurement."
                        },
                        {
                            "text": "One liquid <w>amphora</w> was defined as roughly equivalent to forty-eight sextarii."
                        }
                    ],
                    "synonyms": [
                        "Roman amphora",
                        "quadrantal",
                        "amphora quadrantal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical unit of measurement"
                        }
                    ]
                },
                {
                    "sense_id": "e66544a5-1637-3e8e-a748-5d47e300bc79",
                    "sense_definition": "An ancient Roman unit of ship cargo capacity, roughly corresponding to the space required for one standard vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_of_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant ship could carry a cargo of over two thousand <w>amphorae</w>."
                        },
                        {
                            "text": "Port officials calculated maritime taxes based on the vessel capacity in <w>amphoras</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical unit of cargo capacity"
                        }
                    ]
                },
                {
                    "sense_id": "53ab734f-203a-30e1-9afb-646168ed0a73",
                    "sense_definition": "The lower portion or valve of a capsule-like fruit that opens by a transverse line.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the lid separated from the fruit, the lower <w>amphora</w> retained the seeds."
                        },
                        {
                            "text": "Botanists analyzed the morphology of the <w>amphora</w> to identify the plant species."
                        }
                    ]
                }
            ]
        }
    ]
}