                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1d47b2f1-4014-3d2f-8190-7e5c7a66aaab",
                                        "entry_id": "0f88899d-ad3d-3302-85ec-a8ce11bf4f17",
                                        "glosses": [
                                            "de mate van oprecht zijn, eerlijkheid, van goede wil zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876e513b-933b-40d9-9c31-ad32314a61c6",
                                                "sense_id": "1d47b2f1-4014-3d2f-8190-7e5c7a66aaab",
                                                "text": "Hij toonde zijn oprechtheid door ze alles te vertellen."
                                            },
                                            {
                                                "example_id": "661e1b15-f9f3-486e-8f78-af056b67c64f",
                                                "sense_id": "1d47b2f1-4014-3d2f-8190-7e5c7a66aaab",
                                                "text": "Kleine Woord aarzelde geen moment. Hij geloofde in de oprechtheid van Wilde Wingerd en de anderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62e171cd-e12a-4aae-b65e-80e0476307b0",
                        "source_entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
                        "source_sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                        "source_sense_description": "integrity",
                        "target_lang_word": "Probität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "629bb741-13e1-4db2-94b4-adcd518e1153",
                        "source_entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
                        "source_sense_id": "e207721c-f779-32d4-9d65-293174ce5bce",
                        "source_sense_description": "integrity",
                        "target_lang_word": "Rechtschaffenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtschaffenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                        "entry_id": "1403ff06-85c8-310b-a10c-b9549427e4de",
                                        "glosses": [
                                            "Zustand, in dem jemand oder etwas rechtschaffen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cba4fc-f1e9-4b35-a1dc-03bf065090d2",
                                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                                "text": "Die Rechtschaffenheit des Kandidaten beeindruckte die Wählerschaft."
                                            },
                                            {
                                                "example_id": "74cd9495-a9f8-4a1a-b7d4-d86f2bb7e20e",
                                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                                "text": "„Das hatte er vor allem seiner sittlichen Rechtschaffenheit zu verdanken und seiner Gottesfurcht, die sein steifer weißer Kragen ausstrahlte.“"
                                            },
                                            {
                                                "example_id": "e55f956b-f5d1-4f06-87a9-313191fb30aa",
                                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                                "text": "„Als wir den Raum verließen, in dem wir gespeist hatten, fragte ich Graf Bonneval, wer der Gast sei; er antwortete mir, daß der Türke ein reicher und weiser Philosoph von anerkannter Rechtschaffenheit sei, dessen Sittenreinheit ebenso groß sei wie seine Religiosität.“"
                                            },
                                            {
                                                "example_id": "53cd4bb9-e4e1-4fdf-9897-2bd03ffea00c",
                                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                                "text": "„Unabhängigkeit von jedermann war das Fundament, auf dem sein inneres Glücksgefühl erwuchs, ein Gefühl der Freiheit und Rechtschaffenheit, das allein möglich wurde durch Sparsamkeit und Regelmäßigkeit, mit denen er seine ökonomischen Verhältnisse in Ordnung hielt.“"
                                            },
                                            {
                                                "example_id": "8a5cb0fc-5859-4fe9-926e-480ae1e29938",
                                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                                "text": "„Die Ursache dazu war, daß die Tochter des dahingegangenen Richters Eydalin entschlossen war, Jón Hreggvidssons Sache zum Prüfstein für die Rechtschaffenheit ihres seligen Vaters als Richter zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e75c02a-9ac0-458c-82da-1327d0995c23",
                        "source_entry_id": "69fc911c-570e-3200-9cc9-da8e8a9ef69e",
