    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a473cb6-5acf-3c53-989d-e9d6cfe13df4",
                    "sense_definition": "A small bird with a brown back and a red or orange breast.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bird_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>robin</w> sat on the garden fence and sang a beautiful song.",
                            "target_lang_translations": {
                                "ru": "<w>Малиновка</w> сидела на садовом заборе и пела красивую песню.",
                                "zh": "<w>知更鸟</w>停在花园的篱笆上，唱着动听的歌。"
                            }
                        },
                        {
                            "text": "We saw a little <w>robin</w> looking for worms in the grass.",
                            "target_lang_translations": {
                                "ru": "Мы увидели маленькую <w>малиновку</w>, ищущую червяков в траве.",
                                "zh": "我们看到一只小<w>知更鸟</w>在草丛里找虫子吃。"
                            }
                        }
                    ],
                    "synonyms": [
                        "redbreast",
                        "robin redbreast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая птица с коричневой спинкой и красной или оранжевой грудкой.",
                        "zh": "一种背部呈褐色、胸部呈红色或橙色的小型鸟类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малиновка",
                                "target_lang_sense_clarification": "птица"
                            },
                            {
                                "target_lang_word": "зарянка",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知更鸟",
                                "target_lang_sense_clarification": "鸟类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f83e0aa-0ddc-3e2e-a132-5b7199ea69ad",
                    "sense_definition": "A nickname for a fan, player, or member of a sports team called the Robins.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a loyal <w>Robin</w> since he was a child and never misses a match.",
                            "target_lang_translations": {
                                "ru": "Он был преданным <w>Робином</w> с детства и никогда не пропускает матчи.",
                                "zh": "他从小就是“知更鸟队”的忠实<w>球迷</w>，从不错过任何一场比赛。"
                            }
                        },
                        {
                            "text": "The <w>Robins</w> celebrated their victory with the cheering crowd.",
                            "target_lang_translations": {
                                "ru": "«<w>Робинс</w>» праздновали победу вместе с ликующей толпой.",
                                "zh": "<w>知更鸟队</w>与欢呼的人群共同庆祝了他们的胜利。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище болельщика, игрока или члена спортивной команды, называемой «Робинс».",
                        "zh": "对名为“知更鸟队”的运动队球迷、球员或成员的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Робин",
                                "target_lang_sense_clarification": "прозвище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知更鸟队成员",
                                "target_lang_sense_clarification": "运动队昵称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45cadb5e-170c-3d21-b830-2c4453d68d71",
                    "sense_definition": "A toxic substance obtained from the locust tree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist analyzed the properties of <w>robin</w> in the laboratory.",
                            "target_lang_translations": {
                                "ru": "Химик анализировал свойства <w>робина</w> в лаборатории.",
                                "zh": "化学家在实验室里分析了<w>刺槐毒蛋白</w>的特性。"
                            }
                        },
                        {
                            "text": "Ingesting <w>robin</w> can be dangerous due to its toxic nature.",
                            "target_lang_translations": {
                                "ru": "Употребление <w>робина</w> внутрь может быть опасным из-за его токсичности.",
                                "zh": "由于其毒性，摄入<w>刺槐毒蛋白</w>可能会有危险。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Токсичное вещество, получаемое из белой акации.",
                        "zh": "一种从刺槐树中提取的有毒物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "робин",
                                "target_lang_sense_clarification": "химическое вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺槐毒蛋白",
                                "target_lang_sense_clarification": "化学物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89a52bbc-3e9a-36cc-ab8a-fd95407d20ce",
                    "sense_definition": "A decorative trimming attached to the front of a dress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage gown featured a delicate lace <w>robin</w> down the center.",
                            "target_lang_translations": {
                                "ru": "Винтажное платье было украшено изящной кружевной <w>отделкой</w> по центру.",
                                "zh": "这件复古礼服的中心饰有精致的蕾丝<w>饰边</w>。"
                            }
                        },
                        {
                            "text": "She carefully sewed the <w>robin</w> onto the bodice of the costume.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно пришила <w>отделку</w> к лифу костюма.",
                                "zh": "她小心翼翼地把<w>饰边</w>缝在戏服的胸衣上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративная отделка, прикрепляемая к передней части платья.",
                        "zh": "附在连衣裙前部的装饰性饰边。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделка",
                                "target_lang_sense_clarification": "элемент одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "饰边",
                                "target_lang_sense_clarification": "服装装饰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7ad8753d-453e-3917-80eb-0bbcee54d9b4",
                    "sense_definition": "A first name given to boys or girls.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "name_1",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Robin</w> is coming to visit us tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Робин</w> приедет навестить нас завтра.",
                                "zh": "我的朋友<w>罗宾</w>明天要来看我们。"
                            }
                        },
                        {
                            "text": "The story of <w>Robin</w> Hood is famous all over the world.",
                            "target_lang_translations": {
                                "ru": "История о <w>Робин</w> Гуде известна во всем мире.",
                                "zh": "<w>罗宾</w>汉的故事举世闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Robin Hood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное имя, которое дают мальчикам или девочкам.",
                        "zh": "男女通用的名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Робин",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗宾",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6853c9f7-7637-3551-96c4-377a4ded3069",
                    "sense_definition": "A family name passed down through generations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name_1",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Please deliver this letter to Mr. <w>Robin</w> at the main office.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, доставьте это письмо мистеру <w>Робину</w> в главный офис.",
                                "zh": "请把这封信送到总办公室交给<w>罗宾</w>先生。"
                            }
                        },
                        {
                            "text": "The <w>Robin</w> family has lived in this town for over a century.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Робин</w> живет в этом городе уже более века.",
                                "zh": "<w>罗宾</w>一家在这个镇上已经住了超过一个世纪了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "originating as a patronymic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, передаваемая из поколения в поколение.",
                        "zh": "代代相传的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Робин",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗宾",
