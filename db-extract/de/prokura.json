                                "target_senses": [
                                    {
                                        "sense_id": "9851ffe1-e862-32f1-ad19-11f28ae817e7",
                                        "entry_id": "196846b3-7846-3cb5-aff9-fbc8ddd564d9",
                                        "glosses": [
