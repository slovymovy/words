        "de-extract.jsonl": [
            {
                "entry_id": "47c19b64-7c2f-3194-b0da-831fb5927d4d",
                "word": "zehnmal",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4caca1c4-8f73-3443-9911-e21981b621e6",
                        "entry_id": "47c19b64-7c2f-3194-b0da-831fb5927d4d",
                        "glosses": [
                            "mit zehn vervielfacht; neunmal und ein weiteres Mal; zehnfach vorgekommen, durchgeführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a772f384-10c7-4a09-bb93-8b630bcb9a24",
                                "sense_id": "4caca1c4-8f73-3443-9911-e21981b621e6",
                                "text": "„Zwischen 1973 und 1984 wurde hier insgesamt zehnmal der Große Preis von Belgien der Formel 1 ausgetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29f9d1c3-c530-3388-8f2a-4b8a0e218d6f",
                        "entry_id": "47c19b64-7c2f-3194-b0da-831fb5927d4d",
                        "glosses": [
                            "häufige Male"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b73aab76-86e1-40e1-966f-ce429adadc90",
                                "sense_id": "29f9d1c3-c530-3388-8f2a-4b8a0e218d6f",
                                "text": "„Unsre Leute sind zehnmal besser und die Franzosen zehnmal schlechter.“"
                            },
                            {
                                "example_id": "4dbbc0c9-09bb-4137-8f97-bf54f4181819",
                                "sense_id": "29f9d1c3-c530-3388-8f2a-4b8a0e218d6f",
                                "text": "„Kinder haben das Gefühl, sie müssten sich noch einmal die Hände waschen, obwohl sie schon wund gewaschen sind, oder sie müssten noch einmal die Tür kontrollieren, obwohl sie es schon zehnmal gemacht haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e09f29e2-b05c-4ddc-a1cb-ceff42e8df40",
                        "source_entry_id": "47c19b64-7c2f-3194-b0da-831fb5927d4d",
                        "source_sense_id": "4caca1c4-8f73-3443-9911-e21981b621e6",
