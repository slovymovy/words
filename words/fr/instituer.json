    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e7f8576-0198-35a6-97a4-fef754fd59f2",
                    "sense_definition": "Établir de façon durable ou officielle une loi, une coutume ou une organisation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé d'<w>instituer</w> une nouvelle réglementation pour protéger l'environnement."
                        },
                        {
                            "text": "Cette organisation souhaite <w>instituer</w> une règle claire afin d'éviter tout conflit interne."
                        }
                    ],
                    "synonyms": [
                        "instaurer",
                        "établir",
                        "créer"
                    ],
                    "antonyms": [
                        "abolir",
                        "supprimer",
                        "abroger"
                    ],
                    "common_phrases": [
                        "instituer une règle",
                        "instituer un système",
                        "instituer une loi"
                    ]
                },
                {
                    "sense_id": "df4bbdd3-e908-3d59-965e-9ffa65c4ffb6",
                    "sense_definition": "Établir quelqu'un dans une charge ou une fonction, ou s'attribuer de son propre chef un rôle particulier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans aucune légitimité, cet homme s'est <w>institué</w> chef de la rébellion locale."
                        },
                        {
                            "text": "Il a constamment tendance à s'<w>instituer</w> juge des actions de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "nommer",
                        "désigner"
                    ],
                    "antonyms": [
                        "destituer"
                    ],
                    "common_phrases": [
                        "s'instituer chef",
                        "s'instituer juge"
                    ]
                },
                {
                    "sense_id": "39de0500-8e04-3c04-8e08-51825c558322",
                    "sense_definition": "Désigner formellement quelqu'un comme successeur ou bénéficiaire dans un testament.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'ayant pas d'enfants, le vieil homme a choisi d'<w>instituer</w> son neveu légataire universel."
                        },
                        {
                            "text": "Le défunt avait formellement <w>institué</w> son fidèle associé comme unique héritier de ses biens."
                        }
                    ],
                    "synonyms": [
                        "désigner"
                    ],
                    "antonyms": [
                        "déshériter"
                    ],
                    "common_phrases": [
                        "instituer un héritier",
                        "instituer son successeur"
                    ]
                }
            ]
        }
    ]
}