                "senses": [
                    {
                        "sense_id": "97b940fc-b50d-39ed-bc3e-fba7e132ed4c",
                        "entry_id": "b6f8b7a0-b3d0-3a0a-845c-21a300d01003",
                        "glosses": [
                            "zob. pokémon"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "85af7f59-ca1d-365a-aa07-52af9d9c1fd6",
                        "entry_id": "b6f8b7a0-b3d0-3a0a-845c-21a300d01003",
                        "glosses": [
                            "osoba dziwna, zachowująca lub ubierająca się w sposób ekstrawagancki, nietypowy"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "031f743a-aa31-43bb-b9d4-1bf1b660498a",
                                "sense_id": "85af7f59-ca1d-365a-aa07-52af9d9c1fd6",
                                "text": "Widziałeś tego pokemona z różowymi włosami w stroju jak ze zlotu miłośników sado-maso?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "90800e5f-7607-305b-a879-a1f24dea446d",
                        "entry_id": "b6f8b7a0-b3d0-3a0a-845c-21a300d01003",
                        "glosses": [
                            "negatywne określenie dowolnej osoby; najczęściej w odniesieniu do osoby brzydkiej, nieinteligentnej albo irytującej"
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d6c08d-19db-4287-8708-73fdb1dc730a",
                                "sense_id": "90800e5f-7607-305b-a879-a1f24dea446d",
                                "text": "Nie idę już więcej do tego klubu, bo ciągle zaczepiają mnie tam same pokemony."
                            },
                            {
                                "example_id": "640dff00-0558-439b-ad5f-37dbcf63ae8a",
                                "sense_id": "90800e5f-7607-305b-a879-a1f24dea446d",
                                "text": "Z tamtego okresu najgorzej chyba wspominam dzieci Neostrady i inne tego typu pokemony."
                            },
                            {
                                "example_id": "48d4632b-88be-450f-82ad-2854955b6c72",
                                "sense_id": "90800e5f-7607-305b-a879-a1f24dea446d",
                                "text": "Dasz wiarę, że ten pokemon kolejny raz dostał pałę z polskiego?"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
