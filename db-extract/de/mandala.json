                "senses": [
                    {
                        "sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                        "entry_id": "917a740c-7de0-35b7-93db-31ccb8dcfc5c",
                        "glosses": [
                            "kreisförmiges oder quadratisches symbolisches Gebilde mit einem Zentrum zur Anregung der Meditation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eaab79f-529c-452b-83b7-0a6c8dc99a03",
                                "sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                                "text": "Mandalas werden oft zu meditativen Zwecken angefertigt."
                            },
                            {
                                "example_id": "f96902b4-2826-4491-90e4-4b33f33ae779",
                                "sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                                "text": "Das Mandala spielt sowohl im Buddhismus als auch im Hinduismus eine Rolle."
                            },
                            {
                                "example_id": "9b79fa25-ede6-4052-83e7-86da8549ea62",
                                "sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                                "text": "Das Mandala aus Sand wurde nach der Erstellung wieder zusammengefegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
