                        "glosses": [
                            "Arbuste de l’ordre des Lamiales, endémique de l'île Maurice et de la Réunion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673fe659-bd35-4913-8f4c-6d5fe186cdc2",
                                "sense_id": "f0a2a1b9-37ca-35e9-8310-5cf35c9a8f07",
                                "text": "La senteur des volcamerias entre doucement d’abord en vous, humblement même et avec la timidité de celle des violettes. Puis elle pénètre, devient un goût, est sapide pour le palais, et vous rappelle confusément les délices de la fraise, la piquante suavité de l’ananas, la joie vineuse d’un cantaloup, mais fondues gracieusement et dans tout le vague d’un souvenir pur."
                            }
                        ]
                    }
