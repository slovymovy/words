    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1909fec9-3683-38e6-895a-82c85a4c23ba",
                    "sense_definition": "Het juridische recht om over een zaak te beschikken en deze als de zijne te beschouwen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bezit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De notaris stelde vast dat het huis officieel zijn <w>eigendom</w> was geworden.",
                            "target_lang_translations": {
                                "en": "The notary established that the house had officially become his <w>property</w>."
                            }
                        },
                        {
                            "text": "Zij betwistten het <w>recht</w> van <w>eigendom</w> over het stuk grond in de rechtszaal.",
                            "target_lang_translations": {
                                "en": "They contested the <w>right</w> of <w>ownership</w> over the piece of land in the courtroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "eigendomsrecht",
                        "bezit"
                    ],
                    "common_phrases": [
                        "recht van eigendom",
                        "particulier eigendom"
                    ],
                    "target_lang_definitions": {
                        "en": "The legal right to possess something and treat it as one's own."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ownership",
                                "target_lang_sense_clarification": "the legal state of owning something"
                            },
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "the exclusive right of possessing a thing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79274ce1-3669-300e-8a13-7c374662826d",
                    "sense_definition": "Een tastbaar object of goed dat iemand bezit.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bezit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie vond de gestolen <w>eigendommen</w> terug in een verlaten loods.",
                            "target_lang_translations": {
                                "en": "The police found the stolen <w>possessions</w> in an abandoned warehouse."
                            }
                        },
                        {
                            "text": "Je moet goed passen op je persoonlijke <w>eigendom</w> als je op reis gaat.",
                            "target_lang_translations": {
                                "en": "You must take good care of your personal <w>property</w> when you go on a trip."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezitting",
                        "goed",
                        "vermogen",
                        "bezit"
                    ],
                    "common_phrases": [
                        "persoonlijke eigendom",
                        "gestolen eigendommen"
                    ],
                    "target_lang_definitions": {
                        "en": "A tangible object or asset that someone owns."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "property",
                                "target_lang_sense_clarification": "something that is owned, like a house or object"
                            },
                            {
                                "target_lang_word": "possession",
                                "target_lang_sense_clarification": "a physical item that belongs to someone"
                            },
                            {
                                "target_lang_word": "belongings",
                                "target_lang_sense_clarification": "personal items that one carries or owns"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}