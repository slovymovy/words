                "senses": [
                    {
                        "sense_id": "8e082f13-a5e6-3aca-8d5c-1c3c5d1d8fa6",
                        "entry_id": "a234814b-23c5-301d-926d-df729e9d9393",
                        "glosses": [
                            "indisches Lehrwerk über Erotik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653caf1b-8782-4000-a8c2-c7be8166bec1",
                                "sense_id": "8e082f13-a5e6-3aca-8d5c-1c3c5d1d8fa6",
                                "text": "„Einen dicken Strang weißer Speichel zwischen meinem Schwanz und ihrer Unterlippe, das Gesicht erhitzt und gerötet vom Würgen, meinen wunden Schwanz in ihrer Faust, hockt Tracy sich auf die Fersen und sagt, das Kamasutra gebe den Rat, wenn man richtig rote Lippen haben wolle, müsse man sie mit Schweiß von den Hoden eines weißen Hengstes einreiben.“"
                            },
                            {
                                "example_id": "93852b94-c6ce-4cb1-b5ab-14dc4ab921a8",
                                "sense_id": "8e082f13-a5e6-3aca-8d5c-1c3c5d1d8fa6",
                                "text": "„Es stimmt, ich habe das Kamasutra gelesen, aber warum jemand eine derart abartige Gymnastik veranstalten sollte, ist und bleibt für mich ein großes Rätsel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
