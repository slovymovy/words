                                        "sense_id": "16a97952-7dba-317d-bb24-0b9328f92479",
                                        "entry_id": "f2863cf2-f76f-3d07-9b46-baa010a047c8",
                                        "glosses": [
                                            "byl, příčestí činné slovesa být"
