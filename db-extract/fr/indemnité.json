        "fr-extract.jsonl": [
            {
                "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                "word": "indemnité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a9138ee-f2b5-4291-8f7d-922e5d021dd4",
                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "indemnités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                        "glosses": [
                            "Ce qu’on alloue à quelqu’un en vue de l’indemniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57764311-45c3-4fb7-a9e3-585e8372ea09",
                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                            },
                            {
                                "example_id": "6c35c7c7-8223-493b-a286-efec77bcc263",
                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                "text": "Une indemnité d'encouragement fut votée, séance tenante, en faveur du docteur Fergusson, et s'éleva au chiffre de deux mille cinq cents livres."
                            },
                            {
                                "example_id": "a4cbd59f-f231-4031-a5d3-f2d33b4cc7e4",
                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                "text": "Mouley El Hassan avait achevé de payer à l’Espagne 120 millions de pesetas d’indemnité de guerre pour les campagnes de Tetuan (1859-60) et de Melilla (1893) et avait laissé à son fils un bit el-mal contenant 60 millions."
                            },
                            {
                                "example_id": "f393bdc7-7ec3-4622-88c8-1a295e1fc72e",
                                "sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                                "text": "En cas de cessation de ses relations avec le mandant, l’agent commercial a droit à une indemnité compensatrice en réparation du préjudice subi."
                            }
                        ]
                    },
                    {
                        "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                        "glosses": [
                            "Sommes allouées à certains fonctionnaires et qui ne sont pas soumises à la retenue pour la retraite."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "ce5a9a6c-405f-4f91-bf94-e81b1a6515f6",
                                "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                                "text": "Il avait vingt mille francs d’appointements et cinq mille francs d’indemnité."
                            },
                            {
                                "example_id": "d7c6def0-768b-4019-824f-537daf6b7d01",
                                "sense_id": "4033821f-b068-3499-97f1-5d839d2eb77b",
                                "text": "Note : C’est dans ce sens qu’on dit également Indemnité de résidence, indemnité de vie chère."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bbc46b7-d1ee-37ee-8c5b-19c4ec7bdeb2",
                        "entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                        "glosses": [
                            "Acte par lequel on promet d’indemniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c663e92-82a6-4b0a-8be2-e274f37ea42a",
                                "sense_id": "1bbc46b7-d1ee-37ee-8c5b-19c4ec7bdeb2",
                                "text": "Bill d’indemnité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "497cbfe4-db54-4724-a5e5-6f0526eec0ef",
                        "source_entry_id": "b44654c5-e983-351e-b7f4-77b961467b5c",
                        "source_sense_id": "5ec589da-b020-3952-99b8-070d84b89694",
                        "source_sense_description": "Ce qu’on alloue à quelqu’un en vue de l’indemniser",
                        "target_lang_word": "indemnity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indemnity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "678b0c85-a583-3d42-93c1-43eae24ad872",
                                        "entry_id": "4b66f172-6a97-3c18-9d36-bd47c0c2314f",
                                        "glosses": [
                                            "Security from damage, loss, or penalty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42ea1ea-d5d7-456a-9611-e77cf83ddceb",
                                                "sense_id": "678b0c85-a583-3d42-93c1-43eae24ad872",
                                                "text": "Near-synonyms: insurance, assurance"
                                            },
                                            {
                                                "example_id": "97d307a9-28ed-496f-a27b-2beafebc0ca0",
                                                "sense_id": "678b0c85-a583-3d42-93c1-43eae24ad872",
                                                "text": "And all this, it will be said, the Duke of Orleans might have prevented by an effective treaty, securing an act of indemnity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac07922-9c57-3ff1-9919-79c7bd85fc01",
                                        "entry_id": "4b66f172-6a97-3c18-9d36-bd47c0c2314f",
                                        "glosses": [
                                            "An obligation or duty upon an individual to incur the losses of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3efbc2-05cf-4cef-bca6-fe5657ee3e43",
                                                "sense_id": "dac07922-9c57-3ff1-9919-79c7bd85fc01",
                                                "text": "Near-synonyms: liability, responsibility"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc7939cc-b62e-35c5-8dee-ddfc76f4ac2a",
                                        "entry_id": "4b66f172-6a97-3c18-9d36-bd47c0c2314f",
                                        "glosses": [
                                            "Repayment; compensation for loss or injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b002d725-cd81-48c7-a599-5780c0b79071",
                                                "sense_id": "cc7939cc-b62e-35c5-8dee-ddfc76f4ac2a",
                                                "text": "Near-synonyms: reparations, recompense, recompensation"
                                            },
                                            {
                                                "example_id": "33eefc15-e011-42b6-9cbc-ba2e641ba114",
                                                "sense_id": "cc7939cc-b62e-35c5-8dee-ddfc76f4ac2a",
                                                "text": "It would have been wise to modify rather than revoke the proclamation. But the Allies went further. Now, for the first time, were heard the words of indemnity for the past, and security for the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6d9374-eddd-3c9d-8e66-01264af5aced",
                                        "entry_id": "4b66f172-6a97-3c18-9d36-bd47c0c2314f",
                                        "glosses": [
                                            "The right of an injured party to shift the loss onto the party responsible for the loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73258b4e-f296-3eaf-824d-456c63964a2e",
                                        "entry_id": "4b66f172-6a97-3c18-9d36-bd47c0c2314f",
                                        "glosses": [
                                            "A principle of insurance which provides that when a loss occurs, the insured should be restored to the approximate financial condition occupied before the loss occurred, no better, no worse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
