                ],
                "senses": [
                    {
                        "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                        "entry_id": "d7a8ac1f-73b8-36a6-a654-55b6065f25ec",
                        "glosses": [
                            "so, dass es beansprucht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a1873b-87ce-4f8c-bf94-6171aeee35ff",
                                "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                                "text": "„Die Oberfläche ist sehr beanspruchbar, abriebfest, besonders kratzfest und bietet die Möglichkeit zur thermischen Reparatur von Kratzern“"
                            },
                            {
                                "example_id": "9abc66bb-12ad-4a21-861b-25859cee6fa3",
                                "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                                "text": "„Laminat ist sehr beanspruchbar, wirkt aber trotzdem exclusiv und edel. Laminatböden sind langlebig und beständig“"
                            },
                            {
                                "example_id": "16bea847-8733-4212-a099-43fe6d8c3029",
                                "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                                "text": "„Mit diesen Produkten können hoch beanspruchbare Markierungen jetzt auch bei kurzen Ruhezeiten durchgeführt werden.“"
                            },
                            {
                                "example_id": "547d2b84-2048-41c7-8262-863f06c8ba32",
                                "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                                "text": "„Die Pulverbeschichtung vereint sich widersprechende Eigenschaften. Sie ist hart und mechanisch beanspruchbar und gleichzeitig elastisch und biegefähig.“"
                            },
                            {
                                "example_id": "52be02bb-5671-436b-8a58-492119c99bbe",
                                "sense_id": "279b8190-c615-3eaf-839f-6e8964535318",
                                "text": "„Eiche ist die derzeit weitaus beliebteste Parkett-Holzart. Das Holz ist im Vergleich zu anderen Holzarten relativ hart und beanspruchbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
