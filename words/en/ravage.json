{
    "word_family": [
        "ravager"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "847d8b48-cf2b-3ba2-a4ce-6beba7b404cd",
                    "sense_definition": "To cause severe and extensive damage to; to devastate or lay waste to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coastal towns were completely <w>ravaged</w> by the violent tropical storm.",
                            "target_lang_translations": {
                                "de": "Die Küstenstädte wurden von dem heftigen Tropensturm völlig <w>verwüstet</w>."
                            }
                        },
                        {
                            "text": "A severe drought continues to <w>ravage</w> crops across the entire southern region.",
                            "target_lang_translations": {
                                "de": "Eine schwere Dürre <w>sucht</w> die Ernten in der gesamten südlichen Region weiterhin <w>heim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "devastate",
                        "destroy",
                        "ruin"
                    ],
                    "common_phrases": [
                        "ravage the country",
                        "ravaged by war",
                        "ravaged by fire"
                    ],
                    "target_lang_definitions": {
                        "de": "Schweren und großflächigen Schaden anrichten; etwas vollkommen verwüsten oder zerstören."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verwüsten",
                                "target_lang_sense_clarification": "durch Unwetter, Kriege oder Katastrophen"
                            },
                            {
                                "target_lang_word": "heimsuchen",
                                "target_lang_sense_clarification": "von Dürre, Krankheiten oder Plagen schwer treffen"
                            },
                            {
                                "target_lang_word": "zerstören",
                                "target_lang_sense_clarification": "stark beschädigen oder vernichten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e80ff58f-691c-3f60-a65e-4ebbbf6c2ca9",
                    "sense_definition": "To pillage, plunder, or sack a place during war or conflict.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Invading soldiers <w>ravaged</w> the border settlements, looting stores and burning homes.",
                            "target_lang_translations": {
                                "de": "Eindringende Soldaten <w>plünderten</w> die Grenzsiedlungen, raubten Geschäfte aus und brannten Häuser nieder."
                            }
                        },
                        {
                            "text": "The army marched inland, determined to <w>ravage</w> any fortress that refused to surrender.",
                            "target_lang_translations": {
                                "de": "Die Armee marschierte ins Landesinnere, entschlossen, jede Festung zu <w>verheeren</w>, die sich weigerte zu kapitulieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillage",
                        "plunder",
                        "sack"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Ort während eines Krieges oder Konflikts plündern, brandschatzen oder verheeren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plündern",
                                "target_lang_sense_clarification": "durch Raubzüge ausrauben"
                            },
                            {
                                "target_lang_word": "brandschatzen",
                                "target_lang_sense_clarification": "durch Feuer und Plünderung verheeren"
                            },
                            {
                                "target_lang_word": "verheeren",
                                "target_lang_sense_clarification": "im Krieg zerstörerisch heimsuchen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5c9ce77-c17c-382a-b075-ef65d9b643fa",
                    "sense_definition": "Acts or effects of severe destruction, damage, or depredation (often used in plural).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone monuments show the clear <w>ravages</w> of time and weathering.",
                            "target_lang_translations": {
                                "de": "Die antiken Steinmonumente zeigen deutlich den <w>Zahn</w> der Zeit und der Verwitterung."
                            }
                        },
                        {
                            "text": "The valley struggled for decades to recover from the <w>ravages</w> of war.",
                            "target_lang_translations": {
                                "de": "Das Tal brauchte Jahrzehnte, um sich von den <w>Verwüstungen</w> des Krieges zu erholen."
                            }
                        }
                    ],
                    "synonyms": [
                        "depredation",
                        "devastation",
                        "havoc"
                    ],
                    "common_phrases": [
                        "ravages of time",
                        "ravages of war",
                        "ravages of disease"
                    ],
                    "target_lang_definitions": {
                        "de": "Verheerende Auswirkungen, Zerstörungen oder Schäden (meist im Plural verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verwüstung",
                                "target_lang_sense_clarification": "Zustand oder Ausmaß starker Zerstörung"
                            },
                            {
                                "target_lang_word": "Zerstörung",
                                "target_lang_sense_clarification": "Vernichtung oder Beschädigung"
                            },
                            {
                                "target_lang_word": "verheerende Auswirkungen",
                                "target_lang_sense_clarification": "fatale Folgen, z. B. der Zeit oder eines Krieges"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}