                                "target_senses": [
                                    {
                                        "sense_id": "66e06a93-054d-39fc-8c80-81645ce66cfa",
                                        "entry_id": "0c2da4b7-80a2-31bb-81a6-32efb03fc9a4",
                                        "glosses": [
                                            "Möglichkeit, (optisch) wahrgenommen zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91328719-edea-46fe-b8ec-816818ffe25c",
                                                "sense_id": "66e06a93-054d-39fc-8c80-81645ce66cfa",
                                                "text": "„Bei den Kriterien sicherer Stand, Kippsicherheit, Gurtsystem, mögliche Quetsch- oder Klemmgefahren und Sichtbarkeit im Dunkeln gewinnen Bugaboo Buffalo, Moon Nuova City und Osann Pepp.“"
                                            },
                                            {
                                                "example_id": "b97b7440-72d0-4605-af0c-57439aef71bf",
                                                "sense_id": "66e06a93-054d-39fc-8c80-81645ce66cfa",
                                                "text": "„Das Papstamt ist wie gemacht für die Gesetze absoluter Sichtbarkeit.“"
                                            },
                                            {
                                                "example_id": "7d5bee1e-bf31-406e-a626-8d44bc41c28c",
                                                "sense_id": "66e06a93-054d-39fc-8c80-81645ce66cfa",
                                                "text": "„Sichtbarkeit des Erfolgs: In vielen Jobs ist die Arbeit so verdichtet, dass ein Projekt das nächste Schlag auf Schlag ablöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d677f6f-d847-3966-aaa1-86871d330eb7",
                                        "entry_id": "0c2da4b7-80a2-31bb-81a6-32efb03fc9a4",
                                        "glosses": [
                                            "Zeit, in der ein Himmelskörper von einem Standort wahrgenommen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "897203c9-738f-451e-8f50-fe42124f7b0f",
                                                "sense_id": "3d677f6f-d847-3966-aaa1-86871d330eb7",
                                                "text": "„Wie die scheinbare Bewegung und die Sichtbarkeiten der Venus ablaufen, haben wir bereits S. 15 geschildert.“"
                                            }
                                        ],
