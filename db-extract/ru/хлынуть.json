                ],
                "translations": [
                    {
                        "translation_id": "82e6177d-378a-4f2b-a486-25ba8efe9d29",
                        "source_entry_id": "9a6329a3-8adc-3e79-b303-5cad2dd77ab8",
                        "target_lang_word": "pour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a74a6094-9d44-3208-8feb-cd54aa5b19d0",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To cause (liquid, or liquid-like substance) to flow in a stream, either out of a container or into it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9dd7ef1-5f07-43ae-a368-c9f67638296b",
                                                "sense_id": "a74a6094-9d44-3208-8feb-cd54aa5b19d0",
                                                "text": "pour water from a jug"
                                            },
                                            {
                                                "example_id": "dcb24e4f-8b85-4c19-9091-827f9a760edf",
                                                "sense_id": "a74a6094-9d44-3208-8feb-cd54aa5b19d0",
                                                "text": "pour wine into a decanter"
                                            },
                                            {
                                                "example_id": "0d02dfb9-92c0-4482-91d0-6bbd55935ad8",
                                                "sense_id": "a74a6094-9d44-3208-8feb-cd54aa5b19d0",
                                                "text": "to pour oil onto chips"
                                            },
                                            {
                                                "example_id": "5d60f3a4-74d5-4d05-bc45-99a5911a5629",
                                                "sense_id": "a74a6094-9d44-3208-8feb-cd54aa5b19d0",
                                                "text": "to pour out sand or dust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To send out as in a stream or a flood; to cause (an emotion) to come out; to cause to escape."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da683e8-8fab-45fb-b5f2-f74ec79c22ab",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "Wherefore did Nature pour her bounties forth / With such a full and unwithdrawing hand?"
                                            },
                                            {
                                                "example_id": "563b475b-1733-4815-98f4-f1c1f0b2808b",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            },
                                            {
                                                "example_id": "4b72d298-272b-41d7-b94b-846b977d54f4",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "My teacher poured scorn on my attempts at writing."
                                            },
                                            {
                                                "example_id": "24745f49-3018-4b73-9b7c-bfee153ff968",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "How London doth pour out her citizens."
                                            },
                                            {
                                                "example_id": "6bb2b986-a7a2-47da-8b68-04c99c773866",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "[…] I haue drunke neither wine nor strong drinke, but haue powred out my soule before the Lord."
                                            },
                                            {
                                                "example_id": "96d79f28-ef43-4291-8268-7ad429165a0d",
                                                "sense_id": "73cc7eeb-c839-32ab-8148-223f3dfff25d",
                                                "text": "Now will I shortly powre out my furie vpon thee, and accomplish mine anger vpon thee[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671c916b-e00d-3048-804b-3023ef7ca002",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To send forth from, as in a stream; to discharge uninterruptedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8538a5ca-eea8-4ca1-97ad-01802094a635",
                                                "sense_id": "671c916b-e00d-3048-804b-3023ef7ca002",
                                                "text": "Is it for thee the linnet pours his throat?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b4f1516-3f34-3fdd-beba-05d997e43620",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To flow, pass, or issue in a stream; to fall continuously and abundantly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c430bc1d-3611-4c2e-9a5a-87a996f7d876",
                                                "sense_id": "6b4f1516-3f34-3fdd-beba-05d997e43620",
                                                "text": "the rain poured down."
                                            },
                                            {
                                                "example_id": "77340210-93a0-4389-850c-96d4eb8dc110",
                                                "sense_id": "6b4f1516-3f34-3fdd-beba-05d997e43620",
                                                "text": "The rain came pouring down\nWhen I was drownin', that's when I could finally breathe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e15d369-435b-3a42-8a1f-5d5df8c72bcb",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To rain hard."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f8deb0-a310-4e10-9244-c6d60e984c80",
                                                "sense_id": "2e15d369-435b-3a42-8a1f-5d5df8c72bcb",
                                                "text": "It's pouring outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cba8103-aabd-3aeb-99d3-6aea9812efed",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "Of a beverage, to be on tap or otherwise available for serving to customers."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c77fd3-b682-31f6-85fa-70ea58a423f1",
                                        "entry_id": "ccbb3330-c9ec-3a12-8058-9488284b920d",
                                        "glosses": [
                                            "To move in a throng, as a crowd."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f51be98-156e-4680-b3a3-d907b94e4a20",
                                                "sense_id": "50c77fd3-b682-31f6-85fa-70ea58a423f1",
                                                "text": "The people poured out of the theater."
                                            },
                                            {
                                                "example_id": "c4bcfd03-9a81-429b-8dbe-e6217498371d",
                                                "sense_id": "50c77fd3-b682-31f6-85fa-70ea58a423f1",
                                                "text": "In the rude throng pour on with furious pace."
                                            },
                                            {
                                                "example_id": "cf882446-8b18-414e-8b55-7c8e3ab36645",
                                                "sense_id": "50c77fd3-b682-31f6-85fa-70ea58a423f1",
                                                "text": "The bluebloods of golf began pouring into the sweltering nation’s capital yesterday for the 64th U.S. Open championship, and the hottest topic was not Arnold Palmer or Jack Nicklaus, but Champagne Tony Lema."
                                            },
                                            {
                                                "example_id": "af7ee951-c05a-4b2f-8b57-f4006377e319",
                                                "sense_id": "50c77fd3-b682-31f6-85fa-70ea58a423f1",
                                                "text": "In a breathless finish Arsenal poured forward looking for a winner but Leeds held out for a deserved replay after Bendtner wastefully fired wide and Schmeichel acrobatically kept out Denilson's rasping effort"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9a534d0-2bae-348d-a3ca-b6d6e711b5a3",
                                        "entry_id": "7a909e95-ed6f-3256-b90b-b5667f5355b9",
                                        "glosses": [
                                            "The act of pouring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61548dd-dd8f-434d-8710-cc4c123a3f51",
                                                "sense_id": "a9a534d0-2bae-348d-a3ca-b6d6e711b5a3",
                                                "text": "The bartender's inexpert pour left me with a pint of beer that was half foam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fab5360-cd4e-3ce7-86c0-8d13054d2f23",
                                        "entry_id": "7a909e95-ed6f-3256-b90b-b5667f5355b9",
                                        "glosses": [
                                            "Something, or an amount, poured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec8c704-d38f-4660-84cd-d861984639e5",
                                                "sense_id": "0fab5360-cd4e-3ce7-86c0-8d13054d2f23",
                                                "text": "Over this time period, the first concrete pour has not only lost workability but has started to set so that it is no longer affected by the action of a vibrator."
                                            },
                                            {
                                                "example_id": "0925b4d2-aa23-4a06-9444-ec9e316935d5",
                                                "sense_id": "0fab5360-cd4e-3ce7-86c0-8d13054d2f23",
                                                "text": "HS2 Ltd has completed the first base-slab concrete pour at the western end of Old Oak Common station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f839f12-ecbf-35f0-bc77-3b7463c5556e",
                                        "entry_id": "7a909e95-ed6f-3256-b90b-b5667f5355b9",
                                        "glosses": [
                                            "A downpour; a flood of precipitation."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb06342-021b-4c22-8221-001e36f0f5b4",
                                                "sense_id": "0f839f12-ecbf-35f0-bc77-3b7463c5556e",
                                                "text": "Then, as if to give the lie to the offensive insinuation, he mounted his horse, and rode home ten miles in a pour of rain, without a great coat or umbrella."
                                            },
                                            {
                                                "example_id": "a64b7f0e-9464-4478-9f76-fa2585f35c57",
                                                "sense_id": "0f839f12-ecbf-35f0-bc77-3b7463c5556e",
                                                "text": "But then one of Mr. Knott's men would have had to put on his coat and hat and turn out, as likely as not in the pitch dark, and in torrents of rain in all probability, and grope his way in the dark in the pours of rain, with the pot of food in his hand, a wretched and ridiculous figure, to where the dog lay."
                                            }
                                        ]
                                    }
                                ]
                            },
