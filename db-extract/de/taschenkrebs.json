                ],
                "senses": [
                    {
                        "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                        "entry_id": "9f58efc0-b899-3d57-b2ab-cd0d63ac5bcf",
                        "glosses": [
                            "im Ostatlantik und der Nordsee verbreitete Krabbenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a371ca9-88da-4344-93a2-ad328bd8e540",
                                "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                                "text": "„›Wenn ich Taschenkrebse oder Hummer aufgetischt bekomme, futtere ich sogar die Eingeweide mit.‹“"
                            },
                            {
                                "example_id": "c4ac4590-062c-4496-bf58-1b2e703aeadd",
                                "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                                "text": "„Sophie fragte, was ›gefüllter Taschenkrebs‹ sei, und Perkins witzelte: ›Keine Ahnung, aber immerhin besser als ein Krebs mit leeren Taschen.‹“"
                            },
                            {
                                "example_id": "949c500c-9df7-4aab-a8a8-0f7e361b6dc9",
                                "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                                "text": "„Aber wenn sich die Flut zurückzog, konnte sich Danny mit den zahlreichen zurückbleibenden Pfützen beschäftigen und Heerscharen kleiner grüner Taschenkrebse fangen.“"
                            },
                            {
                                "example_id": "a8f935f0-e4bd-4761-ae60-fa17f5ada297",
                                "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                                "text": "„Cameron konnte ihr Atmen hören, die Wunde ihrer Gesichtszüge in der Düsternis sich öffnen und schließen sehen: ölige Knochenpartien, ineinandergreifend, sich voneinander lösend wie die Fressfront eines Taschenkrebses.“"
                            },
                            {
                                "example_id": "2efbd0d0-8ee1-4227-834b-f77eed4342e9",
                                "sense_id": "3fb14472-9035-3c3c-89da-4b906f635b05",
                                "text": "„Auf dem Agbogbloshie-Markt wimmelte es von Sonntagskäufern und fliegenden Händlern, die alles von Bananen bis Taschenkrebsen feilboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
