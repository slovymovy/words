                                                "sense_id": "b96c56e9-ccfb-34e2-bdd8-4769a514f8dc",
                                                "text": "К полудню около крайних дворов завязалась перестрелка."
                                            },
                                            {
                                                "example_id": "d87bb12f-0ff0-4d35-996c-eab69b26017d",
                                                "sense_id": "b96c56e9-ccfb-34e2-bdd8-4769a514f8dc",
                                                "text": "Два дня мы были в перестрелке."
                                            }
                                        ]
                                    },
