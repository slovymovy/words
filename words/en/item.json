                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "likewise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Item, one sword; <w>item</w>, one shield.",
                            "target_lang_translations": {
