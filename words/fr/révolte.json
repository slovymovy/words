    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "feccbea3-55f0-3626-b1fe-fa33e1cb3d88",
                    "sense_definition": "Soulèvement collectif et souvent violent contre une autorité ou un pouvoir établi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple a organisé une vaste <w>révolte</w> pour protester contre la hausse brutale des impôts."
                        },
                        {
                            "text": "Les soldats ont réussi à écraser une <w>révolte</w> qui menaçait la stabilité de la région."
                        }
                    ],
                    "synonyms": [
                        "insurrection",
                        "mutinerie",
                        "rébellion",
                        "soulèvement"
                    ],
                    "antonyms": [
                        "obéissance",
                        "soumission"
                    ],
                    "common_phrases": [
                        "écraser une révolte",
                        "entrer en révolte",
                        "mener une révolte"
                    ]
                },
                {
                    "sense_id": "799c2669-6d47-352a-b407-fa0aacf77a23",
                    "sense_definition": "Sentiment d'indignation vive ou de colère face à une situation injuste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un profond sentiment de <w>révolte</w> l'a envahi après la décision injuste des juges."
                        },
                        {
                            "text": "Elle a exprimé sa <w>révolte</w> devant les conditions de travail déplorables des ouvriers."
                        }
                    ],
                    "synonyms": [
                        "écœurement",
                        "indignation",
                        "réprobation"
                    ],
                    "antonyms": [
                        "acceptation",
                        "résignation"
                    ],
                    "common_phrases": [
                        "cri de révolte",
                        "sentiment de révolte",
                        "vent de révolte"
                    ]
                },
                {
                    "sense_id": "37fda3c4-0386-3617-ae43-e84a3bd9f09c",
                    "sense_definition": "Refus catégorique ou résistance morale face à une contrainte ou une règle imposée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pièce de théâtre illustre la <w>révolte</w> de l'esprit humain contre le conformisme."
                        },
                        {
                            "text": "Il vit dans une constante <w>révolte</w> contre les conventions sociales de son époque."
