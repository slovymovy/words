                        "sense_id": "eec8ccb1-af90-3bf8-9167-4b4aa8312388",
                        "entry_id": "da1869ec-ecef-361d-a061-9619178263e4",
                        "glosses": [
                            "Absperrung, meist Zaun, zwischen Viehweiden"
                        ],
