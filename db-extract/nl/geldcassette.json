                        "examples": [
                            {
                                "example_id": "effbacd7-96c0-44d4-9dc2-b02cdde1252b",
                                "sense_id": "f5f7f474-9321-3cc3-a2c9-b16bca8f8395",
                                "text": "De twee mannen stonden volgens de rechtbank in oktober op het punt om een geldtransportwagen in Amsterdam te overvallen. Verkleed als postbezorgers en vermomd met plaksnorren liepen ze rond met een steekwagen. Daarop stonden dozen waarin precies een geldcassette zou passen."
                            },
                            {
                                "example_id": "d5dc9640-c243-4907-b532-4575894287d5",
                                "sense_id": "f5f7f474-9321-3cc3-a2c9-b16bca8f8395",
                                "text": "Aanleiding is een gewapende overval op een lijnbus in Apeldoorn gisteravond. De chauffeur moest zijn geldcassette afgeven en werd bedreigd met een vuurwapen. Het was volgens Syntus de derde overval op een bestuurder in korte tijd."
                            },
                            {
                                "example_id": "2ae74c10-0138-406a-82bb-53271048cd9c",
                                "sense_id": "f5f7f474-9321-3cc3-a2c9-b16bca8f8395",
                                "text": "Het is een beeld dat je normaal alleen in films ziet: op de A2 bij Maastricht viel een volle geldcassette uit een geldtransportwagen. Een passerende automobilist reed dwars over de koffer heen en meteen lag de weg bezaaid met tienduizenden euro's."
                            }
                        ]
