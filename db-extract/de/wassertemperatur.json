                                        "glosses": [
                                            "de temperatuur van het (zwem)water"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62feb8c-ecde-46ef-9999-9f8465958941",
                                                "sense_id": "a1408cec-9a66-3b93-a12f-8f047207a253",
                                                "text": "Ik schatte de watertemperatuur op zeven, acht graden."
                                            },
                                            {
                                                "example_id": "ecce564c-f29d-4a3b-924a-6e1a497f17f6",
                                                "sense_id": "a1408cec-9a66-3b93-a12f-8f047207a253",
                                                "text": "De voordelen waren tweeledig. Doordat hij niet in een 50-meterbad zwom, had hij niet te maken met hinderlijke keerpunten en kon hij een half uur lang aan één stuk zwemmen. Daarnaast was er de mogelijkheid de watertemperatuur op te schroeven tot 30 graden, waarmee het aanvoelde alsof hij in de baai van Tokio lag."
                                            }
