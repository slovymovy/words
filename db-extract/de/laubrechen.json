                    {
                        "sense_id": "51915523-ee97-3a4c-a141-d14c959430e7",
                        "entry_id": "d18142eb-e00a-3ce1-a0a9-58b9e75696c7",
                        "glosses": [
                            "Gartengerät zum Zusammenkehren von Laub oder anderem losem, typischerweise grobem Zeug, Gartenabfall"
                        ],
                        "tags": [
                            "meist süddeutsch und mitteldeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "f8cd9614-470c-4e50-85a4-6a1dfcd9545a",
                                "sense_id": "51915523-ee97-3a4c-a141-d14c959430e7",
                                "text": "„Sichtlich erregt fuchtelte sie mit einem Laubrechen vor dem Gesicht herum, bis die Blümchen auf ihrem Umhang bebten.“"
                            },
                            {
                                "example_id": "0c85224b-084e-4db4-87e4-05190bcec83d",
                                "sense_id": "51915523-ee97-3a4c-a141-d14c959430e7",
                                "text": "„An der Hauswand lehnte ein Laubrechen, und auf dem Gehsteig lagen gelbe Gartenhandschuhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
