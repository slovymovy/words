                        "glosses": [
                            "tikfout, typo, verkeerde letters aanslaan bij typen het gaat dus niet over spellingsfouten en grammaticale fouten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6de44e2-a3bb-4388-b171-f9ab8e44634e",
                                "sense_id": "7990a459-7afc-39b3-9e0d-dc0301bec734",
                                "text": "Ik kon door die typefout niet uitmaken of de vorstin gevallen of de vorst ingevallen was."
