            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8a207047-0207-3c7f-b63e-ad5d40311e67",
                    "sense_definition": "Qui est doué de capacités intellectuelles remarquables, qui comprend et apprend rapidement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève très <w>intelligent</w> comprend toutes les leçons dès la première explication du maître."
                        },
                        {
                            "text": "Elle pose toujours de bonnes questions en classe parce qu'elle est particulièrement <w>intelligente</w>."
                        }
                    ],
                    "synonyms": [
                        "doué",
                        "éveillé",
                        "malin"
                    ],
                    "antonyms": [
                        "bête",
                        "stupide",
                        "idiot"
                    ],
                    "common_phrases": [
                        "enfant intelligent"
                    ]
                },
                {
                    "sense_id": "76aa7c7b-6d40-396c-8e07-c82a4beebdbd",
                    "sense_definition": "Muni de capteurs ou de programmes informatiques lui permettant d'agir de façon autonome ou connectée.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pilote le système d'alarme de sa maison <w>intelligente</w> à distance grâce à son smartphone."
                        },
                        {
                            "text": "La municipalité a installé un réseau de lampadaires <w>intelligents</w> pour réduire la facture d'électricité."
                        }
                    ],
                    "synonyms": [
                        "smart"
                    ],
                    "common_phrases": [
                        "maison intelligente",
                        "téléphone intelligent",
                        "ville intelligente"
                    ]
                },
                {
                    "sense_id": "899278d4-8f52-3c70-a6d7-bd01d3f286ad",
                    "sense_definition": "Qui témoigne de réflexion, de finesse ou d'un bon jugement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investir dans ces infrastructures modernes constitue une décision <w>intelligente</w> pour l'avenir du pays."
                        },
                        {
                            "text": "L'avocat a proposé un compromis <w>intelligent</w> qui a satisfait immédiatement les deux parties."
                        }
                    ],
                    "synonyms": [
                        "astucieux",
                        "ingénieux",
                        "judicieux",
                        "pertinent",
                        "sensé"
                    ],
                    "antonyms": [
                        "absurde",
                        "insensé"
                    ],
                    "common_phrases": [
                        "choix intelligent",
                        "décision intelligente",
                        "remarque intelligente"
                    ]
                },
                {
                    "sense_id": "de59bf10-2351-3ad3-b5fa-65f799e299fd",
                    "sense_definition": "Qui est doué de la faculté de concevoir, d'analyser et de raisonner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astrophysiciens recherchent depuis plusieurs décennies des traces d'une vie <w>intelligente</w> dans notre galaxie."
                        },
                        {
                            "text": "De nombreux scientifiques reconnaissent désormais que le dauphin est un être <w>intelligent</w> capable de communiquer."
