                        "sense_id": "45b58875-3f4f-3bcc-b063-46bbe810ec72",
                        "entry_id": "81a46c0a-fed9-375c-9234-e8534cc3b2e8",
                        "glosses": [
                            "een ondiepe plek van zand op de bodem van een water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "240cb369-3857-4b36-9dc8-2b7bb06366c9",
                                "sense_id": "45b58875-3f4f-3bcc-b063-46bbe810ec72",
                                "text": "Op de zandplaat lagen de zeehonden te zonnen."
                            },
                            {
                                "example_id": "23747caf-7556-43b6-b763-3239192ccff7",
                                "sense_id": "45b58875-3f4f-3bcc-b063-46bbe810ec72",
                                "text": "Op de zandplaat liet Iris Beekman uit Groningen ze vrij in de Waddenzee. \"Mijn vriend gaf me dit cadeau met kerst. Hij weet hoe gek ik ben op zeehonden. Vroeger deed ik mijn spreekbeurten erover. Dit is echt iets wat ik al mijn hele leven wilde doen\", zei ze. \"En nu ben ik degene die de laatste zeehond uit Pieterburen mag terugbrengen naar zee. Heel bijzonder.\""
                            }
                        ]
                    }
