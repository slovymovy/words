                        "sense_id": "ebe7ee06-e41e-377f-b2c7-5a40d0453884",
                        "entry_id": "db9e6c40-78c9-3037-8e44-6b50167d66b2",
                        "glosses": [
                            "An instance of someone dressed up as Santa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e85853-4bd1-483b-893c-e3ad503d23b5",
                                "sense_id": "ebe7ee06-e41e-377f-b2c7-5a40d0453884",
                                "text": "They get some pretty fishy Santas in this mall. The one in the food court right now seems like he might be drunk."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf695570-6385-3fd5-a7df-272d3751d9aa",
                        "entry_id": "db9e6c40-78c9-3037-8e44-6b50167d66b2",
                        "glosses": [
                            "An instance of any likeness of Santa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700d1d49-6c36-4b5d-97c4-a087d99026fe",
                                "sense_id": "cf695570-6385-3fd5-a7df-272d3751d9aa",
                                "text": "a plastic Santa waving in time to some music"
                            },
                            {
                                "example_id": "d15b0991-c157-4c03-90a0-f624bf49fa5a",
                                "sense_id": "cf695570-6385-3fd5-a7df-272d3751d9aa",
                                "text": "They get some pretty nice chocolate Santas and chocolate Easter Bunnies in this mall. The ones in the food court right now are making me hungry just looking at them."
                            }
                        ]
                    }
                ],
