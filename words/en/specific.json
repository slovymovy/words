                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специфический",
                                "target_lang_sense_clarification": "свойственный только данному предмету"
                            },
                            {
                                "target_lang_word": "особый",
                                "target_lang_sense_clarification": "отличительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8b63de1-84be-37fd-9796-a6742eea1faf",
                    "sense_definition": "Serving to identify a particular thing, such as a disease, with little risk of confusion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor ordered a highly <w>specific</w> test to confirm the diagnosis.",
                            "target_lang_translations": {
                                "ru": "Врач назначил высоко<w>специфичный</w> тест для подтверждения диагноза."
                            }
                        },
                        {
                            "text": "These symptoms are <w>specific</w> to this rare condition.",
                            "target_lang_translations": {
                                "ru": "Эти симптомы <w>характерны</w> для этого редкого заболевания."
                            }
                        }
