            "senses": [
                {
                    "sense_id": "27685b76-22d5-33f2-a0ef-1ba13630467d",
                    "sense_definition": "iets van de ene plaats naar de andere brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me helpen om deze zware kast naar de andere hoek te <w>verplaatsen</w>?",
                            "target_lang_translations": {
                                "en": "Can you help me <w>move</w> this heavy cabinet to the other corner?",
                                "ru": "Ты можешь помочь мне <w>передвинуть</w> этот тяжелый шкаф в другой угол?"
                            }
                        },
                        {
                            "text": "De afspraak werd naar volgende week <w>verplaatst</w> omdat de directeur ziek was.",
                            "target_lang_translations": {
                                "en": "The appointment was <w>rescheduled</w> for next week because the director was ill.",
                                "ru": "Встречу <w>перенесли</w> на следующую неделю, потому что директор был болен."
                            }
                        },
                        {
                            "text": "Als je een hortensia wilt <w>verplaatsen</w>, kun je dat het beste doen in de lente.",
                            "target_lang_translations": {
                                "en": "If you want to <w>relocate</w> a hydrangea, it is best to do so in the spring.",
                                "ru": "Если вы хотите <w>пересадить</w> гортензию, лучше всего делать это весной."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen"
                    ],
                    "common_phrases": [
                        "meubels verplaatsen",
                        "een afspraak verplaatsen",
                        "de grens verplaatsen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move something from one place to another",
                        "ru": "переместить что-либо с одного места на другое"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change the position of an object"
                            },
                            {
                                "target_lang_word": "reschedule",
                                "target_lang_sense_clarification": "to change the time of an appointment"
                            },
                            {
                                "target_lang_word": "relocate",
                                "target_lang_sense_clarification": "to move something to a new location"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to slightly change the position of something"
                            }
