                        "source_sense_id": "ea462613-b464-3fec-9bd2-4dc774cadf54",
                        "target_lang_word": "softly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "In a soft manner; gently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cecd2f-b4e7-46cd-b4fe-3fecf102946e",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "The masseuse was rubbing my back too softly for my liking, so I asked her to go harder."
                                            },
                                            {
                                                "example_id": "c77e3ca9-df67-41ad-93d2-3796161f1332",
                                                "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                                                "text": "He had married a lady well educated and softly nurtured, but not dowered with worldly wealth. […] They would give up ideas of gentle living, of soft raiment, and delicate feeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "Not loudly; nearly inaudibly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7ac6f1-5e92-45f1-8cec-77aae41d81c7",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "whisper softly in someone's ear"
                                            },
                                            {
                                                "example_id": "9c22bad6-7ccd-4f58-a02e-4ed377560ff8",
                                                "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                                                "text": "play music softly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                        "entry_id": "19d560f7-05c7-35d8-8046-1d2f06d5e12e",
                                        "glosses": [
                                            "With subdued color; faded or misty with distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ac4721-97b8-44c6-830b-4a48acabc289",
                                                "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                                                "text": "And they sat very still, the two of them, and looked out over that great, beautiful desert—away to the home mesa that they could see, softly blue, in the distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f64b3bf-9e6f-4b8e-9efa-1e95e86475e3",
                        "source_entry_id": "9b94a7f0-8ca1-3985-acd9-f19031e47778",
                        "source_sense_id": "ea462613-b464-3fec-9bd2-4dc774cadf54",
                        "target_lang_word": "мягко",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мягко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "04d137f4-f89a-342d-818e-32acf967703d",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "наречие к мягкий"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aac1350-d525-46be-85af-d08c1cdebe93",
                                                "sense_id": "04d137f4-f89a-342d-818e-32acf967703d",
                                                "text": "Высокая трава мягко обвивалась около колёс и ног лошади, оставляя свои семена на мокрых спицах и ступицах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cc3e50f-891e-36bc-b507-f68cfade1f40",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "аккуратно, плавно; без толчков или ударов"
                                        ],
                                        "tags": [
                                            "наречие"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9756781-14f5-4e78-9708-d934a9b7a614",
                                                "sense_id": "1cc3e50f-891e-36bc-b507-f68cfade1f40",
                                                "text": "«Боинг» мягко коснулся подмосковной земли и, теряя скорость, побежал по летному полю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8e8c9e-105d-3e71-a519-a6f789483ddb",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "перен. без нажима, жестокости или строгости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158cc8fa-a430-475c-9699-8a36f21b043f",
                                                "sense_id": "6b8e8c9e-105d-3e71-a519-a6f789483ddb",
                                                "text": "Однако Цюрупа заметил мою неловкость и очень мягко спросил у меня, какой я люблю кофе — с молоком или с лимоном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e82ee4-0e39-3918-a2d8-e8c12b2a6e7f",
                                        "entry_id": "b7b0ac99-a481-31f3-8f70-e37ca406043e",
                                        "glosses": [
                                            "хорошо, комфортно, уютно"
                                        ],
                                        "tags": [
                                            "в значении сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dee0bbc-37e0-4db5-beea-f1f7f012b5e0",
                                                "sense_id": "12e82ee4-0e39-3918-a2d8-e8c12b2a6e7f",
                                                "text": "Ещё было мягко в Бутырках: можно было ночью прятать руки под шинель, на ночь не отбирали очков, пропускали в камеру спички, не выпотрашивали из каждой папиросины табак, а хлеб в передачах резали только на четыре части, не на мелкие кусочки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
