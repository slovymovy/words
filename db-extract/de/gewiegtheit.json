                ],
                "senses": [
                    {
                        "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                        "entry_id": "f162d2c4-cb0d-3080-b6df-8664f6b3fec0",
                        "glosses": [
                            "Eigenschaft, aus Erfahrung schlau, geschickt zu sein"
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7f54d6ea-b659-4089-a913-c22d02d861df",
                                "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                                "text": "„Weltstellung aber verrät er durch die Gewiegtheit in allen Dingen der Politik, Finanz, Verwaltung und Strategie.“"
                            },
                            {
                                "example_id": "e38ed732-2be2-434b-a1c7-02d29bf25689",
                                "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                                "text": "„Bei der Wahl eines Reisenden wird aber nicht immer auf kaufmännische Gewiegtheit, Erfahrung und persönliche Solidität gesehen.“"
                            },
                            {
                                "example_id": "08f4e251-2961-4767-84cb-78b474343963",
                                "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                                "text": "„Das ist von Mir gegeben und behütet, eingemittet und erhöht zum Absoluten, das Ich Bin und ewig bleibe in des Seins Erhabenheit, Gewiegtheit, Weisheit und Bewusstheit, in der Liebe liebevollem Sanktuarium.“"
                            },
                            {
                                "example_id": "d4995ed7-6b89-401f-8d9e-93f7f5418cc2",
                                "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                                "text": "„Entweder diese beiden Männer sind tüchtige und bedeutende Männer, dann fällt ihre Ansicht schwer in die Wagsdale, oder wenn deren Ansicht von keinem großen Gewicht ist, so spricht dies nicht für die Gewiegtheit der Männer.“"
                            },
                            {
                                "example_id": "f25cc02b-28c7-48f5-8f24-df2ffe78d641",
                                "sense_id": "94a727fc-5b41-3ade-9c5e-e82db155fb3e",
                                "text": "„Auch das Sichten und Scheiden, das Wiegen und Wägen des Gelernten und Erlebten war gewiss noch weit hinter der Gewiegtheit und Sicherheit zurück, die sein Beruf von ihm forderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
