                        "entry_id": "ffe5fe68-907f-3c9a-bb85-103398908931",
                        "glosses": [
                            "Sous-système informatique de gestion automatique de la mémoire. Il est responsable du recyclage de la mémoire préalablement allouée puis libérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7259d17-5fe4-46c0-b383-6dae0f620458",
                                "sense_id": "370c5c9b-b64e-3c37-9406-3bc6f8dc13ed",
                                "text": "Lorsque le ramasse-miette se lance, le programme se bloque pendant au moins trois secondes !"
                            }
                        ]
                    },
