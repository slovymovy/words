                "senses": [
                    {
                        "sense_id": "eb15668e-1239-3a7a-a74a-fb3d07b97271",
                        "entry_id": "0279c369-5ec1-3b79-9e68-e653f21a5001",
                        "glosses": [
                            "nachtaktiver Vogel"
                        ],
                        "tags": [
                            "Zoologie, speziell Ornithologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0dd44a46-dc3a-4c4e-a406-330344e2e887",
                                "sense_id": "eb15668e-1239-3a7a-a74a-fb3d07b97271",
                                "text": "„Die Blätter der Bäume raschelten, ein Nachtvogel rief, vielleicht ein Uhu, der seinen verletzten Gefährten suchte.“"
                            },
                            {
                                "example_id": "7f2ae9a2-f71f-4a72-8b51-935a212fe079",
                                "sense_id": "eb15668e-1239-3a7a-a74a-fb3d07b97271",
                                "text": "„In den dunklen Schatten des Waldes erhob ein unheimlicher Nachtvogel seinen spottenden Ruf.“"
                            },
                            {
                                "example_id": "f59962de-0e50-4427-b08e-869c0d9a4aa3",
                                "sense_id": "eb15668e-1239-3a7a-a74a-fb3d07b97271",
                                "text": "„Es war jedoch unmöglich zu sagen, auf was er lauschte; draußen war Wind aufgekommen, und die Stimme des Meeres murmelte und donnerte über den Strand; dahinter erhob sich die Stimme eines Nachtvogels, es war ein unheimliches, unvertrautes Heulen, und über uns rauschte etwas unablässig auf dem Dachboden, als heule der Wind irgendwo durch eine Öffnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e7ce187-be7d-4b43-8c5f-334b4616c3d0",
                        "source_entry_id": "0279c369-5ec1-3b79-9e68-e653f21a5001",
                        "source_sense_id": "eb15668e-1239-3a7a-a74a-fb3d07b97271",
                        "source_sense_description": "nachtaktiver Vogel",
                        "target_lang_word": "night bird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "night bird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1835d1f2-07a4-3816-8177-a1f0a653867e",
                                        "entry_id": "94c0b6c2-1846-31e5-a9c0-b6ac5d5cae60",
                                        "glosses": [
                                            "A bird that is active in the night; a nocturnal bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a48d0fb-5347-4bb1-8c04-8999f29603e6",
                                                "sense_id": "1835d1f2-07a4-3816-8177-a1f0a653867e",
                                                "text": "Some night-bird, belike, or a sea-gull squalling below the headland."
                                            },
                                            {
                                                "example_id": "d37bef90-1b58-455d-b627-da339a512d28",
                                                "sense_id": "1835d1f2-07a4-3816-8177-a1f0a653867e",
                                                "text": "Far out in the scrubs a solitary nightbird was calling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f33884-593b-32ac-b9ef-05989ae585ee",
                                        "entry_id": "94c0b6c2-1846-31e5-a9c0-b6ac5d5cae60",
                                        "glosses": [
                                            "A human denizen of night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f17f2f-bb64-4ae5-8531-aa7a81dcfece",
                                                "sense_id": "b8f33884-593b-32ac-b9ef-05989ae585ee",
                                                "text": "Bradley assenting, went with him into an early public-house, haunted by unsavoury smells of musty hay and stale straw, where returning carts, farmers' men, gaunt dogs, fowls of a beery breed, and certain human night-birds fluttering home to roost, were solacing themselves after their several manners; and where not one of the night-birds hovering about the sloppy bar failed to discern at a glance in the passion-wasted night-bird with respectable feathers, the worst night-bird of all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdfe9eb7-0a7c-438a-bb1b-5ab2b24bb051",
                        "source_entry_id": "0279c369-5ec1-3b79-9e68-e653f21a5001",
