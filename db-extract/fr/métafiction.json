                    {
                        "sense_id": "809c6fad-66fa-3168-89b0-7f746a6c673b",
                        "entry_id": "ec6a3d59-f32f-3642-85d9-9b045e15518e",
                        "glosses": [
                            "Forme d’écriture autoréférentielle qui dévoile ses propres mécanismes par des références explicites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a41ca62-9207-416f-a475-acf962f5cb1c",
                                "sense_id": "809c6fad-66fa-3168-89b0-7f746a6c673b",
                                "text": "S’il existe plusieurs définitions de la métafiction, on s’entendra le plus souvent pour dire qu’il s’agit de textes autoréflexifs qui questionnent leur statut en tant qu'œuvre littéraire (Currie 1–2)."
                            }
                        ]
                    }
                ],
                "translations": [
