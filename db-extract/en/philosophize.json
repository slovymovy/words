                                        "glosses": [
                                            "über etwas nachdenken"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b51a5b83-d5df-46c2-a4ff-60de1d474386",
                                                "sense_id": "9c038a4f-5b75-30bd-be9d-069f0f76880a",
                                                "text": "„Erst wenn du im gesetzteren Alter über den FCK philosophierst, schaffst du es in die FAZ, vielleicht ja sogar in den Feuilleton-Teil.“"
                                            }
                                        ],
