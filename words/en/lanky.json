{
    "word_family": [
        "lank"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d013674-ba78-3f7e-b36a-3f0827b2b7ce",
                    "sense_definition": "Tall, slim, and rather ungraceful or awkward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lanky</w> teenager towered over his classmates.",
                            "target_lang_translations": {
                                "zh": "那个<w>瘦长</w>的少年比他的同学们高出一大截。"
                            }
                        },
                        {
                            "text": "A <w>lanky</w> cat with a long frame slinked across the alley.",
                            "target_lang_translations": {
                                "zh": "一只<w>细长</w>的猫拖着长长的身躯溜过了小巷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gangly"
                    ],
                    "common_phrases": [
                        "long lanky frame"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容人或动物身材高大、瘦削且动作不太协调。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瘦长",
                                "target_lang_sense_clarification": "形容身材瘦而长，常带有笨拙的意味。"
                            },
                            {
                                "target_lang_word": "细长",
                                "target_lang_sense_clarification": "形容四肢细长，常用于描述体型。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c3db346-ff73-3859-8fd8-09ffc4297a37",
                    "sense_definition": "From Lancashire or having distinctive Lancashire traits.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a distinct <w>Lanky</w> accent that was hard to understand.",
                            "target_lang_translations": {
                                "zh": "他带着一种很难听懂的、独特的<w>兰开夏</w>口音。"
                            }
                        },
                        {
                            "text": "The local traditions are very <w>Lanky</w> in their origin.",
                            "target_lang_translations": {
                                "zh": "当地的传统起源于<w>兰开夏</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Relating to Lancashire, England."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指英国兰开夏郡的，或具有该地区特征的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰开夏郡的",
                                "target_lang_sense_clarification": "指代英国兰开夏郡相关的地理或文化特征。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa159461-84b4-31c6-b38e-d78d151086fb",
                    "sense_definition": "Someone from Lancashire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regional",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Many <w>Lankies</w> are proud of their industrial heritage.",
                            "target_lang_translations": {
                                "zh": "许多<w>兰开夏郡人</w>为他们的工业遗产感到自豪。"
                            }
                        },
                        {
                            "text": "The group of <w>Lankies</w> gathered at the local pub.",
                            "target_lang_translations": {
                                "zh": "一群<w>兰开夏郡人</w>聚集在当地的酒吧里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to people from Lancashire."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "兰开夏郡人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰开夏郡人",
                                "target_lang_sense_clarification": "指居住在英国兰开夏郡的人。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0adb4d9a-34ef-31ad-a6d2-c6fd0d5e8892",
                    "sense_definition": "The dialect of English spoken in Lancashire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "He struggled to understand the <w>Lanky</w> spoken by the locals.",
                            "target_lang_translations": {
                                "zh": "他很难听懂当地人说的<w>兰开夏方言</w>。"
                            }
                        },
                        {
                            "text": "Old poems were written in <w>Lanky</w> to preserve the dialect.",
                            "target_lang_translations": {
                                "zh": "古老的诗歌是用<w>兰开夏方言</w>写成的，以保存这种方言。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to the Lancashire dialect."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "兰开夏郡方言。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰开夏方言",
                                "target_lang_sense_clarification": "指英国兰开夏郡地区使用的方言。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b5870ba-444a-38f5-9a92-27a7b4b4abc5",
                    "sense_definition": "The Lancashire and Yorkshire Railway.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Lanky</w> was a major transport line in the north.",
                            "target_lang_translations": {
                                "zh": "<w>兰开夏与约克郡铁路</w>曾是北部的一条主要运输线。"
                            }
                        },
                        {
                            "text": "Old trains from the <w>Lanky</w> are now in museums.",
                            "target_lang_translations": {
                                "zh": "<w>兰开夏与约克郡铁路</w>的老式火车现在陈列在博物馆里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical railway company."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "兰开夏与约克郡铁路公司。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兰开夏与约克郡铁路",
                                "target_lang_sense_clarification": "英国历史上的一个铁路运输公司。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}