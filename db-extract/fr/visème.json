                    {
                        "sense_id": "33ad16d4-a50e-32b5-815b-33f22e237858",
                        "entry_id": "3e19de73-ae4f-3d88-aa4c-bc80b9305301",
                        "glosses": [
                            "Expression faciale élémentaire associée à une émotion ou à l’élocution d’un phonème."
                        ],
                        "tags": [
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3f1d43a1-5906-4653-bba0-0b1a43069425",
                                "sense_id": "33ad16d4-a50e-32b5-815b-33f22e237858",
                                "text": "Ce cours a pour objectif de vous permettre d’acquérir les bases en animation d’agents virtuels humains, elle ^([sic]) explique comment créer des visages avec la prise en compte des expressions faciales (appelées « visèmes ») ainsi que l’animation des mouvements de personnage (par l’articulation du squelette). Le cours commence par une explication sur les maillages de surface (géométrie tridimensionnelle et algorithmique) et se poursuit par leur application au cas des visages et squelettes."
                            },
                            {
                                "example_id": "9da9df56-2639-42fa-a9e8-bbb07dfeafd3",
                                "sense_id": "33ad16d4-a50e-32b5-815b-33f22e237858",
                                "text": "L’élaboration d’une tête parlante nécessite en particulier la construction de visèmes de la langue à traiter, ici la langue Française ^([sic])."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
