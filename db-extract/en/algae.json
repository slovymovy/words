                    },
                    {
                        "form_id": "11768665-3c0f-41ad-8579-2eada2b04f24",
                        "entry_id": "03537df7-9c6a-32a3-8841-aea8ef5dae36",
                        "tags": [
                            "plural"
                        ],
                        "form": "algaes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af7f24c9-cdf2-319a-9b08-50dc923a45c0",
                        "entry_id": "03537df7-9c6a-32a3-8841-aea8ef5dae36",
                        "glosses": [
                            "Algal organisms viewed collectively or as a mass; algal growth."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8fe43883-3f34-483e-a2a1-7024e1d50c79",
                                "sense_id": "af7f24c9-cdf2-319a-9b08-50dc923a45c0",
                                "text": "Algae grows best in shallow water, 3 inches (7.5 cm) deep or less, especially where poor seedbed preparation has created low areas with poor surface drainage, and in fields with inadequate decomposition of organic matter."
                            },
                            {
                                "example_id": "822502c7-2d34-4a0c-8f19-11aff34789f8",
                                "sense_id": "af7f24c9-cdf2-319a-9b08-50dc923a45c0",
                                "text": "Unlike seaweed, which grows in salt water, algae grows in freshwater ponds (chlorella or spirulina) or wild in the Pacific Northwest (Klamath blue green)."
                            },
                            {
                                "example_id": "a3eb0317-c363-453e-b2ad-3dc5e5775192",
                                "sense_id": "af7f24c9-cdf2-319a-9b08-50dc923a45c0",
                                "text": "An algae bloom has killed thousands of fish in the San Francisco Bay Area in recent weeks, officials say, forcing shoreline cleanups, spreading unpleasant odor and spurring scientists to further investigate the extent of the ecological damage."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdb2bbf6-b585-3810-ab61-178b211791bf",
                        "entry_id": "03537df7-9c6a-32a3-8841-aea8ef5dae36",
                        "glosses": [
                            "A particular kind of alga."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2b5cf012-3d18-4f3a-8a69-1ac6e5722a7f",
                                "sense_id": "fdb2bbf6-b585-3810-ab61-178b211791bf",
                                "text": "This hollow, lumpy, yellow-brown algae grows epiphytically in sac-like clumps on large seaweeds and on rocks."
                            },
                            {
                                "example_id": "80a2eee2-7542-4f8f-9882-f929e071d4ae",
                                "sense_id": "fdb2bbf6-b585-3810-ab61-178b211791bf",
                                "text": "This algae grows relatively quickly, even in temporary ponds and water holes in the desert, so it remained widely known."
                            },
                            {
                                "example_id": "0641d829-e1fc-42d4-bb98-30876917d792",
                                "sense_id": "fdb2bbf6-b585-3810-ab61-178b211791bf",
                                "text": "Although often lumped together, spirulina is a blue-green algae whereas chlorella is a green algae."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
