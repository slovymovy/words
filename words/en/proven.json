    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "760c8978-abf7-3a62-ad0f-69a8c3ffaeeb",
                    "sense_definition": "Having been verified or demonstrated to be true, effective, or valid.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate has a <w>proven</w> track record of success in local government.",
                            "target_lang_translations": {
                                "ru": "У кандидата есть <w>подтверждённый</w> послужной список успехов в органах местного самоуправления.",
                                "zh": "这位候选人在地方政府工作中有着<w>公认的</w>成功记录。",
                                "es": "El candidato tiene un historial <w>probado</w> de éxito en el gobierno local."
                            }
                        },
                        {
                            "text": "It is a <w>proven</w> fact that a healthy diet improves your mood.",
                            "target_lang_translations": {
                                "ru": "То, что здоровое питание улучшает настроение — это <w>доказанный</w> факт.",
                                "zh": "健康饮食能改善情绪是一个<w>经过验证的</w>事实。",
                                "es": "Es un hecho <w>demostrado</w> que una dieta saludable mejora el estado de ánimo."
                            }
                        }
                    ],
                    "synonyms": [
                        "verified",
                        "established",
                        "confirmed",
                        "demonstrated"
                    ],
                    "antonyms": [
                        "unproven",
                        "disproven"
                    ],
                    "common_phrases": [
                        "proven track record",
                        "proven fact",
                        "proven ability",
                        "proven method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подтверждённый фактами, проверенный или доказавший свою эффективность.",
                        "zh": "经过验证或证明是真实、有效或可靠的。",
                        "es": "Que ha sido verificado o demostrado como verdadero, efectivo o válido."
                    },
                    "translations": {
