                "senses": [
                    {
                        "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                        "entry_id": "f727b521-684d-3e89-81ad-7ad5e7c7f65e",
                        "glosses": [
                            "innerer Teil, innere Seite eines Kastens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da833653-b733-4673-8390-aea471e3a8fc",
                                "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                                "text": "„Im thermodynamischen Gleichgewicht stellt sich ein Gleichgewicht zwischen absorbierter und emittierter Strahlung im Kasteninneren ein.“"
                            },
                            {
                                "example_id": "bc3b5073-bbf5-40c6-983e-1c0d616cf1e1",
                                "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                                "text": "„Nicke einigen bekannten Gesichtern zu und versuche zu sehen, was sich im Kasteninneren versteckt.“"
                            },
                            {
                                "example_id": "8819232c-3423-463c-af16-7567df1d4530",
                                "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                                "text": "„Mit hydraulisch betätigten Außenschalungen und Einsatz von Schalwagen im Kasteninneren kann die Produktivität weiter gesteigert werden.“"
                            },
                            {
                                "example_id": "8995c3c0-ddfe-4d58-9c73-fbcb4cc940d8",
                                "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                                "text": "„Zwischen der Frontscheibe und der Bodenoberfläche im Kasteninneren befand sich weiterhin eine durchsichtige Schutzfolie.“"
                            },
                            {
                                "example_id": "01e7eee9-31a6-4c10-a994-fc07a2a22405",
                                "sense_id": "340e3826-4715-34cb-99df-8548d5788f3e",
                                "text": "„Ein Kasten, der am unteren Ende Schneiden aufweist (siehe Bild 3.16), wird durch das Ausheben des Bodens im Kasteninneren allmählich zum Absinken gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
