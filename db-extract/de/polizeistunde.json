                "senses": [
                    {
                        "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                        "entry_id": "3e0f79a7-0566-3a97-b9cd-9e8cf6c4474e",
                        "glosses": [
                            "Zeit, zu der gastronomische Einrichtungen schließen müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf38a3d-7a3b-413c-917b-cc1922d12662",
                                "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                                "text": "Wir wollten noch ein Bier trinken, doch es war leider schon Polizeistunde."
                            },
                            {
                                "example_id": "5b42c4ff-df49-4bb2-b727-a69f64086077",
                                "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                                "text": "„Er sagte, der Aufgang sei schon geschlossen, aber er könne mir den heimlichen Aufstieg zeigen, den sie immer benutzten, wenn sie nach der Polizeistunde noch hochwollten.“"
                            },
                            {
                                "example_id": "4f300d82-3e82-4a55-a062-2ae66392d368",
                                "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                                "text": "„Einmal, berichtet Tanner weiter, saß Einstein mit seinen Studenten bis zur Polizeistunde plaudernd in einem Café.“"
                            },
                            {
                                "example_id": "4e1dbe97-ed70-477b-90d1-26ab25bfac79",
                                "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                                "text": "„In New York schien es einfach keine Polizeistunde zu geben.“"
                            },
                            {
                                "example_id": "b60c7813-e2fc-43e7-a0a3-ddcb7360f61e",
                                "sense_id": "bc9fd32b-8750-3e36-9a2e-e0679f85f6f3",
                                "text": "„Eines Abends hatten wir drei uns bei einem Bekannten verplaudert, und als ich einen Blick auf die Uhr warf, stellte ich zu meinem Schrecken fest, daß schon bald die Polizeistunde beginnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
