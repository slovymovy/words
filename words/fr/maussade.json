                },
                {
                    "sense_id": "d4ecebc3-c7c8-3541-924f-060ee41f6f78",
                    "sense_definition": "D'une humeur sombre, chagrine ou difficile, qui montre du mécontentement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis ce matin, il affiche une humeur particulièrement <w>maussade</w> et refuse de nous parler.",
                            "target_lang_translations": {
                                "en": "Since this morning, he has been in a particularly <w>sullen</w> mood and has refused to speak to us.",
                                "ru": "С самого утра у него особенно <w>угрюмое</w> настроение, и он отказывается с нами разговаривать.",
                                "de": "Seit heute Morgen zeigt er eine besonders <w>missmutige</w> Stimmung und weigert sich, mit uns zu reden.",
                                "es": "Desde esta mañana está especialmente <w>malhumorado</w> y se niega a hablar con nosotros.",
                                "zh": "从今天早上起，他就一直情绪特别<w>阴沉</w>，还拒绝跟我们说话。"
                            }
                        },
                        {
                            "text": "Pourquoi prends-tu cet air <w>maussade</w> alors que nous partons bientôt en vacances ?",
                            "target_lang_translations": {
                                "en": "Why are you putting on that <w>glum</w> look when we're leaving for our holidays soon?",
                                "ru": "Почему ты принимаешь такой <w>хмурый</w> вид, когда мы скоро уезжаем в отпуск?",
                                "de": "Warum machst du so eine <w>missmutige</w> Miene, obwohl wir bald in den Urlaub fahren?",
                                "es": "¿Por qué pones esa cara <w>hosca</w> cuando nos vamos de vacaciones pronto?",
                                "zh": "我们很快就要去度假了，你为什么还摆出这副<w>不快</w>的样子？"
                            }
                        }
                    ],
                    "synonyms": [
                        "morose",
                        "bougon",
                        "renfrogné",
                        "sombre"
                    ],
                    "antonyms": [
                        "joyeux",
                        "heureux"
                    ],
                    "common_phrases": [
                        "air maussade",
                        "mine maussade",
                        "humeur maussade"
                    ],
                    "target_lang_definitions": {
                        "en": "Describes a gloomy, sulky or difficult mood that shows displeasure.",
                        "ru": "О мрачном, угрюмом или раздражённом настроении, выражающем недовольство.",
                        "de": "Beschreibt eine düstere, verdrießliche oder schwierige Stimmung, die Unzufriedenheit zeigt.",
                        "es": "Dicho del humor o del aspecto de alguien, sombrío, malhumorado o difícil, que muestra disgusto.",
                        "zh": "形容心情阴郁、郁闷或难以相处，流露出不满。"
                    },
