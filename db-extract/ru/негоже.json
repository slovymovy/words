        "ru-extract.jsonl": [
            {
                "entry_id": "ab76e410-6c7c-39de-98b9-5ad7aeecea75",
                "word": "негоже",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e5020b98-1a49-370f-b093-77b849f01b79",
                        "entry_id": "ab76e410-6c7c-39de-98b9-5ad7aeecea75",
                        "glosses": [
                            "разг. свойство по значению прилагательного негожий; плохо, дурно, нехорошо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec2942b-96f9-4c5d-a7a6-db03486e95ef",
                                "sense_id": "e5020b98-1a49-370f-b093-77b849f01b79",
                                "text": "Ведёшь себя негоже!"
                            },
                            {
                                "example_id": "177d6055-4ad3-4ae7-a10a-52873f5e0b97",
                                "sense_id": "e5020b98-1a49-370f-b093-77b849f01b79",
                                "text": "Товарища выдавать негоже."
                            },
                            {
                                "example_id": "3694f1be-12b1-4a7b-ae72-20b37bcb05df",
                                "sense_id": "e5020b98-1a49-370f-b093-77b849f01b79",
                                "text": "Второй размер, отметил я, и тут же устыдился: негоже это ― переводить совершенство в номера и сантиметры."
                            }
                        ]
                    },
                    {
                        "sense_id": "b981fc0c-b43f-36ef-ab45-1524a2854894",
                        "entry_id": "ab76e410-6c7c-39de-98b9-5ad7aeecea75",
                        "glosses": [
                            "неподходяще, не следует, нельзя, не годится"
                        ],
                        "tags": [
                            "в функции сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "ed0b455c-3b45-4efd-815d-d5673d5f672d",
                                "sense_id": "b981fc0c-b43f-36ef-ab45-1524a2854894",
                                "text": "То, что годится для иностранного словаря, газете — негоже."
                            },
                            {
                                "example_id": "e0f7368a-434d-4075-a9da-53a91df1d075",
                                "sense_id": "b981fc0c-b43f-36ef-ab45-1524a2854894",
                                "text": "Торопиться было негоже: кто-нибудь мог увидеть."
                            },
                            {
                                "example_id": "75fadd81-e988-410f-b3f4-5225dd569598",
                                "sense_id": "b981fc0c-b43f-36ef-ab45-1524a2854894",
                                "text": "И ты встань, Петрок, негоже ползать перед ними на коленях."
                            }
                        ]
                    }
                ],
