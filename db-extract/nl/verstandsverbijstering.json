                                "target_senses": [
                                    {
                                        "sense_id": "559e41b0-e865-37f0-9378-3e45bf99b762",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "The state of being mad, insanity",
                                            "A cyclical mental disease, apparently linked to the lunar phases."
                                        ],
