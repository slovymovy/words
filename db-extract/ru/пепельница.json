                    {
                        "translation_id": "284b3542-a64f-4524-a59f-2729dda4af91",
                        "source_entry_id": "8e7d5d35-e98a-3387-a9f4-4af620e6d0ea",
                        "source_sense_id": "e8b876f9-3312-3489-a008-c524b49246da",
                        "target_lang_word": "Aschenbecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aschenbecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                        "entry_id": "e1436928-2c4a-3a1b-b43b-2183ea2dace3",
                                        "glosses": [
                                            "Schale für Tabakasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b6c9abf-7eb6-44ce-b109-835393bfebed",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "Wo ist bloß der Aschenbecher?"
                                            },
                                            {
                                                "example_id": "5c22a108-aab1-4fc6-a112-11d1a9b42866",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "Der Aschenbecher ist bis zum Rand mit Zigarettenkippen gefüllt."
                                            },
                                            {
                                                "example_id": "9c8fed46-d781-4bb7-9871-5f6734e2cfcb",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Er überzeugt sich genau, daß die Scheine nirgendwo unter dem Aschenbecher hervorsehen.“"
                                            },
                                            {
                                                "example_id": "dc278dfb-810d-43a6-8870-34af73772d14",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Solowjew drückte seine Zigarre aus, was den ganzen Aschenbecher verwüstete.“"
                                            },
                                            {
                                                "example_id": "340edd87-4c93-4c95-a4ff-9d7e3868f321",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Der Alte tätschelte ihm die Wange und fing dann an, die Aschenbecher in der Wartehalle zu leeren.“"
                                            },
                                            {
                                                "example_id": "3febae00-bed0-41e9-a456-451a1caa8139",
                                                "sense_id": "cd3d05bd-f4da-32f9-9560-31eb15259503",
                                                "text": "„Sie streift die Asche im Aschenbecher ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "671f715d-f81d-4575-9914-068bc2ddbd5f",
                        "source_entry_id": "8e7d5d35-e98a-3387-a9f4-4af620e6d0ea",
                        "source_sense_id": "e8b876f9-3312-3489-a008-c524b49246da",
                        "target_lang_word": "cendrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cendrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08f2163c-d1a7-3af1-9574-1d70505dfb09",
                                        "entry_id": "83c14a31-e684-3204-a2c7-3211c77b86ee",
                                        "glosses": [
                                            "Partie du fourneau qui est au-dessous de la grille ou du foyer, et dans laquelle tombent les cendres du bois ou du charbon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b14562f-25af-3367-9656-80830c07b173",
                                        "entry_id": "83c14a31-e684-3204-a2c7-3211c77b86ee",
                                        "glosses": [
                                            "Espace au-dessous du foyer d’une locomotive à vapeur, où tombent les cendres et escarbilles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b6e92c-f26f-3512-a314-3d0fb57d5785",
                                        "entry_id": "83c14a31-e684-3204-a2c7-3211c77b86ee",
                                        "glosses": [
                                            "Petite coupe où l’on dépose les cendres d’un cigare, d’une cigarette, d’une pipe, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4bd307e-28ef-45be-abb1-4dc15fa6cc19",
                                                "sense_id": "34b6e92c-f26f-3512-a314-3d0fb57d5785",
                                                "text": "Esmé sort cinq cigarettes, les allume les cinq et les pose sur le bord d’un cendrier de verre."
                                            },
                                            {
                                                "example_id": "185b6597-395f-443d-b6b5-b6c4507eccb0",
                                                "sense_id": "34b6e92c-f26f-3512-a314-3d0fb57d5785",
                                                "text": "La machine à écrire sur la consolette Louis XV, la ronéotype sur le bureau Napoléon III, des paquets de papier partout sur un vestige de tapis de la Savonnerie, et des cendriers pleins de clopes dans tous les coins."
                                            },
                                            {
                                                "example_id": "f83d7e8e-69f1-4e96-86f8-1a6ec56d78f1",
                                                "sense_id": "34b6e92c-f26f-3512-a314-3d0fb57d5785",
                                                "text": "Il allumait cigarette sur cigarette et faisait tomber sa cendre à petits gestes secs. Le cendrier débordait de mégots et de filtres à nicotine aux granulés jaunis, qui exhalaient leur odeur pestilentielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24b90b67-3a19-3f80-990b-8a82c3655148",
                                        "entry_id": "83c14a31-e684-3204-a2c7-3211c77b86ee",
                                        "glosses": [
                                            "Grand sac de coton, tissé serré, dans lequel on mettait les cendres qui servaient à préparer l’eau de lessive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a29e32be-4549-3f79-ac2e-9ffd65bcfed1",
                                        "entry_id": "83c14a31-e684-3204-a2c7-3211c77b86ee",
                                        "glosses": [
                                            "Grand carré de toile utilisé pour le transport du foin à dos d’homme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
