                                                "example_id": "a5387cf6-dc4a-415f-af20-f34254b03081",
                                                "sense_id": "406ed632-b08e-3649-831f-54da86209ee5",
                                                "text": "\"Gary's an awful name. Whatever he's like. It reminds me of a G.I. man with a crew cut, and 'Mom' tattooed on his chest, and lots of pin-up pictures on his wall.\""
                                            },
                                            {
                                                "example_id": "f54bede2-9eb2-419c-8d7c-43d3aa67537a",
                                                "sense_id": "406ed632-b08e-3649-831f-54da86209ee5",
                                                "text": "Call it a brain freeze, another “Aleppo moment,” or a mere campaign stumble, but Gary Johnson has stumbled again in his quixotic presidential campaign."
                                            }
