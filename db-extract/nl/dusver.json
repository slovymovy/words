                                        "sense_id": "d12e9ecb-82b5-3039-85a0-b745a23c0038",
                                        "entry_id": "53b32815-73b8-3518-8c74-20695bd33022",
                                        "glosses": [
                                            "So far, hitherto."
                                        ],
