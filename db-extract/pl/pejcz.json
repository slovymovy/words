                ],
                "senses": [
                    {
                        "sense_id": "05b9f9c4-dd88-33cc-bd5d-8f2f07330201",
                        "entry_id": "4d6955cd-2e86-39ab-ae2b-a332469dde8c",
                        "glosses": [
                            "krótki, pleciony bicz z rączką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69f7269f-7e9b-4d31-8acb-895cb0f7dd0f",
                                "sense_id": "05b9f9c4-dd88-33cc-bd5d-8f2f07330201",
                                "text": "Gdy pies schylał się, żeby zjeść rzucony kawałek mięsa z podłogi, trener lekko uderzał go pejczem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65e3a057-495a-4041-898f-7b3f81334bca",
                        "source_entry_id": "4d6955cd-2e86-39ab-ae2b-a332469dde8c",
                        "source_sense_id": "05b9f9c4-dd88-33cc-bd5d-8f2f07330201",
                        "target_lang_word": "quirt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quirt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8a9b1c-5b41-38de-b7ad-00c66c392905",
                                        "entry_id": "25629008-c91e-30e6-bf13-660d1b275dc5",
                                        "glosses": [
                                            "To strike with a quirt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quirt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                        "entry_id": "30ea4567-068c-3b0c-aa86-bb68fdf1b826",
                                        "glosses": [
                                            "A rawhide whip plaited with two thongs of buffalo hide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81193fd0-cfd0-4f67-9f3d-d62c2c8eb6c9",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "He sprang into the saddle easily as a bird, got the quirt from the horn, and gave his pony a slash with it."
                                            },
                                            {
                                                "example_id": "96cb7b9a-ddb1-425d-8ac6-3c0ce7c106d9",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "He paused a moment and flicked a sage-brush with his quirt."
                                            },
                                            {
                                                "example_id": "0ab8aad5-db10-476c-b72c-a9585c16572e",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "[…] when the young man whirled his horse, “hazed” Jupiter in circles and belaboured him with a rawhide quirt, […] He ceased his cavortings […]"
                                            },
                                            {
                                                "example_id": "16d0eb5b-4511-4f0e-a12e-7f5b57cc5aa7",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "He wore a revolver down low, with ammunition belt, and carried a small quirt of some kind, and pieces of leather hanging everywhere, like a walking torture chamber: shiny shoes, low-hanging jacket, cocky hat, everything but boots."
                                            },
                                            {
                                                "example_id": "a6010b1a-e99d-4ef2-ace2-d507e8bbcd21",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "She raised the handle of her beautiful quirt to her eyes and scanned the Western horizon."
                                            },
                                            {
                                                "example_id": "fb57ffa6-ea8a-4edf-aa38-46cb79375801",
                                                "sense_id": "366a44ed-3243-35e1-8a1f-2898fa9aa035",
                                                "text": "He rode his horse with the reins tied and he wore a pistol at his belt and a plain flatcrowned hat of a type no longer much seen in that country and he wore tooled boots to his knees and carried a quirt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
