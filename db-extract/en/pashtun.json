                "senses": [
                    {
                        "sense_id": "0588fa1d-f18c-32c3-92bd-8a533efc23e8",
                        "entry_id": "0f33a551-4ac4-3553-a79e-14784e4db293",
                        "glosses": [
                            "Of or relating to the Pashtuns (a segmentary-lineage ethnic group currently numbering some 50 million people, which is the largest ethnic group in Afghanistan and the second largest in Pakistan), or to their culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac2f182-4a6c-4814-a86a-7fc63721b47c",
                                "sense_id": "0588fa1d-f18c-32c3-92bd-8a533efc23e8",
                                "text": "“What about Zalmai?” he said. “It’s a good Pashtun name.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a62fb8c-a2a4-47d7-8dc8-cf054f77efe8",
                        "source_entry_id": "0f33a551-4ac4-3553-a79e-14784e4db293",
                        "source_sense_id": "0588fa1d-f18c-32c3-92bd-8a533efc23e8",
                        "source_sense_description": "of or relating to the Pashtuns",
                        "target_lang_word": "paschtunisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paschtunisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66eadd16-b400-39e2-9dbf-3ef24e56eec9",
                                        "entry_id": "1f920dd0-772b-3b81-b511-3638189e3b8f",
                                        "glosses": [
                                            "die Paschtunen, das paschtunische Volk betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e470121-83e5-4b97-9bc1-2bc5ac7a9bb1",
                                                "sense_id": "66eadd16-b400-39e2-9dbf-3ef24e56eec9",
                                                "text": "„Er sah aus wie ein paschtunischer Geschäftsmann irgendwo zwischen 50 und 70.“"
                                            },
                                            {
                                                "example_id": "b23e423b-c1c1-41ee-9ff0-343a0168c010",
                                                "sense_id": "66eadd16-b400-39e2-9dbf-3ef24e56eec9",
                                                "text": "„Zweifellos hast du längst erraten, weshalb ich dich lebend wollte - mit dir und diesem paschtunischen Schwein habe ich noch einige unterhaltsame Dinge vor.“"
                                            },
                                            {
                                                "example_id": "f5e6a68b-4d98-43b0-914e-e4c404ce474a",
                                                "sense_id": "66eadd16-b400-39e2-9dbf-3ef24e56eec9",
                                                "text": "„Er sagt, dass er und Nazir keine Angst vor diesen halben Männern aus Amerika haben, und zitiert ein altes paschtunisches Sprichwort, das Haji Mohammed seinen Söhnen beigebracht hat: ›Wer heute entehrt wird, ist morgen verloren.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "974d7c08-428f-30e8-8eb2-fabdf1889c61",
                                        "entry_id": "1f920dd0-772b-3b81-b511-3638189e3b8f",
                                        "glosses": [
                                            "die paschtunische Sprache (das Paschtunische) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6d860a-c329-4b1a-8767-d1e58539202b",
                                                "sense_id": "974d7c08-428f-30e8-8eb2-fabdf1889c61",
                                                "text": "„‹Nikka›, begann der Gefangene, indem er das paschtunische Wort für Großvater verwendete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
