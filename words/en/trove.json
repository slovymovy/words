    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e1f7745-ceb4-34b7-bbf9-2681ad476df0",
                    "sense_definition": "A store of valuable items or money found hidden or abandoned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The divers discovered a sunken <w>trove</w> of gold coins off the coast.",
                            "target_lang_translations": {
                                "nl": "De duikers ontdekten een gezonken <w>schat</w> aan gouden munten voor de kust."
                            }
                        },
                        {
                            "text": "Archaeologists unearthed a hidden <w>trove</w> of ancient jewelry in the cave.",
                            "target_lang_translations": {
                                "nl": "Archeologen hebben in de grot een verborgen <w>schat</w> aan antieke sieraden opgegraven."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoard",
                        "cache"
                    ],
                    "common_phrases": [
                        "treasure trove"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een voorraad waardevolle voorwerpen of geld die verborgen of achtergelaten is gevonden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schat",
                                "target_lang_sense_clarification": "gevonden waardevolle voorwerpen"
                            },
                            {
                                "target_lang_word": "schatvondst",
                                "target_lang_sense_clarification": "gevonden schat of depot"
                            },
                            {
                                "target_lang_word": "buit",
                                "target_lang_sense_clarification": "verzameling gevonden waardevolle spullen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b3e0769-bfa3-380c-874c-5926b7294615",
                    "sense_definition": "A large or valuable collection of information, objects, or resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library is a <w>trove</w> of historical documents and rare books.",
                            "target_lang_translations": {
                                "nl": "De bibliotheek is een <w>schatkamer</w> aan historische documenten en zeldzame boeken."
                            }
                        },
                        {
                            "text": "Her attic was a <w>trove</w> of forgotten family photographs and letters.",
                            "target_lang_translations": {
                                "nl": "Haar zolder was een <w>schatkamer</w> vol vergeten familiefoto's en brieven."
                            }
                        }
                    ],
                    "synonyms": [
                        "collection",
                        "repository",
                        "wealth"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een grote of waardevolle verzameling van informatie, objecten of bronnen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schatkamer",
                                "target_lang_sense_clarification": "rijke verzameling of bron"
                            },
                            {
                                "target_lang_word": "goudmijn",
                                "target_lang_sense_clarification": "figuurlijk, rijke bron van nuttige zaken"
                            },
                            {
                                "target_lang_word": "schat",
                                "target_lang_sense_clarification": "grote verzameling waardevolle dingen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
