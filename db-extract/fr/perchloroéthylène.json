                                        "entry_id": "c8b3af7d-85c7-332b-afbd-e3651577a7b1",
                                        "glosses": [
                                            "A liquid chlorocarbon with the formula C₂Cl₄, commonly used in dry cleaning and metal degreasing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca56df40-2010-4413-8e7f-993c87946545",
                                                "sense_id": "a79209e1-720d-3227-997a-ec317e77d315",
                                                "text": "Uses of tetrachloroethylene have included dry cleaning, degreasing, deworming, and others, but its use is now curtailed as compared with decades ago."
                                            },
                                            {
                                                "example_id": "3566f279-2cc7-450d-93e5-624f650067ba",
                                                "sense_id": "a79209e1-720d-3227-997a-ec317e77d315",
                                                "text": "The department has been testing samples of tap water in the affected neighborhoods for the presence of the chemical, tetrachloroethylene, which is used in dry cleaning and auto body repair."
                                            }
                                        ]
                                    }
                                ]
                            }
