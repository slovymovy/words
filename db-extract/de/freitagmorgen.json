                "senses": [
                    {
                        "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                        "entry_id": "17e5c0fd-6976-3498-b947-12256d999c43",
                        "glosses": [
                            "der Morgen eines Freitages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ccbb29-a09b-4be8-a651-3cde38d6d2ea",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "Am Freitagmorgen hat man das Wochenende schon vor Augen."
                            },
                            {
                                "example_id": "bda15c43-89d3-424d-a757-0a48b8344d57",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "Augenzeugen beobachteten an zwei aufeinanderfolgenden Freitagmorgen einen Mann im Gebüsch nahe dem Bahnhof."
                            },
                            {
                                "example_id": "3dca100b-3c6c-4709-b110-07b3a725eff5",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "„Edgeworths Steuermann trieb den ganzen Freitagmorgen zur Abfahrt und drohte mit Unwetter und Nebel.“"
                            },
                            {
                                "example_id": "05932625-7fdc-434c-aacf-1d687c6c9168",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "„Es war früh am Freitagmorgen, die Vögel sangen leise, und ich stand auf dem Bürgersteig vor meinem Haus in der Sonne und fragte mich, ob ich die richtige Entscheidung getroffen hatte und ob ich das ohne Koffein überhaupt beurteilen konnte.“"
                            },
                            {
                                "example_id": "4d19f44f-949c-4583-9fd5-2d67e14b4bc2",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "„Die 73 Meter lange „Annika“ war am Freitagmorgen etwa 4,5 Kilometer vor Heiligendamm in Brand geraten.“"
                            },
                            {
                                "example_id": "4ebcba9e-30cf-4ada-b9a5-e08c8ed32b96",
                                "sense_id": "37c03e23-2347-3476-9bdc-6c05e1456829",
                                "text": "„Es stellte sich heraus, dass sie die Reise nie angetreten, sondern sich am Freitagmorgen krankgemeldet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
