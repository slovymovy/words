                                    {
                                        "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                                        "entry_id": "c9c7a4e5-7740-3856-88b1-27cc325fc26b",
                                        "glosses": [
                                            "(u ludzi i zwierząt) niechęć lub chorobliwy lęk przed ludźmi"
                                        ],
                                        "tags": [
                                            "psychology"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e60297-414a-4fdd-8a87-1210642b8ca8",
                                                "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                                                "text": "Najbardziej istotne zmiany występują w grupach zwierząt wykazujących antropofobię lub ścisły związek ze środowiskami naturalnymi. Zmiany wywołane urbanizacją powodują w pierwszym rzędzie zmniejszanie się powierzchni terenów, na których mogą one żyć"
                                            },
                                            {
                                                "example_id": "ce18cf71-3e16-4dba-95cc-c99a44bbbb52",
                                                "sense_id": "8f8da8a1-1899-30a4-b6bd-e1c98a039650",
                                                "text": "Miliony ludzi cierpią na antropofobię, czyli chorobliwy lęk przed innymi ludźmi"
                                            }
                                        ],
