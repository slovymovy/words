                ],
                "senses": [
                    {
                        "sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                        "entry_id": "85ba9d75-2ff3-3f2e-b690-8250de4ce08b",
                        "glosses": [
                            "een geringe kans bezittend om waar te worden of te blijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02475b8-d2ef-429f-ba17-f4be60002f16",
                                "sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                                "text": "Hij voerde de onwaarschijnlijkste redenen aan."
                            },
                            {
                                "example_id": "6bf9e5d7-e405-457f-883b-2a75fc28ca57",
                                "sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                                "text": "Maar dat de telefoon van duizenden mensen werd afgeluisterd? Dat was alleen om praktische redenen al onwaarschijnlijk."
                            },
                            {
                                "example_id": "97d204d9-ab95-4fac-b754-ca70b20bef58",
                                "sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                                "text": "Jarenlang procederen zal tijd en energie kosten die kwekers liever in hun product hadden gestoken, vreest Cusani. Dat zijn werknemers de komende maanden opnieuw de Calabrese heuvels vol kunnen planten met hennep, is zeer onwaarschijnlijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "916ab7bc-2128-4b36-841a-4ac957f9a98c",
                        "source_entry_id": "85ba9d75-2ff3-3f2e-b690-8250de4ce08b",
                        "source_sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                        "source_sense_description": "een geringe kans bezittend om waar te worden of te blijken",
                        "target_lang_word": "unwahrscheinlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwahrscheinlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                        "entry_id": "d612f12c-5f11-3365-a0a0-687952d2c4a3",
                                        "glosses": [
                                            "nicht wahrscheinlich; mit geringer Wahrscheinlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1c75c3-9615-41f8-8f26-4fb786678395",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "Im Lotto zu gewinnen ist höchst unwahrscheinlich."
                                            },
                                            {
                                                "example_id": "a57fdd52-8093-48e4-985d-a5f5829801b1",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "„Denn selbst wenn es für die Wohnung bereits einen Nachmieter gibt, so ist es aktuell eher unwahrscheinlich, dass er oder sie demnächst einzieht.“"
                                            },
                                            {
                                                "example_id": "760e8f8d-0509-4124-9e26-a66aa416eaed",
                                                "sense_id": "b74018ac-039b-3652-89e1-d9fafb0bc8e0",
                                                "text": "„Die Regierungen der Welt haben sich im Paris-Abkommen verpflichtet, die Erderhitzung bei deutlich unter 2 Grad und möglichst bei 1,5 Grad zu begrenzen. Das erscheint aber zunehmend unwahrscheinlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0435beb-3207-3949-9fd9-ed0ed6eacd9b",
                                        "entry_id": "d612f12c-5f11-3365-a0a0-687952d2c4a3",
                                        "glosses": [
                                            "sehr, übermäßig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ab5b6-c3ed-4447-829d-36924a19e596",
                                                "sense_id": "d0435beb-3207-3949-9fd9-ed0ed6eacd9b",
                                                "text": "Sie hatte bei der letzten Prüfung unwahrscheinliches Glück mit dem Thema gehabt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d58e16db-d39e-4bf9-b4b0-8fbe3ec41db1",
                        "source_entry_id": "85ba9d75-2ff3-3f2e-b690-8250de4ce08b",
                        "source_sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                        "source_sense_description": "een geringe kans bezittend om waar te worden of te blijken",
                        "target_lang_word": "improbable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improbable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b24c19de-967c-31a6-a17c-789a39711cac",
                                        "entry_id": "a6237cf3-f902-3a45-9535-4cdbe92ad493",
                                        "glosses": [
                                            "Not likely to be true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f19b28-0f3a-41cb-a721-7876db7414da",
                                                "sense_id": "b24c19de-967c-31a6-a17c-789a39711cac",
                                                "text": "It's highly improbable that aliens abducted you."
                                            },
                                            {
                                                "example_id": "c48a8c0d-862b-4af4-9f0f-73e63201e0f9",
                                                "sense_id": "b24c19de-967c-31a6-a17c-789a39711cac",
                                                "text": "Nay, if he be of a proud humour, […] he will not Bate an Ace of abſolute certainty, but however doubtful or improbable the thing is, coming f[r]om him it muſt go for an indiſputable truth."
                                            },
                                            {
                                                "example_id": "05c58de5-498f-407a-a6ae-ee37375b4781",
                                                "sense_id": "b24c19de-967c-31a6-a17c-789a39711cac",
                                                "text": "It is highly improbable that the drafter of the notice ever visualised the form that heavy vehicles of the future would take, but the comprehensive wording still covers modern types."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35427853-94ab-3279-90ec-0c1cb1f12158",
                                        "entry_id": "a6237cf3-f902-3a45-9535-4cdbe92ad493",
                                        "glosses": [
                                            "Not likely to happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb0fd73-812d-4b3a-8761-63dacdef6567",
                                                "sense_id": "35427853-94ab-3279-90ec-0c1cb1f12158",
                                                "text": "Due to the loss of power, it is improbable that we will begin on time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e355e40d-9963-441b-b8f2-14a4689dfbf8",
                        "source_entry_id": "85ba9d75-2ff3-3f2e-b690-8250de4ce08b",
                        "source_sense_id": "6b69969a-332c-35b7-9fe5-be2c9e6c3f6d",
                        "source_sense_description": "een geringe kans bezittend om waar te worden of te blijken",
                        "target_lang_word": "improbable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improbable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0778a89-2a3b-38e6-8aad-582e592feb1f",
                                        "entry_id": "f9b1e420-bdf4-3ea6-afe8-43b59a987f6d",
                                        "glosses": [
                                            "Qui n’a pas de probabilité ; qui n’est pas probable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f99f5442-c13d-4de2-ad2d-240ad3d60944",
                                                "sense_id": "f0778a89-2a3b-38e6-8aad-582e592feb1f",
                                                "text": "Lorsqu'on veut se figurer la cosmogenèse, c'est une aventure étrange, assez récente, pareille en somme à ce que serait une explosion hiroshimesque aperçue au ralenti : à partir d'un moment improbable, une avalanche de nébuleuses ignées, qui fuient."
                                            },
                                            {
                                                "example_id": "cebb7e46-d7bb-4b0f-a173-91e8d4e5d5c1",
                                                "sense_id": "f0778a89-2a3b-38e6-8aad-582e592feb1f",
                                                "text": "Un tel milieu est susceptible de protoner tout substrat organique et de favoriser des réactions improbables en chimie classique."
                                            },
                                            {
                                                "example_id": "7eefe38a-bc8e-41a3-a5f6-42d59317272b",
                                                "sense_id": "f0778a89-2a3b-38e6-8aad-582e592feb1f",
                                                "text": "Après 100 ans de recherche, aucun individu en mesure de démontrer […] des facultés extrasensorielles n’a été identifié. Pour cette seule raison, il est improbable que les facultés extra-sensorielles n’existent."
                                            },
                                            {
                                                "example_id": "d7ffd65f-27d8-464f-927c-600e216541da",
                                                "sense_id": "f0778a89-2a3b-38e6-8aad-582e592feb1f",
                                                "text": "Le regard ankylosé par trop d’impérities, je cherchais un improbable mais tant espéré soutien au loin, partout et nulle part, peut-être vers le ciel où s'était machinalement orientée ma tête; ce ciel où avaient établi leurs pénates, mon défunt père et mes regrettées sœurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                        "entry_id": "f9b1e420-bdf4-3ea6-afe8-43b59a987f6d",
                                        "glosses": [
                                            "Invraisemblable ; incroyable ; inattendu ; excentrique ; curieux ; insolite."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "note": "Il est souvent utilisé dans l'expression « endroit improbable »",
                                        "examples": [
                                            {
                                                "example_id": "d34eba1f-7299-4a21-9f4f-fbfc20382252",
                                                "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                                "text": "L’improbable signature de Jack Lew : incompatible avec le dollar ? Note : Référence à la signature atypique et illisible de Jack Lew, chef de cabinet de la Maison-Blanche, pressenti pour occuper les fonctions de Secrétaire du Trésor des États-Unis."
                                            },
                                            {
                                                "example_id": "35546fe2-1082-4121-bb29-a3299dcc1de5",
                                                "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                                "text": "Mais il se passa quelque chose auquel l'Anneau ne s'attendait pas : il fut ramassé par la créature la plus improbable qui soit, un Hobbit, Bilbon Sacquet, de la Comté."
                                            },
                                            {
                                                "example_id": "e84fc24d-5a4d-4670-ba77-130c63c51c05",
                                                "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                                "text": "L’improbable « accident » du MH370"
                                            },
                                            {
                                                "example_id": "35c011fa-18b6-4916-a7c6-e23f9ebb3881",
                                                "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                                "text": "Il arborait une improbable moustache en trait de crayon, et ça énervait Bilodeau autant que le reste."
                                            },
                                            {
                                                "example_id": "8195dd73-fd3b-4998-aa12-51f9d025c09a",
                                                "sense_id": "67913541-115b-34c3-9462-f26a63598a69",
                                                "text": "Pendant quelques secondes, ils restèrent debout à m'examiner : Stefania, sorte d'apparition en salopette violette, et Leonie dans un énorme manteau de fourrure, un improbable gin tonic à la main."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "improbable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6ef0f3-21d4-3fb5-8515-71e3a1f9993c",
                                        "entry_id": "85760628-1341-3c5b-9cc0-a34c36021d7c",
                                        "glosses": [
                                            "Ce qui peut probablement ne peut pas arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81bd31b4-ad7d-49ad-a57a-825c543d5220",
                                                "sense_id": "bb6ef0f3-21d4-3fb5-8515-71e3a1f9993c",
                                                "text": "On se fait une idée des discussions à ce sujet, avec Gontier ou d’autres ingénieurs, sur le probable et l’improbable. Je disais ceci, […], c’est que le passage d’un obus à un mètre de ma tête précisément, ou à cent mètres cinquante centimètres, ou à toute autre distance déterminée, était juste aussi improbable, ou aussi proba­ble, que le passage par ma tête exactement. En somme, concluais-je, il n’arrive que des coups parfaitement improbables, et il en arrive continuellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e84584-42b4-30a1-9253-d957d9c9f525",
                                        "entry_id": "85760628-1341-3c5b-9cc0-a34c36021d7c",
                                        "glosses": [
                                            "Invraisemblable."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e256641d-101f-413f-aa31-bdcf6b90039e",
                                                "sense_id": "44e84584-42b4-30a1-9253-d957d9c9f525",
                                                "text": "Je suis cependant loin d'approuver globalement son œuvre. Les événements y relèvent parfois de l’improbable. Elle joue en outre un peu trop des coïncidences."
                                            }
                                        ]
                                    }
                                ]
                            }
