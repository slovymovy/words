                    "frequency": "High",
                    "semantic_group_id": "rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a citizen, you are <w>entitled</w> to vote in the national election."
                        },
                        {
                            "text": "If you are <w>entitled</w> to a refund, you will receive it within ten days."
                        }
                    ],
                    "synonyms": [
                        "authorized",
                        "empowered"
                    ],
                    "common_phrases": [
