                    {
                        "sense_id": "5ba04827-7bc3-38c3-a60a-8220a32fe5af",
                        "entry_id": "95ffa5cd-007d-3801-b621-62d0567494b8",
                        "glosses": [
                            "Langage de programmation, surtout destiné au calcul numérique."
