                        "glosses": [
                            "Bewuchs mit unterschiedlichen Arten, zum Beispiel mit Fichten oder Kiefern, oder auch Nadel- und Laubbäumen"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
