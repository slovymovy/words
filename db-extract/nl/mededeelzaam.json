                                        "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                        "entry_id": "65bbd73c-b761-3734-8e2c-7b73cf3fd35d",
                                        "glosses": [
                                            "so, dass man leicht mit anderen über seine Gedanken und Gefühle spricht oder Auskunft gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d418227b-26c6-4a8e-a13e-5c475fe8d028",
                                                "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                                "text": "Die Nachbarin erwies sich als sehr mitteilsam, so dass ich nach zehn Minuten schon wusste, wann sie ihren Mann kennengelernt hat und dass sie fünf Kinder und drei Katzen hat."
                                            },
                                            {
                                                "example_id": "f12f5a49-ec8d-42a0-8102-2fbd13f59f55",
                                                "sense_id": "7c477d38-c1e9-3557-ad78-1d913cf671f0",
                                                "text": "„Dänemarks sonst mitteilsamer Hedtoft machte sich schon vor der Konferenz bei den Journalisten mit der Mitteilung unbeliebt, daß sie keinerlei Informationen über Verlauf und Ergebnis der Tagung erhalten würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
