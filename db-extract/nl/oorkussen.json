                        "sense_id": "baa85d0a-7ecf-3c50-bc9e-ea0a95474497",
                        "entry_id": "d55ed04d-5798-3495-add3-4594a1fab04c",
                        "glosses": [
                            "hoofdkussen waarop men zijn hoofd legt bij het slapen gaan"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
