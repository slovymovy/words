                    {
                        "sense_id": "d8529447-0390-3b53-a628-f16bcb9da60f",
                        "entry_id": "23d36d4c-5434-3554-816a-fc32cefecad6",
                        "glosses": [
                            "geschäftliche Tätigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "19919082-56ab-4339-bbbb-cec752242823",
                                "sense_id": "d8529447-0390-3b53-a628-f16bcb9da60f",
                                "text": "„No Biz Like Show Biz“",
                                "translation": "„Kein Geschäft wie das Showgeschäft“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a25e783e-ae49-4cbc-a51a-ae8ef7ee41ab",
                        "source_entry_id": "23d36d4c-5434-3554-816a-fc32cefecad6",
                        "source_sense_id": "d8529447-0390-3b53-a628-f16bcb9da60f",
                        "source_sense_description": "umgangssprachlich: geschäftliche Tätigkeit",
                        "target_lang_word": "Geschäft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschäft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "gewinnorientierte Unternehmung; kaufmännische Transaktion; Austausch von Gütern und Dienstleistungen"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d96587b-fa0e-4d43-b4b0-2a935ee672d9",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "„Um diese Geschäfte abzuwickeln, gründeten viele russische Geschäftsleute sogar eigene Firmen in der Türkei.“"
                                            },
                                            {
                                                "example_id": "1d38faa3-dca4-41d1-a5f3-43868480e564",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "Claas und Saxbert machen schon seit 20 Jahren miteinander Geschäfte."
                                            },
                                            {
                                                "example_id": "43ad53f9-22f0-46dc-bb8c-224c398fafc2",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "„Erst als die Influencer anfingen, die Produkte in die Kamera zu halten, ging das Geschäft richtig los.“"
                                            },
                                            {
                                                "example_id": "35f5c074-0d58-40cb-a1b6-abf1cc15ce1b",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "„Illegaler Holzschlag ist für mexikanische Banden und Kartelle ein lukratives Geschäft.“"
                                            },
                                            {
                                                "example_id": "97dbe7f2-f366-4567-bfdd-777b47bdf2ce",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "„Ihr kleines Geschäft ist bankrott gegangen, und sie hat eine Menge Schulden angehäuft.“"
                                            },
                                            {
                                                "example_id": "3f9300ed-a008-43af-9e4d-cabfab1697cd",
                                                "sense_id": "4e978de9-2bca-38e9-a9cd-0f95da3049e7",
                                                "text": "[Russischer Angriffskrieg auf die Ukraine:] „So steht der chinesische Konzern Sinno Electronics auf der US-Sanktionsliste, weil er mit einem russischen Rüstungsunternehmen Geschäfte gemacht haben soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cbc1c49-e286-3c5c-8afc-15817a4d2165",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "Gesamtmenge der Transaktionen im Handel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d34665d-a38a-4863-9078-a55ed127db8d",
                                                "sense_id": "1cbc1c49-e286-3c5c-8afc-15817a4d2165",
                                                "text": "Hoffentlich wird das Geschäft im Inland wieder besser."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3958297-e5dd-3d93-a2e3-8f0ea552fd6d",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "Gewinn oder Ertrag aus einer Transaktion"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d978c7e2-9490-4b53-bc88-b9ba1dd72267",
                                                "sense_id": "c3958297-e5dd-3d93-a2e3-8f0ea552fd6d",
                                                "text": "Ich habe auf dem Flohmarkt Bücher verkauft und ein gutes Geschäft gemacht."
                                            },
                                            {
                                                "example_id": "32aa4fdf-23f8-416c-889f-de25ac4c0941",
                                                "sense_id": "c3958297-e5dd-3d93-a2e3-8f0ea552fd6d",
                                                "text": "„Plötzlich machte er damit ein richtig gutes Geschäft, obwohl er eigentlich nur Einzelhändler war.“"
                                            },
                                            {
                                                "example_id": "1a9cc491-a6b5-415c-8ef6-006dd404d93f",
                                                "sense_id": "c3958297-e5dd-3d93-a2e3-8f0ea552fd6d",
                                                "text": "„Chinesische Reedereien und Fluggesellschaften wittern längst das große Geschäft.“"
                                            },
                                            {
                                                "example_id": "bf37a06b-84c4-4c10-815c-215b40ea21ba",
                                                "sense_id": "c3958297-e5dd-3d93-a2e3-8f0ea552fd6d",
                                                "text": "„Für Trump und seine Familie ist die Präsidentschaft ein lukratives Geschäft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "91c08fb4-47e4-3d25-a330-2606e0659a88",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "kaufmännische (meist private) Gesellschaft; gewerbliches Unternehmen"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4c4149-7232-4dc0-b6e0-5cfb777b8216",
                                                "sense_id": "91c08fb4-47e4-3d25-a330-2606e0659a88",
                                                "text": "Altmund hat das Geschäft seines Onkel geerbt."
                                            },
                                            {
                                                "example_id": "8449fdd2-3b38-4948-9739-01b561a5e778",
                                                "sense_id": "91c08fb4-47e4-3d25-a330-2606e0659a88",
                                                "text": "„Reginald Black hatte kein Geschäft und keine Kunstgalerie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "01c19866-d2c1-3711-b72a-bd7d8f46749f",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "Räumlichkeiten, in denen Waren zum Verkauf angeboten werden"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b202db30-6282-4e77-bc98-9eeba48ca1b6",
                                                "sense_id": "01c19866-d2c1-3711-b72a-bd7d8f46749f",
                                                "text": "Den Hund darf man nicht mit in das Geschäft nehmen."
                                            },
                                            {
                                                "example_id": "0d4d16d8-5ee8-4979-a957-f4ff2dc1f7c2",
                                                "sense_id": "01c19866-d2c1-3711-b72a-bd7d8f46749f",
                                                "text": "„Erst später gingen über das Warenangebot der Geschäfte die überregionalen Bezeichnungen allmählich in den Sprachgebrauch der Käufer aller Schichten und Sprachlandschaften über.“"
                                            },
                                            {
                                                "example_id": "4001499b-ab4c-4acf-83eb-6138cba91f6e",
                                                "sense_id": "01c19866-d2c1-3711-b72a-bd7d8f46749f",
                                                "text": "„Elisabeth besaß eines der führenden Geschäfte für Anglerzubehör in der Pariser Rue de Châteaudun, heute eine der großen Einkaufsstraßen in der französischen Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "3aa17a8e-b4a0-4bda-b158-32f12b1ffb3d",
                                                "sense_id": "01c19866-d2c1-3711-b72a-bd7d8f46749f",
                                                "text": "„Ihnen gehörte eine Boutique im Ort, und sie waren gerade aus Teneriffa zurückgekommen, wo sie oft am Anfang des Winters Urlaub machten, bevor im Geschäft der Weihnachtsrummel begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c28f2b9f-ee8a-36c0-b98d-fa4d7942dfb3",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "zu erledigende Angelegenheit, Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e11b1f9-6251-4554-9654-9e1faf2d9d1b",
                                                "sense_id": "c28f2b9f-ee8a-36c0-b98d-fa4d7942dfb3",
                                                "text": "Ich habe noch einige Geschäfte zu erledigen, bevor ich in den Urlaub kann."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "ee7590ec-a206-3f87-885c-2290dbd02848",
                                        "entry_id": "a46b6b45-9672-3941-949c-f3098cbe669d",
                                        "glosses": [
                                            "Ausscheidung von Fäkalien"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb63c8f-8246-4269-a2a1-d54a88d324a5",
                                                "sense_id": "ee7590ec-a206-3f87-885c-2290dbd02848",
                                                "text": "Es ist nicht erlaubt, sein Geschäft im Park zu verrichten."
                                            },
                                            {
                                                "example_id": "dec726c3-557e-4138-a008-a987b1b17477",
                                                "sense_id": "ee7590ec-a206-3f87-885c-2290dbd02848",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
