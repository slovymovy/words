                "senses": [
                    {
                        "sense_id": "60d91fec-3aca-38e4-be88-f6def56b85bd",
                        "entry_id": "d8da0f66-8330-3632-be85-1b2c661d378c",
                        "glosses": [
                            "Annulation d’un acte juridique entaché d’un vice radical."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "ec3bd98f-39f9-4599-b959-3d30224c15a2",
                                "sense_id": "60d91fec-3aca-38e4-be88-f6def56b85bd",
                                "text": "Beaumanoir dit encore que l'acte dommageable qu'a passé le mineur pourra être rescindé, […]. Cette rescision devra être demandée dans l'an et le jour de la majorité."
                            },
                            {
                                "example_id": "e3e7b1bc-a166-4a69-ae5a-36a83803abc0",
                                "sense_id": "60d91fec-3aca-38e4-be88-f6def56b85bd",
                                "text": "Dans tous les cas où l'action en nullité ou en rescision d'une convention n'est pas limitée à un moindre temps par une loi particulière, cette action dure cinq ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dcdbdec-5f68-4fd6-9ec3-1cb6f1e2f2a2",
                        "source_entry_id": "d8da0f66-8330-3632-be85-1b2c661d378c",
                        "source_sense_id": "60d91fec-3aca-38e4-be88-f6def56b85bd",
                        "target_lang_word": "Rücktritt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rücktritt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a28ef6-58aa-325f-942c-069529b6deec",
                                        "entry_id": "92a717e8-2c65-3be1-a975-f78510b161f8",
                                        "glosses": [
                                            "Ausscheiden aus einem Amt oder Dienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c40a914-58dc-43e6-a3d7-5e3ee8c66d99",
                                                "sense_id": "c8a28ef6-58aa-325f-942c-069529b6deec",
                                                "text": "Mir fiel der Rücktritt vom Amt schwer."
                                            },
                                            {
                                                "example_id": "c4a77f29-4bac-4d52-b8e0-8691b20ae38e",
                                                "sense_id": "c8a28ef6-58aa-325f-942c-069529b6deec",
                                                "text": "„Von Rücktritt will er nichts wissen.“"
                                            },
                                            {
                                                "example_id": "e9139c0d-6172-4b14-b2a6-cdf5a3fb39af",
                                                "sense_id": "c8a28ef6-58aa-325f-942c-069529b6deec",
                                                "text": "„Selbstverständlich wurde im Januar 2013 der Rücktritt vom Rücktritt bekannt gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ba770bf-741b-3bee-88c2-5ddadaef954b",
                                        "entry_id": "92a717e8-2c65-3be1-a975-f78510b161f8",
                                        "glosses": [
                                            "Erklärung, dass eine Vereinbarung nicht wahrgenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd39d6da-1d18-4b2c-86e4-1bdb9f061552",
                                                "sense_id": "7ba770bf-741b-3bee-88c2-5ddadaef954b",
                                                "text": "Der Rücktritt von dem geplanten Kreditvertrag war notwendig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3d26bf9b-30a9-3590-9c4c-a75fd0fb908b",
                                        "entry_id": "92a717e8-2c65-3be1-a975-f78510b161f8",
                                        "glosses": [
                                            "Bremse (mit den Pedalen) beim Fahrrad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c679c6-53c6-42b1-b908-358d7c5e40ef",
                                                "sense_id": "3d26bf9b-30a9-3590-9c4c-a75fd0fb908b",
                                                "text": "Nicht alle Fahrräder haben einen Rücktritt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
