                "senses": [
                    {
                        "sense_id": "55f10df1-a80e-3372-9342-bebd3872ab6e",
                        "entry_id": "2464b26d-5060-3659-846d-226555a6135c",
                        "glosses": [
                            "taki, który nie uwzględnia nawiązania połączenia między urządzeniami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bae9798-82c2-4245-a290-2fa9bb8d9545",
                                "sense_id": "55f10df1-a80e-3372-9342-bebd3872ab6e",
                                "text": "Protokoły bezpołączeniowe — na przykład UDP i ICMP — przesyłają zawsze pojedyncze pakiety danych, nie troszcząc się o wcześniejsze nawiązanie połączenia, układanie przesyłanych pakietów w logiczny ciąg i sprawdzanie, czy wysłane dane zostały w ogóle odebrane."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
