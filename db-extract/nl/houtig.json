                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a07fc2bb-2d09-3272-8031-22ca8a20d4a5",
                                        "entry_id": "03ad2904-474a-360a-bf91-d7a82a9654be",
                                        "glosses": [
                                            "Belonging to the woods; sylvan."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
