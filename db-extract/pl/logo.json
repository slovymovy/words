                                                "example_id": "ecfee743-97e4-4594-9929-579e1a7cdd4f",
                                                "sense_id": "51f60c41-dcf9-3643-85cf-ecc3ef566424",
                                                "text": "La Sua Carta di credito è accettata in milioni di esercizi convenzionati in Italia e nel mondo. Il logo riportato sulla sua carta ne indica il circuito di accettazione."
                                            }
