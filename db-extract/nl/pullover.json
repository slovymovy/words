                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4645eb3-6a98-3a24-b0df-b6c8e184d642",
                                        "entry_id": "32902991-ceaa-36cc-8d8a-e03517ea3b48",
                                        "glosses": [
                                            "Vêtement couvrant le buste, des épaules à la ceinture et les bras jusqu’aux poignets."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9df9ce-8e4b-44f1-80ea-23dc7759da7d",
                                                "sense_id": "a4645eb3-6a98-3a24-b0df-b6c8e184d642",
                                                "text": "On y respirait une atmosphère frelatée de barrière, qu’un petit groupe d’individus en pull-over et en casquettes à carreaux s’employaient de leur mieux à rendre mystérieuse."
                                            },
                                            {
                                                "example_id": "1468d4f8-b18c-45b2-a8cf-b49b39bd65bf",
                                                "sense_id": "a4645eb3-6a98-3a24-b0df-b6c8e184d642",
                                                "text": "Quel sociologue appréciera le ferme flou des dernières démocraties qui auront lutté contre l’angoisse ambiante par le ponceau d’un spencer ou le jacquard d’un pull-over ?"
                                            },
                                            {
                                                "example_id": "cbbeae9e-b2a5-4a69-b65f-170c7be981f0",
                                                "sense_id": "a4645eb3-6a98-3a24-b0df-b6c8e184d642",
                                                "text": "Les élèves portent des culottes de golf – des culottes à chier dedans, ricane la rue Sainte-Anne –, des pull-overs faits à la machine avec dessus des grands dessins compliqués pour bien montrer que c’est acheté avec des sous, pas tricoté à la maison par une mère pauvresse en berçant le petit dernier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
