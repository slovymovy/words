                    ]
                },
                {
                    "sense_id": "45d91118-cd75-3ea6-95f5-ffe1d66aaeae",
                    "sense_definition": "Homme coquet, prétentieux et excessivement soucieux de son élégance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune <w>muguet</w> passait des heures devant sa glace avant de rejoindre les salons."
                        },
                        {
                            "text": "Tous les <w>muguets</w> de la cour rivalisaient d'habits précieux pour s'attirer les faveurs des dames."
