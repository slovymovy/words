                {
                    "sense_id": "248cedee-f28b-38a2-9dc4-a7733c02914b",
                    "sense_definition": "człowiek postępujący nieuczciwie, często w sposób przebiegły lub złośliwy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przestępca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>łotr</w> znowu nas oszukał, obiecując zyski, których nigdy nie zamierzał wypłacić.",
                            "target_lang_translations": {
                                "ru": "Этот <w>мошенник</w> снова нас обманул, обещая прибыль, которую никогда не собирался выплачивать."
                            }
                        },
                        {
                            "text": "Nie ufaj mu, to patentowany <w>łotr</w>, który dba wyłącznie o własne interesy kosztem innych.",
                            "target_lang_translations": {
                                "ru": "Не верь ему, это патентованный <w>пройдоха</w>, который заботится исключительно о собственных интересах за счет других."
                            }
                        }
