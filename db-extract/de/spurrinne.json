                "senses": [
                    {
                        "sense_id": "464234a7-a948-3b77-aa93-fe5fc2e64bf7",
                        "entry_id": "eebbb571-60c7-3d7c-965c-fe1abf91fa9e",
                        "glosses": [
                            "durch häufiges Befahren entstandene, in Fahrtrichtung verlaufende Vertiefung in der Fahrbahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887ed02e-81c1-42fb-87af-672b009f9b17",
                                "sense_id": "464234a7-a948-3b77-aa93-fe5fc2e64bf7",
                                "text": "„Tauwetter hat seit einiger Zeit die Winterkälte abgelöst: Frostaufbrüche, tiefe Schlaglöcher, Spurrinnen überall, vom Eiswasser gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c717d215-aa56-432e-9422-642ff6a994b0",
                        "source_entry_id": "eebbb571-60c7-3d7c-965c-fe1abf91fa9e",
                        "source_sense_id": "464234a7-a948-3b77-aa93-fe5fc2e64bf7",
                        "source_sense_description": "durch häufiges Befahren entstandene, in Fahrtrichtung verlaufende Vertiefung in der Fahrbahn",
                        "target_lang_word": "колея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "колея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aee8b097-50b3-31ee-b2b4-e1771473bb40",
                                        "entry_id": "6c1b9530-cad8-3d4b-b2d7-098604f9df79",
                                        "glosses": [
                                            "углублённый след от колеса на грунте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49b41bf4-1395-4776-a5df-b81ecb774dda",
                                                "sense_id": "aee8b097-50b3-31ee-b2b4-e1771473bb40",
                                                "text": "Старая, чёрная и изрытая колеями дорога тянулась пред ним бесконечною нитью, усаженная своими ветлами; направо ― голое место, давным-давно сжатые нивы; налево ― кусты, а далее за ними лесок."
                                            },
                                            {
                                                "example_id": "b06ed128-fc22-4d8c-9a8b-0ecb43577e7b",
                                                "sense_id": "aee8b097-50b3-31ee-b2b4-e1771473bb40",
                                                "text": "Сначала сбитая катышками пыль превратилась в жидкую грязь, которую месили колёса, толчки стали меньше, и по глинистым колеям потекли мутные ручьи."
                                            },
                                            {
                                                "example_id": "bc6af515-dca2-4df8-8d24-14eb09e2889d",
                                                "sense_id": "aee8b097-50b3-31ee-b2b4-e1771473bb40",
                                                "text": "Дышловые лошади жались от колей на дышло, но ловкий ямщик, боком сидевший на козлах, держал дышлом по колее, так что колёса бежали по гладкому."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2abfdd96-ca00-3d46-bdbc-a0b61ea5e986",
                                        "entry_id": "6c1b9530-cad8-3d4b-b2d7-098604f9df79",
                                        "glosses": [
                                            "техн. расстояние между колёсами каждой оси или между центральными линиями гусениц транспортного средства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667aeb5b-61d7-4aa6-9b30-2b8f6c73fc4d",
                                                "sense_id": "2abfdd96-ca00-3d46-bdbc-a0b61ea5e986",
                                                "text": "Прицеп: двухосный, с длинной базой, низким центром масс, широкой колеёй, малой парусностью и длинным дышлом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd9644c2-e454-3f22-8417-2ef43222da07",
                                        "entry_id": "6c1b9530-cad8-3d4b-b2d7-098604f9df79",
                                        "glosses": [
                                            "ж.-д. железнодорожный путь, образуемый парой параллельно проложенных рельсов; в более узком значении — расстояние между внутренними гранями рельсов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdb5e11-f5c5-482d-8598-76888d3955d0",
                                                "sense_id": "fd9644c2-e454-3f22-8417-2ef43222da07",
                                                "text": "Точно так же в настоящее время уже действует комиссия, которая производит пробу движения наших вагонов, наших локомотивов по финляндской колее, и по первым опытам комиссии надо думать, что габарит наших вагонов подойдет к финляндской колее и сквозное движение окажется возможным и будет осуществлено."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41564694-e7db-3adb-898d-4c2c63ca131b",
                                        "entry_id": "6c1b9530-cad8-3d4b-b2d7-098604f9df79",
                                        "glosses": [
                                            "перен. привычный ход жизни, привычное ведение дел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1051487e-393c-451c-899a-ae1da8c8505d",
                                                "sense_id": "41564694-e7db-3adb-898d-4c2c63ca131b",
                                                "text": "Отношения Россия — НАТО возвращаются в свою колею, заявил лорд Робертсон."
                                            }
                                        ]
                                    }
                                ]
                            },
