                "senses": [
                    {
                        "sense_id": "bbf48108-2c16-31ea-8fad-ef67f88e6689",
                        "entry_id": "58794ea1-9854-33d6-9f70-82b7c82458dd",
                        "glosses": [
                            "Cellui qui ne ressent peu ou pas d’attirance sexuelle."
                        ],
                        "tags": [
                            "Variations diaéthiques",
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "a6808770-035a-4431-bf96-fb8293d55cb2",
                                "sense_id": "bbf48108-2c16-31ea-8fad-ef67f88e6689",
                                "text": "A l'inverse, al y a des personnes aromantiques (aro) mais non-asexuelles (z-sexuelles, comme disent certans asexuæls :) ) qui ont un désir sexuel pour d'autres personnes (et peuvent avoir toute orientation sexuelle) mais ne ressentent pas le désir de s'engager dans une relation romantique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41501975-6592-429e-9116-db56498b91c7",
                        "source_entry_id": "58794ea1-9854-33d6-9f70-82b7c82458dd",
                        "source_sense_id": "bbf48108-2c16-31ea-8fad-ef67f88e6689",
                        "target_lang_word": "asexual",
                        "target_lang_code": "en",
