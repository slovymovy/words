                "senses": [
                    {
                        "sense_id": "15d60de2-e652-300a-be7b-1cc66710357d",
                        "entry_id": "95e84459-fac6-3cd1-8782-409344e41896",
                        "glosses": [
                            "die Gesamtheit der Staatsangehörigen eines Staates"
                        ],
                        "tags": [
                            "Völkerrecht",
                            "Verfassungsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "89164052-b470-4943-9d4f-9303512c4a6b",
                                "sense_id": "15d60de2-e652-300a-be7b-1cc66710357d",
                                "text": "„Der Umfang der Rechte des Staatsvolks kann sehr unterschiedlich sein: in freiheitlichen Demokratien ist er weit, in Diktaturen kann er auf ein Nichts zusammenschrumpfen.“"
                            },
                            {
                                "example_id": "a765f969-27c2-41eb-9560-b681ec242112",
                                "sense_id": "15d60de2-e652-300a-be7b-1cc66710357d",
                                "text": "„Zehn Dekrete, erlassen zwischen dem 8. Mai und der ersten Sitzung der Provisorischen Nationalversammlung, regelten die Rechtsverhältnisse zwischen dem Staatsvolk und der deutschen und magyarischen Minderheit.“"
                            },
                            {
                                "example_id": "9d392374-9af8-4413-95ed-7c97fb70114b",
                                "sense_id": "15d60de2-e652-300a-be7b-1cc66710357d",
                                "text": "„Es gab weder eine Staatsgewalt noch ein Staatsgebiet noch ein Staatsvolk in der völkerrechtlich und staatsrechtlich gebotenen Eindeutigkeit der Definition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
