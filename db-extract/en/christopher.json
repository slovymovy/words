                                ]
                            },
                            {
                                "target_word": "Christoph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                        "entry_id": "28763b78-20c6-391f-b184-a0f35ee870e4",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2cd0096-a915-4c66-971c-d0497121bc92",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Frau Christoph ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "d4a55426-cb73-4724-8801-219e8aef94cd",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Herr Christoph wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d6478c69-8d1f-4640-9683-a855d0b85be6",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Die Christophs fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "d5e49cc2-27b1-4960-acbc-36e58e4f95dd",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Der Christoph trägt nie die Pullover, die die Christoph ihm strickt."
                                            },
                                            {
                                                "example_id": "40fe5eee-240e-4ef9-afe3-0d9786411a0f",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Christoph kommt, geht der Herr Christoph.“"
                                            },
                                            {
                                                "example_id": "34ceeede-849a-41cb-a90d-7298a67c67c7",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Christoph kommt und geht."
                                            },
                                            {
                                                "example_id": "4f8e9846-a359-4244-bd8e-6f3a1c6e96d8",
                                                "sense_id": "ae5fe4ba-0a27-3a49-833d-331d7728a699",
                                                "text": "Christophs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
