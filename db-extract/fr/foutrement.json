                        "examples": [
                            {
                                "example_id": "1e005cb2-aa22-4e2b-acc0-e20dba96c043",
                                "sense_id": "555ee66e-665f-385a-bcb1-b2d73795024a",
                                "text": "La veste était foutrement bien faite. Angelo se parla un lange plus châtié à mesure que le velours lui mettait de la tiédeur aux entournures."
                            },
                            {
                                "example_id": "b9c43e4d-ba25-463b-8869-0ba6e8133168",
                                "sense_id": "555ee66e-665f-385a-bcb1-b2d73795024a",
                                "text": "C’est foutrement compliqué ton histoire !"
                            },
                            {
                                "example_id": "bd127f45-2c51-40a8-a99b-a9744728799c",
                                "sense_id": "555ee66e-665f-385a-bcb1-b2d73795024a",
                                "text": "Révélée par M6, cette démarche foutrement administrative lui permet dorénavant d’utiliser « sa » marque pour des activités telles que « la publicité, les affaires commerciales, la comptabilité, les services juridiques »."
                            },
                            {
                                "example_id": "3d344ca8-259a-4597-aea6-b6ae97257f56",
                                "sense_id": "555ee66e-665f-385a-bcb1-b2d73795024a",
                                "text": "Allez trouver ce type et dites-lui que je suis foutrement désolé, et que j’aimerais bien qu’il vienne prendre un verre avec moi, pour qu’on n’en parle plus."
                            }
                        ]
                    }
                ],
