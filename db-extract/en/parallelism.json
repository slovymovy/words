    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                "word": "parallelism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b5f90e79-6aa3-41da-b4a4-19a48cc52648",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "tags": [
                            "plural"
                        ],
                        "form": "parallelisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9bd8252-7d2b-3de5-b569-bfb8cd1515ed",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "The state or condition of being parallel; agreement in direction, tendency, or character."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8cff20be-683b-3518-b2f4-5f4bfb3bf5fe",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "The state of being in agreement or similarity; resemblance, correspondence, analogy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "11864759-9f09-444d-af1f-d88889037f17",
                                "sense_id": "8cff20be-683b-3518-b2f4-5f4bfb3bf5fe",
                                "text": "Plutarch (c. AD 46-120), in his Lives of the Noble Grecians and Romans, traced a parallelism between the most eminent men of the two countries."
                            }
                        ]
                    },
                    {
                        "sense_id": "30cb0dbc-a6ca-35f5-826a-102420283015",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "A parallel position; the relation of parallels."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5552594a-4d9f-37cd-bcbe-76e441eaaf87",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "The juxtaposition of two or more identical or equivalent syntactic constructions, especially those expressing the same sentiment with slight modifications, introduced for rhetorical effect."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6e82fc6a-4fbd-3ca3-8026-5ce5f5719568",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "The doctrine that matter and mind do not causally interact but that physiological events in the brain or body nonetheless occur simultaneously with matching events in the mind."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c5c56083-71cf-302c-9c67-2fb17a508036",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "In antitrust law, the practice of competitors of raising prices by roughly the same amount at roughly the same time, without engaging in a formal agreement to do so."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3098ab8-95d5-39a8-9ea8-2600f436dce1",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "Similarity of features between two species resulting from their having taken similar evolutionary paths following their initial divergence from a common ancestor."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "92ebc29a-cfb3-3f5a-a546-3339f5f20e38",
                        "entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "glosses": [
                            "The use of parallel methods in hardware or software, so that several tasks can be performed at the same time."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "296ec358-67ae-494b-aaf2-3acd792922b1",
                        "source_entry_id": "44f67507-c706-3fa8-a53f-e6248be45531",
                        "source_sense_description": "state or condition of being parallel",
                        "target_lang_word": "parallélisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parallélisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9531b366-68f1-3e6d-b974-e8a42dc101c7",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "État de ce qui est parallèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "106919cd-3950-4230-8abd-c93f337a5733",
                                                "sense_id": "9531b366-68f1-3e6d-b974-e8a42dc101c7",
                                                "text": "Dans la cour de la prison de la Santé, un aide-bourreau, en salopette, vérifie au niveau à bulle d’air le parallélisme des bois de justice."
                                            },
                                            {
                                                "example_id": "8b5aae02-94ea-4d5a-b12f-15ac6398a06b",
                                                "sense_id": "9531b366-68f1-3e6d-b974-e8a42dc101c7",
                                                "text": "L’allée centrale, renforcée dans les airs par le long parallélisme du tuyau de poêle, servait de frontière aux plus jeunes espoirs des deux nations, inégalement représentées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ee33813-1f89-3f18-9544-b567ad550d88",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "État de ce que l’on peut comparer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0765ce19-f600-402f-bcc7-f2e4fdbcbbe2",
                                                "sense_id": "0ee33813-1f89-3f18-9544-b567ad550d88",
                                                "text": "C'est une différence dans le degré d'ionisabilité qui permet d'expliquer un fait qui semble tout d'abord en opposition avec le parallélisme généralement constaté entre la non-saturation de l'auxochrome et son effet sur la coloration : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7155e180-cfdd-36cc-9d1d-867bb7c8f2a9",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "Propriété que l’axe de la Terre a de rester sensiblement parallèle à lui-même, dans tous les points de la courbe que la Terre décrit annuellement autour du soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c00c9be-90f5-4f9a-b1f7-3a98feceda75",
                                                "sense_id": "7155e180-cfdd-36cc-9d1d-867bb7c8f2a9",
                                                "text": "Le parallélisme de l’axe de la Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd5721f8-5384-3388-8c66-682b3e12514a",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "Angle nul ou légèrement aigu que font les deux roues d’un même essieu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea72d140-bb7c-314a-a277-7711ef399c08",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "Rapprochement de deux constructions identiques, suivant le schéma AB/AB afin de produire une impression d'équivalence."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb84eb04-3f1f-4d1a-b424-24a92fc2ec8b",
                                                "sense_id": "ea72d140-bb7c-314a-a277-7711ef399c08",
                                                "text": "Voici un exemple de parallélisme : On se levait (A) trop tard (B), on se couchait (A) trop tôt (B)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ca51dc-458e-3245-985a-fa9ea00b7163",
                                        "entry_id": "6858daa3-562c-387d-9187-7aa61b3d6460",
                                        "glosses": [
                                            "Se dit d'objets géométriques unidimensionnels (segment, demi-droite, droite) situés de telle façon qu'ils sont équidistants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32931a1c-6054-4a8d-a128-b2024c78e7c4",
                                                "sense_id": "82ca51dc-458e-3245-985a-fa9ea00b7163",
                                                "text": "La relation de parallélisme entre les droites de l’espace géométrique est une relation réflexive, symétrique et transitive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
