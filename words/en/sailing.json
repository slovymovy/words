                            "target_lang_translations": {
                                "ru": "Гавань была полна <w>парусных</w> лодок, готовящихся к гонке.",
                                "tr": "Liman, yarışa hazırlanan <w>yelkenli</w> teknelerle doluydu.",
                                "zh": "港口里停满了准备参加比赛的<w>帆船</w>。"
                            }
