                "senses": [
                    {
                        "sense_id": "5f1e1028-e21c-3ab6-86fc-b9f281380a0b",
                        "entry_id": "4e0044e3-95fb-39d8-bfb7-343c3482f1f1",
                        "glosses": [
                            "home inventory, appliances"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "c7a8218c-96b2-4bdc-9caa-ee60ccad2f7a",
                                "sense_id": "5f1e1028-e21c-3ab6-86fc-b9f281380a0b",
                                "text": "― Побилы коняку, сдох!.. Все потеряв, що на возу, пропало. Ногами шли. Шлею зризав и ту покинув; самовар у бабы и вся худоба дома пропала, а я, як перед истинным,― и заревел стоеросовым голосом:― не жали-ю!.. нэхай, нэ жалко, нэхай!.. бо це наша, хрестьянска власть. Без нэи мы дохлятина, як та падаль пид тыном, воняемо…― и заплакал скупыми собачьими слезами."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3669ed3-3146-31cd-8440-96b4dc89e538",
                        "entry_id": "4e0044e3-95fb-39d8-bfb7-343c3482f1f1",
