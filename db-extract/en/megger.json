                        "examples": [
                            {
                                "example_id": "9f18391b-4be5-4052-b570-bdae8f8fb23a",
                                "sense_id": "07e4fd89-fd0f-313a-af6a-1aebfa7e5458",
                                "text": "Backers, confronted with the heavy demands of directors, point out that the megger is doing more of a job than the producer […]"
                            },
                            {
                                "example_id": "2deb9523-b572-407e-8358-cde740b21765",
                                "sense_id": "07e4fd89-fd0f-313a-af6a-1aebfa7e5458",
                                "text": "The megger, as the director is known to the motion picture industry's trade journals, has to be a sort of reservoir of knowledge, know-how, residual bits of information on all subjects and techniques."
