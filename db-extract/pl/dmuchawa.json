                "translations": [
                    {
                        "translation_id": "7036240c-efc9-4c65-a8bb-af356f4c98eb",
                        "source_entry_id": "39f4a0d7-7f08-3313-9c60-89efa261e374",
                        "source_sense_id": "b69987bf-ee2b-3249-b923-c59a0f83e912",
                        "target_lang_word": "blower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "699ad5d3-8d21-34ea-8b2e-80464255f0c6",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "A person who blows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e161eba6-e59b-3876-907b-ab3269c2a38b",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "A fissure from which firedamp issues, often in quantity for many years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c372814-73dc-44fe-a466-d5484490990f",
                                                "sense_id": "e161eba6-e59b-3876-907b-ab3269c2a38b",
                                                "text": "The great sources of fire-damp in coal mines are blowers or fissures from which currents of this inflammable gas issue in considerable quantities and for a long series of years"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f32d45-644f-35b1-b445-ae1efc55f67f",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "Any device that blows; often, especially, a furnace component or a supercharger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd7dcc58-d3d0-4d9a-ac79-8c71f3f9fbc4",
                                                "sense_id": "61f32d45-644f-35b1-b445-ae1efc55f67f",
                                                "text": "The locomotive […] was quietly \"blowing off\" on one Ross \"pop\" valve, whilst the rhythmic clanging of the fireman's shovel, the black smoke pouring from her chimney, and the harsh sound of the blower told of the proximity of departure time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67f3faa-8a1a-33b8-b243-0bda463eb73b",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "Any device that blows; often, especially, a furnace component or a supercharger.",
                                            "A ducted fan, usually part of a heating, ventilation, and/or air conditioning system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d4ffc76-0cc9-3e70-b1a7-0879119bc2d6",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "Telephone."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95038da6-f812-4bc1-bbf4-9f558585e12f",
                                                "sense_id": "2d4ffc76-0cc9-3e70-b1a7-0879119bc2d6",
                                                "text": "Get on the blower and call headquarters right away!"
                                            },
                                            {
                                                "example_id": "ea9226ce-0232-42b9-9ca5-d327c835079d",
                                                "sense_id": "2d4ffc76-0cc9-3e70-b1a7-0879119bc2d6",
                                                "text": "I got off the blower oozing no confidence at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f356bdd-768b-38c2-9cfb-a7acbb7f772c",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "Telephone.",
                                            "A telephone service providing betting odds and commentary, relayed to customers in a bookmaker's shop via loudspeaker."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK",
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8ae5890-866f-3f28-896f-037dde233e3d",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "A braggart, or loud talker."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f694b958-695e-4307-9de9-503756980cad",
                                                "sense_id": "f8ae5890-866f-3f28-896f-037dde233e3d",
                                                "text": "There hangs something majestic about a man who has borne his part in battles, especially if he is very quiet regarding it when you desire him to unbosom. I am continually lost at the absence of blowing and blowers among these old-young American militaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "214d5c1a-cbc1-3eb5-abe4-8237c6dcbbe8",
                                        "entry_id": "1cfd15c1-ff78-378a-8844-a51281d143c4",
                                        "glosses": [
                                            "The whale; so called from its habit of spouting up a column of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be886baf-9a0b-3b1d-a464-6bb8ff35a0ee",
