                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70195dd4-6a0b-3994-bd55-7376cdf8d8f5",
                                        "entry_id": "488844fc-1c9d-3a90-be85-6892af090903",
                                        "glosses": [
                                            "Hauptstadt des US-Bundesstaats New York"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074b180e-d28b-4e17-be7f-c1476d0e6988",
                                                "sense_id": "70195dd4-6a0b-3994-bd55-7376cdf8d8f5",
                                                "text": "„Am dritten Tag fand man Slater besinnungslos in einem hohlen Baum, und man brachte ihn in das nächste Gefängnis, wo er von Nervenärzten aus Albany untersucht wurde, sobald er wieder bei Bewusstsein war.“"
                                            },
                                            {
                                                "example_id": "763ef34a-1e39-4c7c-bb5a-1a5a2cc09ced",
                                                "sense_id": "70195dd4-6a0b-3994-bd55-7376cdf8d8f5",
                                                "text": "„Innerhalb einer Woche hatte ich mich genügend erholt, um aus Albany einen Hilfstrupp zu holen, damit das Anwesen der Martenses und der gesamte Gipfel des Tempest Mountain mit Dynamit gesprengt, alle entdeckten Hügelgräben zugeschüttet und einige besonders überdüngte Bäume gefällt wurden, deren bloße Existenz die Vernunft beleidigte.“"
                                            },
                                            {
                                                "example_id": "a00363da-ad2c-48ed-bd9b-d60ac8737e72",
                                                "sense_id": "70195dd4-6a0b-3994-bd55-7376cdf8d8f5",
                                                "text": "„Er rief von einer Hotelsuite in Albany aus an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b97f5849-ba7a-3ef1-b89a-3eb42b8e1dd3",
                                        "entry_id": "488844fc-1c9d-3a90-be85-6892af090903",
                                        "glosses": [
                                            "Verwaltungssitz von Dougherty County in Georgia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbb625a-e04c-4a2b-b84f-d9c2e2f1dbaa",
                                                "sense_id": "b97f5849-ba7a-3ef1-b89a-3eb42b8e1dd3",
                                                "text": "Albany liegt ungefähr mittig zwischen Columbus und Tallahassee."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c008bec-3e58-392a-8a07-b4c332d147fe",
                                        "entry_id": "488844fc-1c9d-3a90-be85-6892af090903",
                                        "glosses": [
                                            "Verwaltungssitz von Linn County und elftgrößte Stadt in Oregon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac40982a-c70c-473d-bc31-5fd9d88cdce1",
                                                "sense_id": "2c008bec-3e58-392a-8a07-b4c332d147fe",
                                                "text": "Albany liegt südlich von Salem, der Hauptstadt von Oregon."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "106b1313-1088-3721-becf-caec7021b4f1",
                                        "entry_id": "488844fc-1c9d-3a90-be85-6892af090903",
                                        "glosses": [
                                            "Küstenstadt in Westaustralien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b00a69-6934-4dae-a2b5-1c57a5ad1c1b",
                                                "sense_id": "106b1313-1088-3721-becf-caec7021b4f1",
                                                "text": "Albany liegt ungefähr 400 km südöstlich von Perth, der Hauptstadt von Westaustralien."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
