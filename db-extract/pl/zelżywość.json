                    {
                        "translation_id": "9fa7d8d6-b13f-44af-ba5f-9a42cbca5a24",
                        "source_entry_id": "37fc4d23-ac64-3404-b1f1-12669d323573",
                        "source_sense_id": "e9d68a5c-99e1-37bf-ae30-b3757089d918",
                        "target_lang_word": "Schmach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                        "entry_id": "b27dada4-5844-353a-b08c-63b69df19d91",
                                        "glosses": [
                                            "erhebliche Beeinträchtigung des Ansehens, durch andere beigebracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9a31b5-6a23-4861-8af2-46bae322cbaa",
                                                "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                                "text": "Was für eine Schmach!"
                                            },
                                            {
                                                "example_id": "4b34f977-89ce-47ec-8b53-32e626d8d6e4",
                                                "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                                "text": "Der Libanon-Feldzug wurde zu einer Schmach für die bis anhin unbezwungene israelische Armee."
                                            },
                                            {
                                                "example_id": "5c46be39-8c90-4aee-86ef-890012a125ef",
                                                "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                                "text": "„Er will die Schmach nicht hinnehmen.“"
                                            },
                                            {
                                                "example_id": "ea01f79b-0a66-449e-adf0-0841e31b8038",
                                                "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                                "text": "„Natürlich war es eine Demütigung, von einer Sechzehnjährigen aufs Kreuz gelegt zu werden, doch angesichts des Blutbads, das seine ehemaligen Kollegen da draußen veranstalteten, war die Schmach verkraftbar.“"
                                            },
                                            {
                                                "example_id": "aba3b5fa-66d3-4d74-aca8-a7cdaec81111",
                                                "sense_id": "95bf33ba-32af-3af4-aa2d-af5baf4d0630",
                                                "text": "„Günther und Klaus kommen vorübergehend gar ins Waisenhaus, wo man ihnen zum Entsetzen von Günther gleich nach der Ankunft eine Glatze schneidet – eine Schmach, die er nie so recht verwindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
