                "senses": [
                    {
                        "sense_id": "0f125e26-91db-3ea8-b556-6358a015906c",
                        "entry_id": "b4f6aa98-68a4-330a-8355-84d511ba0e90",
                        "glosses": [
                            "Temperatur im Inneren von etwas (insbesondere von Lebensmitteln)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4401ebdc-5c7e-4bd1-9e18-becb54c31af3",
                                "sense_id": "0f125e26-91db-3ea8-b556-6358a015906c",
                                "text": "„Um gar zu werden, benötigt die Weihnachtsgans eine Kerntemperatur von 90 Grad.“"
                            },
                            {
                                "example_id": "4b08dbd0-de91-4919-bd9f-5dde5d8d51f2",
                                "sense_id": "0f125e26-91db-3ea8-b556-6358a015906c",
                                "text": "„Die Presse drückt winzige Proben des Materials zwischen zwei Diamanten, um im Labor den extremen Druck, der im Erdinnersten vorherrscht, zu erzeugen, wobei der Laser die Materialien auf die nötige Kerntemperatur erhitzt.“"
                            },
                            {
                                "example_id": "432d1b6a-9860-43f3-a92e-2ff96178ed40",
                                "sense_id": "0f125e26-91db-3ea8-b556-6358a015906c",
                                "text": "„»Kerntemperatur unseres Körpers ist 37 Grad, ab 40 Grad wird es lebensgefährlich.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
