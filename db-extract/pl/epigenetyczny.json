                                "target_senses": [
                                    {
                                        "sense_id": "3b3b20d1-88fd-3e83-9ce4-ad63b7d4f715",
                                        "entry_id": "a25fd443-d23f-34f1-bae5-6d55793f791d",
                                        "glosses": [
                                            "die Epigenese betreffend, also die Tatsache, dass sich Lebewesen in ihrer Embryogenese von einem undifferenzierten in einen hochkomplex ausdifferenzierten Zustand entwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c809170b-29c6-496c-b973-3fcf568155c6",
                                                "sense_id": "3b3b20d1-88fd-3e83-9ce4-ad63b7d4f715",
                                                "text": "Das neue epigenetische Konzept wird zur Wurzel und zum Modellfall für Herbert Spencers Konzept einer universalen Evolution."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "70a2de0d-229b-34df-8f18-7552febc2bca",
                                        "entry_id": "a25fd443-d23f-34f1-bae5-6d55793f791d",
                                        "glosses": [
                                            "die Epigenetik betreffend"
                                        ],
                                        "tags": [],
