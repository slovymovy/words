                "senses": [
                    {
                        "sense_id": "516116b2-60fc-3309-8a41-8a2460a82d8e",
                        "entry_id": "df224963-05d7-3129-9949-0c089de28192",
                        "glosses": [
                            "allgemein: das Vorhandensein von Motivation, innerem Antrieb zu etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b7ff71-a15b-4be2-ac69-dfee88d10f1c",
                                "sense_id": "516116b2-60fc-3309-8a41-8a2460a82d8e",
                                "text": "Die derzeitige Motiviertheit der Leute lässt zu wünschen übrig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "adec237e-ca3a-33bf-939a-156bf68a974e",
                        "entry_id": "df224963-05d7-3129-9949-0c089de28192",
                        "glosses": [
                            "Eigenschaft von Morphemen oder Wörtern, durch ihre schriftliche oder mündliche Form Hinweise auf ihre Bedeutung zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c3b934-ed91-44f8-90e4-dfed63568315",
                                "sense_id": "adec237e-ca3a-33bf-939a-156bf68a974e",
                                "text": "Motiviertheit liegt dann vor, wenn man aus der Form einer sprachlichen Einheit auf ihre Bedeutung schließen kann."
                            },
                            {
                                "example_id": "b17313c3-f811-46d4-a7fb-f16a343f31f4",
                                "sense_id": "adec237e-ca3a-33bf-939a-156bf68a974e",
                                "text": "Ableitungen, Komposita, Onomatopoetika und formikonische Wörter weisen einen gewissen Grad an Motiviertheit auf."
                            },
                            {
                                "example_id": "256146b5-1a36-4bff-bc90-fc104006f2e4",
                                "sense_id": "adec237e-ca3a-33bf-939a-156bf68a974e",
                                "text": "„Im Hinblick auf den Grad der Motiviertheit lassen sich grob einige Gruppen unterscheiden....“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
