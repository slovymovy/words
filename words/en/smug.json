{
    "word_family": [
        "smugly",
        "smugness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb74b7aa-89b0-35a8-a3c4-a11c0b412409",
                    "sense_definition": "Irritatingly pleased with oneself; offensively self-complacent or self-satisfied.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-satisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kate looked extremely <w>smug</w> this morning after she won the competition.",
                            "target_lang_translations": {
                                "tr": "Kate yarışmayı kazandıktan sonra bu sabah son derece <w>kendini beğenmiş</w> görünüyordu."
                            }
                        },
                        {
                            "text": "He had a <w>smug</w> attitude that made it very difficult to work with him on the project.",
                            "target_lang_translations": {
                                "tr": "Projede onunla çalışmayı çok zorlaştıran <w>ukala</w> bir tavrı vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "complacent",
                        "self-satisfied",
                        "conceited",
                        "priggish"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "common_phrases": [
                        "smug attitude",
                        "smug grin"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kendi başarısından veya durumundan rahatsız edici derecede memnun, kendini beğenmiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kendini beğenmiş",
                                "target_lang_sense_clarification": "Kendiyle aşırı gurur duyan ve başkalarını rahatsız eden."
                            },
                            {
                                "target_lang_word": "ukala",
                                "target_lang_sense_clarification": "Bilgiçlik taslayan veya kendini üstün gören."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae0eaecb-fba9-302d-bbc9-b5b66db13a2d",
                    "sense_definition": "Showing smugness, self-complacency, or self-satisfaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-satisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>smug</w> look on her face when she realized she was right.",
                            "target_lang_translations": {
                                "tr": "Haklı olduğunu anladığında yüzünde <w>kendinden memnun</w> bir ifade vardı."
                            }
                        },
                        {
                            "text": "I could not stand his <w>smug</w> expression during the entire meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantı boyunca onun <w>ukala</w> ifadesine katlanamadım."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloaty",
                        "self-satisfied"
                    ],
                    "common_phrases": [
                        "smug look",
                        "smug expression"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kendi kendine memnuniyet veya kendini beğenmişlik gösteren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kendinden memnun",
                                "target_lang_sense_clarification": "Kendi durumundan aşırı hoşnut olan."
                            },
                            {
                                "target_lang_word": "havalı",
                                "target_lang_sense_clarification": "Kibirli bir tavır sergileyen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5717a48-74f7-3a56-89e9-e41303765d89",
                    "sense_definition": "Studiously neat or nice, especially in dress; spruce; affectedly precise; smooth and prim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentlemen were so <w>smug</w> and smooth in their finely tailored suits.",
                            "target_lang_translations": {
                                "tr": "Beyefendiler, özel dikim takım elbiseleri içinde çok <w>şık</w> ve düzgündüler."
                            }
                        },
                        {
                            "text": "He presented himself as a <w>smug</w>, handsome young man with impeccable manners.",
                            "target_lang_translations": {
                                "tr": "Kendini kusursuz tavırlara sahip, <w>bakımlı</w> ve yakışıklı bir genç adam olarak tanıttı."
                            }
                        }
                    ],
                    "synonyms": [
                        "spruce",
                        "prim",
                        "affected"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English to mean neat or spruce"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle giyimde aşırı titiz, şık veya yapmacık derecede düzenli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şık",
                                "target_lang_sense_clarification": "Özenli ve düzgün giyimli."
                            },
                            {
                                "target_lang_word": "bakımlı",
                                "target_lang_sense_clarification": "Dış görünüşüne çok dikkat eden."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4060acd-279d-30bb-a137-91d752a547b4",
                    "sense_definition": "To adopt an offensively self-complacent expression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He visibly <w>smugged</w> and went off to celebrate his small victory.",
                            "target_lang_translations": {
                                "tr": "Gözle görülür şekilde <w>kibirli bir ifade takındı</w> ve küçük zaferini kutlamaya gitti."
                            }
                        },
                        {
                            "text": "Instead of showing empathy, she merely <w>smugged</w> and walked away.",
                            "target_lang_translations": {
                                "tr": "Empati göstermek yerine, sadece <w>ukala bir tavır takındı</w> ve uzaklaştı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Rahatsız edici derecede kendini beğenmiş bir ifade takınmak."
                    },
                    "translations": {
                        "tr": []
