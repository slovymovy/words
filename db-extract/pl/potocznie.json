                                    {
                                        "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                        "entry_id": "0b2152fc-b259-372e-8ab7-dc352ecdd0c8",
                                        "glosses": [
                                            "In a colloquial manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ce24d7-6819-46c0-84b6-196ecd68cac8",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "Known colloquially as the \"El,\" the elevated lines constituted the earliest attempt to remove urban passenger traffic from the streets."
                                            },
                                            {
                                                "example_id": "ce84bd65-618a-4eeb-91a5-ddaaa1dd98c3",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "Cattle, colloquially referred to as cows, are domesticated ungulates."
                                            },
                                            {
                                                "example_id": "6f08880c-2e88-4a0f-becc-5c51c9eace88",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "The technical term for the event is “coupling,” but it is known colloquially as the “Shinkansen kiss.” For Japanese rail fans, it’s a big deal. For foreigners, it is a unique insight into the quintessentially Japanese experience of trainspotting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
