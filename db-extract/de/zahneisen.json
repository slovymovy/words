                        "glosses": [
                            "Steinmetzwerkzeug (Meißel) mit einer Schneide aus 3 bis 9 Zähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38ce8c61-b8f7-4e6d-a443-f60edafa6f2f",
                                "sense_id": "b56a377f-52e7-3fc0-869a-bbd4c8511435",
                                "text": "„Die Zähne des Zahneisens hinterlassen je nach Material und Aufwand Vertiefungen mit der Länge im Zentimeter- und der Tiefe im Millimeterbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
