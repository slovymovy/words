                ],
                "senses": [
                    {
                        "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                        "entry_id": "6c977533-fa05-3fc2-98c6-7b431d6476e2",
                        "glosses": [
                            "emotionale Abneigung zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58044d2-b1a6-4a67-9fbc-3012420be8fe",
                                "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                                "text": "„Tatsache ist, dass bei häufigem Misserfolg meist auch die Motivation zu spielen schwindet und sich schließlich Spielunlust als begreifliche Vermeidungsreaktion einstellt.“"
                            },
                            {
                                "example_id": "721c4f3e-dc11-41c0-a686-5983703702b9",
                                "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                                "text": "„Ein früh erkennbarer Mangel an Selbstwirksamkeitserfahrung und Erfolgserlebnissen im Spiel verstärkt Unzufriedenheit, Langeweile und Spielunlust mit einem Mangel an Ausdauer, raschem Aufgeben bei kleinen Herausforderungen und frustriertem Selbstwertgefühl.“"
                            },
                            {
                                "example_id": "87e69c25-36c4-4c97-bb34-972c334414c1",
                                "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                                "text": "„Abschließend werden häufig gestellte Fragen nach möglichen entwicklungspsychopathologischen Zusammenhängen von früher Spielunlust und ADHS diskutiert.“"
                            },
                            {
                                "example_id": "ce945c61-7319-480f-949a-5451de91d61f",
                                "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                                "text": "„Ob der plötzliche Formabfall durch Ermüdungserscheinungen (nach zwei Wochen Schach), durch plötzliche Spielunlust oder andere psychologische Einflüsse erklärt werden kann, ist gleichgültig.“"
                            },
                            {
                                "example_id": "4d393256-0825-4a1d-8d0e-b24336993e6a",
                                "sense_id": "3eaa5f3a-2e68-3ed0-8cd7-aa5128c79081",
                                "text": "„Dann äußerten sie plötzlich den Verdacht, seine Spielunlust sei durch den Stuhl, auf dem er saß, verursacht, weil er offensichtlich präpariert worden sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
