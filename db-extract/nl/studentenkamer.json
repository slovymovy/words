                        "tags": [],
                        "examples": [
                            {
                                "example_id": "006c078d-a37f-4372-a588-4c587b7b588c",
                                "sense_id": "4d036473-823b-3349-8f2d-438c5afea3bb",
                                "text": "Een studentenkamer is meestal een klein en smerig vertrek van waaruit de student de mooiste tijd van zijn leven heeft."
                            },
                            {
                                "example_id": "e6e6be70-bd40-4400-93c0-b552879d830a",
                                "sense_id": "4d036473-823b-3349-8f2d-438c5afea3bb",
                                "text": "„Airbed and breakfast”: daar staat de afkorting Airbnb voor. Eén van de meest succesvolle technologiebedrijven van de laatste jaren begon in 2007 op een studentenkamer in San Francisco als dienst om logeerplekken aan vreemden aan te bieden - al dan niet op een luchtbedje."
                            }
                        ]
                    }
