                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bos</w> de oude kranten samen zodat ze opgehaald kunnen worden.",
                            "target_lang_translations": {
                                "en": "I <w>bundle</w> the old newspapers together so they can be collected.",
                                "ru": "Я <w>связываю</w> старые газеты в пачки, чтобы их могли забрать.",
                                "pl": "<w>Wiążę</w> stare gazety, żeby można je było odebrać.",
                                "de": "Ich <w>bündele</w> die alten Zeitungen, damit sie abgeholt werden können.",
                                "fr": "Je <w>lie en bottes</w> les vieux journaux pour qu'ils puissent être ramassés.",
                                "it": "Io <w>affastello</w> i vecchi giornali insieme così che possano essere ritirati.",
                                "cs": "Staré noviny <w>svazuji</w> dohromady, aby se daly odvézt.",
                                "tr": "Eski gazeteleri toplanabilmeleri için bir araya getirip <w>bağlıyorum</w>.",
                                "es": "Yo <w>ato</w> los periódicos viejos para que puedan ser recogidos."
                            }
                        },
                        {
                            "text": "Als ik de takken <w>bos</w>, ziet de tuin er weer netjes uit.",
                            "target_lang_translations": {
                                "en": "When I <w>bundle</w> the branches, the garden looks tidy again.",
                                "ru": "Когда я <w>связываю</w> ветки, сад снова выглядит опрятно.",
                                "pl": "Kiedy <w>powiążę</w> gałęzie, ogród znowu będzie wyglądał schludnie.",
