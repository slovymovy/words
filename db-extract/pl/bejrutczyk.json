                                    {
                                        "sense_id": "83bba36d-b504-3464-9d05-475b0d451265",
                                        "entry_id": "32087804-0f67-3f24-a30e-e3573d48f86b",
                                        "glosses": [
                                            "Habitant ou personne originaire de Beyrouth, capitale du Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe55fe7-1528-452b-9b21-987c5692d2cc",
                                                "sense_id": "83bba36d-b504-3464-9d05-475b0d451265",
                                                "text": "Depuis le mois d’avril, les Beyrouthins soucieux de l’environnement bénéficient d’un système de ramassage à la demande, à domicile et gratuit, gérable par smartphone via une application."
                                            },
                                            {
                                                "example_id": "1eaf1472-6cca-4b68-8b11-11daccd13f06",
                                                "sense_id": "83bba36d-b504-3464-9d05-475b0d451265",
                                                "text": "La grande majorité des spectateurs adulait Marcel Cerdan et voir le champion du monde tenir en une telle estime un jeune Beyrouthin leur procurait une fierté sans nom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
