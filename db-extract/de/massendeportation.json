                "senses": [
                    {
                        "sense_id": "479f78c8-b7a1-3189-93e1-c45d320bc2b4",
                        "entry_id": "0e1e8a02-c67d-36f7-abfd-44ce4228504f",
                        "glosses": [
                            "Deportation von vielen Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14fcbd78-b983-4140-9be0-90903ba62ef2",
                                "sense_id": "479f78c8-b7a1-3189-93e1-c45d320bc2b4",
                                "text": "„Die Anklage umfasste auch Verbrechen gegen andere Völker wie die Massendeportationen von Polen und Slowenen, den Mord an Zehntausenden Sinti und Roma und anderes.“"
                            },
                            {
                                "example_id": "5073ebf9-2afb-4cc3-9ac0-b7de42cccf9c",
                                "sense_id": "479f78c8-b7a1-3189-93e1-c45d320bc2b4",
                                "text": "„Selbst in seriösen historischen Werken werden öffentliche Auspeitschungen, Hinrichtungen und Massendeportationen nach Australien beschrieben, und trotzdem steht England in dem Ruf, es ginge dort höflich und gesittet zu.“"
                            },
                            {
                                "example_id": "6d0039f7-6368-48ae-a299-11ec1dc3ef6e",
                                "sense_id": "479f78c8-b7a1-3189-93e1-c45d320bc2b4",
                                "text": "„Wie sich herausstellte, waren nur wenige Flüchtlinge bereit, den Gazastreifen für ein Flugticket zu verlassen, und Massendeportationen waren mehr oder weniger unmöglich, weil die israelische Politik von ausländischen Diplomaten und der Weltpresse genau beobachtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
