                                    },
                                    {
                                        "sense_id": "1d7179a5-3563-3f15-aba0-522144a99eef",
                                        "entry_id": "201ba33d-1625-3b52-bf69-54d4179dfbc6",
                                        "glosses": [
                                            "canned fish, usually mackerel."
                                        ],
                                        "tags": [
                                            "Sri-Lanka",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "347dded6-caa2-4c9f-b503-a2b320515b67",
                                                "sense_id": "1d7179a5-3563-3f15-aba0-522144a99eef",
                                                "text": "Tinned mackerel is confusingly called ‘salmon’ in Sri Lanka. So this dish, in Sinhalese, is salmon hodi, or salmon in gravy. Now that I think on it, all tinned fish in Sri Lanka is called salmon."
                                            },
                                            {
                                                "example_id": "b13afc5d-9d56-4777-b955-b7f229aed070",
                                                "sense_id": "1d7179a5-3563-3f15-aba0-522144a99eef",
                                                "text": "With a thick gravy made up of onions, tomatoes, spices, and coconut milk this Sri Lankan salmon curry might breathe new life to those canned mackerels on your shelf."
                                            },
                                            {
                                                "example_id": "93e8faed-c256-417b-9881-b5eedc9720f9",
                                                "sense_id": "1d7179a5-3563-3f15-aba0-522144a99eef",
                                                "text": "We manufacture canned markerel fish (salmon)"
                                            }
