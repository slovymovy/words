                    {
                        "sense_id": "d08c1b4a-be90-38bc-97f4-dc24589e775a",
                        "entry_id": "e0ab02a6-e968-35c0-acf6-d6f7a89620c3",
                        "glosses": [
                            "Feuer, das durch Verbrennen von Torf entfacht wurde und mit diesem unterhalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23a0304-77b9-4940-aba9-262762e9d6ff",
                                "sense_id": "d08c1b4a-be90-38bc-97f4-dc24589e775a",
                                "text": "„Auf der windgeschützten Seite eines hohen Felsblocks saß ein hagerer alter Mann und wärmte sich an einem niedrigen Torffeuer.“"
                            },
                            {
                                "example_id": "461b0835-88c2-47ef-850a-2dd98c2f1f82",
                                "sense_id": "d08c1b4a-be90-38bc-97f4-dc24589e775a",
                                "text": "„Nachdem sie sich vergewissert hatte, dass sich in der Nähe keine Ameisenhügel befanden, entzündete sie drei qualmende Torffeuer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
