                                "example_id": "a4859f3b-ad04-4b19-a813-321d4481b859",
                                "sense_id": "a34e6824-49ab-304c-b18e-f40bd593f96d",
                                "text": "Otherwise, the films of Cassavetes were always more praised than seen and some of the fulsome tributes to him when he died in 1989 were nauseously hypocritical."
                            },
                            {
                                "example_id": "6a50b6af-fe63-4717-b6de-709be1e67956",
                                "sense_id": "a34e6824-49ab-304c-b18e-f40bd593f96d",
                                "text": "Perhaps it’s more accurate to say I’m nauseously optimistic, because, to be candid, I go into the next five weeks feeling a bit sick to my stomach."
                            }
                        ]
                    }
