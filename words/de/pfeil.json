            "senses": [
                {
                    "sense_id": "58396b27-d0af-3d53-8b3e-87936c294018",
                    "sense_definition": "Grafisches Symbol oder Zeichen mit einer Spitze, das eine Richtung anzeigt oder auf etwas hinweist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Folgen Sie bitte dem <w>Pfeil</w> an der Wand bis zum Ausgang des Gebäudes."
                        },
                        {
                            "text": "Ein grüner <w>Pfeil</w> an der Ampel erlaubt das Abbiegen auch bei rotem Licht."
                        }
                    ],
                    "common_phrases": [
                        "dem Pfeil folgen",
                        "ein Pfeil nach rechts"
                    ]
                },
                {
                    "sense_id": "f0c5263c-cb66-330e-a056-8dfc09a050fe",
                    "sense_definition": "Geschoss mit einer Spitze und einem Schaft, das mit einem Bogen oder einer Armbrust abgeschossen wird.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "waffe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Schütze spannte die Sehne und traf mit dem <w>Pfeil</w> genau ins Schwarze."
                        },
                        {
                            "text": "Die Kinder bauten sich im Wald Pfeil und Bogen aus langen, biegsamen Ästen."
                        }
                    ],
                    "common_phrases": [
                        "Pfeil und Bogen",
                        "schnell wie ein Pfeil"
                    ]
                },
                {
                    "sense_id": "9575646f-e1ad-3705-8b80-1a6eda15ef4f",
                    "sense_definition": "Zeiger auf einer grafischen Benutzeroberfläche, der mit der Maus oder dem Touchpad gesteuert wird.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bewege den <w>Pfeil</w> auf das Symbol und klicke zweimal mit der linken Maustaste."
                        },
                        {
                            "text": "Wenn die Computermaus nicht reagiert, bleibt der <w>Pfeil</w> auf dem Bildschirm unbeweglich stehen."
                        }
                    ],
                    "synonyms": [
                        "Cursor",
                        "Mauszeiger"
                    ],
                    "common_phrases": [
                        "den Pfeil bewegen",
                        "mit dem Pfeil anklicken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig umgangssprachlich für beliebige Zeigerformen auf dem Bildschirm gebraucht"
                        }
                    ]
                }
            ]
