                    {
                        "sense_id": "9c887570-97d3-3842-9e42-6ec7de0f0194",
                        "entry_id": "3ab5325b-6043-3112-994a-df3333f05798",
                        "glosses": [
                            "Rivière d’Arcadie consacrée à Apollon."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "d49830a7-40d6-4544-8e66-a1014aaf0b64",
                                "sense_id": "9c887570-97d3-3842-9e42-6ec7de0f0194",
                                "text": "LADON, (Géog. anc.) rivière de Grèce, au Péloponnèse dans l’Arcadie. Elle avait sa source dans les marais de la ville de Phénée, & se perdait dans l’Alphée. Pausanias vante la beauté de ses eaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa61615a-8a55-32a1-b6c1-5c5240e203d7",
                        "entry_id": "3ab5325b-6043-3112-994a-df3333f05798",
                        "glosses": [
                            "Dieu-fleuve personnifiant ce cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85eee9c-902d-42a9-b6a0-69f813f414d5",
                                "sense_id": "fa61615a-8a55-32a1-b6c1-5c5240e203d7",
                                "text": "Les mythologistes firent de Ladon le père de la nymphe Daphné & de la nymphe Syrinx."
                            }
                        ]
                    }
                ],
