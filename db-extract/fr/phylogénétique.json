                "senses": [
                    {
                        "sense_id": "11acbd5a-3424-3f45-ae9a-a2c6c6b9bdd7",
                        "entry_id": "51a2a765-021e-3e01-a783-191e423486f8",
                        "glosses": [
                            "Relatif à l’histoire évolutive d’une espèce, c’est-à-dire sa phylogenèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d1ccef-e543-4a1f-904f-40f4526474c2",
                                "sense_id": "11acbd5a-3424-3f45-ae9a-a2c6c6b9bdd7",
                                "text": "Le séquençage génomique du coronavirus permet de tracer son évolution dans le monde au travers d’arbres phylogénétiques. En Belgique, des chercheurs de la KULeuven examinent plus de 250 échantillons qui montrent que son origine est très variée."
                            },
                            {
                                "example_id": "4b980444-c54c-445e-9a0e-3bd2882781d0",
                                "sense_id": "11acbd5a-3424-3f45-ae9a-a2c6c6b9bdd7",
                                "text": "Contrairement aux visions aristotélicienne et biblique, les espèces ne sont pas apparues parfaites dès l’origine, chacune à sa place et séparée des autres. Tous les êtres vivants sont les descendants des premiers organismes unicellulaires auxquels ils sont reliés par un arbre phylogénétique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "822fadd4-47fe-4964-a137-7ea10f190b1c",
                        "source_entry_id": "51a2a765-021e-3e01-a783-191e423486f8",
                        "source_sense_id": "11acbd5a-3424-3f45-ae9a-a2c6c6b9bdd7",
                        "target_lang_word": "phylogenetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phylogenetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afd1a264-41d6-3c6c-8cef-7a0d2141c12d",
                                        "entry_id": "a20e0adb-0dba-35d5-907e-cdbf98191cbb",
                                        "glosses": [
                                            "Of, or relating to phylogeny or phylogenetics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a194b01-d013-4865-8a55-7a7ca998c5d2",
                                                "sense_id": "afd1a264-41d6-3c6c-8cef-7a0d2141c12d",
                                                "text": "To each of these subdivisions of the phylum thus differentiated the name race may appropriately be restricted, and the sum of the peculiarities of each race may be termed race-characters. This is the phylogenetic side of anthropology, and its nomenclature should be kept clearly separate from that of the ethnological side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c531994-ec58-3dd3-bcfb-9f3a168e3316",
                                        "entry_id": "a20e0adb-0dba-35d5-907e-cdbf98191cbb",
                                        "glosses": [
                                            "Of, or relating to the evolutionary development of organisms."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
