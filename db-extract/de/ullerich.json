                ],
                "senses": [
                    {
                        "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                        "entry_id": "4ade5839-5ebe-3ad1-a8a2-4a4a52ce1b2d",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b3e7d4-c8ae-49cf-a5a7-f1631d34cf2c",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Frau Ullerich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f155e87b-df27-4223-b77d-a5653bcd8ff2",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Herr Ullerich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fdb3025a-9684-4a48-be12-463c8bf1b0d7",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Die Ullerichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d483227d-2bb8-4968-8110-c359652141e3",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Der Ullerich trägt nie die Schals, die die Ullerich ihm strickt."
                            },
                            {
                                "example_id": "b7edcdad-8f8c-4a40-b432-2f91fa25260f",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ullerich kommt, geht der Herr Ullerich.“"
                            },
                            {
                                "example_id": "3e786360-ab25-4d7c-a91e-596ca3ce9771",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Ullerich kommt und geht."
                            },
                            {
                                "example_id": "a33bf0c0-9137-4ef0-aa92-f51ff0eb51a4",
                                "sense_id": "612140ff-e64a-3d27-a839-31587b4a6d0d",
                                "text": "Ullerichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
