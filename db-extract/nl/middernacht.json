        "nl-extract.jsonl": [
            {
                "entry_id": "32092f6a-fe9d-3b34-8570-c577439a635a",
                "word": "middernacht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5af78e34-64ac-3f86-b633-f397628e3bde",
                        "entry_id": "32092f6a-fe9d-3b34-8570-c577439a635a",
                        "glosses": [
                            "het midden van de nacht, twaalf uur 's nachts"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "370fc9de-026c-47ab-ab33-89c2a7ae3c1d",
                                "sense_id": "5af78e34-64ac-3f86-b633-f397628e3bde",
                                "text": "Op de dag dat de vergunningen verstrekt werden zat ik stipt om middernacht klaar met drie computers binnen handbereik om er zeker van te zijn een startbewijs te bemachtigen."
                            },
                            {
                                "example_id": "2d9c92e0-75e7-4e22-abc0-4e5bbda8c67f",
                                "sense_id": "5af78e34-64ac-3f86-b633-f397628e3bde",
                                "text": "Het was een groot feest in Deventer: Deventer kan zijn geluk niet op na bekerwinst Go Ahead Eagles: 'We gaan Europa in!' De horeca in het centrum van Deventer had al eerder afgesproken om middernacht te sluiten. Vanaf toen stroomde de binnenstad dan ook grotendeels leeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dba79722-db77-45f9-93f1-49cf6b5111f7",
                        "source_entry_id": "32092f6a-fe9d-3b34-8570-c577439a635a",
                        "source_sense_id": "5af78e34-64ac-3f86-b633-f397628e3bde",
                        "source_sense_description": "het midden van de nacht, twaalf tot één uur 's nachts",
                        "target_lang_word": "Mitternacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitternacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                        "entry_id": "5d755c9d-49b5-3ea0-97ff-7075589ee898",
                                        "glosses": [
                                            "der Zeitpunkt 24 Uhr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14daa12-3e80-47fc-9491-750557c5654b",
                                                "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                                "text": "Man kann nicht jeden Tag um Mitternacht ins Bett gehen."
                                            },
                                            {
                                                "example_id": "09e2f4dc-c596-414f-9a19-237eca3afbc7",
                                                "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                                "text": "„Gegen Mitternacht, als seine Wange noch dicker geworden war und jede Bewegung an jeder Stelle seines Körpers weh tat, wurde ihm klar, daß der Barbier den falschen Zahn gezogen hatte.“"
                                            },
                                            {
                                                "example_id": "dd1fa73f-db7d-4104-a7d9-cce54f247268",
                                                "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                                "text": "„Sie saß am Rand seines Bettes, sie war nackt, gestern um eins nach Mitternacht war sie viel zu müde gewesen, um noch in die Pyjamas zu schlüpfen.“"
                                            },
                                            {
                                                "example_id": "62332df6-2c28-46aa-8bb2-52c8713a97fd",
                                                "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                                "text": "„St. Pölten ist ausgestorben, als wir weit nach Mitternacht durch den Schnee zu unseren Autos wanken.“"
                                            },
                                            {
                                                "example_id": "8d8836f0-b98f-401a-8391-a6959c4ea381",
                                                "sense_id": "08148221-ce5a-31cd-9e7f-02a30577bab7",
                                                "text": "„Die litauische Mitternacht, die Stunde der Werwölfe, war schon vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77f73a5e-27c2-43bc-a38c-82af901e41d1",
                        "source_entry_id": "32092f6a-fe9d-3b34-8570-c577439a635a",
                        "source_sense_id": "5af78e34-64ac-3f86-b633-f397628e3bde",
                        "source_sense_description": "het midden van de nacht, twaalf tot één uur 's nachts",
                        "target_lang_word": "midnight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
