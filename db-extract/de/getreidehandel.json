                "senses": [
                    {
                        "sense_id": "f18b1ef3-7cc2-363e-880c-efc209e06055",
                        "entry_id": "3573d93a-f58b-38bc-b369-5698b063b920",
                        "glosses": [
                            "der Handel mit Getreide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a73111a3-6349-4317-8e8b-13111d9d4e90",
                                "sense_id": "f18b1ef3-7cc2-363e-880c-efc209e06055",
                                "text": "„Der konventionelle Getreidehandel der Hofer Agarhandel GmbH bietet seinen Kunden den An- und Verkauf von Speise- und Futtergetreide.“"
                            },
                            {
                                "example_id": "f7a95bd2-d905-4ccb-aeab-154966ad8e2e",
                                "sense_id": "f18b1ef3-7cc2-363e-880c-efc209e06055",
                                "text": "„Indem er auf eigene Kosten einen 28 Meter langen Kai hatte bauen lassen, von dem aus Korn in kleine Leichter verladen werden kann, hatte Robert Billy dokumentiert, wie sehr ihm daran gelegen war, dass der Getreidehandel der Stadt Vannes weiter expandierte.“"
                            },
                            {
                                "example_id": "15662d43-29bd-46df-b2b3-a21742fe3506",
                                "sense_id": "f18b1ef3-7cc2-363e-880c-efc209e06055",
                                "text": "„Durch die günstige Verkehrslage war Gerdauen zu Beginn des 20. Jahrhunderts ein bedeutendes Zentrum des Getreidehandels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
