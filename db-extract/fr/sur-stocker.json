                ],
                "senses": [
                    {
                        "sense_id": "b0785838-be39-3324-89ee-14024e8a2d0a",
                        "entry_id": "836ad441-87ce-3718-9655-d32966402a26",
                        "glosses": [
                            "Stocker en quantité excessive, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ab1e64-6e75-456b-9edc-d95ff66b039b",
                                "sense_id": "b0785838-be39-3324-89ee-14024e8a2d0a",
                                "text": "Pendant longtemps, la gestion du stock se limitait à faire en sorte d’éviter d’être en rupture, quitte à sur-stocker un peu."
                            },
                            {
                                "example_id": "da0f0cd8-6806-492a-8dae-d457cd5f0471",
                                "sense_id": "b0785838-be39-3324-89ee-14024e8a2d0a",
                                "text": "Aux questions alors posées par le banquier, les explications seront nombreuses : nécessité de sur-stocker pour ne pas avoir de ruptures d’approvisionnement, lancement de nouvelles gammes de produits."
                            },
                            {
                                "example_id": "a24b2772-bcf2-431f-a693-af437062d421",
                                "sense_id": "b0785838-be39-3324-89ee-14024e8a2d0a",
                                "text": "L’organisme mis à la diète va sur-stocker, dès que le régime sera terminé, histoire de pouvoir résister à une nouvelle “famine”."
                            }
                        ]
                    }
                ],
