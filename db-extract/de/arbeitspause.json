                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efae617f-9aa4-4a14-af84-20194b03b53d",
                                "sense_id": "e4697c8f-593b-306b-8783-5e9f198ddd5c",
                                "text": "„In ihren wenigen, kurzen Arbeitspausen sitzt Mekdes am liebsten im Restaurant vor dem ununterbrochen laufenden Fernseher.“"
                            },
                            {
                                "example_id": "d2039e65-f9f6-492e-9081-83721d934b6c",
                                "sense_id": "e4697c8f-593b-306b-8783-5e9f198ddd5c",
                                "text": "„In den Arbeitspausen brennen Kartoffelfeuer; ihr Duft liegt über dem Land.“"
                            },
                            {
                                "example_id": "cae3c4eb-201a-424a-a73f-de2e633f3c52",
                                "sense_id": "e4697c8f-593b-306b-8783-5e9f198ddd5c",
                                "text": "„In den Arbeitspausen erklärten sie ihm ihre Dinge: das Brot, den Tabak und die Qualität ihrer Schuhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
