                        "target_lang_word": "сосуд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сосуд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac0dfc8-e11d-374a-ae2d-c78632d1dad5",
                                        "entry_id": "02023bca-0b62-3530-9d90-2ead58ece543",
                                        "glosses": [
                                            "вместилище для жидких или сыпучих тел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ac3c4a-5f6e-4e1b-a35f-3c5f3fb7ae29",
                                                "sense_id": "9ac0dfc8-e11d-374a-ae2d-c78632d1dad5",
                                                "text": "Напиток дозревает в тёмном стекле или керамическом сосуде."
                                            },
                                            {
                                                "example_id": "368337bd-6ddb-4ea7-af33-0157b0f314d2",
                                                "sense_id": "9ac0dfc8-e11d-374a-ae2d-c78632d1dad5",
                                                "text": "Целый ряд сосудов: сулеи, кубки и чарки радовали и веселили взор хозяина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f64c4c2f-8508-32da-992f-fb9182606440",
                                        "entry_id": "02023bca-0b62-3530-9d90-2ead58ece543",
                                        "glosses": [
                                            "анат. трубчатый о́рган у животных и растений, по которому движется жидкая среда (кровь или лимфа)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931834bb-448b-404c-a0bf-f865141bd5e9",
                                                "sense_id": "f64c4c2f-8508-32da-992f-fb9182606440",
                                                "text": "Американские учёные выявили — орехи укрепляют сердце и полезны кровеносным сосудам."
                                            },
                                            {
                                                "example_id": "1a37df6a-4967-4c3e-ad87-d9f6f927268b",
                                                "sense_id": "f64c4c2f-8508-32da-992f-fb9182606440",
                                                "text": "Стресс вызывает выброс адреналина, что, в свою очередь, обусловливает спазм сосудов и резкие сбои в системе кровоснабжения внутренних органов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b11ca08d-3af7-395c-a413-4ec512e810b4",
                                        "entry_id": "02023bca-0b62-3530-9d90-2ead58ece543",
                                        "glosses": [
                                            "ботан. элемент ткани у растений в виде длинных полых трубок, образованных одним рядом клеток (члеников) со сквозными отверстиями (перфорациями) между ними для продвижения воды и растворенных в ней веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6fdba6a-d1b3-4136-828b-69b608117ff6",
                                                "sense_id": "b11ca08d-3af7-395c-a413-4ec512e810b4",
                                                "text": "Сложный и изумительный процесс химического превращения элементов происходил в сосудах растений."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
