                "senses": [
                    {
                        "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                        "entry_id": "edd231cc-f516-3ac6-988f-23b2dca5f1b6",
                        "glosses": [
                            "eine Stadt in Schleswig-Holstein, Deutschland; Chorstadt des Nordens, Rosen- und Hochzeitsstadt an der Pinnau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efccfd46-e868-431b-a951-c1478b2fab9a",
                                "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                                "text": "Seit 1999 trägt Uetersen den Titel »Hochzeitsstadt«.“"
                            },
                            {
                                "example_id": "6d6df8be-0684-4054-932c-95cce9267b70",
                                "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                                "text": "„Mit dem Untergang des einzigen Uetersener Walfangschiffs am 8. April 1859 während eines Schneesturms vor Grönland fand der Walfang Uetersens ein jähes Ende.“"
                            },
                            {
                                "example_id": "74f199c1-12ae-4d9c-9206-172ac6bde492",
                                "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                                "text": "Ich bin in Uetersen geboren."
                            },
                            {
                                "example_id": "99f294ff-ce0b-4432-982c-aacdf0370845",
                                "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                                "text": "Ich habe in Uetersen meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "3763244a-0093-4fd3-b9b8-7aceb9bc77aa",
                                "sense_id": "453e32fc-a192-3355-b462-6bb4292a72ec",
                                "text": "Nach Uetersen führen viele Wege."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
