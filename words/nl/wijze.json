            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb381a52-a90f-30c7-883a-4e2b63e4183e",
                    "sense_definition": "De manier waarop iets gebeurt of gedaan wordt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op welke <w>wijze</w> kunnen we dit probleem het beste oplossen?",
                            "target_lang_translations": {
                                "en": "In what <w>way</w> can we best solve this problem?",
                                "ru": "Каким <w>способом</w> мы можем лучше всего решить эту проблему?"
                            }
                        },
                        {
                            "text": "Het behalen van de landstitel werd op een grootse <w>wijze</w> gevierd.",
                            "target_lang_translations": {
                                "en": "Winning the national title was celebrated in a grand <w>manner</w>.",
                                "ru": "Завоевание национального титула было отпраздновано грандиозным <w>образом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "manier",
                        "methode",
                        "trant"
                    ],
                    "common_phrases": [
                        "op deze wijze",
                        "op mysterieuze wijze",
                        "op een wijze"
                    ],
                    "target_lang_definitions": {
                        "en": "The way in which something happens or is done.",
                        "ru": "Способ, которым что-либо происходит или делается."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "way",
                                "target_lang_sense_clarification": "a method or manner of doing something"
                            },
                            {
                                "target_lang_word": "manner",
                                "target_lang_sense_clarification": "mode of action or way of performing something"
                            },
                            {
                                "target_lang_word": "method",
                                "target_lang_sense_clarification": "a systematic way of doing something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "способ",
                                "target_lang_sense_clarification": "метод или порядок действий"
                            },
                            {
                                "target_lang_word": "образ",
                                "target_lang_sense_clarification": "характер или вид деятельности, например, образ действий"
                            },
                            {
                                "target_lang_word": "манера",
                                "target_lang_sense_clarification": "особенность поведения или выполнения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2b421da-af6f-3efc-b4ba-d7267b4be7a8",
                    "sense_definition": "Gebruikt in de uitdrukking 'bij <w>wijze</w> van' om een vergelijking of functie aan te duiden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij doet elke ochtend aan yoga bij <w>wijze</w> van conditietraining.",
                            "target_lang_translations": {
                                "en": "He does yoga every morning <w>by way of</w> fitness training.",
                                "ru": "Он каждое утро занимается йогой <w>в качестве</w> тренировки для поддержания формы."
                            }
                        },
                        {
                            "text": "Wanneer we te laat kwamen, zeiden we dat het regende bij <w>wijze</w> van excuus.",
                            "target_lang_translations": {
                                "en": "When we were late, we said it was raining <w>as an</w> excuse.",
                                "ru": "Когда мы опаздывали, мы говорили, что идет дождь, <w>в качестве</w> оправдания."
                            }
                        }
                    ],
                    "synonyms": [
                        "als",
                        "bij wijze van"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in the expression 'bij wijze van' to indicate a comparison, function, or figure of speech.",
                        "ru": "Используется в выражении «bij wijze van» для обозначения сравнения, функции или в качестве оборота речи."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "by way of",
                                "target_lang_sense_clarification": "serving as or as a form of"
                            },
                            {
                                "target_lang_word": "as a",
                                "target_lang_sense_clarification": "in the role or function of"
                            },
                            {
                                "target_lang_word": "so to speak",
                                "target_lang_sense_clarification": "used to indicate a metaphorical expression"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "в качестве",
                                "target_lang_sense_clarification": "в роли чего-либо"
                            },
                            {
                                "target_lang_word": "в виде",
                                "target_lang_sense_clarification": "как форма чего-либо"
                            },
                            {
                                "target_lang_word": "так сказать",
                                "target_lang_sense_clarification": "для обозначения метафорического выражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a56720d5-56b8-39d0-8d06-13bb409e642d",
                    "sense_definition": "Een persoon die over veel kennis, inzicht en levenservaring beschikt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>wijze</w> zat onder de boom en gaf advies aan de dorpelingen.",
                            "target_lang_translations": {
                                "en": "The old <w>sage</w> sat under the tree and gave advice to the villagers.",
                                "ru": "Старый <w>мудрец</w> сидел под деревом и давал советы жителям деревни."
                            }
                        },
                        {
                            "text": "Volgens de legende kwamen de drie <w>wijzen</w> uit het oosten op bezoek.",
                            "target_lang_translations": {
                                "en": "According to the legend, the three <w>wise men</w> from the east came to visit.",
                                "ru": "Согласно легенде, три <w>волхва</w> с востока пришли с визитом."
                            }
                        }
                    ],
                    "synonyms": [
                        "geleerde",
                        "denker"
                    ],
                    "common_phrases": [
                        "de drie wijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who possesses great knowledge, insight, and life experience.",
                        "ru": "Человек, обладающий большими знаниями, проницательностью и жизненным опытом."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wise man",
                                "target_lang_sense_clarification": "a man who is wise or a sage"
                            },
                            {
                                "target_lang_word": "sage",
                                "target_lang_sense_clarification": "a profoundly wise person"
                            },
                            {
                                "target_lang_word": "scholar",
                                "target_lang_sense_clarification": "a learned person"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мудрец",
                                "target_lang_sense_clarification": "человек, обладающий высшей мудростью"
                            },
                            {
                                "target_lang_word": "мудрый человек",
                                "target_lang_sense_clarification": "человек с большим жизненным опытом"
                            }
                        ]
                    }
                },
                {
