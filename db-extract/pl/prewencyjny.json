                                        "glosses": [
                                            "Slowing the development of an illness; prophylactic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a7a2f6-58ab-4bbb-b21c-4472681e2e6f",
                                                "sense_id": "4d109aed-98e2-3f2d-a82f-4711cfbd2b0e",
                                                "text": "Physick is either curative or preventive."
