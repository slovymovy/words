                                                "example_id": "cb15dbc8-f8e2-42b5-85df-9178bad9bfbf",
                                                "sense_id": "1dd55819-4e16-311e-851a-46d87d80ac91",
                                                "text": "[H]er thick, gurgling voice saying […]: \"Get it in all the way… please, please do… I’m horny.\""
                                            },
