                "senses": [
                    {
                        "sense_id": "b4604ce3-572b-3181-b19c-7c4fb86690c9",
                        "entry_id": "2d7e4910-6a4a-3864-93e2-b039a05d5f54",
                        "glosses": [
                            "von Parteimitgliedern in Fußgängerzonen betriebene, persönliche Wahlwerbung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a995f0a9-3e73-4fbc-afde-ad974c88fe46",
                                "sense_id": "b4604ce3-572b-3181-b19c-7c4fb86690c9",
                                "text": "„Allein der Straßenwahlkampf soll die Parteien zusammen mehr als das jährliche Budget für ländliche Entwicklung gekostet haben.“"
                            },
                            {
                                "example_id": "49a0000f-5135-4f4c-9ed0-0e3e2fe0962f",
                                "sense_id": "b4604ce3-572b-3181-b19c-7c4fb86690c9",
                                "text": "„Inwieweit sind wahlsystemische Anreize für das Ausmaß verantwortlich, in dem Straßenwahlkampf betrieben wird und in dem lokale Veranstaltungen besucht werden?“"
                            },
                            {
                                "example_id": "f180e718-2152-46ee-8624-2a3b5bc89e30",
                                "sense_id": "b4604ce3-572b-3181-b19c-7c4fb86690c9",
                                "text": "„Am Tag seiner Niederlage vor Gericht twitterte Emanuel ein langweiliges Foto, das ihn im Straßenwahlkampf zeigt.“"
                            },
                            {
                                "example_id": "bae52e43-8f4f-4c99-8785-eb229ce92f90",
                                "sense_id": "b4604ce3-572b-3181-b19c-7c4fb86690c9",
                                "text": "„Wir sind zu viert, und für uns alle ist es der erste Straßenwahlkampf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
