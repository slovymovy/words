                    {
                        "sense_id": "df9324a8-b501-3a59-9469-267d7d6c935e",
                        "entry_id": "bebe3b5f-d354-3408-a7d6-1e59bed05bbd",
                        "glosses": [
                            "Ordensfrau, die nach der Regel des Heiligen Benedikt lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80806377-4642-42d7-bca7-e74173a53e10",
                                "sense_id": "df9324a8-b501-3a59-9469-267d7d6c935e",
                                "text": "„In Frankreich und Belgien entstanden zwar wieder sehr schnell, in einigen Fällen sogar schon vor dem Sturz Napoleons, eine Anzahl von Konventen der Benediktinerinnen.“"
                            },
                            {
                                "example_id": "41ff6977-187e-47e7-bae0-3638a6a55816",
                                "sense_id": "df9324a8-b501-3a59-9469-267d7d6c935e",
                                "text": "„Am vergangenen Sonntag schalteten wiederum 5,33 Millionen ein, als es um die Benediktinerin Hildegard von Bingen ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f0c0ea2-beea-4c24-b1b2-d7044dbe14b9",
