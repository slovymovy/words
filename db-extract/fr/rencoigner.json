                            "pronominal"
                        ],
                        "form": "se rencoigner"
                    },
                    {
                        "form_id": "13387a99-c102-4101-919d-5b89289d5ea7",
                        "entry_id": "336bbcad-d26c-3047-bf95-d9d9f9ae0139",
                        "tags": [],
                        "form": "rencogner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "910406dd-3c4c-349f-ade2-ffac7a158eff",
                        "entry_id": "336bbcad-d26c-3047-bf95-d9d9f9ae0139",
                        "glosses": [
                            "Pousser ou serrer quelqu’un dans un coin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2e756bad-e3b0-4198-8bc9-d81839e20ca7",
                                "sense_id": "910406dd-3c4c-349f-ade2-ffac7a158eff",
                                "text": "Usés, effacés, humiliés, rencoignés, passés sous silence, tous les traits de l’enfant sont restés chez le quinquagénaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d9f9604-6c37-37b0-9e90-91ce39efe4d6",
                        "entry_id": "336bbcad-d26c-3047-bf95-d9d9f9ae0139",
                        "glosses": [
                            "Se retirer dans un coin, se renfermer chez soi."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c095a0bc-2196-4d40-8b90-a4597c48820a",
                                "sense_id": "5d9f9604-6c37-37b0-9e90-91ce39efe4d6",
                                "text": "Il nous jeta un regard féroce bien que, le gendarme et moi, soyons rencoignés dans notre coin de porte comme deux petits lapins."
                            },
                            {
                                "example_id": "9c01bd6b-298b-4680-98b8-74aec3e06f40",
                                "sense_id": "5d9f9604-6c37-37b0-9e90-91ce39efe4d6",
                                "text": "Le bruit de voix monotone et égal reprenait le fil, me ramenait au réveil du matin comme à un rêve coupé d’insomnies, et je me rencoignai dépité, mal convaincu de ne plus dormir."
                            },
                            {
                                "example_id": "efd48574-5d73-454c-bdbe-cc6785292a69",
                                "sense_id": "5d9f9604-6c37-37b0-9e90-91ce39efe4d6",
                                "text": "Pour toute réponse, je donnai un coup d’œil sur la galerie, me rencoignai dans l’épaisseur du mur, me jetai à genoux et donnai un long baiser à l’amour, sous la robe à fleurs."
                            },
                            {
                                "example_id": "90ccb05b-c145-4cd8-b4df-cbe24af1e5e0",
                                "sense_id": "5d9f9604-6c37-37b0-9e90-91ce39efe4d6",
                                "text": "Me rencoigner patiemment et attendre. Oh, pas qu’elle revienne, l’espoir n’allait pas si loin."
                            }
                        ]
                    },
                    {
                        "sense_id": "6de71909-a8dc-3cf7-bd26-045758fafaf8",
                        "entry_id": "336bbcad-d26c-3047-bf95-d9d9f9ae0139",
                        "glosses": [
                            "Ravaler, en parlant de larmes, chez Saint-Simon."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "89367925-05b8-41d1-92ba-97f31697edab",
                                "sense_id": "6de71909-a8dc-3cf7-bd26-045758fafaf8",
                                "text": "(...) Mme la duchesse d’Orléans ayant repris ses esprits et surmonté son embarras et son dépit, elle fit effort pour rencoigner ses larmes."
                            }
                        ]
                    }
                ],
