                "senses": [
                    {
                        "sense_id": "0dcbf168-e0f8-33f4-be44-95a9ee056684",
                        "entry_id": "459e225a-a43f-3037-829e-e3df64ad6f95",
                        "glosses": [
                            "Substanz, die bewirken soll, dass der Konsument nur die Wahrheit sagen und nicht lügen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911080db-1192-4be5-b342-67b049efb0a7",
                                "sense_id": "0dcbf168-e0f8-33f4-be44-95a9ee056684",
                                "text": "Da hat man dir ein Wahrheitsserum untergejubelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c869c23d-1421-48ce-9270-edf9a328d144",
                        "source_entry_id": "459e225a-a43f-3037-829e-e3df64ad6f95",
                        "source_sense_id": "0dcbf168-e0f8-33f4-be44-95a9ee056684",
                        "source_sense_description": "Substanz, die bewirken soll, dass der Konsument nur die Wahrheit sagen und nicht lügen kann",
                        "target_lang_word": "truth serum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truth serum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                        "entry_id": "07035620-f6fc-39ec-aa67-343d1f220625",
                                        "glosses": [
                                            "A psychoactive medication, especially one administered by injection, which supposedly renders a person cooperative and disposed to respond honestly to questions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f1c250-f8f3-4b5f-acea-a073d075ca45",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "There is a difference of opinion among criminologists as the relative merits of the truth serum test over the lie detector test. The former relies upon producing a state of near unconsciousness in the subject by injection of controlled dosages of sodium amytal."
                                            },
                                            {
                                                "example_id": "2096a922-3908-4327-8b81-6ce0d5f8b4f6",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "\"The British run torture centers in Cyprus where they beat their prisoners, inject them with truth serums, extract their teeth and fingernails,\" cried Athens' Voice of the Fatherland radio."
                                            },
                                            {
                                                "example_id": "a30b2c3a-5b80-40f5-8ec6-b21be72747de",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "He does note, however, that other aids such as truth sera and lie detectors will never be entirely successful since persons speak only what they believe to be the truth, and the truth they speak may not square with objective reality. Under these circumstances truth sera and lie detectors are not dependable."
                                            },
                                            {
                                                "example_id": "55d1cf99-e3db-435c-b026-a5426bb8d348",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "This assumption underlies the repeated comparison of hypnosis to scientific tests designed to measure the truthfulness of the subject, such as polygraphs and truth sera."
                                            },
                                            {
                                                "example_id": "b52ab8a3-21e4-4c52-9111-9a083616821a",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "Cassidy opened her mouth to say she was fine but an internal voice stopped her. You’re not supposed to do that anymore. Feeling as if she’d drunk truth serum, she said, “I had an anxiety attack driving over and I’m a little shaky.”"
                                            },
                                            {
                                                "example_id": "a9a6aa53-ceb6-4033-a944-82825774930f",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "Mr. Heirens spent days in police custody and was given truth serum and a spinal tap before confessing to the Degnan killing and the earlier slayings of two women."
                                            },
                                            {
                                                "example_id": "93190407-091d-4c6b-9e93-7faaee6f5ae2",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "This did not mean that truth sera could not be used as diagnostic aids in distinguishing between falsehood and truth, but the nature of the evidence changed in psychiatric contexts, and so did the kinds of falsehood it could ferret out."
                                            },
                                            {
                                                "example_id": "2f7c6c9e-1e42-4fd6-89c6-41c289710168",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "I was tipsy enough that when Dubey asked me what had been the craziness I’d alluded to in my message, I blurted the whole story of Vijay as if we’d drunk truth serum."
                                            },
                                            {
                                                "example_id": "6189a5ed-068b-450a-b56c-da43cdd03249",
                                                "sense_id": "1e91f73e-6b01-3da1-866b-354ef73aefcd",
                                                "text": "Mirrors and windows are deceiving; they may look clean head-on, but when you move to another part of the room they can look like a hot mess. […] By checking at these four angles, you account for any funny lighting and can see, for real, any streaks or areas left uncleaned. It’s like your mirror has drunk truth serum!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31987558-bd34-4a69-afc5-893efdb08f97",
                        "source_entry_id": "459e225a-a43f-3037-829e-e3df64ad6f95",
                        "source_sense_id": "0dcbf168-e0f8-33f4-be44-95a9ee056684",
                        "source_sense_description": "Substanz, die bewirken soll, dass der Konsument nur die Wahrheit sagen und nicht lügen kann",
                        "target_lang_word": "sérum de vérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérum de vérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3df491-e07d-3a7f-b1c8-2eaf4754f326",
                                        "entry_id": "f0df63bc-7c1c-3b86-b3f5-a35b9a19a347",
                                        "glosses": [
                                            "Produit pharmaceutique, à base de penthotal, utilisée dans les interrogatoires pour inhiber la résistance du questionné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771b7de7-e6ca-4e62-a835-ce813bd6931b",
                                                "sense_id": "7b3df491-e07d-3a7f-b1c8-2eaf4754f326",
                                                "text": "Tous ces préparatifs confirmaient ce que j’appréhendais. Ils allaient expérimenter sur moi le « sérum de vérité »."
                                            },
                                            {
                                                "example_id": "ac6074eb-93cc-4464-a33e-39027b5577fa",
                                                "sense_id": "7b3df491-e07d-3a7f-b1c8-2eaf4754f326",
                                                "text": "Haj Garne n’a pas besoin de sérum de vérité pour se trahir. Il est l’incarnation par excellence de la fausseté. Son sourire, ses éclats de rire, ses grasses taloches sur l’épaule ne sont que leurre."
                                            },
                                            {
                                                "example_id": "4ee1826f-aa45-4ca9-ab4d-404ec760d93a",
                                                "sense_id": "7b3df491-e07d-3a7f-b1c8-2eaf4754f326",
                                                "text": "Elle déroba du penthotal à l’infirmerie et en injecta une dose à EPJ327. Le sérum de vérité délia la langue […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
