                    },
                    {
                        "form_id": "f1e9f287-dc9d-4c36-a789-aac1493917e0",
                        "entry_id": "c629d927-767b-3848-b252-8f806315bd4c",
                        "tags": [
                            "masculine"
                        ],
                        "form": "lieutenant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7e418d3-0bbd-32ed-8b6d-789e127dace3",
                        "entry_id": "c629d927-767b-3848-b252-8f806315bd4c",
                        "glosses": [
                            "Celle qui est immédiatement au-dessous d’un chef, qu’elle supplée dans certains cas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935decec-a1b7-46a8-a346-8f95d8593fb7",
                                "sense_id": "c7e418d3-0bbd-32ed-8b6d-789e127dace3",
                                "text": "Dans les deux cas, Isabelle de Lorraine est instituée vicaire générale, lieutenante, rectrice et gouvernante (vicariam generalem, vicegerentem, locumtenentem, rectricem, et gubernatricem)."
                            },
                            {
                                "example_id": "2e985ac6-2b82-488d-bb7c-c3cacf223d39",
                                "sense_id": "c7e418d3-0bbd-32ed-8b6d-789e127dace3",
                                "text": "La lieutenante Tanja Rotfeld est une femme dynamique au franc-parler qui émane une aura d’ondes positives."
                            }
                        ]
                    },
                    {
                        "sense_id": "757b0a41-8065-311e-a0d4-7a5df458bf64",
                        "entry_id": "c629d927-767b-3848-b252-8f806315bd4c",
                        "glosses": [
                            "Militaire (officière) ou civile (sapeuse-pompière) qui porte le grade de lieutenant."
                        ],
                        "tags": [
                            "Lutte contre l’incendie"
                        ],
                        "examples": [
                            {
                                "example_id": "e5f295dc-a933-4f19-92c7-17a52d264426",
                                "sense_id": "757b0a41-8065-311e-a0d4-7a5df458bf64",
                                "text": "C’est alors qu’il reçut la visite d’une jeune lieutenante à sa table."
                            },
                            {
                                "example_id": "83f793a6-c1ff-4d1b-8693-e7e4c40e9410",
                                "sense_id": "757b0a41-8065-311e-a0d4-7a5df458bf64",
                                "text": "La lieutenante Adriana Wayakalin se gara sur le parking de la brigade, coupa le moteur et posa les deux mains sur le volant."
                            },
                            {
                                "example_id": "30a29713-f361-4fc4-a061-57b4132418d9",
                                "sense_id": "757b0a41-8065-311e-a0d4-7a5df458bf64",
                                "text": "Certes, au Journal officiel, les décrets de nomination utilisent le féminin pour les colonels et les généraux. Toutefois, l’usage communément observé dans les armées est de dire « le lieutenant Sylvie X », « le colonel Catherine Y » ou « le capitaine de vaisseau Jacqueline Z ». Celles qui insistent sur la féminisation de leur grade – « lieutenante », « colonelle » – sont relativement rares."
                            },
                            {
                                "example_id": "82bca34b-59b4-48a2-91e3-c5e2b7e0e62a",
                                "sense_id": "757b0a41-8065-311e-a0d4-7a5df458bf64",
                                "text": "Mais derrière la championne se cache aussi un agent du service public, puisque Élodie Clouvel est titulaire du grade de lieutenante dans la gendarmerie nationale."
                            }
                        ]
                    },
                    {
                        "sense_id": "827fd68c-600a-3391-8805-b067106f2c7f",
                        "entry_id": "c629d927-767b-3848-b252-8f806315bd4c",
                        "glosses": [
                            "Grade d’officière des Forces armées canadiennes."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f132b3e-509f-3c8d-8406-365e939b25fd",
                        "entry_id": "c629d927-767b-3848-b252-8f806315bd4c",
                        "glosses": [
                            "Épouse d’un magistrat portant, autrefois, le titre de lieutenant, comme celui de lieutenant général, lieutenant civil ou lieutenant criminel."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
