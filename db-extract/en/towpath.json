                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e494525-a1e2-401b-8b24-a1170d24b090",
                        "source_entry_id": "5f7ddbec-e5ca-3bef-bf35-87ca8fd91d72",
                        "source_sense_id": "080bd82b-24e7-36c5-a018-b59f84559918",
                        "source_sense_description": "path alongside a canal or river",
                        "target_lang_word": "chemin de halage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chemin de halage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04024ec3-9843-3783-9965-7ae96884c9ad",
                                        "entry_id": "f0cfe3b7-0516-3c38-98a1-1f34ab5e7043",
                                        "glosses": [
                                            "Espace que les propriétaires riverains sont tenus de laisser libre sur le bord des rivières pour le passage des hommes ou des chevaux qui tirent les bateaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a6758ec-5d08-3e82-9f75-b93a7142c4eb",
                                        "entry_id": "f0cfe3b7-0516-3c38-98a1-1f34ab5e7043",
                                        "glosses": [
                                            "Cet espace, aménagé en allée sur une berge de rivière, de canal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a5b299-0de8-4a1a-837a-ec6587d13374",
                                                "sense_id": "5a6758ec-5d08-3e82-9f75-b93a7142c4eb",
                                                "text": "Le lendemain j’étais perclus, mais je continuai ma route en longeant le chemin de halage de la rive droite du Danube, et bientôt nous arrivâmes à Semendria."
                                            },
                                            {
                                                "example_id": "d51cbab1-376f-40b7-99f9-5099fd0b91f6",
                                                "sense_id": "5a6758ec-5d08-3e82-9f75-b93a7142c4eb",
                                                "text": "L’après-midi, le groupe prenait la direction de Bouziès où les amicalistes ont embarqué sur une gabare en bois pour une promenade sur le Lot avec son chemin de halage taillé dans la falaise, son écluse manuelle et une vue imprenable sur le village perché de Saint-Cirq-Lapopie…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26597c38-47d0-47ec-882b-fa6427ab40d3",
                        "source_entry_id": "5f7ddbec-e5ca-3bef-bf35-87ca8fd91d72",
                        "source_sense_id": "080bd82b-24e7-36c5-a018-b59f84559918",
                        "source_sense_description": "path alongside a canal or river",
                        "target_lang_word": "halage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d22abda3-9978-33d8-b451-92b02dd74653",
                                        "entry_id": "4ac87462-55eb-3bf4-a72d-2fcda494527e",
                                        "glosses": [
                                            "Action de haler quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f83efd-36f6-493f-8eb1-5f8550f54b35",
                                                "sense_id": "d22abda3-9978-33d8-b451-92b02dd74653",
                                                "text": "Si le train de bois n’était pas prêt, le sergent saurait bien arrêter le halage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339cb170-a964-3776-9a9b-6efa9ad8c3f3",
                                        "entry_id": "4ac87462-55eb-3bf4-a72d-2fcda494527e",
                                        "glosses": [
                                            "Action de haler un bateau ; de le tirer à soi avec une corde, de lui imprimer un mouvement de translation à l’aide de moteurs agissant sur les bords d’un canal ou d’une rivière."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2876f346-e91f-4392-be8d-0f2c41f1b468",
                                                "sense_id": "339cb170-a964-3776-9a9b-6efa9ad8c3f3",
                                                "text": "Tout prêt du halage se tient le bistrot des mariniers, il garde l’entrée du canal. Le courant jaune vient pousser sur l’écluse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
