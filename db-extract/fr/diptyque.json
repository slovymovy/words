                                    },
                                    {
                                        "sense_id": "f9519a78-fad1-3d56-b992-1543e8107204",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "A double catalogue, containing in one part the names of living, and in the other of deceased, ecclesiastics and benefactors of a church."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85528df3-127e-3c84-8954-68e0d47c9adb",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "A catalogue of saints."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6303f260-e319-3eb7-b27b-13008fd00097",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "Artistically-wrought tablets distributed by consuls, etc. of the later Roman Empire to commemorate their tenure of office; hence (transferred sense) a list of magistrates."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb374045-3b8f-3932-91cf-2fb2ff9cfdbd",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "A novel published in two volumes forming one continuous story (as opposed to a duology or dilogy)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "156112b5-5fdb-3c54-9195-fb07693e20eb",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "A literary work consisting of two contrasting parts, such as a narrative telling the same story from two opposing points of view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07423086-d1a3-4980-a3ce-4d5210171e50",
                                                "sense_id": "156112b5-5fdb-3c54-9195-fb07693e20eb",
                                                "text": "A very simple narrative, a diptych, a pastoral in which the author narrates the birth of Christ […] first as it has impressed the rich countryman Asveer, then as it has been seen by the skeptic Nicodemus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352857a7-bdc8-336a-9405-21cb314d0edd",
                                        "entry_id": "bd6d7072-bbfc-38c3-914a-73724301e35d",
                                        "glosses": [
                                            "Any work made up of two parts treating complementary or contrasting aspects of one general topic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36106bef-9051-4e6f-b86a-92520e3435a8",
                                                "sense_id": "352857a7-bdc8-336a-9405-21cb314d0edd",
                                                "text": "“Vegetation of the Sonoran Desert” is the first volume of a diptych “Vegetation and Flora of the Sonoran Desert,” for which Ira L. Wiggins is to write the companion volume on the flora."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
