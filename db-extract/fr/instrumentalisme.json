                        "entry_id": "d71b1151-9c07-334d-a5ce-c9a1001f888c",
                        "glosses": [
                            "Position qui considère que les modèles scientifiques ne sont que des instruments nous permettant de concevoir commodément les phénomènes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b6cfdf8-4524-4733-afdc-4ba0abc36a85",
                                "sense_id": "5e375db9-7a03-3822-8608-81d1f5eac990",
                                "text": "En revanche, l’instrumentalisme sous toutes ses formes est une position qu’il est plus difficile d’attaquer sur des bases philosophiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
