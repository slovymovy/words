        "fr-extract.jsonl": [
            {
                "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                "word": "entêtement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d621c519-5677-4b07-8bc8-2077d3e9790c",
                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "entêtements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "glosses": [
                            "Attachement opiniâtre d’une personne à ses opinions, à ses goûts, à ses vues, à ses projets, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a3111a-bf9a-4bfd-8755-dc21fb456da3",
                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                "text": "Il était d’un entêtement de brute ; devant une volonté étrangère, nettement formulée, il se serait emporté grossièrement jusqu’à battre les gens."
                            },
                            {
                                "example_id": "be9aa9d9-358d-41d4-8b6e-2d5650f95d57",
                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                "text": "Sur le même ton caustique, elle décrivait ses trois mariages soldés par deux divorces et un veuvage, son entêtement obsessionnel pour racheter sa bastide, mais aussi ses souvenirs de jeunesse à l’époque des gemmeurs et de la splendeur des Nogaro."
                            },
                            {
                                "example_id": "08f60b9f-6831-4b0e-bbcb-76c7dc2d9a58",
                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "glosses": [
                            "Engouement pour une personne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eb5e96f9-af16-4bfc-ae60-791cbc17b22e",
                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                "text": "Il a un grand entêtement pour cette femme."
                            },
                            {
                                "example_id": "1f776b7b-cc35-4588-8571-a0f45a1e4fb4",
                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                "text": "Rien ne la lasse, elle tient bon ! Je le lui dis, ce n’est pas de l’amour, c’est de l’entêtement."
                            },
                            {
                                "example_id": "72e15f3a-3911-4184-9ce9-0b27e7a48653",
                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                "text": "Maintes fois tu m’as blessée en entretenant Juliette ou Abel de ce qui eût dû rester entre toi et moi, et c’est bien là ce qui, longtemps avant que tu t’en doutes, m’a fait penser que ton amour était surtout un amour de tête, un bel entêtement intellectuel de tendresse et de fidélité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd27760c-85a1-40cc-ace5-4a98bde4db08",
                        "source_entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "target_lang_word": "Sturheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sturheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d062c190-c9fc-3cf1-8f28-5640331ce75a",
                                        "entry_id": "b4a91a26-c9d9-397f-b31c-aec80a53e034",
                                        "glosses": [
                                            "die Eigenschaft, stur oder unnachgiebig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7216ab5-abda-4170-8653-64d876f512c7",
                                                "sense_id": "d062c190-c9fc-3cf1-8f28-5640331ce75a",
                                                "text": "Die sprichwörtliche Sturheit des Esels entpuppt sich bei näherer Betrachtung oft als Intelligenz."
                                            },
                                            {
                                                "example_id": "e52ec08d-6f59-4d9c-92cd-85479c036d52",
                                                "sense_id": "d062c190-c9fc-3cf1-8f28-5640331ce75a",
                                                "text": "„Sturheit obsiegt, sie scheint bis auf den heutigen Tag unheilbar.“"
                                            },
                                            {
                                                "example_id": "3b84b98f-6f71-4716-80bb-952c5e9fe714",
                                                "sense_id": "d062c190-c9fc-3cf1-8f28-5640331ce75a",
                                                "text": "„Aus Sturheit oder Pflichtgefühl ließ er sie sofort festnehmen und als Gefangene abtransportieren, und damit war die kurze Fraternisierung beendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b041525d-fd68-40ca-abcc-3ea06dd54eb3",
                        "source_entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "target_lang_word": "Eigensinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigensinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                        "entry_id": "ba59cf12-a310-3c67-a72f-a5867bc6f273",
                                        "glosses": [
                                            "hartnäckiges Beharren auf einer Meinung oder Absicht (ohne den Rat anderer anzunehmen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4fe487-6c5b-4445-8cdd-7db9e6cff776",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "Er sperrte sich aus Eigensinn dagegen."
                                            },
                                            {
                                                "example_id": "ca706464-034c-4734-9c53-2b42bfe955e8",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Offensichtlich schadete diese Niederlage, die mehr römischem Eigensinn als seiner Unfähigkeit zu verdanken ist, seiner Karriere nicht.“"
                                            },
                                            {
                                                "example_id": "fd05efd4-e327-4992-8490-8b175d12b58d",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Die Renaissance des Begriffs [‚Heimat‘] begann demnach in den 70er-Jahren, als der lokale Eigensinn eine neue Protestkultur gegen die zentrale Planung von oben wachsen ließ.“"
                                            },
                                            {
                                                "example_id": "42921c68-20b9-4570-82e2-0b1587ac278f",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Die Pedanterie zählt neben Rigidität, Perfektionismus und Eigensinn aus heutiger psychologischer Sicht zu den Kernsymptomen der zwanghaften Persönlichkeitsstörung (ICD-10: F60.5).“"
                                            },
                                            {
                                                "example_id": "6bdee229-c84c-4d51-9594-d6c9e73529ed",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„So viel Eigensinn musste bestraft werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ef0919-3e1f-4fc8-80b4-e4d236ee5c48",
                        "source_entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                        "target_lang_word": "Eigenwille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9445fa22-5899-4d23-b772-fbedaa253d0f",
