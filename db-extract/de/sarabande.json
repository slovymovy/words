                    {
                        "sense_id": "428819ed-6f1b-35d9-a895-7b226a210cba",
                        "entry_id": "fa74f7ee-5a49-3964-8c00-10eb8f655970",
                        "glosses": [
                            "langsamer, höfischer Tanz des Barock"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba5d608-ea68-4bff-b089-0bf1db3ec487",
                                "sense_id": "428819ed-6f1b-35d9-a895-7b226a210cba",
                                "text": "„Am Ende der Mahlzeit fragte mein Vater den Marquis, ob er mich die Sarabande lehren könne.“"
                            },
                            {
                                "example_id": "881eb363-e297-419e-9168-40fd3211bf00",
                                "sense_id": "428819ed-6f1b-35d9-a895-7b226a210cba",
                                "text": "„Sie bemerkte ihn nicht und versuchte einige Tanzschritte von einer Sarabande.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
