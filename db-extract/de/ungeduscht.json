                                        "glosses": [
                                            "Not watered by showers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1894266-43af-4f91-b2bf-2a982a7d76d5",
                                                "sense_id": "44d157ee-4e36-39aa-81ab-efc8f7be106a",
                                                "text": "Nor is Osiris seen\nIn Memphian grove or green,\nTrampling the unshowered grass with lowings loud."
