                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4153f0a3-4a38-472f-bd1b-bb98d08898e5",
                                                "sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                                                "text": "Immer wieder fanden sie auffällig häufig Antikörper gegen die Bazille im Blut von Herz-Kreislauf-Kranken, doch nur um in anderen Studien mit gegenteiligen Befunden konfrontiert zu werden."
                                            },
                                            {
                                                "example_id": "0a89a2c4-c01e-436c-a1d5-016c7ade532f",
                                                "sense_id": "8f09bc82-409b-3ed3-ae64-5e7f087d103d",
                                                "text": "Die Bazillen dauerhaft klein zu kriegen, ist eine Sisyphusarbeit, denn innerhalb von Stunden besiedeln die Mikroben frisch gereinigte Zahnoberflächen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
