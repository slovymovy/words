{
    "word_family": [
        "bougeotte",
        "débouger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae1d6bce-a6cc-356c-b20b-ff8777d5645a",
                    "sense_definition": "Changer de place ou ne pas rester immobile ; être en mouvement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est très agité et ne peut pas s'empêcher de <w>bouger</w> sur sa chaise."
                        },
                        {
                            "text": "Le médecin lui a demandé de ne pas <w>bouger</w> pendant toute la durée de la radio."
                        }
                    ],
                    "synonyms": [
                        "se déplacer",
                        "remuer"
                    ],
                    "antonyms": [
                        "s'immobiliser",
                        "rester"
                    ],
                    "common_phrases": [
                        "ne pas bouger",
                        "bouger de là"
                    ]
                },
                {
                    "sense_id": "8d8f6afc-8cad-3b34-a498-1c3ab34e34ab",
                    "sense_definition": "Déplacer quelque chose ou changer un objet de place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>bouger</w> cette table lourde pour faire de la place dans le salon."
                        },
                        {
                            "text": "Il a réussi à <w>bouger</w> le meuble sans l'aide de personne ce matin."
                        }
                    ],
                    "synonyms": [
                        "déplacer",
                        "remuer"
                    ],
                    "antonyms": [
                        "fixer"
                    ],
                    "common_phrases": [
                        "bouger les meubles"
                    ]
                },
                {
                    "sense_id": "e3acf2de-3ff6-3c35-8cc8-27a5fe75d025",
                    "sense_definition": "Mouvoir une partie précise de son corps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tellement mal au dos qu'il a du mal à <w>bouger</w> les jambes aujourd'hui."
                        },
                        {
                            "text": "Elle a simplement <w>bougé</w> la tête pour faire un signe d'assentiment discret."
                        }
                    ],
                    "synonyms": [
                        "agiter",
                        "remuer"
                    ],
                    "common_phrases": [
                        "bouger la tête",
                        "bouger les bras"
                    ]
                },
                {
                    "sense_id": "0b3eb3d9-0509-38f6-a4c2-8f5e3c30a1e5",
                    "sense_definition": "Quitter un endroit ou s'en aller.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est déjà tard et la fête se termine, on <w>bouge</w> d'ici maintenant ?"
                        },
                        {
                            "text": "Nous allons bientôt <w>bouger</w> pour ne pas rater notre train à la gare."
                        }
                    ],
                    "synonyms": [
                        "partir",
                        "s'en aller"
                    ],
                    "antonyms": [
                        "rester",
                        "demeurer"
                    ],
                    "common_phrases": [
                        "on bouge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "b9f6456b-b12f-36c0-b33f-869e546b7c29",
                    "sense_definition": "Sortir de l'inaction et se décider à agir énergiquement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu veux réussir cet examen important, il va falloir te <w>bouger</w> sérieusement."
                        },
                        {
                            "text": "Les citoyens attendent avec impatience que les élus commencent enfin à se <w>bouger</w>."
                        }
                    ],
                    "synonyms": [
                        "s'activer",
                        "se remuer"
                    ],
                    "antonyms": [
                        "stagner"
                    ],
                    "common_phrases": [
                        "se bouger les fesses",
                        "faire bouger les choses"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "351b60d2-44c3-352f-ab1e-f0efcab171d5",
                    "sense_definition": "Évoluer, progresser ou changer, en parlant d'une situation ou des choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis l'arrivée de la nouvelle directrice, les choses ont beaucoup commencé à <w>bouger</w>."
                        },
                        {
                            "text": "Le dossier est bloqué depuis des mois mais les négociations pourraient faire <w>bouger</w> les lignes."
                        }
                    ],
                    "synonyms": [
                        "évoluer",
                        "changer"
                    ],
                    "antonyms": [
                        "stagner"
                    ],
                    "common_phrases": [
                        "faire bouger les lignes"
                    ]
                },
                {
                    "sense_id": "72830d9a-e0f3-350b-aecb-9f91a3672fb4",
                    "sense_definition": "S'agiter d'une manière hostile, contester l'autorité ou se révolter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "revolte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde a averti les prisonniers qu'ils seraient punis s'ils osaient <w>bouger</w>."
                        },
                        {
                            "text": "Dans ce régime autoritaire, personne n'osait <w>bouger</w> de peur des représailles immédiates."
                        }
                    ],
                    "synonyms": [
                        "se révolter",
                        "protester"
                    ],
                    "antonyms": [
                        "se soumettre",
                        "obéir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "utilisé souvent comme mise en garde"
                        }
                    ]
                }
            ]
        }
    ]
}