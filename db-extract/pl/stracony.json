                                        "sense_id": "f27480bd-3ca1-3026-b612-8ea5ce30f4a2",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Not perceptible to the senses; no longer visible."
