                "translations": [
                    {
                        "translation_id": "45c864ed-d173-47ca-acc3-9f97ef2d87c3",
                        "source_entry_id": "1df10ba4-ed3c-3831-be3c-5448c67ea5e6",
                        "source_sense_description": "one of a fictional order of beings",
                        "target_lang_word": "Jedi",
