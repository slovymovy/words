                            },
                            {
                                "target_lang_word": "synthetisieren",
                                "target_lang_sense_clarification": "einen Stoff chemisch herstellen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制取",
                                "target_lang_sense_clarification": "通过化学过程制得某种物质"
                            },
                            {
                                "target_lang_word": "合成",
                                "target_lang_sense_clarification": "强调化学合成出新物质"
                            },
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "强调从原料中提取出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5691b8da-9eaa-36b5-b315-68d79b9dfbdc",
                    "sense_definition": "To divert the flow of water or a liquid into a different channel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "diversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient engineers built canals to <w>derive</w> water from the river to the fields.",
                            "target_lang_translations": {
                                "ru": "Древние инженеры строили каналы, чтобы <w>отводить</w> воду из реки на поля.",
                                "de": "Die antiken Ingenieure bauten Kanäle, um Wasser vom Fluss auf die Felder <w>abzuleiten</w>.",
                                "zh": "古代工程师修建运河，把河水<w>引流</w>到田地里。"
                            }
                        },
                        {
                            "text": "They had to <w>derive</w> the stream through a pipe to prevent the construction site from flooding.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>направить</w> поток через трубу, чтобы предотвратить затопление строительной площадки.",
                                "de": "Sie mussten den Bach durch ein Rohr <w>umleiten</w>, um eine Überflutung der Baustelle zu verhindern.",
                                "zh": "为了防止工地被淹，他们不得不把溪水通过管道<w>改道</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "divert",
                        "channel",
                        "redirect"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English for physical liquids"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отводить поток воды или жидкости в другое русло.",
                        "de": "Den Fluss von Wasser oder einer Flüssigkeit in ein anderes Bett oder einen anderen Kanal lenken.",
                        "zh": "把水流或液体引到另一条水道或通道中去。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "поток воды"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "жидкость в канал"
                            }
                        ],
