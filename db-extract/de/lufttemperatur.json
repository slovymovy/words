                        "cross_references": [
                            {
                                "target_word": "luchttemperatuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36e7db65-b48c-3326-9549-b3bc3cdccd7f",
                                        "entry_id": "7c6ba804-a170-3d8c-ac39-ce72c16af9fb",
                                        "glosses": [
                                            "temperatuur van de buitenlucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ae773e4-bee1-4d64-b6b0-05d8fd1d1da4",
                                                "sense_id": "36e7db65-b48c-3326-9549-b3bc3cdccd7f",
                                                "text": "Het voorspellen van extreem weer is lastig, zegt Groenland. En zeker bij de zware buien en valwinden. \"Het ontstaan daarvan is van zoveel factoren afhankelijk, zoals de luchttemperatuur en de hoeveelheid vocht. Dat kan van uur tot uur verschillen. Je weet vaak pas een kwartier ervoor waar de bui precies ontstaat. En dan ben je meestal al te laat voor een waarschuwing.\" Een systeem dat lijkt op NL-Alert zou dat probleem kunnen ondervangen."
                                            },
                                            {
                                                "example_id": "db0c865b-6a12-498e-a8ab-e8107e009574",
                                                "sense_id": "36e7db65-b48c-3326-9549-b3bc3cdccd7f",
                                                "text": "Het is geen toeval dat daar juist vanavond een begin mee wordt gemaakt. Het moet in het donker gebeuren omdat de aaltjes niet tegen uv-licht kunnen. Het mag niet regenen of waaien én als de aaltjes worden ingespoten moet de luchttemperatuur boven de 6 graden zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
