                    },
                    {
                        "sense_id": "d4704c0c-9f88-3381-981e-8bd0c9699dce",
                        "entry_id": "6275a597-f844-3225-9d15-ef01a8e4aace",
                        "glosses": [
                            "Stauung oder Stockung (besonders des Blutes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277ee69a-1107-4422-b8ad-0de257199c57",
                                "sense_id": "d4704c0c-9f88-3381-981e-8bd0c9699dce",
                                "text": "„Denn beim Sex hat die absolute Stasis keinen Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
