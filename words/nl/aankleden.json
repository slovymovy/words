                {
                    "sense_id": "ab257589-3708-37ec-a0f7-e59dd7e839b0",
                    "sense_definition": "Zichzelf kleren aandoen; kleding aantrekken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_reflexive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je warm <w>aankleden</w> als het buiten koud is.",
                            "target_lang_translations": {
                                "en": "You need to <w>dress</w> warmly when it is cold outside.",
                                "ru": "Ты должен тепло <w>одеться</w>, когда на улице холодно.",
                                "it": "Devi <w>vestirti</w> pesante quando fuori fa freddo.",
                                "zh": "外面冷的时候，你得穿得<w>暖和</w>点。"
                            }
                        },
                        {
                            "text": "Hij is zich boven aan het <w>aankleden</w>.",
                            "target_lang_translations": {
                                "en": "He is upstairs <w>getting dressed</w>.",
                                "ru": "Он <w>одевается</w> наверху.",
                                "it": "Si sta <w>vestendo</w> di sopra.",
                                "zh": "他正在楼上<w>穿衣服</w>。"
                            }
                        }
                    ],
                    "antonyms": [
