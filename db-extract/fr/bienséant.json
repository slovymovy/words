                ],
                "senses": [
                    {
                        "sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                        "entry_id": "4644e652-ad9a-33f2-8ee3-65991a1749d7",
                        "glosses": [
                            "Qu’il sied bien de faire, de dire, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2843f59-bf74-4c3e-b353-9a731c0e6d29",
                                "sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                                "text": "Une espèce de force contre-nature l’avait poussé loin de ses camarades avec lesquels il venait de faire connaissance, les prenant pour des hommes bienséants et mondains."
                            },
                            {
                                "example_id": "d3b1268d-c57d-4fc8-92c0-c9ccfddf612f",
                                "sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                                "text": "Il est bienséant aux jeunes gens de respecter la vieillesse, de n’être pas trop pressés de parler."
                            },
                            {
                                "example_id": "f998b1e4-c9ec-4b0f-90bf-ecd5311de40e",
                                "sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                                "text": "Cela n’est pas bienséant."
                            },
                            {
                                "example_id": "3942854a-9f0d-47c2-b76c-8b970dba39e2",
                                "sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                                "text": "Une telle réponse est peu bienséante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00d87917-0910-4827-ba47-26787ebb0034",
                        "source_entry_id": "4644e652-ad9a-33f2-8ee3-65991a1749d7",
                        "source_sense_id": "f6f13c9d-8444-3256-8a50-085114e62002",
                        "target_lang_word": "seemly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seemly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e29d265-e8e2-300c-ad72-f9e349e99650",
                                        "entry_id": "4adc6775-353a-3a80-ae28-e645c381ac8a",
                                        "glosses": [
                                            "Of behavior, appropriate; suited to the occasion or purpose; becoming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf94446-1893-49d2-83e0-a3d0d230aaa3",
                                                "sense_id": "9e29d265-e8e2-300c-ad72-f9e349e99650",
                                                "text": "His behavior was seemly, as befits a gentleman."
                                            },
                                            {
                                                "example_id": "2ce36445-45a6-445b-9a69-ef676ecd5e17",
                                                "sense_id": "9e29d265-e8e2-300c-ad72-f9e349e99650",
                                                "text": "I am a woman, lacking wit / To make a seemly answer to such persons."
                                            },
                                            {
                                                "example_id": "4dff5449-fd6f-4f9d-aad1-cf5fd204d847",
                                                "sense_id": "9e29d265-e8e2-300c-ad72-f9e349e99650",
                                                "text": "Suspense of judgment and exercise of charity were safer and seemlier for Christian men than the hot pursuit of these controversies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seemly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3b5ff03-7fe0-3cbe-8350-320b32dd32e7",
                                        "entry_id": "4c1f149c-177d-3514-a4a6-1e8b33e90dd5",
                                        "glosses": [
                                            "Appropriately, fittingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1aa1030-8da4-4608-9319-c62462a347a8",
                                                "sense_id": "e3b5ff03-7fe0-3cbe-8350-320b32dd32e7",
                                                "text": "The great earthes wombe they open to the sky, / And with sad Cypresse seemely it embraue [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
