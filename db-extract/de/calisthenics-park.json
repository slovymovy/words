                "senses": [
                    {
                        "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                        "entry_id": "9122080f-3347-3fe6-a955-e3a3361d0b02",
                        "glosses": [
                            "öffentliche Trainingsanlage mit verschiedenen Geräten für Körpergewichtsübungen, oft in einem Park oder auf einem Spielplatz"
                        ],
                        "tags": [
                            "Calisthenics"
                        ],
                        "examples": [
                            {
                                "example_id": "514b7d4a-1e1c-4643-8a06-78a448b981a6",
                                "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                                "text": "„Auf dem Naherholungsgelände gibt es mit Bäumen bewachsene weitläufige Wiesenflächen, Blumenbeete und Wege sowie einen künstlich angelegten Teich, einen Kinderspielplatz und einen Calisthenics-Park.“"
                            },
                            {
                                "example_id": "e4957cca-3baf-4eb1-87e2-7058a9dd5753",
                                "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                                "text": "„Der nahegelegene Idasee mit Abendteuerspielplatz, Calisthenics-Park und einer Wasserskianlage bietet für alle Altersklassen ein interessantes Freizeitangebot und einen sehr hohen Erholungsfaktor.“"
                            },
                            {
                                "example_id": "f377a3d1-9907-4e2a-88cc-e59c47501d05",
                                "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                                "text": "„Ein Calisthenics-Park für den privaten Garten muss anderen Anforderungen genügen als eine modulare Outdoor-Anlage für den öffentlichen Bereich wie einen Park oder eine öffentliche Sportstätte.“"
                            },
                            {
                                "example_id": "b337f227-26a0-419c-b2d7-cbbc53bca75c",
                                "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                                "text": "„Als im letzten Schuljahr im Unterricht die Aufgabe lautete, ein Realprojekt mit nachhaltigem Nutzen auf die Beine zu stellen, kam den beiden Sportbegeisterten die Idee, für ihre Schule und vielleicht sogar für ganz Handewitt einen sogenannten Calisthenics-Park zu etablieren.“"
                            },
                            {
                                "example_id": "757fa441-0072-47e7-8ae1-006afbc6954a",
                                "sense_id": "3bb9cd67-ed53-3963-8f7d-833a343d8e17",
                                "text": "„Dass dieses Motto beim Calisthenics-Park in direkter Nähe zum Gymnasium Bad Essen Programm ist, zeigten besonders die Kleinsten bei einigen Übungen im Rahmen der offiziellen Scheckübergabe durch Guido Pott, Kuratoriumsmitglied der Stiftung LAUTER.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
