                                                "example_id": "7ad340e1-f8fb-4ae7-a1a5-b1959c2b762e",
                                                "sense_id": "b9323597-57af-351e-a598-5e74ca9118aa",
                                                "text": "Beim Bambus beträgt das Wachstum bis zu zehn Zentimeter pro Tag."
                                            },
                                            {
                                                "example_id": "361df20a-5467-4a94-a92c-bfdf73109b5d",
                                                "sense_id": "b9323597-57af-351e-a598-5e74ca9118aa",
                                                "text": "„In diesem lebendigen Kosmos des organischen Wachstums erscheinen das aschene Schwarz und somit die mächtigen Linien in Klees Spätwerk zunächst als Auslöschung alles Vitalen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                        "entry_id": "46882e63-4bf4-37d4-a33b-da8fc3967799",
                                        "glosses": [
                                            "Zunahme an Umfang, Größe, Menge, Intensität von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085a62fe-2f99-42c3-83e3-188a53ebd16b",
                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Wir müssen dem Wachstum der versiegelten Flächen Einhalt gebieten."
                                            },
                                            {
                                                "example_id": "8dec2ec6-a9b8-4668-93a0-2030d693a2d4",
                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Für Deutschland wurde ein Wachstum von lediglich einem Prozent prognostiziert."
                                            },
                                            {
                                                "example_id": "26bfb38f-6142-40a1-abe6-05791cfce83c",
                                                "sense_id": "7edcafeb-c116-3e86-8d8e-49d8dcdef81b",
                                                "text": "Das Wachstum der Weltbevölkerung beschleunigt sich weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
