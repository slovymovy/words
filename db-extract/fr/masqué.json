                            {
                                "example_id": "3db71e28-c8cd-4a88-b7a5-f2a7fb4c32a1",
                                "sense_id": "6580edad-9d16-3c71-8bc9-216ecb861b51",
                                "text": "Femme masquée."
                            },
                            {
                                "example_id": "82a044a7-dd69-4ace-89ef-a910835418d4",
                                "sense_id": "6580edad-9d16-3c71-8bc9-216ecb861b51",
                                "text": "Voleurs, bandits masqués."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd9bc10-b729-3bb5-b75e-33d0e5505acd",
                        "entry_id": "b95a36e6-78b7-3d70-bbbe-298aeb905aa0",
                        "glosses": [
                            "Se d'un d’un animal dont la face est d'un couleur différente de celle du corps, généralement plus sombre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbc54d64-8e74-324d-b8ed-e6dcb3ac27ed",
                        "entry_id": "b95a36e6-78b7-3d70-bbbe-298aeb905aa0",
                        "glosses": [
                            "Se dit d’un animal portant sur un masque sur la face."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5fdcaa4a-2ef7-3ed1-8e14-3b5f60375af2",
                        "entry_id": "b95a36e6-78b7-3d70-bbbe-298aeb905aa0",
                        "glosses": [
                            "Avoir le visage renfrogné, fermé, triste et hostile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1cdabb-12d8-4c05-a131-80b2f55c2c88",
                                "sense_id": "5fdcaa4a-2ef7-3ed1-8e14-3b5f60375af2",
                                "text": "Elle me fourre sa langue dans la bouche. Je la renverse sur les galets. On frotte. Nous sommes tout rouges. Lyse se repointe, sortant de l'eau, comprend immédiatement et demeure masquée tout le reste de la journée."
                            }
                        ]
                    }
