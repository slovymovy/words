                ],
                "senses": [
                    {
                        "sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                        "entry_id": "7a349176-253a-3b55-b09e-06271dcfa078",
                        "glosses": [
                            "Not noticed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae258681-0cdb-4e3d-b42e-54f815ac0f19",
                                "sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                                "text": "In the midst of a world war many centenaries pass unnoticed, but one which fell on August 2, namely, the opening of Fenchurch Street station, is deserving of record."
                            },
                            {
                                "example_id": "b2c43077-395c-43dd-88d8-f1c9a33c8ad9",
                                "sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                                "text": "The announcement was slipped out almost unnoticed on the last day before Parliament was dissolved to prepare for a General Election."
                            },
                            {
                                "example_id": "b97db44a-6aeb-4cde-ae6b-bce0340f72b7",
                                "sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                                "text": "The change of blue of the flags adorning the Elysée Palace was first made a year ago but went largely unnoticed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77e8237a-70c8-4f41-9505-9234390b5e95",
                        "source_entry_id": "7a349176-253a-3b55-b09e-06271dcfa078",
                        "source_sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
