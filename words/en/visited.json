    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08b4417a-9af3-3fd6-a4a7-818006a26294",
                    "sense_definition": "Past tense and past participle of <w>visit</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Last summer we <w>visited</w> our grandparents in the countryside.",
                            "target_lang_translations": {
                                "ru": "Прошлым летом мы <w>навестили</w> бабушку с дедушкой в деревне."
                            }
                        },
                        {
                            "text": "She has <w>visited</w> several museums during her stay in London.",
                            "target_lang_translations": {
                                "ru": "Во время своего пребывания в Лондоне она <w>посетила</w> несколько музеев."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола visit (навещать, посещать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посетил",
                                "target_lang_sense_clarification": "место или достопримечательность"
                            },
                            {
                                "target_lang_word": "навестил",
                                "target_lang_sense_clarification": "человека, родственников"
                            },
                            {
                                "target_lang_word": "побывал",
                                "target_lang_sense_clarification": "в каком-либо месте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d895b23-ff22-3ce1-81c7-7c47de30cfe3",
                    "sense_definition": "Having received one or more visits; frequented by guests, travelers, or tourists.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This historic castle is one of the most <w>visited</w> sites in the region.",
                            "target_lang_translations": {
                                "ru": "Этот исторический замок — одно из самых <w>посещаемых</w> мест в регионе."
                            }
                        },
                        {
                            "text": "The small gallery remained a rarely <w>visited</w> corner of the city.",
                            "target_lang_translations": {
                                "ru": "Маленькая галерея оставалась редко <w>посещаемым</w> уголком города."
                            }
                        }
                    ],
                    "synonyms": [
                        "frequented"
                    ],
                    "antonyms": [
                        "unvisited"
                    ],
                    "common_phrases": [
                        "most visited",
                        "frequently visited",
                        "heavily visited"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, в котором часто бывают гости, туристы или путешественники; посещаемый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посещаемый",
                                "target_lang_sense_clarification": "о месте, сайте, достопримечательности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
