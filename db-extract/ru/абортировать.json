                                    },
                                    {
                                        "sense_id": "5755c2e4-6287-3f89-9169-a8e122443455",
                                        "entry_id": "89da7bee-30d2-3f85-8180-9ea0ec7642bd",
                                        "glosses": [
                                            "To terminate a mission involving a missile or rocket; to destroy a missile or rocket prematurely."
