                "senses": [
                    {
                        "sense_id": "37d6cab8-4e63-3f7e-9e45-9b14d7f4bc42",
                        "entry_id": "a83507cd-9f31-3343-b8fd-b742fb505815",
                        "glosses": [
                            "Toilette, die für Männer vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbc64ed-8d2e-483a-8124-23152869f33a",
                                "sense_id": "37d6cab8-4e63-3f7e-9e45-9b14d7f4bc42",
                                "text": "„Er sah korrekt aus; das hatte er auf der Herrentoilette am Bahnhof im Spiegel überprüft.“"
                            },
                            {
                                "example_id": "d2217a73-192c-4e99-bf71-05b3af1ad0ac",
                                "sense_id": "37d6cab8-4e63-3f7e-9e45-9b14d7f4bc42",
                                "text": "„Cheryl eilte aus der Herrentoilette.“"
                            },
                            {
                                "example_id": "d5587a53-eb94-4e19-aa40-c0b470c0dcf3",
                                "sense_id": "37d6cab8-4e63-3f7e-9e45-9b14d7f4bc42",
                                "text": "„An der Tigard High School schmiert ein unbekannter Jugendlicher seine Scheiße an die Wände der Herrentoilette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
