                "senses": [
                    {
                        "sense_id": "0cc1ad22-affd-342b-ace3-a0e7c633d5fb",
                        "entry_id": "012acb72-b2c9-3900-bd92-a191d41d14d5",
                        "glosses": [
                            "bliksem die door de hemel schiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0649d65-1af0-44ed-ae6e-77e11b05a495",
                                "sense_id": "0cc1ad22-affd-342b-ace3-a0e7c633d5fb",
                                "text": "Het luchtschip doorkliefde een wolkendek waaruit bliksemschichten opvonkten."
                            }
                        ]
                    },
                    {
                        "sense_id": "c61125f3-a1fb-3b6d-bd33-e6b9d5d41fad",
                        "entry_id": "012acb72-b2c9-3900-bd92-a191d41d14d5",
                        "glosses": [
                            "plotselingen inval"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "636cc645-7cac-4bfc-a37e-eaff0885c0d7",
                                "sense_id": "c61125f3-a1fb-3b6d-bd33-e6b9d5d41fad",
                                "text": "‘En daar in het schijthuis van het klooster werd ik als door een bliksemschicht getroffen door de idee dat de rechtvaardigen zullen leven door het geloof alleen.’ Zo omschrijft Maarten Luther in 1532, in een van zijn beroemde tafelredes, het moment in 1515 waarop hij voor het eerst de genade van God ervoer."
                            },
                            {
                                "example_id": "6939f836-9ed8-44df-9fa4-a5f97b7c2075",
                                "sense_id": "c61125f3-a1fb-3b6d-bd33-e6b9d5d41fad",
                                "text": "De meeste ontladingen vinden in de wolk zelf plaats. Maar soms is het spanningsverschil tussen de wolk en het aardoppervlak te groot en dan slaat de bliksem in. \"Bij een ontlading zoeken de deeltjes elkaar op via de weg van de minste weerstand. Dat is de bliksemschicht die wij zien."
                            }
                        ]
                    }
