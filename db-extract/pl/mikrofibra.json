                        "entry_id": "df5787c6-e90d-3a2c-83c0-a45e716e143a",
                        "glosses": [
                            "syntetyczne włókno o bardzo małej średnicy (poniżej 10 mikrometrów), zwykle wykonane z mieszanki poliesteru i poliamidu, charakteryzujące się wysoką chłonnością, miękkością oraz trwałością, szeroko stosowane w produkcji tkanin do czyszczenia, odzieży sportowej i tekstyliów domowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e13cf9e-b524-42ce-b757-73edee8f032c",
                                "sense_id": "aac7c8b0-db8d-3240-ab1d-8c896401f35f",
                                "text": "Proszę opisać zalety mikrofibry w porównaniu z bawełną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
