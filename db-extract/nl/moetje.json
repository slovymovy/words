                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0eedf0df-4aaf-34d9-8d53-3b60f97d83f8",
                                        "entry_id": "acd16d44-a57b-3f21-866f-1509368afa00",
                                        "glosses": [
                                            "A wedding in which the bride is already pregnant."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a49a5d2a-f7af-4d50-99d6-ad2cc6962bc7",
                                                "sense_id": "0eedf0df-4aaf-34d9-8d53-3b60f97d83f8",
                                                "text": "If Red Skelton's joke can still elicit laughs, it is only because there is a minority who can still remember a shotgun wedding and even recall the understandings that lay behind that insistence, now seeming quaint, that a couple sleeping together should really be married."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08b060cd-14fe-36d1-aee9-783bbfa8ac00",
                                        "entry_id": "acd16d44-a57b-3f21-866f-1509368afa00",
                                        "glosses": [
                                            "A wedding which is made in haste or under duress."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ab390c5-9282-38df-8b07-386f4e4a61da",
                                        "entry_id": "acd16d44-a57b-3f21-866f-1509368afa00",
                                        "glosses": [
                                            "Any similarly reputedly forced partnership, between people, organizations, components, or concepts."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b6bb73-aac3-4fb2-85e6-15376ac1339f",
                                                "sense_id": "1ab390c5-9282-38df-8b07-386f4e4a61da",
                                                "text": "But all this fails when we try to have a shotgun wedding between the two great theories of nature, relativity and quantum theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
