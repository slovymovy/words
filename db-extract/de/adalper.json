                        "examples": [
                            {
                                "example_id": "56be30fc-e982-4f11-a5b1-c3b39cd7513a",
                                "sense_id": "15f67c01-a667-3a1d-b783-2a71f13e2437",
                                "text": "„Aus einer urkundlich nicht benannten Gemahlin hatte erwähnter Adalper Niger II., wie es scheint, nur einen einzigen Sohn, Niger II., welcher, als der jüngere, häufig Negerle benannt wurde, erzeugt, der aber im blühendsten Mannesalter, noch vor dem Vater Adalper schon um’s Jahr 1370 dem Tode als Beute fiel, aus einer ungenannten Gemahlin einen urkundlich nachweisbaren Sohn, Leonard, hinterlassend; …“"
                            }
                        ],
