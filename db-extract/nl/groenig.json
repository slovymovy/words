                "senses": [
                    {
                        "sense_id": "b55a8622-a33d-3eff-8307-283fa482914e",
                        "entry_id": "617e11a8-7bfb-3b72-a604-7286c2208711",
                        "glosses": [
                            "een beetje groen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c69e341-be5b-467d-8b45-dbf7e963ad63",
                                "sense_id": "b55a8622-a33d-3eff-8307-283fa482914e",
                                "text": "Na zijn val had zijn gezicht iets groenigs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bdda04c-4f12-3783-8414-4dbd6cd4f268",
                        "entry_id": "617e11a8-7bfb-3b72-a604-7286c2208711",
                        "glosses": [
                            "op groen lijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45319ec3-36f0-4ae3-9a04-8c85e55b01b0",
                                "sense_id": "2bdda04c-4f12-3783-8414-4dbd6cd4f268",
                                "text": "Dit blauw is bijna groenig."
                            },
                            {
                                "example_id": "07ea5f94-2701-4c40-a44f-fb0bb82937af",
                                "sense_id": "2bdda04c-4f12-3783-8414-4dbd6cd4f268",
                                "text": "Het water dat ik in Zuid-Californië tegenkwam was niet altijd even geweldig, het was vaak stilstaand en groenig van kleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b5a67df-72ed-4a34-ad58-52c1e0528f29",
                        "source_entry_id": "617e11a8-7bfb-3b72-a604-7286c2208711",
                        "source_sense_id": "2bdda04c-4f12-3783-8414-4dbd6cd4f268",
                        "source_sense_description": "op groen lijkend",
                        "target_lang_word": "grünlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grünlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                        "entry_id": "bbf9a75b-5cbd-30ae-86b3-daddd40f2492",
                                        "glosses": [
                                            "eine ins Grüne spielenden (sich der Farbe Grün nähernden) Farbe habend; der Farbe Grün ähnlich; an Grün erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a08370-ced2-476a-91ae-595a5320f863",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Er wurde leicht grünlich im Gesicht."
                                            },
                                            {
                                                "example_id": "d02b9da7-dade-4dc3-af87-483a9de50a6f",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Lichtblau bezeichnet ein leicht grünliches Hellblau."
                                            },
                                            {
                                                "example_id": "af1ccd47-483f-4239-85a9-baab0e199f66",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "Die Wand war grünlich gefärbelt."
                                            },
                                            {
                                                "example_id": "e437b380-b525-44e4-8404-511918f6d1ab",
                                                "sense_id": "b07c49b3-00ac-3690-821a-975f8b613a91",
                                                "text": "„Der ganze Kniff sei, sich nie etwas durchgehen zu lassen, sagte er zu Frau Schobel, seiner Zimmervermieterin, und bat um noch ein Glas der grünlichen Molke, vor der es ihn so ekelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1187919-6254-482f-9e46-05e9589ad63c",
                        "source_entry_id": "617e11a8-7bfb-3b72-a604-7286c2208711",
                        "source_sense_id": "2bdda04c-4f12-3783-8414-4dbd6cd4f268",
