                "senses": [
                    {
                        "sense_id": "96802435-b30a-33b6-b205-fddfd15791fc",
                        "entry_id": "4ab9a27d-6c2b-3802-aa25-7366192abd8f",
                        "glosses": [
                            "Arbeiter im zaristischen Russland, der als Schiffszieher/Treidler an der Wolga tätig war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "976ff150-b129-4c94-b091-94f5a8b5d7ec",
                                "sense_id": "96802435-b30a-33b6-b205-fddfd15791fc",
                                "text": "Die Zahl der Burlaken längs der Wolga von Astrachan bis Rybinsk mag gegen 100,000 betragen."
                            },
                            {
                                "example_id": "e847af82-0b97-4839-ab38-c70e1119f129",
                                "sense_id": "96802435-b30a-33b6-b205-fddfd15791fc",
                                "text": "Allerdings schmälert die auf der Wolga zunehmende Dampfschifffahrt, namentlich die Bugfirschiffe, von Jahr zu Jahr mehr das Geschäft der Burlaken, aber noch immer kann man mit Zuverlässigkeit annehmen, daß es deren in Astrachan 10,000, in Samara etwa 15,000, in Kasan 20,000 und in den anderen Häfen der Wolga und Kamagebiets über 30,000 gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
