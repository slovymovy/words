{
    "word_family": [
        "tattler",
        "tattletale"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55fbd5b7-7709-35ff-b985-d7c88e760875",
                    "sense_definition": "Idle talk or gossip.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office was full of <w>tattle</w> about who would be promoted next month.",
                            "target_lang_translations": {
                                "tr": "Ofis, gelecek ay kimin terfi alacağı hakkında <w>dedikodu</w> ile doluydu."
                            }
                        },
                        {
                            "text": "She ignored the idle <w>tattle</w> and focused on her own work.",
                            "target_lang_translations": {
                                "tr": "Boş <w>dedikoduları</w> görmezden geldi ve kendi işine odaklandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "tittle-tattle"
                    ],
                    "common_phrases": [
                        "idle tattle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Boş konuşma, dedikodu veya gereksiz laf."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dedikodu",
                                "target_lang_sense_clarification": "Başkaları hakkında yapılan asılsız veya gereksiz konuşmalar."
                            },
                            {
                                "target_lang_word": "boş laf",
                                "target_lang_sense_clarification": "Anlamsız veya önemsiz konuşmalar."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eacfeda-1775-3ae2-8125-a41bf511ee1a",
                    "sense_definition": "A report of someone else's wrongdoing, typically made by a child to an authority figure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told the students that she did not want to hear any more <w>tattle</w> during class time.",
                            "target_lang_translations": {
                                "tr": "Öğretmen öğrencilere ders sırasında daha fazla <w>ispiyon</w> duymak istemediğini söyledi."
                            }
                        },
                        {
                            "text": "He brought a <w>tattle</w> to the teacher about his classmate breaking the rules.",
                            "target_lang_translations": {
                                "tr": "Sınıf arkadaşının kuralları çiğnediğine dair öğretmene bir <w>ispiyon</w> getirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "tale"
                    ],
                    "common_phrases": [
                        "bring a tattle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the context of children."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle çocuklar tarafından bir otorite figürüne başkasının yanlış davranışını bildirme."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ispiyon",
                                "target_lang_sense_clarification": "Birinin hatasını yetkiliye bildirme eylemi."
                            },
                            {
                                "target_lang_word": "şikayet",
                                "target_lang_sense_clarification": "Bir durumu veya kişiyi şikayet etme durumu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b90ae3-ee8c-37a2-9cdb-10e692fe1901",
                    "sense_definition": "A person who habitually reports the wrongdoings of others.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody in the group trusted him because he was known as a <w>tattle</w>.",
                            "target_lang_translations": {
                                "tr": "Gruptaki kimse ona güvenmiyordu çünkü o bir <w>ispiyoncu</w> olarak bilinirdi."
                            }
                        },
                        {
                            "text": "The other children avoided the <w>tattle</w> during recess.",
                            "target_lang_translations": {
                                "tr": "Diğer çocuklar teneffüs sırasında <w>ispiyoncudan</w> uzak durdular."
                            }
                        }
                    ],
                    "synonyms": [
                        "informant"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarının yanlışlarını sürekli olarak yetkililere bildiren kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ispiyoncu",
                                "target_lang_sense_clarification": "Sürekli başkalarını şikayet eden kimse."
                            },
                            {
                                "target_lang_word": "muhbir",
                                "target_lang_sense_clarification": "Bilgi taşıyan veya şikayet eden kişi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7703070-3f4f-36f8-8300-6431335d92ac",
                    "sense_definition": "To report someone's wrongdoing to an authority figure in an annoying way.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not nice to <w>tattle</w> on your friends just to get them in trouble.",
                            "target_lang_translations": {
                                "tr": "Arkadaşlarını sadece başlarını belaya sokmak için <w>ispiyonlamak</w> hoş bir şey değildir."
                            }
                        },
                        {
                            "text": "The boy decided to <w>tattle</w> on his brother for breaking the vase.",
                            "target_lang_translations": {
                                "tr": "Çocuk, vazoyu kırdığı için kardeşini <w>ispiyonlamaya</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "rat out"
                    ],
                    "common_phrases": [
                        "tattle on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used regarding children."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin yanlışını rahatsız edici bir şekilde yetkiliye bildirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ispiyonlamak",
                                "target_lang_sense_clarification": "Birini şikayet etmek veya sırrını açığa çıkarmak."
                            },
                            {
                                "target_lang_word": "şikayet etmek",
                                "target_lang_sense_clarification": "Birinin hatasını otoriteye söylemek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f593d80f-fc2f-3f28-94a1-aa3ff13fba15",
                    "sense_definition": "To engage in idle talk or gossip.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors spent the whole afternoon <w>tattling</w> about the new family on the street.",
                            "target_lang_translations": {
                                "tr": "Komşular bütün öğleden sonrayı sokaktaki yeni aile hakkında <w>dedikodu yaparak</w> geçirdiler."
                            }
                        },
                        {
                            "text": "They love to <w>tattle</w> about everyone else's business.",
                            "target_lang_translations": {
                                "tr": "Herkesin işi hakkında <w>dedikodu yapmaya</w> bayılırlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "prattle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Boş konuşmak veya dedikodu yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dedikodu yapmak",
                                "target_lang_sense_clarification": "Başkaları hakkında konuşmak."
                            },
                            {
                                "target_lang_word": "çene çalmak",
                                "target_lang_sense_clarification": "Boş ve gereksiz konuşmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f0af37-6985-334d-9beb-f84b6142be12",
                    "sense_definition": "To speak in a childish, halting, or babbling manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler began to <w>tattle</w> in an unintelligible way while trying to explain his dream.",
                            "target_lang_translations": {
                                "tr": "Küçük çocuk rüyasını anlatmaya çalışırken anlaşılmaz bir şekilde <w>gevelemeye</w> başladı."
                            }
                        },
                        {
                            "text": "He could only <w>tattle</w> a few words before becoming frustrated with his stutter.",
                            "target_lang_translations": {
                                "tr": "Kekemeliği yüzünden sinirlenmeden önce sadece birkaç kelime <w>geveleyebildi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prattle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çocuksu, kesik kesik veya geveleyerek konuşmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gevelemek",
                                "target_lang_sense_clarification": "Anlaşılmaz veya çocuksu bir şekilde konuşmak."
                            },
                            {
                                "target_lang_word": "mırıldanmak",
                                "target_lang_sense_clarification": "Belirsiz sesler çıkarmak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}