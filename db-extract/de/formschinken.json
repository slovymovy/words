                "senses": [
                    {
                        "sense_id": "47738465-7c5d-354c-9687-966ec90b183f",
                        "entry_id": "f6869d60-8579-3c29-b757-110ff240bfed",
                        "glosses": [
                            "aus Fleischstücken zusammengefügtes und in eine bestimmte Form gepresstes Nahrungsmittel; Ersatzprodukt für Kochschinken"
                        ],
                        "tags": [
                            "Lebensmittelindustrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b59d4447-57f0-4e95-be23-68a0b9448b36",
                                "sense_id": "47738465-7c5d-354c-9687-966ec90b183f",
                                "text": "„Das mit Dioxin belastete Frühstücksei, Pestizid-Rückstände in Weintrauben, Paprika oder Erdbeeren, Keime im Fleisch, verunreinigter Formschinken für die Pizza – in Fachkreisen sind die Belastungen und Mängel von Lebensmitteln längst bekannt.“"
                            },
                            {
                                "example_id": "b6ff13ab-b419-40c9-a661-808e8ed30f04",
                                "sense_id": "47738465-7c5d-354c-9687-966ec90b183f",
                                "text": "„»Der Käufer muss inzwischen nicht mehr nur mit Analogkäse und Formschinken rechnen, sondern auch mit gestrecktem Pesto oder Schokoladenkeksen ohne Schokolade«, sagt Silke Schwartau von der Verbraucherzentrale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
