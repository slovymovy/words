                    {
                        "translation_id": "7b3ea450-b73d-40fd-84f0-6b220b0dda39",
                        "source_entry_id": "6d9c9d28-f65d-3f01-9876-7693013c8eac",
                        "source_sense_id": "c1010c5d-8691-3b41-80c3-4519d07e4a9e",
                        "target_lang_word": "atlante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atlante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                        "entry_id": "af1e8c5f-60ef-38f3-badb-18b54e7b516f",
                                        "glosses": [
                                            "Figure d’homme (statue ou buste) qui soutient sur le cou et les épaules une corniche, une tribune, etc."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1a5ab8-03c0-4d81-b756-58c98c98e477",
                                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                                "text": "Louis XlV prouva l’estime qu’il réservait au maître de Toulon, à ce “bûcheur”, qui, avant d’orner ses parcs, avait décoré ses vaisseaux, dans l’orme et le tilleul, de tant d’atlantes, de tritons et de gigantes."
                                            },
                                            {
                                                "example_id": "47d55a96-bdd2-4c67-8b0e-5606e017cbcd",
                                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                                "text": "De chacune des colonnes qui séparent les loges jaillit un atlante ou une cariatide, superbe échantillon de sculpture sur bois."
                                            },
                                            {
                                                "example_id": "da9ee365-a6e1-48e9-a1e8-39cbea920a08",
                                                "sense_id": "7708e0e9-b122-3cc6-a4a2-9a2a189d59dd",
                                                "text": "Un balcon soutenu par quatre atlantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atlante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaed4242-34f2-3020-9719-eeed09a01185",
                                        "entry_id": "95904e14-a7dd-3117-bdc6-030089055680",
                                        "glosses": [
                                            "Genre de mollusque hétéropode (Atlanta Lesueur 1817)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf5b47b-98a9-479e-85cf-a15cb2b62714",
                                                "sense_id": "eaed4242-34f2-3020-9719-eeed09a01185",
                                                "text": "Cette Atlante se rapproche encore plus que la précédente de l’Atlante de Péron ; elle ne s’en distingue que par sa spire plus large et composée de six tours, et surtout par la carène qui ne se prolonge plus entre les deux derniers tours, mais s’arrête à quelque distance de l’ouverture ; la forme de cette ouverture est aussi un peu différente et semblable à celle de l’Atlante inclinée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atlante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba81ea8-d9e5-3031-90cd-ed5bb57c21b0",
                                        "entry_id": "fcb2d372-97b3-3730-af4d-f7af4d87036f",
                                        "glosses": [
                                            "Qui concerne l’Atlantide ou les Atlantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d124ed02-8928-4dfd-8f23-e3f39351f25a",
                                                "sense_id": "8ba81ea8-d9e5-3031-90cd-ed5bb57c21b0",
                                                "text": "Nous ne devons pas oublier que l’établissement du zodiaque [sic] est absolument atlante et n’appartient pas à la période beaucoup plus ancienne qui nous occupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6a922d-2489-3a8b-8406-69bf1e08ccb2",
                                        "entry_id": "fcb2d372-97b3-3730-af4d-f7af4d87036f",
                                        "glosses": [
                                            "Qui concerne les montagnes de l'Atlas et ses habitants."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
