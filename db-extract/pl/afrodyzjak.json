                        "entry_id": "958a7757-2950-3e39-822f-cc8ebd0f6147",
                        "glosses": [
                            "środek (roślina, lek itp.) pobudzający popęd seksualny, wzmagający potencję lub doznania erotyczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c61a03-ecf8-4617-9b04-8c199e9b287c",
                                "sense_id": "5dea8dac-7a7a-3cb5-a4a8-8a13ae4402ad",
                                "text": "Znanym afrodyzjakiem jest mucha hiszpańska."
                            },
                            {
                                "example_id": "b119be64-240d-4c19-8c5f-3b9b7f32cfee",
                                "sense_id": "5dea8dac-7a7a-3cb5-a4a8-8a13ae4402ad",
                                "text": "Dawniej kobiety dodawały swoim ukochanym lubczyk do potraw, gdyż wierzyły, że to afrodyzjak."
                            }
                        ],
