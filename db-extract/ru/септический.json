                "senses": [
                    {
                        "sense_id": "f4630706-3bf2-3233-8faa-b12e55809d28",
                        "entry_id": "3078ac67-9f4d-3c5c-a1b6-fd028bdeddd3",
                        "glosses": [
                            "гнилостный, вызывающий гниение, связанный с поражением гнилостными микробами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93ce770-abb5-487a-8fd6-492b70257861",
                                "sense_id": "f4630706-3bf2-3233-8faa-b12e55809d28",
                                "text": "Септическое заражение крови."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf0e3e5f-6977-44d5-ad49-011181109e55",
                        "source_entry_id": "3078ac67-9f4d-3c5c-a1b6-fd028bdeddd3",
                        "source_sense_id": "f4630706-3bf2-3233-8faa-b12e55809d28",
                        "target_lang_word": "septisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "septisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c200f0da-5967-3717-9573-bbf2d2c0bef5",
                                        "entry_id": "5609c37a-ebc3-3a2e-a322-d51e71f2a56d",
                                        "glosses": [
                                            "durch Krankheitserreger verunreinigt, nicht keimfrei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35363f3-4230-4273-a82b-a1273bb384be",
                                                "sense_id": "c200f0da-5967-3717-9573-bbf2d2c0bef5",
                                                "text": "Operationen an septischen also keimbesetzten Wunden werden als septische Operationen bezeichnet und verschärfte Hygiene-Richtlinien werden eingehalten."
                                            },
                                            {
                                                "example_id": "16e92857-a175-4533-b87e-bb823fa7c97f",
                                                "sense_id": "c200f0da-5967-3717-9573-bbf2d2c0bef5",
                                                "text": "Die Operationen müssen aus hygienischer Sicht nicht in einem extra für septische Operationen reservierten OP-Saal durchgeführt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38341ac6-89c9-3b89-b5e8-fb4003f5df38",
                                        "entry_id": "5609c37a-ebc3-3a2e-a322-d51e71f2a56d",
                                        "glosses": [
                                            "auf Sepsis beruhend; die Sepsis betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4872b207-9070-4316-bc77-727eb70b5b31",
                                                "sense_id": "38341ac6-89c9-3b89-b5e8-fb4003f5df38",
                                                "text": "Bei einem septischen Schock kommt es trotz adäquater Volumensubstitution zu Hypotonien mit Zeichen einer Organminderperfusion und -dysfunktion."
                                            },
                                            {
                                                "example_id": "51d09f7e-d6e3-43ea-83b1-38ba4838ce23",
                                                "sense_id": "38341ac6-89c9-3b89-b5e8-fb4003f5df38",
                                                "text": "Die Todesart endlich beeinflußt den Gang der Leichenzerstörung insofern, als an septischen Krankheiten Verstorbene sehr wirksame Leichenzerstörer mit in das Grab bringen, da alle pathogenen Mikroorganismen, wie schon oben bemerkt, auch fäulnisfördernd sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
