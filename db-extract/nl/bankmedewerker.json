                        "examples": [
                            {
                                "example_id": "2732d122-2224-497f-bf1b-f987e4fa3b2a",
                                "sense_id": "ed7fd134-a904-370f-ab32-164ab8a12dc5",
                                "text": "Hij wijst erop dat het vooral ook mensenwerk blijft. \"In principe is het niet zo moeilijk om een bankmedewerker om te kopen. Als die jou in het systeem laat en je ontwikkelt een programma waarbij valse opdrachten ook automatisch gewist worden, zijn de miljoenen snel gepakt.\""
                            },
                            {
                                "example_id": "5b4cc0eb-fbc8-44d2-8de5-534adb388c1b",
                                "sense_id": "ed7fd134-a904-370f-ab32-164ab8a12dc5",
                                "text": "De bankmedewerker ontdekte meteen dat het Duitse geld was vervalst en alarmeerde de politie. Die hield de 22-jarige man aan."
                            }
                        ]
                    }
