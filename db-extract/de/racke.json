                                        "entry_id": "09c1641d-c214-31a1-a5a5-c49f897227e6",
                                        "glosses": [
                                            "A roll of titles or (especially) credits played over film or video; television or film credits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291c40f9-4e55-4d9f-a9ee-38f8778e3581",
                                                "sense_id": "3d394316-eba5-3bcd-90e5-52b94d6e1ed1",
                                                "text": "I learned a lot from watching, but the part that I should have studied harder was the roller. The names of the writers went on for ever."
                                            }
