                    {
                        "translation_id": "e9ae9aba-3545-42b0-af09-60e29f1c9fe4",
                        "source_entry_id": "5c5c9ec3-f1c6-3cb3-bdf5-98815cd4f80a",
                        "source_sense_description": "claim",
                        "target_lang_word": "притязание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "притязание",
                                "target_lang_code": "ru",
