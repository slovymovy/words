                    {
                        "translation_id": "5d60bc6a-2591-4ab7-8699-df0661dd976f",
                        "source_entry_id": "8e40a750-25d6-3898-8346-e2d4b1253b70",
                        "source_sense_id": "88c47d7d-0cf6-3565-a867-6200f12f1cce",
                        "target_lang_word": "Ribonukleinsäure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ribonukleinsäure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c66da0b-dd3e-3b5f-b614-2ab25d53a0e7",
                                        "entry_id": "f07b6138-7eab-3528-b6ed-182d043ea6da",
                                        "glosses": [
                                            "eine Nukleinsäure, deren Hauptfunktion darin besteht, die genetische Information in entsprechende Proteine umzusetzen. Die Ribonukleinsäure ist hierbei sowohl als Informationsträger (mRNA, messenger RNA, Boten RNA) als auch als katalytisches Molekül bei der Synthese des Proteins beteiligt (rRNA oder ribosomale RNA, tRNA oder transfer RNA)."
                                        ],
                                        "tags": [
                                            "Genetik",
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59fa0338-febe-4279-99aa-956e726136e9",
                                                "sense_id": "1c66da0b-dd3e-3b5f-b614-2ab25d53a0e7",
                                                "text": "\"Die Basentripletts sind von innen (5') nach außen (3') zu lesen. Sie geben die Basensequenzen der messenger Desoxyribonukleisäure-Codonen [gemeint wohl: Desoxyribonukleinsäure-Codonen] wieder, die für die außerhalb des Kreises stehende Aminosäure kodieren.\" (siehe auch die zugehörige „Sonne“ des genetischen Codes im Deklinationsschema oben)"
                                            },
                                            {
                                                "example_id": "9687f0d4-8b93-478a-a5e7-11f16cccd6c0",
                                                "sense_id": "1c66da0b-dd3e-3b5f-b614-2ab25d53a0e7",
                                                "text": "\"Eine Grundvoraussetzung für die Entstehung des Lebens vor ca. 4 Milliarden Jahren war die Existenz eines informationstragenden Biopolymers, das in der Lage sein musste, sich selbst zu replizieren. Nach heutiger Erkenntnis handelte es sich bei diesem Molekül wahrscheinlich um eine Ribonukleinsäure (RNA).\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
