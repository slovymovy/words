    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a032f35-8f35-30c5-9507-d8ae3635fbd1",
                    "sense_definition": "spowodować, że coś narysowanego, napisanego lub widocznego staje się niewyraźne lub znika przez pocieranie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "usuwanie_sladow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ulewny deszcz szybko <w>zatarł</w> wszelkie ślady kół na polnej drodze.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь быстро <w>смыл</w> все следы колёс на просёлочной дороге."
                            }
                        },
                        {
                            "text": "Sprawca zrobił wszystko, aby starannie <w>zatrzeć</w> ślady swojej obecności w pokoju.",
                            "target_lang_translations": {
                                "ru": "Преступник сделал всё, чтобы тщательно <w>замести</w> следы своего пребывания в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "zamazać",
                        "zetrzeć"
                    ],
                    "common_phrases": [
                        "zatrzeć ślady",
                        "zatrzeć granicę"
                    ],
                    "target_lang_definitions": {
                        "ru": "стереть, сгладить или уничтожить следы трением, сделать что-либо невидимым или неразличимым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замести",
                                "target_lang_sense_clarification": "следы"
                            },
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "физические следы, надписи"
                            },
                            {
                                "target_lang_word": "затереть",
                                "target_lang_sense_clarification": "сделать неразличимым трением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c89c85cf-4a1f-33ae-b280-9c6135dcca92",
                    "sense_definition": "ukryć nieprzyjemne fakty, różnice lub złe wrażenie, sprawiając, że przestają być zauważalne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "usuwanie_sladow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor próbował za wszelką cenę <w>zatrzeć</w> złe wrażenie po wczorajszym spotkaniu.",
                            "target_lang_translations": {
                                "ru": "Директор пытался любой ценой <w>сгладить</w> плохое впечатление после вчерашней встречи."
                            }
                        },
                        {
                            "text": "Czas częściowo <w>zatarł</w> bolesne wspomnienia o tamtej tragedii.",
                            "target_lang_translations": {
                                "ru": "Время частично <w>стерло</w> болезненные воспоминания о той трагедии."
                            }
                        }
                    ],
                    "synonyms": [
                        "zatuszować"
                    ],
                    "common_phrases": [
                        "zatrzeć złe wrażenie",
                        "zatrzeć różnice"
                    ],
                    "target_lang_definitions": {
                        "ru": "сгладить, скрыть неприятные факты, различия или неприятное впечатление"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгладить",
                                "target_lang_sense_clarification": "неприятное впечатление, различия"
                            },
                            {
                                "target_lang_word": "загладить",
                                "target_lang_sense_clarification": "вину или неловкость"
                            },
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "воспоминания, границы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31be26b0-5f8c-3015-8c98-62722503866f",
                    "sense_definition": "stać się niewyraźnym, mało widocznym lub ulec uszkodzeniu przez tarcie, upływ czasu albo brak smarowania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zuzycie_i_zanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodu braku odpowiedniego oleju silnik w samochodzie nagle się <w>zatarł</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за отсутствия подходящего масла двигатель в машине внезапно <w>заклинило</w>."
                            }
                        },
                        {
                            "text": "Różnica między tymi dwoma pojęciami całkowicie się <w>zatarła</w> w nowoczesnym języku.",
                            "target_lang_translations": {
                                "ru": "Разница между этими двумя понятиями полностью <w>стерлась</w> в современном языке."
                            }
                        }
                    ],
                    "synonyms": [
                        "zamazać się",
                        "rozmyć się"
                    ],
                    "common_phrases": [
                        "silnik się zatarł"
                    ],
                    "target_lang_definitions": {
                        "ru": "стереться, исчезнуть, потерять четкость со временем или заклинить от трения (о механизмах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заклинить",
                                "target_lang_sense_clarification": "о двигателе, деталях (в форме 'zatrzeć się')"
                            },
                            {
                                "target_lang_word": "стереться",
                                "target_lang_sense_clarification": "о различиях, границах"
                            },
                            {
                                "target_lang_word": "размыться",
                                "target_lang_sense_clarification": "потерять четкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01e98451-2080-3a1a-9fac-46a595ec8bc3",
                    "sense_definition": "rozgnieść lub wymieszać składniki na jednolitą masę za pomocą tarcia, na przykład w kuchni lub budownictwie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharka starannie <w>zatarła</w> zupę zasmażką z mąki i masła.",
                            "target_lang_translations": {
                                "ru": "Повариха старательно <w>заправила</w> суп зажаркой из муки и сливочного масла."
                            }
                        },
                        {
                            "text": "Robotnik musiał dokładnie <w>zatrzeć</w> tynk, zanim ściana całkiem wyschła.",
                            "target_lang_translations": {
                                "ru": "Рабочему нужно было тщательно <w>затереть</w> штукатурку, пока стена совсем не высохла."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozetrzeć"
                    ],
                    "common_phrases": [
                        "zatrzeć tynk"
                    ],
                    "target_lang_definitions": {
                        "ru": "растереть, загладить поверхность штукатурки либо заправить суп пассеровкой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затереть",
                                "target_lang_sense_clarification": "о штукатурке, швах"
                            },
                            {
                                "target_lang_word": "заправить",
                                "target_lang_sense_clarification": "суп мучной зажаркой/заправкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}