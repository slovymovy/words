                ],
                "senses": [
                    {
                        "sense_id": "6eb263a8-b2d7-305b-b8cc-25c4f04753f3",
                        "entry_id": "509415f6-760e-3f72-8cc4-d93d0795f0f3",
                        "glosses": [
                            "Staat, dessen Bevölkerung sich aus mehreren/vielen Ethnien zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965a5d0e-2fad-4f9e-83df-2aa0689267ad",
                                "sense_id": "6eb263a8-b2d7-305b-b8cc-25c4f04753f3",
                                "text": "„Die 2000 Jahre alte Stadt Derbent am Kaspischen Meer liegt tief im Süden des Vielvölkerstaats.“"
                            },
                            {
                                "example_id": "bfa51cd9-5776-407e-a348-236c7e3ed248",
                                "sense_id": "6eb263a8-b2d7-305b-b8cc-25c4f04753f3",
                                "text": "„Im Vielvölkerstaat Österreich war die Durchsetzung einer Staatssprache natürlich sehr viel schwieriger, jedenfalls ab 1848.“"
                            },
                            {
                                "example_id": "d9328300-70f6-4623-a950-3198f7b20c41",
                                "sense_id": "6eb263a8-b2d7-305b-b8cc-25c4f04753f3",
                                "text": "„Als Freud sein Buch über den Witz schrieb, gab es den altösterreichischen Vielvölkerstaat noch, in dem ein großer Teil des jiddischsprachigen Ostjudentums seine Heimat hatte.“"
                            },
                            {
                                "example_id": "ccf68d2b-26f6-49ee-9b3c-da97e39b89ba",
                                "sense_id": "6eb263a8-b2d7-305b-b8cc-25c4f04753f3",
                                "text": "„Die osteuropäischen Reiche waren Vielvölkerstaaten, in denen sehr unterschiedliche Sprachen nebeneinander gesprochen wurden und in denen es mehrere Hochsprachen gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
