{
    "word_family": [
        "apoplexy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97965cd8-6f52-3e8f-a03c-695643411143",
                    "sense_definition": "Marked by extreme anger or fury.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager became <w>apoplectic</w> when he discovered the major error in the financial report.",
                            "target_lang_translations": {
                                "ru": "Менеджер пришел в <w>ярость</w>, когда обнаружил серьезную ошибку в финансовом отчете."
                            }
                        },
                        {
                            "text": "She was absolutely <w>apoplectic</w> with rage after hearing the unfair criticism of her work.",
                            "target_lang_translations": {
                                "ru": "Она была совершенно <w>вне себя от гнева</w>, услышав несправедливую критику своей работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "enraged",
                        "livid"
                    ],
                    "antonyms": [
                        "calm",
                        "serene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охваченный крайним гневом или яростью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в ярости",
                                "target_lang_sense_clarification": "состояние сильного гнева"
                            },
                            {
                                "target_lang_word": "вне себя от гнева",
                                "target_lang_sense_clarification": "крайняя степень раздражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "455634cd-7ba8-384f-8c54-d9b4937ff4b7",
                    "sense_definition": "Relating to or caused by apoplexy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient showed signs of an <w>apoplectic</w> seizure during the medical examination.",
                            "target_lang_translations": {
                                "ru": "Во время медицинского осмотра у пациента проявились признаки <w>апоплексического</w> припадка."
                            }
                        },
                        {
                            "text": "Historical records describe the king's sudden <w>apoplectic</w> collapse at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают внезапный <w>апоплексический</w> удар, случившийся с королем за обеденным столом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к апоплексии или вызванный ею."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "апоплексический",
                                "target_lang_sense_clarification": "медицинский термин, связанный с инсультом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6651accb-35e3-3e65-82e3-6f5bd84a5c10",
                    "sense_definition": "Filled or congested with blood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His face turned <w>apoplectic</w> as the blood rushed to his head during the intense exercise.",
                            "target_lang_translations": {
                                "ru": "Его лицо стало <w>багровым</w>, когда во время интенсивной тренировки кровь прилила к голове."
                            }
                        },
                        {
                            "text": "The doctor noted the <w>apoplectic</w> appearance of the skin around the injury.",
                            "target_lang_translations": {
                                "ru": "Врач отметил <w>гиперемированный</w> вид кожи вокруг травмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "congested"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполненный кровью или переполненный кровью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гиперемированный",
                                "target_lang_sense_clarification": "медицинский термин, означающий прилив крови"
                            },
                            {
                                "target_lang_word": "багровый",
                                "target_lang_sense_clarification": "о цвете лица при сильном приливе крови"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4872f845-49ce-3aba-be36-e811663e8a05",
                    "sense_definition": "A person suffering from apoplexy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital ward was dedicated to the care of <w>apoplectics</w> recovering from strokes.",
                            "target_lang_translations": {
                                "ru": "Больничная палата была предназначена для ухода за <w>апоплектиками</w>, восстанавливающимися после инсульта."
                            }
                        },
                        {
                            "text": "In the nineteenth century, physicians often prescribed rest for <w>apoplectics</w>.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке врачи часто прописывали покой <w>апоплектикам</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий апоплексией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "апоплектик",
                                "target_lang_sense_clarification": "устаревшее медицинское обозначение больного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}