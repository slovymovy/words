                "senses": [
                    {
                        "sense_id": "82afa46c-5cc0-355c-8bd1-4f772d6ac447",
                        "entry_id": "8ea92c1b-b85a-332b-98ef-c1048b8c8ed3",
                        "glosses": [
                            "Bonbon oriental moelleux."
                        ],
                        "tags": [
                            "Confiserie"
                        ],
                        "examples": [
                            {
                                "example_id": "9d0de31f-5af7-4430-8f1a-16b2e2ef0991",
                                "sense_id": "82afa46c-5cc0-355c-8bd1-4f772d6ac447",
                                "text": "Nous rendîmes visite à M. Ben Simon qui nous reçut dans un bureau constellé d’échantillons de rahat-loukoum, de fruits secs, de bimbeloterie, de tapis du Daghestan ou de Karamanie, de broderies bulgares et de phares d’automobiles."
                            },
                            {
                                "example_id": "f0cdbd71-3c42-42ed-b627-ff71503a357e",
                                "sense_id": "82afa46c-5cc0-355c-8bd1-4f772d6ac447",
                                "text": "Mon \"neveu\" veut bien goûter avec moi, dans la chambre, où j'installe sur nos genoux du rahat-lukum, des bananes trop avancées, et des grogs froids avec des gâteaux salés."
                            }
                        ]
                    }
                ],
