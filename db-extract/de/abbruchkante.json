                ],
                "senses": [
                    {
                        "sense_id": "368b50ac-7fc9-33e0-95f0-2e039cb0c09d",
                        "entry_id": "91326885-2ad7-3d68-be2f-1e36cd4514df",
                        "glosses": [
                            "eine Kante (meist im Gelände), die durch Abbruch entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d99a879-31ca-4def-8608-07ec54c6c2a5",
                                "sense_id": "368b50ac-7fc9-33e0-95f0-2e039cb0c09d",
                                "text": "Durch den stundenlangen Starkregen wurde die Abbruchkante des Tagebaus stark ausgewaschen und unterhöhlt."
                            },
                            {
                                "example_id": "f62dd087-dae7-4346-827d-c47400ed19c2",
                                "sense_id": "368b50ac-7fc9-33e0-95f0-2e039cb0c09d",
                                "text": "„Mein Bruder war glücklich, maß mit einem kleinen Gerät den Sauerstoffgehalt seines Bluts, neunundneunzig Prozent, und stellte sich nah an die Abbruchkante.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2154acd4-a420-4b6a-b505-e0ca38769208",
                        "source_entry_id": "91326885-2ad7-3d68-be2f-1e36cd4514df",
                        "source_sense_id": "368b50ac-7fc9-33e0-95f0-2e039cb0c09d",
                        "source_sense_description": "eine Kante (meist im Gelände), die durch Abbruch entstanden ist",
                        "target_lang_word": "escarpment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarpment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f129fb76-4062-382a-a81b-b0756cf7a77e",
                                        "entry_id": "20660e16-0d48-3273-a9a8-d7356c507157",
                                        "glosses": [
                                            "A steep descent or declivity; steep face or edge of a ridge; ground about a fortified place, cut away nearly vertically to prevent hostile approach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1464c8-5546-4147-b408-b77ed80f6a06",
                                                "sense_id": "f129fb76-4062-382a-a81b-b0756cf7a77e",
                                                "text": "After the canyons, the most remarkable features of the country are the long lines of cliffs. These are bold escarpments scores or hundreds of miles in length,—great geographic steps, often hundreds or thousands of feet in altitude, presenting steep faces of rock, often vertical."
                                            },
                                            {
                                                "example_id": "5c4aeeae-f7e4-4eed-bf7a-932a61b75864",
                                                "sense_id": "f129fb76-4062-382a-a81b-b0756cf7a77e",
                                                "text": "The railway winds down the face of the escarpment on a steady grade of 1.05 per cent, which is considerably better than the old route, up which trains took 2 hr. to struggle 15 miles, with two stops."
                                            },
                                            {
                                                "example_id": "7fc88657-71f8-4fe3-9305-f8f854a63b54",
                                                "sense_id": "f129fb76-4062-382a-a81b-b0756cf7a77e",
                                                "text": "One of [the] defining characteristics of [the northern Horn of Africa] is its separateness, and this is partly due to its physical diversity. A detailed description of physical geography falls outside the scope of this book. It may simply be noted that the region comprises highlands that are bounded on the east by the precipitous escarpment bordering the Danakil lowlands and the Red Sea. To the west, the country descends more gradually to the extensive plains of the Nile Valley but is riven by the rugged valleys of the Takezze and other Nile tributaries. In the north, with decreasing altitude, the terrain becomes progressively more arid as the Sudanese lowlands converge with the Red-Sea coast. It is only to the south that the highlands continue, linking them with the principal mass of the Ethiopian plateau, near the western edge of which lies Lake Tana and the source of the Blue Nile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "114b3872-281b-4bb0-9cc1-7eb8874ee821",
                        "source_entry_id": "91326885-2ad7-3d68-be2f-1e36cd4514df",
                        "source_sense_id": "368b50ac-7fc9-33e0-95f0-2e039cb0c09d",
                        "source_sense_description": "eine Kante (meist im Gelände), die durch Abbruch entstanden ist",
                        "target_lang_word": "scarp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scarp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "540fe3c7-3b98-3658-9666-88d69cc2493b",
                                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                                        "glosses": [
                                            "The steep artificial slope below a fort's parapet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9728410b-b4d7-39be-aa11-c8446b9939f2",
                                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                                        "glosses": [
                                            "A cliff at the edge of a plateau or ridge caused by erosion or faulting; the steeper side of an escarpment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c78664c-50ab-42a1-b68c-cf06bee67849",
                                                "sense_id": "9728410b-b4d7-39be-aa11-c8446b9939f2",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nSweating under the sun, we scale the barren eastern scarp of the Great Rift Valley (Area B), edging carefully around controversial, razor-wired Israeli settlements (Area C)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                                        "entry_id": "0a68e2c1-b941-3fdb-b6de-84515ebf09f0",
                                        "glosses": [
                                            "Obsolete spelling of scarpe, scrape."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43ab8302-abac-473c-a5ff-334e1fdb93e7",
                                                "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                                                "text": "[...] as in the seventh, which is Argent a Scarp Azure."
                                            },
                                            {
                                                "example_id": "3f5b8c86-3b24-4f0e-b5cc-0297517affa3",
                                                "sense_id": "48385b36-f5ea-302b-b162-123ce048d694",
                                                "text": "He beareth Argent, a Scarp, Azure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scarp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc9f7e4-8dec-35c7-a9e5-d77703b5567d",
                                        "entry_id": "65f79cca-d66f-3e67-bcf8-c0f94188006c",
                                        "glosses": [
                                            "to cut, scrape, erode, or otherwise make into a scarp or escarpment"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4f5cb0-ca49-430a-ad1e-37027a2772a6",
                                                "sense_id": "dfc9f7e4-8dec-35c7-a9e5-d77703b5567d",
                                                "text": "For thou, O Spring! canst renovate / All that high God did first create. / […] / Sweep ruins from the scarped mountain, / Cleanse the torrent at the fountain, […]"
                                            },
                                            {
                                                "example_id": "27a059d0-d896-47d1-b4d4-4e1829751174",
                                                "sense_id": "dfc9f7e4-8dec-35c7-a9e5-d77703b5567d",
                                                "text": "to scarp the face of a ditch or a rock"
                                            },
                                            {
                                                "example_id": "30f616ce-0d50-4f1f-bffd-47b369f8cc21",
                                                "sense_id": "dfc9f7e4-8dec-35c7-a9e5-d77703b5567d",
                                                "text": "From scarped cliff and quarried stone"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
