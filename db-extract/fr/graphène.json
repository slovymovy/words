                                        "glosses": [
                                            "molecola bidimensionale ultrapiatta ricavata in laboratorio dalla grafite, composta di atomi di carbonio esagonali in disposizione vincolata, e caratterizzata da ottime proprietà come conduttore"
                                        ],
                                        "tags": [],
