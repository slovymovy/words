                        ],
                        "examples": [
                            {
                                "example_id": "45294c0e-dcb0-4c03-8810-51cb21623154",
                                "sense_id": "9bd6253c-de01-39e8-9dc3-5896d5ced512",
                                "text": "Brandbommen zetten naburige huizen in lichtelaaie. Delen van het vuur waren te blussen geweest, maar er was groot gebrek aan brandweerlieden. Een politieagent zei dat de Haagse brandweer door de Duitsers was ingezet in het Ruhrgebied dat ook zwaar werd gebombardeerd."
                            },
                            {
                                "example_id": "0d8e957a-f9c5-4ed9-9c84-94154c2529d4",
                                "sense_id": "9bd6253c-de01-39e8-9dc3-5896d5ced512",
                                "text": "Rond 00.30 uur hoorden omwonenden een harde knal. Niet veel later stonden een bijgebouw en een schutting in lichtelaaie. De brandweer schaalde direct op naar middelbrand en kwam met veel materiaal ter plaatse. Zo werd voorkomen dat de brand ook oversloeg naar de woning."
                            }
                        ]
                    }
