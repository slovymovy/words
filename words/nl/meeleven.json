{
    "word_family": [
        "leven",
        "medeleven",
        "meelevend",
        "beleven",
        "overleven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8769090-3f9a-3760-9689-21da5029f56d",
                    "sense_definition": "uit verbondenheid proberen je gevoelsmatig te verplaatsen in wat iemand doormaakt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "empathie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil graag met je <w>meeleven</w> in deze moeilijke tijd na het verlies van je vader.",
                            "target_lang_translations": {
                                "en": "I would like to <w>sympathize</w> with you during this difficult time after the loss of your father."
                            }
                        },
                        {
                            "text": "Heel veel mensen lieten weten dat ze intens met de slachtoffers <w>meeleefden</w>.",
                            "target_lang_translations": {
                                "en": "Many people let it be known that they <w>empathized</w> deeply with the victims."
                            }
                        }
                    ],
                    "synonyms": [
                        "sympathiseren",
                        "empathie tonen"
                    ],
                    "common_phrases": [
                        "intens meeleven",
                        "met iemand meeleven"
                    ],
                    "target_lang_definitions": {
                        "en": "To emotionally empathize or sympathize with someone's situation out of a sense of connection."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sympathize",
                                "target_lang_sense_clarification": "sharing feelings of sorrow or pity"
                            },
                            {
                                "target_lang_word": "to empathize",
                                "target_lang_sense_clarification": "understanding and sharing the feelings of another"
                            },
                            {
                                "target_lang_word": "to feel for",
                                "target_lang_sense_clarification": "to have compassion for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d519513-8487-3786-9d38-3cca79058ebf",
                    "sense_definition": "in dezelfde periode samen doormaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben de hele ontwikkeling van het bedrijf van dichtbij kunnen <w>meeleven</w>.",
                            "target_lang_translations": {
                                "en": "They were able to <w>experience</w> the entire development of the company from up close."
                            }
                        },
                        {
                            "text": "Het is bijzonder om zo'n historisch moment samen met de hele bevolking te <w>meeleven</w>.",
                            "target_lang_translations": {
                                "en": "It is special to <w>live through</w> such a historical moment together with the entire population."
                            }
                        }
                    ],
                    "synonyms": [
                        "meemaken",
                        "beleven"
                    ],
                    "common_phrases": [
                        "van dichtbij meeleven"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience or live through a period or event together with others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to experience",
                                "target_lang_sense_clarification": "to live through an event"
                            },
                            {
                                "target_lang_word": "to witness",
                                "target_lang_sense_clarification": "to see and experience something firsthand"
                            },
                            {
                                "target_lang_word": "to live through",
                                "target_lang_sense_clarification": "to experience a specific period or event"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}