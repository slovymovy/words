                "senses": [
                    {
                        "sense_id": "f8f9aa78-b944-39c5-a109-c094e930963f",
                        "entry_id": "576a9a83-2d7c-3524-9285-5ff287791041",
                        "glosses": [
                            "Sportler, der das Basketballspiel ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c238346-5f39-41f8-ac99-1d8c1520414d",
                                "sense_id": "f8f9aa78-b944-39c5-a109-c094e930963f",
                                "text": "Nach einer schnellen Drehung kann der Basketballspieler den Ball im Korb versenken."
                            },
                            {
                                "example_id": "6534413b-339d-48c3-8202-ca8121e8ebca",
                                "sense_id": "f8f9aa78-b944-39c5-a109-c094e930963f",
                                "text": "„Er war einer der bekanntesten Basketballspieler in den 1980ern, mittlerweile setzt er sich mit seiner Magic Johnson Foundation für Aidsforschung ein.“"
                            },
                            {
                                "example_id": "f7b024e1-65c0-48ac-8672-72c54b85f63c",
                                "sense_id": "f8f9aa78-b944-39c5-a109-c094e930963f",
                                "text": "„Nach dem Durchbruch in der NBA will der Schweizer Basketballspieler Clint Capela mit den Houston Rockets nächste Saison den Titel gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
