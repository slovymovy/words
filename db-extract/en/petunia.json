                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                        "entry_id": "8f747e37-b673-3b88-94af-64ce36465992",
                                        "glosses": [
                                            "Zierpflanze mit trichterförmigen roten, violetten oder weißen Blüten sowie mit klebrigen, weichen Trichomen auf Stängeln und Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2669136d-f3ca-4946-90cf-ab2d5c65ac67",
                                                "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                                "text": "Als waschechte Südamerikanerin bevorzugt die Petunie einen Standort in der prallen Sonne."
                                            },
                                            {
                                                "example_id": "b292047f-8c60-400f-9cc2-8b4262b6be3e",
                                                "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                                "text": "Die Samen von Petunien können ganz einfach selber abgeerntet werden."
                                            },
                                            {
                                                "example_id": "80e1aa20-b21d-4e8e-816f-abe2f2bcf5c8",
                                                "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                                "text": "Petunien (Petunia-Hybriden) bilden üppige Blütenberge, die in allen Farben aus Balkonkästen und Blumenampeln quellen."
                                            },
                                            {
                                                "example_id": "2572f941-c1b4-44cd-8a9c-2e0604ac374a",
                                                "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                                "text": "Die meisten Petunien werden als frostempfindliche Einjahresblumen kultiviert."
                                            },
                                            {
                                                "example_id": "b279ad90-b599-4b59-b40d-71961494ce33",
                                                "sense_id": "afabf891-6674-36ac-8326-72b91f7a20f7",
                                                "text": "Petunien bevorzugen sonnige, wind- und regengeschützte Plätze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
