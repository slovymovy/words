                                "target_senses": [
                                    {
                                        "sense_id": "2ad31256-882d-37c9-bdbe-425ae8643873",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "So as to be generally favored or accepted by the people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "commonly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d858b2-9ad9-4139-b7cc-0484b4fc082b",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "They were popularly known as \"the Kings of California\""
                                            },
                                            {
                                                "example_id": "bf5347e0-9f93-465b-ac63-5529d7abfb60",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "Officially the Nordland Railway begins at Hell, but popularly the whole route north of Trondheim is so called."
                                            },
                                            {
                                                "example_id": "0324245b-d4b4-4ae7-b298-790c38384343",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "[T]he Oligocene's signature species were an unsavoury group of pigs and pig-like creatures, foremost among which were the entelodonts, more popularly known as hell pigs, or terminator pigs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35b4b98-0e79-3d40-8a78-2a03467a32ae",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "currently"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edb366ba-dc3a-4136-b33d-57323fd10f50",
                        "source_entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "source_sense_description": "dans le langage courant",
                        "target_lang_word": "coarsely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coarsely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                        "entry_id": "02cc8cbf-653a-3586-a9a4-fa20baff3ad7",
                                        "glosses": [
                                            "in a coarse manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501ad2fb-c585-4233-9782-0d817556cf21",
                                                "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "0c33be7b-409a-4c22-9920-9a06885d5239",
                                                "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                                "text": "Wild nuts, peas, vetch, a legume which had edible seed pods, and grasses were often combined with pulses like beans or lentils, the most commonly identified ingredient, and at times, wild mustard. To make the plants more palatable, pulses, which have a naturally bitter taste, were soaked, coarsely ground or pounded with stones to remove their husk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b63b5d01-db84-46ae-99d3-82c4cbd5241b",
                        "source_entry_id": "72e2c737-1b95-3ed6-8cff-cf3d27fcdecf",
                        "source_sense_description": "dans le langage courant",
                        "target_lang_word": "grossly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                                        "entry_id": "d149501f-c1a5-3f6e-87a0-9d24a1f61a69",
                                        "glosses": [
                                            "Greatly; to a large degree, especially one large enough to be frankly appreciable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df82f7da-2e26-4acc-8975-e98a38dcf2b4",
                                                "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                                                "text": "grossly inflated expectations"
                                            },
                                            {
                                                "example_id": "5e9a3777-a7aa-45db-870d-cc45c9555510",
                                                "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                                                "text": "grossly enlarged hepatic lobes, evident on palpation"
                                            },
                                            {
                                                "example_id": "270aca57-6bc5-4f47-9382-901bc8293423",
                                                "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                                                "text": "Third-class carriages are grossly overcrowded, with passengers lying on the luggage racks, standing between the benches, and occasionally even riding on the footboards and clinging to the outsides of the coaches for short distances."
                                            },
                                            {
                                                "example_id": "69dadd39-87c9-4843-841a-a238b1712ab5",
                                                "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                                                "text": "Barker believed that evidence was emerging that a \"solid proportion\" of operations were \"grossly uneconomic\", and that no amount of improvement in equipment would make them viable. He suggested that \"while the superstructure of the report is correct, the foundations require radical re-examination\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da71528-716c-3fda-a5ee-b33804460cfb",
                                        "entry_id": "d149501f-c1a5-3f6e-87a0-9d24a1f61a69",
                                        "glosses": [
                                            "To a serious, severe, or offensive degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d396721-4167-4ebf-afb2-b853a227cb4c",
                                                "sense_id": "5da71528-716c-3fda-a5ee-b33804460cfb",
                                                "text": "grossly misjudged"
                                            },
                                            {
                                                "example_id": "262fef82-eed5-4ed0-bc38-0fb67fb750af",
                                                "sense_id": "5da71528-716c-3fda-a5ee-b33804460cfb",
                                                "text": "grossly inflamed"
                                            },
                                            {
                                                "example_id": "9826bdd1-55d9-41d2-97f0-9f105af9aacb",
                                                "sense_id": "5da71528-716c-3fda-a5ee-b33804460cfb",
                                                "text": "A draft deal to cut global fossil fuel production is “grossly insufficient” and “incoherent” and will not stop the world from facing dangerous climate breakdown, according to delegates at the UN’s Cop28 summit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9be2dd3a-398c-3f52-9ef3-633ae116b2b8",
                                        "entry_id": "d149501f-c1a5-3f6e-87a0-9d24a1f61a69",
                                        "glosses": [
                                            "In a gross (disgusting) manner; without delicacy."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92f4115a-6e8c-48aa-8c22-99357ef3d2ca",
                                                "sense_id": "9be2dd3a-398c-3f52-9ef3-633ae116b2b8",
                                                "text": "The men were talking grossly about their sexual conquests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e70f59-ccad-364f-9b55-12988dc873cd",
                                        "entry_id": "d149501f-c1a5-3f6e-87a0-9d24a1f61a69",
                                        "glosses": [
                                            "Roughly; approximately; inexactly; sketchily."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
