                        "glosses": [
                            "Culte des marabouts considérés comme des saintes personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68c30ce-1496-4540-8724-c5641796475f",
                                "sense_id": "e634aa62-9129-3507-ab3e-7e275505b5f4",
                                "text": "Il nous faut ajouter que si le maraboutisme n'implique pas forcément un déplacement quant à l'objet de la sexualité il n'en est pas de même du çoufisme."
                            },
                            {
                                "example_id": "b879bb5c-df60-48a1-ac51-b54184115dcb",
                                "sense_id": "e634aa62-9129-3507-ab3e-7e275505b5f4",
                                "text": "L’impérialisme français a combattu le mouvement progressiste des Oulémas pour donner son appui total au maraboutisme, domestiqué par la corruption de certains chefs de confréries."
                            }
                        ]
                    }
