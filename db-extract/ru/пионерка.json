                        "glosses": [
                            "женск. к пионер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a33cf7-b261-4d24-b870-a3d3c3b8f214",
                                "sense_id": "e246f54b-5dcd-387f-9764-bed5b38536be",
                                "text": "Мама сказала Карине Ивановой, пионерке, ученице седьмого класса, отличнице: — Отправляйся на шестой участок и отнеси башке Лукерье Сидоровне пирожок с капустой и последний номер газеты «Гуслярское знамя» с отчётом о чистке рядов партийной организации нашего района."
                            }
                        ]
                    }
                ],
