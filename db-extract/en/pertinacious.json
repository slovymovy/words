                    {
                        "translation_id": "e6982c5c-8f05-4cf2-9e60-52f473fab45c",
                        "source_entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "source_sense_description": "stubbornly resolute or tenacious",
                        "target_lang_word": "tenace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee76243-c232-33ba-b241-971fb811545e",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Qui est adhérent ; qui tient fortement à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7e22b5-e854-4ee5-894e-b6c5a7c7e9fb",
                                                "sense_id": "8ee76243-c232-33ba-b241-971fb811545e",
                                                "text": "Le suc d’oignons de lis étoit tenace, gluant; il fallut pour en avoir un peu, le ramasser avec un couteau : il étoit couleur de café au lait; […]."
                                            },
                                            {
                                                "example_id": "e26cf5ef-f942-48e4-9722-cd631d5d66f0",
                                                "sense_id": "8ee76243-c232-33ba-b241-971fb811545e",
                                                "text": "L’intrépide lion dans un piège surpris\nS’irrite du danger, et de sa dent tenace\nRonge, en grondant, la toile où lui-même s’enlace"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277f9d10-48b9-3c1f-892f-88a5976de775",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Qualifie les plantes et des parties de plantes qui s’attachent, s’accrochent à ce qui les touche, telles que les tiges et les semences du grateron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd39734-c7f3-4ab4-ae26-9d9aaf9ba2ea",
                                                "sense_id": "277f9d10-48b9-3c1f-892f-88a5976de775",
                                                "text": "Une tige, une feuille tenace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Dont les parties tiennent fortement ensemble, qui peut soutenir une traction, une pression considérable sans s’allonger, sans se rompre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a036c715-2edd-4381-afaf-413f58be6735",
                                                "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                                "text": "Roche tenace, roche qu'on a de la peine à détacher, à casser."
                                            },
                                            {
                                                "example_id": "09ba6b1e-c9b8-4d5f-83a2-a9949742bb03",
                                                "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                                "text": "Un métal tenace, métal qui supporte une pression, un tiraillement considérable, sans se rompre."
                                            },
                                            {
                                                "example_id": "ba1d1def-b12e-4020-a9b1-2c721f44a461",
                                                "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                                "text": "Quoique l’or soit le plus compacte et le plus tenace des métaux, il n’est néanmoins que peu élastique et peu sonore."
                                            },
                                            {
                                                "example_id": "bdc27e86-e15d-407e-acdd-a1063050dddb",
                                                "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                                "text": "Du chanvre très tenace."
                                            },
                                            {
                                                "example_id": "a9bbd9ba-5b11-40bd-b331-228af94784d0",
                                                "sense_id": "77f66ac9-0e69-30f9-a950-30ee94a36f69",
                                                "text": "L’eau chaude et surtout bouillante peut prendre plus de sucre en dissolution que l’eau froide, et former un liquide plus épais, plus tenace que le sirop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12aa6b0b-1039-3afe-89c6-960aeb972b44",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Dont on ne peut pas se débarrasser ; qui persiste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd7dc3a-8860-4eec-b802-ffd35a3dc721",
                                                "sense_id": "12aa6b0b-1039-3afe-89c6-960aeb972b44",
                                                "text": "Il se gratte le front qu'un prurit tenace ne cesse de taquiner, et où fleurissent des taches rougeâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Qualifie une personne dont on ne peut se défaire, qu’on ne peut écarter."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b670d0a0-05c3-4fea-a3c9-52cf51276537",
                                                "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                                "text": "Ce diable-là est furieusement tenace ; c’est celui qui possède ordinairement les femmes, quand elles ont le diable au corps."
                                            },
                                            {
                                                "example_id": "3cb63080-6eed-488e-b22b-b5b9a609622d",
                                                "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                                "text": "Non, je ne vis jamais d’animal si tenace [un créancier]."
                                            },
                                            {
                                                "example_id": "cbdfa018-1647-41a9-a0cf-249dab063b8a",
                                                "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                                "text": "Ce fade médecin est un amant tenace,\nEt qui ne s’aperçoit jamais qu’il embarrasse."
                                            },
                                            {
                                                "example_id": "fe4be1b8-67c9-4856-a554-f1bc651c744c",
                                                "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                                "text": "Reste encore un neveu, mais un neveu tenace."
                                            },
                                            {
                                                "example_id": "4cce80e7-f7da-4502-9ff9-e32c83461cf9",
                                                "sense_id": "7052fea9-a521-31a2-baa2-3a63859489ee",
                                                "text": "Une petite pluie mince et tenace dégoulinait sans arrêt depuis la veille […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Qui est attaché fortement à ses idées, à ses projets, à ses prétentions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a516f8db-c012-40f1-b7b1-0aa7b9b4ff8a",
                                                "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                                "text": "Existe-t-il un type de preuves incontournables qu’il suffirait d’évoquer pour persuader de la justesse de sa position ses opposants les plus tenaces ?"
                                            },
                                            {
                                                "example_id": "d5496f8f-7fd2-4ef9-b469-ee46a528f3ad",
                                                "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                                "text": "C’est un homme fort tenace et qui ne renonce pas aisément à ce qu’il désire, à ce qu’il veut."
                                            },
                                            {
                                                "example_id": "60260f7f-222f-45a4-8b51-f61a3cabc898",
                                                "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                                "text": "Un caractère, une volonté tenace."
                                            },
                                            {
                                                "example_id": "588f9b14-feab-44e4-b0ee-2b7141396ad9",
                                                "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                                "text": "Préjugé tenace."
                                            },
                                            {
                                                "example_id": "12bf8768-d44c-4835-af7c-bfc8e900067a",
                                                "sense_id": "19212dc3-a730-3e2d-9dd9-e1a496294dfa",
                                                "text": "On tient beaucoup aux choses dont on est continuellement occupé, témoin l’obstination tenace des mahométans et des juifs, et la facilité qu’ont de changer de religion les peuples barbares et sauvages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c1d18e-4088-32a7-9417-a7a6f46d4a99",
                                        "entry_id": "42bf5dee-6f67-3278-bf08-cd85b5bcaebc",
                                        "glosses": [
                                            "Qui ne donne qu’avec peine ; avare."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c99498cc-4e86-451c-b6ab-ad31a1c7897a",
                                                "sense_id": "a2c1d18e-4088-32a7-9417-a7a6f46d4a99",
                                                "text": "Il est d’une humeur fort tenace, on ne saurait en rien tirer."
                                            },
                                            {
                                                "example_id": "dd1ca3bb-5dae-43db-9331-eafbbed1fb26",
                                                "sense_id": "a2c1d18e-4088-32a7-9417-a7a6f46d4a99",
                                                "text": "Sa fille est riche ; mais l’oncle, qui est tuteur, est tenace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
