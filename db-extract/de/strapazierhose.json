                "senses": [
                    {
                        "sense_id": "61139725-60d8-3ea1-b5dc-2a07ee99d74f",
                        "entry_id": "5a2a9620-e429-373c-b64e-f9e407ec7a86",
                        "glosses": [
                            "Hose, die man stark beanspruchen kann, zum Beispiel bei Bauarbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79421781-4b8e-430d-a735-fcf0d0aa0372",
                                "sense_id": "61139725-60d8-3ea1-b5dc-2a07ee99d74f",
                                "text": "„Auch vor UV-Strahlen sind Sie bestens geschützt, denn die wasser- und schmutzabweisende Strapazierhose ist aus unempfindlichem G-1000 Original mit UV-Schutz (65% Polyester, 35% Baumwolle).“"
                            },
                            {
                                "example_id": "234cd11e-995d-4d86-aed6-c06e0c13daa5",
                                "sense_id": "61139725-60d8-3ea1-b5dc-2a07ee99d74f",
                                "text": "„An den Ständen wird die ganze Palette der Branchenbedürfnisse vorgestellt: Von der Strapazierhose für den übergewichtigen Koch über den 2-Minuten-\"Spaghettomaten\" bis zur modernsten Software fürs Yield Management.“"
                            }
                        ],
