                                        "entry_id": "be0fea9b-32cc-33f9-94c6-50f9a14738d8",
                                        "glosses": [
                                            "Handlung oder Vorgang, etwas abzuändern, und Ergebnis dieser Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3297b04f-2c85-402b-bb4e-68ae0d7f4b4e",
                                                "sense_id": "477a70b2-51d3-3521-91b3-6e4ec5e0a3e6",
                                                "text": "Es gilt noch einige Modifikationen an dem Entwurf vorzunehmen, bevor er in die Produktion geht."
                                            },
                                            {
                                                "example_id": "a1d48912-8cfd-45a9-b339-92163bd490a3",
                                                "sense_id": "477a70b2-51d3-3521-91b3-6e4ec5e0a3e6",
                                                "text": "„Jüngers Prozedere besteht mithin aus der Übernahme und Modifikation von Vorgaben und Einflüssen anderer Autoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6195f718-9763-4d2d-8abc-d60625d08f64",
                        "source_entry_id": "1cf32fce-eb7b-3254-9165-ee4b79da9bca",
