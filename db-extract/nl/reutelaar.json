                    {
                        "sense_id": "64e36022-e6ef-3fc9-8940-a5765160240b",
                        "entry_id": "e6da4d9c-f5be-3d90-934e-dd15c8e2f899",
                        "glosses": [
                            "iemand die met grommende geluiden uiting geeft aan zijn ongenoegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e091864-fa63-445f-afd8-b84dbe655c97",
                                "sense_id": "64e36022-e6ef-3fc9-8940-a5765160240b",
                                "text": "Reutelaar M. en reutelaarster V. Knorrepot, babbelaar, babbelaarster."
                            },
                            {
                                "example_id": "a8b41e64-2a06-4c7f-9254-d421e1e12d6a",
                                "sense_id": "64e36022-e6ef-3fc9-8940-a5765160240b",
                                "text": "De breinkist van een Man die jaren wint wort gemeenelyk een magazyn van zotheit of wysheit, en moet zich by gevolg ontlasten in iets dat zeer inpertinent of zeer leerzaam is: des vint men schier niets belagchelyker dat een' ouden Reutelaar, die zich door Viswyve- of Voerluide-termen van zyne gal ontlast; en ter contrarie is 'er niets waerdiger dan een persoon die zyne studie en ervarentheit tot vermaak en stichting van zyne Lezers emploieert."
                            }
                        ]
                    }
