                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a987a5e8-6790-3a24-8685-9d5da35df483",
                                        "entry_id": "204bb58e-f3ce-3298-b2cb-6b4f8615ddd3",
