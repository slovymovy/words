                        "examples": [
                            {
                                "example_id": "c72f514c-9965-46c8-9695-74ac255d4817",
                                "sense_id": "6ccf0534-924a-3497-b1ec-fcfc1f00e648",
                                "text": "Ook moslimleiders lieten hun afkeer blijken. De voorganger van de moskee van Parramatta, Neil al-Kadomi, zei vrijdag dat moslims die Australische waarden afwijzen, moeten oplazeren."
                            },
                            {
                                "example_id": "a85853b0-2611-4f4f-a832-5bdaed971cec",
                                "sense_id": "6ccf0534-924a-3497-b1ec-fcfc1f00e648",
                                "text": "\"Ik heb geen idee waarom hij dit doet. Maar ik weet wel dat als iemand niet langer voor deze club wil spelen, hij beter snel kan oplazeren.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70690d21-b607-4746-9077-cd432a8a2ae1",
                        "source_entry_id": "f06084da-d331-3e13-acb0-f34712460ea1",
                        "source_sense_id": "6ccf0534-924a-3497-b1ec-fcfc1f00e648",
                        "target_lang_word": "go to hell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go to hell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d07dbadc-f11a-308a-ab9c-84487df2da06",
                                        "entry_id": "77859526-55ce-34a5-8746-f3425869edfe",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see go, to, hell."
