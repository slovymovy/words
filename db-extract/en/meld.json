                        "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                        "entry_id": "9f356796-b536-3665-9552-6838794b509a",
                        "glosses": [
                            "To combine (multiple things) together; to blend, to fuse."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6f459852-f368-4dbb-b197-b17f4d657120",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "One can meld copper and zinc together to form brass."
                            },
                            {
                                "example_id": "5feddd54-24dc-4ef6-87a1-1d01206ea8a4",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "Much as America's motto celebrates melding many into one, South Africa's says that it doesn't matter what you look like – we can all be proud of our young country."
                            },
                            {
                                "example_id": "62a36309-baf0-4f8f-b7d6-1dcad96883ee",
                                "sense_id": "af3555d0-7f64-3ba6-bdc4-1940c823c1ce",
                                "text": "Users can upload an unlimited number of voice messages, text prompts, photographs and videos of themselves, and in return an algorithm melds together memories and media and spits out a “virtual you” – an avatar that can speak to loved ones on phone calls and through text messages “so that children, grandchildren and beyond can know what you’re really like”."
                            }
                        ]
