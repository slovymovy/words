                    {
                        "sense_id": "ca9111ad-2468-3eaf-8022-0a8cef5f6440",
                        "entry_id": "141004fb-c0b0-3bdd-8248-9ca24060b3f8",
                        "glosses": [
                            "Qui se réduit facilement en poudre ; qui est sous forme de poudre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "c8f5ff7b-976c-452b-96a1-d1cb9ddee4e4",
                                "sense_id": "ca9111ad-2468-3eaf-8022-0a8cef5f6440",
                                "text": "Ces diverses opérations pourraient être complétées par l’épandage de scories pulvérulentes à faible dose qui continueraient l’action de la chaux ; à dose plus élevée, ces scories amèneraient la destruction des Mousses."
                            }
                        ]
                    },
                    {
                        "sense_id": "381f1021-55af-3cff-917c-59519701dfb6",
                        "entry_id": "141004fb-c0b0-3bdd-8248-9ca24060b3f8",
                        "glosses": [
                            "Décrit les parties de certaines plantes qui sont couvertes d’un duvet d’une telle ténuité qu’il ressemble à de la poussière."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ff781b4-6456-3336-b7a0-107b10357525",
                        "entry_id": "141004fb-c0b0-3bdd-8248-9ca24060b3f8",
                        "glosses": [
                            "Qualifie une texture minérale caractérisée par la finesse de son grain."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
