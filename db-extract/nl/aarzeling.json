                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                                "text": "Réciter sans hésitation, sans la moindre hésitation."
                                            },
                                            {
                                                "example_id": "54778431-e718-485f-b2a9-c3f2470163a3",
                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
                                                "text": "Parler, répondre avec hésitation."
                                            },
                                            {
                                                "example_id": "8fdf33b0-3f8d-4660-bdbe-0a760804ea7c",
                                                "sense_id": "70e81801-e230-3a17-b647-690baf011b04",
