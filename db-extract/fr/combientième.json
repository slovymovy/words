                        "examples": [
                            {
                                "example_id": "74b99a3e-0626-4ab7-afef-962739f2582c",
                                "sense_id": "6c4a5485-4443-306d-9d5b-6c4fc6cc10a3",
                                "text": "Que fait-il ? Tourne-t-il en rond dans sa mansarde en regardant sa collection de trophées militaires […] ? À la combientième fiasque de pinot gris en est-il depuis le début de la semaine ?"
                            },
                            {
                                "example_id": "44acc638-9206-4f47-9f15-55821a3204d6",
                                "sense_id": "6c4a5485-4443-306d-9d5b-6c4fc6cc10a3",
                                "text": "C’est la combientième fois que je me retrouve dans son bureau depuis la rentrée ? Deux fois avec Reinier, le prof de math, une fois avec Anconis, le prof d’allemand… Mais c’est la première fois avec Dubigny."
                            }
                        ]
                    }
