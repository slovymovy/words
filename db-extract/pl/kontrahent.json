                    },
                    {
                        "translation_id": "d1c78e1a-5a5f-47ca-9604-8e02e6441811",
                        "source_entry_id": "7f1153fb-f71d-3adb-becf-9adf9b6d483b",
                        "source_sense_id": "b5277f93-d4e8-32de-baf5-68a65ddead8a",
                        "target_lang_word": "contractant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contractant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af4d1819-4d06-3444-801f-089647341ebc",
                                        "entry_id": "e429ccb8-5cad-39ec-b787-f1424f3427a3",
                                        "glosses": [
                                            "Qui passe un contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2e7bd2-8c98-46ad-9c99-0898d2776a21",
                                                "sense_id": "af4d1819-4d06-3444-801f-089647341ebc",
                                                "text": "… ; c'est lui qui marie les fils et les filles des pairs de France; ces mariages sont pour lui l'occasion de prononcer de petits discours que les parties contractantes font imprimer et conservent précieusement dans la famille."
                                            },
                                            {
                                                "example_id": "aacc259a-4ce2-413a-b838-13c5d7dc155d",
                                                "sense_id": "af4d1819-4d06-3444-801f-089647341ebc",
                                                "text": "Nous avons, aux articles de la capacité des parties contractantes, rapporté un arrêt qui a déclaré un ex-maire personnellement responsable d'un emprunt qu'il avait fait en cette qualité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contractant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28b16405-c120-3f9a-9322-4994ca797da0",
                                        "entry_id": "f0369ce3-133e-3d47-a132-a3b51d04432c",
                                        "glosses": [
                                            "Partie qui passe un contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc999f2a-58eb-414d-a2db-d1c0ace29619",
                                                "sense_id": "28b16405-c120-3f9a-9322-4994ca797da0",
                                                "text": "Le contrat de partage de production, comme la concession, autorise en exclusivité le contractant à conduire à son propre risque des travaux d’exploration sur un domaine minier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contractant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae4d1cc-12fe-390d-ab06-3a5b30f8f9ee",
                                        "entry_id": "bb098805-96a1-361d-8e51-3de29dc33489",
                                        "glosses": [
                                            "Participe présent du verbe contracter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4b038f8-3a07-4b18-b2f7-5549cf50f32a",
                                                "sense_id": "9ae4d1cc-12fe-390d-ab06-3a5b30f8f9ee",
                                                "text": "Mais, ce n’est pas fini: on pense ventriculariser l’oreillette en l’emballant d’un muscle de la ceinture thoracique, se contractant de façon synchrone avec le reste du cœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce190800-9a56-4456-894a-f13aa712d6ab",
                        "source_entry_id": "7f1153fb-f71d-3adb-becf-9adf9b6d483b",
                        "source_sense_id": "b5277f93-d4e8-32de-baf5-68a65ddead8a",
                        "target_lang_word": "Kontrahent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontrahent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f03dafd9-d1fb-35b9-acd8-b59b751a177d",
                                        "entry_id": "fd00848a-8795-3bff-8269-2b1ccd446cb2",
                                        "glosses": [
                                            "jemand, der gegen jemanden antritt; ein Gegner in einer Wettkampf- oder Konfliktsituation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86803970-f1aa-4cef-9ff9-653ebd47c56b",
                                                "sense_id": "f03dafd9-d1fb-35b9-acd8-b59b751a177d",
                                                "text": "Die Kontrahenten haben den Ring betreten und starren sich entschlossen an."
                                            },
                                            {
                                                "example_id": "3c3ece39-8f5f-4482-9536-b70191141264",
                                                "sense_id": "f03dafd9-d1fb-35b9-acd8-b59b751a177d",
                                                "text": "„Allfälliger Kontrahent und eventueller Partner der Donaumonarchie in ihrer Balkanpolitik war in erster Linie das Zarenreich.“"
                                            },
                                            {
                                                "example_id": "eb5782ad-71db-4e0c-a8a9-5f59f900de80",
                                                "sense_id": "f03dafd9-d1fb-35b9-acd8-b59b751a177d",
                                                "text": "„Seine Ehe konnte er kitten, den Rest nicht: 1804 starb er, nachdem er sich am Hudson River mit einem seiner langjährigen Kontrahenten duelliert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8831845-021e-329c-b499-66ebad6892be",
                                        "entry_id": "fd00848a-8795-3bff-8269-2b1ccd446cb2",
                                        "glosses": [
                                            "Vertragspartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91b1216-50a5-42cc-b0d2-df7b077e5686",
                                                "sense_id": "a8831845-021e-329c-b499-66ebad6892be",
                                                "text": "„Der Kontrahent (von lat. con-trahere „zusammenziehen, vereinigen, bewirken“) ist eine Person, die einen Vertrag (Kontrakt) abschließt.“"
                                            },
                                            {
                                                "example_id": "7e970bca-dda4-45fe-85b8-77d7ebc6ef5e",
                                                "sense_id": "a8831845-021e-329c-b499-66ebad6892be",
                                                "text": "„Der Offenlegungsgrundsatz verlangt nicht die Nennung des Namens des Geschäftsherrn durch den Vertreter; es genügt, wenn sich der dritte Kontrahent jederzeit danach erkundigen oder darüber informieren kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
