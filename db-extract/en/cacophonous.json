        "zh-extract.jsonl": [
            {
                "entry_id": "1548d29f-dead-3817-bf28-5a21a6c99bbb",
                "word": "cacophonous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10b2b4ca-9c5a-4aee-b1ca-0e324453aaa0",
                        "entry_id": "1548d29f-dead-3817-bf28-5a21a6c99bbb",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more cacophonous"
                    },
                    {
                        "form_id": "8289fbcc-dfa8-4065-9f25-32c94fc926db",
                        "entry_id": "1548d29f-dead-3817-bf28-5a21a6c99bbb",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most cacophonous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                        "entry_id": "1548d29f-dead-3817-bf28-5a21a6c99bbb",
                        "glosses": [
                            "刺耳的，难听的，走调的"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7e9308-da86-4df3-96f0-f3220114ad23",
                                "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                                "text": "[…] Huple had rescued them just in time by seizing the controls back from Dobbs and leveling the ship out almost as suddenly right back in the middle of the buffeting layer of cacophonous flak from which they had escaped successfully only a moment before."
                            },
                            {
                                "example_id": "99278911-3a69-4e19-985c-38c3c0ae3c9b",
                                "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                                "text": "The good thing about this job is that it gives me time and space to contemplate the future at my leisure, whilst the city sleeps, free from the cacophonous curiosity of the hoi polloi."
                            },
                            {
                                "example_id": "9306b96c-d699-479a-8d66-29339109ee77",
                                "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                                "text": "The first time I saw the NYC quartet [Sonic Youth] was in 1983 for their Confusion Is Sex album, when they filled The Venue in Victoria, London with a cacophonous maelstrom of mangled sounds that still reverberates, more than two decades on."
                            },
                            {
                                "example_id": "e12f6569-2e79-40d8-9f2f-15d37bc4e263",
                                "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                                "text": "[…] and the cacophonous clatter of pots and pans accompanied the vociferous complaints of the ship's cook."
                            },
                            {
                                "example_id": "4642045b-714e-4903-9b50-9773c98718c7",
                                "sense_id": "c0d0d6b4-16d2-305b-9ddb-9d1f25be177e",
                                "text": "A colony of pelicans can be cacophonous."
                            }
                        ]
                    }
                ],
                "translations": [],
