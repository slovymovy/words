                "senses": [
                    {
                        "sense_id": "614fab35-147c-3fbe-ac89-351b2adce162",
                        "entry_id": "885a064e-9661-3a53-9ffc-b913d8616f7c",
                        "glosses": [
                            "техн. то же что смешанный, составной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf51b6e-484b-426d-80b9-b2819c7ab29a",
                                "sense_id": "614fab35-147c-3fbe-ac89-351b2adce162",
                                "text": "Электронный или компаундный регулятор напряжения."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ae3928f-995d-3aa0-82f5-559ff5d83da3",
                        "entry_id": "885a064e-9661-3a53-9ffc-b913d8616f7c",
                        "glosses": [
                            "техн. свойственый компаунд-машине, характерный для компаунд-машины, либо имеющий к компаунд-машине иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c321c80-5c60-40c6-93e2-bd4f5e45b784",
                                "sense_id": "0ae3928f-995d-3aa0-82f5-559ff5d83da3",
                                "text": "Только спустя 10 лет новый компаундный турбонаддувный дизель появился на тяжелых грузовиках."
                            }
                        ]
                    },
                    {
                        "sense_id": "cae03c02-9b21-3494-b8ca-e61f8acdd1fd",
                        "entry_id": "885a064e-9661-3a53-9ffc-b913d8616f7c",
                        "glosses": [
                            "хим., техн. свойственый полимерному компаунду, характерный для полимерному компаунду, либо имеющий к полимерному компаунду иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae498087-7a37-4df0-af88-859df33f7451",
                                "sense_id": "cae03c02-9b21-3494-b8ca-e61f8acdd1fd",
                                "text": "Другая часть жидкого диоксида углерода из компаундного ресивера РКЦ-2 забирается циркуляционными насосами НЦ-2."
                            }
                        ]
                    }
                ],
