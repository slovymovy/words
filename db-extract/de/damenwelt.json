                ],
                "senses": [
                    {
                        "sense_id": "843f07f5-6003-340c-9506-8c1186daeed8",
                        "entry_id": "4bdc21b2-6d35-3ae9-8886-44df73ee326e",
                        "glosses": [
                            "die Gesamtheit der Damen/Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b65075-a483-41a6-ab49-04374dc4e8ff",
                                "sense_id": "843f07f5-6003-340c-9506-8c1186daeed8",
                                "text": "„Einerseits verwunderlich, andererseits schon wieder logisch ist dann die Tatsache, dass durch das vermehrte Auftauchen von hübsch anzuschauenden, schaumgekrönten Kaffeespezialitäten à la Cappuccino, Latte Macchiato oder Milchkaffee auch die Damenwelt ungetrübte Freude an dem schwarzen Trank bekommt.“"
                            },
                            {
                                "example_id": "cd291ef1-0589-4d36-bfa3-7b47a95d2279",
                                "sense_id": "843f07f5-6003-340c-9506-8c1186daeed8",
                                "text": "„Wer so durch die Straßen stolzieren konnte, erregte Aufmerksamkeit bei der Damenwelt.“"
                            },
                            {
                                "example_id": "b8cdd17b-b5cc-4e1b-a35a-c38e77c3b60d",
                                "sense_id": "843f07f5-6003-340c-9506-8c1186daeed8",
                                "text": "„Meine Teilnahme gilt heute der Damenwelt und einem Umstand, der auch den Herren nicht mehr länger gleichgültig sein kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
