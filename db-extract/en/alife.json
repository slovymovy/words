                                "example_id": "1a7759a0-9cae-4eaa-982e-580b9b9e9723",
                                "sense_id": "3da0bcc8-0c4e-31c3-b2ad-021bf28946cd",
                                "text": "Saffron loueth a-life to be trampled and trod vpon."
                            },
                            {
                                "example_id": "8bd59613-4d2e-4729-95ce-d9dc8563e154",
                                "sense_id": "3da0bcc8-0c4e-31c3-b2ad-021bf28946cd",
                                "text": "A busie fellow loveth a-life to step secretly into a house."
                            },
                            {
                                "example_id": "1aa3d2a2-3181-4cba-a095-9734319d6e67",
                                "sense_id": "3da0bcc8-0c4e-31c3-b2ad-021bf28946cd",
                                "text": "Fla[via]. Come, Sir Pergamus, till your horse come, you and I'll go play at shuttle-cock. / Per[gamus]. A match i'faith. I love that sport a' life. Yet my mother charged me not to use it for fear of putting my arm out of joint."
                            }
                        ]
                    }
