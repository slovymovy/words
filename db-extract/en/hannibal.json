                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae8e4ab7-04a2-4df2-8421-f3bd4801c982",
                                                "sense_id": "604ed70a-b50c-37d5-b78b-cb50ac05f550",
                                                "text": "Hannibal ist sein zweiter Vorname."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3be1f34f-ef8a-3742-abca-ebdcf3f10c56",
                                        "entry_id": "0668b229-9d7f-3faa-96c7-9c8f9b1e4ac2",
                                        "glosses": [
                                            "ein karthagischer Feldherr (* um 247 v. Chr; † 183 v. Chr.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a0795b-33d7-47c0-aec6-73643df62816",
                                                "sense_id": "3be1f34f-ef8a-3742-abca-ebdcf3f10c56",
                                                "text": "Als Hannibal 211 vor Christus gegen Rom zog, schrien die Römer: Hannibal ante portas! (Hannibal steht vor den Toren)"
                                            },
                                            {
                                                "example_id": "87081a78-6bc7-4a0e-a7d1-d3d1a50a61dc",
                                                "sense_id": "3be1f34f-ef8a-3742-abca-ebdcf3f10c56",
                                                "text": "„Hannibal, so lautet der häufig erhobene Vorwurf, hätte nach dem römischen Debakel den Krieg durch die Einnahme Roms beenden können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
