                "senses": [
                    {
                        "sense_id": "ce34197a-4858-3b6b-a605-07ecdc014f3e",
                        "entry_id": "854a9cca-9d1e-3ba8-ba77-38fb38a426cf",
                        "glosses": [
                            "разг. делать дурачества, глупости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b41dddc-1338-4a71-b8aa-d404a9431f6c",
                                "sense_id": "ce34197a-4858-3b6b-a605-07ecdc014f3e",
                                "text": "— До сих пор ты молчала и была согласна, а теперь, когда всё решено, ты вздумала капризничать и отрекаться. Не изволь дурачиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "382022a0-7eda-33d8-9187-9caf7ab6288a",
                        "entry_id": "854a9cca-9d1e-3ba8-ba77-38fb38a426cf",
                        "glosses": [
                            "разг. забавляться дурачеством, шутками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5230270-64da-4cfb-bbcf-920ef5b983fa",
                                "sense_id": "382022a0-7eda-33d8-9187-9caf7ab6288a",
                                "text": "[Рябовский] прыгал, дурачился и на серьёзные вопросы отвечал шутками."
                            }
                        ]
                    }
