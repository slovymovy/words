                    },
                    {
                        "translation_id": "0e2cdddf-a820-40a6-92d0-3289877154ed",
                        "source_entry_id": "dc12f36f-c597-3e1f-91f8-7036ce31d331",
                        "source_sense_id": "60ef25df-bb6e-34f3-8638-242b3de754a9",
                        "target_lang_word": "Breslau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Breslau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                        "entry_id": "8b0049b2-56bd-309f-9281-56e6f395bdbe",
                                        "glosses": [
                                            "deutsche Bezeichnung der Stadt Wrocław, Niederschlesien, Polen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b5054d-f495-41c3-b84b-eb2a502821e5",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "Ich bin in Breslau geboren."
                                            },
                                            {
                                                "example_id": "1f7932a7-60cf-4175-a80a-77095a5e1d4a",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "Ich habe in Breslau meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "5f5e2a52-2903-45be-a979-b46fcc897037",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "Breslau ist die Metropole Niederschlesiens."
                                            },
                                            {
                                                "example_id": "614b7979-561a-467c-92a8-8bf1c0d8b242",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "Das Breslau der zwanziger Jahre war eine geschäftstüchtige Stadt."
                                            },
                                            {
                                                "example_id": "fd7604a0-d1d9-41ff-a6a6-fcb9c07ef1b5",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "Nach Breslau führen viele Wege."
                                            },
                                            {
                                                "example_id": "9a8cab0a-275f-4be9-8edf-a367fa89b2e3",
                                                "sense_id": "eac3f873-18da-3f9a-ba01-861a236b747a",
                                                "text": "„Mit ihren zwanzig Jahren hatte sie Breslau noch nie verlassen und war wohl neugierig, wie die übrige Welt aussah; es mußte sehr reizvoll für sie sein, mit Dresden zu beginnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Breslau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                        "entry_id": "10f25c3d-32b2-3a64-877d-12f0a904dd6e",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024395c0-e8b3-4e70-a844-c7eea375e60f",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Breslaus kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "70d9071f-5900-4133-a28a-2f7dd361d922",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Frau Breslau ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c10ed8b0-2793-4fc1-9c4b-7f91f68d6793",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Herr Breslau wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f2b6896f-f2df-4759-a331-c44e3683e699",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Die Breslaus fahren heute nach Köln."
                                            },
                                            {
                                                "example_id": "76c7822f-fafd-41ef-93d4-dd2814b43aee",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Der Breslau trägt nie die Pullover, die die Breslau ihm strickt."
                                            },
                                            {
                                                "example_id": "e49fc303-727e-424a-8d4e-a3b5094f2f00",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breslau kommt, geht der Herr Breslau.“"
                                            },
                                            {
                                                "example_id": "347ae26b-9cb4-4430-9632-9328e284d469",
                                                "sense_id": "92618fbb-065a-3bbf-a5df-9888cb42865b",
                                                "text": "Breslau kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
