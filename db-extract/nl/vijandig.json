                                    },
                                    {
                                        "sense_id": "95daa884-02f9-38ef-9822-2ed69e2361f4",
                                        "entry_id": "737a4273-19e9-3fd7-b0b2-6b688d748376",
                                        "glosses": [
                                            "Unwilling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "950b8e82-c5fe-3902-a0cb-23c6d180b511",
                                        "entry_id": "737a4273-19e9-3fd7-b0b2-6b688d748376",
                                        "glosses": [
                                            "Being or relating to a hostile takeover."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e507ec04-9bbc-47ba-a657-2b3a4ffa8fb6",
                                                "sense_id": "950b8e82-c5fe-3902-a0cb-23c6d180b511",
                                                "text": "Microsoft may go hostile in its bid for Yahoo! as soon as Friday, according to a published report."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1ae90da-5cb4-4d6d-8719-a46ba5ba741d",
                        "source_entry_id": "8c2745f3-0eea-3132-9d1a-40b1e59bc786",
                        "source_sense_id": "7501bea9-9e1b-3a29-b61f-61a70c25eba9",
                        "source_sense_description": "zich als een vijand gedragend",
                        "target_lang_word": "truculent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truculent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5258827f-467f-3918-aca5-6e98e54b2c9a",
                                        "entry_id": "aa40f059-8147-32b8-a668-735c56c3e96f",
                                        "glosses": [
                                            "Cruel or savage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4eeca2-8e10-48fb-aec7-3eda779c4ff0",
                                                "sense_id": "5258827f-467f-3918-aca5-6e98e54b2c9a",
                                                "text": "The truculent soldiers gave us a steely-eyed stare."
                                            },
                                            {
                                                "example_id": "7f1c3ab2-1e95-4092-bf62-78e7fb4395c6",
                                                "sense_id": "5258827f-467f-3918-aca5-6e98e54b2c9a",
                                                "text": "She really was a most charming girl, and might have passed for a captive fairy, whom that truculent Ogre, Old Barley, had pressed into his service."
                                            },
                                            {
                                                "example_id": "6414ce1d-23d5-469f-8ca9-4cab1edff646",
                                                "sense_id": "5258827f-467f-3918-aca5-6e98e54b2c9a",
                                                "text": "His face was very truculent, grey and massive, with black cavernous nostrils and circled by a scanty white fur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3246576-a255-3ea7-8c73-f5a52361a74f",
                                        "entry_id": "aa40f059-8147-32b8-a668-735c56c3e96f",
                                        "glosses": [
                                            "Defiant or uncompromising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bf14bd-30dc-4e90-a166-94ae896c3e53",
                                                "sense_id": "e3246576-a255-3ea7-8c73-f5a52361a74f",
                                                "text": "In her turn, Helen Burns asked me to explain, and I proceeded forthwith to pour out, in my own way, the tale of my sufferings and resentments. Bitter and truculent when excited, I spoke as I felt, without reserve or softening."
                                            },
                                            {
                                                "example_id": "92852ccf-330e-459f-9332-9bf7d2401901",
                                                "sense_id": "e3246576-a255-3ea7-8c73-f5a52361a74f",
                                                "text": "Rokoff assumed a truculent air, attempting by bravado to show how little he feared Tarzan’s threats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                                        "entry_id": "aa40f059-8147-32b8-a668-735c56c3e96f",
                                        "glosses": [
                                            "Eager or quick to argue, fight or start a conflict."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132b1880-2db1-47bb-b156-afada44fef7a",
                                                "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                                                "text": "She might pity herself, but he must not pity her. She did not want any quarrel; she blamed him for wanting one, but she could not help assuming a truculent attitude."
                                            },
                                            {
                                                "example_id": "72822a92-a66a-409f-8fb1-29e6c95befa2",
                                                "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                                                "text": "If he came too close to a she with a young baby, the former would bare her great fighting fangs and growl ominously, and occasionally a truculent young bull would snarl a warning if Tarzan approached while the former was eating."
                                            },
                                            {
                                                "example_id": "83d4927c-e7c7-4983-9e69-ebf14749e205",
                                                "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                                                "text": "It is an important source of the value of moral rights then that — speaking very generally — they dispose people with opposed interests to be reasonable rather than arrogant and truculent."
                                            },
                                            {
                                                "example_id": "89c22295-3f1d-4323-acf5-d5cce7cf7942",
                                                "sense_id": "f64fbe98-7379-3009-8839-1d35ecee0ba1",
                                                "text": "These bitches is getting truculent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df1e6f2-1f2a-35b3-9624-090081ec5f79",
                                        "entry_id": "aa40f059-8147-32b8-a668-735c56c3e96f",
                                        "glosses": [
                                            "Violent; rude; scathing; savage; harsh."
                                        ],
                                        "tags": [
                                            "of speech or writing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ef729b-d8b8-4b45-a0be-7d6833ec0157",
                                                "sense_id": "4df1e6f2-1f2a-35b3-9624-090081ec5f79",
                                                "text": "Voltaire is never either gross or truculent."
                                            },
                                            {
                                                "example_id": "caaa543a-c220-467a-b74d-3cfc09dc22f4",
                                                "sense_id": "4df1e6f2-1f2a-35b3-9624-090081ec5f79",
                                                "text": "[…] or again, the first whispering of love, dainty and witty and tender, to the girl he served a few days ago with sateen, or a gallant rescue of generalised beauty in distress from truculent insult or ravening dog."
                                            },
                                            {
                                                "example_id": "5fc8485f-22c3-4f6c-946a-719a34b2d5b9",
                                                "sense_id": "4df1e6f2-1f2a-35b3-9624-090081ec5f79",
                                                "text": "Cahusac appeared to be having it all his own way, and he raised his harsh, querulous voice so that all might hear his truculent denunciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a616a1e-1ed8-3efe-89bf-f5d4d5d916d6",
                                        "entry_id": "aa40f059-8147-32b8-a668-735c56c3e96f",
                                        "glosses": [
                                            "Destructive; deadly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aab79b9-e592-43f4-b293-cbd6deff9bb5",
                                                "sense_id": "8a616a1e-1ed8-3efe-89bf-f5d4d5d916d6",
                                                "text": "More or less truculent Plagues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "019e7320-f43b-467e-9423-b271fbe4b786",
                        "source_entry_id": "8c2745f3-0eea-3132-9d1a-40b1e59bc786",
                        "source_sense_id": "7501bea9-9e1b-3a29-b61f-61a70c25eba9",
                        "source_sense_description": "zich als een vijand gedragend",
                        "target_lang_word": "hostile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3cc34e-344d-3a7c-a3bc-bc77cfab5a4c",
                                        "entry_id": "2aab8927-6043-3a32-8dd7-6ec1eee7ea6d",
                                        "glosses": [
                                            "Qui est d’un ennemi, qui annonce, qui caractérise un ennemi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1634fb40-0a88-4fe3-976c-31f116d0126f",
                                                "sense_id": "9f3cc34e-344d-3a7c-a3bc-bc77cfab5a4c",
                                                "text": "Le pape Innocent III (1193-1216) devait rompre avec cette tradition de tolérance et se faire l’inspirateur d’une politique hostile, qu’il mena avec une vigueur exceptionnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                                        "entry_id": "2aab8927-6043-3a32-8dd7-6ec1eee7ea6d",
                                        "glosses": [
                                            "Qui est fermement opposé à quelque chose ou à quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024341ba-26a2-479e-b395-420e37fee1cd",
                                                "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                                                "text": "Les historiens de la philosophie me paraissent avoir été très hostiles à Xénophon parce qu'il est trop vieux Grec; Platon leur convient mieux parce qu’il est plus aristocrate, et par suite plus détaché de l’économie."
                                            },
                                            {
                                                "example_id": "381ae064-391e-4b14-94c2-aaca4f927b6d",
                                                "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                                                "text": "Il est le premier ministre de la Guerre qui se soit déclaré hostile à l’alliance franco-russe, thème favori des hommes de la « Jésuitière »."
                                            },
                                            {
                                                "example_id": "fe518a61-5c93-4e68-8a1d-9f664b9370c5",
                                                "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                                                "text": "Entre la petite Écosse, pauvre, calviniste et profrançaise, et la puissante Angleterre, épiscopalienne et traditionnellement hostile à la France, les relations n’ont jamais été de tout repos."
                                            },
                                            {
                                                "example_id": "a1abb541-16f2-4345-bba4-a56be58bd37a",
                                                "sense_id": "93ee0b5e-95b6-32cd-89ce-7942af1d9450",
                                                "text": "Il faut reconnaître que la ville, ses trottoirs transformés en « crottoirs » (où maintenant circulent souvent des deux roues) et ses espaces verts où sont comptés les cimetières, constitue un monde hostile pour l'enfant qui n'y n'a plus sa place, voire dérange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66d2504-c8b5-3040-a5ab-8a8e8e58c957",
                                        "entry_id": "2aab8927-6043-3a32-8dd7-6ec1eee7ea6d",
                                        "glosses": [
                                            "Qualifie une OPA qui n’a pas l’assentiment de, voire est jugée indésirable par, la société visée par ladite OPA."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c78d26-901e-46d4-88a3-6e12fd1947ec",
                                                "sense_id": "b66d2504-c8b5-3040-a5ab-8a8e8e58c957",
                                                "text": "La première OPA hostile en France a été menée par le verrier BSN sur Saint-Gobain à la fin des années 1960. Ce fut un échec, notamment du fait des réactions de l’establishment de l'époque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
