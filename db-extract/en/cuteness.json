                        "entry_id": "e60a627c-0e9b-3ef3-bbbc-5fd043fd52d0",
                        "glosses": [
                            "The state of being cute (endearingly attractive)."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "67824e6a-be87-4422-9a6b-942981ddc787",
                                "sense_id": "9fa83bc3-aa36-3df8-90d1-6d932b85b443",
                                "text": "It is music of great and quiet charm and proves to be a pleasant discovery after the more superficial cutenesses of Chaminade."
                            },
                            {
                                "example_id": "55cfaaa1-06a2-4a9e-b9de-679bd3b91234",
                                "sense_id": "9fa83bc3-aa36-3df8-90d1-6d932b85b443",
                                "text": "The craving for cuteness is a psychological phenomenon that originally had the purpose of increasing the chances of a baby to survive […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff89c3a5-efd2-336d-b8cc-f69fee6f96a5",
