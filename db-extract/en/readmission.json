    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ca556917-1513-33d3-b375-b75feb99a93a",
                "word": "readmission",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33b2ac46-4531-448b-b1ba-a3c54b26f859",
                        "entry_id": "ca556917-1513-33d3-b375-b75feb99a93a",
                        "tags": [
                            "plural"
                        ],
                        "form": "readmissions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d38cb72-ec13-3360-8daa-c3ddd8927638",
                        "entry_id": "ca556917-1513-33d3-b375-b75feb99a93a",
                        "glosses": [
                            "A second or subsequent admission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9578a38f-4ec3-4615-94ff-54b022fd02ba",
                                "sense_id": "8d38cb72-ec13-3360-8daa-c3ddd8927638",
                                "text": "On the Freshwater line, the most outstanding improvement was the readmission of all trains to the main station at Newport, and the introduction of a through service in each direction between Ventnor and Freshwater, via Sandown and Newport, calling only at the principal stations."
                            },
                            {
                                "example_id": "718d4b97-5199-4b79-86c1-f9c905921b0f",
                                "sense_id": "8d38cb72-ec13-3360-8daa-c3ddd8927638",
                                "text": "Multiple escapes and readmissions to this facility."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e32bd9b-9396-4597-b76e-e67b976404f7",
                        "source_entry_id": "ca556917-1513-33d3-b375-b75feb99a93a",
                        "source_sense_id": "8d38cb72-ec13-3360-8daa-c3ddd8927638",
                        "source_sense_description": "a second or subsequent admission",
                        "target_lang_word": "Wiederaufnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederaufnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                        "entry_id": "e7dc0acd-7c5a-3094-8321-ea20a4abb816",
                                        "glosses": [
                                            "Fortsetzung einer unterbrochenen Tätigkeit oder eines unterbrochenen Vorganges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd7201ed-3aad-4840-9c53-883a3a1d466d",
                                                "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                                "text": "Die NASA hat die Wiederaufnahme der Shuttleflüge ins All geplant."
                                            },
                                            {
                                                "example_id": "51a20444-3bdd-412e-a530-c780c31ac5fc",
                                                "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                                "text": "Der Betriebsrat zeigte sich zur Wiederaufnahme der Verhandlungen bereit."
                                            },
                                            {
                                                "example_id": "e500ebb2-bb9b-4144-b1a5-c5e26571d4d0",
                                                "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                                "text": "1.800 aus aller Welt eingegangene Bestellungen ermöglichen die Wiederaufnahme der Produktion im Fahrradwerk Nordhausen."
                                            },
                                            {
                                                "example_id": "bb640fc9-5856-4330-9510-7952c4b0140f",
                                                "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                                "text": "Die USA und Südkorea hatten zuvor als Bedingung gestellt, dass Nordkorea vor der Wiederaufnahme dieser Runde seine Verantwortung für den Cheonan-Abschuss eingesteht."
                                            },
                                            {
                                                "example_id": "a7cfb5d9-44c9-49c1-85ed-6d04813cfe45",
                                                "sense_id": "e7f506b5-ab66-3235-b130-653e0aa7c087",
                                                "text": "Mit der Aufhebung des Wählerreferendums am Mittwoch gab das Gericht aber nicht automatisch Erlaubnis für eine sofortige Wiederaufnahme gleichgeschlechtlicher Eheschließungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e946643c-e341-3950-a9cd-d6b0accd788b",
                                        "entry_id": "e7dc0acd-7c5a-3094-8321-ea20a4abb816",
                                        "glosses": [
                                            "mehr oder weniger unverändere Wiederholung innerhalb eines Satzes, die nicht direkt auf das Wiederholte folgt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e80e9308-2da9-37d9-8f8b-334550cd25fd",
                                        "entry_id": "e7dc0acd-7c5a-3094-8321-ea20a4abb816",
                                        "glosses": [
                                            "Anfang einer neuen Aufführungsserie einer Inszenierung nach längerer Unterbrechung"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80db5502-81b1-4a64-84cc-a2bc8887241b",
                                                "sense_id": "e80e9308-2da9-37d9-8f8b-334550cd25fd",
                                                "text": "Die Wiederaufnahme des Märchens ist weiter verschoben worden, da im Landestheater die Bühne nun doch nicht zur Verfügung steht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fb4c88-6576-4c27-8303-c47332295850",
