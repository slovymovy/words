        "fr-extract.jsonl": [
            {
                "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                "word": "ourson",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d6a2518-f5d6-48e7-933f-21a88a5b5120",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
