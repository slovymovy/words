                        "entry_id": "393f3961-953c-3561-8534-4d0f85798723",
                        "glosses": [
                            "отсутствие веры, уверенности в осуществлении чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d6c7b4f-8d76-31a2-bd3c-c49904da0565",
                        "entry_id": "393f3961-953c-3561-8534-4d0f85798723",
                        "glosses": [
                            "отсутствие веры в Бога; атеизм"
                        ],
                        "tags": [],
