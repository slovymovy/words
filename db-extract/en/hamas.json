                                "sense_id": "8c38c445-0901-322c-9615-910c0ecbfe57",
                                "text": "He wanted to travel to Gaza in the Palestinian territories to join HAMAS’ military wing, the Izz ad-Din al-Qassam Brigade in its fight against Israel."
                            },
                            {
                                "example_id": "087eb7b5-658e-4242-a230-adc531f8893e",
                                "sense_id": "8c38c445-0901-322c-9615-910c0ecbfe57",
                                "text": "HAMAS emerged in 1987 during the first Palestinian uprising, or intifada, as an outgrowth of the Muslim Brotherhood’s Palestinian branch."
                            }
                        ]
