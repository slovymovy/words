    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
                "word": "icily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dc421c5b-81ce-413d-a27c-e21299113ced",
                        "entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more icily"
                    },
                    {
                        "form_id": "96ec97d8-ebaa-4e42-8ef3-20c4ddd988c9",
                        "entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most icily"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d8df74c-32bb-36e6-9c38-3c350bcf793b",
                        "entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
                        "glosses": [
                            "In the manner of ice; with a cold or chilling effect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd68733-ecfb-4e78-903c-b5aa6c805d11",
                                "sense_id": "6d8df74c-32bb-36e6-9c38-3c350bcf793b",
                                "text": "The cold Alpine air flowed icily into his car, so he stopped by the roadside to put on a leather trench-coat, thick scarf, and woollen hat[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e09cd00a-ed8a-35b3-8ed0-2649e5351432",
                        "entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
                        "glosses": [
                            "In an uncaring or coolly angry manner."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b1976939-5fe1-4ca8-9bea-15b3bac8e712",
                                "sense_id": "e09cd00a-ed8a-35b3-8ed0-2649e5351432",
                                "text": "[…]quite often her husband and Jo did not eat at home, or sat icily silent through a meal."
                            },
                            {
                                "example_id": "e7fd2dc2-71eb-4aa0-b6f7-e69654feefa7",
                                "sense_id": "e09cd00a-ed8a-35b3-8ed0-2649e5351432",
                                "text": "Bond had pulled her head back by her hair and had kissed her once, long and cruelly. Then he had told her to go to sleep and had leant back and waited icily for his body to leave him alone."
                            },
                            {
                                "example_id": "a84ebcfa-4c4d-4f36-a87f-af67d4dc7853",
                                "sense_id": "e09cd00a-ed8a-35b3-8ed0-2649e5351432",
                                "text": "\"So I was made to look the fool?\" Jason said icily."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce251acf-fa93-4d40-88f3-bc42c3814bb9",
                        "source_entry_id": "174d16f6-7231-381e-8ecc-9d3a07c77342",
