                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b4da99a-db51-46d7-8b31-bb4866b7bf0f",
                                                "sense_id": "ede4d0ec-d9db-39ea-a1c3-f75c838676a0",
                                                "text": "Bij de supermarkt kochten we een hortensia met 6 koppen"
