            "senses": [
                {
                    "sense_id": "f1bad1d0-b01e-3862-8fc2-a299c5428eaf",
                    "sense_definition": "Interférer indûment dans les affaires, les fonctions, le temps ou les droits légitimes d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le travail à distance ne doit pas trop <w>empiéter</w> sur la vie privée des employés."
                        },
                        {
                            "text": "Le nouveau responsable administratif <w>empiète</w> souvent sur les prérogatives de son collègue."
                        }
                    ],
                    "synonyms": [
                        "déborder",
                        "usurper"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
