                                        "entry_id": "65e24ab7-2581-351d-abb1-77e57355892a",
                                        "glosses": [
                                            "Membre de la famille des caprinés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a6d515-f67d-4a9c-9499-e14d112f7ec5",
                                                "sense_id": "e08d5abf-f28b-3e91-a130-3cb09fae5ae9",
                                                "text": "Le bœuf musqué est un capriné."
                                            },
                                            {
                                                "example_id": "46b12e11-a7d0-413a-8072-135597755143",
                                                "sense_id": "e08d5abf-f28b-3e91-a130-3cb09fae5ae9",
                                                "text": "Espérons juste que cet enfant ne soit pas un artiodactyle, un bovidé, un capriné."
                                            }
                                        ]
