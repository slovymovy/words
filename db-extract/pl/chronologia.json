                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6989365-e093-323e-a0f7-7f31c7c6cb24",
                                        "entry_id": "9da85bdd-a36f-3483-8a62-9b41fa51a070",
                                        "glosses": [
                                            "An arrangement of events into chronological order; called a timeline when involving graphical elements."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66fba347-1401-457e-bf5a-33fab5bf6ee7",
                                                "sense_id": "d6989365-e093-323e-a0f7-7f31c7c6cb24",
                                                "text": "The film's chronology is not entirely obvious, but can be worked out by the clothes the characters are wearing in the scenes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ad8e707-aa42-4c2e-958d-426029d6cc31",
                        "source_entry_id": "cb37b054-5185-399f-b18d-6d7c6bf8995c",
