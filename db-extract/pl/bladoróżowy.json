                "senses": [
                    {
                        "sense_id": "a73b83e7-2a8b-3320-9245-0b03b87c8b18",
                        "entry_id": "35602b5f-7fe3-30f1-8926-5a44b8db7f37",
                        "glosses": [
                            "różowy o bladym, rozbielonym odcieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f79b7953-9380-47b0-b95d-68e8617122a2",
                                "sense_id": "a73b83e7-2a8b-3320-9245-0b03b87c8b18",
                                "text": "W domku zapewne było biuro: na daszku łopotała bezwładnie bladoróżowa flaga, już postrzępiona"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f70a88b-01ff-4e3a-9d25-e8f759075c0a",
                        "source_entry_id": "35602b5f-7fe3-30f1-8926-5a44b8db7f37",
                        "source_sense_id": "a73b83e7-2a8b-3320-9245-0b03b87c8b18",
                        "target_lang_word": "blassrosa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blassrosa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad13a204-c62e-30da-bd8a-54d47042a635",
                                        "entry_id": "4371e483-8d31-3288-a79a-d26c4accece2",
                                        "glosses": [
                                            "von hellem, mattem Rosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501b2969-d6d4-4854-b107-420a861dab35",
                                                "sense_id": "ad13a204-c62e-30da-bd8a-54d47042a635",
                                                "text": "„Als er aus der Wanne stieg, war das Wasser blassrosa, und aus den Wunden in seinem Bein sickerte noch immer wässrig verdünntes Blut mit Serum.“"
                                            },
                                            {
                                                "example_id": "aed7c36e-508b-4c8f-8ea0-8e44169ff826",
                                                "sense_id": "ad13a204-c62e-30da-bd8a-54d47042a635",
                                                "text": "„Die riesenhafte Gestalt glänzte, als habe man ihr die Haut abgezogen; im düsteren Zwielicht erschien sie blassrosa und sonderbar unbeständig.“"
                                            },
                                            {
                                                "example_id": "52a4534d-39d7-4aff-b6c3-8fe62173db46",
                                                "sense_id": "ad13a204-c62e-30da-bd8a-54d47042a635",
                                                "text": "„Offenbar hat es nachts geregnet, aber als Nasha und ich aus der Hauptschleuse treten, steht die Sonne auf halber Höhe an einem blassrosa Himmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
