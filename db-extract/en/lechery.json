                    {
                        "translation_id": "d8adb1c9-a914-48ad-800e-44a8f31fa84c",
                        "source_entry_id": "c578c0c4-73b6-3302-97fa-b54cf5edb9a7",
                        "source_sense_id": "5091358b-a894-36de-96a1-ca4d5a9e4b39",
