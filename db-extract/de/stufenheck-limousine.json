                "senses": [
                    {
                        "sense_id": "d1704d32-aafd-3f2c-a729-5fbd6135af53",
                        "entry_id": "2646c7f1-285d-37c0-a779-d60c33a063f4",
                        "glosses": [
                            "ein viertüriges Auto mit einem sogenannten Stufenheck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b89ec42-a304-4294-8a7e-5d8c95d6e854",
                                "sense_id": "d1704d32-aafd-3f2c-a729-5fbd6135af53",
                                "text": "„Der Seat 132 ist eine viertürige Stufenheck-Limousine mit Hinterradantrieb im Segment der Oberen Mittelklasse.“"
                            },
                            {
                                "example_id": "401bddbf-a3be-4364-bbca-0ad1013ce47d",
                                "sense_id": "d1704d32-aafd-3f2c-a729-5fbd6135af53",
                                "text": "„Der von Giugiaro 2004 gestaltete und von Pininfarina im Jahre 2007 überarbeitete Brilliance BS6 ist eine chinesische Stufenheck-Limousine des Herstellers Brilliance China Auto, die im Werk der BMW Brilliance Automotive in Shenyang montiert wird.“"
                            },
                            {
                                "example_id": "c5a58b2e-bd11-4b7b-b27d-0756c28f924f",
                                "sense_id": "d1704d32-aafd-3f2c-a729-5fbd6135af53",
                                "text": "„Der VW-Phaeton ist seit dem Mai 2002 als viertürige Stufenheck-Limousine auf dem Markt.“"
                            }
                        ],
