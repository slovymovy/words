                                        "glosses": [
                                            "A row of balusters topped by a rail, serving as an open parapet, as along the edge of a balcony, terrace, bridge, staircase, or the eaves of a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25909899-688a-4a95-aa82-af639fece015",
                                                "sense_id": "49064ec5-1913-3492-9862-2fad58691659",
                                                "text": "So on a pleasant morning, as he leant / Into the sun-rise, o’er the balustrade [...]"
                                            },
                                            {
                                                "example_id": "038599ee-7685-485a-84eb-4491664b2854",
                                                "sense_id": "49064ec5-1913-3492-9862-2fad58691659",
                                                "text": "The Jester sat down on one of the marble balustrades and regarded Alvin with a curious intentness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0fbdcef-8d4f-44ba-a976-558067c63fe5",
                        "source_entry_id": "4c5d3f15-1fdd-3b96-99fd-f045d007582e",
