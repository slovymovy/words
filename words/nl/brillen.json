                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «очки» (оптический прибор для коррекции зрения)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очки",
                                "target_lang_sense_clarification": "оптический прибор для улучшения зрения"
                            }
                        ]
                    }
                }
            ]
        },
        {
