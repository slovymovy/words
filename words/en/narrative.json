{
    "word_family": [
        "narrate",
        "narration",
        "narrator",
        "narratology",
        "narrativity"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "333a554f-4d81-375c-a322-b2d7ffa1601f",
                    "sense_definition": "A spoken or written account of connected events; a story.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "storytelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author creates a compelling <w>narrative</w> that keeps the reader engaged until the very last page.",
                            "target_lang_translations": {
                                "ru": "Автор создает захватывающее <w>повествование</w>, которое держит читателя в напряжении до самой последней страницы."
                            }
                        },
                        {
                            "text": "She began a long <w>narrative</w> about her travels through South America during the summer.",
                            "target_lang_translations": {
                                "ru": "Она начала длинный <w>рассказ</w> о своих летних путешествиях по Южной Америке."
                            }
                        }
                    ],
                    "synonyms": [
                        "story",
                        "tale",
                        "account",
                        "chronicle"
                    ],
                    "common_phrases": [
                        "compelling narrative",
                        "personal narrative",
                        "historical narrative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устный или письменный рассказ о связанных событиях; история."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повествование",
                                "target_lang_sense_clarification": "связный рассказ о событиях"
                            },
                            {
                                "target_lang_word": "рассказ",
                                "target_lang_sense_clarification": "словесное изложение событий"
                            },
                            {
                                "target_lang_word": "история",
                                "target_lang_sense_clarification": "эпическое повествование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79e0c912-6b18-39e0-834a-10edd492c08b",
                    "sense_definition": "A particular way of explaining or understanding events, often used to influence public opinion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to control the <w>narrative</w> regarding the recent economic changes.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается контролировать <w>нарратив</w> относительно недавних экономических изменений."
                            }
                        },
                        {
                            "text": "Different news outlets often present a different <w>narrative</w> of the same political event.",
                            "target_lang_translations": {
                                "ru": "Разные новостные агентства часто представляют разную <w>трактовку</w> одного и того же политического события."
                            }
                        }
                    ],
                    "synonyms": [
                        "interpretation",
                        "perspective",
                        "framing"
                    ],
                    "common_phrases": [
                        "control the narrative",
                        "dominant narrative",
                        "false narrative",
                        "change the narrative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный способ объяснения или понимания событий, часто используемый для влияния на общественное мнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарратив",
                                "target_lang_sense_clarification": "интерпретация событий в медиа или политике"
                            },
                            {
                                "target_lang_word": "изложение фактов",
                                "target_lang_sense_clarification": "представление событий под определенным углом"
                            },
                            {
                                "target_lang_word": "трактовка",
                                "target_lang_sense_clarification": "определенное видение ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cf90033-b548-3c50-a22c-3a75bc4fb94a",
                    "sense_definition": "The technique or style used to tell a story within a creative work.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "storytelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film uses a non-linear <w>narrative</w> to show the protagonist's memories out of order.",
                            "target_lang_translations": {
                                "ru": "В фильме используется нелинейное <w>повествование</w>, чтобы показать воспоминания главного героя не по порядку."
                            }
                        },
                        {
                            "text": "Video games allow players to shape their own <w>narrative</w> through the choices they make.",
                            "target_lang_translations": {
                                "ru": "Видеоигры позволяют игрокам формировать свой собственный <w>сюжет</w> через принимаемые ими решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "storytelling",
                        "exposition"
                    ],
                    "common_phrases": [
                        "linear narrative",
                        "narrative structure",
                        "narrative technique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника или стиль, используемые для изложения истории в творческом произведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повествование",
                                "target_lang_sense_clarification": "манера изложения сюжета"
                            },
                            {
                                "target_lang_word": "нарратив",
                                "target_lang_sense_clarification": "структура и стиль изложения в искусстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b6a8814-3c0a-365f-8c88-00e02894862e",
                    "sense_definition": "Consisting of or characterized by the telling of a story.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "descriptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist is known for <w>narrative</w> paintings that depict scenes from ancient mythology.",
                            "target_lang_translations": {
                                "ru": "Художник известен своими <w>повествовательными</w> картинами, изображающими сцены из древней мифологии."
                            }
                        },
                        {
                            "text": "The poem follows a <w>narrative</w> style, describing the hero's journey in great detail.",
                            "target_lang_translations": {
                                "ru": "Стихотворение выдержано в <w>повествовательном</w> стиле, подробно описывающем путешествие героя."
                            }
                        }
                    ],
                    "synonyms": [
                        "storytelling",
                        "anecdotal"
                    ],
                    "common_phrases": [
                        "narrative style",
                        "narrative poem",
                        "narrative art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из рассказа или характеризующийся повествованием истории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повествовательный",
                                "target_lang_sense_clarification": "содержащий рассказ о событиях"
                            },
                            {
                                "target_lang_word": "сюжетный",
                                "target_lang_sense_clarification": "основанный на сюжете или истории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9617d39-c892-38ef-bf5a-80207b237471",
                    "sense_definition": "Relating to the process of narration or the way a story is told.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "descriptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director focused on the <w>narrative</w> thrust of the film to keep the audience interested.",
                            "target_lang_translations": {
                                "ru": "Режиссер сосредоточился на <w>повествовательном</w> порыве фильма, чтобы поддерживать интерес аудитории."
                            }
                        },
                        {
                            "text": "There is a clear <w>narrative</w> arc that connects the beginning of the book to its conclusion.",
                            "target_lang_translations": {
                                "ru": "Существует четкая <w>сюжетная</w> арка, которая связывает начало книги с ее завершением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrative arc",
                        "narrative voice",
                        "narrative flow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к процессу повествования или способу изложения истории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарративный",
                                "target_lang_sense_clarification": "связанный с теорией или структурой повествования"
                            },
                            {
                                "target_lang_word": "повествовательный",
                                "target_lang_sense_clarification": "относящийся к манере изложения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abf29dfb-e2df-3be8-8134-0338aa8311e8",
                    "sense_definition": "Tending to talk a lot, especially about stories or past events.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man became quite <w>narrative</w> after a few drinks, sharing tales of his youth.",
                            "target_lang_translations": {
                                "ru": "Старик стал довольно <w>словоохотливым</w> после нескольких рюмок, делясь историями своей молодости."
                            }
                        },
                        {
                            "text": "He was wise through time and <w>narrative</w> with age, always ready with a story.",
                            "target_lang_translations": {
                                "ru": "Он был мудр годами и <w>разговорчив</w> в силу возраста, всегда готовый рассказать какую-нибудь историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "garrulous",
                        "talkative",
                        "loquacious"
                    ],
                    "antonyms": [
                        "taciturn",
                        "silent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of being talkative is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный много говорить, особенно рассказывая истории или вспоминая прошлые события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разговорчивый",
                                "target_lang_sense_clarification": "склонный к беседам"
                            },
                            {
                                "target_lang_word": "болтливый",
                                "target_lang_sense_clarification": "чрезмерно многословный"
                            },
                            {
                                "target_lang_word": "словоохотливый",
                                "target_lang_sense_clarification": "любящий поговорить и порассказывать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}