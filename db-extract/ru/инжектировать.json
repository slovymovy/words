                                "target_senses": [
                                    {
                                        "sense_id": "302ffa09-067d-3c61-be8c-0d1501318649",
                                        "entry_id": "71fb695a-686f-3156-8e14-383d03af74ef",
                                        "glosses": [
                                            "eine Flüssigkeit in den Körper einspritzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebc5825-9b01-4bc7-9710-8a76cff6f404",
                                                "sense_id": "302ffa09-067d-3c61-be8c-0d1501318649",
                                                "text": "Deshalb wurde das Medikament direkt ins Herz injiziert."
                                            },
                                            {
                                                "example_id": "7c333861-c00c-4325-b5cc-d98c26272132",
                                                "sense_id": "302ffa09-067d-3c61-be8c-0d1501318649",
                                                "text": "[Dem zum Tode verurteilten Waren Lee] Hill soll nun das Gift am kommenden Montagabend (Ortszeit, 23.07.2012) injiziert werden, wie die zuständige Gefängnisbehörde mitteilte."
                                            },
                                            {
                                                "example_id": "2e784bb6-c646-4fb6-a8fc-89ea34ce173f",
                                                "sense_id": "302ffa09-067d-3c61-be8c-0d1501318649",
                                                "text": "Dieser Stoff [BCG - Bacillus Calmette Guerin - ein Lebendimpfstoff aus Rinderzellen] aber wirkt nur [gegen Tuberkulose], wenn er Kleinkindern injiziert wird, nicht bei Erwachsenen."
                                            }
