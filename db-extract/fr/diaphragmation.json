                    {
                        "sense_id": "7933ee6b-1771-3c3b-9b01-bda48c951d16",
                        "entry_id": "5d83786e-4efe-3f9f-9f3a-52371f06ddd3",
                        "glosses": [
                            "Action de diaphragmer ou résultat de cette action."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "53d19ef5-baa8-4180-ba00-45dc50ebe3ec",
                                "sense_id": "7933ee6b-1771-3c3b-9b01-bda48c951d16",
                                "text": "Il s'agit de la diaphragmation dynamique : du myosis (petite ouverture pupillaire), à la mydriase (grande ouverture en cas d'assombrissement de l'environnement) et écran irien (arrêt des flux lumineux par l'absorption des pigments de l'iris)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c6f3fdf-5715-389e-a29b-cd179850eabd",
                        "entry_id": "5d83786e-4efe-3f9f-9f3a-52371f06ddd3",
                        "glosses": [
                            "Niveau d'ouverture (ou de fermeture) du diaphragme d'un objectif."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3b9ab0af-65d7-458c-8bc9-db1c5c87d0b7",
                                "sense_id": "0c6f3fdf-5715-389e-a29b-cd179850eabd",
                                "text": "Nous ne répéterons pas ce qui a été dit plus haut au sujet de l'éclairage et des inconvéniens d'une diaphragmation imparfaite ou d'une lumière non convenablement concentrée sur l'objet."
                            },
                            {
                                "example_id": "8aba3b72-5fa8-4d5e-8f4f-f2f0a420b90b",
                                "sense_id": "0c6f3fdf-5715-389e-a29b-cd179850eabd",
                                "text": "Notons enfin qu'il ne faut pas compter sur une diaphragmation excessive pour augmenter la netteté de l'image : la diffraction par les ouvertures très étroites gêne en effet le stigmatisme : en fait on ne descend guère, pour n'importe quel format, au dessous de l'ouverture F/45."
                            }
                        ]
                    }
                ],
