        "fr-extract.jsonl": [
            {
                "entry_id": "dee6e403-4556-372d-b409-1be7e9adce97",
                "word": "nettement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d705a0f1-047b-3179-b34d-3f821ed10f78",
                        "entry_id": "dee6e403-4556-372d-b409-1be7e9adce97",
                        "glosses": [
                            "D’une manière nette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6820d6ac-d271-44e6-b3b4-c28f923fae5d",
                                "sense_id": "d705a0f1-047b-3179-b34d-3f821ed10f78",
                                "text": "La lumière égale d’un grand quinquet éclairait assez nettement tous les objets."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5e1d14a-7850-3e7b-a1de-0c6d9cec4fd5",
                        "entry_id": "dee6e403-4556-372d-b409-1be7e9adce97",
                        "glosses": [
                            "Clairement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e845394b-660b-4fc8-a999-a343d6bc9917",
                                "sense_id": "e5e1d14a-7850-3e7b-a1de-0c6d9cec4fd5",
                                "text": "La consommation d’essence était depuis une huitaine d’heures nettement inférieure à nos estimations, pourtant très tirées."
                            },
                            {
                                "example_id": "789a81c4-7942-4432-a047-733247e80d49",
                                "sense_id": "e5e1d14a-7850-3e7b-a1de-0c6d9cec4fd5",
                                "text": "A titre d'exemple, la réaction simplifiée (3) résume la transformation de phosphate tricalcique insoluble en phosphate monocalcique nettement plus soluble sous l'effet d'un acide carboxylique."
                            },
                            {
                                "example_id": "93f0a9c0-1b8d-4414-90c5-be6d59b1bb44",
                                "sense_id": "e5e1d14a-7850-3e7b-a1de-0c6d9cec4fd5",
                                "text": "L'ancien ministre de l'Agriculture n'a jamais été perçu aussi nettement, aussi vigoureusement, aussi brillamment comme le plus populaire des « présidentiables » de la majorité."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0dc1785-9458-3a81-8328-ab58c1e19f6e",
                        "entry_id": "dee6e403-4556-372d-b409-1be7e9adce97",
                        "glosses": [
                            "Franchement ; sans rien déguiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9744a28b-040f-4ad8-82c7-e5ec676e4c5c",
                                "sense_id": "f0dc1785-9458-3a81-8328-ab58c1e19f6e",
                                "text": "Je lui ai dit nettement la vérité."
                            },
                            {
                                "example_id": "57ffa7ae-4b01-4f09-b83c-75c8bffb8845",
                                "sense_id": "f0dc1785-9458-3a81-8328-ab58c1e19f6e",
                                "text": "Parlez-lui nettement."
                            },
                            {
                                "example_id": "99b2d118-754d-4106-8ef6-9161fd5e89d9",
                                "sense_id": "f0dc1785-9458-3a81-8328-ab58c1e19f6e",
                                "text": "Pourquoi tant de détours ? Expliquez-vous nettement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa84bbdf-8423-4caa-b6ad-fddeb10918b7",
                        "source_entry_id": "dee6e403-4556-372d-b409-1be7e9adce97",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
