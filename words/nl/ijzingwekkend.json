{
    "word_family": [
        "ijzing",
        "ijzen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5c45502-d449-3a52-8fff-40598dcc599c",
                    "sense_definition": "Angstaanjagend of huiveringwekkend, zodanig dat men er koude rillingen van krijgt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angstaanjagend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het plotselinge, <w>ijzingwekkende</w> geschreeuw uit het donkere bos deed ons onmiddellijk stilstaan.",
                            "target_lang_translations": {
                                "en": "The sudden, <w>spine-chilling</w> scream from the dark forest made us stop in our tracks immediately."
                            }
                        },
                        {
                            "text": "De film had een <w>ijzingwekkende</w> sfeer die de kijkers de hele tijd op het puntje van hun stoel hield.",
                            "target_lang_translations": {
                                "en": "The movie had an <w>eerie</w> atmosphere that kept the viewers on the edge of their seats the entire time."
                            }
                        }
                    ],
                    "synonyms": [
                        "angstaanjagend",
                        "huiveringwekkend",
                        "bloedstollend",
                        "beangstigend",
                        "griezelig",
                        "vreesaanjagend"
                    ],
                    "antonyms": [
                        "geruststellend"
                    ],
                    "common_phrases": [
                        "ijzingwekkende sfeer",
                        "ijzingwekkend geschreeuw"
                    ],
                    "target_lang_definitions": {
                        "en": "Terrifying, spine-chilling, or hair-raising, such that it gives one cold shivers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spine-chilling",
                                "target_lang_sense_clarification": "causing terror or cold shivers"
                            },
                            {
                                "target_lang_word": "hair-raising",
                                "target_lang_sense_clarification": "extremely alarming or frightening"
                            },
                            {
                                "target_lang_word": "eerie",
                                "target_lang_sense_clarification": "inspiring fear in a mysterious or strange way"
                            },
                            {
                                "target_lang_word": "gruesome",
                                "target_lang_sense_clarification": "repellently frightful and shocking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93ea0ebb-3459-3272-a29c-0f8bc6e8b568",
                    "sense_definition": "Uiterst kalm en beheerst, zonder emotie te tonen in een spannende of gevaarlijke situatie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ongeemotioneerd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de crisis bleef de kapitein <w>ijzingwekkend</w> kalm en wist zo iedereen te redden.",
                            "target_lang_translations": {
                                "en": "During the crisis, the captain remained <w>chillingly</w> calm and thus managed to save everyone."
                            }
                        },
                        {
                            "text": "Zijn <w>ijzingwekkende</w> rust werkte in die chaotische situatie zowel bevreemdend als geruststellend.",
                            "target_lang_translations": {
                                "en": "His <w>unnerving</w> calmness in that chaotic situation was both strange and reassuring."
                            }
                        }
                    ],
                    "synonyms": [
                        "ijzig"
                    ],
                    "antonyms": [
                        "paniekerig"
                    ],
                    "common_phrases": [
                        "ijzingwekkend kalm"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely calm and controlled, showing no emotion in a tense or dangerous situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chillingly",
                                "target_lang_sense_clarification": "in an unnervingly cold or calm manner"
                            },
                            {
                                "target_lang_word": "unnervingly",
                                "target_lang_sense_clarification": "so calm as to cause unease"
                            },
                            {
                                "target_lang_word": "icy",
                                "target_lang_sense_clarification": "extremely cold and unemotional"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}