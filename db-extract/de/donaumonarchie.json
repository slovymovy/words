                "senses": [
                    {
                        "sense_id": "3bfc0a92-a5c0-33e7-a217-604d24021199",
                        "entry_id": "fa359f83-6b5b-32c4-be34-33b3eb6dfbcf",
                        "glosses": [
                            "Austria-Hungary (a former multi-ethnic empire and country in Central Europe existing from 1867 to 1918)"
                        ],
                        "tags": [
                            "feminine",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b255a9-76f3-4e7a-9141-673f1f05e72a",
                                "sense_id": "3bfc0a92-a5c0-33e7-a217-604d24021199",
                                "text": "Die deutsche Regierung hat alsbald nach der Bekanntgabe des österreichisch-ungarischen Ultimatums an Serbien — bei aller Betonung ihrer Bundestreue gegenüber der Donaumonarchie und ihres Wunsches, den Konflikt zu lokalisieren — Wert darauf gelegt, gegenüber der eigenen Öffentlichkeit und gegenüber den Regierungen der Großmächte festzustellen, daß sie an der Abfassung des Ultimatums nicht beteiligt gewesen sei und von seinen Einzelheiten vorher keine Kenntnis gehabt habe."
                            }
                        ]
                    }
                ],
