                "translations": [
                    {
                        "translation_id": "43ac432a-f503-488a-8d6c-cc1cbc308eed",
                        "source_entry_id": "8e20b97d-7d56-34f2-8473-1a6902fce744",
                        "source_sense_description": "болезненно раздражительный; излишне склонный нервничать",
                        "target_lang_word": "nervous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16846551-be81-3a17-bbbc-ae4fed807fa5",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of sinews and tendons.",
                                            "Full of sinews."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd7e9b36-4157-3174-b83f-a5c53e3723bd",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of sinews and tendons.",
                                            "Having strong or prominent sinews; sinewy, muscular."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ae7c40-4b82-42e9-a787-6fda13f33ad5",
                                                "sense_id": "fd7e9b36-4157-3174-b83f-a5c53e3723bd",
                                                "text": "[T]here is nothing in marble equal to the Venus of Medici, for ſoftneſs and tenderneſs; as there is nothing ſo ſtrong and nervous, as the Hercules Farneſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b9bd47-45f7-36d6-83c3-bcdcbd4ca0ac",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of sinews and tendons.",
                                            "Of a piece of writing, literary style etc.: forceful, powerful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4d4734-c3b2-400d-9b69-387fe0189c73",
                                                "sense_id": "53b9bd47-45f7-36d6-83c3-bcdcbd4ca0ac",
                                                "text": "Fortescutus illustratus, or a commentary on that nervous treatise De Laudibus Legum Angliæ […] [book title]"
                                            },
                                            {
                                                "example_id": "24e1efcd-dae3-4fae-a192-3798e949daf2",
                                                "sense_id": "53b9bd47-45f7-36d6-83c3-bcdcbd4ca0ac",
                                                "text": "Nervous, clear, and striking, was almost all that he uttered […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c7d31f-bb84-3051-9477-b6bae0932e26",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of nerves.",
                                            "Supplied with nerves; innervated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6db1d31f-7009-3ef0-96a3-fad7eb400da3",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of nerves.",
                                            "Affecting or involving the nerves or nervous system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ed0bd0-379b-4731-9211-82984dee9d98",
                                                "sense_id": "6db1d31f-7009-3ef0-96a3-fad7eb400da3",
                                                "text": "All Nervous Diſtempers whatſoever, from Yawning and Stretching, up to a mortal Fit of an Apoplexy, ſeems to me to be but one continued Diſorder, or the ſeveral Steps or Degrees of it, ariſing from a Relaxation or Weakneſs, and the want of a ſufficient Force and Elaſticity in the Solids in general, and the Nerves in particular, in Proportion to the Reſiſtance of the Fluids, in order to carry on the Circulation, remove Obſtructions, carry off the Recrements, and make the Secretions."
                                            },
                                            {
                                                "example_id": "7eac5abb-be7b-42f9-abf5-b0862ccc7d0f",
                                                "sense_id": "6db1d31f-7009-3ef0-96a3-fad7eb400da3",
                                                "text": "Elizabeth Moſs, a girl of about 15 years of age, was attacked, in December, 1773, with a ſlow nervous fever, during the courſe of which ſhe had very little ſleep; […]"
                                            },
                                            {
                                                "example_id": "7de51c63-14a4-4d21-9c71-8cc81b76cb91",
                                                "sense_id": "6db1d31f-7009-3ef0-96a3-fad7eb400da3",
                                                "text": "However, concern regarding potential morbidity from biopsy of a central nervous system lesion makes it rare to have a pathologic specimen available for clinical diagnosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6581a5d4-27a9-35bf-b9da-8b43d755135c",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of nerves.",
                                            "Nervose."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043de477-b9ae-4156-98c6-edf3661f7ab0",
                                                "sense_id": "6581a5d4-27a9-35bf-b9da-8b43d755135c",
                                                "text": "CANNACORUS, […] It hath a knobbed tuberoſe Root: The Leaves are long and nervous: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "893785d9-f1e6-3965-bee4-8b85936341f9",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of nerves.",
                                            "Easily agitated or alarmed; edgy, on edge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c74627-1c3e-418a-9729-f54ca68bac93",
                                                "sense_id": "893785d9-f1e6-3965-bee4-8b85936341f9",
                                                "text": "Being in a crowd of strangers makes me nervous."
                                            },
                                            {
                                                "example_id": "2779f786-e8ed-4bd6-bf62-6fe1d14651bb",
                                                "sense_id": "893785d9-f1e6-3965-bee4-8b85936341f9",
                                                "text": "I can only assure you here that there is such a thing as a nervous child; whose nervous system is unstable; who is easily upset; whose pulse is apt to \"run away\" at any excitement; who blushes and pales and sweats easily; who tires easily; and who may be subject to headache and eye strain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a23da8b-6e7d-3cda-adc3-ab4483713087",
                                        "entry_id": "7c4d7b7d-47e6-3dc1-b2ca-c9132a4a0da0",
                                        "glosses": [
                                            "Of nerves.",
                                            "Apprehensive, anxious, hesitant, worried."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25512ab3-3535-4a28-8eaa-c61789fa2fc1",
                                                "sense_id": "8a23da8b-6e7d-3cda-adc3-ab4483713087",
                                                "text": "They were looking at the table (which was spread out in great array); for these young housekeepers are always nervous on such points, and like to see that everything is right."
                                            },
                                            {
                                                "example_id": "ed7ae682-04d2-4e2c-8d39-001fc9f2cff3",
                                                "sense_id": "8a23da8b-6e7d-3cda-adc3-ab4483713087",
                                                "text": "Various harbours fit to receive settlers are now enumerated by the author; and as for the cold, of which some, through report, entertained a nervous dread, he invites his readers to reflect on \"the great colde that is at times in Muſcouia, Sweidon, Norway, Spruceland, Poland, Denmarke, and other Eaſterne and Northerne parts of the world, where the people liue well and grow rich;\" […]"
                                            },
                                            {
                                                "example_id": "5410b1ea-940e-4dcc-af66-6008744fb387",
                                                "sense_id": "8a23da8b-6e7d-3cda-adc3-ab4483713087",
                                                "text": "\"My baby is a perfect bundle of nerves,\" said one mother to another. \"She is so sensitive, she starts at the slightest sound. She sleeps only a few minutes at a time, and has to be walked or rocked to get her off again. She won't go to strangers, and I am a nervous wreck taking care of her.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
