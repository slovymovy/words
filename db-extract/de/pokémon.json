                "senses": [
                    {
                        "sense_id": "f569d92c-e0f3-386d-b936-bc4ddf263c8b",
                        "entry_id": "49782a72-ee44-3435-a3d9-ffa75161218d",
                        "glosses": [
                            "von Satoshi Tajiri und Game Freak entwickelte Fantasiewesen, die namensgebend für mehrere Videospiele, mehrere Fernsehserien, mehrere Kinofilme, ein Sammelkartenspiel und andere Produkte sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe87c222-03a6-4398-8bdc-aa2d1d8c5ed7",
                                "sense_id": "f569d92c-e0f3-386d-b936-bc4ddf263c8b",
                                "text": "Wilde Pokémon trifft man im hohen Gras, in Höhlen, auf See oder auf dem Meeresgrund."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "917e8fba-8c7e-4b8e-a529-b45dcdf3f58d",
                        "source_entry_id": "49782a72-ee44-3435-a3d9-ffa75161218d",
                        "source_sense_id": "f569d92c-e0f3-386d-b936-bc4ddf263c8b",
                        "target_lang_word": "口袋妖怪",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "07af8608-ff11-4c1d-90b6-b2005ce04327",
                        "source_entry_id": "49782a72-ee44-3435-a3d9-ffa75161218d",
                        "source_sense_id": "f569d92c-e0f3-386d-b936-bc4ddf263c8b",
                        "target_lang_word": "Pokémon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pokémon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad14d0b-5d28-377d-937d-cab81a48c176",
                                        "entry_id": "94a8cd27-91ef-340d-8551-3025405f0bca",
                                        "glosses": [
                                            "A Japanese media franchise featuring fictional creatures that are captured by humans and trained to battle each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8063741e-5db4-4b7b-b304-a8d8c8968583",
                                                "sense_id": "cad14d0b-5d28-377d-937d-cab81a48c176",
                                                "text": "The organization has also named three newly discovered, rare beetles after characters from Pokémon – the Japanese anime series that spawned an entire franchise of video games, toys and trading cards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pokémon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                        "entry_id": "5e3543ec-8496-3360-ab5c-8373d28b42c2",
                                        "glosses": [
                                            "A pocket monster; a fictional creature from the universe of the Pokémon franchise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d601a5a-a0eb-4df6-9e09-e0174fd25a24",
                                                "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                                "text": "Pokémons are the latest and adamantly conformist craze among middle-childhood boys. The theme of the video games that started the craze is, as usual, the triumph of good over evil. The hero is a child, twelve-year-old Ash. His goal is to capture all 150-plus nonhuman creatures called Pokémons, train them to be good, and use them to capture the remaining wicked Pokémons that so far have escaped. In the games, Ash is not your ally: he is you. Each of the Pokémons has its own sort of power which, after conversion, accrues to Ash’s (your) favor."
                                            },
                                            {
                                                "example_id": "4abe2125-5e92-4508-9dfb-8d06c660a9eb",
                                                "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                                "text": "Game strategy (and tactics) are full of such learning about real life, like the rules, the strategy in games needs to be lifelike for the games to make sense, even if the characters, such as Pokémons, are purely imaginary."
                                            },
                                            {
                                                "example_id": "5be70e6c-9d76-466f-af55-614bf6bfe01b",
                                                "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                                "text": "He had been delighted when his mother said, Just leave everything as it is. Not even his bed was made. He could see that little kid’s mess, his clothes, his Pokémons, his old Winnie Dubdoub, his Spiderman^([sic]) poster; and the truck, alone in the empty house for days now, nearly two weeks."
                                            },
                                            {
                                                "example_id": "143d1067-dfaf-4d62-8fff-a4328a5423ee",
                                                "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                                "text": "Professor Oak, the world's leading Pokémon expert, is at once a genius and a bumbling, absent-minded professor"
                                            },
                                            {
                                                "example_id": "8390bcaa-7061-456e-a7bc-01baaee6bc3a",
                                                "sense_id": "6cffa0fd-141e-33a3-b619-32936a11f35b",
                                                "text": "The beetles are named Binburrum articuno, Binburrum moltres and Binburrum zapdos after three rare Pokémon: Articuno, Moltres and Zapdos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d6a9e7-879e-419b-bb25-f1f9043fc07f",
                        "source_entry_id": "49782a72-ee44-3435-a3d9-ffa75161218d",
                        "source_sense_id": "f569d92c-e0f3-386d-b936-bc4ddf263c8b",
                        "target_lang_word": "Pokémon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pokémon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e76de87a-08b2-36c1-9aeb-b2eba605c618",
                                        "entry_id": "1a67eaff-b100-39d1-af6a-44b09f08de25",
                                        "glosses": [
                                            "Créature imaginaire du jeu vidéo Pokémon (ainsi que du dessin animé dérivé) de formes très diverses, qui peut être attrapé et qui est utilisé pour des combats avec d’autres créatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001404b0-e296-483e-b7f8-191ce29f1a88",
                                                "sense_id": "e76de87a-08b2-36c1-9aeb-b2eba605c618",
                                                "text": "Le game designer avoue avoir passé des heures « et même des journées » à jouer aux Pokémon sur sa Game Boy lorsqu'il était enfant. Il ne ratait jamais un épisode télévisé, ni aucune rediffusion, avoue-t-il."
                                            },
                                            {
                                                "example_id": "2bff7e08-ac1a-4a95-b776-4e83785fea82",
                                                "sense_id": "e76de87a-08b2-36c1-9aeb-b2eba605c618",
                                                "text": "Les noms c’est comme des cartes Pokémon, ça vient avec des points. Des points en plus ou bien des points en moins. Dans la guerre des noms, la famille de mon père l’emporte sur la famille de ma mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
