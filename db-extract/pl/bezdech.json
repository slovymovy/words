                                        "sense_id": "3e0a582f-948e-33dc-92bc-dfb88429cec0",
                                        "entry_id": "62a81d8b-8d5c-39af-b979-2bc100fda37f",
                                        "glosses": [
                                            "een onderbreking van de ademhaling van langer dan 10 seconden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e45fa0-2b38-4d31-b979-1679610a0b00",
                                                "sense_id": "3e0a582f-948e-33dc-92bc-dfb88429cec0",
                                                "text": "Bleef over de alcoholische slaap der bewustelozen, wreed onderbroken door de ene ademstilstand na de andere."
                                            },
                                            {
                                                "example_id": "7c87bd67-ca0d-4d57-b2e2-5575e961be7b",
                                                "sense_id": "3e0a582f-948e-33dc-92bc-dfb88429cec0",
                                                "text": "Alleen S. kan de natriumazide hebben toegediend. Alle andere scenario's zijn absoluut niet aannemelijk. Mevrouw verleed door hart- of ademstilstand als gevolg van een ernstig zuurstofgebrek. Die kwam door de azide in het lichaam."
                                            }
                                        ]
