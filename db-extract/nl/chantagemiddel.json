                        "glosses": [
                            "iets waarmee je iemand in verlegenheid kan brengen en daardoor kunt chanteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e51beb-a3b1-465f-8aac-d384145d9eda",
                                "sense_id": "9b27d785-0aa5-3619-b100-c2acd29bc69b",
                                "text": "Honderdduizenden bezoekers komen naar het zuiden voor de Franse festivals. Daarom zijn de festivalgangers het sterkste chantagemiddel van de stakers."
                            },
                            {
                                "example_id": "f0fd78c5-a6d9-413a-a987-2dc57a001e1b",
                                "sense_id": "9b27d785-0aa5-3619-b100-c2acd29bc69b",
                                "text": "De beelden worden vaak gebruikt als chantagemiddel of als kinderporno verspreid op internet. De politie benadrukt dan ook dat het altijd belangrijk is om melding te maken of aangifte te doen van een strafbaar feit op internet."
                            },
                            {
                                "example_id": "ce1a27c6-de8d-46c0-b60b-e188523368e0",
                                "sense_id": "9b27d785-0aa5-3619-b100-c2acd29bc69b",
                                "text": "Nadat hij het vertrouwen had gewonnen van zijn slachtoffers, vroeg hij hun zich uit te kleden voor de webcam. De beelden nam hij stiekem op en gebruikte hij als chantagemiddel."
                            }
                        ]
                    }
