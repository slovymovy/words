                "senses": [
                    {
                        "sense_id": "2dbfe2b8-9d49-3809-baf8-3dc1e24f5459",
                        "entry_id": "58568f97-52f7-3ba0-8670-5b59fcfff55f",
                        "glosses": [
                            "Faire monter les salaires qui étaient trop souvent au niveau du SMIC."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "65dafda1-8b52-4209-bf52-c1b48a0c38ba",
                                "sense_id": "2dbfe2b8-9d49-3809-baf8-3dc1e24f5459",
                                "text": "L’exigence des syndicats est simple: obtenir un salaires de 10 000 francs pour 200 heures par mois pour les chauffeurs «grand routiers», afin de «désmicardiser la profession», car la grille salariale démarre largement en dessous du salaire minimum."
                            },
                            {
                                "example_id": "ea60e853-58f2-423e-a112-2586b0790eb6",
                                "sense_id": "2dbfe2b8-9d49-3809-baf8-3dc1e24f5459",
                                "text": "« J’assume de le dire, il faut désmicardiser la France », a déclaré Gabriel Attal."
                            }
                        ]
                    }
                ],
