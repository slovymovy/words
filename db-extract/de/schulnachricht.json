                "senses": [
                    {
                        "sense_id": "c9f2611c-d596-3f52-9ebb-21b53127ca69",
                        "entry_id": "f7c2cd3f-fe3f-3a64-9ba7-08864322600c",
                        "glosses": [
                            "in Österreich eine Mitteilung des schulischen Leistungsstandes zum Halbjahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ccdda6-fdfe-442f-bcfa-78fd798f156c",
                                "sense_id": "c9f2611c-d596-3f52-9ebb-21b53127ca69",
                                "text": "„In die Schulnachricht über das erste Semester der ersten Stufe der Volksschule und der Sonderschule mit Klassenlehrersystem ist für alle Unterrichtsgegenstände, ausgenommen Religion, eine Gesamtnote einzutragen.“"
                            },
                            {
                                "example_id": "04035903-60df-4762-8843-6f6d78a6bce6",
                                "sense_id": "c9f2611c-d596-3f52-9ebb-21b53127ca69",
                                "text": "„Groß ist die Furcht der Jugendlichen vor der so genannten Schulnachricht - sie wird fälschlich immer wieder als ‚Semesterzeugnis‘ bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
