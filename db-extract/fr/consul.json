                "senses": [
                    {
                        "sense_id": "71e100a3-07ee-31f6-8211-461abeed87e1",
                        "entry_id": "755b2795-d4d3-3c3d-ade8-26cc6acd162e",
                        "glosses": [
                            "Magistrat qui avait la principale autorité dans la république romaine."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5c85536c-d191-31e1-ac82-0385d05dbd61",
                        "entry_id": "755b2795-d4d3-3c3d-ade8-26cc6acd162e",
                        "glosses": [
                            "Juge prudhomme des marchands et des négociants, chargé de régler les affaires urgentes en matière de commerce, à Paris et dans quelques autres villes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583d0cf1-9157-4520-a3e8-71e961314e60",
                                "sense_id": "5c85536c-d191-31e1-ac82-0385d05dbd61",
                                "text": "Pendant cinq siècles, sous la direction de ses capitouls et de ses consuls, Montauban fut une courageuse petite démocratie autonome."
                            }
                        ]
                    },
                    {
                        "sense_id": "afb8973c-ad4f-330d-9661-dc40f58a9deb",
                        "entry_id": "755b2795-d4d3-3c3d-ade8-26cc6acd162e",
                        "glosses": [
                            "Magistrat suprême auquel la constitution de l’an VIII avait confié le gouvernement de la République."
                        ],
                        "tags": [
                            "Histoire de France"
                        ],
                        "examples": [
                            {
                                "example_id": "f06531b8-b257-4ac2-9088-39d7305ebc3d",
                                "sense_id": "afb8973c-ad4f-330d-9661-dc40f58a9deb",
                                "text": "Il y avait selon la constitution trois consuls, et Napoléon Bonaparte était le Premier consul, celui des trois qui détenait le plus de pouvoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa927a4-608b-3ac9-a17c-269d0ec45f7b",
                        "entry_id": "755b2795-d4d3-3c3d-ade8-26cc6acd162e",
                        "glosses": [
                            "Agent chargé par un gouvernement de protéger les intérêts privés et commerciaux des nationaux résidant à l’étranger, d’exercer à leur égard diverses attributions de l’État et, dans certains pays, une juridiction, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69feb75b-2a56-49c0-801d-919a263b39b7",
                                "sense_id": "6aa927a4-608b-3ac9-a17c-269d0ec45f7b",
                                "text": "Grâce au concours que me prêtera notre consul à Tiflis, je ne tarderai pas à être en règle avec l’administration moscovite."
                            }
                        ]
                    }
                ],
