{
    "word_family": [
        "bejewel",
        "jeweler",
        "jewellery",
        "jewelry",
        "jewel-box",
        "jewel-case"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a014f32a-a9da-3917-a89a-b6bd4ecb597d",
                    "sense_definition": "A precious or semi-precious stone; a gem or gemstone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gemstone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crown was decorated with a large red <w>jewel</w> in the center.",
                            "target_lang_translations": {
                                "ru": "Корона была украшена крупным красным <w>драгоценным камнем</w> в центре."
                            }
                        },
                        {
                            "text": "She found a rare <w>jewel</w> while exploring the old cave.",
                            "target_lang_translations": {
                                "ru": "Она нашла редкий <w>самоцвет</w>, исследуя старую пещеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "gem",
                        "gemstone",
                        "precious stone"
                    ],
                    "common_phrases": [
                        "rare jewel",
                        "precious jewel",
                        "sparkling jewel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драгоценный или полудрагоценный камень; самоцвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоце́нный ка́мень",
                                "target_lang_sense_clarification": "минерал, используемый в украшениях"
                            },
                            {
                                "target_lang_word": "самоцве́т",
                                "target_lang_sense_clarification": "окрашенный природный камень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "384f2032-1126-30de-a3eb-a4b526e4dcdb",
                    "sense_definition": "An item of personal ornamentation made of precious metals and stones; a piece of jewelry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ornament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a collection of ancient <w>jewels</w> from Egypt.",
                            "target_lang_translations": {
                                "ru": "В музее была представлена коллекция древних <w>драгоценностей</w> из Египта."
                            }
                        },
                        {
                            "text": "He kept his most expensive <w>jewel</w> in a locked safe at home.",
                            "target_lang_translations": {
                                "ru": "Самое дорогое <w>украшение</w> он хранил дома в запертом сейфе."
                            }
                        }
                    ],
                    "synonyms": [
                        "jewelry",
                        "ornament",
                        "trinket"
                    ],
                    "common_phrases": [
                        "family jewels",
                        "crown jewels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет личного украшения, изготовленный из драгоценных металлов и камней; ювелирное изделие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоце́нность",
                                "target_lang_sense_clarification": "ювелирное изделие"
                            },
                            {
                                "target_lang_word": "украше́ние",
                                "target_lang_sense_clarification": "предмет для украшения себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9d11b1d-dfb0-398c-a65b-dfe499f3087c",
                    "sense_definition": "A person or thing that is highly valued, prized, or admired.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "valuable_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This small island is the <w>jewel</w> in the crown of the country's tourism industry.",
                            "target_lang_translations": {
                                "ru": "Этот маленький остров — <w>жемчужина</w> в короне туристической индустрии страны."
                            }
                        },
                        {
                            "text": "She is a real <w>jewel</w> for helping us with the project so late at night.",
                            "target_lang_translations": {
                                "ru": "Она просто <w>сокровище</w>, раз помогла нам с проектом так поздно ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "treasure",
                        "prize",
                        "gem"
                    ],
                    "common_phrases": [
                        "jewel in the crown",
                        "absolute jewel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые высоко ценятся или вызывают восхищение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокро́вище",
                                "target_lang_sense_clarification": "о ком-то или чем-то очень ценном"
                            },
                            {
                                "target_lang_word": "жемчу́жина",
                                "target_lang_sense_clarification": "лучшая часть чего-либо"
                            },
                            {
                                "target_lang_word": "драгоце́нность",
                                "target_lang_sense_clarification": "о дорогом и памятном предмете или человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef421b70-9795-3802-ab64-4860d01fc92e",
                    "sense_definition": "A hard gemstone used as a bearing for a pivot in a mechanical watch to reduce friction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "horology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high-quality mechanical watch contains twenty-one <w>jewels</w> for better precision.",
                            "target_lang_translations": {
                                "ru": "Высококачественные механические часы содержат двадцать один <w>камень</w> для большей точности."
                            }
                        },
                        {
                            "text": "A watch <w>jewel</w> is typically made of synthetic ruby or sapphire.",
                            "target_lang_translations": {
                                "ru": "Часовой <w>камень</w> обычно изготавливается из синтетического рубина или сапфира."
                            }
                        }
                    ],
                    "synonyms": [
                        "bearing"
                    ],
                    "common_phrases": [
                        "watch jewel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in horology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый драгоценный камень, используемый в качестве опоры для оси в механических часах для уменьшения трения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ка́мень",
                                "target_lang_sense_clarification": "деталь часового механизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4801fae-2209-33e1-83a3-77d1583cd385",
                    "sense_definition": "A slang term referring to the clitoris.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author used the word <w>jewel</w> as a metaphor in the erotic novel.",
                            "target_lang_translations": {
                                "ru": "Автор использовал слово <w>жемчужинка</w> в качестве метафоры в эротическом романе."
                            }
                        },
                        {
                            "text": "She felt a sharp sensation near her <w>jewel</w> during the massage.",
                            "target_lang_translations": {
                                "ru": "Во время массажа она почувствовала резкое ощущение в области своего <w>бутона</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clitoris"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sexual slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговый термин, относящийся к клитору."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жемчу́жинка",
                                "target_lang_sense_clarification": "метафорическое обозначение в эротическом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84b19894-2048-34c9-99fd-f6607d73e777",
                    "sense_definition": "Any of various lycaenid butterflies belonging to the genus Hypochrysops.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butterfly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collector was thrilled to find a rare <w>jewel</w> butterfly in the rainforest.",
                            "target_lang_translations": {
                                "ru": "Коллекционер был в восторге, найдя в тропическом лесу редкую бабочку из рода <w>гипохризопс</w>."
                            }
                        },
                        {
                            "text": "Many species of the <w>jewel</w> genus are found in Australia.",
                            "target_lang_translations": {
                                "ru": "Многие виды рода <w>Hypochrysops</w> встречаются в Австралии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biological common name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из различных бабочек-голубянок, принадлежащих к роду Hypochrysops."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипохризопс",
                                "target_lang_sense_clarification": "биологическое название рода бабочек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98fcfe1f-fe9c-3eee-b0c9-0d707ee71a53",
                    "sense_definition": "To decorate or adorn an object with gems or jewels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan decided to <w>jewel</w> the handle of the sword with emeralds.",
                            "target_lang_translations": {
                                "ru": "Мастер решил <w>украсить</w> рукоять меча изумрудами."
                            }
                        },
                        {
                            "text": "The morning dew seemed to <w>jewel</w> the spider's web in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Казалось, утренняя роса <w>усыпала</w> паутину драгоценными каплями в лучах солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "bejewel",
                        "adorn",
                        "bedeck"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used as a participle: jeweled"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или отделывать объект драгоценными камнями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украша́ть самоцве́тами",
                                "target_lang_sense_clarification": "инкрустировать камнями"
                            },
                            {
                                "target_lang_word": "усыпа́ть",
                                "target_lang_sense_clarification": "покрывать поверхность (например, росой)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a7a6e1fe-0312-3866-8126-91f9a552aa23",
                    "sense_definition": "A female given name derived from the noun <w>jewel</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The singer <w>Jewel</w> became very famous in the late nineties.",
                            "target_lang_translations": {
                                "ru": "Певица <w>Джуэл</w> стала очень знаменитой в конце девяностых."
                            }
                        },
                        {
                            "text": "My grandmother's name was <w>Jewel</w>, which was popular in her time.",
                            "target_lang_translations": {
                                "ru": "Мою бабушку звали <w>Джуэл</w>, это имя было популярно в её время."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, происходящее от существительного «драгоценный камень»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джу́эл",
                                "target_lang_sense_clarification": "женское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e14c7b-0e20-3e9f-9e0e-0cf9fc80f383",
                    "sense_definition": "A male given name, often a variant of Jewell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "given_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "In some old records, <w>Jewel</w> appears as a masculine first name.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых записях <w>Джуэл</w> встречается как мужское имя."
                            }
                        },
                        {
                            "text": "He was named <w>Jewel</w> after his father's favorite uncle.",
                            "target_lang_translations": {
                                "ru": "Его назвали <w>Джуэл</w> в честь любимого дяди его отца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, часто вариант имени Jewell."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джу́эл",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}