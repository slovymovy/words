                                            {
                                                "example_id": "8c25ff60-46d0-4b02-b999-391207029375",
                                                "sense_id": "081c3d47-1fbf-38a3-9b81-709387b15332",
                                                "text": "Genau genommen gibt es keine Erdkugel, da die Erde nicht genau kugelförmig ist."
                                            },
                                            {
                                                "example_id": "031b6442-df8b-475d-8349-e75571848e87",
                                                "sense_id": "081c3d47-1fbf-38a3-9b81-709387b15332",
                                                "text": "„Um die Erdkugel legte sich das erste globale Netz, ein Netz aus den Handelsrouten der christlichen Seefahrt.“"
                                            },
                                            {
                                                "example_id": "e584cf1a-bff6-485f-9f5a-8dffe07104ac",
                                                "sense_id": "081c3d47-1fbf-38a3-9b81-709387b15332",
                                                "text": "„Es war ein milder und duftender Morgen, der Fluss so breit, dass ich den Eindruck hatte, ich könne die Krümmung der Erdkugel wahrnehmen.“"
                                            },
                                            {
                                                "example_id": "eb9647dd-650e-49b6-8274-abe4cab21769",
                                                "sense_id": "081c3d47-1fbf-38a3-9b81-709387b15332",
                                                "text": "„Die Erdkugel, ein Drittel ist verschattet, schwebt nun klar über dem Mondhorizont.“"
                                            },
                                            {
                                                "example_id": "dd6c053f-4e38-46a9-8665-0ab3f62f9ba7",
                                                "sense_id": "081c3d47-1fbf-38a3-9b81-709387b15332",
                                                "text": "„Zur gleichen Zeit, da Thomas Lieven in seiner Zelle im »Aljube« zu Lissabon, ein Gefühl arktischer Kälte in der Magengrube, ihren Abschiedsbrief las, saß die schwarzhaarige, hinreißend gebaute Konsulin auf der anderen Seite der Erdkugel im Salon des teuersten Appartements im teuersten Hotel von San José, der Hauptstadt der Republik Costa Rica.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a60181d-ce8b-46e9-9fdb-0767bf56696c",
                        "source_entry_id": "1b51cfbb-e494-3fa9-b75d-9294b157f04e",
                        "source_sense_id": "7657c089-d10e-3074-9ab1-f5b86e54b42d",
                        "source_sense_description": "Erdball, Erdkugel, Globus",
                        "target_lang_word": "Globus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Globus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                        "entry_id": "3eb861c9-0e88-37bb-93b5-16efb0ad3fe2",
                                        "glosses": [
                                            "Kugel mit dem Abbild eines Himmelskörpers, zum Beispiel der Erde oder der scheinbaren Himmelskugel auf ihrer Oberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6be9a6e7-4cce-4208-bf62-19744e2959f9",
                                                "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                                "text": "Für Geografen ist ein Globus ein hilfreiches Arbeitsmittel."
                                            },
                                            {
                                                "example_id": "fa6bfd2f-0948-4924-97cf-6d41dc5eeb02",
                                                "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                                "text": "„Ihr werdet auf den Grund des Ozeans tauchen und zum Mond reisen, in fünf Stunden werdet ihr von Hamburg nach Amerika fliegen, in euren Stuben werdet ihr sitzen und sehen, was auf der anderen Seite des Globus geschieht.“"
                                            },
                                            {
                                                "example_id": "3e583d8b-4852-42ad-b647-d475d68f7e76",
                                                "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                                "text": "„Climata sind Gleich-Striche, und gewisse Flächen oder Räume des Globi, welche die Gelehrten sich auf der Erden also concipiren: Auf dem Globo oder Charte werden sie von Westen gegen Osten gezogen, und gleichweitige Neben-Creyse des Aequatoris genennet.“"
                                            },
                                            {
                                                "example_id": "e497a361-8768-4b12-a71e-5582bbd2c9de",
                                                "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                                "text": "„Dieser Globus war eine lebendige, hin- und herwogende Kugel ohne klar erkennbare Grenzen.“"
                                            },
                                            {
                                                "example_id": "331ae0a5-b0be-4bb1-b9b1-5c701d2c4920",
                                                "sense_id": "50b083cc-27a2-3c99-90da-d1a7cddbdae3",
                                                "text": "„Dann ging er zu dem Globus hinüber, der in der Ecke stand, und drehte ihn herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                        "entry_id": "3eb861c9-0e88-37bb-93b5-16efb0ad3fe2",
                                        "glosses": [
                                            "der Planet Erde"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283eb981-b6b8-45fd-976c-0fab4a0652aa",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "„Die US-Medien zitieren ausführlich die negativen Reaktionen von Kommentatoren rund um den Globus, die vom Symbol für den Abstieg sprechen.“"
                                            },
                                            {
                                                "example_id": "dd61ddca-d15b-46cb-abd9-18b06a5a1cd6",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "2010c9a7-98b5-4e50-b375-a64ae9da5629",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "Die Nachricht wurde in sekundenschnelle um den Globus geschickt."
                                            },
                                            {
                                                "example_id": "78552e8d-6f31-4acc-9a88-0e71ef8527db",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "„So ist es schon seit Jahrhunderten – seit die Kontrolle des afrikanischen Südzipfels zu einem strategisch wichtigen Vorteil im Ringen um die Seeherrschaft auf dem Globus wurde.“"
                                            },
                                            {
                                                "example_id": "a8cd386c-47b4-4ef3-a729-7d68045a1a96",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "„Er umrundet zehn Mal den Globus und landet immer wieder als derselbe Ignorant, als der er vor Urzeiten an Bord gegangen war.“"
                                            },
                                            {
                                                "example_id": "2f1f19ee-bd71-4162-a77d-c8a5d7866cf9",
                                                "sense_id": "7608b4d0-cfbb-3224-bac7-4b56cce4e4a5",
                                                "text": "„Ständig registrierten Erdbebenstationen um den Globus herum auch leichte Erdbeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
