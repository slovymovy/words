                                    {
                                        "sense_id": "8511ae83-49a3-3cd1-9684-5c651500050d",
                                        "entry_id": "2a1c43ca-e9f0-3b33-bf67-7632bbf44e87",
                                        "glosses": [
                                            "eine kleine Menge eines Geschmacksträgers (zum Beispiel Essen) zum Probieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0eb1ee2-fb75-4e80-9eed-a9a510594488",
                                                "sense_id": "8511ae83-49a3-3cd1-9684-5c651500050d",
                                                "text": "Nehmen Sie bitte eine Kostprobe unserer neuen Marmelade."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30d51520-dd9a-3e1f-92f2-6db2e28806a3",
                                        "entry_id": "2a1c43ca-e9f0-3b33-bf67-7632bbf44e87",
                                        "glosses": [
                                            "das Ausprobieren von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109ade11-2728-4d72-a5e9-715a504455d3",
                                                "sense_id": "30d51520-dd9a-3e1f-92f2-6db2e28806a3",
                                                "text": "Nach der Kostprobe kaufte er die getestete Marmelade."
                                            },
                                            {
                                                "example_id": "621e29b0-e3f6-4284-ba41-c465c5301b7f",
                                                "sense_id": "30d51520-dd9a-3e1f-92f2-6db2e28806a3",
                                                "text": "„Mit Hilfe der Käsepartikel, die an der Nadel haften bleiben, kann man den Geruch testen und eine Kostprobe durchführen.“"
                                            },
                                            {
                                                "example_id": "99e9b693-d0a9-4c3d-9b7d-4132decae94a",
                                                "sense_id": "30d51520-dd9a-3e1f-92f2-6db2e28806a3",
                                                "text": "„Vereinbaren Sie einen Besuchstermin für eine Kostprobe in einer der … Kellereien…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f2fb2ed1-abe0-39b2-aca2-436abe9845d6",
                                        "entry_id": "2a1c43ca-e9f0-3b33-bf67-7632bbf44e87",
                                        "glosses": [
                                            "eine kurze Vorführung; ein Beispiel für die Eigenschaften von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4f3f07b-5769-4ef3-8c8f-d6be2202e490",
                                                "sense_id": "f2fb2ed1-abe0-39b2-aca2-436abe9845d6",
                                                "text": "Willst du eine Kostprobe meiner Stärke sehen?"
                                            },
                                            {
                                                "example_id": "76a10ec3-40f4-4541-8bd7-0c535fc68cb4",
                                                "sense_id": "f2fb2ed1-abe0-39b2-aca2-436abe9845d6",
                                                "text": "„Cliff öffnete seinen Tornister und breitete einige Kostproben seiner neuesten Forschungsergebnisse auf dem Kneipentisch aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
