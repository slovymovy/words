                ],
                "senses": [
                    {
                        "sense_id": "17aa3601-b5a3-3d1b-8ea4-b2298c0ddd8a",
                        "entry_id": "650b1b1f-5810-3dc5-87c6-d3c4face155b",
                        "glosses": [
                            "Qui ruisselle, en parlant d'un liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d25d9ad-05f6-41c4-90ec-fd48f5fca678",
                                "sense_id": "17aa3601-b5a3-3d1b-8ea4-b2298c0ddd8a",
                                "text": "Dans son coin, Paul Hans fredonnait une chanson en s’épongeant le cou, chassant à grands gestes les nuées de moute-moute qui s’acharnaient sur la peau ruisselante de son visage."
                            },
                            {
                                "example_id": "15b2d89e-d898-421e-9499-055c909c4f4b",
                                "sense_id": "17aa3601-b5a3-3d1b-8ea4-b2298c0ddd8a",
                                "text": "La nuit était froide, ses habits étaient ruisselants, il avait besoin d’un feu et d’un lit."
                            },
                            {
                                "example_id": "6ac572dd-29e8-47a4-9a0d-5a118670d80b",
                                "sense_id": "17aa3601-b5a3-3d1b-8ea4-b2298c0ddd8a",
                                "text": "A s'entendre appeler ainsi, Belle de Candeur fut si surprise que son corps se couvrit de sueurs froides ; et c’est ruisselante qu’elle se réveilla."
                            }
                        ]
                    }
                ],
