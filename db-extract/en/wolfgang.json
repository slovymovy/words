                                "target_senses": [
                                    {
                                        "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                        "entry_id": "46acf78c-1b4f-306a-8cb4-76b8d53d9a55",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95514989-7537-4a5a-9079-0f9797125a9c",
                                                "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                                "text": "Wolfgang, den werde ich nie vergessen, und auch nicht, wie wir einen Regentanz zu Ina Detert getanzt haben."
                                            },
                                            {
                                                "example_id": "4f6601be-12b5-4195-9b05-edd0a0a5e5a2",
                                                "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                                "text": "Marika und Wolfgang haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "803f8585-26ce-4014-b0d4-71ab8137f95f",
                                                "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                                "text": "Wolfgang spielt gern."
                                            },
                                            {
                                                "example_id": "7b89bc8a-24fa-4d0e-b2de-a6a104aa7608",
                                                "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                                "text": "Wolfgang Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "3d2366a4-5f91-4806-b7de-b93cbf5a26af",
                                                "sense_id": "833f1d75-07ed-38cc-86c1-3c8702c53d3a",
                                                "text": "Kennen sie den Vornamen Wolfgang?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolfgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                        "entry_id": "69891c90-830f-3be6-ab5d-1923d59c5924",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ea5d22-d36d-4bf9-aa37-2f2adcd34ceb",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Frau Wolfgang ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9cb8d95d-354b-42df-b5c8-adb522e40a69",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Herr Wolfgang wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6274910c-601c-4d85-bbd0-5862ed0b264e",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Die Wolfgangs kommen heute aus der Wachau."
                                            },
                                            {
                                                "example_id": "41e244d9-27cc-4eb3-b5bb-7b9990e4bf70",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Der Wolfgang trägt nie die Schals, die die Wolfgang ihm strickt."
                                            },
                                            {
                                                "example_id": "6a6389ec-36aa-4de9-91ee-50f0797141b4",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wolfgang kommt, geht der Herr Wolfgang.“"
                                            },
                                            {
                                                "example_id": "365a07f4-a8e0-4dc5-b1ba-700ac699f760",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Wolfgang kommt und geht."
                                            },
                                            {
                                                "example_id": "6e8f5a5b-3f1d-4bb5-b1c6-de2c4526cd5a",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "Wolfgangs kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "d60e5ae3-cd82-4638-af4d-87ec8edee215",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "An verregneten Herbsttagen ist Familie Wolfgangs liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "cd3eeeab-8be5-4d6a-981f-25194292ba6c",
                                                "sense_id": "088de76e-32c7-38fb-bfc0-2370b6ef4a5c",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Wolfgang das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
