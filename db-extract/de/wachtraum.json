                ],
                "senses": [
                    {
                        "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                        "entry_id": "af527f09-6ff0-36af-a62c-670127ae7223",
                        "glosses": [
                            "traumähnliche, oft steuerbare Phantasievorstellung in wachem Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7ce111-1309-42c2-9ac9-5adbdd851cf7",
                                "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                                "text": "Petra kann sich nicht auf ihre Hausaufgaben konzentrieren; immer wieder versinkt sie in Wachträume, in denen meist der nette Junge von nebenan vorkommt."
                            },
                            {
                                "example_id": "1fdb5e7a-0808-4b0e-addf-e87e11740b9d",
                                "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                                "text": "„Dann tauchte ich in einen Wachtraum ein. Ich sah mich als Kind in unserem Garten. Sah meinen Hund, meine Geschwister, meine Eltern.“"
                            },
                            {
                                "example_id": "e1138857-b198-42f2-90f3-3a6f1d063fa7",
                                "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                                "text": "„Als ‚ältesten Wachtraum der Menschheit‘ bezeichnete Ernst Bloch 1961 die ‚Umwerfung aller Verhältnisse, worin der Mensch ein erniedrigtes, geknechtetes, verlassenes, verächtliches Wesen ist‘.“"
                            },
                            {
                                "example_id": "721d9bdb-b6a3-4c74-a486-03ac622ae631",
                                "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                                "text": "„Ich hatte einen Wachtraum.“"
                            },
                            {
                                "example_id": "a1d66a82-e4c7-485a-9c72-241ff27e7039",
                                "sense_id": "04f0d440-abe2-381c-b83a-04c296a58c69",
                                "text": "„Hoffmann hat nicht nur ein sehr lebhaftes Traumleben, oft kommt es auch vor, daß ihm Wachträume erscheinen, er hat oft Vorahnungen und Gesichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
