                ],
                "senses": [
                    {
                        "sense_id": "cdf64157-15fa-3dde-859e-a7933af020bc",
                        "entry_id": "de8d8155-b14c-35e2-af28-426b2450b91c",
                        "glosses": [
                            "Rendre kasher, ou rendre propre à une utilisation kasher (quelque chose qui a servi de façon non kasher)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7620b36c-781e-4ab8-9604-81620fd7dd82",
                                "sense_id": "cdf64157-15fa-3dde-859e-a7933af020bc",
                                "text": "Lorsqu’un récipient a été souillé par un contact impur, il faut le « kachériser »."
                            },
                            {
                                "example_id": "69ab1987-3219-4a94-b62d-40d8f8b2372e",
                                "sense_id": "cdf64157-15fa-3dde-859e-a7933af020bc",
                                "text": "Un lave-vaisselle qui a servi à laver du non kacher, doit être kachérisé."
                            },
                            {
                                "example_id": "367962fa-0f45-44f4-9b82-460871dde7b1",
                                "sense_id": "cdf64157-15fa-3dde-859e-a7933af020bc",
                                "text": "Tous les ustensiles en verre, les Achkénazim ne peuvent pas les kachériser."
                            }
                        ]
                    }
                ],
