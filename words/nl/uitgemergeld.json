{
    "word_family": [
        "uitmergelen",
        "mergel",
        "mergelen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28d5eff3-2ca8-32eb-9459-a17b10b9687e",
                    "sense_definition": "door ziekte, gebrek of uitputting extreem vermagerd en verzwakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De natuurfotograaf zag een <w>uitgemergelde</w> ijsbeer die door voedselgebrek nauwelijks meer op zijn poten kon staan.",
                            "target_lang_translations": {
                                "en": "The nature photographer saw an <w>emaciated</w> polar bear that could hardly stand on its legs due to a lack of food."
                            }
                        },
                        {
                            "text": "Na weken van honger zag de man er <w>uitgemergeld</w> uit, met een opvallend mager gezicht en diepliggende ogen.",
                            "target_lang_translations": {
                                "en": "After weeks of hunger, the man looked <w>gaunt</w>, with a strikingly thin face and deep-set eyes."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitgeteerd",
                        "broodmager",
                        "vermagerd",
                        "mager"
                    ],
                    "antonyms": [
                        "gezet",
                        "dik",
                        "welgedaan",
                        "gezond"
                    ],
                    "common_phrases": [
                        "een uitgemergeld gezicht",
                        "er uitgemergeld uitzien"
                    ],
                    "target_lang_definitions": {
                        "en": "extremely thin and weakened due to illness, lack of food, or exhaustion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emaciated",
                                "target_lang_sense_clarification": "abnormally thin or weak, especially because of illness or a lack of food"
                            },
                            {
                                "target_lang_word": "gaunt",
                                "target_lang_sense_clarification": "lean and haggard, especially because of suffering, hunger, or age"
                            },
                            {
                                "target_lang_word": "starved",
                                "target_lang_sense_clarification": "suffering or dying from hunger; extremely thin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "224ddfcd-5361-3280-bf35-8ea80f19c343",
                    "sense_definition": "voltooid deelwoord van <w>uitmergelen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jarenlange intensieve landbouw heeft de vruchtbare grond volledig <w>uitgemergeld</w>.",
                            "target_lang_translations": {
                                "en": "Years of intensive agriculture have completely <w>depleted</w> the fertile soil."
                            }
                        },
                        {
                            "text": "De zware arbeid heeft zijn lichaam in korte tijd helemaal <w>uitgemergeld</w>.",
                            "target_lang_translations": {
                                "en": "The heavy labor has completely <w>exhausted</w> his body in a short period of time."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'uitmergelen' (to exhaust, deplete, or emaciate)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depleted",
                                "target_lang_sense_clarification": "used for soil or resources that have been exhausted"
                            },
                            {
                                "target_lang_word": "exhausted",
                                "target_lang_sense_clarification": "completely used up or worn out"
                            },
                            {
                                "target_lang_word": "emaciated",
                                "target_lang_sense_clarification": "physically wasted away"
                            }
                        ]
                    }
                }
            ]
        }
    ]
