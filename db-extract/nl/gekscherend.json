                "senses": [
                    {
                        "sense_id": "702ee583-a865-324c-995f-82c2e595b6bb",
                        "entry_id": "8bf09547-d7a7-3502-b0e7-b6dcdbed83b6",
                        "glosses": [
                            "op een grappige manier spottend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec608b9-ee4e-4e30-b403-00253bde82e7",
                                "sense_id": "702ee583-a865-324c-995f-82c2e595b6bb",
                                "text": "De sfeer onderling is prima en veel gekscherende opmerkingen worden gemaakt."
                            },
                            {
                                "example_id": "7ae62741-d08c-4f74-aad2-18a2b4c08936",
                                "sense_id": "702ee583-a865-324c-995f-82c2e595b6bb",
                                "text": "Hoewel talloze mensen op onder meer Twitter op gekscherende wijze waarschuwen voor het 'carmageddon', bestaan er ook reële zorgen over de openbare veiligheid. Landingsplatformen voor helikopters zijn beschikbaar gesteld voor reddingshelikopters en er is extra brandweer- en paramedisch personeel ingezet."
                            },
                            {
                                "example_id": "909f6fd7-6219-453b-af88-9d9208680e33",
                                "sense_id": "702ee583-a865-324c-995f-82c2e595b6bb",
                                "text": "De kracht van de acht theaterbeesten van Kalefater zit 'm in de toewijding. Na de gekscherende opmerking van Eissens en de reactie van Ekkelkamp ging Frits Tutert onmiddellijk aan het tekenen."
                            }
                        ]
                    }
                ],
