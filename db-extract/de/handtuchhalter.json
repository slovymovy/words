                        "entry_id": "a5c9149b-f231-35f3-9d82-0eded4546475",
                        "glosses": [
                            "Vorrichtung zum Aufhängen und Bereitstellen von Handtüchern, die meistens direkt neben einem Waschbecken angebracht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a04da8b-cff9-45d8-a060-8cc499e0d141",
                                "sense_id": "b48da146-6bd1-3000-afee-75215d516b8d",
                                "text": "Wir bringen zwischen den beiden Waschbecken einen weiteren Handtuchhalter an."
                            },
                            {
                                "example_id": "ced46043-9686-4518-ac36-c7e0a4787871",
                                "sense_id": "b48da146-6bd1-3000-afee-75215d516b8d",
                                "text": "„Er nahm einen Waschlappen von dem gläsernen Handtuchhalter, drehte das heiße Wasser auf, befeuchtete den Waschlappen, wrang ihn aus und wischte sich damit Gesicht und Nacken.“"
                            }
                        ],
