                        ]
                    },
                    {
                        "translation_id": "46e29ea4-f59c-4fc7-9718-4b6d5f0179d3",
                        "source_entry_id": "163650d4-d818-3397-9839-f728da08d2d5",
                        "source_sense_id": "855f59b2-7c6a-3fa2-a7d3-336baa55cb06",
                        "target_lang_word": "Judée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcef4808-389f-3d5b-9d77-f75768f691b1",
                                        "entry_id": "2a0f2aec-438a-358f-bd17-4ffe155b6d89",
                                        "glosses": [
                                            "Région historique de Palestine, au sud de la région Samarie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9253b9c1-c964-4af9-8ee8-db09f023fafe",
                                                "sense_id": "dcef4808-389f-3d5b-9d77-f75768f691b1",
                                                "text": "La région a cessé de s'appeler la Judée pour prendre le nom de Palestine, en référence aux plus anciens ennemis des Juifs, les Philistins – habitants de la bande de Gaza que les Juifs, à vrai dire, avaient commencé par déloger."
                                            },
                                            {
                                                "example_id": "4f83c035-ad3e-4aa5-bb92-950b9dfd4e18",
                                                "sense_id": "dcef4808-389f-3d5b-9d77-f75768f691b1",
                                                "text": "— Derrière le Christ, c’était un paysage de la terre de Chanaan : une campagne nue, pierreuse, je ne sais quelle mélancolie d’abandon dans de la lumière chaude, je ne sais quoi d’inexprimable qui m’avait fait comprendre la Judée…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0c7284-2ef4-3696-a603-042fdbf8c95e",
                                        "entry_id": "2a0f2aec-438a-358f-bd17-4ffe155b6d89",
                                        "glosses": [
                                            "Province romaine fondée en l'an 6 et recouvrant à peu près la même région."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a260345-1b8f-4046-93f9-1252608a58a0",
                                                "sense_id": "1c0c7284-2ef4-3696-a603-042fdbf8c95e",
                                                "text": "Lorsque le gouverneur juif du Temple refusa en 66 d'accepter les sacrifices offerts au nom de l'empereur – compromis qui permettait aux Juifs de ne pas sacrifier au culte impérial –, le procurateur de Judée lança un assaut sur le Temple et en pilla le trésor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9efb4051-cb8a-3ac0-a5da-abe2f90a6586",
                                        "entry_id": "2a0f2aec-438a-358f-bd17-4ffe155b6d89",
                                        "glosses": [
                                            "Surnom de Bethléem, quartier de la ville de Clamecy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5decf103-39f3-497c-b6f9-f84a89081046",
                                                "sense_id": "9efb4051-cb8a-3ac0-a5da-abe2f90a6586",
                                                "text": "Ces messieurs de Judée nous traitent de paysans, d’escargots de Bourgogne et de croque-fumier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
