                        "glosses": [
                            "Maladie parasitaire affectant les poissons porteurs de lésions préalables, sur lesquelles se développe une sorte de mousse cotonneuse blanchâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ec43ee-3de7-4d71-85f2-093b6023e016",
                                "sense_id": "b2474c7c-80df-3c60-ba04-d548de4564d7",
                                "text": "Ces poissons meurtris développent généralement dans les jours qui suivent le frai une saprolégniose quasi fatale (mousse blanche)."
                            },
                            {
                                "example_id": "d646c0c4-e934-4fad-97be-14c56fb923bb",
                                "sense_id": "b2474c7c-80df-3c60-ba04-d548de4564d7",
                                "text": "La saprolégniose apparaît comme une moisissure blanchâtre, cotonneuse, s'attaquant à la peau, aux branchies et même aux yeux, ce qui peut provoquer étouffement et exophtalmie."
                            }
                        ]
                    }
