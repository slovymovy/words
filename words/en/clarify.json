{
    "word_family": [
        "clarification",
        "clarity",
        "clear",
        "clearly",
        "unclarified"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3fc8ba9-8324-33e7-9253-1599d3a2c57d",
                    "sense_definition": "To make something easier to understand by explaining it in more detail or removing confusion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "explain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please <w>clarify</w> your position on the new company policy?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы, пожалуйста, <w>прояснить</w> вашу позицию относительно новой политики компании?",
                                "tr": "Lütfen yeni şirket politikası hakkındaki duruşunuzu <w>açıklığa kavuşturabilir</w> misiniz?"
                            }
                        },
                        {
                            "text": "The teacher had to <w>clarify</w> the instructions because the students were confused.",
                            "target_lang_translations": {
                                "ru": "Учителю пришлось <w>разъяснить</w> инструкции, потому что ученики были в замешательстве.",
                                "tr": "Öğrencilerin kafası karıştığı için öğretmen talimatları <w>netleştirmek</w> zorunda kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "explicitize",
                        "get straight"
                    ],
                    "antonyms": [
                        "confuse",
                        "obscure"
                    ],
                    "common_phrases": [
                        "clarify the situation",
                        "clarify your position",
                        "clarify a point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более понятным, объяснив это более подробно или устранив путаницу.",
                        "tr": "Bir şeyi daha ayrıntılı açıklayarak veya kafa karışıklığını gidererek daha kolay anlaşılır hale getirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прояснить",
                                "target_lang_sense_clarification": "сделать понятным"
                            },
                            {
                                "target_lang_word": "уточнить",
                                "target_lang_sense_clarification": "внести детали"
                            },
                            {
                                "target_lang_word": "разъяснить",
                                "target_lang_sense_clarification": "подробно объяснить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açıklığa kavuşturmak",
                                "target_lang_sense_clarification": "bir konuyu anlaşılır kılmak"
                            },
                            {
                                "target_lang_word": "netleştirmek",
                                "target_lang_sense_clarification": "belirsizliği gidermek"
                            },
                            {
                                "target_lang_word": "açıklamak",
                                "target_lang_sense_clarification": "detaylı bilgi vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85e143a5-d3e7-3faf-a9a2-97299fd9894c",
                    "sense_definition": "To make a liquid pure or clear by removing impurities or solid particles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "purify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>clarify</w> the butter by heating it and removing the milk solids.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>очистить</w> масло, нагрев его и удалив молочные белки.",
                                "tr": "Tereyağını ısıtıp süt tortularını alarak <w>sade yağ haline getirmeniz</w> gerekiyor."
                            }
                        },
                        {
                            "text": "Leave the wine for twenty-four hours and it will <w>clarify</w> naturally.",
                            "target_lang_translations": {
                                "ru": "Оставьте вино на двадцать четыре часа, и оно <w>прояснится</w> естественным путем.",
                                "tr": "Şarabı yirmi dört saat bekletin, kendiliğinden <w>berraklaşacaktır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "explicitize"
                    ],
                    "antonyms": [
                        "cloud",
                        "contaminate"
                    ],
                    "common_phrases": [
                        "clarify butter",
                        "clarify cooking oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать жидкость чистой или прозрачной путем удаления примесей или твердых частиц.",
                        "tr": "Bir sıvıyı içindeki yabancı maddeleri veya katı parçacıkları uzaklaştırarak saf veya berrak hale getirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "от примесей"
                            },
                            {
                                "target_lang_word": "осветлять",
                                "target_lang_sense_clarification": "делать прозрачным"
                            },
                            {
                                "target_lang_word": "проясниться",
                                "target_lang_sense_clarification": "стать прозрачным (о жидкости)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "arıtmak",
                                "target_lang_sense_clarification": "saf hale getirmek"
                            },
                            {
                                "target_lang_word": "süzüp berraklaştırmak",
                                "target_lang_sense_clarification": "sıvıyı berrak yapmak"
                            },
                            {
                                "target_lang_word": "temizlemek",
                                "target_lang_sense_clarification": "tortulardan arındırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e161f435-d2ae-3701-8fbd-6b68c132c1ff",
                    "sense_definition": "To give glory or honor to something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "glorify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, poets would often <w>clarify</w> the deeds of their kings.",
                            "target_lang_translations": {
                                "ru": "В древних текстах поэты часто <w>прославляли</w> деяния своих королей.",
                                "tr": "Eski metinlerde şairler genellikle krallarının icraatlarını <w>yüceltirlerdi</w>."
                            }
                        },
                        {
                            "text": "The monument was built to <w>clarify</w> the memory of the fallen heroes.",
                            "target_lang_translations": {
                                "ru": "Памятник был построен, чтобы <w>увековечить</w> память павших героев.",
                                "tr": "Anıt, düşen kahramanların anısını <w>onurlandırmak</w> için inşa edildi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздавать славу или почести чему-либо или кому-либо (устаревшее).",
                        "tr": "Birine veya bir şeye yücelik, şan veya onur vermek (eskimiş kullanım)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прославлять",
                                "target_lang_sense_clarification": "воспевать"
                            },
                            {
                                "target_lang_word": "величать",
                                "target_lang_sense_clarification": "возносить почести"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüceltmek",
                                "target_lang_sense_clarification": "övgüyle anmak"
                            },
                            {
                                "target_lang_word": "onurlandırmak",
                                "target_lang_sense_clarification": "şereflendirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
