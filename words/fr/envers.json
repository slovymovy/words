            "senses": [
                {
                    "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                    "sense_definition": "À l'égard de quelqu'un ou de quelque chose, marquant la direction de sentiments ou de comportements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se montre toujours très poli et attentionné <w>envers</w> ses voisins âgés."
                        },
                        {
                            "text": "Elle a exprimé une vive reconnaissance <w>envers</w> les médecins qui l'ont soignée."
                        }
                    ],
                    "synonyms": [
