                ],
                "senses": [
                    {
                        "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                        "entry_id": "eb782bb2-c2e7-3d96-936b-8e9d21f4c659",
                        "glosses": [
                            "Auflösen beengender Zustände, Erweiterung der Handlungsspielräume"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c1d291-903e-413b-a25f-1bd4949ab237",
                                "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                                "text": "„Afrikanischer Vitalismus als lebendige Religion enthält nach Bulagas Darstellung in sich selbst schon das Prinzip der Grenzsprengung.“"
                            },
                            {
                                "example_id": "2fdf5156-a8a0-41b0-a300-e158a14937d0",
                                "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                                "text": "„Entwicklung braucht das Überwinden der Verharrungstendenz. Sie braucht die Grenzsprengung, weil nur so die Handlungsspielräume und die eigenen Persönlichkeitsdimensionen erfahrbar werden.“"
                            },
                            {
                                "example_id": "00bfbf82-3cd6-433b-8335-d2344bfe0456",
                                "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                                "text": "„Aber die Grenzsprengung auf der wirtschaftlichen Seite hat zwangsweise die Grenzsprengung auf der sozial-gesellschaftlichen Seite zur Folge.“"
                            },
                            {
                                "example_id": "7784b74c-ef59-4950-84eb-2c2efb32743b",
                                "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                                "text": "„In ihrer Studie über Apollinaire spricht Carola Giedion-Welcker sogar von einer neuen Bildtypographie, von Grenzsprengungen ins Sichtbare des Wort-Bildes hinüber.“"
                            },
                            {
                                "example_id": "499a81a7-cbe4-424e-9a58-99fd879ba7eb",
                                "sense_id": "1f7e2bb6-99c2-3f87-a24d-85c344b4e23f",
                                "text": "„Eine Kritik der Grenzen des Menschen […] scheint mir heute, da sein Produzieren alle Grenzen gesprengt zu haben scheint, und da diese spezielle Grenzsprengung die noch immer bestehenden Grenzen der anderen Vermögen […] deutlich sichtbar gemacht hat, geradezu das Desiderat der Philosophie geworden zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
