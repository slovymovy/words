                ],
                "senses": [
                    {
                        "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                        "entry_id": "1244f4ac-e24e-32b7-acd3-2cdf2788a1e3",
                        "glosses": [
                            "A sea between Italy and the Balkan Peninsula; an extension of the Mediterranean located between the boot of Italy and the Dalmatian coast of the Balkans; in full, Adriatic Sea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cfd34c-7f92-409c-a99d-89c46a782de0",
                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                "text": "Her husband sail'd upon the Adriatic,\nAnd made some voyages, too, in other seas,"
                            },
                            {
                                "example_id": "6ec23d3a-2f66-41ea-a8f2-ee35b914fa10",
                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                "text": "A strange story comes from the Adriatic."
                            },
                            {
                                "example_id": "bfa1d723-8611-4c71-aff1-78dfbdda58c6",
                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                "text": "From Stettin in the Baltic to Trieste in the Adriatic, an iron curtain has descended across the Continent."
                            }
                        ]
                    }
                ],
