                "senses": [
                    {
                        "sense_id": "902000fa-c1b4-3bac-9be8-52f36610b07c",
                        "entry_id": "be5fea9c-79c4-30f1-92e0-607d7891ed7b",
                        "glosses": [
                            "Handhaltung, bei der sich Daumen, Ring- und Mittelfinger berühren und Zeige- sowie kleiner Finger gestreckt sind und das als Signal im Unterricht eingesetzt wird, um Ruhe zu schaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da2fc25-bc78-417f-9c8f-fb8adb09b8e8",
                                "sense_id": "902000fa-c1b4-3bac-9be8-52f36610b07c",
                                "text": "„Das Kultusministerium in Baden-Württemberg hat einem Medienbericht zufolge Lehrerinnen und Lehrern empfohlen, auf den sogenannten Schweigefuchs zu verzichten.“"
                            },
                            {
                                "example_id": "549e883a-e9ef-44bd-97bf-ab40e100a076",
                                "sense_id": "902000fa-c1b4-3bac-9be8-52f36610b07c",
                                "text": "„Immer, wenn jemand den Schweigefuchs zeigt, müssen die Gesprächsteilnehmer zuhören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
