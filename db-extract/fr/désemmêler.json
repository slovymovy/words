                        "glosses": [
                            "Démêler (quelque chose qui était emmêlé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2fdb380-e91a-45bb-8565-7497e0a75744",
                                "sense_id": "256a1395-3c61-3ed4-a146-5448a5bb0845",
                                "text": "Pour exposer cette situation complexe, l'historien, rappelé à l'ordre par la chronologie et l'événement, peine à désemmêler l'écheveau."
                            },
                            {
                                "example_id": "ff9c0795-7fa8-40a9-98bb-01e039d351cf",
                                "sense_id": "256a1395-3c61-3ed4-a146-5448a5bb0845",
                                "text": "Le bon Stoklasa se souvient à ce propos d'une histoire ridicule que lui raconta l'avocat, et se met à la désemmêler de l'écheveau de sa mémoire."
                            }
                        ]
                    }
