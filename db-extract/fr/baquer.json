                "senses": [
                    {
                        "sense_id": "1f52d05d-e63f-3274-ac12-ebbdac5c3dc1",
                        "entry_id": "fb69f1fa-86f7-3cd8-8c4a-68900105bd8c",
                        "glosses": [
                            "Se baigner."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f0a81a4f-63dd-4b2e-850e-ecec3269bf4e",
                                "sense_id": "1f52d05d-e63f-3274-ac12-ebbdac5c3dc1",
                                "text": "Deux marches à descendre. On se baque ensemble, miss et moi. Elle m'oint. Si tu verrais ces crèmes, lotions, onguents qu'elle dispose (c.d.B.) ! Un fourbi formide. Et efficace !"
                            },
                            {
                                "example_id": "3a738f63-0237-4699-8d0e-eccf6bcf7263",
                                "sense_id": "1f52d05d-e63f-3274-ac12-ebbdac5c3dc1",
                                "text": "Il fit allusion coup sur coup au pont passerelle qui reliait jadis les deux rives, les parties de pêche, les baignades dans la rivière où l'on se « baquait à poil, les étés de plein cagnard »."
                            },
                            {
                                "example_id": "718837c9-c7c5-4b7f-ab1f-9092e614c26a",
                                "sense_id": "1f52d05d-e63f-3274-ac12-ebbdac5c3dc1",
                                "text": "Celles-là, elles friment, parce qu'elles ont toutes, au poignet, un bracelet en plastique bleu, qui leur permet d'aller se baquer dans leur piscine résidentielle."
                            }
                        ]
                    }
