                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e06fc9-0834-471e-9ee1-1b0bee097616",
                                "sense_id": "12ee9f51-3cd3-363b-9478-51ab5a190126",
                                "text": "De ontzetting stond op zijn gezicht af te lezen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e22732b2-1db2-34f2-a1c3-94590616c7e1",
                        "entry_id": "eb060757-ae89-3b64-942b-7fca46cf3d11",
                        "glosses": [
                            "volgens artikel 31 van het Belgisch Strafwetboek, een rechterlijke beslissing die aan de veroordeelde het recht ontneemt bepaalde burgerlijke en/of politieke ambten uit te oefenen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02184eea-995c-4d18-8aa4-49996f7bb934",
                        "source_entry_id": "eb060757-ae89-3b64-942b-7fca46cf3d11",
                        "source_sense_id": "12ee9f51-3cd3-363b-9478-51ab5a190126",
                        "source_sense_description": "grote mate van schrik",
                        "target_lang_word": "Entsetzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entsetzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                        "entry_id": "fa8c38e6-a565-352b-9ad7-a3dc4e3198c9",
                                        "glosses": [
                                            "Gefühl des fassungslosen Erschreckens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13601497-541f-4860-aa64-89216650b243",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "Mit Entsetzen stellte er fest, dass er von Feinden umgeben war."
                                            },
                                            {
                                                "example_id": "544a6e74-0776-4451-9a51-d54b36d7681c",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Er ſieht das Entſetzen in ihrem Geſicht, ihr Unterkiefer fängt an zu zittern, über das alte, faltige Frauengeſicht laufen Tränen …“"
                                            },
                                            {
                                                "example_id": "e1b7fe27-f7bf-46c8-9bbb-45edd1b102ea",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Georg spuerte schon ein Entsetzen, gegen das man nicht ankaempfen konnte, man war schon vorher gelaehmt.“"
                                            },
                                            {
                                                "example_id": "c0114380-bf4e-4793-9287-bf59bee005f1",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Die Wurzel des kantischen Optimismus, nach dem moralisches Handeln auch dort vernünftig sei, wo das niederträchtige gute Aussicht habe, ist das Entsetzen vor dem Rückfall in die Barbarei.“"
                                            },
                                            {
                                                "example_id": "16f756d3-7b4c-424b-b467-36f41b4815d6",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Eher ist anzunehmen, daß der Faschismus und das Entsetzen, das er bereitete, damit zusammenhängen, daß die alten, etablierten Autoritäten des Kaiserreichs zerfallen, gestürzt waren, nicht aber die Menschen psychologisch schon bereit, sich selbst zu bestimmen.“"
                                            },
                                            {
                                                "example_id": "6a86e7fe-fad7-426c-9052-e63844bc1895",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Und er schwelgte in Ekel und Haß, und es sträubten sich seine Haare vor wohligem Entsetzen.“"
                                            },
                                            {
                                                "example_id": "98007130-9751-4126-9907-151b17f0edec",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Entsetzen kroch in ihr hoch und machte sie steif.“"
                                            },
                                            {
                                                "example_id": "6101804c-c3ef-40e1-b2cf-c319daa93a77",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„David ging bleich und gefaßt ins Spital und kam zwei Stunden später stumm vor Entsetzen wieder zurück.“"
                                            },
                                            {
                                                "example_id": "3808aeb6-1e55-439b-aa7e-286086e53b5b",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Es war ein plötzlicher Schrei, dem man anhörte, daß ihm weniger Schmerz denn Entsetzen zugrunde lag.“"
                                            },
                                            {
                                                "example_id": "9c4e7f9f-d69d-464e-b9c7-712b33251bc8",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Alek schoss das Entsetzen in jede Faser ihres Körpers, füllte die Risse, die die Angst verursacht hatte.“"
                                            },
                                            {
                                                "example_id": "b310e8aa-e7fd-4f8e-ab47-313b66be50f1",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Die Nachricht aus dem fernen Norden löste in Rom Entsetzen aus.“"
                                            },
                                            {
                                                "example_id": "bee85c90-515c-4762-8162-5d6bb0c3bd90",
                                                "sense_id": "6876fc03-e633-3306-8214-c5067ffb4eef",
                                                "text": "„Dann blickte ich voller Entsetzen auf den Boden des Spielplatzes: Er war mit kleinen Kindergräbern bedeckt, zwischen denen wilde Blumen blühten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
