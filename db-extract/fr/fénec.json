                            {
                                "example_id": "58e4e59e-e4ea-461f-bba2-7100eadcae2e",
                                "sense_id": "cf2e28cd-4e4a-3e17-bb32-80099bdf6faa",
                                "text": "Il y avait là des autruches, des gazelles, une girafe et, pêle-mêle, des renards fénecs, des léopards, et même un lion !"
                            },
                            {
                                "example_id": "55efe941-113c-4687-a6d3-37d9c3ae5b37",
                                "sense_id": "cf2e28cd-4e4a-3e17-bb32-80099bdf6faa",
                                "text": "Le Tchad est doté d’une faune variée : lions, rhinocéros, girafes… toute la panoplie des grands animaux, jusqu’aux gazelles et fénecs du désert en passant par tous les oiseaux migrateurs ou non."
                            },
                            {
                                "example_id": "5997320a-4387-4679-a55f-c01ec60f68a3",
                                "sense_id": "cf2e28cd-4e4a-3e17-bb32-80099bdf6faa",
                                "text": "On entendait plus que glapir les fénecs en chasse et les aboiements féroces des chiens kabyles."
