                                                "sense_id": "cfd0f9cb-b4b8-3c4e-b8fa-e10c77484f9c",
                                                "text": "Möchtest du noch etwas? Nein, danke. Ich bin satt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50a9ae66-d7a0-35ea-8a49-307dfa78ebca",
                                        "entry_id": "d2c02cc2-91ca-30c6-86dc-3dbfa3e24d22",
                                        "glosses": [
                                            "etwas nicht mehr ertragen könnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e66c8b-83ab-404c-8f45-8878b2ce7b3a",
                                                "sense_id": "50a9ae66-d7a0-35ea-8a49-307dfa78ebca",
                                                "text": "Jetzt hab' ich es aber endgültig satt!"
                                            },
                                            {
                                                "example_id": "5fe64033-b831-462f-bd4a-83dc0addd442",
                                                "sense_id": "50a9ae66-d7a0-35ea-8a49-307dfa78ebca",
                                                "text": "„Seit die Kultur vom Kultus abgefallen ist und aus sich selber einen gemacht hat, ist sie denn auch nichts anderes mehr als ein Abfall, und alle Welt ist ihrer nach bloßen fünfhundert Jahren so müd und satt, als wenn sie's, salva venia, mit eisernen Kochlöffeln gefressen hätt...“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4a25d321-c74f-3686-8967-7eb1c3ad9a79",
                                        "entry_id": "d2c02cc2-91ca-30c6-86dc-3dbfa3e24d22",
                                        "glosses": [
                                            "mehr als zufriedenstellend, deutlich überdurchschnittlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8869dadc-5e98-4926-a14d-9e50f5580d6f",
                                                "sense_id": "4a25d321-c74f-3686-8967-7eb1c3ad9a79",
                                                "text": "All die Erfolge zauberten ein sattes Grinsen auf sein Gesicht."
                                            },
                                            {
                                                "example_id": "8fd51178-5abe-44e7-ba20-fdd24f30e1c6",
                                                "sense_id": "4a25d321-c74f-3686-8967-7eb1c3ad9a79",
                                                "text": "Und dann bekommt sie auch noch ein sattes Gehalt mit Tantiemen."
                                            },
                                            {
                                                "example_id": "4aad20ff-08dc-428c-8aee-dbc0badce215",
                                                "sense_id": "4a25d321-c74f-3686-8967-7eb1c3ad9a79",
                                                "text": "200€? Das ist aber eine satte Strafe!"
                                            },
                                            {
                                                "example_id": "32c30755-aad0-4c59-8925-56309ca74da9",
                                                "sense_id": "4a25d321-c74f-3686-8967-7eb1c3ad9a79",
                                                "text": "„Erst setzte Konrad Laimer noch einen Köpfler nach Eckball knapp neben die Stange (60.), schließlich war aber Berisha mit etwas Ballglück und sattem Schuss aus spitzem Winkel mit dem 1:0 zur Stelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5c99cbac-c142-3672-bb8c-c3265c0166d3",
                                        "entry_id": "d2c02cc2-91ca-30c6-86dc-3dbfa3e24d22",
                                        "glosses": [
                                            "leuchtend"
                                        ],
                                        "tags": [
                                            "von Farben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d2787c-a1a2-4444-8f0f-03fc4ae0ffe8",
                                                "sense_id": "5c99cbac-c142-3672-bb8c-c3265c0166d3",
                                                "text": "Emil Noldes Bilder zeichnen sich durch ihre meist satten Farben aus."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e6822d54-c421-3a5c-b580-8c4f00ee2674",
                                        "entry_id": "d2c02cc2-91ca-30c6-86dc-3dbfa3e24d22",
                                        "glosses": [
                                            "reichlich vorhanden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f861d0d-8b38-42d4-9132-273747613772",
                                                "sense_id": "e6822d54-c421-3a5c-b580-8c4f00ee2674",
                                                "text": "Angebot: Kaffee satt für 2,90 €"
                                            },
                                            {
                                                "example_id": "0c6cebd4-33f6-4fc2-a8ea-20904df500a4",
                                                "sense_id": "e6822d54-c421-3a5c-b580-8c4f00ee2674",
                                                "text": "Es gab Grillwürstchen satt."
                                            }
