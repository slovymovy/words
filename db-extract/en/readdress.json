                                                "example_id": "039103ba-1718-4cec-a222-7323c6a4cdfa",
                                                "sense_id": "68b537d7-7894-32f8-ae75-de32d1749646",
                                                "text": "„Lorentz schickte Hesse mit den Briefen wieder zurück und bat in einem Begleitbrief, das Hilfeersuchen an die Erfurter umzuadressieren.“"
                                            },
                                            {
                                                "example_id": "46976f79-b8ec-494b-b8c3-68a8bc730ef1",
                                                "sense_id": "68b537d7-7894-32f8-ae75-de32d1749646",
                                                "text": "„Speicher und Peripherie lassen sich beliebig erweitern, wobei sich auch das interne 256 x 8-Bit-RAM umadressieren lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
