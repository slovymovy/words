                        "glosses": [
                            "Droguer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83b4146-3943-4457-9bb9-8b01c060129b",
                                "sense_id": "ec660ccc-7812-3022-9fe5-0416d9e0fe34",
                                "text": "Tel est le sophisme que la drogue inspire pour justifier la rechute : je suis perdu, donc je puis me redroguer."
                            },
                            {
                                "example_id": "3a734301-83f0-4cfe-95bc-09c650e7f832",
                                "sense_id": "ec660ccc-7812-3022-9fe5-0416d9e0fe34",
                                "text": "Ce n'est pas en tournant autour du pot que tu l'auras. Il faut le faire fondre physiquement et le redroguer progressivement."
                            }
                        ]
                    }
