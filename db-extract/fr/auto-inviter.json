                ],
                "senses": [
                    {
                        "sense_id": "b8c95153-5ee2-3ac8-b38b-592909382896",
                        "entry_id": "fbdcbf11-dccf-3d5c-beb7-b85bc237c14f",
                        "glosses": [
                            "S’inviter soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1d8af4a4-a0ef-4996-a7b8-e3efec71fdc6",
                                "sense_id": "b8c95153-5ee2-3ac8-b38b-592909382896",
                                "text": "Un damoiseau s’auto-invite, s’auto-justifie, s’auto-proclame, s’auto-qualifie, s’auto-analyse, s’auto-différencie, et s'auto-promeut."
                            },
                            {
                                "example_id": "7df4c1e5-9aaf-4a30-8458-d056785ce322",
                                "sense_id": "b8c95153-5ee2-3ac8-b38b-592909382896",
                                "text": "Peillon, organisateur de ce ramassage invitait les militants de EAG à s’auto-inviter et d’inviter d’autres participants."
                            },
                            {
                                "example_id": "520566d3-3acd-47cf-8ae8-2bff9c619653",
                                "sense_id": "b8c95153-5ee2-3ac8-b38b-592909382896",
                                "text": "On dirait que personne n’est au courant qu’il est maintenant possible de « s’auto-inviter » et ce, sur le site même de Joost !"
                            }
                        ]
                    },
                    {
                        "sense_id": "85da8aa9-54b2-3ece-99a0-9c7218d538f0",
                        "entry_id": "fbdcbf11-dccf-3d5c-beb7-b85bc237c14f",
                        "glosses": [
                            "Inviter de sa propre initiative alors qu’on n’est normalement pas la personne qui invite."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "55d89f3b-eac2-48fc-af83-eeab9f77e092",
                                "sense_id": "85da8aa9-54b2-3ece-99a0-9c7218d538f0",
                                "text": "C’est elle qui a auto-invité tous ces amis Ahaha."
                            }
                        ]
                    }
