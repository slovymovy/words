                        "form": "ли́пце"
                    },
                    {
                        "form_id": "80eff616-4022-49e1-bbd1-a278480d13f1",
                        "entry_id": "8f82447e-af15-39f9-a25e-69acc4616aef",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ли́пцах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dfa9981-22f3-3e59-a91b-570efc71f025",
                        "entry_id": "8f82447e-af15-39f9-a25e-69acc4616aef",
                        "glosses": [
                            "липовый мёд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ceabd7-c150-4435-be2f-02182248dfc5",
                                "sense_id": "3dfa9981-22f3-3e59-a91b-570efc71f025",
                                "text": "Заметив отверстие, в которое лазят пчелы, его выдалбливают и обделывают должеями, чтоб можно было вынимать их и свободно доставать соты душистого зеленого меда, известного под именем липца."
                            },
                            {
                                "example_id": "04de58e6-fd2f-468b-b65e-1c426500be37",
                                "sense_id": "3dfa9981-22f3-3e59-a91b-570efc71f025",
                                "text": "Пчеловодство процветало, и Бобруйский уезд производил торговлю медом-липцем (белым) и воском."
                            }
                        ]
                    },
                    {
                        "sense_id": "577f8f21-b431-3aa7-89d7-b90e90a4847c",
                        "entry_id": "8f82447e-af15-39f9-a25e-69acc4616aef",
                        "glosses": [
                            "напиток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39b6bffc-cc18-4306-857e-e18cbb34ddcd",
                                "sense_id": "577f8f21-b431-3aa7-89d7-b90e90a4847c",
                                "text": "Чичиков налил стакан из первого графина ― точно липец, который он некогда пивал в Польше: игра как у шампанского, а газ так и шибнул приятным кручком изо рта в нос."
                            },
                            {
                                "example_id": "ca27b970-844f-43fd-b94f-e85de3aafb66",
                                "sense_id": "577f8f21-b431-3aa7-89d7-b90e90a4847c",
                                "text": "Обед у Максимова с древним венгерским и липцом, украшенный сельским праздником и присутствием дам."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad7bac26-722b-3cc2-89b9-6ea17126a73a",
                        "entry_id": "8f82447e-af15-39f9-a25e-69acc4616aef",
                        "glosses": [
                            "месяц июль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6039040b-ea18-4e17-a049-1fc9e2523308",
                                "sense_id": "ad7bac26-722b-3cc2-89b9-6ea17126a73a",
                                "text": "Галактион Какореков. Месяца Липца 20 числа в самое куроглашение."
                            }
                        ]
                    }
                ],
