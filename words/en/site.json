    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ce73ed6-c985-357a-b43e-b8ab3d7a5ef2",
                    "sense_definition": "A website; a collection of related web pages on the internet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "digital_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can download the application form directly from our <w>site</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать бланк заявления прямо с нашего <w>сайта</w>.",
                                "zh": "你可以直接从我们的<w>网站</w>下载申请表。"
                            }
                        },
                        {
                            "text": "The official <w>site</w> contains all the details about the upcoming event.",
                            "target_lang_translations": {
                                "ru": "Официальный <w>сайт</w> содержит все подробности о предстоящем мероприятии.",
                                "zh": "官方<w>网站</w>包含了关于即将举行的活动的所有细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "website"
                    ],
                    "common_phrases": [
                        "web site",
                        "official site",
                        "visit the site",
                        "launch a site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Веб-сайт; совокупность связанных веб-страниц в интернете.",
                        "zh": "网站；互联网上相关网页的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сайт",
                                "target_lang_sense_clarification": "страница в интернете"
                            },
                            {
                                "target_lang_word": "веб-сайт",
                                "target_lang_sense_clarification": "полная форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "网站",
                                "target_lang_sense_clarification": "互联网上的网页集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c015885f-f4aa-31a9-8fd4-b8dff5237f29",
                    "sense_definition": "A specific place where something is located, is happening, or will be built.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor visited the construction <w>site</w> to inspect the progress.",
                            "target_lang_translations": {
                                "ru": "Мэр посетил строительную <w>площадку</w>, чтобы проверить ход работ.",
                                "zh": "市长视察了施工<w>工地</w>以检查进度。"
                            }
                        },
                        {
                            "text": "Tourists flock to the <w>site</w> of the ancient battle every year.",
                            "target_lang_translations": {
                                "ru": "Туристы ежегодно стекаются к <w>месту</w> древней битвы.",
                                "zh": "游客们每年都会涌向那场古战役的发生<w>地点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "location",
                        "place",
                        "spot",
                        "setting"
                    ],
                    "common_phrases": [
                        "construction site",
                        "historic site",
                        "archaeological site",
                        "on site",
                        "site of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное место, где что-либо находится, происходит или будет построено.",
                        "zh": "某物所在、发生或将要建造的具体地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "строительная или специально оборудованная"
                            },
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "земли или территории"
                            },
                            {
                                "target_lang_word": "местоположение",
                                "target_lang_sense_clarification": "географическое положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地点",
                                "target_lang_sense_clarification": "一般意义上的场所"
                            },
                            {
                                "target_lang_word": "工地",
                                "target_lang_sense_clarification": "施工现场"
                            },
                            {
                                "target_lang_word": "场所",
                                "target_lang_sense_clarification": "特定用途的地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b534606-b369-3341-83fb-26c81bbd19f2",
                    "sense_definition": "A specific area on the body where a medical procedure has been performed or is intended.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse cleaned the injection <w>site</w> with an alcohol wipe.",
                            "target_lang_translations": {
                                "ru": "Медсестра протерла <w>место</w> укола спиртовой салфеткой.",
                                "zh": "护士用酒精棉片清洁了注射<w>部位</w>。"
                            }
                        },
                        {
                            "text": "Patients should monitor the surgical <w>site</w> for any signs of infection.",
                            "target_lang_translations": {
                                "ru": "Пациентам следует наблюдать за <w>местом</w> операции на предмет признаков инфекции.",
                                "zh": "患者应观察手术<w>部位</w>是否有感染迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "area"
                    ],
                    "common_phrases": [
                        "injection site",
                        "surgical site"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный участок тела, где проводится или планируется медицинская процедура.",
                        "zh": "身体上进行或计划进行医疗操作的特定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "укола или операции"
                            },
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "поверхности тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部位",
                                "target_lang_sense_clarification": "身体上的特定区域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37476344-8af9-3f17-92c8-78da80da8c39",
                    "sense_definition": "To place or build something in a particular location.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The council decided to <w>site</w> the new library in the town center.",
                            "target_lang_translations": {
                                "ru": "Совет решил <w>разместить</w> новую библиотеку в центре города.",
                                "zh": "委员会决定将新图书馆<w>选址</w>在市中心。"
                            }
                        },
                        {
                            "text": "The hotel is <w>sited</w> on a cliff with a spectacular view of the ocean.",
                            "target_lang_translations": {
                                "ru": "Отель <w>расположен</w> на утесе с захватывающим видом на океан.",
                                "zh": "这家酒店<w>坐落</w>在悬崖上，拥有壮观的海景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "locate",
                        "situate",
                        "position",
                        "place"
                    ],
                    "common_phrases": [
                        "be sited",
                        "site a building"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размещать или строить что-либо в определенном месте.",
                        "zh": "将某物放置或建造在特定位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать",
                                "target_lang_sense_clarification": "размещать в пространстве"
                            },
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "устанавливать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选址",
                                "target_lang_sense_clarification": "确定建筑位置"
                            },
                            {
                                "target_lang_word": "安置",
                                "target_lang_sense_clarification": "放置在某处"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}