                                                "sense_id": "23cd4545-7cc5-3df1-a371-2444c325e4b9",
                                                "text": "Ich finde diese Frau einfach unattraktiv."
                                            },
                                            {
                                                "example_id": "6f295a68-a82b-4873-ac65-1e2bcae6ae42",
                                                "sense_id": "23cd4545-7cc5-3df1-a371-2444c325e4b9",
