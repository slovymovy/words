                        "source_entry_id": "39b6fe87-d330-3584-a826-54846ca9db68",
                        "source_sense_description": "a preoccupation with sensual pleasure",
                        "target_lang_word": "zmysłowość",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zmysłowość",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "615e3ca0-6870-38c5-804a-c0a2d2036ca8",
                                        "entry_id": "cd5ecbb5-b152-3ee0-9098-02b0a598bed4",
                                        "glosses": [
                                            "cecha tego, co zmysłowe, erotyczne, ponętne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01d2235-11e7-4dcc-952b-8ce78c0dcb42",
                                                "sense_id": "615e3ca0-6870-38c5-804a-c0a2d2036ca8",
                                                "text": "Seks bez zmysłowości jest wulgarny, ona to bowiem dodaje mu pieprzyku, tajemniczości"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "732541b1-a335-3e54-9971-0d5e566ed44c",
                                        "entry_id": "cd5ecbb5-b152-3ee0-9098-02b0a598bed4",
                                        "glosses": [
                                            "cecha tego, co odnosi się do zmysłów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c65e3e-df36-415f-80fb-628f10ddd086",
                                                "sense_id": "732541b1-a335-3e54-9971-0d5e566ed44c",
                                                "text": "Władza poznawania objawia się w nas, jako postrzegająca albo jako myśląca: w pierwszym razie nazywa się zmysłowością, a w drugim razie rozumem. Zmysłowość jest władzą bierną i mimowolną, a rozum władzą czynną i samodzielną; obie zaś te władze podlegają odmiennym, właściwym sobie prawom"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77c4fd9e-3e4b-41ae-a14a-f39ea7ae2fad",
                        "source_entry_id": "39b6fe87-d330-3584-a826-54846ca9db68",
                        "source_sense_description": "a preoccupation with sensual pleasure",
                        "target_lang_word": "сладостра́стие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сладостра́стие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dcdc44c4-4759-394b-a83e-78a7f63dc325",
                                        "entry_id": "be1ffb7c-a37a-349e-8056-670d4c4af714",
                                        "glosses": [
                                            "повышенное стремление к удовлетворению полового чувства, чувственным наслаждениям; похоть, вожделение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1837f5-117c-42a3-bf8f-457fe6286e58",
                                                "sense_id": "dcdc44c4-4759-394b-a83e-78a7f63dc325",
                                                "text": "Соваль, адвокат парижского парламента, описывая «Любовные похождения королей французских», говорит, что век Франциска I был самый развращённый и что все произведения тогдашних поэтов и живописцев дышали сладострастием."
                                            },
                                            {
                                                "example_id": "a3a1a81a-8075-4ba9-91ee-50c4ee0f6250",
                                                "sense_id": "dcdc44c4-4759-394b-a83e-78a7f63dc325",
                                                "text": "Пред ним беспрерывно мелькали её сверкающие, упругие перси, нежная, прекрасная, вся обнажённая рука; самое платье, облипавшее вокруг её девственных и вместе мощных членов, дышало в мечтах его каким-то невыразимым сладострастием."
                                            },
                                            {
                                                "example_id": "747a12d1-2aa7-4224-a356-bed9ff7a55c2",
                                                "sense_id": "dcdc44c4-4759-394b-a83e-78a7f63dc325",
                                                "text": "Юрий обхватил её мягкий стан, приклонил к себе и поцеловал её в шею: девственные груди облились румянцем и заволновались, стараясь вырваться из-под упрямой одежды… о, сколько сладострастия дышало в её полураскрытых пурпуровых устах!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6884d150-539e-33ba-b89e-94c97e5caf9b",
                                        "entry_id": "be1ffb7c-a37a-349e-8056-670d4c4af714",
                                        "glosses": [
                                            "перен. большое удовольствие, наслаждение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb524b69-aea5-4807-8f7d-d8f30ae507f2",
                                                "sense_id": "6884d150-539e-33ba-b89e-94c97e5caf9b",
                                                "text": "Поверь, мой милый друг, страданье нужно нам, / Не испытав его, нельзя понять и счастья: / Живой источник сладострастья / Дарован в нём его сынам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
