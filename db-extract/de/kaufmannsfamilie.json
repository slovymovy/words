                "senses": [
                    {
                        "sense_id": "f71f9ed2-db30-3b64-9e8b-242f21e201f2",
                        "entry_id": "7c488acb-5dbe-3201-a290-e2e8a5aea289",
                        "glosses": [
                            "Familie, deren Mitglieder traditionell im Handel tätig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072daebd-9e2a-45f9-9fa1-3549273fa090",
                                "sense_id": "f71f9ed2-db30-3b64-9e8b-242f21e201f2",
                                "text": "„Ich komme aus einer Kaufmannsfamilie und war der Erste von uns, der studierte, aber dort an der Uni hätte ich ebenso gut unsichtbar sein können.“"
                            },
                            {
                                "example_id": "71523ac5-6bca-4d19-b17d-0109221288cb",
                                "sense_id": "f71f9ed2-db30-3b64-9e8b-242f21e201f2",
                                "text": "„Sie entstammte einer begüterten Kaufmannsfamilie und verfügte über Geld, Grundbesitz und eine weitverzweigte Verwandtschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
