                        ],
                        "form": "slaapzakje"
                    },
                    {
                        "form_id": "51231f17-f0d0-46a2-b3f8-1485698dd46d",
                        "entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "slaapzakjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                        "entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "glosses": [
                            "Een slaapzak wordt gevormd door een grote, doorstikte deken, die vaak door middel van een rits om het lichaam heen te sluiten is. In de dan gevormde zak kan men slapen, in plaats van onder een deken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41985092-160a-49e4-ab52-5c5552fc23ad",
                                "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                                "text": "Daar kroop ik, nog in de greep van de angst, mijn slaapzak in en rolde mezelf tot een kleine bal."
                            },
                            {
                                "example_id": "c966973a-1c55-41fc-b4be-b3c2b4013e1d",
                                "sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                                "text": "Voordat ik weer in slaap viel kreeg ik de gedachte aan zeven verschrompelde lijken in gesmolten slaapzakken niet uit mijn hoofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21007c9f-2066-4feb-bd45-dae32b1c8caa",
                        "source_entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "source_sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                        "target_lang_word": "Schlafsack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafsack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                        "entry_id": "bb7a1236-d9c2-39b7-a4e7-cb2312c1460e",
                                        "glosses": [
                                            "ein wärmedämmender, großer Beutel, in dem geschlafen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da9fadec-534b-471e-8a00-f024eca50df4",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "„Ich liege in Marcs Schlafsack auf dem Dach des Busses.“"
                                            },
                                            {
                                                "example_id": "de943f5c-72f4-47de-b98e-4890b2d7817a",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "Der Soldat hatte seinen Schlafsack vergessen, somit musste sein ganzer Zug Nachtwache schieben."
                                            },
                                            {
                                                "example_id": "f33356de-8786-45eb-9050-93cdc22230b6",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "„Im Moment liege ich jedoch im Schlafsack und schlottere vor Kälte.“"
                                            },
                                            {
                                                "example_id": "2a442ecb-2c91-4364-96b8-fa174f67f74b",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "„Gegen sechs Uhr morgens wachte ich auf und pellte mich aus dem Schlafsack.“"
                                            },
                                            {
                                                "example_id": "63ab6f6d-8886-4b21-b1c5-ca9fd416cc40",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "„Nach dem Essen verkroch ich mich wortlos im Schlafsack, schlief sofort ein.“"
                                            },
                                            {
                                                "example_id": "bf3ef66b-4531-4c2f-89a5-4c995ecdc864",
                                                "sense_id": "d8273073-4ad9-3816-b02e-090097d7c76c",
                                                "text": "„Um zwanzig nach elf stieg er aus, seinen Rucksack auf dem Rücken und den zusammengerollten Schlafsack unter dem Arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "389a87a2-262a-4bf3-95f2-445feccabcaf",
                        "source_entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "source_sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                        "target_lang_word": "sleeping bag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleeping bag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d378765a-1d03-3017-a82d-05398b3f9671",
                                        "entry_id": "dd9bbd39-3793-3599-a502-1f7e93dabfc2",
                                        "glosses": [
                                            "A padded or insulated bag large enough to surround the whole body and which keeps the user warm while sleeping, used as a substitute for bedclothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4d573b-922c-4af0-bd3c-72f456af9c2c",
                                                "sense_id": "d378765a-1d03-3017-a82d-05398b3f9671",
                                                "text": "All students attending the multi-day field trip should bring a sleeping bag suitable for camping in a tent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8529c08f-f9d8-4c08-b0aa-acfce8f21305",
                        "source_entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "source_sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                        "target_lang_word": "duvet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duvet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Ensemble des plumes courtes, molles et frisées, qui poussent en premier sur le corps des oiseaux et est particulièrement fournie chez les cygnes et les oies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ede1ef8-3af3-456f-9ee8-588ae2ff5871",
                                                "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                                "text": "Ces îlots, constitués de basalte, servent de repaires à des myriades d’eiders qui nichent dans les rochers. Ces oiseaux donnent le précieux duvet connu sous le nom d’édredon, et sont la principale ressource des habitants : la loi défend de les tuer."
                                            },
                                            {
                                                "example_id": "f27abff0-d2f8-4e2d-8971-866368070587",
                                                "sense_id": "dcd1bdaf-d0ea-3bcb-9492-86c117130dea",
                                                "text": "Ces petits moineaux ont encore leur duvet. — Un oreiller de duvet. — Un édredon de duvet de cygne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7160dcf5-6ab4-3e7a-a5d4-8096f0501a7b",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Poils courts de la toison de certains animaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab38508-05e9-47dc-95dd-625d4f150dcc",
                                                "sense_id": "7160dcf5-6ab4-3e7a-a5d4-8096f0501a7b",
                                                "text": "La toison se compose de poils longs et raides, de nature jarreuse en mèches souvent vrillées et d’un duvet extrêmement fin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Premier poil qui vient au menton et aux joues des jeunes gens."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7b63b2-6066-4601-97a7-3efa63fb1af7",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Un léger duvet qui faisait une ombre sur ses lèvres donnait à son visage une grâce irritante et fière."
                                            },
                                            {
                                                "example_id": "a66ed7f4-e4e4-4e5f-b7fc-febd19a6f885",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Un soldat me secoua pour me réveiller. Je compris vaguement que le duvet qui couvrait ses joues n’avait probablement jamais été rasé. Il n’avait guère plus de seize ans."
                                            },
                                            {
                                                "example_id": "8e317d5d-9bc2-46d8-a86f-5c4896558879",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "Après tout, le duvet apparent sur ses joues ou ses rides lorsqu’elle fronce les sourcils parle pour le personnage: le rendu est plus réaliste que la vision du précédent jeu."
                                            },
                                            {
                                                "example_id": "e6550273-a4a0-4474-a7b0-506d132f1a84",
                                                "sense_id": "8f6d96d4-f5c9-3f23-8054-3df9627bc79b",
                                                "text": "— Il avait les cheveux coupés à ras comme à l'armée quand on vous ratiboisait tout, et on avait laissé un duvet plus sombre sur le sommet de son crâne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1fb979-e461-3a3b-99a6-413849a2a47a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Poils fins et courts qui recouvrent certaines parties du corps."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f7cc4a-018f-43be-9e81-d36a085513c4",
                                                "sense_id": "1d1fb979-e461-3a3b-99a6-413849a2a47a",
                                                "text": "Ses yeux bruns étaient bordés de noir ou plutôt meurtris ; sa lèvre supérieure était ornée d’un duvet brun qui dessinait une espèce de fumée ; elle avait les lèvres menues, et son front impérieux était rehaussé par une chevelure jadis noire, mais qui tournait au chinchilla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Espèce de coton qui vient sur certains fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd53d8b-4982-4d3d-91d2-58d9fce3abf8",
                                                "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                                "text": "Le vent, qui écoutait nos paroles, les fera chanter encore par les chemins ensoleillés ; les groseilles que mes lèvres prenaient sur ta main, mûriront gaîment à côté des noisettes et les abricots pâles, au duvet d’argent, deviendront chaque jour plus vermeils."
                                            },
                                            {
                                                "example_id": "f8958a60-e014-49b0-83aa-3a4d933f3174",
                                                "sense_id": "33fb4bb6-dc3f-3d96-bf2f-b31a2256337a",
                                                "text": "Les pêches, les coings sont couverts d’un duvet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cda8ee3-0eac-3005-97f9-830e74e9b1e9",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Sac de couchage."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcdada44-a520-4825-9dad-2ef6131fd9bf",
                                                "sense_id": "0cda8ee3-0eac-3005-97f9-830e74e9b1e9",
                                                "text": "Où ranger son duvet sur le sac à dos ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d0fcaf5-6f2e-359d-8b06-67e479a525af",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Couette épaisse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f64e25f-51f1-3665-b212-a1cf799d4b6a",
                                        "entry_id": "5a706154-f8e3-3038-b95e-69cd951f688b",
                                        "glosses": [
                                            "Légère couche d'un matériau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc668ea-6ff3-4551-a926-32054f2a1731",
                                                "sense_id": "5f64e25f-51f1-3665-b212-a1cf799d4b6a",
                                                "text": "Le château de Vaux-le-Vicomte était recouvert ce dimanche matin d'un léger duvet neigeux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cac6bdc6-d3e8-4588-b878-8e44ba79dff0",
                        "source_entry_id": "99acdb2b-bcde-301d-969b-cc946932f43b",
                        "source_sense_id": "bb4df199-8af1-3fa6-a489-ea94a8818a79",
                        "target_lang_word": "sac de couchage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sac de couchage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ae89da9-2426-3a93-86a5-95b832b8ee9d",
                                        "entry_id": "562b45bf-96cc-3962-ac23-35df445370ad",
                                        "glosses": [
                                            "Grand sac garni de duvet dans lequel on se glisse pour dormir et pour lutter contre les intempéries et le froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1705acf4-9203-4048-907d-c250b4512753",
                                                "sense_id": "1ae89da9-2426-3a93-86a5-95b832b8ee9d",
                                                "text": "Non. Elle est partie se réfugier dans ton sac de couchage."
                                            },
                                            {
                                                "example_id": "f88fd8a8-ce4d-4c57-a927-b50a22ec3556",
                                                "sense_id": "1ae89da9-2426-3a93-86a5-95b832b8ee9d",
                                                "text": "«On a des équipes qui repassent dans chacune des chambres. Elles s'assurent que tous les sacs de couchage qui ont été prêtés à la clientèle retournent en quarantaine», précise Sandra Nadeau du Groupe Calypso Valcartier."
                                            },
                                            {
                                                "example_id": "f6afb3d3-71e8-4e0d-8845-7f283539b5ff",
                                                "sense_id": "1ae89da9-2426-3a93-86a5-95b832b8ee9d",
                                                "text": "Le principe du sac de couchage consiste à emprisonner dans son enveloppe une quantité importante d’air qui va jouer un rôle d’isolant, permettant au corps de conserver sa chaleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
