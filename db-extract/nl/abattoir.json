                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9fa556e-3c0d-34b3-bd33-ce1bd26e30b1",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Lieu de mort brutale, de boucherie, de massacre systématique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1329bf3-f54a-4111-a8a3-79ec551d1a44",
                                                "sense_id": "c9fa556e-3c0d-34b3-bd33-ce1bd26e30b1",
                                                "text": "La guerre de 1914 vit une faillite générale des consciences. Les propagandistes du pacifisme et de l’anti-militarisme se firent ultra-patriotes et la masse qui les avait suivis les suivit encore, jusqu’à l’abattoir !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
