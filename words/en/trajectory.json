{
    "word_family": [
        "traject"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "529d49a8-b54b-34fa-87c9-fb2938e4a6ba",
                    "sense_definition": "The curved path that an object follows as it moves through space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper watched the ball's <w>trajectory</w> as it soared toward the top corner of the net.",
                            "target_lang_translations": {
                                "zh": "守门员注视着足球飞向球门死角的<w>轨迹</w>。"
                            }
                        },
                        {
                            "text": "Engineers calculated the <w>trajectory</w> of the rocket to ensure it would reach the correct orbit.",
                            "target_lang_translations": {
                                "zh": "工程师计算了火箭的<w>弹道</w>，以确保它能进入预定轨道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "path",
                        "flight-path",
                        "course"
                    ],
                    "common_phrases": [
                        "flight trajectory",
                        "curved trajectory"
                    ],
                    "target_lang_definitions": {
                        "zh": "物体在空间中运动时所经过的曲线路径。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轨迹",
                                "target_lang_sense_clarification": "指物体运动时留下的路径，常用于物理或数学语境。"
                            },
                            {
                                "target_lang_word": "弹道",
                                "target_lang_sense_clarification": "特指抛射体（如炮弹、火箭）在空中飞行的路径。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3a12a36-c638-3c1f-8099-1907f32107de",
                    "sense_definition": "The general direction or course of development of a person, organization, or process over time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's growth <w>trajectory</w> has been impressive since they launched their new product line.",
                            "target_lang_translations": {
                                "zh": "自推出新产品系列以来，该公司的增长<w>轨迹</w>令人印象深刻。"
                            }
                        },
                        {
                            "text": "His career <w>trajectory</w> changed significantly after he decided to pursue a degree in medicine.",
                            "target_lang_translations": {
                                "zh": "在他决定攻读医学学位后，他的职业<w>发展轨迹</w>发生了重大改变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "progression",
                        "development",
                        "course"
                    ],
                    "common_phrases": [
                        "career trajectory",
                        "growth trajectory"
                    ],
                    "target_lang_definitions": {
                        "zh": "人、组织或过程随时间发展的总体方向或进程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发展轨迹",
                                "target_lang_sense_clarification": "指事物或人随时间演变的历程。"
                            },
                            {
                                "target_lang_word": "走向",
                                "target_lang_sense_clarification": "指事物发展的趋势或方向。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}