                        ],
                        "examples": [
                            {
                                "example_id": "0ce14a3e-8279-48e3-85a8-a278364b4c57",
                                "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                                "text": "„Urlaub mit Kindern ist wie ein Rieseneis mit extra Sahne: Klingt erst mal super – und dann ist es einem doch zu viel.“"
                            },
                            {
                                "example_id": "ce65b5f2-adb8-44d2-85d8-9b2e96f8a445",
                                "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                                "text": "„Die Ermittler wurden misstrauisch. Sie nahmen das Rieseneis mit zur Wache, um zu klären, woher es stammt.“"
                            },
                            {
                                "example_id": "973d72cc-ac75-4e08-bdbe-cc10d20e8e6b",
                                "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                                "text": "„Primeln auf den Balkon pflanzen, ein Rieseneis schlecken, Grill anwerfen.“"
                            },
                            {
                                "example_id": "846296f0-c101-4561-95b9-a3fda4c64706",
                                "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                                "text": "„Später wurde das auffällige Rieseneis auf dem Balkon eines Hauses in der Gemeinde gesehen.“"
                            },
                            {
                                "example_id": "d0867e93-01a2-4512-b98b-03c6056a5144",
                                "sense_id": "3bbc9cb4-df40-357d-8467-03089f361c9c",
                                "text": "„Das Rieseneis war 3,08 Meter hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
