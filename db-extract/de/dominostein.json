                "senses": [
                    {
                        "sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                        "entry_id": "86900b27-89fc-3c81-a452-5b3a86416955",
                        "glosses": [
                            "Spielstein des Spiels Domino"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72ec6fa-16b6-4d56-a3e2-21761566bcfd",
                                "sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                                "text": "Ein Dominostein fehlt bei diesem Spiel."
                            },
                            {
                                "example_id": "ef93e27a-5256-4832-b908-40e7d60307d7",
                                "sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                                "text": "„Es stimmte nicht mit dem Dominostein überein.“"
                            },
                            {
                                "example_id": "bd9a4ca3-ce98-46a3-b134-9574c0dcba19",
                                "sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                                "text": "„Vor ihm stand der Zettelkasten, eine blaue Holzdose, in der wir früher unsere Dominosteine aufbewahrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32b588f9-dd1e-3d6e-8deb-01ad861e777d",
                        "entry_id": "86900b27-89fc-3c81-a452-5b3a86416955",
                        "glosses": [
                            "Marzipan enthaltende, würfelförmige Weihnachtssüßigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ab0c84-cf2b-4f1c-b011-474821f762cc",
                                "sense_id": "32b588f9-dd1e-3d6e-8deb-01ad861e777d",
                                "text": "Dominosteine esse ich sehr gerne."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d48cc13-1a06-4976-8751-42be6b5d1e19",
                        "source_entry_id": "86900b27-89fc-3c81-a452-5b3a86416955",
                        "source_sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                        "source_sense_description": "Spielstein des Spiels Domino",
                        "target_lang_word": "domino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "940a5d83-12d7-3b25-8b7b-1b6ed223ef4a",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A tile divided into two squares, each having 0 to 6 (or sometimes more) dots or pips (as in dice), used in the game of dominoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10923e61-671d-4b8b-bad7-f89ad17894e5",
                                                "sense_id": "940a5d83-12d7-3b25-8b7b-1b6ed223ef4a",
                                                "text": "Dominoes of indiscretions down\nFalling all around, in cycles, in circles\nConstantly consuming\nConquer and devour"
                                            },
                                            {
                                                "example_id": "dc949b9c-3af7-41ba-8b8e-78d1a6049f2b",
                                                "sense_id": "940a5d83-12d7-3b25-8b7b-1b6ed223ef4a",
                                                "text": "The Mormon church's past anti-gay positions and its role in financing Proposition 8 – California's 2008 ban on same-sex marriage – may have been the first dominoes to fall around the faithful, but vetting Mitt Romney as a presidential candidate links the straightforward similarities between Mormonophobia and homophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5878ef14-6792-3b37-9945-998d8206630a",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A country that is expected to react to events in a neighboring country, according to the domino effect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a0a1f50-7822-32ce-9aad-60107e509a5c",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A masquerade costume consisting of a hooded robe and a mask covering the upper part of the face."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5573f6-796e-46d5-a38e-2a6ae1892ae4",
                                                "sense_id": "2a0a1f50-7822-32ce-9aad-60107e509a5c",
                                                "text": "all the women were desirous of having the bundle immediately opened; which operation was at length performed by little Betsy, with the consent of Mr Jones: and the contents were found to be a domino, a mask, and a masquerade ticket."
                                            },
                                            {
                                                "example_id": "b3e59dc2-cd2c-42e9-b340-2f5bf7a1ea08",
                                                "sense_id": "2a0a1f50-7822-32ce-9aad-60107e509a5c",
                                                "text": "The chair being announced, she fastened on her mask, and drew her domino round her, it not being her intention to display her splendid and fantastic costume till supper, when all the guests were expected to unmask."
                                            },
                                            {
                                                "example_id": "f8f189fa-f975-4eb0-910e-825c676e944b",
                                                "sense_id": "2a0a1f50-7822-32ce-9aad-60107e509a5c",
                                                "text": "For this scene, a large number of supers are engaged, and in order to further swell the crowd, practically all the available stage hands have to ‘walk on’ dressed in various coloured dominoes, and all wearing masks."
                                            },
                                            {
                                                "example_id": "fff81880-c4ff-4fb5-b097-67074cb01c4e",
                                                "sense_id": "2a0a1f50-7822-32ce-9aad-60107e509a5c",
                                                "text": "Then he hunted for the black carnival domino, supposing that it was the appropriate thing for a penitent to wear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784f5f25-92ba-35df-bba7-53d4b2dfde06",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "The mask itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c0fca2-82f3-453d-b12d-65bf7e1a00a0",
                                                "sense_id": "784f5f25-92ba-35df-bba7-53d4b2dfde06",
                                                "text": "He wore a domino, but beneath it could be seen his whiskers, cut after the English fashion, and long and pendent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc6ba9f-7e33-3156-b010-3771bff6a454",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "The person wearing the costume."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b12d11f8-3cca-335a-b570-f8c3ca3834fb",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A polyomino made up of two squares."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed639304-0b64-3ad6-81bd-fb14bc5ea995",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A mistake in performing."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220d37e7-f92d-4c2f-82ed-d6ea770f0527",
                                                "sense_id": "ed639304-0b64-3ad6-81bd-fb14bc5ea995",
                                                "text": "Any player is liable to make a 'domino' — that is to say, he goes wool-gathering and continues to play when everyone else has stopped. If he does so at a grown-up concert the fault is irredeemable […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2149b70-1347-3249-adb3-c597ee4dab7c",
                                        "entry_id": "b2c72e2e-e7bb-3ff9-ab58-151068dce251",
                                        "glosses": [
                                            "A person's teeth."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1991546a-5e5c-4a43-8f44-60e3cbc6673b",
                                                "sense_id": "d2149b70-1347-3249-adb3-c597ee4dab7c",
                                                "text": "[…] break your dominoes by grinding them that way."
                                            },
                                            {
                                                "example_id": "9968356b-9694-42eb-8057-4511634102f1",
                                                "sense_id": "d2149b70-1347-3249-adb3-c597ee4dab7c",
                                                "text": "Look here, you chaps, don't you chew it too quick, or you'll break your dominoes on the nails!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "domino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6dc6c27-3884-363c-9472-5db763bdb617",
                                        "entry_id": "82902196-bfc4-38df-b785-fb40ec3838f4",
                                        "glosses": [
                                            "To collapse in the manner of dominoes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0d5037c-91d9-4714-b930-9c61bfd62f50",
                                                "sense_id": "a6dc6c27-3884-363c-9472-5db763bdb617",
                                                "text": "A dismasting often means the dominoing of one mast into the other, down through the decks, cannoning the cargo through the hull below, and sinking the ship very quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b875e999-41f7-3b78-8c0b-11ba9342930b",
                                        "entry_id": "82902196-bfc4-38df-b785-fb40ec3838f4",
                                        "glosses": [
                                            "To cause to collapse in the manner of dominoes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ed78ddf-7ce0-4f91-a607-132eb7fe9bc8",
                        "source_entry_id": "86900b27-89fc-3c81-a452-5b3a86416955",
                        "source_sense_id": "21b9e266-fe60-30c9-b589-f3eab3eb8eca",
                        "source_sense_description": "Spielstein des Spiels Domino",
                        "target_lang_word": "domino",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domino",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "880dfb00-c1b9-31bc-852b-e60f1ab512c9",
                                        "entry_id": "71c0303c-aa05-3a81-b98f-214c7449d3a9",
                                        "glosses": [
                                            "Camail que portaient les ecclésiastiques aux offices, pendant l’hiver."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                        "entry_id": "71c0303c-aa05-3a81-b98f-214c7449d3a9",
                                        "glosses": [
                                            "Habillement ou costume de bal masqué, composé d’une robe ouverte, descendant jusqu’aux talons, et d’une espèce de capuchon ou camail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23faacac-a492-4d70-8acb-078995557796",
                                                "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                                "text": "La dernière venue, une blonde en domino blanc, ne lui avait rien dit encore, mais elle n’avait pas quitté la place, pendant qu’il se demandait, en examinant le troubadour mélancolique : […] ?"
                                            },
                                            {
                                                "example_id": "d79bee7f-a6fa-4847-a395-2b34a6d8a865",
                                                "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                                "text": "Quelques femmes, mettant sur leur visage un voile ou un masque de velours noir pour se préserver de l’air que n’arrêtaient pas les rideaux de leurs carrosses (car ils n’avaient point de glaces encore), semblaient porter le costume que nous appelons domino."
                                            },
                                            {
                                                "example_id": "bef682bc-a33e-4330-a2c1-0a943b6df866",
                                                "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                                "text": "C’est d’abord une espèce de géant qui rit d’un accent germanique sous sa « tête », tandis qu’il étudie, de ses mains énormes et laiteuses, un masque d’apparence plus aimable, une soubrette, qui, ayant quitté son domino, le porte roulé sur un bras et demeure là en ce galant déshabillé d’estampe. Elle a gardé du fil de fer sur la figure, mais ses épaules sont nues, blanches au demeurant et ornées d’un large collier d’or vert, de perles, d’opales."
                                            },
                                            {
                                                "example_id": "92c71117-022e-4722-aba3-7772dcd00233",
                                                "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                                "text": "— Je dînerai ce soir chez ma mère, dit d’une voix indifférente madame, qui fougueusement, court aussitôt s’acheter un domino rose.\n— J’irai donc au cercle, dit monsieur, qui court aussitôt s’acheter un domino bleu."
                                            },
                                            {
                                                "example_id": "9b903e9b-705b-4598-b3ee-ba0ddc374f60",
                                                "sense_id": "fad46103-1be2-39bb-b5d2-73f0536d83ee",
                                                "text": "Gustave III, bon connaisseur en art et en plaisir, qui, où qu’il aille, va vers le bal masqué de l’Opéra de Stockholm où il s’effondrera, frappé au ventre à travers son domino par le coup de feu d’Anckarström et soutenu par son favori von Essen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b62bce-b2fb-3832-aa48-9310e96c2ef5",
                                        "entry_id": "71c0303c-aa05-3a81-b98f-214c7449d3a9",
                                        "glosses": [
                                            "Personne en domino."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c8d5e26-8c4b-4e13-b708-9c5f497c8347",
                                                "sense_id": "f0b62bce-b2fb-3832-aa48-9310e96c2ef5",
                                                "text": "– Merci, monsieur, je n’y tiens pas, répond le domino blanc."
                                            },
                                            {
                                                "example_id": "f4770bba-6012-419f-be12-6e1d867acc48",
                                                "sense_id": "f0b62bce-b2fb-3832-aa48-9310e96c2ef5",
                                                "text": "Un domino noir passa, qui lui serra rapidement le bout des doigts. Il comprit que c’était elle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "domino",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2d201d-c41b-3bbf-91b5-c822039c13d1",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Jeu de société constitué de 28 pièces à deux parties. Chaque partie contient un nombre de points et peut être combinée à une partie d’un autre domino."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bdebfd-54f0-41cb-bb0e-7d129de4890a",
                                                "sense_id": "8f2d201d-c41b-3bbf-91b5-c822039c13d1",
                                                "text": "Apportez-nous un domino."
                                            },
                                            {
                                                "example_id": "2c776c26-60a1-456d-b8f8-3239aa3af1ec",
                                                "sense_id": "8f2d201d-c41b-3bbf-91b5-c822039c13d1",
                                                "text": "Jouer aux dominos."
                                            },
                                            {
                                                "example_id": "27679c5a-7566-4e77-b14e-9e3b6e9ef0e6",
                                                "sense_id": "8f2d201d-c41b-3bbf-91b5-c822039c13d1",
                                                "text": "Elle était accroupie au milieu de la paille, si bien qu’on en voyait à peine sortir ses deux genoux, sur lesquels elle jouait aux dominos toute seule. Elle nous regarda un moment, trembla longtemps, me sourit un peu, et se remit à jouer. Il me parut qu’elle s’appliquait à comprendre comment sa main droite battrait sa main gauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c092b5-ce27-3f9a-9dcf-407c1a89e3b7",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Jeu de société constitué de 28 pièces à deux parties. Chaque partie contient un nombre de points et peut être combinée à une partie d’un autre domino.",
                                            "Chacune des pièces de ce jeu ou réunion de ces pièces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2461159b-7809-4a8c-b99a-043ec43733b4",
                                                "sense_id": "78c092b5-ce27-3f9a-9dcf-407c1a89e3b7",
                                                "text": "Le mah-jong est un jeu traditionnel de dominos (et d'argent !) qui se joue à quatre avec des pièces sur lesquelles sont gravés des caractères. Le jeu se compose de 144 tuiles spéciales réparties en 6 catégories : […]."
                                            },
                                            {
                                                "example_id": "cb2cd93e-d62a-4615-8f8a-f02e12e264d1",
                                                "sense_id": "78c092b5-ce27-3f9a-9dcf-407c1a89e3b7",
                                                "text": "Les points de ce domino sont effacés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2a7fd3-5f2b-304e-8a6d-5cb85cab57b9",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Jeu de société constitué de 28 pièces à deux parties. Chaque partie contient un nombre de points et peut être combinée à une partie d’un autre domino.",
                                            "Jeu utilisant des pièces de forme similaire à celle des dominos (1), mais consistant à les disposer verticalement à proximité les uns des autres, puis à faire tomber le premier dont la chute entraînera celle de tous les autres, par propagation successive d’un élément à l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d192c6d-673e-455e-afbd-cda632d8d116",
                                                "sense_id": "9b2a7fd3-5f2b-304e-8a6d-5cb85cab57b9",
                                                "text": "Effet domino."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1711cf3f-2112-3762-9350-d3132ad89c46",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Sucre électrique, pièce cubique ou parallélépipédique servant à relier des conducteurs électriques, serre-fils."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4725ae81-550a-318a-bb56-dc2dd6d048af",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Manière de désigner un couple dont l'une des deux personnes est noire et l'autre blanche."
                                        ],
                                        "tags": [
                                            "Antilles"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90caa5d0-0cc6-33e7-8bfd-45667c83928b",
                                        "entry_id": "c5120dea-85c0-3a88-ba63-06194cd4acfc",
                                        "glosses": [
                                            "Dent."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39fcf6a7-36d3-46d2-a985-06a9a6a46cca",
                                                "sense_id": "90caa5d0-0cc6-33e7-8bfd-45667c83928b",
                                                "text": "« Est-il bête, avec tout son esprit, ce mâtin-là ! » se disait-il parfois en découvrant silencieusement dans un rire muet les trente-deux « dominos » de sa mâchoire."
                                            }
                                        ]
                                    }
                                ]
                            },
