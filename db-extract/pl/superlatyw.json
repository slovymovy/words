                "translations": [
                    {
                        "translation_id": "ea48304e-94a0-4fbb-af6c-a4194dfa5bd7",
                        "source_entry_id": "bde55159-8b21-3320-8199-08b1bad6714d",
                        "source_sense_id": "7ccead39-3762-37be-ab80-3dbb37c95f18",
                        "target_lang_word": "superlative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superlative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44498ac1-619c-3408-bbe5-4791883fe1d0",
                                        "entry_id": "45fe3231-acb1-3d19-bd0f-a8f99b9466c1",
                                        "glosses": [
                                            "Having the power to carry something or someone above, over or beyond others."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe02341f-89ea-3058-bed5-a7b090eb6836",
                                        "entry_id": "45fe3231-acb1-3d19-bd0f-a8f99b9466c1",
                                        "glosses": [
                                            "Exceptionally good; of the highest quality."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53496d8c-d324-43b5-bc04-937cac439cf6",
                                                "sense_id": "fe02341f-89ea-3058-bed5-a7b090eb6836",
                                                "text": "The Governor-General was entertaining at a civil banquet in the evening. He is reported as having made a “superlative speech, congratulating the Victorians on their loyalty; […].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b9d37f-9fe1-305c-ab13-04e4c4e903bf",
                                        "entry_id": "45fe3231-acb1-3d19-bd0f-a8f99b9466c1",
                                        "glosses": [
                                            "Of or relating to the superlative degree (a degree of comparison of adjectives and adverbs)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "superlative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aca81b50-12f3-389b-aad3-106f8645e8e9",
                                        "entry_id": "1a46c91f-2ec0-3577-99e9-2f43cf03b4b8",
                                        "glosses": [
                                            "The extreme (e.g. highest, lowest, deepest, farthest, etc) extent or degree of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1d08db-197c-4313-b9a1-f0965406833b",
                                                "sense_id": "aca81b50-12f3-389b-aad3-106f8645e8e9",
                                                "text": "A twist is accordingly something especially good, and a big twist is the superlative of excellence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cdaa57-856e-3fc2-9d58-962631bcd5c3",
                                        "entry_id": "1a46c91f-2ec0-3577-99e9-2f43cf03b4b8",
                                        "glosses": [
                                            "The degree of comparison of an adjective or adverb used when comparing three or more entities in terms of a certain property or a certain way of doing something. In English, the superlative of superiority is formed by adding the suffix -est or the word most (e.g. tiniest, most fully); the superlative of inferiority, by adding the word least (e.g. least big, least fully)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd477c8a-691e-3166-9867-2419f5b6111a",
                                        "entry_id": "1a46c91f-2ec0-3577-99e9-2f43cf03b4b8",
                                        "glosses": [
                                            "An adjective or adverb in the superlative degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d04f580-def4-4b4c-b128-7e8e84faa639",
                                                "sense_id": "dd477c8a-691e-3166-9867-2419f5b6111a",
                                                "text": "Daniel is amazing, wonderful, fantastic, and many other superlatives I can’t think of right now!"
                                            },
                                            {
                                                "example_id": "c831b266-efcc-4492-91de-11218932822d",
                                                "sense_id": "dd477c8a-691e-3166-9867-2419f5b6111a",
                                                "text": "Sometimes it feels like there are no more superlatives left. Seriously, what else can be said about this little guy with the No 10 shirt and magic in his feet other than to ask, perhaps, whether there is anyone who wants to persist with the argument that Pelé, or Diego Maradona, or any of the others, have ever played this sport any better?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dfbdfe3-1b60-4dee-a972-346f214c7d18",
                        "source_entry_id": "bde55159-8b21-3320-8199-08b1bad6714d",
                        "source_sense_id": "7ccead39-3762-37be-ab80-3dbb37c95f18",
