                                        "glosses": [
                                            "ein Einwohner, Bewohner der Stadt Köln, eine in Köln geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d161594-0a5f-4bd8-928a-e553d0c72a01",
                                                "sense_id": "fa08a989-643a-3982-8f50-98ec8a0a4ea9",
                                                "text": "Er ist ein Kölner, ist schwarzhaarig und hat breite Schultern."
                                            },
                                            {
                                                "example_id": "712809b9-05f9-4c8f-af6b-f8213964af1a",
                                                "sense_id": "fa08a989-643a-3982-8f50-98ec8a0a4ea9",
                                                "text": "„Der Kölner nickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kölner",
