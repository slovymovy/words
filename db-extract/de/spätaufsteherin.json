                                        "glosses": [
                                            "Someone who gets up late in the morning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f130937d-05f3-42c4-bbde-b3f09c693dcb",
                                                "sense_id": "47cd5984-83ac-3b11-9f7e-58943036e2b1",
                                                "text": "One oddity of the Scottish Region timetable is that the special page (52) devoted to the \"Midday Scot\" shows, among other meal prices, that of breakfast, on trains beginning their journeys at 1.30 p.m. Some Scots (or Sassenachs) would appear to be late risers!"
                                            }
                                        ]
