                        "form": "das Brennholz"
                    },
                    {
                        "form_id": "941f3a98-311f-442a-9a77-ef918dfcbef9",
                        "entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                        "tags": [
                            "accusative",
