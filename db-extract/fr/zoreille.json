                        "glosses": [
                            "Français de la métropole résidant à la Réunion, aux Antilles (Martinique, Guadeloupe), en Guyane, etc."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8c0df5d4-0b5d-4900-9aa9-49ca9a08dedf",
                                "sense_id": "f6f10826-5b7c-3b19-acb4-cd82e6455a0b",
                                "text": "Le peuple appelle un métropolitain un zoreille, sans doute à cause de son teint rose."
                            },
                            {
                                "example_id": "550d116a-5b42-421a-8cb1-9d5043165e92",
                                "sense_id": "f6f10826-5b7c-3b19-acb4-cd82e6455a0b",
                                "text": "Bonjour, je ne suis pas originaire de la Martinique ! Je suis une zoreille ! Mon mari est un zoreille aussi mais il est en Martinique depuis l’âge de 8 ans."
                            }
                        ]
