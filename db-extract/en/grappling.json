                ],
                "translations": [
                    {
                        "translation_id": "f3686a04-cd5b-451d-827f-642e22f7e336",
                        "source_entry_id": "3224ce85-d04e-3cc0-9de3-1e011932a336",
                        "source_sense_description": "act in which something is grappled",
                        "target_lang_word": "grijpen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grijpen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5ffa1057-e5f7-3898-aded-732d48958e98",
                                        "entry_id": "61a0adaa-d810-39ca-8a14-320b376cb1f3",
                                        "glosses": [
                                            "plotseling iets of iemand beetpakken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbd8be6e-6523-4e77-9399-f0d4eb50a368",
                                                "sense_id": "5ffa1057-e5f7-3898-aded-732d48958e98",
                                                "text": "Hij wist snel de peuter te grijpen voor deze in de kolkende rivier viel."
                                            },
                                            {
                                                "example_id": "b9f00b21-dc70-4c2a-9169-c6d358a7c085",
                                                "sense_id": "5ffa1057-e5f7-3898-aded-732d48958e98",
                                                "text": "Terwijl de jonge assistent de gegevens van zijn Franse identiteitskaart invoerde, had ik de neiging om zijn ID te grijpen en te fotograferen, alsof zijn administratieve nummers met het verlaten van de Camino ineens belangrijker voor me Zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4e3e91-d4a4-3992-a3a7-a518e4263132",
                                        "entry_id": "61a0adaa-d810-39ca-8a14-320b376cb1f3",
                                        "glosses": [
                                            "met kracht iets pakken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ee26da-8ee6-4319-988b-ebe7e0289e7c",
                                                "sense_id": "8c4e3e91-d4a4-3992-a3a7-a518e4263132",
                                                "text": "Gehaast stap ik uit de cabine, waarbij ik uitglijd en me nog net weet vast te grijpen aan de wasbak."
                                            },
                                            {
                                                "example_id": "a8f1f1c8-99f8-4def-b3c5-a68be6d03bf4",
                                                "sense_id": "8c4e3e91-d4a4-3992-a3a7-a518e4263132",
                                                "text": "Op 14 juli 2014 demarreert Nibali op drie kilometer voor de top. De Siciliaan grijpt de leiderstrui en staat die niet meer af."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3bb603d-e8d6-3e44-8cd4-7bff60bcb64e",
                                        "entry_id": "61a0adaa-d810-39ca-8a14-320b376cb1f3",
                                        "glosses": [
                                            "emotioneel ergens door geraakt worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47c4253d-8956-46cf-b5ec-e9d50f5b805b",
                                                "sense_id": "d3bb603d-e8d6-3e44-8cd4-7bff60bcb64e",
                                                "text": "Ik vond het verbijsterend om te horen hoeveel indruk de trail destijds op deze man had gemaakt. Zou ik over 35 jaar ook nog zo gegrepen zijn door deze ervaring?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6554fd17-e142-3173-b50a-02e690a2f3bf",
                                        "entry_id": "61a0adaa-d810-39ca-8a14-320b376cb1f3",
                                        "glosses": [
                                            "naast grijpen: iets missen, iets niet te pakken kunnen krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e17a19bc-233d-453d-8ccd-3221615d51ba",
                                                "sense_id": "6554fd17-e142-3173-b50a-02e690a2f3bf",
                                                "text": "Zij grijpen dus naast de 1.000 euro tegemoetkoming en moeten wachten tot een volgende ronde. Het loket gaat op 1 september en 1 november opnieuw open. Degenen die zich wel hebben kunnen aanmelden, krijgen binnen enkele dagen hierover een bericht."
                                            }
                                        ]
                                    }
                                ]
                            },
