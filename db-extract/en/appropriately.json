                        "entry_id": "6a531df5-efcc-3f8d-bf23-6263ab4437c8",
                        "glosses": [
                            "In an appropriate manner; properly; suitably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e65920-1fab-40ca-b2c8-77627b3a45b0",
                                "sense_id": "50106758-7452-38c7-822d-74c344511668",
                                "text": "He closes the foreword by acknowledging that his proposals would have far-reaching impacts on railway staff, communities and industry - and passes the buck onto government to ensure that these consequences are managed appropriately."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027a354a-e790-4ab8-8eaf-4e04b899b6b3",
                        "source_entry_id": "6a531df5-efcc-3f8d-bf23-6263ab4437c8",
                        "source_sense_id": "50106758-7452-38c7-822d-74c344511668",
                        "source_sense_description": "in an appropriate manner",
