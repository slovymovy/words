                    {
                        "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                        "entry_id": "00e39b04-9aaf-33ca-9e46-291d965662f5",
                        "glosses": [
                            "Celui qui bouquine."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9e3620-2d71-4940-8c3c-2962dd759f87",
                                "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                                "text": "C’est un bouquineur."
                            },
                            {
                                "example_id": "5b310eca-4616-4797-8130-da505632852a",
                                "sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                                "text": "Mais les quais de la Seine exercent encore un autre attrait sur moi : j’y complète mes très graves études sur les bouquineurs et les pêcheurs à la ligne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73fe743c-b057-482b-aa01-00f0f8e6b525",
                        "source_entry_id": "00e39b04-9aaf-33ca-9e46-291d965662f5",
                        "source_sense_id": "57ed909f-a198-35b8-a0ea-2a5563481e41",
                        "target_lang_word": "Leseratte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leseratte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                        "entry_id": "c92e26b3-0b41-37dc-98ab-fef5b9972933",
                                        "glosses": [
                                            "Person, die sehr gern und viel liest"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a4c9219-33e7-4c7d-8682-4d19a883ef9e",
                                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                                "text": "Sie ist erst in der dritten Klasse und schon eine richtige Leseratte."
                                            },
                                            {
                                                "example_id": "e836b2a9-ed73-4cc3-a434-4a2753da5767",
                                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                                "text": "„Erst da spaltete sich die Versammlung; in Färinger, die gerne sangen, und in Isländer, die als ausgesprochene Leseratten viel lieber den Text vom Blatt ablasen und sich völlig über dem kopierten Liederbuch vergaßen.“"
                                            },
                                            {
                                                "example_id": "cd327366-835f-4dc5-a862-ad345d978d3e",
                                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                                "text": "„Seit Schultagen ist sie eine Leseratte, ihr Haus ist vollgestopft mit tschechischen Büchern.“"
                                            },
                                            {
                                                "example_id": "40b97dec-8576-40ad-9609-ceb0116afa50",
                                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                                "text": "„Vielleicht waren diese Abende ein kleines bisschen ausschlaggebend dafür, dass die Leseratten geworden sind.“"
                                            },
                                            {
                                                "example_id": "040aeb54-b83b-4a6d-9631-df8744e7eeb4",
                                                "sense_id": "619f84a0-b212-308d-9f3e-8e340f3079e8",
                                                "text": "„Nein, aus dem wird nie eine Leseratte werden, die Trumpfkarte in mütterlichen Konkurrenzkämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
