                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61af5d66-2b5e-3701-9b18-597519a179f5",
                                        "entry_id": "eb8c226c-6fb1-31aa-8515-a04287c0a9a2",
                                        "glosses": [
                                            "Easily set on fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99031ff4-4e70-4310-8d4a-f6a2e5f3ba03",
                                                "sense_id": "61af5d66-2b5e-3701-9b18-597519a179f5",
                                                "text": "On he went a few paces and touched a second, then a third, and a fourth, till at last we were surrounded on all three sides by a great ring of bodies flaring furiously, the material with which they were preserved having rendered them so inflammable that the flames would literally spout out of the ears and mouth in tongues of fire a foot or more in length."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4126454c-d118-31aa-bcbd-e9f39123c66f",
                                        "entry_id": "eb8c226c-6fb1-31aa-8515-a04287c0a9a2",
                                        "glosses": [
                                            "Easily excited; set off by the slightest excuse; easily enraged or inflamed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9099f1a6-79b3-3781-aac1-2f254f01589b",
                                        "entry_id": "eb8c226c-6fb1-31aa-8515-a04287c0a9a2",
                                        "glosses": [
                                            "Incapable of burning; not easily set on fire."
                                        ],
