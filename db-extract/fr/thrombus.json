        "fr-extract.jsonl": [
            {
                "entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                "word": "thrombus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af216186-93a6-4437-a4e2-42126903b303",
                        "entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                        "tags": [
                            "plural"
                        ],
                        "form": "thrombi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                        "entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                        "glosses": [
                            "Caillot sanguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af668e6e-4584-439d-b352-13309026aa7e",
                                "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                                "text": "Paradoxalement, il est recommandé d’anticoaguler à dose curative afin d’éviter la formation de thrombus intracarotidien [20, 21]."
                            },
                            {
                                "example_id": "b68fa54e-f9b6-4266-9c32-5ebd5cba9b7a",
                                "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c16f1128-f9ca-4eb8-9074-e3ccd24a88cc",
                        "source_entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                        "source_sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                        "target_lang_word": "Thrombus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thrombus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                                        "entry_id": "cc6a0886-3fd0-3ddd-ba92-f40f9ae18926",
                                        "glosses": [
                                            "Blutpfropf, der ein Blutgefäß verstopft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0bb5e66-7ec8-455e-b2fe-93946dd29481",
                                                "sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                                                "text": "„Der nächste Thrombus lag gewiss schon auf der Lauer, wollte sich hinter meinen zugefallenen Lidern unter der Hirnschranke durchducken, um diesmal einen der zentralen Eingänge zu verstopfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "720f126c-715b-4c70-b681-51cfc4403b14",
                        "source_entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                        "source_sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                        "target_lang_word": "Blutgerinnsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutgerinnsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                        "entry_id": "48759fd8-65f4-3328-b599-c06d87d04bed",
                                        "glosses": [
                                            "geronnenes Blut, das ein Blutgefäß im Körper verstopfen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b917ce8-addf-4254-8ab1-1df2e338dcf1",
                                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                                "text": "Durch Blutgerinnsel kann eine Lungenembolie ausgelöst werden."
                                            },
                                            {
                                                "example_id": "ba46d09e-2270-4f59-8549-d419ad693d5c",
                                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                                "text": "Noch ist unklar, warum sich die Blutgerinnsel bei Covid-19 bilden können."
                                            },
                                            {
                                                "example_id": "c8657db5-915a-45d6-ba23-3a1d2a6d383a",
                                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                                "text": "Blutgerinnsel sind nicht nur für die Gliedmaßen gefährlich, sondern können ihren Weg auch in die Lunge, das Herz oder das Gehirn finden und so Lungenembolien, Herzinfarkte und Schlaganfälle verursachen."
                                            },
                                            {
                                                "example_id": "25a7b1d1-fea0-40d5-b306-2424e96b3e9c",
                                                "sense_id": "5e59007f-2cf1-3325-bd8a-0dbf5abe890b",
                                                "text": "„Schließlich stellte ein Arzt fest, dass sich Blutgerinnsel an den Segeln seiner neuen Klappe gebildet hatten, die eine ordnungsgemäße Funktion verhinderten, und so erhielt er den starken Blutverdünner Coumadin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95d8d421-344f-4c55-8b7c-e343b9a19ca5",
                        "source_entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
