                        "glosses": [
                            "persdienst die zich toelegt op het maken en verspreiden van fotografisch materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658b9d30-8c58-4a85-82f7-08c8276b5429",
                                "sense_id": "19c62676-1448-3916-89b1-04c5c0f28c74",
                                "text": "Verder bevat het kistje foto's met Mussert uit de oorlogstijd, gemaakt door de fotodienst van de NSB en ook zijn lidmaatschapskaart voor 1943 en 1944. Opmerkelijk is dat de contributiezegels tot 1 september 1944 zijn bijgeplakt."
                            },
                            {
                                "example_id": "2df4a574-477b-46b2-a2d5-e45ded2f536b",
                                "sense_id": "19c62676-1448-3916-89b1-04c5c0f28c74",
                                "text": "Het ANP, dat in de zomer zelf fotodienst Hollandse Hoogte kocht, maakt sindsdien onderdeel uit van Talpa Network. Daarin heeft De Mol verschillende mediaplatforms samengebracht: radiostations 538, Veronica, Sky Radio en Radio 10, de televisiezenders SBS6, Net5, Veronica en SBS9, de onlinediensten Juke en Kijk en onlangs nog het YouTube-kanaal StukTV."
                            }
                        ]
                    }
