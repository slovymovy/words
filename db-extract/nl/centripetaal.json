                ],
                "senses": [
                    {
                        "sense_id": "2731ee9b-7c4f-3c62-a2f3-466e5a307227",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "naar het midden strevend of naar binnen gericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6adf93bc-6d0d-430c-84e5-c490f90e86db",
                                "sense_id": "2731ee9b-7c4f-3c62-a2f3-466e5a307227",
                                "text": "Bij al deze voorbeelden vormen de ribben van het straalgewelf in de koorsluiting een centripetaal lijnenspel waardoor deze belangrijke sluitsteen als vanzelf in het oog springt."
                            }
                        ]
                    },
                    {
                        "sense_id": "703567d0-e78c-357c-9cd5-b106263d2b20",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "naar het middelpunt van een draaiende beweging toe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cccee66-d9d9-48b5-83b5-d559f6b4259f",
                                "sense_id": "703567d0-e78c-357c-9cd5-b106263d2b20",
                                "text": "Een balletje dat aan een touwtje wordt rondgeslingerd ondervindt van het touwtje een centripetale kracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "100691a9-6289-30cb-abbe-2b915978765b",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "naar de oorspronkelijke bron van de besmetting"
                        ],
                        "tags": [
                            "epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "880cc13f-5410-452f-8766-a2d7263a9cb1",
                                "sense_id": "100691a9-6289-30cb-abbe-2b915978765b",
                                "text": "Vooral in streken waar de strijd met de tuberculose nog niet is aangebonden, kan een centripetaal' onderzoek ons in korten tijd inlichten, hoe het in die streek met de tuberculose staat."
                            }
                        ]
                    },
                    {
                        "sense_id": "aad6e055-da61-3e02-ae09-1b28ff94f2ba",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "uitgaand van het op de eigen persoon gerichte oordeel van anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9edf7c4-5e7f-422f-bbce-008c660ff2e4",
                                "sense_id": "aad6e055-da61-3e02-ae09-1b28ff94f2ba",
                                "text": "Centrifugaal narcisme gaat uit van de zelfpool, centripetaal narcisme vertrekt vanuit het beeld van de ander."
                            }
                        ]
                    },
                    {
                        "sense_id": "6802ffa7-7197-39a1-a9a9-b87d5da81c06",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "gericht op versterking van de samenhang in eigen groep of samenleving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c1d10f-b90b-4846-a5ff-cd192ffe9f2a",
                                "sense_id": "6802ffa7-7197-39a1-a9a9-b87d5da81c06",
                                "text": "Het lijkt aannemelijk, dat activiteiten als alleen uit vissen gaan, bezoeken van sportevenementen door de man alleen etc. als centrifugaal kunnen worden gekwalificeerd, terwijl gemeenschappelijk kamperen en het maken van gemeenschappelijke trektochten als centripetaal kunnen worden getypeerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d4a8ed4-042f-380b-886b-30850269cc9a",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "gericht op door velen gedeelde, gematigde opvattingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "421c2aa2-a988-4f33-b44b-499bb057835d",
                                "sense_id": "6d4a8ed4-042f-380b-886b-30850269cc9a",
                                "text": "En daardoor treden ook toenemende spanningen bij socialisten en liberalen op tussen hen die ter wille van de nog altijd bestaande noodzaak tot coalitievorming meer ‘centripetaal’ gericht willen blijven, en nieuwe ‘centrifugale’ krachten die van een scherpere koers meer winst en duidelijkheid verwachten."
                            }
                        ]
                    },
                    {
                        "sense_id": "b82154db-2618-3e8e-8119-1c16872754ac",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "verwijzend naar eenzelfde kern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "336a37c3-eed6-4b84-bb39-21a653106e43",
                                "sense_id": "b82154db-2618-3e8e-8119-1c16872754ac",
                                "text": "De persoonlijke, christelijke boodschap is in Moens' gedichten inderdaad de voornaamste bindende kracht waardoor de beelden centripetaal worden aangetrokken."
                            }
                        ]
                    },
                    {
                        "sense_id": "b11eb6fe-6c1a-3f26-be5b-45b25be0a018",
                        "entry_id": "7fba54c4-95d1-3448-85b3-2db8ba60bc49",
                        "glosses": [
                            "met de nadruk op het midden van het doek"
                        ],
                        "tags": [
                            "schilderkunst",
                            "compositie"
                        ],
                        "examples": [
                            {
                                "example_id": "e39bea57-71ac-4b1d-a6e0-4a36eef69f16",
                                "sense_id": "b11eb6fe-6c1a-3f26-be5b-45b25be0a018",
                                "text": "Deze asymmetrische wending van het harmoniebegrip verklaart waarom Mondriaan de centripetale, veelal binnen ovalen geordende stijl in de loop van 1917 plotseling liet vallen ter wille van excentrisch geordende kleurblokjes en waarom hij nog weer een paar jaar later (1920) brak met de centripetaal geordende composities en koos voor asymmetrische, ‘perifere’ doeken waarop hij het centrum vaak op opvallende manier openliet."
                            }
                        ]
                    }
                ],
