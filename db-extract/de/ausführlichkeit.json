                "senses": [
                    {
                        "sense_id": "3025c38d-49d8-36d7-a915-92d580f23a68",
                        "entry_id": "4d84d40a-ed5e-334e-80f2-0cf70c8a36b7",
                        "glosses": [
                            "Eigenschaft, etwas vollständig/ohne Auslassungen zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0f480d1-993b-4002-a0ea-0978d6334845",
                                "sense_id": "3025c38d-49d8-36d7-a915-92d580f23a68",
                                "text": "„Bolchowitinow machte sich daran, alles, was ihm aufgetragen worden war, von Anfang an mit grösster Ausführlichkeit zu berichten.“"
                            },
                            {
                                "example_id": "29ff9415-6eff-4ff5-a2dc-672e32629531",
                                "sense_id": "3025c38d-49d8-36d7-a915-92d580f23a68",
                                "text": "„Er geht zum Stehpult, stützt seine Ellenbogen darauf, sieht hoch zum Gericht und hebt an, mit linksgeneigtem Kopf, hochdeutsch und in einer Ausführlichkeit, als habe er hier eine Vorlesung zu halten.“"
                            },
                            {
                                "example_id": "cef266d5-9d0f-4193-82f8-4a3a8bc18679",
                                "sense_id": "3025c38d-49d8-36d7-a915-92d580f23a68",
                                "text": "„Eine unerfreuliche Episode legt er Zimmermann in bemerkenswerter Ausführlichkeit dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
