                    {
                        "sense_id": "57456496-dfcd-37ad-860b-bcf75c0b0e28",
                        "entry_id": "7848ab2e-fafb-3962-bf09-511cf76fbcbd",
                        "glosses": [
                            "that which is compulsory; an obligation; duty; must"
                        ],
                        "tags": [
                            "informal",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a5f09e34-d785-4b43-80a1-9988306da2ed",
                                "sense_id": "57456496-dfcd-37ad-860b-bcf75c0b0e28",
                                "text": "Comme le fait remarquer Daphne Patai, Loïs Pineau, contrairement à Catherine MacKinnon, postule que les femmes sont tout à fait capables de donner un consentement explicite et verbal sans en rester au geste et au sous-entendu. Non seulement l'explicitation n'est pas un problème, mais c'est un must.",
                                "translation": "As Daphne Patai points out, Loïs Pineau, unlike Catherine MacKinnon, postulates that women are entirely capable of giving explicit and verbal consent without relying on gesture and insinuation. Not only is explanation not a problem, but it's a must.",
                                "english": "As Daphne Patai points out, Loïs Pineau, unlike Catherine MacKinnon, postulates that women are entirely capable of giving explicit and verbal consent without relying on gesture and insinuation. Not only is explanation not a problem, but it's a must."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d98cb0-3e80-35e5-ba2a-0af117ff9cf8",
                        "entry_id": "7848ab2e-fafb-3962-bf09-511cf76fbcbd",
                        "glosses": [
                            "must-have (item that one must own)"
                        ],
                        "tags": [
                            "humorous",
                            "masculine",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "fbf779e6-8967-4330-8cc6-3cba80243488",
                                "sense_id": "c3d98cb0-3e80-35e5-ba2a-0af117ff9cf8",
                                "text": "La fête des Mères s’affiche partout dans le centre commercial. À Auchan, un espace lui est réservé, rempli de robots, d’aspirateurs, de machines à café – le must apparemment – parfums, etc.",
                                "translation": "Mother's Day is on display everywhere in the mall. At Auchan, a space is reserved for it, filled with appliances, vacuum cleaners, coffee makers — the apparent must-have — perfumes, etc.",
                                "english": "Mother's Day is on display everywhere in the mall. At Auchan, a space is reserved for it, filled with appliances, vacuum cleaners, coffee makers — the apparent must-have — perfumes, etc."
                            }
                        ]
                    }
