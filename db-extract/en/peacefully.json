                        "translation_id": "fe609525-54e0-4bff-8a36-7f9780c762cc",
                        "source_entry_id": "2deb9e58-0775-3910-8bd3-932747c26123",
                        "source_sense_id": "d91dfdf0-436a-319f-b676-b6ca37866d99",
                        "source_sense_description": "in a peaceful manner",
                        "target_lang_word": "friedlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friedlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2098f633-5a28-3666-984c-c2adeafb6c8a",
                                        "entry_id": "f2cb6226-12a0-324c-a0d2-beb074203889",
                                        "glosses": [
                                            "ohne Gewalt und Krieg; in Frieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b3e5de-1181-43b3-a7bf-f143363818eb",
                                                "sense_id": "2098f633-5a28-3666-984c-c2adeafb6c8a",
                                                "text": "„Wir lebten damals in friedlichen Zeiten.“"
                                            },
                                            {
                                                "example_id": "32079128-a244-4a52-bb29-8c5a95015a15",
                                                "sense_id": "2098f633-5a28-3666-984c-c2adeafb6c8a",
                                                "text": "„Wie der Untergang des habsburgischen Reichs hätte der Zerfall des sowjetischen Imperiums erfahrungsgemäss zahllose, endlose Konflikte nach sich ziehen müssen. Aber es blieb friedlich in allen osteuropäischen Staaten, denen die EU den Beitritt anbieten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a21c109-6a44-3f44-aaa3-5e9d1adc9985",
                                        "entry_id": "f2cb6226-12a0-324c-a0d2-beb074203889",
                                        "glosses": [
                                            "eine gewaltlose Lebenseinstellung besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8781e8a-c5b6-491c-9692-61324509ec6e",
                                                "sense_id": "1a21c109-6a44-3f44-aaa3-5e9d1adc9985",
                                                "text": "„Sie ist eine der friedlichsten Menschen, die ich je gesehen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f61747ce-c815-3e48-8ff0-a70e4a7b0429",
                                        "entry_id": "f2cb6226-12a0-324c-a0d2-beb074203889",
                                        "glosses": [
                                            "beschaulich, leise seiend"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9631f409-27fb-44de-ae6e-e3d8f8b3185c",
                                                "sense_id": "f61747ce-c815-3e48-8ff0-a70e4a7b0429",
                                                "text": "„Ich habe ein Haus in einem friedlichen, kleinen Wohngebiet gekauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
