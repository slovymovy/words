                                        "sense_id": "b2e60ca4-dbd6-3d81-b1a1-9f77366cb1c2",
                                        "entry_id": "7bafbd70-989a-3ac3-a1bd-0242f2f708ac",
                                        "glosses": [
                                            "ein Ganzes aus seinen Teilen herstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "895e4abf-1db3-4732-8c3e-1478f2aa3cf5",
                                                "sense_id": "b2e60ca4-dbd6-3d81-b1a1-9f77366cb1c2",
                                                "text": "Es ist ihm nicht gelungen, die Uhr wieder zusammenzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31eb0138-180a-3800-bb9d-351e6a0bd20f",
                                        "entry_id": "7bafbd70-989a-3ac3-a1bd-0242f2f708ac",
                                        "glosses": [
                                            "sich mit anderen treffen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d0d47f-86a1-41b3-80e3-df82202660f7",
                                                "sense_id": "31eb0138-180a-3800-bb9d-351e6a0bd20f",
                                                "text": "Wir müssen uns so bald wie möglich zusammensetzen, um das Problem zu beraten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4de37fa1-268e-3406-be4e-1a1cad2ff6d0",
                                        "entry_id": "7bafbd70-989a-3ac3-a1bd-0242f2f708ac",
                                        "glosses": [
                                            "bestehen aus"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5ec4f3-6311-4543-8944-bc46a74487ab",
                                                "sense_id": "4de37fa1-268e-3406-be4e-1a1cad2ff6d0",
                                                "text": "Aus welchen Modulen setzt sich der neue Studiengang zusammen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f89373e9-9143-4bfd-8962-1921e77be924",
                        "source_entry_id": "34e068b2-fead-361f-9cbe-430793025b5f",
                        "source_sense_id": "a207b64b-9096-36bf-8efa-330ab51c75ac",
                        "source_sense_description": "etwas wieder zusammensetzen, etwas wieder zusammenlegen",
                        "target_lang_word": "zusammenlegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusammenlegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68b66ea1-0db0-338d-8204-dbb8aef5e658",
                                        "entry_id": "6153470c-e3f3-304d-b712-be0b8512b4f2",
                                        "glosses": [
                                            "etwas, das an getrennten Orten ist/liegt an einem Ort zusammenführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63939d81-4706-4b5c-a5a4-752c7e191aa1",
                                                "sense_id": "68b66ea1-0db0-338d-8204-dbb8aef5e658",
                                                "text": "Die beiden Kommunen haben sich darauf geeinigt, ihre Planungsabteilungen zusammenzulegen."
                                            },
                                            {
                                                "example_id": "5e3b61d2-0e18-4a74-ad22-84533cdd943a",
                                                "sense_id": "68b66ea1-0db0-338d-8204-dbb8aef5e658",
                                                "text": "Wir legen den Fortgeschrittenenkurs mit dem Gesprächskreis zusammen, dann wird die Gruppe wieder größer."
                                            },
                                            {
                                                "example_id": "c1a564b1-d6fa-40c1-85fb-0f7a78e56b85",
                                                "sense_id": "68b66ea1-0db0-338d-8204-dbb8aef5e658",
                                                "text": "Leg doch mal alle Sachen zusammen, die zum Tauchen gehören."
                                            },
                                            {
                                                "example_id": "5ce0391c-400e-4e75-9486-2106d90f471c",
                                                "sense_id": "68b66ea1-0db0-338d-8204-dbb8aef5e658",
                                                "text": "Man kann doch keinen Gewalttäter mit einem Steuerhinterzieher zusammenlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c97f1c8-f9f4-3139-9ccb-94eab251e601",
                                        "entry_id": "6153470c-e3f3-304d-b712-be0b8512b4f2",
                                        "glosses": [
                                            "etwas, das in einem ausgebreiteten Zustand ist, auf ein kleineres Maß reduzieren/falten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bdeca8-91a4-4c48-b18b-ba89fd5c65f9",
                                                "sense_id": "2c97f1c8-f9f4-3139-9ccb-94eab251e601",
                                                "text": "Lassen Sie mal, ich lege den Pullover wieder zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "33942ba3-8c3d-3dd0-839f-f2e3b2435987",
                                        "entry_id": "6153470c-e3f3-304d-b712-be0b8512b4f2",
                                        "glosses": [
                                            "gemeinsam Geld stiften, um etwas damit zu finanzieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5360d8-2787-4784-9c91-010d23b393eb",
                                                "sense_id": "33942ba3-8c3d-3dd0-839f-f2e3b2435987",
                                                "text": "Wenn wir zusammenlegen, könnte es für einen Wochenendtrip reichen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "351733ec-4338-332d-ab01-b26078014706",
                                        "entry_id": "6153470c-e3f3-304d-b712-be0b8512b4f2",
                                        "glosses": [
                                            "die Hände sich berühren lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b0485f-b6e7-41b8-9d40-9009c7db2686",
                                                "sense_id": "351733ec-4338-332d-ab01-b26078014706",
                                                "text": "„Hinknien, die Hände zusammenlegen und zu einer Schale formen. Das Quellwasser hineinfließen lassen, die Hände – notfalls reicht auch eine hohle Hand – zum Mund führen und langsam das Quellwasser schlürfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e522de2-8639-4536-935c-9c12b23fa25f",
                        "source_entry_id": "34e068b2-fead-361f-9cbe-430793025b5f",
                        "source_sense_id": "34c9293a-8a1b-3e34-9cc0-de36338bcfb4",
                        "source_sense_description": "ein Foto/ Bild rahmen",
                        "target_lang_word": "rahmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rahmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c27a344c-8b20-3b9e-a43b-dadf9ee89696",
                                        "entry_id": "48eb5292-e005-3a42-903b-1c41be042324",
                                        "glosses": [
                                            "etwas mit einer für den Zweck geeigneten, umgebenden Konstruktion (Rahmen) versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726b1a7e-2d1b-457b-9645-70a2cb2c5fd2",
                                                "sense_id": "c27a344c-8b20-3b9e-a43b-dadf9ee89696",
                                                "text": "Was für eine hübsche Zeichnung! Die würde ich rahmen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03568bf5-8ebd-3fec-994d-a9ff0f1b7edc",
                                        "entry_id": "48eb5292-e005-3a42-903b-1c41be042324",
                                        "glosses": [
                                            "für etwas die Umgebung (Rahmen) bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed868f4-3b51-4b42-b85d-a5e8a0c1ac84",
                                                "sense_id": "03568bf5-8ebd-3fec-994d-a9ff0f1b7edc",
                                                "text": "„Felsnadeln wie der ›Gottesfinger‹ rahmen die dramatisch schöne Bucht.“"
                                            },
                                            {
                                                "example_id": "aa677c05-cfce-467e-973b-0e3932b03e59",
                                                "sense_id": "03568bf5-8ebd-3fec-994d-a9ff0f1b7edc",
                                                "text": "„Bereits bei ihnen aber zeigt sich, was, schon zuvor erwähnt, nun für den Rahmen ganz grundsätzlich auszusprechen bleibt: Jeder Rahmen schafft ein Überordnungsverhältnis, denn er erhebt, was er rahmt, zum Zentrum. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "rahmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f6b64b-d350-3342-942f-980500fa7a8d",
                                        "entry_id": "e6518911-ccc4-3a9a-b4d7-002f1ed67415",
                                        "glosses": [
                                            "die fetthaltige Phase (Rahm) an der Oberfläche sammeln"
                                        ],
                                        "tags": [
                                            "Meierei",
                                            "über Milch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13dcb1a3-51ae-48f2-8bd4-31e61ffde15f",
                                                "sense_id": "c9f6b64b-d350-3342-942f-980500fa7a8d",
                                                "text": "Läßt man rohe Milch stehen, trennt sich das Fett vom Wasser, die Milch rahmt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec5ac5a0-bcc5-3d75-9efb-0cf32b606fb7",
                                        "entry_id": "e6518911-ccc4-3a9a-b4d7-002f1ed67415",
                                        "glosses": [
                                            "entrahmen, den Rahm abnehmen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c4c4c8-964a-4f03-8376-cc040f80ee03",
                                                "sense_id": "ec5ac5a0-bcc5-3d75-9efb-0cf32b606fb7",
                                                "text": "„Sie lieferte reichlich Milch; wir rahmten sie in guter alter Bauernart auf irdene Schüsseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2438e3df-a09c-4a19-9a84-aeef4330eca6",
                        "source_entry_id": "34e068b2-fead-361f-9cbe-430793025b5f",
                        "source_sense_id": "34c9293a-8a1b-3e34-9cc0-de36338bcfb4",
