                        "translation_id": "8e5d2d6d-5045-442a-9ece-da51b247ae42",
                        "source_entry_id": "a72df0a5-b7ff-354b-b793-ae1bbca93f45",
                        "source_sense_id": "b60dd23d-b733-38c6-8f26-510f7aabb9aa",
                        "target_lang_word": "Libéria",
