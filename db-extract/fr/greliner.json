                "senses": [
                    {
                        "sense_id": "a8b5bdfd-c309-3fcb-a941-227ee4f72ea8",
                        "entry_id": "1478aa08-6330-3799-9f5e-2f7463e11dde",
                        "glosses": [
                            "Ameublir un sol à l’aide d’une grelinette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7020d7e5-2362-4eb2-8bcf-991251941a69",
                                "sense_id": "a8b5bdfd-c309-3fcb-a941-227ee4f72ea8",
                                "text": "Nous sommes 2 pour consommer les récoltes + quelques voisins qui en profitent. Je le fais à la main et depuis 2 ans je ne bêche plus je greline."
                            },
                            {
                                "example_id": "dcc4e020-9047-4d4f-8103-6dd18a9fb5de",
                                "sense_id": "a8b5bdfd-c309-3fcb-a941-227ee4f72ea8",
                                "text": "Jusqu’en 2003 j’attaquais à la fourche bêche, ben j’en suis contente de ma grelinette, sauf qu’à la période où je greline mon soucis c’est de trouver le terrain ressuyé après les pluies."
                            },
                            {
                                "example_id": "2937f7c3-aed9-4ad7-a51c-0a0f3724c096",
                                "sense_id": "a8b5bdfd-c309-3fcb-a941-227ee4f72ea8",
                                "text": "bon d’accord on a pas trop le temps, mais quand on arrive à faire des tomates ou des patates, on est content (pas de motoculteur, nous grelinons !) et plein d’autre truc qui sont évident pour moi et ma femme mais au quel je ne pense pas de suite."
                            }
                        ]
                    }
