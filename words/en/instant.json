                {
                    "sense_id": "e3d92af7-da96-34a1-ab47-8d4e10e2e04e",
                    "sense_definition": "Of the current month.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "date_correspondence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We acknowledge receipt of your letter dated the 12th <w>instant</w>.",
                            "target_lang_translations": {
                                "ru": "Подтверждаем получение вашего письма от 12-го числа <w>текущего месяца</w>.",
                                "de": "Wir bestätigen den Erhalt Ihres Schreibens vom 12. <w>dieses Monats</w>.",
                                "pl": "Potwierdzamy otrzymanie Państwa listu z 12. dnia <w>bieżącego miesiąca</w>.",
                                "tr": "<w>Bu ayın</w> 12'si tarihli mektubunuzun alındığını teyit ederiz.",
                                "zh": "我们确认收到了您<w>本月</w>12日的来信。"
                            }
                        },
                        {
                            "text": "Please refer to our memo of the 4th <w>instant</w> regarding the new regulations.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обратитесь к нашей служебной записке от 4-го числа <w>сего месяца</w> касательно новых правил.",
                                "de": "Bitte beziehen Sie sich auf unser Memo vom 4. <w>laufenden Monats</w> bezüglich der neuen Bestimmungen.",
                                "pl": "Prosimy o zapoznanie się z naszym pismem z 4. dnia <w>niniejszego miesiąca</w> dotyczącym nowych przepisów.",
                                "tr": "Lütfen yeni düzenlemelerle ilgili <w>bu ayın</w> 4'ündeki notumuza bakınız.",
                                "zh": "请参阅我们<w>本月</w>4日关于新规的备忘录。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the 15th instant"
                    ],
