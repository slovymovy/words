                            {
                                "example_id": "650a76ac-601d-4382-b40b-6e86bc363bfc",
                                "sense_id": "570fadf2-ec1d-37d3-ac1d-6afc55f2cae6",
                                "text": "Bier was een gezonde 'volksdrank', dat onze voorvaderen, de Germanen reeds dronken uit de schedels hunner verslagen vijanden."
                            },
                            {
                                "example_id": "f77cf43b-5228-4bd4-95bb-ca925796c41b",
                                "sense_id": "570fadf2-ec1d-37d3-ac1d-6afc55f2cae6",
                                "text": "Mogen de monniken van Westvleteren zelf bier drinken? Jazeker, naast water is ook de volksdrank van de streek toegelaten. Maar van de monniken wordt verwacht dat ze het bij één fles van tafelbier per dag houden. Geen overdaad of dronkenschap dus."
                            }
                        ]
