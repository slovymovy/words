                                "target_lang_sense_clarification": "разговорное название полицейской машины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8320b25e-6c0a-37fd-9dfc-8148a8711e39",
                    "sense_definition": "A small cart or set of shelves on wheels used for serving food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter pushed the dessert <w>wagon</w> to our table so we could choose a cake.",
                            "target_lang_translations": {
                                "ru": "Официант подкатил десертную <w>тележку</w> к нашему столику, чтобы мы могли выбрать торт."
                            }
                        },
                        {
                            "text": "They used a dinner <w>wagon</w> to bring the heavy plates from the kitchen to the dining room.",
                            "target_lang_translations": {
                                "ru": "Они использовали сервировочную <w>тележку</w>, чтобы привезти тяжелые тарелки из кухни в столовую."
                            }
                        }
                    ],
                    "synonyms": [
                        "dinner wagon",
                        "trolley",
                        "tea cart"
                    ],
                    "common_phrases": [
                        "dessert wagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая тележка или набор полок на колесах, используемые для подачи еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сервировочная тележка",
                                "target_lang_sense_clarification": "столик на колесах для еды"
                            },
                            {
                                "target_lang_word": "каталка",
                                "target_lang_sense_clarification": "разговорное название передвижного столика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f38eaa06-2673-3ebf-ae0f-d986c5f5c949",
                    "sense_definition": "An insulting term for an unpleasant or obnoxious woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insults",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He muttered that she was a total <w>wagon</w> after she shouted at the staff.",
                            "target_lang_translations": {
                                "ru": "Он пробормотал, что она настоящая <w>стерва</w>, после того как она накричала на персонал."
                            }
                        },
                        {
                            "text": "Don't be such a <w>wagon</w> and try to be nice to your neighbors for once.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>хабалкой</w> и попытайся хоть раз быть вежливой с соседями."
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch",
                        "cow"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Irish"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "Pejorative"
                        }
