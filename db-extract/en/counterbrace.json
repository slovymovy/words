                        "entry_id": "0ddbb68b-ea6e-37ff-ac9b-11948016490d",
                        "glosses": [
                            "To brace in opposite directions."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "954302f3-879b-49f2-895d-42ca8d42171a",
                                "sense_id": "595f3cb0-699a-3d62-9ce4-45fe1726594c",
                                "text": "To counterbrace the yards is to brace the head yards one way and the after yards another."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c54522b-34e8-3680-b4de-ca8222064dcf",
                        "entry_id": "0ddbb68b-ea6e-37ff-ac9b-11948016490d",
                        "glosses": [
                            "To brace in such a way that opposite strains are resisted."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac32f5d-cd0d-4580-9182-ec878b0a3842",
                                "sense_id": "1c54522b-34e8-3680-b4de-ca8222064dcf",
                                "text": "Here a, b, and c are the great ribs whose thrusts, in the direction of the arrows, are concentrated upon the pier, d, and are counterbraced by the flying buttress, e. In other words, the section through the vaulting conoid at half its vertical height gives the triangle, a, b, c, in A, and not the square, a, b, c, d, in B in the same figure."
                            }
                        ]
                    }
