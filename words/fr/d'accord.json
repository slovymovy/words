                    "sense_id": "d2cc98cf-2962-3c89-8c11-7261768a6242",
                    "sense_definition": "Sert à exprimer son assentiment, son approbation ou son acceptation d'une proposition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "assentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>D'accord</w>, nous pouvons commencer la réunion dès que tout le monde sera installé.",
                            "target_lang_translations": {
                                "en": "<w>All right</w>, we can start the meeting as soon as everyone is settled in.",
                                "ru": "<w>Хорошо</w>, можем начинать совещание, как только все устроятся.",
                                "nl": "<w>Oké</w>, we kunnen de vergadering beginnen zodra iedereen zit.",
                                "de": "<w>Okay</w>, wir können mit der Besprechung beginnen, sobald alle Platz genommen haben.",
                                "pl": "<w>Dobrze</w>, możemy zacząć spotkanie, jak tylko wszyscy zajmą miejsca.",
                                "it": "<w>D'accordo</w>, possiamo iniziare la riunione non appena tutti si saranno sistemati.",
                                "cs": "<w>Dobře</w>, můžeme začít schůzku, jakmile se všichni usadí.",
                                "tr": "<w>Tamam</w>, herkes yerleşir yerleşmez toplantıya başlayabiliriz.",
                                "es": "<w>Vale</w>, podemos empezar la reunión en cuanto todo el mundo se haya acomodado.",
                                "zh": "<w>好的</w>，等大家都坐好了，我们就可以开始开会了。"
                            }
                        },
                        {
                            "text": "Je veux bien vous accompagner au marché ce matin, <w>d'accord</w>, mais revenons vite.",
                            "target_lang_translations": {
                                "en": "I don't mind coming to the market with you this morning, <w>OK</w>, but let's come back quickly.",
                                "ru": "Я не прочь сходить с вами на рынок этим утром, <w>ладно</w>, но давайте вернёмся поскорее.",
                                "nl": "Ik ga graag met u mee naar de markt vanochtend, <w>oké</w>, maar laten we snel terugkomen.",
                                "de": "Ich begleite Sie gern heute Morgen zum Markt, <w>okay</w>, aber wir sollten schnell zurückkommen.",
                                "pl": "Chętnie pójdę z wami dziś rano na targ, <w>dobrze</w>, ale wróćmy szybko.",
                                "it": "Volentieri vi accompagno al mercato stamattina, <w>va bene</w>, ma torniamo subito.",
                                "cs": "Klidně vás dnes ráno doprovodím na trh, <w>dobře</w>, ale vraťme se brzy.",
                                "tr": "Bu sabah sizinle pazara gitmeye razıyım, <w>peki</w>, ama hemen geri dönelim.",
                                "es": "No me importa acompañarles al mercado esta mañana, <w>vale</w>, pero volvamos pronto.",
                                "zh": "今天早上我很乐意陪你们去市场，<w>行</w>吧，不过我们得快点回来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "OK",
                        "entendu",
                        "ça marche"
                    ],
                    "target_lang_definitions": {
