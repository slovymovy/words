                "senses": [
                    {
                        "sense_id": "342318a4-ece6-332a-b8ad-ec69b6871cc7",
                        "entry_id": "7b2b1bba-851f-3113-ab42-66cd8657eef9",
                        "glosses": [
                            "Zeiger einer Uhr, der die Sekunden anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8338b3-09b2-4dec-ac50-1bdbd5f8fe0a",
                                "sense_id": "342318a4-ece6-332a-b8ad-ec69b6871cc7",
                                "text": "„Er sah auf den Sekundenzeiger; er glaubte, sie sei stehengeblieben.“"
                            },
                            {
                                "example_id": "c0d9936f-2653-4d8f-b4ac-162847dd883e",
                                "sense_id": "342318a4-ece6-332a-b8ad-ec69b6871cc7",
                                "text": "„Die Sekundenzeiger umliefen die letzte Minute vor zwei Uhr früh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
