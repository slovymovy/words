                                    {
                                        "sense_id": "b906ae71-8537-351d-8d41-af2ca34ae99f",
                                        "entry_id": "13d827fe-ec03-3bcd-8e4a-4be2dcba1719",
                                        "glosses": [
                                            "Any stony meteorite that contains no chondrules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffc8497-4158-4b62-a17c-19aae66de1bd",
                                                "sense_id": "b906ae71-8537-351d-8d41-af2ca34ae99f",
                                                "text": "The study confirms a 20-year-old theory that balsaltic^([sic]) achondrite meteorites are projected off the surface of the asteroid 4 Vesta, the second largest asteroid in the solar system, which lies between Jupiter and Mars."
                                            },
                                            {
                                                "example_id": "85c5f4ac-f4d3-4ed8-9f98-dec5d47e7eb4",
                                                "sense_id": "b906ae71-8537-351d-8d41-af2ca34ae99f",
                                                "text": "The Vestan, Lunar, and Martian meteorites are achondrites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23dee74d-62d4-4504-8228-c54fcb0c46e0",
