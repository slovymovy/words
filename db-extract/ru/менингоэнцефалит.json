                "senses": [
                    {
                        "sense_id": "f3536e7b-c4aa-36ff-9732-2c2cd8f688f6",
                        "entry_id": "1f5a52a8-33a1-39d4-8fb5-11908d5f8c53",
                        "glosses": [
                            "мед. воспаление оболочек и вещества головного мозга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96a3982-c7b8-465a-8ba0-25a2f759f0ed",
                                "sense_id": "f3536e7b-c4aa-36ff-9732-2c2cd8f688f6",
                                "text": "Гуммозный менингоэнцефалит. Утолщение и инфильтрация мягкой мозговой оболочки."
                            },
                            {
                                "example_id": "98ec83d1-9fa5-4752-b733-497b94469f9e",
                                "sense_id": "f3536e7b-c4aa-36ff-9732-2c2cd8f688f6",
                                "text": "Об этом свидетельствует тот факт, что у больных, у которых описанное парадоксальное сочетание было бы особенно выражено, локальный процесс был осложнён органическими процессами диффузного характера (менингоэнцефалит, абсцесс, хронический сепсис)."
                            }
                        ]
                    }
