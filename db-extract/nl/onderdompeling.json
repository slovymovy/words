                "senses": [
                    {
                        "sense_id": "ec351cee-e79a-3ee8-8c2f-f8b7737316f9",
                        "entry_id": "0110e0aa-613e-365b-94dd-1fb232342e5c",
                        "glosses": [
                            "helemaal in een vloeistof geduwd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f8dd35-62e1-41ee-9250-f3274a763b78",
                                "sense_id": "ec351cee-e79a-3ee8-8c2f-f8b7737316f9",
                                "text": "Zijn onderdompeling in het frituurvet had totale blindheid als doel."
                            },
                            {
                                "example_id": "314a7580-5c40-4cc0-8071-d7675768b334",
                                "sense_id": "ec351cee-e79a-3ee8-8c2f-f8b7737316f9",
                                "text": "Naar schatting 30 miljoen hindoes kwamen zondag samen op de plek waar de Yamunarivier zich bij de Ganges voegt. Met een onderdompeling op die heilige plek geloven hindoes dat hun zonden worden weggewassen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ed49f72-2898-3a5d-9478-e4a66c9e03d5",
                        "entry_id": "0110e0aa-613e-365b-94dd-1fb232342e5c",
                        "glosses": [
                            "helemaal door iets omgeven zijn"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e49b1a3a-d3e6-46ac-9f8b-c8633e5cade6",
