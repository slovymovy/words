                    {
                        "sense_id": "a0e7f55f-6dac-34d5-98d6-fb71de4272ef",
                        "entry_id": "72b69360-f698-30c2-b40d-a4f93d4793fb",
                        "glosses": [
                            "Person, die im Auftrag einer dazu berechtigten Institution nach etwas oder jemandem fahndet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e0db2a-3cbd-485e-8acb-117abf8ad78b",
                                "sense_id": "a0e7f55f-6dac-34d5-98d6-fb71de4272ef",
                                "text": "„Deshalb haben die vier Fahnder jetzt Klage gegen Gutachter H. eingereicht und auch seinem Auftraggeber, dem Land Hessen, den Streit erklärt.“"
                            },
                            {
                                "example_id": "86f8c761-ed48-427e-8a14-7a0b7c5dae9d",
                                "sense_id": "a0e7f55f-6dac-34d5-98d6-fb71de4272ef",
                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb671751-ce92-4fec-a08f-26032acd0aef",
