                    {
                        "translation_id": "472575d6-12e2-4932-9c90-8a2915c717eb",
                        "source_entry_id": "b643c9bf-7998-3ec3-8f97-07d04155ed47",
                        "source_sense_id": "105899fb-85cd-3e39-bdb0-2d0bb771f139",
                        "target_lang_word": "Zölibat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zölibat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                        "entry_id": "932aaf15-1f81-35de-82d7-5df057a3314d",
                                        "glosses": [
                                            "durch die Priesterweihe eingegangene Verpflichtung zur Ehelosigkeit und zu sexueller Enthaltsamkeit katholischer Priester"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e0b352-f8b8-4f16-9f32-f05eefb48cf3",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "In der orthodoxen Kirche ist der Zölibat nur für Bischöfe verpflichtend."
                                            },
                                            {
                                                "example_id": "f587643e-1663-4fc3-8ed9-9e59b07fc4c4",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "\"Der Zölibat ist zur Zeit Gegenstand außer- und innerkirchlicher Auseinandersetzungen. Nach Inhalt und Form spiegeln sie sich auch in der Enzyklika \"Sacerdotalis caelibatus\" wider.\""
                                            },
                                            {
                                                "example_id": "5d81d3f4-3515-409b-9f9a-625a766c9583",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "„Die größte Schuld am Nachwuchsmangel in den Klöstern gab Eusebius aber dem Zölibat.“"
                                            },
                                            {
                                                "example_id": "31167c2c-36e3-444a-933d-17a418aa1e89",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "„Phuntsog war verheiratet, was für einen Lama, den sein Gelübde zum Zölibat verpflichtete, unüblich war, und lebte außerhalb der Klostermauern.“"
                                            },
                                            {
                                                "example_id": "9aca619f-3046-4a04-91e8-d884c3180766",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "„Dann fiel mir nichts Klügeres ein als zu fragen, wie es eigentlich mit dem Zölibat stehe.“"
                                            },
                                            {
                                                "example_id": "a7d2d8a6-bed9-4807-a113-7f53ebce42e5",
                                                "sense_id": "6ffdbe60-e85c-3fd8-ada4-a49064eba6cd",
                                                "text": "„Unerschöpfliches Thema des klerikalen Witzes ist das Zölibat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
