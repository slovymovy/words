        "fr-extract.jsonl": [
            {
                "entry_id": "7211c34c-152a-3d89-a125-fd5da42e4217",
                "word": "barège",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a509cf4f-5d61-4ecc-bc15-cdfbbe773dc2",
                        "entry_id": "7211c34c-152a-3d89-a125-fd5da42e4217",
                        "tags": [
                            "plural"
                        ],
                        "form": "barèges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                        "entry_id": "7211c34c-152a-3d89-a125-fd5da42e4217",
                        "glosses": [
                            "Sorte d’étoffe, taffetas de laine, légère et non croisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea109bc5-187d-4127-ba9e-f7a9e2e136f4",
                                "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                                "text": "Mademoiselle de Boussac jeta une écharpe de barége sur sa tête, prit la petite lanterne de Jeanne, et descendit avec elle légèrement, un peu curieuse, un peu effrayée de l’aventure."
                            },
                            {
                                "example_id": "01f4608a-be10-4a3e-a281-c70273aa3f2d",
                                "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                                "text": "Pendant longtemps on teignit les fils destinés à la confection du barège avant de les employer. L’introduction des barèges écrus pour l’impression, contribua beaucoup à faire prendre un nouvel essor à l’article gaze."
                            },
                            {
                                "example_id": "0214285a-84c0-4120-a137-3861d8d0d417",
                                "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                                "text": "Mes robes de satin, de soie et de barège\nOnt l’aspect de brouillards, de tourbillons de neige."
                            },
                            {
                                "example_id": "483236ef-76d3-453c-ba58-ca7db43aed8c",
                                "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                                "text": "Mais, ô étrangers des deux mondes, si toutefois vous lisez cette physiologie de la facture, sachez que cette scène se joue dans les magasins de nouveautés pour du barège à deux francs ou pour de la mousseline imprimée, à quatre francs le mètre !"
                            },
                            {
                                "example_id": "e11429f7-2988-4e73-b9f4-8da831fc0c81",
                                "sense_id": "3fe0d7f7-2b7d-3e04-944d-e82e330dc492",
                                "text": "Elle avait un chapeau de paille avec des roses jaunes et un châle en barège lilas (c'était l'époque du châle) semé de petits bouquets d'un violet plus foncé."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a63aec3-52e6-3a46-8abc-20edd2c8d29c",
                        "entry_id": "7211c34c-152a-3d89-a125-fd5da42e4217",
                        "glosses": [
                            "Sulfure de potassium (K₂S)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "df3ca390-ab07-4e4d-9aa0-c19f24ab31cd",
                                "sense_id": "1a63aec3-52e6-3a46-8abc-20edd2c8d29c",
                                "text": "Un des produits qui donnent les meilleurs résultats est le Pentasulfure ^([sic]) de potassium ou Barège des pharmaciens."
                            },
                            {
                                "example_id": "891421b8-65f2-4df0-9552-d4b1ca56d9c2",
                                "sense_id": "1a63aec3-52e6-3a46-8abc-20edd2c8d29c",
                                "text": "[…] l’acteur, depuis quelque temps, recueillait d’assez sales tuyaux, sentait souffler à son oreille une brise fraîche, de mauvais augure, flotter autour de lui une atmosphère fâcheuse, fleurant le ratage et le four comme une salle de bains le barège."
                            }
                        ]
                    }
