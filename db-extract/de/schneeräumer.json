                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf47a62d-cdd6-3f1d-88b9-0c699863f3c1",
                        "entry_id": "000d3205-56b1-3434-959f-72fcec83a59d",
                        "glosses": [
                            "Person, die Schnee räumt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e504126d-caa2-4aea-a842-9ab93a89ce9d",
                                "sense_id": "bf47a62d-cdd6-3f1d-88b9-0c699863f3c1",
                                "text": "„Das Vereinsmitglied wird vom Obmann dazu bestimmt, bei Schneefall den Gehsteig vor dem Sportplatz zu räumen. Dieser Repräsentant vergisst […] seine Aufgabe. Ein Fußgänger […] bricht sich ein Bein. Der Verein und der vergessliche Schneeräumer haften dem Fußgänger gegenüber solidarisch […] für den erlittenen Schaden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
