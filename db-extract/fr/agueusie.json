                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b98c789-4f81-3369-9cab-f37e9e544094",
                        "entry_id": "cbaafa73-122f-30a8-a1b3-ab81cb225183",
                        "glosses": [
                            "Perte totale ou partielle du sens du goût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a864b7f-3c0d-4247-8965-db554427494c",
                                "sense_id": "5b98c789-4f81-3369-9cab-f37e9e544094",
                                "text": "La lésion d’un point quelconque de ces voies occasionne des troubles qui se manifestent par l’abolition de la sensation gustative (agueusie) ou sa diminution (hypogueusie), rarement par son exagération (hypergueusie)."
                            },
                            {
                                "example_id": "86128857-622c-418f-9acc-3c9966f5116d",
                                "sense_id": "5b98c789-4f81-3369-9cab-f37e9e544094",
                                "text": "Lors du vol en apesanteur, nous avons expérimenté la quasi-agueusie, comme la vivent les occupants de la station spatiale internationale (ISS) : une privation presque totale du goût, due essentiellement à l’absence de rétro-olfaction."
                            },
                            {
                                "example_id": "ea5ee4c5-279a-44f0-8e4f-e58b340b5593",
                                "sense_id": "5b98c789-4f81-3369-9cab-f37e9e544094",
                                "text": "L’agueusie (privation de goût) et l’anosmie (privation d’odorat) sont les symptômes caractéristiques du covid."
                            }
                        ]
                    },
                    {
                        "sense_id": "a248a0fb-bd2d-3d8e-8c54-6835c6d07975",
                        "entry_id": "cbaafa73-122f-30a8-a1b3-ab81cb225183",
                        "glosses": [
                            "Perte du goût de la vie."
                        ],
                        "tags": [
                            "figuratively",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "413133c6-5d4a-4320-8b13-7686aa59ba3b",
                                "sense_id": "a248a0fb-bd2d-3d8e-8c54-6835c6d07975",
                                "text": "Et il n'est pas rare que ce sentiment d'essoufflement intérieur s'accompagne d'une impression de ne plus goûter à la saveur de la vie, comme une agueusie existentielle..."
                            }
                        ]
                    }
                ],
