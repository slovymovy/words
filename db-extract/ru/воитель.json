                        "target_lang_word": "fighter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fighter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ccc5dd4-ca8c-32fc-9841-338c3cbfdac2",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A person who fights; a combatant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d51268e-bc0d-3ca6-b984-284cd036abe9",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A warrior; a fighting soldier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1291676-e2f6-3055-81c8-29d87426aff8",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A pugnacious, competitive person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf1de03c-60db-3891-b905-5697afb2bb5d",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A person with a strong determination to resist protracted or severe adversity, especially illness."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3dcced-24de-41e0-b223-11e0b90ba3ec",
                                                "sense_id": "cf1de03c-60db-3891-b905-5697afb2bb5d",
                                                "text": "Little weapons / Over the phone / They like to threaten / The life that I know / They say \"Get over here and get into the ring\" / But I'm not really much of a fighter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba403bd3-528e-3630-9f26-aeb1cb4a736e",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A class of fixed-wing aircraft whose primary purpose is to shoot down other aircraft, sometimes accompanied by a secondary purpose of attacking ground targets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c149d41c-e91d-3d37-add1-b104eaa801be",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A class of fixed-wing aircraft whose primary purpose is to shoot down other aircraft, sometimes accompanied by a secondary purpose of attacking ground targets.",
                                            "A starfighter"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7ce4cb3-f2b0-44f5-94b8-b5d6e9947b78",
                                                "sense_id": "c149d41c-e91d-3d37-add1-b104eaa801be",
                                                "text": "Task Force 42 consisted of almost two dozen main line spinships, including the carriers Olympus Shadow and Neptune Station. Each of these can launch more than a hundred fighters or ALRs."
                                            },
                                            {
                                                "example_id": "ecd8bf43-ce83-4dd4-b901-a39bc17a7ee4",
                                                "sense_id": "c149d41c-e91d-3d37-add1-b104eaa801be",
                                                "text": "I toss around [37,654 tonne] dreadnoughts like they were fighters; dimly aware of the former crews being crushed to liquescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8201dee-d841-31ab-a770-3f6bb0fac125",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A participant in boxing or any martial art."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45067c23-1c51-3ab8-b5d0-aea0849d7196",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A firefighter."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd2fdd85-015e-3773-b862-86e8af0cdde2",
                                        "entry_id": "5eaaf0d1-bf20-3a40-83c5-e1ac1bc23a6f",
                                        "glosses": [
                                            "A game with a focus on physical combat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "539d95dd-68f0-4899-8b66-c8f4d289a266",
                                                "sense_id": "dd2fdd85-015e-3773-b862-86e8af0cdde2",
                                                "text": "Still, it's excellent software, especially for one-on-one fighting titles such as the King Of Fighters series, classic Street Fighter II variants, and newer one-on-one fighters such as Garou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b11d050d-b909-47fa-807a-173592f933f5",
                        "source_entry_id": "5db5191c-ffd9-35f0-be5f-aa7f69e1a596",
                        "source_sense_description": "воин",
                        "target_lang_word": "guerrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui a rapport à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "926c06d3-ede6-4836-a9eb-d36dc9ebe7fd",
                                                "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                                "text": "Tu ne te souviens sans doute pas de moi, m'écrivait-il, mais il est impossible que tu aies complètement oublié nos petites aventures guerrières de l'été 1914, l'entrée en Belgique par Trélon, la rentrée en France, dare-dare, par Solre-le-Château, et cette sinistre nuit de Zorées, et cette traversée du bois du Nouvion, […]."
                                            },
                                            {
                                                "example_id": "4c4e57d4-11d9-4035-b4d1-e7899976a72b",
                                                "sense_id": "3cdfae64-a124-371a-bb14-2c9b157ad6f0",
                                                "text": "Ce héros, la lance brandie en avant, l’oriflamme sacrée flottant au-dessus de sa tête, entra d’un élan fougueux dans la masse guerrière qui lui prêtait le flanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui est porté à la guerre ; qui est propre à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb801983-5bf4-4a1e-a18a-a289e9802a89",
                                                "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                                "text": "Le cabo­tinage était poussé par Murat jusqu’au grotesque, et les historiens n’ont pas assez remarqué quelle responsabilité incombe à Napoléon dans cette dégénérescence du véritable esprit guerrier."
                                            },
                                            {
                                                "example_id": "6072f660-6dc4-4bf0-b660-77c46d8bcc35",
                                                "sense_id": "64e32fde-8ea5-3b5e-827a-c6df623c132c",
                                                "text": "C’est très violent et très “testostéroné”, cette manière d’opposer sans cesse les acteurs les uns aux autres. Laurent Wauquiez a un modèle de société très guerrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e892cba-8b73-35e4-adac-b22b3c22fc1f",
                                        "entry_id": "512b841a-a614-3fcc-b129-6b0a65b1e0b4",
                                        "glosses": [
                                            "Qui a l’allure, l’apparence d’un homme de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb628b6-6329-4a56-92a5-5576baef64da",
                                                "sense_id": "1e892cba-8b73-35e4-adac-b22b3c22fc1f",
                                                "text": "Avoir l’air guerrier, la mine guerrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guerrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                        "entry_id": "0e50f9ee-5d3f-37cc-be44-c1ab0f962307",
                                        "glosses": [
                                            "Celui qui fait la guerre et qui s’y plaît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc1f810-480a-49c8-b803-4112439c55ce",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Mais, l’ayant vu une fois déployer sa force dans la bataille, il me semble que je le reconnaîtrais entre mille guerriers."
                                            },
                                            {
                                                "example_id": "eec68310-682c-4083-8ba7-98288373b668",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Hilperik entra à Paris sans aucune opposition, et logea ses guerriers dans les tours qui défendaient les ponts de la ville, alors environnée par la Seine."
                                            },
                                            {
                                                "example_id": "26e1221f-13b3-4631-b522-1438a23c43cb",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "[…]; les utopies sociales furent faites en vue de maintenir un noyau de guerriers homériques dans les cités, etc."
                                            },
                                            {
                                                "example_id": "8ffc1bb0-ac51-4774-bf7f-c0ef4532057d",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "N’avait-on pas vu, parfois des pachas turcs épouser leurs esclaves et de riches guerriers préférer leur servante à d’autre épouses plus magnifiquement parées ?"
                                            },
                                            {
                                                "example_id": "942ccae2-97e5-4f50-a2e0-3d37b7c985ed",
                                                "sense_id": "58310acc-0c72-31d4-a795-5026a0196295",
                                                "text": "Le garçon était assis, le dos à la porte, concentré sur l’écran de son ordinateur, sur lequel on voyait une sorte de guerrier bigorexique anéantissant des squelettes avec une épée disproportionnée. Il ne nous accorda même pas un regard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec4576d-f9a7-38ba-94b4-d7427aaa4a7c",
                                        "entry_id": "0e50f9ee-5d3f-37cc-be44-c1ab0f962307",
                                        "glosses": [
                                            "Soldat."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81faaf8a-17be-46bf-850a-0110389743eb",
                                                "sense_id": "dec4576d-f9a7-38ba-94b4-d7427aaa4a7c",
                                                "text": "C’est notre première bataille, mais nous ébauchons instinctivement tous les gestes et les pensées que nous aurons une fois guerriers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
