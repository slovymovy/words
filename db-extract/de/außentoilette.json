                        "glosses": [
                            "Toilette, die sich außerhalb des Hauses befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6a396b-854a-4210-960d-39485c0e8ade",
                                "sense_id": "dafdea0b-f2c2-35fa-8081-03f7357e0137",
                                "text": "„Mr. Smile führte mich durch die alten, kalten, staubigen Gebäude voller toter Luft, mit rußigen Wänden und Außentoiletten mit Eimern in sechs Kabinen.“"
                            }
                        ],
