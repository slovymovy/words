                "senses": [
                    {
                        "sense_id": "f888c44e-fca3-37e7-b667-b285fc00ac30",
                        "entry_id": "d3d39b89-2ea8-3e66-914f-2f1d91a0cac3",
                        "glosses": [
                            "sessil auf dem Meeresboden oder planktonische lebende Tiere, die ihre Nahrung als Futterfiltrierer gewinnen. Ihr Körper ist von dem namengebenden Mantel aus einem Cellulose-ähnlichen Material umgeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a195ff6a-1d0f-45ea-a1b4-ea68cf691861",
                                "sense_id": "f888c44e-fca3-37e7-b667-b285fc00ac30",
                                "text": "Die Manteltiere sind ein Unterstamm der Chordatiere."
                            },
                            {
                                "example_id": "3718e049-a1b4-489a-9257-62cfc5ebf313",
                                "sense_id": "f888c44e-fca3-37e7-b667-b285fc00ac30",
                                "text": "Manteltiere leben als sessile Tiere auf dem Meeresboden wie die Seescheiden oder planktonisch wie die Salpen."
                            }
                        ],
