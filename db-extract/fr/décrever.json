                "senses": [
                    {
                        "sense_id": "90fb0404-d9c0-39b2-89c2-f6bd7bf1b359",
                        "entry_id": "d93ba625-59e8-35c9-bbb0-15b4ecc817e6",
                        "glosses": [
                            "Remettre en service (quelque chose qui a été crevé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea98a632-94cd-4814-85eb-f117214a1f87",
                                "sense_id": "90fb0404-d9c0-39b2-89c2-f6bd7bf1b359",
                                "text": "J’ai été détaché au garage où je devais “décrever” des roues."
                            },
                            {
                                "example_id": "5e42e0c9-701d-4010-adcf-3d393a3ffcef",
                                "sense_id": "90fb0404-d9c0-39b2-89c2-f6bd7bf1b359",
                                "text": "Il y a si longtemps que les hommes, usés les uns par les autres, ne savent plus se reconnaître ! Leur décrever les yeux, comme tu l’as dit, c’est leur faire une blessure."
                            },
                            {
                                "example_id": "b6d215a8-17ed-4fad-b91b-c17f803ac7e7",
                                "sense_id": "90fb0404-d9c0-39b2-89c2-f6bd7bf1b359",
                                "text": "Mais si je perds connaissance, qui va décrever l’œil du chat ?"
                            }
                        ]
                    }
