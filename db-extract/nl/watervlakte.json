                        "glosses": [
                            "een groot oppervlak water zoals bijv. een meer of een zee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4668d36a-5d08-4062-a9d4-9644a68fe488",
                                "sense_id": "3d0bc091-4548-31b0-a65d-2c81ccaeb11e",
                                "text": "Vorst Andrej leunde tegen de reling en keek zwijgend over de door het licht van de ondergaande zon glinsterende watervlakte."
                            },
                            {
                                "example_id": "5547aac0-111d-4997-9157-4d444641ab62",
                                "sense_id": "3d0bc091-4548-31b0-a65d-2c81ccaeb11e",
                                "text": "Zomerdijk kondigde destijds in de vroege ochtend van 1 februari een noodevacuatie van het Betuwse dorp af, nadat er scheuren waren geconstateerd in de Waalbandijk. Beelden van de burgemeester op de dijk, die nog net boven een immense watervlakte uit kwam, gingen de hele wereld over."
                            }
                        ]
                    }
