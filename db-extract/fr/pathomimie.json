                        "sense_id": "a22e1258-3e3d-3096-96f2-3e3a387586bf",
                        "entry_id": "30cfe214-553b-363d-933a-084108bdbdc5",
                        "glosses": [
                            "Trouble mental au cours duquel le sujet éprouve le besoin morbide de simuler une maladie en s'imposant des signes ou des symptômes, parfois en se mutilant."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e33f74b-eded-406e-9220-b9582bacf203",
                                "sense_id": "a22e1258-3e3d-3096-96f2-3e3a387586bf",
                                "text": "La présence ou l’absence de certains symptômes facilite la reconnaissance de la pathomimie, comme par exemple la persistance de la fièvre sans raison organique, l’absence d’une tachycardie, d’une chaleur cutanée ou de sueurs lors des poussées fébriles, l’atypicité du tracé de la courbe thermique."
                            }
                        ]
                    }
