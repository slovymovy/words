                    "sense_id": "a95154de-d501-3245-b5a2-b9c2171f3751",
                    "sense_definition": "Excellent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>swell</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>отлично</w> провели время на вечеринке вчера вечером."
