{
    "word_family": [
        "Antarctic",
        "subarctic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                    "sense_definition": "Pertaining to the northern polar region of the planet, characterized by extreme cold and an icy landscape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geo_region",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many unique animals, such as the polar bear, live in the <w>Arctic</w> environment.",
                            "target_lang_translations": {
                                "ru": "Многие уникальные животные, такие как белый медведь, обитают в <w>арктической</w> среде.",
                                "zh": "许多独特的动物，比如北极熊，都生活在<w>北极</w>环境中。"
                            }
                        },
                        {
                            "text": "The expedition team prepared for the harsh conditions of the <w>Arctic</w> circle.",
                            "target_lang_translations": {
                                "ru": "Экспедиционная группа готовилась к суровым условиям <w>Северного полярного</w> круга.",
                                "zh": "探险队为<w>北极</w>圈的恶劣条件做好了准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "polar",
                        "northern",
                        "hyperborean",
                        "frozen",
                        "icy"
                    ],
                    "antonyms": [
                        "Antarctic"
                    ],
                    "common_phrases": [
                        "Arctic Circle",
                        "Arctic Ocean",
                        "Arctic fox",
                        "Arctic hare"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к северному полярному региону планеты, характеризующийся сильным холодом и ледяным ландшафтом.",
                        "zh": "指地球北极地区，以极度寒冷和冰雪覆盖的地貌为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арктический",
                                "target_lang_sense_clarification": "относящийся к Арктике"
                            },
                            {
                                "target_lang_word": "полярный",
                                "target_lang_sense_clarification": "относящийся к полюсу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北极的",
                                "target_lang_sense_clarification": "指地理位置或环境"
                            },
                            {
                                "target_lang_word": "极地的",
                                "target_lang_sense_clarification": "指与极地相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "294a0a94-c37f-3f27-9adb-8155c4340948",
                    "sense_definition": "Extremely cold, snowy, or having other properties of extreme winter associated with the northern polar region.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please close the window because the air coming in is absolutely <w>arctic</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, закрой окно, потому что воздух снаружи просто <w>ледяной</w>.",
                                "zh": "请把窗户关上，进来的空气简直<w>冰冷</w>刺骨。"
                            }
                        },
                        {
                            "text": "We were not dressed warmly enough for the <w>arctic</w> weather that hit the city.",
                            "target_lang_translations": {
                                "ru": "Мы были недостаточно тепло одеты для <w>арктической</w> погоды, обрушившейся на город.",
                                "zh": "我们穿得不够暖和，无法应对袭击这座城市的<w>严寒</w>天气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freezing",
                        "frigid",
                        "glacial",
                        "icy",
                        "gelid"
                    ],
                    "antonyms": [
                        "tropical",
                        "hot",
                        "scorching",
                        "torrid"
                    ],
                    "common_phrases": [
                        "arctic weather",
                        "arctic conditions",
                        "arctic blast",
                        "arctic air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно холодный, морозный; обладающий свойствами суровой зимы.",
                        "zh": "形容极度寒冷、多雪，或具有北极地区那种严冬的特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледяной",
