                    {
                        "translation_id": "e4b9006c-c66d-4300-9189-b5be9e039e9b",
                        "source_entry_id": "4e3d5f9d-dd62-3773-8992-f1963a09e5df",
                        "source_sense_id": "e396e084-44ec-3378-9279-d6392d9dde95",
                        "source_sense_description": "wenn es keine andere Möglichkeit mehr gibt; als Notlösung; wenn es notwendig ist",
                        "target_lang_word": "au besoin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au besoin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a13114-b0ef-38ae-91e7-bd92ab8b3f70",
                                        "entry_id": "5087cc49-0deb-33f5-a6af-c9df68cd602c",
                                        "glosses": [
                                            "En cas de besoin ; si le besoin se fait sentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52319711-4885-47cc-b4d7-bffaefbff528",
                                                "sense_id": "c9a13114-b0ef-38ae-91e7-bd92ab8b3f70",
                                                "text": "Le mot d'ordre étant donné sur toute la ligne, on vous répondra ad rem, quelque saugrenues que puissent être vos questions. — Au besoin le télégraphe aura joué son rôle pour annoncer que le convoi transporte : un journaliste!"
                                            },
                                            {
                                                "example_id": "74147ad5-cc59-4c31-884e-cd2274da6ad2",
                                                "sense_id": "c9a13114-b0ef-38ae-91e7-bd92ab8b3f70",
                                                "text": "— Eh ! bon Dieu, que vous êtes devenu sentimental ! C’est l’ombrage de ces arbres qui a produit cet effet, leur parfum, leur fraîcheur. Comment donc les appelez-vous, que je retienne leur nom pour en user au besoin ?"
                                            },
                                            {
                                                "example_id": "f4735d35-7aaa-4d26-a49a-66ed736824fa",
                                                "sense_id": "c9a13114-b0ef-38ae-91e7-bd92ab8b3f70",
                                                "text": "L'artiste ne demandait qu'à voir cet homme. Il exigeait même, au besoin, qu'on allât le chercher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7455909e-8600-34f0-a597-4e2e52ffaf8b",
                                        "entry_id": "5087cc49-0deb-33f5-a6af-c9df68cd602c",
                                        "glosses": [
                                            "Faute de mieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc654feb-e5fc-44b0-a1cd-eed39eb87557",
                                                "sense_id": "7455909e-8600-34f0-a597-4e2e52ffaf8b",
                                                "text": "Au besoin nous pourrons nous servir de cela. — Cela peut suffire, au besoin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
