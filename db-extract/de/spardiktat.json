                "senses": [
                    {
                        "sense_id": "cfd7d9ca-ea89-3a32-9d5d-295d799a19ed",
                        "entry_id": "45160300-8e6c-33ac-a746-7f73f8c1a20c",
                        "glosses": [
                            "von jemandem auferlegte Pflicht, weniger Geld auszugeben; Vorgabe, weniger Geld auszugeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c50d96-57cc-4998-a889-10cec00e9fc3",
                                "sense_id": "cfd7d9ca-ea89-3a32-9d5d-295d799a19ed",
                                "text": "„Nach einem Zwischenstopp in Deutschland wollte ich 2015 nach Athen und darüber berichten, wie das rigide Spardiktat die dortige Gesellschaft zerstörte.“"
                            },
                            {
                                "example_id": "c49bfda6-49d1-4061-80c4-901d020bdbd6",
                                "sense_id": "cfd7d9ca-ea89-3a32-9d5d-295d799a19ed",
                                "text": "„Mit seinem Hang zum Spardiktat stieß der Christdemokrat zwar auf reichlich Kritik, zugleich genoss Schäuble aber bei ausländischen Verhandlungspartnern viel Respekt und erreichte in Deutschland hohe Beliebtheitswerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
