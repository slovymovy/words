                                "target_senses": [
                                    {
                                        "sense_id": "83493997-e8fc-34fb-b1d5-54890e8505c7",
                                        "entry_id": "93fd794d-5a2c-39f1-b1fe-279840b18287",
                                        "glosses": [
                                            "in einem an Safran erinnernden Gelbton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08aaa46b-5571-48bc-bf56-a75c1bd1ee09",
                                                "sense_id": "83493997-e8fc-34fb-b1d5-54890e8505c7",
                                                "text": "„Von der Vegetation unter uns gewannen wir nur eine vage Vorstellung. Sie zog als verschwommene Masse aus blaugrünen und weißlich-grünen Farben, verwaschen-violetten und safrangelben Tönen mit jadefarbenen Schattierungen unter uns vorüber.“"
                                            },
                                            {
                                                "example_id": "c63cc00e-21e7-43b6-904b-4d21151545fb",
                                                "sense_id": "83493997-e8fc-34fb-b1d5-54890e8505c7",
                                                "text": "„Ein Mann in safrangelbem Gewand saß auf einem Podium vor Hanuman, und sein Vortrag war fließend und kraftvoll, die alte Geschichte von Bali und Sugriv, der Konflikt, die Herausforderung, das Duell, und die im Dschungel lauernden Götter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
