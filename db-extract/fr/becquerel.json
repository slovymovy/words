            },
            {
                "entry_id": "9c0c3fd3-ccf7-3111-a5e1-c444959fba3d",
                "word": "becquerel",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "59682ed0-5a7d-493e-9348-3eb9a7f65d79",
                        "entry_id": "9c0c3fd3-ccf7-3111-a5e1-c444959fba3d",
                        "tags": [
                            "plural"
                        ],
                        "form": "becquerels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96a0edb5-4d1f-3dd9-a88d-580bd9f4bbac",
                        "entry_id": "9c0c3fd3-ccf7-3111-a5e1-c444959fba3d",
                        "glosses": [
                            "Unité de mesure d’activité des radionucléides du Système international, égale à une désintégration par seconde, et dont le symbole est Bq."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "475200cf-b2e1-4411-bd8e-dd72993c9298",
                                "sense_id": "96a0edb5-4d1f-3dd9-a88d-580bd9f4bbac",
                                "text": "Le SCPRI s’obstine à compter en curies, unité remplacée aujourd'hui par le becquerel (1 becquerel = 27 picocuries)."
                            },
                            {
                                "example_id": "8dde6d92-7422-4e22-9ad8-282fd1207cce",
                                "sense_id": "96a0edb5-4d1f-3dd9-a88d-580bd9f4bbac",
                                "text": "En effet, 17 % des maisons testées dépassent la norme canadienne, qui est de 200 becquerels par mètre cube."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "864a8c15-cc6f-499a-8636-bf83103776ce",
                        "source_entry_id": "9c0c3fd3-ccf7-3111-a5e1-c444959fba3d",
                        "source_sense_id": "96a0edb5-4d1f-3dd9-a88d-580bd9f4bbac",
                        "source_sense_description": "Unité de mesure d’activité des rationucléides",
                        "target_lang_word": "Becquerel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Becquerel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                                        "entry_id": "053a7f0f-2d0e-31f1-b86c-2a3aadbf5fb9",
                                        "glosses": [
                                            "seit 1975 abgeleitete SI-Einheit der Radioaktivität; gibt die mittlere Anzahl der Atomkerne an, die pro Sekunde radioaktiv zerfallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "981858b4-f6b1-4049-a955-143969cd04e0",
                                                "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                                                "text": "„Angegeben wird die Aktivität üblicherweise in der SI-Einheit Becquerel (Bq), ein Becquerel entspricht einem Zerfall pro Sekunde.“"
                                            },
                                            {
                                                "example_id": "bc05dbbf-a40c-4fb4-a1db-4aba0d334cff",
                                                "sense_id": "d9f841b8-bbbf-37ee-ae64-2ae440f0cc6e",
                                                "text": "„Die Belastung der Maronen-Röhrlinge mit radioaktivem ¹³⁷Cs liegt auch 20 Jahre nach dem Reaktorunglück von Tschernobyl gebietsweise über dem EU-Grenzwert für Lebensmittel von 600 Becquerel pro Kilogramm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
