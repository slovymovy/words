                                        "entry_id": "bdb51236-4474-3196-bb9c-234f1e9b47b2",
                                        "glosses": [
                                            "eine Vogelart aus der Gattung der echten Drosseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c2f174-2181-4165-a691-bcca5d4d66f9",
                                                "sense_id": "333b2fe7-b016-367b-b5fd-42b78701e079",
                                                "text": "Im Winter sieht man Wacholderdrosseln oft in großen Schwärmen."
                                            }
