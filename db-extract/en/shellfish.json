                    },
                    {
                        "translation_id": "508742d6-55be-491d-9a43-e85caef996b0",
                        "source_entry_id": "4dea8cc1-e806-347a-9925-ac6809334d81",
                        "source_sense_description": "aquatic food that has a shell",
                        "target_lang_word": "coquillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coquillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e743259-ae0f-335a-95d0-cb49143bd71c",
                                        "entry_id": "524759b0-d5e7-36c8-917e-dd03943852a5",
                                        "glosses": [
                                            "Tout mollusque marin dont le corps est enveloppé dans une coquille."
                                        ],
                                        "tags": [],
                                        "note": "Il désigne généralement des animaux pêchés sur le rivage à basse mer. — Note d’usage : Le terme est alors le plus souvent utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "58c03966-930c-422f-bc07-1eae2c2d5f87",
                                                "sense_id": "1e743259-ae0f-335a-95d0-cb49143bd71c",
                                                "text": "Il mangeait les coquillages crus ; les coquillages sont, dans une certaine mesure, désaltérants."
                                            },
                                            {
                                                "example_id": "0f615cb1-4650-469e-9b5b-5fffd67d30b9",
                                                "sense_id": "1e743259-ae0f-335a-95d0-cb49143bd71c",
                                                "text": "L’industrie tire encore des fils pour tissus du fond des mers dont le plus remarquable est le tissu fabriqué à l’aide du « byssus » d’un coquillage appelé « Pinna » et qui se rencontre dans la Méditerranée."
                                            },
                                            {
                                                "example_id": "c7ba3c3c-57a4-4e7e-8bc0-3583f552fcd2",
                                                "sense_id": "1e743259-ae0f-335a-95d0-cb49143bd71c",
                                                "text": "Ça me rappelle le vieux port marseillais, les marchandes de coquillages, les pieds-paquets et le vin de Cassis, doré comme du soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb8bf44-02ab-33cf-8f30-e36bbdc9a99d",
                                        "entry_id": "524759b0-d5e7-36c8-917e-dd03943852a5",
                                        "glosses": [
                                            "La coquille du mollusque elle-même, voire la valve isolée d’une coquille de bivalve."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab80d137-5c21-4780-97bb-8ba4034968c8",
                                                "sense_id": "6cb8bf44-02ab-33cf-8f30-e36bbdc9a99d",
                                                "text": "Après le repas, plusieurs cadeaux me furent présentés, notamment des nacres, des coquillages et plusieurs chapeaux tressés en paille de pandanus."
                                            },
                                            {
                                                "example_id": "56c5caf1-5808-4d02-ae04-c9b57c7e7d35",
                                                "sense_id": "6cb8bf44-02ab-33cf-8f30-e36bbdc9a99d",
                                                "text": "Les peuples préhistoriques ont eu des conventions monétaires, de coquillages, pierres, pépites ou lingots de métaux précieux, de valeur intrinsèque relative constante, pour acheter des objets moins portatifs dont le possesseur était titulaire. C’était des constitutions financières démocratiques de l’âge d’or."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e5b9592-68d7-3d31-94f8-deaa80278581",
                                        "entry_id": "524759b0-d5e7-36c8-917e-dd03943852a5",
                                        "glosses": [
                                            "Vulve, sexe des femmes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e9ad212-1c85-4f65-b55c-3efe141dc30a",
                                                "sense_id": "9e5b9592-68d7-3d31-94f8-deaa80278581",
                                                "text": "Chaque coquillage incrusté\nDans la grotte où nous nous aimâmes\nA sa particularité\n…\nMais un, entre autres, me troubla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aef10242-f171-4e78-a9cd-28b9468b3a2d",
                        "source_entry_id": "4dea8cc1-e806-347a-9925-ac6809334d81",
