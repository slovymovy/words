                "senses": [
                    {
                        "sense_id": "11e3ba09-80f4-36e6-b955-3d026262d124",
                        "entry_id": "0787f189-58b8-399d-bea7-5d96882d0ccc",
                        "glosses": [
                            "Donner un caractère ferrique, ou apporter du fer, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d7cd67-8691-41ea-aac2-d52aa8d88831",
                                "sense_id": "11e3ba09-80f4-36e6-b955-3d026262d124",
                                "text": "Toute la matinée à pomper pour avoir de la pression et sulfater, enfin ferriser, les vignes."
                            },
                            {
                                "example_id": "1f783d67-d1be-4ce2-9e94-f49bde5b78bc",
                                "sense_id": "11e3ba09-80f4-36e6-b955-3d026262d124",
                                "text": "Ainsi, la destruction partielle de la structure micronodulaire et la mobilisation limitée de l’argile ferrisée résulteraient essentiellement de l’action de contraintes hydriques extrêmes, dues à l’alternance de fortes dessiccations et d’humectations."
                            },
                            {
                                "example_id": "86c4e9ac-b58a-4e0f-a6ec-8a7ab9a5286c",
                                "sense_id": "11e3ba09-80f4-36e6-b955-3d026262d124",
                                "text": "j'ai un forage, et mon eau sort \"ferrisée\"."
                            },
                            {
                                "example_id": "3e3e21e9-6133-4b8c-ba9d-6ded9c9709fe",
                                "sense_id": "11e3ba09-80f4-36e6-b955-3d026262d124",
                                "text": "Je vais essayer de me \"ferriser\" avant d'aller courir."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ffd7b22-bae8-3dc8-aa48-ac493dcc05dc",
                        "entry_id": "0787f189-58b8-399d-bea7-5d96882d0ccc",
                        "glosses": [
                            "Croiser le fer. (sens à vérifier)"
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "609926e7-8da0-40ae-94d9-c64992547e3b",
                                "sense_id": "8ffd7b22-bae8-3dc8-aa48-ac493dcc05dc",
                                "text": "affirmations contestables, m'enfin, on va encore ferriser pendant des heures..."
                            }
                        ]
                    }
