                                "example_id": "d1558c72-c1a0-471e-8f0e-9ae80ea49fd6",
                                "sense_id": "544396f2-a601-32db-bfff-900fc70ec4f9",
                                "text": "„Im privaten Bankgewerbe gab es zwar vereinzelte Solidaraktionen zur Abwendung von Insolvenzfolgen.“"
                            },
