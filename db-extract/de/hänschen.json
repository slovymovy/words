                    },
                    {
                        "translation_id": "b8485729-b1c2-4969-b462-07b07f50ed55",
                        "source_entry_id": "f042d2ef-cf0d-30ab-9846-1109f33ddf59",
                        "source_sense_id": "2037507a-3aa4-3129-9f74-cda5ccbf79d3",
                        "source_sense_description": "Koseform, Diminutiv: deutscher Vorname",
                        "target_lang_word": "Honzík",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Honzík",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "836e3be1-2d35-3f28-a6ed-c45849b5b7e6",
                                        "entry_id": "0bb840bf-7b2d-34e9-af7a-41292ba6efaf",
                                        "glosses": [
                                            "Jan"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "010c179d-ae83-47b6-8d7d-516ad852bfc2",
                                                "sense_id": "836e3be1-2d35-3f28-a6ed-c45849b5b7e6",
                                                "text": "Ale tam stál Honzík, pasák Frantíkův, se svižným prutem, a poněvadž páni kluci věděli, že s Honzíkem a s prutem nejsou žerty, zůstali raději v slušné vzdálenosti."
                                            },
                                            {
                                                "example_id": "31bab205-befc-4a59-a674-0ff4a05aa6b4",
                                                "sense_id": "836e3be1-2d35-3f28-a6ed-c45849b5b7e6",
                                                "text": "Honzík je běžně používaná zdrobnělina jména Jan."
                                            },
                                            {
                                                "example_id": "ef29bb2e-5a47-409c-9364-1bed30ef6904",
                                                "sense_id": "836e3be1-2d35-3f28-a6ed-c45849b5b7e6",
                                                "text": "Psisko bláznilo; kousalo s překypující něhou Prokopovy ruce, pištělo, funělo, a tumáš! morkou mordou se mu dostalo až na prsa. „Honzíku,“ křičela dívka, „ty jsi blázen! Necháš pána!“ Přiběhla k posteli a vzala psíka do náruče. „Bože, Honzíku, ty jsi hlupák!“ „Nechte ho,“ žádal Prokop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
