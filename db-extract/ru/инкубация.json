                "senses": [
                    {
                        "sense_id": "860ed822-4354-3080-aa06-5b3409d78b81",
                        "entry_id": "127da94a-ef60-387f-8167-5a2f8b5fd798",
                        "glosses": [
                            "естественный процесс развития яйцекладущих животных (птиц, земноводных, пресмыкающихся, ящериц, простейших, червей и т. п. представителей животного мира) от кладки яиц, икры и/или спор, до появления выводка, протекающий при определённых температурных и иных климатических условиях или в искусственно созданной человеком среде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e6c885-56d1-4f9a-90c7-8ba1584bfb01",
                                "sense_id": "860ed822-4354-3080-aa06-5b3409d78b81",
                                "text": "После инкубации такую суспензию пропускают через проточный цитофлуориметр."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81891e0e-358d-4e02-a1d9-ed8b18cad2d7",
                        "source_entry_id": "127da94a-ef60-387f-8167-5a2f8b5fd798",
                        "source_sense_id": "860ed822-4354-3080-aa06-5b3409d78b81",
                        "target_lang_word": "incubation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incubation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b3d222b-29c0-31bc-b955-3a7269030fbe",
                                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
                                        "glosses": [
                                            "Sitting on eggs for the purpose of hatching young; a brooding on, or keeping warm, to develop the life within, by any process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91463519-12d7-3024-80e6-a1d4a75eb225",
                                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
                                        "glosses": [
                                            "The development of a disease from its causes, or the period of such development."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3815870e-73d9-4e20-934b-7730823fbdfe",
                                                "sense_id": "91463519-12d7-3024-80e6-a1d4a75eb225",
                                                "text": "1829, A Practical Synopsis of Cutaneous Diseases\nThe course of small-pox, whether distinct or confluent, may be divided into five stages, which are known under the names of incubation, invasion, eruption, suppuration, and desiccation. This division, founded on the most prominent symptoms that the disease presents, although it is an arbitrary one, still affords a facility in the study. The period of incubation comprises the interval of time that elapses from the infection to the beginning of the attack; its duration is from six to twenty days. It is not designated by any visible symptom, as the individual apparently continues in good health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad510967-6f42-3c1c-9e68-2eb85feabbbf",
                                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
                                        "glosses": [
                                            "A period of little reaction which is followed by more rapid reaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b01ddbf-2ac1-3ef7-a783-cd37b2af0951",
                                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
                                        "glosses": [
                                            "One of the four proposed stages of creativity (preparation, incubation, illumination, and verification): the unconscious recombination of thought elements that were stimulated through conscious work at one point in time, resulting in novel ideas at a later point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35481ee2-a2d7-342a-99ac-cf853f41c652",
                                        "entry_id": "4bba5baf-cf66-3dab-b280-6c5b9b3ed383",
                                        "glosses": [
                                            "Sleeping in a temple or other holy place in order to have oracular dreams or to receive healing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e997bff2-b7c8-44c6-a61f-8418fe5ba313",
                                                "sense_id": "35481ee2-a2d7-342a-99ac-cf853f41c652",
                                                "text": "Incubation in the vicinity of burial places, cremation grounds, holy wells and sacred streams was common. The ancient Hebrews visited vaults or slept among tombs to get meaningful dreams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
