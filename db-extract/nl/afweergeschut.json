                    {
                        "sense_id": "b48712e3-bfb3-3f7a-ad49-f9a73ff9ae82",
                        "entry_id": "ad4c5256-ba6d-3361-8478-28266118da8e",
                        "glosses": [
                            "verzamelterm voor vuurwapens waarmee verdedigers aanvallende vliegtuigen kunnen bestoken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27521e9-72cc-403a-94b2-f256cbe3c5cb",
                                "sense_id": "b48712e3-bfb3-3f7a-ad49-f9a73ff9ae82",
                                "text": "Het afweergeschut was niet goed geregeld, waardoor de oorlog werd verloren."
                            },
                            {
                                "example_id": "4579b502-9168-4053-bc4e-e40cea2db4df",
                                "sense_id": "b48712e3-bfb3-3f7a-ad49-f9a73ff9ae82",
                                "text": "Ik hoor weer hoe een luchtalarm klinkt, hoe afweergeschut klinkt, vliegtuigen die laag overkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bed624d-dfa3-4522-b5d2-42199afe268d",
                        "source_entry_id": "ad4c5256-ba6d-3361-8478-28266118da8e",
                        "source_sense_id": "b48712e3-bfb3-3f7a-ad49-f9a73ff9ae82",
                        "source_sense_description": "verzamelterm voor vuurwapens waarmee verdedigers aanvallende vliegtuigen kunnen bestoken",
                        "target_lang_word": "Flugabwehrkanone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugabwehrkanone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dddf3da2-3711-3251-ae6f-1a96dde4a1f0",
                                        "entry_id": "b02738d3-1ce8-3645-ba53-c45cf17db483",
                                        "glosses": [
                                            "Geschütz, das gegen angreifende Flugzeuge eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70f2a29-6b54-434e-99a6-188372d7efbb",
                                                "sense_id": "dddf3da2-3711-3251-ae6f-1a96dde4a1f0",
                                                "text": "Durch das Abwehrfeuer der Flugabwehrkanonen wurden die feindlichen Flugzeuge zum Abdrehen gezwungen."
                                            },
                                            {
                                                "example_id": "e620fd17-8a73-457d-b307-bf225f15db79",
                                                "sense_id": "dddf3da2-3711-3251-ae6f-1a96dde4a1f0",
                                                "text": "„Und in der Tat konnte die bei den alliierten Soldaten gefürchtete 88-Millimeter-Kanone, die sowohl im deutschen Tiger-Panzer als auch als ursprünglich konzipierte Flugabwehrkanone zur Panzerabwehr eingesetzt wurde, im Sommer 1944 jedes gepanzerte Fahrzeug von Amerikanern, Briten und Kanadiern ausschalten, bevor diese überhaupt in Schussweite kamen.“"
                                            },
                                            {
                                                "example_id": "1d7b73f4-3b74-409a-affa-41477ee2563f",
                                                "sense_id": "dddf3da2-3711-3251-ae6f-1a96dde4a1f0",
                                                "text": "„Einen Algorithmus zur Steuerung einer Flugabwehrkanone, der die messbaren Daten des bisherigen Flugverhaltens nutzt, um vorauszusagen, wie sich der Pilot in den nächsten Sekunden verhalten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
