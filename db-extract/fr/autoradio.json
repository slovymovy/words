                    }
                ],
                "senses": [
                    {
                        "sense_id": "039b9086-41f0-3d33-95d7-89a33e7b671b",
                        "entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
                        "glosses": [
                            "Poste de radio conçu pour fonctionner à bord d’une automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d296df-2b3d-49a2-a6a3-8367ec0dc101",
                                "sense_id": "039b9086-41f0-3d33-95d7-89a33e7b671b",
                                "text": "C’est pas de ma faute si je n’ai pas les moyens, moi, de m’offrir un autoradio…"
                            },
                            {
                                "example_id": "2c0bfb54-a159-40ec-b7a0-bd1215ebb9ea",
                                "sense_id": "039b9086-41f0-3d33-95d7-89a33e7b671b",
                                "text": "Lors d’une révision un client demande à profiter de l'arrêt du véhicule pour changer son autoradio."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48449266-8f34-4986-b3d1-c3d6a093668b",
                        "source_entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
                        "source_sense_id": "039b9086-41f0-3d33-95d7-89a33e7b671b",
                        "target_lang_word": "Autoradio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autoradio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                        "entry_id": "e37bbd16-b59a-32b8-a560-9ffc219c272f",
                                        "glosses": [
                                            "Radio, das in einem Auto eingebaut ist oder eingebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df98673-ce02-460e-ac00-f7c535bcd239",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "Mir wurde das Autoradio gestohlen."
                                            },
                                            {
                                                "example_id": "cbd33f54-c0d3-456c-871d-f2e5764b8a20",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "„Er lachte voller Selbstironie und fummelte dann an den Knöpfen des Autoradios herum.“"
                                            },
                                            {
                                                "example_id": "911f5f42-a6a9-4a36-bd51-03253d917e9b",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "„Da dieser aufgeregte lange Kerl immer noch hinter ihm stand und ihm etwas ins Ohr brüllte, stellte er den Autoradio ein, und eine tiefe Männerstimme begann zu singen: «Ach, ich hab' sie ja nur auf die Schulter geküsst.»“"
                                            },
                                            {
                                                "example_id": "75d490fa-93d8-4271-8d53-ecd86d38a9da",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "„An einen Autoradio zu denken, wäre damals für Kleinwagenfahrer Vermessenheit gewesen.“"
                                            },
                                            {
                                                "example_id": "59b529c9-e087-4e0b-b7e8-1e4ade6dfa28",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "„Ich drückte den Zigarettenanzünder rein, steckte mir eine zwischen die Lippen und knipste das Autoradio an.“"
                                            },
                                            {
                                                "example_id": "b5424d9c-4614-4903-b152-31ce25ce0461",
                                                "sense_id": "f8c96af8-2ff5-326e-a7eb-cb81c8e21bfd",
                                                "text": "„Alice suchte einen Sender im Autoradio, und Ferris wagte kaum, zu ihr hinüberzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d6f97f1-700c-47e2-8f6f-d1ec8019f62c",
                        "source_entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
                        "source_sense_id": "039b9086-41f0-3d33-95d7-89a33e7b671b",
                        "target_lang_word": "car radio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car radio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80be04eb-52ee-366f-b85f-43d21b874c5a",
                                        "entry_id": "ab02e522-3bfd-330d-9fb8-7f7af253e1a7",
                                        "glosses": [
                                            "A radio receiver fitted in a car, typically on or just below the dashboard, sometimes with specific features for use while driving, such as traffic alert interrupts and alternative frequency functions (switching frequencies as one moves in and out of range of transmitters)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86fa384d-c3e0-3f23-a78f-82d355cce02e",
                                        "entry_id": "ab02e522-3bfd-330d-9fb8-7f7af253e1a7",
                                        "glosses": [
                                            "An on-board entertainment system in a car, usually including a radio receiver as well as the capability to play audio from recorded media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42f6e71-1f64-4034-b517-1b7839f4ed3a",
                                                "sense_id": "86fa384d-c3e0-3f23-a78f-82d355cce02e",
                                                "text": "If you’ve ever turned the key in your ignition and noticed that your car radio isn’t tuning in to your favourite station or playing your carefully curated playlist, the problem could be a security code. A car radio code is a password to access your vehicle's audio system - a combination of button presses designed to deter thieves from stealing your radio and using it in another vehicle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b638826-7949-4806-afc1-607722ab16e9",
                        "source_entry_id": "26101024-ae1f-329d-88ba-805aa50abf36",
