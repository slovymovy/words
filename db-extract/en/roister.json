                ],
                "senses": [
                    {
                        "sense_id": "9116f28c-5663-3280-9318-29dce7c2d025",
                        "entry_id": "de783baa-da88-37f3-aae5-9d6e99fb5ff7",
                        "glosses": [
                            "A roisterer."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "af82f55e-ddad-479e-8e17-bb77bc5a1cfc",
                                "sense_id": "9116f28c-5663-3280-9318-29dce7c2d025",
                                "text": "He now suspected that the grave roysters of the mountain had put a trick on him, and having dosed him with liquor, had robbed him of his gun."
                            },
                            {
                                "example_id": "1cae55de-410f-493e-b172-7764b78ee211",
                                "sense_id": "9116f28c-5663-3280-9318-29dce7c2d025",
                                "text": "The youth who had joined the roisters, was apparently about eighteen[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7da38c5-b560-3a76-baa0-be08996b68cc",
                        "entry_id": "de783baa-da88-37f3-aae5-9d6e99fb5ff7",
                        "glosses": [
                            "A session of noisy, drunken, or riotous behaviour."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "49b179e5-42b5-4d8f-8ce4-9267ad51f98a",
                                "sense_id": "c7da38c5-b560-3a76-baa0-be08996b68cc",
                                "text": "The servants went out on the roister after getting paid."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
