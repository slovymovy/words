                "senses": [
                    {
                        "sense_id": "3fbdd54f-b2b3-3dd4-b4bf-b805e50b1efc",
                        "entry_id": "c594b7c5-ef2b-3a09-abd0-c09cd660c576",
                        "glosses": [
                            "Relating to or characteristic of a biome or biomes."
                        ],
                        "tags": [
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "67d3d321-c217-4c46-bd6a-c378ba12b4f7",
                                "sense_id": "3fbdd54f-b2b3-3dd4-b4bf-b805e50b1efc",
                                "text": "I know this may seem like an obvious no, but with the newest Star Wars movie just released, there is a mineral-rich planet called Crait which I have seen make a few debates about whether or not this is single-biomed or not?"
                            },
                            {
                                "example_id": "11e15f8b-5274-4b7d-9688-6276e7b605f4",
                                "sense_id": "3fbdd54f-b2b3-3dd4-b4bf-b805e50b1efc",
                                "text": "Biomed Lava\nThis pack changes the color of lava depending on the biome! This will dynamically change the color of lava depending on the biome."
                            },
                            {
                                "example_id": "1a2a72f0-bdda-4cb2-a64a-5737a98c0a47",
                                "sense_id": "3fbdd54f-b2b3-3dd4-b4bf-b805e50b1efc",
                                "text": "It’s also true during the colonization of the universe some planets had special materials that could only be found on that world which prompted colonization of an otherwise devoid and single biomed world (think of a comparison to Araxus in Dune)."
                            },
                            {
                                "example_id": "235aeadb-8f25-43ff-889d-5e400f16ba28",
                                "sense_id": "3fbdd54f-b2b3-3dd4-b4bf-b805e50b1efc",
                                "text": "Multi-biomed superflat in vanilla?\n Is there a way to make a superflat world that generates all biomes and structures without using mods, perhaps with datapacks?"
                            }
                        ]
                    }
                ],
