                        ]
                    },
                    {
                        "translation_id": "e20a8f54-1bf8-4dab-8388-ed3d15c774dd",
                        "source_entry_id": "6f8df1f6-42f7-334f-bfa4-5c167315914d",
                        "source_sense_id": "b655865d-9b77-3121-b6c6-5e473c0cf513",
                        "source_sense_description": "die Eigenschaft, bieder zu sein",
                        "target_lang_word": "порядочность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "порядочность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5db0a6-dac4-3ad8-9075-2992778749d1",
                                        "entry_id": "9f8a388f-4c24-3775-90ca-d80a7a224472",
                                        "glosses": [
                                            "свойство по значению прилагательного порядочный; честность, неспособность к низким поступкам, соблюдение этических принципов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dde2c44-9740-4222-84e3-3efe113e6357",
                                                "sense_id": "dd5db0a6-dac4-3ad8-9075-2992778749d1",
                                                "text": "Возможно, он действительно хотел усовершенствовать социализм, придать ему хотя бы порядочность…"
                                            },
                                            {
                                                "example_id": "7e9d7282-4dc2-4336-a06d-e59c0ba72d5e",
                                                "sense_id": "dd5db0a6-dac4-3ad8-9075-2992778749d1",
                                                "text": "Здесь хранились копии заявлений, которые я посылала в Комиссариат внутренних дел, доказательства невиновности Андрея, свидетельства его порядочности и нравственной чистоты."
                                            },
                                            {
                                                "example_id": "eaafa779-27ed-43e1-98fc-cdededfb38b1",
                                                "sense_id": "dd5db0a6-dac4-3ad8-9075-2992778749d1",
                                                "text": "Как видите, я полностью полагаюсь на вашу порядочность."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ce3a46-0a91-36b6-8b7a-11631e0615b7",
                                        "entry_id": "9f8a388f-4c24-3775-90ca-d80a7a224472",
                                        "glosses": [
                                            "устар. упорядоченность, проявление порядка в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c9f40a-1535-4b13-a94e-4f67633c9cca",
                                                "sense_id": "a8ce3a46-0a91-36b6-8b7a-11631e0615b7",
                                                "text": "Вообще, во всем этом обиходе домашней жизни молодого человека была заметна порядочность и некоторое стремление к роскоши и щегольству."
                                            },
                                            {
                                                "example_id": "6d897300-79a1-4147-8e87-f413f88b2d3e",
                                                "sense_id": "a8ce3a46-0a91-36b6-8b7a-11631e0615b7",
                                                "text": "Рассчитанная порядочность немецкой школы, казарменная дисциплина французской коллегии совершенно не похожи на тот характер старых английских школ, который живет, кажется, как домовой, в стенах заведения и равно подчиняет себе учеников, наставников и даже прислугу."
                                            },
                                            {
                                                "example_id": "33c4b3e3-54ba-4724-9d45-bda2c64dbb76",
                                                "sense_id": "a8ce3a46-0a91-36b6-8b7a-11631e0615b7",
                                                "text": "В их нравах была некоторая сдержанность, а в домашней обстановке ― стремление к порядочности и комфорту."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
