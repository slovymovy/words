                "senses": [
                    {
                        "sense_id": "37dbf9ab-9bc6-3475-8bcf-167be7cbd190",
                        "entry_id": "9aa726e2-5113-313c-b3fb-74d0db0eb887",
                        "glosses": [
                            "to forbid, to ban"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ff9deaa0-5e5a-3c97-80e8-f8681fb27878",
                        "entry_id": "9aa726e2-5113-313c-b3fb-74d0db0eb887",
                        "glosses": [
                            "to hinder, to oppose"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "27bfe55f-f2f7-4c0e-845c-9dc70a6bf97c",
                                "sense_id": "ff9deaa0-5e5a-3c97-80e8-f8681fb27878",
                                "text": "Угожда́я Персам, благоразумно ли бы́ло прети́ть Македонянам?",
                                "translation": "When pleasing the Persians, was it judicious to oppose the Macedonians?",
                                "english": "When pleasing the Persians, was it judicious to oppose the Macedonians?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e0fc48d1-ec43-3044-a525-3f34771cebb2",
                        "entry_id": "9aa726e2-5113-313c-b3fb-74d0db0eb887",
                        "glosses": [
                            "to sicken, to disgust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0c7db1-4740-45f2-b72c-5d1050a607f0",
                                "sense_id": "e0fc48d1-ec43-3044-a525-3f34771cebb2",
                                "text": "мне прети́т лесть",
                                "translation": "flattery disgusts/sickens me; I can't stand flattery",
                                "english": "flattery disgusts/sickens me; I can't stand flattery"
                            },
                            {
                                "example_id": "d37168cd-0c9f-4ca9-82db-1f4cd369600b",
                                "sense_id": "e0fc48d1-ec43-3044-a525-3f34771cebb2",
                                "text": "ему́ прети́ло быть у неё на побегу́шках",
                                "translation": "he was sick of being an errand boy for her",
                                "english": "he was sick of being an errand boy for her"
                            },
                            {
                                "example_id": "11cbe678-744f-4870-ac10-5f75fdd0aa08",
                                "sense_id": "e0fc48d1-ec43-3044-a525-3f34771cebb2",
                                "text": "Сего́дня весь день бо́лен. На ветчину́ и гляде́ть не могу́ — прети́т, но во́дка пьётся.",
                                "translation": "Nikolai Leykin",
                                "english": "Nikolai Leykin"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
