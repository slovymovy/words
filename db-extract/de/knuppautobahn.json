                "senses": [
                    {
                        "sense_id": "4b62026f-8aa4-35c8-b4d0-985e397db1f0",
                        "entry_id": "6744c666-c881-3e03-bfc1-59693b4475bc",
                        "glosses": [
                            "Fahrbahn für Knuppautos (Autoskooter)"
                        ],
                        "tags": [
                            "westmitteldeutsch",
                            "(Moselgebiet)",
                            "Luxemburg"
                        ],
                        "examples": [
                            {
                                "example_id": "8cc7c05c-9c86-40c1-ad62-8801781f7637",
                                "sense_id": "4b62026f-8aa4-35c8-b4d0-985e397db1f0",
                                "text": "„Die Premiere kam letztes Jahr so gut an, dass der Festgottesdienst am Sonntag wieder auf der „Knuppautobahn“ stattfindet.“"
                            },
                            {
                                "example_id": "b39340cb-79a3-4239-99f2-5877aecd9a90",
                                "sense_id": "4b62026f-8aa4-35c8-b4d0-985e397db1f0",
                                "text": "„Fremde Männer kommen mit ihren Lastwagen angefahren und bauen den Traum eines jeden Jungen mit Matchboxbenzin im Blut auf dem Dorfplatz auf: die Knuppautobahn.“"
                            },
                            {
                                "example_id": "1ce13b16-0904-425f-b899-9c3755239555",
                                "sense_id": "4b62026f-8aa4-35c8-b4d0-985e397db1f0",
                                "text": "„Eine Neuerung ist, dass der Festgottesdienst am Sonntag auf der \"Knuppautobahn\" stattfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
