                "senses": [
                    {
                        "sense_id": "98e197cc-1ba7-3939-b428-5f75d19ee8a8",
                        "entry_id": "d364759d-88ee-3e3a-9964-28afe04b708d",
                        "glosses": [
                            "ringvormig vlechtwerk van bloemen als eerbetoon of versiering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc14271d-7b8f-4459-8dbd-d1d30cd252b8",
                                "sense_id": "98e197cc-1ba7-3939-b428-5f75d19ee8a8",
                                "text": "In 'Bella en de beer' (…) is de schone een typische jugendstil-vrouw met een bloemenkrans in haar lange, blonde haar en een sierlijk gedrapeerde jurk."
                            },
                            {
                                "example_id": "a55ee90c-309a-4eb3-8e35-cd77942f8bad",
                                "sense_id": "98e197cc-1ba7-3939-b428-5f75d19ee8a8",
                                "text": "De Koning, de Koningin en de overige leden van de Familie verlieten het gloednieuwe gebouw langs de gerestaureerde kapel van Nassau om enkele meters lager en verder een bloemenkrans neer te leggen voor het standbeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c5b0f66-0cb1-48e6-8fdc-4a8a9f654288",
                        "source_entry_id": "d364759d-88ee-3e3a-9964-28afe04b708d",
                        "source_sense_id": "98e197cc-1ba7-3939-b428-5f75d19ee8a8",
                        "source_sense_description": "ringvormig vlechtwerk van bloemen",
                        "target_lang_word": "Blumenkranz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blumenkranz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                        "entry_id": "42bc0973-ffed-3638-8084-730950e1678d",
                                        "glosses": [
                                            "rund geformtes Gebinde aus Blumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ede3b6-0fc1-49df-809c-d9ae2ab90c38",
                                                "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                                "text": "„Alle trugen Blumenkränze im Haar, vielen war ein Sträußchen angesteckt worden, oder sie hielten es auch ausgestreckt in der kleinen Faust vor sich.“"
                                            },
                                            {
                                                "example_id": "eca3738c-a259-4426-a9dd-81c304f94aa4",
                                                "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                                "text": "[Flüchtlinge in Lampedusa:] „Der Papst war hier und warf einen Blumenkranz ins türkisblaue Wasser,“ […]."
                                            },
                                            {
                                                "example_id": "5321d50a-38d5-412a-865f-127dbd23afb2",
                                                "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                                "text": "[Gedenken an den Beginn des 1. Weltkriegs:] „Van Rompuy und EU-Kommissionschef José Manuel Barroso legten an dem Tor einen weißen Blumenkranz nieder.“"
                                            },
                                            {
                                                "example_id": "9281da90-33d8-4568-959a-04156e8fc83c",
                                                "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                                "text": "[Tschernobyl:] „Mit einem Blumenkranz an der Reaktorruine gedachte Präsident Poroschenko der Opfer der radioaktiven Katastrophe.“"
                                            },
                                            {
                                                "example_id": "cb31a5e5-f2fd-47d5-be03-78afc06942fc",
                                                "sense_id": "efe9b867-8c6f-39ed-90b0-b11f2c521eb3",
                                                "text": "[Ferdinand von Toskana:] „Anschließend kam er ins Exil nach Würzburg, wo er bereits vor Dettelbach von den Schulkindern mit Blumenkränzen begrüßt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
