                "senses": [
                    {
                        "sense_id": "5f3b4cbb-cd64-36dc-8860-a7360782c155",
                        "entry_id": "f666eefc-a0a4-3bee-a4f6-7e36dfa0d0a8",
                        "glosses": [
                            "naar of van alle kanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e77e79-a161-457c-9a0a-03e900bee5da",
                                "sense_id": "5f3b4cbb-cd64-36dc-8860-a7360782c155",
                                "text": "De antiautoritaire opvoeding was hiervan het trieste hoogtepunt: een mens heeft geen grenzen nodig, laat iedereen zich van jongs af aan vrij en alzijdig ontwikkelen."
                            },
                            {
                                "example_id": "9b5ed1ee-a32d-4068-8530-e48cd91a32c5",
                                "sense_id": "5f3b4cbb-cd64-36dc-8860-a7360782c155",
                                "text": "Niettemin is voor ons de relatie met Zwolle en Utrecht net zo belangrijk. Wil Flevoland floreren, dan zal het alzijdig ontwikkeld moeten zijn, bijvoorbeeld als het gaat over de infrastructuur. Daarom zijn we zo blij met de Hanzelijn.”"
                            }
                        ]
                    }
