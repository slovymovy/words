                                        "entry_id": "693f09f5-ebe8-3d6b-9362-3833fb6e36af",
                                        "glosses": [
                                            "Sly, cunning, full of tricks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2af2839-c793-4ef9-acdd-c49adf6078f1",
                                                "sense_id": "c7027043-f229-3a36-93bf-a19cc3b9b1d7",
                                                "text": "Horatio's new girlfriend is a wily coquette, and poor Horatio is too smitten to see it."
                                            },
                                            {
                                                "example_id": "03d1fd4d-d077-4c67-b6da-dd14071ed7d1",
                                                "sense_id": "c7027043-f229-3a36-93bf-a19cc3b9b1d7",
                                                "text": "Of all the medical monsters Peter Hotez could have set out to slay, the Yale University researcher could not have chosen a more wily and obscure villain than the hookworm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
