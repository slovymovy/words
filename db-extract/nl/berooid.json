                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ed30ed5-aaaa-369a-8a70-f33bf0a4f23d",
                        "entry_id": "1535cba8-4061-3295-bc31-402f2dc1d49f",
                        "glosses": [
                            "zonder geld of andere bezittingen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20a2da55-7858-4c1b-b604-f631a641b570",
                        "source_entry_id": "1535cba8-4061-3295-bc31-402f2dc1d49f",
                        "source_sense_id": "8ed30ed5-aaaa-369a-8a70-f33bf0a4f23d",
                        "source_sense_description": "zonder geld of andere bezittingen",
                        "target_lang_word": "vide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                        "entry_id": "70d624cd-34ea-3bb5-a227-208e1ef3872b",
                                        "glosses": [
                                            "Qui ne contient rien ; qui est totalement dépourvu de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d4f9c6-d21e-4d4d-9cc8-d04855036ddc",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Il n’y a plus rien dans la maison, elle est vide."
                                            },
                                            {
                                                "example_id": "99a95516-b9d6-4223-921e-6d08154beaee",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Ces lieux communs mythologiques et ce cliquetis de mots sonores, mais à peu près vides de sens, plurent au roi Sighebert et à ceux des seigneurs Francs qui, comme lui, comprenaient quelque peu la poésie latine."
                                            },
                                            {
                                                "example_id": "965ebb75-ffa4-43fb-a8bd-75e4ffc7cde7",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Place, espace vide."
                                            },
                                            {
                                                "example_id": "4623edc3-ce86-47c8-bc43-bb6bf6255ab0",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "La bouteille est à moitié vide."
                                            },
                                            {
                                                "example_id": "83f1e805-1f30-42b9-a983-a5d1d227007c",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Il a le ventre vide, l’estomac vide."
                                            },
                                            {
                                                "example_id": "9497226e-c79b-4a9b-90d8-79d5cf53db46",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "'(Sens figuré) Avoir la tête vide, le cerveau vide', éprouver la faiblesse de tête que produisent le manque de nourriture, la"
                                            },
                                            {
                                                "example_id": "a3e32993-8afb-4824-a3be-4e0e4f7fcd6d",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Le cœur vide se dit pour exprimer le Manque d’affection et de sentiments."
                                            },
                                            {
                                                "example_id": "861010d2-1f36-4233-92e3-4089392ac6ed",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Ces discours amusent l’oreille et laissent le cœur vide."
                                            },
                                            {
                                                "example_id": "ef557490-40e4-497c-a6c0-3b4489c3520b",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Moment vide : moment libre d’occupation."
                                            },
                                            {
                                                "example_id": "543943cc-2885-4276-b4a1-87d1288c3893",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Il y a des moments vides dans la journée, qu’on ferait bien de remplir par quelque occupation."
                                            },
                                            {
                                                "example_id": "aaf0f4ef-acae-41da-8b37-fa8e1fafe236",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Existence vide, Existence qui n’est pas occupée."
                                            },
                                            {
                                                "example_id": "0f8e2a5e-d695-4be1-9b18-24e4e1118037",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Époque vide, époque qui n’a été signalée par aucun événement remarquable."
                                            },
                                            {
                                                "example_id": "c6d4578e-a68f-42f4-a181-8014f82318b1",
                                                "sense_id": "6e9bace5-453e-3721-8cab-b4deffc14b83",
                                                "text": "Un discours, un ouvrage vide de sens, de raison : où il n’y a ni sens ni raison, où il n’y a rien de solide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e27c62e-5a27-366e-b426-3fe5d575b2a6",
                                        "entry_id": "70d624cd-34ea-3bb5-a227-208e1ef3872b",
                                        "glosses": [
                                            "Sans acteur pendant un moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3604ffc5-a51c-41d7-a8d4-91f48edd8aea",
                                                "sense_id": "8e27c62e-5a27-366e-b426-3fe5d575b2a6",
                                                "text": "Le théâtre, la scène est vide, reste vide se dit lorsque, dans le courant d’un acte, il ne reste aucun acteur sur la scène."
                                            },
                                            {
                                                "example_id": "b60062e1-9f78-4f30-ac45-2a37e0015c1a",
                                                "sense_id": "8e27c62e-5a27-366e-b426-3fe5d575b2a6",
                                                "text": "Une scène vide, un acte vide se dit d’une Scène, d’un acte sans événement, sans action, sans incident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0081c2-00a3-364c-9761-b6e95c81ca22",
                                        "entry_id": "70d624cd-34ea-3bb5-a227-208e1ef3872b",
                                        "glosses": [
                                            "Égal à l’ensemble vide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f2cf586-06dd-4450-b49a-78d4c6980f06",
                                                "sense_id": "3e0081c2-00a3-364c-9761-b6e95c81ca22",
                                                "text": "Par suite de sa définition, un corps est nécessairement non vide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d45fadfb-7650-3afb-b000-5cec6a955391",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Espace ne contenant rien de palpable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af2ecba9-f031-4ff3-8223-b4ab768bbb72",
                                                "sense_id": "d45fadfb-7650-3afb-b000-5cec6a955391",
                                                "text": "[…] j’eus comme un étourdissement, et je dus m’accrocher fortement aux rebords de la croisée, pour n’être pas précipité dans le vide […]"
                                            },
                                            {
                                                "example_id": "6dc0a62c-406c-44bb-a778-aae6a5018585",
                                                "sense_id": "d45fadfb-7650-3afb-b000-5cec6a955391",
                                                "text": "Où es-tu, quand mes mains en révolte te cherchent et ne rencontrent que le vide ?"
                                            },
                                            {
                                                "example_id": "970d4627-b132-4bf1-a512-eae380b83443",
                                                "sense_id": "d45fadfb-7650-3afb-b000-5cec6a955391",
                                                "text": "Une corde, munie d’une sorte de ralingue, avait été lancée par-dessus le vide et s’était accrochée à un fragment de garde-fou."
                                            },
                                            {
                                                "example_id": "b295c960-4df7-48e6-963b-2ff3fc863095",
                                                "sense_id": "d45fadfb-7650-3afb-b000-5cec6a955391",
                                                "text": "Il est interdit aux notaires de laisser du vide dans la minute de leurs actes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d72f92cc-74e7-34c5-a59c-756cf58f1162",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Lieu où il n’y a pas de matière, qui ne contient pas d’air."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d8da5b-81ca-42e8-8ed6-858db6f2b0f1",
                                                "sense_id": "d72f92cc-74e7-34c5-a59c-756cf58f1162",
                                                "text": "Quelle que soit la méthode de synthèse utilisée, l’alcool γ-acétopropylique se sépare et se purifie par distillation sous vide (78-80°/5 mm Hg)."
                                            },
                                            {
                                                "example_id": "833e77e3-a7c6-4b23-848f-cd6de9b03db7",
                                                "sense_id": "d72f92cc-74e7-34c5-a59c-756cf58f1162",
                                                "text": "Au delà de 10⁷ Hz, la masse des électrons est elle-même trop importante pour que ceux-ci puissent suivre l’excitation, et le matériau a alors un comportement diélectrique semblable à celui du vide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c33b1f-ffbd-3133-a419-1bfa8d4b0450",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Toute ouverture ou baie dans un mur, de tout espace qui n’est pas occupé par une construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e665fafe-4a62-47d5-ab18-f8483afe1651",
                                                "sense_id": "e6c33b1f-ffbd-3133-a419-1bfa8d4b0450",
                                                "text": "La façade du Palais des doges présente cette particularité que les pleins sont au-dessus des vides."
                                            },
                                            {
                                                "example_id": "5690a3c3-3498-4107-8596-f8da9efc9654",
                                                "sense_id": "e6c33b1f-ffbd-3133-a419-1bfa8d4b0450",
                                                "text": "Ce mur pousse au vide, Il perd son aplomb, Il déverse ou fait ventre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16e20d2b-f655-3b79-b322-501e327e738e",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Sentiment de manque, par rapport aux personnes ou aux occupations dont on vient d’être privé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58eca99b-ebde-43e3-9219-94059c92ae1a",
                                                "sense_id": "16e20d2b-f655-3b79-b322-501e327e738e",
                                                "text": "Et les muges ? Pauvres muges ! On leur a fait tellement de tort avec la pollution et le mazout que les amateurs de muges aux olives sont plutôt rares. C'est un grand vide dans les traditions que la disparition de ce poisson appelé « mulet » dans le reste de la France."
                                            },
                                            {
                                                "example_id": "ed8e9997-a54e-4dfe-9210-fa2ed3fa3fb9",
                                                "sense_id": "16e20d2b-f655-3b79-b322-501e327e738e",
                                                "text": "Notre foyer s'équipait, se suréquipait de tous les appareils et gadgets qui simplifient la vie domestique. Grille-pain, brosse à dents électrique, chaîne 2 × 100 watts et autres remparts illusoires contre le vide de l'existence."
                                            },
                                            {
                                                "example_id": "de481653-aafa-44d2-b24d-47ce79fdba8d",
                                                "sense_id": "16e20d2b-f655-3b79-b322-501e327e738e",
                                                "text": "Faire le vide autour de quelqu’un, L’isoler."
                                            },
                                            {
                                                "example_id": "e6a173ab-2135-440f-8ea3-fd8594baa81a",
                                                "sense_id": "16e20d2b-f655-3b79-b322-501e327e738e",
                                                "text": "'(Par analogie) Cet orateur fait le vide' dans la salle où il parle, Il décourage, il fait fuir les auditeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b11389c-004b-360e-a123-50db44f2f7be",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Vanité, vacuité, néant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25671d4f-e08b-4e70-9d1b-bdc9e8f82914",
                                                "sense_id": "6b11389c-004b-360e-a123-50db44f2f7be",
                                                "text": "Favrolles prend la parole. Son vide intérieur, son inconscience braillarde se masquent sous l’énergie de ses propositions."
                                            },
                                            {
                                                "example_id": "2ca59f11-3aa6-4d80-8f8e-2cc1d7812e97",
                                                "sense_id": "6b11389c-004b-360e-a123-50db44f2f7be",
                                                "text": "Si nous prenons quelques instants pour nous demander quel est le sens réel que nous souhaitons donner à notre vie, nous faisons face à un vide."
                                            },
                                            {
                                                "example_id": "7a893d05-2ddc-458d-a50d-13b97603908b",
                                                "sense_id": "6b11389c-004b-360e-a123-50db44f2f7be",
                                                "text": "Le grand vide silencieux qu'on imagine à la naissance ou à la fin du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae226eb0-5068-3cfd-86ee-c9dec5a588ea",
                                        "entry_id": "6e40a3cf-8cc0-3d76-83eb-da287f2528eb",
                                        "glosses": [
                                            "Espace sans arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751e6e53-e7c2-42ad-aaf4-5eba3f639ecc",
                                                "sense_id": "ae226eb0-5068-3cfd-86ee-c9dec5a588ea",
                                                "text": "La grande surface de vides à reconstituer comprend les vides dus à la tempête, mais également les vides liés au non-reboisement des plateaux d’altitude en raison de la surdensité de cervidés."
                                            }
                                        ]
                                    }
                                ]
                            },
