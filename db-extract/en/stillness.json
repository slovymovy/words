                "senses": [
                    {
                        "sense_id": "d8c34fb4-35af-3e74-b3af-d9b6f978edce",
                        "entry_id": "4c2e58fa-ad08-377e-954d-077b1e9ae57a",
                        "glosses": [
                            "The quality or state of being still."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "946cc909-4531-4bf8-9a42-0932582bc03a",
                                "sense_id": "d8c34fb4-35af-3e74-b3af-d9b6f978edce",
                                "text": "The teru-tero (Vanellus cayanensis), is another bird, which often disturbs the stillness of the night."
                            },
                            {
                                "example_id": "ebd72b88-ae72-4947-a6e3-b95a79967a85",
                                "sense_id": "d8c34fb4-35af-3e74-b3af-d9b6f978edce",
                                "text": "It resembled them in the sense that it was not ended, when it was past, but continued to unfold, in Watt's head, from beginning to end, over and over again, the complex connexions of its lights and shadows, the passing from silence to sound and from sound to silence, the stillness before the movement and the stillness after, the quickenings and retardings, the approaches and the separations, all the shifting detail of its march and ordinance, according to the irrevocable caprice of its taking place."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dca7d7f-a7cb-3ee0-bf66-e3dc0e3fefed",
                        "entry_id": "4c2e58fa-ad08-377e-954d-077b1e9ae57a",
                        "glosses": [
                            "Habitual silence or quiet; taciturnity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "376038d5-6324-4a75-ac21-1c8f0633e93b",
                                "sense_id": "6dca7d7f-a7cb-3ee0-bf66-e3dc0e3fefed",
                                "text": "The grauitie, and ſtillneſſe of your youth / The world hath noted."
                            },
                            {
                                "example_id": "55c3bd68-0898-410f-ad68-d123ebaad6bc",
                                "sense_id": "6dca7d7f-a7cb-3ee0-bf66-e3dc0e3fefed",
                                "text": "Like a heartbeat drives you mad / In the stillness of remembering what you had / And what you lost"
                            }
                        ]
                    }
                ],
