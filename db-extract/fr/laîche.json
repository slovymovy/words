                                "target_senses": [
                                    {
                                        "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                        "entry_id": "ada5bb10-93b9-35d4-a416-4e2f4c6e00b2",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Carex aus der Familie der Sauergräser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebbdfba-6156-4b16-88e7-4dc1751c84a7",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "Seggen sind weltweit verbreitet."
                                            },
                                            {
                                                "example_id": "e95299e6-e5f5-4e22-80c1-506ff605994a",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "Eine Segge erkennt man an den gewinkelten Blättern."
                                            },
                                            {
                                                "example_id": "e46b1f31-df2b-43ff-99eb-5e4eb8752fde",
                                                "sense_id": "cd151e0d-e703-37aa-ac6a-624545ec271c",
                                                "text": "„Man unterscheidet die flachen meist nährstoffreichen Niedermoore, in denen verschiedene Laubmoose, vor allem aber Seggen und Binsen wachsen, und die nährstoffarmen, in der Mitte uhrglasartig aufgewölbten Hochmoore, auf denen vor allem Torfmoose gedeihen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
