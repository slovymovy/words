{
    "word": "eternally",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3a11cb13-2b74-3362-bb30-4cec90a86ed9",
                "word": "eternally",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a17a0186-749a-3447-b514-bfe5dbcf07e7",
                        "entry_id": "3a11cb13-2b74-3362-bb30-4cec90a86ed9",
                        "glosses": [
                            "For eternity; forever."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "01854aac-da01-4334-9939-cd1b56ea78d4",
                                "sense_id": "a17a0186-749a-3447-b514-bfe5dbcf07e7",
                                "text": "I shall be eternally grateful for your assistance."
                            }
                        ]
                    },
                    {
                        "sense_id": "43eb59b9-9f86-377e-9d82-2cf9f288e561",
                        "entry_id": "3a11cb13-2b74-3362-bb30-4cec90a86ed9",
                        "glosses": [
                            "Unceasingly, recurringly."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2374fab8-53d7-4d1d-bdaa-f8c7266b0e7c",
                                "sense_id": "43eb59b9-9f86-377e-9d82-2cf9f288e561",
                                "text": "The colonel and his sponsor made a queer contrast: Greystone [the sponsor] long and stringy, with a face that seemed as if a cold wind was eternally playing on it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "669f31ef-7530-4586-95f3-43754a690e35",
                        "source_entry_id": "3a11cb13-2b74-3362-bb30-4cec90a86ed9",
                        "source_sense_description": "forever",
                        "target_lang_word": "éternellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éternellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2384002-2662-3f14-940e-31c016fda34a",
                                        "entry_id": "4088350f-953a-3f4e-8df1-301b775b04d0",
                                        "glosses": [
                                            "D’une façon éternelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71bf5c4c-7c4e-4905-a7b3-4acfec18be3b",
                                                "sense_id": "d2384002-2662-3f14-940e-31c016fda34a",
                                                "text": "Dieu existe éternellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                        "entry_id": "4088350f-953a-3f4e-8df1-301b775b04d0",
                                        "glosses": [
                                            "Sans fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b425c4bc-0b45-44a1-828b-0c575ab755f6",
                                                "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                                "text": "Elle était heureuse simplement, sans réflexion et sans autre désir que celui de voir son bonheur durer éternellement."
                                            },
                                            {
                                                "example_id": "8d546013-8dde-4af5-9b8c-eba61aab0fe0",
                                                "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                                "text": "Par les Muses seulement\nL’homme est exempt de la Parque ;\nEt ce qui porte leur marque\nDemeure éternellement."
                                            },
                                            {
                                                "example_id": "c44fabb9-4504-4dd8-873e-23fb7ee39131",
                                                "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                                "text": "Tous vous savent louer, mais non également :\nLes ouvrages communs vivent quelques années ;\nCe que Malherbe écrit dure éternellement."
                                            },
                                            {
                                                "example_id": "cedb6502-a034-49c8-ad18-eef413c3a10a",
                                                "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                                "text": "Ils [les hérétiques et les schismatiques] seront éternellement connus par leur désertion, et il est clair, dit saint Jude, que c’est par ce caractère que tous les apôtres les ont voulu désigner."
                                            },
                                            {
                                                "example_id": "b729670a-a3ea-48ab-a603-45e1cba7ad0d",
                                                "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                                                "text": "Il y a réussi au-delà de toute expression ; plusieurs de ses bons mots nt même fait proverbe dans la langue, et les Lettres Provinciales seront éternellement regardées comme un modèle de goût et de style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                        "entry_id": "4088350f-953a-3f4e-8df1-301b775b04d0",
                                        "glosses": [
                                            "Sans cesse, continuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f82aec-c329-4fce-b920-2f589c71e793",
                                                "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                                "text": "Ce qui achève le cauchemar, c’est le lugubre postillon en vieille cape déguenillée qui sautille éternellement dans la clarté jaunâtre."
                                            },
                                            {
                                                "example_id": "be020abd-770d-4501-b231-86add39a3d23",
                                                "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                                "text": "Voyez-vous, madame, reprit-il, un peu embarrassé, vous ne pouvez pas éternellement moisir dans cette turne."
                                            },
                                            {
                                                "example_id": "ec437ef4-ec24-477e-a063-58bc76c9b789",
                                                "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                                "text": "L’avoir [le prince de Condé] entre ses mains c’était y avoir la victoire même, qui le suit éternellement dans les combats : mais il était juste que ce précieux dépôt de l’État demeurât entre les mains du roi, et il lui appartenait de garder une si noble partie de son sang."
                                            },
                                            {
                                                "example_id": "302a9953-a857-4b97-bd8c-c0c13a2d76f6",
                                                "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                                "text": "Il [le marquis Brisacier] parlait éternellement sans rien dire, et renchérissait dans ses habits sur les modes les plus outrées."
                                            },
                                            {
                                                "example_id": "93379ddc-9a79-4bff-9888-f37c0dcc5462",
                                                "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                                                "text": "Voilà où se réduit la philosophie sublime des impies ; voilà cette force, cette raison, cette sagesse qu’ils nous vantent éternellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b4bddf2-f109-4c5d-af96-1303237429e0",
                        "source_entry_id": "3a11cb13-2b74-3362-bb30-4cec90a86ed9",
                        "source_sense_description": "forever",
                        "target_lang_word": "ewig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ewig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "endlos, zeitlich unbegrenzt"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7538a61-c1df-408a-a088-7b78a2cfe676",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Ewig existiert Gott."
                                            },
                                            {
                                                "example_id": "55ca9294-07cb-4adf-a502-e32c1e4b6d70",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Sie sind ewig in Liebe verbunden."
                                            },
                                            {
                                                "example_id": "91d80915-23a3-4555-8adb-0479a7c079cd",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "Uns ist das Ewige Leben versprochen."
                                            },
                                            {
                                                "example_id": "777034e2-f366-4a49-8f30-2d7c532f5713",
                                                "sense_id": "23176059-3a2c-37d7-9b89-ed2c58ae4063",
                                                "text": "„Ich, dessen Herz in die entferntesten Jahrtausende der Vergangenheit und der Zukunft immer tiefer und tiefer Wurzel schlägt, ich, der ich selbst einer der ewigsten Menschen bin, jeder Atemzug ein ewiges Leben, jeder Gedanke ein ewiger Stern – ich sollte nicht an Unsterblichkeit glauben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "einen langen Zeitraum betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0becee02-eeca-4277-9f5d-c416665d10ab",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                                            },
                                            {
                                                "example_id": "e4824948-56b3-470a-a101-225f22aa7f98",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Nein, Thomas, bist du es wirklich? Wir haben uns ja ewig nicht gesehen! Wie gehts so, alter Kumpel?"
                                            },
                                            {
                                                "example_id": "e63c5281-e121-4178-b830-84180d130a90",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Ich habe keine Ahnung, das ist ewig her, dass ich sie gesehen habe. Vielleicht fünf Jahre, oder so."
                                            },
                                            {
                                                "example_id": "22a834e2-0512-48fb-8a59-33cac9d77aee",
                                                "sense_id": "d448ba9b-19dd-3c9d-8bbb-1eb5e90ba777",
                                                "text": "Nacktbaden? Das habe ich ewig nicht gemacht, also los!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                        "entry_id": "c527ebf9-1964-3bbd-bae5-2ebf9ac771f6",
                                        "glosses": [
                                            "sich ständig wiederholend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "103e7943-ddb6-487f-a360-0785bd8294e6",
                                                "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                                "text": "Ich habe den Typen sowas von satt, der nörgelt ewig an mir rum."
                                            },
                                            {
                                                "example_id": "9eafaad1-2dac-4c6b-a637-a446ca0fcf08",
                                                "sense_id": "a8ea14e6-83e9-3b87-a114-342cf50b5502",
                                                "text": "Im Grunde habe ich mich ewig gefragt, ob der Fehler nicht bei mir lag."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
