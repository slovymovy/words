        "fr-extract.jsonl": [
            {
                "entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                "word": "bourgmestre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a641e3a6-a080-4ce9-a882-dca02f85f3dc",
                        "entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bourgmestres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                        "entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                        "glosses": [
                            "Titre du premier magistrat des villes de Belgique, du Luxembourg, des Pays-Bas, d’Allemagne, etc."
                        ],
                        "tags": [
                            "Belgique",
                            "Luxembourg"
                        ],
                        "examples": [
                            {
                                "example_id": "907f698f-61c6-47e3-aab8-0983850bda52",
                                "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                                "text": "Ma bonne ville de Cambrai est en pleine prospérité et peut se passer de mes services. […] Pour lors, il me faudrait ici un brave homme qui pût me remplacer en qualité de bourgmestre."
                            },
                            {
                                "example_id": "7d7770d1-8cfb-4dc5-ab9d-1862b5b5ad1c",
                                "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                                "text": "Vers 1637, un échevin noble supposé avoir participé au meurtre du bourgmestre La Ruelle fut déchiré par la foule qui, dit-on, goûta au sang du malheureux et lacéra sa chair à coups de dents."
                            },
                            {
                                "example_id": "efc28e66-d4ab-48f0-b055-7607143c5530",
                                "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                                "text": "Sa perruque blonde bien frisée, bien mise, seyait à sa blanche figure froidie comme celle de ces femmes de bourgmestre peintes par Holbein."
                            },
                            {
                                "example_id": "7b3ae8e9-163e-4ab9-89fb-4233703c71db",
                                "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                                "text": "Le programme officiel s'est poursuivi par un dîner au Prater offert par le bourgmestre de Vienne."
                            },
                            {
                                "example_id": "7327fadd-f996-4fc0-8b36-d7ba72e077be",
                                "sense_id": "e8642d8d-6daf-3b76-8d58-3191b0ee6bcb",
                                "text": "— Mais nom de Dieu, je m'en moque de cette législation ou de cette nomination, ce qui me va loin, c'est l'absurdité de ce gouvernement et de ce parlement composé de Flamands qui débarquent de Perpète-les-Bains pour nous dire qui peut devenir bourgmestre ou non dans une commune francophone."
                            }
                        ]
                    },
                    {
                        "sense_id": "8875a199-4195-3bbf-81b0-542cf861ad02",
                        "entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                        "glosses": [
                            "Chef de l’administration d’une commune."
                        ],
                        "tags": [
                            "Congo-Kinshasa"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3cb2977-e151-4de6-b186-685085db8aaa",
                        "source_entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                        "target_lang_word": "Bürgermeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgermeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                        "entry_id": "4815ec34-5c57-371b-b095-42ed891a436b",
                                        "glosses": [
                                            "Oberhaupt einer Stadt, Gemeinde oder anderen Kommune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683fa349-fb8d-4351-8a93-60d85171fdc2",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "Bürgermeister und Gemeinderat verabschieden den neuen Gemeindehaushalt."
                                            },
                                            {
                                                "example_id": "681e9d45-d377-4a45-8e82-9fb11e355480",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "Es sind nicht die klügsten Bauern, die sich zum Bürgermeister wählen lassen."
                                            },
                                            {
                                                "example_id": "ee4e4e48-b56b-4de6-a96d-829ee8f82333",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Als Humboldt spätabends vom Empfang beim Bürgermeister heimkam, wollte sein Gastgeber mit ihm trinken.“"
                                            },
                                            {
                                                "example_id": "8137529f-f846-42e7-9415-b2395af3c59a",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„In seinem Amtszimmer angekommen, setzt sich der Bürgermeister einen Augenblick in seinen Sessel und denkt nach.“"
                                            },
                                            {
                                                "example_id": "587ded34-f0ac-49b9-9643-4a77948c81c1",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Der spätere Bonner Bürgermeister war schon als Kind Mitglied von Johannas Gesangverein und einer ihrer glühenden Verehrer.“"
                                            },
                                            {
                                                "example_id": "0e1be245-07a0-43f7-ac70-9d361e3507ac",
                                                "sense_id": "0b0fdded-52d9-33db-8473-f9afaa9e255e",
                                                "text": "„Es war seine dritte Amtszeit als Bürgermeister, und abgesehen von seiner Intelligenz hatte der Mann eine ganz außergewöhnliche Arbeitsdisziplin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcffef50-075c-4d5c-a5e2-f707843407c9",
                        "source_entry_id": "bef80f12-5731-36a6-b277-32ec7a2dcc16",
                        "target_lang_word": "Bürgermeisterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgermeisterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                        "entry_id": "93cfbe11-300c-3129-8bd0-91c89e207f6f",
                                        "glosses": [
                                            "weibliches Oberhaupt einer Stadt, Gemeinde oder anderen Kommune"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8967794e-f99f-476c-a7c6-029e55602f77",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "Bürgermeisterin und Gemeinderat verabschieden den neuen Gemeindehaushalt."
                                            },
                                            {
                                                "example_id": "1c25cfcd-f102-42ea-bf61-f2a697e9dbd2",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "Athens Bürgermeisterin Dora Bakogianni rief all ihre europäischen Kollegen dazu auf, den Opfern der Flutwelle in Asien zu helfen."
                                            },
                                            {
                                                "example_id": "c5b6ae8f-fb2a-45cc-b2d7-4d0ecf495b61",
                                                "sense_id": "5ad3ff45-2182-31cf-b665-42081e7e58c0",
                                                "text": "„Ich habe bei einer öffentlichen Veranstaltung einmal die Bürgermeisterin dieses Bezirks kennengelernt, eine tapfere Frau, die vor ihrem Wirkungsgebiet überhaupt keine Angst zu haben schien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
