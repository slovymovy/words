                ],
                "senses": [
                    {
                        "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                        "entry_id": "c2b37996-6dec-3743-9cb9-6608f76c3b2d",
                        "glosses": [
                            "längliches Stück Land, auf dem blühende Pflanzen wachsen (häufig zum Zweck der Förderung von Insektenpopulationen angelegt)"
                        ],
                        "tags": [
                            "an Straßen",
                            "Feldrändern"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a2d6e2-5403-493e-99f8-c2b509d15c25",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Grün- und Blühstreifen an Waldrändern, Feldern und Wegen verschwinden.“"
                            },
                            {
                                "example_id": "e60a2602-a1be-4be9-8f0c-7892232c2396",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Blühstreifen werden auf Flächen angelegt, die nicht genutzt werden.“"
                            },
                            {
                                "example_id": "17002db6-a073-4e0b-804f-ed6a33e4fbaa",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Der Blühstreifen sollte zwischen 3 und 10 Metern breit sein.“"
                            },
                            {
                                "example_id": "9f058790-8b6c-4906-8c1e-1edcb0476b55",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Tagetes wird außerhalb von Gärten für Blühstreifen und Wildäcker genutzt“ […]."
                            },
                            {
                                "example_id": "0d85d306-ed37-42c3-84fb-0150539d3c95",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "In Deutschland müssen wir mehr Lebensraum und Nahrungsangebote für Insekten schaffen, beispielsweise mit Blühstreifen."
                            },
                            {
                                "example_id": "7bab1369-3dcd-4542-864a-3e052b0b4b56",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Ein häufiger Bewohner der Blühstreifen ist zum Beispiel das Grüne Heupferd.“"
                            },
                            {
                                "example_id": "7ff1e035-669b-4e76-a360-290794921751",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Feldlerche und Neuntöter halten sich gerne zur Nahrungssuche im Blühstreifen auf.“"
                            },
                            {
                                "example_id": "e8f82e96-d314-45d6-bf40-2db9b0115775",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "[Großbritannien:] „Insekten aber auch andere Tiere profitieren von einem Netz an Blühstreifen, entwickelt von der britischen Tier- und Naturschutzorganisation Buglife.“"
                            },
                            {
                                "example_id": "ccc05034-96b6-484e-842f-aac7c67ec4cb",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„In der Landwirtschaft werden seit den 1990er-Jahren Blühstreifen an Ackerrändern als Agrarumweltmaßnahmen angelegt und sollen die lokale Biodiversität fördern.“"
                            },
                            {
                                "example_id": "ee7d642d-1161-4f5e-9bf5-0d635cfd37b1",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Landwirte versuchen ihren Teil zur Lösung beizutragen, indem sie Blühstreifen neben ihren Ackern stehen lassen.“"
                            },
                            {
                                "example_id": "e3363e43-4652-419f-a7a4-fc6fcf4e04cb",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Der Bauernverband fordert, dass er wieder mehr Fläche bewirtschaften darf und nicht, wie es die EU-Kommission kürzlich durchgesetzt hat, am Rande der Felder unbeackerte Blühstreifen ausgespart werden müssen, damit Insekten weniger stark leiden.“"
                            },
                            {
                                "example_id": "7adb5841-9daa-4129-b741-095329aede48",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„»Die Arten haben zugenommen und die Anzahl jeder Insektenart hat sich um das Vierfache erhöht«, erzählt der Agronom. Wissenschaftler hatten den Zuwachs auf dem Blühstreifen erfasst, nachdem gezielt Pflanzen für Insekten und Vögel gesät worden waren.“"
                            },
                            {
                                "example_id": "a32fcd61-7233-4469-853e-d5b3a7bb9b03",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Andere Flächen sollen als Brachland und Blühstreifen unbewirtschaftet bleiben, so dass sich dort die Artenvielfalt erholen kann.“"
                            },
                            {
                                "example_id": "98333699-b2fc-41a2-b475-316d2be1cabd",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Häufiger als Feldfrucht wird Buchweizen heute in Saatgutmischungen für Blühstreifen, für Agrarumweltmaßnahmen oder als Bienenweide eingesetzt, wo er zu den am häufigsten verwendeten Arten zählt.“"
                            },
                            {
                                "example_id": "e8cdeec6-0669-4fd0-acc8-c2af1b58db19",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Ein Blumensaum am Ackerrand kann dem Bauern Bares bringen: Laut einer neuen Studie fördern Blühstreifen nicht nur die Artenvielfalt, sondern können sogar den Befall mit unerwünschten Tieren deutlich reduzieren.“"
                            },
                            {
                                "example_id": "babc62c9-155c-4a35-a58f-efb486d71b41",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "[Schweiz:] „Für Blühstreifen werden seit 2015 Direktzahlungen vergeben.“"
                            },
                            {
                                "example_id": "37d08815-14f8-40a4-b95a-502faa9cbb5c",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Die Blühstreifen sind daher eine Dienstleistung am Ökosystem und fördern gleichzeitig selten gewordene Wildbienenarten. Auch für Hummeln und andere Insekten sind die Streifen attraktiv.“"
                            },
                            {
                                "example_id": "382d4291-120f-46bb-9031-2613c94a1dad",
                                "sense_id": "5f1c53e7-7383-387d-8c8c-d45d363efe27",
                                "text": "„Im ersten Jahr nach ihrer Einführung beteiligten sich 449 Betriebe aus 16 Kantonen an der Förderung der Bienen mittels Blühstreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
