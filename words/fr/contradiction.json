    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                    "sense_definition": "Incompatibilité ou opposition entre deux faits, deux idées ou deux affirmations qui ne peuvent être vrais en même temps.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "incompatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a une évidente <w>contradiction</w> entre ses paroles et ses actes."
                        },
                        {
                            "text": "Ces nouvelles directives entrent en <w>contradiction</w> avec les règles établies."
                        }
                    ],
                    "synonyms": [
                        "incompatibilité",
                        "incohérence",
                        "divergence"
                    ],
                    "antonyms": [
                        "cohérence",
                        "accord",
                        "harmonie"
                    ],
                    "common_phrases": [
                        "en contradiction avec",
                        "entrer en contradiction"
                    ]
                },
                {
                    "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                    "sense_definition": "Action de contredire, d'exprimer son désaccord ou d'affirmer le contraire d'une opinion énoncée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par pur esprit de <w>contradiction</w>, elle refuse systématiquement les avis des autres."
                        },
                        {
                            "text": "Il a supporté la <w>contradiction</w> sans jamais s'énerver durant le débat."
                        }
                    ],
                    "synonyms": [
                        "contestation",
                        "réfutation"
                    ],
                    "antonyms": [
                        "approbation",
                        "assentiment"
                    ],
                    "common_phrases": [
                        "esprit de contradiction"
                    ]
                },
                {
                    "sense_id": "77d24e75-5837-331d-9ae0-5bbdb49c496b",
                    "sense_definition": "Opposition vive, résistance ou objection manifestée à une personne ou à un projet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opposition_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet de loi a été approuvé sans <w>contradiction</w> majeure au parlement."
                        },
                        {
                            "text": "Le ministre a dû affronter de nombreuses <w>contradictions</w> pendant cette réunion agitée."
                        }
                    ],
                    "synonyms": [
                        "opposition",
                        "résistance",
                        "objection"
                    ],
                    "antonyms": [
                        "adhésion",
                        "consentement"
                    ],
                    "common_phrases": [
                        "sans contradiction"
                    ]
                },
                {
                    "sense_id": "5bebe675-dddf-3480-9701-132a1af9c67c",
                    "sense_definition": "Relation logique d'incompatibilité absolue entre deux propositions dont l'une affirme exactement ce que l'autre nie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "incompatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce raisonnement mathématique aboutit inévitablement à une <w>contradiction</w> flagrante."
                        },
                        {
                            "text": "Une théorie ne peut pas tolérer de <w>contradiction</w> interne entre ses axiomes fondamentaux."
                        }
                    ],
                    "synonyms": [
                        "antinomie"
                    ],
                    "common_phrases": [
                        "contradiction logique"
                    ]
                }
            ]
        }
    ]
}