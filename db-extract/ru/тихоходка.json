                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5dfd981a-0d07-399f-9d6a-991cb61658a2",
                                        "entry_id": "c81ee838-93e6-39a3-b21f-f5b387c0e980",
                                        "glosses": [
                                            "A sloth, a neotropical mammal of suborder Folivora (syn. Tardigrada)."
                                        ],
