                "senses": [
                    {
                        "sense_id": "6640bd91-ee6c-3f96-96b8-17729d846efa",
                        "entry_id": "9ac5db5c-563c-3eff-850d-e2f1815dc3ba",
                        "glosses": [
                            "Nom vernaculaire de nombreuses espèces de poissons appartenant à la famille des holocentridés (Holocentridae)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06357b42-3753-4e9f-9221-bde5be5f3353",
                                "sense_id": "6640bd91-ee6c-3f96-96b8-17729d846efa",
                                "text": "En fait, la coloration de ce joli poisson-soldat suffit pour l’identifier : le corps est rouge brillant avec des lignes longitudinales blanches ; il existe, en outre, une tache noire au niveau des premiers rayons de la dorsale."
                            },
                            {
                                "example_id": "e625a3be-0b5d-45cc-9496-a4a7baa31af7",
                                "sense_id": "6640bd91-ee6c-3f96-96b8-17729d846efa",
                                "text": "On verra ainsi le poisson-duc, le poisson-diable, le poisson-papillon, le poisson-cocher, le poisson-soldat, le poisson-lion, le poisson-queue de lyre, le poisson-écureuil, le poisson-demoiselle, le poisson-scorpion …."
                            },
                            {
                                "example_id": "eacef32d-4cf3-4f52-8bfa-1e09a6d8b80d",
                                "sense_id": "6640bd91-ee6c-3f96-96b8-17729d846efa",
                                "text": "Les poissons-soldats sont souvent observés par les plongeurs qui visitent les régions tropicales et subtropicales. Ils nagent généralement en bancs serrés qui peuvent ressembler à une formation militaire, d’où leur nom."
                            }
                        ]
                    }
                ],
