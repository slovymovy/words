                                        "entry_id": "e6087340-4f0a-3947-93eb-6d0af3966388",
                                        "glosses": [
                                            "Verletzung einer moralischen Verpflichtung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b99d0ca8-2e61-39ba-b035-4349996f5828",
                                        "entry_id": "e6087340-4f0a-3947-93eb-6d0af3966388",
                                        "glosses": [
                                            "Verletzung einer rechtlichen Verpflichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a95f76-5cc9-43c4-982b-4aa78be8cd60",
                                                "sense_id": "b99d0ca8-2e61-39ba-b035-4349996f5828",
                                                "text": "Er wurde wegen Untreue verurteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "575434c6-2fa9-376f-82f6-ec5f1b4fdcd0",
                                        "entry_id": "e6087340-4f0a-3947-93eb-6d0af3966388",
                                        "glosses": [
                                            "Betrug seines Partners mit einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b4dfd8-f0c5-4af5-8b9c-ada3e0866774",
                                                "sense_id": "575434c6-2fa9-376f-82f6-ec5f1b4fdcd0",
                                                "text": "„Nun ja, er brachte ihm eine kleine Abkühlung und Ernüchterung, indem er vor Untreue der Weiber warnte und ihn zur Vorsicht mahnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63856440-4f72-484a-84cb-4272c8cdb59f",
                        "source_entry_id": "79f6f38b-5b0a-3493-98eb-a686c53d17bc",
                        "target_lang_word": "Verrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                        "entry_id": "b397eb4c-866a-37cd-a4e1-95fb23a58c6f",
                                        "glosses": [
                                            "Weitergabe von Informationen ohne das Einverständnis des Betroffenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3fe3d1-7d5d-489c-8cf9-dcb5167b715c",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "Der Verrat wurde bestraft."
                                            },
                                            {
                                                "example_id": "772e8100-0c28-497a-9e6d-7ea9bc654c97",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "„Trump hetzt gegen Justizminister Jeff Sessions, einen bislang treuen Vasallen und beinharten Konservativen, nur weil der getan hat, was Recht und Gesetz von ihm verlangen: Trump sieht gerade in der Rechtstreue seines Justizministers den Verrat.“"
                                            },
                                            {
                                                "example_id": "d638d922-db5d-43dd-b594-de13155ebb4d",
                                                "sense_id": "0beb9351-b623-38d2-89df-2bca9673bf6d",
                                                "text": "„Sie konnte eigentlich nur für ihn kochen, ohne dauernd an mich denken zu müssen, denn das hat sie so selten für mich getan, daß es nicht unbedingt Verrat oder Hurerei sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
