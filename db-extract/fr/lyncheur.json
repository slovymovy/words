                    {
                        "sense_id": "cf3ce9c8-5505-311f-a9b6-cfb6720e2326",
                        "entry_id": "a4160e90-8d17-3784-8936-134198154e59",
                        "glosses": [
                            "Qui participe ou pousse à un lynchage, concerne le lynchage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ca1f22-8a94-490f-bb2f-2f7851f3e4b0",
                                "sense_id": "cf3ce9c8-5505-311f-a9b6-cfb6720e2326",
                                "text": "La foule, ignoble et lyncheuse, hurlait sur notre passage, faisait la haie, agitant les poings et les cannes en un hystérique désir de porter des coups anonymes."
                            },
                            {
                                "example_id": "d6c384bb-ce1b-48b8-849c-d3bd6a244fab",
                                "sense_id": "cf3ce9c8-5505-311f-a9b6-cfb6720e2326",
                                "text": "Tous ceux-là me montrent que la littérature peut chercher, au plus loin de la parole grégaire, au plus loin de l’antisémitisme, du discours totalitaire ou du bouc émissaire, un ailleurs de la jouissance lyncheuse, un ailleurs de la haine politique et programmée."
                            }
                        ]
                    }
                ],
