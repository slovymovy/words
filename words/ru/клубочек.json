{
    "word_family": [
        "клубок",
        "клубочный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4937cc80-842b-3bd5-8f71-464a77da53fc",
                    "sense_definition": "Уменьшительно-ласкательная форма слова <w>клубок</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Котёнок весело играл с маленьким <w>клубочком</w> шерстяных ниток.",
                            "target_lang_translations": {
                                "de": "Das Kätzchen spielte vergnügt mit einem kleinen <w>Wollknäuel</w>."
                            }
                        },
                        {
                            "text": "Бабушка смотала пряжу в аккуратный <w>клубочек</w>.",
                            "target_lang_translations": {
                                "de": "Die Großmutter wickelte das Garn zu einem ordentlichen <w>Knäuel</w> auf."
                            }
                        }
                    ],
                    "common_phrases": [
                        "шерстяной клубочек"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine kleine, meist runde Ansammlung von aufgewickeltem Garn, Faden oder Wolle."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wollknäuel",
                                "target_lang_sense_clarification": "Ein kleines Knäuel aus Wolle oder Garn."
                            },
                            {
                                "target_lang_word": "Knäuel",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für aufgewickeltes Material."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b7c79fd-b0e1-3b55-801d-81a25ba43921",
                    "sense_definition": "Сеть кровеносных капилляров в почке, окруженная капсулой нефрона.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Фильтрация крови в почках начинается именно в почечном <w>клубочке</w>.",
                            "target_lang_translations": {
                                "de": "Die Blutfiltration in den Nieren beginnt genau im <w>Glomerulus</w>."
                            }
                        },
                        {
                            "text": "Повреждение <w>клубочков</w> может привести к серьезным нарушениям работы почек.",
                            "target_lang_translations": {
                                "de": "Eine Schädigung der <w>Glomeruli</w> kann zu schwerwiegenden Nierenfunktionsstörungen führen."
                            }
                        }
                    ],
                    "synonyms": [
                        "почечный клубочек"
                    ],
                    "common_phrases": [
                        "почечный клубочек"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Geflecht aus Blutkapillaren in der Niere, das für die Filtration des Blutes zuständig ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Glomerulus",
                                "target_lang_sense_clarification": "Fachbegriff für das Nierenkörperchen."
                            },
                            {
                                "target_lang_word": "Nierenkörperchen",
                                "target_lang_sense_clarification": "Der anatomische Fachbegriff für die Filtereinheit der Niere."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}