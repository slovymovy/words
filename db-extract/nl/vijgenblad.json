                    {
                        "translation_id": "f059ddfd-47ca-4980-9596-727478043c40",
                        "source_entry_id": "72bdc1b3-3cd3-3275-9c0a-43219d23538e",
                        "source_sense_id": "94edd659-03c8-3b7a-8d24-5f7fef19c87e",
                        "target_lang_word": "fig leaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fig leaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d3260ff-b51d-3484-9984-f6ed116fb51b",
                                        "entry_id": "1582dc42-f23e-3265-ba39-5784b22d1053",
                                        "glosses": [
                                            "A leaf of the fig plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b956eda-8bd2-352e-a194-04c20bd9a5da",
                                        "entry_id": "1582dc42-f23e-3265-ba39-5784b22d1053",
                                        "glosses": [
                                            "A representation of leaf of a fig plant used to cover the genitals of a nude figure in a work of art (alluding to Genesis iii 7, in which Adam and Eve use fig leaves to hide their nakedness)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d64b5163-16b9-31af-a110-3e7f3d02c38c",
                                        "entry_id": "1582dc42-f23e-3265-ba39-5784b22d1053",
                                        "glosses": [
                                            "Anything used to conceal something undesirable or that one does not want to be discovered."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d79fe4-6774-4458-a6ca-f033467ada56",
                                                "sense_id": "d64b5163-16b9-31af-a110-3e7f3d02c38c",
                                                "text": "True, David Brog, one of the organizers of last week’s conference, insisted that national conservatives are not anti-immigrant. But this is a fig leaf. [University of Pennsylvania law professor Amy] Wax explicitly made an argument for limiting the number of nonwhites entering the US."
                                            },
                                            {
                                                "example_id": "292b237f-e494-45a1-8886-47d2bf8574b7",
                                                "sense_id": "d64b5163-16b9-31af-a110-3e7f3d02c38c",
                                                "text": "In fact, speaking of paedos, the prime minister chose to use one as a figleaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cdd161c-c45e-49fc-b2f0-ce7bd2d9bf21",
                        "source_entry_id": "72bdc1b3-3cd3-3275-9c0a-43219d23538e",
                        "source_sense_id": "94edd659-03c8-3b7a-8d24-5f7fef19c87e",
                        "target_lang_word": "feuille de figuier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuille de figuier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2eda3e1b-f08b-3e4e-82a8-c3bdad3a2ba7",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Face cérébrale des lobes pariétaux."
                                        ],
                                        "tags": [
                                            "Par analogie de forme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48460e99-7e5e-4b32-a5e6-d76091259798",
                                                "sense_id": "2eda3e1b-f08b-3e4e-82a8-c3bdad3a2ba7",
                                                "text": "Les anatomistes ont donné ce nom aux sillons profonds que présente la face cérébrale des pariétaux […] parce que leur disposition rameuse les a fait comparer à la feuille de figuier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b992ab-eafe-3a63-b665-c98dd85762cc",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Motif pudique couvrant les organes sexuels des représentations de nus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71628c97-ad39-4613-9292-9cc0c3b428c8",
                                                "sense_id": "c5b992ab-eafe-3a63-b665-c98dd85762cc",
                                                "text": "Pour cacher sa toison pubienne, un petit cache-sexe triangulaire également blanc, faisait l’office de feuille de figuier."
                                            },
                                            {
                                                "example_id": "7722b936-75d8-4d05-af3f-384ed7a46da5",
                                                "sense_id": "c5b992ab-eafe-3a63-b665-c98dd85762cc",
                                                "text": "Il trouve que dans mon journal je me suis « couvert d’une belle feuille de figuier » ! Ce qui m’apprend, en passant, qu’en Hollande comme dans les pays anglo-saxons, la feuille de figuier remplace la feuille de vigne."
                                            },
                                            {
                                                "example_id": "03562de9-109c-47b4-94a0-abad4c66a309",
                                                "sense_id": "c5b992ab-eafe-3a63-b665-c98dd85762cc",
                                                "text": "Curieuse à plusieurs chefs m’a paru cette feuille de figuier qui nous vient, évidemment, du troisième chapitre de la Genèse où il est dit qu’après la faute, Adam et Eve cousirent ensemble des feuilles de figuier pour s’en faire, disent les versions les plus anciennes, des tabliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1972bc6d-ba47-348c-b345-1528a774ce6a",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Sexe de femme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9796a5-42de-466a-8d6e-08f519a36dff",
                                                "sense_id": "1972bc6d-ba47-348c-b345-1528a774ce6a",
                                                "text": "Si nous avons plus de raison que les femmes, elles ont bien plus d’instinct que nous. La seule chose qu’on leur ait apprise, c’est à bien porter la feuille de figuier qu’elles ont reçue de leur première aïeule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4ead8f5-4108-3806-b19a-18c69f76ef16",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Support d’un vœu ou d’une divination."
                                        ],
                                        "tags": [
                                            "Ésotérisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04ad27b6-01c5-4092-9705-069d2bca9314",
                                                "sense_id": "f4ead8f5-4108-3806-b19a-18c69f76ef16",
                                                "text": "Chez les Tolba d’Afrique du Nord on écrit une requête sur une feuille de figuier ; si elle sèche c’est raté, si elle reste fraîche le vœu se réalise. Dans le folklore juif, le figuier est parfois une page blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c68e73-17ed-3ca2-b5d7-bb6f2dd1dbf3",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Ingrédient de préparation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b997f0-056e-426b-b211-b5efa8729309",
                                                "sense_id": "93c68e73-17ed-3ca2-b5d7-bb6f2dd1dbf3",
                                                "text": "Crème à l’infusion de feuille de figuier : 100g d'eau, 10g de sucre semoule, 1 feuille de figuier, 200g de crème liquide, 15 g de miel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66235b5-583b-34d0-9ba4-02a0ed38f8b8",
                                        "entry_id": "e1f9f84f-02d0-3cc9-a383-1d2a2be70631",
                                        "glosses": [
                                            "Plat ou assiette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e49b332b-359e-4a92-8ea7-d2270c89ee2f",
                                                "sense_id": "c66235b5-583b-34d0-9ba4-02a0ed38f8b8",
                                                "text": "Il m’avoit apporté le beurre sur une feuille de figuier. Il faisoit chaud, & il avoit demandé une mauvaise feuille de papier pour mettre entre sa main & la feuille de figuier. Cela tenoit lieu d’une assiette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
