                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a136a5e-27c0-342c-8020-d5dfe7c1f173",
                        "entry_id": "8e26b6a3-7e65-36a8-8e0e-15ab37328b16",
                        "glosses": [
                            "siehe Name"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afeb76a6-3eb2-4581-9a3d-fe8a28078c54",
                                "sense_id": "5a136a5e-27c0-342c-8020-d5dfe7c1f173",
                                "text": "„Sein Namen ist in den Markneukirchener Matrikeln ebenso wie der seines Vaters nicht auffindbar.“"
                            },
                            {
                                "example_id": "97029e52-7182-4841-b5f5-9073d3753585",
                                "sense_id": "5a136a5e-27c0-342c-8020-d5dfe7c1f173",
                                "text": "„Auch seine eigene Identität ist ihm unbekannt, bis er schließlich herausfindet, dass sein Namen Owen Brick, er als Zauberer in Queens lebt und Corporal von Beruf ist.“"
                            },
                            {
                                "example_id": "10eb8260-135a-45fd-bdc1-bd8b93cb6fd6",
                                "sense_id": "5a136a5e-27c0-342c-8020-d5dfe7c1f173",
                                "text": "„›Es ist ganz peinlich, wenn jemand zum vierten Mal fragen muss: 'Wie war ihr Namen gleich nochmal?'‹, sagt der Experte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
