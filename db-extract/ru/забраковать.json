                ],
                "senses": [
                    {
                        "sense_id": "4ba824e6-1a5b-3d31-b554-50fc50a77d82",
                        "entry_id": "8c46aa8a-c81b-3763-8d84-59d9c2ccc979",
                        "glosses": [
                            "расценить как брак; признать негодным, не соответствующим каким-либо требованиям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "483627de-71d3-40d2-906b-0686add09c08",
                                "sense_id": "4ba824e6-1a5b-3d31-b554-50fc50a77d82",
                                "text": "Ты уж меня извини, я давеча был не в духе ― картину мою забраковали, не приняли на осеннюю выставку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af71e414-629d-41d7-be3a-bba14fd2b643",
                        "source_entry_id": "8c46aa8a-c81b-3763-8d84-59d9c2ccc979",
                        "source_sense_id": "4ba824e6-1a5b-3d31-b554-50fc50a77d82",
                        "target_lang_word": "condemn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condemn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4db9cfbf-fce3-30fa-8370-5b70679c882b",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To strongly criticise or denounce; to excoriate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365abbfb-6c99-40e6-b7f4-73c512b07f41",
                                                "sense_id": "4db9cfbf-fce3-30fa-8370-5b70679c882b",
                                                "text": "The president condemned the terrorists."
                                            },
                                            {
                                                "example_id": "f7b38f8f-783c-448c-a531-d73c669b0707",
                                                "sense_id": "4db9cfbf-fce3-30fa-8370-5b70679c882b",
                                                "text": "Ignorant and ſuperſtitious wretches meaſure the actions of letterd and philoſophical men by the tattle of their nurſes or illiterate parents and companions, or by the faſhion of the country : and people of differing religions judge and condemn each other by their own tenents ; when both of them cannot be in the right, and it is well if either of them are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de82b4f-86c0-326f-9cde-1ca41580da3a",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To judicially pronounce (someone) guilty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "062d9e4c-dc49-3929-871e-99b477926739",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To judicially announce a verdict upon a finding of guilt; To sentence"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27005a2-ef4c-4bd6-9886-c43c9e3ff96c",
                                                "sense_id": "062d9e4c-dc49-3929-871e-99b477926739",
                                                "text": "The judge condemned him to death."
                                            },
                                            {
                                                "example_id": "58f00c57-670f-415e-9003-5f54e41c2d08",
                                                "sense_id": "062d9e4c-dc49-3929-871e-99b477926739",
                                                "text": "She was condemned to life in prison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe52025-a205-3470-87ff-a783b278222c",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To confer eternal divine punishment upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "257e410f-8936-314c-b3ea-f81d266eb7bc",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To destine to experience bad circumstances; to doom."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec39f07-d574-47b8-a8b4-564c5cebfc48",
                                                "sense_id": "257e410f-8936-314c-b3ea-f81d266eb7bc",
                                                "text": "Too many people are condemned to a life of poverty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a86846bd-0a90-38e5-9a31-3e313efede1c",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To declare something to be unfit for use, or further use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2763dc8d-977c-4587-9919-09686ff64e09",
                                                "sense_id": "a86846bd-0a90-38e5-9a31-3e313efede1c",
                                                "text": "There was a massive slaughter of W.R. steam power at the conclusion of the summer timetable. In all, 169 locomotives were condemned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ce1967-ff9c-3c56-b25f-040f058ae52e",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To declare something to be unfit for use, or further use.",
                                            "To adjudge (a building) as being unfit for habitation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dc972f4-8386-4f7d-80bd-12471e03859f",
                                                "sense_id": "12ce1967-ff9c-3c56-b25f-040f058ae52e",
                                                "text": "The house was condemned after it was badly damaged by fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caba09ea-0686-377a-acbe-d36bed6664bb",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To declare something to be unfit for use, or further use.",
                                            "To adjudge (building or construction work) as of unsatisfactory quality, requiring the work to be redone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd8198db-b4b2-39bd-a4a1-83308da32fb2",
                                        "entry_id": "738d0abb-6f12-34c8-8b70-77aa7d3baf53",
                                        "glosses": [
                                            "To declare something to be unfit for use, or further use.",
                                            "To adjudge (food or drink) as being unfit for human consumption."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
