                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                        "entry_id": "ff459ce7-e47a-3363-9cfb-3c6921431422",
                                        "glosses": [
                                            "große Zerstörung oder Verwüstung hinterlassend, sehr schlimm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4dc03c-0cbf-4930-aac7-538d4638a848",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "Der Sturm hatte ein verheerendes Ausmaß."
                                            },
                                            {
                                                "example_id": "afdce5b3-ab07-44fc-b0e6-c5929d99240e",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "„Einer der bislang mächtigsten Taifune ist mit verheerender Zerstörungskraft über die Philippinen hereingebrochen.“"
                                            },
                                            {
                                                "example_id": "20d0c866-38cc-45fb-9e67-16d8547ea288",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "„In den frühen Morgenstunden des 6. September 2017 zog der Hurrikan Irma in der höchsten Kategorie 5 mit rund 300 km/h genau über Barbuda und richtete verheerende Schäden an.“"
                                            },
                                            {
                                                "example_id": "223baadc-2c20-4e39-9482-91e3a68e0c1d",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "Überschrift: Verheerende Luftangriffe im Jemen"
                                            },
                                            {
                                                "example_id": "275a1d91-a288-4f21-bf8a-51d7687615ca",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "Überschrift: Verheerende Explosion in Ludwigshafen"
                                            },
                                            {
                                                "example_id": "7caf7ce7-76e8-4a6b-8334-831365149f68",
                                                "sense_id": "5cf6ea58-36a8-32fa-99bf-6bc2d28c002d",
                                                "text": "Überschrift: Verheerende Waldbrände in Kalifornien"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2d59b456-9b32-307d-8cb7-46498111b2b1",
                                        "entry_id": "ff459ce7-e47a-3363-9cfb-3c6921431422",
                                        "glosses": [
