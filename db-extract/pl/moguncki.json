                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d816ed1-2b99-411c-a98b-12ec1d84e830",
                                                "sense_id": "80e7853d-2c0a-3686-9eb4-800ed9518f02",
                                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Mainzer."
