                        "examples": [
                            {
                                "example_id": "33116d20-e6f8-4b6a-a6fe-1c788a2a43ab",
                                "sense_id": "c0db0590-5c98-3d48-bfaf-67d4e312e220",
                                "text": "В Петербурге за этакую спаржу рублик серебрецом платить надо."
                            },
                            {
                                "example_id": "559c3ab1-8423-47c3-9dcb-dc6a48dec8d8",
                                "sense_id": "c0db0590-5c98-3d48-bfaf-67d4e312e220",
                                "text": "На деревьях ещё осенний лист золотом отливает, а уж ветки серебрецом снежка пухлого присыпаны…"
                            }
                        ]
                    }
