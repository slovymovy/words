                            {
                                "example_id": "4412abb3-e37f-4ce1-a9a1-5b121c4743f3",
                                "sense_id": "f1352a1b-f7e9-3362-b606-afe5353d2895",
                                "text": "J’y ai appris [à la Conciergerie] un mot nouveau, qui n’est peut-être pas dans votre glossaire : gougnotte, subst. fém. fam. : femme ou fille qui abuse des personnes de son sexe, d’où le verbe gougnotter."
                            },
                            {
                                "example_id": "2d3095d2-f312-44d9-92cd-5e085f446b18",
                                "sense_id": "f1352a1b-f7e9-3362-b606-afe5353d2895",
                                "text": "L’autre gougnote — j’entendais ce mot pour la première fois —, à peine remise de sa pâmoison, fourra sa tête entre ces cuisses largement ouvertes et sa langue sur le clitoris raidi, humide et vermillon."
                            }
                        ]
                    }
