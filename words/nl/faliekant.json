    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8aef78f5-be92-37e1-998d-4898be0d440f",
                    "sense_definition": "geheel, totaal of volkomen; meestal gebruikt om een sterke tegenstelling of een grote fout te benadrukken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volledigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben daar <w>faliekant</w> tegen en zal nooit mijn mening veranderen.",
                            "target_lang_translations": {
                                "en": "I am <w>dead</w> set against that and will never change my mind."
                            }
                        },
                        {
                            "text": "Het plan om de nieuwe brug te bouwen is <w>faliekant</w> mislukt door een gebrek aan geld.",
                            "target_lang_translations": {
                                "en": "The plan to build the new bridge has <w>completely</w> failed due to a lack of money."
                            }
                        }
                    ],
                    "synonyms": [
                        "volkomen",
                        "totaal",
                        "volledig",
                        "vierkant"
                    ],
                    "antonyms": [
                        "enigszins",
                        "deels"
                    ],
                    "common_phrases": [
                        "faliekant tegen",
                        "faliekant mislukt",
                        "faliekant oneens"
                    ],
                    "target_lang_definitions": {
                        "en": "entirely, totally, or completely; usually used to emphasize a strong opposition or a major failure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "completely",
                                "target_lang_sense_clarification": "to the fullest extent or degree"
                            },
                            {
                                "target_lang_word": "totally",
                                "target_lang_sense_clarification": "entirely or to the fullest degree"
                            },
                            {
                                "target_lang_word": "utterly",
                                "target_lang_sense_clarification": "completely and without qualification; often used with negative outcomes"
                            },
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "used as an intensifier meaning 'completely' in phrases like 'dead set against'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "baf52bd4-c36f-3eaa-9bce-8d4fa34b4629",
                    "sense_definition": "op een volkomen verkeerde manier; totaal mis",
