                                                "example_id": "c170a59c-6219-483d-bc0f-d228fc7daa7e",
                                                "sense_id": "72714ef0-7494-3e6b-b520-3891b25a3211",
                                                "text": "One saint’s day in mid-term a certain newly-appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1a9e9b-bded-3f30-bd39-5ea15d36d5a3",
                                        "entry_id": "491812a2-32fe-3e23-bc26-cca0efadeb74",
                                        "glosses": [
                                            "To proclaim by public discourse; to utter in a sermon or a formal religious harangue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28cab1e-2945-4eee-84ff-da4bfb3605ca",
                                                "sense_id": "ec1a9e9b-bded-3f30-bd39-5ea15d36d5a3",
                                                "text": "The Spirit of the Lord God is vpon me, therefore hathe the Lord anointed me: he hathe ſent me to preache good tidings vnto the poore,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a739ab90-b1ff-3e62-b0e0-3335a243fafb",
                                        "entry_id": "491812a2-32fe-3e23-bc26-cca0efadeb74",
                                        "glosses": [
                                            "To advise or recommend earnestly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b42e9631-912a-43cc-bb6d-25ee32fed919",
                                                "sense_id": "a739ab90-b1ff-3e62-b0e0-3335a243fafb",
                                                "text": "My Mʳ preaches patience to him,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f6811f-22b9-3686-bd7c-4003d5b84aeb",
                                        "entry_id": "491812a2-32fe-3e23-bc26-cca0efadeb74",
                                        "glosses": [
                                            "To teach or instruct by preaching; to inform by preaching."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1d8564a-5982-41a1-9ae6-13e817da47cd",
                                                "sense_id": "06f6811f-22b9-3686-bd7c-4003d5b84aeb",
                                                "text": "The Spirits of the Dead, / Quitting their mortal mansion, enter not, / As falsely ye are preached, their final seat / Of bliss, or bale;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e061af96-1a62-393c-9d73-63cf16097fc9",
                                        "entry_id": "491812a2-32fe-3e23-bc26-cca0efadeb74",
                                        "glosses": [
                                            "To give advice in an offensive or obtrusive manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
