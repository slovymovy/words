                "senses": [
                    {
                        "sense_id": "e1a9968d-4692-320e-9084-8eda63636bb2",
                        "entry_id": "cfec2b1d-fdd2-35b7-bfc3-4899169f5f8b",
                        "glosses": [
                            "Creme für die Hautpflege während der Tageszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18d1d997-f0ca-47e7-a23b-537581361826",
                                "sense_id": "e1a9968d-4692-320e-9084-8eda63636bb2",
                                "text": "„Statt auf eine stark deckende Foundation sollte auf eine feuchtigkeitsspendende, getönte Tagescreme zurückgegriffen werden.“"
                            },
                            {
                                "example_id": "0db9b392-0e7d-472a-a6bd-e318d3daebb1",
                                "sense_id": "e1a9968d-4692-320e-9084-8eda63636bb2",
                                "text": "„Die Stiftung Warentest hat 13 getönte Tagescremes für rund 2,50 bis 36 Euro geprüft und Noten von \"Gut\" bis \"Mangelhaft\" vergeben.“"
                            },
                            {
                                "example_id": "8a497b14-d5ad-42f2-8ad7-c526770d26f1",
                                "sense_id": "e1a9968d-4692-320e-9084-8eda63636bb2",
                                "text": "„Nachtcremen sind fettender als Tagescremen, was unsere Haut zu Nutze macht, denn die Zellteilung ist nachts um 8mal schneller als am Tag, die Talgproduktion wird minimiert und die Durchblutung der Haut steigt, somit können mehr Inhaltsstoffe in der Haut aufgenommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
