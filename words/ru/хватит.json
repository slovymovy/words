                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Хватит> разговаривать, урок уже начался!",
                            "target_lang_translations": {
                                "en": "<Stop> talking, the lesson has already started!",
                                "zh": "<w>别</w>说话了，课已经开始了！",
                                "nl": "<w>Houd op</w> met praten, de les is al begonnen!",
                                "pl": "<w>Przestań</w> rozmawiać, lekcja już się zaczęła!",
                                "de": "<w>Hör auf</w> zu reden, der Unterricht hat schon begonnen!",
                                "fr": "<w>Ça suffit</w> de parler, le cours a déjà commencé !",
                                "it": "<Basta> parlare, la lezione è già iniziata!",
                                "cs": "<w>Dost</w> řečí, hodina už začala!",
                                "tr": "<w>Yeter</w> konuşmak, ders çoktan başladı!",
                                "es": "¡<w>Basta</w> de hablar, la clase ya empezó!"
                            }
                        },
                        {
                            "text": "Всё, <хватит>, я больше не хочу это обсуждать.",
                            "target_lang_translations": {
                                "en": "That's it, <enough>, I don't want to discuss this anymore.",
                                "zh": "行了，<w>够了</w>，我不想再讨论这件事了。",
                                "nl": "Klaar, <w>genoeg</w>, ik wil dit niet meer bespreken.",
                                "pl": "Wszystko, <w>dość</w>, nie chcę już więcej o tym dyskutować.",
                                "de": "Alles, <w>genug</w>, ich möchte das nicht mehr diskutieren.",
                                "fr": "C'est bon, <w>ça suffit</w>, je ne veux plus en discuter.",
                                "it": "Tutto qui, <basta>, non voglio più discuterne.",
                                "cs": "Už <w>dost</w>, nechci to dál probírat.",
                                "tr": "Tamam, <w>yeter</w>, bunu daha fazla tartışmak istemiyorum.",
                                "es": "Ya, <w>basta</w>, no quiero discutir esto más."
                            }
