                        "épouser le relief"
                    ]
                },
                {
                    "sense_id": "331c1114-ef71-3b1b-8a19-55dcac563f13",
                    "sense_definition": "Faire sien un parti, une opinion, une querelle ou s'engager résolument dans une voie.",
