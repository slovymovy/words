    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8da6b35d-e962-3879-a70b-2008245b86ed",
                    "sense_definition": "Faire obtenir à quelqu'un ce dont il a besoin ou ce qui lui est agréable ; fournir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon ami a réussi à me <w>procurer</w> deux places pour le concert de ce soir."
                        },
                        {
                            "text": "Il est difficile de se <w>procurer</w> ce médicament sans ordonnance médicale."
                        }
                    ],
                    "synonyms": [
                        "fournir"
                    ],
                    "common_phrases": [
                        "se procurer des billets",
                        "procurer un emploi"
                    ]
                },
                {
                    "sense_id": "bd272086-02a2-3a32-9d9f-78377b62edda",
                    "sense_definition": "Être la cause d'une sensation, d'un sentiment ou d'un état chez quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette promenade matinale dans la forêt lui <w>procure</w> un profond sentiment de calme."
                        },
                        {
                            "text": "Prendre une douche chaude après le sport <w>procure</w> un soulagement immédiat."
                        }
                    ],
                    "common_phrases": [
                        "procurer du plaisir",
                        "procurer un soulagement"
                    ]
                },
                {
                    "sense_id": "49c901bd-979c-3527-b6e6-5258e4ca403e",
                    "sense_definition": "Employer ses soins et ses efforts pour faire advenir quelque chose de favorable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre affirmait vouloir tout faire pour <w>procurer</w> le bien public."
                        },
                        {
                            "text": "Chaque citoyen devrait veiller à <w>procurer</w> la concorde dans son entourage."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage soutenu et vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "ef74ab80-6dc4-3aa5-aa82-97f943f770ee",
                    "sense_definition": "Prendre soin de l'établissement ou de la publication d'un texte.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur a <w>procuré</w> une nouvelle édition critique des poèmes de Ronsard."
                        },
                        {
                            "text": "Il passa plusieurs années à <w>procurer</w> la publication des manuscrits inédits."
                        }
                    ],
                    "traits": [
