                ],
                "senses": [
                    {
                        "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                        "entry_id": "a843187a-e22c-34a9-8054-bdb53bbed6f0",
                        "glosses": [
                            "ein Bundesland der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dfd1d19-4d5b-443f-8859-a34d0b66568e",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Hamburg und Schleswig-Holstein wollen im Bereich der Life Science enger mit den österreichischen Bundesländern Oberösterreich und Steiermark zusammenarbeiten."
                            },
                            {
                                "example_id": "94e0afd8-e019-4058-8846-2acf1ab812f2",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Ausgerechnet in einem braven Dorf in Oberösterreich hat sich der Londoner Galerist Nicholas Treadwell niedergelassen."
                            },
                            {
                                "example_id": "6d545510-b5db-4360-a024-e017feba9f63",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Die Gemeinde Baumgartenberg in Oberösterreich hatte Glück, der Machlanddamm hielt dem Druck der Wassermassen stand."
                            },
                            {
                                "example_id": "282ecb2e-b4a0-4982-8e16-e1fbdcb42516",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Oberösterreich feiert den zweihundertsten Geburtstag von Adalbert Stifter, einem großen Dichter der Natur."
                            },
                            {
                                "example_id": "8309bfed-eb49-41dd-9a8c-d3cb141b7edb",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "„Die Kreativwirtschaft in Oberösterreich zeichnet sich dadurch aus, dass hier wenig branchenspezifisch, dafür sehr übergreifend und interaktiv gearbeitet wird“, sagt dazu Patrick Bartos, Geschäftsführer der Creative Region, einer Plattform für Kreativwirtschaft in Oberösterreich."
                            },
                            {
                                "example_id": "42fcbb50-348e-4740-abd9-54a566160270",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Welche Erinnerungen haben Sie an das Oberösterreich der 40er und 50er Jahre?"
                            },
                            {
                                "example_id": "8179a2ad-c7d4-4ec4-80e2-339b1c8291a1",
                                "sense_id": "70c476e2-c39d-3d00-a816-b3f221be87cb",
                                "text": "Norbert Ortmayr hat dieses soziale Austauschsystem, das den Zerfall der Monarchie überlebte, für das Oberösterreich der Zwischenkriegszeit beschrieben und analysiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
