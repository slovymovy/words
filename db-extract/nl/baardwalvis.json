                        "sense_id": "3e229e23-7e97-33e4-962a-479cd5ddbeb8",
                        "entry_id": "2a3b24e7-1395-3b31-aee7-1a75c2bf4518",
                        "glosses": [
                            "zeezoogdieren uit de onderorde Mysticeti, met baleinplaten in de bovenkaak, waarmee ze voedseldeeltjes uit het water kunnen filteren"
                        ],
                        "tags": [
                            "walvisachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "a319cf4d-38dc-4c28-b54c-564534ac4062",
                                "sense_id": "3e229e23-7e97-33e4-962a-479cd5ddbeb8",
                                "text": "Naast de soorten die de Japanse walvisjagers op dit moment vangen, gaan zij zich straks ook richten op baardwalvissen en vinvissen."
                            },
                            {
                                "example_id": "2bbb46eb-38f9-48d0-a269-7018d80959e3",
                                "sense_id": "3e229e23-7e97-33e4-962a-479cd5ddbeb8",
                                "text": "Amateurpaleontoloog Wolfgang Höpfner en zijn kameraden hadden het skelet de voorbije maanden blootgelegd. De baardwalvis leefde rond elf miljoen jaar geleden in de oer-Noordzee."
                            }
                        ]
                    }
                ],
