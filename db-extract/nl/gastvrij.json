                    }
                ],
                "senses": [
                    {
                        "sense_id": "75a4ed8a-4f58-3f6b-b5e8-4d319c56a9d7",
                        "entry_id": "e2752be4-52e2-3cd9-a43b-5cbe8c1d547f",
                        "glosses": [
                            "gul in het onthalen of herbergen van gasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4678cc55-d6d6-48c2-a098-c3b8f54176c7",
                                "sense_id": "75a4ed8a-4f58-3f6b-b5e8-4d319c56a9d7",
                                "text": "Er stond ons een gastvrije verwelkoming te wachten in ons gastgezin."
                            },
                            {
                                "example_id": "38c68df5-7d76-4b7d-97a1-23b112b99895",
                                "sense_id": "75a4ed8a-4f58-3f6b-b5e8-4d319c56a9d7",
                                "text": "Overal ter wereld was de lokale bevolking gastvrij en verwelkomde vermoeide lopers met een warme kop thee of een bed voor de nacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89f73479-bf55-4f29-919e-c07d2a155846",
                        "source_entry_id": "e2752be4-52e2-3cd9-a43b-5cbe8c1d547f",
                        "source_sense_id": "75a4ed8a-4f58-3f6b-b5e8-4d319c56a9d7",
                        "source_sense_description": "gul in het onthalen of herbergen van gasten",
                        "target_lang_word": "gastfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gastfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                        "entry_id": "fb9706a6-df2f-3775-9cb4-9b5d97097436",
                                        "glosses": [
                                            "in großzügiger Weise gerne bereit seiend, Gäste zu sich einzuladen, bei sich aufzunehmen, zu bewirten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2985eb9-5f51-4921-bf5e-b79cc288fd28",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Diesseits und jenseits des Rheins, in Hagenau, Fort Louis, Philippsburg, der Ortenau, fand ich die Personen zerstreut, die ich in Sesenheim vereinigt gesehn, jeden bei sich, als freundlichen Wirt, gastfrei und so gern Küche und Keller als Gärten und Weinberge, ja die ganze Gegend aufschließend.“"
                                            },
                                            {
                                                "example_id": "8e296131-8a10-428e-b689-508010247a51",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Paris iﬅ durchaus nicht gaﬅfreier als London und weder Paris noch London ſind halb ſo gaﬅfrei, wie man die Bewohner ſchwach bevölkerter Gegenden findet, ſie mögen civiliſirt oder wild ſein, denn dieſe ſind ﬅets überglücklich, wenn ſie die Geſellſchaft eines Fremden haben können und bewirthen ihn gern Tage und Wochen.“"
                                            },
                                            {
                                                "example_id": "7ebf639b-7cc6-4786-a5ee-4dec08cf93e7",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Andere flohen aus dem libanesischen Bürgerkrieg und fanden ebenfalls in Marokko ein gastfreies Land, das keinen Anstoß an ihren Praktiken nimmt.“"
                                            },
                                            {
                                                "example_id": "6e2c1453-772e-47ae-9348-afd70f692bc5",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Denn neben vereins-geprägten Aktivitäten wie den vielen (vorwiegend kulturellen) Ausflügen ist der Zeißiger Kulturverein in erster Linie ein öffentlicher, gastfreier, der Interessenten oft zum Besuch einlädt: bei besagten Offenen Fenstern, zum Tag des offenen Denkmals, zu Jutry w Serbach (Ostern mit den Sorben), zum Sommer- und/oder Herbstfest, zum Weihnachtsmarkt, zu den Zeißiger Lesenächten und Hoffesten …“"
                                            },
                                            {
                                                "example_id": "b3c4f649-1011-4700-b48c-08296ee04f1f",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Ihre Häuser waren sehr nett, sie selbst sehr gastfrei.“"
                                            },
                                            {
                                                "example_id": "885155a1-6221-45f9-a831-1f656a625c69",
                                                "sense_id": "06501128-6088-32d4-9245-d44f48b27c5c",
                                                "text": "„Und das habe auch direkten Bezug zur Stadt, wo Goethe einst bei den Jacobis zu Besuch war und niederschrieb, sie hätten ‚das gastfreieste aller Häuser‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb841482-deda-4621-9f07-a1c172d5d999",
                        "source_entry_id": "e2752be4-52e2-3cd9-a43b-5cbe8c1d547f",
                        "source_sense_id": "75a4ed8a-4f58-3f6b-b5e8-4d319c56a9d7",
