        "fr-extract.jsonl": [
            {
                "entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                "word": "stéarine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35b550cb-eef7-4275-9e75-eff7ecf818fc",
                        "entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "tags": [
                            "plural"
                        ],
                        "form": "stéarines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                        "entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "glosses": [
                            "Triglycéride, triple ester du glycérol et d’acide stéarique, substance solide, nacrée, tirée du suif et qu’on emploie pour la fabrication de la bougie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66844bc-e739-4615-bd4b-bfc9f25bf969",
                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                "text": "M. Toutin-Laroche, grand et maigre, ancien inventeur d’un mélange de suif et de stéarine pour la fabrication des bougies, rêvait le Sénat."
                            },
                            {
                                "example_id": "ef34a800-844a-478c-94e2-114182be8108",
                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                "text": "La stéarine est analogue à la palmitine qui l’accompagne généralement dans les graisses solides. On la prépare en partant du suif de mouton, mais on ne l'obtient pas chimiquement pure."
                            },
                            {
                                "example_id": "9e0426dd-de64-4691-b553-82427a75c57f",
                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                "text": "Les graisses de suintine traitées par distillation donnent de l'huile à gaz 4%, de l'oléine et de la stéarine 45%, de l'huile verte 15%, enfin d'un résidu graissaux dit « pitch » 15%."
                            },
                            {
                                "example_id": "271aea95-8bff-49e0-9828-79f3524f869a",
                                "sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                                "text": "Le territoire envahi, la guerre éternisée, voilà ce qu’en réalité la France doit à Joffre. Elle est assez riche en grands Français, dignes du marbre, pour ne point s’encombrer de statues de stéarine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9fe71d8-161e-4231-9749-41eb39fd72a1",
                        "source_entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "source_sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                        "target_lang_word": "Stearin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stearin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df5701d1-913f-342e-bb87-3178ff0b82c9",
                                        "entry_id": "4511337c-1ed5-3758-97e2-1af228d2d9e9",
                                        "glosses": [
                                            "Stoff, der ein Gemisch aus Stearin- und Palmitinsäure ist; Rohstoff für Kerzen, Kosmetik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf134a1d-43ec-4330-b14d-e48889e254fd",
                                                "sense_id": "df5701d1-913f-342e-bb87-3178ff0b82c9",
                                                "text": "„Das Licht im Kupee hat, wie ich sehe, meine Jacke die ganze Nacht hindurch mit Stearin betropft.“"
                                            },
                                            {
                                                "example_id": "3a30e16f-59e4-4ec7-92f8-1af4fa751abb",
                                                "sense_id": "df5701d1-913f-342e-bb87-3178ff0b82c9",
                                                "text": "„Das flüssige Olein wurde durch Auspressen von den beiden anderen Fettsäuren getrennt, Margarin und Stearin waren die Ausgangsprodukte der Kerzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f13fe26f-83a7-49c3-84b2-2070c28a8b99",
                        "source_entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "source_sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                        "target_lang_word": "Tristearin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5dc59d08-d186-4f85-90a3-6f1dd5132c5b",
                        "source_entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "source_sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                        "target_lang_word": "stearin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stearin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21f65573-54e8-324d-afab-5282e46dc749",
                                        "entry_id": "891b3f00-b9e9-3832-a731-382c090086e7",
                                        "glosses": [
                                            "Solid fat."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                        "entry_id": "891b3f00-b9e9-3832-a731-382c090086e7",
                                        "glosses": [
                                            "A glyceride (especially the triglyceride) of stearic acid"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "627d9d0a-b678-42fd-a7e9-6f24f7cb1f75",
                                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                                "text": "1860, Oil, entry in The Penny Cyclopædia of the Society for the Diffusion of Useful Knowledge, Volumes 16: Murillo—Organ, page 415,\nWhen exposed to the temperature of 32°, it deposits stearin, and the oil separated from the stearin by filtration is soluble in 0.82 of pure alcohol when heated to about 168° Fahr."
                                            },
                                            {
                                                "example_id": "b9583729-35c0-49c5-8507-3716f327adc1",
                                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                                "text": "Palmkernel (PK) oil is fractionated in one step to concentrate the triglycerides containing medium-chain fatty acids (lauric and myristic) into a stearin fraction."
                                            },
                                            {
                                                "example_id": "a3920ead-48f5-4c1c-8776-428bb78c7e63",
                                                "sense_id": "e492ef17-9c79-3542-880b-43d18e1b1bdf",
                                                "text": "Stearin is a hard, nongreasy substance, an ester of stearic acid, that is mixed with molten tallow at about a 1:9 ratio to make a tallow candle that is harder, burns longer, and does not give off the usual smoke and unpleasant odors of ordinary tallow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f16897d7-246b-4895-a742-0476475b793c",
                        "source_entry_id": "b997e62c-88f5-3756-b866-b9b944bfc824",
                        "source_sense_id": "62fd39d6-3c79-3f5b-8479-eb42c9b9f6cb",
                        "target_lang_word": "stearine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stearine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed826a47-11b5-349a-b579-abf4b5159c0e",
                                        "entry_id": "531d7c6d-25b9-3ba3-8061-aed3eadaec56",
                                        "glosses": [
                                            "Alternative form of stearin."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8dc47a3-8969-463e-8963-81c0b9371fa2",
                                                "sense_id": "ed826a47-11b5-349a-b579-abf4b5159c0e",
                                                "text": "The solid and fixed oily bodies, or stearines, contain less water than the soft and delicate fats and fluid oils, while alcohol, the lowest of the class, contains as much as 39 per cent, of water, and is quite soluble in that fluid."
                                            },
                                            {
                                                "example_id": "102dcd23-48f7-4118-826d-7ce93a06eea1",
                                                "sense_id": "ed826a47-11b5-349a-b579-abf4b5159c0e",
                                                "text": "1835, Fat, entry in Andrew Ure, William Nicholson, A Dictionary of Chemistry and Mineralogy, page 463,\nThe margaric acid of the stearines had precisely the same capacity for saturation as that which was extracted from the soaps formed of fat."
                                            },
                                            {
                                                "example_id": "b454f17e-3e1b-44e7-9978-906dd97585d7",
                                                "sense_id": "ed826a47-11b5-349a-b579-abf4b5159c0e",
                                                "text": "Although the saturated glycerides that make up stearine are found in many kinds of oils, the amount of stearine found in cottonseed oil makes it rather unique."
                                            },
                                            {
                                                "example_id": "4c70fc66-9bda-4378-a3e7-712e33de74ae",
                                                "sense_id": "ed826a47-11b5-349a-b579-abf4b5159c0e",
                                                "text": "2002, (Indian) National Institute of Industrial Research, Modern Technology Of Oils, Fats & Its Derivatives, Delhi, page 71,\nVirtually the only commercial production of vegetable oil stearines is from coconut oil and other lauric acid oils, which are processed like the graining and seeding of oleo stock or other animal fats, […] ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
