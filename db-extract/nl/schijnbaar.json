                "senses": [
                    {
                        "sense_id": "66546553-9fe2-30c5-84cc-80a9ab1f79ae",
                        "entry_id": "f291c16e-64d0-3f02-9909-3c7ec567054d",
                        "glosses": [
                            "zo als iets lijkt te zijn maar in de werkelijkheid niet is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba23d47d-e851-48b5-9f01-9c13fc9a22e6",
                                "sense_id": "66546553-9fe2-30c5-84cc-80a9ab1f79ae",
                                "text": "Het schijnbaar verdwijnen van de zon tijdens een verduistering betekent niet dat de maan even groot is."
                            },
                            {
                                "example_id": "dd322439-f90d-4724-9159-28c84f575490",
                                "sense_id": "66546553-9fe2-30c5-84cc-80a9ab1f79ae",
                                "text": "Hoewel ik er vaak was geweest en de klinkende namen van Titiaan en Tintoretto achteloos door soiréetjes had laten rollen, en hoewel ik geroutineerd in mijn krant bleef lezen terwijl de vuurrode hogesnelheidstrein mij over de landverbinding van Mestre naar de oude stad bracht en veelbetekenend begon af te remmen, en hoewel ik mij had voorgenomen om mijn entree in de stad met een praktische instelling te benaderen en enige eventuele beroering van het gemoed uit te stellen totdat ik goed en wel was geïnstalleerd, moest ik even naar adem happen toen ik het station uit liep en het breekbare, pastelkleurige cliché van de stad aan het groene water zich onbekommerd en schijnbaar onschuldig voor mij ontvouwde."
                            },
                            {
                                "example_id": "13567b29-4942-48dd-bbe1-db4a193ab772",
                                "sense_id": "66546553-9fe2-30c5-84cc-80a9ab1f79ae",
                                "text": "Ja, dat was precies wat zijn en Louises probleem was. Schijnbaar onoplosbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a5b2754-76a6-475a-81fd-3c03994fdac1",
                        "source_entry_id": "f291c16e-64d0-3f02-9909-3c7ec567054d",
                        "source_sense_id": "66546553-9fe2-30c5-84cc-80a9ab1f79ae",
                        "source_sense_description": "naar aanzien",
                        "target_lang_word": "scheinbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheinbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c3bac3-6ccf-333c-bd3d-3093a1f67237",
                                        "entry_id": "72618d97-5ff8-3a5e-8fcd-01c2a1f2cb13",
                                        "glosses": [
                                            "(nur) auf den ersten Blick oder vordergründig wahr; etwas scheint zwar so zu sein, ist aber nicht so"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced3b6b0-9b3c-455a-a028-f98367c7209f",
                                                "sense_id": "d3c3bac3-6ccf-333c-bd3d-3093a1f67237",
                                                "text": "Dies ist ein nur scheinbar günstiges Angebot."
                                            },
                                            {
                                                "example_id": "6506c36d-0590-4351-8b7a-63c48a51d41d",
                                                "sense_id": "d3c3bac3-6ccf-333c-bd3d-3093a1f67237",
                                                "text": "Die Unterredung zieht sich scheinbar endlos in die Länge."
                                            },
                                            {
                                                "example_id": "9f852ca3-e1ab-4232-9b79-4d521104bc5d",
                                                "sense_id": "d3c3bac3-6ccf-333c-bd3d-3093a1f67237",
                                                "text": "Das Medikament bewirkte nur eine scheinbare Verbesserung."
                                            },
                                            {
                                                "example_id": "8b336b07-a9f6-4d45-9069-149c1f351063",
                                                "sense_id": "d3c3bac3-6ccf-333c-bd3d-3093a1f67237",
                                                "text": "„Wer sich jedoch eine Basiskompetenz im Spielen angeeignet hat, gerät auch an scheinbar spielfeindlichen, anregungsarmen Orten, auch ohne jegliches Spielgerät, auch ohne Mitspieler, nicht in Verlegenheit, zu sinnvollem Spiel zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff54a948-c7c1-3e35-9aea-20afa8f4f08e",
                                        "entry_id": "72618d97-5ff8-3a5e-8fcd-01c2a1f2cb13",
                                        "glosses": [
                                            "dem Anscheine nach, wahrscheinlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3e31bc-c0fa-4635-941b-1e7b3edc2dfe",
                                                "sense_id": "ff54a948-c7c1-3e35-9aea-20afa8f4f08e",
                                                "text": "Wir haben dieses Jahr scheinbar einen guten Sommer."
                                            },
                                            {
                                                "example_id": "c743c945-2357-404e-b212-a157fff402ee",
                                                "sense_id": "ff54a948-c7c1-3e35-9aea-20afa8f4f08e",
                                                "text": "Machen Sie sich keine Sorgen, die Fluglotsen haben scheinbar alles im Griff."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "71edd12e-b55d-31cb-90a6-786eb7d38652",
                                        "entry_id": "72618d97-5ff8-3a5e-8fcd-01c2a1f2cb13",
                                        "glosses": [
                                            "sichtbar, sichtlich, offenbar"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c7fb035f-b737-3b26-8f2a-e4a16ca424d7",
                                        "entry_id": "72618d97-5ff8-3a5e-8fcd-01c2a1f2cb13",
                                        "glosses": [
                                            "die sichtbare Realität einer betrachteten Größe betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dcfe3c0-e7ce-40a0-8437-ff092ff48314",
                                                "sense_id": "c7fb035f-b737-3b26-8f2a-e4a16ca424d7",
                                                "text": "Die scheinbare jährliche Bahn der Sonne definiert den Grosskreis der Ekliptik."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7d964d88-2c2e-3d84-994e-906d7893d1ca",
                                        "entry_id": "72618d97-5ff8-3a5e-8fcd-01c2a1f2cb13",
