                "senses": [
                    {
                        "sense_id": "08de44f6-a18b-30a1-95d1-b5fb94f3d0f2",
                        "entry_id": "c7d2a29f-d272-3951-87c1-f982efc80b7b",
                        "glosses": [
                            "действие по значению гл. набрасывать, набросить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff8908c-dbc3-4284-a194-5b69d6bc84e0",
                                "sense_id": "08de44f6-a18b-30a1-95d1-b5fb94f3d0f2",
                                "text": "«Ливерпуль» отыгрался на 35-й – Диогу Жота замкнул мягкий наброс Энди Робертсона с линии вратарской."
                            }
                        ]
                    },
                    {
                        "sense_id": "9383e89c-2d79-3829-ae70-a96a9fea8357",
                        "entry_id": "c7d2a29f-d272-3951-87c1-f982efc80b7b",
                        "glosses": [
                            "полит. жарг. вброс недостоверной информации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eaaaa39-14c2-46c3-ae0e-e60d23add666",
                                "sense_id": "9383e89c-2d79-3829-ae70-a96a9fea8357",
                                "text": "Также информацию о введении платной вакцинации в России опроверг зампредседателя комитета Госдумы по охране здоровья депутат Алексей Куринный. Он предположил, что «это некий наброс информации, как дополнительный такой аргумент для тех, кто еще не вакцинировался»."
                            }
                        ]
                    }
