                ],
                "senses": [
                    {
                        "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                        "entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                        "glosses": [
                            "Raum, in dem Tee serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e94be37-c25e-49ba-b53b-e86eb44f56c0",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "In der Teestube gab es nicht nur Tee, sondern auch Kekse."
                            },
                            {
                                "example_id": "6d081ef7-df0f-4a13-ba06-fa688c2c379e",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "Sie trafen sich jeden Mittwoch zum Kartenspielen und Reden in der Teestube."
                            },
                            {
                                "example_id": "8680e822-cca4-4239-9b91-cf12aee5b9cf",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "Teestuben haben im türkischen Kulturkreise die Bedeutung des europäischen Cafés."
                            },
                            {
                                "example_id": "555a3ee3-5da3-4bd0-8223-566709fe3af1",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "„Val sah, wie die Touristen im Innern der Teestube sie anstarrten.“"
                            },
                            {
                                "example_id": "55d18e87-94d1-4355-9e62-d0ac735d4c49",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "„Es war Zeit für eine Pause und ich steuerte mein beladenes Rad durch das Gewirr an Menschen und Autos zu einer Teestube.“"
                            },
                            {
                                "example_id": "4d833475-f4b9-4d8d-8eec-16c1e43ec98f",
                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                "text": "„Er verabschiedete sich darauf von ihr und verließ die Teestube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c70645-7235-4253-9f5e-240f73b79b4a",
                        "source_entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                        "source_sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                        "source_sense_description": "Raum, in dem Tee serviert wird",
                        "target_lang_word": "tearoom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tearoom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66a10803-a0cb-36fa-b06a-049fb8f3449c",
                                        "entry_id": "e232d56d-f3ba-375c-9021-6f57326ddb94",
                                        "glosses": [
                                            "A café which serves tea, usually with light food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b64e20-edf3-4245-bb60-7026a8e78577",
                                                "sense_id": "66a10803-a0cb-36fa-b06a-049fb8f3449c",
                                                "text": "At Rannoch, the platforms were rebuilt. Although the station tearoom couldn't be reached by rail during the closure, which started on October 5, it did help feed and sustain the workforce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00377b7-df5d-3304-889d-de2d97449681",
                                        "entry_id": "e232d56d-f3ba-375c-9021-6f57326ddb94",
                                        "glosses": [
                                            "A public lavatory, especially (US, gay slang, dated) as a meeting place for gay men."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8dd7fc2-8655-457f-b8a7-f8e60ff377e2",
                                                "sense_id": "a00377b7-df5d-3304-889d-de2d97449681",
                                                "text": "I'm deathly afraid of the tearooms though, John. Some of my best friends have been entrapped and busted by the fuzz."
                                            },
                                            {
                                                "example_id": "cd6457ba-baed-4d3e-9f35-e4d708968b16",
                                                "sense_id": "a00377b7-df5d-3304-889d-de2d97449681",
                                                "text": "I had run into Grant in a tea-room—The busy main floor crapper—a few months earlier."
                                            },
                                            {
                                                "example_id": "c5770ba0-f9ba-4b92-b44c-fa21f02981ff",
                                                "sense_id": "a00377b7-df5d-3304-889d-de2d97449681",
                                                "text": "The euphemistically named \"tea room\" has been used in sexual subcultures among men who have sex with men (MSM) to describe public sex environments, usually public toilets, where men meet other men in sexual interaction... The term itself might be outdated..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "782763bb-8ba9-383e-ab37-09663cfdd67b",
                                        "entry_id": "e232d56d-f3ba-375c-9021-6f57326ddb94",
                                        "glosses": [
                                            "A room in a workplace set aside for tea breaks, lunch breaks, snacking, etc; a break room."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64cf4c59-d44b-4d8f-b5b8-4c00de66ad1b",
                        "source_entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                        "source_sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
