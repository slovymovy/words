{
    "word_family": [
        "daintily",
        "daintiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45c0aabb-a31a-3cc3-a194-e17288a93b56",
                    "sense_definition": "Delicately small, elegant, and pretty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>dainty</w> necklace that sparkled in the sunlight.",
                            "target_lang_translations": {
                                "it": "Indossava una collana <w>delicata</w> che scintillava alla luce del sole.",
                                "de": "Sie trug eine <w>zierliche</w> Halskette, die im Sonnenlicht funkelte."
                            }
                        },
                        {
                            "text": "The garden was filled with <w>dainty</w> flowers that swayed in the breeze.",
                            "target_lang_translations": {
                                "it": "Il giardino era pieno di fiori <w>graziosi</w> che ondeggiavano nella brezza.",
                                "de": "Der Garten war voll von <w>zarten</w> Blumen, die sich in der Brise wiegten."
                            }
                        }
                    ],
                    "synonyms": [
                        "neat",
                        "petite"
                    ],
                    "common_phrases": [
                        "dainty hands",
                        "dainty feet"
                    ],
                    "target_lang_definitions": {
                        "it": "Delicatamente piccolo, elegante e grazioso.",
                        "de": "Auf ansprechende Weise fein, klein und zierlich."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "delicato",
                                "target_lang_sense_clarification": "minuto e aggraziato"
                            },
                            {
                                "target_lang_word": "grazioso",
                                "target_lang_sense_clarification": "carino ed elegante"
                            },
                            {
                                "target_lang_word": "fine",
                                "target_lang_sense_clarification": "raffinato, di fattura minuta"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zierlich",
                                "target_lang_sense_clarification": "feingliedrig, zart gebaut"
                            },
                            {
                                "target_lang_word": "fein",
                                "target_lang_sense_clarification": "filigran und detailliert"
                            },
                            {
                                "target_lang_word": "zart",
                                "target_lang_sense_clarification": "anmutig und wenig robust wirkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99b31e42-086f-3d8c-9e9f-e898f34f3f4a",
                    "sense_definition": "Fussy or fastidious, especially regarding food or manners.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is quite <w>dainty</w> about his food and refuses to eat anything spicy.",
                            "target_lang_translations": {
                                "it": "È piuttosto <w>schizzinoso</w> con il cibo e rifiuta di mangiare qualsiasi cosa piccante.",
                                "de": "Er ist ziemlich <w>mäkelig</w> beim Essen und weigert sich, etwas Scharfes zu sich zu nehmen."
                            }
                        },
                        {
                            "text": "Do not be so <w>dainty</w> about getting your hands dirty while gardening.",
                            "target_lang_translations": {
                                "it": "Non essere così <w>schizzinoso</w> all'idea di sporcarti le mani facendo giardinaggio.",
                                "de": "Sei nicht so <w>zimperlich</w>, wenn es darum geht, dir bei der Gartenarbeit die Hände schmutzig zu machen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Schizzinoso o esigente, specialmente riguardo al cibo o ai modi.",
                        "de": "Wählerisch, übertrieben empfindlich oder heikel, besonders beim Essen oder bei Manieren."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "schizzinoso",
                                "target_lang_sense_clarification": "difficile da accontentare, esigente"
                            },
                            {
                                "target_lang_word": "difficile",
                                "target_lang_sense_clarification": "esigente rispetto a cibo o gusti"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mäkelig",
                                "target_lang_sense_clarification": "wählerisch, besonders beim Essen"
                            },
                            {
                                "target_lang_word": "pingelig",
                                "target_lang_sense_clarification": "übergenau, heikel"
                            },
                            {
                                "target_lang_word": "zimperlich",
                                "target_lang_sense_clarification": "überempfindlich, empfindlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7341f5ce-1952-3219-91f0-f897a11794fd",
                    "sense_definition": "Excellent, valuable, or fine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>dainty</w> feast for the visiting dignitaries.",
                            "target_lang_translations": {
                                "it": "Lo chef preparò un banchetto <w>squisito</w> per i dignitari in visita.",
                                "de": "Der Küchenchef bereitete ein <w>erlesenes</w> Festmahl für die angereisten Würdenträger zu."
                            }
                        },
                        {
                            "text": "They enjoyed a <w>dainty</w> selection of rare wines from the cellar.",
                            "target_lang_translations": {
                                "it": "Hanno gustato una <w>prelibata</w> selezione di vini rari della cantina.",
                                "de": "Sie genossen eine <w>feine</w> Auswahl an seltenen Weinen aus dem Keller."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Eccellente, squisito o di alto pregio.",
                        "de": "Vorzüglich, exquisit oder von erlesener Qualität."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "squisito",
                                "target_lang_sense_clarification": "di ottima qualità o sapore"
                            },
                            {
                                "target_lang_word": "prelibato",
                                "target_lang_sense_clarification": "eccellente e ricercato"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erlesen",
                                "target_lang_sense_clarification": "ausgesucht und vorzüglich"
                            },
                            {
                                "target_lang_word": "delikat",
                                "target_lang_sense_clarification": "köstlich, schmackhaft"
                            },
                            {
                                "target_lang_word": "fein",
                                "target_lang_sense_clarification": "von hoher Qualität"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f71e5abb-2110-320c-af78-75119bf49663",
                    "sense_definition": "A choice or pleasing food item; a delicacy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The table was covered with various <w>dainties</w> for the guests to enjoy.",
                            "target_lang_translations": {
                                "it": "La tavola era imbandita con varie <w>leccornie</w> che gli ospiti potevano gustare.",
                                "de": "Der Tisch war mit verschiedenen <w>Leckerbissen</w> gedeckt, an denen sich die Gäste erfreuen konnten."
                            }
                        },
                        {
                            "text": "She brought a box of sweet <w>dainties</w> to the afternoon tea party.",
                            "target_lang_translations": {
                                "it": "Ha portato una scatola di dolci <w>ghiottonerie</w> per il tè del pomeriggio.",
                                "de": "Sie brachte eine Schachtel süßer <w>Leckereien</w> zur nachmittäglichen Teegesellschaft mit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Cibo prelibato e particolarmente gradito; una leccornia.",
                        "de": "Eine besonders schmackhafte, feine Speise; ein Gaumenschmaus."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "leccornia",
                                "target_lang_sense_clarification": "cibo gustoso e raffinato"
                            },
                            {
                                "target_lang_word": "ghiottoneria",
                                "target_lang_sense_clarification": "delicatezza gastronomica"
                            },
                            {
                                "target_lang_word": "prelibatezza",
                                "target_lang_sense_clarification": "cibo raro e squisito"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Leckerbissen",
                                "target_lang_sense_clarification": "besonders wohlschmeckende Speise"
                            },
                            {
                                "target_lang_word": "Delikatesse",
                                "target_lang_sense_clarification": "feine, erlesene Spezialität"
                            },
                            {
                                "target_lang_word": "Leckerei",
                                "target_lang_sense_clarification": "etwas Süßes oder Feines zum Naschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea93feb0-7f4e-33de-93d7-61a810510246",
                    "sense_definition": "A small, fancy homemade cookie or pastry served at social events.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every guest was offered a plate of homemade <w>dainties</w>.",
                            "target_lang_translations": {
                                "it": "A ogni ospite è stato offerto un piatto di <w>pasticcini</w> fatti in casa.",
                                "de": "Jedem Gast wurde ein Teller mit hausgemachtem <w>Feingebäck</w> angeboten."
                            }
                        },
                        {
                            "text": "The local bakery is famous for its holiday <w>dainties</w>.",
                            "target_lang_translations": {
                                "it": "La pasticceria locale è famosa per i suoi <w>dolcetti</w> delle feste.",
                                "de": "Die örtliche Bäckerei ist berühmt für ihr festliches <w>Kleingebäck</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in Canadian English."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Piccolo dolcetto o pasticcino fatto in casa servito in occasioni sociali.",
                        "de": "Ein kleines, feines selbstgebackenes Gebäckstück oder Plätzchen."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pasticcino",
                                "target_lang_sense_clarification": "piccolo dolce da tè o rinfresco"
                            },
                            {
                                "target_lang_word": "dolcetto",
                                "target_lang_sense_clarification": "piccola pasta o biscotto"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Törtchen",
                                "target_lang_sense_clarification": "kleines, feines Gebäck"
                            },
                            {
                                "target_lang_word": "Teilchen",
                                "target_lang_sense_clarification": "kleines feines Feingebäck"
                            },
                            {
                                "target_lang_word": "Plätzchen",
                                "target_lang_sense_clarification": "kleines feines Keksgebäck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196aa388-c1e6-3baf-ba5a-c3240bbebdbb",
                    "sense_definition": "A feeling of esteem or honour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the ancient tradition in high <w>dainty</w>.",
                            "target_lang_translations": {
                                "it": "Teneva l'antica tradizione in grande <w>stima</w>.",
                                "de": "Er hielt die alte Tradition in hoher <w>Wertschätzung</w>."
                            }
                        },
                        {
                            "text": "The king was treated with great <w>dainty</w> by his loyal subjects.",
                            "target_lang_translations": {
                                "it": "Il re fu trattato con grande <w>riguardo</w> dai suoi leali sudditi.",
                                "de": "Der König wurde von seinen treuen Untertanen mit großem <w>Respekt</w> behandelt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Sentimento di stima, riguardo o onore.",
                        "de": "Ein Gefühl von hoher Wertschätzung, Achtung oder Ehre."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "riguardo",
                                "target_lang_sense_clarification": "stima o considerazione"
                            },
                            {
                                "target_lang_word": "stima",
                                "target_lang_sense_clarification": "alto rispetto"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wertschätzung",
                                "target_lang_sense_clarification": "Achtung, Respekt"
                            },
                            {
                                "target_lang_word": "Hochachtung",
                                "target_lang_sense_clarification": "großer Respekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1544c3-923a-3a46-8f1b-96fa0f0cd249",
                    "sense_definition": "An affectionate term of address for a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, my little <w>dainty</w>, and tell me your story.",
                            "target_lang_translations": {
                                "it": "Vieni qui, mio piccolo <w>tesorino</w>, e raccontami la tua storia.",
                                "de": "Komm her, mein kleines <w>Schätzchen</w>, und erzähle mir deine Geschichte."
                            }
                        },
                        {
                            "text": "She whispered to her child, calling her a sweet <w>dainty</w>.",
                            "target_lang_translations": {
                                "it": "Sussurrò alla sua bambina, chiamandola dolce <w>gioia</w>.",
                                "de": "Sie flüsterte ihrem Kind zu und nannte es einen süßen <w>Sonnenschein</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in contemporary speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Appellativo affettuoso rivolto a una persona cara.",
                        "de": "Eine liebevolle Koseform oder Anrede für eine Person."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tesorino",
                                "target_lang_sense_clarification": "vezzeggiativo affettuoso"
                            },
                            {
                                "target_lang_word": "gioia",
                                "target_lang_sense_clarification": "termine affettuoso"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schätzchen",
                                "target_lang_sense_clarification": "liebevolle Koseform"
                            },
                            {
                                "target_lang_word": "Liebling",
                                "target_lang_sense_clarification": "Kosewort für eine geliebte Person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
