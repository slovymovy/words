                        "cross_references": [
                            {
                                "target_word": "bec de lièvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54bd349e-24be-30ca-9327-df4f43007ecc",
                                        "entry_id": "849f0755-6586-39f2-9703-84421619aa2c",
                                        "glosses": [
                                            "Variante orthographique de bec-de-lièvre."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ad7884-cbcf-4a2b-b594-e1a6147552c4",
                                                "sense_id": "54bd349e-24be-30ca-9327-df4f43007ecc",
                                                "text": "Il y avait là trois ou quatre négociants retirés qui tremblaient pour leurs rentes, et qui appelaient de tous leurs vœux un gouvernement sage et fort. Un ancien marchand d’amandes, membre du conseil municipal, M. Isidore Granoux, était comme le chef de ce groupe. Sa bouche en bec de lièvre, fendue à cinq ou six centimètres du nez, ses yeux ronds, son air à la fois satisfait et ahuri, le faisaient ressembler à une oie grasse qui digère dans la salutaire crainte du cuisinier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39992187-d3d8-445e-86df-e1e6689cc3fe",
                        "source_entry_id": "6b865c63-75a3-3771-83c6-e6da4eeb12fe",
                        "source_sense_id": "c301519e-7aba-398e-a29c-ef13fa95aea1",
                        "source_sense_description": "congenital malformation of the upper lip",
                        "target_lang_word": "bec-de-lièvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bec-de-lièvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                        "entry_id": "cac639c8-6f6b-3f01-bf49-eda52c69532e",
                                        "glosses": [
                                            "Difformité congénitale qui consiste à avoir la lèvre supérieure fendue, avec parfois prolongation jusqu’au palais. Fente labio-palatine."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3764d3c-3e72-487b-ad4c-eb1472248659",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Avoir un bec-de-lièvre."
                                            },
                                            {
                                                "example_id": "36e26b24-9576-48b0-9159-d78115c48c7d",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Son bec-de-lièvre salivait, sans qu’une goutte de sueur mouillât sa peau dure."
                                            },
                                            {
                                                "example_id": "f0061713-108b-4107-a8bc-07686f0935bd",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Elle fait la comparaison avec l’opération correctrice d’un bec-de-lièvre ou de doigts fusionnés, acceptée socialement."
                                            },
                                            {
                                                "example_id": "7540504a-1abd-463e-a43b-e4e096fa8275",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Naît-on pied-bot, hydrocéphale, avec un bec-de-lièvre, une arthrogrypose, des mains syndactyles, une scoliose ou des jambes arquées ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be51b76-29e6-3682-b080-621b8858a97a",
                                        "entry_id": "cac639c8-6f6b-3f01-bf49-eda52c69532e",
                                        "glosses": [
                                            "Personne affligée de cette difformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c86c457c-e8da-4f00-98e3-5c8a67f855d1",
                                                "sense_id": "8be51b76-29e6-3682-b080-621b8858a97a",
                                                "text": "Nous connaissons sur le pont de Stamboul toutes les échoppes, tous les passants, même tous les mendiants, la collection complète des estropiés, aveugles, manchots, becs-de-lièvre et culs-de-jatte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15895e35-2cc9-4a10-a6b9-4e2b65d9a3ff",
                        "source_entry_id": "6b865c63-75a3-3771-83c6-e6da4eeb12fe",
                        "source_sense_id": "c301519e-7aba-398e-a29c-ef13fa95aea1",
                        "source_sense_description": "congenital malformation of the upper lip",
                        "target_lang_word": "Hasenscharte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hasenscharte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c86af99d-e538-3ba2-ab6a-1af6798ef509",
                                        "entry_id": "20f949c6-0743-3907-b2ff-cfbc1d2e1657",
                                        "glosses": [
                                            "angeborene Fehlbildung der Oberlippe, Lippenspalte"
                                        ],
                                        "tags": [
                                            "teilweise abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862f7948-356c-4c48-b67a-05803268d3a6",
                                                "sense_id": "c86af99d-e538-3ba2-ab6a-1af6798ef509",
                                                "text": "„In der Nähe des Todesstrandes entdeckt Götz Ehmann ein zwei Jahre altes Kind, das er vor einem Jahr an einer Hasenscharte operiert hatte.“"
                                            },
                                            {
                                                "example_id": "63e1dd8b-d5a4-4b46-b11f-9bd2f48b04f2",
                                                "sense_id": "c86af99d-e538-3ba2-ab6a-1af6798ef509",
                                                "text": "„Eine Schwangere darf kein Wasser schöpfen, über kein Beet steigen, keine schadhafte Tanne ansehen, weil sonst das Kind eine Hasenscharte bekommt, keine Leiche ansehen, weil es sonst blaß bleibt; das hat die Hanne vermieden.“"
                                            },
                                            {
                                                "example_id": "db7cf046-0974-4de1-8c28-fdac0cd844a6",
                                                "sense_id": "c86af99d-e538-3ba2-ab6a-1af6798ef509",
                                                "text": "„Einer war kahlköpfig und hatte eine Hasenscharte, die er mit der Hand immer wieder verdeckte; der andere trug einen Hitlerschnurrbart und hatte ein schwammiges, bleiches Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
