                                "target_senses": [
                                    {
                                        "sense_id": "d575b0ce-3963-3f9f-a377-79b18876398e",
                                        "entry_id": "c8dcf7e4-bd84-36e4-a724-6a28e5e658bf",
                                        "glosses": [
                                            "ciascuno degli avventurieri spagnoli che diedero inizio alla conquista del continente americano, dopo la sua scoperta da parte di Cristoforo Colombo"
                                        ],
                                        "tags": [
                                            "forestierismo"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4efb170-bef5-4b57-87ea-6a08ca4b0020",
                        "source_entry_id": "bc1c0abe-22e8-3391-b641-599574703f5a",
                        "target_lang_word": "Konquistador",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konquistador",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b66550-b34d-37b3-9215-c943901b8826",
                                        "entry_id": "8010f9ea-0025-380d-a348-3d5c975f51d4",
                                        "glosses": [
                                            "(spanische) Eroberer Süd- und Mittelamerikas im 16. und 17. Jahrhundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec3a374-fd16-44d1-8bc4-9f6e32a7ccb1",
                                                "sense_id": "88b66550-b34d-37b3-9215-c943901b8826",
                                                "text": "„Die Konquistadoren trafen im ganzen Andenraum und selbst in Mittelamerika auf die Steinschleuder.“"
                                            },
                                            {
                                                "example_id": "9f2c9289-d772-42ef-9a9d-83923ac3981b",
                                                "sense_id": "88b66550-b34d-37b3-9215-c943901b8826",
                                                "text": "„Es waren diese zermürbenden Guerillaattacken, die den Elan der Konquistadoren stoppten und den geplanten Durchmarsch nach Norden verhinderten.“"
                                            },
                                            {
                                                "example_id": "e57c5d69-737d-4640-b130-98932ee0fbe5",
                                                "sense_id": "88b66550-b34d-37b3-9215-c943901b8826",
                                                "text": "„Der Konquistador war, wie viele seiner Kollegen, Spanier, gottesfürchtiger Christenmensch, Mörder, Vielfachmörder, Entdecker und hündisch gierig nach Geld.“"
                                            },
                                            {
                                                "example_id": "d7db762d-d880-4219-8b33-f10096e434ee",
                                                "sense_id": "88b66550-b34d-37b3-9215-c943901b8826",
                                                "text": "„Im Jahre 1540 führte der Konquistador Hernando de Soto eine Expedition an, die sich vom Süden aus weit in das Gebiet der heutigen USA vorwagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5d2147f-3a15-453f-bef2-e42e06114846",
