                        "glosses": [
                            "betrekking hebbend op, gesteld in versmaat"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fcf355c2-c544-3ff4-b6c3-43781d9951d8",
                        "entry_id": "1fad40df-a729-3013-8761-ec2b254faa0f",
                        "glosses": [
                            "volgens het metrieke stelsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d5b6989-7568-4e73-b181-362002ec8df4",
                                "sense_id": "fcf355c2-c544-3ff4-b6c3-43781d9951d8",
                                "text": "“M8” op een schroefbout betekent: de schroefdraad is metrisch, en de diameter is acht milimeter."
                            }
                        ]
                    },
                    {
                        "sense_id": "97962e05-3b88-3b3a-bfd2-08ab72bdebb4",
                        "entry_id": "1fad40df-a729-3013-8761-ec2b254faa0f",
                        "glosses": [
                            "volgens het systeem voor de tijdsduur van muzieknoten en rusten, waarin de verhoudingen worden bepaald door een factor twee, of een veelvoud van twee. De tijdsduur (notenwaarde) van noten en rusten volgens dit systeem, wordt in de muzieknotatie met een eigen symbool aangegeven. Niet op twee gebaseerde verdelingen noemt men “antimetrisch.”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99efe935-3981-4bf1-af57-9bb4070c3b1a",
                                "sense_id": "97962e05-3b88-3b3a-bfd2-08ab72bdebb4",
                                "text": "Een kwartnoot of een kwart is een van de noten uit de metrische reeks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c81ab23-322f-4edc-9ff4-14117be4c006",
                        "source_entry_id": "1fad40df-a729-3013-8761-ec2b254faa0f",
                        "source_sense_id": "49f7c2b1-371a-3103-a5ba-b17ea0e39c73",
