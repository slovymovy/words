                            {
                                "example_id": "f06f749d-f96d-4208-bf04-540c58473033",
                                "sense_id": "a34ac9b4-5efb-39a5-b37a-c77f6742dc06",
                                "text": "L’indemnisation du dommage corporel est au cœur de la réparation."
