                "senses": [
                    {
                        "sense_id": "e0f3fa80-108c-3d69-b398-2b6a2c988156",
                        "entry_id": "0871a8fe-b31e-3a4c-a8fa-a19192a50051",
                        "glosses": [
                            "Qui appartient à un mouvement militant dont l’objet est de défendre les animaux dans le cadre d’une idéologie faisant primer l'intérêt de l'animal, avant les considérations écologiques."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "b04030bc-1a52-4adf-af70-8f0f19ff939f",
                                "sense_id": "e0f3fa80-108c-3d69-b398-2b6a2c988156",
                                "text": "Une des propositions du parti animaliste consiste à intégrer des territoires ré-ensauvagés à la Trame verte et bleue, notamment parmi les territoires qui ne sont pas habités."
                            },
                            {
                                "example_id": "8d1555b0-c90e-452e-a4f5-cdd4ca320fbb",
                                "sense_id": "e0f3fa80-108c-3d69-b398-2b6a2c988156",
                                "text": "Il est de bon ton de caricaturer la pensée animaliste et de la réduire à un sentimentalisme incohérent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34a3cbd7-ed1f-4f0f-acfe-b6ea361fde4d",
