                "senses": [
                    {
                        "sense_id": "42a7e5f7-447d-33f5-b8ba-126f2f732251",
                        "entry_id": "d252a3e4-6d86-3c71-8bc3-a12a4bff161e",
                        "glosses": [
                            "een door mensen gemaakt voorwerp dat gemaakt is om te kunnen exploderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc785455-5bcd-436b-948a-f0b12d803648",
                                "sense_id": "42a7e5f7-447d-33f5-b8ba-126f2f732251",
                                "text": "Bij een moskee in Beringen in Belgisch Limburg is in de nacht van dinsdag op woensdag een een klein explosief tot ontploffing gebracht. Het springtuig was aangebracht bij de ingang van het gebouw aan de buitenkant. De schade is beperkt."
                            },
                            {
                                "example_id": "fc429334-0c98-412c-8c3c-39ea73e84032",
                                "sense_id": "42a7e5f7-447d-33f5-b8ba-126f2f732251",
                                "text": "Volgens bronnen dicht bij het onderzoek werd de bom aangebracht in het achterste deel van het toestel nabij de staart. Dit zou er eerder op wijzen dat een passagier het springtuig mee aan boord bracht terwijl daarvoor door de onderzoekers werd vermoed dat een luchthavenmedewerker de bom in de laadruimte had verstopt."
                            }
                        ]
                    }
