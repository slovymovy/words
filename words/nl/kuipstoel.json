            "senses": [
                {
                    "sense_id": "38657fde-efc0-37ae-af54-58f1c85a7c1f",
                    "sense_definition": "Een stoel waarvan de zitting, rugleuning en armleuningen één geheel vormen in de vorm van een kuip of kom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meubilair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De moderne <w>kuipstoel</w> heeft een bolvormige achterzijde en zit erg comfortabel.",
                            "target_lang_translations": {
                                "en": "The modern <w>bucket chair</w> has a spherical back and is very comfortable."
                            }
                        },
                        {
                            "text": "Zij kocht een nieuwe houten <w>kuipstoel</w> voor aan haar bureau.",
                            "target_lang_translations": {
                                "en": "She bought a new wooden <w>tub chair</w> for her desk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "comfortabele kuipstoel",
                        "moderne kuipstoel"
                    ],
                    "target_lang_definitions": {
                        "en": "A chair where the seat, backrest, and armrests form a single unit in the shape of a tub or bowl."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bucket chair",
                                "target_lang_sense_clarification": "furniture"
                            },
                            {
                                "target_lang_word": "tub chair",
                                "target_lang_sense_clarification": "furniture"
                            },
                            {
                                "target_lang_word": "bucket seat",
                                "target_lang_sense_clarification": "furniture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80fffe44-a172-3c1c-a586-519d39edc609",
                    "sense_definition": "Een speciaal gevormde autostoel die extra zijdelingse steun biedt aan het lichaam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voertuigonderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sportwagen is uitgerust met een lederen <w>kuipstoel</w> voor een betere grip in de bochten.",
                            "target_lang_translations": {
                                "en": "The sports car is equipped with a leather <w>bucket seat</w> for better grip in the corners."
                            }
                        },
                        {
                            "text": "Tijdens de race hield de stevige <w>kuipstoel</w> de coureur perfect op zijn plaats.",
                            "target_lang_translations": {
                                "en": "During the race, the sturdy <w>bucket seat</w> kept the driver perfectly in place."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sportieve kuipstoel"
                    ],
                    "target_lang_definitions": {
                        "en": "A specially shaped car seat that provides extra lateral support to the body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bucket seat",
                                "target_lang_sense_clarification": "in a car"
                            }
                        ]
                    }
