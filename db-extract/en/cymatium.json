                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f50246f-7547-3242-b29e-2d4ee07696ab",
                        "entry_id": "92bf1ab2-523e-3d56-9595-030ba0f05a70",
                        "glosses": [
                            "A molding on the cornice, above the corona, often having a wavelike form (cyma)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9032a6f8-5293-414c-9ba4-9b862d4f140d",
                                "sense_id": "7f50246f-7547-3242-b29e-2d4ee07696ab",
                                "text": "The cornice only is carried around the room at the ceiling, and in the staircase hall only the cymatium and corona of the cornice; but over the archway, supported by a colonnade of four fluted round columns, a complete entablature with nicely worked classic detail is employed and given added emphasis by several inches' projection into the reception hall."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9939a16-32cb-4a9b-afd5-d1a25722fd1a",
                        "source_entry_id": "92bf1ab2-523e-3d56-9595-030ba0f05a70",
                        "source_sense_id": "7f50246f-7547-3242-b29e-2d4ee07696ab",
                        "source_sense_description": "type of molding that is wavelike in form",
                        "target_lang_word": "cimaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cimaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6e79c7-c152-3a1c-aa10-5481f696187d",
                                        "entry_id": "220d24dd-4bb8-39eb-93be-5180edc6b980",
                                        "glosses": [
                                            "Moulure qui forme la partie supérieure d’une corniche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb70627-2720-42b7-974e-293b1a99daca",
                                                "sense_id": "9b6e79c7-c152-3a1c-aa10-5481f696187d",
                                                "text": "De temps à autre une main la soulevait et l'approchait du mur, illuminant de ternes gravures accrochées à la cimaise."
                                            },
                                            {
                                                "example_id": "a0ae839b-2e42-43a2-b317-020db3b16d25",
                                                "sense_id": "9b6e79c7-c152-3a1c-aa10-5481f696187d",
                                                "text": "Elle descendit avec lenteur, en se balançant ainsi, au niveau de la fenêtre du premier étage, puis elle s’efforça de gagner une mince cimaise de briques vernies qui partait de l’extrémité de la marquise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37aca6e3-aebf-3181-8a28-e879c0a5e59c",
                                        "entry_id": "220d24dd-4bb8-39eb-93be-5180edc6b980",
                                        "glosses": [
                                            "Moulure servant de couronnement à un lambris d’appui, en bois ou en pierre peinte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6dcf70f-a38d-4239-8628-e12e754a538a",
                                                "sense_id": "37aca6e3-aebf-3181-8a28-e879c0a5e59c",
                                                "text": "Il faut autant que possible, dans une exposition, poser les tableaux sur la cimaise."
                                            },
                                            {
                                                "example_id": "fa7f23cd-a849-47f1-90e5-58640fd9db55",
                                                "sense_id": "37aca6e3-aebf-3181-8a28-e879c0a5e59c",
                                                "text": "Faire à un tableau les honneurs de la cimaise. L’exposer bien en vue."
                                            },
                                            {
                                                "example_id": "0a1b1917-5e8a-4307-afae-20cf30467710",
                                                "sense_id": "37aca6e3-aebf-3181-8a28-e879c0a5e59c",
                                                "text": "Elles couvraient le hall, de la baie vitrée du plafond à la cimaise de chêne verni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccd84463-bb5f-30d3-a765-3e8dd3cf5887",
                                        "entry_id": "220d24dd-4bb8-39eb-93be-5180edc6b980",
                                        "glosses": [
                                            "Dispositif technique permettant d’accrocher des tableaux."
                                        ],
                                        "tags": [
                                            "Muséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee3b3e2-fefb-4c0e-9cf5-5211a90fb438",
                                                "sense_id": "ccd84463-bb5f-30d3-a765-3e8dd3cf5887",
                                                "text": "À la cimaise, aujourd’hui, les premiers nymphéas de Monet, de séductions singulières, paraissent bien sages auprès de l’apothéose des Tuileries."
                                            },
                                            {
                                                "example_id": "3493e8fc-e18e-4082-8efb-548c1c9dd27d",
                                                "sense_id": "ccd84463-bb5f-30d3-a765-3e8dd3cf5887",
                                                "text": "Il comptabilise à ce jour, 1 000 toiles qui ont vu le jour dans son atelier ou sur les cimaises de sa galerie landernéenne : des œuvres abstraites ou tournées vers la mer et les bateaux, essentiellement réalisées à l’acrylique, sur bois, ardoise ou pans de palettes avec des techniques diverses."
                                            },
                                            {
                                                "example_id": "2e4ed258-9974-4651-998d-f2be4f32bc67",
                                                "sense_id": "ccd84463-bb5f-30d3-a765-3e8dd3cf5887",
                                                "text": "Quand il [Léon-Paul Fargue] m’admit à la cimaise de ses « Portraits de famille », j’eus lieu de lui manifester ma joie et ma gratitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5ced1fd-0484-471e-aa58-09ab7040876c",
                        "source_entry_id": "92bf1ab2-523e-3d56-9595-030ba0f05a70",
                        "source_sense_id": "7f50246f-7547-3242-b29e-2d4ee07696ab",
                        "source_sense_description": "type of molding that is wavelike in form",
                        "target_lang_word": "Kymation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kymation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ebb99e0-8c65-3554-a4aa-ff2f0c79b9cd",
                                        "entry_id": "a7efc9b9-d128-334d-9497-16a3c2d87c5c",
                                        "glosses": [
                                            "ein antikes, friesartiges Ornament in Form einer Zier- oder Schmuckleiste, das in den drei klassischen Erscheinungsformen „dorisch“, „ionisch“ und „lesbisch“ vorkommt"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf6ad17-e6dd-4537-80b0-f74bbbcbbe31",
                                                "sense_id": "2ebb99e0-8c65-3554-a4aa-ff2f0c79b9cd",
                                                "text": "Das Kymation ist eine Schmuckleiste, die bei Architekturgliedern wie Kapitell, Fries, Architrav, dann aber auch bei Gegenständen wie Sarkophagen verwendet wurden."
                                            },
                                            {
                                                "example_id": "4d1b4091-5683-4248-bbfa-2a3459fea235",
                                                "sense_id": "2ebb99e0-8c65-3554-a4aa-ff2f0c79b9cd",
                                                "text": "Die frühchristliche Kunst hat die klassischen drei Formen des Dorischen, des Ionischen und des Lesbischen Kymations übernommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e51e3738-acfe-469a-8365-94a68428bfbb",
                        "source_entry_id": "92bf1ab2-523e-3d56-9595-030ba0f05a70",
                        "source_sense_id": "7f50246f-7547-3242-b29e-2d4ee07696ab",
                        "source_sense_description": "type of molding that is wavelike in form",
                        "target_lang_word": "Karnies",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karnies",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b305f8a-60ae-3f94-bf2e-c572ee4567a7",
                                        "entry_id": "414345fd-194c-3100-9045-f2e1aa20c01d",
                                        "glosses": [
                                            "leistenförmiges, architektonisches Schmuckelement, Kranzleiste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13920555-6197-433a-851b-1169a1c932e2",
                                                "sense_id": "1b305f8a-60ae-3f94-bf2e-c572ee4567a7",
                                                "text": "„Oder die Mauer über der Pfeilerreihe der Arkaden; sie wird, damit sie die Decke zu tragen vermag, durch eine Stahlkonstruktion gestärkt, und sie ist, wie es Schattner möchte, sichtbar. Sie bricht über dem Eingang etwa ruppig ab, um einen Erker mit seinem schönen Karnies nicht zu belästigen. Die drei alten Hoffassaden wiederum sind, zu Bildern geworden – ein Spaß, mit dem die Architekten den Auftrag der Denkmalpflege, „alle Befunde zu sichern“, auf die Schippe nahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
