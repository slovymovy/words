                "senses": [
                    {
                        "sense_id": "fd25a596-8b04-35f8-abe3-1c6cb558b95a",
                        "entry_id": "4df71a6f-7fbb-3bf9-a2b8-f34fda4be643",
                        "glosses": [
                            "Anomalie de l’hémogramme, caractérisée par un nombre trop élevé de lymphocytes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a0c715-6d6c-4641-b6c9-6a3532613ead",
                                "sense_id": "fd25a596-8b04-35f8-abe3-1c6cb558b95a",
                                "text": "Dans les stades plus avancés de la maladie, cette hausse de lymphocytes (lymphocytose) peut s’accompagner d’une augmentation du volume des ganglions, de la rate et du foie ainsi que d’une anémie, d’une baisse des plaquettes (thrombocytopénie) et d’une baisse des neutrophiles (neutropénie)."
                            },
                            {
                                "example_id": "efb1fbe8-7c01-4347-a4d1-68d9b30a32ec",
                                "sense_id": "fd25a596-8b04-35f8-abe3-1c6cb558b95a",
                                "text": "Nous avons ensuite évalué la spécificité de ces LB à partir d’observations de lymphocytoses bénignes ou malignes colligées depuis plusieurs années."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
