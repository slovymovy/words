                        "sense_id": "b0d598b2-06d1-34ea-ac49-e7163d32aeeb",
                        "entry_id": "2c136c7c-0e96-36b3-89bf-e406ab4d4d63",
                        "glosses": [
                            "Propre à la région de la Charente ou des Charentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a74ae8-7c85-44c7-8348-f3f4e5cd3c25",
                                "sense_id": "b0d598b2-06d1-34ea-ac49-e7163d32aeeb",
                                "text": "S’il est assez habituel de les rencontrer dans les pertuis charentais, il est beaucoup plus rare de les rencontrer si près des côtes."
                            },
                            {
                                "example_id": "10d8717c-8366-4ce4-8c37-1228f88ee2eb",
                                "sense_id": "b0d598b2-06d1-34ea-ac49-e7163d32aeeb",
                                "text": "Cyprienne est charentaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "31772cbe-9dfd-30a9-967b-57b3d72c9f2f",
                        "entry_id": "2c136c7c-0e96-36b3-89bf-e406ab4d4d63",
                        "glosses": [
                            "Qualifie des pantoufles charentaises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30cf599a-91b1-4e97-8fd7-9fa594c7fd52",
                                "sense_id": "31772cbe-9dfd-30a9-967b-57b3d72c9f2f",
                                "text": "Dix patères doubles où en rentrant on accrochait son pardessus ou son capuchon et sa coiffure. Au-dessous, des paires de chaussons charentais."
                            }
                        ]
                    }
