                        "target_lang_word": "décharge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décharge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a7ee4c-0a5b-3884-b1ef-156c3321a835",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Action de décharger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c362f8b-3ffc-4ed4-b6c3-99b7c2bec91c",
                                                "sense_id": "b6a7ee4c-0a5b-3884-b1ef-156c3321a835",
                                                "text": "Assister à la décharge d’un ballot."
                                            },
                                            {
                                                "example_id": "19c91f45-906d-460b-beb3-d6e12492aa6d",
                                                "sense_id": "b6a7ee4c-0a5b-3884-b1ef-156c3321a835",
                                                "text": "Les voituriers sont obligés de faire la décharge de leurs marchandises en tel endroit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a5aa59-aba3-3c7c-8d36-9490af8d23e5",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Action de décharger.",
                                            "Moment, endroit où cette action se fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0a9e40-5d41-4363-a1b8-94693bfe354c",
                                                "sense_id": "b7a5aa59-aba3-3c7c-8d36-9490af8d23e5",
                                                "text": "Se trouver à la décharge d’un wagon, d’un paquebot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb823e0-943d-35cb-b949-548005595c54",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Construction faite pour soulager quelque partie d’un édifice du poids qui est au-dessus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff7562df-c4a9-3ef5-8d76-fcf46d13da44",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "dans un mur en pans de bois : pièce oblique reliant deux pièces horizontales (les sablières. Elles servent à consolider les assemblages, à éviter leur relâchement, à maintenir d'aplomb les pièces principales en les contrebutant ; enfin, à reporter sur les poteaux d'huisserie le poids des trumeaux qui se trouvent au-dessus d'un grand vide, de manière à soulager le poitrail couronnant celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Acte par lequel on déclare une personne quitte ou libérée d’une dette, d’un dépôt, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67769c5f-d1a5-4904-88ae-e74045cb563c",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Un gardien dont le rôle était de donner aux croque-morts décharge, sur un registre, des cercueils qu’il avait comptés et vu inhumer, signa le livre et apposa son timbre en marge."
                                            },
                                            {
                                                "example_id": "c2709135-8ed9-4389-a8fa-2c47555534e2",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Il me tendit deux enveloppes cachetées. Je reconnus le timbre du Conseil de Surveillance, dont dépend à Orsenna la conduite des affaires de haute police – il faisait pressentir quelque grave affaire ; j’en donnai décharge à Marino sans mot dire, et j’attendis pour les ouvrir un moment où je serais seul."
                                            },
                                            {
                                                "example_id": "631f9ab7-ac67-4825-8087-704ae7789753",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Décharge bonne et valable."
                                            },
                                            {
                                                "example_id": "8459f001-8c2e-4cde-a916-b76dfdd9a95c",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "On ne saurait lui rien demander, il a sa décharge."
                                            },
                                            {
                                                "example_id": "c4bdaae7-f9d9-48d0-91d4-deae8c48b801",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "On lui a donné une décharge de tout."
                                            },
                                            {
                                                "example_id": "244fce4a-3d0d-4349-b897-7a525bcc4979",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Demander, obtenir décharge."
                                            },
                                            {
                                                "example_id": "787798b2-2335-4932-b995-1dd77bd7dc50",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Donner quittance et décharge."
                                            },
                                            {
                                                "example_id": "6da4069a-2884-4ad2-9451-4b16069be72b",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "Payer tant à la décharge de quelqu’un, à la décharge d’un compte, Payer tant en déduction de ce que doit quelqu’un, de ce qui est porté sur un compte."
                                            },
                                            {
                                                "example_id": "b338eccb-869b-4ab6-97ef-6a14ad237982",
                                                "sense_id": "ca210d5f-c017-35e6-9f08-ad179ad7c006",
                                                "text": "On dit aussi Porter une somme en décharge, Indiquer sur le registre, sur le compte, qu’elle a été acquittée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14216295-1250-334d-a4e4-d63baca090e0",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Justification, avantage qui résulte pour l’accusé des circonstances ou des dépositions favorables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2773870-75b0-4ce4-be87-13a58ec0dc2a",
                                                "sense_id": "14216295-1250-334d-a4e4-d63baca090e0",
                                                "text": "Ils ont tous parlé à votre décharge."
                                            },
                                            {
                                                "example_id": "64b2e986-5bfc-4c5e-9c85-d3b192e67a5d",
                                                "sense_id": "14216295-1250-334d-a4e4-d63baca090e0",
                                                "text": "La déposition des témoins est à la décharge de l’accusé."
                                            },
                                            {
                                                "example_id": "ea0adf37-efd7-4340-901d-9fba9ce966b4",
                                                "sense_id": "14216295-1250-334d-a4e4-d63baca090e0",
                                                "text": "Il n'y a pas d'arrangement possible avec la réalité, avec le ça a eu lieu, consigné dans les archives d'un tribunal de Londres, avec nos noms, elle d'accusée, et moi de témoin à décharge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "704d575c-a6c8-37cc-8b9d-6b68b3582391",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Soulagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3467d32-8a83-4ab1-93f1-f3d4b8b38748",
                                                "sense_id": "704d575c-a6c8-37cc-8b9d-6b68b3582391",
                                                "text": "C’est une décharge considérable pour l’état."
                                            },
                                            {
                                                "example_id": "68297bcf-0ea7-47f2-9138-046fe2a56016",
                                                "sense_id": "704d575c-a6c8-37cc-8b9d-6b68b3582391",
                                                "text": "Je vous en avertis pour la décharge de ma conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36361099-b7fd-3192-926f-7716a03393a8",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Éjaculation."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811b9cfb-32d1-4b34-b01f-89c7f0483409",
                                                "sense_id": "36361099-b7fd-3192-926f-7716a03393a8",
                                                "text": "Alexine tomba sur eux épuisée râlante et grinçant des dents et Mony qui mit sa bouche dans son con n’eut qu’à donner deux ou trois coups de langue pour obtenir une décharge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Fait de plusieurs armes à feu qui tirent à la fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb5f4cee-7971-4a89-a52a-6c0551a2c9bb",
                                                "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                                "text": "La fête se termina par des réjouissances bruyantes : musique, sonneries de clairons, roulements de tambours, fantasias échevelées, décharges retentissantes d’artillerie et de mousqueterie, — une orgie de couleurs, de mouvement et de bruit."
                                            },
                                            {
                                                "example_id": "d9e9e226-cd8f-4d69-aa77-e28c270f9954",
                                                "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                                "text": "Des détonations retentissaient incessamment, comparables aux décharges continues d’une formidable artillerie."
                                            },
                                            {
                                                "example_id": "fa66b39e-3ce3-4db7-93cd-ccacd752e86e",
                                                "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                                "text": "…en vain les courtisans joyeux espéraient qu’avec quelques décharges on pourrait réduire au silence, ces braillards, ces bourgeois et ces ouvriers qui voulaient des réformes."
                                            },
                                            {
                                                "example_id": "ffdc2164-5b9c-4a41-b680-91d197756fd9",
                                                "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                                "text": "— Ils répondirent donc par une décharge de leurs grandes arbalètes, de leurs arcs, de leurs frondes et autres armes."
                                            },
                                            {
                                                "example_id": "985fc90b-531d-4518-841b-d3a637f21ad3",
                                                "sense_id": "303a624a-d3da-32aa-8bb9-c8e12d38ede7",
                                                "text": "Une décharge de coups de bâton, Une bastonnade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59da1524-12e2-3157-809e-13f5f8dcddec",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Décharge électrique : Évacuation de charges électriques, sous différentes formes → voir décharge électrique : court-circuit, arc électrique, électrocution, décharge luminescente, etc. ; action de décharger un condensateur, une pile électrique ou une batterie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71d33b76-b1d3-3a7d-af74-71c5eb33560c",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Écoulement des eaux d’un bassin, d’un canal, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd2f8e4-59f4-41e0-aba2-da3c27a7e140",
                                                "sense_id": "71d33b76-b1d3-3a7d-af74-71c5eb33560c",
                                                "text": "Tuyau de décharge."
                                            },
                                            {
                                                "example_id": "576c1adc-0814-4e19-9ee4-1f71d4605238",
                                                "sense_id": "71d33b76-b1d3-3a7d-af74-71c5eb33560c",
                                                "text": "La décharge des eaux surabondantes."
                                            },
                                            {
                                                "example_id": "f3351133-7245-41dc-9f47-2cef4e038844",
                                                "sense_id": "71d33b76-b1d3-3a7d-af74-71c5eb33560c",
                                                "text": "— Décharge de ventre, évacuation abondante qui débarrasse l’intestin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08f2b7e5-ddef-3c4b-90cf-90bb42f6af79",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Ouverture qui donne issue aux eaux d’un étang, d’une fontaine, etc., soit pour les empêcher de déborder, soit pour qu’elles s’écoulent entièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9104a82-9124-4317-b16f-63a5a0b8a15e",
                                                "sense_id": "08f2b7e5-ddef-3c4b-90cf-90bb42f6af79",
                                                "text": "Décharge de fond."
                                            },
                                            {
                                                "example_id": "6eedd9fe-b76c-4cdc-b60d-ff17e19e80c9",
                                                "sense_id": "08f2b7e5-ddef-3c4b-90cf-90bb42f6af79",
                                                "text": "Décharge de superficie."
                                            },
                                            {
                                                "example_id": "7c6f9a59-5386-48b7-beee-2b9ea09c1801",
                                                "sense_id": "08f2b7e5-ddef-3c4b-90cf-90bb42f6af79",
                                                "text": "Pratiquer une décharge."
                                            },
                                            {
                                                "example_id": "80d0286f-1e67-4258-8b64-a48e23487fed",
                                                "sense_id": "08f2b7e5-ddef-3c4b-90cf-90bb42f6af79",
                                                "text": "La fontaine a sa décharge à deux pas de là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c12a624d-86bb-3960-9f5f-8c1c8c33d52c",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Réservoir ou bassin qui reçoit le trop-plein d’une rivière, d’un lac, d’une fontaine, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf05935-1c63-4a70-b170-d8245079220c",
                                                "sense_id": "c12a624d-86bb-3960-9f5f-8c1c8c33d52c",
                                                "text": "Établir une décharge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a018e089-2431-3bcb-8f45-6eb3385cb3bd",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Lieu où, dans une maison, on rangeait ce qui n’était pas d’un usage ordinaire, ou ce qui aurait causé de l’embarras. On dit aujourd’hui débarras."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b0d8ec2-5003-3630-b112-a4700ee663bc",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Lieu où l’on entrepose les déchets, les débris."
                                        ],
                                        "tags": [
                                            "Déchets",
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0196e0ae-0da1-4520-891e-fdc12e368117",
                                                "sense_id": "6b0d8ec2-5003-3630-b112-a4700ee663bc",
                                                "text": "Si l’on ne faisait que passer, si l’on ne regardait pas, loin derrière les vitres, on croirait à une décharge, à un brocante de gitans."
                                            },
                                            {
                                                "example_id": "1acc00f4-6b2d-44d9-b356-6f2e548a16c6",
                                                "sense_id": "6b0d8ec2-5003-3630-b112-a4700ee663bc",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                                            },
                                            {
                                                "example_id": "3263bc45-f0bd-4ac9-a275-8da418867f2a",
                                                "sense_id": "6b0d8ec2-5003-3630-b112-a4700ee663bc",
                                                "text": "254 kilos. C’est la quantité d’ordures ménagères produite chaque année par un Français. Soit le poids de deux réfrigérateurs américains. Une fois collectées, les poubelles grises sont envoyées en décharge ou brûlées dans des incinérateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0b9e81-e136-3ea4-88d7-aeff0dd58097",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Feuille de papier qu’on presse sur une forme pour en sécher les caractères."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99bbe1e0-5a9e-3428-8269-4392a47e4a6c",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Marque d’encre sur les feuillets précédant la page dont l’encre est en excès."
                                        ],
                                        "tags": [
                                            "Livre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86953440-1b60-4f13-9a62-85c46a9a194b",
                                                "sense_id": "99bbe1e0-5a9e-3428-8269-4392a47e4a6c",
                                                "text": "Les Idylles de Bion et de Moschus, traduites de Grec en Vers François, avec des Remarques, A Lyon, Chez Horace Molin, 1697 Deux parties en un volume in-12 […]. Titre et faux-titre en rouge et noir. (Quelques rousseurs, décharges des titres rouges, petit grattage sans conséquence au premier faux-titre.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0122c0a2-7784-305c-a313-0963e2b3778f",
                                        "entry_id": "0b470572-ca1c-3f9a-a593-f05893ecc876",
                                        "glosses": [
                                            "Avantage de poids pouvant être concédé à un cheval de course dans certains cas, par exemple lorsque son jockey est un apprenti ou un amateur."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
