                "senses": [
                    {
                        "sense_id": "16c85156-be62-304b-8bfb-81586daafc1e",
                        "entry_id": "3fc04ea0-7499-3854-a13b-4005793e1aa6",
                        "glosses": [
                            "Having covers made of paper or thin cardboard; paperback."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a534f0bb-f7da-4200-b0d7-590bb9ea67e0",
                                "sense_id": "16c85156-be62-304b-8bfb-81586daafc1e",
                                "text": "It gives more emphasis to the literary novels and short-story collections reviewed so often in our pages (and sometimes published only in softcover)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9955a535-b6f7-4bd5-a342-9c95de1e5be9",
                        "source_entry_id": "3fc04ea0-7499-3854-a13b-4005793e1aa6",
                        "source_sense_id": "16c85156-be62-304b-8bfb-81586daafc1e",
                        "source_sense_description": "of a book: having a cover made of paper",
                        "target_lang_word": "broché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e89b98-aa7d-356e-b03b-cfbcc9aea27d",
                                        "entry_id": "f1d8fb6d-9f51-3e0b-9047-4492000e991b",
                                        "glosses": [
                                            "Qui est broché, qui a une broche, qui est travaillé au brochoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7a6c27-f485-4091-9f84-6553a8f78805",
                                                "sense_id": "e0e89b98-aa7d-356e-b03b-cfbcc9aea27d",
                                                "text": "Il y eut des articles sur le Complexe Webuy dans la plupart des publications spécialisées à travers le monde, il serait étonnant que le plus petit paquet de feuilles brochées par quelque association étudiante de Nouvelle-Zélande n’ait pas fait paraître son propre compte rendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6c85af-9f32-3b79-823e-011a48ae5f70",
                                        "entry_id": "f1d8fb6d-9f51-3e0b-9047-4492000e991b",
                                        "glosses": [
                                            "Se dit d’un livre assemblé par collage de la tranche des feuillets au dos de sa couverture, qui est souple."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "note": "Initialement, le « brochage » désignait le fait de coudre les cahiers à la main ; c’est avec l’automatisation au début du xxᵉ siècle que la « brocheuse » a désigné la machine à coller les pages",
                                        "examples": [
                                            {
                                                "example_id": "d7acabb3-08d0-4ac9-931a-8275d683bc84",
                                                "sense_id": "ac6c85af-9f32-3b79-823e-011a48ae5f70",
                                                "text": "Les livres brochés coûtent souvent moins que les reliés."
                                            },
                                            {
                                                "example_id": "96b1f85b-cfd7-43c4-bfd2-8721d2bdc893",
                                                "sense_id": "ac6c85af-9f32-3b79-823e-011a48ae5f70",
                                                "text": "Le relieur reçoit l’ouvrage broché ; son premier travail consiste à en décoller la couverture, et à débrocher les cahiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "broché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9e72ce-f1b6-3d7d-aea2-6ae871f64eca",
                                        "entry_id": "21738438-fe58-3af4-8c97-63b4665dcb21",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe brocher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b25abee1-fabc-46c2-9b19-032074bfb2ab",
                                                "sense_id": "7e9e72ce-f1b6-3d7d-aea2-6ae871f64eca",
                                                "text": "Foi de journaliste, j’ai broché plus de cent articles contre les auteurs de qui vous parlez ; mais j’avoue que, si je les ai attaqués, c’était pour dire quelque chose qui ressemblât à de la critique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
