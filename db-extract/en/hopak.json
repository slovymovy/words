                                        "glosses": [
                                            "Hopak, danse populaire ukrainienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2391b315-0cb7-4345-bde8-4316536a8ade",
                                                "sense_id": "03d20566-59f3-355c-a448-4b2de65e22c4",
                                                "text": "Il y avait pas mal de monde, et toute cette foule buvait, chantait Le Fier Cosaque sur son cheval (la chanson préférée de Khoudobtchenko) , et dansait le gopak."
                                            }
                                        ]
                                    }
                                ]
