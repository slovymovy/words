                    {
                        "translation_id": "b43b017e-31ab-4bf4-8461-54519e01285b",
                        "source_entry_id": "de9cab58-d816-3d3e-8ab5-98359b321b13",
                        "source_sense_id": "f99bcc3e-f04f-319c-88c6-89dbfb549958",
