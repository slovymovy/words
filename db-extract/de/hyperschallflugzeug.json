                ],
                "senses": [
                    {
                        "sense_id": "3ae9731a-d1c6-3122-97ce-b266405f0231",
                        "entry_id": "fa314e9e-987c-398a-af45-ec83d3fca71d",
                        "glosses": [
                            "Flugzeug, das mit einer Geschwindigkeit von über Mach 5 fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8847fe-1f3e-4275-9ce6-cad9194a15fe",
                                "sense_id": "3ae9731a-d1c6-3122-97ce-b266405f0231",
                                "text": "„Es handelt sich um eine Art Hyperschallflugzeug, das bis zu zehntausend Kilometer pro Stunde schnell ist.“"
                            },
                            {
                                "example_id": "22995ba1-1b29-46fe-b771-330abf49bd89",
                                "sense_id": "3ae9731a-d1c6-3122-97ce-b266405f0231",
                                "text": "„Das geplante Hyperschallflugzeug »Sänger«, so Riesenhuber, werde nicht nur den »Zugang zum Weltraum« eröffnen, sondern auch der Wirtschaft »weittragende technologische Schübe« bescheren.“"
                            },
                            {
                                "example_id": "f932d981-9897-4a25-806d-fda83ed87687",
                                "sense_id": "3ae9731a-d1c6-3122-97ce-b266405f0231",
                                "text": "„Bevor das Hyperschallflugzeug kontrolliert in den Pazifik stürzte, führte es noch einige programmierte Flugmanöver aus.“"
                            },
                            {
                                "example_id": "f4cb1924-6876-48f4-ae07-03494df60679",
                                "sense_id": "3ae9731a-d1c6-3122-97ce-b266405f0231",
                                "text": "„Mica Endsley, Chef-Forscherin der Air Force sagte laut ‚Daily Mail‘, Air Force und Darpa, die Forschungsorganisation des Pentagons, planten, bis 2023 ein neues Hyperschallflugzeug herstellen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
