                    {
                        "sense_id": "5ace5f83-a406-3341-9eec-268bbdc270b7",
                        "entry_id": "c90bacfb-2871-3661-94ff-16e4792ed256",
                        "glosses": [
                            "A bright green mineral, a basic copper carbonate, Cu₂CO₃(OH)₂; one of the principal ores of copper."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e059e149-5c9b-45d5-8c33-ac871b146ceb",
                                "sense_id": "5ace5f83-a406-3341-9eec-268bbdc270b7",
                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "898e42a3-9f40-3dea-9978-65f01adc71da",
                        "entry_id": "c90bacfb-2871-3661-94ff-16e4792ed256",
                        "glosses": [
                            "A mild green color, like that of the mineral."
                        ],
