                ],
                "senses": [
                    {
                        "sense_id": "5f9c75a3-a289-3a71-8c95-584455287daf",
                        "entry_id": "ea25e6af-588d-339b-867f-4aa84d92d876",
                        "glosses": [
                            "рег. глиняный горшок; кринка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323307a1-f058-43e9-a3d3-2e27056a32be",
                                "sense_id": "5f9c75a3-a289-3a71-8c95-584455287daf",
                                "text": "На пол капал огуречный сок и сливался с жилкой пролитого из махотки молока."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c4dc28-2f99-3b62-be6f-6f7ac136da14",
                        "entry_id": "ea25e6af-588d-339b-867f-4aa84d92d876",
                        "glosses": [
                            "рег. количество чего-либо, вмещающееся в такой сосуд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed504fe-f1f3-4a87-a1e2-19b0af84b84f",
                                "sense_id": "22c4dc28-2f99-3b62-be6f-6f7ac136da14",
                                "text": "Выпьют махотку с молоком, а горшок ― обземь, озлясь."
                            }
                        ]
                    }
                ],
