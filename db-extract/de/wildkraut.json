                ],
                "senses": [
                    {
                        "sense_id": "49343f86-89a1-3d09-8e01-57d588031e29",
                        "entry_id": "9ad0c32d-24e4-3cfe-b319-17ce7b4ce418",
                        "glosses": [
                            "Pflanze, die typischerweise in der Wildnis wächst und die als Gewürz oder Heilmittel verwendet wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "bb99ad9c-cc05-4e02-befa-2fc7b08ca35d",
                                "sense_id": "49343f86-89a1-3d09-8e01-57d588031e29",
                                "text": "Meine Frau steht auf Frischkäse mit Wildkräutern."
                            },
                            {
                                "example_id": "e9692b44-e83a-426c-a3ff-993aff4ba105",
                                "sense_id": "49343f86-89a1-3d09-8e01-57d588031e29",
                                "text": "„Man kann natürlich das Aufkommen von Wildkräutern auch unterdrücken, indem man das Beet mulcht.“"
                            },
                            {
                                "example_id": "e5fd601d-b47e-4f7b-9aa5-6c638f6313aa",
                                "sense_id": "49343f86-89a1-3d09-8e01-57d588031e29",
                                "text": "„Das Gras und die Wildkräuter, die wegen des rauen Klimas nur langsam wachsen, speichern besonders viele Nährstoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
