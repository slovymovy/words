                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval astronomers used the concept of <w>trepidation</w> to explain irregularities in star positions."
                        },
                        {
                            "text": "The theory of <w>trepidation</w> was eventually replaced by more accurate models of planetary motion."
                        }
                    ]
                }
