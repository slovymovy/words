                ],
                "senses": [
                    {
                        "sense_id": "698d552e-e490-303e-a17a-2c83c04fe28d",
                        "entry_id": "d3d36f72-5eef-3275-8ad5-e0e8438003ab",
                        "glosses": [
                            "Rute, mit deren Hilfe jemand nach unsichtbaren Wasser- oder Erzadern im Untergrund sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167d4e6e-93db-429e-aff8-0522f197f471",
                                "sense_id": "698d552e-e490-303e-a17a-2c83c04fe28d",
                                "text": "„Auf dem Hohleberg hatte er mit seiner Wünschelrute aus Weidenholz mehrere Kraftlinien lokalisiert, die sich in der Mitte der Grotte kreuzten.“"
                            },
                            {
                                "example_id": "b30cf971-685e-457a-8db0-4af12a85acfc",
                                "sense_id": "698d552e-e490-303e-a17a-2c83c04fe28d",
                                "text": "„Für die Romantiker war es gar nicht so schwer, die Welt zum Klingen zu bringen, wenn man über die Wünschelrute dazu verfügt.“"
                            },
                            {
                                "example_id": "1cd8d98c-99b8-4f11-a418-a6b55c3e7fef",
                                "sense_id": "698d552e-e490-303e-a17a-2c83c04fe28d",
                                "text": "„Ich legte die Hand auf ihren Arm, so leicht, als legte ich eine Wünschelrute auf ihn.“"
                            },
                            {
                                "example_id": "6f3cd62b-9e49-4e21-8c68-fbf38c486578",
                                "sense_id": "698d552e-e490-303e-a17a-2c83c04fe28d",
                                "text": "„Dieses Deutsch war mir eine Wünschelrute auf der Suche nach den Meinigen, die jahrhundertelang taubstummen Kindern das Sprechen beigebracht hatten, als müsste ich das stumme Deutsch lernen, um sprechen zu können, und dieser Wunsch war mir unerklärlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
