                ],
                "senses": [
                    {
                        "sense_id": "7fe9cffd-cd38-3e70-bcd6-de8dfac4d225",
                        "entry_id": "7b4c9c86-0f77-3b6a-9a90-607613925782",
                        "glosses": [
                            "einzelnes weibliches Mitglied eines Landfrauenverbandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3e7873-bd32-4472-822e-c636185fcd25",
                                "sense_id": "7fe9cffd-cd38-3e70-bcd6-de8dfac4d225",
                                "text": "„Die Landfrauen fordern unter anderem von den Politikern in Brüssel: - die Gestaltung zeitgemäßer, praxisbezogener Rahmenbedingungen für die Agrarpolitik, die besonders den jungen Hofnachfolgern wieder Mut geben kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed752b8c-192f-3cb5-8391-c6bc270c62a7",
                        "entry_id": "7b4c9c86-0f77-3b6a-9a90-607613925782",
                        "glosses": [
                            "Frau, die im ländlichen Raum arbeitet, eine Frau, die in einem landwirtschaftlichen Betrieb tätig ist"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5fc5a931-32f5-4ae6-9dc4-7e302631d2de",
                                "sense_id": "ed752b8c-192f-3cb5-8391-c6bc270c62a7",
                                "text": "„Sie verstehen sich nicht als Landfrauen, sondern orientieren sich in ihren sozialen und kulturellen Interessen an der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3132968-e6e2-44e7-b460-e437690f93da",
                        "source_entry_id": "7b4c9c86-0f77-3b6a-9a90-607613925782",
                        "source_sense_id": "ed752b8c-192f-3cb5-8391-c6bc270c62a7",
                        "target_lang_word": "paysanne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paysanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee18d0e-5547-3c73-99d8-c0385d693c65",
                                        "entry_id": "cece73a1-a098-3b1b-b8dd-33c71a339dba",
                                        "glosses": [
                                            "Femme qui s’occupe des travaux de la terre et vit à la campagne"
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f1a5fc3-a766-43fd-a133-3213d89a2e4d",
                                                "sense_id": "8ee18d0e-5547-3c73-99d8-c0385d693c65",
                                                "text": "Rabalan rencontra une paysanne, les manches retroussées jusqu’au coude, qui portait un seau plein de lait…"
                                            },
                                            {
                                                "example_id": "61e27630-0685-4852-8c91-fb787208470b",
                                                "sense_id": "8ee18d0e-5547-3c73-99d8-c0385d693c65",
                                                "text": "La petite paysanne et la bête suivaient le sentier qui longeait le vallon, au bord du plateau ; et, le dos tourné, il avait achevé l’emblave en remontant, lorsqu’un bruit de course, au milieu de cris étranglés, lui fit de nouveau lever la tête, comme il dénouait son semoir pour partir."
                                            },
                                            {
                                                "example_id": "e5b6a244-2e92-4eb6-88c8-bd26d822ea02",
                                                "sense_id": "8ee18d0e-5547-3c73-99d8-c0385d693c65",
                                                "text": "Il m’a radicalement guérie de ces odieuses rougeurs qui me couperosaient le teint et me faisaient ressembler à une paysanne."
                                            },
                                            {
                                                "example_id": "98c23e25-fcd3-48c1-810f-ddb90998a5bb",
                                                "sense_id": "8ee18d0e-5547-3c73-99d8-c0385d693c65",
                                                "text": "Son allure et ses manières n’étaient pourtant pas celles d’une paysanne et encore moins d’une ancienne vannière du village ; pour qui ne la connaissait pas, elle avait tout d'une soixante-huitarde ayant opéré un retour à la campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da35367-8b2b-30fa-8362-bc33b6771c39",
                                        "entry_id": "cece73a1-a098-3b1b-b8dd-33c71a339dba",
                                        "glosses": [
                                            "Femme fruste ou ayant des manières frustes."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b0f18f-753a-4e76-a3e2-34f3404d4d32",
                                                "sense_id": "7da35367-8b2b-30fa-8362-bc33b6771c39",
                                                "text": "Sa fiancée est sympa, mais elle s’habille comme une paysanne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe2734f-083c-361f-b14a-40ccf6d141d5",
                                        "entry_id": "cece73a1-a098-3b1b-b8dd-33c71a339dba",
                                        "glosses": [
                                            "Pizza garnie de gruyère, lardons, mozzarella, oignon, crème fraîche, sauce tomate et œuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10449525-66a8-41cc-9957-88dba14c9c7d",
                                                "sense_id": "6fe2734f-083c-361f-b14a-40ccf6d141d5",
                                                "text": "Je sors de la pizzeria, j'ai pris une quatre fromages et une paysanne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paysanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7010452f-e7b6-36ff-873d-44dc683957e6",
                                        "entry_id": "512d3546-b647-31dc-87d0-8222913a57b2",
                                        "glosses": [
                                            "Féminin singulier de paysan."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1feaad7b-36bf-4260-8f44-823322359c98",
                                                "sense_id": "7010452f-e7b6-36ff-873d-44dc683957e6",
                                                "text": "Hier, les trois organisateurs — le collectif Bassines non merci, le syndicat agricole la Confédération paysanne et le collectif les Soulèvements de la terre — ont été reçus comme ils l’espéraient par le président du Comité de bassin, Thierry Burlot, puis dans l’après-midi par la nouvelle préfète du Loiret, Sophie Broucas."
                                            }
                                        ]
                                    }
                                ]
                            },
