                        "examples": [
                            {
                                "example_id": "e840edf2-55c3-4160-b2ec-afee4c5b7911",
                                "sense_id": "2c95e30a-2470-3d1d-9e8b-d3781f8ac294",
                                "text": "Но всё-таки не будем забывать, что Александр Мясников — действующий главный врач крупной городской больницы, а не Ларри Кинг. Допускать в России возможность убийства реанимационного пациента врачами по указанию сверху (а именно это доктор Мясников и сказал) — сильное заявление для главного врача."
                            }
                        ]
                    }
