                            {
                                "example_id": "8688ce3d-5235-4e26-9a05-ab930a0f37c0",
                                "sense_id": "f5999083-80f4-3f06-8a55-866b17610625",
                                "text": "руби́новое стекло́",
                                "translation": "ruby glass",
                                "english": "ruby glass"
                            },
                            {
                                "example_id": "49c15336-70f9-40d8-97ba-e297cf064ed2",
                                "sense_id": "f5999083-80f4-3f06-8a55-866b17610625",
                                "text": "Скользя́ по неви́димой про́волоке, Купидо́н полете́л от галере́и к паро́му на Неве́, где стоя́ли щиты́ «для о́гненной поте́хи по пла́ну фити́льному», и фа́келом свои́м зажё́г пе́рвую аллего́рию — же́ртвенник из бриллиа́нтовых огне́й с двумя́ пыла́ющими руби́новыми сердца́ми.",
                                "translation": "Dmitry Merezhkovsky",
                                "english": "Dmitry Merezhkovsky"
                            }
                        ]
                    }
