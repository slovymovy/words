                        "examples": [
                            {
                                "example_id": "3b4333c6-f777-437d-beeb-114f1683c660",
                                "sense_id": "544401bb-79e2-302f-864d-8a7b746dee66",
                                "text": "„In der letzten Aprilwoche ist also nicht eindeutig zu bestimmen, wo sich Luther aufgehalten hat.“"
                            },
                            {
                                "example_id": "df293bc8-d3ee-4322-84c1-712565583bf7",
                                "sense_id": "544401bb-79e2-302f-864d-8a7b746dee66",
                                "text": "„In der ersten Aprilwoche stieg der Luftdruck im Zuge eines kräftigen Westwindes an, am 16. April schifften sich die Siedler mit einigen Vorräten für eine längere Seefahrt ein.“"
                            }
                        ],
