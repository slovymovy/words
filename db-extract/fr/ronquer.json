                        "examples": [
                            {
                                "example_id": "7aeae7a5-0f7a-4b89-a76b-dbab996d33c2",
                                "sense_id": "244800cf-3539-34dd-a18f-74324e0dfd84",
                                "text": "Non mais quand même, le pauv’gars en train de ronquer… et puis dites-donc, excusez-moi mais vous y allez pas de main morte !"
                            },
                            {
                                "example_id": "dd7bab4d-577c-45ee-b6f2-464f60dda559",
                                "sense_id": "244800cf-3539-34dd-a18f-74324e0dfd84",
                                "text": "– Qu’est-ce que tu fous à ronquer ? Pourquoi je te paie ? Dépêche-toi, on a du boulot."
                            },
                            {
                                "example_id": "77a533bc-4d44-45a6-b07f-9b377e8ee94c",
                                "sense_id": "244800cf-3539-34dd-a18f-74324e0dfd84",
                                "text": "J'ai envie de ronquer, il me faut du café"
                            }
                        ]
