                    ],
                    "common_phrases": [
                        "body is a temple",
                        "temple of knowledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'body is a temple'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что считается священным, важным или достойным большой заботы."
