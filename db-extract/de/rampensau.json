                    {
                        "sense_id": "5fbc1c69-f185-31ca-a9bf-b90a33900551",
                        "entry_id": "7d95b3f1-c481-3cd2-ba10-9c8837957fa8",
                        "glosses": [
                            "bête de scène, born showman/showwoman"
                        ],
