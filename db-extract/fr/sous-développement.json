                        "entry_id": "99534e4c-71cc-35fe-bf79-0d2404ae9bd1",
                        "tags": [
                            "plural"
                        ],
                        "form": "sous-développements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc055aec-15a6-3af1-8a52-bfcdc46c1eec",
                        "entry_id": "99534e4c-71cc-35fe-bf79-0d2404ae9bd1",
                        "glosses": [
                            "Développement insuffisant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d989c7b1-9c16-3fb8-8f8c-082bab134e37",
                        "entry_id": "99534e4c-71cc-35fe-bf79-0d2404ae9bd1",
                        "glosses": [
                            "Développement économique en dessous du potentiel d’un pays, retard dans le développement industriel."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "7e54add1-44b5-4f9b-ab04-48bfe4a46e65",
                                "sense_id": "d989c7b1-9c16-3fb8-8f8c-082bab134e37",
                                "text": "Le tiers-mondisme est une doctrine selon laquelle le sous-développement des pays du tiers-monde est causé par le colonialisme occidental."
                            },
                            {
                                "example_id": "3245ed7f-fd32-4ec3-ae9b-533c982ce355",
                                "sense_id": "d989c7b1-9c16-3fb8-8f8c-082bab134e37",
                                "text": "[…] ils ne supportent pas le sous-développement du pays lors de leur séjour estival, mais de l’autre côté ils contribuent matériellement à l’essor du trabendo qui affaiblit toutes les initiatives d’émancipation nationale."
                            },
                            {
                                "example_id": "a14b5ae6-5f13-418b-b4c4-ae396e20b1ef",
                                "sense_id": "d989c7b1-9c16-3fb8-8f8c-082bab134e37",
                                "text": "La problématique de l’intégrité des dirigeants renvoie à la question centrale du développement et du sous développement car elle soulève des préoccupations liées à la bonne ou mauvaise gestion, en un mot à la corruption […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a54245fe-8e95-36d9-b94e-1b2f21562860",
                        "entry_id": "99534e4c-71cc-35fe-bf79-0d2404ae9bd1",
                        "glosses": [
                            "Transformation en pays sous-développé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "afea4fe5-ef93-46e5-b20a-f0e39cbaceee",
                                "sense_id": "a54245fe-8e95-36d9-b94e-1b2f21562860",
                                "text": "La France est-elle en voie de sous-développement ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcd64f27-3577-4bdc-803e-8dee2546fd52",
                        "source_entry_id": "99534e4c-71cc-35fe-bf79-0d2404ae9bd1",
