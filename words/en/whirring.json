{
    "word_family": [
        "whirr"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9b47b0e5-96a2-35d4-a845-cd21cd63d75b",
                    "sense_definition": "Producing a continuous low, rapid, buzzing or humming sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whirring</w> blades of the helicopter made it difficult to hear anything else.",
                            "target_lang_translations": {
                                "cs": "<w>Bzučící</w> listy vrtulníku způsobily, že bylo těžké slyšet cokoli jiného."
                            }
                        },
                        {
                            "text": "She woke up to the <w>whirring</w> sound of the old fan in the corner.",
                            "target_lang_translations": {
                                "cs": "Probudila se do <w>bzučivého</w> zvuku starého větráku v rohu."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzzing",
                        "humming"
                    ],
                    "common_phrases": [
                        "whirring sound",
                        "whirring noise"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávající nepřetržitý nízký, rychlý, bzučivý nebo hučivý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bzučivý",
                                "target_lang_sense_clarification": "označující zvuk připomínající bzučení hmyzu nebo strojů"
                            },
                            {
                                "target_lang_word": "hučivý",
                                "target_lang_sense_clarification": "označující hlubší, nepřetržitý zvuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04efb549-7914-364a-b228-3e8baefd623f",
                    "sense_definition": "Moving or spinning very quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>whirring</w> gears of the machine moved with incredible speed and precision.",
                            "target_lang_translations": {
                                "cs": "<w>Rotující</w> ozubená kola stroje se pohybovala s neuvěřitelnou rychlostí a přesností."
                            }
                        },
                        {
                            "text": "He watched the <w>whirring</w> wheels of the bicycle as they blurred in the sunlight.",
                            "target_lang_translations": {
                                "cs": "Sledoval <w>rotující</w> kola jízdního kola, jak se na slunci rozmazávala."
                            }
                        }
                    ],
                    "synonyms": [
                        "spinning",
                        "rotating"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybující se nebo rotující velmi rychle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rotující",
                                "target_lang_sense_clarification": "točící se kolem své osy"
                            },
                            {
                                "target_lang_word": "svištící",
                                "target_lang_sense_clarification": "rychle se pohybující za doprovodu zvuku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19c617a0-0582-335c-a812-ec44850f6810",
                    "sense_definition": "A continuous low, rapid, buzzing or humming sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>whirring</w> from the computer server room was quite distracting.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>hučení</w> ze serverovny bylo docela rušivé."
                            }
                        },
                        {
                            "text": "I could hear the soft <w>whirring</w> of the clockwork mechanism inside the toy.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem tiché <w>bzučení</w> hodinového mechanismu uvnitř hračky."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzz",
                        "hum"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nepřetržitý nízký, rychlý, bzučivý nebo hučivý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bzučení",
                                "target_lang_sense_clarification": "zvuk vydávaný stroji nebo hmyzem"
                            },
                            {
                                "target_lang_word": "hučení",
                                "target_lang_sense_clarification": "hlubší, monotónní zvuk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ebd9827-cdef-374e-9424-317ea9e60ded",
                    "sense_definition": "Present participle and gerund of <w>whirr</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine was <w>whirring</w> loudly as the pilot prepared for takeoff.",
                            "target_lang_translations": {
                                "cs": "Motor hlasitě <w>hučel</w>, zatímco se pilot připravoval ke vzletu."
                            }
                        },
                        {
                            "text": "The drone kept <w>whirring</w> above the trees while capturing aerial footage.",
                            "target_lang_translations": {
                                "cs": "Dron nad stromy neustále <w>bzučel</w>, zatímco pořizoval letecké záběry."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa whirr (bzučet, hučet)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bzučící",
                                "target_lang_sense_clarification": "vydávající bzučivý zvuk"
                            },
                            {
                                "target_lang_word": "hučící",
                                "target_lang_sense_clarification": "vydávající hučivý zvuk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}