                "senses": [
                    {
                        "sense_id": "6a67a4f7-22d2-324e-86c8-4b8721ff6843",
                        "entry_id": "85f9508f-e8b2-34e0-91bd-f03a91ab30cc",
                        "glosses": [
                            "pogląd postulujący możliwość wyjaśnienia wszystkich zjawisk zachodzących w przyrodzie za pomocą praw i pojęć mechaniki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a7a070-dc6e-4d28-8b24-57733cb1f054",
                                "sense_id": "6a67a4f7-22d2-324e-86c8-4b8721ff6843",
                                "text": "Powstanie mechanicyzmu wiąże się z początkami nowożytnych nauk przyrodniczych […], a do jego rozwoju przyczyniły się znacząco sukcesy mechaniki Newtonowskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
