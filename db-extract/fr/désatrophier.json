                "senses": [
                    {
                        "sense_id": "793e76f6-c0e6-3649-8d3c-f0e8cdf380bb",
                        "entry_id": "39876436-b413-3009-87ad-61fddcac3631",
                        "glosses": [
                            "Faire perdre son caractère atrophié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a7b129-18ac-4cae-898e-4b971b223d1f",
                                "sense_id": "793e76f6-c0e6-3649-8d3c-f0e8cdf380bb",
                                "text": "Ce caractère subversif est sacré, et c’est ce désir subversif que tout théâtre vraiment populaire doit chercher à stimuler, à développer, à désatrophier, à faire grandir."
                            },
                            {
                                "example_id": "b45eb090-ab76-4339-8fc4-b16d5d863bed",
                                "sense_id": "793e76f6-c0e6-3649-8d3c-f0e8cdf380bb",
                                "text": "Comment ces parties, qui n’ont plus que la vie automatique, redeviennent sensibles et agissent à volonté, quand il arrive que, par l’électricité, les secousses de l’émétique, ou tout autre procédé médical, on parvient à désatrophier le tronc et ses ramifications."
                            }
                        ]
                    }
                ],
