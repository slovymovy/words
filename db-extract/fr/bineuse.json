                    {
                        "sense_id": "d9c0ecbc-7e23-3185-a432-c6026e6dacf1",
                        "entry_id": "4bc658da-9787-3ead-a0f8-dbcc4550d161",
                        "glosses": [
                            "Instrument aratoire qui effectue le binage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f103636-6fdd-4df2-ba1f-db5ec193fd2f",
                                "sense_id": "d9c0ecbc-7e23-3185-a432-c6026e6dacf1",
                                "text": "Cette bineuse est constituée par un bâti métallique, muni d’une ou quelquefois deux roues à l’avant, et assemblé à l’arrière avec deux manchons en bois."
                            },
                            {
                                "example_id": "b645139a-a6ea-4d63-ae43-72958fb40779",
                                "sense_id": "d9c0ecbc-7e23-3185-a432-c6026e6dacf1",
                                "text": "Les bineuses sont des matériels de désherbage spécifiquement adaptés aux cultures semées en ligne (maïs, betterave…). Deux types de bineuses sont réellement utilisées: la bineuse à dents et la bineuse à étoiles. Dans les deux cas, le principe est le même : des éléments « bineurs » (6, 8 ou plus) travaillent l’inter-rang de la culture."
                            }
                        ]
