    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9eab7f97-fa75-31fe-9d74-0b69abe5267a",
                    "sense_definition": "The part of a plant that grows underground, absorbs water and nutrients, and holds the plant in place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botany_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tree has deep <w>roots</w> that help it survive strong winds.",
                            "target_lang_translations": {
                                "ru": "У этого дерева глубокие <w>корни</w>, которые помогают ему пережить сильные ветры.",
                                "zh": "这棵树有很深的<w>根</w>，帮助它经受住强风。"
                            }
                        },
                        {
                            "text": "You should water the soil so the <w>roots</w> can absorb the moisture.",
                            "target_lang_translations": {
                                "ru": "Нужно поливать почву, чтобы <w>корни</w> могли впитывать влагу.",
                                "zh": "你应该给土壤浇水，这样<w>根</w>才能吸收水分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take root",
                        "put down roots",
                        "pull up by the roots"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть растения, которая растет под землей, впитывает воду и питательные вещества и удерживает растение на месте.",
                        "zh": "植物长在地下、吸收水分和养分并固定植物的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корень",
                                "target_lang_sense_clarification": "растения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根",
                                "target_lang_sense_clarification": "植物地下部分"
                            },
                            {
                                "target_lang_word": "树根",
                                "target_lang_sense_clarification": "树的根"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "425356c0-3654-32e9-84e2-2cb5df9a0c2d",
                    "sense_definition": "A number that produces a specified quantity when multiplied by itself a certain number of times.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "math_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The square <w>root</w> of nine is three.",
