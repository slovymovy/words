                        "entry_id": "7cec0d55-44db-31ad-9af5-8bda83ac0689",
                        "glosses": [
                            "Faire perdre son caractère exotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5459c0-b981-4409-b1a6-98b39b488c13",
                                "sense_id": "78469b48-7425-38e8-aede-e66df799f25d",
                                "text": "Les africanistes qui se reconnaissent dans ce point de vue disent qu’il faut « dé-exoticiser » l’Afrique et la rendre banale."
                            },
                            {
                                "example_id": "74597658-f992-4887-9b07-7c8058683cd3",
                                "sense_id": "78469b48-7425-38e8-aede-e66df799f25d",
                                "text": "De quoi nuancer et dé-exoticiser les théories de Jean-François Bayart (1999) sur l’extraversion comme stratégie historique des élites africaines."
                            }
                        ]
                    }
