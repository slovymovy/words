                "senses": [
                    {
                        "sense_id": "549cefd1-ccd5-3307-baa1-bd6968ec7fbe",
                        "entry_id": "0c2e3693-395a-3c4a-9bdd-731149d6f4fc",
                        "glosses": [
                            "Faire perdre son caractère saoudien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d12fed-0c61-4e0f-9b6f-ee0fb0d756f9",
                                "sense_id": "549cefd1-ccd5-3307-baa1-bd6968ec7fbe",
                                "text": "Face à une famille royale divisée en clans et en fratries, confrontée à la lutte contre le terrorisme et à la montée du fondamentalisme, l’Administration Bush est revenue sur son projet initial de « désaoudiser » l’Arabie."
                            },
                            {
                                "example_id": "b9ed6e30-c905-424b-b34b-bc9683fea0ce",
                                "sense_id": "549cefd1-ccd5-3307-baa1-bd6968ec7fbe",
                                "text": "En 2002, après une conférence au Pentagone où vous appeliez à « désaoudiser » l’Arabie, vous êtes évincé de la Rand Corporation, cet institut de recherche sur les questions de défense."
                            }
                        ]
                    }
                ],
