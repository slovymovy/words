                ],
                "senses": [
                    {
                        "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                        "entry_id": "60d3e8e8-56e1-3829-8f94-ff9f1b9de652",
                        "glosses": [
                            "Zusammenstellung von Einzelblättern meist informativen Charakters im bayerischen Schulwesen zu einem Thema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a2249ac-ee8f-4417-a261-9a5401622795",
                                "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                                "text": "„Das Geheft »Willkommenskultur« stellt konkrete Vorschläge für den Umgang mit Flüchtlingskindern in ihren ersten Schultagen vor.“"
                            },
                            {
                                "example_id": "ccf81192-b6a2-457f-9566-b8c9ca211896",
                                "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                                "text": "„Seit einigen Jahren werden diese meines Wissens nicht mehr als Geheft für jeden Schüler zur Verfügung gestellt, sondern müssen von den Schulen kopiert werden.“"
                            },
                            {
                                "example_id": "7fd5187b-e16f-430b-833e-66bfc309668d",
                                "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                                "text": "„Weches [sic!] Geheft sollen Sie nun verwenden, wenn im September Ihr Praktikum beginnt?“"
                            },
                            {
                                "example_id": "0200ed76-0a0a-4511-94e3-a5537b945e84",
                                "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                                "text": "„… geeignet zum Druck der Merkhilfe als achtseitiges Geheft im Format DIN A5 (Papier: DIN A4; Druck: beidseitig; Ausrichtung der Seiten beachten)“"
                            },
                            {
                                "example_id": "68596b18-ba18-490d-ad88-b975f94c0efa",
                                "sense_id": "e490ada6-2fcc-30e5-b8a7-57aab1e0c1cf",
                                "text": "„Dieses DIN A4-Geheft ist an alle staatlichen Gymnasien verschickt worden, kann aber natürlich in der Geschäftsstelle des bpv nachbestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
