                    {
                        "translation_id": "9a59dc74-1838-4971-9da0-4d9a164d5c16",
                        "source_entry_id": "62d4f65e-3cf7-3404-93f6-117698d36ef8",
                        "source_sense_id": "8d98a654-6ac4-3dff-8d38-f329dbec633a",
                        "source_sense_description": "bepaalde graansoort afkomstig uit Midden-Amerika, Zea mays",
                        "target_lang_word": "maize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b07a4928-bc63-3e85-b13c-6d800eb6909a",
                                        "entry_id": "ba5511f0-9c24-35cf-90d3-b6793865a05f",
                                        "glosses": [
                                            "Corn; a type of grain of the species Zea mays."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac078b14-d2a7-4d89-a0ec-ef0a4e3ccf33",
                                                "sense_id": "b07a4928-bc63-3e85-b13c-6d800eb6909a",
                                                "text": "But alass! these, when they had maize (yt is, Indean corne) they thought it as good as a feast, and wanted not only for 5. days togeather, but some time 2. or 3. months togeather, and neither had bread nor any kind of corne."
                                            },
                                            {
                                                "example_id": "712eae7b-18d2-4d85-8932-73b1efd7fc28",
                                                "sense_id": "b07a4928-bc63-3e85-b13c-6d800eb6909a",
                                                "text": "A fundamental creative act of American man was the development of maize. For it was maize that made possible and sustained the whole Peruvian civilization as well as Mexican and Central American ones. Exactly where it originated is not known, but corn was found in pre-Mayan graves dating to 3000 B.C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
