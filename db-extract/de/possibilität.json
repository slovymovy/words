                                                "sense_id": "1b778275-85b9-33e2-9fd7-2f4078419ca0",
                                                "text": "Stály před ním netušené možnosti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c335be3-cb34-371b-8af1-bf1eec3caeae",
