                "senses": [
                    {
                        "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                        "entry_id": "07d49f3a-0e6e-30ad-87eb-2d393a7a8d7f",
                        "glosses": [
                            "Having no odor."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac54eec9-0f4d-449a-9ccc-e853e9fb3ff0",
                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                "text": "They were taken unawares and overcome when the room filled with a lethal, odorless gas."
                            },
                            {
                                "example_id": "5cbaaf4d-7d88-4c6d-acc8-63bfbf83d54b",
                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                "text": "The garlion is a cross between the garlic and onion; the topeppo combines the tomato and the pepper. We have the odorless onion, the odorless cabbage, the lemon cucumber that grows on a vine but looks like a lemon, and a giant cucumber"
                            },
                            {
                                "example_id": "ba4e0963-1328-4ef9-956f-7e605d7d95a9",
                                "sense_id": "de641585-08ea-3aa8-9098-cd738b82f172",
                                "text": "The Invisible Killer Dihydrogen monoxide is colorless, odorless, tasteless, and kills uncounted thousands of people every year. Most of these deaths are caused by accidental inhalation of DHMO, but the dangers of dihydrogen monoxide do not end there."
                            }
                        ]
                    }
                ],
