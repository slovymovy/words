                                        "glosses": [
                                            "Avant le temps ordinaire (en parlant de la culture de fleurs ou de fruits)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6670e7-6bde-4e14-8892-6ef3f492b996",
                                                "sense_id": "bd1ee0f6-9eb4-3533-a7f1-aa46562fa611",
                                                "text": "Il a fait venir ces fruits hâtivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3299a91-47f8-34c2-8648-ee1ad927f446",
