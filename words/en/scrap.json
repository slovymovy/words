                {
                    "sense_id": "04fc14db-fcb5-36f7-8739-efd733427126",
                    "sense_definition": "Small amounts of food left over after a meal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waste_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We usually give the table <w>scraps</w> to the dog.",
                            "target_lang_translations": {
                                "ru": "Мы обычно отдаем <w>остатки</w> со стола собаке.",
                                "zh": "我们通常把<w>剩饭</w>喂给狗吃。",
                                "pl": "Zazwyczaj dajemy <w>resztki</w> ze stołu psu.",
                                "cs": "Obvykle dáváme <w>zbytky</w> od stolu psovi.",
                                "fr": "Nous donnons généralement les <w>restes</w> de table au chien.",
                                "it": "Di solito diamo gli <w>avanzi</w> della tavola al cane."
                            }
                        },
                        {
                            "text": "The stray cat survived by eating <w>scraps</w> from the restaurant bin.",
                            "target_lang_translations": {
                                "ru": "Бродячий кот выжил, питаясь <w>объедками</w> из мусорного бака ресторана.",
                                "zh": "那只流浪猫靠吃餐馆垃圾桶里的<w>残羹剩饭</w>活了下来。",
                                "pl": "Bezpański kot przeżył, jedząc <w>resztki</w> z restauracyjnego śmietnika.",
                                "cs": "Toulavá kočka přežila díky tomu, že jedla <w>zbytky</w> z restauračního koše.",
                                "fr": "Le chat errant a survécu en mangeant des <w>restes</w> provenant de la poubelle du restaurant.",
                                "it": "Il gatto randagio è sopravvissuto mangiando gli <w>avanzi</w> dal bidone del ristorante."
                            }
                        }
                    ],
                    "synonyms": [
                        "leftovers",
                        "remains"
