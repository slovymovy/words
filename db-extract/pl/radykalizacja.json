                                        "sense_id": "8d262187-8372-3142-9aa9-d989632215d1",
                                        "entry_id": "1ae217a1-b2bb-331a-900d-c414218bc2dd",
                                        "glosses": [
                                            "The process of radicalizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "862c27de-3e17-452c-bf87-17e9e5795c7f",
                                                "sense_id": "8d262187-8372-3142-9aa9-d989632215d1",
                                                "text": "From there, it was only a short step to “Kekism,” at once a joke religion and a precursor of the reactionary radicalization to follow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c22992a9-451f-48d7-86ef-5dc07ef10899",
                        "source_entry_id": "a0ec2715-9aa5-323e-b21f-0ebee2f46e01",
                        "source_sense_id": "b91b2610-d3d0-3269-bcc9-397d92e97550",
                        "target_lang_word": "радикализация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "радикализация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9d678567-6373-3ec3-9c85-a3278df642d5",
                                        "entry_id": "884b2ced-1849-386d-a055-78fe9fee1a83",
                                        "glosses": [
                                            "действие по значению гл. радикализировать, радикализироваться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff3f250-ba87-4cd4-8009-2f2ad83ceaf5",
                                                "sense_id": "9d678567-6373-3ec3-9c85-a3278df642d5",
                                                "text": "Вообще одна из главных проблем любых российских протестов в том, что сами протестующие не до конца способны не только сформулировать свои требования, но и объяснить, почему они протестуют. А власть в свою очередь считает, что в стране нет никаких проблем, кроме самих недовольных. Поэтому нужно убрать этих недовольных, и всё остальное будет хорошо. Но это путь не только в никуда, но и к радикализации любого недовольства. И это может иметь достаточно серьёзные последствия в обозримом будущем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
