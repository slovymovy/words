                "senses": [
                    {
                        "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                        "entry_id": "ee7c96e8-b629-3599-b406-49944995fc23",
                        "glosses": [
                            "zeitlicher und aktionaler Verlauf eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318b4543-f204-44ac-83b9-92e24c383e27",
                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                "text": "„Es bestätigt sich auch für das Regelspiel, dass der Spielablauf im wesentlichen nicht durch das Festhalten an einer durchgehenden Gestaltungslinie bedingt ist.“"
                            },
                            {
                                "example_id": "365cd7ee-204d-4948-9f42-d9a1e6e19c6e",
                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                "text": "„Meistens gründen sie mit ihrem Master Digitale Medien eigene Start-up-Unternehmen im Bereich Webdesign, kümmern sich um die Visual Effects bei Film- und Werbeproduktionen, erstellen Computersimulationen oder steigen in die lukrative Computerspiel-Branche ein – dort entwickeln und animieren sie die Spielfiguren und programmieren den gesamten Spielablauf.“"
                            },
                            {
                                "example_id": "d558ac31-b0b3-4b9b-8f0b-8d0dece4cd94",
                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                "text": "„Wenn wir uns allerdings vor Augen führen, was Spielen alles vom Spielenden verlangt, […] dann wird einsichtig, dass beim Spielen auch Schwierigkeiten entstehen können, dass also nicht jeder Spielablauf unproblematisch ist.“"
                            },
                            {
                                "example_id": "63c5ae0d-968f-4753-b40e-e1a40ab6d912",
                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                "text": "„Deshalb sehe ich das nicht als Belastung und auch nicht als unnötigen Test, sagte Labbadia, der in bisher vier intensiven Arbeitstagen viel Wert auf Geschlossenheit, taktische Disziplin, mehr Dynamik und schnelle Spielabläufe gelegt hat.“"
                            },
                            {
                                "example_id": "c51a2cb7-9fcb-46cd-a262-17a411b4bfc7",
                                "sense_id": "ac75f835-6cd5-3ce1-9b2b-a6565498f1c5",
                                "text": "„Es ging nur noch um die Sicherheit unserer Spieler, ein regulärer Spielablauf war nicht mehr möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
