                        "examples": [
                            {
                                "example_id": "e75cd96d-f30b-4c96-b7e7-0377b99c8ca6",
                                "sense_id": "0c98f5a1-eae1-395c-8d07-1f57307dded9",
                                "text": "„Es handelt sich um einen Vierteiler, die beiden ersten Teile hatten am 7. Oktober Premiere.“"
                            },
                            {
                                "example_id": "c5487cbb-4f5f-42d4-b2e7-532a923a6bd7",
                                "sense_id": "0c98f5a1-eae1-395c-8d07-1f57307dded9",
                                "text": "„Ausgehend von dem, was dieser Vierteiler an historischen Fakten und Interpretationen zusammenträgt, muss man anmerken, dass es vor allem der Sklavenhandel war, der sich zum Medium der ursprünglichen Akkumulation machte.“"
                            }
                        ],
