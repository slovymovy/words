                "senses": [
                    {
                        "sense_id": "df219977-0e6e-3fe5-8d79-9aad3073b769",
                        "entry_id": "617a11b2-769d-3f9c-9c35-8a52edb74cb3",
                        "glosses": [
                            "met een harde opvallende kleur rood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb701a69-dfd1-4b8a-bf92-b9dbcca48014",
                                "sense_id": "df219977-0e6e-3fe5-8d79-9aad3073b769",
                                "text": "'De jurk in halterstijl is helrood en gemaakt van zijde en fluweel', liet het Witte Huis weten. Een opvallende ring, ontworpen door Kimberly McDonald, hield de stukjes stof aan de neklijn bijeen. Schoenen van Jimmy Choo maakten het ensemble helemaal af. Op Twitter werd de keuze van Michelle alvast enthousiast onthaald."
                            },
                            {
                                "example_id": "cfd6fbe0-a630-4f14-9997-b7e65cf2cc43",
                                "sense_id": "df219977-0e6e-3fe5-8d79-9aad3073b769",
                                "text": "Ook voor het avondgedeelte koos de Amerikaan voor een bombardement aan harde kleuren waarvan de absolute klapper een helrode jurk met aangehechte cape was."
                            }
                        ]
                    }
                ],
