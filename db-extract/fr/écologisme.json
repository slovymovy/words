                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e876071d-3923-48f2-b52e-799fc004cbfc",
                        "entry_id": "ddf6f009-79c2-364a-9695-ab01c0207fce",
