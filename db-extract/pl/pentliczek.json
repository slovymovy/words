                    {
                        "sense_id": "045a5edd-930f-3269-a6e3-d9ae049c86fa",
                        "entry_id": "9ae06522-0922-3f49-acf9-a277f3975d21",
                        "glosses": [
                            "abstrakcyjny wyraz z dziecięcej wyliczanki"
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "c9a18612-2de0-4c39-8c12-7417b8c404b5",
                                "sense_id": "045a5edd-930f-3269-a6e3-d9ae049c86fa",
                                "text": "Entliczek-pentliczek, czerwony stoliczek, na kogo wypadnie, na tego bęc!"
                            },
                            {
                                "example_id": "12d4f14f-9f69-4a87-9c37-17c9b42dcaf6",
                                "sense_id": "045a5edd-930f-3269-a6e3-d9ae049c86fa",
                                "text": "Entliczek-pentliczek, czerwony stoliczek, / A na tym stoliczku pleciony koszyczek, / W koszyczku jabłuszko, w jabłuszku robaczek, / A na tym robaczku zielony kubraczek."
                            },
                            {
                                "example_id": "6cc436f6-1a27-4af1-a41a-364d51bf4d95",
                                "sense_id": "045a5edd-930f-3269-a6e3-d9ae049c86fa",
                                "text": "Entliczek-pentliczek / czerwony „Płomyczek”, / na kogo wypadnie, na tego bęc! / i do więzienia…"
                            },
                            {
                                "example_id": "7c98bc3b-cb60-431c-aea1-ee6aed6ec06a",
                                "sense_id": "045a5edd-930f-3269-a6e3-d9ae049c86fa",
                                "text": "Entliczek-pentliczek / Co zrobi Piechniczek…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
