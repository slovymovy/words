                                "target_senses": [
                                    {
                                        "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                        "entry_id": "e1b401b4-e2b7-3ae7-aa61-01a90bb6ce0b",
                                        "glosses": [
                                            "asiatisches Land im Himalaya"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a076aa9-ede0-414f-a89f-d72b3bc006fe",
                                                "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                                "text": "Bhutan ist buddhistisch geprägt."
                                            },
                                            {
                                                "example_id": "95bcb3ff-03dd-4204-b012-6e947f0a2d2f",
                                                "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                                "text": "Thimphu ist die Hauptstadt von Bhutan."
                                            },
                                            {
                                                "example_id": "b4b14e40-5675-41d2-bfd9-e1258653b914",
                                                "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                                "text": "Der Himalaya bestimmt die Landschaft Bhutans."
                                            },
                                            {
                                                "example_id": "cb1ba405-63ba-4fa9-ad72-79039d8b7d66",
                                                "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                                "text": "Berge über 6000 m Höhe dürfen in Bhutan nicht bestiegen werden, weil die Berggipfel als Wohnstatt von Geistern und Göttern gelten."
                                            },
                                            {
                                                "example_id": "1e5a5367-7b42-406a-8ec3-7e34258dd9f5",
                                                "sense_id": "11beb68e-26fb-3ec1-8241-ebc466b46755",
                                                "text": "„Er hatte sieben Jahre lang in der Hauptstadt Tibets und in den Zentren des Buddhismus in Bhutan und Nepal studiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
