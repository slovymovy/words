                    {
                        "translation_id": "1d98902c-2ffc-4cc6-94b9-cfa8b9882b1d",
                        "source_entry_id": "9b0e4687-f222-3251-ac56-a7fcf8d5c5eb",
                        "source_sense_id": "dad82820-61e4-3969-b266-5e09b009200c",
                        "target_lang_word": "Peristyl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Peristyl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6a09cf-cad3-3ec8-ad8e-eb60c88f62fc",
                                        "entry_id": "bfe43e2c-3c7a-3fb9-88de-6e6e9ce7b065",
                                        "glosses": [
                                            "von Säulen umgebener Innenhof des altgriechischen Hauses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12263c9d-a381-4170-a963-8ff307670d14",
                                                "sense_id": "bd6a09cf-cad3-3ec8-ad8e-eb60c88f62fc",
                                                "text": "„Das Peristyl […] ist in der antiken Architektur ein rechteckiger Hof, der auf allen Seiten von durchgehenden Säulenhallen […] umgeben ist.“"
                                            },
                                            {
                                                "example_id": "805c1603-168f-45fd-a728-98a3ef018593",
                                                "sense_id": "bd6a09cf-cad3-3ec8-ad8e-eb60c88f62fc",
                                                "text": "Marcus und Livia wandeln schweigend durch das Peristyl."
                                            },
                                            {
                                                "example_id": "5a31ae1c-686f-4c8c-b485-afe356966248",
                                                "sense_id": "bd6a09cf-cad3-3ec8-ad8e-eb60c88f62fc",
                                                "text": "„Er trat in ein Peristyl mit doppelter Säulenreihe, blieb vor mir stehen, musterte mich von Kopf bis zu den Füßen und von den Füßen bis zum Kopf und sagte dann nach kurzem Nachdenken: »Sie sind ein sehr schöner Mann.«“"
                                            },
                                            {
                                                "example_id": "4060d5a9-99a9-482a-9bd3-16eee48ae8b7",
                                                "sense_id": "bd6a09cf-cad3-3ec8-ad8e-eb60c88f62fc",
                                                "text": "„Acht Stufen von weißlich geflecktem Marmor führten zur Piazza und dem Peristyle, mit dem die Front des Hauses verziert war; die Säulenräume waren mit hohen Jalousiefenstern ausgefüllt, gleichfalls um während der heißen Sommerszeit einen fortwährenden Luftzug zu unterhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51b56865-9dcb-469d-91a7-fa56e7d7ef81",
