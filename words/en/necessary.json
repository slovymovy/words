                    "semantic_group_id": "toilet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic cabin still had an old <w>necessary</w> located a few yards behind the main building.",
                            "target_lang_translations": {
                                "ru": "В исторической хижине все еще сохранился старый <w>нужник</w>, расположенный в нескольких метрах за главным зданием."
                            }
                        },
                        {
                            "text": "Before indoor plumbing, the <w>necessary</w> was a standard feature of every backyard.",
                            "target_lang_translations": {
