    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73b6d340-8170-3ac8-a6df-d61b39c0006c",
                    "sense_definition": "The occurrence of events that happen at the same time by accident but seem to have a connection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chance events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a strange <w>coincidence</w> that we both wore the exact same dress to the party.",
                            "target_lang_translations": {
                                "ru": "Это было странное <w>совпадение</w>, что мы обе надели на вечеринку совершенно одинаковые платья."
                            }
                        },
                        {
                            "text": "By sheer <w>coincidence</w>, I met my old school friend while I was on vacation in Japan.",
                            "target_lang_translations": {
                                "ru": "По чистому <w>совпадению</w> я встретил своего старого школьного друга, когда был в отпуске в Японии."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluke",
                        "chance"
                    ],
                    "common_phrases": [
                        "sheer coincidence",
                        "strange coincidence",
                        "by coincidence",
                        "mere coincidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайное стечение обстоятельств, которые происходят одновременно и кажутся связанными между собой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадение",
                                "target_lang_sense_clarification": "случайная одновременность событий"
                            },
                            {
                                "target_lang_word": "случайность",
                                "target_lang_sense_clarification": "непредвиденное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd7d4d7-9edc-3225-a69b-5d83314c1d90",
                    "sense_definition": "The state or fact of occupying the same relative position or occurring at the same time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simultaneity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>coincidence</w> of their interests made them perfect partners for the new research project.",
                            "target_lang_translations": {
                                "ru": "<w>Совпадение</w> их интересов сделало их идеальными партнерами для нового исследовательского проекта."
                            }
                        },
                        {
                            "text": "The <w>coincidence</w> of the two explosions suggested they were triggered by the same remote device.",
                            "target_lang_translations": {
                                "ru": "<w>Одновременность</w> двух взрывов наводила на мысль, что они были вызваны одним и тем же дистанционным устройством."
                            }
                        }
                    ],
                    "synonyms": [
                        "concurrentness",
                        "simultaneousness"
                    ],
                    "common_phrases": [
                        "coincidence of interests",
                        "temporal coincidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или факт нахождения в одном и том же положении или происхождение в одно и то же время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадение",
                                "target_lang_sense_clarification": "сходство или общность интересов, взглядов"
                            },
                            {
                                "target_lang_word": "одновременность",
                                "target_lang_sense_clarification": "происхождение в одно и то же время"
                            },
                            {
                                "target_lang_word": "совмещение",
                                "target_lang_sense_clarification": "нахождение в одной позиции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b57baa07-dab7-3f10-908a-05dd35b8ab3b",
                    "sense_definition": "A specific point in mathematical analysis where two functions have the same value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical points",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician spent hours calculating the exact <w>coincidence</w> point for the two complex functions.",
                            "target_lang_translations": {
                                "ru": "Математик провел часы, вычисляя точную <w>точку совпадения</w> для двух сложных функций."
                            }
                        },
                        {
                            "text": "In this geometric proof, the <w>coincidence</w> of the two lines occurs only at the origin.",
                            "target_lang_translations": {
                                "ru": "В этом геометрическом доказательстве <w>совпадение</w> двух линий происходит только в начале координат."
                            }
                        }
                    ],
                    "synonyms": [
                        "coincidence point"
                    ],
                    "common_phrases": [],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка в математическом анализе, в которой две функции принимают одинаковое значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совпадение",
                                "target_lang_sense_clarification": "математическое совмещение графиков или линий"
                            },
                            {
                                "target_lang_word": "точка совпадения",
                                "target_lang_sense_clarification": "технический термин в анализе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
