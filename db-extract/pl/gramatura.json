                    {
                        "sense_id": "455240f0-6da1-342f-b470-f8e4a54d893c",
                        "entry_id": "a6aa2ec1-38c8-302b-8322-a8e68fa449e2",
                        "glosses": [
                            "ciężar materiału, zwłaszcza papieru, wyrażony w gramach na metr kwadratowy arkusza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1adb2d80-c9bc-4ca5-a1f2-fb25ea10eaed",
                                "sense_id": "455240f0-6da1-342f-b470-f8e4a54d893c",
                                "text": "W mieszkaniu był również papier o takiej samej gramaturze jak ten, z którego wykonywane są dyplomy wyższych uczelni i papier, z którego wykonywane były stare dowody rejestracyjne i prawa jazdy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89a451e7-2443-3708-9503-cdf230a1bbf2",
                        "entry_id": "a6aa2ec1-38c8-302b-8322-a8e68fa449e2",
                        "glosses": [
                            "ciężar posiłku lub wyrobu spożywczego wyrażony w gramach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df76a36d-2b01-4b8d-b81a-abdf6548c094",
                                "sense_id": "89a451e7-2443-3708-9503-cdf230a1bbf2",
                                "text": "W warszawskim Wedlu zdarzyło się, że konsumentka zwróciła torcik, gdyż według niej gramatura była za mała."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
