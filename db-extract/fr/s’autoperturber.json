                ],
                "senses": [
                    {
                        "sense_id": "a7a2027a-9300-3629-8a31-fdb3876146d9",
                        "entry_id": "67ac641e-2eba-31b2-986f-379ee46447a4",
                        "glosses": [
                            "Se perturber soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce96e61-5c22-4c00-8518-d2d60627c14c",
                                "sense_id": "a7a2027a-9300-3629-8a31-fdb3876146d9",
                                "text": "Dans cette configuration, je pense que les champs générés vont s'autoperturber."
                            },
                            {
                                "example_id": "976b8fbf-15ad-49c1-8343-7c7375ce01bf",
                                "sense_id": "a7a2027a-9300-3629-8a31-fdb3876146d9",
                                "text": "Cette capacité permet au sujet de s'autoperturber et de s'autoréguler, de façon endogène et donc autonome, afin de trouver la ou les solutions les plus efficaces face à un problème."
                            },
                            {
                                "example_id": "34888945-0c13-4c41-ab2b-b38b2e3b6128",
                                "sense_id": "a7a2027a-9300-3629-8a31-fdb3876146d9",
                                "text": "Vous voulez vous autoperturber pendant des années à vouloir faire des référendums."
                            }
                        ]
                    }
