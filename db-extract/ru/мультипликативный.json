                "senses": [
                    {
                        "sense_id": "9b167278-8f3c-3cba-8365-8df2534435ce",
                        "entry_id": "a88fd825-805d-320d-9384-d882fa2dc8bf",
                        "glosses": [
                            "книжн. связанный с умножением, получаемый при умножении и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4dee1ca-ebfa-414a-9a40-e7f13d9bc602",
                                "sense_id": "9b167278-8f3c-3cba-8365-8df2534435ce",
                                "text": "Например, мультипликативная полугруппа натуральных чисел, конечно, не являющаяся группой, есть подполугруппа мультипликативной группы всех положительных рациональных чисел."
                            }
                        ]
                    }
                ],
