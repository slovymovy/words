                        "sense_id": "deef644e-7991-3d0d-ab48-886fc0057e7a",
                        "entry_id": "81b6af47-1795-31db-9be3-a669657243dd",
                        "glosses": [
                            "Handlung (und ihr Ergebnis), jemanden vollständig der Macht einer anderen Person zu unterstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c35c60d-8253-4982-80db-045aeb733973",
                                "sense_id": "deef644e-7991-3d0d-ab48-886fc0057e7a",
                                "text": "„Zwar hatte die ferne Krone die Versklavung der Einheimischen grundsätzlich verboten; de facto wurde dieses Verbot durch Ausnahmeregelungen ausgehöhlt.“"
                            },
                            {
                                "example_id": "f9c7744d-b5bd-41b7-97c1-1007248cc2ac",
                                "sense_id": "deef644e-7991-3d0d-ab48-886fc0057e7a",
                                "text": "„Damit haben sie ihre eigene Versklavung unterschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
