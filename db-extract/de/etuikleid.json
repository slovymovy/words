                "senses": [
                    {
                        "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                        "entry_id": "9ef2c2f6-fe7b-3760-a76e-97a8f76e42c0",
                        "glosses": [
                            "einfaches Kleid, das an Hüfte und Taille eng geschnitten ist, ärmelloses ist oder nur kurze Ärmel hat und über dem Knie endet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4c5b5fd-c5d6-49d2-853f-6df42b1d80e0",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "„Stilikone Audrey Hepburn hat das enge, figurbetonte Etuikleid zum Klassiker gemacht.“"
                            },
                            {
                                "example_id": "ff1ee797-6808-417d-87a5-92d62d6c491b",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "[…] „Audrey Hepburn trug das schwarze Etuikleid in der berühmten Szene, als sie vor dem Schaufenster von Tiffany stand.“"
                            },
                            {
                                "example_id": "0de96f93-e59f-4275-8e46-320cca46a5b7",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "[Juliette Greco:] „Sie trat stets in Schwarz gekleidet auf: in engen Hosen und Pulli oder – später – im schwarzen Etuikleid.“"
                            },
                            {
                                "example_id": "d4a7d8eb-978c-4be7-88d3-9b4f0e144b4d",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "[Die Gréco] „[…] verbarg sich als Person vollkommen hinter dem Schwarz ihrer langen Etuikleider.“"
                            },
                            {
                                "example_id": "3a2b0f8c-a13a-4000-93eb-38363ef7abbc",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "[Die US-Richterin am Supreme Court Sonia Sotomayor] „trägt ein türkises Etuikleid und eine schwarze Strickjacke. […] Sie hat Stil.“"
                            },
                            {
                                "example_id": "dfb34e30-1470-47db-877a-16de34b7837c",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "„Die Dame trägt Kostüm oder Hosenanzug mit Bluse. Bei hohen Temperaturen hat sich das klassische Etuikleid vielfach bewährt.“"
                            },
                            {
                                "example_id": "fa04b7e5-fbec-4fd9-99f7-76e50dc11b3b",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "„PJ […] im roten enganliegenden Etuikleid mit knallroten Stöckelschuhen. Solche Signale sind bei einer intelligenten Frau wie PJ Harvey sicher kein Zufall.“"
                            },
                            {
                                "example_id": "5e176007-7187-40cb-b381-10482c3982dc",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "„Trotzdem ist es ihr gelungen, auch in Deutschland Kundinnen zu gewinnen. Es sind vor allem berufstätige Frauen, die Führungspositionen inne haben. »Diese Frauen wollen professionell auftreten. Sie tragen Etuikleider und Stiftröcke. Das ist genau meine Zielgruppe.«“"
                            },
                            {
                                "example_id": "1f154892-c302-4378-a066-c6eaa8cc1a15",
                                "sense_id": "5d189078-90fd-3d02-9726-b6eca05a1e4f",
                                "text": "„[…] Mit perfekt geföhnten Blondinen in Etuikleidern und auf High Heels inszeniert Regisseur Roach punktgenau das Bild einer toxisch-misogynen Arbeitswelt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
