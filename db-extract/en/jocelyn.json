                    },
                    {
                        "sense_id": "0c280ff6-e79f-3377-91ed-ccbc507f8c17",
                        "entry_id": "5a3a6540-3cd9-3b28-a169-a56987252b45",
                        "glosses": [
                            "A female given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a143c285-e375-46e9-b9d5-2f7e5c45cfc5",
                                "sense_id": "0c280ff6-e79f-3377-91ed-ccbc507f8c17",
                                "text": "I drove Dorothy immediately to King George V Hospital and two hours later she delivered a beautiful baby daughter. We named her Jocelyn."
                            }
                        ]
                    },
                    {
                        "sense_id": "86648af2-84c4-326b-83fd-368285e657c2",
                        "entry_id": "5a3a6540-3cd9-3b28-a169-a56987252b45",
                        "glosses": [
                            "A township in Ontario, Canada."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e62357c3-440f-44bd-a3f1-6914f3bca142",
                        "source_entry_id": "5a3a6540-3cd9-3b28-a169-a56987252b45",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Jocelyn",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jocelyn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82e433ba-1289-34ff-ab4f-236b7eb02192",
                                        "entry_id": "82a5cee8-372d-3b33-8f46-ee36c9d3f190",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7fd14b3-e35b-4d0a-9925-947146d87654",
                                                "sense_id": "82e433ba-1289-34ff-ab4f-236b7eb02192",
                                                "text": "Cinq mois après l’annonce de la mise en vente du groupe de cinéma CGR (Circuit Georges-Raymond), dont la valeur était estimée à 1 milliard d'euros, « l’heure n’est pas encore aux discussions serrées avec un repreneur potentiel », indique Jocelyn Bouyssy, le directeur général."
                                            },
                                            {
                                                "example_id": "e5c9b3a3-2ead-42b4-8b42-908fa5fb0d99",
                                                "sense_id": "82e433ba-1289-34ff-ab4f-236b7eb02192",
                                                "text": "« Régis, il faut le connaître sur la durée pour que ça fonctionne vraiment avec lui », estime Jocelyn Laurent (26 ans), qui l’a côtoyé au centre de formation lorientais."
                                            },
                                            {
                                                "example_id": "3731716b-fce9-4dc1-9133-944ccdf03855",
                                                "sense_id": "82e433ba-1289-34ff-ab4f-236b7eb02192",
                                                "text": "Il avait été battu par Lille (1-0) où Galtier, champion de France 2021, avait laissé sa place à Jocelyn Gourvennec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc6965cf-c61f-4a22-86b1-8caede8eb23b",
                        "source_entry_id": "5a3a6540-3cd9-3b28-a169-a56987252b45",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Josselin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
