                        "glosses": [
                            "Coureur qui pratique cette activité depuis peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e062f8-90b8-4a03-800d-275a614ccfa3",
                                "sense_id": "8b552765-8b37-3b4e-a938-c5c3054c0cd5",
                                "text": "On ne court pas un marathon pour faire bien mais pour se dépasser, pose le néocoureur."
                            },
                            {
                                "example_id": "a9e9e5ad-d84a-4cee-a732-04b91f6f52ef",
                                "sense_id": "8b552765-8b37-3b4e-a938-c5c3054c0cd5",
                                "text": "Même si tous les hommes arborent le même genre de tenue « néocoureurs des bois », certains semblent sortir tout droit d’un roman."
                            },
                            {
                                "example_id": "42ac19c8-d99f-4239-a924-c33e138d57ae",
                                "sense_id": "8b552765-8b37-3b4e-a938-c5c3054c0cd5",
                                "text": "Étonnant, mais, pourtant, pas un instant on ne décroche de la fuite folle de l’ancien critique et néocoureur, qui, de la montée vers Luz-Ardiden au col de Joux-Plane, oscille endre déboires physiques et métaphysiques."
                            }
                        ]
                    }
