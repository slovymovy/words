                                                "sense_id": "3aceba98-7ee0-3bdf-af31-7f84f14dd493",
                                                "text": "Pracuje jako stavbyvedoucí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6433c365-0d7d-3a9d-ba98-21f032110e0e",
                                        "entry_id": "68eba5ae-68d3-3419-9c5b-01c184d7d429",
