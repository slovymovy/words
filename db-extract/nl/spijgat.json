                                "target_senses": [
                                    {
                                        "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Trou, canal pour faire écouler les eaux hors du navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f377be53-8c9e-4274-be97-fb320ab5eef0",
                                                "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                                "text": "Il y a plusieurs dalots à chaque bord."
                                            },
                                            {
                                                "example_id": "ae85aa2d-d047-4960-aa91-48d76e1c7e77",
                                                "sense_id": "475d8a43-e3fc-3de7-a0b0-639ada660ad9",
                                                "text": "Le pont se remplissait, à chaque plongeon, et la nappe liquide, ne trouvant pas par les dalots un assez rapide écoulement, pouvait submerger le navire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Conduit maçonné permettant l'écoulement des eaux d'un remblai le long d'une route, d'une voie ferrée, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6150dfae-059c-4099-b200-bb5efbecbff1",
                                                "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                                "text": "Bélanger entreprit alors d'installer un dalot qui passerait au centre d'une talle d'érables à sucre."
                                            },
                                            {
                                                "example_id": "e23bf296-dde5-4a47-a1f5-8041d2a207fd",
                                                "sense_id": "5706fcd9-d4a9-3add-ab18-dc454643cd38",
                                                "text": "“C’est un problème au niveau d’un dalot bouché par des déchets verts et autres détritus, accentué par la pluie, alors l’eau pluviale est passée sur la route, déformant la chaussée à certains endroits.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80926bc-8d20-32d8-a527-61785f40fb5b",
                                        "entry_id": "2dcb9791-a4ee-38d9-98ba-cef89d29c4ce",
                                        "glosses": [
                                            "Sorte de gouttière située de chaque côté d’une allée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
