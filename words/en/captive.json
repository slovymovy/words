{
    "word_family": [
        "capture",
        "captivity",
        "captor",
        "captivate",
        "caption"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8928be08-0d28-38da-ba0f-94358b45f26d",
                    "sense_definition": "Held as a prisoner or confined in a space; not free to leave.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>captive</w> soldiers were eventually released after the peace treaty was signed.",
                            "target_lang_translations": {
                                "ru": "<w>Пленные</w> солдаты были в конце концов освобождены после подписания мирного договора.",
                                "de": "Die <w>gefangenen</w> Soldaten wurden nach der Unterzeichnung des Friedensvertrags schließlich freigelassen."
                            }
                        },
                        {
                            "text": "Zoos often have <w>captive</w> breeding programs to help save endangered species.",
                            "target_lang_translations": {
                                "ru": "Зоопарки часто имеют программы разведения <w>в неволе</w>, чтобы помочь спасти вымирающие виды.",
                                "de": "Zoos haben oft Zuchtprogramme <w>in Gefangenschaft</w>, um bedrohte Arten zu retten."
                            }
                        }
                    ],
                    "synonyms": [
                        "confined",
                        "imprisoned",
                        "incarcerated",
                        "caged"
                    ],
                    "antonyms": [
                        "non-captive"
                    ],
                    "common_phrases": [
                        "captive audience",
                        "captive breeding",
                        "held captive",
                        "taken captive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживаемый как пленник или запертый в пространстве; не имеющий свободы уйти.",
                        "de": "Als Gefangener festgehalten oder in einem Raum eingesperrt; nicht frei, sich zu bewegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пле́нный",
                                "target_lang_sense_clarification": "о солдатах или людях, захваченных в ходе конфликта"
                            },
                            {
                                "target_lang_word": "содержащийся в неволе",
                                "target_lang_sense_clarification": "о животных в зоопарках или питомниках"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gefangen",
                                "target_lang_sense_clarification": "allgemeiner Zustand der Unfreiheit"
                            },
                            {
                                "target_lang_word": "in Gefangenschaft",
                                "target_lang_sense_clarification": "besonders bei Tieren oder in militärischem Kontext"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33cd3888-da93-30bd-8ef7-5efad26f1108",
                    "sense_definition": "Strongly attracted to or charmed by someone or something; mentally or emotionally held.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>captive</w> to her beauty and could not look away.",
                            "target_lang_translations": {
                                "ru": "Он был <w>пленён</w> её красотой и не мог отвести взгляд.",
                                "de": "Er war von ihrer Schönheit <w>gefangen</w> und konnte den Blick nicht abwenden."
                            }
                        },
                        {
                            "text": "The storyteller held the children's <w>captive</w> imagination for hours.",
                            "target_lang_translations": {
                                "ru": "Рассказчик часами удерживал <w>захваченное</w> воображение детей.",
                                "de": "Der Geschichtenerzähler hielt die Fantasie der Kinder stundenlang <w>gefangen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivated",
                        "charmed",
                        "entranced",
                        "fascinated"
                    ],
                    "common_phrases": [
                        "captive heart",
                        "captive imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно привлеченный или очарованный кем-то или чем-то; удерживаемый ментально или эмоционально.",
                        "de": "Stark angezogen oder bezaubert von jemandem oder etwas; mental oder emotional gefesselt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пленённый",
                                "target_lang_sense_clarification": "перен. захваченный чувствами или мыслями"
                            },
                            {
                                "target_lang_word": "очаро́ванный",
                                "target_lang_sense_clarification": "находящийся под сильным впечатлением"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gebannt",
                                "target_lang_sense_clarification": "von Aufmerksamkeit oder Emotionen gefesselt"
                            },
                            {
                                "target_lang_word": "gefangen genommen",
                                "target_lang_sense_clarification": "im übertragenen Sinne von Gefühlen oder Schönheit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80f0c521-bd97-3b46-ab50-99176d97f4ec",
                    "sense_definition": "A person or animal that has been captured and is being kept in a confined space.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>captive</w> tried to escape from the cell during the night.",
                            "target_lang_translations": {
                                "ru": "<w>Пленник</w> пытался сбежать из камеры ночью.",
                                "de": "Der <w>Gefangene</w> versuchte in der Nacht aus der Zelle zu entkommen."
                            }
                        },
                        {
                            "text": "Guards brought food and water to the <w>captive</w> twice a day.",
                            "target_lang_translations": {
                                "ru": "Охранники приносили еду и воду <w>пленнику</w> дважды в день.",
                                "de": "Die Wachen brachten dem <w>Gefangenen</w> zweimal täglich Essen und Wasser."
                            }
                        }
                    ],
                    "synonyms": [
                        "prisoner",
                        "hostage",
                        "detainee"
                    ],
                    "common_phrases": [
                        "political captive",
                        "war captive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое было захвачено и содержится в замкнутом пространстве.",
                        "de": "Eine Person oder ein Tier, das gefangen genommen wurde und in einem begrenzten Raum gehalten wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пле́нник",
                                "target_lang_sense_clarification": "человек, взятый в плен"
                            },
                            {
                                "target_lang_word": "у́зник",
                                "target_lang_sense_clarification": "заключенный, лишенный свободы"
                            },
                            {
                                "target_lang_word": "пле́нный",
                                "target_lang_sense_clarification": "военнопленный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gefangener",
                                "target_lang_sense_clarification": "männliche Person, die ihrer Freiheit beraubt ist"
                            },
                            {
                                "target_lang_word": "Gefangene",
                                "target_lang_sense_clarification": "weibliche Person, die ihrer Freiheit beraubt ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f412c27-e92e-3704-8a54-c86c4761b2aa",
                    "sense_definition": "A subsidiary company formed to insure the risks of its parent company.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corporation established a <w>captive</w> to manage its own insurance needs more efficiently.",
                            "target_lang_translations": {
                                "ru": "Корпорация создала <w>кэптив</w> для более эффективного управления собственными страховыми потребностями.",
                                "de": "Das Unternehmen gründete eine <w>Captive-Versicherung</w>, um den eigenen Versicherungsbedarf effizienter zu verwalten."
                            }
                        },
                        {
                            "text": "Regulations for a <w>captive</w> can differ from those for traditional insurance providers.",
                            "target_lang_translations": {
                                "ru": "Правила для <w>кэптива</w> могут отличаться от правил для традиционных страховых компаний.",
                                "de": "Die Vorschriften für eine <w>Captive</w> können sich von denen für traditionelle Versicherungsanbieter unterscheiden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "captive insurance",
                        "captive insurer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дочерняя компания, созданная для страхования рисков своей материнской компании.",
                        "de": "Eine Tochtergesellschaft, die gegründet wurde, um die Risiken ihrer Muttergesellschaft zu versichern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэптив",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "кэптивная компания",
                                "target_lang_sense_clarification": "страхование"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Captive-Versicherung",
                                "target_lang_sense_clarification": "Fachbegriff für eine firmeneigene Versicherungsgesellschaft"
                            },
                            {
                                "target_lang_word": "Kaptiv-Versicherer",
                                "target_lang_sense_clarification": "im Finanzwesen gebräuchliche Bezeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73460f27-d263-3616-905f-2cff6249e08e",
                    "sense_definition": "To take someone as a prisoner; to capture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient army sought to <w>captive</w> the inhabitants of the city.",
                            "target_lang_translations": {
                                "ru": "Древняя армия стремилась <w>пленить</w> жителей города.",
                                "de": "Die antike Armee versuchte, die Bewohner der Stadt <w>gefangen zu nehmen</w>."
                            }
                        },
                        {
                            "text": "He did <w>captive</w> the enemy general after a long battle.",
                            "target_lang_translations": {
                                "ru": "Он всё же <w>пленил</w> вражеского генерала после долгой битвы.",
                                "de": "Er konnte den feindlichen General nach einer langen Schlacht <w>gefangen nehmen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "capture",
                        "seize"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern English uses 'capture' instead."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взять кого-то в плен; захватить.",
                        "de": "Jemanden gefangen nehmen; ergreifen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плени́ть",
                                "target_lang_sense_clarification": "устар. или высок."
                            },
                            {
                                "target_lang_word": "взять в плен",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gefangen nehmen",
                                "target_lang_sense_clarification": "Standardausdruck für das Ergreifen von Personen"
                            },
                            {
                                "target_lang_word": "bezwingen",
                                "target_lang_sense_clarification": "im Sinne von jemanden in seine Gewalt bringen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}