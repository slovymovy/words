                "senses": [
                    {
                        "sense_id": "e23b2478-f510-3110-80ff-4057de3f283e",
                        "entry_id": "a39b2c2c-dd2b-3e72-9b18-1b77939cd86c",
                        "glosses": [
                            "Benelüks"
