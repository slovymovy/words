                    {
                        "sense_id": "cb587ca1-d0b4-380d-80a8-2fa43bd86be1",
                        "entry_id": "332e51cf-a3cc-356d-983d-f3ad0565a537",
                        "glosses": [
                            "A nymph or minor goddess from Roman mythology."
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "f3717cef-546c-450e-8eba-1fc92690f2d6",
                                "sense_id": "cb587ca1-d0b4-380d-80a8-2fa43bd86be1",
                                "text": "On the heroine of his play he dwelt with the passionate fondness of a lover: there the real mingled with the ideal: could he write of love, and not think of Ethel Churchill? She was the Egeria of his heart, who taught him all the truth of tenderness."
                            }
                        ]
                    },
