                "senses": [
                    {
                        "sense_id": "436b84f0-8091-3c65-a281-e4a4ae7411ff",
                        "entry_id": "0e0efeb5-dc99-3eee-ae63-3f4c766a40bd",
                        "glosses": [
                            "een bureau voor juridische dienstverlening met als hoofdwerkzaamheid: werkzaamheden door advocaten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d3de44-7620-4d6d-8184-5117a829768e",
                                "sense_id": "436b84f0-8091-3c65-a281-e4a4ae7411ff",
                                "text": "Een advocatenkantoor dat de naam Parr & Co. droeg, gevestigd in Bread Lane, in de City, verzocht me op donderdag langs te komen - en of ik mijn paspoort en een uittreksel uit het bevolkingsregister wilde meenemen. Ik weet nog hoe bang ik was."
                            },
                            {
                                "example_id": "7e041ba8-621b-4eaa-a2f7-8b7659549246",
                                "sense_id": "436b84f0-8091-3c65-a281-e4a4ae7411ff",
                                "text": "Nadat ik rechten had gestudeerd en bij een advocatenkantoor ging werken, raakte ik naast het contact met mijn lichaam ook mijn 'gave' kwijt."
                            }
                        ]
                    }
                ],
