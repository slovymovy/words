                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4b516ac-2e64-3120-8b22-a9b531e6a38e",
                        "entry_id": "9c6db916-fecb-3ea9-a06f-91562d3be34c",
                        "glosses": [
                            "Caractère magique de quelque chose."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "92d4c22e-57c4-439c-a78d-af2c840a8d57",
                                "sense_id": "b4b516ac-2e64-3120-8b22-a9b531e6a38e",
                                "text": "Et la magie de l’île Maurice est sa lumière. Elle est, cette lumière, pourpre à Port-Louis, verte à Beau-Bassin, rose dans le nord, et bleue à la Rivière Noire. Et comme le poète peint par sa plume, cette extraordinaire magicité affecte son verbe, le fait."
                            }
                        ]
                    },
                    {
                        "sense_id": "beaa532d-53ec-3746-b4a7-9f917f5e1473",
                        "entry_id": "9c6db916-fecb-3ea9-a06f-91562d3be34c",
                        "glosses": [
                            "Qualité d’un carré magique ; constante magique d’un tel carré."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "20291ed6-46ea-4ccf-a2a3-f83b5ff727f9",
                                "sense_id": "beaa532d-53ec-3746-b4a7-9f917f5e1473",
                                "text": "Le cube d’un nombre augmenté de sa racine étant divisé par 2, donne la magicité du carré de ce nombre."
                            },
                            {
                                "example_id": "04168728-5dde-4953-a86d-8fae4034eb2f",
                                "sense_id": "beaa532d-53ec-3746-b4a7-9f917f5e1473",
                                "text": "On dira aussi d’un tableau magique qu’il vérifie la contrainte du carré, pour dire que, la magicité étant préalablement connue, on sait de plus que c’est un carré magique, c’est-à-dire qu’il comporte tous les nombres de 1 à n²."
                            }
                        ]
                    },
                    {
                        "sense_id": "dab7340c-2679-381f-bd06-587059c6f0c3",
                        "entry_id": "9c6db916-fecb-3ea9-a06f-91562d3be34c",
                        "glosses": [
                            "Qualité d’un noyau atomique possédant un nombre magique de protons et de neutrons."
                        ],
                        "tags": [
                            "especially",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7dcae6-3f7b-4e99-8a6f-d9ce561aa004",
                                "sense_id": "dab7340c-2679-381f-bd06-587059c6f0c3",
                                "text": "La « magicité » d’un noyau atomique correspond à une énergie de liaison accrue par rapport aux noyaux voisins (en termes de nombres de nucléons)."
                            }
                        ]
                    }
                ],
