                "senses": [
                    {
                        "sense_id": "fe0823f2-d8ae-3cec-a05d-c110eb4f201c",
                        "entry_id": "453020d5-e365-3e44-b010-cd3fb19ed2f1",
                        "glosses": [
                            "разг. обильное употребление спиртных напитков, также вечеринка с обильным употреблением алкоголя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa3115c-824d-499d-b2bd-03be66c58a00",
                                "sense_id": "fe0823f2-d8ae-3cec-a05d-c110eb4f201c",
                                "text": "Потом была грандиозная пьянка в ресторане с осетрами, поросятами, заливным и прочими разносолами ― постарался директор за спасённую жизнь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "901c67e9-1cf5-47ee-a640-ebbb9790e066",
                        "source_entry_id": "453020d5-e365-3e44-b010-cd3fb19ed2f1",
                        "source_sense_id": "fe0823f2-d8ae-3cec-a05d-c110eb4f201c",
                        "target_lang_word": "carousal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carousal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                        "entry_id": "7d324af7-4202-3370-b9d8-04a62dbad172",
                                        "glosses": [
                                            "A noisy feast or social gathering, often with much alcohol consumption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7ff5f9-fa91-4bcd-9dff-49a6c07877f3",
                                                "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                                "text": "When Alcohol ursurps the throne, and Sober Rationality is ejected, every other consideration is lost; that of having a regular ‘spree’ alone prevails:—the excited passions proclaim for a grand carousal."
                                            },
                                            {
                                                "example_id": "ab3de1c7-e993-4114-9b82-43974029fe0e",
                                                "sense_id": "3d386504-227f-3f92-b187-80862e9c6d9e",
                                                "text": "The earth-spirit of Tema, who loved carousals, heard from afar the songs and laughter of the people on Nassau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
