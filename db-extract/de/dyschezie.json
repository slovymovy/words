                "senses": [
                    {
                        "sense_id": "19ab850b-3aae-30b7-8f9a-5f2d515ac17c",
                        "entry_id": "9323681a-5053-3645-9224-eac0f666ab2b",
                        "glosses": [
                            "Störung des Stuhlgangs (Defäkation)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b237bed4-6f4b-436e-89cb-1aefd73fc627",
                                "sense_id": "19ab850b-3aae-30b7-8f9a-5f2d515ac17c",
                                "text": "„Eine Dyschezie ist eine schmerzhafte Stuhlentleerung (Defäkation), die auf einer Koordinationsstörung der Analschließmuskeln (Musculus sphincter ani internus und Musculus sphincter ani externus) mit der Beckenbodenmuskulatur beruht.“"
                            },
                            {
                                "example_id": "038f1aba-6c72-4679-857e-3d9c21707ce4",
                                "sense_id": "19ab850b-3aae-30b7-8f9a-5f2d515ac17c",
                                "text": "„Ein wohlgeformter Stuhl bei hartnäckiger Obstipation spricht für eine Dyschezie.“"
                            },
                            {
                                "example_id": "40e30b4d-b054-468b-91a5-3d6beac6cbb9",
                                "sense_id": "19ab850b-3aae-30b7-8f9a-5f2d515ac17c",
                                "text": "„Aus bis jetzt noch ungeklärten Gründen verschließt sich der Sphinkter bei einigen Patienten schneller, als für den Aktikon-Neosphinktern vorgesehen ist (ungefähr 7 min), was für eine Dyschezie verantwortlich sein kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b1b275c-a738-41c7-8121-bf67652563bd",
