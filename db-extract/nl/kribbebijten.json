                "word": "kribbebijten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19e1b97a-9f4b-3b1e-b988-466ae44c64bd",
                        "entry_id": "b8577c83-013d-3c56-81b1-f2932405fda9",
                        "glosses": [
                            "een ondeugd van ezels en paarden om aan de voerbak of staldeur te knagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344e90e1-b1db-41c3-a6a4-f9c3e08d3691",
                                "sense_id": "19e1b97a-9f4b-3b1e-b988-466ae44c64bd",
                                "text": "Geef de paarden geen suikerklontjes, anders gaan ze kribbebijten."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c8de65c-2eab-3aaf-883d-e10cd32fcfe7",
                        "entry_id": "b8577c83-013d-3c56-81b1-f2932405fda9",
                        "glosses": [
                            "in een narrige bui met iedereen ruzie maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc360c76-548b-4fef-a90e-2bc7e3e76b94",
                                "sense_id": "6c8de65c-2eab-3aaf-883d-e10cd32fcfe7",
                                "text": "Is hij alweer aan het kribbebijten? Hij heeft wel vaak de pest in tegenwoordig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
