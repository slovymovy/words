                ],
                "senses": [
                    {
                        "sense_id": "8f6cfd8b-c913-3832-a9d4-b072cc86da0d",
                        "entry_id": "98e2ea49-0017-32db-b629-17c801c0dd81",
                        "glosses": [
                            "Frau mit blondem Haar"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "fa6210db-ac1f-4481-b641-58a6826c12d9",
                                "sense_id": "8f6cfd8b-c913-3832-a9d4-b072cc86da0d",
                                "text": "„Daisy, die verwöhnte Amerikanerin, ist ein dummes Blondchen, das so lange bei den britischen Schwarzhemden und dem perversen Boy aushalten muss, bis die Dramaturgie den Mann mit den richtigen Überzeugungen auftreten lässt.“"
                            },
                            {
                                "example_id": "17ac74b3-0a99-4dca-8132-7d63017f79b4",
                                "sense_id": "8f6cfd8b-c913-3832-a9d4-b072cc86da0d",
                                "text": "„Wird mir wirklich ein Ferrari anvertraut, oder sucht der Herr mit dem Pirelli-Kalender an der Wand nur ein Blondchen für den Beifahrersitz?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a79616ad-808f-4fd0-a79c-f54ed8ae2daf",
                        "source_entry_id": "98e2ea49-0017-32db-b629-17c801c0dd81",
                        "source_sense_id": "8f6cfd8b-c913-3832-a9d4-b072cc86da0d",
                        "source_sense_description": "umgangssprachlich, meist abwertend: Frau mit blondem Haar",
                        "target_lang_word": "blond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                        "entry_id": "74eaf093-fe84-3779-8a11-c036178c2f61",
                                        "glosses": [
                                            "Of a bleached or pale golden (light yellowish) colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0115ce74-4d4e-4284-ac3f-d799b2a7c081",
                                                "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                                "text": "She has a blond complexion, with brown hair and gray eyes."
                                            },
                                            {
                                                "example_id": "a5e7026b-b9a2-4da9-adff-4c4394177449",
                                                "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                                "text": "If you're going one or two shades lighter, don't even touch your brows. But if you're making a big change, soften them by tinting them with home haircolor: a lighter shade of brown for blonder shades, a golden shade if you're dyeing your hair red."
                                            },
                                            {
                                                "example_id": "1ae00d4a-b760-41bf-97f6-012593bffa7c",
                                                "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                                "text": "blond hair"
                                            },
                                            {
                                                "example_id": "1917b22d-3113-447d-bd7e-4bc844a056d0",
                                                "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                                "text": "blond ale"
                                            },
                                            {
                                                "example_id": "d819af78-01f6-4f80-a477-7ce7796ce41c",
                                                "sense_id": "881f15a0-4991-3580-9b7a-51390f54ab65",
                                                "text": "blond beer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7081b9e5-5353-3d3e-bdb8-c01d16dd65d5",
                                        "entry_id": "74eaf093-fe84-3779-8a11-c036178c2f61",
                                        "glosses": [
                                            "Having blond hair."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1296c8aa-41d7-40b4-b4c8-0398ca7b5c4f",
                                                "sense_id": "7081b9e5-5353-3d3e-bdb8-c01d16dd65d5",
                                                "text": "He seemed—somehow—younger than I had ever been, and blonder and more beautiful, and he wore his masculinity as unequivocally as he wore his skin."
                                            },
                                            {
                                                "example_id": "694fdebd-f1be-47c4-929a-bde7eac79bc5",
                                                "sense_id": "7081b9e5-5353-3d3e-bdb8-c01d16dd65d5",
                                                "text": "Blonde bombshells have been around since the beginning of time, but lately, stars have really been stepping up their golden-haired game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d73047-5d6b-3f7a-b31f-9ed54f6d53f8",
                                        "entry_id": "74eaf093-fe84-3779-8a11-c036178c2f61",
                                        "glosses": [
                                            "Alternative spelling of blonde (“stupid”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2d5bbb-1f45-4175-9fad-7cae7659b2ec",
                                                "sense_id": "69d73047-5d6b-3f7a-b31f-9ed54f6d53f8",
                                                "text": "“She was so blond, that where it said 'sign here,' she wrote Gemini.” He had given her only the weakest of smiles."
                                            },
                                            {
                                                "example_id": "7059e26f-f45f-4ff5-a500-fa904f67385a",
                                                "sense_id": "69d73047-5d6b-3f7a-b31f-9ed54f6d53f8",
                                                "text": "Katelyn's laugh was nearly uncontrollable. “You are so blond sometimes,” she said with a long laughing sigh, but then calmed herself down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blond",
                                "target_lang_code": "en",
                                "target_senses": [
