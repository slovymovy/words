    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5a2259c-f6c6-3c11-9628-6a532f988e9a",
                    "sense_definition": "Заполненный до предела чем-либо; плотно уложенный вещами или предметами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он с трудом поднял тяжёлый чемодан, плотно <w>набитый</w> старыми книгами и одеждой.",
                            "target_lang_translations": {
                                "en": "He struggled to lift the heavy suitcase, tightly <w>packed</w> with old books and clothes."
                            }
                        },
                        {
                            "text": "У школьника был большой рюкзак, туго <w>набитый</w> тетрадями и учебниками.",
                            "target_lang_translations": {
                                "en": "The schoolboy had a large backpack, tightly <w>stuffed</w> with notebooks and textbooks."
                            }
                        }
                    ],
                    "synonyms": [
                        "наполненный"
                    ],
                    "common_phrases": [
                        "туго набитый",
                        "набитый карман"
                    ],
                    "target_lang_definitions": {
                        "en": "Filled to capacity; tightly packed or stuffed with things or objects."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuffed",
                                "target_lang_sense_clarification": "filled tightly with things"
                            },
                            {
                                "target_lang_word": "packed",
                                "target_lang_sense_clarification": "full of items"
                            },
                            {
                                "target_lang_word": "crammed",
                                "target_lang_sense_clarification": "forced tightly into a space"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4805a871-6a4c-3932-8b80-73e47c04e57b",
                    "sense_definition": "Переполненный людьми; тесный из-за большого скопления народа.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crowded",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В утренний час пик к остановке подъехал битком <w>набитый</w> автобус.",
                            "target_lang_translations": {
                                "en": "During the morning rush hour, a <w>jam-packed</w> bus pulled up to the stop."
                            }
                        },
                        {
                            "text": "Вечером весь зрительный зал был <w>набит</w> публикой до отказа.",
                            "target_lang_translations": {
                                "en": "In the evening, the entire auditorium was <w>packed</w> to capacity with the audience."
                            }
                        }
                    ],
                    "common_phrases": [
                        "битком набитый",
                        "набитый людьми"
                    ],
                    "target_lang_definitions": {
                        "en": "Overcrowded with people; packed to capacity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "packed",
                                "target_lang_sense_clarification": "full of people"
                            },
                            {
                                "target_lang_word": "jam-packed",
                                "target_lang_sense_clarification": "extremely crowded"
                            },
                            {
                                "target_lang_word": "crammed",
                                "target_lang_sense_clarification": "crowded tightly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96922a86-cd0e-3848-8eb4-3db3743a7a3e",
                    "sense_definition": "Совершенный, абсолютный, круглый (употребляется бранно со словами «дурак», «дура»).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Только <w>набитый</w> дурак мог совершить такую очевидную и непростительную ошибку.",
                            "target_lang_translations": {
                                "en": "Only an <w>utter</w> fool could make such an obvious and unforgivable mistake."
                            }
                        },
                        {
                            "text": "Она считала своего соседа совершенно <w>набитым</w> дураком за его странные выходки.",
                            "target_lang_translations": {
                                "en": "She considered her neighbor to be a complete <w>fool</w> because of his strange antics."
                            }
                        }
                    ],
                    "common_phrases": [
                        "набитый дурак"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Complete, absolute, utter (used pejoratively, typically modifying 'fool')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "utter",
                                "target_lang_sense_clarification": "used with 'fool'"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "thorough, absolute"
                            },
                            {
                                "target_lang_word": "downright",
                                "target_lang_sense_clarification": "thoroughly foolish"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86d91fff-5705-3867-bc5b-11c0ed8cce17",
                    "sense_definition": "Страдательное причастие прошедшего времени от глагола <w>набить</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мешок, быстро <w>набитый</w> рабочими сухими опилками, стоял прямо у дверей склада.",
                            "target_lang_translations": {
                                "en": "The sack, quickly <w>filled</w> by the workers with dry sawdust, stood right by the warehouse doors."
                            }
                        },
                        {
                            "text": "Тюфяк был заново <w>набит</w> свежей и душистой соломой специально к приезду гостей.",
                            "target_lang_translations": {
                                "en": "The mattress was newly <w>stuffed</w> with fresh and fragrant straw especially for the arrival of the guests."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'набить': stuffed, packed, or filled by someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuffed",
                                "target_lang_sense_clarification": "filled with material"
                            },
                            {
                                "target_lang_word": "filled",
                                "target_lang_sense_clarification": "packed with contents"
                            }
                        ]
                    }
                }
            ]
        }
