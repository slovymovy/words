                        "examples": [
                            {
                                "example_id": "f5d37c62-2915-43e7-a8b2-bb61b7e10395",
                                "sense_id": "7c07934e-cad5-3c27-9a4d-910ace138c4b",
                                "text": "Mon copain Mohamed est un hittiste. C’est-à-dire un « muriste » en français."
                            },
                            {
                                "example_id": "6ee691c1-fbc9-4cdf-8308-de2a47e5a90a",
                                "sense_id": "7c07934e-cad5-3c27-9a4d-910ace138c4b",
                                "text": "Or, en 1988, la population stratégique des 15-24 ans représentant quelque 20% de la population algérienne, était à 72% sans travail ce qui les condamnait à s'adosser, oisifs, aux murs des cités, avec le qualificatif de « muristes »."
                            },
                            {
                                "example_id": "40a8e072-55d5-4ed9-826b-e40d757fda63",
                                "sense_id": "7c07934e-cad5-3c27-9a4d-910ace138c4b",
                                "text": "Nonobstant leur désastreuse destinée, les hittistes n'en rigolent pas moins une bonne partie de la journée. La nature les a faits comme ça, les muristes, le dos large et le zygomatique à la retrousse."
                            }
                        ]
                    }
