                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfa3008-039b-4716-ad80-88cc45df0cd1",
                                                "sense_id": "d99f2618-48ec-3141-8b76-b707a39f5e1b",
                                                "text": "Z řady vystoup’ Brichta, vyšnořený, oholený, býval kaprál u hulánů, dnes je řečník vyvolený."
                                            }
                                        ]
                                    }
                                ]
