                                        "entry_id": "fea8ea0d-6712-3884-b370-72453dcf9790",
                                        "glosses": [
                                            "In a ceremonious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c16d9f4-c152-45a5-818e-68441b0b349d",
                                                "sense_id": "48307133-ac91-3319-a299-ca8f0942c74a",
                                                "text": "After a simply marvelous, entertaining two and a half hour meal, they reclaimed their shoes and ceremoniously bid their sayonaras to the Japanese girls."
                                            }
