                "senses": [
                    {
                        "sense_id": "3f8205a5-fcb3-3e2a-a3a7-036ec0336e45",
                        "entry_id": "f202d092-aa44-3f50-a0d9-fa4b1172b6a9",
                        "glosses": [
                            "Véhicule ou remorque pour transporter le bétail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e300eb09-0d63-4fdf-929b-613f2aa3dfcc",
                                "sense_id": "3f8205a5-fcb3-3e2a-a3a7-036ec0336e45",
                                "text": "Fernand Raynaud, parlons-en : […]. Une bétaillère qui avançait trop lentement abrégea son voyage terrestre en projetant sa Rolls contre le mur du cimetière auvergnat du Cheix-sur-Morge. On congédierait un scénariste imaginant une mort pareille."
                            },
                            {
                                "example_id": "2a113044-f2d1-469b-8b89-226ca5ebdde2",
                                "sense_id": "3f8205a5-fcb3-3e2a-a3a7-036ec0336e45",
                                "text": "La veille de mon départ Momo me propose de prendre sa deudeuche pour le retour, moi je prendrai la bétaillère pour rapatrier quelques chevaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d929dc46-9d85-3539-828c-bc90d9f69e83",
                        "entry_id": "f202d092-aa44-3f50-a0d9-fa4b1172b6a9",
                        "glosses": [
                            "Véhicule pour transporter des personnes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fc0b317e-f086-4e34-b614-b7fbf24fb2f7",
                                "sense_id": "d929dc46-9d85-3539-828c-bc90d9f69e83",
                                "text": "La Renault Espace est surnommée la « bétaillère à cathos »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9248b80-cde1-4c80-95c7-938a175d364b",
                        "source_entry_id": "f202d092-aa44-3f50-a0d9-fa4b1172b6a9",
                        "target_lang_word": "Viehwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viehwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba46b5f-d1b4-3f38-a0ff-609ded8f8bd2",
                                        "entry_id": "c93d2ab6-db76-3f57-88d1-1e8b52ff139a",
                                        "glosses": [
                                            "ein Schienenfahrzeug ohne eigenen Antrieb zum Transport von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f1131a-b4ea-4d18-bf9c-b6966a903751",
                                                "sense_id": "5ba46b5f-d1b4-3f38-a0ff-609ded8f8bd2",
                                                "text": "„Sie haben uns in geschlossene Viehwagen umgeladen.“"
                                            },
                                            {
                                                "example_id": "bbf449f9-7cbf-42e3-99dd-1269eb23191a",
                                                "sense_id": "5ba46b5f-d1b4-3f38-a0ff-609ded8f8bd2",
                                                "text": "„Man sperrte sie in einen Viehwagen, der auf dem Gleis vergessen worden war, und brachte sie mir dann einzeln ins Büro des Bahnhofsvorstehers.“"
                                            },
                                            {
                                                "example_id": "5f753725-e9fe-42ae-b125-0259e7eaa64d",
                                                "sense_id": "5ba46b5f-d1b4-3f38-a0ff-609ded8f8bd2",
                                                "text": "„Hirsch war außer sich darüber, daß die Juden von den Deutschen gefangen wurden wie Kaninchen und daß sie sich zu so vielen Tausenden ohne Widerstand in die überfüllten Viehwagen stopfen ließen, die zu den Todeslagern fuhren.“"
                                            },
                                            {
                                                "example_id": "98100b6c-95f4-4980-9875-5de6ef6116d7",
                                                "sense_id": "5ba46b5f-d1b4-3f38-a0ff-609ded8f8bd2",
                                                "text": "„In Viehwagen wurden die Flüchtlinge nun dreihundert Kilometer weiter in den Westen transferiert, ins schleswig-holsteinische Büchen, nahe Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
