                "senses": [
                    {
                        "sense_id": "1ab4eb43-ed09-313f-84c2-f4e876625797",
                        "entry_id": "44056109-3601-3096-a786-847642408907",
                        "glosses": [
                            "A grandmother."
                        ],
                        "tags": [
                            "in Jewish contexts"
                        ],
                        "examples": [
                            {
                                "example_id": "4b1d6993-5509-49bc-9add-c45d435e77da",
                                "sense_id": "1ab4eb43-ed09-313f-84c2-f4e876625797",
                                "text": "The Bube explained the situation in voluble Yiddish, and made Esther wince again under the impassioned invective on her clumsiness. […] If the family died of starvation, their blood would be upon her grand-daughter's head."
                            },
                            {
                                "example_id": "ae46729f-448f-4253-bbc2-59e524bd8ec4",
                                "sense_id": "1ab4eb43-ed09-313f-84c2-f4e876625797",
                                "text": "I never met my bubbe, my grandma, the source of all my mother's Yiddish proverbs, […]"
                            },
                            {
                                "example_id": "a2e3af92-a0dc-4d1d-affc-a9ec22a02b2e",
                                "sense_id": "1ab4eb43-ed09-313f-84c2-f4e876625797",
                                "text": "I dedicate this book to my late grandparents, Morris and Bala Baellow. My bubbe’s inability to write in English turned out to be a blessing: she pressed me into service as her scribe at an early age."
                            },
                            {
                                "example_id": "e6b084c4-a24d-479a-ab0d-3f8a3f9ab05b",
                                "sense_id": "1ab4eb43-ed09-313f-84c2-f4e876625797",
                                "text": "Once, when I poked my stick in a bed of brown leaves, I found a shimmery snakeskin. When I showed my bubbe, she said I had found a memory of the snake, and that memories were precious."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e56d843-c7df-31b4-abf4-7fab4bc5057a",
                        "entry_id": "44056109-3601-3096-a786-847642408907",
                        "glosses": [
                            "An elderly woman."
                        ],
                        "tags": [
                            "in Jewish contexts"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ae877f-f2f2-4f14-b03d-92d4a68264ee",
                                "sense_id": "0e56d843-c7df-31b4-abf4-7fab4bc5057a",
                                "text": "\"I wanna more chocolate, bubbe,\" said Karl. […] \"You heard the bubbe,\" said Josie. \"There isn't any. You act up and cry and I'll give you the back of my hand.\""
                            }
                        ]
                    }
