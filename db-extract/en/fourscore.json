                                        "entry_id": "ff8cc83a-fb0b-3aa9-b9fb-55440918cc08",
                                        "glosses": [
                                            "\\\"80\\\", het getal tussen negenenzeventig en eenentachtig, acht maal tien",
                                            "om een hoeveelheid aan te geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d95cc7-fb43-43cc-a7fc-c0f6148f4b5b",
                                                "sense_id": "b188866a-2e57-3a02-b9fe-8979cdd3ecf5",
                                                "text": "De totale kosten bedragen tachtig euro en zevenendertig cent."
                                            },
                                            {
                                                "example_id": "cfb71d25-369c-4587-adf9-a65972baea9b",
                                                "sense_id": "b188866a-2e57-3a02-b9fe-8979cdd3ecf5",
                                                "text": "Studenten en promovendi met veel kennis van onder meer kritieke grondstoffen zijn hard nodig voor de energietransitie, zegt men ook buiten de muren van de VU. De ongeveer tachtig bachelor- en masterstudenten die de studie in Amsterdam jaarlijks trekt, zijn harder nodig dan ooit, klinkt het. Ook bijvoorbeeld voor de opslag van CO2 onder de grond en kustbescherming is hun kennis nodig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f3416e-a77d-3d61-80fd-0a18a275abdd",
                                        "entry_id": "ff8cc83a-fb0b-3aa9-b9fb-55440918cc08",
                                        "glosses": [
                                            "\\\"80\\\", het getal tussen negenenzeventig en eenentachtig, acht maal tien",
                                            "om een plaats in een volgorde aan te geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3ea890-026b-4398-9d52-9b79ca207d49",
                                                "sense_id": "99f3416e-a77d-3d61-80fd-0a18a275abdd",
                                                "text": "Het juiste antwoord op opgave tachtig is \"42\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tachtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f564b9b-4915-3b00-b314-0631631a7284",
                                        "entry_id": "3b957082-0904-37a1-bbfa-9f35d2d11c5e",
                                        "glosses": [
                                            "dat wat in een (rang)ordening met 80 is aangeduid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031e497c-a76d-4620-894d-96bdfdda7234",
                                                "sense_id": "8f564b9b-4915-3b00-b314-0631631a7284",
                                                "text": "Het is weer de tachtig die het niet doet, kunnen we die niet simpel vervangen?"
                                            },
                                            {
                                                "example_id": "2965c78e-62eb-40ad-bb3c-94f692b214e4",
                                                "sense_id": "8f564b9b-4915-3b00-b314-0631631a7284",
                                                "text": "Haar eenentachtigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tachtig eenmaal voorbij was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c8cd567-7187-3ba4-ab9b-5bc8718dd64b",
                                        "entry_id": "3b957082-0904-37a1-bbfa-9f35d2d11c5e",
                                        "glosses": [
                                            "groep van 80 eenheden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3818fc5e-b49b-43b1-8463-328c18393d09",
                                                "sense_id": "4c8cd567-7187-3ba4-ab9b-5bc8718dd64b",
                                                "text": "De tachtig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
