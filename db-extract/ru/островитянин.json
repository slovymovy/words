                ],
                "senses": [
                    {
                        "sense_id": "dd805a37-f263-398f-8b38-9a64fc676d11",
                        "entry_id": "8a3371c4-5975-3034-b5a0-e8e1670e8bea",
                        "glosses": [
                            "житель острова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d8cb8d-9463-4766-af0a-ff7b27d19ccd",
                                "sense_id": "dd805a37-f263-398f-8b38-9a64fc676d11",
                                "text": ".. островитяне приносили им [морякам] кокосовые орехи, плоды хлебного дерева .."
                            },
                            {
                                "example_id": "f04da36a-98eb-450a-ac8e-45d0f943866e",
                                "sense_id": "dd805a37-f263-398f-8b38-9a64fc676d11",
                                "text": "Красивый островок с густою растительностью, толпа туземцев у берега, разукрашенных цветами, листьями, .. всё это живо напоминало мне описание островитян Тихого океана первыми мореплавателями."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4215eeeb-81d4-4a9b-93af-d9b83c47ed51",
                        "source_entry_id": "8a3371c4-5975-3034-b5a0-e8e1670e8bea",
                        "source_sense_id": "dd805a37-f263-398f-8b38-9a64fc676d11",
                        "target_lang_word": "islander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "islander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                        "entry_id": "2b4efafc-d137-3124-b280-d821747a1309",
                                        "glosses": [
                                            "A person who lives on an island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9785196-ee02-442f-b849-ad9671479944",
                                                "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                                "text": "Susan happily introducing speaker Steve Smith, Channel Eleven’s newzanchor, ya’know, and an islandophile from wayyy back – and as of this writing, a newly retired islander and fisherman."
                                            },
                                            {
                                                "example_id": "096276e6-3f6b-4ef8-b272-71cf9a2476b2",
                                                "sense_id": "c42af485-a8f4-3c3d-ab19-a5bdaac5a215",
                                                "text": "The Foreign and Commonwealth Office (FCO) has categorically ruled out any new negotiations saying the future of the Falklands can only be decided by the islanders themselves in accordance with the UN principle of self-determination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2663b19-9b3e-47a7-8330-2ac515fbaba5",
                        "source_entry_id": "8a3371c4-5975-3034-b5a0-e8e1670e8bea",
                        "source_sense_id": "dd805a37-f263-398f-8b38-9a64fc676d11",
                        "target_lang_word": "Insulaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insulaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d139da80-23cd-3c7b-a2e6-5276841c1c61",
                                        "entry_id": "0cb5c6a6-153b-354b-b28b-5bbf2954da3a",
                                        "glosses": [
                                            "jemand, der auf einer Insel wohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f61d670-9252-4bd4-95c2-41fa19e6f818",
                                                "sense_id": "d139da80-23cd-3c7b-a2e6-5276841c1c61",
                                                "text": "Die Insulaner sorgen sich vor einer Sturmflut."
                                            },
                                            {
                                                "example_id": "e7aab903-abca-49d4-87fb-16e98b35a296",
                                                "sense_id": "d139da80-23cd-3c7b-a2e6-5276841c1c61",
                                                "text": "„Insulaner haben mehr Zeit als Nicht-Insulaner, das ist klar.“"
                                            },
                                            {
                                                "example_id": "af6c119c-f914-47a5-a0ff-d5efa1a25c4a",
                                                "sense_id": "d139da80-23cd-3c7b-a2e6-5276841c1c61",
                                                "text": "„Wir schlichen uns auf die Lichtung und kamen neben einem Insulaner mittleren Alters namens Richard zu stehen.“"
                                            },
                                            {
                                                "example_id": "e676ebd9-9bbf-4cec-920c-b37383cc3159",
                                                "sense_id": "d139da80-23cd-3c7b-a2e6-5276841c1c61",
                                                "text": "„Die Insulaner schienen mit solchen Geschäften vertraut zu sein; nach kaum einer Stunde lag das breite Boot wieder versteckt neben den übrigen Kähnen, während die Pferde in den Ställen untergebracht waren und dort von einem jungen Mestizen versorgt und mit Nahrung versehen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1cc3b96-470b-3d4f-a736-7c50aa7a2c9a",
                                        "entry_id": "0cb5c6a6-153b-354b-b28b-5bbf2954da3a",
                                        "glosses": [
                                            "Bezeichnung der (West-)Berliner vor der Wiedervereinigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3cc9ab-850c-4ef7-a85a-ce50bbb0b3c2",
                                                "sense_id": "a1cc3b96-470b-3d4f-a736-7c50aa7a2c9a",
                                                "text": "„Ich würde nicht besonders gern ein Insulaner sein, aber die Berliner sind sehr gerne Insulaner und sogar stolz darauf, es zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
