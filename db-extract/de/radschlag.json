                                    },
                                    {
                                        "sense_id": "d758a9ef-fabb-3165-a0d8-8c01cee74be0",
                                        "entry_id": "2d491f5a-bd0c-336d-9d8f-bee64a825cae",
                                        "glosses": [
                                            "To flip end over end: normally said of a crashing vehicle or aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01764171-5826-415c-a212-19dee2377bc7",
                                                "sense_id": "d758a9ef-fabb-3165-a0d8-8c01cee74be0",
                                                "text": "The race car hit a bump and cartwheeled over the finish line."
                                            }
                                        ]
