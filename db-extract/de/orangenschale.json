                            "singular"
                        ],
                        "form": "die Orangenschale"
                    },
                    {
                        "form_id": "500746d2-b3ef-410c-abbc-0c46bbc399e4",
                        "entry_id": "fdca7abb-daf8-3eb3-b9fa-fdf82f58347f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Orangenschalen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "317f4c43-75ed-3f32-903b-6aad49770e84",
                        "entry_id": "fdca7abb-daf8-3eb3-b9fa-fdf82f58347f",
                        "glosses": [
                            "die Schale einer Orange"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67362b76-6bea-49de-8d4b-13cee663d035",
                                "sense_id": "317f4c43-75ed-3f32-903b-6aad49770e84",
                                "text": "„Auf dem Teller, den sie auf den Knien hielt, häufte sich ein Berg Orangenschalen.“"
                            },
                            {
                                "example_id": "a435c678-deeb-45f9-9af6-df272402cf1c",
                                "sense_id": "317f4c43-75ed-3f32-903b-6aad49770e84",
                                "text": "Orangenschalen sollten im Biomüll entsorgt werden."
                            },
                            {
                                "example_id": "74a1e5da-a83f-4b69-b05d-9c0e319d6779",
                                "sense_id": "317f4c43-75ed-3f32-903b-6aad49770e84",
                                "text": "„Die Nachrichten – Mikrofilme, nicht größer als ein Stecknadelkopf – sollten in Geldstücken, alten Papiertaschentüchern oder Orangenschalen verborgen werden.“"
                            },
                            {
                                "example_id": "dd733710-f33c-46ad-a219-e6c3daef4dc3",
                                "sense_id": "317f4c43-75ed-3f32-903b-6aad49770e84",
                                "text": "„Wir haben aber nicht nur Rührei und ein Spiegelei mit Speck bekommen, sondern auch noch frischen Orangensaft und dunkles Knäckebrot und eine Marmelade mit Orangenschalen darin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
