                                "zh": "我们晚餐时点了一瓶起泡<w>桃红葡萄酒</w>。"
                            }
                        },
                        {
                            "text": "A chilled glass of <w>rose</w> is refreshing in the summer.",
                            "target_lang_translations": {
                                "ru": "Бокал охлажденного <w>розе</w> освежает летом.",
                                "zh": "夏天喝一杯冰镇<w>桃红葡萄酒</w>非常清爽。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rosé"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт розового вина; альтернативное написание rosé.",
                        "zh": "一种粉红色的葡萄酒。"
                    },
                    "translations": {
