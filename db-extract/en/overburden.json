                        "form_id": "ef4b7da9-f2d0-4a62-8e2c-76a84df947e4",
                        "entry_id": "490db27f-0421-304e-b16b-43676f5c7252",
                        "tags": [
                            "plural"
                        ],
                        "form": "overburdens"
