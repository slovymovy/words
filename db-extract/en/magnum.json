                    }
                ],
                "senses": [
                    {
                        "sense_id": "523a6269-d3ce-35f8-82cb-912170246b5b",
                        "entry_id": "fa67763b-403c-3115-a0bf-922451f3aff6",
                        "glosses": [
                            "A bottle containing 1.5 liters of fluid, double the volume of a standard wine bottle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042d9b91-2958-4e7b-a7fa-0f79b11aabe7",
                                "sense_id": "523a6269-d3ce-35f8-82cb-912170246b5b",
                                "text": "So please don’t ask me when / There may be wine and roses / And magnums of champagne"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a4b2464-289d-3a4d-b77a-f2fe63079ee9",
                        "entry_id": "fa67763b-403c-3115-a0bf-922451f3aff6",
                        "glosses": [
                            "A powerful firearm cartridge, often derived from a shorter, less powerful cartridge calibre that uses the same bullet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0f4f408c-d670-3864-bbec-bf8c4a116167",
                        "entry_id": "fa67763b-403c-3115-a0bf-922451f3aff6",
                        "glosses": [
                            "A handgun that fires a cartridge of this calibre; chiefly a revolver, but rarely an autoloader firing an unusually powerful calibre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "94c2397e-5425-48bf-b140-5493f7c09692",
                                "sense_id": "0f4f408c-d670-3864-bbec-bf8c4a116167",
                                "text": "I know what you're thinking. \"Did he fire six shots or only five?\" Well, to tell you the truth, in all this excitement, I've kinda lost track myself. But, being as this is a .44 magnum, the most powerful handgun in the world, and would blow your head clean off, you've got to ask yourself one question: \"Do I feel lucky?\" Well, do ya, punk?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4d34077-5afe-4810-ab33-36eb2ec7b513",
                        "source_entry_id": "fa67763b-403c-3115-a0bf-922451f3aff6",
                        "source_sense_description": "bottle",
                        "target_lang_word": "magnum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d6406b-4c3f-32ec-bbf4-6bd7413932f4",
                                        "entry_id": "1f68e371-1e3a-3df5-8242-a4b346e90f8f",
                                        "glosses": [
                                            "Se dit de munitions dont la charge de poudre est élevée et dont la puissance est supérieure à celles de cartouches normales."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86798a97-cd7e-425b-8b5d-091728afb88b",
                                                "sense_id": "c0d6406b-4c3f-32ec-bbf4-6bd7413932f4",
                                                "text": "Je n’utilise jamais de munitions magnums, c’est trop puissant pour moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e50928c-2f37-3257-89da-e90b7955ca5e",
                                        "entry_id": "1f68e371-1e3a-3df5-8242-a4b346e90f8f",
                                        "glosses": [
                                            "Se dit d’une arme à feu (pistolet, fusil) conçue pour tirer ces munitions."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "note": "S'écrit parfois avec une majuscule initiale",
                                        "examples": [
                                            {
                                                "example_id": "f35ea795-ee79-4a89-b6d0-a1570a54b950",
                                                "sense_id": "0e50928c-2f37-3257-89da-e90b7955ca5e",
                                                "text": "Il m’a proposé un pistolet magnum."
                                            },
                                            {
                                                "example_id": "1f67f26d-2869-40ae-8030-ea71e7185e25",
                                                "sense_id": "0e50928c-2f37-3257-89da-e90b7955ca5e",
                                                "text": "C'est du 357 Magnum, létal sans problème à dix mètres, et c'est super-simple à utiliser, je t'explique en cinq minutes."
                                            },
                                            {
                                                "example_id": "459eb214-25da-45b7-98df-0c21f8a3f6d0",
                                                "sense_id": "0e50928c-2f37-3257-89da-e90b7955ca5e",
                                                "text": "Une balle de 257 Weatherby Magnum l’attrapa au passage et le relâcha trente-cinq mètres plus bas où, derrière son rideau, figée sur sa chaise de paralytique, une femme momifiée avait suivi son vol plané sans que ses paupières tressaillissent…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "magnum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3ad4f09-4af6-36d2-8b75-1115b13b675b",
                                        "entry_id": "0b87f5d1-263f-3aa5-b64f-e265a772dd2c",
                                        "glosses": [
                                            "Munition magnum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba18ef7-c2a8-4a6d-b9f0-a5075f77f4f9",
                                                "sense_id": "f3ad4f09-4af6-36d2-8b75-1115b13b675b",
                                                "text": "Pour mon arme, j’utilise des magnums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8fa9aa-b219-3d1e-b360-3de9b835fcc3",
                                        "entry_id": "0b87f5d1-263f-3aa5-b64f-e265a772dd2c",
                                        "glosses": [
                                            "Arme tirant ce type de munitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019b896f-9c6e-49b6-9b4d-a059e431ea9c",
                                                "sense_id": "ba8fa9aa-b219-3d1e-b360-3de9b835fcc3",
                                                "text": "L’homme tira un magnum de sa poche ; ses intentions étaient claires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f8fd080-127a-382b-b424-f200146e2951",
                                        "entry_id": "0b87f5d1-263f-3aa5-b64f-e265a772dd2c",
                                        "glosses": [
                                            "Grosse bouteille de champagne d’environ un litre et demi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4e9687-b70d-4bca-98f0-a0cd2eb64275",
                                                "sense_id": "2f8fd080-127a-382b-b424-f200146e2951",
                                                "text": "Tout content de ses achats, il s’arrêta encore chez un caviste où il choisit un magnum de champagne Roederer qui serait sa participation au réveillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f93bab83-e7d8-35fc-a19c-0317ff23593c",
                                        "entry_id": "0b87f5d1-263f-3aa5-b64f-e265a772dd2c",
                                        "glosses": [
                                            "Grosse bouteille dont la contenance est en général le double d’une bouteille normale, soit 1,5 à 2 litres."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "760d8041-5572-444b-8e8a-0fadf1f58f13",
                                                "sense_id": "f93bab83-e7d8-35fc-a19c-0317ff23593c",
                                                "text": "Une tristesse légère, qui prenait plaisir à se constater, l’incitait à allumer les bougies, à déboucher le magnum de champagne, gros jouet burlesque promis à l’étonnement des enfants."
                                            },
                                            {
                                                "example_id": "6066754b-3c41-447d-aa11-fdda3f1e185d",
                                                "sense_id": "f93bab83-e7d8-35fc-a19c-0317ff23593c",
                                                "text": "Il ouvrit le sommier, en ressortit un magnum de blanquette de Die. Le bouchon vola. Il but au goulot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb2b3155-49c7-3228-937f-80314dca3325",
                                        "entry_id": "0b87f5d1-263f-3aa5-b64f-e265a772dd2c",
                                        "glosses": [
                                            "Glace (esquimau) de la marque Magnum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5547059f-0124-4256-92e9-db7605945071",
                                                "sense_id": "cb2b3155-49c7-3228-937f-80314dca3325",
                                                "text": "Narcisse proposa la dégustation d’un esquimau à la vanille, mais le cœur n’y était pas pour les autres, et il se gougnotta son magnum tout seul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "magnum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3f0550-8518-3e22-939f-2c7364fe2083",
                                        "entry_id": "80dab1f8-a70b-31d3-a615-d28802f03b4d",
                                        "glosses": [
                                            "Sorte de pomme de terre."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f778133b-58c1-450e-a476-32106e1d5e92",
                                                "sense_id": "2f3f0550-8518-3e22-939f-2c7364fe2083",
                                                "text": "Elle mêle les lardons frits et la graisse aux magnums qu'elle écrase avec une spatule, qu'elle spotche, comme elle dit, et chacun en comble son assiette […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
