                        "sense_id": "43fd21ef-9c48-3653-9ed8-681cc14a3716",
                        "entry_id": "cf7059b0-b6a2-34ba-a801-ab8e02f2795c",
                        "glosses": [
                            "elektriciteitskabel van de bovenleiding voor een trein of tram"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57aafe32-6df3-4863-b866-3a3865986350",
                                "sense_id": "43fd21ef-9c48-3653-9ed8-681cc14a3716",
                                "text": "Het rangeerterrein betreft een gebied van zeventien voetbalvelden. Daar komt 35 kilometer aan spoorrails terug. Dan praat je over zestig wissels, 40.000 dwarsliggers en 65 kilometer aan rijdraad voor de bovenleiding."
                            },
                            {
                                "example_id": "e82ca4d2-d230-403d-9aa1-c72acfdad623",
                                "sense_id": "43fd21ef-9c48-3653-9ed8-681cc14a3716",
                                "text": "Tijdens de buitendienststelling vervangt Prorail wissels, spoorstaven en dwarsliggers en vernieuwen ze de wisselverwarming en de rijdraad, de kabel van de bovenleiding."
                            },
                            {
                                "example_id": "8764b783-9540-4631-bb12-1b50be1002d0",
                                "sense_id": "43fd21ef-9c48-3653-9ed8-681cc14a3716",
                                "text": "Er was zaterdagochtend heel wat hinder tussen Oostende en Knokke. Door aanvriezende mist ondervond de kusttram problemen. Er werd een tijdlang gepoogd om met koperen slepers de rijdraad vorstvrij te maken, maar uiteindelijk besloot de vervoersmaatschappij om vervangbussen in te leggen."
                            }
                        ]
                    }
