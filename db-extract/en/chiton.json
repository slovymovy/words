                                    {
                                        "sense_id": "3fd451bc-fc38-3f1e-a51d-b34f4379b0c4",
                                        "entry_id": "236f0608-7a5f-3031-9b5f-ee5b74784983",
                                        "glosses": [
                                            "benaming voor dieren uit de klasse Polyplacophora, platte ovale zeedieren met een schelp die uit 8 segmenten bestaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5314c7d-c8cd-4bbd-b391-6184adb7ff79",
                                                "sense_id": "3fd451bc-fc38-3f1e-a51d-b34f4379b0c4",
                                                "text": "De keverslak bleek zowel onder als boven water even goed te zien, wat van pas komt aangezien het dier soms droogvalt in de branding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04857e10-745e-41ac-97c0-0fa51b99677d",
                        "source_entry_id": "6e6c00b7-a6e2-3b64-afc3-86c49d67b4fa",
                        "source_sense_id": "c31ba5df-201c-3c09-a954-631b72b0f897",
                        "source_sense_description": "mollusc",
                        "target_lang_word": "chiton",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiton",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "19d039ab-46f4-3f20-acae-238c5c30548b",
                                        "entry_id": "444acc6e-b07e-338d-93c2-21cd9ede91ec",
                                        "glosses": [
                                            "gewaad van wol zoals dat in de oudheid door direct op het lichaam werd gedragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360fb98e-bd53-485e-9d1f-c03bfb54925b",
                                                "sense_id": "19d039ab-46f4-3f20-acae-238c5c30548b",
                                                "text": "Hij draagt een kort harnas waar onderuit een chiton komt die van dezelfde stof gemaakt lijkt als het doorluchtige kleed van Circe op Waterhouse’s schilderij, daaronder is hij naakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db593bfd-0e42-34ea-85b8-a3b05c181237",
                                        "entry_id": "444acc6e-b07e-338d-93c2-21cd9ede91ec",
                                        "glosses": [
                                            "benaming voor dieren uit de klasse Polyplacophora, platte ovale zeedieren met een schelp die uit 8 segmenten bestaat"
                                        ],
                                        "tags": [
                                            "keverslakken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd240e9-3fe4-4833-b1d5-32f505ce5a11",
                                                "sense_id": "db593bfd-0e42-34ea-85b8-a3b05c181237",
                                                "text": "Men geeft er de laatste tijd de voorkeur aan om de chiton zo te prepareren dat hij flexibel blijft, hiertoe wordt de volgende methode gehanteerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
