                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3f55f51-1965-4baa-9cf7-14a19f7733b5",
                                "sense_id": "bf498612-b66e-3331-a808-605cf3e07554",
                                "text": "По лицу Давыдова побежала, тепля глаза, счастливая улыбка."
                            },
                            {
                                "example_id": "bcad5c40-4f65-419e-b50f-46e585bb3e84",
                                "sense_id": "bf498612-b66e-3331-a808-605cf3e07554",
                                "text": "Анна пристально наблюдала за мужем, и радость прокрадывалась в душу, теплила ее."
                            }
                        ]
                    }
