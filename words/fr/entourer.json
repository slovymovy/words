    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a57b3e3-6ffe-30b4-8d61-dfae8f4fb5dd",
                    "sense_definition": "Mettre ou disposer autour ; être placé tout autour de quelqu'un ou de quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une haute clôture en bois <w>entoure</w> le jardin de cette maison de campagne."
                        },
                        {
                            "text": "Les enfants <w>entourent</w> le musicien pour écouter attentivement son histoire."
                        }
                    ],
                    "synonyms": [
                        "encercler",
                        "ceindre"
                    ],
                    "common_phrases": [
                        "entourer d'un mur",
                        "entourer la ville"
                    ]
                },
                {
                    "sense_id": "71444713-a8d0-3c33-b026-ed0c007651ca",
                    "sense_definition": "Constituer l'environnement ou le milieu de quelqu'un ; prodiguer une attention soutenue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "environnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques cherchent à mieux comprendre le monde qui nous <w>entoure</w>."
                        },
                        {
                            "text": "L'équipe médicale a su <w>entourer</w> de soins attentifs le jeune patient hospitalisé."
                        }
                    ],
                    "common_phrases": [
                        "monde qui nous entoure",
                        "entourer de soins"
                    ]
                },
                {
                    "sense_id": "65a68b3b-d26c-39da-990d-a81f3e236660",
                    "sense_definition": "Former le cercle habituel, la compagnie ou les proches de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a beaucoup de chance d'être bien <w>entourée</w> par ses amis et sa famille."
                        },
                        {
                            "text": "Ce dirigeant autoritaire est constamment <w>entouré</w> de flatteurs qui lui cachent la vérité."
                        }
                    ],
                    "common_phrases": [
                        "être bien entouré",
                        "être mal entouré"
                    ]
                },
                {
                    "sense_id": "fd95c23b-4420-3100-949d-91933a90f6f9",
                    "sense_definition": "Réunir auprès de soi des collaborateurs, des conseillers ou des proches de confiance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour mener à bien ce projet ambitieux, la responsable s'<w>entoure</w> d'experts renommés."
                        },
                        {
                            "text": "Le nouveau président a voulu s'<w>entourer</w> des spécialistes les plus compétents du domaine."
                        }
                    ],
                    "common_phrases": [
                        "s'entourer des meilleurs",
                        "s'entourer d'experts"
                    ]
                },
                {
                    "sense_id": "a1696935-90c8-3d42-bb80-c82f06d9a878",
                    "sense_definition": "Prendre ou rassembler auprès de soi des garanties, des avis ou des précautions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prévoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de signer cet accord délicat, l'avocat s'<w>entoure</w> de toutes les garanties légales."
                        },
                        {
                            "text": "Le diplomate s'est <w>entouré</w> de précautions infinies avant de faire sa déclaration officielle."
                        }
                    ],
                    "common_phrases": [
                        "s'entourer de précautions",
                        "s'entourer de garanties"
                    ]
                }
            ]
        }
    ]
}