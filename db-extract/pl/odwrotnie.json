                                                "sense_id": "0f02ca84-4fb7-340e-8666-cd27df5bf5ab",
                                                "text": "I’m going to give her a diamond necklace for her birthday, and vice versa, she’s going to get me a Premium Pass for FIFA 24 for mine."
                                            }
