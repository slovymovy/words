                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12eeb99b-ed53-3670-876a-0d20d58b2f5d",
                                        "entry_id": "7d11b825-3c9c-3868-b7d8-9a85dd59db44",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de fouiller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98421295-986f-31cb-a766-48e5c7bf0c72",
                                        "entry_id": "7d11b825-3c9c-3868-b7d8-9a85dd59db44",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de fouiller."
                                        ],
