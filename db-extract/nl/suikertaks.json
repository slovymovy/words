                        "glosses": [
                            "belasting op voedingsproducten die obesitas veroorzaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17738eec-1ee6-4fcd-9598-bb04e0033629",
                                "sense_id": "2cc447ec-8fa9-34e1-8890-62cef821b1bd",
                                "text": "Ongeveer twee derde van de Britse bevolking heeft last van overgewicht, een aandeel dat de afgelopen jaren flink is toegenomen. Ongeveer een op de drie kinderen die naar de middelbare school gaan is te zwaar. Groot-Brittannië voerde in 2018 al een suikertaks in op frisdrank."
                            },
                            {
                                "example_id": "edcf195f-e537-4396-b2ab-d12ef92bbd6f",
                                "sense_id": "2cc447ec-8fa9-34e1-8890-62cef821b1bd",
                                "text": "Het adviesorgaan wil dat er een verbod komt op reclame voor ongezond voedsel. De raad stelt verder voor om de btw op gezond eten zoals groente en fruit te verlagen en een suikertaks in te voeren. Gemeenten moeten de bevoegdheid krijgen om fastfoodrestaurants en snackbars te weren om een gezondere leefomgeving te bevorderen."
                            }
                        ]
                    }
