                    {
                        "sense_id": "33172f76-1a9c-3ef2-a0a2-2867bc42f2ae",
                        "entry_id": "588be988-d770-3ecc-a924-762df279ca37",
                        "glosses": [
                            "Gerät zum Aufspüren von Metallen in Stoffen wie zum Beispiel im Erdreich oder in bzw. an Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dec53de-93b8-49cf-b94d-319685ff6337",
                                "sense_id": "33172f76-1a9c-3ef2-a0a2-2867bc42f2ae",
                                "text": "Metalldetektoren werden auf Flughäfen verwendet."
                            },
                            {
                                "example_id": "11b8f1b6-f0e0-4e75-a2fa-b6998bac57b8",
                                "sense_id": "33172f76-1a9c-3ef2-a0a2-2867bc42f2ae",
                                "text": "„Kurzzeitig erwog er, Eisenschrott zu verstreuen, damit die Räuber mit ihren Metalldetektoren vor lauter Signalen nichts mehr finden konnten.“"
                            },
                            {
                                "example_id": "74abaf8c-bffd-4077-9577-1fe7749fc8d1",
                                "sense_id": "33172f76-1a9c-3ef2-a0a2-2867bc42f2ae",
                                "text": "„Du nimmst einen Metalldetektor mit an den Strand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
