                "senses": [
                    {
                        "sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                        "entry_id": "bc466954-967c-3d17-a485-a4052635e373",
                        "glosses": [
                            "eine weibliche Person, die Filmaufnahmen oder Tonaufzeichnungen schneidet und in Zusammenarbeit mit dem Regisseur nach künstlerischen Gesichtspunkten zu einem Gesamtwerk zusammensetzt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "f6c96281-9a56-40ec-8e76-0574cf28e9bf",
                                "sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                                "text": "Juliane Lorenz war seit Jahren seine Cutterin, seine Lebensgefährtin, versuchte Ordnung und Ruhe in dieses Leben zu bringen."
                            },
                            {
                                "example_id": "49a56cdb-c775-4e0b-87d5-95beb08fbc0b",
                                "sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                                "text": "Thelma Schoonmaker ist die berühmteste Cutterin der Welt, hat drei Oscars gewonnen und arbeitet seit vier Jahrzehnten mit Martin Scorsese zusammen."
                            },
                            {
                                "example_id": "ba76cf55-81d2-4b8b-a6dd-bc8955ea5ae3",
                                "sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                                "text": "Ein noch breiteres Berufespektrum bietet der Bereich Produktion. Dort sind alle jene Tätigkeiten vom Kameramann bis zur Cutterin angesiedelt, die Ideen der Redaktionen mit Hilfe der Technik erst in Fernsehen umsetzen."
                            },
                            {
                                "example_id": "1bd54a97-88fc-40aa-ac6a-fc18c2e10e1a",
                                "sense_id": "bdbcf6f2-56cb-348a-bf4e-e7ec25d6a37c",
                                "text": "„Das Schiff war ein Wrack, sie nahm Kredite auf, kündigte ihren Job als Cutterin und arbeitete sich tot, um das Schiff für ihn vorzubereiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
