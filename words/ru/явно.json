    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "462ddba4-b036-32b4-a09f-40e51ce77de9",
                    "sense_definition": "Так, что это совершенно очевидно, заметно или понятно для всех; несомненно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты <явно> что-то скрываешь от нас.",
                            "target_lang_translations": {
                                "en": "You are <w>obviously</w> hiding something from us."
                            }
                        },
                        {
                            "text": "Это решение было <явно> ошибочным с самого начала.",
                            "target_lang_translations": {
                                "en": "This decision was <w>clearly</w> wrong from the very beginning."
                            }
                        }
                    ],
                    "synonyms": [
                        "очевидно",
                        "заметно",
                        "несомненно",
                        "ясно"
                    ],
                    "antonyms": [
                        "неочевидно",
                        "сомнительно"
                    ],
                    "common_phrases": [
                        "явно не",
                        "явно выраженный",
                        "стало явно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is completely obvious, noticeable, or understandable to everyone; undoubtedly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obviously",
                                "target_lang_sense_clarification": "used to state that something is easily perceived or understood"
                            },
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "used to indicate that something is beyond doubt"
                            },
                            {
                                "target_lang_word": "evidently",
                                "target_lang_sense_clarification": "used when something is apparent from the evidence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db3a395f-861f-3954-9c93-baec31d6b627",
                    "sense_definition": "Не скрываясь, не тайно; открыто и публично.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Соседи <явно> враждовали и не здоровались при встрече.",
                            "target_lang_translations": {
                                "en": "The neighbors were <w>openly</w> hostile and did not greet each other when they met."
                            }
                        },
                        {
                            "text": "Он <явно> пренебрегал правилами безопасности.",
                            "target_lang_translations": {
                                "en": "He was <w>openly</w> disregarding safety rules."
                            }
                        }
                    ],
                    "synonyms": [
                        "открыто",
                        "публично",
                        "гласно"
                    ],
                    "antonyms": [
                        "тайно",
                        "скрыто"
                    ],
                    "target_lang_definitions": {
                        "en": "Without hiding, not secretly; openly and publicly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "openly",
                                "target_lang_sense_clarification": "in a way that is not concealed or secret"
                            },
                            {
                                "target_lang_word": "explicitly",
                                "target_lang_sense_clarification": "in a direct and clear manner, leaving no room for doubt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "76673fcc-50a4-3b01-a6ae-da3e00b2a479",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>явный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его превосходство в этой игре было <явно>.",
                            "target_lang_translations": {
                                "en": "His superiority in this game was <w>evident</w>."
                            }
                        },
                        {
                            "text": "Всё тайное рано или поздно становится <явно>.",
                            "target_lang_translations": {
                                "en": "Everything secret sooner or later becomes <w>obvious</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "становится явно"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'evident' or 'obvious'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evident",
                                "target_lang_sense_clarification": "plain or obvious; clearly seen or understood"
                            },
                            {
                                "target_lang_word": "obvious",
                                "target_lang_sense_clarification": "easily perceived or understood; clear, self-evident, or apparent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}