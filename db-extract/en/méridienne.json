                        "examples": [
                            {
                                "example_id": "42871777-3958-4657-ad45-64ce1c4a6f10",
                                "sense_id": "2e36ed6a-faa1-3361-846d-dd59574baaf3",
                                "text": "Méridiennes have sold for up to $19,000 a pair, a bid posted at Morton’s. “Méridiennes such as that one are the rare pieces that bring top dollar,” says Phillip Alford, Morton’s nineteenth-century furniture expert."
                            },
                            {
                                "example_id": "2612ae20-066e-4e08-a262-3931b7e1c960",
                                "sense_id": "2e36ed6a-faa1-3361-846d-dd59574baaf3",
                                "text": "Silk velvet on the méridiennes is from Manuel Canovas; Clarence House fabric covers the sofa and front of fauteuils."
                            },
