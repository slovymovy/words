                        "glosses": [
                            "Donner aux institutions (structure économique, politiques, …) un caractère bolchevik."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4f299a-56b9-42a1-aef3-880d97fdd5ff",
                                "sense_id": "1a278b1d-04a9-33a5-bf68-e3c5823996fc",
                                "text": "Il fallait bolchéviser le Soviet."
                            },
                            {
                                "example_id": "1ff22e36-2c96-41eb-9a2a-a3a2d52d9b57",
                                "sense_id": "1a278b1d-04a9-33a5-bf68-e3c5823996fc",
                                "text": "Mais… mais…, monsieur Dupré, je n’ai pas envie qu’on bolchévise mon pays, qu’on nous retire nos enfants !"
                            }
