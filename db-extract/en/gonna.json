                    {
                        "sense_id": "bf80f15f-125e-39d2-b5ee-27b6fc42d993",
                        "entry_id": "73815a6d-9cef-3247-9df7-bca51a811318",
                        "glosses": [
                            "a modal used to express a future action that is being planned or prepared for in the present."
                        ],
                        "tags": [
                            "auxiliary",
                            "colloquial"
                        ],
                        "examples": [
                            {
