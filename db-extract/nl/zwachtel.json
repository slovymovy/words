                "senses": [
                    {
                        "sense_id": "49e802d5-c5d6-3f64-9eaa-4dd114362fbb",
                        "entry_id": "25ceee6b-addf-3d7d-ac22-f9acdbda93b2",
                        "glosses": [
                            "een lange, smalle strook dun textiel voor het verbinden van een wond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab88cb19-e593-4000-ba15-3920dc5bb59f",
                                "sense_id": "49e802d5-c5d6-3f64-9eaa-4dd114362fbb",
                                "text": "Ziekenhuizen hebben een overschot aan zwachtels."
                            },
                            {
                                "example_id": "2be6819e-8fba-4455-bead-272078444bc3",
                                "sense_id": "49e802d5-c5d6-3f64-9eaa-4dd114362fbb",
                                "text": "Daarna gingen we naar de tuin, waar we de lakens en zwachtels in een oud prieel hadden verborgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43b6113f-8b29-494c-994e-d4c53465979d",
                        "source_entry_id": "25ceee6b-addf-3d7d-ac22-f9acdbda93b2",
                        "source_sense_id": "49e802d5-c5d6-3f64-9eaa-4dd114362fbb",
                        "target_lang_word": "bandage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3385c199-32ad-35ed-800d-3a6be4f17018",
                                        "entry_id": "deb3e078-5da8-35cb-8097-8385ca3d1077",
                                        "glosses": [
                                            "A strip of gauze or similar material used to protect or support a wound or injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c3a2aa-f756-457e-ba49-21d40db84321",
                                                "sense_id": "3385c199-32ad-35ed-800d-3a6be4f17018",
                                                "text": "[…]he was deadly pale, and the blood-stained bandage round his head told that he had recently been wounded, and still more recently dressed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8c4e826-2b7d-3a7d-b3bc-4b4e1c45c76d",
                                        "entry_id": "deb3e078-5da8-35cb-8097-8385ca3d1077",
                                        "glosses": [
                                            "A strip of cloth bound round the head and eyes as a blindfold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed576e6f-324b-4048-9129-78fe6b569524",
                                                "sense_id": "f8c4e826-2b7d-3a7d-b3bc-4b4e1c45c76d",
                                                "text": "[…] the president informed him that one of the conditions of his introduction was that he should be eternally ignorant of the place of meeting, and that he would allow his eyes to be bandaged, swearing that he would not endeavor to take off the bandage."
                                            },
                                            {
                                                "example_id": "f535fcce-a77f-4f8d-a13a-01880e861481",
                                                "sense_id": "f8c4e826-2b7d-3a7d-b3bc-4b4e1c45c76d",
                                                "text": "The face which emerged was not reassuring. It was blunt and grey, the nose springing thick and flat from high on the frontal bone of the forehead, whilst his eyes were narrow slits of dark in a tight bandage of tissue.[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db84345-92f9-3cbc-ab76-984d3d729564",
                                        "entry_id": "deb3e078-5da8-35cb-8097-8385ca3d1077",
                                        "glosses": [
                                            "A provisional or makeshift solution that provides insufficient coverage or relief."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc980a4-6396-4787-904d-7d9c77ae1ff6",
                                                "sense_id": "5db84345-92f9-3cbc-ab76-984d3d729564",
                                                "text": "This new healthcare proposal merely applies a bandage to the current medical crisis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bandage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d46460a2-fff1-339f-964b-9105557ca85c",
                                        "entry_id": "d229897c-08fe-3420-b169-2b045c5a5936",
                                        "glosses": [
                                            "To apply a bandage to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "155df908-a1c9-455d-a9fc-b276ff4a4b62",
                                                "sense_id": "d46460a2-fff1-339f-964b-9105557ca85c",
                                                "text": "1879, Samuel Clemens (as Mark Twain), A Tramp Abroad, https://web.archive.org/web/20140811201712/http://etext.virginia.edu/etcbin/ot2www-pubeng?specfile=%2Ftexts%2Fenglish%2Fmodeng%2Fpublicsearch%2Fmodengpub.o2w\n...they ate...whilst they chatted, disputed and laughed. The door to the surgeon's room stood open, meantime, but the cutting, sewing, splicing, and bandaging going on in there in plain view did not seem to disturb anyone's appetite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f8e5230-6e21-442b-bba2-52a715de884a",
                        "source_entry_id": "25ceee6b-addf-3d7d-ac22-f9acdbda93b2",
                        "source_sense_id": "49e802d5-c5d6-3f64-9eaa-4dd114362fbb",
                        "target_lang_word": "bandage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c75bddb-0f73-37fd-945c-abb270ad4abc",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Action de bander quelque chose, de le tendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4a636a-1eeb-4d32-8a0a-2634c6193c3b",
                                                "sense_id": "8c75bddb-0f73-37fd-945c-abb270ad4abc",
                                                "text": "Le bandage d’un arc, d’une arbalète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240e987e-affa-3a0f-a3f3-79dff3cafdaa",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Action de placer un bandeau, de le serrer autour de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea43a31-cc7d-4d7a-86bd-31e7b175bd45",
                                                "sense_id": "240e987e-affa-3a0f-a3f3-79dff3cafdaa",
                                                "text": "Le bandage des yeux d’un homme avant de le fusiller est d’une pratique courante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a711a12-72ad-35cf-9151-fefdb5bc9b33",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Action de placer un bandeau, de le serrer autour de quelque chose.",
                                            "Bandes réglementaires enveloppant le poignet, la paume et la base du pouce des boxeurs ainsi que ceux des pratiquants de certains autres sports de combats et arts martiaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "244c8c55-a606-39c8-b121-b52951b7a523",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Action de placer un bandeau, de le serrer autour de quelque chose.",
                                            "En Chine, action de bander les pieds des femmes pour les rétrécir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76eba1c1-ff36-4796-8a73-a29b5301559a",
                                                "sense_id": "244c8c55-a606-39c8-b121-b52951b7a523",
                                                "text": "Les femmes mandchoues et mongoles, elles, ne pratiquaient pas le bandage des pieds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249e1cdb-1e47-3c60-8dc7-72f4e7f2c108",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Pansement, garrot, fait avec une bande ou moyen d’immobilisation d’une articulation ou d’un segment de membre avec une ou plusieurs bandes d’après une technique définie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6d2b77-a941-4552-b5c9-cdcfa1b84750",
                                                "sense_id": "249e1cdb-1e47-3c60-8dc7-72f4e7f2c108",
                                                "text": "Enlever, serrer un bandage."
                                            },
                                            {
                                                "example_id": "f12ce519-280d-43dd-80ad-2cd0d1d4275a",
                                                "sense_id": "249e1cdb-1e47-3c60-8dc7-72f4e7f2c108",
                                                "text": "Au retour d’une course, nous retrouvons Betty, notre petite chatte, sur trois pattes, miaulant désespérément au moindre mouvement. Vétérinaire, radio, la patte est cassée au niveau de l’humérus, il faut l’opérer et fixer une broche. Et nous ramenons Betty avec un beau bandage jaune et la consigne médicale impérative : repos absolu."
                                            },
                                            {
                                                "example_id": "a8988747-9a1e-4cb0-99e3-acc56eba560b",
                                                "sense_id": "249e1cdb-1e47-3c60-8dc7-72f4e7f2c108",
                                                "text": "De très nombreux types de bandage sont utilisés en chirurgie et en traumatologie ; l’immobilisation n’est souvent que relative et permet de conserver une certaine fonction musculaire et articulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b72987d-4dfd-3785-8c5d-15ba4aaab776",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Pansement, garrot, fait avec une bande ou moyen d’immobilisation d’une articulation ou d’un segment de membre avec une ou plusieurs bandes d’après une technique définie.",
                                            "Bande dont on se sert pour bander, entourer ou envelopper une partie du corps d’un homme ou d’un animal, malade ou blessé."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a53d19c-a452-3b5e-973a-fb4679508515",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Mise en compression de tous les éléments d’une voûte après retrait des soutènements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a21eadcc-fb25-338b-98c5-d9b484748ab0",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Cercle ou bande de métal, de caoutchouc ou de polymère entourant la jante d’une roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043f2f31-022c-47e9-aba1-13090ccf76c7",
                                                "sense_id": "a21eadcc-fb25-338b-98c5-d9b484748ab0",
                                                "text": "Les roues des caddies d’hypermarché sont munies de bandage en plastique."
                                            },
                                            {
                                                "example_id": "d2283ac8-b9b4-4da7-9f04-5f40df978d84",
                                                "sense_id": "a21eadcc-fb25-338b-98c5-d9b484748ab0",
                                                "text": "M. Filleul se pencha : la poussière du chemin présentait des marques de pneumatiques, à bandages antidérapants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47168d7e-b524-38e8-8a12-3946c722394d",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Cercle ou bande de métal, de caoutchouc ou de polymère entourant la jante d’une roue.",
                                            "Sur les vélos et les motos montées de roues à rayons, petite bande de caoutchouc placée en fond de jante pour éviter que les têtes de rayon n’abiment la chambre à air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08e33c0-7db6-43d5-a9bc-b95a85bcb22f",
                                                "sense_id": "47168d7e-b524-38e8-8a12-3946c722394d",
                                                "text": "Les jantes des roues de la Suzuki VanVan sont garnies de bandage."
                                            },
                                            {
                                                "example_id": "3488b0a9-7cff-4c57-a18c-09b97ffd1990",
                                                "sense_id": "47168d7e-b524-38e8-8a12-3946c722394d",
                                                "text": "Bénin était heureux. Les cahots le réjouissaient. Car il connaissait ainsi l’élasticité des bandages, la résistance du cadre, la souplesse de la selle, la dureté de son propre fondement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb0f22ed-9753-3e9b-acf8-3e5143901e7f",
                                        "entry_id": "c5161418-b670-3e18-94fb-3a97921df417",
                                        "glosses": [
                                            "Cercle ou bande de métal, de caoutchouc ou de polymère entourant la jante d’une roue.",
                                            "Bande de fer ou d’autre métal qui entoure une roue de bois et qui la serre pour la tenir en état."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0370d293-d648-4025-aba3-3f8f91755182",
                                                "sense_id": "eb0f22ed-9753-3e9b-acf8-3e5143901e7f",
                                                "text": "Par endroit, il y avait de la boue et les pas glissaient, les bandages de fer des roues enfonçaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
