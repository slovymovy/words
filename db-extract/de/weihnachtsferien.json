                "senses": [
                    {
                        "sense_id": "a147bfe6-bd48-3234-9c0a-030fac03c6c4",
                        "entry_id": "604404a5-8fa9-3a1f-9203-f22624596fef",
                        "glosses": [
                            "Vacances de Noël."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3faecfa2-0bf7-46bb-8b9b-ecad56890119",
                                "sense_id": "a147bfe6-bd48-3234-9c0a-030fac03c6c4",
                                "text": "In den Weihnachtsferien fahren wir zum Skifahren in die Alpen.",
                                "translation": "Durant les vacances de Noël, nous partons faire du ski dans les Alpes."
                            },
                            {
                                "example_id": "62954984-f3dd-442d-9662-69230e4dc761",
                                "sense_id": "a147bfe6-bd48-3234-9c0a-030fac03c6c4",
                                "text": "So auch in den Weihnachtsferien des Jahres 1964, als die Temperaturen tief in den Keller gerutscht waren.",
                                "translation": "Également durant les vacances de Noël de 1964, lorsque la température de la cave était glaciale."
                            },
                            {
                                "example_id": "295be2f5-b2ac-4698-9a81-58d726231780",
                                "sense_id": "a147bfe6-bd48-3234-9c0a-030fac03c6c4",
                                "text": "Am Tag bevor die Schüler in die kurzen Weihnachtsferien fuhren, hatten der erste Helfer und Schüler der Oberklasse im Wald eine besondere Tanne mit weißen Kerzen bestückt.",
                                "translation": "Le jour avant le départ des élèves pour les vacances de Noël, le premier assistant et les élèves de la classe supérieure ont déposé une bougie devant un sapin particulier de la forêt."
                            }
                        ]
                    }
                ],
