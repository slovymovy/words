                "senses": [
                    {
                        "sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                        "entry_id": "d6067aa1-a1cd-3289-876a-0c32f46413d2",
                        "glosses": [
                            "Lebensweise und Kunststil im deutschsprachigen Raum von 1815 bis 1848"
                        ],
                        "tags": [
                            "Stilbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "dea513b2-4aef-45ee-9200-15008f43b9c5",
                                "sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                                "text": "Erkennungsmerkmal für den Biedermeier ist die Mode."
                            },
                            {
                                "example_id": "bcf8f7aa-cd6e-4984-a81c-bd293e58409b",
                                "sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                                "text": "Aus Österreich stammen die drei bedeutendsten Dramatiker des Biedermeier."
                            },
                            {
                                "example_id": "627db2a9-e5b2-4f66-8723-0011daec110e",
                                "sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                                "text": "„Freiligrath trug ungezähmte Phantasien in das betuliche Wohnzimmer des Biedermeier.“"
                            },
                            {
                                "example_id": "dd6a8bca-7803-4907-9d2e-51e3f973172c",
                                "sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                                "text": "„Er beschrieb damit das Biedermeier, jene Jahrzehnte der politischen Ohnmacht nach dem Wiener Kongress, als die Menschen vor der eigenen Mutlosigkeit in die heile Welt der Kultur geflohen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0487ac77-c5ec-326d-b4b6-79bf0f5ee034",
                        "entry_id": "d6067aa1-a1cd-3289-876a-0c32f46413d2",
                        "glosses": [
                            "umgangssprachlich, ursprüngliche Bezeichnung für Spießer, Spießbürger oder Spießertum"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "25b5678e-5b4b-40c0-9f5a-61930f7ff65f",
                                "sense_id": "0487ac77-c5ec-326d-b4b6-79bf0f5ee034",
                                "text": "Biedermeier steht im allgemeinen Sprachgebrauch für alles Kleinbürgerliche und Hausbackene."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90279a14-4abe-4ebb-8772-72779b8138ba",
                        "source_entry_id": "d6067aa1-a1cd-3289-876a-0c32f46413d2",
                        "source_sense_id": "b97de6b2-f09d-3d87-b3a9-ec7b95e7cab0",
                        "source_sense_description": "Lebensweise und Kunststil im deutschsprachigen Raum von 1815 bis 1848",
                        "target_lang_word": "Biedermeier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biedermeier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b834b59e-11a7-3923-99e4-9c8a8e003cd8",
                                        "entry_id": "0554fd69-80ea-348c-9ae0-24e3ee877554",
                                        "glosses": [
                                            "A period in Central Europe between 1815 and 1848 during which the middle class grew in number and the arts appealed to common sensibilities and a sense of parochialism, starting with the Congress of Vienna at the end of the Napoleonic Wars in 1815 and ending with the onset of the Revolutions of 1848."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b067db70-aa82-49ad-8a19-b5f58b8511d1",
                                                "sense_id": "b834b59e-11a7-3923-99e4-9c8a8e003cd8",
                                                "text": "When Frederick died, there followed that time of which Germans themselves are ashamed—the hole-and-corner time, the time when the parochial spirit was abroad and no German burgher saw beyond the village church and the village pump; the Biedermeier time (that comic figure of the German Punch), the time of genuine German philistinism, when the people were lapped in an idyllic repose and were content, as many are to-day, with the smallest and simplest pleasures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
