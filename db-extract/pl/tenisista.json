                                        "glosses": [
                                            "A person who plays tennis. (This entry is a translation hub.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d70af68e-63f5-4d1c-8a68-093904e8b4fe",
                                                "sense_id": "46180d04-aabb-3c57-b8d5-df6818ebe3c5",
                                                "text": "By way of analogy, let us consider what it takes to be a good or bad tennis player. An extremely good tennis player must possess a mastery of the many different activities that are part of the game—serving, returning, and running around the court […]"
                                            }
