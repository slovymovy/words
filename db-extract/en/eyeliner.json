                "word": "eyeliner",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dfcc4ba1-0375-4a1f-8e9c-65c0028a8789",
                        "entry_id": "332fde1c-3dff-3aa3-8d89-7b8e3b599b63",
