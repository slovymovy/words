                        "sense_id": "11713b8d-c618-385c-ad79-9126d86798e5",
                        "entry_id": "ed4ef5c3-22c2-3e82-9819-51464b843eb4",
                        "glosses": [
                            "In an enthusiastic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e79cc178-cec0-4ef0-a39d-476274426867",
                                "sense_id": "11713b8d-c618-385c-ad79-9126d86798e5",
                                "text": "When God presented Lilith to Adam, Adam was overjoyed and enthusiastically set her on the ground and tried to mount her after the fashion of the animals; but Lilith protested and said: \"Why should I be on the bottom and you on the top?\""
                            },
                            {
                                "example_id": "a2ec1945-6f89-491e-b96a-8ae83e5c3ef2",
                                "sense_id": "11713b8d-c618-385c-ad79-9126d86798e5",
                                "text": "The new sea wall may stop the waves from the sea, but not from the children who enthusiastically greet our train as it passes. It's great to see this ages-old habit is still going strong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8039c80d-a3c4-42d9-861f-a7c1a575c339",
