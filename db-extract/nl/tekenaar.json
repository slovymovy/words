                                    },
                                    {
                                        "sense_id": "ee92c852-4f85-3ae3-95f3-f632f4bf724e",
                                        "entry_id": "390ef112-b61c-3543-8d90-45d8281c0e0c",
                                        "glosses": [
                                            "Inhaber einer Schuldverschreibung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b67d909-4bbb-4178-a5b9-ec037c678a2f",
                                                "sense_id": "ee92c852-4f85-3ae3-95f3-f632f4bf724e",
                                                "text": "Der Zeichner einer Schuldverschreibung geht ein hohes Risiko ein."
