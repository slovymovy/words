                "senses": [
                    {
                        "sense_id": "6d63dc70-53f5-37db-86fb-131d3de2a0d2",
                        "entry_id": "df158dde-144a-3c62-aca8-5cf835e22b55",
                        "glosses": [
                            "Faire perdre son caractère vertical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b25a479e-2709-4476-afd8-08e89672b6f8",
                                "sense_id": "6d63dc70-53f5-37db-86fb-131d3de2a0d2",
                                "text": "Elle a elle-même condamné « l’échelle des êtres » , la scala naturae, parce qu’elle tenait à « déverticaliser » l’ensemble et surtout parce qu’elle manifestait les divergences (les séparations)."
                            },
                            {
                                "example_id": "d4b953e7-3b92-40ff-8734-72e041b4760e",
                                "sense_id": "6d63dc70-53f5-37db-86fb-131d3de2a0d2",
                                "text": "Elle a été intégrée aussi horizontalement avec la création de monopoles nationaux et est en train de se déverticaliser lentement."
                            }
                        ]
                    }
