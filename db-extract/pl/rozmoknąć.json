                        ],
                        "examples": [
                            {
                                "example_id": "4b730090-9cad-4caf-ad19-52708dec675c",
                                "sense_id": "32c779d5-71f7-33fd-80b7-6b6378ea4cc9",
                                "text": "„Step rozmókł i zmienił się w wielką kałużę, słońce zaś w południe dogrzewało tak mocno, że — dziw nad dziwy! — w województwie bracławskiem i na Dzikich polach zielona ruń okryła stepy i rozłogi już w połowie grudnia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bad17a25-109c-4867-91c5-a210658ff8b3",
                        "source_entry_id": "f6f909ce-8a08-30f6-a9b7-ef6ba3d34728",
                        "source_sense_id": "32c779d5-71f7-33fd-80b7-6b6378ea4cc9",
                        "source_sense_description": "intransitiv: sich mit Wasser vollsaugen; aufweichen, durchweichen",
                        "target_lang_word": "aufweichen",
