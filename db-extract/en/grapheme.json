                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                        "entry_id": "b0c5d9f0-0e4f-347f-b71c-b2f47b9e9ec4",
                                        "glosses": [
                                            "Plus petit groupe de lettres représentant un phonème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c278ffc-01d3-44c7-95d3-c58e176de0a8",
                                                "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                                "text": "on et om sont les graphèmes associés au phonème \\ɔ̃\\."
                                            },
                                            {
                                                "example_id": "b32581b8-5c6f-4288-89d7-647ba32cb420",
                                                "sense_id": "00d60da2-8b6e-356d-86d9-d43c1cfafb68",
                                                "text": "La phonologie permet d’associer à un graphème, c’est-à-dire à un groupe de lettres particulier (exemple : le groupe de lettres « ch ») un phonème spécifique. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 106)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bda1cd47-cfcc-4aee-94db-f7a9f6d032c9",
                        "source_entry_id": "bb4e2017-7b47-3dc8-952e-8a47af401ffd",
                        "source_sense_description": "fundamental unit of a writing system",
                        "target_lang_word": "Graphem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graphem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af003ca5-95bc-35b6-89e9-c95376fee389",
                                        "entry_id": "59e031fc-7a2d-3451-8ddb-9f338cc2a4b0",
                                        "glosses": [
                                            "kleinste bedeutungsunterscheidende Einheit eines Schriftsystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34fb06f-fd7e-4a69-872e-d3400811364c",
                                                "sense_id": "af003ca5-95bc-35b6-89e9-c95376fee389",
                                                "text": "Das lateinische Alphabet besteht aus Graphemen."
                                            },
                                            {
                                                "example_id": "6b061e1f-015c-4e0c-aef8-e8e2114e736f",
                                                "sense_id": "af003ca5-95bc-35b6-89e9-c95376fee389",
                                                "text": "„Das Graphem ist eine Klasse von Graphen, die distributionell als sprachzeichenunterscheidende graphische Einheit bestimmt wird.“"
                                            },
                                            {
                                                "example_id": "7ea72eeb-e986-437a-acda-c95b109a35b4",
                                                "sense_id": "af003ca5-95bc-35b6-89e9-c95376fee389",
                                                "text": "„Die vierte Art Schrift ist die uns seit der ersten Schulklasse bekannte: „Phonographie“, das heißt wir sprechen Sprachlaute, Phoneme, und schreiben sie dann auf als Buchstaben, Grapheme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4245aea-edc1-3dec-ab91-a4066305c617",
                                        "entry_id": "59e031fc-7a2d-3451-8ddb-9f338cc2a4b0",
                                        "glosses": [
                                            "Menge derjenigen Buchstaben (Graphe), die ein bestimmtes Phonem wiedergeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5abbc485-d58f-415f-b7ac-eec0c3de4ec9",
                                                "sense_id": "c4245aea-edc1-3dec-ab91-a4066305c617",
                                                "text": "„Grapheme sind Buchstaben oder Buchstabenverbindungen, die sich auf ein und dasselbe Phonem beziehen.“"
                                            },
                                            {
                                                "example_id": "78bf212b-da2b-4f84-8a6a-5a875dac6284",
                                                "sense_id": "c4245aea-edc1-3dec-ab91-a4066305c617",
                                                "text": "„Das Graphem ist die kleinste distinktive Einheit der geschriebenen Sprache, die ein Phonem (bzw. eine Phonemfolge) repräsentiert.“"
                                            },
                                            {
                                                "example_id": "7727a0ae-c1d4-4c81-92c4-c444677c9fd0",
                                                "sense_id": "c4245aea-edc1-3dec-ab91-a4066305c617",
                                                "text": "„Mit dieser Einteilung in Grapheme kommen wir zu einer Gliederung, die insofern exakt ist, als sie aus einer unübersehbaren Fülle genau dasjenige abgrenzt, was für unsere Zwecke, für die sprachliche Mitteilung relevant ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4f40558e-4e74-33e0-89a9-986d03faa4ed",
                                        "entry_id": "59e031fc-7a2d-3451-8ddb-9f338cc2a4b0",
                                        "glosses": [
                                            "komplexes Schriftzeichen, das Silben oder Morpheme wiedergibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52cec32c-1014-4e37-ba4d-cd99fe9f78fd",
                                                "sense_id": "4f40558e-4e74-33e0-89a9-986d03faa4ed",
                                                "text": "Das Graphem \"&\" ist ein Beispiel für ein Logogramm in westlichen Sprachen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
