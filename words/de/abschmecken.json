                    "sense_id": "75d27b5a-8ef8-3fb9-9b4c-28b34763f606",
                    "sense_definition": "den Geschmack einer Speise durch vorsichtiges Probieren prüfen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kochen_geschmack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bevor der Koch das Gericht serviert, muss er die Brühe sorgfältig <w>abschmecken</w>."
                        },
                        {
                            "text": "<w>Schmeck</w> bitte kurz die Soße <w>ab</w>, um zu sehen, ob sie gelungen ist."
                        }
                    ],
                    "synonyms": [
                        "probieren",
                        "verkosten",
                        "kosten"
                    ],
                    "common_phrases": [
                        "die Soße abschmecken",
                        "die Suppe abschmecken"
                    ]
                },
                {
                    "sense_id": "3d0edb3a-ea27-3487-9371-94ce5d4148dd",
                    "sense_definition": "den Geschmack einer Speise durch die gezielte Zugabe von Gewürzen abstimmen oder verfeinern",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kochen_geschmack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du solltest das Gemüse vor dem Servieren noch mit etwas Salz und Pfeffer <w>abschmecken</w>."
                        },
                        {
                            "text": "Sie <w>schmeckte</w> das fertige Curry vorsichtig mit frischem Zitronensaft und Kräutern <w>ab</w>."
                        }
                    ],
                    "synonyms": [
                        "würzen",
                        "verfeinern",
                        "nachwürzen"
                    ],
                    "common_phrases": [
                        "mit Salz und Pfeffer abschmecken",
                        "nach Belieben abschmecken"
                    ]
                }
            ]
        },
        {
