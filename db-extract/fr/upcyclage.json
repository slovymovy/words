                        "glosses": [
                            "Synonyme de surcyclage et upcycling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b818ac-e28a-45c0-b9df-1eae84531390",
                                "sense_id": "0029c20f-7e9e-3808-8816-884a41b73752",
                                "text": "L’upcyclage ou le surcyclage consiste à transformer des déchets en produits de qualité supérieure. Exemple : des sacs réalisés dans des tuyaux de lance à incendie destinés au rebut."
                            },
                            {
                                "example_id": "706aee44-8019-48e8-a4a1-136402209fb4",
                                "sense_id": "0029c20f-7e9e-3808-8816-884a41b73752",
                                "text": "Le recyclage s’est recyclé en « upcyclage » ! Cette nouvelle tendance qui a vu le jour dans l’univers du développement durable, offre une seconde vie aux objets et textiles usés."
                            }
                        ]
                    }
