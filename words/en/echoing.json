{
    "word_family": [
        "echo"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b137141-f621-31ac-9973-3a69fbdbf62a",
                    "sense_definition": "The present participle and gerund of <w>echo</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountains were <w>echoing</w> the sound of the distant thunder.",
                            "target_lang_translations": {
                                "pl": "Góry <w>odbijały</w> echem dźwięk dalekiego grzmotu."
                            }
                        },
                        {
                            "text": "She kept <w>echoing</w> his words, <w>echoing</w> his opinions without thinking for herself.",
                            "target_lang_translations": {
                                "pl": "Ciągle <w>powtarzała</w> jego słowa, <w>powtarzając</w> jego opinie bez własnego myślenia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "echoing sound",
                        "echoing voice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma imiesłowu czasu teraźniejszego lub rzeczownik odczasownikowy od czasownika 'echo' (odbijać się echem, powtarzać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odbijający się echem",
                                "target_lang_sense_clarification": "w odniesieniu do dźwięku"
                            },
                            {
                                "target_lang_word": "powtarzający",
                                "target_lang_sense_clarification": "w odniesieniu do słów lub opinii"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eab53a2c-836e-391b-85a0-9cfbca5de356",
                    "sense_definition": "The act or process of producing an echo.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>echoing</w> in the empty hall made it difficult to hear the speaker.",
                            "target_lang_translations": {
                                "pl": "<w>Odbijanie się</w> dźwięku w pustej sali utrudniało słyszenie mówcy."
                            }
                        },
                        {
                            "text": "We listened to the faint <w>echoing</w> of footsteps against the stone walls.",
                            "target_lang_translations": {
                                "pl": "Słuchaliśmy cichego <w>odbijania się</w> kroków od kamiennych ścian."
                            }
                        }
                    ],
                    "synonyms": [
                        "reverberation",
                        "resonance"
                    ],
                    "common_phrases": [
                        "faint echoing",
                        "constant echoing"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces powstawania echa lub pogłosu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odbijanie się echem",
                                "target_lang_sense_clarification": "ogólne zjawisko akustyczne"
                            },
                            {
                                "target_lang_word": "pogłos",
                                "target_lang_sense_clarification": "dźwięk utrzymujący się w pomieszczeniu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}