                "senses": [
                    {
                        "sense_id": "e1efcb26-7899-3729-a7de-52651ca88b3e",
                        "entry_id": "a24db408-c4e2-3d0d-8a83-7c3c9a98fd69",
                        "glosses": [
                            "Couper par apocope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd6fa65-5f4e-48ec-858f-18bb11ae9864",
                                "sense_id": "e1efcb26-7899-3729-a7de-52651ca88b3e",
                                "text": "ça me fait penser à Balladurian qui a préféré apocopiser son patronyme pour qu'on ne taxe pas son discours \"d'épicier\"."
                            },
                            {
                                "example_id": "3ddf2ccb-f9ba-46b4-9497-9eeb2ff9ed17",
                                "sense_id": "e1efcb26-7899-3729-a7de-52651ca88b3e",
                                "text": "Mais épo (qu'il me permette ici de l'apocopiser en toute fraternité) l'a dit aussi : c'est quand même un tout petit peu plus compliqué qu'un t à la place d'un s."
                            },
                            {
                                "example_id": "319cc507-3540-4123-8aa1-caa311894f39",
                                "sense_id": "e1efcb26-7899-3729-a7de-52651ca88b3e",
                                "text": "M. BUZALKOVSKA-ALEXOVA, examine des prépositions bi-syllabiques et leur possible présence dans les textes en Linéaire B et conclut qu’il y a plusieurs instances dans lesquelles ils peuvent s’apocopiser, (...)"
                            }
                        ]
                    }
