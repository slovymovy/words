                            {
                                "example_id": "d94014ef-35b6-4c61-b20d-70eccac51640",
                                "sense_id": "eae57140-730f-3cc3-8f0a-c57ca48548e3",
                                "text": "Потом поехал он к атаманову отцу, у которого был ему приготовлен обед."
                            },
                            {
                                "example_id": "f1c9a4bd-3e91-427a-85f7-ca2186e53643",
                                "sense_id": "eae57140-730f-3cc3-8f0a-c57ca48548e3",
                                "text": "Шапчонку сдёрнул Лукич, на колени шмякнулся, руки волосатые атамановы хватал, целуя…"
                            }
                        ]
