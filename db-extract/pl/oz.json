                "translations": [
                    {
                        "translation_id": "93efcb56-ba59-4131-af27-1dddc3cd502d",
                        "source_entry_id": "180ab509-96f3-331f-928f-c91a319d7dae",
                        "source_sense_id": "69054de7-c8a3-3229-804a-61f2f1a52dc8",
                        "target_lang_word": "sker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "858e33f6-ef4f-42a0-ab84-4ffe41e95ce3",
                        "source_entry_id": "180ab509-96f3-331f-928f-c91a319d7dae",
                        "source_sense_id": "69054de7-c8a3-3229-804a-61f2f1a52dc8",
                        "target_lang_word": "esker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c93678b-b89a-3e30-b51a-d23025f2168c",
                                        "entry_id": "63067035-6438-3894-b366-6e7a17e57854",
                                        "glosses": [
                                            "A long, narrow, sinuous ridge created by deposits from a stream running beneath a glacier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea514892-9581-4f74-af20-83c2cb7d7a02",
                                                "sense_id": "6c93678b-b89a-3e30-b51a-d23025f2168c",
                                                "text": "Another unusual ice-contact feature is an esker, a long, narrow, steep-sided ridge of glaciofluvial sand and gravel inhabiting a glaciated area. Eskers tend to follow valleys and lowlands, carefully picking a course between obstacles."
                                            },
                                            {
                                                "example_id": "d5fe3b90-312a-4034-83c2-9c83ed6acd18",
                                                "sense_id": "6c93678b-b89a-3e30-b51a-d23025f2168c",
                                                "text": "Another objection to the tunnel-valley interpretation comes from a comparison with eskers.[…]The esker rivers and the tunnel-channel rivers of Wisconsin therefore seem to have been the result of significantly different meltwater regimes."
                                            },
                                            {
                                                "example_id": "e01bbb67-e3b0-451b-82ff-c943d81d0a19",
                                                "sense_id": "6c93678b-b89a-3e30-b51a-d23025f2168c",
                                                "text": "2001, Allan D. Randall, Hydrogeologic Framework of Stratified-drift Aquifers in the Glaciated Northeastern United States, US Geological Survey Paper 1415-B, page B37,\nThe multiple deltas must have formed sequentially, which led Thompson (1982) to conclude that the eskers were built in successive segments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91b0a91a-5267-47cb-8f7e-401b64690309",
                        "source_entry_id": "180ab509-96f3-331f-928f-c91a319d7dae",
                        "source_sense_id": "69054de7-c8a3-3229-804a-61f2f1a52dc8",
                        "target_lang_word": "eskar",
                        "target_lang_code": "en",
