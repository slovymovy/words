{
    "word_family": [
        "изумление",
        "изумительный",
        "изумлять"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1e552de2-df45-3207-a1f4-1b4e649f703f",
                    "sense_definition": "Удивительно, восхитительно, необыкновенно хорошо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adverbial_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня погода <w>изумительно</w> теплая и солнечная.",
                            "target_lang_translations": {
                                "en": "The weather today is <w>wonderfully</w> warm and sunny.",
                                "es": "Hoy el clima está <w>maravillosamente</w> cálido y soleado.",
                                "fr": "Aujourd'hui, le temps est <w>merveilleusement</w> chaud et ensoleillé."
                            }
                        },
                        {
                            "text": "Она <w>изумительно</w> играет на фортепиано, вызывая восторг у публики.",
                            "target_lang_translations": {
                                "en": "She plays the piano <w>amazingly</w>, delighting the audience.",
                                "es": "Ella toca el piano <w>maravillosamente</w>, causando deleite en el público.",
                                "fr": "Elle joue <w>admirablement</w> du piano, suscitant l'enthousiasme du public."
                            }
                        }
                    ],
                    "synonyms": [
                        "восхитительно"
                    ],
                    "common_phrases": [
                        "изумительно красиво",
                        "изумительно выглядит"
                    ],
                    "target_lang_definitions": {
                        "en": "In a surprising, delightful, or unusually good way.",
                        "es": "De manera maravillosa, encantadora o extraordinariamente buena.",
                        "fr": "D'une manière merveilleuse, étonnante ou extrêmement agréable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wonderfully",
                                "target_lang_sense_clarification": "Used to describe an action or state that is excellent or delightful."
                            },
                            {
                                "target_lang_word": "amazingly",
                                "target_lang_sense_clarification": "Used to describe something done in a way that causes admiration."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "maravillosamente",
                                "target_lang_sense_clarification": "Indica que algo es excelente o causa admiración."
                            },
                            {
                                "target_lang_word": "estupendamente",
                                "target_lang_sense_clarification": "Se usa para describir algo que es muy bueno o excelente."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "admirablement",
                                "target_lang_sense_clarification": "D'une manière parfaite ou merveilleuse."
                            },
                            {
                                "target_lang_word": "merveilleusement",
                                "target_lang_sense_clarification": "D'une façon qui suscite l'émerveillement."
                            },
                            {
                                "target_lang_word": "magnifiquement",
                                "target_lang_sense_clarification": "D'une manière très belle ou impressionnante."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b585d983-9b43-3ae3-9112-b2718067298c",
                    "sense_definition": "Вызывая сильное удивление или восторг.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adverbial_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот пейзаж <w>изумительно</w> прекрасен в лучах заката.",
                            "target_lang_translations": {
                                "en": "This landscape is <w>remarkably</w> beautiful in the sunset light.",
                                "es": "Este paisaje es <w>asombrosamente</w> hermoso bajo los rayos del atardecer.",
                                "fr": "Ce paysage est <w>incroyablement</w> beau sous les rayons du soleil couchant."
                            }
                        },
                        {
                            "text": "Мастер <w>изумительно</w> точно передал детали на картине.",
                            "target_lang_translations": {
                                "en": "The master captured the details in the painting with <w>amazing</w> precision.",
                                "es": "El maestro capturó los detalles en la pintura con una precisión <w>asombrosa</w>.",
                                "fr": "L'artiste a reproduit les détails du tableau avec une précision <w>admirable</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "восхитительно"
                    ],
                    "common_phrases": [
                        "изумительно точно"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing strong surprise, wonder, or admiration.",
                        "es": "Que causa gran asombro, sorpresa o admiración.",
                        "fr": "Qui provoque un sentiment de surprise intense ou d'admiration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amazingly",
                                "target_lang_sense_clarification": "Used to emphasize the degree of wonder or surprise."
                            },
                            {
                                "target_lang_word": "remarkably",
                                "target_lang_sense_clarification": "Used to highlight that something is worthy of attention or notice."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asombrosamente",
                                "target_lang_sense_clarification": "De un modo que causa asombro o sorpresa."
                            },
                            {
                                "target_lang_word": "increíblemente",
                                "target_lang_sense_clarification": "Que resulta difícil de creer por su calidad o intensidad."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "étonnamment",
                                "target_lang_sense_clarification": "D'une manière qui surprend beaucoup."
                            },
                            {
                                "target_lang_word": "incroyablement",
                                "target_lang_sense_clarification": "À un degré qui dépasse l'attente."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f530df-c306-32eb-8e7f-d80320a13634",
                    "sense_definition": "Оценочная характеристика чего-либо как великолепного или превосходного.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adverbial_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ужин был приготовлен <w>изумительно</w> и всем очень понравился.",
                            "target_lang_translations": {
                                "en": "The dinner was <w>wonderfully</w> prepared and everyone liked it very much.",
                                "es": "La cena fue preparada <w>magníficamente</w> y a todos les gustó mucho.",
                                "fr": "Le dîner était <w>merveilleusement</w> préparé et a beaucoup plu à tout le monde."
                            }
                        },
                        {
                            "text": "Она <w>изумительно</w> справилась с этой сложной задачей.",
                            "target_lang_translations": {
                                "en": "She handled this difficult task <w>brilliantly</w>.",
                                "es": "Ella se encargó <w>excelentemente</w> de esta tarea difícil.",
                                "fr": "Elle a <w>brillamment</w> réussi cette tâche complexe."
                            }
                        }
                    ],
                    "synonyms": [
                        "восхитительно"
                    ],
                    "target_lang_definitions": {
                        "en": "An evaluative description of something as magnificent or excellent.",
                        "es": "Característica evaluativa de algo que es magnífico o superior.",
                        "fr": "Caractérise quelque chose comme étant excellent ou de très haute qualité."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wonderfully",
                                "target_lang_sense_clarification": "Used to express that something is done in an excellent or superb manner."
                            },
                            {
                                "target_lang_word": "brilliantly",
                                "target_lang_sense_clarification": "Used to describe a high level of skill or success."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "magníficamente",
                                "target_lang_sense_clarification": "De manera excelente o grandiosa."
                            },
                            {
                                "target_lang_word": "excelentemente",
                                "target_lang_sense_clarification": "Que denota una calidad superior."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "parfaitement",
                                "target_lang_sense_clarification": "D'une manière sans défaut."
                            },
                            {
                                "target_lang_word": "brillamment",
                                "target_lang_sense_clarification": "Avec une grande réussite ou talent."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea2b0253-f852-35c7-b597-d018e1b47687",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>изумительный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adjective_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё в этом доме было <w>изумительно</w>.",
                            "target_lang_translations": {
                                "en": "Everything in this house was <w>wonderful</w>.",
                                "es": "Todo en esta casa era <w>maravilloso</w>.",
                                "fr": "Tout dans cette maison était <w>merveilleux</w>."
                            }
                        },
                        {
                            "text": "Её пение было <w>изумительно</w> и трогательно.",
                            "target_lang_translations": {
                                "en": "Her singing was <w>amazing</w> and moving.",
                                "es": "Su canto era <w>maravilloso</w> y conmovedor.",
                                "fr": "Son chant était <w>admirable</w> et touchant."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'amazing' (neuter), used as a predicate.",
                        "es": "Forma corta del adjetivo que describe algo como maravilloso o sorprendente.",
                        "fr": "Forme courte de l'adjectif signifiant quelque chose de merveilleux ou d'étonnant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "amazing",
                                "target_lang_sense_clarification": "Used as a predicative adjective to describe a state or quality."
                            },
                            {
                                "target_lang_word": "wonderful",
                                "target_lang_sense_clarification": "Used to describe something as very good or delightful."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "maravilloso",
                                "target_lang_sense_clarification": "Adjetivo que describe algo que causa admiración."
                            },
                            {
                                "target_lang_word": "asombroso",
                                "target_lang_sense_clarification": "Adjetivo que describe algo que causa gran sorpresa."
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "merveilleux",
                                "target_lang_sense_clarification": "Qui suscite l'admiration."
                            },
                            {
                                "target_lang_word": "admirable",
                                "target_lang_sense_clarification": "Qui mérite l'admiration."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}