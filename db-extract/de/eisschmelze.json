                "senses": [
                    {
                        "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                        "entry_id": "3d18afaf-85c5-31e4-960b-08c5b49eeffa",
                        "glosses": [
                            "großflächiges Tauen von Eis"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "6739889f-e2a0-4ac1-a6a2-48868ee9bf2d",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Die Klimakrise treibt die Eisschmelze an.“"
                            },
                            {
                                "example_id": "999be5ce-f8cb-40de-9c70-9c03b95cf1fa",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Zur Eisschmelze trägt neben der Erderhitzung noch ein anderer Faktor maßgeblich bei: Staub und Ruß.“"
                            },
                            {
                                "example_id": "1fd4049b-d55d-451c-ba58-583ab993b94e",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "Durch die Eisschmelze steigt der Meeresspiegel."
                            },
                            {
                                "example_id": "9cd71406-aeb8-499e-8edc-30bad33164bf",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Klimastudien der letzten Jahre zeigen: Die Eisschmelze im Norden beeinflusst den Jetstream – und damit unser Wetter.“"
                            },
                            {
                                "example_id": "2ea1a20b-08c8-4304-87b9-712862215eba",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„In den vergangenen Jahren hat es mehrere Jahre mit ungewöhnlich viel Eisschmelze in Grönland gegeben.“"
                            },
                            {
                                "example_id": "7d9e84f4-fa9b-4f48-92cf-8516f0dd6827",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Jüngste Studien schätzen, dass die jährliche Eisschmelze im Jahr 2019 allein auf Grönland rund 550 Kubikkilometer beträgt, erklärt Boris Koch, chemischer Ozeanograf am Alfred-Wegener-Institut für Polar- und Meeresforschung in Bremerhaven.“"
                            },
                            {
                                "example_id": "ff18df1b-dc22-4c9e-90b4-2ac23bf11914",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "[Rekordtemperaturen an Land und in den Ozeanen:] „Eine drastische Beschleunigung der Eisschmelze und der Anstieg des Meeresspiegels sind die bereits messbaren Folgen.“"
                            },
                            {
                                "example_id": "abfa9d0a-f3cb-46d3-8b33-383a6a1ef564",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Eine Ende Januar von der US-Raumfahrtbehörde NASA veröffentlichte Studie führt die beschleunigte Eisschmelze in Küstennähe auf die Erwärmung des Arktischen Ozeans zurück.“"
                            },
                            {
                                "example_id": "608c1ef8-f5a1-47a9-ba9c-3ca939b6708e",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Zusätzlich kann der Trend der arktischen Eisschmelze nun in Zahlen gefasst werden: Die Flächenabnahme (im Februar) beträgt rund 2,8 % pro Jahrzehnt; auch bei der Eisdicke lässt sich ein negativer Trend feststellen.“"
                            },
                            {
                                "example_id": "860e36e3-9db6-4563-a717-d8f7723896bc",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Im Sonderbericht über die Ozeane und die Kryosphäre“ […] „des Weltklimarates (Intergovernmental Panel on Climate Change, ⁠IPCC⁠) wird gezeigt, dass die Eisschmelze in Antarktis und Arktis von 2012 bis 2016 zusammen pro Jahr 1,2 mm zum Meeresspiegelanstieg beigetragen hat.“"
                            },
                            {
                                "example_id": "6ab93209-7221-4234-8e51-f6438502549b",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Die Arktis gewinnt durch den ⁠Klimawandel⁠ und die daraus resultierende Eisschmelze zunehmend an geopolitischem und ökonomischem Interesse.“"
                            },
                            {
                                "example_id": "3c958b49-9e51-4d78-aaaf-96d24aff3df3",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„Seit Monaten macht ein extremer Rückgang des Eises auf dem Meer rund um die Antarktis Schlagzeilen. Im Februar 2023, dem Höhepunkt der sommerlichen Eisschmelze, gab es so wenig Meereis wie nie zuvor um den Südkontinent.“"
                            },
                            {
                                "example_id": "112891f1-7255-4a99-958a-1a1590cc55e1",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "„2022 war für Schweizer Gletscher katastrophal: Mit sehr wenig Schnee im Winter und anhaltenden Hitzewellen im Sommer wurden sämtliche Rekorde der Eisschmelze pulverisiert.“"
                            },
                            {
                                "example_id": "4ae26703-4597-411f-9522-0a7e951a737e",
                                "sense_id": "eabc9c2d-f241-36d4-830e-a26568c6df9e",
                                "text": "[Lena (Fluss in Sibirien):] „Der etwa zwischen 2.800 m³/s im Januar und 66.500 m³/s im Juni variierende Abfluss, ist hauptsächlich auf die zwischen Mai und Juni auftretende Eisschmelze zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
