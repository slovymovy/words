                                        "glosses": [
                                            "A Francophone Canadian who resides in the province of Ontario."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f34c4f4-18b4-4795-99e0-316615d64b0f",
                                                "sense_id": "0b3b551f-228e-3498-a2e6-d0ef3fc331f7",
                                                "text": "The mention of Regulation 17 continues to evoke chills in our community: Enacted from 1912 to 1927, Regulation 17 aimed to eradicate French-language education in Ontario schools. The objective was ultimately to assimilate Franco-Ontarians into the English-speaking majority."
                                            }
                                        ]
                                    }
                                ]
                            },
