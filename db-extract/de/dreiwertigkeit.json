                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "5267ecb7-8b68-47b6-be38-2c22641e0c1f",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Dreiwertigkeit"
                    },
                    {
                        "form_id": "12bf7ba3-d634-4c06-8d21-e6525bf03d80",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Dreiwertigkeit"
                    },
                    {
                        "form_id": "2bb2232c-0258-4c48-85a4-37bb5b2d50dc",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Dreiwertigkeit"
                    },
                    {
                        "form_id": "42ef3d8e-887c-498a-8dc8-5447a0f75b52",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Dreiwertigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ece040b-e90f-338f-8d09-3c72a880fad4",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "glosses": [
                            "Eigenschaft, drei Komponenten zu beinhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a038c61a-660b-4132-8208-b06f424f4ef8",
                                "sense_id": "7ece040b-e90f-338f-8d09-3c72a880fad4",
                                "text": "„Die Dreiwertigkeit der Topologien – geographisch, temporal, sozio-organisch – macht den Kern geopolitischer Metaphernfelder aus.“"
                            },
                            {
                                "example_id": "0cb48508-ad0a-4e63-bdd8-fc92e3bddaf6",
                                "sense_id": "7ece040b-e90f-338f-8d09-3c72a880fad4",
                                "text": "„Die Dreiwertigkeit von Zeichen als immanenter Differenz von Bezeichnendem und Bezeichnetem sowie des Beobachters, der beide diskriminiert, also das Zeichen als Zeichen erkennt, bindet es in weitere Zeichenverwendung […].“"
                            },
                            {
                                "example_id": "b6eccaa8-dbb0-41f9-a805-88b239b3fd6d",
                                "sense_id": "7ece040b-e90f-338f-8d09-3c72a880fad4",
                                "text": "„Die Dreiwertigkeit der Systemtheorie besteht formal, gilt aber nicht für die Operation des Unterscheidens, welche immer dichotom gedacht wird.“"
                            },
                            {
                                "example_id": "4dbb9c33-2cb2-4205-b431-8842fcaca371",
                                "sense_id": "7ece040b-e90f-338f-8d09-3c72a880fad4",
                                "text": "„Die Dreiwertigkeit produziert nur eine Dreiheit zweiwertiger Fundamentalthemata und gibt nicht den geringsten Fingerzeig, wie dadurch der ursprüngliche Streit befriedet werden könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                        "entry_id": "ff0d7d6c-2bf4-3a55-8119-4260194f8273",
                        "glosses": [
                            "Eigenschaft, mit drei anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea35ed82-9d9c-482c-8352-a6660a593883",
                                "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                                "text": "„In der 8. Nebengruppe ist die maximale Wertigkeit beim Eisen die Sechswertigkeit, beim Kobalt und Nickel die Dreiwertigkeit, während die größte Beständigkeit die Verbindungen des dreiwertigen Eisens und des zweiwertigen Nickels haben.“"
                            },
                            {
                                "example_id": "7e58e32c-ec6e-4507-9f9d-8e96975b65d3",
                                "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                                "text": "„Bedingt durch die Dreiwertigkeit des Aluminiums wird in der zweiten Stufe ein wesentlich höher vernetztes System erhalten.“"
                            },
                            {
                                "example_id": "42f658bb-2f18-4a49-82fa-d5f4504cb8a3",
                                "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                                "text": "„So sind die seltenen Erden in erster Linie durch die Dreiwertigkeit verknüpft, die sich von Lanthan (57) bis zum Cassiopeium (71) erstreckt.“"
                            },
                            {
                                "example_id": "35e3f4b5-92ae-4962-8087-dec4d58e01e3",
                                "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                                "text": "„Gegenüber elektropositiven Elementen wie Wasserstoff oder Metallen treten die Elemente der 5. nur dreiwertig auf; gegenüber elektronegativen Elementen wie Sauerstoff, Schwefel oder Chlor sind sie drei- und fünfwertig, wobei mit steigendem Atomgewicht die Dreiwertigkeit mehr und mehr die Fünfwertigkeit überwiegt.“"
                            },
                            {
                                "example_id": "94a4a2ff-018b-4e5d-9434-31ab73514aa9",
                                "sense_id": "8094417f-8b6a-34b5-9cce-2b991d1fcc35",
                                "text": "„Dank einer vollbesetzten f-Schale bildet auch das Ytterbium (6s²4f¹⁴) zweiwertige Kationen, wieder ist jedoch die Dreiwertigkeit bevorzugt: ist ein derart starkes Reduktionsmittel, dass es in Wasser nicht beständig ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
