                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "dd9d5f53-2e7a-42b3-96d8-6580faea798e",
                        "entry_id": "58e0e7c8-5617-37e8-9a1e-b04aa1daa565",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Paternosters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b3757bb-8636-356c-bcc8-f3876ae8d0bc",
                        "entry_id": "58e0e7c8-5617-37e8-9a1e-b04aa1daa565",
                        "glosses": [
                            "gebed dat Jezus Christus aan zijn discipelen heeft geleerd tijdens de Bergrede\\nHet uitspreken van dit gebed kan worden aangeduid met paternoster zonder hoofdletter volgens spellingregel 16.P"
                        ],
                        "tags": [
                            "christendom"
                        ],
                        "examples": [
                            {
                                "example_id": "dd609ba3-b718-41f4-9d34-6eb0b68ce7ee",
                                "sense_id": "7b3757bb-8636-356c-bcc8-f3876ae8d0bc",
                                "text": "Otten schreef over het Paternoster in nrc Handelsblad van 7 maart 2008: ‘Ik verkies het te denken dat het Onze Vader de laatste zone is die we begaan; de laatste keer dat we de wereld kunnen vergeten. Waar het altijd om te doen was.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a0e9297-942e-4da3-b549-8c7e9838e179",
                        "source_entry_id": "58e0e7c8-5617-37e8-9a1e-b04aa1daa565",
                        "source_sense_id": "7b3757bb-8636-356c-bcc8-f3876ae8d0bc",
                        "source_sense_description": "gebed dat Jezus Christus aan zijn discipelen heeft geleerd tijdens de Bergrede",
                        "target_lang_word": "Lord's Prayer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lord's Prayer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1e3f30-a18c-3dae-86e4-62fd55ef2eac",
                                        "entry_id": "62a44d77-f1d1-35ec-b965-c79d2fac9e8e",
                                        "glosses": [
                                            "The prayer which, according to the New Testament of the Bible, Jesus Christ taught his disciples in the Sermon on the Mount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed06c99d-ab62-4037-82ec-0534ae530159",
                                                "sense_id": "9b1e3f30-a18c-3dae-86e4-62fd55ef2eac",
                                                "text": "He sat down in the middle of the floor, took his chalk out and marked a large ring around him, and round about this he wrote the Lord's Prayer, and then he did not feel afraid even if Old Nick himself should come."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "18d87c29-ef9c-4204-8a3f-a7642349105c",
                        "source_entry_id": "58e0e7c8-5617-37e8-9a1e-b04aa1daa565",
                        "source_sense_ids": [
                            "7b3757bb-8636-356c-bcc8-f3876ae8d0bc"
                        ],
                        "linkage_type": "synonyms",
                        "word": "Onzevader"
                    }
                ]
            },
            {
                "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                "word": "paternoster",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1d5f163a-ea56-4e14-830a-dda5ea68c2d5",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "paternosters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e3d347d-de6a-3e2e-8332-8188a36e8f55",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "glosses": [
                            "als gebed uitspreken van het Onzevader\\nAls naam van het gebed wordt Paternoster net als Onzevader met een hoofdletter geschreven volgens spellingregel 16."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec87fce-9b4d-4bcc-bc4c-7176112504bc",
                                "sense_id": "5e3d347d-de6a-3e2e-8332-8188a36e8f55",
                                "text": "Maar, zoals een bestuurder het verwoordt: ‘Als jij of je vader of moeder ligt te creperen van de pijn, gaat het niet helpen als iemand naast je een paternoster zit te bidden. Overigens: hoeveel mens is een mens nog als die volledig opgaat in het lijden?’"
                            }
                        ]
                    },
                    {
                        "sense_id": "95f59c0b-ea3e-37be-895f-789caf69d459",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "glosses": [
                            "christelijk gebedssnoer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b0d2c0d-f1b2-4f2d-a1dc-3aae3c73fb9a",
                                "sense_id": "95f59c0b-ea3e-37be-895f-789caf69d459",
                                "text": "Het is een constante gedurende de reis, hoe geloof en familieband verweven zijn. Jessica heeft een zak vol plastic wijwaterflessen mee om te vullen in de Jordaan. Jad koopt Palestijnse sjaals op verzoek van de familie. Maryse en Jessica nemen een paar paternosters uit Bethlehem mee naar Brussel."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf2cb742-7305-388e-8f34-039579719b84",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "glosses": [
                            "type lift met cabines die voortdurend rond blijven gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82508f2-95c3-400f-bf71-5bb64fe37d8e",
                                "sense_id": "bf2cb742-7305-388e-8f34-039579719b84",
                                "text": "De paternoster is niet ongevaarlijk. In 2012 viel een 81-jarige man in de liftschacht in het voormalige Ziggo-gebouw in Den Haag."
                            }
                        ]
                    },
                    {
                        "sense_id": "f80610ac-72c6-3a0e-9794-e3861e01cc80",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "glosses": [
                            "installatie voor baggerwerk met voortdurend rondgaande bakjes"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dbb778d3-25b5-3593-a124-eb5fe56758e6",
                        "entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "glosses": [
                            "reeks vertakkingen aan een vislijn met behulp van staafjes die haaks op de vislijn zijn bevestigd, om zo met meer haakjes tegelijk te hengelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca39c89-967b-40c4-97a9-10b5df3921a0",
                                "sense_id": "dbb778d3-25b5-3593-a124-eb5fe56758e6",
                                "text": "Op de golfbrekers was het sowieso oppassen geblazen. Als m’n lijn vastzat, omdat ’t werpklompje of paternoster ergens achter bleef steken, moest ik langs slijmgladde blokken afdalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2992ad58-c494-47b2-ad1a-aba219d375d3",
                        "source_entry_id": "a652a531-9645-3607-94b4-4301556ca4cf",
                        "source_sense_id": "5e3d347d-de6a-3e2e-8332-8188a36e8f55",
                        "source_sense_description": "(religie) christelijk gebed, het onze vader",
                        "target_lang_word": "paternoster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paternoster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "871bc743-8123-3f25-8aae-a2d29710f3ed",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "The Lord's Prayer, especially in a Roman Catholic context."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9881e069-0300-40e4-8d5d-217c706135b2",
                                                "sense_id": "871bc743-8123-3f25-8aae-a2d29710f3ed",
                                                "text": "The friar had said his paternosters duly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805b296d-5219-32f6-83e2-20f6e50a7c43",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A slow, continuously moving lift or elevator consisting of a loop of open-fronted cabins running the height of a building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "676c6449-2814-36c8-82b0-06cffd9124c0",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A bead-like ornament in mouldings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9284f1-9481-3fc2-96e8-1eb8df83ad79",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A tackle rig with a heavy sinker at the end of the line, and one or more hooks on traces at right angles spaced above the sinker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1198ad7-ce56-425a-a419-45640fe1c4fd",
                                                "sense_id": "cb9284f1-9481-3fc2-96e8-1eb8df83ad79",
                                                "text": "PATERNOSTER TWIN This rig is slightly more complicated than the single paternoster, however this rig has the added advantage of having two hooks, these can be different sizes and be baited with different baits."
                                            },
                                            {
                                                "example_id": "0f8050e2-9e66-4d60-8c4b-4eb7d23e1f82",
                                                "sense_id": "cb9284f1-9481-3fc2-96e8-1eb8df83ad79",
                                                "text": "A paternoster is any style of hook rig where the hook(s) are on droppers above a fixed sinker. One or two hooks are used on a paternoster rig. The droppers are tied using dropper loops tied directly in the line. The twisted dropper is an ideal knot as it stands out at right angles to the line."
                                            },
                                            {
                                                "example_id": "7ab1189d-d564-4ab1-9e94-9a733738c64c",
                                                "sense_id": "cb9284f1-9481-3fc2-96e8-1eb8df83ad79",
                                                "text": "In plain terms, the paternoster is a rig with the weight at the bottom and hook traces (sometimes called snoods by sea anglers) attached above in fixed positions. Besides a tidy presentation, this arrangement allows the sea angler to try more than one bait and you'll often find paternosters with two hooks (or even three or four). Effectively this allows us to hedge our bets and try more baits (which could be the same or different types), thereby increasing the scent and attraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d98e6208-a1ca-3267-9913-400c27d68874",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A string of beads used in counting prayers that are said."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59e7e8e4-0bb8-3ccf-9721-09ba169f95ef",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "Every eleventh bead in a rosary, at which, while counting the beads, the Lord's Prayer is to be repeated."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e61dbad4-d142-44a1-9b0f-3425fbc8a9b5",
                                                "sense_id": "59e7e8e4-0bb8-3ccf-9721-09ba169f95ef",
                                                "text": "Holonyms: rosary; prayer beads"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd83de90-eb17-3e36-abc9-63f05d9d8721",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A medieval artisan who crafted rosary beads or prayer nuts."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3866bd22-dad0-32d7-960c-5d85e44cf17e",
                                        "entry_id": "29a57777-ad3b-3bec-83a5-3071bbd02699",
                                        "glosses": [
                                            "A patent medicine, so named because salesmen would pray the Lord's Prayer over it before selling it."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9aa37ca-82e1-40e9-bce0-b689fe8a32ec",
                                                "sense_id": "3866bd22-dad0-32d7-960c-5d85e44cf17e",
                                                "text": "Near-synonyms: nostrum, nostrum remedium"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paternoster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b455df8-89a3-3fa2-b93c-35b3ed506103",
