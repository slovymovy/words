                        "glosses": [
                            "Personengruppe, die eine Leiche auf ihrem letzten Weg begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c58784e0-a1e6-4f81-9d00-15a59b425312",
                                "sense_id": "b053692b-2440-3da8-a50e-5dc6c7e24b08",
                                "text": "„Unter solchem Selbstgespräche war er bis an die Bülowstraße gekommen und wollte sich eben unter Benutzung derselben in weitem Bogen wieder zurück nach dem Tiergarten schlängeln, als er in einiger Entfernung eines Begräbniszuges gewahr wurde, der nach dem Matthäikirchhofe hinaus wollte.“"
                            }
                        ],
