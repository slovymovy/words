                    {
                        "sense_id": "694e05c9-b26e-334b-b086-98f858af8446",
                        "entry_id": "be6083f7-a7b8-36cb-ade8-ce9755bf063d",
                        "glosses": [
                            "Tennessee (État des États-Unis d’Amérique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8b5665-3a30-465f-b510-f17f0918254f",
                                "sense_id": "694e05c9-b26e-334b-b086-98f858af8446",
                                "text": "Я глядел на мелькающие за окном пейзажи Теннесси.",
                                "translation": "Je regardai défiler le paysage du Tennessee derrière la vitre."
                            }
                        ]
