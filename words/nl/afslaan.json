                            },
                            {
                                "target_lang_word": "to go down",
                                "target_lang_sense_clarification": "prices becoming lower"
                            },
                            {
                                "target_lang_word": "to reduce",
                                "target_lang_sense_clarification": "lowering the cost of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fa18818-f4ee-34e4-b4f4-d114dac61dbb",
                    "sense_definition": "iemand fysiek mishandelen of een pak slaag geven",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeven hebben het slachtoffer genadeloos <w>afgeslagen</w> in een steegje.",
                            "target_lang_translations": {
                                "en": "The thugs <w>beat up</w> the victim mercilessly in an alleyway."
