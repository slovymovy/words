                "senses": [
                    {
                        "sense_id": "bfc0546d-fb86-3292-818f-55cfcf1e354b",
                        "entry_id": "4ea35af2-96f2-3e98-9f23-155c909f6c44",
                        "glosses": [
                            "страд. прич. прош. вр. от провинтитьᴵ"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "179d86a0-c33f-4ec7-879f-373a6a64d24a",
                                "sense_id": "bfc0546d-fb86-3292-818f-55cfcf1e354b",
                                "text": "Я на секунду провинчен серыми, холодными буравчиками глаз."
                            },
                            {
                                "example_id": "54a5e51e-9383-45f2-8ebd-5f6c8c7d686c",
                                "sense_id": "bfc0546d-fb86-3292-818f-55cfcf1e354b",
                                "text": "В этот день мои руки были изрезаны, истыканы, провинчены и распилены; из большого пальца, особенно сильно пострадавшего, была сделана белая куколка, и катанье на коньках было отложено до завтра."
                            }
                        ]
                    }
