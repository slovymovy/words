                        "glosses": [
                            "een prikkel die als doel heeft een bepaalde activiteit te bevorderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d98cf6-10ce-4e6c-896d-5e75efd72720",
                                "sense_id": "98f79f42-1988-3ce6-aa03-d818b46c98bc",
                                "text": "Nuon kondigde de aanleg van het windmolenpark in 2008 aan, waarna in 2011 met de bouw werd begonnen. In 2010 verleende de overheid een subsidie van maximaal 229 miljoen euro, op basis van een stimuleringsmaatregel voor duurzame energie. Het uiteindelijke subsidiebedrag werd afhankelijk gemaakt van de productie en de elektriciteitsprijs."
                            },
                            {
                                "example_id": "46999bd1-4a00-4699-9f49-45dc059459ac",
                                "sense_id": "98f79f42-1988-3ce6-aa03-d818b46c98bc",
                                "text": "Bussemaker is bereid met het geld een stimuleringsmaatregel te bekostigen. Zij denkt dan aan een zogenoemde cash rebate, een subsidie die wordt gegeven op basis van de bestedingen van de filmproducent."
                            }
                        ]
                    }
