                    {
                        "translation_id": "6bfb6f9f-d001-463b-944f-d0a1ef298d64",
                        "source_entry_id": "541527d9-4cdb-3a3a-a7f1-98db98a73f67",
                        "source_sense_id": "ab1dde84-a420-33ec-8b2e-6daacc141be6",
                        "source_sense_description": "hässlich, unansehnlich",
                        "target_lang_word": "hässlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hässlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "616b4224-fa2d-3762-a645-d8797e8f9155",
                                        "entry_id": "e3fe04c9-a6cf-3780-b47c-c1f18fdaa0c1",
                                        "glosses": [
                                            "unschön aussehend, nicht den vorherrschenden Normen über gutes Aussehen entsprechend"
                                        ],
                                        "tags": [
                                            "optisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d70ec48-d3a7-4d3f-b6fa-3c355823290b",
                                                "sense_id": "616b4224-fa2d-3762-a645-d8797e8f9155",
                                                "text": "Zieh bloß dieses hässliche Kleid nicht mehr an!"
                                            },
                                            {
                                                "example_id": "9fbcc5ba-754d-4ca9-8757-d6486fdc731e",
                                                "sense_id": "616b4224-fa2d-3762-a645-d8797e8f9155",
                                                "text": "Sie ist nicht hässlich, aber auch nicht schön, man könnte vielleicht sagen, dass die apart ist und auf ihre Weise höchst interessant."
                                            },
                                            {
                                                "example_id": "e406716c-af3c-4349-8659-e2cccec32113",
                                                "sense_id": "616b4224-fa2d-3762-a645-d8797e8f9155",
                                                "text": "„Hässlich, ich bin so hässlich, so grässlich hässlich:“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56df73e3-333b-30c1-ade4-977dfbb76238",
                                        "entry_id": "e3fe04c9-a6cf-3780-b47c-c1f18fdaa0c1",
                                        "glosses": [
                                            "unschön klingend"
                                        ],
                                        "tags": [
                                            "akustisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7b2ac2-c2f9-4487-8fc7-d3d38014b700",
                                                "sense_id": "56df73e3-333b-30c1-ade4-977dfbb76238",
                                                "text": "So ein hässliches Gekrächze!"
                                            },
                                            {
                                                "example_id": "335fff4b-ca9e-4469-b71e-f811f1309cf1",
                                                "sense_id": "56df73e3-333b-30c1-ade4-977dfbb76238",
                                                "text": "„Hässlich, ich bin so hässlich, so grässlich hässlich:“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "446ba980-e0cc-335d-a770-ac3db7452b5a",
                                        "entry_id": "e3fe04c9-a6cf-3780-b47c-c1f18fdaa0c1",
                                        "glosses": [
                                            "mit Absicht verletzend und gemein"
                                        ],
                                        "tags": [
                                            "auf Worte und Verhalten bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dc7f1ac-fb92-45be-9096-8452bc1c125a",
                                                "sense_id": "446ba980-e0cc-335d-a770-ac3db7452b5a",
                                                "text": "Sei nicht immer so hässlich zu deiner Schwester!"
                                            },
                                            {
                                                "example_id": "1b8e0922-abf4-41e2-86b4-5f0e77b86395",
                                                "sense_id": "446ba980-e0cc-335d-a770-ac3db7452b5a",
                                                "text": "Zwischen den Parteien gab es immer wieder hässliche Töne."
                                            },
                                            {
                                                "example_id": "d573c371-249b-4a57-be25-631aa8e75de2",
                                                "sense_id": "446ba980-e0cc-335d-a770-ac3db7452b5a",
                                                "text": "„Hässlich, ich bin so hässlich, so grässlich hässlich:“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7f0509a7-29a8-3680-bdab-fae3d031aa29",
                                        "entry_id": "e3fe04c9-a6cf-3780-b47c-c1f18fdaa0c1",
                                        "glosses": [
                                            "kalt oder regnerisch"
                                        ],
                                        "tags": [
                                            "auf das Wetter bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe14ff8-afde-4441-ba07-e222435d05fe",
                                                "sense_id": "7f0509a7-29a8-3680-bdab-fae3d031aa29",
                                                "text": "Bei diesem gar hässlichen Wetter bekommen mich keine zehn Pferde nach draußen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9db9555a-f2dc-3858-8836-9a275d6f2f75",
                                        "entry_id": "e3fe04c9-a6cf-3780-b47c-c1f18fdaa0c1",
                                        "glosses": [
                                            "mit geringem Wert, unerfreulich und negativ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f33612-61b5-4801-a5a2-861018a6c8cb",
                                                "sense_id": "9db9555a-f2dc-3858-8836-9a275d6f2f75",
                                                "text": "Du wirst noch hässlich enden, wenn du so weitermachst."
                                            },
                                            {
                                                "example_id": "2f9bd309-4dae-4f51-bc09-15fce90e93a4",
                                                "sense_id": "9db9555a-f2dc-3858-8836-9a275d6f2f75",
                                                "text": "Das war eine ganz hässliche Geschichte, die sie dann auch letztlich den Job gekostet hat."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
