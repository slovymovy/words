                        "entry_id": "1fedc198-2529-3a18-a3ca-70af8b99f5f0",
                        "glosses": [
                            "dzieło historiograficzne będące chronologicznym zapisem ważnych dla danego dzieła wydarzeń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee83a319-fcb0-48e6-b595-093c84d52bb1",
                                "sense_id": "55f3bebf-1528-3d08-ad63-7a7987494668",
                                "text": "Annały żarskie nie odnotowały jakichkolwiek ekscesów na tle wyznaniowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "810c018b-d60f-31af-821e-e330bcc6b35d",
                        "entry_id": "1fedc198-2529-3a18-a3ca-70af8b99f5f0",
                        "glosses": [
                            "historia, pamięć społeczna"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "3569a968-03ef-4f86-8155-603ef5c4b7de",
                                "sense_id": "810c018b-d60f-31af-821e-e330bcc6b35d",
                                "text": "W historii spotkań gwiazd były takie pojedynki, które na stałe wpisały się w annały NBA i pamięć kibiców"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
