                "senses": [
                    {
                        "sense_id": "d3aa72d7-b80e-38fd-80ba-abaf96bc4a65",
                        "entry_id": "915df708-708d-3a77-a252-2b38dfc214fc",
                        "glosses": [
                            "der Vorgang oder das Ergebnis des Vertuschens; die Verheimlichung eines Sachverhalts, sodass er nicht öffentlich bekannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718b6cd7-82d6-4148-aa53-c6a0c9385809",
                                "sense_id": "d3aa72d7-b80e-38fd-80ba-abaf96bc4a65",
                                "text": "Der Chef des Konzerns wird verdächtigt, Schweigegelder zur Vertuschung des Abgasskandals gezahlt zu haben."
                            },
                            {
                                "example_id": "a3500791-c189-4eb4-938b-fa44c9b36c38",
                                "sense_id": "d3aa72d7-b80e-38fd-80ba-abaf96bc4a65",
                                "text": "„Papst Franziskus soll seit spätestens 2015 von der Vertuschung von Missbrauchsfällen in Chile durch Bischof Juan Barros gewusst haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e29d07e2-600f-4847-862c-84b297760dfa",
                        "source_entry_id": "915df708-708d-3a77-a252-2b38dfc214fc",
                        "source_sense_id": "d3aa72d7-b80e-38fd-80ba-abaf96bc4a65",
                        "target_lang_word": "cover-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cover-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                        "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                                        "glosses": [
                                            "An attempt to conceal or disguise something, especially a wrongdoing or a mistake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7da3985-b133-4ced-a619-9ea6e2dba544",
                                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                                "text": "Truthfulness means no lies and no cover-ups. Compassion means being kind and helpful to others. Forbearance means being able to tolerate and suffer, and not fight back."
                                            },
                                            {
                                                "example_id": "79dbf3f9-e355-4619-aa49-cca421355ce5",
                                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                                "text": "[War metaphors] are used, either consciously or unconsciously, for specific effect and purpose. They are used, not so much as descriptions, but rather to convey additional moral, imaginative or judgmental information. The ubiquitous \"war between the sexes\" is, in fact, a cover-up of the fact that men, generally, have social power over women."
                                            },
                                            {
                                                "example_id": "0499ff70-7dea-4e81-9adb-25d27dfb7eb3",
                                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                                "text": "Mona: Oh, of course, a cover-up! You know, the whole town would panic if they knew a misunderstood Frankensteinosaurus was on a bloodthirsty rampage! Your secret's safe, Officer. I don't want to cause an international panic any more than you do."
                                            },
                                            {
                                                "example_id": "226a59a9-e432-48f4-baf5-dab0154eb438",
                                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                                "text": "These divine qualities migrated to Mary because of deficiencies in the theology of God, in Christology and in pneumatology. It makes no lasting sense to retain this as a permanent status quo, using Mary as a cover-up for defective notions of the divine."
                                            },
                                            {
                                                "example_id": "ca6f7752-05e8-48e0-8bcd-4d5a7a16b23c",
                                                "sense_id": "601ffc52-35e2-3caa-8737-3ed58be312d3",
                                                "text": "Many supporters believed Donald Trump would finally expose government cover-ups once he returned to power. But more than six months into his new term, those much-hyped conspiracy theories have either been debunked or quietly fallen apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3077a31-b341-3e67-8140-3e055f77e74e",
                                        "entry_id": "451491a4-b230-31b0-a437-30631314f9da",
                                        "glosses": [
                                            "An item of clothing to be worn over a swimsuit while not in the water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5444d5-9ba7-48a0-a579-9370a677a795",
                                                "sense_id": "f3077a31-b341-3e67-8140-3e055f77e74e",
                                                "text": "The women usually wore bikini tops with shorts, swimsuits underneath cover-ups or just swimsuits. Men came in various types of trunks, from traditional boxers, to Speedos, to G-string trunks that showcased their packages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5c39ec-d4af-4a73-897a-3703962f1fa6",
                        "source_entry_id": "915df708-708d-3a77-a252-2b38dfc214fc",
                        "source_sense_id": "d3aa72d7-b80e-38fd-80ba-abaf96bc4a65",
                        "target_lang_word": "étouffement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étouffement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b011c68f-7b00-31c5-a777-ccc9c17eb83c",
                                        "entry_id": "88c0508c-fd06-3263-bac4-9c0e508f7f0d",
                                        "glosses": [
                                            "Difficulté de respirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5298a0c-eb0d-4e04-bcac-e2bcb9209fcc",
                                                "sense_id": "b011c68f-7b00-31c5-a777-ccc9c17eb83c",
                                                "text": "Ce malade a des crises d’étouffement."
                                            },
                                            {
                                                "example_id": "a53cc1c7-43f2-4b19-99de-6becef24c865",
                                                "sense_id": "b011c68f-7b00-31c5-a777-ccc9c17eb83c",
                                                "text": "« Comment se trouve-t-il ce soir, Clémence ?\n– Pas très bien. Il a ses étouffements. Il réclamait un peu de limonade. Je lui en ai donné ; il en restait encore un verre dans le siphon. »"
                                            },
                                            {
                                                "example_id": "c9402007-4255-4b7a-ae8d-a16343966289",
                                                "sense_id": "b011c68f-7b00-31c5-a777-ccc9c17eb83c",
                                                "text": "Malgré-moi, tous les muscles de mon corps se bandaient inutilement pour m'arracher à l'étouffement."
                                            },
                                            {
                                                "example_id": "b4cf8bdf-fd7c-4f58-8ed5-3ccbf635148b",
                                                "sense_id": "b011c68f-7b00-31c5-a777-ccc9c17eb83c",
                                                "text": "— Je ne sais trop, insistai-je, d’un ton rêveur, et comme me parlant à moi-même, si l’étouffement sous des édredons se décèle à l’autopsie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b97054-292a-3f20-9fa6-7d10041cb685",
                                        "entry_id": "88c0508c-fd06-3263-bac4-9c0e508f7f0d",
                                        "glosses": [
                                            "Dispositif destiné à faire cesser la vibration des cordes d'un piano."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2544b2c-5b8c-41eb-8754-3112e1b3ed57",
                                                "sense_id": "c2b97054-292a-3f20-9fa6-7d10041cb685",
                                                "text": "Doux souvenirs ! Nos mains se rencontraient sur les touches d’ivoire, nos pieds sur la pédale d’étouffement, et vous poussiez des petits cris aigus…\nBlanche.– C’étaient vos bottes, mon ami."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f95ff0e1-70ec-3ac6-985d-a9e7256cf09e",
                                        "entry_id": "88c0508c-fd06-3263-bac4-9c0e508f7f0d",
                                        "glosses": [
                                            "Dans diverses industries utilisant un four, chauffe à mi-température précédant le défournement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39e1ea4-014e-4ea6-baac-d8402032fd79",
                                                "sense_id": "f95ff0e1-70ec-3ac6-985d-a9e7256cf09e",
                                                "text": "Ordinairement cet étouffement dure 12 heures, sans que le fourneau ne refroidisse trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ac0b46a-9997-3a45-828a-04f29aa228f6",
                                        "entry_id": "88c0508c-fd06-3263-bac4-9c0e508f7f0d",
                                        "glosses": [
                                            "Action d’étouffer, de tuer, les cocons de vers à soie, on dit aussi étouffage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ad15b6-9dcb-426d-97c3-84268b6fb221",
                                                "sense_id": "8ac0b46a-9997-3a45-828a-04f29aa228f6",
                                                "text": "L’étouffement à la vapeur de l'eau bouillante est sujet aux mêmes inconvéniens⁽ˢⁱᶜ⁾. Il n'y a pas moins de dangers et d'imperfections dans l'étouffement au four. Ce procédé presque universellement suivi consiste à mettre les cocons au four …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
