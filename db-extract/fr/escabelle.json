                                        "sense_id": "8e8c9771-caa9-34b9-a5c2-ae8d24c1d041",
                                        "entry_id": "fc1330fc-187b-3057-8143-dc440b1fabfa",
                                        "glosses": [
                                            "A seat, especially for one person and without armrests.",
                                            "A royal seat; a chief's throne."
