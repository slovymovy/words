                                "example_id": "0212a497-a137-4f44-89a7-a0e946481c6c",
                                "sense_id": "51895f2b-16ad-3a6a-a01b-60c3d76244dc",
                                "text": "Die Beschlüsse des Gemeinderates werden im Amtsblatt der Gemeinde veröffentlicht."
                            },
                            {
                                "example_id": "50c9bea8-9666-4443-98eb-af096a81f9a0",
                                "sense_id": "51895f2b-16ad-3a6a-a01b-60c3d76244dc",
                                "text": "Das Amtsblatt der Europäischen Union ist die maßgebliche Quelle für EU-Recht."
                            },
                            {
                                "example_id": "dfc4723b-cb45-412c-a0f5-b334fc9a350d",
                                "sense_id": "51895f2b-16ad-3a6a-a01b-60c3d76244dc",
                                "text": "„Leider enthält das Amtsblatt keine Angaben, welche Postanstalten der neuen OPD zugeordnet worden sind.“"
                            }
                        ],
