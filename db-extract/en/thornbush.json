                    },
                    {
                        "translation_id": "127855fa-ab98-410d-8558-2c13c72021e4",
                        "source_entry_id": "e8971789-b49e-309a-baa3-fb89c4d6dc34",
                        "source_sense_id": "b6738e7b-941c-3c7f-bf72-f2f2531eaa90",
                        "source_sense_description": "thorny shrub or bush",
                        "target_lang_word": "épineux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db0852fb-e36d-3fdf-8bf0-e6b07faf66a9",
                                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                                        "glosses": [
                                            "Qui a des épines, des piquants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf462008-5b89-4ed4-9e33-0edd2be3e890",
                                                "sense_id": "db0852fb-e36d-3fdf-8bf0-e6b07faf66a9",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                                        "glosses": [
                                            "Qui est plein de difficultés, d’embarras, de contrariétés, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a16508c-b372-4d2d-bbab-57d15da9510c",
                                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                                "text": "– La montée au temple de la Fortune qui se présente à vous est une des moins épineuses que j’aie vues."
                                            },
                                            {
                                                "example_id": "60064267-280f-4c0e-9939-20844325ad25",
                                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                                "text": "En vacances, il me dictait des textes épineux, choisis d’ordinaire chez Victor Hugo."
                                            },
                                            {
                                                "example_id": "62e0e1b6-b28b-4bc1-b481-d4d722e183e0",
                                                "sense_id": "173653be-d620-3dfb-868d-42d9660b9a38",
                                                "text": "La question d’argent devient épineuse. Je ne peux plus vivre que pauvrement dans cette grande ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aaa1464-b5bb-3365-8fa2-471f05d3c50f",
                                        "entry_id": "d1122a2d-b283-3184-923e-c96c02b23575",
                                        "glosses": [
                                            "Qui fait des difficultés sur tout, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce8cd67-7148-47c0-92f4-720fdeffbf42",
                                                "sense_id": "9aaa1464-b5bb-3365-8fa2-471f05d3c50f",
                                                "text": "Il est désagréable d’avoir affaire à lui, il est trop épineux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e819c171-4274-3453-ae5f-1f3f232c633c",
                                        "entry_id": "01f4c3db-8f8a-367b-9ed0-386d45e1ab75",
                                        "glosses": [
                                            "Arbres ou arbustes à épines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a252d3be-54d9-45fa-85fa-d36acbadcb63",
                                                "sense_id": "e819c171-4274-3453-ae5f-1f3f232c633c",
                                                "text": "J’avais le souvenir d’avoir noté la veille, en dépit de l’obscurité, que des massifs d’épineux encadraient ma hutte et que, devant, une immense clairière s’enfonçait dans le secret de la nuit."
                                            },
                                            {
                                                "example_id": "4528845c-0cf7-47fd-8ca4-3e080c30a205",
                                                "sense_id": "e819c171-4274-3453-ae5f-1f3f232c633c",
                                                "text": "Des plantes bulbeuses avaient eu le temps de s'installer, il y avait des lianes, des arbustes en grande quantité dont beaucoup d’épineux traduisaient le stade classique de la friche armée et puis des jeunes arbres qui poussait à la faveur de cette friche armée."
                                            },
                                            {
                                                "example_id": "fe6f4ada-5069-4c28-8100-d425a6210f84",
                                                "sense_id": "e819c171-4274-3453-ae5f-1f3f232c633c",
                                                "text": "La piste était cahoteuse, et des épineux raclaient contre les portières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2ebcb8f-099c-461f-82ae-ced278820b82",
                        "source_entry_id": "e8971789-b49e-309a-baa3-fb89c4d6dc34",
                        "source_sense_id": "b6738e7b-941c-3c7f-bf72-f2f2531eaa90",
                        "source_sense_description": "thorny shrub or bush",
                        "target_lang_word": "bruyère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruyère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d17d7fa-409e-38b4-85d1-31ec4b9f1fcb",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Plante ligneuse du genre Erica, dont le feuillage est toujours vert et qui croît dans des terrains incultes et sablonneux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b9864a-3541-4089-9b2c-4ec248447a48",
                                                "sense_id": "0d17d7fa-409e-38b4-85d1-31ec4b9f1fcb",
                                                "text": "Le rucher se composait de 75 ruches avec 10 à 12 k. d'abeilles. La récolte se faisait sur une petite bruyère, dite la grelotteuse (Erica cinerea). Le miel récolté était si clair, que le fond du seau en était visible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Nom donné à plusieurs autres plantes de la famille des Éricacées appartenant aux genres Bruckenthalia, Calluna (les callunes), Daboecia et Pentapera entre autres."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8d204f-e84b-433c-84e6-aa9d3934bc50",
                                                "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                                "text": "On commence d'abord par nettoyer le sol en arrachant les ronces, les épines, les bruyères, etc., puis on procède à l'abatage du taillis."
                                            },
                                            {
                                                "example_id": "8683cfe2-9902-4935-8a36-d671eb7eb97a",
                                                "sense_id": "52da2da4-04e0-3ca6-990b-cbc9e1952fb8",
                                                "text": "Si cela a brûlé très fort, il peut y avoir de l’installation de mousse pendant quelques années, avec des tapis parfois denses qui vont empêcher des graines de bruyère, d’ajonc ou des graminées de venir recoloniser tout de suite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                        "entry_id": "b91c7902-2b25-3dae-8029-29265f8e15a2",
                                        "glosses": [
                                            "Lieu où croissent ces plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6f30d1-1cc9-47db-8adf-98c6980dbf7d",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "La bruyère spongieuse à Erica Tetralix est souvent en continuité avec des petits ilots de l'association à Schœnus établis dans la zone des marnes supra-gypseuses et l'on constate alors , à la marge des deux groupements un mélange de leurs éléments respectifs."
                                            },
                                            {
                                                "example_id": "323f7dfd-6b5c-410e-837e-11e545242391",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Hervé ne croyait pas aux fées, et du reste si, comme l’affirment les Cornouaillais, les fées se promènent au clair de lune sur les bruyères désertes, personne ne les a jamais vues naviguer."
                                            },
                                            {
                                                "example_id": "319a0cf3-a7cc-4059-8640-7be623bbee71",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Son casse-pierres sur l’épaule, le carnier de toile, bourré d’un morceau de pain bis, sur le dos, il dévala la bruyère, prit la route."
                                            },
                                            {
                                                "example_id": "3186110a-99f2-4952-ab86-ca7011ab8133",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "La plus grande métairie en superficie était Mauvy : 140 hectares environ, mais la surface labourable ne représentait que 18 % des terres (25 hectares), car l'essentiel était constitué de bruyères (72 hectares), de pâtures (24 hectares) et de taillis (14,3 hectares)."
                                            },
                                            {
                                                "example_id": "0fabf01f-5b7c-4611-ba94-23098d974c98",
                                                "sense_id": "c5fde513-bf64-3165-be28-1f481d2c49a1",
                                                "text": "Les petites filles se levaient à cinq heures, balayaient, surveillaient le déjeuner, prenaient une leçon d’anglais avec leur père et une leçon de couture avec leur tante ; le reste du temps, c’était la promenade sur la bruyère, la lente promenade toujours recommencée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ded97dfd-d752-4881-abe0-7efc4f3d9bec",
                        "source_entry_id": "e8971789-b49e-309a-baa3-fb89c4d6dc34",
                        "source_sense_id": "b6738e7b-941c-3c7f-bf72-f2f2531eaa90",
                        "source_sense_description": "thorny shrub or bush",
                        "target_lang_word": "Dornbusch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dornbusch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                        "entry_id": "610221ed-465e-3791-a688-f2f7fa21b238",
                                        "glosses": [
                                            "ein Busch oder ein Strauch mit Dornen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef43b0c-c113-46ce-ae1a-095b832af4e0",
                                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                                "text": "„Beiras bewohnen in kleinen Rudeln trockenes, steiniges Berg- u. Hügelland mit niedrigen Dornbüschen in Somalia (Afrika).“"
                                            },
                                            {
                                                "example_id": "3555454b-3453-4b5e-a872-4a16c10e5275",
                                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                                "text": "„Durch teils bergiges Gelände, mit Dornbüschen bewachsene Steppen und bewaldetes Gebiet dringt er nun immer weiter nach Westen vor.“"
                                            },
                                            {
                                                "example_id": "583911ef-eef1-486f-8543-fd0e0678ec84",
                                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                                "text": "„Er fand die Stiefel zwischen Plunder und versteckte sie unter einem Dornbusch vierzehn Tage lang, ehe er weglief.“"
                                            },
                                            {
                                                "example_id": "11ec3e83-7619-45a3-b63a-7a0aec74807e",
                                                "sense_id": "d9cb4314-9542-3ed1-ae5a-d94a40b3ebc8",
                                                "text": "„Ein blühender Dornbusch breitete seine rosa Rispen aus, und schwer hingen die Fliederdolden herab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
