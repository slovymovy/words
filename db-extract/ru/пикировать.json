        "fr-extract.jsonl": [
            {
                "entry_id": "48175c36-7cac-3b9d-a601-f96873e98db4",
                "word": "пикировать",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc78348f-2a34-3947-a6f1-8d7d34ebc904",
                        "entry_id": "48175c36-7cac-3b9d-a601-f96873e98db4",
                        "glosses": [
                            "Piquer, piquer du nez, plonger vers le bas, en parlant d’un avion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57763d76-87f9-4c17-9ce7-07e03ed601a2",
                                "sense_id": "bc78348f-2a34-3947-a6f1-8d7d34ebc904",
                                "text": "Как ни странно, но совсем другие, не сельскохозяйственные мысли одолевают меня, когда я пикирую над этими озерками или на бреющем полёте сею пшеницу.",
                                "translation": "Curieusement, des pensées complètement différentes et non agricoles me submergent lorsque je plonge au-dessus de ces lacs ou que je sème du blé lors d’un vol à basse altitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f636171-2e05-3bde-a08b-e5390a97b860",
                        "entry_id": "48175c36-7cac-3b9d-a601-f96873e98db4",
                        "glosses": [
                            "Fondre sur sa proie, en parlant d’un rapace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9382a97a-1db4-407d-9ebb-199d05e1c65f",
                                "sense_id": "6f636171-2e05-3bde-a08b-e5390a97b860",
                                "text": "Инструктор по соколиной охоте уже сообщил, что некоторые соколы способны пикировать на добычу со скоростью 300 километров в час.",
                                "translation": "Un instructeur de fauconnerie a déjà rapporté que certains faucons sont capables de fondre sur une proie à une vitesse de 300 kilomètres à l’heure."
                            }
                        ]
                    }
                ],
