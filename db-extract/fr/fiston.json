                    },
                    {
                        "form_id": "40214a0e-ad45-4bcf-a4ab-388cca90a25e",
                        "entry_id": "5d67245b-8280-30a0-80be-882915c5e410",
                        "tags": [
                            "feminine"
                        ],
                        "form": "fistonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bdebf02-e37f-30f9-9624-2aba87ae8a6d",
                        "entry_id": "5d67245b-8280-30a0-80be-882915c5e410",
                        "glosses": [
                            "Fils."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "05d80b6d-18be-4a0e-ad22-a6fe075a6d93",
                                "sense_id": "7bdebf02-e37f-30f9-9624-2aba87ae8a6d",
                                "text": "Et il devient quoi ton fiston ?"
                            },
                            {
                                "example_id": "7f960493-7028-41a2-ad63-293558701369",
                                "sense_id": "7bdebf02-e37f-30f9-9624-2aba87ae8a6d",
                                "text": "Plein de bonheur à vous, ma fistonne et mon gendre !"
                            }
                        ]
                    },
                    {
                        "sense_id": "221b9054-6abe-3ee1-bb1e-a0f2f3e8a93e",
                        "entry_id": "5d67245b-8280-30a0-80be-882915c5e410",
                        "glosses": [
                            "Appellatif affectueux pour s'adresser à un garçon ou une fille plus jeune que soi."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d00f26d0-cbd1-42d4-b5e1-f37e05457453",
                                "sense_id": "221b9054-6abe-3ee1-bb1e-a0f2f3e8a93e",
                                "text": "Alors fiston, quoi de neuf ?"
                            },
                            {
                                "example_id": "791dad0d-220c-4107-8276-2aae644efabc",
                                "sense_id": "221b9054-6abe-3ee1-bb1e-a0f2f3e8a93e",
                                "text": "Bon, fistonne, t’as perdu ta langue ?"
                            },
                            {
                                "example_id": "10dca25d-6773-4901-82a0-2462b59b257f",
                                "sense_id": "221b9054-6abe-3ee1-bb1e-a0f2f3e8a93e",
                                "text": "Dieu de Dieu, mon fiston, quel dommage de ne plus avoir ses vingt ans !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be8f87fa-79f3-4484-89ec-7737dfb7b0c5",
                        "source_entry_id": "5d67245b-8280-30a0-80be-882915c5e410",
                        "target_lang_word": "sonny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfaaad12-76cb-3fa3-8510-8c188364cf37",
                                        "entry_id": "d71098c3-7268-3a86-93b5-f7312d72ee06",
                                        "glosses": [
                                            "A familiar form of address for a boy."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0346712-6a7e-3314-9721-44b60eb25d82",
                                        "entry_id": "d71098c3-7268-3a86-93b5-f7312d72ee06",
                                        "glosses": [
                                            "Form of address to a boy or man, to express contempt, warning etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "063f00ea-8b4a-4f2a-b698-e29575cab4e9",
                        "source_entry_id": "5d67245b-8280-30a0-80be-882915c5e410",
                        "target_lang_word": "lad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15412081-6183-3643-a6f3-647ec596d5cc",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "A boy or young man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05aceb20-cc18-4a90-89d2-4bc35c05241f",
                                                "sense_id": "15412081-6183-3643-a6f3-647ec596d5cc",
                                                "text": "How great is that danger, to which poor lads are now exposed, when placed on shipboard to learn the art of sailing! Five lads, training up for the seas, were now on board this ship; […]"
                                            },
                                            {
                                                "example_id": "87f94a52-3fed-4dbe-a94f-7646eb99c8f3",
                                                "sense_id": "15412081-6183-3643-a6f3-647ec596d5cc",
                                                "text": "The lad, his son, had obtained a Jew's-harp, and learned to play upon it the profane airs of \"Yankee Doodle,\" \"Hail Columbia,\" \"St. Patrick's Day,\" and \"Auld Lang Syne.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ed9bd0-fa94-3340-9aaf-ac6335c84158",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "A hedonistic or irresponsible young man; A Jack the lad."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13c2e32-33c8-498c-a972-d4ccec1dd543",
                                                "sense_id": "82ed9bd0-fa94-3340-9aaf-ac6335c84158",
                                                "text": "I think he reckons he’s a bit of a lad."
                                            },
                                            {
                                                "example_id": "f7ea2cf2-6e39-49c5-9f0a-9d36dcb08c9e",
                                                "sense_id": "82ed9bd0-fa94-3340-9aaf-ac6335c84158",
                                                "text": "Last night I was out drinking with the lads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81b5950-9aac-379a-ab47-ff0e34ee4314",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "A familiar term of address for a young man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aafc6e7-c175-46a7-9372-b3f42044f8c9",
                                                "sense_id": "c81b5950-9aac-379a-ab47-ff0e34ee4314",
                                                "text": "Come here, lad, and help me shift these boxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe8ccad6-b103-36c8-83a6-ed0b15309ad6",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "A groom who works with horses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7fd3697-ffaf-35c0-8560-2e925e3667dd",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e255a8ed-1308-402b-b541-b296578968b5",
                                                "sense_id": "d7fd3697-ffaf-35c0-8560-2e925e3667dd",
                                                "text": "— The lad stood to attention anyhow, he said with a sigh. She's a gamey mare and no mistake."
                                            },
                                            {
                                                "example_id": "cf338b52-ef45-4c74-ad12-96e9eddadf5d",
                                                "sense_id": "d7fd3697-ffaf-35c0-8560-2e925e3667dd",
                                                "text": "Mrs Glynn: Oh but there's this great bit in it. You see, there was this girl, but then you find out it's not a girl but a man!\nMrs Sheridan: And he got his lad out."
                                            },
                                            {
                                                "example_id": "7a115054-c916-4203-a27c-207d95e4effd",
                                                "sense_id": "d7fd3697-ffaf-35c0-8560-2e925e3667dd",
                                                "text": "And he loaded the chariot with clods and boulders and cobbles that he fired at anyone who came to stare at him and jeer him, stark naked as he was, with his long lad and his acorns dangling down through the floor of the chariot."
                                            },
                                            {
                                                "example_id": "47584e51-edef-4b07-8694-8a2d6ee2ff72",
                                                "sense_id": "d7fd3697-ffaf-35c0-8560-2e925e3667dd",
                                                "text": "Just thinking about how she would look without her clothes made his lad twitch with anticipation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad3e845-950f-3243-8312-0fd9d42a8eda",
                                        "entry_id": "a6874a97-36e7-390d-a25d-761e4fa0954c",
                                        "glosses": [
                                            "A scammer."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aebfd279-e50a-4136-9a48-52f2255075fb",
                                                "sense_id": "7ad3e845-950f-3243-8312-0fd9d42a8eda",
                                                "text": "[...] regardless whether you feel the lads may deserve to be subjected to those types of images."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb22fc17-281c-411a-baee-f6143689f39c",
