                "senses": [
                    {
                        "sense_id": "0ad4d7db-a783-3b03-aaba-bbcc9601478d",
                        "entry_id": "c7c69a98-517b-3aca-815a-6f47e05019b5",
                        "glosses": [
                            "Geräusch, das von laufenden Schrauben von Schiffen oder anderen maritimen Geräten ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8203b33-7377-4622-9a5a-e7e50030a6d6",
                                "sense_id": "0ad4d7db-a783-3b03-aaba-bbcc9601478d",
                                "text": "„Nach gut zwei Stunden wurden die Schraubengeräusche des Kanonenboots leiser, es entfernte sich.“"
                            },
                            {
                                "example_id": "df6badd3-1066-4bd5-adfc-91862aa2fd65",
                                "sense_id": "0ad4d7db-a783-3b03-aaba-bbcc9601478d",
                                "text": "„Im Kopfhörer summte es wie in einem Bienenkorb, doch Schraubengeräusche waren nicht zu hören.“"
                            },
                            {
                                "example_id": "fc9a6e78-19a2-4c11-bbea-afefbd7a2d61",
                                "sense_id": "0ad4d7db-a783-3b03-aaba-bbcc9601478d",
                                "text": "„Nicht nur auf Wale und Fische hat Unterwasserlärm negative Auswirkungen, auch Strandkrabben fühlen sich durch Schiffsgetöse offenbar gestresst. Dazu genügt schon das Schraubengeräusch vorbeifahrender Wasserfahrzeuge, berichten Biologen im Fachjournal \"Biology Letters\" der britischen Royal Society.“"
                            },
                            {
                                "example_id": "556743d7-e07f-4d5f-af0b-2a80aa892c01",
                                "sense_id": "0ad4d7db-a783-3b03-aaba-bbcc9601478d",
                                "text": "„Da meldet der Horcher Schraubengeräusche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
