                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2747dcb3-43aa-4102-a39f-2d61dd139184",
                                "sense_id": "5441b888-51d7-3585-934c-472ac0013a58",
                                "text": "Die letzten Bilder, die von der Flüchtlingskrise an Polens Ostgrenze über die Bildschirme flimmerten, zeigten eine Gruppe von 32 frierenden Afghanen – darunter vier Frauen, ein 15-jähriges Mädchen und ein 17-jähriger Junge – die den polnischen Soldaten immer wieder auf Englisch zuriefen: „Wir wollen internationalen Schutz!“"
                            }
                        ]
                    },
                    {
                        "sense_id": "4182fc84-4b96-3701-840f-b4c271840631",
                        "entry_id": "43e2838f-ac9b-3723-a795-91de4451822f",
                        "glosses": [
                            "the 2015 European migrant crisis"
                        ],
                        "tags": [
                            "feminine",
