                    {
                        "sense_id": "1017af94-3983-3702-84a9-e9dd66dd6a96",
                        "entry_id": "48b0e60e-c597-3989-8654-f0c8e7803866",
                        "glosses": [
                            "płaskie naczynie do wypieków i pieczeni, czasem o owalnym kształcie, zwykle z przykrywką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e56969-e33b-47f5-a9c1-3b6333252572",
                                "sense_id": "1017af94-3983-3702-84a9-e9dd66dd6a96",
                                "text": "Na patelni smażyła się młoda papuga, a na brytfannie piekł się zajączek, naszpikowany słoniną."
                            },
                            {
                                "example_id": "779fd6f1-8e09-4ab4-b42d-c5c65778902a",
                                "sense_id": "1017af94-3983-3702-84a9-e9dd66dd6a96",
                                "text": "Pan kucharz kaczkę starannie • Piekł, jak należy, w brytfannie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
