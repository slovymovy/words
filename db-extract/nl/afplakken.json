                "entry_id": "c9a4a1a4-5bea-35eb-8bdd-7f6beb6af1b9",
                "word": "afplakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76cc9f70-39ab-3a82-90c5-1ca088d69ab4",
                        "entry_id": "c9a4a1a4-5bea-35eb-8bdd-7f6beb6af1b9",
                        "glosses": [
                            "dichtmaken door er iets op te plakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d8086c-d9c5-42d5-8f85-be7b4f01c96e",
                                "sense_id": "76cc9f70-39ab-3a82-90c5-1ca088d69ab4",
                                "text": "Alle ramen van de donkere kamer zijn afgeplakt met verduisteringspapier"
                            },
                            {
                                "example_id": "5bb990be-1b59-40bb-9a67-8dbdabb09d24",
                                "sense_id": "76cc9f70-39ab-3a82-90c5-1ca088d69ab4",
                                "text": "Edward Snowden kennen we als die frêle, kalme jongeman die in documentaire Citizenfour van Laura Poitras de surveillancejungle van de Amerikaanse overheid blootlegde. Het is nog even de vraag wat dat heeft veranderd, al weten wij nu wel dat je soms beter je webcam kan afplakken."
                            }
                        ]
                    },
                    {
                        "sense_id": "bddd5c58-7993-3372-9e77-641e5bb144ec",
                        "entry_id": "c9a4a1a4-5bea-35eb-8bdd-7f6beb6af1b9",
                        "glosses": [
                            "het voltooien van het plakken om daarna weer wat anders te kunnen doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2e9135-ec50-4cf2-b2e0-47f96e23f83a",
                                "sense_id": "bddd5c58-7993-3372-9e77-641e5bb144ec",
                                "text": "Als we zijn afgeplakt kunnen we weer gaan schilderen."
                            }
                        ]
                    }
                ],
