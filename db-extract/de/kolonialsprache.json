                ],
                "senses": [
                    {
                        "sense_id": "88591bc2-6d68-302d-afc4-470aaca5a1d7",
                        "entry_id": "06e9906a-3f7f-3c41-9357-30ff8f43db92",
                        "glosses": [
                            "Sprache von Kolonisatoren, die für die Kommunikation in ihrer Kolonie eine dominierende Rolle spielt; bisweilen wurden spezielle Kolonialsprachen als reduzierte Sprachformen gezielt entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e9f46c-a1ee-4e87-928d-f1bd39ca1827",
                                "sense_id": "88591bc2-6d68-302d-afc4-470aaca5a1d7",
                                "text": "Über E. Schwörer: „Er propagierte 1916 das von ihm benannte ‚Kolonialdeutsch‘ in der gleichnamigen Veröffentlichung mit dem Untertitel ‚Vorschläge einer künftigen deutschen Kolonialsprache in systematisch-grammatikalischer Darstellung und Begründung‘.“"
                            },
                            {
                                "example_id": "26cbf71c-59cf-4e62-80af-b80aed9fd524",
                                "sense_id": "88591bc2-6d68-302d-afc4-470aaca5a1d7",
                                "text": "„Als Folge ihrer Ausbreitung in den Regionen Italiens übte die römische Kolonialsprache einen assimilatorischen Druck auf alle anderen Sprachen aus…“"
                            },
                            {
                                "example_id": "1f122fce-b9c8-4956-a28b-cc42b5e78644",
                                "sense_id": "88591bc2-6d68-302d-afc4-470aaca5a1d7",
                                "text": "„In Nürnberg wird in jener oberdeutsch-ostmitteldeutschen Kolonialsprache gedruckt, die wir bereits bei Erörterung der Kanzleisprachen kennengelernt haben und für die eine einheitliche Dialektbezeichnung fehlt.“"
                            },
                            {
                                "example_id": "febfe9ac-1d87-47a5-9bd8-9cbc2972bf59",
                                "sense_id": "88591bc2-6d68-302d-afc4-470aaca5a1d7",
                                "text": "„Die kamerunischen Zwischenhändler hatten sich mit den Engländern in dieser Kolonialsprache ausgetauscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
