                                                "sense_id": "c902a1a9-75c7-36ff-bc50-2d9069600b3a",
                                                "text": "When a turkey vulture detects the scent of rot, it circles down, tracing the plume of chemicals to its source."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6e1674-29b2-3c88-8873-e12fa07c8794",
                                        "entry_id": "b31fdb40-7460-3dc9-8c86-7925a8fe2328",
                                        "glosses": [
                                            "Any of several diseases in which breakdown of tissue occurs."
                                        ],
