                    {
                        "sense_id": "cdb16e78-05b6-3b82-b57e-89a73fe74d7b",
                        "entry_id": "ebac9b73-a039-3dce-8fb3-7f159b512fdf",
                        "glosses": [
                            "Oiseau appartenant au genre Uraeginthus, petit passereau originaire d’Afrique, souvent élevé en captivité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863f632c-52f5-4bbb-aecd-cd20bb25aa79",
                                "sense_id": "cdb16e78-05b6-3b82-b57e-89a73fe74d7b",
                                "text": "Le Cordonbleu cyanocéphale, un petit oiseau chanteur, séduit son partenaire grâce à ses pas de danse invisibles à l'œil nu."
                            },
                            {
                                "example_id": "e9a79dfa-263e-4b48-86b1-a94b36efbba6",
                                "sense_id": "cdb16e78-05b6-3b82-b57e-89a73fe74d7b",
                                "text": "On connaît 5 espèces de Cordonbleus, parmi lesquelles se trouvent trois \"petites\" espèces à dominante bleue, traditionnellement dénommées \"Cordons-bleus\", et deux \"grandes\" espèces très colorées, connues jadis sous le nom de \"Grenadins\"."
                            }
                        ]
                    }
