                                        "entry_id": "840c0d0d-aa7f-324f-b68e-a5e63c70832c",
                                        "glosses": [
                                            "Pertaining to a German populist, identity-nationalist or ethnonationalist ideology found since the late 19th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7ee6f4-6330-4493-b624-3fd3c314a97c",
                                                "sense_id": "f86fd016-35b6-33c9-88fa-56c7d4a5d90f",
                                                "text": "It is led by Björn Höcke, who is considered to be part of the AfD’s far right or völkisch wing, which was officially disbanded but is still widely believed to exist."
                                            }
                                        ]
