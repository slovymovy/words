                    {
                        "translation_id": "1855f40f-9f5d-4dde-ada4-36782e8b7417",
                        "source_entry_id": "63f6ee65-fa7a-3f4d-a2b8-1c6894495a49",
                        "source_sense_description": "bodily feeling",
                        "target_lang_word": "ongesteldheid",
