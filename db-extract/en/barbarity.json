                    {
                        "translation_id": "c081fb5f-09de-445d-a2ec-7cda5f69ab0d",
                        "source_entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                        "source_sense_description": "state of being barbarous",
                        "target_lang_word": "barbarij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6af6ac5-7456-33f5-a35d-818dd120581b",
                                        "entry_id": "e55cb316-0f23-34e5-a8cb-7894bd5f128e",
                                        "glosses": [
                                            "barbaarsheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a4c8dd-e023-4a3d-8ce3-292f2561696d",
                                                "sense_id": "b6af6ac5-7456-33f5-a35d-818dd120581b",
                                                "text": "Een lichtpuntje was dat Finland er veel beter vanaf was gekomen dan de buurlanden Estland, Letland en Litouwen, die waren opgeslokt door de barbarij en veranderd in Sovjetrepublieken."
                                            },
                                            {
                                                "example_id": "6facf0a9-0281-4405-bd3f-3882421daa63",
                                                "sense_id": "b6af6ac5-7456-33f5-a35d-818dd120581b",
                                                "text": "Europa ziet de Verenigde Staten wegzakken in barbarij, met een president die gerechtelijke uitspraken gewoon negeert. Alleen Europa staat nog voor mensenrechten, democratische waarden en principes, heet het."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d6d96fd-d61c-49c3-956a-17096263562b",
                        "source_entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                        "source_sense_description": "state of being barbarous",
                        "target_lang_word": "barbaarsheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbaarsheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e213d29f-a832-3b1e-8a0e-e2a6c3ff6622",
                                        "entry_id": "5788fa8e-0b87-3fb1-b4f2-32add52e745d",
                                        "glosses": [
                                            "de gruwelijkheid, wreedheid en achterlijkheid die zou passen bij onderontwikkelde mensen en volkeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1990a585-624b-4e78-8149-67b51859663b",
                                                "sense_id": "e213d29f-a832-3b1e-8a0e-e2a6c3ff6622",
                                                "text": "Het is voldoende dat een grootmacht, zoals Rusland, bekend om zijn barbaarsheid, zichzelf onbaatzuchtig aan het hoofd stelt van een bondgenootschap dat zich het evenwicht in Europa ten doel stelt en de wereld zal gered zijn!"
                                            },
                                            {
                                                "example_id": "2014d1d3-3e41-40f1-a8df-ceb654bcb4ca",
                                                "sense_id": "e213d29f-a832-3b1e-8a0e-e2a6c3ff6622",
                                                "text": "Franciscus riep in herinnering dat in de oude Egyptische beschaving de zoektocht naar kennis en een ruimdenkende opleiding hoog aangeschreven stonden. Eenzelfde houding is nu noodzakelijk, in de strijd tegen wat de paus noemt de barbaarsheid van religieus extremisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61aaf8ae-6ed1-3749-9b4e-9eea7ae8e607",
                                        "entry_id": "5788fa8e-0b87-3fb1-b4f2-32add52e745d",
                                        "glosses": [
                                            "iets wat getuigt van achterlijkheid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5c73789-e2e5-449d-9047-5713115c4b7f",
                        "source_entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                        "source_sense_description": "state of being barbarous",
                        "target_lang_word": "barbarie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Manque de civilisation, ignorance des arts, des lettres et des sciences chez un peuple, souvent étranger."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec7311e-75c6-48ab-9fdf-3040577f87fe",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "La prévention du pays, jointe à l’orgueil de la nation, nous fait oublier que la raison est de tous les climats, et que l’on pense juste partout où il y a des hommes. Nous n’aimerions pas à être traités ainsi de ceux que nous appelons barbares ; et s’il y a en nous quelque barbarie, elle consiste à être épouvantés de voir d’autres peuples raisonner comme nous."
                                            },
                                            {
                                                "example_id": "29ac247f-d794-42b8-ba2c-bd3a8a8695e0",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Mais il était poète aussi, et la poésie, à cette époque d’absolutisme et de barbarie, était chose dangereuse lorsqu’on avait l’esprit aussi caustique que Thierrat."
                                            },
                                            {
                                                "example_id": "fa7af190-5891-4ebc-8cbe-6b16e2045339",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "À la différence de la bête, l’homme est capable de se dénaturer, de renverser le cours naturel des choses, pour le meilleur – la culture – ou pour le pire – la barbarie."
                                            },
                                            {
                                                "example_id": "eb084f8a-8a56-4964-84a2-77b59d96d78e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "L’état de barbarie."
                                            },
                                            {
                                                "example_id": "2ca9b226-8698-4497-95ba-0704f8a1c9a1",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Les siècles de barbarie."
                                            },
                                            {
                                                "example_id": "1fb3154f-80ba-4719-b13a-c0cf14df28d1",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Les ténèbres de la barbarie."
                                            },
                                            {
                                                "example_id": "aa4e237b-42ee-4d13-91c6-00c70b2c25bb",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "La barbarie était grande en ce temps-là."
                                            },
                                            {
                                                "example_id": "7ca62fe9-8f3c-4702-8e47-e5dd74321d2e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Un peuple qui sort à peine de la barbarie."
                                            },
                                            {
                                                "example_id": "e9f12591-33cb-41d7-b8c5-7bb4d4a48c3e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Vivre dans un temps de barbarie."
                                            },
                                            {
                                                "example_id": "ddce459d-f0bc-4223-b6a3-bedf878c93fc",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Être plongé dans la barbarie."
                                            },
                                            {
                                                "example_id": "8530caa3-c050-40b5-ba74-db05a38b737f",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Barbarie de langage, de style, se dit des façons de parler grossières et impropres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Cruauté, inhumanité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6670f7b-65ed-49ee-a6da-5be5968aecb3",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Les ennemis acharnés qui combattent les uns contre les autres avec tous les raffinements de la barbarie ne demandent et n’accordent pas de quartier."
                                            },
                                            {
                                                "example_id": "2aadbe1e-f39f-4a61-85ba-f9b263972d08",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Ils n’ignorent rien de tout cela et savent notamment fort bien que c’est en l’affirmant qu’ils créeront cette éternité de barbarie nécessaire au maintien des institutions qui leur sont chères."
                                            },
                                            {
                                                "example_id": "15d2da73-4ee1-4e35-8d6a-57f01b9315c0",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Les barbares ne sont pas nécessairement des gens courageux : ce qui leur donne de l’audace est la passivité tremblante et soumise de ceux qui sont en face d’eux.\nJe dirais même que la passivité tremblante et soumise crée des vocations de barbares et constitue une incitation à la barbarie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Acte barbare."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2556ccb7-7176-49b6-a7b3-827a8adc4ed4",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Vous avez vu parmi ces barbaries ridicules les barbaries sanglantes des guerres de religion."
                                            },
                                            {
                                                "example_id": "d7c6a67e-6c9e-4636-a577-7b8d8cc88c1d",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Commettre une barbarie, un acte inhumain."
                                            },
                                            {
                                                "example_id": "7f4537b9-ccec-470e-a85d-516552976d71",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Tant de barbaries l’avaient rendu odieux à ses sujets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854aa513-1bc6-4d41-b03d-5c2de0d8ca53",
                        "source_entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                        "source_sense_description": "state of being barbarous",
                        "target_lang_word": "Barbarei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbarei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                        "entry_id": "24a46e2f-9931-3e8c-80c1-5d4b1890d148",
                                        "glosses": [
                                            "ungezügelte Rohheit, Vandalismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2a3d46-79de-45c4-9914-399b78c21487",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "Die Behandlung der Gefangenen erwies sich als reine Barbarei."
                                            },
                                            {
                                                "example_id": "5c8ff28d-bafa-4573-9ce8-90dd3a835500",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Ich fing an zu begreifen, weshalb die Angst, es könne zu einem Rückfall in die Barbarei kommen, viele Menschen zeitlebens begleitete.“"
                                            },
                                            {
                                                "example_id": "a031c8b8-fb68-4a35-85b2-55e673ac7707",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Bis dahin hatte Nikolai das Regime nur mit vagem Widerwillen betrachtet; nun erkannte er dessen archaische Barbarei in ihrem ganzen grauenvollen Ausmaß.“"
                                            },
                                            {
                                                "example_id": "f278db31-234c-4755-ace7-06439f855f80",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Leopolds System stellt längst jene Barbarei der Sklaverei in den Schatten, zu deren Beseitigung es vorgeblich eingerichtet worden ist.“"
                                            },
                                            {
                                                "example_id": "b8562937-15e0-40c0-863e-0a508676c353",
                                                "sense_id": "573cab09-0e89-3f64-a52f-a3df449ceef6",
                                                "text": "„Er musste schreiben, anschreiben gegen die um sich greifende Barbarei des Nationalsozialismus in der Weimarer Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                        "entry_id": "24a46e2f-9931-3e8c-80c1-5d4b1890d148",
                                        "glosses": [
                                            "Zustand der Unzivilisiertheit und des Nichtvorhandenseins von Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca91d07-3eee-4aad-8b84-7f2849b3c2ed",
                                                "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                                "text": "„Der gesellschaftlich akzeptierte und etablierte Kannibalismus, also die Barbarei erscheint als codierte Darstellung des »Dritten Reiches«.“"
                                            },
                                            {
                                                "example_id": "68ad6c5b-eb39-4de3-b0d5-c937adf06744",
                                                "sense_id": "8f250ac7-5c7d-3361-a76f-fa96a19acf34",
                                                "text": "„Weskott fand das empörend, als eine kulturelle Barbarei schlimmsten Ausmaßes, die er nicht hinzunehmen bereit war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
