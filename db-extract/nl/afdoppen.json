                    },
                    {
                        "sense_id": "95f0ec72-85d1-304d-8c6e-2cb0c5b6e21b",
                        "entry_id": "a32013d8-f342-38d6-ab77-5b114aef6f44",
                        "glosses": [
                            "afsluiten van een leiding met een dop"
