                        "source_entry_id": "2dbca939-594b-3580-baeb-1bbf474e4642",
                        "source_sense_description": "специализированное образование на конце нервного волокна, обеспечивающее передачу информации",
                        "target_lang_word": "uitgang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitgang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                        "entry_id": "cd88b9a9-b12c-3fb3-917f-43c73120e8ff",
                                        "glosses": [
                                            "een opening waar iets doorheen kan of waardoor men een ruimte verlaten kan; vaak is dit tevens een ingang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c574d1-e2bf-4288-a241-e03a0081a8da",
                                                "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                                "text": "De uitgang werd bewaakt door een bewaker."
                                            },
                                            {
                                                "example_id": "8d8074d9-ec0b-42a8-a7e5-57d20941d07a",
                                                "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                                "text": "Een van onze gedistingeerde gasten heeft mij ooit gezegd dat de monsters volgens hem niet waren bedoeld om vreemden buiten te houden, maar om de gasten te beletten de uitgang te bereiken. Het was jaren geleden dat hij dat zei, en hij is hier nog steeds. Zijn naam is Patelski. U zult hem ontmoeten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51eef4f0-6a3c-3d44-9278-0784c22befc1",
                                        "entry_id": "cd88b9a9-b12c-3fb3-917f-43c73120e8ff",
                                        "glosses": [
