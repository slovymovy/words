                                        "entry_id": "1d2f4444-9c32-3f5c-be36-bc09c3f1c76d",
                                        "glosses": [
                                            "(171) Ophélie : Astéroïde de la ceinture principale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
