                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f6a9e0-5612-43c9-aa73-b76d012199e8",
                                                "sense_id": "f9ef2694-104e-377a-bd42-ff51d69ce108",
                                                "text": "“‘Poison gas’?” A new one on Lew. But Dr. De Bottle had taken on a somber look. “Phosgene.”"
                                            },
                                            {
                                                "example_id": "804c3273-f5d7-44ef-b386-62fad55fa455",
                                                "sense_id": "f9ef2694-104e-377a-bd42-ff51d69ce108",
                                                "text": "Remote and cold, H-276 is nevertheless of interest due to phosgene gas in its thick chlorine atmosphere. This could indicate primitive chlorine-based life. However, no detailed study has been completed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c838a8c2-e4c8-4bff-ae2a-fa8b46bffaf1",
                        "source_entry_id": "e7fa0c61-280e-3ef2-b787-992a40683508",
                        "source_sense_id": "15105266-c56d-3504-9aee-47dac7577141",
                        "source_sense_description": "giftig gas met de molecuulformule COCl₂",
                        "target_lang_word": "phosgène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosgène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6175090-cbc5-36eb-8d8b-5d7564a8d883",
                                        "entry_id": "eb07f1e5-5c1e-358c-8bbf-5d88498aa54f",
                                        "glosses": [
                                            "Composé chimique gazeux au dessus de 8 °C, de formule brute CCl₂O, produit par la combinaison du chlore et du monoxyde de carbone, et qui a une action dangereuse sur les voies respiratoires."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf49d62f-d7d1-4827-a979-aa8c5d46acd7",
                                                "sense_id": "d6175090-cbc5-36eb-8d8b-5d7564a8d883",
                                                "text": "Au-dehors, une odeur douceâtre flottait dans l’air ; nous apprîmes plus tard qu’on nous avait, cette fois-ci, gratifiés de phosgène."
                                            },
                                            {
                                                "example_id": "4d8abd2c-1749-4ee6-9821-823e83351d20",
                                                "sense_id": "d6175090-cbc5-36eb-8d8b-5d7564a8d883",
                                                "text": "L’exposition à la lewisite et au phosgène provoque une douleur immédiate. Les lésions tissulaires apparaissent en quelques minutes. En cas d’exposition des yeux, il y a douleur, photophobie, larmoiement et perte d’acuité visuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
