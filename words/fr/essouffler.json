                                "target_lang_sense_clarification": "Kraft, Eifer, Bewegung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "decaer",
                                "target_lang_sense_clarification": "interés, actividad o popularidad"
                            },
                            {
                                "target_lang_word": "perder impulso",
                                "target_lang_sense_clarification": "movimiento o ritmo de algo"
                            },
                            {
                                "target_lang_word": "ir a menos",
                                "target_lang_sense_clarification": "dicho de negocios o situaciones"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "降温",
