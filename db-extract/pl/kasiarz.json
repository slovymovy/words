                                "target_senses": [
                                    {
                                        "sense_id": "a41011c9-89d4-3743-8866-5ef502c9d42d",
                                        "entry_id": "745c7938-4650-3b1d-b517-7411bd442e6d",
                                        "glosses": [
                                            "One who breaks into safes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e3d459-1812-4ea6-a9f6-1559fd82b91d",
                                                "sense_id": "a41011c9-89d4-3743-8866-5ef502c9d42d",
                                                "text": "His fingers were slender and delicate, an evolutionary advantage for a safecracker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c9d2b8-5ff9-4f29-be86-e2e2330168e6",
                        "source_entry_id": "39c2f8d0-2f74-3d4a-b02f-c54d7ff5ab41",
                        "source_sense_id": "8c908740-41d1-3db1-a8d3-111ec910068d",
                        "target_lang_word": "yegg",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yegg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90c15e66-1721-356d-b042-85f636bb559b",
                                        "entry_id": "be59d347-8b28-3f6a-81cb-a3a123f0e7ef",
                                        "glosses": [
                                            "A person who breaks open safes; a burglar."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87d37fa8-6148-4b43-b092-eccdd1c9f22a",
                                                "sense_id": "90c15e66-1721-356d-b042-85f636bb559b",
                                                "text": "1904, Edwin S. Porter (director), Capture of the ‘Yegg’ Bank Burglars"
                                            },
                                            {
                                                "example_id": "8ab7e993-0c11-40c9-8d7b-150ae62ea715",
                                                "sense_id": "90c15e66-1721-356d-b042-85f636bb559b",
                                                "text": "She was frankly disappointed. For some reason she had expected to discover a burglar of one or another accepted type—either a dashing cracksman in full-blown evening dress, lithe, polished, pantherish, or a common yegg, a red-eyed, unshaven, burly brute in the rags and tatters of a tramp."
                                            },
                                            {
                                                "example_id": "f80466dd-988f-4439-9928-fc8cae10ca65",
                                                "sense_id": "90c15e66-1721-356d-b042-85f636bb559b",
                                                "text": "‘These racketeers are a new type. We think about them the way we think about old time yeggs or needled-up punks.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yegg",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7af07a0-f445-366c-9003-1d6c85c7ed60",
                                        "entry_id": "bd4e94ab-d733-3b0b-b755-6576211f64e4",
                                        "glosses": [
                                            "To rob."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6491ad-978f-47ca-a7e1-199566040716",
                                                "sense_id": "c7af07a0-f445-366c-9003-1d6c85c7ed60",
                                                "text": "The bookmakers were yegged as they left the track in the era of the hand-books."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
