            {
                "entry_id": "cd027520-0406-384a-b612-957dfd594c4a",
                "word": "uphand",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ef37b12-c6cd-3e97-a83e-891060aef2bb",
                        "entry_id": "cd027520-0406-384a-b612-957dfd594c4a",
                        "glosses": [
                            "The upper hand."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b9a43f83-7b78-4118-854d-20f0efb45161",
                                "sense_id": "9ef37b12-c6cd-3e97-a83e-891060aef2bb",
                                "text": "Such monsters as these have all been, Our fathers and mothers have known : If that they should get the uphand, Us Protestants they would all smother"
                            },
                            {
                                "example_id": "c6489041-efc7-4c48-8789-6a3f89a27b99",
                                "sense_id": "9ef37b12-c6cd-3e97-a83e-891060aef2bb",
                                "text": "Or else to death he had been dight, While th' house of York had the uphand."
                            },
                            {
                                "example_id": "d6cc49a4-1c08-45fe-b984-a100e8df2069",
                                "sense_id": "9ef37b12-c6cd-3e97-a83e-891060aef2bb",
                                "text": "Politics seem to have had an uphand over business..."
                            }
                        ]
                    }
                ],
