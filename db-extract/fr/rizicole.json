            {
                "entry_id": "34271904-2199-3258-b6e6-8ecf64229334",
                "word": "rizicole",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                        "entry_id": "34271904-2199-3258-b6e6-8ecf64229334",
                        "glosses": [
                            "Qui a rapport à la culture du riz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b060147-9e98-4cd3-9f20-57e3648d2b5b",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Une partie de l’industrie rizicole est disséminée dans toutes les régions productrices."
                            },
                            {
                                "example_id": "bbf89e75-3bf9-4d13-a6da-55082371e235",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Grâce à une politique rizicole dynamique, les Philippines sont devenues exportateur."
                            },
                            {
                                "example_id": "41b5f864-c058-4a7d-81ab-34ca25ed346c",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Un des plus anciens bassins de la production rizicole africaine, datant de plus d'un millénaire, selon Portères (1950), accueille actuellement une grande quantité de riz importée des USA et d’Asie."
                            },
                            {
                                "example_id": "c4ad4632-f638-4171-8f22-12d995351b56",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Elle s’établit actuellement autour de 230 000 hectares , soit la moitié environ de la superficie rizicole de cinq pays , contre 165 000 au début de la décennie."
                            },
                            {
                                "example_id": "8cb48bf9-7837-4fcd-820c-fb45575a41d7",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Tananarive fut conçue comme le centre d’une plaine rizicole."
                            },
                            {
                                "example_id": "197b87af-623b-4eb9-aadd-bec764f6f80d",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "L'endettement – amplifié par la dégradation du contexte rizicole, suite à la dévaluation du franc CFA le 12 janvier 1994, puis à la libéralisation de cette filière – barre la route du crédit aux membres de nombreux périmètres irrigués."
                            },
                            {
                                "example_id": "4f1e5bfd-14fc-4f07-8e38-e6cfdc60386e",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Cependant, une grande partie des habitants travaille principalement dans le secteur rizicole qui assure les principaux emplois et les revenus."
                            },
                            {
                                "example_id": "1d8f0669-9c34-48be-ac3d-fa4a5030d3e6",
                                "sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
                                "text": "Au XIXᵉ siècle, Valence est la plus importante région rizicole d’Espagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ce64d83-f07e-476d-a7dd-9edea38fa0f9",
                        "source_entry_id": "34271904-2199-3258-b6e6-8ecf64229334",
                        "source_sense_id": "7c88a366-689b-3142-a5a8-0cba14be03c2",
