                                    },
                                    {
                                        "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "An arrangement between people to meet; an engagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "947bfe06-de57-4a2a-8fd3-e4df2fb304e8",
                                                "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                                "text": "They made an appointment to meet at six."
                                            },
                                            {
                                                "example_id": "cf3ce2a0-6d96-4c68-b764-e9b9bc549e64",
                                                "sense_id": "75fffd76-737b-3f25-8c27-bb08796b2839",
                                                "text": "I’m leaving work early because I have a doctor’s appointment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "Decree; direction; established order or constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7718d-fe99-425c-bb97-884665f29937",
                                                "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                                "text": "to submit to the divine appointments"
                                            },
                                            {
                                                "example_id": "b1d58f47-1951-4025-831b-bc922362b012",
                                                "sense_id": "edfb5c1a-abb7-320c-9ee3-c1291563f5e3",
                                                "text": "According to the appointment of the priests."
