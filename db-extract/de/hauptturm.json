                "senses": [
                    {
                        "sense_id": "d1d13bc4-dfd3-3bd8-a1bd-90b16761a786",
                        "entry_id": "0481090e-a668-3d19-b7a8-6e5dd6b98d6e",
                        "glosses": [
                            "aufgrund seiner Größe oder Lage zentraler, wichtigster Turm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5526706d-ee9f-4565-939e-e40b882a0c10",
                                "sense_id": "d1d13bc4-dfd3-3bd8-a1bd-90b16761a786",
                                "text": "„Massenerschießungen sind mittlerweile auf alarmierende Weise weit verbreitet und anders geartet als Charles Whitmans Mordserie, die er 1966 vom Dach des Hauptturms der University of Texas aus unternahm.“"
                            },
                            {
                                "example_id": "9a53f6f2-8ef3-4ea6-a200-9d945d67753b",
                                "sense_id": "d1d13bc4-dfd3-3bd8-a1bd-90b16761a786",
                                "text": "„Sie bogen abermals um eine Ecke, und dann öffnete Hiromatsu plötzlich eine eisenbeschlagene Tür und stieg eine Steintreppe hinan, die zum Hauptturm dieser Befestigungsanlage hinaufführte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
