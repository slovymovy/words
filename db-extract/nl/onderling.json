                                        "glosses": [
                                            "In the same way, each to the other; reciprocally"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead45f6f-5504-4feb-bc18-8e81a2c6eba3",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "The contract was mutually binding."
                                            },
                                            {
                                                "example_id": "b0da2a8c-3bf9-4ad4-91a1-dde850d1cb46",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            },
                                            {
                                                "example_id": "7bb357df-947c-4bb1-86c3-1cd4c155bd41",
                                                "sense_id": "2a4b4fb9-b9a6-354b-9c0e-e52a14d5a088",
                                                "text": "The deepening strategic partnership between the People’s Republic of China and the Russian Federation and their mutually reinforcing attempts to undercut the rules-based international order run counter to our values and interests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dde9515-f789-3419-b474-71381dd9a148",
                                        "entry_id": "2783b676-0f7f-3605-9c19-542be1c1f79e",
                                        "glosses": [
                                            "In a shared manner; equally; affecting all parties the same way"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49741117-a1d6-4c99-aebd-a9f810e61c18",
                                                "sense_id": "4dde9515-f789-3419-b474-71381dd9a148",
                                                "text": "The adventure was mutually beneficial."
                                            }
                                        ]
                                    }
                                ]
                            }
