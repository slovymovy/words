{
    "word_family": [
        "éloignement",
        "éloigné",
        "loin",
        "lointain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "caa99a5b-f458-35aa-a8ad-7d901e4c32f7",
                    "sense_definition": "Mettre ou porter quelqu'un ou quelque chose à une plus grande distance dans l'espace ou dans le temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distance_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>éloigner</w> cette chaise de la cheminée pour éviter tout incident."
                        },
                        {
                            "text": "Le médecin a conseillé d'<w>éloigner</w> les enfants des personnes malades."
                        }
                    ],
                    "synonyms": [
                        "écarter",
                        "distancier"
                    ],
                    "antonyms": [
                        "rapprocher"
                    ],
                    "common_phrases": [
                        "éloigner le danger",
                        "éloigner les soupçons"
                    ]
                },
                {
                    "sense_id": "b02056b1-6ddf-3bce-95b3-0fa7552b5bdb",
                    "sense_definition": "Partir plus loin, se mettre à distance d'un lieu ou d'une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distance_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navire s'<w>éloigne</w> lentement du port en direction de la pleine mer."
                        },
                        {
                            "text": "Ne t'<w>éloigne</w> pas trop car nous allons bientôt partir pour la gare."
                        }
                    ],
                    "synonyms": [
                        "partir",
                        "s'écarter"
                    ],
                    "antonyms": [
                        "s'approcher",
                        "se rapprocher"
                    ],
                    "common_phrases": [
                        "s'éloigner du bord",
                        "s'éloigner de la ville"
                    ]
                },
                {
                    "sense_id": "9f4c043b-3242-3772-ba33-10415e3c4ea3",
                    "sense_definition": "Perdre progressivement le contact affectif, social ou intellectuel avec autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son déménagement, il s'est peu à peu <w>éloigné</w> de ses anciens camarades."
                        },
                        {
                            "text": "Leurs modes de vie différents ont fini par les <w>éloigner</w> l'un de l'autre."
                        }
                    ],
                    "synonyms": [
                        "se détacher",
                        "se désintéresser"
                    ],
                    "antonyms": [
                        "se rapprocher"
                    ],
                    "common_phrases": [
                        "s'éloigner de ses amis",
                        "s'éloigner de sa famille"
                    ]
                },
                {
                    "sense_id": "1852e063-3fd3-3c2f-bbce-934ef67cb3bc",
                    "sense_definition": "Différer d'une idée, d'une norme, d'un thème ou de la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette explication confuse s'<w>éloigne</w> beaucoup de la réalité des faits."
                        },
                        {
                            "text": "Pendant son discours, le professeur s'est <w>éloigné</w> de la question principale."
                        }
                    ],
                    "synonyms": [
                        "dévier",
                        "diverger"
                    ],
                    "antonyms": [
                        "se rapprocher"
                    ],
                    "common_phrases": [
                        "s'éloigner du sujet",
                        "s'éloigner de la vérité"
                    ]
                },
                {
                    "sense_id": "8a103702-a31f-31a3-99ff-f81598f4167c",
                    "sense_definition": "Manquer à ses devoirs, à ses obligations morales ou à ses principes fondamentaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En acceptant ce compromis douteux, il s'est <w>éloigné</w> de son devoir professionnel."
                        },
                        {
                            "text": "Le magistrat refuse absolument de s'<w>éloigner</w> des principes fondateurs de la justice."
                        }
                    ],
                    "synonyms": [
                        "déroger",
                        "faillir"
                    ],
                    "common_phrases": [
                        "s'éloigner de son devoir",
                        "s'éloigner de ses principes"
                    ]
                }
            ]
        }
    ]
}