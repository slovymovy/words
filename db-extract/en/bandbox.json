                        "glosses": [
                            "A box of lightweight construction (e.g. cardboard, thin wood) for carrying hats or other apparel items."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b58d709-5f06-44b8-9243-e53969b46ac2",
                                "sense_id": "64bdaeb8-b481-344b-b24e-b9a3e54d6ab9",
                                "text": "There is a dangerous freshness in the hues / Of the new bonnets which that day produces / Bright from the bandbox, be they greens or blues; / The aspect of a new pelisse conduces / To gazings which the gazer often rues."
                            },
                            {
                                "example_id": "b3150804-0ed8-4e01-abd5-739be267ab7e",
                                "sense_id": "64bdaeb8-b481-344b-b24e-b9a3e54d6ab9",
                                "text": "On the evening of Easter Sunday the gypsies of Southern Europe take a wooden vessel like a band-box, which rests cradle-wise on two cross pieces of wood."
                            }
