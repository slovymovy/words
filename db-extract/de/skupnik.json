                "senses": [
                    {
                        "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                        "entry_id": "886648ce-10a2-3062-8540-d419bae20ba6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50169464-405d-4af8-8c35-83d7d45f80ef",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Frau Skupnik ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a16008d1-daca-4cb1-86c0-497ac4a6174b",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Herr Skupnik wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "58e5cf90-0f47-4126-8862-b97cbb3eeecb",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Die Skupniks kommen heute aus den Alpen."
                            },
                            {
                                "example_id": "c573d9ac-5614-4af9-9f5e-93c0cce9882f",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Der Skupnik trägt nie die Schals, die die Skupnik ihm strickt."
                            },
                            {
                                "example_id": "e06ffb01-0c9e-4d17-a350-68f936c4403f",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Skupnik kommt, geht der Herr Skupnik.“"
                            },
                            {
                                "example_id": "e4cb02aa-ccc2-4071-a06d-31d8d5a54aa6",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Skupnik kommt und geht."
                            },
                            {
                                "example_id": "9b651f07-6c7d-47a1-95c8-67cbd5d5baad",
                                "sense_id": "6b051b1b-c613-3961-8f50-a36820d46dec",
                                "text": "Skupniks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
