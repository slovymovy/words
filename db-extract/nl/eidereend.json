                    {
                        "translation_id": "4a7c7e83-108f-497a-97c6-917042146705",
                        "source_entry_id": "5a2d3859-a956-3070-9ab3-821ad435bc42",
                        "source_sense_id": "94bb283c-23c1-34ec-871e-eeab6cbb0062",
