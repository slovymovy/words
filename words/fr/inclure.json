{
    "word_family": [
        "inclusion",
        "inclusif",
        "inclusivement",
        "inclusivité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5673b919-2c3d-3d79-9319-aa36264686ee",
                    "sense_definition": "Comprendre quelque chose dans un tout, faire figurer parmi d'autres éléments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tarif de la chambre d'hôtel <w>inclut</w> le petit-déjeuner pour deux personnes.",
                            "target_lang_translations": {
                                "en": "The hotel room rate <w>includes</w> breakfast for two people.",
                                "ru": "Стоимость номера в отеле <w>включает</w> завтрак для двух человек.",
                                "de": "Der Zimmerpreis <w>enthält</w> das Frühstück für zwei Personen.",
                                "es": "La tarifa de la habitación del hotel <w>incluye</w> el desayuno para dos personas.",
                                "zh": "客房价格<w>包括</w>两人的早餐。"
                            }
                        },
                        {
                            "text": "Nous devons <w>inclure</w> toutes les dépenses imprévues dans le budget final.",
                            "target_lang_translations": {
                                "en": "We must <w>include</w> all unforeseen expenses in the final budget.",
                                "ru": "Мы должны <w>включить</w> все непредвиденные расходы в окончательный бюджет.",
                                "de": "Wir müssen alle unvorhergesehenen Ausgaben in das endgültige Budget <w>einrechnen</w>.",
                                "es": "Debemos <w>incluir</w> todos los gastos imprevistos en el presupuesto final.",
                                "zh": "我们必须把所有意外开支<w>计入</w>最终预算。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprendre",
                        "englober",
                        "intégrer",
                        "contenir"
                    ],
                    "antonyms": [
                        "exclure",
                        "omettre"
                    ],
                    "common_phrases": [
                        "tout inclure",
                        "inclure dans le prix"
                    ],
                    "target_lang_definitions": {
                        "en": "To take something in as one of the parts of a whole, or make it part of a larger set.",
                        "ru": "Включить что-либо в состав целого или сделать это частью большего набора.",
                        "de": "Etwas als Teil eines Ganzen mit einschließen oder zu einer größeren Menge hinzuzählen.",
                        "es": "Tener algo como parte de un todo o hacer que figure entre otros elementos.",
                        "zh": "把某物纳入整体之中，使其成为其中的一部分，或列入其他要素之中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "include",
                                "target_lang_sense_clarification": "items within a price or total"
                            },
                            {
                                "target_lang_word": "comprise",
                                "target_lang_sense_clarification": "formal, parts that make up a whole"
                            },
                            {
                                "target_lang_word": "encompass",
                                "target_lang_sense_clarification": "covering a broad range of things"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "в цену, в общую сумму"
                            },
                            {
                                "target_lang_word": "охватывать",
                                "target_lang_sense_clarification": "широкий круг явлений"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "enthalten",
                                "target_lang_sense_clarification": "Bestandteil eines Preises oder Pakets"
                            },
                            {
                                "target_lang_word": "einschließen",
                                "target_lang_sense_clarification": "in Kosten oder Gesamtsumme"
                            },
                            {
                                "target_lang_word": "inkludieren",
                                "target_lang_sense_clarification": "in Angeboten und Preisen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "incluir",
                                "target_lang_sense_clarification": "en un precio o total"
                            },
                            {
                                "target_lang_word": "comprender",
                                "target_lang_sense_clarification": "uso formal, partes de un todo"
                            },
                            {
                                "target_lang_word": "abarcar",
                                "target_lang_sense_clarification": "amplia gama de cosas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包括",
                                "target_lang_sense_clarification": "价格或总额中的项目"
                            },
                            {
                                "target_lang_word": "包含",
                                "target_lang_sense_clarification": "作为整体的组成部分"
                            },
                            {
                                "target_lang_word": "计入",
                                "target_lang_sense_clarification": "纳入费用或总数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e4296d0-1d3b-3a7f-a79d-16bff7602d44",
                    "sense_definition": "Insérer ou joindre un document ou un fichier dans un courrier ou un message.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas d'<w>inclure</w> une copie de votre pièce d'identité avec le formulaire.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>include</w> a copy of your ID card with the form.",
                                "ru": "Не забудьте <w>вложить</w> копию вашего удостоверения личности вместе с бланком.",
                                "de": "Vergessen Sie nicht, eine Kopie Ihres Ausweises mit dem Formular <w>beizulegen</w>.",
                                "es": "No olvide <w>incluir</w> una copia de su documento de identidad con el formulario.",
                                "zh": "别忘了随表格<w>附上</w>一份身份证件的复印件。"
                            }
                        },
                        {
                            "text": "J'<w>inclus</w> le contrat signé dans ce courriel pour finaliser notre accord.",
                            "target_lang_translations": {
                                "en": "I'm <w>attaching</w> the signed contract to this email to finalise our agreement.",
                                "ru": "Я <w>прикрепляю</w> подписанный договор к этому письму, чтобы завершить наше соглашение.",
                                "de": "Ich <w>hänge</w> den unterschriebenen Vertrag dieser E-Mail <w>an</w>, um unsere Vereinbarung endgültig abzuschließen.",
                                "es": "<w>Adjunto</w> el contrato firmado en este correo electrónico para finalizar nuestro acuerdo.",
                                "zh": "我在这封邮件里<w>附上</w>已签字的合同，以便敲定我们的协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "joindre",
                        "annexer",
                        "insérer"
                    ],
                    "antonyms": [
                        "retirer",
                        "extraire"
                    ],
                    "common_phrases": [
                        "inclure une pièce jointe",
                        "inclure un justificatif"
                    ],
                    "target_lang_definitions": {
                        "en": "To insert or add a document or file into a letter or message.",
                        "ru": "Вложить документ или файл в письмо или сообщение.",
                        "de": "Ein Dokument oder eine Datei einem Brief oder einer Nachricht hinzufügen.",
                        "es": "Insertar o añadir un documento o archivo en una carta o mensaje.",
                        "zh": "把文件或电子文件附入信件或邮件中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enclose",
                                "target_lang_sense_clarification": "documents sent with a letter"
                            },
                            {
                                "target_lang_word": "attach",
                                "target_lang_sense_clarification": "files sent with an email"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "документы в конверт или письмо"
                            },
                            {
                                "target_lang_word": "прикреплять",
                                "target_lang_sense_clarification": "файлы к электронному письму"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beilegen",
                                "target_lang_sense_clarification": "Dokumente im Briefumschlag"
                            },
                            {
                                "target_lang_word": "anhängen",
                                "target_lang_sense_clarification": "Dateien an E-Mails"
                            },
                            {
                                "target_lang_word": "beifügen",
                                "target_lang_sense_clarification": "in formellen Schreiben"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "adjuntar",
                                "target_lang_sense_clarification": "archivos enviados por correo electrónico"
                            },
                            {
                                "target_lang_word": "anexar",
                                "target_lang_sense_clarification": "documentos en cartas formales"
                            },
                            {
                                "target_lang_word": "incluir",
                                "target_lang_sense_clarification": "documentos dentro de una carta"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附上",
                                "target_lang_sense_clarification": "随信件或邮件一同寄出"
                            },
                            {
                                "target_lang_word": "附寄",
                                "target_lang_sense_clarification": "文件随信件寄出"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}