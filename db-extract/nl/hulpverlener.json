                    {
                        "sense_id": "daef8152-f102-3426-85bf-37e0fef8bf2b",
                        "entry_id": "5f12ab06-67de-39c9-9d0a-55e1cb5c26ac",
                        "glosses": [
                            "iemand die zich toelegt op het verlenen van hulp in algemene zin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a29ef960-296d-4999-976f-d3e4c619a96f",
                                "sense_id": "daef8152-f102-3426-85bf-37e0fef8bf2b",
                                "text": "Na de aardbeving duurde het enige tijd voor hulpverleners erin slaagden tot het getroffen gebied door te dringen omdat alle toegangswegen geblokkeerd waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8888581b-ee37-4517-aa0e-6da64cb5e4fa",
                        "source_entry_id": "5f12ab06-67de-39c9-9d0a-55e1cb5c26ac",
                        "source_sense_id": "daef8152-f102-3426-85bf-37e0fef8bf2b",
                        "source_sense_description": "iemand die zich toelegt op het verlenen van hulp in algemene zin",
                        "target_lang_word": "Sozialarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                        "entry_id": "3d6d690f-b77e-3690-91d0-be7bbcd647b0",
                                        "glosses": [
                                            "qualifizierter Helfer in schwierigen Lebenslagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3d8f7c-6672-4d8d-943d-f2bd9d92a140",
                                                "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                                "text": "Sozialarbeiter werden unter anderem in Bereichen der Kinder- und Jugendhilfe, der Wohnungslosenhilfe, der Suchthilfe und der Bewährungshilfe eingesetzt."
                                            },
                                            {
                                                "example_id": "c89ac780-e6aa-4709-b267-099888f0191f",
                                                "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                                "text": "Bis die ersten Sozialarbeiter ihre Arbeit an Grundschulen aufnehmen, ist es trotz des positiven Votums im Jugendhilfeausschuss noch ein weiter Weg."
                                            },
                                            {
                                                "example_id": "e417d3fe-8095-42c4-9fe2-520694a61528",
                                                "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                                "text": "„Die Sozialarbeiter/innen und Psycholog/innen tragen zur angestrebten Verkürzung der Untersuchungshaft unter anderem durch Erstellung eines umfassenden Persönlichkeitsbildes, Abklärung des sozialen Empfangsraumes, Einzelfallbesprechungen, Vernetzungen mit Betreuungseinrichtungen sowie bei Bedarf Erstattung von alternativen Unterbringungsmöglichkeiten zur Untersuchungshaft bei.“"
                                            },
                                            {
                                                "example_id": "ec21f675-eefd-42a9-892b-a1a228f828f6",
                                                "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                                "text": "„Die syrische Post wurde in einer speziellen Wohnung im Erdgeschoss gesammelt und von einem überforderten Sozialarbeiter nach Lust und Laune bearbeitet.“"
                                            },
                                            {
                                                "example_id": "3fa05ec2-d057-4550-b891-39e5ee8c9eab",
                                                "sense_id": "66cbfc36-da53-3ed8-8b1d-03d98927f096",
                                                "text": "„Přemysl Pitter lebte später als Schriftsteller und Sozialarbeiter in der Schweiz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
