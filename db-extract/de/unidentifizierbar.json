                "senses": [
                    {
                        "sense_id": "982bad2c-5bea-329a-9017-fa237a791e89",
                        "entry_id": "ee47b7f4-5f74-3e61-8ec9-4713ed106852",
                        "glosses": [
                            "so beschaffen, dass eine Identifizierung unmöglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d959194-e80d-4d62-a0c9-8bc3dd90c139",
                                "sense_id": "982bad2c-5bea-329a-9017-fa237a791e89",
                                "text": "„In kleinen Städten sorgen Kleinigkeiten schnell für beträchtliches Aufsehen, und das ist der Grund, weshalb die Menschen von Kingsport während des ganzen Frühjahrs und den ganzen Sommer hindurch über die drei unidentifizierbaren Leichen sprachen, die von den Gezeitenströmen an die Küste gespült wurden, schrecklich zerschnitten wie von vielen Entermessern und grausig zertrampelt wie von unzähligen grausamen Bootsstiefeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
