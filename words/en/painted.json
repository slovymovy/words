        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b68fd2a1-bd76-3d24-9ed1-66f372b09a72",
                    "sense_definition": "Simple past and past participle of <w>paint</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>painted</w> the kitchen walls yellow last weekend.",
                            "target_lang_translations": {
                                "ru": "Она <w>покрасила</w> стены кухни в желтый цвет в прошлые выходные.",
                                "zh": "上周末她把厨房的墙壁<w>粉刷</w>成了黄色。"
                            }
                        },
                        {
                            "text": "The old fence has been <w>painted</w> white to look new.",
                            "target_lang_translations": {
                                "ru": "Старый забор был <w>покрашен</w> в белый цвет, чтобы выглядеть как новый.",
                                "zh": "旧栅栏被<w>漆</w>成了白色，看起来像新的一样。"
                            }
