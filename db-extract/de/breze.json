                ],
                "senses": [
                    {
                        "sense_id": "8e8e9421-d6bf-3436-afa8-7e50f3b7af75",
                        "entry_id": "a823bb9d-7023-3686-8623-1bc613609d63",
                        "glosses": [
                            "größeres mit grobem Salz (oder Zucker) bestreutes Gebäck, dessen Form dem Buchstaben B ähnelt"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "2c13be1d-f9a5-4983-be27-e18a69b4b675",
                                "sense_id": "8e8e9421-d6bf-3436-afa8-7e50f3b7af75",
                                "text": "„»Die bayerische Breze erkennt man am Geschmack und nicht an der Schreibweise«, sagte der Vorsitzende der CSU-Europagruppe, Manfred Ferber.“"
                            },
                            {
                                "example_id": "561a896d-5625-4e31-8450-614402ddd99f",
                                "sense_id": "8e8e9421-d6bf-3436-afa8-7e50f3b7af75",
                                "text": "„[…] die Mentalität im japanischen Geschäftsleben war mir so fremd – ich hatte Heimweh und wollte plötzlich unbedingt eine Breze.“"
                            },
                            {
                                "example_id": "758f5005-7709-41de-afc2-806fc15e7100",
                                "sense_id": "8e8e9421-d6bf-3436-afa8-7e50f3b7af75",
                                "text": "„Sei es, wie es sei – die Breze gilt als eines der ältesten Gebildbrote.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
