                "senses": [
                    {
                        "sense_id": "f7992d96-68d9-3bc0-afcf-d7088c6ca6fc",
                        "entry_id": "1c326bbc-e343-3cfe-9614-906c8a5c963f",
                        "glosses": [
                            "Besitzer eines Vermögens im Wert von mehreren Milliarden einer „Währungseinheit“ (Euro, Dollar, Pfund oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93725de-4f01-448b-8fc9-18213b1abdfb",
                                "sense_id": "f7992d96-68d9-3bc0-afcf-d7088c6ca6fc",
                                "text": "„Der britische Multimilliardär Richard Branson (Virgin Group) veranstaltet in Kolumbien ein Benefizkonzert für die notleidende Bevölkerung im benachbarten Venezuela.“"
                            },
                            {
                                "example_id": "3a82df1e-6523-4c28-abf1-b3e7d11ecfff",
                                "sense_id": "f7992d96-68d9-3bc0-afcf-d7088c6ca6fc",
                                "text": "„Der amerikanische Multimilliardär Robert F. Smith ist mit einem besonderen Geschenk zur Graduiertenfeier des traditionell von Schwarzen besuchten Morehouse College im amerikanischen Bundesstaat Georgia gekommen: Er sagte den frischgebackenen Absolventen am Sonntag zu, für ihre Studienkredite komplett aufzukommen – geschätzte 40 Millionen Dollar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
