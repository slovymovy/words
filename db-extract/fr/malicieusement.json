        "fr-extract.jsonl": [
            {
                "entry_id": "bffffa1f-f885-3973-802c-dff005aa808b",
                "word": "malicieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3e34e69-ce58-3876-b6e9-d27078335ed4",
                        "entry_id": "bffffa1f-f885-3973-802c-dff005aa808b",
                        "glosses": [
                            "D’une manière malicieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34557bab-39c9-4528-a566-285f7f894d91",
                                "sense_id": "f3e34e69-ce58-3876-b6e9-d27078335ed4",
                                "text": "Je vous dirai donc en un mot, sur cette fable que vous avez semée dans tous vos écrits contre M. d’Ypres, que vous abusez malicieusement de quelques paroles ambigues d’une de ses lettres, qui étant capables d’un bon sens doivent être prises en bonne part, selon l’esprit de l’Eglise; & ne peuvent être prises autrement que selon l’esprit de votre Societé."
                            },
                            {
                                "example_id": "8d17bc7a-ed09-4fe6-adcb-701222b7a0de",
                                "sense_id": "f3e34e69-ce58-3876-b6e9-d27078335ed4",
                                "text": "Que voulez-vous, répliqua Jean de Boy malicieusement, on se bat toujours pour ce qu’on n’a pas !"
                            },
                            {
                                "example_id": "f475d538-643d-445f-a6a0-656a07e8f194",
                                "sense_id": "f3e34e69-ce58-3876-b6e9-d27078335ed4",
                                "text": "Il sonda malicieusement ce caractère propre à se courber aux exigences d’un plan pourvu qu’il y trouvât sa pâture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee83d8b5-8d42-42b9-873d-f7704112ca1c",
                        "source_entry_id": "bffffa1f-f885-3973-802c-dff005aa808b",
                        "source_sense_id": "f3e34e69-ce58-3876-b6e9-d27078335ed4",
                        "target_lang_word": "archly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a54b9e-7295-37e2-831d-be6e39956f67",
                                        "entry_id": "df7405ad-e305-398c-9546-22503f9c4710",
                                        "glosses": [
                                            "In an arch manner; slyly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f68bbe-3a68-4313-897b-c1805fd5c25a",
                                                "sense_id": "b9a54b9e-7295-37e2-831d-be6e39956f67",
                                                "text": "Phoebe lay down by me, and ask'd me archly if, now that I had seen the enemy, and fully considered him, I was still afraid of him?",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "ff128314-a444-44b1-a3ad-5e3bd98c6dd2",
                                                "sense_id": "b9a54b9e-7295-37e2-831d-be6e39956f67",
                                                "text": "Though he intends it destructively, Rothbard is right that there are relations between the millennial hope for justice he archly calls KGE—Kingdom of God on Earth—and communism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "archly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e39bf06b-183d-3829-a953-b0818663ed71",
                                        "entry_id": "c80e7e94-f753-3064-8b9b-eb4015e2c54a",
                                        "glosses": [
                                            "In the form of an arch."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a993b123-f762-4fe6-8861-56f77d82d214",
                                                "sense_id": "e39bf06b-183d-3829-a953-b0818663ed71",
                                                "text": "My eyebrows recently plucked archly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
