                        "examples": [
                            {
                                "example_id": "421b5e61-57e0-45ba-a42f-778dbc7840fd",
                                "sense_id": "d9f5fd08-9d39-3e74-bcc2-ef51ee62edec",
                                "text": "De stichting ondersteunt in de lente en zomer enkele evenementen in de Amsterdamse grachten, waaronder een bloemencorso van roeiboten en een zwemmarathon van 2028 meter."
                            },
                            {
                                "example_id": "fa3ec3cb-27d8-4cd4-ba97-58882abd4989",
                                "sense_id": "d9f5fd08-9d39-3e74-bcc2-ef51ee62edec",
                                "text": "McCardel zwom al zesmaal het Kanaal over en won in 2010 de zwemmarathon rond Manhattan in New York."
                            },
                            {
                                "example_id": "935689d6-3adf-4d94-82c9-65f0138afa16",
                                "sense_id": "d9f5fd08-9d39-3e74-bcc2-ef51ee62edec",
                                "text": "In Frankrijk zegt Françoise Lavoisier van de vluchtelingenhulporganisatie SALAM dat bijna geen enkele migrant zich aan de zwemmarathon waagt. Velen zijn via de Middellandse Zee hierheen gekomen, ze kennen de gevaren."
                            },
                            {
                                "example_id": "1fd2d0cb-974c-417b-839e-96709a220e1e",
                                "sense_id": "d9f5fd08-9d39-3e74-bcc2-ef51ee62edec",
                                "text": "Tijdens zijn zwemmarathon werd hij gesteund door diverse andere zwemmers en bekende Nederlanders. Ferry Weertman, winnaar van olympisch goud op de tien kilometer in Rio, en zijn vriendin Ranomi Kromowidjojo zwommen het laatste stuk met Van der Weijden mee."
                            }
