                "senses": [
                    {
                        "sense_id": "453ee0f9-a314-3c1f-b1f1-f91bc7d794d0",
                        "entry_id": "2a4af181-8ad7-3781-8699-353f6cf2ab7c",
                        "glosses": [
                            "der Durchmesser einer Klemmverbindung bei Metallbauteilen (beispielsweise das Klemmmaß eines Fahrradlenkers)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563f7b8b-5dfc-4dd8-be59-edf58836997f",
                                "sense_id": "453ee0f9-a314-3c1f-b1f1-f91bc7d794d0",
                                "text": "„Wie messe ich an einem vorhandenen Vorbau das Klemmmaß des nicht vorhandenen Lenkers (mit dem Mess-Schieber, ist klar, aber von wo nach wo)?“"
                            },
                            {
                                "example_id": "e4f8c982-8dbc-46b5-a5f3-32c64e17519b",
                                "sense_id": "453ee0f9-a314-3c1f-b1f1-f91bc7d794d0",
                                "text": "„Hebel für Dropbar-Lenker (auch Straßenlenker oder Rennlenker) sind genau wie der Lenker gebogen und folgen der Rundung des Lenkers. Diese Hebel benötigen Klemmschellen, die auf das bei fast allen Dropbar-Lenkern benutzte Klemmmaß von 23,8mm (15/16 Zoll) passen.“"
                            },
                            {
                                "example_id": "5f450305-1586-42ff-8e11-4da6ddbd9775",
                                "sense_id": "453ee0f9-a314-3c1f-b1f1-f91bc7d794d0",
                                "text": "Das Klemmmaß dieser Lenkstange passt nicht für mein Fahrrad."
                            },
                            {
                                "example_id": "830fb25a-2107-42a5-adeb-fd6db9268605",
                                "sense_id": "453ee0f9-a314-3c1f-b1f1-f91bc7d794d0",
                                "text": "Die Klemmmaße bei Fahrrädern wurden in den letzten zwanzig Jahren aus Sicherheitsgründen deutlich vergrößert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
