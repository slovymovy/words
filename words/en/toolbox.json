{
    "word_family": [
        "tool",
        "box"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b99a03af-7927-3e84-aa86-d675d2f99d64",
                    "sense_definition": "A storage case for tools.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He opened his heavy metal <w>toolbox</w> to find a wrench for the leaky pipe.",
                            "target_lang_translations": {
                                "ru": "Он открыл свой тяжелый металлический <w>ящик для инструментов</w>, чтобы найти ключ для протекающей трубы."
                            }
                        },
                        {
                            "text": "Please put the hammer back in the <w>toolbox</w> when you are finished with it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи молоток обратно в <w>ящик для инструментов</w>, когда закончишь с ним."
                            }
                        }
                    ],
                    "synonyms": [
                        "tool chest",
                        "kitbag"
                    ],
                    "common_phrases": [
                        "metal toolbox",
                        "portable toolbox",
                        "heavy toolbox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер или ящик, предназначенный для хранения и переноски инструментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ящик для инструментов",
                                "target_lang_sense_clarification": "физический контейнер"
                            },
                            {
                                "target_lang_word": "инструментальный ящик",
                                "target_lang_sense_clarification": "специализированный кейс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "693de26c-6771-3b60-921c-d241a4feb130",
                    "sense_definition": "A set of skills or competences used to achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Learning a second language is a great addition to your professional <w>toolbox</w>.",
                            "target_lang_translations": {
                                "ru": "Изучение второго языка — отличное дополнение к вашему профессиональному <w>инструментарию</w>."
                            }
                        },
                        {
                            "text": "Developing this chameleon-like skill could prove to be a very useful addition to your <w>toolbox</w> for winning people over.",
                            "target_lang_translations": {
                                "ru": "Развитие этого навыка адаптивности может оказаться очень полезным дополнением к вашему <w>арсеналу</w> средств для завоевания расположения людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "skillset",
                        "repertoire"
                    ],
                    "common_phrases": [
                        "professional toolbox",
                        "mental toolbox",
                        "addition to your toolbox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор навыков, методов или компетенций, используемых для достижения цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструментарий",
                                "target_lang_sense_clarification": "набор методов или навыков"
                            },
                            {
                                "target_lang_word": "арсенал",
                                "target_lang_sense_clarification": "совокупность средств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d1eccec-3d8a-39dd-a83a-63d3c072f336",
                    "sense_definition": "A set of pre-existing routines or software components for use in writing new programs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer used a specialized <w>toolbox</w> to simplify the creation of the user interface.",
                            "target_lang_translations": {
                                "ru": "Разработчик использовал специализированный <w>инструментарий</w>, чтобы упростить создание пользовательского интерфейса."
                            }
                        },
                        {
                            "text": "This software <w>toolbox</w> contains all the functions needed for data analysis.",
                            "target_lang_translations": {
                                "ru": "Этот программный <w>пакет</w> содержит все функции, необходимые для анализа данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "library",
                        "toolkit"
                    ],
                    "common_phrases": [
                        "software toolbox",
                        "programming toolbox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор готовых программных компонентов или библиотек для разработки программного обеспечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инструментарий",
                                "target_lang_sense_clarification": "набор программных средств"
                            },
                            {
                                "target_lang_word": "панель инструментов",
                                "target_lang_sense_clarification": "элемент интерфейса"
                            },
                            {
                                "target_lang_word": "библиотека",
                                "target_lang_sense_clarification": "набор функций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38a25498-b1d5-3035-a75f-11d5a3e8d992",
                    "sense_definition": "A person who is considered stupid or foolish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the get go, one can immediately tell that this kid is a total <w>toolbox</w>.",
                            "target_lang_translations": {
                                "ru": "С самого начала сразу видно, что этот парень — полный <w>тупица</w>."
                            }
                        },
                        {
                            "text": "I cannot believe that <w>toolbox</w> forgot to lock the door again.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что этот <w>олух</w> снова забыл запереть дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "dumbass",
                        "fool"
                    ],
                    "antonyms": [
                        "genius"
                    ],
                    "common_phrases": [
                        "total toolbox"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или нелепый человек (оскорбительный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупица",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "олух",
                                "target_lang_sense_clarification": "простак или дурак"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}