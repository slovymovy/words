                    {
                        "sense_id": "4a80a249-228d-342a-b6e4-7deddfe14653",
                        "entry_id": "260a3620-2629-3cc3-9eef-4ad5eed89f8f",
                        "glosses": [
                            "A designer of levels for video games."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5410b37-4d02-46ed-8db5-2ee9f1665bbd",
                                "sense_id": "4a80a249-228d-342a-b6e4-7deddfe14653",
                                "text": "As he churned out early versions of the Quake III engine, the mappers and artists felt adrift, with no direction on what to pursue."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad1abd9f-cc44-3cff-856d-f37b99d8eada",
                        "entry_id": "260a3620-2629-3cc3-9eef-4ad5eed89f8f",
                        "glosses": [
                            "A software or hardware component that performs a mapping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efb51cd-bac8-444a-abde-363a92a63fbe",
                                "sense_id": "ad1abd9f-cc44-3cff-856d-f37b99d8eada",
                                "text": "Throughout the Famicom's life span, Nintendo produced several ASIC mappers, which grew in capability and specialty, allowing the Famicom to break many of its own hardware rules."
                            }
                        ]
                    }
                ],
                "translations": [
