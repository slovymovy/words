                "translations": [
                    {
                        "translation_id": "968b5d47-5d60-49f5-9697-8366b195b938",
                        "source_entry_id": "71284f2c-7c67-3025-b33e-6644d841ba1c",
                        "source_sense_id": "8305ad19-9db2-3410-927d-723b1c22d9ce",
                        "target_lang_word": "eructate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eructate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff778fd-f6c1-395b-950f-f1bca6fa7516",
                                        "entry_id": "467596c0-2e4f-3e1c-9fc9-7ca9fc94f98f",
                                        "glosses": [
                                            "To belch, to burp."
                                        ],
                                        "tags": [
                                            "formal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "341007bc-250f-477e-8f15-7589b714df4c",
                                                "sense_id": "7ff778fd-f6c1-395b-950f-f1bca6fa7516",
                                                "text": "Pain in the right side of the throat, as from an ulcery sensation or as if a splinter were lodged in the throat, when swallowing, eructating, breathing, stretching and moving the neck."
                                            },
                                            {
                                                "example_id": "4be1b830-bcc6-43d3-bf33-81d7f4b0b98e",
                                                "sense_id": "7ff778fd-f6c1-395b-950f-f1bca6fa7516",
                                                "text": "What hours have I paced those platforms, endlessly, hopelessly, where the draughts of Siberia and the solstice heats of Ecuador focus their unscrupling rigours on the eructated passenger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2856be5d-3267-449a-9a0c-e226c080057a",
                        "source_entry_id": "71284f2c-7c67-3025-b33e-6644d841ba1c",
                        "source_sense_id": "8305ad19-9db2-3410-927d-723b1c22d9ce",
                        "target_lang_word": "burp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "529192de-4027-3dbd-ba28-aa5d4c0b3db4",
                                        "entry_id": "e8cfc973-3f50-337e-ae4e-c9420fe033ac",
                                        "glosses": [
                                            "A belch."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d80843-293f-4e2e-b94d-43a0a3faf62f",
                                                "sense_id": "529192de-4027-3dbd-ba28-aa5d4c0b3db4",
                                                "text": "Lennon let out a burp after downing the beer."
                                            },
                                            {
                                                "example_id": "8bec638a-0b99-438a-a9d4-80944de33d32",
                                                "sense_id": "529192de-4027-3dbd-ba28-aa5d4c0b3db4",
                                                "text": "Sylvanshine would burp and it would seem like more than a burp; it would taste like he'd almost thrown up a little."
                                            },
                                            {
                                                "example_id": "7f73dbce-3164-4dc0-9469-d6945b00a29e",
                                                "sense_id": "529192de-4027-3dbd-ba28-aa5d4c0b3db4",
                                                "text": "When they approached, he turned from them and made swallowing noises indispersed with burps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                                        "entry_id": "0412f03b-01f7-3344-9859-233a873d2c07",
                                        "glosses": [
                                            "To emit a burp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267d8fcd-01a1-4899-8466-35fe4967eddf",
                                                "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                                                "text": "Burping is considered impolite in most western cultures."
                                            },
                                            {
                                                "example_id": "b3dfc8ba-843f-41fc-8cb5-92da50cd1397",
                                                "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                                                "text": "My dad used to burp to hide the fact he was farting."
                                            },
                                            {
                                                "example_id": "204bf349-d7dd-4fe6-bc13-cf94946bb147",
                                                "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                                                "text": "‘[…] She burped and tried to jam the bottle into the waste-hole of the waste-disposal thing, the thingummy.’\n‘Garburator,’ said Pigs Trotter. ‘I think they’re called Garburators.’\n‘Garburator, that’s it. She tried to jam the bottle down the Garburator.[…]’"
                                            },
                                            {
                                                "example_id": "86b1da24-71e9-4d2b-935d-af0bd8614a25",
                                                "sense_id": "61ff8599-7a76-3ad1-a7fd-f1438a3a003e",
                                                "text": "During a burping contest to celebrate wonderfully cold soft drinks after a long hike one hot afternoon, one little girl said, \"My dad can outburp any of you!\" Her father is a distinguished theologian and church leader whom I will not name here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57331567-31b9-3655-ab8d-0cc4c931aec2",
                                        "entry_id": "0412f03b-01f7-3344-9859-233a873d2c07",
                                        "glosses": [
                                            "To utter by burping"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e85e5616-579f-49d6-8af9-5bbf0947b19d",
                                                "sense_id": "57331567-31b9-3655-ab8d-0cc4c931aec2",
                                                "text": "Stevie intends to burp the alphabet at the school talent show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9440a978-b18f-3298-a103-c13087167947",
                                        "entry_id": "0412f03b-01f7-3344-9859-233a873d2c07",
                                        "glosses": [
                                            "To cause someone (such as a baby) to burp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0646e65c-27b4-40fb-a313-c22fbdf00d94",
                                                "sense_id": "9440a978-b18f-3298-a103-c13087167947",
                                                "text": "Usually baby doesn't need to be burped if (1) he consistently takes his usual amount of formula, gradually increasing his capacity as the weeks go by and (2) if he hasn't spit up when put down unburped after most feedings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945d808b-47ff-36cb-9552-f94204f24582",
                                        "entry_id": "0412f03b-01f7-3344-9859-233a873d2c07",
                                        "glosses": [
                                            "To open (a container of fermenting substance) to allow the release of accumulated gas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deaf1929-19f2-44b7-853b-2ddcdb44db9c",
                                                "sense_id": "945d808b-47ff-36cb-9552-f94204f24582",
                                                "text": "Ferment the lemons for up to 2 weeks, opening the bag occasionally to burp it and release carbon dioxide, and reseal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e4093f0-0a7e-4846-9698-0348b22029b9",
                        "source_entry_id": "71284f2c-7c67-3025-b33e-6644d841ba1c",
                        "source_sense_id": "8305ad19-9db2-3410-927d-723b1c22d9ce",
                        "target_lang_word": "belch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f2e0eb-e7fb-3b7b-a202-c27ff8d953bb",
                                        "entry_id": "fe45b3df-d087-3474-9b7b-3cc4d318e89c",
                                        "glosses": [
                                            "To expel (gas) from the stomach through the mouth; especially, to do so loudly."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4077f552-0b8b-4ae7-a981-58b3169c954a",
                                                "sense_id": "b7f2e0eb-e7fb-3b7b-a202-c27ff8d953bb",
                                                "text": "'Tis not a year or two shows us a man:\nThey are all but stomachs, and we all but food;\nTo eat us hungerly, and when they are full,\nThey belch us."
                                            },
                                            {
                                                "example_id": "8e32aef9-b786-42da-a5d8-f58af351e43f",
                                                "sense_id": "b7f2e0eb-e7fb-3b7b-a202-c27ff8d953bb",
                                                "text": "1746, attributed to Jonathan Swift, \"A Love Poem form a Physician to his Mistress,\" http://www.gutenberg.org/cache/epub/14353/pg14353-images.html\nWhen I an amorous kiss design'd,\nI belch'd a hurricane of wind."
                                            },
                                            {
                                                "example_id": "d2086a32-4d49-4a33-8aa1-bb8fa2605123",
                                                "sense_id": "b7f2e0eb-e7fb-3b7b-a202-c27ff8d953bb",
                                                "text": "She eats too fast, belches behind a cupped hand, smiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                        "entry_id": "fe45b3df-d087-3474-9b7b-3cc4d318e89c",
                                        "glosses": [
                                            "To eject or emit (something) with spasmodic force or noise."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f43401-0485-4bfb-aca8-2d4fd8bfd85f",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "Thick smoke belched through the funnels of the steamship."
                                            },
                                            {
                                                "example_id": "2e17a5cd-5f86-4511-b781-6a6122ba5317",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "Within the gates of hell sat Sin and Death,\nIn counterview within the gates, that now\nStood open wide, belching outrageous flame\nFar into Chaos […]."
                                            },
                                            {
                                                "example_id": "f29fe031-bfaf-4db3-8dc5-f677163cf921",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "Vulcan this plague begot; and, like his sire,\nBlack clouds he belch'd, and flakes of livid fire."
                                            },
                                            {
                                                "example_id": "a7c29025-24e9-4460-8fba-9eb444e95585",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "[…]beneath him sound like waves on a desert shore\nThe voice of slaves beneath the sun, and children bought with money,\nThat shiver in religious caves beneath the burning fires\nOf lust, that belch incessant from the summits of the earth."
                                            },
                                            {
                                                "example_id": "7d911667-2f10-4410-895e-9036ccf96001",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "I sing the song of the great clean guns that belch forth death at will.\nAh, but the wailing mothers, the lifeless forms and still!"
                                            },
                                            {
                                                "example_id": "d10dd809-d7f3-4987-a322-fb14ec85cfbe",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "I grasped the cold slimy rung. My feet slithered and scrunched on stranded things. Next rung...the next and next...endless horrible rungs, hissing and smells belching from under the wharf."
                                            },
                                            {
                                                "example_id": "32be0854-400d-4c93-bbc3-f895379a1e72",
                                                "sense_id": "9642f115-d2c1-3b3f-86d4-a92c68edc01d",
                                                "text": "A book entitled Emerging Indonesia has on its cover photographs of a sunrise over palm trees, bent women in coolie hats transplanting rice, a wooden bull burning at a Balinese cremation, and a liquid nitrogen plant belching black smoke into a clear, undefiled tropical sky."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "belch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b30aa6-f372-3627-a208-d64c68de298b",
                                        "entry_id": "68bfac01-288e-30fc-9313-94696edf69a7",
                                        "glosses": [
                                            "An instance of belching; the sound that it makes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02af5346-8f99-4835-ab0d-8546ff99dc9b",
                                                "sense_id": "b6b30aa6-f372-3627-a208-d64c68de298b",
                                                "text": "The hotel coffee machine gurgles out an acrid belch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25268fc3-38d1-3340-b54f-04e4d0f0c875",
                                        "entry_id": "68bfac01-288e-30fc-9313-94696edf69a7",
                                        "glosses": [
                                            "Malt liquor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31f0bb4-90d5-44d9-8fed-90dd8e6e3a9a",
                                                "sense_id": "25268fc3-38d1-3340-b54f-04e4d0f0c875",
                                                "text": "c. 1699, John Dennis, letter to Mr. Collier\nPorters would no longer be drunk with Belch"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
