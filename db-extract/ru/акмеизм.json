                                        "sense_id": "fa115798-3a5c-3ac4-8f5c-de4ec86fe16d",
                                        "entry_id": "970e4e6a-6a93-35d0-9c10-3b294764ab20",
                                        "glosses": [
                                            "A literary movement in early twentieth-century Russia, reacting against symbolism and concerned with greater immediacy in poetic language."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff48cd4-3a84-4568-9540-c21856445c3e",
                                                "sense_id": "fa115798-3a5c-3ac4-8f5c-de4ec86fe16d",
                                                "text": "A manifestation of Russian modernism that comprised those who had “overcome” symbolism, acmeism represents a facet of 20th-century Russian literature without a direct predecessor in Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
