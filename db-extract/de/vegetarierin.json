                "senses": [
                    {
                        "sense_id": "4f30f466-0209-3a46-9baf-823730da6ea9",
                        "entry_id": "aee8bba1-95c2-353f-a5ec-e54d2efffde7",
                        "glosses": [
                            "Frau, die kein Fleisch oder keine Tierprodukte verzehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3389fb6-31ad-404e-bed9-b5aa285f9c7b",
                                "sense_id": "4f30f466-0209-3a46-9baf-823730da6ea9",
                                "text": "Bloß weil deine Freundin Vegetarierin ist, musst du doch deine Ernährung nicht völlig umstellen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab554d33-b605-47ef-bc69-9595bd0b1b55",
                        "source_entry_id": "aee8bba1-95c2-353f-a5ec-e54d2efffde7",
                        "source_sense_id": "4f30f466-0209-3a46-9baf-823730da6ea9",
                        "source_sense_description": "Frau, die kein Fleisch oder keine Tierprodukte verzehrt",
                        "target_lang_word": "vegetarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                        "entry_id": "e223e8cb-9cfe-3f79-9777-56f3a58d67a1",
                                        "glosses": [
                                            "A person who does not eat animal flesh, or, in some cases, use any animal products."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1db420c-959b-43a9-a19e-f603b9322044",
                                                "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                                "text": "\"The sight and smell of raw meat are especially odious to me, and I have often thought that if I had had to be my own cook, I should inevitably become a vegetarian, probably, indeed, return entirely to my green and salad days.\""
                                            },
                                            {
                                                "example_id": "0cc76aa9-55be-4f07-a5df-5f924b40bbf1",
                                                "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                                "text": "Vegetarian Society […] A society […] formed at Manchester in 1847, to promote the use of cereals, pulse, and fruit, as articles of diet; and to induce habits of abstinence from fish, flesh, and fowl, as food."
                                            },
                                            {
                                                "example_id": "bbd2f84d-0b21-4ec2-8526-d34a16537818",
                                                "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                                "text": "vegetarian […] One who abstains from animal food, living exclusively on vegetables, milk, eggs, and the like. The more strict vegetarians eat vegetables and farinaceous food only, abstaining from eggs, butter, milk, and in some cases, honey."
                                            },
                                            {
                                                "example_id": "e70de248-0966-45ca-9be4-89cd13615eb7",
                                                "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                                "text": "I went in for all books available on vegetarianism and read them. One of these, Howard Williams' The Ethics of Diet, was a 'biographical history of the literature of humane dietetics from the earliest period to the present day'. It tried to make out, that all philosophers and prophets from Pythagoras and Jesus down to those of the present age were vegetarians."
                                            },
                                            {
                                                "example_id": "cd0a5072-8b86-446b-b55c-b8d533d8ff00",
                                                "sense_id": "514a421c-3c21-3c1c-8ccd-8b43080c0e9b",
                                                "text": "Heh heh. You hit like a vegetarian!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e66814-38c5-386e-9d0c-044c03b84860",
                                        "entry_id": "e223e8cb-9cfe-3f79-9777-56f3a58d67a1",
                                        "glosses": [
                                            "An animal that eats only plants; a herbivore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vegetarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11d7dd3e-fd90-3724-949e-406133c707ff",
                                        "entry_id": "b65a305c-60f1-3513-b0dc-d3ba6067745c",
                                        "glosses": [
                                            "Of or relating to the type of diet eaten by vegetarians (in all senses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1797b22-74bb-43a7-a829-f70bc2cd06c9",
                                                "sense_id": "11d7dd3e-fd90-3724-949e-406133c707ff",
                                                "text": "Must we not put to death blackbirds and thrushes because they feed on worms, or (if capital punishment offends our humanitarianism) starve them slowly by permanent captivity and vegetarian diet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b175b1-3309-3ff5-9f9a-015bf7c74fed",
                                        "entry_id": "b65a305c-60f1-3513-b0dc-d3ba6067745c",
                                        "glosses": [
                                            "Without meat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce4095d9-bb5f-3d8e-8a19-9baed2ca2786",
                                        "entry_id": "b65a305c-60f1-3513-b0dc-d3ba6067745c",
                                        "glosses": [
                                            "Of a product normally made with meat, having non-meat substitutes in place of meat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6d9b16-6264-4409-a961-fd2e6e35941e",
                                                "sense_id": "ce4095d9-bb5f-3d8e-8a19-9baed2ca2786",
                                                "text": "Is there such a thing as a good tasting vegetarian hot dog? Cuz every one I've tried tasted like smelted tire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d688c8c-90d9-374c-b460-909497738512",
                                        "entry_id": "b65a305c-60f1-3513-b0dc-d3ba6067745c",
                                        "glosses": [
                                            "That does not eat meat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ab2d7c-34b9-487a-a5f5-8d1d033cc83e",
                                                "sense_id": "3d688c8c-90d9-374c-b460-909497738512",
                                                "text": "I have a vegetarian brother"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
