                    {
                        "form_id": "6e5a1dda-e128-4aae-9a82-7ca12dd2072b",
                        "entry_id": "11c074fa-b250-35e1-b0c5-179944d162bf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Landratsämter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ae87b62-f8a0-3c86-aa20-0fff4a3f87fd",
                        "entry_id": "11c074fa-b250-35e1-b0c5-179944d162bf",
                        "glosses": [
                            "Kreisverwaltungsbehörde in einigen deutschen Bundesländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2ba515-0ae6-4955-85d5-22426c0c024b",
                                "sense_id": "5ae87b62-f8a0-3c86-aa20-0fff4a3f87fd",
                                "text": "„Das Landratsamt plant eine nie gekannte Einstellungsoffensive.“"
                            },
                            {
                                "example_id": "9f4794c6-9114-4910-99c2-73dfdc4f792f",
                                "sense_id": "5ae87b62-f8a0-3c86-aa20-0fff4a3f87fd",
                                "text": "„Das Landratsamt war der Meinung, sie sollten mit dem Zug fahren.“"
                            },
                            {
                                "example_id": "14e7da34-727a-41c2-b9b4-92cc3fb2a57a",
                                "sense_id": "5ae87b62-f8a0-3c86-aa20-0fff4a3f87fd",
                                "text": "„Das Landratsamt hatte Anfang Juni wegen der beiden Fälle zu einer Informationsveranstaltung eingeladen und Antworten auf Fragen besorgter Anwohner gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b9846f6-bb77-38f2-a161-d0aa67b3b4fa",
                        "entry_id": "11c074fa-b250-35e1-b0c5-179944d162bf",
                        "glosses": [
                            "Gebäude von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666ab24c-8a8c-4d35-a9e4-869c6cad4c2c",
                                "sense_id": "3b9846f6-bb77-38f2-a161-d0aa67b3b4fa",
                                "text": "„In diesen Tagen wächst das Gebäude auf einer Fläche von etwa 70 mal 100 Metern zwischen dem 100 Jahre alten Landratsamt und den Kreiswerken aus dem Boden heraus, in dem schon das Fundament mit einer 1,20 Meter dicken Betonplatte und die Tiefgeschosse mit Parkflächen für Mitarbeiter und Besucher fertiggestellt sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
