                    {
                        "translation_id": "f4fc55c2-1da1-4231-b9e7-3196a9798910",
                        "source_entry_id": "59bd707a-9988-3a29-a761-308ccc8582ae",
                        "source_sense_id": "a7f8a841-0df3-3704-b67b-ab1e908ccb40",
                        "target_lang_word": "Baseballmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baseballmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                        "entry_id": "89aa5532-71e5-3c15-a735-f0306e61972b",
                                        "glosses": [
                                            "Mütze, die ursprünglich von Baseballern getragen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29961032-712b-43a1-a24f-cdfe62595837",
                                                "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                                "text": "In seiner Freizeit trägt er immer eine Baseballmütze."
                                            },
                                            {
                                                "example_id": "820b1e2b-6b11-4bce-8460-73c9323d5a8b",
                                                "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                                "text": "„In einem Fach dieses Necessaires steckte das Foto eines Jungen mit einer Baseballmütze.“"
                                            },
                                            {
                                                "example_id": "388fb355-a8ef-402b-b54d-7fda99941976",
                                                "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                                "text": "„In Ländern, in denen Baseball unbekannt war, war die häufigste Kopfbedeckung eine Baseballmütze.“"
                                            },
                                            {
                                                "example_id": "aaeb7050-dfa8-4d40-870a-aa3a97333be1",
                                                "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                                "text": "„Auch Chrissi schützt ihr frischgetöntes Haar, sie hat sich eine Baseballmütze von John Deere aus dem Gewächshaus übergezogen.“"
                                            },
                                            {
                                                "example_id": "6fe8dee8-c9bb-4855-9452-e98297bc0fe6",
                                                "sense_id": "b3655b85-ac37-35b6-815e-96b924eb457f",
                                                "text": "„Er hat sich sehr sorgfältig angezogen. Jeans, T-Shirt, Baseballmütze, die umgedreht werden muss, das hat er gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
