                "senses": [
                    {
                        "sense_id": "bb1fdd7b-4307-3272-8d94-e254719d76b5",
                        "entry_id": "c3e077c9-e19c-3e39-9b1c-fb99099089c0",
                        "glosses": [
                            "A flag, usually a broad tapering pennant, often with a swallowtail, flown by yachts to identify the owner's yacht club."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a00ca14-341e-34cc-8b95-3102394cca02",
                        "entry_id": "c3e077c9-e19c-3e39-9b1c-fb99099089c0",
                        "glosses": [
                            "Sometimes a flag in the form of a triangular swallowtail pennant regardless of use, as in the State Flag of Ohio as officially the 'Ohio Burgee'"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40754c19-b916-4861-a542-094162d75865",
                        "source_entry_id": "c3e077c9-e19c-3e39-9b1c-fb99099089c0",
                        "source_sense_description": "a broad tapering pennant",
                        "target_lang_word": "guidon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guidon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "162bef67-c35d-3058-897a-a3d98e68614a",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Petit drapeau d’une compagnie militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a672cb07-11ba-4ff1-8a7c-11b1ef8083d3",
                                                "sense_id": "162bef67-c35d-3058-897a-a3d98e68614a",
                                                "text": "[…] et, bien que garantie par une espèce de paravent, la flamme des torches penchait de côté comme le guidon déroulé d’un chef de clan."
                                            },
                                            {
                                                "example_id": "d364c19a-30f2-4fcc-9fc1-a7d634ce76ec",
                                                "sense_id": "162bef67-c35d-3058-897a-a3d98e68614a",
                                                "text": "En 1793, la République enleva de l’église de Blenheim les guidons arrachés à la monarchie en 1704 : elle vengeait le royaume et immolait le roi ; elle abattait la tête de Louis XVI, mais elle ne permettait qu’à la France de déchirer le drapeau blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d552c1-0ee9-3721-b3e3-5f1261d24038",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Celui qui portait ce drapeau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc195260-8651-44e3-b851-f347e13ea058",
                                                "sense_id": "87d552c1-0ee9-3721-b3e3-5f1261d24038",
                                                "text": "Au Pont-Neuf, la statue d’Henri IV tenait à la main, comme un guidon de la Ligue, un drapeau tricolore."
                                            },
                                            {
                                                "example_id": "2bf2b2b5-346e-48c0-a8ce-b869e5efd740",
                                                "sense_id": "87d552c1-0ee9-3721-b3e3-5f1261d24038",
                                                "text": "Je dois faire de très grands pas, c’est plus homme, puis ça use moins les souliers. Je fais de grands pas et j’ai toujours l’air d’aller relever une sentinelle, de rejoindre un guidon, d’être à la revue. Je passe dans la vie avec la raideur d’un soldat, et la rapidité d’une ombre chinoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57d4eec-0bae-3751-aa3b-14cc8b52c3d1",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Petit drapeau qui sert pour l’alignement dans les manœuvres de l’infanterie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "322cbf38-6515-36e6-9ab9-dde770c9a56f",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Banderole plus courte et plus large que la flamme, et fendue à son extrémité, qui sert ordinairement à faire des signaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbc1f0b-b398-47d4-8247-69aa147d9e30",
                                                "sense_id": "322cbf38-6515-36e6-9ab9-dde770c9a56f",
                                                "text": "Tous les chiffons marins, depuis le guidon de pêche jusqu’aux enseignes de guerre, pendent le long des mâts."
                                            },
                                            {
                                                "example_id": "ff921c71-b252-425e-b529-55df93129f99",
                                                "sense_id": "322cbf38-6515-36e6-9ab9-dde770c9a56f",
                                                "text": "Le lendemain de mon arrivée, le launch du Rochester, croiseur portant le guidon de l'amiral américain, venait accoster le long du Firecrest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a680ffa2-09d7-39eb-acfd-5be149f8cd72",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Barre d’acier creux placée en haut de la fourche qui sert à orienter la roue avant et par là même à contrôler la trajectoire d'un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de10ae85-6cd9-4111-b2e2-eca10e0127c1",
                                                "sense_id": "a680ffa2-09d7-39eb-acfd-5be149f8cd72",
                                                "text": "Je me suis occupée de lui parce que je ne vous faisais pas confiance. Son chopper est une antiquité. Un tas de boue avec un guidon très haut de type Harley Davidson. Je suis sûre que cette bécane n'est pas fiable."
                                            },
                                            {
                                                "example_id": "c7fbc31f-ea53-49a6-bce2-5197e4151d2e",
                                                "sense_id": "a680ffa2-09d7-39eb-acfd-5be149f8cd72",
                                                "text": "Nos El Ingenioso Hidalgo Don Quixote de la Mancha enfin réunis chevauchant leurs mobylettes bleues motobécane AV 88 customisées selle biplace, chicanes de pot d'échappement retirées et guidon Harley, alimentées en carburant 86% essence, 4% huile et 10% éther..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7ab1f02-c7d2-3d29-b91f-d757664714e4",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Titularisation d’un pilote dans une écurie de sport motocycliste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93175f60-0d6a-41f3-bae1-41c68bca06c9",
                                                "sense_id": "e7ab1f02-c7d2-3d29-b91f-d757664714e4",
                                                "text": "Il a obtenu un bon guidon cette année et pourra sans doute viser le titre mondial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3dd58c2-5470-380a-9d10-538361c401af",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Marque que l’on fait au bout d’une ligne, pour indiquer l’endroit où doit être placée la note qui commence la ligne suivante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "461f7898-1d1f-389e-bb91-fd23439233a0",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Pièce fixée à l’extrémité du canon d'une arme à feu et qui sert à viser."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eef96608-9c09-3842-a5b1-8f49418d22a6",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Signal d'arrêt pour le conducteur d'un train."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b48a74c7-2c1f-341e-8688-950c05edbbfe",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Meuble représentant dans les armoiries un drapeau de forme plus ou moins allongée à l’extrémité se divisant en deux pointes ondoyantes ou non. Il est généralement attaché à une hampe placée à dextre et est dit emmanché quand la hampe est d’un autre émail. À rapprocher de bannière, étendard, gonfanon, oriflamme, pavillon et pennon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f80c8fb1-838c-43bb-ad70-3b8c325abcf9",
                                                "sense_id": "b48a74c7-2c1f-341e-8688-950c05edbbfe",
                                                "text": "De gueules à la fasce d’argent, accompagné en chef de deux merlettes du même et en pointe à dextre d’une crosse d’or et à senestre d’un guidon d’argent chargé d’une aigle de sable, emmanché aussi d’or, le tout accosté de deux fleurs de lys du même, qui est de Foncquevillers de l’Oise → voir illustration « armoiries avec un guidon »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c33060bb-b04a-39cf-bdec-ac4bbb2934fa",
                                        "entry_id": "3e73fcc9-e367-32a5-9816-7c9a53afe647",
                                        "glosses": [
                                            "Trait peint en limite de parcelle afin de la matérialiser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4964f1f2-eb96-47de-b907-b574f45473ec",
                        "source_entry_id": "c3e077c9-e19c-3e39-9b1c-fb99099089c0",
                        "source_sense_description": "a broad tapering pennant",
                        "target_lang_word": "Stander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80ae4ca9-17d6-32c4-b85a-740184945db4",
                                        "entry_id": "029b9e63-0152-3f8c-b3f1-d4d36cd38571",
                                        "glosses": [
                                            "offizielle Flagge am Auto eines Präsidenten, Regierungsmitglieds, Diplomaten oder Militärs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "452fd1c7-6237-4278-9a10-b5a760f1a945",
                                                "sense_id": "80ae4ca9-17d6-32c4-b85a-740184945db4",
                                                "text": "Der Stander des Bundespräsidenten ist wieder von anderer Art: Das Gefieder geöffnet, Krallen und Schnabel durchaus wehrhaft."
                                            },
                                            {
                                                "example_id": "fabe60b6-e223-4a7f-b239-829b8488631b",
                                                "sense_id": "80ae4ca9-17d6-32c4-b85a-740184945db4",
                                                "text": "Lindner kam mit Aversionen gegen Statussymbole wie den schwarz-rot-goldenen Stander an der Limousine."
                                            },
                                            {
                                                "example_id": "dca2504b-f111-474b-a131-4f881861ec5e",
                                                "sense_id": "80ae4ca9-17d6-32c4-b85a-740184945db4",
                                                "text": "Zur Ausstattung gehörten Stander, Blaulicht (in der Mitte des Kühlergrills) und Zusatzblinker - der Adenauer-Mercedes befindet sich heute wieder im Originalzustand."
                                            },
                                            {
                                                "example_id": "cefb070c-a205-4b6b-b840-5aacae6bfa3b",
                                                "sense_id": "80ae4ca9-17d6-32c4-b85a-740184945db4",
                                                "text": "„Am rechten Kotflügel des schwarzen Chryslers leuchtete ein Stander der Vereinigten Staaten von Amerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e47a4580-8740-3427-a6bd-97044a231fc8",
                                        "entry_id": "029b9e63-0152-3f8c-b3f1-d4d36cd38571",
                                        "glosses": [
                                            "kurze, dreieckige oder trapezförmige Flagge zur Identifizierung oder Signalgebung"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950f471d-585b-494c-a9c8-fa29a70f382b",
                                                "sense_id": "e47a4580-8740-3427-a6bd-97044a231fc8",
                                                "text": "Jede in Dienst gestellte Yacht muß den Stander eines der Vereine führen, bei dem sie eingetragen ist, auch wenn sie keine ständige Besatzung hat."
                                            },
                                            {
                                                "example_id": "4d1ff12b-d837-4110-a0ed-d1654de99319",
                                                "sense_id": "e47a4580-8740-3427-a6bd-97044a231fc8",
                                                "text": "Eine Yacht, die bei mehreren Vereinen eingetragen ist, führt im allgemeinen den Stander des Vereins, dem sich der Eigner hauptsächlich angehörig fühlt; im Hafenbereich den heimischen Stander, in fremden Häfen den Stander des ältesten ortsansässigen Vereins, dem der Eigner angehört."
                                            },
                                            {
                                                "example_id": "67d25a50-e48e-4101-83a4-49d52ec2225d",
                                                "sense_id": "e47a4580-8740-3427-a6bd-97044a231fc8",
                                                "text": "Kupfer und Salpeter, Häute, Alpaka, Felle und Schafwolle, Tran, Kakao, Kaffee und Schildpatt brachten die Segler des Hauses mit dem goldenen Falken im Stander zurück an die Elbe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
