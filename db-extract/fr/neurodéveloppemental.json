                "senses": [
                    {
                        "sense_id": "1879a0d7-cfa5-3c95-9bf3-485e36569c78",
                        "entry_id": "3aee2ab8-fc49-3584-bcad-1d5cf10adea7",
                        "glosses": [
                            "Propre au développement du système nerveux, en particulier du développement du cerveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85875c1-8b5b-4a90-bdd1-864df51aef00",
                                "sense_id": "1879a0d7-cfa5-3c95-9bf3-485e36569c78",
                                "text": "Ces travaux se basent sur les données récoltées sur deux cohortes. La première se compose de 15.585 personnes touchées par divers troubles neurodéveloppementaux, tandis que la seconde, dite Simons Simplex Collection (SSC), correspond aux patrimoines génétiques des parents et des frères et sœurs de 762 familles dans lesquelles on ne compte qu’un enfant autiste."
                            },
                            {
                                "example_id": "d7fabe32-2b6c-4a4c-b2ca-a32d991c3270",
                                "sense_id": "1879a0d7-cfa5-3c95-9bf3-485e36569c78",
                                "text": "L’ensemble des données de la littérature internationale s’accorde sur le fait que les troubles autistiques sont neurodéveloppementaux."
                            },
                            {
                                "example_id": "c5e9229b-cbe1-45d6-9ceb-e56cb16e0c18",
                                "sense_id": "1879a0d7-cfa5-3c95-9bf3-485e36569c78",
                                "text": "« … Les taux de problèmes graves neurodéveloppementaux augmentent. … »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e2fd28-e06c-4ec0-9619-c8dc74ca42e9",
                        "source_entry_id": "3aee2ab8-fc49-3584-bcad-1d5cf10adea7",
                        "source_sense_id": "1879a0d7-cfa5-3c95-9bf3-485e36569c78",
