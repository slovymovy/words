                        "glosses": [
                            "совершить действие по отхаркиванию мокроты и плевка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5297f9c-c930-464b-9b7a-7f46ac5892a8",
                                "sense_id": "05e14126-fcc6-3e2a-815b-a6057a9bfaa4",
                                "text": "А ты этот харчок-то возьми да покажи всем: вот, мол, они, воеводушки: так уж привыкли плевать на нас, что и перед смертью утерпеть не может — надо харкнуть."
                            }
                        ]
                    }
