                        "target_lang_word": "halo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef974fe9-1286-38e4-b85d-519e1c0aec09",
                                        "entry_id": "773af587-6587-3888-b107-45f7dd467397",
                                        "glosses": [
                                            "stralenkrans die (het hoofd van) een heilige in afbeeldingen omgeeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0144bc8e-dc16-4de6-b079-36e823e4c353",
                                                "sense_id": "ef974fe9-1286-38e4-b85d-519e1c0aec09",
                                                "text": "Aan het kruisribgewelf ervan hangt het gepolychromeerde eikehouten Marianum uit 1533. Een halo van stralen en vlammen omringt deze dubbele Madonna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0372fc-e2a2-3508-adae-5df42eb4441a",
                                        "entry_id": "773af587-6587-3888-b107-45f7dd467397",
                                        "glosses": [
                                            "diffuse lichtgevende ring rond de zon of de maan veroorzaakt door lichtstrooiing aan ijskristallen in de dampkring"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e8b6c4-1eaf-450b-be4e-5f076a3760eb",
                                                "sense_id": "9c0372fc-e2a2-3508-adae-5df42eb4441a",
                                                "text": "Er bestaat een grote verscheidenheid aan halo's doordat ijskristallen licht op veel verschillende manieren kunnen breken."
                                            },
                                            {
                                                "example_id": "f3dcc456-02da-4d91-8cbb-6090fc1d2bbd",
                                                "sense_id": "9c0372fc-e2a2-3508-adae-5df42eb4441a",
                                                "text": "We spraken over haar ervaringen en zij sloot het telefoongesprek af met de woorden: „Moet je eens naar buiten kijken, er is zo’n prachtige halo om de maan.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440e8864-2eda-3d1b-b0c0-ddc75d30d452",
                                        "entry_id": "773af587-6587-3888-b107-45f7dd467397",
                                        "glosses": [
                                            "de bolvormige invloedsfeer die een melkwegstelsel omgeeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0846828-badd-4830-b114-91a08758f625",
                                                "sense_id": "440e8864-2eda-3d1b-b0c0-ddc75d30d452",
                                                "text": "In de halo bevinden zich bolvormige sterrenhopen."
                                            },
                                            {
                                                "example_id": "e4296ce3-722d-4113-9fe2-8a927d67725c",
                                                "sense_id": "440e8864-2eda-3d1b-b0c0-ddc75d30d452",
                                                "text": "Amerikaanse astronomen hebben ontdekt dat melkwegstelsels van zeer uiteenlopende typen en helderheden omringd worden door een zeer ijle, maar ook zeer uitgestrekte halo van hoog geïoniseerde koolstofatomen. Zo'n halo verraadt zich doordat hij het licht van quasars die er op heel grote afstanden achter staan op bepaalde golflengten absorbeert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ce7421-7f75-3401-9559-111f44b570f3",
                                        "entry_id": "773af587-6587-3888-b107-45f7dd467397",
                                        "glosses": [
                                            "uitstraling van een marketingactiviteit op een ander merk/product dan dat waar de activiteit direct op gericht is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a633a2-09ac-45d1-a612-4dc2e4349261",
                                                "sense_id": "96ce7421-7f75-3401-9559-111f44b570f3",
                                                "text": "Het is de droom van elke marketeer om zo'n status te bereiken waarin de halo van het merk zo helder schijnt dat het alles verlicht wat het bedrijf aanraakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4a53ab-0038-34f8-b3a3-a430ff5cef52",
                                        "entry_id": "773af587-6587-3888-b107-45f7dd467397",
                                        "glosses": [
                                            "constructie van stangen op racevoertuigen die het hoofd van de coureur bij een botsing moeten beschermen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "257e1170-c782-45e6-a855-6e90845d9428",
                                                "sense_id": "4d4a53ab-0038-34f8-b3a3-a430ff5cef52",
                                                "text": "Eén ding valt wél op aan de nieuwe bolide in de Formule 1: die zware constructie op de cockpit die wat wegheeft van een teenslipper. De halo is nu verplicht, maar wordt nog steeds verguisd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
