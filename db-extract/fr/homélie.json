                                "target_senses": [
                                    {
                                        "sense_id": "5bd0d7a3-8adb-31b6-b5f8-77f9417e0750",
                                        "entry_id": "2ba8aca3-7ea3-33e5-8398-e456fa67dea7",
                                        "glosses": [
                                            "w katolicyzmie kazanie mszalne do tekstów biblijnych, które może głosić tylko kapłan lub diakon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0318e8-740b-495b-9837-08251891f6eb",
                                                "sense_id": "5bd0d7a3-8adb-31b6-b5f8-77f9417e0750",
                                                "text": "We wszystkich Mszach św. w niedziele i święta nakazane, odprawianych z udziałem wiernych, homilia jest obowiązkowa i nie wolno jej opuszczać bez poważnej przyczyny"
                                            },
                                            {
                                                "example_id": "aa25b6ba-9c0d-444f-acc5-26d70c917a82",
                                                "sense_id": "5bd0d7a3-8adb-31b6-b5f8-77f9417e0750",
                                                "text": "Także te słowa homilii, wypowiedziane przez ks. kard. Ratzingera w czasie Mszy Świętej pogrzebowej, świadczą o jego bliskości i głębokiej przyjaźni z wielkim swoim poprzednikiem Janem Pawłem II"
                                            },
                                            {
                                                "example_id": "1d43e3aa-a844-4c66-b603-464a33b55c3f",
                                                "sense_id": "5bd0d7a3-8adb-31b6-b5f8-77f9417e0750",
                                                "text": "Każda homilia jest kazaniem, ale nie każde kazanie jest homilią."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "bb86398f-491a-3aae-b2d7-ba3ba5d50f10",
                                        "entry_id": "2ba8aca3-7ea3-33e5-8398-e456fa67dea7",
                                        "glosses": [
                                            "tekst wygłoszonej homilii (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c97a7e-242d-46fa-8c8e-c6eba5e72668",
                                                "sense_id": "bb86398f-491a-3aae-b2d7-ba3ba5d50f10",
                                                "text": "Teolodzy zajęli się odnalezionymi niedawno homiliami nieznanego autora z V wieku."
                                            },
                                            {
                                                "example_id": "0b5dbd6b-f6d9-4980-968d-93263bfc52b2",
                                                "sense_id": "bb86398f-491a-3aae-b2d7-ba3ba5d50f10",
                                                "text": "Wszyscy dobrze wiedzieli, że to ks. Stolarczyk był autorem biskupich homilii."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0498fe4-4e50-409d-ac41-5fd5413d72ef",
                        "source_entry_id": "30c26532-14c1-3fdf-af7c-c198bbe911d2",
                        "target_lang_word": "проповедь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "проповедь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee1a379-8cf4-3b19-ad93-8a8054f37340",
                                        "entry_id": "dad2049d-d7d0-34bc-ac5f-e2e70f21a5ea",
                                        "glosses": [
                                            "религ. речь религиозно-нравственного содержания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cba807-f3a2-427d-ac71-f1539b7d9c83",
                                                "sense_id": "4ee1a379-8cf4-3b19-ad93-8a8054f37340",
                                                "text": "Услышит, например, она, что в такой-то церкви православный священник будет говорить красноречивую проповедь, она едет туда, выслушает и умилится искренно."
                                            },
                                            {
                                                "example_id": "598a77ec-3a22-4b19-8621-ad17578b64b7",
                                                "sense_id": "4ee1a379-8cf4-3b19-ad93-8a8054f37340",
                                                "text": "Это было именно сразу после праздника «Нечаянной Радости», а в следующее воскресенье я говорил в приходе проповедь о том, что Божия Матерь сделала, как Она сумела превратить преступление в новую радость, в нечаянную радость, в нежданную, негаданную радость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f269d1-c127-3e5c-8438-472418fb417b",
                                        "entry_id": "dad2049d-d7d0-34bc-ac5f-e2e70f21a5ea",
                                        "glosses": [
                                            "перен. распространение каких-нибудь идей, взглядов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922cb85c-f45d-47c2-8c7c-3bd81bf6bd9d",
                                                "sense_id": "c4f269d1-c127-3e5c-8438-472418fb417b",
                                                "text": "…если доро́га к благу, о котором эта партия говорит без конца, исключает проповедь насилия как универсального метода осчастливливания общества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
