                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8615bd77-b867-478f-ab36-6db82276087d",
                                                "sense_id": "74d28056-5a62-3d19-b466-b42925504465",
                                                "text": "Poměrně vypjaté emoce doprovázely jednání mandátového a imunitního výboru při projednávání vydání poslanců Andreje Babiše a Jaroslava Faltýnka (oba ANO). Členové výboru se nakonec dohodli, že hlasovat o vydání obou poslanců budou příští týden."
                                            },
                                            {
                                                "example_id": "978925a6-6548-4cc8-875a-f4448a72e13d",
                                                "sense_id": "74d28056-5a62-3d19-b466-b42925504465",
                                                "text": "Jak buňky nakažlivé rakoviny unikají imunitnímu systému?"
                                            },
                                            {
                                                "example_id": "1b8c4efe-5038-4680-b811-f3840b888f45",
                                                "sense_id": "74d28056-5a62-3d19-b466-b42925504465",
                                                "text": "Také bylo mnohokrát pozorováno a následně vědecky prokázáno, že hluboký smutek (například nad ztrátou milované osoby) má za následek vyřazení části imunitních reakcí, což vede velmi rychle k nemoci."
                                            }
                                        ]
