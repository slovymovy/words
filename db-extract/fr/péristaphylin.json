                        "entry_id": "cea43a66-d9e6-3e92-8bd2-339c63676dc5",
                        "glosses": [
                            "Muscle péristaphylin."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "461ea733-1d78-4dcd-a48a-f57433c3a8ef",
                                "sense_id": "4a8cfdf7-d041-38ee-adb2-60911b8a789b",
                                "text": "Le nerf facial, selon moi, préside à la contraction de tous les muscles du voile palatin, excepté le péristaphylin externe, qui est animé, comme on le savait, par la racine motrice du trijumeau."
                            },
                            {
                                "example_id": "a910e132-a5a7-4e43-bb78-3248c4f4f1f4",
                                "sense_id": "4a8cfdf7-d041-38ee-adb2-60911b8a789b",
                                "text": "Chaque moitié du voile reçoit une paire de péristaphylins extrêmement réduits, émanant des temporaux excentriques."
                            }
                        ]
                    }
