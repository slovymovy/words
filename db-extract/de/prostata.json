                    {
                        "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                        "entry_id": "97067df4-f3c2-3102-ae5b-cd067f8525ba",
                        "glosses": [
                            "akzessorische Geschlechtsdrüse aller Säugetiere (einschließlich Mensch), die nahe der Harnblase liegt und die Harnröhre umgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b17ec7b-392c-45f0-b2ef-95aa48d4423d",
                                "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                                "text": "„Die Prostata liegt an der Einmündung der paarigen Samenleiter in die Harnröhre direkt unterhalb der Harnblase.“"
                            },
                            {
                                "example_id": "b57e20b4-e222-4aba-a78f-ee1e361a10ac",
                                "sense_id": "f3440df2-902f-3e51-bb7f-048ea4b1a9e4",
                                "text": "„1991, etwa um die Zeit, als seinem Bruder die von Krebs befallene Prostata entfernt wurde, was zu Impotenz und ständiger Inkontinenz führte, unterzog er sich unverzüglich einer Prostatauntersuchung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
