                                        "glosses": [
                                            "Langue théorique et non attestée reconstruite à partir des similarités entre d’autres langues dont on pense qu’elles sont issues de cette langue unique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7f6dde-e3de-45fd-82a0-4d5370981204",
                                                "sense_id": "169a220e-ba82-377f-b699-78c3051fd7a9",
                                                "text": "L’indo-européen est une protolangue."
                                            },
                                            {
                                                "example_id": "7348224e-6d30-43e9-bf31-f6b18cf1e9b8",
                                                "sense_id": "169a220e-ba82-377f-b699-78c3051fd7a9",
                                                "text": "Le linguiste doit aussi chercher à découvrir comment les langues qui sont apparentées ont évolué de la protolangue jusqu’à leurs formes actuelles."
