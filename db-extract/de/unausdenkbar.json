                        "source_entry_id": "10d0a08f-1d4a-32d6-bbde-6f527ce8a8ef",
                        "source_sense_id": "e00e9150-3f3f-37b4-95ba-9fe06b345e05",
                        "source_sense_description": "so, dass man es nicht ausdenken kann",
                        "target_lang_word": "unthinkable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unthinkable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e20fd8a7-ab4c-37d7-a0d0-8e2830a33dbb",
                                        "entry_id": "e561f8b8-4dca-3d45-a040-56cfb443a839",
                                        "glosses": [
                                            "Incapable of being believed; incredible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1196df2-f447-3b92-9f2f-58edfdcbf7d1",
                                        "entry_id": "e561f8b8-4dca-3d45-a040-56cfb443a839",
                                        "glosses": [
                                            "Inconceivable or unimaginable; extremely improbable in a way that goes against common sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f039bf1-e13e-4bf3-80c8-f1729b28d0fe",
                                                "sense_id": "f1196df2-f447-3b92-9f2f-58edfdcbf7d1",
                                                "text": "Nothing is unthinkable, nothing impossible to the balanced person, provided it comes out of the needs of life and is dedicated to life's further development - Lewis Mumford"
                                            },
                                            {
                                                "example_id": "27031038-3ada-4063-a67a-67a29dbf6b70",
                                                "sense_id": "f1196df2-f447-3b92-9f2f-58edfdcbf7d1",
                                                "text": "With 16 minutes left on the clock and the tension climbing through the roof, Trinh-Duc tried his luck with a penalty from just inside halfway only to push it wide, but the unthinkable now seemed a real possibility."
                                            },
                                            {
                                                "example_id": "ed2b5218-05a2-4fcb-80e2-5c387bc9d87e",
                                                "sense_id": "f1196df2-f447-3b92-9f2f-58edfdcbf7d1",
                                                "text": "The ruling also comes amid calls from an opposition party for a review of the royal insult law, which would have been unthinkable just a few years ago."
                                            },
                                            {
                                                "example_id": "ad986d73-97af-4136-9859-f7b6f1fbbf7d",
                                                "sense_id": "f1196df2-f447-3b92-9f2f-58edfdcbf7d1",
                                                "text": "It reopened as St Pancras Renaissance Hotel London in the early part of this century, and it now seens unthinkable to demolish such a structure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbeaa5f-ac51-3149-908b-117399bdd9f5",
                                        "entry_id": "e561f8b8-4dca-3d45-a040-56cfb443a839",
                                        "glosses": [
                                            "Extremely improper; extremely at odds with norms of expected behavior; taboo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ee2780-9383-495d-a393-ebbfa28d5dc7",
                                                "sense_id": "0fbeaa5f-ac51-3149-908b-117399bdd9f5",
                                                "text": "I want you to know that P.A.C. will pay for a child psychiatrist to come in and testify on behalf of the child so that the homosexual father will not be able to have that little girl overnight and weekends to expose her to what is unthinkable."
                                            },
                                            {
                                                "example_id": "ba49dde0-864b-4980-86a6-714849732ec6",
                                                "sense_id": "0fbeaa5f-ac51-3149-908b-117399bdd9f5",
                                                "text": "But... No. Luján broke his violin. That part definitely happened; he remembers it with distressing clarity. His relationship with Luján has never been much more than tepidly professional, but the man was a professional. To vandalise a precious instrument like that would be unthinkable for him, or anybody in the orchestra. There is something wrong."
                                            }
                                        ]
                                    }
                                ]
                            }
