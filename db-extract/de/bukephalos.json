                "senses": [
                    {
                        "sense_id": "071e69b5-035f-3875-b6b6-ac93b2fd9df5",
                        "entry_id": "87b3cce2-065c-31a3-aa58-0466fdf6d8db",
                        "glosses": [
                            "Lieblings- und Schlachtpferd Alexanders des Großen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58bab8e5-9cee-40c6-9c47-cb9db897f41a",
                                "sense_id": "071e69b5-035f-3875-b6b6-ac93b2fd9df5",
                                "text": "„Infolge der Schlacht gegen Poros verendete auch der Bukephalos, zwar nicht sogleich, sondern erst später, die meisten sagen: an seinen Wunden und während der Kur; Onesikritus gibt an, weil er wegen seines Alters den Anstrengungen nicht mehr gewachsen war; er sei nämlich bei seinem Tod dreißig Jahre alt gewesen.“"
                            },
                            {
                                "example_id": "4ab322e7-6f0e-4117-9c25-bab1f71a4d62",
                                "sense_id": "071e69b5-035f-3875-b6b6-ac93b2fd9df5",
                                "text": "„[Wahrlich, ich tausche dieses weissagende Roß des göttlichen Renners nicht gegen] Alexanders hochgebildeten Bukephalos: Gemeint sind Alexander d. Große (356–323 v. Chr.) und sein Schlachtpferd Bukephalos (gest. 326 v. Chr.).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
