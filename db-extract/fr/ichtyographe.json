                        "examples": [
                            {
                                "example_id": "6669ac7e-18f7-4589-8e29-49405b2fc346",
                                "sense_id": "0cdc1c19-f6f1-3768-98bf-f1cc0b3cee24",
                                "text": "En 1792 le Journal de Normandie, devenu Journal de Rouen, passait sous la juvénile direction de Noël de la Morinière, le célèbre ichtyographe."
                            },
                            {
                                "example_id": "68a25e8e-c3c4-49e3-bb83-f96fbfe0b470",
                                "sense_id": "0cdc1c19-f6f1-3768-98bf-f1cc0b3cee24",
                                "text": "Il en fut réduit à accrocher aux lignes de ses amis des sardines à l’huile et des harengs saurs, et détermina ainsi une pêche qui plongea tous les ichtyographes du quai de la Mégisserie dans une vive stupeur."
                            }
                        ]
                    }
