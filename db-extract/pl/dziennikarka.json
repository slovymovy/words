                                        "examples": [
                                            {
                                                "example_id": "d9f3e584-f20f-41af-9ad0-361d0139eb73",
                                                "sense_id": "46aa766d-78af-3254-904a-02d4cd2e206b",
                                                "text": "Журналистка одной из центральных газет Австралии приехала к Катарине Причард взять у неё интервью по каким-то вопросам женского движения."
                                            },
                                            {
                                                "example_id": "cb7bb4b9-91bb-451b-b7e2-80a254191a73",
                                                "sense_id": "46aa766d-78af-3254-904a-02d4cd2e206b",
                                                "text": "Тем более что владелицей Резо оказалась журналистка из соседней эстонской газеты ― миловидная Анечка Паю."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
