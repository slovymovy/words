                                ]
                            },
                            {
                                "target_word": "riverain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f03515f7-a442-3bbe-a763-cccb7b5370b5",
                                        "entry_id": "e8333644-5933-3f12-bf16-3469199a74fd",
                                        "glosses": [
                                            "Celui qui habite le long d’une rivière, d’un fleuve ou d’un lac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e7ac9f-59c2-402e-8898-2a8d436b71ef",
                                                "sense_id": "f03515f7-a442-3bbe-a763-cccb7b5370b5",
                                                "text": "Il est d'ailleurs impossible de compter pendant les sécheresses sur la totalité du produit alimentaire parce que les riverains de la Bar profitant de ce qu'elle n'est pas considérée comme rivière navigable en amont de la prise d'eau y font de nombreuses saignées pour l'irrigation de leurs prairies ; […]."
                                            },
                                            {
                                                "example_id": "76744a03-0677-4071-8605-67ed2bf262b4",
                                                "sense_id": "f03515f7-a442-3bbe-a763-cccb7b5370b5",
                                                "text": "La chapelle qu'avait bâtie Senard, sur le tombeau de saint Germain, devint au moyen âge un pèlerinage très-fréquenté des riverains de la Bresle."
                                            },
                                            {
                                                "example_id": "c01895e4-b90e-4c66-a1a2-88655d080931",
                                                "sense_id": "f03515f7-a442-3bbe-a763-cccb7b5370b5",
                                                "text": "En 1995, la montée des eaux avait été si brutale que ni les riverains ni les commerçants n’avaient pu sauver les meubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40445628-aba7-327e-84ee-e8fd1bb672bb",
                                        "entry_id": "e8333644-5933-3f12-bf16-3469199a74fd",
                                        "glosses": [
                                            "Celui qui habite ou est propriétaire d'un terrain le long d’une forêt, d’une rue, d’une route, d’une voie ferrée, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3ff534-efc1-47f8-9729-124bfe50d56f",
                                                "sense_id": "40445628-aba7-327e-84ee-e8fd1bb672bb",
                                                "text": "Spécialement, un riverain ne peut demander à une Compagnie de chemins de fer la réparation du préjudice qui est résulté pour lui de la mort d'un bœuf, qui s'était introduit sur la voie par une brèche ouverte dans la haie bordant cette voie, et a été écrasé par le passage d'un train."
                                            },
                                            {
                                                "example_id": "f45c86e9-484a-4d33-be4f-9b2f7a7b49f3",
                                                "sense_id": "40445628-aba7-327e-84ee-e8fd1bb672bb",
                                                "text": "En effet, au cours des dernières semaines, les riverains de la route nationale 59 de la commune de Ménil-Flin ont assisté à trois accidents graves provoqués par des poids lourds qui ont occasionné des dégâts matériels très importants."
                                            },
                                            {
                                                "example_id": "03934952-d3cb-4e34-91cf-98c038bb8dec",
                                                "sense_id": "40445628-aba7-327e-84ee-e8fd1bb672bb",
                                                "text": "Les policiers angoumoisins sont appelés par un riverain du centre-ville d’Angoulême qui signale que deux individus s’amusent à dégrader les rétroviseurs de voitures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
