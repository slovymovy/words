                {
                    "sense_id": "16ef5165-2112-339d-8f7e-fc1adc0c81f2",
                    "sense_definition": "The physical state or condition of something or someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite being ten years old, the car is still in very good <w>nick</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что машине десять лет, она всё ещё в очень хорошем <w>состоянии</w>.",
                                "zh": "尽管这辆车已经开了十年，但它的<w>状况</w>依然很好。"
                            }
                        },
                        {
                            "text": "He has been training hard and is in top <w>nick</w> for the upcoming match.",
                            "target_lang_translations": {
                                "ru": "Он усердно тренировался и сейчас в отличной <w>форме</w> перед предстоящим матчем.",
                                "zh": "他一直在刻苦训练，为即将到来的比赛保持着最佳<w>状态</w>。"
                            }
                        }
