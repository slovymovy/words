{
    "word_family": [
        "rag",
        "ragged"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4192cd88-c198-3947-a8f8-d679b526abd4",
                    "sense_definition": "Torn, worn out, or in a tattered condition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book had a <w>raggedy</w> cover that was falling apart.",
                            "target_lang_translations": {
                                "ru": "У старой книги была <w>истрепанная</w> обложка, которая разваливалась на части."
                            }
                        },
                        {
                            "text": "She found a <w>raggedy</w> doll left behind in the attic.",
                            "target_lang_translations": {
                                "ru": "Она нашла <w>потрепанную</w> куклу, оставленную на чердаке."
                            }
                        }
                    ],
                    "synonyms": [
                        "tattered",
                        "shabby"
                    ],
                    "antonyms": [
                        "pristine"
                    ],
                    "common_phrases": [
                        "raggedy doll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Истрепанный, порванный или находящийся в ветхом состоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истрепанный",
                                "target_lang_sense_clarification": "о предметах, которые сильно износились или порвались"
                            },
                            {
                                "target_lang_word": "ветхий",
                                "target_lang_sense_clarification": "о старых, пришедших в негодность вещах"
                            },
                            {
                                "target_lang_word": "оборванный",
                                "target_lang_sense_clarification": "имеющий рваные края или части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf6a7db-3280-38b0-87be-83128c4eb48c",
                    "sense_definition": "Dressed in clothes that are torn or worn out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>raggedy</w> child sat on the corner asking for help.",
                            "target_lang_translations": {
                                "ru": "<w>Оборванный</w> ребенок сидел на углу и просил о помощи."
                            }
                        },
                        {
                            "text": "He looked quite <w>raggedy</w> after hiking through the woods for days.",
                            "target_lang_translations": {
                                "ru": "Он выглядел довольно <w>потрепанным</w> после многодневного похода по лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "shabby",
                        "unkempt"
                    ],
                    "antonyms": [
                        "well-dressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одетый в рваную или сильно изношенную одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборванный",
                                "target_lang_sense_clarification": "о человеке в грязной, рваной одежде"
                            },
                            {
                                "target_lang_word": "одетый в лохмотья",
                                "target_lang_sense_clarification": "о человеке в крайне ветхой одежде"
                            },
                            {
                                "target_lang_word": "потрепанный",
                                "target_lang_sense_clarification": "о человеке, чей внешний вид стал неопрятным из-за изношенной одежды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}