                        "glosses": [
                            "Bearbeitung eines literarischen Werks zur Aufführung auf einer Bühne (in einem Theater)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f771c5-fff8-4f95-8eb3-d8a350cc51e4",
                                "sense_id": "df567e8f-a119-3dc3-a68b-a30e89d0da9d",
                                "text": "„Bühnenbearbeitungen klassischer Dramen von Calderon, Corneille, Racine, Moliere, Voltaire, Shakespeare und Gozzi, aber auch Stücke von Kleist, F. und A.W. Schlegel bestärkten den Rang Weimars als eines erstklassigen Literaturtheaters, während Kotzebue und Iffland die einträgliche Tagesware lieferten.“"
                            }
                        ],
