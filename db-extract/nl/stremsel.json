    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d695ca71-9ed8-375d-b8c8-809c7341b0a7",
                "word": "stremsel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8cb08b1f-9fd3-4720-95af-f311d215789d",
                        "entry_id": "d695ca71-9ed8-375d-b8c8-809c7341b0a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "stremsels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7fa45af-dc5e-3e98-b681-4991e1968875",
                        "entry_id": "d695ca71-9ed8-375d-b8c8-809c7341b0a7",
                        "glosses": [
                            "rennet; an enzyme used as the first step in making cheese, to curdle the milk and coagulate the casein in it, derived by soaking the fourth stomach of a milk-fed calf in brine"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "b0531f7b-1ba6-43e1-bb75-d4f6560fc483",
                                "sense_id": "e7fa45af-dc5e-3e98-b681-4991e1968875",
                                "text": "Om kaas te maken heeft men stremsel nodig.",
                                "translation": "You need rennet in order to make cheese.",
                                "english": "You need rennet in order to make cheese."
                            },
                            {
                                "example_id": "65d43c8e-a575-4600-94d6-2ad1b361592a",
                                "sense_id": "e7fa45af-dc5e-3e98-b681-4991e1968875",
                                "text": "Stremsel. Zeker vogt dat men in de melk doet om ze te doen stremmen.",
                                "translation": "Rennet. A certain fluid added to milk in order to make it curdle.",
                                "english": "Rennet. A certain fluid added to milk in order to make it curdle."
                            },
                            {
                                "example_id": "0593132e-60aa-4761-abbb-4e6fec4e46ee",
                                "sense_id": "e7fa45af-dc5e-3e98-b681-4991e1968875",
                                "text": "Year unknown, Hermina Grolman, Eigen Volk, vol. 2, page 23.\nDit stremsel bestond uit een aftreksel van nuchtere kalvermagen, kalverlebben genaamd.",
                                "translation": "This rennet consisted of an infusion of abstemious calf stomachs called calf maws.",
                                "english": "This rennet consisted of an infusion of abstemious calf stomachs called calf maws."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8648ff0-9e68-36b6-bde4-2c648cfd1007",
                        "entry_id": "d695ca71-9ed8-375d-b8c8-809c7341b0a7",
                        "glosses": [
                            "any curdled liquid, especially milk"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76cea4ee-1a54-4a18-9896-085cddaafaa3",
                                "sense_id": "d8648ff0-9e68-36b6-bde4-2c648cfd1007",
                                "text": "Hun hart verhardt, als stremsel, zonder zegen...",
                                "translation": "Their hearts hardened, like curdled milk, graceless...",
                                "english": "Their hearts hardened, like curdled milk, graceless..."
                            },
                            {
                                "example_id": "6bbc844e-3b3a-417f-8ebc-31e9749a60e0",
                                "sense_id": "d8648ff0-9e68-36b6-bde4-2c648cfd1007",
                                "text": "1807, Johannes le Francq van Berkhey, Natuurlyke historie van Holland, vol. 6, publ. P. H. Trap, page 251.\nDe jonge Kalveren, die altoos een soort van stremsel, ja zelfs stukken geronnen kaas, in de maag hebben...",
                                "translation": "The young Calves, which always have a kind of curdled milk, yes, even chunks of clotted cheese in their stomachs...",
                                "english": "The young Calves, which always have a kind of curdled milk, yes, even chunks of clotted cheese in their stomachs..."
                            }
                        ]
                    }
                ],
