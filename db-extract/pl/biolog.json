                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddde6433-70e2-4e85-8194-46144f6800c9",
                                                "sense_id": "e6660134-d6e5-35a8-92fa-244513556d9c",
                                                "text": "Наш биолог сознался, что когда (уже после МГУ) стал работать в школе, то зашёл в ту школу, где сам учился и… попросил у учителей прощения."
                                            }
                                        ]
