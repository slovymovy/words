{
    "word_family": [
        "traditional",
        "traditionally",
        "traditionalist",
        "traditionalism",
        "traditionary",
        "traditionless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3b2d0a9-56f5-322c-985a-186569041d70",
                    "sense_definition": "A part of culture, such as a custom or belief, that is passed from person to person or generation to generation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culture_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a family <w>tradition</w> to visit the seaside every summer.",
                            "target_lang_translations": {
                                "ru": "Это семейная <w>традиция</w> — ездить на море каждое лето.",
                                "tr": "Her yaz deniz kenarını ziyaret etmek bir aile <w>geleneğidir</w>.",
                                "zh": "每年夏天去海边度假是我们家的<w>传统</w>。"
                            }
                        },
                        {
                            "text": "Many people follow the <w>tradition</w> of giving gifts during the holidays.",
                            "target_lang_translations": {
                                "ru": "Многие люди следуют <w>традиции</w> дарить подарки во время праздников.",
                                "tr": "Birçok insan tatillerde hediye verme <w>geleneğine</w> uyar.",
                                "zh": "许多人遵循节日期间互赠礼物的<w>传统</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "family tradition",
                        "long tradition",
                        "oral tradition",
                        "cultural tradition",
                        "break with tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть культуры, например обычай или верование, передаваемая от человека к человеку или из поколения в поколение.",
                        "tr": "Kültürün, kişiden kişiye veya kuşaktan kuşağa aktarılan gelenek veya inanç gibi bir parçası.",
                        "zh": "文化的一部分，如习俗或信仰，代代相传。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "обычай, унаследованный от предыдущих поколений"
                            },
                            {
                                "target_lang_word": "обычай",
                                "target_lang_sense_clarification": "устоявшееся правило или привычка"
                            },
                            {
                                "target_lang_word": "предание",
                                "target_lang_sense_clarification": "устный рассказ, история, передающаяся из поколения в поколение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelenek",
                                "target_lang_sense_clarification": "kuşaktan kuşağa aktarılan kültürel alışkanlıklar"
                            },
                            {
                                "target_lang_word": "görenek",
                                "target_lang_sense_clarification": "bir şeyin görüle geldiği gibi yapılması alışkanlığı"
                            },
                            {
                                "target_lang_word": "töre",
                                "target_lang_sense_clarification": "toplulukta yerleşmiş davranış ve yaşama biçimleri"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "代代相传的文化习俗或信仰"
                            },
                            {
                                "target_lang_word": "习俗",
                                "target_lang_sense_clarification": "长期形成的社会习惯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd5d0f87-3118-35a5-853f-47509321532c",
                    "sense_definition": "An established or distinctive style, method, or manner of doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "culture_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer continued in the <w>tradition</w> of great mystery novelists.",
                            "target_lang_translations": {
                                "ru": "Писатель продолжил <w>традиции</w> великих авторов детективных романов.",
                                "tr": "Yazar, büyük polisiye romancılarının <w>geleneğini</w> sürdürdü.",
                                "zh": "这位作家延续了伟大悬疑小说家的<w>传统</w>。"
                            }
                        },
                        {
                            "text": "By <w>tradition</w> the captain is the last person to leave the ship.",
                            "target_lang_translations": {
                                "ru": "По <w>традиции</w> капитан последним покидает корабль.",
                                "tr": "<w>Gelenek icabı</w> gemiyi en son terk eden kişi kaptandır.",
                                "zh": "按照<w>惯例</w>，船长是最后一个离开船的人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the tradition of",
                        "by tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устоявшийся или характерный стиль, метод или манера исполнения чего-либо.",
                        "tr": "Bir şeyi yapmanın yerleşmiş veya kendine özgü tarzı, yöntemi veya biçimi.",
                        "zh": "某种既定的或独特的做事风格、方法或方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "стиль или метод, характерный для кого-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelenek",
                                "target_lang_sense_clarification": "yerleşmiş tarz veya ekol"
                            },
                            {
                                "target_lang_word": "adet",
                                "target_lang_sense_clarification": "alışılagelmiş kural veya gelenek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "某种特定的风格或流派"
                            },
                            {
                                "target_lang_word": "惯例",
                                "target_lang_sense_clarification": "一贯的做法或规矩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11eeb0c4-466b-3487-b936-056c91839636",
                    "sense_definition": "A commonly held system of thought, doctrine, or principles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "system_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university was founded on the <w>tradition</w> of liberal arts education.",
                            "target_lang_translations": {
                                "ru": "Университет был основан на <w>традициях</w> гуманитарного образования.",
                                "tr": "Üniversite, özgür sanatlar eğitimi <w>geleneği</w> üzerine kurulmuştur.",
                                "zh": "这所大学建立在博雅教育的<w>传统</w>之上。"
                            }
                        },
                        {
                            "text": "He challenged the established <w>tradition</w> regarding scientific research methods.",
                            "target_lang_translations": {
                                "ru": "Он бросил вызов устоявшейся <w>традиции</w> касательно методов научных исследований.",
                                "tr": "Bilimsel araştırma yöntemlerine ilişkin yerleşik <w>geleneğe</w> meydan okudu.",
                                "zh": "他挑战了关于科学研究方法的既定<w>传统</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doctrine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общепринятая система взглядов, учение или принципы.",
                        "tr": "Genel kabul gören düşünce sistemi, öğreti veya ilkeler bütünü.",
                        "zh": "一种普遍持有的思想体系、学说或原则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "система взглядов или учение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelenek",
                                "target_lang_sense_clarification": "düşünce veya ekol geleneği"
                            },
                            {
                                "target_lang_word": "ekol",
                                "target_lang_sense_clarification": "düşünce veya sanat akımı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "思想体系或学说"
                            },
                            {
                                "target_lang_word": "学派",
                                "target_lang_sense_clarification": "特定的学术思想流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77364d2e-e418-39ec-bcc8-ea789c6c085a",
                    "sense_definition": "The act of delivering property or a deed into the hands of another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_delivery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ownership of the land was transferred by <w>tradition</w> of the deed.",
                            "target_lang_translations": {
                                "ru": "Право собственности на землю было передано посредством <w>передачи</w> купчей.",
                                "tr": "Arazinin mülkiyeti, tapunun <w>devri</w> ile aktarıldı.",
                                "zh": "土地所有权是通过契约的<w>交付</w>而转让的。"
                            }
                        },
                        {
                            "text": "In ancient law, a valid sale required the physical <w>tradition</w> of the object.",
                            "target_lang_translations": {
                                "ru": "В древнем праве действительная продажа требовала физической <w>передачи</w> объекта.",
                                "tr": "Eski hukukta, geçerli bir satış için nesnenin fiilen <w>teslimi</w> gerekiyordu.",
                                "zh": "在古代法律中，有效的买卖要求对物品进行实物<w>交付</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт передачи собственности или документа в руки другого лица.",
                        "tr": "Bir mülkün veya tapunun başkasının eline teslim edilmesi eylemi.",
                        "zh": "将财产或契约交付到他人手中的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "юридический акт вручения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "devir",
                                "target_lang_sense_clarification": "mülkiyetin başkasına devredilmesi"
                            },
                            {
                                "target_lang_word": "teslim",
                                "target_lang_sense_clarification": "resmi olarak verme, teslim etme"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交付",
                                "target_lang_sense_clarification": "法律上的移交行为"
                            },
                            {
                                "target_lang_word": "转让",
                                "target_lang_sense_clarification": "所有权的移交"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca9120d9-4938-3290-a8ed-8b8f33e7d9c7",
                    "sense_definition": "To transmit or hand down something as a tradition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These stories have been <w>traditioned</w> within the community for centuries.",
                            "target_lang_translations": {
                                "ru": "Эти истории <w>передавались</w> внутри общины на протяжении веков.",
                                "tr": "Bu hikayeler yüzyıllardır topluluk içinde <w>aktarıla gelmiştir</w>.",
                                "zh": "这些故事在社区内被<w>传承</w>了几个世纪。"
                            }
                        },
                        {
                            "text": "The values were <w>traditioned</w> from the elders to the youth.",
                            "target_lang_translations": {
                                "ru": "Ценности <w>передавались</w> от старейшин к молодежи.",
                                "tr": "Değerler yaşlılardan gençlere <w>gelenek olarak aktarıldı</w>.",
                                "zh": "这些价值观由长辈<w>传承</w>给年轻人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать или вручать что-либо как традицию.",
                        "tr": "Bir şeyi gelenek olarak aktarmak veya kuşaktan kuşağa devretmek.",
                        "zh": "作为传统来传递或传授某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать",
                                "target_lang_sense_clarification": "транслировать из поколения в поколение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelenekleşmek",
                                "target_lang_sense_clarification": "gelenek olarak süregelmek"
                            },
                            {
                                "target_lang_word": "aktarmak",
                                "target_lang_sense_clarification": "kuşaktan kuşağa devretmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传承",
                                "target_lang_sense_clarification": "代代相传"
                            },
                            {
                                "target_lang_word": "传授",
                                "target_lang_sense_clarification": "将知识或价值传给后人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}