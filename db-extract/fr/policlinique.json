                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b505c409-0c77-4f4f-ad22-04535624fd1b",
                        "entry_id": "3e8f7615-9d94-3de1-be07-d118c6dea2e8",
                        "tags": [
