                "entry_id": "d9e4fd80-7a80-3539-90db-ab1b7f052f40",
                "word": "broadshare",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4c5af649-37fc-4d7c-9a25-2d7a8fc5c7b1",
                        "entry_id": "d9e4fd80-7a80-3539-90db-ab1b7f052f40",
