{
    "word_family": [
        "awake",
        "awaken",
        "waken",
        "wakeful",
        "wakefulness",
        "awakening"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eab099cc-288d-3429-ac2a-e38044f9a039",
                    "sense_definition": "To stop sleeping and become conscious.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually <w>wake</w> up at seven o'clock every morning to get ready for work.",
                            "target_lang_translations": {
                                "ru": "Я обычно <w>просыпаюсь</w> в семь часов каждое утро, чтобы собраться на работу.",
                                "de": "Ich <w>wache</w> normalerweise jeden Morgen um sieben Uhr auf, um mich für die Arbeit fertig zu machen."
                            }
                        },
                        {
                            "text": "The baby will <w>wake</w> if you make too much noise in the hallway.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>проснется</w>, если вы будете слишком шуметь в коридоре.",
                                "de": "Das Baby wird <w>aufwachen</w>, wenn du auf dem Flur zu viel Lärm machst."
                            }
                        }
                    ],
                    "synonyms": [
                        "get up",
                        "awake",
                        "awaken",
                        "stir",
                        "arise",
                        "wake up"
                    ],
                    "antonyms": [
                        "sleep",
                        "fall asleep"
                    ],
                    "common_phrases": [
                        "wake up early",
                        "wake up late"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать спать и прийти в сознание.",
                        "de": "Den Schlaf beenden und wach werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просыпаться",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "проснуться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufwachen",
                                "target_lang_sense_clarification": "den Schlaf beenden"
                            },
                            {
                                "target_lang_word": "erwachen",
                                "target_lang_sense_clarification": "gehoben, den Schlaf beenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f28378-4d60-3826-9af6-444c0c29d3c0",
                    "sense_definition": "To cause someone to stop sleeping; to rouse someone from sleep.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>wake</w> me up before you leave the house tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разбуди</w> меня завтра утром перед выходом из дома.",
                                "de": "Bitte <w>wecke</w> mich, bevor du morgen früh das Haus verlässt."
                            }
                        },
                        {
                            "text": "The loud thunder <w>woke</w> the entire family in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "Громкий гром <w>разбудил</w> всю семью посреди ночи.",
                                "de": "Der laute Donner <w>weckte</w> mitten in der Nacht die ganze Familie auf."
                            }
                        }
                    ],
                    "synonyms": [
                        "rouse",
                        "awaken",
                        "waken",
                        "wake up"
                    ],
                    "common_phrases": [
                        "wake someone up",
                        "wake the dead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то перестать спать; вывести из состояния сна.",
                        "de": "Jemanden aus dem Schlaf holen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будить",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "разбудить",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wecken",
                                "target_lang_sense_clarification": "jemanden aus dem Schlaf holen"
                            },
                            {
                                "target_lang_word": "aufwecken",
                                "target_lang_sense_clarification": "jemandes Schlaf beenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee42ba84-a028-36d3-8be3-df0e88cb7812",
                    "sense_definition": "To cause an emotion, memory, or interest to become active or strong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arouse_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of fresh bread <w>woke</w> memories of his childhood in the village.",
                            "target_lang_translations": {
                                "ru": "Запах свежего хлеба <w>разбудил</w> воспоминания о его детстве в деревне.",
                                "de": "Der Geruch von frischem Brot <w>weckte</w> Erinnerungen an seine Kindheit im Dorf."
                            }
                        },
                        {
                            "text": "We need to <w>wake</w> the public to the dangers of ignoring climate change.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>пробудить</w> общественность и показать опасность игнорирования изменения климата.",
                                "de": "Wir müssen die Öffentlichkeit für die Gefahren des Klimawandels <w>wachrütteln</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "arouse",
                        "stir",
                        "provoke",
                        "stimulate",
                        "kindle"
                    ],
                    "common_phrases": [
                        "wake memories",
                        "wake interest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать или усилить эмоцию, воспоминание или интерес.",
                        "de": "Etwas in jemandem hervorrufen oder entstehen lassen (z. B. Interesse oder Erinnerungen)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждать",
                                "target_lang_sense_clarification": "вызывать чувства"
                            },
                            {
                                "target_lang_word": "будить",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wecken",
                                "target_lang_sense_clarification": "Gefühle oder Interesse hervorrufen"
                            },
                            {
                                "target_lang_word": "erwachen",
                                "target_lang_sense_clarification": "in jemandem zu entstehen beginnen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ea77347-fae8-3dca-8ac4-9aded2cd1f08",
                    "sense_definition": "A social gathering associated with a death, usually held before the funeral, where people watch over the body or share memories.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "death_ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family held a <w>wake</w> at their home so friends could say their final goodbyes.",
                            "target_lang_translations": {
                                "ru": "Семья устроила <w>поминки</w> у себя дома, чтобы друзья могли попрощаться в последний раз.",
                                "de": "Die Familie hielt eine <w>Totenwache</w> zu Hause ab, damit Freunde sich ein letztes Mal verabschieden konnten."
                            }
                        },
                        {
                            "text": "There was a lot of storytelling and singing at the Irish <w>wake</w> last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером на ирландских <w>поминках</w> было много историй и песен.",
                                "de": "Bei der irischen <w>Totenwache</w> gestern Abend wurde viel erzählt und gesungen."
                            }
                        }
                    ],
                    "synonyms": [
                        "vigil",
                        "viewing"
                    ],
                    "common_phrases": [
                        "attend a wake",
                        "hold a wake",
                        "funeral wake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание людей в память об умершем, обычно проводимое до или после похорон.",
                        "de": "Eine Zusammenkunft im Gedenken an einen Verstorbenen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поминки",
                                "target_lang_sense_clarification": "поминальный обряд"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Totenwache",
                                "target_lang_sense_clarification": "Wache am Sarg oder Bett des Verstorbenen"
                            },
                            {
                                "target_lang_word": "Leichenschmaus",
                                "target_lang_sense_clarification": "Mahlzeit nach der Beerdigung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "299716fc-4ef8-3158-b8cf-ea945c40bf4b",
                    "sense_definition": "The track of waves or turbulent water left behind a moving ship or boat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "track_behind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fishing boat rocked violently in the <w>wake</w> of the large cruise ship.",
                            "target_lang_translations": {
                                "ru": "Маленькая рыбацкая лодка сильно качалась в <w>кильватере</w> большого круизного лайнера.",
                                "de": "Das kleine Fischerboot schaukelte heftig im <w>Kielwasser</w> des großen Kreuzfahrtschiffes."
                            }
                        },
                        {
                            "text": "Dolphins love to jump and play in the <w>wake</w> left by the ferry.",
                            "target_lang_translations": {
                                "ru": "Дельфины любят прыгать и играть в <w>следе</w>, оставленном паромом.",
                                "de": "Delfine lieben es, im <w>Kielwasser</w> der Fähre zu springen und zu spielen."
                            }
                        }
                    ],
                    "synonyms": [
                        "trail",
                        "track",
                        "path",
                        "backwash"
                    ],
                    "common_phrases": [
                        "boat wake",
                        "leave a wake"
                    ],
                    "target_lang_definitions": {
                        "ru": "След на воде, остающийся за движущимся судном.",
                        "de": "Die Spur im Wasser hinter einem fahrenden Schiff."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кильватер",
                                "target_lang_sense_clarification": "морской термин"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "на воде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kielwasser",
                                "target_lang_sense_clarification": "Spur hinter einem Schiff"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f97efe96-71e6-31ed-925d-6fa03f30cbee",
                    "sense_definition": "The consequences or aftermath of a significant event, often used in the phrase 'in the wake of'.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "track_behind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many small businesses were forced to close in the <w>wake</w> of the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Многие малые предприятия были вынуждены закрыться <w>вследствие</w> экономического кризиса.",
                                "de": "Viele kleine Unternehmen mussten im <w>Kielwasser</w> der Wirtschaftskrise schließen."
                            }
                        },
                        {
                            "text": "Disease and famine often follow in the <w>wake</w> of a major war.",
                            "target_lang_translations": {
                                "ru": "Болезни и голод часто идут <w>по следам</w> большой войны.",
                                "de": "Krankheiten und Hungersnöte folgen oft im <w>Kielwasser</w> eines großen Krieges."
                            }
                        }
                    ],
                    "synonyms": [
                        "aftermath",
                        "consequence"
                    ],
                    "common_phrases": [
                        "in the wake of",
                        "in its wake"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последствия или результаты значимого события (часто в фразе 'in the wake of').",
                        "de": "Die Folgen oder Auswirkungen eines bedeutenden Ereignisses."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последствия",
                                "target_lang_sense_clarification": "результат события"
                            },
                            {
                                "target_lang_word": "по следам",
                                "target_lang_sense_clarification": "в идиомах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "im Kielwasser",
                                "target_lang_sense_clarification": "infolge von, im Nachgang zu"
                            },
                            {
                                "target_lang_word": "Nachwirkungen",
                                "target_lang_sense_clarification": "Folgen eines Ereignisses"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4cbf889d-60ad-3874-afe9-254766085977",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wake</w> will be leading the meeting in the conference room today.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Уэйк</w> будет вести собрание в конференц-зале сегодня.",
                                "de": "Herr <w>Wake</w> leitet heute das Meeting im Konferenzraum."
                            }
                        },
                        {
                            "text": "I was introduced to a woman named Sarah <w>Wake</w> at the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринке меня представили женщине по имени Сара <w>Уэйк</w>.",
                                "de": "Ich wurde auf der Party einer Frau namens Sarah <w>Wake</w> vorgestellt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэйк",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wake",
                                "target_lang_sense_clarification": "Eigenname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}