                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8d0a38e-1873-41ac-ae72-705ebe0e9e32",
                                "sense_id": "582869bf-ae8d-3d62-ac1f-d1b68131d7cb",
                                "text": "Deze knop kan zowel het onderschrift “Zijbalk tonen” als “Zijbalk verbergen” hebben, afhankelijk van de status van de zijbalk.",
                                "translation": "Note that the option will appear as either “Show Sidebar” or “Hide Sidebar”, depending on whether the sidebar is currently shown.",
