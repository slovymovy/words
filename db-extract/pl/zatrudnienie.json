                                "sense_id": "00489621-eda1-3c55-b17a-d059e2784c86",
                                "text": "Zatrudnienie w przemyśle wzrosło o 2% w ujęciu rocznym."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "16b34ffb-6b2e-304d-a717-545b7c921b36",
                        "entry_id": "433c6caa-111d-3d2e-8f7e-73ae3aacb598",
