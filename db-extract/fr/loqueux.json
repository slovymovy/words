                        "examples": [
                            {
                                "example_id": "48816717-f288-4154-88dd-d90a319e2f8c",
                                "sense_id": "fc54fb20-84e2-37c5-9372-7ab33bc0a0d3",
                                "text": "M. Hamet prétend que le miel loqueux soumis à une forte ébullition peut être servi aux abeilles sans danger."
                            },
                            {
                                "example_id": "38ebfeb6-2a46-407e-b900-cd97fa8cfb55",
                                "sense_id": "fc54fb20-84e2-37c5-9372-7ab33bc0a0d3",
                                "text": "Je n'ai eu qu'une seule fois l'occasion d'examiner la reine d'une ruche loqueuse appartenant à M. Matthey, de Bassins. Les œufs de cet animal étaient sains et ne renfermaient ni bacilles, ni granulations virulentes."
                            }
