{
    "word_family": [
        "public",
        "publican",
        "publication",
        "publisher",
        "publicity",
        "publish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8b64f84-d11c-3278-ba5b-6eda0d7c42f9",
                    "sense_definition": "A public house where alcoholic beverages are sold and consumed, often serving food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drinking_establishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to meet at the <w>pub</w> for a quick drink after work.",
                            "target_lang_translations": {
                                "ru": "Мы решили встретиться в <w>пабе</w>, чтобы пропустить по стаканчику после работы.",
                                "zh": "我们决定下班后去<w>酒吧</w>喝一杯。"
                            }
                        },
                        {
                            "text": "The village <w>pub</w> serves excellent fish and chips on Fridays.",
                            "target_lang_translations": {
                                "ru": "В деревенском <w>пабе</w> по пятницам подают отличную рыбу с картошкой.",
                                "zh": "村里的那家<w>酒馆</w>周五供应很棒的炸鱼薯条。"
                            }
                        }
                    ],
                    "synonyms": [
                        "public house",
                        "tavern",
                        "boozer",
                        "local",
                        "watering hole",
                        "alehouse",
                        "bar"
                    ],
                    "common_phrases": [
                        "go to the pub",
                        "local pub",
                        "pub lunch",
                        "pub quiz",
                        "at the pub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заведение, где продаются и употребляются алкогольные напитки, часто подается еда; традиционный британский бар.",
                        "zh": "一种主要供应酒精饮料并常提供餐食的公共场所，尤指英式酒吧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паб",
                                "target_lang_sense_clarification": "питейное заведение в британском или ирландском стиле"
                            },
                            {
                                "target_lang_word": "бар",
                                "target_lang_sense_clarification": "общее название заведений с алкоголем"
                            },
                            {
                                "target_lang_word": "пивная",
                                "target_lang_sense_clarification": "заведение, специализирующееся на пиве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒吧",
                                "target_lang_sense_clarification": "提供酒精饮料的公共场所"
                            },
                            {
                                "target_lang_word": "酒馆",
                                "target_lang_sense_clarification": "传统风格的饮酒场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e1a630-dd73-3c37-be18-d06c696bd791",
                    "sense_definition": "A short form of the word <w>publication</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "publishing_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist listed his recent <w>pubs</w> on the university website.",
                            "target_lang_translations": {
                                "ru": "Ученый перечислил свои недавние <w>публикации</w> на сайте университета.",
                                "zh": "这位科学家在大学网站上列出了他最近的<w>出版物</w>。"
                            }
                        },
                        {
                            "text": "She needs a few more academic <w>pubs</w> to get tenure.",
                            "target_lang_translations": {
                                "ru": "Ей нужно еще несколько научных <w>статей</w> для получения постоянной должности.",
                                "zh": "她还需要几篇学术<w>论文</w>才能获得终身教职。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"публикация\" (научная статья или работа).",
                        "zh": "“出版物”或“学术论文”的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "публикация",
                                "target_lang_sense_clarification": "научная работа или статья"
                            },
                            {
                                "target_lang_word": "статья",
                                "target_lang_sense_clarification": "научный труд в журнале"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出版物",
                                "target_lang_sense_clarification": "公开发表的文字作品"
                            },
                            {
                                "target_lang_word": "论文",
                                "target_lang_sense_clarification": "学术性的文章"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c76bc42-0817-3215-a750-08b20cbf09fb",
                    "sense_definition": "A public server in an online game.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often hard to find good teamwork when playing in random <w>pubs</w>.",
                            "target_lang_translations": {
                                "ru": "Часто трудно найти хорошую командную игру в случайных <w>пабликах</w>.",
                                "zh": "在随机匹配的<w>野房</w>里玩游戏时，往往很难找到好的团队配合。"
                            }
                        },
                        {
                            "text": "He prefers private matches because <w>pubs</w> are too chaotic.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает частные матчи, потому что в <w>пабликах</w> слишком много хаоса.",
                                "zh": "他更喜欢私人对局，因为<w>公共服务器</w>太混乱了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичный сервер или матч в онлайн-игре (игровой сленг).",
                        "zh": "在线游戏中面向公众开放的服务器或比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паблик",
                                "target_lang_sense_clarification": "сленг: общедоступный игровой сервер"
                            },
                            {
                                "target_lang_word": "публичный сервер",
                                "target_lang_sense_clarification": "сервер, доступный всем игрокам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公共服务器",
                                "target_lang_sense_clarification": "对所有玩家开放的游戏服务器"
                            },
                            {
                                "target_lang_word": "野房",
                                "target_lang_sense_clarification": "游戏俚语，指随机匹配的公共对局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a296512a-833b-3db0-8368-6094dc7a8ec2",
                    "sense_definition": "A short form of the word <w>publisher</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "publishing_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pub</w> decided to drop the book series due to low sales.",
                            "target_lang_translations": {
                                "ru": "<w>Издательство</w> решило закрыть серию книг из-за низких продаж.",
                                "zh": "这家<w>出版社</w>因销量不佳决定停止出版该系列丛书。"
                            }
                        },
                        {
                            "text": "Several independent <w>pubs</w> attended the annual book fair.",
                            "target_lang_translations": {
                                "ru": "Несколько независимых <w>издательств</w> посетили ежегодную книжную ярмарку.",
                                "zh": "几家独立<w>出版商</w>参加了年度书展。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"издатель\" или \"издательство\".",
                        "zh": "“出版商”或“出版社”的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "издательство",
                                "target_lang_sense_clarification": "организация, выпускающая печатную продукцию"
                            },
                            {
                                "target_lang_word": "издатель",
                                "target_lang_sense_clarification": "лицо или компания, занимающаяся изданием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出版社",
                                "target_lang_sense_clarification": "负责出版书籍的机构"
                            },
                            {
                                "target_lang_word": "出版商",
                                "target_lang_sense_clarification": "从事出版业务的个人或公司"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59be7360-8ed8-392d-8c6f-8fd921da4c4f",
                    "sense_definition": "To visit one or more public houses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking_establishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went <w>pubbing</w> all night to celebrate his birthday.",
                            "target_lang_translations": {
                                "ru": "Мы всю ночь <w>ходили по барам</w>, празднуя его день рождения.",
                                "zh": "为了庆祝他的生日，我们整晚都在<w>泡吧</w>。"
                            }
                        },
                        {
                            "text": "They enjoy <w>pubbing</w> around the city on Friday evenings.",
                            "target_lang_translations": {
                                "ru": "Им нравится <w>ходить по пабам</w> в городе по вечерам пятницы.",
                                "zh": "他们喜欢在周五晚上去城里<w>逛酒吧</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go pubbing"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посещать пабы или бары, ходить по питейным заведениям.",
                        "zh": "指在多个酒吧间穿梭饮酒或在酒吧消磨时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить по барам",
                                "target_lang_sense_clarification": "посещать питейные заведения"
                            },
                            {
                                "target_lang_word": "зависать в пабе",
                                "target_lang_sense_clarification": "разг.: проводить время в пабе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泡吧",
                                "target_lang_sense_clarification": "频繁去酒吧消遣"
                            },
                            {
                                "target_lang_word": "逛酒吧",
                                "target_lang_sense_clarification": "连续造访多家酒吧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23024617-4f22-3b45-9d67-6a4899fe79bb",
                    "sense_definition": "To <w>publish</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "publishing_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pubbed</w> his first novel just last year.",
                            "target_lang_translations": {
                                "ru": "Он <w>опубликовал</w> свой первый роман только в прошлом году.",
                                "zh": "他去年才<w>出版</w>了他的第一部小说。"
                            }
                        },
                        {
                            "text": "They <w>pubbed</w> the report without reviewing it thoroughly.",
                            "target_lang_translations": {
                                "ru": "Они <w>издали</w> отчет без тщательной проверки.",
                                "zh": "他们在没有仔细审核的情况下就<w>发行</w>了这份报告。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публиковать или издавать материал (разговорное сокращение).",
                        "zh": "“出版”或“发行”的口语缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опубликовать",
                                "target_lang_sense_clarification": "разместить материал в печати или сети"
                            },
                            {
                                "target_lang_word": "издать",
                                "target_lang_sense_clarification": "выпустить книгу или отчет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出版",
                                "target_lang_sense_clarification": "将作品公之于众"
                            },
                            {
                                "target_lang_word": "发行",
                                "target_lang_sense_clarification": "正式推出作品"
                            }
                        ]
                    }
                }
