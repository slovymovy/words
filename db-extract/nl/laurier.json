                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7b4e23-3c3b-3849-a2cb-ef5564d27e8c",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "An evergreen shrub of species Laurus nobilis, having aromatic leaves of a lanceolate shape, with clusters of small, yellowish white flowers in their axils."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa7bd062-b68f-48e9-9996-63d46f2652cd",
                                                "sense_id": "5c7b4e23-3c3b-3849-a2cb-ef5564d27e8c",
                                                "text": "Laurel leaves were used in the Orient to promote amatory exercise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba341d1c-08f0-3a93-a23f-62a578ed6c20",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "A crown of laurel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f292837-abeb-39f0-9546-ca96637925b1",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "Honor, distinction, fame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48995932-51ac-4af2-b321-f1ea8fd56006",
                                                "sense_id": "6f292837-abeb-39f0-9546-ca96637925b1",
                                                "text": "to win laurels"
                                            },
                                            {
                                                "example_id": "a4d1b439-6a0b-480b-81dc-dd80679660d2",
                                                "sense_id": "6f292837-abeb-39f0-9546-ca96637925b1",
                                                "text": "to crown with laurels"
                                            },
                                            {
                                                "example_id": "45a0101d-75ef-45b2-8298-dda13289c6ad",
                                                "sense_id": "6f292837-abeb-39f0-9546-ca96637925b1",
                                                "text": "I was semi-famous; I had been something, but as one worthy critic remarked: past laurels fade fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461d281f-f862-3969-948e-6eeeaafce018",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "Any plant of the family Lauraceae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e6680a3-fb67-39d1-ad29-022a71e43d36",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "Any of various plants of other families that resemble laurels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8526d2cb-d9cd-38d1-947b-807ee2b25fdf",
                                        "entry_id": "c76a1e7a-803f-30a6-aefc-03ed65a07d7f",
                                        "glosses": [
                                            "An English gold coin made in 1619, and so called because the king's head on it was crowned with laurel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laurel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54e5d1df-3165-329a-90f5-f302604714e5",
                                        "entry_id": "0c167b82-0420-30f9-8848-e0b5b87f948e",
                                        "glosses": [
                                            "To decorate with laurel, especially with a laurel wreath."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8199eda3-bd92-476b-a251-72ca59bf2712",
                                                "sense_id": "54e5d1df-3165-329a-90f5-f302604714e5",
                                                "text": "Windows peered from the spaces between the columns, which rose to hold up the large portico laureling the home with chiseled, decorative wreaths and curving spirals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "520897b9-53ce-30d6-b33d-b3c2d41a54f6",
                                        "entry_id": "0c167b82-0420-30f9-8848-e0b5b87f948e",
                                        "glosses": [
                                            "To enwreathe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6823d232-f68b-487b-8e32-398645715b95",
                                                "sense_id": "520897b9-53ce-30d6-b33d-b3c2d41a54f6",
                                                "text": "It wasn't hot this late in the year, and the sun was low in the southern sky, bracketed by pines and nearly hidden by a tree line laureling a trailer park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                                        "entry_id": "0c167b82-0420-30f9-8848-e0b5b87f948e",
                                        "glosses": [
                                            "To award top honours to."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae482007-a5fa-4458-b37e-f731afe7e2e7",
                                                "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                                                "text": "In this regiment there was a young corporal, a native of Little K . He was laurelled and decorated more than many of his companions, for he excelled them all in courage, coolness, and daring. In one thing more he also excelled them — he was cruel, he was dissipated, and he was vicious in his tastes."
                                            },
                                            {
                                                "example_id": "262d4696-aad9-43eb-beb6-df61011f2474",
                                                "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                                                "text": "Not in any vision of that order did he figure for most of the admirers who laurelled him on his eightieth birthday and the few who go on laurelling him still."
                                            },
                                            {
                                                "example_id": "caed62aa-4fc6-4d1c-a073-e13d9ac7d207",
                                                "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                                                "text": "He was laurelled in admiring headlines from both left and right."
                                            },
                                            {
                                                "example_id": "78b79853-ff11-4847-9c62-d5a689609566",
                                                "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                                                "text": "In 1973, the modern papist missionary was laurelled an honorary Doctor of Divinity by the institution founded by a Congregationalist missionary to the Indians of the northern wilds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "458ba61e-8296-48fa-9cde-98458eb5b83c",
                        "source_entry_id": "910bb7a9-e959-3ea4-9893-97013531f0d6",
                        "source_sense_description": "boom en kruid",
                        "target_lang_word": "laurier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab5a07e-df66-3f17-b41c-82cff8b9e5a7",
                                        "entry_id": "532f676f-10a5-37ae-8acb-607b7e2ec7c4",
                                        "glosses": [
                                            "Synonyme de laurier sauce (Laurus nobilis), arbre sempervirent de la famille des Lauraceae qui porte une petite graine noire et amère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e66acee-139a-4adc-8b81-964d96b9fd11",
                                                "sense_id": "5ab5a07e-df66-3f17-b41c-82cff8b9e5a7",
                                                "text": "Chez les anciens, le laurier était consacré à Apollon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82db6933-4c17-3a7b-8ec1-ed000dfe0380",
                                        "entry_id": "532f676f-10a5-37ae-8acb-607b7e2ec7c4",
                                        "glosses": [
                                            "Feuilles aromatiques du laurier (Laurus nobilis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf159c1d-4c38-4e03-8fd9-c4d03b3c5812",
                                                "sense_id": "82db6933-4c17-3a7b-8ec1-ed000dfe0380",
                                                "text": "J’ai mis du laurier pour relever le goût du lapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a26582ce-a34f-3a63-98d5-95d34abccd32",
                                        "entry_id": "532f676f-10a5-37ae-8acb-607b7e2ec7c4",
                                        "glosses": [
                                            "Ce terme désigne une multitude de plantes présentant une similitude d’aspect ou d’usage (voir ci-dessous)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c5a28a2-474d-3f68-b5cc-e4a1c8c807ef",
                                        "entry_id": "532f676f-10a5-37ae-8acb-607b7e2ec7c4",
                                        "glosses": [
                                            "(Généralement au pluriel) Symbole de la victoire, à la manière des Anciens qui donnaient des couronnes de laurier aux vainqueurs, aux poètes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44d315f6-57c2-4fc3-804d-2a8f683536d7",
                                                "sense_id": "0c5a28a2-474d-3f68-b5cc-e4a1c8c807ef",
                                                "text": "Mon chef a récolté tous les lauriers de mes succès."
                                            },
                                            {
                                                "example_id": "6282e6af-9d65-4b1f-a384-e8e46f05e194",
                                                "sense_id": "0c5a28a2-474d-3f68-b5cc-e4a1c8c807ef",
                                                "text": "Au feu les strophes insensées,\nPleines du néant des lauriers!\nAssez de colonnes dressées\nAu stupide orgueil des guerriers!"
                                            },
                                            {
                                                "example_id": "2d5dfb1b-a87f-4909-90ba-3bcc7d5d8e5c",
                                                "sense_id": "0c5a28a2-474d-3f68-b5cc-e4a1c8c807ef",
                                                "text": "Refusant d’acquitter la rançon de la gloire,\nSur mon brin de laurier je dormais comme un loir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae451f02-573e-3949-ac24-bae83b3207a2",
                                        "entry_id": "532f676f-10a5-37ae-8acb-607b7e2ec7c4",
                                        "glosses": [
                                            "(Généralement au pluriel) Symbole de la gloire et de la grandeur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd5ff7bf-e57b-42e2-b2f8-d6eb220ad26a",
                                                "sense_id": "ae451f02-573e-3949-ac24-bae83b3207a2",
                                                "text": "Grand Roi, si jusqu’ici, par un trait de prudence,\nJ’ai demeuré pour toi dans un humble silence,\nCe n’est pas que mon cœur, vainement suspendu,\nBalance pour t’offrir un encens qui t’es dû;\nMais je sais peu louer; et ma muse tremblante\nFuit d’un si grand fardeau la charge trop pesante,\nEt, dans ce haut éclat où tu te viens offrir,\nTouchant à tes lauriers, craindrait de les flétrir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
