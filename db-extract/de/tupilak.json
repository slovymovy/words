                "senses": [
                    {
                        "sense_id": "19ad13b7-9f60-3c31-b2ad-c4068bae38eb",
                        "entry_id": "26ffa736-0242-345c-b208-da20e58d1336",
                        "glosses": [
                            "mystische, teils groteske Figur aus Grönland, die aus Knochen oder Zähnen geschnitzt wird, schamanistischem Denken entstammt und teils als Abwehrzauber dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f2a86ff-019b-47e8-87b1-4a2943b36b64",
                                "sense_id": "19ad13b7-9f60-3c31-b2ad-c4068bae38eb",
                                "text": "Die Formen der Tupilak folgen in der Regel deutlich sichtbar den Ausgangsmaterialien (wie z. B. einem Schulterblatt)."
                            },
                            {
                                "example_id": "84a5659b-e7f6-4035-858a-9688b60f7ba5",
                                "sense_id": "19ad13b7-9f60-3c31-b2ad-c4068bae38eb",
                                "text": "„Tupilak sind kraftvolle Gegenstände, die für ein bestimmtes Thema hergestellt werden und über magische Kräfte verfügen.“"
                            },
                            {
                                "example_id": "9be31e2e-7433-4b83-a21c-630d87fd8048",
                                "sense_id": "19ad13b7-9f60-3c31-b2ad-c4068bae38eb",
                                "text": "„Der Tupilak wurde oft ins Meer ausgesetzt, damit er selber den Feind aufsuchen und töten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
