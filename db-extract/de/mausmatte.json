                "senses": [
                    {
                        "sense_id": "f57f12c5-dae8-3fad-95a9-b5f72679f3ab",
                        "entry_id": "4d0361e0-1ef5-3f95-959c-560834040907",
                        "glosses": [
                            "Tapis de souris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc2b3ae-20c5-4e24-a08c-8853a3e3462a",
                                "sense_id": "f57f12c5-dae8-3fad-95a9-b5f72679f3ab",
                                "text": "Eine Mausmatte, mit der ihr euren Nager kabellos aufladen könnt, ist eigentlich ein tolles Gimmick.",
                                "translation": "Un tapis de souris avec lequel vous pouvez charger sans fil votre « rongeur » est vraiment un chouette gadget."
                            },
                            {
                                "example_id": "002bb10f-34a1-4f44-8ebd-7d30256ef0c6",
                                "sense_id": "f57f12c5-dae8-3fad-95a9-b5f72679f3ab",
                                "text": "Mit dem Skiller SGP2, einer Mausmatte, die mit zahlreichen Tags im American-Vintage- und Graffiti-Art-Stil verziert ist, beweist Sharkoon, dass man auch mit dem eigenen Firmenlogo einen stilvollen und optisch sehr ansprechenden Look kreieren kann.",
                                "translation": "Avec le Skiller SGP2, un tapis de souris décoré de nombreux tags dans les styles vintage américain et graffiti, Sharkoon prouve qu’il est également possible de créer un look stylé et visuellement attrayant avec son propre logo d’entreprise."
                            }
                        ]
                    }
                ],
