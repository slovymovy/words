                "senses": [
                    {
                        "sense_id": "6c33af09-cba5-3012-b533-63bd720ded0f",
                        "entry_id": "921423e1-b2a8-3fd1-89d5-a50e700649b2",
                        "glosses": [
                            "Geistlicher, der an Personen, die ihm anvertraut sind oder dieselbe Religion haben, geistliche Begleitung und Unterstützung leistet, beziehungsweise Sakramente austeilt"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1c2fe784-03c2-470b-b69f-111c00fc27e5",
                                "sense_id": "6c33af09-cba5-3012-b533-63bd720ded0f",
                                "text": "„In erster Linie war es der ehrwürdige Ortspfarrer, Herr Karl Brey, ein sehr gottesfürchtiger, edler Seelenhirte, dem das Schicksal der Familie Burner, besonders der zwei armen Kinder, nahe ging.“"
                            },
                            {
                                "example_id": "cc0d545f-7675-4081-839d-73baa044ebda",
                                "sense_id": "6c33af09-cba5-3012-b533-63bd720ded0f",
                                "text": "„Das geschah jedoch nicht, ohne vorher noch herzliche Grüße und Besserungswünsche für ihren Seelenhirten der geschäftigen Wirtin des Hauses aufgetragen zu haben, die auch fest versprach, sie alle auszurichten und für den Kranken wie für ein eigenes Kind zu sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
