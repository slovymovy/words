                            {
                                "example_id": "200a1a79-7009-4e61-a47f-bef74e0efecc",
                                "sense_id": "a038654d-c099-3ba9-8b3c-3e0cae3e7373",
                                "text": "За горами, за лесами, // За широкими морями, // Против неба — на земле, // Жил старик в одном селе. // У старинушки три сына. // Старший умный был детина, // Средний сын и так и сяк, // Младший вовсе был дурак."
                            }
                        ]
                    }
