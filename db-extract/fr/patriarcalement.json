            {
                "entry_id": "4a5d974f-aa5d-37fb-a2a9-3bbfc9b7739c",
                "word": "patriarcalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b888b140-2583-3427-adc9-e46b87c7cfef",
                        "entry_id": "4a5d974f-aa5d-37fb-a2a9-3bbfc9b7739c",
                        "glosses": [
                            "En patriarche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50087bd0-a91b-4fd5-88f4-3bd2341bcf0f",
                                "sense_id": "b888b140-2583-3427-adc9-e46b87c7cfef",
                                "text": "Tout le monde n’est pas aussi philosophe que votre serviteur, et, patriarcalement parlant, je serais fort aise de rendre le père et la mère témoins du bonheur de leur fille."
                            },
                            {
                                "example_id": "11bd0318-48d7-4b81-94cf-3bfa1e08c87f",
                                "sense_id": "b888b140-2583-3427-adc9-e46b87c7cfef",
                                "text": "Là, avec nous, vivaient, patriarcalement encore, deux braves serviteurs, comme hélas ! on n'en rencontre plus guère aujourd'hui, Anselme le berger et Claudia, qu'on appelait aussi la Péguinotte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a7d7a55-48b9-4443-9116-2a9152887ce6",
                        "source_entry_id": "4a5d974f-aa5d-37fb-a2a9-3bbfc9b7739c",
                        "source_sense_id": "b888b140-2583-3427-adc9-e46b87c7cfef",
                        "target_lang_word": "patriarchally",
