                        "examples": [
                            {
                                "example_id": "a10e5f15-0afe-4fef-80b9-9641f47abe0b",
                                "sense_id": "8c97bd32-03cd-321d-ab79-52dbe9893a99",
                                "text": "L’auteur nous fait connaître un cas typique de cet état psychopathique spécial que Hammond a désigné sous le nom de misophobie […] et Verga sous le nom de rupophobie (Archivio delle malattie mentali. 1881), état qui consisté dans la peur d’être contaminé."
                            },
                            {
                                "example_id": "5e593466-f634-4d3b-b0cb-51b7955ad7e6",
                                "sense_id": "8c97bd32-03cd-321d-ab79-52dbe9893a99",
                                "text": "Ainsi j’ai observé quelquefois une sorte de rupophobie (phobie de la saleté) avec apopatophobie (phobie de la défécation), provenant ordinairement d’un relâchement léger des sphincters."
                            }
                        ]
                    }
