                        "examples": [
                            {
                                "example_id": "e192f01b-1942-426b-b2ee-135d41a0bbc7",
                                "sense_id": "170c0434-2228-30a6-b392-923c168de398",
                                "text": "„Verloren klangen seine Worte in die Morgenstille.“"
                            },
                            {
                                "example_id": "7cc7ba30-7c2f-4d8f-9088-a43d1ded7116",
                                "sense_id": "170c0434-2228-30a6-b392-923c168de398",
                                "text": "„Der Lärm der Trommeln und Signalhörner, die mir die Morgenstille, mein Bestes, verscheuchten, dazu das naßkalte Wetter und die Beunruhigungen der Kriegsrüstung […]“"
                            },
                            {
                                "example_id": "6f1d944f-134f-4861-b932-f7c912b055e0",
                                "sense_id": "170c0434-2228-30a6-b392-923c168de398",
                                "text": "„Er hörte das Muhen im Schlaf, in der Morgenstille trug es über die fast zwei Kilometer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
