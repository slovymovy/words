                "senses": [
                    {
                        "sense_id": "4fac9536-0780-3a6a-b128-65440a4bf3a6",
                        "entry_id": "813479bf-de22-326a-b5d1-0b50c0b9c949",
                        "glosses": [
                            "устар. старинная плотная бумажная или полушерстяная ткань для верхней одежды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6b11a4-9032-460b-9310-9037fecc0d5d",
                                "sense_id": "4fac9536-0780-3a6a-b128-65440a4bf3a6",
                                "text": "Одет в вицмундир серого казинета, с красным казинетовым же воротником, и притом несколько странного покроя: с узенькими-узенькими фалдочками, падающими почти до земли; при вицмундире серенькие штанишки, коротенькие и отрёпанные; карманы везде глубокие, способные вместить содержание сумы нищего, возвращающегося домой после удачного сбора «кусков»."
                            }
                        ]
                    },
