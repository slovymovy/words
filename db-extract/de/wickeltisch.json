                    {
                        "sense_id": "51bee01b-e562-31b9-98f4-64a27763735f",
                        "entry_id": "19716a30-92fb-3482-9386-2b22229c003a",
                        "glosses": [
                            "tischartige Ablage, auf der ein Kleinkind gepflegt und mit frischen Windeln versorgt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f605ec-6527-4b3f-b100-373cb31eafd3",
                                "sense_id": "51bee01b-e562-31b9-98f4-64a27763735f",
                                "text": "„Wickeltische für Babys gibt es jetzt schon in allen Jumbos.“"
                            },
                            {
                                "example_id": "e42708dd-88f0-4e72-beee-8b0d7eeebcc5",
                                "sense_id": "51bee01b-e562-31b9-98f4-64a27763735f",
                                "text": "„Auch die Gestaltung des Kinderhauses haben die Eltern übernommen. Ein Vater hat einen Wickeltisch für die Krabbelgruppe gebaut, eine Mutter hat Bilder an die Wände gemalt, andere haben Gardinen genäht.“"
                            },
                            {
                                "example_id": "46e1561d-4a75-4ce9-bb80-8a2cb1964d1d",
                                "sense_id": "51bee01b-e562-31b9-98f4-64a27763735f",
                                "text": "„Mit der Abdeckung darauf wird es zum Wickeltisch.“"
                            },
                            {
                                "example_id": "d8782bd9-9bfb-42cc-a119-7393496e31c5",
                                "sense_id": "51bee01b-e562-31b9-98f4-64a27763735f",
                                "text": "„Väter haben es im US-Bundesstaat New York künftig leichter, wenn sie mit dem Nachwuchs unterwegs sind: Ein neues Gesetz sieht vor, dass Herrentoiletten mit Wickeltischen ausgestattet werden müssen.“"
                            }
