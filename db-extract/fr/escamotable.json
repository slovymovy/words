                "senses": [
                    {
                        "sense_id": "59691871-373b-392a-8784-2359a312ca44",
                        "entry_id": "6f80d04f-4bc8-30a9-92dc-d32d399135ad",
                        "glosses": [
                            "Que l'on peut escamoter, cacher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "010cc817-28f5-415a-ba57-185d8f4657c2",
                                "sense_id": "59691871-373b-392a-8784-2359a312ca44",
                                "text": "Quelle ne fut pas notre malchance: le générateur de notre poste, qui est escamotable, […], lorsqu'il n'est pas nécessaire de recharger les accumulateurs, se coinça sur son rail de sortie: […]."
                            },
                            {
                                "example_id": "792a3c5b-5b5b-4651-94cb-e0a3ca2a3dc6",
                                "sense_id": "59691871-373b-392a-8784-2359a312ca44",
                                "text": "Un lit escamotable."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec6695e1-eaf3-35a0-89c6-4279af6f1232",
                        "entry_id": "6f80d04f-4bc8-30a9-92dc-d32d399135ad",
                        "glosses": [
                            "Que l'on peut enlever facilement."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f0e08c93-a0a1-4cc9-8268-b30f763056ec",
                                "sense_id": "ec6695e1-eaf3-35a0-89c6-4279af6f1232",
                                "text": "La toiture de cette piscine est escamotable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14bdd852-6b94-40b9-b599-820fa526cc4b",
                        "source_entry_id": "6f80d04f-4bc8-30a9-92dc-d32d399135ad",
                        "target_lang_word": "retractable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retractable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "762a56b7-fbaa-3f4f-9fb5-eaf782e7ca92",
                                        "entry_id": "2a833392-d4e4-307c-8238-3024637c3573",
                                        "glosses": [
                                            "Capable of being retracted; retractile."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6bf0c6-8d8e-40e2-b4fb-ba1ec1b326fb",
                                                "sense_id": "762a56b7-fbaa-3f4f-9fb5-eaf782e7ca92",
                                                "text": "Retractable steps and handrails are provided on each side of the cars. The steps, which are under the control of the guard, are operated by hand levers in the entrance vestibule."
                                            },
                                            {
                                                "example_id": "4cf93394-8b9b-4740-b3ff-e447f5501ebe",
                                                "sense_id": "762a56b7-fbaa-3f4f-9fb5-eaf782e7ca92",
                                                "text": "Features such as trackless doors, mercury-type door interlocks, roof-mounted door fault indicator lights, rubber window glazing, improved retractable shoegear and a modified electro-pneumatic brake system designed to facilitate maintenance and improve reliability, which have proved their worth on the prototype trains, are continued in the new stock."
                                            },
                                            {
                                                "example_id": "23a4477b-9651-4e12-8a20-8bdbb6a6c008",
                                                "sense_id": "762a56b7-fbaa-3f4f-9fb5-eaf782e7ca92",
                                                "text": "He says the company's FLIRT design, in particular its retractable steps, provides greater accessibility, while the technology is highly innovative and reliable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retractable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2930bf6b-e730-3e56-87b9-34bf91f8515a",
                                        "entry_id": "3e063e88-c1d9-3af4-b593-19d066155a78",
                                        "glosses": [
                                            "A retractable pen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53059ce3-47c5-4cbb-87d0-f00cfe1aabfc",
                                                "sense_id": "2930bf6b-e730-3e56-87b9-34bf91f8515a",
                                                "text": "Somewhere in the cosmos, he said, […] there was also a planet entirely given over to Biro life forms. […] Veet Voogajig suddenly claimed to have found this planet, and to have worked there for a while driving a limousine for a family of cheap green retractables […]"
                                            }
                                        ]
