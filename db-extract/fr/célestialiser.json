                "senses": [
                    {
                        "sense_id": "e232fad0-3a56-378a-ae3c-eaae1e381bb4",
                        "entry_id": "c4bc5c91-55b5-3b7c-b426-e92d72387679",
                        "glosses": [
                            "Donner un caractère céleste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618a3a58-e3bf-4e8c-9320-9888909df74e",
                                "sense_id": "e232fad0-3a56-378a-ae3c-eaae1e381bb4",
                                "text": "C’est ainsi que, pour obtenir des effets merveilleux — car bénéfiques, imprévisibles et improbables —, il est appelé à se rendre quasiment divin, ou plutôt à se \"célestialiser\" comme tout chrétien céleste en a normalement l’ambition."
                            },
                            {
                                "example_id": "bf99d8d1-9f0a-4c57-8e1f-a33377d14eee",
                                "sense_id": "e232fad0-3a56-378a-ae3c-eaae1e381bb4",
                                "text": "Notre Père Céleste a un corps de chair et d’os, glorifié, ressuscité et célestialisé."
                            }
                        ]
                    }
                ],
