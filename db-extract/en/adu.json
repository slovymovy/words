                        "examples": [
                            {
                                "example_id": "14fb55a8-2376-4b47-9198-ca5eb6e09524",
                                "sense_id": "035f08fe-5dfa-3db2-9990-44d576815a27",
                                "text": "Near-synonyms: granny annexe, granny flat, granny room, in-law unit, mother-in-law apartment, secondary suite, casita, garden apartment"
                            },
                            {
                                "example_id": "c1785964-2ce7-4928-a8c0-d75becc6ae67",
                                "sense_id": "035f08fe-5dfa-3db2-9990-44d576815a27",
                                "text": "A.D.U.s, whether stand-alone or connected to the main house, are being embraced by a growing number of cities and states in response to their lack of affordable housing."
                            },
                            {
                                "example_id": "699dc540-c14b-4b8f-8a3f-fa7a46c89e39",
                                "sense_id": "035f08fe-5dfa-3db2-9990-44d576815a27",
                                "text": "One solution is accessible dwelling units, or ADUs, but contractors say building them is no small task.\n“Building a single ADU — California has done better at making it more streamlined, but it’s still very difficult,” said Tankersley."
                            }
                        ]
