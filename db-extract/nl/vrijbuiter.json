                    {
                        "sense_id": "783409af-7d12-34ec-9f3c-cfdf97bed35e",
                        "entry_id": "d79573a2-3d2f-3dbb-b0cd-d0ab3493aa06",
                        "glosses": [
                            "dobrodruh, flibustýr, soukromý kolonizátor, bukanýr, pirát"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2fe9f2-c2cd-4bab-998f-68b5ccbb5a9a",
                                "sense_id": "783409af-7d12-34ec-9f3c-cfdf97bed35e",
                                "text": "Kapers werden vaak vrijbuiters als hun dat uitkwam, zodat het verschil niet zo groot was.",
                                "translation": "Únosci se často stávali bukanýry, takže ten rozdíl nebyl tak zásadní."
                            },
                            {
                                "example_id": "540acb14-bd77-4390-ae99-264429e9e6c9",
                                "sense_id": "783409af-7d12-34ec-9f3c-cfdf97bed35e",
                                "text": "De afwisseling van vijvers, grasvlakten, struiken en bosjes vormt een groot, structuurrijk geheel dat naar vleermuizen één uitgelezen vrijbuiter biedt.",
                                "translation": "Střídání rybníků, travnatých ploch, keříků a remízků vytváří velký, strukturně bohatý celek, který netopýrům poskytuje vynikající loviště."
                            }
                        ]
