                "senses": [
                    {
                        "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                        "entry_id": "bed05ec7-e9b1-352e-b94b-30d15c856b80",
                        "glosses": [
                            "A deep-fried dumpling in American Asian cuisine, stuffed with a specified ingredient (typically crab)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10bccef6-fe95-49e5-99ef-4a2b34dab4db",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "Instead he orders beef vindaloo, Cantonese lobster with ginger sauce, pork rangoon, and something called salad pizza. He pays for it, eats it, and leaves the cartons in his living room, every inch of which is piled with books."
                            },
                            {
                                "example_id": "f844a50d-1319-44f4-a7eb-4ff522c33207",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "\"I wanted to scream, Why don't you just take the damn thing out of there and ask me to marry you? But, nothing. The man just sat there and then looked down and finished eating his fucking chicken Rangoon.\""
                            },
                            {
                                "example_id": "8b2d41d6-d197-49d0-91d8-7c67e98eba59",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "[...] spanakopita, and dolmades peacefully coexist on the menu with Goan coconut curry, shrimp rangoon, samosas, and chicken biryani."
                            },
                            {
                                "example_id": "a63e0866-9c3b-4cdc-99bd-b56891eb6351",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "The box exploded on my chest, and I was covered from head to toe with chicken rangoon. I don't even like Chinese. No more Mr. Nice Guy. Ox launched himself at the fat man, hitting him square in his beer belly."
                            },
                            {
                                "example_id": "18d9fd50-5a20-49c9-9856-a3d3a09f48b7",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "They ordered in Chinese—fried egg rolls, wontons stuffed with pork, crispy orange beef, greasy lo mein, and shrimp Rangoon. Fina ate until she was stuffed, took a long shower, and collapsed into Milloy's bed."
                            },
                            {
                                "example_id": "46b47aa3-0d04-4054-be0b-6115773ddaf7",
                                "sense_id": "d6ef0ace-50a9-341e-b4c0-a376a60a4f53",
                                "text": "Festooned with bamboo and mahogany, these establishments served Maui onion soup, shrimp rangoon, and sweet barbecued ribs; their colorful drinks included mai tais, lava flows, and Blue Hawaiians, libations inevitably topped with tiny[…]"
                            }
                        ]
                    }
