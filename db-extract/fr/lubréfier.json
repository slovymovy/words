                        "glosses": [
                            "Variante ancienne de lubrifier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cddbd132-a713-4d39-97fb-8a8d27cccc8d",
                                "sense_id": "f5caebe1-e3be-3bf8-9390-38982d075509",
                                "text": "L’odeur de l’huile qu’on ajoute à la laine pour la lubréfier et faciliter le cardage et le peignage n’est désagréable que pour les étrangers."
                            },
                            {
                                "example_id": "2eea1887-6e58-4d62-88db-a4c153dae85e",
                                "sense_id": "f5caebe1-e3be-3bf8-9390-38982d075509",
                                "text": "Déjà Chambige sentait son cœur impassible vibrer au son des mandolines, sa sécheresse d’âme se lubréfier à l’aspect du ciel étoilé."
                            }
                        ]
                    }
