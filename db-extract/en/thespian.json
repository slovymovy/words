                "senses": [
                    {
                        "sense_id": "34febbd7-2f99-3726-abef-87fed5270ec1",
                        "entry_id": "3b0aa7e3-3b73-362a-8666-a06a63270ae5",
                        "glosses": [
                            "Alternative letter-case form of thespian."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "be4b9caf-1072-41c9-9b46-6f3eb143c2e5",
                                "sense_id": "34febbd7-2f99-3726-abef-87fed5270ec1",
                                "text": "Went to that magnificent Temple of Thalia, the New Olympic, and saw the bewitchingest Pauline, in the person of Winifred Emery, that ever I saw in the shammiest, stagiest, tawdriest, tinsellest, transparentest, most diaphanously theatrical comedy I ever saw in the absolute period of my Thespian existence."
                            },
                            {
                                "example_id": "a55bf800-9cac-4817-ac88-65a10a5838e7",
                                "sense_id": "34febbd7-2f99-3726-abef-87fed5270ec1",
                                "text": "He stopped, and smiled, his blond hair, male-model good looks, and his ponytail giving away his Thespian dreams."
                            },
                            {
                                "example_id": "e66c35ec-7f59-4200-a485-8d6e0d08a038",
                                "sense_id": "34febbd7-2f99-3726-abef-87fed5270ec1",
                                "text": "“A stunning clotheshorse upon whom no discernible Thespian demands were made,” wrote Jack Gould, the television critic for The New York Times."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
