                        "sense_id": "980159aa-a7b2-3d8a-bd1d-4adc1eb485f3",
                        "entry_id": "a95dcf3e-37bd-31f0-afe4-9ca88a0789dc",
                        "glosses": [
                            "durch die vorherrschende (aktuelle) Lage bestimmt/hervorgerufen/beeinflusst"
