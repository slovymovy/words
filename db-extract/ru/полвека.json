                        "source_sense_id": "8c26017a-5dc3-38a1-b841-8c4c98a08e1b",
                        "target_lang_word": "demi-siècle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-siècle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04860d6f-b61c-39b2-9a6d-f51a98ff3a4a",
                                        "entry_id": "5441f9a6-d83b-39f4-b9d7-06f7c8c02c71",
                                        "glosses": [
                                            "Cinquante années, la moitié d’un siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82d6d40-069c-41de-9354-9d12f16c0510",
                                                "sense_id": "04860d6f-b61c-39b2-9a6d-f51a98ff3a4a",
                                                "text": "Pendant un demi-siècle, les bourgeoises de Pont-l’Évêque envièrent à Mme Aubain sa servante Félicité."
                                            },
                                            {
                                                "example_id": "3a8892c9-29a1-4a5b-b244-b142c5657f57",
                                                "sense_id": "04860d6f-b61c-39b2-9a6d-f51a98ff3a4a",
                                                "text": "Son premier coup d’œil ne fut pas pour ma coéquipière mais pour ma moto. Je grommelai : — Je sais, c’est une BM récente. La tienne a plus d’un demi-siècle ?"
                                            },
                                            {
                                                "example_id": "ca168fb0-c7fb-4175-87ea-594d8207624a",
                                                "sense_id": "04860d6f-b61c-39b2-9a6d-f51a98ff3a4a",
                                                "text": "Ces remarques simples n’ont pas empêché la presse française, unanime, de consacrer sa première page, le 1ᵉʳ janvier 1950, à l’avènement du second demi-siècle et au bilan du demi-siècle déjà écoulé. Naturellement la presse fut muette lors du véritable milieu du xxᵉ siècle, le 1ᵉʳ janvier 1951."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
