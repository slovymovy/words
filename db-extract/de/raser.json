                ],
                "senses": [
                    {
                        "sense_id": "c7deaec1-6f97-3d32-a9c3-97f717d9eeee",
                        "entry_id": "c5371de7-aa7f-3a44-ba83-9468372509f7",
                        "glosses": [
                            "Chauffard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df6212e-46d9-4ec8-9699-26fe7a62a1cf",
                                "sense_id": "c7deaec1-6f97-3d32-a9c3-97f717d9eeee",
                                "text": "Die Polizei führt eine Geschwindigkeitskontrolle durch. Raser werden an Ort und Stelle abgestraft.",
                                "translation": "La police effectue un contrôle de vitesse. Les chauffards sont mis à l’amende sur place."
                            },
                            {
                                "example_id": "38f6152b-d2b7-4bf8-a880-67e4ecda59b4",
                                "sense_id": "c7deaec1-6f97-3d32-a9c3-97f717d9eeee",
                                "text": "Die Polizei hat am Wochenende bei Kontrollen mehrere Raser gestoppt. (...) Alle vier mussten ihre Führerscheine abgeben und ihre Fahrzeuge wurden beschlagnahmt.",
                                "translation": "La police a arrêté plusieurs chauffards lors de contrôles ce week-end. (...) Les quatre ont dû rendre leur permis de conduire et leurs véhicules ont été confisqués."
                            }
                        ]
                    }
