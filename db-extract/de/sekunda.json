                        "entry_id": "5d13b89b-4f1e-3a1f-bb50-38d5ffa88e0b",
                        "glosses": [
                            "Classe de seconde au lycée, qui correspond aux 10ème (Untersekunda) et 11ème (Obersekunda) années depuis la première classe du primaire."
                        ],
                        "tags": [
                            "Allemagne",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "0d74bf41-b74e-4a67-af86-a36b1f00a532",
                                "sense_id": "3aca9478-bf31-3c3e-b433-a0c98336ae48",
                                "text": "Die beiden Sekunden unserer Schule gehen dieses Jahr gemeinsam auf Klassenfahrt.",
                                "translation": "Les deux secondes de notre école font un voyage de classe ensemble cette année."
                            }
                        ]
                    },
