                                                "sense_id": "88b1f9d3-488e-3826-948e-e4bf0cfce6ca",
                                                "text": "I second the need for a bazillion dollars. 'twould be nice. :-)"
                                            },
                                            {
                                                "example_id": "a184c3a6-ba78-4dc3-a603-7c43eb193ffa",
                                                "sense_id": "88b1f9d3-488e-3826-948e-e4bf0cfce6ca",
                                                "text": "I wouldn't sleep with him in a bazillion years, but I'm not scared of him."
                                            },
                                            {
                                                "example_id": "60b68465-d0c0-4d0b-8cdb-d6ec48051193",
                                                "sense_id": "88b1f9d3-488e-3826-948e-e4bf0cfce6ca",
                                                "text": "I have a bazillion of these kernel messages showing up in my logs..."
                                            }
