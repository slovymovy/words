                                        "entry_id": "a85d9635-70ee-3973-aaa6-99d1dcc5198c",
                                        "glosses": [
                                            "Situation, bei der die Temperatur über ein bestimmtes Maß ansteigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "973a36a6-3c32-4cad-b3b8-06e4cb1e87fa",
                                                "sense_id": "0ffc95cc-d09a-3eef-a5df-b2c79e32a73e",
                                                "text": "„Eine Überhitzung der Bremsen tritt typischerweise bei langen Abfahrten im Hochgebirge auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb96f794-7ddc-326e-99d9-812371198ab5",
                                        "entry_id": "a85d9635-70ee-3973-aaa6-99d1dcc5198c",
                                        "glosses": [
                                            "Situation, bei der die Nachfrage höher als die Produktion bei normaler Auslastung ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0974a646-3aca-4dc6-92bc-9965fe5a7d13",
                                                "sense_id": "eb96f794-7ddc-326e-99d9-812371198ab5",
                                                "text": "„Als Erster warnte der Sachverständigenrat im Herbst davor, dass sich die Zeichen für eine Überhitzung mehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
