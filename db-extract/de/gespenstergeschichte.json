                        "source_sense_id": "d5526660-0943-3f0b-b9b6-4af9fcd83998",
                        "source_sense_description": "unheimliche Erzählung über Gespenster",
                        "target_lang_word": "ghost story",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ghost story",
