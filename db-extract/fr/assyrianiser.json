                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfe4713-4d13-4e67-9945-bf40a7ac9144",
                                "sense_id": "681a7a8a-b649-31f5-bf3e-a4ef53349d0d",
                                "text": "On amène des Assyriens, qui sont chargés d’assyrianiser Gargamis, exactement comme on avait fait pour Hamath."
                            },
                            {
                                "example_id": "4535a0b4-8a75-4bcc-8e01-45f84a499ecb",
                                "sense_id": "681a7a8a-b649-31f5-bf3e-a4ef53349d0d",
                                "text": "A ce temps, il semble que sur la manie d’assyrianiser, ce fut celle d’imiter l’Égypte qui prévalut."
                            }
                        ]
                    }
