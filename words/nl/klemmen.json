{
    "word_family": [
        "klem",
        "beklemmen",
        "klemming",
        "klemtoon",
        "vastklemmen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa20d909-02b4-340f-90a1-7d9939ca1806",
                    "sense_definition": "iets stevig vastzetten of samendrukken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vastzetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb per ongeluk mijn vinger tussen de zware deur <w>geklemd</w>.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>pinched</w> my finger in the heavy door.",
                                "pl": "Przypadkowo <w>przytrzasnąłem</w> sobie palec ciężkimi drzwiami."
                            }
                        },
                        {
                            "text": "Je moet de papieren goed <w>klemmen</w> onder de metalen clip.",
                            "target_lang_translations": {
                                "en": "You need to <w>clamp</w> the papers properly under the metal clip.",
                                "pl": "Musisz dobrze <w>zacisnąć</w> dokumenty pod metalowym klipsem."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastklemmen",
                        "aandrukken",
                        "vastzetten"
                    ],
                    "antonyms": [
                        "loslaten"
                    ],
                    "common_phrases": [
                        "tussen de deur klemmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to firmly secure or compress something",
                        "pl": "mocno coś ściskać, zaciskać lub przytrzymywać w ucisku"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "to squeeze between two objects"
                            },
                            {
                                "target_lang_word": "clamp",
                                "target_lang_sense_clarification": "to fasten or hold tightly with a device"
                            },
                            {
                                "target_lang_word": "jam",
                                "target_lang_sense_clarification": "to wedge something tightly into a space"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przytrzasnąć",
                                "target_lang_sense_clarification": "np. palec drzwiami"
                            },
                            {
                                "target_lang_word": "zaciskać",
                                "target_lang_sense_clarification": "mocno ściskać coś uchwytem lub klamrą"
                            },
                            {
                                "target_lang_word": "ściskać",
                                "target_lang_sense_clarification": "wywierać silny nacisk z obu stron"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0c60efc-8dbf-3b00-b595-e6484a1fa9bc",
                    "sense_definition": "niet soepel bewegen of vastzitten door wrijving",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vastzitten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De houten deur <w>klemt</w> vreselijk door het vochtige weer van vandaag.",
                            "target_lang_translations": {
                                "en": "The wooden door is <w>sticking</w> terribly because of today's damp weather.",
                                "pl": "Drewniane drzwi strasznie się <w>zacinają</w> przez dzisiejszą wilgotną pogodę."
                            }
                        },
                        {
                            "text": "Als de lade blijft <w>klemmen</w>, moet je er misschien wat kaarsvet op smeren.",
                            "target_lang_translations": {
                                "en": "If the drawer keeps <w>binding</w>, you might need to rub some candle wax on it.",
                                "pl": "Jeśli szuflada nadal się <w>zacina</w>, być może powinieneś posmarować ją woskiem ze świecy."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastlopen",
                        "vastzitten"
                    ],
                    "antonyms": [
                        "lopen"
                    ],
                    "common_phrases": [
                        "de deur klemt"
                    ],
                    "target_lang_definitions": {
                        "en": "to not move smoothly or to be stuck due to friction",
                        "pl": "nie poruszać się płynnie, zacinać się lub blokować z powodu tarcia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick",
                                "target_lang_sense_clarification": "to be fixed in place and difficult to move"
                            },
                            {
                                "target_lang_word": "bind",
                                "target_lang_sense_clarification": "to hinder movement through friction or tight fit"
                            },
                            {
                                "target_lang_word": "jam",
                                "target_lang_sense_clarification": "to become stuck or wedged"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zacinać się",
                                "target_lang_sense_clarification": "o drzwiach, szufladzie lub zamku"
                            },
                            {
                                "target_lang_word": "blokować się",
                                "target_lang_sense_clarification": "utknąć z powodu braku luzu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70e2b392-a95f-30a5-9cc3-203bd759c462",
                    "sense_definition": "meervoud van <w>klem</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben verschillende <w>klemmen</w> nodig om de houten planken vast te houden.",
                            "target_lang_translations": {
                                "en": "We need several <w>clamps</w> to hold the wooden planks in place.",
                                "pl": "Potrzebujemy kilku <w>ścisków</w>, aby przytrzymać drewniane deski."
                            }
                        },
                        {
                            "text": "De wasknijpers zijn eigenlijk kleine <w>klemmen</w> voor je natte kleding.",
                            "target_lang_translations": {
                                "en": "Clothespins are actually small <w>clips</w> for your wet clothes.",
                                "pl": "Klamerki do prania to właściwie małe <w>zaciski</w> na mokre ubrania."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'clamp' or 'clip'",
                        "pl": "liczba mnoga od słowa oznaczającego zacisk, klamrę lub ścisk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clamps",
                                "target_lang_sense_clarification": "tools used to hold things together"
                            },
                            {
                                "target_lang_word": "clips",
                                "target_lang_sense_clarification": "small fasteners"
                            },
                            {
                                "target_lang_word": "grips",
                                "target_lang_sense_clarification": "devices that hold something firmly"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ściski",
                                "target_lang_sense_clarification": "narzędzia stolarskie lub montażowe"
                            },
                            {
                                "target_lang_word": "klamry",
                                "target_lang_sense_clarification": "elementy spinające lub przytrzymujące"
                            },
                            {
                                "target_lang_word": "zaciski",
                                "target_lang_sense_clarification": "uchwyty zaciskowe lub klipsy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}