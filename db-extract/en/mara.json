                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtmahr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba87bd50-1a7e-3f1e-9b4d-975e240899b0",
                                        "entry_id": "4cc939db-04e9-31ed-9552-c489d36701d5",
                                        "glosses": [
                                            "ein Schreckgespenst, welches in einem Traum auftaucht (vergleiche das englische nightmare (Albtraum))"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7b74a27-e658-4e39-ad85-7e9506fdbbe7",
                                                "sense_id": "ba87bd50-1a7e-3f1e-9b4d-975e240899b0",
                                                "text": "Er kam mir vor wie ein Nachtmahr."
                                            },
                                            {
                                                "example_id": "299a735f-8cb7-4c70-8cc5-4867a01c3a2d",
                                                "sense_id": "ba87bd50-1a7e-3f1e-9b4d-975e240899b0",
                                                "text": "„Wenn Hoffmann allein in seinem Arbeitszimmer ist, scheucht die Flamme der Kerzen im zitternden Wasser der Spiegel Gespenster und Nachtmahre auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eecfeddb-67d6-354d-af14-dfc5ee217911",
                                        "entry_id": "4cc939db-04e9-31ed-9552-c489d36701d5",
                                        "glosses": [
                                            "ein Traum, der sehr unangenehm ist und Angst bereitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304f80ae-41da-430f-ac06-8a77477dc4df",
                                                "sense_id": "eecfeddb-67d6-354d-af14-dfc5ee217911",
                                                "text": "Der Film am Samstag war so gruselig, dass ich darauf einen Nachtmahr hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1e2277-e4dc-4dfb-a855-1ff85c6367fc",
                        "source_entry_id": "1c2fdac3-025a-38b5-a81b-0dbfa6c4136e",
