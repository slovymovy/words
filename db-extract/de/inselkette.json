                "senses": [
                    {
                        "sense_id": "652052e0-a47d-3dcd-8280-f747f9b00ff2",
                        "entry_id": "f8b41677-ca24-3a7e-a377-b560c165e0e2",
                        "glosses": [
                            "Gruppe von benachbarten Inseln, die entlang einer Linie liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d7c12d-4baa-45b4-84f1-b9eaaeec2a20",
                                "sense_id": "652052e0-a47d-3dcd-8280-f747f9b00ff2",
                                "text": "„Barbados ist die östlichste Insel der Inselkette der Kleinen Antillen und liegt im Atlantischen Ozean.“"
                            },
                            {
                                "example_id": "30686122-e1c1-44b6-a27d-0012864c7402",
                                "sense_id": "652052e0-a47d-3dcd-8280-f747f9b00ff2",
                                "text": "„Andere Inselketten sind wärmer, reicher, bessere Fährverbindungen, heitere Leute, aber ich bin auf Inö und werde bleiben, solange mir die fremde Landschaft Gewißheit gibt, kein weiterer Zufall in die Quere kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
