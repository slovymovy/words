                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                        "entry_id": "d1ef7cde-6ae6-3d22-b0f7-9f26cf701e2e",
                        "glosses": [
                            "Partisan d’une théorie du complot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92e489f-dc68-40ab-90c5-d61006216420",
                                "sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                                "text": "En science et en médecine aussi, les complotistes sont légion, parfois appuyés par des scientifiques."
                            },
                            {
                                "example_id": "7f3de8ca-9d82-4999-91a0-b8963df90159",
                                "sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                                "text": "Contrairement aux complotistes, Posner a la bonne méthode d'investigation, la méthode zététique, chère aux esprits critiques éclairés tels qu'Henri Broch en France, ou James Randi aux États-Unis."
                            },
                            {
                                "example_id": "1950a19b-4abb-421c-b82b-9bd1712a73c4",
                                "sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                                "text": "L'histoire, n'en déplaise aux élitistes et aux complotistes, faces complémentaires d'une même incompréhension, est faite par les masses, aisées, pauvres ou médiocres."
                            },
                            {
                                "example_id": "45dbd1b1-e289-4423-85df-49534cd76879",
                                "sense_id": "7ee22943-9e67-3d33-8fbf-47e02e87924d",
                                "text": "L’image aurait possiblement été captée le 20 décembre 2020 alors que quelques milliers de complotistes se sont réunis dans la métropole pour participer à une manifestation contre les mesures sanitaires imposées par le gouvernement face à la pandémie de COVID-19."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b86ead22-afd6-45c6-b4ea-a811134c717a",
