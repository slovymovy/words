                    },
                    {
                        "translation_id": "ceec582c-392b-4fa6-9f14-ecae54fa1f01",
                        "source_entry_id": "6bfcb0be-612b-3711-b303-eb7f54162587",
                        "source_sense_id": "dc7a9c04-5133-323d-b203-2b683c06e22d",
                        "source_sense_description": "iemand die gevangen genomen is",
                        "target_lang_word": "Häftling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häftling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                        "entry_id": "f1010de4-0697-3f98-835d-3944f8fc16bd",
                                        "glosses": [
                                            "Person, die in Haft ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71dac14-0249-4cd1-be79-9d1b78dee98e",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Der Häftling muss seine Besitztümer abgeben."
                                            },
                                            {
                                                "example_id": "a8ec0fea-ce53-4260-922e-242f54751794",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Die Häftlinge werden in ein anderes Gefängnis verlegt."
                                            },
                                            {
                                                "example_id": "0f8b0448-ed30-4c72-ae61-b924ad41848e",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "Władysław Bartoszewski ist tot. Der Auschwitz-Häftling und ehemalige polnische Außenminister engagierte sich über Jahrzehnte für die deutsch-polnische Versöhnung."
                                            },
                                            {
                                                "example_id": "a08e64ba-e21b-4834-bc10-a4ee34ae5ae9",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "200 Häftlinge seien [aus der Haftanstalt] ausgebrochen, nur zehn habe man bislang wieder dingfest machen können, berichteten Polizei und Justiz in der Stadt Minna in Zentralnigeria."
                                            },
                                            {
                                                "example_id": "0242a2b0-8eaf-4cf8-924a-72fad6313b75",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Die anderen Häftlinge starrten ihn mit eisiger Miene an.“"
                                            },
                                            {
                                                "example_id": "46c35574-62b3-4c9c-a1e7-3c5dd2eef46a",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Unser Häftling war vollkommen eingeschüchtert.“"
                                            },
                                            {
                                                "example_id": "728cbf0a-f497-47d2-9fbf-442e2698fa92",
                                                "sense_id": "62f88aaa-b486-3ef9-887e-8fe0590e6dc4",
                                                "text": "„Als Schülerin demonstrierte ich gegen den Golfkrieg, während meines Psychologiestudiums probte ich mit Häftlingen ein Theaterstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc985c60-a897-460e-bb9a-5876b8a40778",
                        "source_entry_id": "6bfcb0be-612b-3711-b303-eb7f54162587",
                        "source_sense_id": "dc7a9c04-5133-323d-b203-2b683c06e22d",
                        "source_sense_description": "iemand die gevangen genomen is",
                        "target_lang_word": "prisoner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisoner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person incarcerated in a prison, while on trial or serving a sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f9c94c-e1e7-45d9-9bda-a7d925cc66c2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "Two other prisoners were staying in the same cell as him."
                                            },
                                            {
                                                "example_id": "ecff8481-0a8a-4356-b99c-a0587a2c82a2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "The evidence disclosed that the three prisoners were in a public-house together with the prosecutor, Abraham Rhodes, and that in concert with the other two prisoners, the prisoner John Dewhirst placed a pencase on the table in the room where they were assembled, and left the room to get writing-paper."
                                            },
                                            {
                                                "example_id": "8a897d78-9989-460d-b0ce-d4b047eff474",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "American journalist Evan Gershkovich and former US Marine Paul Whelan were among the 24 detainees released as part of a complex prisoner swap between Russia, the US and other Western nations. […] Krasikov, a former high-ranking FSB colonel serving a life sentence in a German prison, was on the top of Moscow’s list of Russian prisoners it wanted to exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "Any person held against their will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed10d49-3a6d-461c-93e6-211ea5090a5f",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "And gainſt the General we will lift our ſwords / And either lanch his greedie thirſting throat, / Or take him priſoner, and his chaine ſhall ſerue / For Manackles, till he be ranſom’d home."
                                            },
                                            {
                                                "example_id": "27825753-244a-408d-8e27-06acaa6eed23",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person who is or feels confined or trapped by a situation or a set of circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eabbee-6245-4ea3-b0b6-07ce02fdda7d",
                                                "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                                "text": "I am no longer a prisoner to fear, for I am a child of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82892f05-6743-4057-a9ea-bbe9371e07c5",
                        "source_entry_id": "6bfcb0be-612b-3711-b303-eb7f54162587",
                        "source_sense_id": "dc7a9c04-5133-323d-b203-2b683c06e22d",
                        "source_sense_description": "iemand die gevangen genomen is",
                        "target_lang_word": "prisonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5b12c47-08d4-3024-88a7-585f07b693de",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Personne qui est arrêtée pour être mise en prison, ou qui y est détenue."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18136a8c-2f04-4877-8492-037c62b024f8",
                                                "sense_id": "c5b12c47-08d4-3024-88a7-585f07b693de",
                                                "text": "J'ai vu des prisonniers jetés à coups de matraque d'un étage à l'autre et qui, hébétés par la torture et les coups, ne savaient plus que murmurer en arabe les premières paroles d'une ancienne prière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Celui qui a été pris à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8be222-c3ce-4a02-bce3-6000d6b5b7e4",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Faits prisonniers par les dragons prussiens, nous avions été emmenés jusqu’à Vrigne-aux-Bois au grand trot de nos montures."
                                            },
                                            {
                                                "example_id": "281f68b2-2342-4022-8a02-566eceecce2d",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Le lieutenant Souchier a reçu de sa femme la nouvelle qu’il y a quarante prisonniers à Roanne! Pas un enfant, pas une vieille paralytique, sur la route de Charlieu, qui ne les ait déjà vus."
                                            },
                                            {
                                                "example_id": "f782a353-213c-440a-a2f9-62680435eb04",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Encore en 1870, une servante prussienne disait à un prisonnier français employé dans la ferme où elle travaillait : « Quand la guerre sera finie, je t’épouserai ; cela t’étonne ce que je te dis là, mais tu sais, pour nous, le patriotisme cela ne veut pas dire grand-chose. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9d407f-4c72-32e6-887a-18fbf13da633",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Personne qui a perdu sa liberté d’action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2c9bb09-4ea5-478f-92fa-0df0054679f9",
                                                "sense_id": "5b9d407f-4c72-32e6-887a-18fbf13da633",
                                                "text": "Vous êtes prisonnier de votre parti. — Il est prisonnier de son passé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prisonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Qui est emprisonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d0c60f-93a1-4e4f-8447-e89041ee817c",
                                                "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                                "text": "En ce moment, je conçus l’idée de faire prisonnier le prêtre et de le tuer ou d’obtenir ma liberté en échange de la sienne."
                                            },
                                            {
                                                "example_id": "67e57c79-772c-4344-bc94-b547c5a24d21",
                                                "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                                "text": "C'est là aussi que végètent misérablement les bédouines qui ont voulu suivre leurs maris prisonniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "832ab409-d966-376d-96dd-4cc1401943b4",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Qui est pris ; qui est entravé dans ses mouvements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97dfd91-bc56-45ad-99f2-cb05ed1ba606",
                                                "sense_id": "832ab409-d966-376d-96dd-4cc1401943b4",
                                                "text": "Il pâlit un peu, puis, tentant un effort désespéré, réussit à dégager un pied, tandis que l’autre restait prisonnier de la glu mouvante et fétide des profondeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebde18bf-c8f8-3fa9-b657-4bc318c4a336",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Captif, assujetti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6882709e-e586-49e5-847a-a72bdebae841",
                                                "sense_id": "ebde18bf-c8f8-3fa9-b657-4bc318c4a336",
                                                "text": "Or c'est typiquement ce que cherche à favoriser l'algorithme de TikTok, dans la mesure où le but de cet algorithme n'est pas forcément de faire monter Bardella en tant que tel, mais de garder prisonnier l'utilisateur sur la plateforme le plus longtemps possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35b6c4de-a1eb-44bb-b00b-68c52376a82d",
