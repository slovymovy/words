                ],
                "senses": [
                    {
                        "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                        "entry_id": "3676250d-f351-3d1c-9702-13b072d8fb5f",
                        "glosses": [
                            "Stahl, der eine witterungsbeständige Patina bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dab2d43-646f-409a-a34c-140b15b0f9eb",
                                "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                                "text": "„Witterungseinflüsse haben diesem Bauwerk binnen kurzer Zeit eine rotbraune Patina verliehen. Der neue, 30 Meter hohe Aussichtsturm im Lausitzer Seenland besteht aus besonders robustem Corten-Stahl.“"
                            },
                            {
                                "example_id": "5d2acae7-ee20-4dca-82a1-7274608fbc02",
                                "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                                "text": "„Auch dieses Tor wird wie die beiden bisherigen aus braunem Corten-Stahl hergestellt.“"
                            },
                            {
                                "example_id": "e544a633-0699-4b76-994b-6e09ba036bd7",
                                "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                                "text": "„Während sich das Haus jedoch verschließt, können die Passanten Sous’ viereinhalb Meter hohes Werk aus Corten-Stahl im Ganzen sehen und erleben.“"
                            },
                            {
                                "example_id": "fd3ed5e6-2475-41e1-87e0-1fb1c7ed99b2",
                                "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                                "text": "„Als Baumaterial wurde Corten-Stahl verwendet, eine Legierung, die sich durch hohe Witterungsbeständigkeit auszeichnet.“"
                            },
                            {
                                "example_id": "63cf3f34-c8af-4ee7-9778-08ba8d155042",
                                "sense_id": "cbbe9be4-78c8-3b55-b449-acacbfc9b885",
                                "text": "„Vier dieser Schachteln hängen über den Hang hinaus und geben dem vollständig in rostbraunen Corten-Stahl gekleideten Komplex ein gefährlich schwebendes Aussehen, zumal unterhalb der Boxen ein Fußweg am Hang entlangführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
