    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "89f68eb2-f15a-3fa3-b6dc-6c7eb76be0de",
                "word": "acquaintanceship",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "59f4b3d2-1c94-48ef-974a-dcc8804bf960",
                        "entry_id": "89f68eb2-f15a-3fa3-b6dc-6c7eb76be0de",
                        "tags": [
                            "plural"
                        ],
                        "form": "acquaintanceships"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e45ca1dc-ecdc-3efd-bf2c-0a92429002b0",
                        "entry_id": "89f68eb2-f15a-3fa3-b6dc-6c7eb76be0de",
                        "glosses": [
                            "The state of being acquainted."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "abedb996-37a7-47af-bf95-c33f11dfaa12",
                                "sense_id": "e45ca1dc-ecdc-3efd-bf2c-0a92429002b0",
                                "text": "What, eschew acquaintanceship? forget, After my most hearty commendations, my very trusty friend, ’Twere sin and shame Tomaso."
                            },
                            {
                                "example_id": "b0e5d380-80fd-4433-95a5-2ada81c653c4",
                                "sense_id": "e45ca1dc-ecdc-3efd-bf2c-0a92429002b0",
                                "text": "To host and hostess thus with fortune blest,\nLief had I come with better news to bear\nUnto your greeting and acquaintanceship;"
                            },
                            {
                                "example_id": "f3c9b241-c0f3-42d0-83df-735bd2710165",
                                "sense_id": "e45ca1dc-ecdc-3efd-bf2c-0a92429002b0",
                                "text": "Without effort, she took them with her into her ever widening circle of acquaintanceship, and the two Avonlea girls found their social pathway at Redmond made very easy and pleasant for them […]"
                            },
                            {
                                "example_id": "235e2bb2-71b0-460a-b40a-265617c20238",
                                "sense_id": "e45ca1dc-ecdc-3efd-bf2c-0a92429002b0",
                                "text": "When they talked down the telephone he heard a man whom he might respect at the other end of it — a fellow who sounded willing to let bygones be bygones and passion acquaintanceship."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                        "entry_id": "89f68eb2-f15a-3fa3-b6dc-6c7eb76be0de",
                        "glosses": [
                            "A relationship as acquaintances."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "22cf8004-fd44-4158-beb8-0edb5b5f338a",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "They began their acquaintanceship very lovingly, and after a shake or two by the hand, Bell gave him a more particular account of the uses and sanctity of his office […]"
                            },
                            {
                                "example_id": "441b0e17-cdd7-4061-8b9d-6aada0d7f538",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "In their long acquaintanceship and intimacy they could not recall an harsh word that had been uttered by Amelia."
                            },
                            {
                                "example_id": "32e57cb7-9b41-476f-ab75-65f108f7ed80",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "I have already spoken to them through my window to begin an acquaintanceship."
                            },
                            {
                                "example_id": "95536013-36c9-4165-8227-325049429251",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "A growing distaste for the forced acquaintanceships of travel and a craving for home brought me back."
                            },
                            {
                                "example_id": "57e1761d-740a-4eea-b114-a249cef50344",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "It was an acquaintanceship formed partly out of boredom, partly for mutual protection […]"
                            },
                            {
                                "example_id": "a46f6711-83e3-49ea-a902-f42addbc4a31",
                                "sense_id": "f5628577-ec4d-3d93-9f69-76d0236f82a9",
                                "text": "[…] because she felt a strange freedom—even a security—in having decided that no acquaintanceship could end in anything untoward, she felt emboldened to sometimes do and say such things to men […]"
                            }
                        ]
                    }
                ],
