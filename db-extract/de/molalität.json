                "senses": [
                    {
                        "sense_id": "57aa71bc-fd97-36af-b34d-3a1910a9b982",
                        "entry_id": "0fa85da2-73a9-3b8d-bafe-4d7572b010ce",
                        "glosses": [
                            "Gehaltsgröße zur Beschreibung einer Lösung; sie gibt an, wieviel Mol eines Stoffes pro Kilogramm Lösungsmittel gelöst sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7558ef8-9458-4bfa-b7e1-4746d2b7f672",
                                "sense_id": "57aa71bc-fd97-36af-b34d-3a1910a9b982",
                                "text": "„Da man eine Lösung bestimmter Molalität leicht durch genaues Einwägen herstellen kann, hat auch dieses Konzentrationsmaß seine Vorzüge.“"
                            },
                            {
                                "example_id": "f2e52cf5-9089-4229-8cc7-f2aa1805418b",
                                "sense_id": "57aa71bc-fd97-36af-b34d-3a1910a9b982",
                                "text": "„Allerdings hat die Molalität gegenüber der Stoffmengenkonzentration (Molarität) den Vorteil, dass sie unabhängig von thermisch bedingten Volumenänderungen ist.“"
                            }
                        ],
