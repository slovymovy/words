                "senses": [
                    {
                        "sense_id": "de4879e5-8a98-3ece-918c-c05d62243bd5",
                        "entry_id": "4439b01b-5566-3d96-b663-96f9a854b32f",
                        "glosses": [
                            "gespensterhafte Figur, die Angst verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79b9023-c2df-4d6d-9d95-ee32dd47b780",
                                "sense_id": "de4879e5-8a98-3ece-918c-c05d62243bd5",
                                "text": "„Siehst du dort den großen Butzemann?“ sagte der Vater, und wollte den Kleinen schrecken, damit er artig wäre, „der kommt und holt dich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59e07f93-e371-4259-ac13-c60ff614ab99",
                        "source_entry_id": "4439b01b-5566-3d96-b663-96f9a854b32f",
                        "source_sense_id": "de4879e5-8a98-3ece-918c-c05d62243bd5",
                        "source_sense_description": "gespensterhafte Figur, die Angst verbreitet",
                        "target_lang_word": "bogeyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bogeyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                        "entry_id": "06f996b6-7def-30cc-94c3-a75475bc092f",
                                        "glosses": [
                                            "A menacing, ghost-like monster in children's stories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76996e4-868a-43a3-b33f-9898a217bc41",
                                                "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                                "text": "Near-synonyms: bogeyperson, bogeywoman"
                                            },
                                            {
                                                "example_id": "06239591-b7f3-492f-a597-c9cf378233b8",
                                                "sense_id": "1914fb92-6a39-3c01-b73c-af7fdc0aee26",
                                                "text": "Lay your head down child\nI won't let the boogeyman come\nCounting bodies like sheep\nTo the rhythm of the war drums\nPay no mind to the rabble\nPay no mind to the rabble\nHead down, go to sleep\nTo the rhythm of the war drums"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                        "entry_id": "06f996b6-7def-30cc-94c3-a75475bc092f",
                                        "glosses": [
                                            "Any make-believe threat, especially one used to intimidate or distract; a real threat greatly exaggerated for those purposes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c82fe4b-1d02-486e-a491-e0bc38068c79",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "Near-synonyms: bug-a-boo, bugaboo, chimera"
                                            },
                                            {
                                                "example_id": "16ac37fb-e72b-4f29-9e9c-23258e1ff61a",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "The bogeyman of a Halloween-candy poisoner behind every door has animated occasional moral panics against trick-or-treating."
                                            },
                                            {
                                                "example_id": "7a55b2df-31a2-4846-9dd3-cf4d226a87c3",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "With no original ideas or solutions, they've now resorted to bringing out a tried-and-tested bogeymen in a last-ditch attempt to derail much-needed legislation."
                                            },
                                            {
                                                "example_id": "1c0ef2ea-76ce-4a34-b959-7d1f6b42e669",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "Before the Internet it was television. And, if not that, it was radio, films, or games. All have taken their turn as the popular bogeyman, blighting the minds of the young."
                                            },
                                            {
                                                "example_id": "ff72d65b-cae9-42e7-85ed-b4019ff54f40",
                                                "sense_id": "877e9722-cf13-3cea-824c-9894d7c4468b",
                                                "text": "If there’s a down side to the film, it’s that “Soros” probably doesn’t devote enough time to the way its subject has become a favorite bogeyman to conservatives that paint him as the guiding hand behind grassroots campaigns by those intent on discrediting them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e842bd6c-af41-4a5c-90dd-be6937ba04fa",
                        "source_entry_id": "4439b01b-5566-3d96-b663-96f9a854b32f",
                        "source_sense_id": "de4879e5-8a98-3ece-918c-c05d62243bd5",
                        "source_sense_description": "gespensterhafte Figur, die Angst verbreitet",
                        "target_lang_word": "croque-mitaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croque-mitaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddaf459-35e8-3ff9-afef-364053f3deda",
                                        "entry_id": "aa084164-690a-3cb3-981d-b3fe9d4f560c",
                                        "glosses": [
                                            "Personnage imaginaire dont on se sert pour faire peur aux enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25dfc30-d088-41e4-a1a2-c2b04e74081a",
                                                "sense_id": "9ddaf459-35e8-3ff9-afef-364053f3deda",
                                                "text": "C’est comme si, vraiment, en vrai aussi, il faisait peur comme ça ; hou, mais il vous regarde, tout simplement. Hou, quel croque-mitaine !"
                                            },
                                            {
                                                "example_id": "05872b0a-2f5f-41eb-963e-d1373186bc1f",
                                                "sense_id": "9ddaf459-35e8-3ff9-afef-364053f3deda",
                                                "text": "Plus loin, c’est el coco, croque-mitaine, qui vient effrayer les petits enfants et qui en effraierait bien d’autres, car, après l’ombre de Samuel dans le tableau de la Pythonisse d’Endor, par Salvator Rosa, nous ne connaissons rien de plus terrible que cet épouvantail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ecf683-1842-37f2-ac83-2f6da460ff5a",
                                        "entry_id": "aa084164-690a-3cb3-981d-b3fe9d4f560c",
                                        "glosses": [
                                            "Vain épouvantail."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae30596-8515-4225-96c0-f541fb62dabf",
                                                "sense_id": "81ecf683-1842-37f2-ac83-2f6da460ff5a",
                                                "text": "C’est un vrai croque-mitaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
