                ],
                "senses": [
                    {
                        "sense_id": "e5dfac2b-6546-3dcb-a294-80783a945c0d",
                        "entry_id": "4b50adfe-3f01-3f09-8309-99f339648f58",
                        "glosses": [
                            "Provisionner au préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6a10b4-a88f-4c20-825a-2ecbffe7856b",
                                "sense_id": "e5dfac2b-6546-3dcb-a294-80783a945c0d",
                                "text": "Il est possible d'utiliser l'interface de ligne de commande pour préprovisionner cette fonctionnalité."
                            },
                            {
                                "example_id": "89a64ed2-5ac4-4254-ab18-3ebbe036c8dd",
                                "sense_id": "e5dfac2b-6546-3dcb-a294-80783a945c0d",
                                "text": "Cette approche contourne la nécessité de préprovisionner des produits en vue de couvrir l'utilisation possible de tels services par des abonnés éligibles, ce qui signifie à son tour que les exigences de mémoire pour la base de données d'abonnés seront réduites dans la mesure où la base de de données ne doit plus contenir un nombre potentiellement élevé de produits préprovisionnés."
                            },
                            {
                                "example_id": "68d5354d-8c56-42eb-812e-1a2755a31b1b",
                                "sense_id": "e5dfac2b-6546-3dcb-a294-80783a945c0d",
                                "text": "Avec une jonction de domaine hors connexion, les administrateurs peuvent préprovisionner des comptes d'ordinateur dans le domaine pour préparer les systèmes d'exploitation au déploiement."
                            }
                        ]
                    }
