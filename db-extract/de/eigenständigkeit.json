                "senses": [
                    {
                        "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                        "entry_id": "d0ecc8fd-f814-3064-a03d-84e7a47a19bf",
                        "glosses": [
                            "Unabhängigkeit/Widerständigkeit gegen Einflüsse/Einwirkungen anderer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12fae19-d32e-4ec9-99fa-461478a88d36",
                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                "text": "„Auch dort haben sich die Bewohner eine Eigenständigkeit bewahrt, die schon fast an Starrsinn erinnert.“."
                            },
                            {
                                "example_id": "b4e8723e-2def-4fd5-af60-e33b73b405b2",
                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                "text": "„Gleichwohl aber wurde bis zu einem gewissen Grade eine Eigenständigkeit des Privaten und damit auch des privat-zwischenmenschlichen Diskurses bewahrt.“"
                            },
                            {
                                "example_id": "b1741d92-6135-4332-8032-a5b7416ff208",
                                "sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                                "text": "„An ihrer kostbaren Eigenständigkeit halten sie fest, die reichen Nationen, wie ein Ertrinkender an seinem Goldbarren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d34de444-9c97-490d-80db-262e27154832",
                        "source_entry_id": "d0ecc8fd-f814-3064-a03d-84e7a47a19bf",
                        "source_sense_id": "f24ed599-2625-3cbb-8ffd-34b7f1773ce0",
                        "source_sense_description": "Unabhängigkeit/Widerständigkeit gegen Einflüsse/Einwirkungen anderer",
                        "target_lang_word": "self-reliance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-reliance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                        "entry_id": "042fc22f-948c-319d-a6cd-bbc59421eac8",
                                        "glosses": [
                                            "The capacity to rely on one's own capabilities, and to manage one's own affairs; independence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc6c0e5-e8c5-4a8a-be60-5622075cb80f",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "Loss of self-reliance leads to loss of self-confidence."
                                            },
                                            {
                                                "example_id": "306a76b7-3193-4f71-bcfb-816afa880e24",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "The present sorrow always exceeds its predecessors—not so the present joy; comparison exaggerates the one, while it diminishes the other; and people talk of their youth as if it had not been a period of feverish sensitiveness, awkward embarrassments, many heart-burnings, and an utter want of that self-reliance which alone can ensure content."
                                            },
                                            {
                                                "example_id": "b9cde9ad-9931-4005-ab3d-c2bf68dd9835",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "A successful response uses social forces such as peer pressure and altruism to help people adapt to changing circumstances. It delivers messages and support that promote self-reliance rather than encourage people to fall back on stressed state support."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
