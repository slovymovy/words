    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50c4fd70-0fbe-35ef-8de8-6872ed0a4506",
                    "sense_definition": "godny zaufania; taki, na którym można polegać",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaufanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pan Tomasz zawsze był <w>spolegliwym</w> i miłym nauczycielem.",
                            "target_lang_translations": {
                                "en": "Mr. Tomasz was always a <w>reliable</w> and kind teacher.",
                                "ru": "Пан Томаш всегда был <w>надежным</w> и приятным учителем."
                            }
                        },
                        {
                            "text": "To bardzo <w>spolegliwy</w> pracownik, któremu można powierzyć każde zadanie.",
                            "target_lang_translations": {
                                "en": "He is a very <w>dependable</w> employee to whom you can entrust any task.",
                                "ru": "Это очень <w>надежный</w> сотрудник, которому можно доверить любое задание."
                            }
                        }
                    ],
                    "synonyms": [
                        "pewny",
                        "zaufany",
                        "niezawodny",
                        "rzetelny",
                        "słowny"
                    ],
                    "common_phrases": [
                        "spolegliwy pracownik",
                        "spolegliwy człowiek"
                    ],
                    "target_lang_definitions": {
                        "en": "worthy of trust; someone or something that can be relied upon",
                        "ru": "заслуживающий доверия, такой, на которого можно положиться"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reliable",
                                "target_lang_sense_clarification": "worthy of dependence or trust"
                            },
                            {
                                "target_lang_word": "trustworthy",
                                "target_lang_sense_clarification": "deserving of trust"
                            },
                            {
                                "target_lang_word": "dependable",
                                "target_lang_sense_clarification": "able to be relied on"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "человек или вещь, на которую можно положиться"
                            },
                            {
                                "target_lang_word": "заслуживающий доверия",
                                "target_lang_sense_clarification": "тот, кому можно доверять"
                            },
                            {
                                "target_lang_word": "ответственный",
                                "target_lang_sense_clarification": "добросовестный в выполнении обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aeec4352-a141-3c34-99a3-31ffed78eb4c",
                    "sense_definition": "skłonny do kompromisu, uległy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kryśka jest zbyt <w>spolegliwa</w> wobec koleżanek z pracy, daje sobie wciskać ich robotę.",
                            "target_lang_translations": {
                                "en": "Kryśka is too <w>compliant</w> with her coworkers; she lets them dump their work on her.",
                                "ru": "Крыська слишком <w>уступчива</w> по отношению к коллегам, позволяет им сваливать на себя их работу."
                            }
                        },
                        {
                            "text": "W negocjacjach nie zawsze warto być tak <w>spolegliwym</w> wobec drugiej strony.",
                            "target_lang_translations": {
                                "en": "In negotiations, it is not always worth being so <w>submissive</w> toward the other side.",
                                "ru": "В переговорах не всегда стоит быть таким <w>сговорчивым</w> по отношению к другой стороне."
                            }
                        }
                    ],
                    "synonyms": [
                        "kompromisowy",
                        "uległy",
                        "ustępliwy",
                        "ugodowy"
                    ],
                    "antonyms": [
                        "bezkompromisowy",
                        "nieustępliwy",
                        "kłótliwy",
                        "swarliwy"
                    ],
                    "common_phrases": [
                        "spolegliwy wobec innych"
                    ],
                    "target_lang_definitions": {
                        "en": "inclined to compromise; submissive or yielding",
                        "ru": "склонный к компромиссам, уступчивый"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compliant",
                                "target_lang_sense_clarification": "willing to do what others want"
                            },
                            {
                                "target_lang_word": "submissive",
                                "target_lang_sense_clarification": "meekly obedient or passive"
                            },
                            {
                                "target_lang_word": "acquiescent",
                                "target_lang_sense_clarification": "accepting something without protest"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "уступчивый",
                                "target_lang_sense_clarification": "легко соглашающийся на требования других"
                            },
                            {
                                "target_lang_word": "сговорчивый",
                                "target_lang_sense_clarification": "легко идущий на компромисс"
                            },
                            {
                                "target_lang_word": "податливый",
                                "target_lang_sense_clarification": "легко поддающийся влиянию или давлению"
                            }
                        ]
                    }
                }
            ]
