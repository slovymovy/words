                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0762f3b1-0e1e-4f64-b666-9dda0013bdd5",
                                                "sense_id": "46999a9f-d033-3e08-bb14-d64e8545ada5",
                                                "text": "Les États-Unis souhaitent aussi améliorer la protection de leurs 28 000 soldats déployés dans la péninsule et protéger Pusan, le principal point d'arrivée de renforts en cas de crise majeure, d'où l'implantation initialement prévue de la batterie à Seongju."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ae5301d-a1bd-41e2-8b2d-3938d3af47e0",
                        "source_entry_id": "6435a274-4332-3e94-a584-fb66b40b5daa",
                        "source_sense_id": "b1d9be07-8ce4-3674-97bd-c7a547042684",
                        "source_sense_description": "zweitgrößte Stadt und wichtigste Hafenstadt Südkoreas, die im Südosten des Landes liegt",
                        "target_lang_word": "Busan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Busan",
