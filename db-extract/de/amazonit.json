                        "glosses": [
                            "Mineral von grüner Farbe, das vorwiegend in magmatischem Gestein vorkommt und als Schmuckstein verwendet wird"
                        ],
                        "tags": [
                            "speziell Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "e78fca07-d643-4f7a-b8b9-6fd5b011aedc",
                                "sense_id": "10c5c72f-1b63-3573-8d95-aea7dadd57d5",
                                "text": "Aufgrund seines hohen Kalium-Anteils gehört der grün schimmernde Amazonit zu den Kalifeldspaten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
