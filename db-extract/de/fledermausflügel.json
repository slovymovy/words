                        "examples": [
                            {
                                "example_id": "6ed47554-fe5e-4a64-9b3e-fc72fd2feac7",
                                "sense_id": "11c98060-9660-3c90-a5c0-0c836dec953d",
                                "text": "„Darin befand sich eine Kreatur. Ihre Haut war grau und gepanzert. Sie hatte Fledermausflügel, Augen wie die eines Adlers, Zähne wie ein Hai und Krallen aus Metall.“"
                            },
                            {
                                "example_id": "34d801c6-1031-4095-916d-1bb542df628f",
                                "sense_id": "11c98060-9660-3c90-a5c0-0c836dec953d",
                                "text": "„Er zeigte auf eine Tätowierung auf seinem rechten Bizeps. »Soll eigentlich ein Fledermausflügel sein. Sieht aber aus wie ein Großsegel.«“"
                            },
                            {
                                "example_id": "c79c134b-c396-4f99-96f3-f0ee0142adc5",
                                "sense_id": "11c98060-9660-3c90-a5c0-0c836dec953d",
                                "text": "„Das Flattern von Fledermausflügeln torkelte durch die Schatten über ihren Baseballkappen.“"
                            },
                            {
                                "example_id": "ba27fddf-8511-4777-8b02-836c730cdf53",
                                "sense_id": "11c98060-9660-3c90-a5c0-0c836dec953d",
                                "text": "„Ein gehörnter Vogel mit Fledermausflügeln und kleinem Penis steht auf einem Felsen mitten im Meer.“"
                            },
                            {
                                "example_id": "9255f346-0416-4dfe-b119-1fef9f2d4897",
                                "sense_id": "11c98060-9660-3c90-a5c0-0c836dec953d",
                                "text": "„Schwingen weit größer als Fledermausflügel rauschten hoch über dem Jäger dahin, und zuweilen erspähte er in den verschatteten Kavernen gewaltige, furchteinflößende Körpermassen, die jenen Riesengeschöpfen und gigantischen Reptilien glichen, deren Gestampfe in Urzeitaltern die Erdkruste hatte erbeben lassen.“"
                            }
