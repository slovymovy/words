        "nl-extract.jsonl": [
            {
                "entry_id": "8ebdd6c3-9793-34d6-821f-307dd4e72827",
                "word": "veraanschouwelijken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                        "entry_id": "8ebdd6c3-9793-34d6-821f-307dd4e72827",
                        "glosses": [
                            "zichtbaar maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f4f0099-5512-4c61-9984-a0165d966fad",
                                "sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                                "text": "Die toorn heeft Jezus willen ondergaan. Uit kracht van Zijn goddelijke natuur was Hij in staat de last van Gods toorn in Zijn menselijke natuur te dragen (HC, zondag 6). Alleen door Zijn dood kon er voor onze zonden worden voldaan (HC, zondag 16). Is de kern van Jezus’ lijden te veraanschouwelijken?"
                            },
                            {
                                "example_id": "1bdead68-7c74-4a7b-977b-11375d132d8a",
                                "sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                                "text": "In een serie van acht litho's paste hij onder meer een knot wol toe, twee klosjes touw en een rits. Samen met enkele meer abstracte motieven veraanschouwelijken ze groeipatronen in de natuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "212d7c77-8cf8-4cec-86e2-8cd9ff98a0c3",
                        "source_entry_id": "8ebdd6c3-9793-34d6-821f-307dd4e72827",
                        "source_sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                        "target_lang_word": "illustrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c003dfe-51b2-37d0-bf02-c33cb12433fd",
                                        "entry_id": "25b72d66-071f-30f1-9692-3dc3b29fb925",
                                        "glosses": [
                                            "To clarify something by giving, or serving as, an example or a comparison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aaff31b-0a29-41de-8a99-65d5eb22a627",
                                                "sense_id": "2c003dfe-51b2-37d0-bf02-c33cb12433fd",
                                                "text": "We illustrate our definitions by including quotations or simple examples."
                                            },
                                            {
                                                "example_id": "1d7b2021-0d79-4113-818d-57322c98978e",
                                                "sense_id": "2c003dfe-51b2-37d0-bf02-c33cb12433fd",
                                                "text": "To prove him, and illustrate his high worth."
                                            },
                                            {
                                                "example_id": "c3f1c40d-f2aa-4287-afed-7b7880112b00",
                                                "sense_id": "2c003dfe-51b2-37d0-bf02-c33cb12433fd",
                                                "text": "England were graphically illustrating the huge gulf in class between the sides and it was no surprise when Lampard added the second just before the half hour. Steven Gerrard found his Liverpool team-mate Glen Johnson and Lampard arrived in the area with perfect timing to glide a header beyond Namasco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d42fda-0cf0-3a41-a84f-b30abe755196",
                                        "entry_id": "25b72d66-071f-30f1-9692-3dc3b29fb925",
                                        "glosses": [
                                            "To provide a book or other publication with pictures, diagrams or other explanatory or decorative features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed1b8ab-61ae-4c6c-a760-5e7834fb0d2f",
                                                "sense_id": "87d42fda-0cf0-3a41-a84f-b30abe755196",
                                                "text": "The economics textbook was illustrated with many graphs."
                                            },
                                            {
                                                "example_id": "76cf0380-f311-45b2-ad7b-523ae654c131",
                                                "sense_id": "87d42fda-0cf0-3a41-a84f-b30abe755196",
                                                "text": "Michael Thompson said he had been photographing prison buildings on Wednesday, Dec. 3, to illustrate an article by Tom Reeves […] when an unidentified plainclothes employee of the prison approached him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977ae4b9-0555-39e1-b293-aa1e517e7983",
                                        "entry_id": "25b72d66-071f-30f1-9692-3dc3b29fb925",
                                        "glosses": [
                                            "To shed light upon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9acbce-a6a4-476c-ad89-611172533c70",
                                                "sense_id": "977ae4b9-0555-39e1-b293-aa1e517e7983",
                                                "text": "Here, when the morn illustrates all the sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d05a98-d3d2-3301-ab58-43f915cf9905",
                                        "entry_id": "25b72d66-071f-30f1-9692-3dc3b29fb925",
                                        "glosses": [
                                            "To give renown or honour to; to make illustrious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3893af-afee-4260-b5d8-f77b53be419f",
                                                "sense_id": "53d05a98-d3d2-3301-ab58-43f915cf9905",
                                                "text": "Matter to me of glory, whom their hate / Illustrates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b8daaa8-ef89-4c62-8339-7e80c83c40ab",
                        "source_entry_id": "8ebdd6c3-9793-34d6-821f-307dd4e72827",
                        "source_sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                        "target_lang_word": "demonstrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonstrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show how to use (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc6ee62-da39-4461-a841-3d16f39769c1",
                                                "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                                "text": "Can you demonstrate the new tools for us?"
                                            },
                                            {
                                                "example_id": "30c1b261-7646-47a8-8025-47741e960620",
                                                "sense_id": "4e2f4202-a0d1-34e6-900d-27cbfe11e160",
                                                "text": "In this tape, a velvet-voiced narrator provides a stroke-by-stroke guide to massaging your partner. As she speaks, comely nude couples demonstrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6b3c10-cc54-315a-b961-8729d714bc88",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show the steps taken to create a logical argument or equation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6362f091-c483-3dd4-a197-7b53d63a2c04",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To participate in or organize a demonstration."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77342f0-9784-446d-b5ed-c26fca2b6138",
                                                "sense_id": "6362f091-c483-3dd4-a197-7b53d63a2c04",
                                                "text": "Those people outside are demonstrating against the election results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                        "entry_id": "b7b5a68a-9ff7-33dd-afcc-8c7810882dcf",
                                        "glosses": [
                                            "To show, display, or present; to prove or make evident"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78c78c2-8062-41d9-8c0c-5717fba18f0e",
                                                "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                                "text": "The debate was not long on policy, as questions about the Affordable Care Act and the war in Syria demonstrated."
                                            },
                                            {
                                                "example_id": "ea3db344-bddc-4510-8124-5e59321aabd6",
                                                "sense_id": "2e7e009a-4d0e-37b9-88f1-a469c5806547",
                                                "text": "\"What we are trying to demonstrate is that freight lines at lower speeds can be electrified much more cheaply. […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e533f997-9de0-469a-8449-4654274d84ae",
                        "source_entry_id": "8ebdd6c3-9793-34d6-821f-307dd4e72827",
                        "source_sense_id": "67892198-d478-34d5-bd95-384d35c93e19",
                        "target_lang_word": "expose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9271eba-826e-387d-ab7a-d491aac8ecd2",
                                        "entry_id": "b10585ba-b50b-3b21-9963-faefce4f96ac",
                                        "glosses": [
                                            "To reveal, uncover, make visible, bring to light, introduce (to)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c29662-91cf-454c-892f-637f118cd654",
                                                "sense_id": "f9271eba-826e-387d-ab7a-d491aac8ecd2",
                                                "text": "The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, […]. They also exposed the blatant discrepancy between the west's professed values and actual foreign policies."
                                            },
                                            {
                                                "example_id": "dcc21ca5-891c-4a58-950b-24c93a28fe8e",
                                                "sense_id": "f9271eba-826e-387d-ab7a-d491aac8ecd2",
                                                "text": "You understand that by using the Services, you may be exposed to Content that might be offensive, harmful, inaccurate or otherwise inappropriate, or in some cases, postings that have been mislabeled or are otherwise deceptive."
                                            },
                                            {
                                                "example_id": "cdad29a8-2500-418e-9587-ff3c3adb136c",
                                                "sense_id": "f9271eba-826e-387d-ab7a-d491aac8ecd2",
                                                "text": "Many supporters believed Donald Trump would finally expose government cover-ups once he returned to power. But more than six months into his new term, those much-hyped conspiracy theories have either been debunked or quietly fallen apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4452f63d-d9c3-3fcc-9cba-d52d1b3eeefc",
                                        "entry_id": "b10585ba-b50b-3b21-9963-faefce4f96ac",
                                        "glosses": [
                                            "To subject photographic film to light thereby recording an image."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e37da4ea-7a3d-320a-b0fd-f762094e13ee",
                                        "entry_id": "b10585ba-b50b-3b21-9963-faefce4f96ac",
                                        "glosses": [
                                            "To abandon, especially an unwanted baby in the wilderness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97df3d0b-9d5b-47e0-bd04-3f410032ab9a",
                                                "sense_id": "e37da4ea-7a3d-320a-b0fd-f762094e13ee",
                                                "text": "This they do, as a rule, by exposing the child or throwing it into the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293d14fe-bfe9-3bfe-92df-0699b44a2387",
                                        "entry_id": "b10585ba-b50b-3b21-9963-faefce4f96ac",
                                        "glosses": [
                                            "To submit to an active (mostly dangerous) substance like an allergen, ozone, nicotine, solvent, or to any other stress, in order to test the reaction, resistance, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19663337-3ee2-308e-85b4-a185ad02dc25",
                                        "entry_id": "b10585ba-b50b-3b21-9963-faefce4f96ac",
                                        "glosses": [
                                            "To make available to other parts of a program, or to other programs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701e4459-e371-4c81-85c1-ff3624950c24",
                                                "sense_id": "19663337-3ee2-308e-85b4-a185ad02dc25",
                                                "text": "In the OO world, the word is to hide the structure of the data, and expose only functionality. OO designers expose an object to the world in terms of the services it provides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
