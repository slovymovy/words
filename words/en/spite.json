{
    "word_family": [
        "spiteful",
        "spitefully",
        "spitefulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                    "sense_definition": "A feeling of wanting to hurt, annoy, or offend someone, often out of a sense of ill will or malice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to sell the car for a very low price just out of <w>spite</w> for his ex-wife.",
                            "target_lang_translations": {
                                "ru": "Он решил продать машину по очень низкой цене просто из <w>злости</w> на свою бывшую жену."
                            }
                        },
                        {
                            "text": "The neighbors were motivated by pure <w>spite</w> when they built the tall fence to block the view.",
                            "target_lang_translations": {
                                "ru": "Соседями двигала чистая <w>злоба</w>, когда они построили высокий забор, чтобы закрыть вид."
                            }
                        }
                    ],
                    "synonyms": [
                        "grudge",
                        "rancor"
                    ],
                    "antonyms": [
                        "goodwill",
                        "benevolence"
                    ],
                    "common_phrases": [
                        "out of spite",
                        "pure spite",
                        "act of spite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство желания причинить боль, досадить или обидеть кого-либо, часто из недоброжелательности или злобы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злость",
                                "target_lang_sense_clarification": "сильное отрицательное чувство"
                            },
                            {
                                "target_lang_word": "злоба",
                                "target_lang_sense_clarification": "враждебное чувство"
                            },
                            {
                                "target_lang_word": "недоброжелательность",
                                "target_lang_sense_clarification": "отсутствие доброй воли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                    "sense_definition": "A feeling of annoyance, frustration, or disappointment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "frustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To his great <w>spite</w>, the project was cancelled just as it was nearing completion.",
                            "target_lang_translations": {
                                "ru": "К его великой <w>досаде</w>, проект был отменен как раз тогда, когда он близился к завершению."
                            }
                        },
                        {
                            "text": "The poet expressed his <w>spite</w> at the unfairness of time and fate.",
                            "target_lang_translations": {
                                "ru": "Поэт выразил свое <w>раздражение</w> по поводу несправедливости времени и судьбы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean vexation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство раздражения, разочарования или досады."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "чувство неудовольствия"
                            },
                            {
                                "target_lang_word": "раздражение",
                                "target_lang_sense_clarification": "состояние недовольства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93f44a66-7ec8-3cb1-b07e-7e616d59f5cc",
                    "sense_definition": "To deliberately annoy, hurt, or frustrate someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She only invited his rival to the party to <w>spite</w> him.",
                            "target_lang_translations": {
                                "ru": "Она пригласила его соперника на вечеринку только для того, чтобы <w>насолить</w> ему."
                            }
                        },
                        {
                            "text": "Don't cut off your nose to <w>spite</w> your face by quitting your job without a backup plan.",
                            "target_lang_translations": {
                                "ru": "Не делай себе хуже <w>назло</w> другим, увольняясь с работы без запасного плана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spite your face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно раздражать, обижать или расстраивать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насолить",
                                "target_lang_sense_clarification": "сделать неприятность"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "вызывать злость"
                            },
                            {
                                "target_lang_word": "делать назло",
                                "target_lang_sense_clarification": "действовать вопреки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbfa1852-b390-35fb-9376-9a2e5e0cecfb",
                    "sense_definition": "To feel hatred or intense anger toward someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hatred",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, the invaders <w>spited</w> the local religious institutions and destroyed them.",
                            "target_lang_translations": {
                                "ru": "В древние времена захватчики <w>ненавидели</w> местные религиозные институты и разрушали их."
                            }
                        },
                        {
                            "text": "He <w>spited</w> the very laws that were meant to protect the citizens.",
                            "target_lang_translations": {
                                "ru": "Он <w>враждовал</w> с теми самыми законами, которые должны были защищать граждан."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean hate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать ненависть или сильный гнев по отношению к кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненавидеть",
                                "target_lang_sense_clarification": "испытывать сильнейшее отрицательное чувство"
                            },
                            {
                                "target_lang_word": "враждовать",
                                "target_lang_sense_clarification": "находиться в отношениях вражды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "90155aa9-beee-376c-8a08-1b9373f10bd8",
                    "sense_definition": "In spite of; without being affected by the particular factor mentioned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went for a long walk in <w>spite</w> of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Они отправились на долгую прогулку <w>несмотря на</w> сильный дождь."
                            }
                        },
                        {
                            "text": "In <w>spite</w> of his lack of experience, he managed to finish the task perfectly.",
                            "target_lang_translations": {
                                "ru": "<w>Вопреки</w> отсутствию опыта, ему удалось идеально выполнить задание."
                            }
                        }
                    ],
                    "synonyms": [
                        "grudge",
                        "rancor"
                    ],
                    "common_phrases": [
                        "in spite of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несмотря на; без учета влияния конкретного упомянутого фактора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несмотря на",
                                "target_lang_sense_clarification": "вопреки обстоятельствам"
                            },
                            {
                                "target_lang_word": "вопреки",
                                "target_lang_sense_clarification": "наперекор чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}