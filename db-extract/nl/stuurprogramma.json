                                    {
                                        "sense_id": "ea12ba67-f802-3188-89f6-ffde88a2c51a",
                                        "entry_id": "468645d5-f066-3757-bd63-d49ce69bbdb6",
                                        "glosses": [
                                            "Something that drives something else.",
                                            "A driving wheel of a locomotive."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd488ba-9062-48c0-885d-1691697107c8",
                                                "sense_id": "ea12ba67-f802-3188-89f6-ffde88a2c51a",
                                                "text": "The later iterations of these locomotives had 56-inch drivers."
                                            },
                                            {
                                                "example_id": "0f65dbb5-56fb-41e3-9578-c3ba11d283b1",
                                                "sense_id": "ea12ba67-f802-3188-89f6-ffde88a2c51a",
                                                "text": "With a toot on her chime whistle, No. 6 set her 3 ft. 9 in. drivers turning and we were off round the curve through Pennyburn works."
                                            }
