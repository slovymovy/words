                                                "sense_id": "94f9efca-f2ba-3e2c-bac8-53de90469803",
                                                "text": "Der Zimmermannsbleistift wird in die Zollstocktasche der Zimmermannshose gesteckt."
                                            },
                                            {
                                                "example_id": "e27e0c5d-0b58-4dde-8890-6d45e5877a09",
                                                "sense_id": "94f9efca-f2ba-3e2c-bac8-53de90469803",
                                                "text": "„Wilke holt einen Zimmermannsbleistift aus seiner Westentasche.“"
                                            }
