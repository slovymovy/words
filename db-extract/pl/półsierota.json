                "senses": [
                    {
                        "sense_id": "242de261-ce40-3d92-8d68-1e1f5ea210a7",
                        "entry_id": "9608720f-f281-39d5-b2fe-8ecc57e707c7",
                        "glosses": [
                            "chłopiec osierocony przez jednego z rodziców"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97731614-8871-406d-a1da-bdc4a20ef6dd",
                                "sense_id": "242de261-ce40-3d92-8d68-1e1f5ea210a7",
                                "text": "A po olbrzymich obszarach Rosji tułają się niezliczone ilości dzieci, wyrzuconych z gniazd rodzinnych przez burzę rewolucji, głód i nędzę w domach rodzicielskich, sierot i półsierot, które już nawet zapomniały imion i nazwisk, oraz miejsc urodzenia swego"
                            },
                            {
                                "example_id": "38e57b04-a8aa-4944-ba1c-e06b8727373b",
                                "sense_id": "242de261-ce40-3d92-8d68-1e1f5ea210a7",
                                "text": "Dowiedział się, że jest to porządna panna, kształcona i bogata. Że jest półsierota, bo ojciec umarł kilka lat temu, że jest familiantka, bo ma jednego stryja takiego, co stawia domy, a drugiego »proboszcza« w najbogatszej parafii całego miasta"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
