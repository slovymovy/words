                        ],
                        "form": "приба́вочна"
                    },
                    {
                        "form_id": "514dc768-0270-4228-86d2-6ba07485edfc",
                        "entry_id": "d568ad17-bbd6-38a2-9f59-b7e4f7dbe8e5",
