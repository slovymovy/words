                "senses": [
                    {
                        "sense_id": "ac523d26-cb91-3703-9309-0888cfad4fde",
                        "entry_id": "6a6aacf6-0371-36ac-8b4a-e5288a083adf",
                        "glosses": [
                            "Payer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c394d1bd-c50e-4631-886d-4431d9791e2f",
                                "sense_id": "ac523d26-cb91-3703-9309-0888cfad4fde",
                                "text": "Rien que pour les avocats il a fallu que je carme près de six cents billets, cinq cents tickets encore pour les frais de justice, afin qu’ils ne vous gardent pas en veilleuse pour contrainte par corps."
                            },
                            {
                                "example_id": "4945229e-8ca9-4a0f-ab04-de86949020d1",
                                "sense_id": "ac523d26-cb91-3703-9309-0888cfad4fde",
                                "text": "- C’est pas que je soye radin, mais je pars du principe qu’en service commandé j’ai pas à carmer mes faux frais."
                            },
                            {
                                "example_id": "355782fe-0c7d-4023-86db-b11fabed44df",
                                "sense_id": "ac523d26-cb91-3703-9309-0888cfad4fde",
                                "text": "Je dus accéder à sa demande de quelques tours d’auto-tamponneuses avec d'autant meilleures grâce qu'elle carmait. Sa paye de dactylo la classait nabab en regard des misérables sous de ma solde […]."
                            }
                        ]
                    }
