                "senses": [
                    {
                        "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                        "entry_id": "16e8b27e-cc40-3c13-96db-0d00cb7e8cbb",
                        "glosses": [
                            "Raum eines Hauses, der für die Durchführung von Schulungen benutzt wird und entsprechend eingerichtet ist (beispielsweise mit Rechnern, Whiteboard, Beamer, Flipchart)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbfde57-2181-4ed2-97c3-2f1d02b9f6a9",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„In den Schulungsräumen werden die Feuerwehrkräfte aus- und fortgebildet.“"
                            },
                            {
                                "example_id": "915134c4-bea8-467d-9633-0b0bce5cef1a",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„In dem Schulungsraum des Bildungszentrums im Rheinberger-Gebäude ist es mucksmäuschenstill - man könnte die Nadel einer Spritze zu Boden fallen hören.“"
                            },
                            {
                                "example_id": "0a8cf34c-1255-4851-8871-a013273a1d54",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Im Nebengebäude befinden sich ein Restaurant sowie Tagungs- und Schulungsräume.“"
                            },
                            {
                                "example_id": "aef25edc-5af1-40c6-a6d4-aadab4daa890",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Die Industriemaschinen werden von den Herstellern zur Verfügung gestellt, die den Space wiederum als Schulungsraum nutzen können.“"
                            },
                            {
                                "example_id": "a3526724-a63f-46dc-9b28-540e585d4656",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Die Kurse finden im Rathaus statt, der Schulungsraum liegt direkt unter dem Amtszimmer des Bürgermeisters Fritz-Ulrich Kasch.“"
                            },
                            {
                                "example_id": "1f6d1469-e178-4097-acd4-2ff91272850a",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Die Volkshochschule suchte am Anfang einfach nur einen geeigneten Schulungsraum, da der eigene rund um die Uhr belegt war.“"
                            },
                            {
                                "example_id": "68e01d1b-02c3-46a7-8742-27c7466cf3a5",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Im Anbau untergebracht werden sollen Arztbüros, Sekretariate und Schulungsräume.“"
                            },
                            {
                                "example_id": "55b89e82-e749-4185-8005-6014bf991c0e",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Jetzt projiziert Körner eine Statistik der Universität Bochum an die Wand des Schulungsraums.“"
                            },
                            {
                                "example_id": "096aaa0c-0c43-4735-9197-90422b5e2693",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Mit anderen Leidensgenossen sitzt er nun in einem Schulungsraum in Solothurn und lernt Tabellenkalkulation am Computer.“"
                            },
                            {
                                "example_id": "6391a33d-0858-4ebd-89e1-e5752860855f",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Jetzt sitzen sie im Schulungsraum und hören angespannt zu, was ein Obergefreiter von einem Blatt Papier abliest.“"
                            },
                            {
                                "example_id": "c0e83696-c11c-4ed2-ba1f-78544372c316",
                                "sense_id": "7e0a7651-bd5b-35f5-bf1a-92b951e0cb96",
                                "text": "„Chantal trägt inzwischen ein großes grünes Hemd ihres Vaters, in dem sie in einem Schulungsraum mit Farben experimentiert und ein Bild malt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
