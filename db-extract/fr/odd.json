                "senses": [
                    {
                        "sense_id": "6a8e4e7a-0c70-3767-ac70-8feb3ce09730",
                        "entry_id": "bcdd5d67-0f4a-3623-9503-c0ae660332c0",
                        "glosses": [
                            "Objectif de développement durable, tel qu’établi par les États membres des Nations unies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd671b7-4ee1-45af-bc32-c49f5593ed80",
                                "sense_id": "6a8e4e7a-0c70-3767-ac70-8feb3ce09730",
                                "text": "« L’assurer à tous est le sixième des dix-sept objectifs de développement durable (ODD) de l’agenda 2030 qu’ont adopté les Nations unies en 2015 », reprend Jean Lapègue."
                            },
                            {
                                "example_id": "7a56d2b9-166a-4735-b12c-8dbda01b19ad",
                                "sense_id": "6a8e4e7a-0c70-3767-ac70-8feb3ce09730",
                                "text": "Les 17 objectifs de développement durable (ODD) et leurs 169 cibles (sous-objectifs) forment la clé de voûte de l’Agenda 2030."
                            },
                            {
                                "example_id": "063b9983-34b6-47fc-a60d-7d9e8d7daba8",
                                "sense_id": "6a8e4e7a-0c70-3767-ac70-8feb3ce09730",
                                "text": "Pourquoi les ODD sont-ils importants pour les entreprises ?"
                            }
                        ]
                    }
