                                    {
                                        "sense_id": "fadf7dfd-5b79-3305-b9b4-3d656e55731a",
                                        "entry_id": "b2b3284a-64af-3fc3-92b5-37b535e8b6a3",
                                        "glosses": [
                                            "A group of separate things that contribute to a coordinated whole."
                                        ],
                                        "tags": [],
                                        "examples": []
