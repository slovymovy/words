                    {
                        "translation_id": "9d3a07c1-8608-4283-8adb-1f91c9318eb0",
                        "source_entry_id": "4af29ea8-218d-3ef2-b442-02847bc50cef",
                        "source_sense_id": "02f867a2-a0d9-301b-bf64-063d4cdb413d",
