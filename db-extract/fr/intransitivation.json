                        "glosses": [
                            "Transformation d'un verbe transitif (qui attend un C.O.D) à un verbe intransitif (sans C.O.D)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb860e7-c777-45da-a85e-b9cd3386f24d",
                                "sense_id": "1a0640fd-b5bc-3027-95f1-c8854c169576",
                                "text": "Leur remplacement se fait de manière diversifiée : intransitivation : il meurt, il part, il pâtit ; réflexivation : il se meurt ; il s’en va ; il se sert de ; voire directement transitivation : il imite ; il parle."
                            },
                            {
                                "example_id": "efa5c232-9299-4ba9-9abf-3b97c1a12155",
                                "sense_id": "1a0640fd-b5bc-3027-95f1-c8854c169576",
                                "text": "Si un jour tu tombes sur un correspondant de Mongolie-Extérieure qui, seul de son espèce, ne fait pas d'erreur de concordance des temps au subjonctif, ou a une conception intéressante de l'intransitivation, tu iras lui rendre visite à Oulan-Bator ?"
                            }
                        ]
                    }
