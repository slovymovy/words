                "senses": [
                    {
                        "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                        "entry_id": "edecf986-19c5-32a7-a369-f8c9257659d7",
                        "glosses": [
                            "Nom ambigu donné à diverses plantes de différents genres de la famille des Poaceae (anciennement graminées), à racines longues et traçantes qui croissent de préférence dans les endroits sablonneux:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cd167a-3c29-41f3-8b97-b2affa909f5f",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme de Corse ou chiendent de Corse (Elytrigia corsica ou Thinopyrum corsicum)"
                            },
                            {
                                "example_id": "15a11b31-e167-4d8d-9b5a-59f55f7ec0f1",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme des sables ou grand oyat ou seigle de mer (Elymus arenarius)"
                            },
                            {
                                "example_id": "0a274ae2-08ae-4855-918a-afc0b7c32af7",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme des sables ou oyat ou roseau des sables (Ammophila arenaria)"
                            },
                            {
                                "example_id": "e6b643fc-362d-49b5-a5bc-8794fa5caf3a",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme des sables (Leymus arenarius)"
                            },
                            {
                                "example_id": "c680a1fe-432f-4789-a516-151772bd7606",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme du Canada (Elymus canadensis)"
                            },
                            {
                                "example_id": "db699bfc-7528-4512-8082-2696b40062ea",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "élyme de Magellan (Elymus magellanicus)"
                            },
                            {
                                "example_id": "3753b9d3-7b40-4836-a5f1-a125b3fe7059",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "— C’est exactement la Hollande telle que je l’ai vue aux environs de Haarlem, mais une Hollande brûlée par le soleil.\n— Alors j’aime mieux l’autre, s’écria M. de Mériolle en se laissant tomber sur une touffe d’herbe bleuâtre qu’on appelle l’élyme des sables."
                            },
                            {
                                "example_id": "35f07f24-32b0-4b5d-9439-fc8be89ee7df",
                                "sense_id": "135e2660-69b9-3f61-ada4-61582984019e",
                                "text": "Skagen n’est qu’une bourgade avec des cabanes de pêcheurs au milieu des dunes où poussent les élymes des sables et des étendues de lande couvertes de bruyère et de mousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "f97fea31-aeee-38eb-8c9a-56a198028047",
                        "entry_id": "edecf986-19c5-32a7-a369-f8c9257659d7",
                        "glosses": [
                            "Flûte utilisée par les Phrygiens."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "e3303338-fd52-4e8b-bf00-5028fc6e7bed",
                                "sense_id": "f97fea31-aeee-38eb-8c9a-56a198028047",
                                "text": "Il rapporte encore que l'élyme inventée par les Phrygiens ſuivant Juba , avoit été ſurnommée ajtalienne à cauſe de ſa groſſeur, ſemblable à celle des sajtales des Laconiens."
                            },
                            {
                                "example_id": "20fd8033-4b24-4073-8a61-45711f8a4f21",
                                "sense_id": "f97fea31-aeee-38eb-8c9a-56a198028047",
                                "text": "ÉLYME : Grosse flûte phrygienne en bois de buis, recourbée à l'extrémité inférieure, où l'on attachait une corne de veau."
                            }
                        ]
                    }
