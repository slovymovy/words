{
    "word_family": [
        "clair",
        "clairement",
        "clarté",
        "éclaircie",
        "éclaircissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcfa05a4-352b-3393-b8c1-ca0c74ed8d0a",
                    "sense_definition": "Rendre plus lumineux, plus clair ou moins sombre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil matinal commence à <w>éclaircir</w> le salon à travers les rideaux."
                        },
                        {
                            "text": "Nous avons repeint les murs en blanc pour <w>éclaircir</w> cette pièce sombre."
                        }
                    ],
                    "synonyms": [
                        "illuminer"
                    ],
                    "antonyms": [
                        "obscurcir"
                    ],
                    "common_phrases": [
                        "éclaircir une pièce"
                    ]
                },
                {
                    "sense_id": "8d354f27-e688-3c6f-bd1a-57c13c0a34ae",
                    "sense_definition": "Rendre net, compréhensible ou dissiper des doutes sur une question complexe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enquête a permis d'<w>éclaircir</w> ce mystère après plusieurs semaines de recherches."
                        },
                        {
                            "text": "Le directeur prend la parole pour <w>éclaircir</w> la situation auprès des employés."
                        }
                    ],
                    "synonyms": [
                        "clarifier",
                        "élucider"
                    ],
                    "antonyms": [
                        "obscurcir"
                    ],
                    "common_phrases": [
                        "éclaircir un mystère",
                        "éclaircir la situation",
                        "éclaircir un doute"
                    ]
                },
                {
                    "sense_id": "2354915f-6b57-3cc9-90da-ad1439df18d9",
                    "sense_definition": "Rendre moins dense ou diminuer le nombre d'éléments dans un ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "densite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a décidé d'<w>éclaircir</w> les branches pour laisser passer l'air."
                        },
                        {
                            "text": "Le froid intense a fini par <w>éclaircir</w> les rangs des manifestants."
                        }
                    ],
                    "synonyms": [
                        "désépaissir",
                        "élaguer"
                    ],
                    "common_phrases": [
                        "éclaircir les rangs",
                        "éclaircir les branches"
                    ]
                },
                {
                    "sense_id": "5533d221-c77d-3c15-8e48-4e9f86536ebe",
                    "sense_definition": "Rendre la voix plus nette et plus distincte, notamment en toussant légèrement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur toussote discrètement pour s'<w>éclaircir</w> la voix avant de commencer."
                        },
                        {
                            "text": "Il a bu une gorgée d'eau afin d'<w>éclaircir</w> sa voix fatiguée."
                        }
                    ],
                    "common_phrases": [
                        "éclaircir la voix",
                        "éclaircir sa gorge"
                    ]
                },
                {
                    "sense_id": "b6c9cc35-ac39-38dc-9d06-5fd7edc7fb3a",
                    "sense_definition": "Rendre un liquide moins épais ou plus fluide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "densite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez ajouter un peu de bouillon pour <w>éclaircir</w> la sauce trop épaisse."
                        },
                        {
                            "text": "Le cuisinier conseille d'<w>éclaircir</w> le coulis avec un filet de jus d'orange."
                        }
                    ],
                    "synonyms": [
                        "diluer"
                    ],
                    "common_phrases": [
                        "éclaircir une sauce"
                    ]
                }
            ]
        }
    ]
}