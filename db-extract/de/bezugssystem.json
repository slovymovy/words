                                        "entry_id": "40a3cacb-2808-33a5-ba74-41ec076f646c",
                                        "glosses": [
                                            "A set of assumptions, ideas and standards that form a viewpoint from which philosophical, religious and other ideas may be evaluated."
                                        ],
                                        "tags": [],
