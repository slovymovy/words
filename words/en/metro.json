{
    "word_family": [
        "metropolitan",
        "metropolis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fa7130f-1491-3b49-bf19-cbefd5e660ce",
                    "sense_definition": "A rapid transit rail transport system, or a train in such systems, generally underground and serving a metropolitan area.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to the city center by <w>metro</w> to avoid the heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Мы решили поехать в центр города на <w>метро</w>, чтобы избежать сильных пробок.",
                                "zh": "为了避开拥堵的交通，我们决定坐<w>地铁</w>去市中心。"
                            }
                        },
                        {
                            "text": "The <w>metro</w> station is just a few minutes walk from our hotel.",
                            "target_lang_translations": {
                                "ru": "Станция <w>метро</w> находится всего в нескольких минутах ходьбы от нашего отеля.",
                                "zh": "<w>地铁</w>站离我们的酒店只有几分钟的步行路程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subway",
                        "underground",
                        "tube"
                    ],
                    "common_phrases": [
                        "take the metro",
                        "by metro",
                        "metro station",
                        "catch the metro"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система скоростного внеуличного (преимущественно подземного) городского транспорта.",
                        "zh": "一种快速轨道交通系统，通常在地下运行，服务于大都市区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метро",
                                "target_lang_sense_clarification": "общеупотребительное"
                            },
                            {
                                "target_lang_word": "метрополитен",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地铁",
                                "target_lang_sense_clarification": "指城市地下铁路系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33e98e15-ed3d-35b3-aa53-709ffaec786f",
                    "sense_definition": "A metropolitan area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metropolitan_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cost of living in this <w>metro</w> has increased significantly over the last decade.",
                            "target_lang_translations": {
                                "ru": "Стоимость жизни в этом <w>мегаполисе</w> значительно выросла за последнее десятилетие.",
                                "zh": "过去十年里，这个<w>大都市</w>的生活成本显著增加。"
                            }
                        },
                        {
                            "text": "They are planning to expand their business into a new <w>metro</w> next year.",
                            "target_lang_translations": {
                                "ru": "В следующем году они планируют расширить свой бизнес в новом <w>крупном городе</w>.",
                                "zh": "他们计划明年将业务扩展到另一个新的<w>大都市</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metro area"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for metropolitan area"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный город вместе с пригородами; мегаполис.",
                        "zh": "指大都市区或大城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мегаполис",
                                "target_lang_sense_clarification": "крупный город"
                            },
                            {
                                "target_lang_word": "агломерация",
                                "target_lang_sense_clarification": "городская область"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大都市",
                                "target_lang_sense_clarification": "指规模巨大的城市"
                            },
                            {
                                "target_lang_word": "都市区",
                                "target_lang_sense_clarification": "指城市及其周边区域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5c7e278-6e00-3cbc-9f86-eeeeb2f8822e",
                    "sense_definition": "Relating to a metropolitan area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metropolitan_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>metro</w> police force is responsible for safety throughout the entire city.",
                            "target_lang_translations": {
                                "ru": "<w>Городская</w> полиция отвечает за безопасность во всем городе.",
                                "zh": "<w>城市</w>警察负责整个市区的安全。"
                            }
                        },
                        {
                            "text": "She reads the <w>metro</w> section of the newspaper every morning to stay informed.",
                            "target_lang_translations": {
                                "ru": "Она читает раздел <w>городских</w> новостей в газете каждое утро, чтобы быть в курсе событий.",
                                "zh": "她每天早上都读报纸的<w>都市</w>新闻版块，以了解最新动态。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metro area",
                        "metro region"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for metropolitan"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к крупному городу или метрополии.",
                        "zh": "与大都市区相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "городской",
                                "target_lang_sense_clarification": "относящийся к городу"
                            },
                            {
                                "target_lang_word": "столичный",
                                "target_lang_sense_clarification": "относящийся к центру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "城市的",
                                "target_lang_sense_clarification": "指与城市有关的"
                            },
                            {
                                "target_lang_word": "都市的",
                                "target_lang_sense_clarification": "指与大都市有关的"
                            }
                        ]
                    }
                }
            ]
        },
        {
