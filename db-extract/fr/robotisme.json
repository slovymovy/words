                            {
                                "example_id": "73b97871-4bef-477a-8984-fc91d614187b",
                                "sense_id": "ced451d8-b798-3a43-8775-a5d4f4331b38",
                                "text": "L’avenir économique des nations, en bannissant la centralisation, s’articule sur la liberté d’initiative, la fluidité, l’informatisation poussée, le robotisme, une situation à laquelle les PVD doivent sérieusement s’adapter […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "51293c53-0237-395a-8912-25df248ac7ce",
                        "entry_id": "1ff2b40c-e653-33e3-865a-1086ac8205d0",
                        "glosses": [
                            "Utilisation de l’homme réduit au rang de robot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447db6e4-22f4-4a85-9036-330b7e20c182",
                                "sense_id": "51293c53-0237-395a-8912-25df248ac7ce",
                                "text": "Il n’est plus question d’aimer la loi pour elle-même, ce qui ferait retomber dans les automatismes et le robotisme de l’obéissance aveugle."
                            },
                            {
                                "example_id": "0e928772-1b90-4c36-83fe-4c44712ac233",
                                "sense_id": "51293c53-0237-395a-8912-25df248ac7ce",
                                "text": "La seule défense, le seul recours du blanc contre le robotisme, et sans doute contre la guerre, la régression à \"pire que cavernes\" bien pire, c’est le retour à son rythme émotif propre."
                            }
                        ]
                    }
