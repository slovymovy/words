                        "entry_id": "05b2a59c-9cca-3c09-826b-42ada8d02b02",
                        "glosses": [
                            "перемещение какого-либо предмета с помощью поворота, катания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13b207d-5029-4eae-a812-8c8dee88dadb",
                                "sense_id": "062e3950-aef2-3617-8286-64ad7f5b378b",
                                "text": "Перекат брёвен к месту стройки."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0426d63-9a8e-36a2-b6f7-04778d6b1c16",
                        "entry_id": "05b2a59c-9cca-3c09-826b-42ada8d02b02",
                        "glosses": [
                            "мн. ч. продолжительный гул с раскатами и временными затиханиями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c70061-3475-48ee-9052-24ff042bd2ff",
                                "sense_id": "f0426d63-9a8e-36a2-b6f7-04778d6b1c16",
                                "text": "Перекаты грома."
                            }
                        ]
                    },
                    {
                        "sense_id": "182b94c0-bb02-3336-9065-ed2fdd5861f7",
                        "entry_id": "05b2a59c-9cca-3c09-826b-42ada8d02b02",
                        "glosses": [
                            "возвышение на какой-либо поверхности, переходящее в углубление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9901093-3502-4a79-a576-037a504069b4",
                                "sense_id": "182b94c0-bb02-3336-9065-ed2fdd5861f7",
                                "text": "Дорога шла перекатами."
                            },
                            {
                                "example_id": "031fd116-77bf-45b8-b954-bb1f7e08d2a1",
                                "sense_id": "182b94c0-bb02-3336-9065-ed2fdd5861f7",
                                "text": "Подниматься на перекаты."
                            }
                        ]
                    },
                    {
                        "sense_id": "96f24597-987b-3074-aa2f-150cc1f1e17c",
                        "entry_id": "05b2a59c-9cca-3c09-826b-42ada8d02b02",
                        "glosses": [
                            "морск. мелководный участок русла реки между двумя плесами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67460a62-da8b-4a45-a9e7-68a24db75655",
                                "sense_id": "96f24597-987b-3074-aa2f-150cc1f1e17c",
                                "text": "На перекатах пароходы идут медленно."
                            }
                        ]
                    },
