                        "glosses": [
                            "schittering van licht, twinkeling van licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad4cb48-b638-4123-8c0a-914f3850d6f4",
                                "sense_id": "9305abfa-260b-326c-9f6a-62d0d6b5bdc4",
                                "text": "Blake had haar precies op het moment afgebeeld waarop ze zich naar hem toe draaide, en een klein helder vlekje gaf de sprankeling in haar ogen weer toen ze haar gezicht naar hem optilde."
                            }
                        ]
                    },
                    {
                        "sense_id": "c365c8a6-eb88-38f5-b782-71d92dc6c91f",
                        "entry_id": "8bc82ed4-fc43-3607-bb57-912042915019",
                        "glosses": [
                            "vol met leven zijnde, enthousiasme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e363c8e-45bc-4369-ab8a-d4fc95388eae",
                                "sense_id": "c365c8a6-eb88-38f5-b782-71d92dc6c91f",
                                "text": "Na rust was die kleine sprankeling in het spel weer als sneeuw voor de zon verdwenen. En het dieptepunt moest nog komen: in de 66ste minuut kopte de arme Van Persie (ongehinderd) de bal uit een vrije trap achter zijn eigen doelman."
                            }
                        ]
                    }
