                    "sense_id": "c7f50fa7-a20f-398e-8dcd-52c266bd28be",
                    "sense_definition": "een grote zwarte vogel uit het geslacht Corvus",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk, er zit een zwarte <w>kraai</w> in de boom!",
                            "target_lang_translations": {
                                "en": "Look, there is a black <w>crow</w> in the tree!"
                            }
                        },
                        {
                            "text": "De <w>kraai</w> vloog weg toen ik dichterbij kwam.",
                            "target_lang_translations": {
                                "en": "The <w>crow</w> flew away when I came closer."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwarte kraai"
                    ],
                    "common_phrases": [
                        "zwarte kraai"
                    ],
                    "target_lang_definitions": {
