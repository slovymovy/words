                "senses": [
                    {
                        "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                        "entry_id": "ccfdb952-b4a1-3230-b66c-41d966e91dbf",
                        "glosses": [
                            "Großunternehmen, in dessen Filialen einfache Speisen (beispielsweise Burger) verkauft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f704e5-a5e3-4c27-8aa6-1dea2a8dc07a",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der Verdacht: Der Fast-Food-Konzern zahlte trotz hoher Gewinne unrechtmäßigerweise keine Steuern - weder in Europa noch in den USA.“"
                            },
                            {
                                "example_id": "1e169acd-5a60-4e8c-87b9-256753b880fa",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "Ich kaufe kein Essen bei einem Fast-Food-Konzern."
                            },
                            {
                                "example_id": "981e0954-6868-425d-a474-071b10959da2",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der 1958 geborene und seit 1986 beim Fast-Food-Konzern beschäftigt Brite David Newman wurde neuer Österreich-Chef.“"
                            },
                            {
                                "example_id": "ec66ce17-b41c-406e-8e4c-7c2d7d4e7a44",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Beachtenswert ist das Bahnhofsrestaurant, das zwar heute von einem internationalen Fast-Food-Konzern betrieben wird, aber in seiner ursprünglichen Gestalt weitgehend erhalten werden konnte.“"
                            },
                            {
                                "example_id": "7e0e6f44-4868-4b83-b15d-8ca7e001c353",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Das Unternehmen hatte zu Zeiten der Sowjetunion als erster internationaler Fast-Food-Konzern eine Filiale in der russischen Hauptstadt eröffnet.“"
                            },
                            {
                                "example_id": "be6ba341-d783-4c3f-81bb-852fb35e0c41",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "[2022 – Russischer Angriffskrieg auf die Ukraine:] „Wie mehrere andere internationale Unternehmen zog sich der Fast-Food-Konzern dann später endgültig aus dem flächenmäßig größten Land der Erde zurück,“ […]."
                            },
                            {
                                "example_id": "c6c90741-c02d-4e39-b037-3e7e526de2fd",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Als die Aktie des Fast-Food-Konzerns vor einem Monat an die New York Stock Exchange zurückkehrte, war sie der umjubelte Star.“"
                            },
                            {
                                "example_id": "987b0140-0921-4de4-8074-8da246989aff",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der Gewinn des weltgrößten Fast-Food-Konzerns fiel im ersten Quartal um etwa ein Drittel zum Vorjahreszeitraum auf 811,5 Millionen Dollar (752 Mio Euro), wie das Unternehmen mitteilte.“"
                            },
                            {
                                "example_id": "d263459b-ac79-4275-bc47-ce5ef0439cd1",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der Fast-Food-Konzern legt Wert auf Regionalität, sagt Unternehmenssprecher Markus Weiß:“ […]."
                            },
                            {
                                "example_id": "7a1593d5-3541-4f65-b21b-3ce03ee5e391",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "[2014:] „Der amerikanische Fast-Food-Konzern Burger King will die kanadische Kaffee- und Donut-Kette Tim Hortons übernehmen.“"
                            },
                            {
                                "example_id": "b46831d3-e07a-49d7-b40e-58155cbf8f0e",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der Fast-Food-Konzern steht wegen seiner Arbeitsbedingungen schon lange in der Kritik.“"
                            },
                            {
                                "example_id": "fca78342-e8b0-403f-bfe7-71fba458faf8",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "[…] „Der kriselnde Fast-Food-Konzern hat nach heftigen und anhaltenden Protesten gegen seine Niedriglöhne eine Gehaltserhöhung für Zehntausende Mitarbeiter in den USA beschlossen.“"
                            },
                            {
                                "example_id": "666fbf70-d44f-4921-8da4-e71348bf7672",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "„Der Fast-Food-Konzern McDonald's hebt in den USA die Gehälter an - doch längst nicht alle Mitarbeiter profitieren.“"
                            },
                            {
                                "example_id": "21c219f9-467e-496a-bb74-8731d36a8b04",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "[…] „Tierwohl bleibt in Deutschland ein Thema. Neben dem Lebensmitteleinzelhandel will auch der Fast-Food-Konzern McDonald's mehr Tierwohlfleisch verkaufen – und ist bereit, den Bauern dafür mehr zu bezahlen.“"
                            },
                            {
                                "example_id": "f0bfb493-e493-4651-9bd4-2d429d4e006d",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "Ray Kroc machte «McDonald's» zum umsatzstärksten Fast-Food-Konzern."
                            },
                            {
                                "example_id": "bccaa18d-0d2c-4b53-bd0a-e8657cdb0443",
                                "sense_id": "19eb3e59-8ddd-33f8-b479-dfce4f29f741",
                                "text": "[Steuer auf Einweggeschirr:] „McDonald's hat gegen die Steuer Klage eingereicht. Laut dem Fast-Food-Konzern sei diese im Sinne des Umweltschutzes nicht zielführend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
