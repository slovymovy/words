                        "sense_id": "752fa744-af8d-310a-b0f6-edbe503e431b",
                        "entry_id": "6f6cfa46-34c0-367e-826d-499a620e442a",
                        "glosses": [
                            "iemand die een vracht in of op een voertuig laadt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed0bf5d-1f17-48a7-ad17-567905a3f77b",
                                "sense_id": "752fa744-af8d-310a-b0f6-edbe503e431b",
                                "text": "Deze huisvuilwagens zijn uitgerust met een hefarm aan de zijkant van de wagen die vanuit de chauffeurskabine wordt bediend. Een ‘belader’ achterop de wagen die handmatig de containers op de hefarm zet, is dan niet meer nodig."
                            },
                            {
                                "example_id": "0444588e-ecfe-42c3-844a-1e630a0d64b3",
                                "sense_id": "752fa744-af8d-310a-b0f6-edbe503e431b",
                                "text": "Het gaat bij de gedwongen ontslagen vooral om staf- en ondersteunende functies. Chauffeurs en beladers worden minder getroffen."
                            },
                            {
                                "example_id": "f3cba244-f9da-4a0b-9585-9eef24f58825",
                                "sense_id": "752fa744-af8d-310a-b0f6-edbe503e431b",
                                "text": "Verdi eist voor de bijna duizend medewerkers in de dienstverlening op Hamburg Airport, onder wie beladers, bagageverwerkers en buschauffeurs, een salarisverhoging van 275 euro per maand. Enkele weken geleden zorgde een staking van de luchthavenbeveiliging voor veel ongerief."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "798fe231-fdb2-45aa-98ed-13f8066faf79",
                        "source_entry_id": "6f6cfa46-34c0-367e-826d-499a620e442a",
                        "source_sense_id": "752fa744-af8d-310a-b0f6-edbe503e431b",
                        "source_sense_description": "iemand die een vracht in of op een voertuig laadt",
                        "target_lang_word": "loader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "Agent noun of load; a person or device that loads."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498dc3c1-024c-4c77-a8c4-38d275d3a25d",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "There was only one loader for the truck today so it took him a long time to get everything moved."
                                            },
                                            {
                                                "example_id": "7c2c6b04-49d3-4310-bd45-be6b840ccf9d",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "The auto-loader on the gun kept jamming so they did it manually."
                                            },
                                            {
                                                "example_id": "0e9ce5cb-d4d6-4bcf-9c35-4e53a92997a3",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "A loader performs the important work of storing goods in the wagons and of unloading the wagons. In each case considerable skill is required to avoid breakage, and, in the case of loading, skill goes far to conserve wagon space."
                                            },
                                            {
                                                "example_id": "3303294c-3203-43ca-85c7-cdca514435ac",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "The loader […] placed the cartridge in the muzzle and shoved it in as far as he could. The rammer rammed it home, the gun captain inserting his priming wire to make sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc33992d-b579-3d17-aeae-95d2e7cf810b",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "A program that prepares other programs for execution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0cc6f8d-7dc5-30b1-84a8-72af1345baf5",
