                                "target_lang_sense_clarification": "a mineral used in jewelry"
                            },
                            {
                                "target_lang_word": "jewel",
                                "target_lang_sense_clarification": "a precious stone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d768cb2-ce1c-34e5-99aa-3003ce60a91f",
                    "sense_definition": "Iets of iemand van uitzonderlijke schoonheid, waarde of kwaliteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit oude schilderij is een echt <w>juweel</w> in de collectie van het museum.",
                            "target_lang_translations": {
                                "en": "This old painting is a real <w>gem</w> in the museum's collection."
                            }
                        },
                        {
                            "text": "Zij is een <w>juweeltje</w> van een dochter waar iedereen dol op is.",
                            "target_lang_translations": {
