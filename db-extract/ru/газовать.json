                        ]
                    },
                    {
                        "translation_id": "e2ccb1ca-faa0-476e-8979-8637eefd8239",
                        "source_entry_id": "061c0048-546b-3b02-8699-030ebbb67cdc",
                        "source_sense_description": "увеличивать скорость движения автомашины, мотоцикла, самолёта и т. п., нажимая педаль акселератора",
                        "target_lang_word": "Gas geben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gas geben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                        "entry_id": "389cd779-ae86-3e00-9029-2c4641f8efe4",
                                        "glosses": [
                                            "ein Fahrzeug beschleunigen, schnell fahren"
                                        ],
                                        "tags": [
                                            "meist: 'jemand gibt Gas'",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04717f9-c66a-457c-8172-2b8d7c219dd1",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Ein 22-Jähriger ist am späten Sonntagabend festgenommen worden, weil er bei einer Polizeikontrolle nicht angehalten, sondern einfach Gas gegeben hat.“"
                                            },
                                            {
                                                "example_id": "66b96e62-c9a8-4ae9-83ab-ea58a3176bfa",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Gas mit Bremse verwechselt? 72-Jährige fährt fünf Autos kaputt […] Die Polizei vermutet, dass die Frau sich nach der ersten Karambolage erschrocken und unbeabsichtigt Gas gegeben hat.“"
                                            },
                                            {
                                                "example_id": "c9800147-6f95-41dc-87f5-de0b4751cf50",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Sieben Tote bei Unfall mit Schleuserfahrzeug in Bayern – Die Polizei wollte den auf der A 94 fahrenden Transporter kontrollieren - doch der Fahrer gab Gas und löste damit die Katastrophe aus.“"
                                            },
                                            {
                                                "example_id": "b0bc665a-db4c-4259-b20a-5ae9c54cfe76",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Nach ersten Ermittlungen der Polizei hatte der Mann am Steuer eines Ferraris am Samstag (25.3.2006) eine junge hübsche Frau am Straßenrand beeindrucken wollen und kräftig Gas gegeben.“"
                                            },
                                            {
                                                "example_id": "f379e2ce-5a70-4e2b-a245-e72288b36bab",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "[Formel 1:] „Nach 26 Runden holte Red Bull den Niederländer zum Boxenstopp, Hamilton blieb draußen, gab Gas und versuchte, genug Vorsprung herauszufahren, um nach dem eigenen Boxenstopp vorne zu bleiben.“"
                                            },
                                            {
                                                "example_id": "de3d35bb-6fba-4de4-9f55-f08d22ee081b",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Eine Kreuzung mitten in Berlin. Die Ampel springt auf Grün, in den eben noch wartenden Autos wird Gas gegeben, beschleunigt - dann rollen die Reifen über den Asphalt.“"
                                            },
                                            {
                                                "example_id": "768fde7e-df7b-4ea1-814f-90d8c322f920",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "[Ford Model T:] „Gas gegeben wurde mit einem Hebel am Lenkrad.“"
                                            },
                                            {
                                                "example_id": "0bee85f1-78eb-44b9-b9aa-235db952c378",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Seit dem Modelljahr 2023 gibt es im Touran auch den „Travel Assist“, der für den Fahrzeugführenden das Gas geben, Abstand halten zum vorausfahrenden Fahrzeug sowie Fahrspur halten und wechseln übernehmen kann.“"
                                            },
                                            {
                                                "example_id": "7e00d28d-7003-4485-88f6-ee6effbeb3e8",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Das heißt, im Teillastbetrieb, wenn wenig Gas gegeben wird, haben Ottomotoren einen schlechten Wirkungsgrad.“"
                                            },
                                            {
                                                "example_id": "aed88148-fa10-4a83-be77-ec7780bde96b",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Wird kein Gas gegeben, so schaltet sich der Verbrennungsmotor aus und das Fahrzeug rollt weiter.“"
                                            },
                                            {
                                                "example_id": "82ab399b-a091-4b71-9216-649cef728c5e",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Florian Hoffmann steuert an diesem Spätsommertag ein Motorboot in […] der Ostsee. […] Mit der rechten Hand gibt er Gas, in der linken hält er sein Handy, um den Kurs zu bestimmen.“"
                                            },
                                            {
                                                "example_id": "415e603a-6a67-4310-ae2d-c72f82deec66",
                                                "sense_id": "9977e6ec-97cc-3bf1-8fcf-1e24fdadfcfb",
                                                "text": "„Während des Luftkampfes gelang es dem Piloten, in Schussposition hinter die MiG zu kommen. Doch dann habe diese Gas gegeben und sei verschwunden – sie sei viel schneller als die F-105 gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                        "entry_id": "389cd779-ae86-3e00-9029-2c4641f8efe4",
                                        "glosses": [
                                            "sich beeilen, etwas (beispielsweise eine Aufgabe, ein Projekt) schneller erledigen, eine Entwicklung beschleunigen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92afc3ce-3f58-4115-885a-60fc555542e0",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "»Noch eine Woche bis zur Prüfung. Ich muss Gas geben, damit ich den Stoff schaffe!«"
                                            },
                                            {
                                                "example_id": "42c03cfb-e97c-4b8b-abb8-0207008a91b1",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "[Schlagzeile:] „Zentralschweiz - Obwaldner Parlament will beim Tunnel Kaiserstuhl Gas geben“"
                                            },
                                            {
                                                "example_id": "6bff9997-adbf-4f8a-b1e7-4374151f932e",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "[EU-Kommissionspräsident Jean-Claude Juncker über die Europäische Union:] „Manchmal haben wir sowieso in Sachen Erweiterung ein bisschen zu viel Gas gegeben.“"
                                            },
                                            {
                                                "example_id": "4d93a0c4-6608-4712-8870-94452309642f",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "„Während Dirk auf der Überholspur Gas gibt und in Vorlesungen, Seminararbeiten und Tutorien aufblüht, verliert sich Moritz mehr und mehr in den Wirren des Studentenlebens und verpasst schon bald den Anschluss.“"
                                            },
                                            {
                                                "example_id": "3ef85acd-2ceb-4aac-ad8d-6583fd7af704",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "„Fachkräfte aus dem Ausland werden gebraucht und auch Hautärztin Rola Al Aseel ist eigentlich ein Segen für die Region, aber: »Jetzt habe ich praktisch das Riesenproblem, dass Rola eine anerkannte Fachärztin ist für Hautkrankheiten, wir in Zittau ganz dringend jemanden brauchen, und die Behörden aber in der Bürokratie das nicht einsehen, dass man hier etwas Gas geben muss.«“"
                                            },
                                            {
                                                "example_id": "ec8c794e-0047-4d5d-a6ee-f880d835a85a",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "[Abschiebungen in Deutschland:] „Der Flüchtlingsbeauftragte des Landes, Torsten Döhring sagt: »Wenn man theoretisch eine Stunde Zeit hat und weiß, von welchem Flughafen der Flieger startet, sollte es möglich sein, die nötigen Anrufe zu tätigen. Das hängt davon ab, inwiefern man Gas gibt oder nicht.« Die Ausländerbehörde hat offensichtlich zu wenig Gas gegeben.“"
                                            },
                                            {
                                                "example_id": "43bc2f66-2dba-4dc0-bcbd-464c3fa787ed",
                                                "sense_id": "4710b8d1-fd01-37f9-8053-d0d3670ce521",
                                                "text": "„Nachdem die amerikanische Notenbank Federal Reserve (Fed) am Mittwoch die Leitzinsen um sogar 75 Basispunkte angehoben hatte - so stark wie seit 28 Jahren nicht mehr - rauschten am Donnerstag die Kurse weltweit bergab […] »Ich bin froh, dass die Fed Gas gegeben hat«, sagt Robert Halver. »Lieber Tabula rasa als ein Schrecken ohne Ende«, meint der Kapitalmarktstratege der Baader Bank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                        "entry_id": "389cd779-ae86-3e00-9029-2c4641f8efe4",
                                        "glosses": [
                                            "sich mehr anstrengen, mit vollem Einsatz trainieren/spielen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de70ef2f-acd3-4ad3-a2e2-c2cd35cd4def",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball:] „»Aktuell machen es die Jungs gut. Der Konkurrenzkampf wird angenommen. Jeder weiß, er muss Gas geben«“ […]."
                                            },
                                            {
                                                "example_id": "d6fe41d5-64d0-423d-b9d2-949a89b2a262",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball:] „»Wir Spieler können auf dem Platz in den Trainingseinheiten Gas geben und dann zählt es am Wochenende. Wer die Leistung bringt, der darf ran.«“"
                                            },
                                            {
                                                "example_id": "62115ff9-0f17-4bc1-adbf-76e4f047a016",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball:] „»Bis jetzt haben wir noch gar nichts. Deswegen wissen wir, dass wir Gas geben müssen bis zum Ende, bis es feststeht. Um dann auch den Aufstieg feiern zu können«, ordnet der Ulmer Kapitän ein.“"
                                            },
                                            {
                                                "example_id": "b85b2134-53de-4239-8fa6-5cf20b97f8b3",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball:] „»Den Erfolgsdruck dieser Leistungsgesellschaft« empfindet Nationalspieler Michael Schulz, 31, sogar als »sehr angenehm«. Denn: »Wer viel Gas gibt, kann viel Geld verdienen.«“"
                                            },
                                            {
                                                "example_id": "f063bce8-34c3-4da1-bd90-646797b077be",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball:] „Viele Spieler müssen dieses Mal Gas geben, weil es für sie die letzte Chance ist, auf einer großen Bühne etwas zu erreichen.“"
                                            },
                                            {
                                                "example_id": "53f8669f-6fd2-4c33-a958-e0872219ce75",
                                                "sense_id": "1ab4086a-e968-3423-80d1-eff0c696da07",
                                                "text": "[Fußball, über den Torwart Roman Bürki:] „Lizenzspieler-Leiter Sebastian Kehl verriet den Ruhr Nachrichten: »Wir haben mit ihm ausführlich gesprochen. Und die Situation ist sicher für ihn als jahrelange Nummer eins auch ungewohnt. Trotzdem sollte er sich weiter aufdrängen, so gut wie möglich anbieten, Gas geben und um seine nächste Chance kämpfen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
