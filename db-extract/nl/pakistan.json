                                                "sense_id": "0194071a-4671-36c4-b7de-6c4e5082f828",
                                                "text": "Pakistan grenzt an Iran, Afghanistan, China und Indien."
                                            },
                                            {
                                                "example_id": "a656273c-2762-4a78-86fb-4c43ec6da203",
                                                "sense_id": "0194071a-4671-36c4-b7de-6c4e5082f828",
                                                "text": "Islamabad ist die Hauptstadt von Pakistan."
                                            },
                                            {
                                                "example_id": "43df65c5-4333-4733-9ffc-99852c2e5130",
                                                "sense_id": "0194071a-4671-36c4-b7de-6c4e5082f828",
                                                "text": "Heftiger Monsunregen und neue Erdrutsche haben im Norden Pakistans mehr als 50 Menschen getötet und die Flutkatastrophe weiter verschärft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21c90543-f97a-4ab8-8b10-ba499569856a",
                        "source_entry_id": "69154a42-b50e-3c7a-b5a7-60004c7bd15a",
                        "source_sense_id": "dbad2080-b6eb-3e3d-bc55-d189db24fd07",
                        "source_sense_description": "een land in het zuiden van Azië grenzend aan India, Afghanistan, Iran en China. De officiële naam is de Islamitische Republiek Pakistan",
                        "target_lang_word": "Pakistan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pakistan",
