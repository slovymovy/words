                    {
                        "sense_id": "6f6a65ac-c044-3601-b027-aa898165e106",
                        "entry_id": "19819d95-2d78-3d62-bb9c-1cbd9f96b60f",
                        "glosses": [
                            "Raumfahrzeug, das einen Himmelskörper umkreist"
                        ],
                        "tags": [
                            "Raumfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "69bfad17-cc9d-4422-a0ee-d9e0f4d5362d",
                                "sense_id": "6f6a65ac-c044-3601-b027-aa898165e106",
                                "text": "Bei der Ulysses-Mission schickten ESA und NASA einen Orbiter um die Sonne."
                            },
                            {
                                "example_id": "1728a6c6-d64f-494a-83af-c5607b81ece6",
                                "sense_id": "6f6a65ac-c044-3601-b027-aa898165e106",
                                "text": "„Im Verlauf des vergangenen Jahres ist der Trace Gas Orbiter der Mission ExoMars unter Ausnutzung der Atmosphärenbremsung allmählich auf einen niedrigeren Orbit eingeschwenkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7669ac77-cb39-4cbb-aa7b-704c5534c371",
                        "source_entry_id": "19819d95-2d78-3d62-bb9c-1cbd9f96b60f",
                        "source_sense_id": "6f6a65ac-c044-3601-b027-aa898165e106",
                        "source_sense_description": "Raumfahrt: Raumfahrzeug, das einen Himmelskörper umkreist",
                        "target_lang_word": "orbiter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orbiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90f6487f-7fe9-38df-84d5-9e06f689b80c",
                                        "entry_id": "c20709be-b1ad-319c-9dfa-0ee67add50d5",
                                        "glosses": [
                                            "An object that orbits another, especially a spacecraft that orbits a planet etc. without landing on it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d648858b-32a8-46b4-911e-a40f292554e5",
                                                "sense_id": "90f6487f-7fe9-38df-84d5-9e06f689b80c",
                                                "text": "One day after the Hope maneuver, a Chinese spacecraft, Tianwen-1, is to also enter orbit around Mars. The Chinese mission is carrying a lander and a rover to explore a large impact basin called Utopia Planitia, but those are not to detach from the orbiter and head to the surface until May."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ff5e00-6cb0-3826-b6f9-29e0b5c676eb",
                                        "entry_id": "c20709be-b1ad-319c-9dfa-0ee67add50d5",
                                        "glosses": [
                                            "A person who constantly hangs around with someone they are attracted to, but too shy to talk to."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3395ad10-1e2b-4e69-8902-f0097bf1edfd",
                                                "sense_id": "98ff5e00-6cb0-3826-b6f9-29e0b5c676eb",
                                                "text": "The orbiters in her life in high likelihood like to talk about this and make themselves her emotional tampon and outlet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
