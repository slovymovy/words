                ],
                "senses": [
                    {
                        "sense_id": "be61ef50-2816-3c9d-a4d4-cebcc336f93d",
                        "entry_id": "32f3cee6-ea99-3cbb-96d9-fb73cbe3e768",
                        "glosses": [
                            "toets op een computertoetsenbord oorspronkelijk bedoeld om een lopende opdracht af te breken; vaak ook tegelijk met een andere toets op het toetsenbord ingedrukt om een bepaalde opdracht aan een computer te geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da055979-e586-49f9-85f9-15fc05dbd8eb",
                                "sense_id": "be61ef50-2816-3c9d-a4d4-cebcc336f93d",
                                "text": "Druk op ‘escape’ als je de diapresentatie wilt beëindigen voordat je presentatie volledig is vertoond."
                            },
                            {
                                "example_id": "1b126f1d-0cfb-401d-b564-29fab84b5eb3",
                                "sense_id": "be61ef50-2816-3c9d-a4d4-cebcc336f93d",
                                "text": "Een wirwar van menu's vormt een ingewikkelde boomstructuur, waarin de \"escape\"-knop, zonder dat dat wordt vermeld, onontbeerlijk is."
                            }
                        ]
                    },
                    {
                        "sense_id": "422c09cf-1e51-397b-9bdf-22f55787f92c",
                        "entry_id": "32f3cee6-ea99-3cbb-96d9-fb73cbe3e768",
                        "glosses": [
                            "mogelijkheid die kan worden benut om aan een dreigend probleem te ontsnappen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0adbbbf-7ff6-44fe-bfbb-ea757c954260",
                                "sense_id": "422c09cf-1e51-397b-9bdf-22f55787f92c",
                                "text": "\"Wat is er gebeurd? U bent gewond. U bloedt. Bent u aangereden?\" Dat 'bent u aangereden' gebruik ik als een escape voor haar: stel dat het waar is, dan kan ze gewoon 'ja' zeggen, stel dat het iets anders is waarover ze niet wil praten, dan kan ze er ook gebruik van maken en 'ja' zeggen."
                            },
                            {
                                "example_id": "88c321a3-5361-4d43-a5bd-df782b36e9e7",
                                "sense_id": "422c09cf-1e51-397b-9bdf-22f55787f92c",
                                "text": "Het stond voor mij daarom als een paal boven water dat ik huisarts zou worden. Maar eerst moest ik in militaire dienst. Ik zat op de Veluwe en er was maar één escape: een opleiding aanvragen tot hulp-anesthesist van het leger."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7c98f2c-956c-383f-91ab-77f2b088e9e2",
                        "entry_id": "32f3cee6-ea99-3cbb-96d9-fb73cbe3e768",
                        "glosses": [
                            "vlucht uit de dagelijkse werkelijkheid in fantasie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "022397af-3aaf-431f-8c75-444ebc8555a9",
                                "sense_id": "e7c98f2c-956c-383f-91ab-77f2b088e9e2",
                                "text": "Schietspellen zijn de ultieme escape. Je kruipt achter het toetsenbord en zet je verstand op nul, zoals de gemiddelde buisverslaafde zich uitstrekt op de bank en van soap naar soap zapt."
                            },
                            {
                                "example_id": "6ea4d9c4-2720-4dd0-b17b-64772eb7f298",
                                "sense_id": "e7c98f2c-956c-383f-91ab-77f2b088e9e2",
                                "text": "Veel pornografie wordt er ook nog anno 1966, terwijl we zo het gevoel hebben dat we nu wel de volledige seksuele vrijmaking beleven en er voor escape dus weinig reden meer is, geproduceerd en geconsumeerd."
                            }
                        ]
                    }
                ],
