                    },
                    {
                        "translation_id": "1a080cb2-68cf-4593-9fc4-a271161721a6",
                        "source_entry_id": "8b565835-8e34-3383-aba8-068cdfbcee0b",
                        "source_sense_id": "69fa4ecd-d3f1-3b5c-9874-291ba6e1e81e",
                        "target_lang_word": "Effekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Effekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "728bb9f9-c4bd-3286-9042-0630bd8ac934",
                                        "entry_id": "db3d61d8-7117-3985-870e-f048a6149a89",
                                        "glosses": [
                                            "Wirkung, die einfach entsteht oder auch absichtlich herbeigeführt werden kann, wobei diese auch überraschend oder beeindruckend sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7904b1cf-6a8e-4aeb-beca-edc2d42c1d6c",
                                                "sense_id": "728bb9f9-c4bd-3286-9042-0630bd8ac934",
                                                "text": "„Die alpine Orogenese ist der Effekt der Nordwanderung der afrikanischen Scholle.“"
                                            },
                                            {
                                                "example_id": "cadaacae-8c4f-4055-a16a-0dcb5c0fe194",
                                                "sense_id": "728bb9f9-c4bd-3286-9042-0630bd8ac934",
                                                "text": "Der Effekt seiner ständigen Mäkeleien auf Familienfeiern war, dass sich die Verwandten von ihm distanzierten."
                                            },
                                            {
                                                "example_id": "473a2ac2-7d24-43f9-a911-8be7079ecfb2",
                                                "sense_id": "728bb9f9-c4bd-3286-9042-0630bd8ac934",
                                                "text": "„Selbst gegen diesen Effekt setzt sich der Mensch zur Wehr.“"
                                            },
                                            {
                                                "example_id": "49cd0033-8c6f-4d69-ad65-d3e2bd4eba91",
                                                "sense_id": "728bb9f9-c4bd-3286-9042-0630bd8ac934",
                                                "text": "„Aber solche Effekte sind Wieland fern, bei ihm gibt es ein opernkonformes Happy End.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "407cb251-a706-306b-8e7a-0160573300c7",
                                        "entry_id": "db3d61d8-7117-3985-870e-f048a6149a89",
                                        "glosses": [
                                            "Wirkung einer (sehr häufig visuellen) Umsetzung, die durch Technik oder Verfahren Betroffene überraschen und beeindrucken soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b049774-3699-4059-b3f9-4aad7f2f1e3e",
                                                "sense_id": "407cb251-a706-306b-8e7a-0160573300c7",
                                                "text": "Die Gruppe bekam den Oscar für die besten visuellen Effekte."
                                            },
                                            {
                                                "example_id": "e40b1b70-963d-4443-95e8-8581f6e5d106",
                                                "sense_id": "407cb251-a706-306b-8e7a-0160573300c7",
                                                "text": "Viele der Zuschauer verließen den Saal, da der Zauberer mit billigen Effekten arbeitete."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
