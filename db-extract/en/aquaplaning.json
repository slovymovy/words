                    {
                        "translation_id": "9acad037-91ce-466f-9f6b-67acc3463992",
                        "source_entry_id": "a3ab86ec-d264-3d0a-a496-6d6f774ea5b7",
                        "source_sense_id": "a8e33e80-adac-3907-ac16-110fc3d26f85",
                        "source_sense_description": "loss of contact with the road",
                        "target_lang_word": "Aquaplaning",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquaplaning",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                        "entry_id": "de9d2691-b310-3961-8a90-00e642971f05",
                                        "glosses": [
                                            "bei Wasserglätte durch nicht angepasste, höhere Geschwindigkeiten (und/oder abgefahrenen Profilen) verursachter Verlust der Bodenhaftung (Aufschwimmen) der Reifen eines Kraftfahrzeugs beziehungsweise Luftfahrzeugs (bei Start oder Landung), wodurch dieses antriebs-, brems- und lenkunfähig wird und in ein unkontrollierbares Gleiten, Rutschen gerät"
                                        ],
                                        "tags": [
                                            "Verkehrswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc20463-447e-4a3a-9ee8-8f01dc497a8b",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Auf regennasser Autobahn geriet ein Kraftfahrer bei einer Stundengeschwindigkeit von 110 Kilometern mit seinem Wagen in Folge von Aquaplaning ins Schleudern.“"
                                            },
                                            {
                                                "example_id": "c60eec93-f3c5-46c8-b99d-e74796910b0f",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Das gefährliche Aquaplaning wird verhindert durch einen Anti-Aquaplan-Kanal in der Mitte des Reifens und durch Jets (Düsen) an den Schultern des Reifens.“"
                                            },
                                            {
                                                "example_id": "690a58cf-0ad7-4caf-8391-a226b32c5ade",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Es ist ein unangenehmes Gefühl: Man fährt bei Regen, will leicht zur Seite lenken – und plötzlich gehorcht der Wagen nicht mehr! ‚Aquaplaning‘ nennen die Techniker diese Erscheinung.“"
                                            },
                                            {
                                                "example_id": "aea7b5da-576e-496e-a98b-f9af1577d9b5",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Starke Gewittergüsse und wolkenbruchartige Niederschläge […] erzeugen auf ebenen Fahrbahnen relativ hohe Wasserfilmstärken, die bei hohen Geschwindigkeiten von den Reifen nicht mehr verdrängt werden können. Es kommt dann zum Aufschwimmen und Gleiten der Reifen auf einem Wasserkeil, wobei die Haftreibung auf die sonst nur bei Glatteis auftretenden Werte absinkt. Dieses mit dem Fachbegriff Aquaplaning bezeichnete Verhalten tritt bei weitgehend abgefahrenen Reifen eher auf als bei guten Profilen.“"
                                            },
                                            {
                                                "example_id": "eea3a8bd-be8d-4e85-841e-d9e5a29eede5",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„So räumt etwa der Reifenproduzent Uniroyal ein, es lasse sich ‚leider nicht vermeiden‘, daß durch die breitere Auflagefläche der modernen Reifen ‚bei sehr viel Wasser auf der Straße und hohen Geschwindigkeiten das Aquaplaning noch begünstigt‘ werde.“"
                                            },
                                            {
                                                "example_id": "ea3c5d94-0fce-4352-b833-f12f469132f5",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Auch die Gefahr des Aquaplanings, also des Aufschwimmens der Reifen auf einem Wasserfilm, stieg mit geringerer Profiltiefe überproportional.“"
                                            },
                                            {
                                                "example_id": "5acf01d7-1d3d-4538-8d50-b60704a8363e",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Eine der Ursachen für die Bruchlandung des Lufthansa-Airbusses A-320 am 14. September auf dem Warschauer Flughafen war Aquaplaning.“"
                                            },
                                            {
                                                "example_id": "775b1ca3-f79a-4e9c-bfe4-f30ad61fd4c7",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Auf der A 3 bei Flums und der A 1 bei Gossau gab es wegen Aquaplaning Verkehrsbehinderungen.“"
                                            },
                                            {
                                                "example_id": "d21ee687-6c74-4a3d-8f23-92fa21642d6a",
                                                "sense_id": "bbb90cb1-1de1-3d54-9dbc-c50963d634c7",
                                                "text": "„Der Bordcomputer hatte aufgrund von Aquaplaning am Ende der Landebahn nicht mehr erkannt, dass das Flugzeug bereits im Ausrollen war – und löste die Bremsen wieder, obwohl das Flugzeug noch viel zu schnell unterwegs war, so der Abschlussbericht der Untersuchungskommission.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
