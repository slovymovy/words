                        "sense_id": "63b5f1d4-e52e-3867-a512-210271bab2ba",
                        "entry_id": "f9904d82-2aa9-31f2-97dc-c8e5278a4100",
                        "glosses": [
                            "zetknięcie się przewodów w obwodzie elektrycznym, powodujące nieprawidłowy przepływ silnego prądu i uszkodzenie instalacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae8b02a-6ec4-4aa1-97a4-fc81fd341844",
                                "sense_id": "63b5f1d4-e52e-3867-a512-210271bab2ba",
                                "text": "Jak na ironię muzeum piromanii nie spłonęło z powodu podpalenia, ale w wyniku zwarcia w instalacjach elektrycznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
