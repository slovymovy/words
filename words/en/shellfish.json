                    ],
                    "common_phrases": [
                        "shellfish population",
                        "marine shellfish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водное беспозвоночное животное, имеющее раковину или панцирь, например, моллюск или ракообразное."
                    },
                    "translations": {
                        "ru": [
