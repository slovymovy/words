                "senses": [
                    {
                        "sense_id": "898c786a-ea0f-3c79-bb4c-20e9efc02266",
                        "entry_id": "67162fe9-45b1-30e1-8b33-d792b5b3e525",
                        "glosses": [
                            "Faire perdre son caractère flegmatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153cabe5-00ff-4648-9f9f-a68854f9fa0c",
                                "sense_id": "898c786a-ea0f-3c79-bb4c-20e9efc02266",
                                "text": "Notice sur les vernis colorés en or, et sur la manière de déflegmatiser l’alcool pour vernis"
                            },
                            {
                                "example_id": "ec1a9b6c-df95-48b1-8a76-4752c89d6e18",
                                "sense_id": "898c786a-ea0f-3c79-bb4c-20e9efc02266",
                                "text": "Pour Pater, il faut vivifier le rapport à Platon, et il cite Novalis : « philosophieren, says Novalis, ist dephlegmatisieren, vivifizieren » (« philosopher, pour Novalis, c’est déflegmatiser, vivifier »)."
                            },
                            {
                                "example_id": "378b1076-7be6-456b-a50b-2ec31c517f18",
                                "sense_id": "898c786a-ea0f-3c79-bb4c-20e9efc02266",
                                "text": "Sinon j'étais en train de parler sur MSN et d'essayer de me déflegmatiser (existe ou pas ?) pour faire mes devoirs."
                            }
                        ]
                    }
                ],
