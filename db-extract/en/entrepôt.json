                        "source_entry_id": "aeea2b3d-e1c8-3c95-9eea-593a649815b2",
                        "source_sense_description": "city, port, or other place where merchandise is sent for import, processing, distribution, and/or export",
                        "target_lang_word": "пакга́уз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пакга́уз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                        "entry_id": "a4fe18e3-f668-34ae-bf48-3122ddec3418",
                                        "glosses": [
                                            "склад для краткосрочного хранения грузов при железнодорожных станциях, портах, таможнях и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e88327-3745-4578-b200-b99b4cde5afd",
                                                "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                                "text": "В доме, принадлежащем американской компании, которая имеет здесь свой пакгауз с товарами (больше с бумажными и другими материями и т. п. нужными для края предметами, которыми торговля идёт порядочная), комната просторная, в окнах слюда вместо стёкол: светло и, говорят, тепло."
                                            },
                                            {
                                                "example_id": "f568c645-279c-4ad4-9e7c-029997a7752a",
                                                "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                                "text": "С раннего утра вся площадка позади университета перед биржевыми пакгаузами наполняется массою громко галдящего оборванного народа, который пришёл сюда искать тяжёлой, чисто каторжной работы за скудную подённую плату."
                                            },
                                            {
                                                "example_id": "76c558b7-2f1a-4479-9866-d3508ea6e579",
                                                "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                                "text": "От судов к бесчисленным пакгаузам и обратно по колеблющимся сходням сновали грузчики: русские босяки, оборванные, почти оголённые, с пьяными, раздутыми лицами, смуглые турки в грязных чалмах и в широких до колен, но обтянутых вокруг голени шароварах, коренастые мускулистые персы, с волосами и ногтями, окрашенными хной в огненно-морковный цвет."
                                            },
                                            {
                                                "example_id": "97537d1a-d3c5-409a-84cf-d6c880fe4453",
                                                "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                                "text": "Собрали всех в громадном товарном пакгаузе и выставили ультиматум: возврат на работу или военно-полевой суд."
                                            },
                                            {
                                                "example_id": "d06e15dd-cacb-46d1-9cdd-f0c226630ba4",
                                                "sense_id": "b6e73b7c-58eb-3a73-a321-0613bfabcb3c",
                                                "text": "Ветер выдувал из открытых ворот пакгауза тучи цементной пыли."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
