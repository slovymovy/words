                    {
                        "sense_id": "e0a60649-9408-3301-851e-3ab66903b7f6",
                        "entry_id": "07ac074c-da7f-3b9f-84c6-9ef36e0b4ac3",
                        "glosses": [
                            "To reverse or negate the feeling of"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "687ff42b-ec08-42df-9daa-29e6eddc3596",
                                "sense_id": "e0a60649-9408-3301-851e-3ab66903b7f6",
                                "text": "And when they are gone, they are gone for good. There is no way to unwind that spring. To unsee what has been seen. To unfeel what has been felt."
                            },
                            {
                                "example_id": "c76df7ea-e10c-4c20-a5b2-b0ab827cd516",
                                "sense_id": "e0a60649-9408-3301-851e-3ab66903b7f6",
                                "text": "And we study how to unlearn it, to unfeel it, to tone it down."
                            },
                            {
                                "example_id": "ac207239-bd52-4499-8f5f-2e9b6c73c1f0",
                                "sense_id": "e0a60649-9408-3301-851e-3ab66903b7f6",
                                "text": "Attempting to “unfeel” whatever you feel is a huge drain on your energy, and that effort can siphon off the power you need to crunch your problem."
                            }
                        ]
                    }
                ],
