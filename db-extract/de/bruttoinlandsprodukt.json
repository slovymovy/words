                        "source_sense_description": "Volkswirtschaft: Wert aller Leistungen, die innerhalb eines Jahres im Inland erbracht wurden",
                        "target_lang_word": "produit intérieur brut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "produit intérieur brut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30a37dea-57e7-34fd-8c7a-6e9fd8313cad",
                                        "entry_id": "fe6fd15c-3537-379b-902b-1ceb2517f06f",
                                        "glosses": [
                                            "Valeur totale de tous les biens et services produits dans un pays donné au cours d’une année donnée."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ac1954-2b6a-416b-83cc-6b7c903699c6",
                                                "sense_id": "30a37dea-57e7-34fd-8c7a-6e9fd8313cad",
                                                "text": "Environ un million de Moldaves, soit près d’un tiers de la population totale, ont quitté leur pays ces vingt dernières années. L’argent qu’ils envoient à leurs familles représente plus de 15 % du produit intérieur brut."
                                            },
                                            {
                                                "example_id": "56208ede-49ef-407d-aa8a-037c0487d364",
                                                "sense_id": "30a37dea-57e7-34fd-8c7a-6e9fd8313cad",
                                                "text": "Avec un trou de 154 milliards d’euros, le déficit public de la France a dépassé l’an dernier 5,5 % de son produit intérieur brut (PIB)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
