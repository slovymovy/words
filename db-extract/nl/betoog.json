                                        "examples": [
                                            {
                                                "example_id": "ac7fb174-c121-41d0-9234-ac6de033f574",
                                                "sense_id": "9c4f75b8-5a69-3672-8ff7-9fd75ef1b3b7",
                                                "text": "Die überzeugende Darlegung eines Themas kann man üben."
