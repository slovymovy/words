{
    "word_family": [
        "скоро",
        "скорый",
        "скорость",
        "ускорить",
        "ускорение"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7c1c35d3-aa98-3551-9c9e-43789437cce3",
                    "sense_definition": "Сравнительная степень к <w>скорый</w> и <w>скоро</w>; быстрее, с большей скоростью или через меньший промежуток времени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "speed_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, идите <скорее>, мы очень спешим.",
                            "target_lang_translations": {
                                "en": "Please walk <faster>, we are in a great hurry.",
                                "de": "Bitte gehen Sie <w>schneller</w>, wir haben es sehr eilig.",
                                "zh": "请<w>快点</w>走，我们很赶时间。"
                            }
                        },
                        {
                            "text": "Напиши мне ответ как можно <скорее>.",
                            "target_lang_translations": {
                                "en": "Write me an answer as <soon> as possible.",
                                "de": "Schreib mir eine Antwort so <w>schnell</w> wie möglich.",
                                "zh": "请<w>尽早</w>给我回复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "быстре́е",
                        "проворнее",
                        "ра́ньше",
                        "побыстрее"
                    ],
                    "common_phrases": [
                        "как можно скорее",
                        "чуть скорее"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Faster, with greater speed or sooner.",
                        "de": "Komparativ zu schnell; mit größerer Geschwindigkeit oder in kürzerer Zeit.",
                        "zh": "更快地，以更高的速度或在更短的时间内。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "faster",
                                "target_lang_sense_clarification": "regarding speed"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "regarding time"
                            },
                            {
                                "target_lang_word": "more quickly",
                                "target_lang_sense_clarification": "general speed"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schneller",
                                "target_lang_sense_clarification": "in Bezug auf die Geschwindigkeit"
                            },
                            {
                                "target_lang_word": "eher",
                                "target_lang_sense_clarification": "in Bezug auf die Zeit"
                            },
                            {
                                "target_lang_word": "rascher",
                                "target_lang_sense_clarification": "gehoben für schneller"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更快",
                                "target_lang_sense_clarification": "指速度或时间上的比较"
                            },
                            {
                                "target_lang_word": "尽早",
                                "target_lang_sense_clarification": "指时间上的紧迫性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "663ef638-a5b6-340d-b5c5-c43c69abe74c",
                    "sense_definition": "Охотнее; выражает предпочтение одного действия другому.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <скорее> останусь дома, чем пойду гулять в такую погоду.",
                            "target_lang_translations": {
                                "en": "I would <rather> stay home than go for a walk in such weather.",
                                "de": "Ich bleibe <w>lieber</w> zu Hause, als bei diesem Wetter spazieren zu gehen.",
                                "zh": "这种天气我<w>宁可</w>待在家里，也不想出去散步。"
                            }
                        },
                        {
                            "text": "Он <скорее> умрёт, чем предаст своих друзей.",
                            "target_lang_translations": {
                                "en": "He would <sooner> die than betray his friends.",
                                "de": "Er würde <w>eher</w> sterben, als seine Freunde zu verraten.",
                                "zh": "他<w>宁愿</w>死也不会背叛朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "лу́чше"
                    ],
                    "target_lang_definitions": {
                        "en": "More willingly; expresses a preference for one action over another.",
                        "de": "Lieber; drückt die Bevorzugung einer Handlung gegenüber einer anderen aus.",
                        "zh": "更愿意；表示对某种选择的偏好。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rather",
                                "target_lang_sense_clarification": "preference"
                            },
                            {
                                "target_lang_word": "sooner",
                                "target_lang_sense_clarification": "idiomatic preference"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lieber",
                                "target_lang_sense_clarification": "Präferenz"
                            },
                            {
                                "target_lang_word": "eher",
                                "target_lang_sense_clarification": "bevorzugte Option"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宁可",
                                "target_lang_sense_clarification": "表示主观意愿的偏好"
                            },
                            {
                                "target_lang_word": "更愿意",
                                "target_lang_sense_clarification": "表示选择倾向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d577080-882f-3a43-9f3e-fb277bb1405b",
                    "sense_definition": "Вернее, точнее говоря; употребляется для уточнения сказанного или оценки высокой вероятности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "correction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это не просто дом, а <скорее> настоящий замок.",
                            "target_lang_translations": {
                                "en": "It is not just a house, but <rather> a real castle.",
                                "de": "Das ist nicht einfach ein Haus, sondern <w>vielmehr</w> ein echtes Schloss.",
                                "zh": "这不仅仅是一座房子，<w>其实</w>是一座真正的城堡。"
                            }
                        },
                        {
                            "text": "Мы, <скорее> всего, не успеем на этот поезд.",
                            "target_lang_translations": {
                                "en": "We will <most likely> not make it to this train.",
                                "de": "Wir werden diesen Zug <w>wahrscheinlich</w> nicht mehr erreichen.",
                                "zh": "我们<w>很可能</w>赶不上这趟火车了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "верне́е",
                        "точне́е"
                    ],
                    "common_phrases": [
                        "скорее всего"
                    ],
                    "target_lang_definitions": {
                        "en": "More accurately speaking; used to clarify a statement or estimate probability.",
                        "de": "Genauer gesagt; wird verwendet, um eine Aussage zu präzisieren oder eine hohe Wahrscheinlichkeit auszudrücken.",
                        "zh": "更准确地说；用于澄清陈述或评估可能性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rather",
                                "target_lang_sense_clarification": "correction or clarification"
                            },
                            {
                                "target_lang_word": "more likely",
                                "target_lang_sense_clarification": "probability"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vielmehr",
                                "target_lang_sense_clarification": "Korrektur oder Präzisierung"
                            },
                            {
                                "target_lang_word": "eher",
                                "target_lang_sense_clarification": "Präzisierung oder Wahrscheinlichkeit"
                            },
                            {
                                "target_lang_word": "wahrscheinlich",
                                "target_lang_sense_clarification": "in der Wendung 'скорее всего'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "其实",
                                "target_lang_sense_clarification": "用于纠正或澄清"
                            },
                            {
                                "target_lang_word": "很可能",
                                "target_lang_sense_clarification": "用于表示概率"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "2d4bad21-5307-3cc0-99d7-2cfed38c6dbf",
                    "sense_definition": "Призыв поторопиться, делать что-либо быстрее.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Иди сюда <скорее>, здесь что-то интересное!",
                            "target_lang_translations": {
                                "en": "Come here <quick>, there is something interesting here!",
                                "de": "Komm <w>schnell</w> her, hier gibt es etwas Interessantes!",
                                "zh": "<w>快点</w>过来，这里有有趣的东西！"
                            }
                        },
                        {
                            "text": "Давай <скорее>, автобус уже уходит!",
                            "target_lang_translations": {
                                "en": "Come on, <hurry up>, the bus is already leaving!",
                                "de": "Mach <w>schnell</w>, der Bus fährt schon ab!",
                                "zh": "<w>赶紧</w>点，公交车要开了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "быстре́е",
                        "живей",
                        "живо"
                    ],
                    "common_phrases": [
                        "давай скорее"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A call to hurry up or do something faster.",
                        "de": "Aufforderung, sich zu beeilen oder etwas schneller zu tun.",
                        "zh": "催促某人快点行动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hurry up",
                                "target_lang_sense_clarification": "imperative phrase"
                            },
                            {
                                "target_lang_word": "quick",
                                "target_lang_sense_clarification": "imperative adverb"
                            },
                            {
                                "target_lang_word": "faster",
                                "target_lang_sense_clarification": "imperative comparative"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schnell",
                                "target_lang_sense_clarification": "Aufforderung"
                            },
                            {
                                "target_lang_word": "beeil dich",
                                "target_lang_sense_clarification": "Imperativ"
                            },
                            {
                                "target_lang_word": "rasch",
                                "target_lang_sense_clarification": "Aufforderung zur Eile"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快点",
                                "target_lang_sense_clarification": "祈使语气，催促行动"
                            },
                            {
                                "target_lang_word": "赶紧",
                                "target_lang_sense_clarification": "表示动作需要迅速完成"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}