                ],
                "senses": [
                    {
                        "sense_id": "41f227ba-194f-3d84-a98d-71d10ea5cf40",
                        "entry_id": "d1339057-cf94-3f37-bcb0-8361ce7fb543",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4a83b0-2687-4dcf-996e-9ed736b039e2",
                                "sense_id": "41f227ba-194f-3d84-a98d-71d10ea5cf40",
                                "text": "Postanowiłem więc i ja zbadać dokładnie wszystko od pierwszych chwil i opisać ci po kolei, dostojny Teofilu, abyś się mógł przekonać o całkowitej pewności nauk, których ci udzielono"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5969261-8599-4cf5-94d5-a5e50a3288da",
                        "source_entry_id": "d1339057-cf94-3f37-bcb0-8361ce7fb543",
                        "source_sense_id": "41f227ba-194f-3d84-a98d-71d10ea5cf40",
                        "target_lang_word": "Theophilus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theophilus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f1baede-1ce2-3a63-927d-ad205e5ee0da",
                                        "entry_id": "c5767a85-1bba-3d5a-a665-ef452e4a3f62",
                                        "glosses": [
                                            "The addressee of the Gospel of Luke and the Acts of the Apostles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62eb28cf-8baf-4016-a0bf-c133eaf5833b",
                                                "sense_id": "9f1baede-1ce2-3a63-927d-ad205e5ee0da",
                                                "text": "It seemed good to me also, having had perfect understanding of all things from the very first, to write unto thee in order, most excellent Theophilus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81513a72-697f-33f0-a3f6-5b48f2841ffc",
                                        "entry_id": "c5767a85-1bba-3d5a-a665-ef452e4a3f62",
                                        "glosses": [
                                            "A male given name from Ancient Greek; rare in English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb369e1-395f-4d20-a544-d3f9e3118307",
                                                "sense_id": "81513a72-697f-33f0-a3f6-5b48f2841ffc",
                                                "text": "'That's a good one, that is!' said Ern. 'Lovaduck, I'd like to see Uncle Theophilus when I tell him that!'"
                                            },
                                            {
                                                "example_id": "650678b0-19e4-4e3b-97c1-6fd494df2d62",
                                                "sense_id": "81513a72-697f-33f0-a3f6-5b48f2841ffc",
                                                "text": "\"Call me Ted, will you, Rip? 'Theophilus' is unmanageable and 'Theo' is awkward. Everybody calls me Ted or Teddie, now.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afae35b7-14f9-4ea8-b18c-56549a35c496",
                        "source_entry_id": "d1339057-cf94-3f37-bcb0-8361ce7fb543",
                        "source_sense_id": "41f227ba-194f-3d84-a98d-71d10ea5cf40",
                        "target_lang_word": "Teofil",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11b5253b-f93e-4e62-8eff-6b21981a771b",
                        "source_entry_id": "d1339057-cf94-3f37-bcb0-8361ce7fb543",
                        "source_sense_id": "41f227ba-194f-3d84-a98d-71d10ea5cf40",
                        "target_lang_word": "Théophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Théophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                        "entry_id": "df4d1301-a9ac-3439-95ce-a35781d6193e",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f1203e-1327-417e-b124-b61b42cf46c8",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Et, derrière lui, modestement, venait Théophile Morin, avec ses favoris gris, ses cheveux gris taillés en brosse, ses lunettes, son air jaune et las de vieux professeur, usé dans sa chaire."
                                            },
                                            {
                                                "example_id": "42a06750-4fa3-4a88-89a1-710ea4bdf683",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Jeanne, la fille du fermier, allait épouser le grand Théophile, de Sexey-aux-Forges."
                                            },
                                            {
                                                "example_id": "906871ea-e117-49a3-b702-5bed782d970c",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Ce fut l’occasion pour Théophile Briant d’évoquer, sous le titre « Léon Daudet et les amazones de la Chouannerie », ses relations avec le directeur de L’Action Française (fonction partagée avec Charles Maurras)."
                                            },
                                            {
                                                "example_id": "6f878691-989b-4844-bd1b-7d73d766ee37",
                                                "sense_id": "a8ff7e9b-c32e-3a0b-a878-0820092e8edf",
                                                "text": "Les gérants, Charlotte et Théophile Nourisson, possèdent déjà deux magasins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e55b165-30b2-37b2-b55e-e6d5df99a3e8",
                                        "entry_id": "df4d1301-a9ac-3439-95ce-a35781d6193e",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0336e7df-a02b-46b3-a5f3-f7ba8018209a",
                                                "sense_id": "8e55b165-30b2-37b2-b55e-e6d5df99a3e8",
                                                "text": "Théophile et Félicité, originaires de Mortagne, village proche du camp, sont les filles d’un greffier, ancien maréchal des logis des hussards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
