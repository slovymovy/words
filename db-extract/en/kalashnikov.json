                                                "sense_id": "5add9541-79f3-300d-8ed5-c3c9f9ccc52e",
                                                "text": "Die Sowjetunion rüstete die Befreiungsbewegungen mit Kalaschnikows aus."
                                            },
                                            {
                                                "example_id": "afb699d2-11ac-4855-834d-6787ab1db9e1",
                                                "sense_id": "5add9541-79f3-300d-8ed5-c3c9f9ccc52e",
                                                "text": "„Der Papierstapel und die Kalaschnikow waren verschwunden.“"
                                            },
                                            {
                                                "example_id": "fcee0683-516a-43eb-b210-8e7bebfbb7ce",
                                                "sense_id": "5add9541-79f3-300d-8ed5-c3c9f9ccc52e",
                                                "text": "„Die Kalaschnikow gehört ihm.“"
                                            }
