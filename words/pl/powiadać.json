            "senses": [
                {
                    "sense_id": "b8b27a62-08c9-3304-9c9e-65ab9d3d6966",
                    "sense_definition": "mówić, oznajmiać coś komuś lub opowiadać",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mówienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starzec często <w>powiadał</w>, że cierpliwość jest największą cnotą człowieka.",
                            "target_lang_translations": {
                                "en": "The old man often <w>used to say</w> that patience is man's greatest virtue."
                            }
                        },
                        {
                            "text": "Jak <w>powiadają</w> ludzie w naszej wsi, ta zima będzie wyjątkowo mroźna.",
                            "target_lang_translations": {
                                "en": "As the people in our village <w>say</w>, this winter will be exceptionally cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "prawić"
                    ],
                    "common_phrases": [
                        "jak powiadają"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "często w utartych zwrotach lub narracji tradycyjnej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to say, tell, or relate something to someone (often slightly archaic, literary, or in set phrases)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "to express in words, often habitually or traditionally"
                            },
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "to relate or narrate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf56b51c-d3ae-30df-befd-65ac9d4af894",
                    "sense_definition": "wskazywać treść przytaczanego tekstu, zapisu lub cytatu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cytowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stare przysłowie <w>powiada</w>, że nie wszystko złoto, co się świeci.",
                            "target_lang_translations": {
                                "en": "An old proverb <w>says</w> that all that glitters is not gold."
                            }
                        },
                        {
                            "text": "Kronika <w>powiada</w> wyraźnie o wielkiej bitwie stoczonej nad rzeką.",
                            "target_lang_translations": {
                                "en": "The chronicle <w>states</w> clearly about a great battle fought by the river."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przysłowie powiada"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane głównie w odniesieniu do tekstów, pism lub przysłów"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to state, read, or indicate as the content of a proverb, text, or chronicle"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "of a proverb, text, or saying: to state"
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "as in 'as the saying goes'"
                            },
                            {
                                "target_lang_word": "state",
                                "target_lang_sense_clarification": "of written accounts or records"
                            }
                        ]
                    }
                }
            ]
        }
    ]
