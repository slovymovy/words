                    {
                        "translation_id": "57a78ba2-ca90-43dc-a6a1-5bee60664ba4",
                        "source_entry_id": "b9598dff-e5c3-3370-9614-590c94465729",
                        "source_sense_description": "to make democratic",
                        "target_lang_word": "démocratiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démocratiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5343f56c-bbb7-344a-97b0-167d2d0d08c0",
                                        "entry_id": "b0fc8859-fa24-37e9-be63-86e8a492cd15",
                                        "glosses": [
                                            "Lorsque l’objet du verbe désigne une personne ou une collectivité : Rendre démocratique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8539c4e5-3b2e-49b4-9332-f4edc845bd5e",
                                                "sense_id": "5343f56c-bbb7-344a-97b0-167d2d0d08c0",
                                                "text": "Les filles de nobliaux seront absorbées par les roturiers enrichis… et les fils des hobereaux démocratiseront leur nom et s'associeront à leurs beaux-pères industriels, s'excusant dans les réunions d'être « nés nobles. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414f00b9-175d-32f1-971a-c35da007cb68",
                                        "entry_id": "b0fc8859-fa24-37e9-be63-86e8a492cd15",
                                        "glosses": [
                                            "Lorsque l’objet du verbe désigne un bien matériel, culturel ou une activité humaine : Rendre accessible au plus grand nombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1132575-ef10-4bf7-8383-c0bfcbdaf22b",
                                                "sense_id": "414f00b9-175d-32f1-971a-c35da007cb68",
                                                "text": "Certes, il y a toujours eu des grands chefs qui ont ouvert des petits restos pour désacraliser et démocratiser la haute cuisine, par exemple le phénomène des annexes de grands restaurants il y a quelques décennies."
                                            },
                                            {
                                                "example_id": "89fad1a3-891a-40a1-9e32-f5bbfb9dcd5c",
                                                "sense_id": "414f00b9-175d-32f1-971a-c35da007cb68",
                                                "text": "Il s’agissait de démocratiser l'école et de combattre l'élitisme […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc53a4ef-fac7-4287-a4ab-782d32294c68",
                        "source_entry_id": "b9598dff-e5c3-3370-9614-590c94465729",
                        "source_sense_description": "to make democratic",
                        "target_lang_word": "demokratisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demokratisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                        "entry_id": "633ef661-eee6-39b8-9538-d902c7a822b1",
                                        "glosses": [
                                            "etwas nach den Grundsätzen der Demokratie gestalten oder einrichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "707f934d-cc55-47fd-abca-17fa3305595f",
                                                "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                                "text": "Die EU muss stärker demokratisiert werden, fordert EU-Parlamentspräsident Martin Schulz im Interview."
                                            },
                                            {
                                                "example_id": "562d6ed0-f56f-4422-bde7-8d369f7e07f6",
                                                "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                                "text": "Und natürlich ist es nicht Aufgabe der Deutschen, Russland zu demokratisieren. Das ist Sache der Russen."
                                            },
                                            {
                                                "example_id": "e8956dcc-5d5a-4be6-8735-2b2159abb13c",
                                                "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                                "text": "Statt die Welt zu demokratisieren, dominiert das Internet heute mehr und mehr die Wirtschaft - jetzt muss sich auch Gigant Microsoft anpassen, um Google nicht das ganze Geld zu überlassen."
                                            },
                                            {
                                                "example_id": "b8781409-8faa-45e8-99f9-b389b0d78d8d",
                                                "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                                "text": "\"Blogs beschleunigen den Informationsaustausch und demokratisieren Arbeitsabläufe\", beschreibt IBM-Deutschlandchef Martin Jetter die Vorzüge des Web-2.0-Mediums."
                                            },
                                            {
                                                "example_id": "b751c151-0b08-401f-abab-2fb8cd74e2b2",
                                                "sense_id": "a81d7a20-8fd6-3a8e-840a-ee7a3182a6df",
                                                "text": "Hübsche Wäsche, erinnert er sich, konnten sich damals nur die Reichen leisten, deswegen wollte er den Bereich \"demokratisieren\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
