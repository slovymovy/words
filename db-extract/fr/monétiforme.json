                        "glosses": [
                            "Qui ressemble à une pièce de monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ac143d-8fe7-413b-b2fb-cb4fa2924bbf",
                                "sense_id": "8e6b5253-cd49-367d-9633-6aa7526bed45",
                                "text": "On entend par l’expression \"objets monétiformes\" les médailles, jetons et méreaux, objets métalliques ronds dont le rôle premier n’est pas monétaire."
                            },
                            {
                                "example_id": "0f6a6224-6448-4ada-9d1f-697f144322a7",
                                "sense_id": "8e6b5253-cd49-367d-9633-6aa7526bed45",
                                "text": "Jusqu’au xixe siècle, on désignait comme « médaille » toute monnaie antique et tout objet monétiforme à but commémoratif, le plus souvent revêtu d’un décor antiquisant."
                            }
                        ]
                    }
