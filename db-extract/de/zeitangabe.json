                "translations": [
                    {
                        "translation_id": "f85ff2f5-0709-42fb-a23a-1c16cecf1706",
                        "source_entry_id": "99d1389d-7883-3704-ac96-e7c98b628f00",
                        "source_sense_id": "edd13241-0171-3675-9731-1b8e76071398",
                        "source_sense_description": "Angabe, Benennung einer Uhr-, Tages- oder Jahreszeit",
                        "target_lang_word": "horaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "415dc41b-5bd1-398b-941f-19512f08f139",
                                        "entry_id": "959f3915-14e7-317b-983c-efbb9eb2cefb",
                                        "glosses": [
                                            "Relatif aux heures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14a1a85-d2fa-4752-aaaa-871db281eaa2",
                                                "sense_id": "415dc41b-5bd1-398b-941f-19512f08f139",
                                                "text": "Les lignes horaires d’un cadran."
                                            },
                                            {
                                                "example_id": "0940f1cd-2939-4026-acf1-b9d30bb2f36e",
                                                "sense_id": "415dc41b-5bd1-398b-941f-19512f08f139",
                                                "text": "Cercles horaires, cercles de la sphère céleste qui passent par les pôles et qui, en arrivant au méridien du lieu, marquent les heures du temps vrai."
                                            },
                                            {
                                                "example_id": "fa83d8a7-c9c8-4723-8b55-5cb7ee885f39",
                                                "sense_id": "415dc41b-5bd1-398b-941f-19512f08f139",
                                                "text": "Mouvement horaire, quantité dont un astre varie dans l’espace d’une heure, soit en longitude, soit en latitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbd31c7-d8fe-3e76-aeb5-7359f1dcbd93",
                                        "entry_id": "959f3915-14e7-317b-983c-efbb9eb2cefb",
                                        "glosses": [
                                            "Qui se produit à chaque heure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fe86543-f778-3079-8e47-d2f9c9203ce5",
                                        "entry_id": "959f3915-14e7-317b-983c-efbb9eb2cefb",
                                        "glosses": [
                                            "Qui tourne comme les aiguilles d’une montre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3b3ec1-1e27-414f-8445-9ccf041618b9",
                                                "sense_id": "8fe86543-f778-3079-8e47-d2f9c9203ce5",
                                                "text": "Puis trois fibres, ainsi créées, sont rassemblées et tissées ensemble dans le sens horaire pour former la corde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58a3e645-e05c-31ff-a3d7-9a1966bd9c28",
                                        "entry_id": "95bec401-a150-3ac9-b899-2791c35ce971",
                                        "glosses": [
                                            "Indicateur des heures d'ouverture et de fermeture d'un service, des heures de départ et et d’arrivée des trains, des avions ou autres opérateurs de transport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5fd70c-52c2-4210-866b-7188ffdce431",
                                                "sense_id": "58a3e645-e05c-31ff-a3d7-9a1966bd9c28",
                                                "text": "Je me suis procuré un horaire et je le consulte. La carte dont il est accompagné me fait connaître, station par station, le parcours du railway entre Tiflis et Bakou."
                                            },
                                            {
                                                "example_id": "c0e227c3-56fa-49a7-a3b3-ac8ada641bf9",
                                                "sense_id": "58a3e645-e05c-31ff-a3d7-9a1966bd9c28",
                                                "text": "Je suis habitué à ces fantaisies d’officiers. À la caserne, on est fréquemment convoqué par un capitaine inconnu qui veut connaître sans délai l’horaire de paquebots pour la Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48c625c-7495-3ffb-8441-5c4c858b0ea2",
                                        "entry_id": "95bec401-a150-3ac9-b899-2791c35ce971",
                                        "glosses": [
                                            "Répartition des heures d’occupation, de travail d’une ou plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab30ce0-b290-4403-aca1-1afb9a98dc8f",
                                                "sense_id": "e48c625c-7495-3ffb-8441-5c4c858b0ea2",
                                                "text": "Je n’ai point consulté mon horaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5ad173b-1f43-400d-933e-45f0b19c7207",
                        "source_entry_id": "99d1389d-7883-3704-ac96-e7c98b628f00",
                        "source_sense_id": "edd13241-0171-3675-9731-1b8e76071398",
                        "source_sense_description": "Angabe, Benennung einer Uhr-, Tages- oder Jahreszeit",
                        "target_lang_word": "tijdsaanduiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tijdsaanduiding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dbceea52-f552-3e0f-9417-546a841ce0b6",
                                        "entry_id": "2001bef0-0119-38ce-a943-4da38e9d25e2",
                                        "glosses": [
                                            "het laten zien hoe laat het is; het laten zien wanneer iets gebeurd is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3215a2bf-4079-495f-9522-cb7ef1642b9a",
                                                "sense_id": "dbceea52-f552-3e0f-9417-546a841ce0b6",
                                                "text": "Iedereen kan een onveilige plek toevoegen. Bij de onveilige plek wordt ook een tijdsaanduiding (altijd, overdag, avond, nacht) gegeven, zo wordt er duidelijk wanneer het onveilig is in het gebied. Mensen kunnen hier ook op reageren."
                                            },
                                            {
                                                "example_id": "8ff22f0d-41e9-474e-a40b-7fa8b12a4403",
                                                "sense_id": "dbceea52-f552-3e0f-9417-546a841ce0b6",
                                                "text": "De foto's hebben geen tijdsaanduidingen, maar laten wel het moment zien dat de menigte zich verzamelt in de buurt van het podium voor de ceremonie. De mensenmassa kwam niet tot aan het Washington Monument, zoals Trump later beweerde. Grote delen van de Mall zijn op dat moment leeg."
                                            },
                                            {
                                                "example_id": "730c14d5-284f-46f3-9589-bd757f4f01d8",
                                                "sense_id": "dbceea52-f552-3e0f-9417-546a841ce0b6",
                                                "text": "De klok slaat wel gewoon, alleen de tijdsaanduiding is kapot. Dat komt door het weer, vertelt beheerder Jaap van Engelenburg. \"We hebben allemaal een beetje last van de warmte. Dit zijn oude uurwerken en door de warmte kunnen oude metalen uitzetten\", zegt hij tegen RTV Utrecht. \"Daardoor komen tandwielen vast te zitten.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
