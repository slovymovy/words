                            {
                                "example_id": "d4942b87-f78b-425c-9091-e7d1855db6a7",
                                "sense_id": "b2bc1296-f933-3c97-93c3-3c312bf3c10f",
                                "text": "Les Néo-Zélandais affirment qu’à la distance de trois journées de pagayage, on arrive en un endroit nommé Mourevhennua, où la terre, ne s’étendant plus à l’ouest, tourne brusquement au sud."
                            },
                            {
                                "example_id": "9c7617e2-cb08-41eb-abb3-34466c72f182",
                                "sense_id": "b2bc1296-f933-3c97-93c3-3c312bf3c10f",
                                "text": "Quant au pagayage alternatif en périssoire, il est si facile qu’il suffit de s’y être essayé une fois pour savoir en user."
                            }
                        ]
                    }
