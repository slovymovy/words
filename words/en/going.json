                    "sense_id": "eb99a67a-3e8d-3274-9fa6-2a042e530aaf",
                    "sense_definition": "Current or prevailing at the present time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>going</w> rate for a private tutor is higher than I expected.",
