                "senses": [
                    {
                        "sense_id": "86d1ea75-00c3-33fe-99b4-757c550481b6",
                        "entry_id": "f9de0f31-48c4-31a1-b374-a328d29f56b5",
                        "glosses": [
                            "die Fachsprache der Jäger, der Jagd, des Jagdwesens, des Waidwerkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee3c526a-2845-4192-a3bb-f7481902b4f6",
                                "sense_id": "86d1ea75-00c3-33fe-99b4-757c550481b6",
                                "text": "Das Jägerlatein ist nicht die Jägersprache."
                            },
                            {
                                "example_id": "6d3132ff-21a8-41ee-b7f9-691b88f4f5fa",
                                "sense_id": "86d1ea75-00c3-33fe-99b4-757c550481b6",
                                "text": "„Die Jägersprache ist also die besondere Sprache eines geschlossenen Kreises, durch deren Gebrauch man die Zugehörigkeit zu diesem Kreise beweist.“"
                            },
                            {
                                "example_id": "329a3710-e92c-4305-bca7-c91c5e13a8e4",
                                "sense_id": "86d1ea75-00c3-33fe-99b4-757c550481b6",
                                "text": "„Von der Gruppe her bestimmt ist die Jägersprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
