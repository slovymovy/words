                "senses": [
                    {
                        "sense_id": "24c90b11-2203-3049-bbbf-744035eddbc4",
                        "entry_id": "94c836b1-e67d-32d4-a3e0-5f8194ba3697",
                        "glosses": [
                            "(mit Eiter gefülltes) Bläschen auf der Haut; Pickel"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1ba0aa23-1924-4985-b345-07372cf2cb63",
                                "sense_id": "24c90b11-2203-3049-bbbf-744035eddbc4",
                                "text": "Als Teenager hatte er das ganze Gesicht voller Wimmerl."
                            },
                            {
                                "example_id": "8dbf4751-00fc-4e77-b6c3-78069c648163",
                                "sense_id": "24c90b11-2203-3049-bbbf-744035eddbc4",
                                "text": "„Als Otto ein paar rote Flecken hatte, die die Mama für Wimmerl hielt, bekam Ida kurz darauf die Feuchtblattern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc292505-e0b8-3a36-8514-5d7cf2a61ef7",
                        "entry_id": "94c836b1-e67d-32d4-a3e0-5f8194ba3697",
                        "glosses": [
                            "kleine Gürteltasche, besonders für Wanderer oder Wintersportler"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4ca84606-b831-45b5-a9a8-7fa206a407d1",
                                "sense_id": "fc292505-e0b8-3a36-8514-5d7cf2a61ef7",
                                "text": "Mit der Brotzeit im Wimmerl vor dem Bauch machte sie sich auf zum Gipfel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
