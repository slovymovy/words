                ],
                "senses": [
                    {
                        "sense_id": "67258278-6590-38c5-b386-c691dac4c35c",
                        "entry_id": "8b5cabdc-89f5-36f8-b8fc-f70d1b53366c",
                        "glosses": [
                            "Straße mit einer Asphaltdecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "747e0eef-a530-4674-aedf-ea12ea1b07ce",
                                "sense_id": "67258278-6590-38c5-b386-c691dac4c35c",
                                "text": "„Dann betrachtete ich die Umrisse der dunklen Tannen und die breite Asphaltstraße unter mir.“"
                            },
                            {
                                "example_id": "33827afd-89b1-4220-8c55-8d3e226a3a45",
                                "sense_id": "67258278-6590-38c5-b386-c691dac4c35c",
                                "text": "„Ich schritt durch das Freilichtmuseum der Zunftgräber, überquerte eine Asphaltstraße und befand mich in einem verwunschenen Rhododendronhain.“"
                            },
                            {
                                "example_id": "c47637a6-8393-49e5-b491-9041d6ac33f7",
                                "sense_id": "67258278-6590-38c5-b386-c691dac4c35c",
                                "text": "„Asphaltstraßen waren eine Seltenheit an diesem Ende der Welt, und die Regenzeit verwandelte alle anderen Straßen in Morast, viele wurden unpassierbar.“"
                            },
                            {
                                "example_id": "e8f58a24-e10e-4b18-9a75-b29570f561eb",
                                "sense_id": "67258278-6590-38c5-b386-c691dac4c35c",
                                "text": "„Auf einer zweispurigen Asphaltstraße fahren wir durch die Wüste, immer geradeaus, schneebedeckte Gebirgsketten zu unserer Rechten, flimmernde Weite zu unserer Linken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
