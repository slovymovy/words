                ],
                "senses": [
                    {
                        "sense_id": "7c0b56c7-ea68-36e2-98ea-b330a855c6ab",
                        "entry_id": "05b685b7-127d-303d-a010-394ce14c3a87",
                        "glosses": [
                            "To perform menial work; to do chores, like a servant."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa11db03-bc0f-4d5d-9bf2-3e669dd8d913",
                                "sense_id": "7c0b56c7-ea68-36e2-98ea-b330a855c6ab",
                                "text": "We went out by turns, or sent out the apprentices who skivvied for us, to fetch in roast pork […]"
                            },
                            {
                                "example_id": "a57040c3-3834-4494-b1c6-951a0d135674",
                                "sense_id": "7c0b56c7-ea68-36e2-98ea-b330a855c6ab",
                                "text": "‘My mother was right. “It’ll take the war for the buggers to realize how important we are,” she used to say, “but as soon as Hitler hangs his clogs up we’ll be back skivvying and scurrying like there’s nothing in our heads.”’"
                            },
                            {
                                "example_id": "5f800809-a7dc-4db8-ab8a-48de0113a2d7",
                                "sense_id": "7c0b56c7-ea68-36e2-98ea-b330a855c6ab",
                                "text": "He saw no mother but a washerwoman at her skivvying and the dirt-faced children that would be clinging to her skirts."
                            }
                        ]
                    }
                ],
