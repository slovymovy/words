        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "12608b13-d951-36b9-82b8-7667d2c571f4",
                "word": "déballonner",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c82fa96-478e-3362-ad90-d3bbd324191d",
                        "entry_id": "12608b13-d951-36b9-82b8-7667d2c571f4",
                        "glosses": [
                            "Désenfler, en parlant de l’abdomen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e454efa-e334-45cf-b50f-8e97dd25c51a",
                                "sense_id": "0c82fa96-478e-3362-ad90-d3bbd324191d",
                                "text": "Il convient d’ajouter que l’aspiration, à laquelle on demande essentiellement de déballonner l’abdomen, est souvent peu efficace à ce point de vue …."
                            },
                            {
                                "example_id": "d23910ef-2790-4f84-918b-ce212e3fd3c8",
                                "sense_id": "0c82fa96-478e-3362-ad90-d3bbd324191d",
                                "text": "Les graines de nigelle ont toujours été employées pour leurs vertus digestives : elles aident à digérer et à déballonner."
                            },
                            {
                                "example_id": "887b4bd8-fd5a-4e4c-a374-efdaba11bafd",
                                "sense_id": "0c82fa96-478e-3362-ad90-d3bbd324191d",
                                "text": "Le 30 octobre, à la suite de l’emploi de purgatifs répétés, le ventre se déballonne."
                            }
                        ]
                    },
                    {
                        "sense_id": "d24835cf-f6d0-3bea-92f9-da23afbb33c0",
                        "entry_id": "12608b13-d951-36b9-82b8-7667d2c571f4",
                        "glosses": [
                            "Accoucher."
                        ],
                        "tags": [
                            "dated",
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5c25c9af-e425-4f5d-9e5f-42dcac6a4270",
                                "sense_id": "d24835cf-f6d0-3bea-92f9-da23afbb33c0",
                                "text": "Proche de l'expression *avoir le ballon qui d’une façon assez cavalière signifie être enceinte, déballonner est une manière tout aussi peu romantique de dire accoucher."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e0787b0-d787-3620-ad07-ebd5d26082da",
                        "entry_id": "12608b13-d951-36b9-82b8-7667d2c571f4",
                        "glosses": [
                            "Ne plus oser, renoncer."
                        ],
                        "tags": [
                            "familiar",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "06a7038f-cd70-4f59-9dcf-fbcf7ae0fe22",
                                "sense_id": "9e0787b0-d787-3620-ad07-ebd5d26082da",
                                "text": "D’ailleurs, vous allez voir tout à l’heure, au moment du départ ! La plupart vont se déballonner et supplier qu’on les ramène."
                            },
                            {
                                "example_id": "fcc5a2e8-f914-440c-8af5-55f4a04b7995",
                                "sense_id": "9e0787b0-d787-3620-ad07-ebd5d26082da",
                                "text": "– Le lendemain, ils se sont déballonnés tous les deux ! J’étais toute seule sur la colline !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
