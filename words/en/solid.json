                    "target_lang_definitions": {
                        "ru": "Прочный и вряд ли сломается или выйдет из строя.",
                        "tr": "Güçlü, kolay kırılmayan veya bozulmayan.",
                        "zh": "坚固且不容易损坏或失效。"
                    },
                    "translations": {
                        "ru": [
