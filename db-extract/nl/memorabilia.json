                "senses": [
                    {
                        "sense_id": "0038d0bc-0704-3624-b55b-217c9da9eb7a",
                        "entry_id": "43977ec1-2c1b-38d2-860f-7936dbdabf5d",
                        "glosses": [
                            "zaken die herinneren aan een persoon of een gebeurtenis, maar geen intrinsieke waarde hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01bc821-5fd0-4a1e-aaf9-761330071d67",
                                "sense_id": "0038d0bc-0704-3624-b55b-217c9da9eb7a",
                                "text": "Vanwege de persoonlijke aantekeningen besloot de man de bijbel te veilen via de site Moments In Time, waarop meerdere memorabilia van beroemdheden tegen hoge bedragen weg gaan."
                            },
                            {
                                "example_id": "916296b9-3e23-490c-83ee-e5477f7a76f7",
                                "sense_id": "0038d0bc-0704-3624-b55b-217c9da9eb7a",
                                "text": "De herinnering aan de Nationale 7 wordt ook levend gehouden in kleine musea, vaak gerund door vrijwilligers. In een oude garage in Piolenc bij Orange is een charmant museum gevestigd met oude auto's, foto's, reclameborden en andere memorabilia."
                            }
                        ]
                    }
