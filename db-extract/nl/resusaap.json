                        "translation_id": "1105cf8b-ecc8-4e97-b094-d382a63958ef",
                        "source_entry_id": "d39813ff-a652-3256-a6c3-776f931560fe",
                        "source_sense_id": "b44a18a3-ba92-325e-b149-76bfda6970ca",
