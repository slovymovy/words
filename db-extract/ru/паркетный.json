                        ],
                        "examples": [
                            {
                                "example_id": "b563c0fc-4613-499f-97d9-491abf87b90a",
                                "sense_id": "417e60b6-58f6-30fd-85bb-f73ac80faa69",
                                "text": "В до́ме у городско́го головы́ па́хло неда́вно натёртыми парке́тными пола́ми и ещё че́м-то, е́ле заме́тно, прия́тно-съестны́м.",
                                "translation": "In the Mayor's house a smell of freshly-waxed parquet floors mingled with a barely perceptible and yet pleasant odour of food.",
                                "english": "In the Mayor's house a smell of freshly-waxed parquet floors mingled with a barely perceptible and yet pleasant odour of food."
                            }
                        ]
