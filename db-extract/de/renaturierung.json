                        "form": "die Renaturierung"
                    },
                    {
                        "form_id": "bf59b150-1b9f-4b52-bbb1-4b6f1859a087",
                        "entry_id": "9134c28a-ee1f-3944-a6e8-e832b2460f1d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Renaturierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                        "entry_id": "9134c28a-ee1f-3944-a6e8-e832b2460f1d",
                        "glosses": [
                            "Wiederherstellung einer genutzten Fläche oder eines Gewässers in seiner ursprünglichen, naturnahen Form; Schaffung von Wildnis"
                        ],
                        "tags": [
                            "Umweltschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "1f4e0bf1-4c16-4b41-9d06-fd7f5560e1e8",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Ohne konsequente Renaturierung von Mooren sind die Pariser Klimaschutzziele kaum noch zu erreichen.“"
                            },
                            {
                                "example_id": "71d9114c-1fdf-4083-9d33-a33ad36b54e7",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Der IPCC hält Maßnahmen für das Binden von CO2 aus der Atmosphäre für notwendig. Dies wäre möglich mit Humusbildung in den Böden, durch Renaturierung von Mooren und Wiederaufforstungen.“"
                            },
                            {
                                "example_id": "a3820288-190d-4ca9-b470-9f3f600725bb",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„In der Flusslandschaft an den Wümmewiesen ist durch massive Renaturierung ein wertvolles Ökosystem mit hoher Artenvielfalt entstanden.“"
                            },
                            {
                                "example_id": "3c2a8aa1-1cb8-4914-a8fa-bf2716ae443a",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Die UN hat die Renaturierung der Emscher bereits 2014 als Großprojekt gewürdigt.“"
                            },
                            {
                                "example_id": "04495b06-aff6-4184-8092-994b628a0eeb",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "[Der Gewässerökologe an der Hochschule Weihenstephan-Triesdorf Prof. Andreas Hoffmann] „rückt regelmäßig mit seinen Studierenden zur Erfolgskontrolle in Sachen Renaturierung aus. Das Wasserwirtschaftsamt hat hier über sieben Jahre lang renaturiert, mit Baggern ein neues Flussbett ausgehoben - vom breiten, tiefen zum engen, kurvigen Verlauf.“"
                            },
                            {
                                "example_id": "31acd0ab-9b02-47aa-989a-d3c22560e3d3",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Die Renaturierung der oberen Altmühl zwischen Haag und Oberndorf wird auf rund 1,5 Kilometern fortgesetzt. Die Kosten von rund 300.000 Euro übernimmt der Freistaat Bayern.“"
                            },
                            {
                                "example_id": "59e86296-d983-4ca1-bf06-7cf527ef52da",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Seit der Renaturierung des Aabachs in Wildegg können [Fische] wieder von der Aare her den Bach hinaufschwimmen.“"
                            },
                            {
                                "example_id": "28edd762-9914-4411-a36d-dd9aada69e66",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Umfangreiche Renaturierungen entlang der Flüsse lassen Niedermoore wieder wachsen und geben auch anderen Tieren eine Heimat.“"
                            },
                            {
                                "example_id": "76dc54ef-c32d-4038-a17c-395ac55b1412",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Die Moore in Schleswig-Holstein drohen auszutrocknen. Damit würden sie als wertvolle CO2-Speicher und Ökosysteme mit hohem Artenreichtum verloren gehen. Moor-Experten wollen sie deshalb durch Renaturierung besser schützen […].“"
                            },
                            {
                                "example_id": "59b8abba-d3b2-4fc8-848d-72a799806ea9",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Durch Investitionen in die Wiederaufforstung und die Renaturierung von Land will Panamas Regierung den Fortbestand seines berühmten Kanals sicherstellen.“"
                            },
                            {
                                "example_id": "fc84d2ea-f15b-466d-b729-b9490ed6160a",
                                "sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                                "text": "„Die Kosten für Renaturierung der Kohletagebauen […] sollten die Unternehmen selbst tragen und nicht die Steuerzahler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c2f6dd2-43db-412f-9ed0-124f5bb98ed8",
                        "source_entry_id": "9134c28a-ee1f-3944-a6e8-e832b2460f1d",
                        "source_sense_id": "7a3bbe68-8ca9-3200-a8fd-8b8177a70e68",
                        "source_sense_description": "Umweltschutz: Wiederherstellung einer genutzten Fläche oder eines Gewässers in seiner ursprünglichen, naturnahen Form; Schaffung von Wildnis",
                        "target_lang_word": "restoration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restoration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The process of bringing an object back to its original state; the process of restoring something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f000f6-fb65-4d80-a0a4-dd866e6e22dd",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "foreskin restoration"
                                            },
                                            {
                                                "example_id": "d55f33af-d5e2-4732-9f87-f1f4dfc4e433",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "The restoration of this painting will take years."
                                            },
                                            {
                                                "example_id": "39a07c9e-b344-4bc8-9efd-c90c97bc722d",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "The restoration of this medieval church involved undoing all the Victorian modifications."
                                            },
                                            {
                                                "example_id": "bc8f46db-1e28-4e49-8772-8a979d55a484",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "There is all the difference between preservation and restoration."
                                            },
                                            {
                                                "example_id": "da667a84-2ce8-4987-8b4d-30e07d81df82",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "As Sir Ronald Matthews said at the meeting of L.N.E.R. stockholders earlier this year, the public must realise \"the inevitability of a certain amount of gradualness\" in connection with the restoration of passenger train services and facilities."
                                            },
                                            {
                                                "example_id": "e5930d00-3edd-4ae1-b416-940da0deabe4",
                                                "sense_id": "746c83df-3564-337a-87e0-840927b37412",
                                                "text": "Providing accommodation is a significant constraint, and an unexpected development from the restoration of services to Okehampton is demand from the Exeter student population to rent local properties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "279d834d-56e9-3a35-b2eb-1fa5ab10b1c1",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The result of such a process, such as a dental restoration (a dental prosthesis)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7d8ac5-32e4-419b-9eda-030c4a509edc",
                                                "sense_id": "279d834d-56e9-3a35-b2eb-1fa5ab10b1c1",
                                                "text": "These restorations were especially impressive and were reported in a leading prosthodontics journal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The return of a former monarchy or monarch to power, usually after having been forced to step down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe59654-8f95-413e-8072-0d2b6e22c353",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "But now here we are, faced with the prospect of a Trump restoration."
                                            },
                                            {
                                                "example_id": "bb59fc67-790c-4879-a9ab-621aff2be811",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "The restoration of the House of Stuart took place a few years after the death of Cromwell."
                                            },
                                            {
                                                "example_id": "2bad862c-e025-4267-8b53-1057773d5869",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "The restoration of the Kingdom of Spain took place immediately after the death of Franco."
                                            },
                                            {
                                                "example_id": "ecf8db0a-aeb6-4daf-8670-7c2923eeb198",
                                                "sense_id": "6b02e094-bb0b-382a-93a6-6bf492d84455",
                                                "text": "Behold the differing Climes agree, / Rejoycing in thy Reſtauration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The return of a socioeconomic formation in the role of the dominant mode of production."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5615567-014a-49ae-aebe-bb8442bdeb95",
                                                "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                                "text": "The restoration of capitalism in Russia gave rise to unemployment."
                                            },
                                            {
                                                "example_id": "c9808232-25fe-4a07-9c9b-f9944c72509e",
                                                "sense_id": "51a85060-7c64-3680-87b4-82979722d35a",
                                                "text": "The restoration of capitalism in Eastern Europe made way for improvement in human rights."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f70f172-93db-3275-8362-413c6ac78704",
                                        "entry_id": "43ee140a-9bd1-337f-8f0e-75113ef906d2",
                                        "glosses": [
                                            "The receiving of a sinner to divine favor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
