            "senses": [
                {
                    "sense_id": "08c3feec-9be5-3222-b980-973d7ec5b262",
                    "sense_definition": "Grand récipient de bois renflé au milieu et cerclé de métal, servant à conserver et à transporter des liquides, en particulier le vin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vigneron descend dans la cave pour surveiller le vin qui vieillit dans chaque <w>tonneau</w>."
                        },
                        {
                            "text": "Deux ouvriers déplacent avec précaution un lourd <w>tonneau</w> rempli d'huile d'olive."
                        }
                    ],
                    "synonyms": [
                        "fût",
                        "barrique"
                    ],
                    "common_phrases": [
                        "tonneau de vin",
                        "mettre en tonneau"
                    ]
                },
                {
                    "sense_id": "302bb8f9-eca4-3340-b83d-3698db8f9960",
                    "sense_definition": "Rotation ou culbute d'un véhicule automobile sur lui-même au cours d'un accident de la route.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a dérapé sur la chaussée glissante avant de faire plusieurs <w>tonneaux</w> dans le fossé."
                        },
                        {
                            "text": "Par miracle, le conducteur est sorti indemne de son véhicule après un violent <w>tonneau</w>."
                        }
                    ],
                    "synonyms": [
                        "culbute"
                    ],
                    "common_phrases": [
                        "faire des tonneaux",
                        "partir en tonneaux"
                    ]
                },
                {
                    "sense_id": "b8146502-882c-37e5-8042-98d82673f1ae",
                    "sense_definition": "Figure de voltige aérienne dans laquelle un aéronef accomplit une rotation complète autour de son axe longitudinal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote chevronné a impressionné les spectateurs en réalisant un <w>tonneau</w> parfaitement maîtrisé."
                        },
                        {
                            "text": "L'avion de chasse effectue un rapide <w>tonneau</w> avant de reprendre son cap initial."
                        }
                    ],
                    "common_phrases": [
