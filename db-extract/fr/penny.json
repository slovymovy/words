                ],
                "senses": [
                    {
                        "sense_id": "11813eb9-c0b9-3e59-aec4-73f9b74fca32",
                        "entry_id": "8170d639-3198-3d0e-8826-0bb766cb8356",
                        "glosses": [
                            "Pièce de monnaie au Royaume-Uni, qui a la valeur d’un centième d’une livre depuis la réforme monétaire de 1971, et qui avait la valeur d’un douzième d’un shilling, soit 1/240 d’une livre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad227525-8ffe-41f4-9015-5ec977169e82",
                                "sense_id": "11813eb9-c0b9-3e59-aec4-73f9b74fca32",
                                "text": "Pas un sequin, pas un penny d’argent, pas un sou ; puisse le Dieu d’Abraham me secourir ! dit le juif se tordant les mains."
                            },
                            {
                                "example_id": "7f8893a4-cb5a-472a-8262-6d3b9bd995bf",
                                "sense_id": "11813eb9-c0b9-3e59-aec4-73f9b74fca32",
                                "text": "Il tira une poignée de monnaie et l’examina : trois pennies, une pièce de six pence et une d’un shilling."
                            },
                            {
                                "example_id": "75b285ae-d4fd-4215-bf86-f03c426d11fe",
                                "sense_id": "11813eb9-c0b9-3e59-aec4-73f9b74fca32",
                                "text": "Tournent les peines sur la terre\nAu revoir Madame Angleterre\nJ’ai des pennies qui sont rouillés\nSi vous saviez ce que je sais."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f02c788-d0d9-3620-81ca-1748a09ff6f3",
                        "entry_id": "8170d639-3198-3d0e-8826-0bb766cb8356",
                        "glosses": [
                            "Valeur de cette pièce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59fd1efb-19a7-4005-8510-ab48447bf505",
                                "sense_id": "5f02c788-d0d9-3620-81ca-1748a09ff6f3",
                                "text": "Il tira une poignée de monnaie et l’examina : trois pennies, une pièce de six pence et une d’un shilling."
                            },
                            {
                                "example_id": "ea25a255-6f3a-4d57-bd23-e7c970e65603",
                                "sense_id": "5f02c788-d0d9-3620-81ca-1748a09ff6f3",
                                "text": "Au bout de deux ans, l’éditeur décida de solder le stock : d’un prix initial de cinq shillings, The Rubáiyát passa à un penny, soixante fois moins."
                            }
                        ]
                    },
                    {
                        "sense_id": "51630ed4-2bdf-33ac-beaa-d96472581b1d",
                        "entry_id": "8170d639-3198-3d0e-8826-0bb766cb8356",
                        "glosses": [
                            "Pièce de monnaie du cent, qui a la valeur d’un centième d’un dollar."
                        ],
                        "tags": [
                            "États-Unis",
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "0eaa0ffb-022d-40d4-932d-3b03e56584ce",
                                "sense_id": "51630ed4-2bdf-33ac-beaa-d96472581b1d",
                                "text": "Si demain vous et vos enfants vous vous retrouvez à bredouiller du globish à deux pennys étoilés ou du wesh à deux dinars troués, dernière étape avant l’aphasie, à écrire de droite à gauche, de haut en bas, ou de l’autre côté de la page, n’allez pas le reprocher à ceux qui n’ont eu de cesse de vous alerter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d63b020-77de-4e8e-8a37-525ea21af1b6",
                        "source_entry_id": "8170d639-3198-3d0e-8826-0bb766cb8356",
                        "target_lang_word": "Penny",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Penny",
