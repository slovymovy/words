                ],
                "senses": [
                    {
                        "sense_id": "4ddb4c13-5cd5-35ba-bc94-404e6da814d9",
                        "entry_id": "f0c62ca4-029e-3efa-9226-79c445431471",
                        "glosses": [
                            "het beslissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4c33a2-1e0f-4e29-acd0-c352d53aa27e",
                                "sense_id": "4ddb4c13-5cd5-35ba-bc94-404e6da814d9",
                                "text": "Er is een beslissing genomen. Wij kopen het huis!"
                            },
                            {
                                "example_id": "e42f27e8-0a5b-4f29-b343-a692382e6a60",
                                "sense_id": "4ddb4c13-5cd5-35ba-bc94-404e6da814d9",
                                "text": "Het engste van alleen op pad gaan is de definitieve beslissing om het ook echt te gaan doen. Daarna valt gek genoeg alles best mee."
                            },
                            {
                                "example_id": "b56d695e-fb64-4d25-9359-706746476861",
                                "sense_id": "4ddb4c13-5cd5-35ba-bc94-404e6da814d9",
                                "text": "'Misschien heeft mijn nichtje wel de juiste beslissing genomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da7dfb85-893b-45a3-a144-d16d8d91d69b",
                        "source_entry_id": "f0c62ca4-029e-3efa-9226-79c445431471",
                        "source_sense_id": "4ddb4c13-5cd5-35ba-bc94-404e6da814d9",
                        "target_lang_word": "Entscheidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entscheidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                        "entry_id": "b7613d40-fd5b-34b3-b5ff-ce6205e51a2c",
                                        "glosses": [
                                            "Resultat einer Wahl zwischen mehreren Alternativen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d1d944-edce-428d-a12d-3508149b0dfa",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "Die Entscheidung, wo die Weltmeisterschaft stattfinden wird, ist bereits seit längerer Zeit getroffen."
                                            },
                                            {
                                                "example_id": "bf6e362f-b597-43b2-b038-812a2cc68109",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "Die Entscheidung fiel nach längerer Diskussion, denn gerade den Älteren schien sie schwerzufallen."
                                            },
                                            {
                                                "example_id": "f81d18b1-a6e0-421b-a89e-70149a1eee28",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "„Und einen Monat später, im Juni, kommen die Isländer zu einem weiteren Treffen zusammen, dessen Entscheidungen auf der gesamten Insel Gültigkeit haben: zum Althing - einem in Europa einzigartigen Plenum.“"
                                            },
                                            {
                                                "example_id": "b851f2ab-1a4c-4adf-bc26-abd04a3dfeec",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "„Eine endgültige Entscheidung stand jedoch zum Zeitpunkt der Drucklegung dieses Beitrags noch aus.“"
                                            },
                                            {
                                                "example_id": "61912466-a2ee-4623-b1a9-1b9b5efe26b9",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "„Niemand möchte Entscheidungen treffen und Befehle erteilen, die einem Eingeständnis der Katastrophe gleichkämen.“"
                                            },
                                            {
                                                "example_id": "87ae34cd-59a3-45cc-a722-ff715d8fb822",
                                                "sense_id": "54baa473-6573-323a-957e-9f50a8727a4e",
                                                "text": "„Entscheidungen fällen wir seiner Ansicht nach, indem wir uns bewusst mit Alternativen auseinandersetzen und sorgfältig das Für und Wider abwägen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "665c2339-b9ee-3539-b52c-3beef4e9b467",
                                        "entry_id": "b7613d40-fd5b-34b3-b5ff-ce6205e51a2c",
                                        "glosses": [
                                            "Vorgang des Sichentscheidens; eine Wahl zwischen mehreren Alternativen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b9ca49f-e690-42fc-81b5-9e841157a870",
                                                "sense_id": "665c2339-b9ee-3539-b52c-3beef4e9b467",
                                                "text": "[DDR:] „Die Entscheidung der SED zum Bau der Berliner Mauer stand schon längst fest.“"
                                            },
                                            {
                                                "example_id": "b75ad884-bcf3-47e7-8ee8-04c3b412ff93",
                                                "sense_id": "665c2339-b9ee-3539-b52c-3beef4e9b467",
                                                "text": "Das ist eine sehr schwierige Entscheidung für mich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "80c7fbfc-729a-3a5a-9f8f-7502c53abcbd",
                                        "entry_id": "b7613d40-fd5b-34b3-b5ff-ce6205e51a2c",
                                        "glosses": [
                                            "das Entscheiden einer Sache (oder in einem Streitfall)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5db047-efa8-4eb6-8989-be5b6b1bf020",
                                                "sense_id": "80c7fbfc-729a-3a5a-9f8f-7502c53abcbd",
                                                "text": "Im Gerichtssaal Nr. 299 wurde soeben die Entscheidung des Gerichtes verkündet."
                                            },
                                            {
                                                "example_id": "b89528da-2244-4883-9e07-455dae0adeb4",
                                                "sense_id": "80c7fbfc-729a-3a5a-9f8f-7502c53abcbd",
                                                "text": "„Das Oberste Gericht traf kurz vor der Sommerpause noch weitere brisante Entscheidungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5c204f1-0900-4d02-afc2-622128421cf5",
