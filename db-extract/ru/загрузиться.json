                    }
                ],
                "senses": [
                    {
                        "sense_id": "9561298e-dac3-3915-bf12-f3198d8ee531",
                        "entry_id": "c86c9220-3406-3bc9-87e6-b7d20096a1bd",
                        "glosses": [
                            "принять груз для перевозки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac12db56-0434-4566-aaf4-6410df257d81",
                                "sense_id": "9561298e-dac3-3915-bf12-f3198d8ee531",
                                "text": "Нам хотелось всё, что можно, доделать, поставить и закрепить на берегу, быстро спустить лодку на воду, загрузиться и ― в путь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "51b6db5b-cae0-3226-8bc1-83db7d994c46",
                        "entry_id": "c86c9220-3406-3bc9-87e6-b7d20096a1bd",
                        "glosses": [
                            "перейти в основную память компьютера для использования в операциях процессора"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b21f8d35-54e3-3d85-bd51-3bba65e002cf",
                        "entry_id": "c86c9220-3406-3bc9-87e6-b7d20096a1bd",
                        "glosses": [
                            "разг. расположиться где-либо для поездки (о множестве людей)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16dc2f91-4b0f-4d0a-9310-8690a6bd7b0e",
                                "sense_id": "b21f8d35-54e3-3d85-bd51-3bba65e002cf",
                                "text": "В половине седьмого утра мы все загрузились в какую-то длинную машину, которая развозила всех по домам."
                            }
                        ]
                    },
                    {
                        "sense_id": "71f86cd2-fb4f-30a5-9ac3-9123238b9c67",
                        "entry_id": "c86c9220-3406-3bc9-87e6-b7d20096a1bd",
                        "glosses": [
                            "жарг. задуматься, погрузиться в размышления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7234f5b8-037e-4c9c-b234-f66156453699",
                                "sense_id": "71f86cd2-fb4f-30a5-9ac3-9123238b9c67",
                                "text": "Я вот тут недавно загрузился на эту тему и понял, что с тех пор ничего в мире не изменилось."
                            }
                        ]
                    }
                ],
