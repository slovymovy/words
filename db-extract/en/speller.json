                        "examples": [
                            {
                                "example_id": "4d1710e0-d7f9-4919-92c5-1f8088f631b5",
                                "sense_id": "4ff61cb5-f860-3bd9-8e4b-527a5505a964",
                                "text": "I'm a slow reader but a good speller."
                            },
                            {
                                "example_id": "01b460d0-10f9-463e-a6dc-51fb73171870",
                                "sense_id": "4ff61cb5-f860-3bd9-8e4b-527a5505a964",
                                "text": "Without insisting on a difference between the inventors and the spellers of words, Socrates makes short work of this case."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4608182-1de8-31a4-8140-1c709a4f08cb",
                        "entry_id": "d25b244b-aa37-3711-8d77-b015e50ac9ed",
                        "glosses": [
                            "A participant in a spelling bee."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f06fb66-7f2b-36c3-b25f-2a90abde9f5f",
                        "entry_id": "d25b244b-aa37-3711-8d77-b015e50ac9ed",
                        "glosses": [
                            "A book used to learn how to spell properly."
