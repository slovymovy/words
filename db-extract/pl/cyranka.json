                "senses": [
                    {
                        "sense_id": "ae979fb7-96d7-37ed-8696-5075fb0999d0",
                        "entry_id": "3687ddf8-e950-397d-8d7e-e06482e02edb",
                        "glosses": [
                            "Anas querquedula, wodny ptak eurazjatycki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32ffad0-5c09-4e9d-8a73-cb61dd870b70",
                                "sense_id": "ae979fb7-96d7-37ed-8696-5075fb0999d0",
                                "text": "Nadleciały stadkiem cyranki, krążyły kilkakroć z wyciągniętymi szyjami, przerywając ciszę melodyjnym, dzwoniącym świstem skrzydeł, zataczały w powietrzu elipsy coraz mniejsze – wreszcie zapadły w trzciny, z łoskotem rozbijając wodę piersiami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
