                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "624c7d03-3772-3c0a-b736-ee361ce70f50",
                                        "entry_id": "cc84edcc-9bcf-3b38-8fa1-8768dd91cef0",
                                        "glosses": [
                                            "a technique in makeup using blush and bronzing powder to define contours on the face"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c88d75b-74fa-420c-b1f5-5a558e826b92",
                                                "sense_id": "624c7d03-3772-3c0a-b736-ee361ce70f50",
                                                "text": "Contouring is not our thing because the main beauty philosophy in France is to accept who you are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecaae8ef-6f84-304a-a071-411fbaeda2d9",
                                        "entry_id": "cc84edcc-9bcf-3b38-8fa1-8768dd91cef0",
                                        "glosses": [
                                            "the building up of muscles with exercise"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8cdb21d-79bd-3c97-acd0-dc892f940b42",
                                        "entry_id": "cc84edcc-9bcf-3b38-8fa1-8768dd91cef0",
                                        "glosses": [
                                            "walking along contour lines, usually to save energy or simplify navigation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2159170b-e380-4242-9b73-7584fb5efc07",
                                                "sense_id": "c8cdb21d-79bd-3c97-acd0-dc892f940b42",
                                                "text": "If you are going to be walking in mountainous or rough terrain it is often a good idea to plan a route following contour lines. This is called ‘contouring’."
                                            }
                                        ]
                                    }
