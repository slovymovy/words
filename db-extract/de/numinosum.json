                "senses": [
                    {
                        "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                        "entry_id": "7b89371c-cb56-3d29-9a90-23f87b681ec8",
                        "glosses": [
                            "etwas, das Ehrfurcht und Schauer hervorruft und damit anziehend wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf779c8-d14a-4734-acca-c5192065d4b7",
                                "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                                "text": "„Der bestiegene Berg verliert sein Numinosum, das so faszinierte. Er hinterlässt eine innere Leere.“"
                            },
                            {
                                "example_id": "95ea7bb7-65b6-48bc-8d80-148ed58c4313",
                                "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                            },
                            {
                                "example_id": "d2b86356-fff7-4653-9a3a-e3d7c96fc652",
                                "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                                "text": "„Nicht, wer die Menschheit, wer die Partei oder sonst eine Abstraktion, nicht, wer allein die Madonna oder ein anderes Numinosum liebt, ist kultiviert, sondern wer erst einmal einen Menschen lieben kann, durch alle Spannungen ambivalenter Erlebnisse hindurch, die er mit ihm haben wird.“"
                            },
                            {
                                "example_id": "4163c128-a793-495a-abc0-9d5f428db5cc",
                                "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                                "text": "„Die das Humanum einbeziehende und mit ihm kulminierende Ehrfurcht braucht noch das im Sterndienst einmal besonders hoch erfahrene, an der Größe der Natur erfahrene Numinosum als Korrektiv, um die religiöse Gegenständlichkeit seiner selbst zu bewahren, das ist eben, um vom Menschen nicht groß und nicht geheimnisvoll genug zu denken.“"
                            },
                            {
                                "example_id": "7f090944-a4b8-4f26-9577-eab4d790ded0",
                                "sense_id": "80fd5464-56ce-33f6-9a57-0a922700d9c3",
                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
