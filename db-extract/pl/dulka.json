                "senses": [
                    {
                        "sense_id": "3b88373a-17a6-3f2c-b7ae-7eaab9cbc767",
                        "entry_id": "5b825341-f5e7-37c8-aec9-41ee563b6f65",
                        "glosses": [
                            "element łodzi wioślarskiej w postaci ruchomego pierścienia metalowego lub widełek, przymocowanych do burty łodzi, służący do utrzymywania wiosła w odpowiedniej pozycji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac74808-be61-46c8-a2ba-76ef46959688",
                                "sense_id": "3b88373a-17a6-3f2c-b7ae-7eaab9cbc767",
                                "text": "Skórzany mankiet wiosła zabezpiecza je przed ścieraniem przez dulkę."
                            },
                            {
                                "example_id": "54d3323d-7977-4e5b-8a5e-fd45ed1d4ef4",
                                "sense_id": "3b88373a-17a6-3f2c-b7ae-7eaab9cbc767",
                                "text": "Wkładamy wiosła w dulki i ruszamy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e1ae40f-7977-4183-8053-398f979267b9",
                        "source_entry_id": "5b825341-f5e7-37c8-aec9-41ee563b6f65",
                        "source_sense_id": "3b88373a-17a6-3f2c-b7ae-7eaab9cbc767",
                        "target_lang_word": "oarlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oarlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c66a89c-f596-328c-b766-c50b91f3c2bb",
                                        "entry_id": "721c38c3-08d5-3bb1-8d2a-8fdd7283f3d5",
                                        "glosses": [
                                            "A usually U-shaped device attached to the gunwale of a rowboat to hold the oars in place while rowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99fb90bb-cb11-4f97-b6df-e4990543844b",
                                                "sense_id": "7c66a89c-f596-328c-b766-c50b91f3c2bb",
                                                "text": "But, as luck would have it, scarcely had he started to row his boat again when an oarlock broke, and so it took him the best part of an hour to make the trip."
                                            },
                                            {
                                                "example_id": "404c40cc-1559-48e8-95ce-6f7df1845c07",
                                                "sense_id": "7c66a89c-f596-328c-b766-c50b91f3c2bb",
                                                "text": "\"No motor,\" Tranny says. \"It snag bad.\"\n Right. The spiderweb would get wrapped around the propeller. Tranny shows Hiro how to snap zodiac's oars into the oarlocks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5a3f90a-d5bf-40bc-a74b-ce4071c20111",
                        "source_entry_id": "5b825341-f5e7-37c8-aec9-41ee563b6f65",
                        "source_sense_id": "3b88373a-17a6-3f2c-b7ae-7eaab9cbc767",
                        "target_lang_word": "rowlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rowlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "574dbb19-0a32-338c-8f06-d2541c9786bc",
                                        "entry_id": "12b770bf-cce3-32c5-b00b-0bef5c4c7ced",
                                        "glosses": [
                                            "A usually U-shaped pivot attached to the gunwale (outrigger in a sport boat) of a boat that supports and guides an oar, and provides a fulcrum for rowing; an oarlock."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b174071f-b00d-46c9-8434-b969ee92b10b",
                                                "sense_id": "574dbb19-0a32-338c-8f06-d2541c9786bc",
                                                "text": "I took a good gap and a stretch, and was just going to unhitch and start when I heard a sound away over the water. I listened. Pretty soon I made it out. It was that dull kind of a regular sound that comes from oars working in rowlocks when it's a still night."
                                            },
                                            {
                                                "example_id": "56167b4e-38e3-49ef-94d6-bd5fe37e853f",
                                                "sense_id": "574dbb19-0a32-338c-8f06-d2541c9786bc",
                                                "text": "Everything smelled salt and there was no noise except the swishing of water and the clop-clop of water against the sides and the splash of the oars and the jolting noise of the rowlocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7804e7-e140-37c7-a66d-51313f4ab5eb",
                                        "entry_id": "12b770bf-cce3-32c5-b00b-0bef5c4c7ced",
                                        "glosses": [
                                            "A brick, for example in a course of brickwork, that is laid vertically with its tallest but slimmest side facing down, and its shortest face facing the outside of the wall (oriented so that it is taller than it is wide)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
