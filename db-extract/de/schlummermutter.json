                "senses": [
                    {
                        "sense_id": "33a22e7a-bc17-3e07-9f17-0b5f0fc35c97",
                        "entry_id": "3b60fb9e-1008-349f-84f2-e900e0323ec5",
                        "glosses": [
                            "Weibliche Person, die Schlafplätze oder Zimmer für Studenten vermietet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "49a4c977-7548-442a-99b3-05a5b2bd063b",
                                "sense_id": "33a22e7a-bc17-3e07-9f17-0b5f0fc35c97",
                                "text": "„Damals als Studenten war für uns eine Schlummermutter eine Frau, bei der man sich möglichst unbemerkt an der Küche vorbeischleichen musste, um nicht wie in einem Spinnennetz in ein Gespräch eingewickelt zu werden. “"
                            },
                            {
                                "example_id": "38a4f76e-6139-48d8-9b8b-e137afb9d3f9",
                                "sense_id": "33a22e7a-bc17-3e07-9f17-0b5f0fc35c97",
                                "text": "„Zudem scheint auch auf dem freien Wohnungsmarkt das Wohnen bei Schlummermüttern bei einigen Studierenden gut anzukommen, wie ein Bericht von Radio DRS vom 31.3.2009 zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0939c9dc-887c-4433-bf99-e2abe4568ee0",
                        "source_entry_id": "3b60fb9e-1008-349f-84f2-e900e0323ec5",
                        "source_sense_id": "33a22e7a-bc17-3e07-9f17-0b5f0fc35c97",
