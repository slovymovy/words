                "senses": [
                    {
                        "sense_id": "5a432f82-7483-32b5-86bc-73edbb0474ac",
                        "entry_id": "b17a2160-be07-31c9-8dff-fb75948438b7",
                        "glosses": [
                            "het door een particulier zelf (en dus niet door een extern bedrijf) bouwen van een woning, apparaat of iets anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0316c07f-614b-4651-ab2e-aec85d64659b",
                                "sense_id": "5a432f82-7483-32b5-86bc-73edbb0474ac",
                                "text": "Voor de bekendste manier van zelfbouw, waarbij een particulier een kavel koopt en zelf een huis bouwt, is relatief weinig plaats. De kavels zijn ook vaak te duur voor mensen met middeninkomens. De gemeente doet daarom onderzoek naar mogelijkheden voor gestapelde zelfbouw en vormen van collectief particulier opdrachtgeverschap (gezamenlijke zelfbouw)."
                            },
                            {
                                "example_id": "79798925-ccab-4117-bf74-35a868d33eea",
                                "sense_id": "5a432f82-7483-32b5-86bc-73edbb0474ac",
                                "text": "Gino Winter – coureur van monstertrucks – heb ik gevraagd te vertellen wat erop is te zien. Hij vindt dat lastig, omdat iedere truck anders is. Het is allemaal zelfbouw."
                            },
                            {
                                "example_id": "a9619e36-7a7c-4b30-abef-2cd8b818d241",
                                "sense_id": "5a432f82-7483-32b5-86bc-73edbb0474ac",
                                "text": "Daarnaast strijden er Sport 1600 auto’s, een soort verlaagde kevers en 1600cc en 2000cc Sprint en Superklasse, die beter bekend staan als de zelfbouw buggy's."
                            }
                        ]
                    }
                ],
