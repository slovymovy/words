    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e9f434f-f6bd-3805-b9a5-6bffa21f8aad",
                "word": "hereabouts",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                        "entry_id": "4e9f434f-f6bd-3805-b9a5-6bffa21f8aad",
                        "glosses": [
                            "Near here."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7b4fd5-7236-4ef1-9b08-992abf1148b0",
                                "sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                                "text": "The people hereabouts are pretty decent folk."
                            },
                            {
                                "example_id": "34bda23b-08cb-4bed-8cb2-3c886b63413a",
                                "sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                                "text": "How far might you call yourselves from the marshes, hereabouts? Not above a mile, I reckon?"
                            },
                            {
                                "example_id": "067dc6fa-e3b8-400d-b2d9-c4ea61544171",
                                "sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                                "text": "Hereabouts is Knockupworth, where the line deviates from the canal course."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e64becf3-e89f-4b8d-8a4d-9bfda3f85464",
                        "source_entry_id": "4e9f434f-f6bd-3805-b9a5-6bffa21f8aad",
                        "source_sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                        "source_sense_description": "near here",
                        "target_lang_word": "hierherum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b46feaf5-e1dc-41b6-a638-7dbcddf4f8d8",
                        "source_entry_id": "4e9f434f-f6bd-3805-b9a5-6bffa21f8aad",
                        "source_sense_id": "2a374f16-7e19-3fc6-b342-ffb71befdffd",
                        "source_sense_description": "near here",
                        "target_lang_word": "hierorts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierorts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                        "entry_id": "0f800b18-0814-3263-9449-7b2d7a691784",
                                        "glosses": [
                                            "an dieser Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd0b63b-037e-41bc-8ab3-375884e1af07",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Es besteht hierorts kein Zweifel, daß Donauhochwässer, die sich in diesem Bereich zurückstauen, für die Überflutungen verantwortlich sind.“"
                                            },
                                            {
                                                "example_id": "46458a94-8a23-4182-b0cb-c0736f6317dd",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Hinsichtlich der örtlichen Gegebenheiten wird auf das hierorts bereits ergangene Gutachten vom 24.03.2015 verwiesen.“"
                                            },
                                            {
                                                "example_id": "b137b6b4-2ed3-4219-9e53-0b27a6f91ee2",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Viele Geschäfte, Banken, Handwerksbetriebe, Gastwirtschaften, Arztpraxis, Grund- und Realschule plus mit Sporthalle, Kindergarten, ebenso eine bei der Schule gelegene Freiluftsportanlage sind vorhanden, so dass man hierorts von einer Eigenversorgung sprechen kann.“"
                                            },
                                            {
                                                "example_id": "9aba0c1c-e252-4dcd-ba7c-29c3749880b5",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„In der deutschen Hochsprache werden die Lokativfunktionen vom Dativ übernommen; in stehengebliebenen Wortformen hat der Genitiv lokativische Funktion (hierorts, veraltet auch dortorts).“"
                                            },
                                            {
                                                "example_id": "3641877a-df6d-4c54-836f-c980d1dd48e2",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Hier wünschte man sich mehr Bemühung, schon um in dieses hierorts verkannte Weinwunderland einzuführen.“"
                                            },
                                            {
                                                "example_id": "08a052d7-d4d1-4a7d-b517-e9aede283c0f",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Denn wer meint, organisierte Kriminalität und Finanzierung von Terrorismus seien eine hierorts weitverbreitete Form von Kriminalität, der täuscht sich.“"
                                            },
                                            {
                                                "example_id": "0a930f15-1ad3-46a5-855b-334443a9aee0",
                                                "sense_id": "c413c648-e82d-3a6b-87bd-c3222e316133",
                                                "text": "„Bei der hierorts durchgeführten persönlichen Begutachtung war die [Beschwerdeführerin] kardial und respiratorisch kompensiert, sowie in gutem Allgemein- und Ernährungszustand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
