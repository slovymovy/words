                    }
                ],
                "senses": [
                    {
                        "sense_id": "37f34af7-5b3c-306f-a76c-0ee79e730323",
                        "entry_id": "10af598a-be07-3879-a451-b9f70ece6b1e",
                        "glosses": [
                            "Qui va de l’avant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b74a98-7035-4018-9575-9e4805de9a79",
                                "sense_id": "37f34af7-5b3c-306f-a76c-0ee79e730323",
                                "text": "Un mouvement antérograde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7655d1c-bd69-34d2-894b-a83c100b007d",
                        "entry_id": "10af598a-be07-3879-a451-b9f70ece6b1e",
                        "glosses": [
                            "Qui s’applique après un événement particulier. Désigne notamment un cas particulier d'amnésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "233d4196-c876-40d4-875e-deabbfb02918",
                                "sense_id": "a7655d1c-bd69-34d2-894b-a83c100b007d",
                                "text": "L’amnésie antérograde porte sur les faits postérieurs à l’accident."
                            },
                            {
                                "example_id": "93fec883-abce-4746-b6e0-117bb8fb1609",
                                "sense_id": "a7655d1c-bd69-34d2-894b-a83c100b007d",
                                "text": "Ces patients perdent la capacité à créer de nouveaux souvenirs – amnésie dite antérograde – tandis que leur capacité à évoquer des souvenirs plus anciens est davantage respectée. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 242)."
                            },
                            {
                                "example_id": "89fe56be-d727-4586-83a7-d229d83f3b1c",
                                "sense_id": "a7655d1c-bd69-34d2-894b-a83c100b007d",
                                "text": "Certains souvenirs sont ainsi susceptibles de disparaître ou de ne jamais s'écrire, impliquant une certaine distanciation avec le réel. En effet, l'amnésie transitoire, ou « ictus amnésique idiopathique », peut advenir à la suite d'un choc émotionnel et engendrer une perte de mémoire antérograde, c'est-à-dire rendant la formation de nouveaux souvenirs impossible. Dans d'autres cas, l'amnésie dite « dissociative » implique la perte de souvenirs anciens — vieux de quelques jours ou de plusieurs années —, souvent provoquée par un événement traumatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b21be9a-ac3d-4e88-a023-d11a44cdf05b",
                        "source_entry_id": "10af598a-be07-3879-a451-b9f70ece6b1e",
                        "target_lang_word": "anterograd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a53f3796-63c8-4a4d-9896-263279ba3147",
                        "source_entry_id": "10af598a-be07-3879-a451-b9f70ece6b1e",
                        "target_lang_word": "anterograde",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anterograde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4713db41-81a1-3e7c-a3f2-a402531fa79e",
                                        "entry_id": "8f510383-bbd1-3828-b28b-23c5f5583331",
                                        "glosses": [
                                            "Effective immediately after a traumatic event such as an external shock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d01cad-139c-476f-b703-c8810b9c083d",
                                                "sense_id": "4713db41-81a1-3e7c-a3f2-a402531fa79e",
                                                "text": "Anterograde amnesia is a loss of the ability to create new memories after the event that caused the amnesia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf83f574-1488-3bf7-b5e2-b4513a9ac780",
                                        "entry_id": "8f510383-bbd1-3828-b28b-23c5f5583331",
                                        "glosses": [
                                            "Moving or occurring in the normal forward or downstream direction of."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a389ccd8-3cac-4d4e-b5e2-b6150a87df99",
                                                "sense_id": "cf83f574-1488-3bf7-b5e2-b4513a9ac780",
                                                "text": "Movement of mitochondria and other cell parts from a neuron's cell body toward the synapse is called anterograde transport."
                                            },
                                            {
                                                "example_id": "cef8d1e3-37b5-4867-ac1d-3c3721db668e",
                                                "sense_id": "cf83f574-1488-3bf7-b5e2-b4513a9ac780",
                                                "text": "Anterograde tracing is a research technique which is used to trace neural connections from their source to their point of termination. The opposite technique is retrograde tracing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
