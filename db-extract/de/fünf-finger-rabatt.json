                "senses": [
                    {
                        "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                        "entry_id": "4f95c0f0-eb66-3127-b8f5-fb236178b647",
                        "glosses": [
                            "Aneignung fremden Eigentums (in einem Geschäft)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dc1c319f-2bb6-44ca-bc57-7be6a5db45df",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "Verstärkte Polizeipräsenz auf Einkaufsmeilen soll die Attraktivität von Fünf-Finger-Rabatten verringern."
                            },
                            {
                                "example_id": "a443c7f4-0780-411d-8e2f-ce7a41bdc4b7",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "„Wissenschaftlern der Gesellschaft für Konsumforschung (GfK) in Nürnberg ist der Nachweis gelungen, dass Ladendiebstahl den Geldbeutel deutlich weniger strapaziert als das traditionelle Bezahlen an der Kasse. Besonders bei vermeintlich teueren Anschaffungen kann der sogenannte Fünf-Finger-Rabatt punkten.“"
                            },
                            {
                                "example_id": "13635e03-a915-4d59-a80a-fa531823c70e",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "„»Ich kriege auf alles Rabatt«, sagte er und wedelte mit den Fingern. »Den Fünf-Finger-Rabatt.«“"
                            },
                            {
                                "example_id": "875508f7-10bb-49e8-bae5-cce7471a8539",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "„Kunstlederjacken-Fetischist steht auf Fünf-Finger-Rabatt“"
                            },
                            {
                                "example_id": "6b2323b9-5900-42b7-923a-a1e6c7740f46",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "„Einfach nehmen anstatt zu bezahlen - der Fünf-Finger-Rabatt hat immer Saison und bescherte dem Einzelhandel auch im vergangenen Jahr hohe Verluste.“"
                            },
                            {
                                "example_id": "f8193057-7efd-4e66-9ce8-0ed83ebbe4b7",
                                "sense_id": "f55420ec-6a42-3759-9048-c92af9a9677b",
                                "text": "„Dass man sich nicht immer sicher sein kann, ob man über den türkischen „Betäubungsmittelkaufmann“, den Polen mit dem „Fünf-Finger-Rabatt“, den „Import/Escort“-Russen oder den Afrikaner, „der uns die Frauen wegschnackselt“ noch, überhaupt oder schon wieder lachen darf, gehört zum (Possen)Spiel des Deutschen Comedypreisträgers 2010.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
