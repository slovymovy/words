                "translations": [
                    {
                        "translation_id": "2966f88f-bb2e-4bbf-ab0b-48e21407ebbf",
                        "source_entry_id": "a94e6e85-0379-32e7-ad00-44c981777b21",
                        "source_sense_id": "2dc95611-9e2e-30fc-95ca-8dd71b860647",
                        "target_lang_word": "freezer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freezer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41f0d8c4-686f-3ad4-a6e0-950e71f1399d",
                                        "entry_id": "31938f2b-148d-3049-bdc2-0390c1c70ed2",
                                        "glosses": [
                                            "An appliance or room used to store food or other perishable items at temperatures below 0° Celsius (32° Fahrenheit)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba15510-0aac-4692-a8e1-5ba7f7668b71",
                                                "sense_id": "41f0d8c4-686f-3ad4-a6e0-950e71f1399d",
                                                "text": "The packinghouse usually delivers shrimp to a few regular customers, such as breaders, freezers, canners, or wholesalers of fresh shrimp."
                                            },
                                            {
                                                "example_id": "02f81649-fdce-46c7-a9ca-28578d5c9b4a",
                                                "sense_id": "41f0d8c4-686f-3ad4-a6e0-950e71f1399d",
                                                "text": "It’s easy to grab plastic-wrapped daifuku at Japanese grocery stores in New York, and to spot boxes of mochi ice cream in supermarket freezer aisles."
                                            },
                                            {
                                                "example_id": "eb397195-33ad-4c32-9638-d5dba146aac6",
                                                "sense_id": "41f0d8c4-686f-3ad4-a6e0-950e71f1399d",
                                                "text": "Fridges contain gases that can cause serious environmental damage and are among the most toxic white goods if not disposed of correctly, along with freezers and air conditioning units."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9132d4d-c9d1-3307-af58-4ffcdd0da66b",
                                        "entry_id": "31938f2b-148d-3049-bdc2-0390c1c70ed2",
                                        "glosses": [
                                            "The section of a refrigerator used to store food or other perishable items at a temperature below 0° Celsius (32° Fahrenheit)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5eba4e-46f2-4d1c-af8d-f4d9be0f6c93",
                                                "sense_id": "a9132d4d-c9d1-3307-af58-4ffcdd0da66b",
                                                "text": "Holonyms: fridge, fridge-freezer, refrigerator, refrigerator-freezer"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe25506-0775-3da7-9f26-6ff29e6394e9",
                                        "entry_id": "31938f2b-148d-3049-bdc2-0390c1c70ed2",
                                        "glosses": [
                                            "A Parkinson's disease patient that experiences freezing of gait (FOG) episodes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f1095dc-999c-3563-bb66-e271d07874e0",
                                        "entry_id": "31938f2b-148d-3049-bdc2-0390c1c70ed2",
                                        "glosses": [
                                            "A hardware device that can freeze the state of the system to allow it to be inspected, saved or modified."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef01905-47fa-42b7-bfc6-9b55bea3f8db",
                                                "sense_id": "1f1095dc-999c-3563-bb66-e271d07874e0",
                                                "text": "[…] \"freezer\" cartridges (such as the Action Replay), as a convenient way to take control […]"
                                            },
                                            {
                                                "example_id": "ae5cabb4-fab2-49d9-b4d5-7bf72ad277e9",
                                                "sense_id": "1f1095dc-999c-3563-bb66-e271d07874e0",
                                                "text": "The execution of the program was suspended with a special hardware expansion, the freezer, and the contents of the memory were saved to disk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
