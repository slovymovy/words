                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a3efd87-690c-4775-a5d9-b873858398a4",
                        "source_entry_id": "07bb74fd-bd86-3238-9b80-11c8395ac35b",
                        "source_sense_description": "depreciation",
