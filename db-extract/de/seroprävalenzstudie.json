                ],
                "senses": [
                    {
                        "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                        "entry_id": "10d74e0f-6003-3fcd-b2e9-f9f668005d1f",
                        "glosses": [
                            "Studie zur Feststellung der Prozentzahl positiv getesteter serologischer Parameter in einer bestimmten Population zu einem bestimmten Zeitpunkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f858a371-4856-4071-a29e-1814278f5712",
                                "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                                "text": "In Seroprävalenzstudien wird ein repräsentativer Teil der Bevölkerung auf Antikörper gegen Viren wie das neuartige Coronavirus SARS-CoV-2 untersucht."
                            },
                            {
                                "example_id": "ed1b2559-3ae9-48c4-953a-e05b2ca6f084",
                                "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                                "text": "Das Team verweist darauf, dass ihre Schätzungen für verschiedene Länder sehr gut mit den Ergebnissen von Seroprävalenzstudien übereinstimmen, bei denen die Zahl der bereits Infizierten anhand von vorhandenen Antikörpern im Blut in einer Stichprobe erhoben und dann auf die Gesamtbevölkerung hochgerechnet wird."
                            },
                            {
                                "example_id": "39d4e2a1-0435-41d5-985e-9f8a9fa4408d",
                                "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                                "text": "Gemäß einer Seroprävalenzstudie an nicht-symptomatischen jungen Männern (Rekruten im damaligen Rekrutierungszentrum in Lausanne) beträgt die Häufigkeit einer Lausannevirus-Infektion bei Menschen 1,74 Prozent."
                            },
                            {
                                "example_id": "7e6606af-fec0-470e-9fcd-42bbdc55bbaa",
                                "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                                "text": "Zwei Seroprävalenzstudien in Französisch-Guyana zeigten, dass 14,3 bzw. 11,9 Prozent der Bevölkerung bereits Kontakt mit dem Virus hatten."
                            },
                            {
                                "example_id": "d49899dc-e03a-4a4a-b013-5ab53184f106",
                                "sense_id": "8f99e209-f81e-3f1e-b584-4d98b1c17c4e",
                                "text": "Die LEOSS.sero-survey Plattform ist eine offene Initiative, um Forschern eine zentrale Anlaufstelle zu bieten, für SARS-CoV-2 Seroprävalenzstudien und deren Daten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc56973a-7566-4362-a53f-1bce4a574a70",
                        "source_entry_id": "10d74e0f-6003-3fcd-b2e9-f9f668005d1f",
