                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf4f6db-25ba-49aa-bcf0-1273251cf238",
                                "sense_id": "64fa3a87-9b21-3d70-8ec3-73685fed77ea",
                                "text": "Un travail de décortiqueur des saint-jacques, ouvert à ceux qui possèdent déjà une expérience et aux personnes qui souhaitent se former à ce métier."
                            },
                            {
                                "example_id": "9aa3a3a7-4d7f-4b1e-b039-e4525c1779fb",
                                "sense_id": "64fa3a87-9b21-3d70-8ec3-73685fed77ea",
                                "text": "Et des érudits rancardés, des tenants du chaos, des décortiqueurs de thèses philosophiques, des trombines masquées."
