{
    "word_family": [
        "behest"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                    "sense_definition": "An authoritative command, order, or request.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was completed at the <w>behest</w> of the company director.",
                            "target_lang_translations": {
                                "ru": "Проект был завершён по <w>распоряжению</w> директора компании."
                            }
                        },
                        {
                            "text": "He acted at his father's <w>behest</w> to settle the family dispute.",
                            "target_lang_translations": {
                                "ru": "Он действовал по <w>просьбе</w> отца, чтобы уладить семейный спор."
                            }
                        }
                    ],
                    "synonyms": [
                        "command",
                        "bidding",
                        "order",
                        "instruction"
                    ],
                    "common_phrases": [
                        "at the behest of"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in formal or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Авторитетное приказание, повеление, распоряжение или просьба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "приказ или предписание руководства"
                            },
                            {
                                "target_lang_word": "указание",
                                "target_lang_sense_clarification": "руководящее наставление или распоряжение"
                            },
                            {
                                "target_lang_word": "повеление",
                                "target_lang_sense_clarification": "высокая или властная воля, приказ"
                            },
                            {
                                "target_lang_word": "воля",
                                "target_lang_sense_clarification": "желание или требование лица, обладающего властью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd479cf-c9a8-38ef-a364-c50948a55998",
                    "sense_definition": "A solemn promise or vow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled to keep the <w>behest</w> she had made to her dying friend.",
                            "target_lang_translations": {
                                "ru": "Она изо всех сил старалась сдержать <w>обещание</w>, данное умирающему другу."
                            }
                        },
                        {
                            "text": "The knight honored his <w>behest</w> to return by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Рыцарь сдержал свой <w>обет</w> вернуться к концу года."
                            }
                        }
                    ],
                    "synonyms": [
                        "vow",
                        "promise",
                        "pledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественное обещание или обет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обет",
                                "target_lang_sense_clarification": "торжественное обещание, клятва"
                            },
                            {
                                "target_lang_word": "обещание",
                                "target_lang_sense_clarification": "добровольное обязательство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0511a381-bf2e-3c6a-9037-1fd172b124a4",
                    "sense_definition": "To make a solemn promise or vow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>behested</w> to return the stolen goods to their rightful owner.",
                            "target_lang_translations": {
                                "ru": "Он <w>поклялся</w> вернуть украденные вещи их законному владельцу."
                            }
                        },
                        {
                            "text": "The king <w>behested</w> that peace would be maintained throughout the land.",
                            "target_lang_translations": {
                                "ru": "Король <w>дал торжественное обещание</w>, что мир во всей стране будет сохранён."
                            }
                        }
                    ],
                    "synonyms": [
                        "vow",
                        "promise",
                        "pledge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "No longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать торжественное обещание или обет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать обет",
                                "target_lang_sense_clarification": "торжественно обещать, связывать себя клятвой"
                            },
                            {
                                "target_lang_word": "клясться",
                                "target_lang_sense_clarification": "давать клятвенное обещание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}