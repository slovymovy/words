{
    "word_family": [
        "dazed",
        "dazing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c52914ae-8981-3133-b69a-a9872e1635e7",
                    "sense_definition": "A state of confusion or mental numbness where one is unable to think clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked around in a <w>daze</w> after hearing the shocking news.",
                            "target_lang_translations": {
                                "zh": "听到那个令人震惊的消息后，她一直处于<w>恍惚</w>状态。"
                            }
                        },
                        {
                            "text": "The survivor remained in a <w>daze</w> for several hours following the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生后的几个小时里，幸存者一直处于<w>恍惚</w>之中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a daze"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种思维混乱或麻木的状态，使人无法清晰思考。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恍惚",
                                "target_lang_sense_clarification": "形容精神不集中，神志不清的状态。"
                            },
                            {
                                "target_lang_word": "发愣",
                                "target_lang_sense_clarification": "形容因吃惊或困惑而呆住的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51b56b79-da9a-3a35-874d-877ac09ac269",
                    "sense_definition": "A type of glittering or sparkling stone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mineral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler identified the small, bright <w>daze</w> among the collection of gems.",
                            "target_lang_translations": {
                                "zh": "珠宝商在宝石收藏中辨认出了那颗微小而明亮的宝石。"
                            }
                        },
                        {
                            "text": "The ancient text describes a rare <w>daze</w> that shines under moonlight.",
                            "target_lang_translations": {
                                "zh": "古籍中记载了一种在月光下会发光的稀有宝石。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English to describe a stone."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种闪闪发光的宝石。"
                    },
                    "translations": {
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebb8a5e1-ee2b-3214-8df3-b33f628baf6a",
                    "sense_definition": "To cause someone to feel stunned, confused, or unable to think clearly due to a shock, bright light, or physical impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright flash of the camera began to <w>daze</w> the performers on stage.",
                            "target_lang_translations": {
                                "zh": "相机明亮的闪光灯开始让舞台上的表演者感到<w>眩晕</w>。"
                            }
                        },
                        {
                            "text": "A heavy blow to the head can easily <w>daze</w> an athlete during a match.",
                            "target_lang_translations": {
                                "zh": "比赛中头部受到重击很容易让运动员感到<w>发懵</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因震惊、强光或物理撞击而使人感到眩晕、困惑或无法清晰思考。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……眩晕",
                                "target_lang_sense_clarification": "指因外力或强光导致头晕目眩。"
                            },
                            {
                                "target_lang_word": "使……发懵",
                                "target_lang_sense_clarification": "指因突发状况导致大脑短时间无法思考。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}