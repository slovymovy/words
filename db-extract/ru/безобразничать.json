                "senses": [
                    {
                        "sense_id": "6db259e1-046e-3c6a-9547-713eefcb5c82",
                        "entry_id": "fe227ccd-7d20-396e-8e5b-1d003a4ea5e0",
                        "glosses": [
                            "разг. вести себя возмутительно, непристойно, совершая дурные поступки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3df17e-6f3c-49b8-bb90-60c69ba456cd",
                                "sense_id": "6db259e1-046e-3c6a-9547-713eefcb5c82",
                                "text": "Безобразничает и денно и нощно, денег у неё никогда нет, и я её должна Христа ради кормить."
                            },
                            {
                                "example_id": "ca2ef9f5-ed66-4490-83de-39e056f5dbc9",
                                "sense_id": "6db259e1-046e-3c6a-9547-713eefcb5c82",
                                "text": "В толпе безобразничал один пьяный: ему всё хотелось плясать, но он всё валился на сторону."
                            },
                            {
                                "example_id": "c2f2c8d2-2f9d-48ee-8164-d5fa72e17f8c",
                                "sense_id": "6db259e1-046e-3c6a-9547-713eefcb5c82",
                                "text": "Безобразничать с женским полом любил не то что по-прежнему, а даже как бы и отвратительнее."
                            }
                        ]
                    }
                ],
