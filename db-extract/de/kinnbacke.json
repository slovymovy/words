                        "examples": [
                            {
                                "example_id": "48db1195-e6bc-4df2-ac38-cdd5557fbf9b",
                                "sense_id": "57fd6b62-9804-30e9-a7d9-c9a44987bd6d",
                                "text": "„Roberts Vater, der noch immer mit dem silbernen Bleistift spielte, machte einige kauende Bewegungen mit den Kinnbacken, bevor er zum Sprechen ansetzte.“"
                            },
                            {
                                "example_id": "ab65bc90-2642-4db6-b946-5ea02e5cf102",
                                "sense_id": "57fd6b62-9804-30e9-a7d9-c9a44987bd6d",
                                "text": "„Er hatte rote Flecken auf seinen Kinnbacken.“"
                            }
                        ],
