                                        "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                        "entry_id": "78960e49-d6b6-3ae2-bb31-d6c3b4c856e5",
                                        "glosses": [
                                            "Suspension ou interruption momentanée d’une action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ee82f4-14cf-4615-b47c-47d7ab944046",
                                                "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                                "text": "La procession fit une pause en tel endroit."
                                            },
                                            {
                                                "example_id": "50a26e34-8d2c-444d-b337-9592d2c26202",
                                                "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                                "text": "Dans un long travail, il faut des petites pauses de temps en temps."
                                            },
                                            {
                                                "example_id": "d74235e4-e2e9-4736-a6a2-b8f9c6aeddab",
                                                "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                                "text": "Y a bien un gars qui est passé et qui a dû faire une pause pour poser son keuss au milieu, genre les bretelles lui sciaient les doigts !"
                                            },
                                            {
                                                "example_id": "e11826d3-bb6f-46a7-b9f3-81d0c5066862",
                                                "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                                "text": "Faire une pause, de longues pauses."
                                            },
                                            {
                                                "example_id": "0c87928e-05ed-4580-bdf5-cc75f84103b9",
                                                "sense_id": "61f129f8-0c4a-3566-953d-83840fc4bb97",
                                                "text": "Il fit deux ou trois pauses en chemin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664fe012-2b7e-3f98-874c-3318f577426b",
                                        "entry_id": "78960e49-d6b6-3ae2-bb31-d6c3b4c856e5",
                                        "glosses": [
                                            "Temps de repos qui interrompt, généralement à intervalles réguliers, un exercice on une marche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43afa059-7460-4d69-b787-8832acc8ac5b",
                                                "sense_id": "664fe012-2b7e-3f98-874c-3318f577426b",
                                                "text": "Faire la pause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85aaed78-6c74-3316-b0d6-46c3e49d8c8e",
                                        "entry_id": "78960e49-d6b6-3ae2-bb31-d6c3b4c856e5",
                                        "glosses": [
                                            "Silence, intervalle de temps pendant lequel un ou plusieurs musiciens, ou même tous les concertants, demeurent sans chanter, sans jouer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea3fd80-a979-4b5d-a0c2-c51bb25c74f7",
                                                "sense_id": "85aaed78-6c74-3316-b0d6-46c3e49d8c8e",
                                                "text": "Marquer les pauses dans la musique."
                                            },
                                            {
                                                "example_id": "2640cec7-4a90-46b1-ad32-1122a150d826",
                                                "sense_id": "85aaed78-6c74-3316-b0d6-46c3e49d8c8e",
                                                "text": "Compter les pauses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3caa2c4c-a238-3b3b-bd98-a2f9393cf9a9",
                                        "entry_id": "78960e49-d6b6-3ae2-bb31-d6c3b4c856e5",
