    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5014c13a-9787-34d9-8230-44107c78cef3",
                    "sense_definition": "Attraper au moyen d'un piège, ou tromper quelqu'un pour le mettre en difficulté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "capturer_tromper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a posé une question délicate pour tenter de le <w>piéger</w> devant tout le monde."
                        },
                        {
                            "text": "L'automobiliste imprudent s'est fait <w>piéger</w> par le nouveau radar installé au carrefour."
                        }
                    ],
                    "synonyms": [
                        "attraper",
                        "duper"
                    ],
                    "common_phrases": [
                        "se faire piéger"
                    ]
                },
                {
                    "sense_id": "4de96f40-3dd5-3c71-b321-05e7078459d2",
                    "sense_definition": "Munir un objet ou un lieu d'un mécanisme dangereux ou d'un explosif dissimulé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont découvert que l'ennemi avait commencé à <w>piéger</w> les maisons abandonnées."
                        },
                        {
                            "text": "Les malfaiteurs avaient l'intention de <w>piéger</w> le véhicule avant l'arrivée du convoi."
                        }
                    ],
                    "synonyms": [
                        "miner"
                    ],
                    "antonyms": [
                        "dépiéger"
                    ],
                    "common_phrases": [
                        "piéger un bâtiment",
                        "piéger une voiture"
                    ]
                },
                {
                    "sense_id": "047ba211-6891-3a13-bc93-a08abc1352c4",
                    "sense_definition": "Retenir ou immobiliser des particules ou une substance dans un milieu physique spécifique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique_chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau filtre permet de <w>piéger</w> efficacement les gaz polluants émis par l'usine."
                        },
                        {
                            "text": "Les chercheurs utilisent un champ magnétique puissant afin de <w>piéger</w> ces particules instables."
                        }
                    ],
                    "synonyms": [
                        "capturer",
                        "confiner"
                    ],
                    "antonyms": [
                        "libérer"
                    ],
                    "common_phrases": [
                        "piéger des particules",
                        "piéger le carbone"
                    ]
                }
            ]
        }
    ]
