{
    "word_family": [
        "saddler",
        "saddlery",
        "unsaddle",
        "saddlebag",
        "saddlecloth",
        "sidesaddle",
        "packsaddle",
        "saddleback"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dac95e09-a46d-3f11-8fcd-12be03ef6ede",
                    "sense_definition": "The seat of a bicycle, motorcycle, or similar vehicle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "seat_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should adjust the bicycle <w>saddle</w> to fit your height comfortably.",
                            "target_lang_translations": {
                                "ru": "Тебе следует отрегулировать велосипедное <w>седло</w> так, чтобы оно подходило под твой рост.",
                                "zh": "你应该调整自行车<w>鞍座</w>的高度，以确保骑行舒适。"
                            }
                        },
                        {
                            "text": "The <w>saddle</w> on this exercise bike is too hard for a long workout.",
                            "target_lang_translations": {
                                "ru": "<w>Седло</w> этого велотренажера слишком жесткое для длительной тренировки.",
                                "zh": "这台健身车的<w>鞍座</w>太硬了，不适合长时间锻炼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seat"
                    ],
                    "common_phrases": [
                        "bicycle saddle",
                        "adjust the saddle",
                        "bike saddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиденье велосипеда, мотоцикла или подобного транспортного средства.",
                        "zh": "自行车、摩托车或其他类似车辆的座椅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седло",
                                "target_lang_sense_clarification": "велосипедное/мотоциклетное"
                            },
                            {
                                "target_lang_word": "сиденье",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞍座",
                                "target_lang_sense_clarification": "自行车或摩托车的座椅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a35af63-04e3-3ce2-8973-27f94c159d00",
                    "sense_definition": "A leather seat fastened on the back of a horse or other animal for a rider.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "seat_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboy tightened the girth on his <w>saddle</w> before mounting the horse.",
                            "target_lang_translations": {
                                "ru": "Ковбой затянул подпругу на своем <w>седле</w>, прежде чем сесть на лошадь.",
                                "zh": "牛仔在骑马前勒紧了<w>马鞍</w>的肚带。"
                            }
                        },
                        {
                            "text": "She climbed into the <w>saddle</w> and rode across the open field.",
                            "target_lang_translations": {
                                "ru": "Она села в <w>седло</w> и поскакала через открытое поле.",
                                "zh": "她坐上<w>马鞍</w>，骑马穿过了开阔的田野。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the saddle",
                        "side saddle",
                        "western saddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кожаное сиденье, закрепляемое на спине лошади или другого животного для всадника.",
                        "zh": "固定在马或其他动物背上供骑手使用的皮革座椅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седло",
                                "target_lang_sense_clarification": "для верховой езды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马鞍",
                                "target_lang_sense_clarification": "用于骑马的鞍子"
                            },
                            {
                                "target_lang_word": "鞍子",
                                "target_lang_sense_clarification": "通用称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b929e6c9-96f4-3a49-bdda-bb9edfbbe339",
                    "sense_definition": "A low part of a ridge between two higher points or peaks in a landscape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers rested at the <w>saddle</w> between the two steep mountain peaks.",
                            "target_lang_translations": {
                                "ru": "Туристы отдыхали на <w>седловине</w> между двумя крутыми горными вершинами.",
                                "zh": "徒步旅行者在两座陡峭山峰之间的<w>鞍部</w>休息。"
                            }
                        },
                        {
                            "text": "Wind rushed through the <w>saddle</w> as we crossed over to the next valley.",
                            "target_lang_translations": {
                                "ru": "Ветер свистел через <w>седловину</w>, когда мы переходили в следующую долину.",
                                "zh": "当我们翻越<w>鞍部</w>前往下一个山谷时，风呼啸而过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain saddle",
                        "cross the saddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понижение в горном хребте между двумя вершинами.",
                        "zh": "山脊上两个较高点或山峰之间的低洼地带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седловина",
                                "target_lang_sense_clarification": "географический термин"
                            },
                            {
                                "target_lang_word": "седло",
                                "target_lang_sense_clarification": "форма рельефа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞍部",
                                "target_lang_sense_clarification": "地理学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a0f5610-3bf9-33c8-a53d-cb4ca05b4d41",
                    "sense_definition": "A cut of meat, usually mutton, venison, or lamb, consisting of the two loins and the back.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For the main course, the chef prepared a roasted <w>saddle</w> of lamb.",
                            "target_lang_translations": {
                                "ru": "На горячее шеф-повар приготовил жареное <w>седло</w> ягненка.",
                                "zh": "主菜是厨师精心烹制的烤羊<w>鞍肉</w>。"
                            }
                        },
                        {
                            "text": "The butcher prepared a <w>saddle</w> of venison for the holiday feast.",
                            "target_lang_translations": {
                                "ru": "Мясник подготовил <w>седло</w> оленины для праздничного пира.",
                                "zh": "屠夫为节日盛宴准备了一块鹿<w>鞍肉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "saddle of lamb",
                        "saddle of venison"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отруб мяса (обычно баранины, оленины или телятины), состоящий из поясничной части туши.",
                        "zh": "肉类的一种切法，通常指羊肉、鹿肉等，包含脊椎两侧的腰肉和背部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седло",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞍肉",
                                "target_lang_sense_clarification": "烹饪用语，指背部及腰部肉块"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da12c593-3846-31dc-92e2-9b430283c134",
                    "sense_definition": "To put a saddle onto a horse or other animal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "seat_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <saddle> the horse before we can leave for the trail ride.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>оседлать</w> лошадь, прежде чем мы сможем отправиться на верховую прогулку.",
                                "zh": "在出发去骑行前，我得先给马<w>备鞍</w>。"
                            }
                        },
                        {
                            "text": "He <saddled> his pony quickly and went for a morning ride.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>оседлал</w> своего пони и отправился на утреннюю прогулку.",
                                "zh": "他迅速给小马<w>备鞍</w>，然后去晨骑了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unsaddle"
                    ],
                    "common_phrases": [
                        "saddle up",
                        "saddle a horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надевать седло на лошадь или другое животное.",
                        "zh": "给马或其他动物装上鞍子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седлать",
                                "target_lang_sense_clarification": "надевать седло"
                            },
                            {
                                "target_lang_word": "оседлать",
                                "target_lang_sense_clarification": "завершенное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "备鞍",
                                "target_lang_sense_clarification": "准备并装上鞍子"
                            },
                            {
                                "target_lang_word": "上鞍",
                                "target_lang_sense_clarification": "安装鞍子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091a56c0-0609-37c2-ac0f-bb5859b22954",
                    "sense_definition": "To burden or impose a difficult task, debt, or responsibility on someone.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "figurative_burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <saddled> with all the extra work after her colleague resigned.",
                            "target_lang_translations": {
                                "ru": "На нее <w>взвалили</w> всю дополнительную работу после увольнения коллеги.",
                                "zh": "同事辞职后，所有的额外工作都被<w>强加</w>给了她。"
                            }
                        },
                        {
                            "text": "The young graduates were <saddled> with enormous loans that took years to repay.",
                            "target_lang_translations": {
                                "ru": "Молодые выпускники были <w>обременены</w> огромными кредитами, на выплату которых ушли годы.",
                                "zh": "年轻的毕业生们<w>背负</w>着巨额贷款，花了多年才还清。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "saddled with debt",
                        "saddled with responsibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обременять кого-либо трудной задачей, долгами или ответственностью.",
                        "zh": "使某人承担困难的任务、债务或责任。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обременять",
                                "target_lang_sense_clarification": "нагружать ответственностью"
                            },
                            {
                                "target_lang_word": "взваливать",
                                "target_lang_sense_clarification": "перекладывать груз/задачи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强加",
                                "target_lang_sense_clarification": "指强加负担或责任"
                            },
                            {
                                "target_lang_word": "背负",
                                "target_lang_sense_clarification": "指背负债务或沉重责任"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}