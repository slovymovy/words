                "senses": [
                    {
                        "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                        "entry_id": "948c0df4-1708-3f2a-82ed-5864def7cc02",
                        "glosses": [
                            "öffentliche Diskussion über das Thema Öffnungsschritte; Abwägen des Für/Pro und Wider/Contra von zugelassenen Kontakten zwischen Menschen/Parteien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d681b9-30a0-4d0c-a331-ab830fda29bb",
                                "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                                "text": "„Der Tourismus muss Teil der Öffnungsdebatte sein. Die Bundesregierung ignoriert ganz offensichtlich vorliegende Fakten mit Blick auf die geringe Infektionsgefahr im Tourismus.“"
                            },
                            {
                                "example_id": "a7fdabff-3130-4261-a886-115a5a6128c2",
                                "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                                "text": "„Nein, niemand macht sich hier über die Geschlagenen lustig, die in ihrem Beruf weder ein noch aus wissen. Nicht zuletzt ihnen, aber auch all den Müden und Ausgelaugten war die Öffnungsdebatte der vergangenen Wochen zu verdanken.“"
                            },
                            {
                                "example_id": "21d984b2-e0f8-4f26-a49f-0a67c6692e31",
                                "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                                "text": "„Jetzt gehen sie los: die Öffnungsdebatten. Dabei ist es noch zu früh, um valide Aussagen über das Infektionsgeschehen zu treffen und daraus abzuleitende Forderungen zu stellen.“"
                            },
                            {
                                "example_id": "4da8614e-36c8-4b0a-a13d-3d3f5e738e6a",
                                "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                                "text": "„Zur anhaltenden Öffnungsdebatte teilt der Vorsitzende der AfD-Fraktion in Deutschen Bundestag, Alexander Gauland, mit: […].“"
                            },
                            {
                                "example_id": "ea5323c5-860e-487e-b85a-c12fe54c0199",
                                "sense_id": "09b911fc-cba5-32ad-bc9d-6024945624f2",
                                "text": "„Was Laschets Attacke für die Öffnungsdebatte bedeutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
