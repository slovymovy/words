                                        "entry_id": "7bfa314d-0055-3261-be37-624bc5ad8c31",
                                        "glosses": [
                                            "język gestów (tzw. znaków migowych), za pomocą którego rozmawiają głusi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e05cff6-5b08-4911-9a0f-a9a5627c8e1a",
                                                "sense_id": "533484f6-9cc5-3c71-a3fd-dfd2ecb3ce0c",
                                                "text": "Istnieje wiele języków migowych, np. brytyjski, amerykański, polski…"
                                            },
                                            {
                                                "example_id": "0bd6976a-8a84-405f-b233-ba6c35d83dad",
                                                "sense_id": "533484f6-9cc5-3c71-a3fd-dfd2ecb3ce0c",
                                                "text": "Większość publikacji i kursów „Polskiego Języka Migowego” uczy tak naprawdę języka miganego (Systemu Językowo-Migowego)."
                                            },
                                            {
                                                "example_id": "573a6075-a3cd-47a6-b9e8-7fffac2fee1f",
                                                "sense_id": "533484f6-9cc5-3c71-a3fd-dfd2ecb3ce0c",
                                                "text": "Polski Język Migowy ma gramatykę odmienną od mówionego polskiego, ma klasyfikatory, czasowniki kierunkowe, za to nie ma przyimków."
                                            }
