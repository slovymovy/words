                "senses": [
                    {
                        "sense_id": "6f92f859-6f5a-32c9-9f23-96c89509a774",
                        "entry_id": "cee8059f-ecd0-3f70-b8a2-fc9570750f07",
                        "glosses": [
                            "die Beschwörung von Toten oder deren Geistern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11eb3c5c-045c-472d-af5b-13f2b9cec642",
                                "sense_id": "6f92f859-6f5a-32c9-9f23-96c89509a774",
                                "text": "„Eine Totenbeschwörung, wie sie bei Ritualen des Gläserrückens, Pendelns, Kartenlegens und der Deutung von Klopfzeichen durchgeführt, wird oft von Menschen in Anspruch genommen, die in tiefer Trauer um einen nahen Menschen gefangen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff201182-a450-4385-8317-183806c3d97f",
                        "source_entry_id": "cee8059f-ecd0-3f70-b8a2-fc9570750f07",
                        "source_sense_id": "6f92f859-6f5a-32c9-9f23-96c89509a774",
                        "source_sense_description": "die Beschwörung von Toten oder deren Geistern",
                        "target_lang_word": "necromancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necromancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aaaa726-3167-3ca7-9bde-78cf6661e367",
                                        "entry_id": "bdb99d8e-e301-3b89-a9b3-f9db65917e9d",
                                        "glosses": [
                                            "Divination involving the dead or death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b66747-8edd-44ce-802f-ae26ab1acffa",
                                                "sense_id": "6aaaa726-3167-3ca7-9bde-78cf6661e367",
                                                "text": "And for to make this treatise the more pleasaunt and facill, I have put it in forme of a Dialogue, which I have diuided into three bookes: The first speaking of Magie in general, and Necromancie in special."
                                            },
                                            {
                                                "example_id": "3e0ef194-ca55-4033-982c-9d102b4a49aa",
                                                "sense_id": "6aaaa726-3167-3ca7-9bde-78cf6661e367",
                                                "text": "And in one word for all, Nagomancy, or Necromancy; by inspecting, consulting, and divining by, with, or from the dead."
                                            },
                                            {
                                                "example_id": "ebabee65-61e2-4118-9e87-f7e22e7a9d82",
                                                "sense_id": "6aaaa726-3167-3ca7-9bde-78cf6661e367",
                                                "text": "1867 E. Rogers, quoted in K. Thomas Relig. & Decline of Magic\nthe Devil did often tempt me to study necromancy and nigromancy and to make use of magic, and to make a league with him..."
                                            },
                                            {
                                                "example_id": "34d11142-da06-41e8-819a-0309de950555",
                                                "sense_id": "6aaaa726-3167-3ca7-9bde-78cf6661e367",
                                                "text": "There is no doubt..that necromancy is the touch-stone of occultism..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4490142-62db-3257-9dfc-01e6c87fe567",
                                        "entry_id": "bdb99d8e-e301-3b89-a9b3-f9db65917e9d",
                                        "glosses": [
                                            "Loosely, any sorcery or witchcraft, especially involving death or the dead, particularly sorcery involving raising or reanimating the dead."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8448683c-33e4-301b-8f85-704e7311d909",
                                        "entry_id": "bdb99d8e-e301-3b89-a9b3-f9db65917e9d",
                                        "glosses": [
                                            "Synonym of necroposting."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a179ee-6709-4509-8c97-c450cc73923e",
                        "source_entry_id": "cee8059f-ecd0-3f70-b8a2-fc9570750f07",
                        "source_sense_id": "6f92f859-6f5a-32c9-9f23-96c89509a774",
                        "source_sense_description": "die Beschwörung von Toten oder deren Geistern",
                        "target_lang_word": "nécromancie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nécromancie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                        "entry_id": "85111fa4-666d-392d-8315-4f5ac7528747",
                                        "glosses": [
                                            "Évocation des morts par la magie, pour avoir connaissance de l’avenir, ou de quelque autre chose de caché."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61778007-3e32-40da-8f40-5680df299925",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "La nécromancie a été très anciennement pratiquée par les peuples de l’Orient."
                                            },
                                            {
                                                "example_id": "eeca5723-c5a6-4570-82c4-4bf1cdb21d2c",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Il [l’Inquisiteur-général Manrique de Lara] dépêcha en Biscaye l’inquisiteur de Calahorra pour qu’il y conduise une enquête minutieuse et établisse la liste des pratiques magiques et des superstitions suspectes : esprits familiers et actes sacrilèges, astrologie judiciaire, géomancie, hydromancie, pyromancie, aéromancie et nécromancie sans oublier la divination par les ongles, l’on[ych]omancie."
                                            },
                                            {
                                                "example_id": "396f0fc1-88d9-4772-bdee-b5f96bd7a9af",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Partisan de la nécromancie, John Dee organisait en effet des séances au cours desquelles il interrogeait les spectres pour qu'ils lui révèlent des choses cachées."
                                            },
                                            {
                                                "example_id": "1edbee72-3476-42cd-9a2b-450c8bcbea46",
                                                "sense_id": "3a792774-2a52-32cb-a17a-e9d07d9e6d9b",
                                                "text": "Le judaïsme et le christianisme sont deux religions particulièrement hostiles à la pratique de la nécromancie …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d9fe1e-f89c-320b-8954-89d642338a6b",
                                        "entry_id": "85111fa4-666d-392d-8315-4f5ac7528747",
                                        "glosses": [
                                            "Magie en général."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ac3ad0-e3ed-46ba-aacd-27b2e5cd1cb0",
                                                "sense_id": "45d9fe1e-f89c-320b-8954-89d642338a6b",
                                                "text": "Cette accusation de nécromancie est trop souvent mise en usage pour ne pas couvrir de mauvais desseins contre notre race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
