                        "entry_id": "3701c0fd-79ef-3344-9257-6d60fff8faf7",
                        "glosses": [
                            "Any of several white, often dark-backed birds of the family Laridae having long, pointed wings and short legs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0635903b-8130-41d0-a705-c4ca9083e581",
                                "sense_id": "e859de90-3e9d-3d26-9123-22f14469779b",
                                "text": "And while there are plenty of benches, there's little shelter from the wind (or predatory seagulls the size of dogs) out on the platforms."
                            }
                        ]
                    },
                    {
                        "sense_id": "44c14f48-1a91-3a5e-b4af-6b9865ef4cd8",
