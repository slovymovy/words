                                "example_id": "312fb2c3-67eb-4fb0-aca6-fd18a5206e3b",
                                "sense_id": "81614456-b0ac-3069-a440-da5b355724d4",
                                "text": "Après la destruction de Dubrovnik par un tremblement de terre en 1667, le centre culturel du monde croate se déplace vers Zagreb, de dialecte kaïkavien."
                            },
                            {
                                "example_id": "64112e7a-e261-4235-9e34-8432e08afa07",
                                "sense_id": "81614456-b0ac-3069-a440-da5b355724d4",
                                "text": "La chanson a été enregistrée en 1958, et elle utilise le dialecte kaïkavien, qui est parlé dans le nord du pays, dans la région de Zagreb."
                            }
                        ]
                    }
