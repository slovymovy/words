                ],
                "senses": [
                    {
                        "sense_id": "4237c14e-4742-3e5f-870b-94ca2612d69a",
                        "entry_id": "feadd137-c324-3026-8bb5-bc8d60c22353",
                        "glosses": [
                            "Ensemble de la carcasse en plomb d’un vitrail"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c23f611-403b-4ee9-b276-bed058c2d58c",
                                "sense_id": "4237c14e-4742-3e5f-870b-94ca2612d69a",
                                "text": "Dans le faisceau de soleil qui décalque sur le pavement un vitrail, ses personnages, ses couleurs et sa plombure, Denis croit apercevoir l’abbé Chevalet qui lit son bréviaire."
                            },
                            {
                                "example_id": "4db5e8c8-aea3-4148-9567-a4bc25aae14c",
                                "sense_id": "4237c14e-4742-3e5f-870b-94ca2612d69a",
                                "text": "En effet, si le rôle premier du peintre-verrier est le travail du verre et la peinture sur verre, il lui arrive aussi de jointoyer les baies, de préparer la plombure avant sertissage ou d’aider à créer l’armature métallique qui maintiendra le vitrail dans la baie."
                            }
                        ]
                    },
                    {
                        "sense_id": "223cf290-617a-3bb1-8951-b261587d2014",
                        "entry_id": "feadd137-c324-3026-8bb5-bc8d60c22353",
                        "glosses": [
                            "Vernis plombifère"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26dce89d-0547-4e5e-ad00-5715d2a1afd5",
                                "sense_id": "223cf290-617a-3bb1-8951-b261587d2014",
                                "text": "On a trouvé dans les fouilles , à la vérité sur un point restreint , des restes de carrelages , j’en ai retiré un carreau qui porte à l’une de ses tranches une plombure émaillée très-bien conservée."
                            },
                            {
                                "example_id": "eee2450d-95c3-4432-a894-90f1bfef8acf",
                                "sense_id": "223cf290-617a-3bb1-8951-b261587d2014",
                                "text": "Le vase qui avait servi à la préparation du purgatif contient du bi-oxalale de potasse et de l’oxalate de plomb; celui-ci est le résultat de l’action du bioxalate sur la plombure du vase."
                            },
                            {
                                "example_id": "60e54f43-dac8-4926-84cf-f0b456ee6a65",
                                "sense_id": "223cf290-617a-3bb1-8951-b261587d2014",
                                "text": "Les produits de ces usines sont de grosses poteries jaunes, vernissées à l’intérieur à l’aide d’une plombure faite de laitier pulvérisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "acc6ad9a-e1a6-3288-a7ea-fb524d47f3e0",
                        "entry_id": "feadd137-c324-3026-8bb5-bc8d60c22353",
                        "glosses": [
                            "Sorte de poterie vernissée avec un produit à base de plomb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f65abb1f-70d5-4bb6-a5fa-540ad3ff8ffb",
                                "sense_id": "acc6ad9a-e1a6-3288-a7ea-fb524d47f3e0",
                                "text": "Ainsi, les fabricans de poterie connue sous le nom de plombure, ne peuvent prétendre être assujétis seulement a la patente de plombiers."
                            },
                            {
                                "example_id": "06a65ff9-c9db-45e0-8fe1-22e3dd90b667",
                                "sense_id": "acc6ad9a-e1a6-3288-a7ea-fb524d47f3e0",
                                "text": "Quant aux fabriques de poterie vernissée dite plombure ou plommure, elles étaient au nombre de deux seulement, dirigées par MM. Laffineur-Fie et Berlin (Simon)."
                            }
                        ]
                    }
                ],
