                        "cross_references": [
                            {
                                "target_word": "sprachlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be74f8b3-2b0b-3ae3-9f38-a59138e723c1",
                                        "entry_id": "6540a75b-3bf4-3cc5-a90f-d8571d108ff9",
                                        "glosses": [
                                            "jemandem fehlen die Worte, einen Sachverhalt oder ein Ereignis zu kommentieren oder sich dazu zu stellen, meist aus Überraschung"
                                        ],
                                        "tags": [
                                            "sprachlos sein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc772d8f-5600-4eb2-9eb0-c1c1be164095",
                                                "sense_id": "be74f8b3-2b0b-3ae3-9f38-a59138e723c1",
                                                "text": "„Der Kommerzienrat blieb wirklich im ersten Augenblick sprachlos vor Schreck, denn der Gedanke, trotz aller erlittenen Unbill, war ihm noch zu neu, sich mitten in der Welt, wie er ging und stand und allein auf sich selber angewiesen zu wissen.“"
                                            },
                                            {
                                                "example_id": "0111f755-a781-40b4-bd64-ec34ec289a86",
                                                "sense_id": "be74f8b3-2b0b-3ae3-9f38-a59138e723c1",
                                                "text": "„Auch die Inuit sind sprachlos, wenn sie zum ersten Mal einen Wal sehen.“"
                                            },
                                            {
                                                "example_id": "c8e73a88-d07d-4e48-947e-4f17e3645fb9",
                                                "sense_id": "be74f8b3-2b0b-3ae3-9f38-a59138e723c1",
                                                "text": "„Heidrun wiederum war sprachlos, dass sich die jungen Leute hier offensichtlich um gar nichts sorgten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee8c1433-7d2d-36cf-ade0-cbc156ae5d25",
                                        "entry_id": "6540a75b-3bf4-3cc5-a90f-d8571d108ff9",
                                        "glosses": [
                                            "ohne gesprochene Worte; stumm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c72009-efdc-41b1-9f19-95f0e040a355",
                                                "sense_id": "ee8c1433-7d2d-36cf-ade0-cbc156ae5d25",
                                                "text": "Sprachlos leiten die Schutzpolizisten den Verkehr."
                                            },
                                            {
                                                "example_id": "01d8cfe1-6656-4fdf-8cf4-154f5b24e9c9",
                                                "sense_id": "ee8c1433-7d2d-36cf-ade0-cbc156ae5d25",
                                                "text": "Sprachlos nahm der Sklave seine Bestrafung hin."
                                            },
                                            {
                                                "example_id": "df1e48a1-52b6-4aa2-a7e6-13fd3f57ecca",
                                                "sense_id": "ee8c1433-7d2d-36cf-ade0-cbc156ae5d25",
                                                "text": "„Dann richtete er den Blick geduldig auf den sprachlosen Sprecher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
