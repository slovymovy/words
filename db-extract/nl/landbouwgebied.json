                        "entry_id": "199dee56-ccb0-3025-a5fa-bc23b8d1f40e",
                        "glosses": [
                            "alles wat met de landbouw te maken heeft"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8e84ceb3-7ca2-4c8d-b961-55816b81abd1",
                                "sense_id": "8248e8a9-3755-3c34-86a0-ba8677ba6dfb",
                                "text": "Ruim 200.000 Nederlanders hebben mede vanwege de handel naar Groot-Brittannië werk. Op landbouwgebied gaat het zelfs om 1 op de 10 banen."
                            }
                        ]
