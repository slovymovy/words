                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb3c249-1d73-470f-b281-9731832d733f",
                        "source_entry_id": "057f846e-6752-3579-9d8d-e2678bbbc73b",
                        "source_sense_id": "50d7dab6-79c9-3b82-93c1-66f75346828e",
                        "target_lang_word": "processional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "processional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                        "entry_id": "80db116c-38ca-35dc-aa9b-1382eefc4adb",
                                        "glosses": [
                                            "Of, pertaining to, or used during a procession, particularly at the start of a religious ceremony or wedding."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b0c996b-cbb7-48d4-b95d-39e4ff1fbea1",
                                                "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                                "text": "The publick Processional-way to the Chapter-house at Windesor, used time out of mind, led from the Presence-Chamber, down through the Cloister, and the great Gate of the Kings Lodging, into the upper Ward of the Castle, thence through the middle Ward, and part of the lower, to and through the passage, between the East-end of the Chappel, and Tomb-house, and thence into the Chapter-house, situate at the North-East Corner of St. George’s Chappel."
                                            },
                                            {
                                                "example_id": "ee6dd2d7-9b7b-42ac-a33a-a84bbca5a9cc",
                                                "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                                "text": "1799, Isaac D’Israeli, Mejnoun and Leila, the Arabian Petrarch and Laura, Book 4, in Romances, London: Cadell and Davies et al., pp. 170-171,\nThe nuptial day arrives. The virgin, preceded by a splendid retinue, and followed by her mother, her female relatives, and the damsels of her tribe, issues from the tent of her father. […] The women then followed with solemn and processional steps."
                                            },
                                            {
                                                "example_id": "0d768ce5-d3cc-4a8f-b79a-9cf95d07104a",
                                                "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                                "text": "The mediæval hierarchical services did not rise to their full majesty and impressiveness till celebrated under a Gothic cathedral. […] The enormous height more than compensated for the contracted breadth. Nothing could be more finely arranged for the processional services; and the processional services became more frequent, more imposing."
                                            },
                                            {
                                                "example_id": "cc9c16bb-a2a9-4a44-bc46-324997a56304",
                                                "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                                "text": "The oxen took up again their quiet processional gait and the old man walked ahead of them, his eyes on the ground."
                                            },
                                            {
                                                "example_id": "13da8a8f-1b04-459e-9e27-57734b7d5e0d",
                                                "sense_id": "e2cb520a-72ec-3031-a729-4c91115351ef",
                                                "text": "All the urchins of the marketplace formed a processional tail behind him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "processional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf1f0f3-df61-3bc6-93bf-83f432679a6f",
                                        "entry_id": "c645d194-36d7-3764-b17e-b9923947b8a8",
                                        "glosses": [
                                            "A hymn or other music used during a procession; prosodion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292dd032-bbb8-43a9-b126-04c06837928d",
                                                "sense_id": "2bf1f0f3-df61-3bc6-93bf-83f432679a6f",
                                                "text": "A perfectly drilled wedding procession, like a military one, should move forward in perfect step, rising and falling in a block or unit. To secure perfection of detail, the bars of the processional may be counted so that the music comes to an end at precisely the moment the bride and groom stand side by side at the chancel steps."
                                            },
                                            {
                                                "example_id": "c08949b6-c209-4690-ab04-311bf83c9786",
                                                "sense_id": "2bf1f0f3-df61-3bc6-93bf-83f432679a6f",
                                                "text": "[…] a rainy Palm Sunday. […] At Grace Church on-the-Hill, the children and the acolytes stood huddled in the narthex; holding their palm fronds, they resembled tourists who’d landed in the tropics on an unseasonably cold day. The organist chose Brahms for the processional—“O Welt ich muss dich lassen”; “O world I must leave you.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f11a1975-6774-3d17-84c9-cc3bf1bf28a7",
                                        "entry_id": "c645d194-36d7-3764-b17e-b9923947b8a8",
                                        "glosses": [
                                            "A group of people or things moving along in an orderly, stately, or solemn manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7afb5d-dee0-484e-b063-310f077ed400",
                                                "sense_id": "f11a1975-6774-3d17-84c9-cc3bf1bf28a7",
                                                "text": "He saw the processional of world brotherhood tramp steadily through the paling sunset; saffron-vestured Mandarin marching by flax-faced Norseman and languid South Sea Islander—the diverse peoples toward whom he had always yearned."
                                            },
                                            {
                                                "example_id": "663fe063-d451-48fc-b614-4f6e1094e936",
                                                "sense_id": "f11a1975-6774-3d17-84c9-cc3bf1bf28a7",
                                                "text": "And Eugene watched the slow fusion of the seasons; he saw the royal processional of the months; he saw the summer light eat like a river into dark; he saw dark triumph once again; and he saw the minute-winning days, like flies, buzz home to death."
                                            },
                                            {
                                                "example_id": "39545016-35e9-4902-b339-413bac537c97",
                                                "sense_id": "f11a1975-6774-3d17-84c9-cc3bf1bf28a7",
                                                "text": "At the Wusdatts’ once, the two had marched in the processional to the buffet table with their small fingers linked […]"
                                            },
                                            {
                                                "example_id": "165b5eca-941c-4544-8e99-e031c4f18cc5",
                                                "sense_id": "f11a1975-6774-3d17-84c9-cc3bf1bf28a7",
                                                "text": "[…] they heard the voices of living men shouting, finally. And the lowing of cattle. And the creaking of wheels. But they saw nothing. The symphonious clamor was everywhere, filling the sky […], it was the great processional of the Union armies, but of no more substance than an army of ghosts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1af06ec-d695-3680-b0f7-a9fcb8f33937",
                                        "entry_id": "c645d194-36d7-3764-b17e-b9923947b8a8",
                                        "glosses": [
                                            "A service book relating to ecclesiastical processions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b408ba57-ab91-4389-9a38-b15b15fd4b21",
                                                "sense_id": "d1af06ec-d695-3680-b0f7-a9fcb8f33937",
                                                "text": "[47] Item that the Churchwardens of euery paryshe shall delyuer vnto our visitours the inuentories of vestmentes, copes, and other ornamentes, plate, bookes, and specyallye of Grayles, Couchers, Legendes, Processionalles, Hymnalles, Manuelles, Portuesses, and suche lyke apperteynyng to theyr Church."
                                            },
                                            {
                                                "example_id": "d4b2603d-6f1a-4e61-92ae-733da0d6bece",
                                                "sense_id": "d1af06ec-d695-3680-b0f7-a9fcb8f33937",
                                                "text": "c. 1640s, John Gregory, “Episcopus Puerorum In Die Innocentium: Or, A Discovery of an Ancient Custom in the Church of Sarum, making an Anniversary Bishop among the Choristers” in The Works of the Reverend and Learned Mr. John Gregory, London: R. Royston and T. Williams, 1671, p. 114,\nBy the Use of Sarum (for ’tis almost the only place where I can hear any thing of this; that of York in their Processional seems to take no notice of it) upon the Eve to Innocents Day the Chorister-Bishop was to go in solemn Procession with his fellows […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
