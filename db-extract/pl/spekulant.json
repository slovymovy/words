                        "sense_id": "c4a55c26-ff23-3a8c-9102-3f8f34c3e753",
                        "entry_id": "539e56ca-e6fd-3e94-a127-ee8750f718da",
                        "glosses": [
                            "człowiek kupujący coś po niskiej cenie z zamiarem sprzedaży po wyższej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72be7e95-f815-47ba-85ff-96a066bfc899",
                                "sense_id": "c4a55c26-ff23-3a8c-9102-3f8f34c3e753",
                                "text": "— Cóż to — zaperzył się — moich krewnych uważasz pani za spekulantów?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "574d1cd4-4548-4169-84e0-0b5f66024997",
                        "source_entry_id": "539e56ca-e6fd-3e94-a127-ee8750f718da",
                        "source_sense_id": "c4a55c26-ff23-3a8c-9102-3f8f34c3e753",
                        "target_lang_word": "spekulant",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e0615bd1-4633-403b-b209-444d4388a4d1",
                        "source_entry_id": "539e56ca-e6fd-3e94-a127-ee8750f718da",
                        "source_sense_id": "c4a55c26-ff23-3a8c-9102-3f8f34c3e753",
                        "target_lang_word": "spéculateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spéculateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3af9b2b-928e-38ea-9fbb-0786fc4e16c4",
                                        "entry_id": "adec2957-647b-3e6e-af95-901fbea0dca0",
                                        "glosses": [
                                            "Qui spécule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spéculateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                        "entry_id": "de339499-90bd-3f2b-9298-91c1417f7729",
                                        "glosses": [
                                            "Celui qui fait des spéculations de finance, de commerce, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db2639-1aec-425f-8f08-1008ec1d47e0",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "La subsistance publique circule-t-elle, lorsque des spéculateurs avides la retiennent entassée dans leurs greniers?"
                                            },
                                            {
                                                "example_id": "83ab62f1-1b44-4da4-a5a7-5ad3504e2549",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "Et d’entendre tous ces beaux projets au milieu de cette foule, dans ce quartier de spéculateurs où l’on sent comme la hâte et la fièvre des jeux de hasard, cela me donnait le frisson d’une histoire de naufrage racontée en pleine mer."
                                            },
                                            {
                                                "example_id": "89a9ee27-890b-4202-967b-0fb78b0cb5fd",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "Charles de Bernage, spéculateur enrichi et futur candidat à la députation, n'avait jamais eu le temps de s'apercevoir qu'il lui manquait quelque chose."
                                            },
                                            {
                                                "example_id": "bb708ad3-0c1f-4266-a2c0-46106c31481c",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "Mais ces belles futaies représentent une valeur commerciale qui a mis en appétit la convoitise du spéculateur, déjà riche de capital, plus riche encore en audace et en influence."
                                            },
                                            {
                                                "example_id": "8c548164-f276-482a-9d75-6e841c4bd201",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "Des intermédiaires parasites, des commerçants occasionnels, des spéculateurs sans vergogne, étrangers à toute production et à tout travail, ne s’emmillionnent-ils pas chaque jour sous nos yeux […] ?"
                                            },
                                            {
                                                "example_id": "2a2ef376-e66b-41dc-a953-2f5177cec3ad",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "Au nom de ceux qui sont révoltés comme moi par une barbarie inconnue de nos pères, je tiens à exprimer ici un mépris public aux spéculateurs vandales qui bientôt, quand ils se seront enrichis aux dépens de ce qui eût fait la joie de nos neveux, viendront les éclabousser de leur luxe imbécile de primaires."
                                            },
                                            {
                                                "example_id": "02bf7bdd-fce1-4012-ab4c-cbb303d1a0f4",
                                                "sense_id": "ea6294e3-b6a9-3c68-b15a-8f26b6017abc",
                                                "text": "\"Que le bitcoin vaille 1 dollar ou 1 million de dollars n’a donc d’importance que pour les spéculateurs qui en détiennent, qui voient leur patrimoine augmenter ou fondre en fonction des fluctuations du cours\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
