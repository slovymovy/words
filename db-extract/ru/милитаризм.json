                                        "glosses": [
                                            "agresywna polityka zewnętrzna polegająca na celowym wywoływaniu konfliktów zbrojnych lub dążeniu do rozstrzygania konfliktów metodami siłowymi"
                                        ],
                                        "tags": [],
