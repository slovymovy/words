                "senses": [
                    {
                        "sense_id": "f39a8a05-4941-38d3-8fca-b8c6e25bfde5",
                        "entry_id": "4026415a-7791-3415-a580-e290dc06393e",
                        "glosses": [
                            "Se menacer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45bc6a8-ea9d-4b0e-894b-fffbe8bf9a4c",
                                "sense_id": "f39a8a05-4941-38d3-8fca-b8c6e25bfde5",
                                "text": "Je m'auto-bannirai un mois ! ça fait plus mal que m'automenacer d'une interdiction définitive pas crédible, et bien plus dur, car si jamais ça se produit, on va pas me louper (enfin, on.. JE!)"
                            },
                            {
                                "example_id": "4652e121-c3d2-4f01-beb2-97dadb8e778e",
                                "sense_id": "f39a8a05-4941-38d3-8fca-b8c6e25bfde5",
                                "text": "bref bref... mais son topic m'avait fait tilter sur le fait que, si quelqu'un s'automenace de mort, apparemment, on peut aussi bien en avertir la police que s'il s'agit de menace de mort d'une personne à l'autre (j'avoue que je l'ignorais)."
                            }
                        ]
                    }
