                                "target_senses": [
                                    {
                                        "sense_id": "37a794f9-454f-3d0b-9771-93e272f32182",
                                        "entry_id": "672bf5af-c9fa-342c-82f0-3ec9b005c263",
                                        "glosses": [
                                            "Qui constitue la base, les fondements de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7697b91-e1ee-4e82-98c9-689c1eb58a6f",
                                                "sense_id": "37a794f9-454f-3d0b-9771-93e272f32182",
                                                "text": "L’historiographie française du communisme semble désormais négliger la période fondatrice de l’histoire du Parti communiste français que furent les années 1917-1925."
                                            },
                                            {
                                                "example_id": "ab088cdb-f541-4296-93ec-fcd2ef59f236",
                                                "sense_id": "37a794f9-454f-3d0b-9771-93e272f32182",
                                                "text": "A l’avenir, le Conseil de l’Europe pourrait avoir pour mission prioritaire de poser des lignes directives pour réactiver le « pacte laïque », c’est-à-dire pour que la laïcité soit affirmée comme valeur fondatrice des démocraties."
                                            },
                                            {
                                                "example_id": "1c9e28cc-3170-4fd7-96a7-64d9d91d1d97",
                                                "sense_id": "37a794f9-454f-3d0b-9771-93e272f32182",
                                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l'objet, sous Louis XIV, d'un « mémoricide » sans précédent : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f226bd5-9676-3aa4-add5-167798bbd0f4",
                                        "entry_id": "672bf5af-c9fa-342c-82f0-3ec9b005c263",
                                        "glosses": [
                                            "Qui a participé à la création, à la fondation de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cadbbcb-d883-4b1f-81cd-fbacf6be3db8",
                                                "sense_id": "6f226bd5-9676-3aa4-add5-167798bbd0f4",
                                                "text": "— Je suis un niais ! a dit plus d’un pauvre propriétaire attiré par la perspective d’être fondateur de quelque chose, et qui, en définitive, se trouve avoir fondu mille ou douze cents francs."
                                            },
                                            {
                                                "example_id": "5ba75e9f-8fde-4ccc-8624-83d9fa3f30c3",
                                                "sense_id": "6f226bd5-9676-3aa4-add5-167798bbd0f4",
                                                "text": "Le chef est en principe assis à droite de la porte, le père de l’association, les membres fondateurs et les autres sociétaires s’asseyent à sa droite selon leur ordre d’importance."
                                            },
                                            {
                                                "example_id": "db8561ad-b619-450b-8146-d0683b6d86ae",
                                                "sense_id": "6f226bd5-9676-3aa4-add5-167798bbd0f4",
                                                "text": "Le Jebtsundamba Khutuktu est le chef spirituel de l’église bouddhiste en Mongolie. Il serait la réincarnation du lama Zanabazar, lama fondateur de la ville d’Oulan-Bator […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
