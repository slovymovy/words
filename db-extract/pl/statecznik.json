                                        "entry_id": "c04e5af2-ba87-3a52-8ef2-b98d86a2da67",
                                        "glosses": [
                                            "Plan fixe qui assure la stabilité en tangage et en trajectoire (ou stabilité en lacet) d’un aérodyne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ad6096-1d1b-496b-b3bb-000247d9a38d",
                                                "sense_id": "f2e791ca-a3d7-3455-8bd9-2ebea8d5c842",
                                                "text": "Tout semblablement, nous pouvons nous rendre compte de l’influence de l’inclinaison de l’empennage horizontal d’avant sur la valeur du couple aérodynamique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63541c0c-0bfb-346c-b688-e8b3eb282250",
                                        "entry_id": "c04e5af2-ba87-3a52-8ef2-b98d86a2da67",
                                        "glosses": [
                                            "Ensemble de plusieurs plans fixes qui assurent une rotation stable à une flèche, obus ou autre projectile, afin de stabiliser sa trajectoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f088cfce-671d-4af9-a02d-f7201e18f3ac",
                                                "sense_id": "63541c0c-0bfb-346c-b688-e8b3eb282250",
                                                "text": "L’empennage d’une flèche est composé la plupart du temps de 3 plumes."
                                            }
                                        ]
                                    }
                                ]
                            }
