                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5985f2b2-d696-4393-81a5-4cc1985c795b",
                                "sense_id": "151b1586-97fa-3a66-8466-cb31796619e5",
                                "text": "He was by nature highly passionate, but more apt to reluct at the excesses of it."
                            },
                            {
                                "example_id": "e13e4f2a-10ad-4f03-9379-be48cf9fcb6d",
                                "sense_id": "151b1586-97fa-3a66-8466-cb31796619e5",
                                "text": "I care not to be carried with the tide, that smoothly bears human life to eternity; and reluct at the inevitable course of destiny."
                            },
                            {
                                "example_id": "8c7cc983-2103-4c99-ae38-f7103c330c19",
                                "sense_id": "151b1586-97fa-3a66-8466-cb31796619e5",
                                "text": "[M]iracles, if you accept them, will not help it very much; or if you reluct at them, and ignore them, your faith remains unshaken and entire."
                            }
                        ]
                    }
