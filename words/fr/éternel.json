    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af0ff780-7e06-336c-8d8c-40a7e5f38241",
                    "sense_definition": "Qui n'aura jamais de fin dans le temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "durée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de croyants espèrent obtenir la vie <w>éternelle</w> après leur passage sur terre."
                        },
                        {
                            "text": "Les plus hauts sommets de cette chaîne restent couverts de neiges <w>éternelles</w>."
                        }
                    ],
                    "synonyms": [
                        "sans fin",
                        "infini"
                    ],
                    "antonyms": [
                        "fini",
                        "limité"
                    ],
                    "common_phrases": [
                        "vie éternelle",
                        "neiges éternelles",
                        "repos éternel"
                    ]
                },
                {
                    "sense_id": "01744a3b-4a0d-34cc-9ac1-59de8b354e09",
                    "sense_definition": "Qui dure extrêmement longtemps ou dont la fin semble impossible à atteindre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "durée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous garderai une reconnaissance <w>éternelle</w> pour le soutien que vous m'avez apporté."
                        },
                        {
                            "text": "Cette pluie <w>éternelle</w> qui tombe sur la région commence sérieusement à peser sur le moral."
                        }
                    ],
                    "synonyms": [
                        "interminable"
                    ],
                    "antonyms": [
                        "limité",
                        "circonscrit"
                    ],
                    "common_phrases": [
                        "reconnaissance éternelle",
                        "ville éternelle"
                    ]
                },
                {
                    "sense_id": "b8179c70-55d1-3819-9943-32e941268368",
                    "sense_definition": "Qui se répète continuellement, de manière lassante ou fastidieuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "répétition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses <w>éternelles</w> plaintes finissent par agacer tous les membres de son équipe."
                        },
                        {
                            "text": "Ce garçon se conduit comme un <w>éternel</w> insatisfait que rien ne parvient à réjouir."
                        }
                    ],
                    "synonyms": [
                        "interminable",
                        "intarissable"
                    ],
                    "common_phrases": [
                        "éternel insatisfait",
                        "éternel recommencement"
                    ]
                },
                {
                    "sense_id": "55f069eb-3bdd-364a-b24e-55af5ab2fab1",
                    "sense_definition": "Qui n'a ni commencement ni fin et existe en dehors du temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "durée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce penseur considérait la géométrie comme l'expression même d'une vérité <w>éternelle</w>."
                        },
                        {
                            "text": "L'auteur décrit l'esprit comme un principe <w>éternel</w> que rien ne saurait détruire."
                        }
                    ],
                    "synonyms": [
                        "infini",
                        "illimité"
                    ],
                    "antonyms": [
                        "borné",
                        "fini"
                    ],
                    "common_phrases": [
                        "vérité éternelle"
                    ]
                }
            ]
        },
