{
    "word_family": [
        "noodler",
        "noodling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a89d139-1577-30f7-b6d5-d51012739d1d",
                    "sense_definition": "A string or flat strip of pasta or other dough, usually cooked by boiling and served in soup or with a sauce.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is cooking <w>noodles</w> for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Она готовит <w>лапшу</w> на ужин сегодня вечером."
                            }
                        },
                        {
                            "text": "She slurped a long <w>noodle</w> up out of her soup.",
                            "target_lang_translations": {
                                "ru": "Она с хлюпаньем втянула длинную <w>лапшину</w> из супа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "instant noodles",
                        "egg noodles",
                        "noodle soup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоска теста (макаронное изделие), которую обычно варят и подают в супе или с соусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапша",
                                "target_lang_sense_clarification": "пищевой продукт из теста"
                            },
                            {
                                "target_lang_word": "макароны",
                                "target_lang_sense_clarification": "общее название макаронных изделий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d3437d-96b7-354a-9e3d-5e09fdccd0f9",
                    "sense_definition": "A long, slender tube or rod made of buoyant foam, used as a toy or exercise tool in swimming pools.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were playing with a bright blue pool <w>noodle</w> in the water.",
                            "target_lang_translations": {
                                "ru": "Дети играли в воде с ярко-синим <w>нудлом</w> для бассейна."
                            }
                        },
                        {
                            "text": "He used a foam <w>noodle</w> to stay afloat while learning how to swim.",
                            "target_lang_translations": {
                                "ru": "Он использовал пенопластовую <w>аквапалку</w>, чтобы держаться на воде, пока учился плавать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pool noodle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная гибкая палка из плавучего пеноматериала, используемая как игрушка или тренажер в бассейне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нудл",
                                "target_lang_sense_clarification": "аквапалка для бассейна"
                            },
                            {
                                "target_lang_word": "аквапалка",
                                "target_lang_sense_clarification": "инвентарь для плавания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f9e96d-0cd6-3f7b-afb7-4b1dd5f824e6",
                    "sense_definition": "A person's head or brain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to use your <w>noodle</w> to solve this difficult math problem.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно пошевелить <w>мозгами</w>, чтобы решить эту сложную математическую задачу."
                            }
                        },
                        {
                            "text": "There is nothing wrong with your <w>noodle</w>; you just need to focus more.",
                            "target_lang_translations": {
                                "ru": "С твоим <w>котелком</w> всё в порядке, тебе просто нужно больше сосредоточиться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "use your noodle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for head"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Голова или мозг человека (в переносном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котелок",
                                "target_lang_sense_clarification": "разговорное обозначение головы"
                            },
                            {
                                "target_lang_word": "башка",
                                "target_lang_sense_clarification": "грубо-разговорное обозначение головы"
                            },
                            {
                                "target_lang_word": "мозги",
                                "target_lang_sense_clarification": "умственные способности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6768dc33-ca56-3f77-9baa-218c3fc8dfba",
                    "sense_definition": "A person with poor judgment; a fool.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>noodle</w> and think before you act.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>простофилей</w> и думай, прежде чем делать."
                            }
                        },
                        {
                            "text": "The play featured a character who was a complete <w>noodle</w> and always made mistakes.",
                            "target_lang_translations": {
                                "ru": "В пьесе был персонаж, который был полным <w>дуралеем</w> и всегда совершал ошибки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "older term for a fool"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с плохим суждением; глупец или простофиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простофиля",
                                "target_lang_sense_clarification": "глуповатый человек"
                            },
                            {
                                "target_lang_word": "дуралей",
                                "target_lang_sense_clarification": "наивный или глупый человек"
                            },
                            {
                                "target_lang_word": "размазня",
                                "target_lang_sense_clarification": "бесхарактерный человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "907ae909-1587-3a7b-80c8-470a7eaa22eb",
                    "sense_definition": "To ponder or think about something, especially in an informal or unsystematic way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>noodled</w> over the problem for a day before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Он <w>обмозговывал</w> проблему целый день, прежде чем принять окончательное решение."
                            }
                        },
                        {
                            "text": "I need to <w>noodle</w> on this idea for a while before I can present it.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>поразмышлять</w> над этой идеей некоторое время, прежде чем я смогу её представить."
                            }
                        }
                    ],
                    "synonyms": [
                        "mull over"
                    ],
                    "common_phrases": [
                        "noodle over",
                        "noodle on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for thinking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать или размышлять о чем-то, обычно неформально или бессистемно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обмозговать",
                                "target_lang_sense_clarification": "подумать над чем-то"
                            },
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "неспешно думать"
                            },
                            {
                                "target_lang_word": "прикидывать",
                                "target_lang_sense_clarification": "предварительно обдумывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f344e810-8dc6-31d5-95d7-d53a4933329d",
                    "sense_definition": "To play a musical instrument or sing in an improvisatory, lighthearted, or casual manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>noodling</w> with that trumpet all afternoon in his room.",
                            "target_lang_translations": {
                                "ru": "Он весь день <w>наигрывал</w> на трубе у себя в комнате."
                            }
                        },
                        {
                            "text": "The guitarist was just <w>noodling</w> around on stage before the concert started.",
                            "target_lang_translations": {
                                "ru": "Гитарист просто <w>бренчал</w> на сцене перед началом концерта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noodle around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть на музыкальном инструменте или петь в импровизационной, легкой или непринужденной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бренчать",
                                "target_lang_sense_clarification": "неумело или небрежно играть"
                            },
                            {
                                "target_lang_word": "импровизировать",
                                "target_lang_sense_clarification": "играть без подготовки"
                            },
                            {
                                "target_lang_word": "наигрывать",
                                "target_lang_sense_clarification": "легко играть мелодию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46bcbcff-193d-31b2-b460-3de2e105fa0d",
                    "sense_definition": "To catch fish, especially large catfish, using only one's bare hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had several scratches on his arms from <w>noodling</w> for catfish in the muddy river.",
                            "target_lang_translations": {
                                "ru": "У него было несколько царапин на руках от <w>ловли</w> сомов <w>руками</w> в мутной реке."
                            }
                        },
                        {
                            "text": "In some regions, <w>noodling</w> is a popular but dangerous way to catch fish.",
                            "target_lang_translations": {
                                "ru": "В некоторых регионах <w>ловля рыбы голыми руками</w> — популярный, но опасный способ рыбалки."
                            }
                        }
                    ],
                    "synonyms": [
                        "guddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Southern United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить рыбу (особенно сомов) голыми руками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить руками",
                                "target_lang_sense_clarification": "способ рыбной ловли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f53d505-5581-3dd6-95e9-313873b8aabc",
                    "sense_definition": "To search through mining waste or dirt for opals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists were allowed to <w>noodle</w> for opals in the old waste heaps.",
                            "target_lang_translations": {
                                "ru": "Туристам разрешили <w>искать</w> опалы в старых отвалах породы."
                            }
                        },
                        {
                            "text": "He spent his childhood <w>noodling</w> in the dirt, hoping to find a precious stone.",
                            "target_lang_translations": {
                                "ru": "Он провел детство, <w>копаясь</w> в земле в надежде найти драгоценный камень."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noodle for opals"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать опалы в отвалах горной породы или грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искать опалы",
                                "target_lang_sense_clarification": "в отходах добычи"
                            },
                            {
                                "target_lang_word": "копаться",
                                "target_lang_sense_clarification": "в поисках камней"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}