                    },
                    {
                        "translation_id": "12e54dd0-6124-4320-863b-0a1438f0fadb",
                        "source_entry_id": "8c5f7fb3-8f55-392e-b789-a8b8806c57fe",
                        "target_lang_word": "Schlamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                        "entry_id": "b40d3b57-650e-3580-b1ed-ea635fb6b0c2",
                                        "glosses": [
                                            "mit Wasser vermischte Erde, Morast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03cfa672-f375-4312-91ff-2a040e0124ae",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "Nach dem Regenguss mussten wir durch Schlamm waten."
                                            },
                                            {
                                                "example_id": "803edb1d-3447-4c9f-b1c6-c2ceed87cbe0",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Er brach frühmorgens auf, kehrte abends wieder, ohne Kopfbedeckung, die Jacke zerrissen und die Hosen mit Schlamm beschmutzt.“"
                                            },
                                            {
                                                "example_id": "93c5bbf1-3be7-407f-9d26-8f04ad4946b8",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Der Schlamm patschte unter den Stiefeln.“"
                                            },
                                            {
                                                "example_id": "e17470cd-b54e-472e-a8ab-870ad287c5b2",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„In der Regenzeit spritzt mir der Schlamm auf der unbefestigten Straße, die zu unserem Haus führt, bis an die Waden.“"
                                            },
                                            {
                                                "example_id": "8c6d9c34-0565-4ea7-a7a1-d4679ee561ca",
                                                "sense_id": "5a741445-3cb1-3d80-85e8-690fbcc7dcfa",
                                                "text": "„Die Pferde wateten im Schlamm, sie hatten Mühe, die Kanonen zu bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1fb169e-2ea2-3313-8e17-ebac490267cc",
                                        "entry_id": "b40d3b57-650e-3580-b1ed-ea635fb6b0c2",
                                        "glosses": [
                                            "feine Ablagerungen am Boden von Gewässern oder in Geräten, durch die Flüssigkeiten fließen; Schlick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec71d529-5f41-4646-8239-c7d86dd5c5a1",
                                                "sense_id": "a1fb169e-2ea2-3313-8e17-ebac490267cc",
                                                "text": "Das Fischernetz wühlte eine Menge Schlamm auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd2cfbda-790a-4917-815b-853e23dcd12f",
                        "source_entry_id": "8c5f7fb3-8f55-392e-b789-a8b8806c57fe",
                        "target_lang_word": "boue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b9fb8a-5384-3a16-b89b-5f8d2b7a271b",
                                        "entry_id": "c1eb4b3b-9a50-312b-889c-a5c3d7d0266d",
                                        "glosses": [
                                            "Fange des rues et des chemins, formée d'un mélange plus ou moins consistant de terre, sable, matière organique et d'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4498702-a495-4d81-9c7c-5ca5ae76a73f",
                                                "sense_id": "b7b9fb8a-5384-3a16-b89b-5f8d2b7a271b",
                                                "text": "L'hiver était rude. Sur les routes que le court dégel de midi amollissait vaguement, la boue se ridait, se hérissait en lilliputiennes murailles et les sillons durcis qui bordaient les ornières ne s'affaissaient point."
                                            },
                                            {
                                                "example_id": "deef920c-2811-4cda-be78-08f4168bfd86",
                                                "sense_id": "b7b9fb8a-5384-3a16-b89b-5f8d2b7a271b",
                                                "text": "Il m’est dit à chaque instant que l’un des grands soucis des autorités départementales, c'est l’entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            },
                                            {
                                                "example_id": "91a0d86f-5ea5-4a55-a4d7-8f9651565b02",
                                                "sense_id": "b7b9fb8a-5384-3a16-b89b-5f8d2b7a271b",
                                                "text": "Il avait plu toute cette semaine-là, et la vieille boue des hivers, pétrie par les sabots des vaches, des chevaux et des gens, grasse de bouse et claire comme de la pâte à gaufres s'était ramollie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b47433-c268-37c1-ba02-addafd5ac7ec",
                                        "entry_id": "c1eb4b3b-9a50-312b-889c-a5c3d7d0266d",
                                        "glosses": [
                                            "Mélange, fluide ou visqueux, d'eau et de minéraux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991b40d1-8263-49cf-bf4f-349f867ff3b3",
                                                "sense_id": "b6b47433-c268-37c1-ba02-addafd5ac7ec",
                                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                                            },
                                            {
                                                "example_id": "12826ab3-e4ea-4fc9-986c-b8ff1816f63a",
                                                "sense_id": "b6b47433-c268-37c1-ba02-addafd5ac7ec",
                                                "text": "L'ennemi réel n'était pas le pauvre nhaqué enfoui dans la boue des rizières, le chleuh retrouvant son moukkala, le fellaga terré dans son djebel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41233484-75ee-3eca-902d-5255133f47f9",
                                        "entry_id": "c1eb4b3b-9a50-312b-889c-a5c3d7d0266d",
                                        "glosses": [
                                            "Dépôt d’encre épaisse qui se forme au fond de l’encrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10848a04-20c9-4625-a911-c24ad661f288",
                                                "sense_id": "41233484-75ee-3eca-902d-5255133f47f9",
                                                "text": "Ce n’est plus de l’encre, c’est de la boue."
                                            },
                                            {
                                                "example_id": "8fec286a-83ce-4c52-8a02-20d03909603f",
                                                "sense_id": "41233484-75ee-3eca-902d-5255133f47f9",
                                                "text": "Comment voulez-vous écrire avec cette boue ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c5f069d-bfab-36d5-a816-a3e4ebc2b306",
                                        "entry_id": "c1eb4b3b-9a50-312b-889c-a5c3d7d0266d",
                                        "glosses": [
                                            "Sorte de limon qui se trouve près de certaines eaux minérales et qui, imprégné des mêmes sels, participe aux mêmes propriétés."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb0e5b5-d78b-41cc-bdb2-7c1595b6958a",
                                                "sense_id": "4c5f069d-bfab-36d5-a816-a3e4ebc2b306",
                                                "text": "Les médecins prescrivent les boues sous la forme de bain, pour combattre certaines affections rhumatismales, etc."
                                            },
                                            {
                                                "example_id": "9255b630-1c8e-4f5c-93a8-ea7eb0f01dca",
                                                "sense_id": "4c5f069d-bfab-36d5-a816-a3e4ebc2b306",
                                                "text": "Prendre les boues de Saint-Amand, de Barbotan, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                        "entry_id": "c1eb4b3b-9a50-312b-889c-a5c3d7d0266d",
                                        "glosses": [
                                            "Chose abjecte, abjection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9378ee93-1bcd-411b-920a-441f088b4ea3",
                                                "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                                "text": "Tirer quelqu’un de la boue, le tirer d’un état bas et abject."
                                            },
                                            {
                                                "example_id": "22dfc343-1eb3-46e4-99ab-cc9c006d4cb4",
                                                "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                                "text": "Traîner quelqu’un dans la boue, proférer ou écrire contre lui des injures graves, des imputations diffamantes."
                                            },
                                            {
                                                "example_id": "f00c97b3-954c-4f42-bb0d-8a4f9099eb17",
                                                "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                                "text": "Cet homme est dans la boue, est tombé dans la boue, il est plongé dans l’abjection."
                                            },
                                            {
                                                "example_id": "33f2ce2e-25d5-43d8-95b8-8adbe1d8cf25",
                                                "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                                "text": "C’est une âme de boue, c’est une âme basse et vile."
                                            },
                                            {
                                                "example_id": "a3def736-dead-4eee-8d43-40f3a5483fc5",
                                                "sense_id": "aaa16b6d-c7e7-36f1-a479-82c155852914",
                                                "text": "Cette maison n’est faite que de boue et de crachat, elle n’est bâtie que de mauvais matériaux."
                                            }
                                        ]
                                    }
                                ]
                            },
