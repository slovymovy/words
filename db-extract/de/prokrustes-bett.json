                "senses": [
                    {
                        "sense_id": "34bb388d-18ff-3203-a5b0-485b5012a607",
                        "entry_id": "4f900b2a-5933-3cc6-ae45-109c8656033f",
                        "glosses": [
                            "bildungssprachlich bis gehoben:"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a8466f7-05fc-389d-8c99-d96a23022eb5",
                        "entry_id": "4f900b2a-5933-3cc6-ae45-109c8656033f",
                        "glosses": [
                            "(allzu starres) Schema, in das etwas (oder jemand) gewaltsam hineingezwängt wird oder werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a48d18f-0e87-4330-ba71-6148283505a2",
                                "sense_id": "2a8466f7-05fc-389d-8c99-d96a23022eb5",
                                "text": "„Für solche Durchblicke und Aufweise schmiedet Klotz kein begriffsgestähltes Prokrustes-Bett, er unterzieht einzelne Textstellen ausgewählter Dramen samt ihrer szenischen Funktion einer gründlichen Lektüre.“"
                            },
                            {
                                "example_id": "439ff6e0-c16e-4b0a-8eab-09554029f728",
                                "sense_id": "2a8466f7-05fc-389d-8c99-d96a23022eb5",
                                "text": "„Slevogt sprach in diesem Zusammenhang von einer ‚Befreiung des Zeichners aus dem Prokrustes-Bett des Buches‘.“"
                            },
                            {
                                "example_id": "a3945296-174e-448b-804f-fb908dd5a552",
                                "sense_id": "2a8466f7-05fc-389d-8c99-d96a23022eb5",
                                "text": "„Doch wären wir niemals so vermessen, ihn in das Prokrustes-Bett der Psychoanalyse zu zwingen.“"
                            },
                            {
                                "example_id": "6115d1ea-7801-4d3a-98c1-50cb78d8b069",
                                "sense_id": "2a8466f7-05fc-389d-8c99-d96a23022eb5",
                                "text": "„Das Lyrische ist zurückgedrängt, und besonders im kantigen Scherzo ist die Musik an die Kandare genommen, sehr streng rhythmisiert, ja beinahe in das rhythmische Korsett gespannt wie in ein Prokrustes-Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7f793ac-ec2f-3e6b-91db-4f09c979208a",
                        "entry_id": "4f900b2a-5933-3cc6-ae45-109c8656033f",
                        "glosses": [
                            "Zwangslage oder zumindest unangenehme Lage, in die jemand gewaltsam hineingezwungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47566e6b-eda0-49d9-81f8-fb93fd937379",
                                "sense_id": "d7f793ac-ec2f-3e6b-91db-4f09c979208a",
                                "text": "„Empfinden Sie es nicht als mühsam, wenn Sie in den parlamentarischen Beratungen über den neuen Verfassungstext nun ständig zur Beschränkung auf das Bestehende mahnen müssen? Es ist schon ein bisschen ein Prokrustes-Bett, in das wir uns da zwängen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
