        "fr-extract.jsonl": [
            {
                "entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                "word": "programmeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0dd2f338-60dd-47e8-82e4-1d24733ca22a",
                        "entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                        "tags": [
                            "plural"
                        ],
                        "form": "programmeurs"
                    },
                    {
                        "form_id": "f66da042-a9ee-447e-bd89-c877d1d955e2",
                        "entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                        "tags": [
                            "feminine"
                        ],
                        "form": "programmeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                        "entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                        "glosses": [
                            "Personne qui développe un programme constitué par une séquence d'instructions écrite dans un langage de programmation et exécutée par un ordinateur, et en particulier, celui qui réalise des logiciels en créant des algorithmes et en les mettant en œuvre. Informaticien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf54cd1-fb9d-4093-8769-2c651f08a216",
                                "sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                                "text": "À partir d’une analyse détaillée faite par le développeur, le programmeur écrit dans un code approprié le programme contenant les instructions qui seront comprises par la machine et qui permettront à celle-ci de réaliser le travail demandé."
                            },
                            {
                                "example_id": "ab0279f4-220d-4ac0-9441-ac7aaae19d2d",
                                "sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                                "text": "Les bons programmeurs savent quoi écrire. Les grands programmeurs savent quoi réécrire (et réutiliser)."
                            },
                            {
                                "example_id": "cecb910c-d794-45c0-aa36-a64a6901b484",
                                "sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                                "text": "De leur côté, les enseignants \"recyclés\", ces néo-programmeurs auxquels l'institution demande à la fois d'inventer des didacticiels, de les écrire, de former leurs collègues..., ne voient que très rarement le piège qui leur est tendu : l'illusion d'une compétence qui prend le plus souvent les allures d'une passion obsessionnelle pour le clavier."
                            },
                            {
                                "example_id": "4264ffe2-0163-46e6-947a-f4ac7de02922",
                                "sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                                "text": "Ils dépendent maintenant des programmeurs. Une nouvelle figure deviendra incontournable au DAE : Lucy Slater, qui, pendant vingt ans, s’occupe de programmer la majorité des travaux des économistes du département."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba66623b-a39b-4517-a5ae-525afaa99e57",
                        "source_entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                        "source_sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                        "target_lang_word": "Programmierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Programmierer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b1bdcd-f850-3827-8af5-c04534f53d5e",
                                        "entry_id": "a8f6a134-6ff1-382d-a2e3-ea89c3b72037",
                                        "glosses": [
                                            "Verfasser eines Computerprogramms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60377777-1596-4ca5-bb92-2a5738c41c8f",
                                                "sense_id": "e4b1bdcd-f850-3827-8af5-c04534f53d5e",
                                                "text": "Ein Programmierer schreibt ein Programm."
                                            },
                                            {
                                                "example_id": "6e9da237-09fc-47c1-8168-f8431ce4e3e7",
                                                "sense_id": "e4b1bdcd-f850-3827-8af5-c04534f53d5e",
                                                "text": "Die Unterscheidung von Programmierer zum Softwareentwickler ist fließend, teilweise werden die Begriffe auch synonym verwendet."
                                            },
                                            {
                                                "example_id": "928f47e8-d76e-4743-b129-f816069430a7",
                                                "sense_id": "e4b1bdcd-f850-3827-8af5-c04534f53d5e",
                                                "text": "„Laut Apple-CEO Tim Cook muss man nicht studiert haben, um ein guter Programmierer zu sein.“"
                                            },
                                            {
                                                "example_id": "6dd2f59e-5d11-426b-bf5f-903bd8a8d666",
                                                "sense_id": "e4b1bdcd-f850-3827-8af5-c04534f53d5e",
                                                "text": "„Das Mitarbeiterprofil ist, ebenso wie am FU-Zentrum, breit gefächert: darunter sind Programmierer und Webdesigner ebenso wie Fachleute aus dem pädagogisch-didaktischen Bereich und schließlich jene, die neudeutsch Content Manager heißen, also für Texte und Inhalte zuständig sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9609349-f7a5-4e68-af94-642e6051a739",
                        "source_entry_id": "995a2a68-4cb9-3872-96e2-79c7b54666da",
                        "source_sense_id": "551711db-5f6d-343a-9800-f91c8a7774ae",
                        "target_lang_word": "programmer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "programmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cb91d1c-0ba8-3838-930f-ffe716803378",
                                        "entry_id": "8452c5d1-ad0f-384c-8232-eb8d56e274cb",
                                        "glosses": [
                                            "One who writes computer programs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc90052-8758-42fc-9481-3ea31d2f304b",
                                                "sense_id": "6cb91d1c-0ba8-3838-930f-ffe716803378",
                                                "text": "More important, when we looked at who worked in that industry, we noticed that programmers were in the minority. They’re dwarfed by, among other occupations, the software developers. The two terms are sometimes used interchangeably, but the jobs follow very different trajectories. Nationwide, software developers haven’t struggled nearly as much as their programming brethren — few other computer-related occupations have. So what makes programmers different? To answer that, we need to dive forehead first into everybody’s favorite part of any analysis: arcane occupation definitions! Upon perusing the fine print, we saw that while programmers do in fact program, they “work from specifications drawn up by software and web developers or other individuals.” That seems like a clue. In the real world, “developer” and “programmer” can seem almost interchangeable. But in the world of government statistics, where we have legal permanent residency, there’s a clear distinction. In the [US] government’s schema, programmers do the grunt work while the much more numerous — and much faster-growing — software developers enjoy a broader remit. They figure out what clients need, design solutions and work with folks such as programmers and hardware engineers to implement them. Their pay reflects this gap in responsibilities. The median programmer earned $99,700 in 2023, compared with $132,270 for the median developer. And while 27.5 percent of programming jobs vanished, jobs for developers have only fallen 0.3 percent, similar to the broader industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2632b461-6a11-3bd5-8275-c42ee529f0e7",
                                        "entry_id": "8452c5d1-ad0f-384c-8232-eb8d56e274cb",
                                        "glosses": [
                                            "One who decides which programs will be shown on a television station, or which songs will be played on a radio station."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4313166c-5711-4bc9-8992-feeb09be2226",
                                                "sense_id": "2632b461-6a11-3bd5-8275-c42ee529f0e7",
                                                "text": "The handful of never-ending summer classics annually activated by rock-radio programmers."
                                            },
                                            {
                                                "example_id": "b86fe925-b48a-424e-9b71-4e9f7d0a5f8a",
                                                "sense_id": "2632b461-6a11-3bd5-8275-c42ee529f0e7",
                                                "text": "So if there is a real shortage of training material and opportunities for radio programmers, then let's write some."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a98106e-88e6-303c-91c2-7bff1b33879d",
                                        "entry_id": "8452c5d1-ad0f-384c-8232-eb8d56e274cb",
                                        "glosses": [
                                            "A device that installs or controls a software program in some other machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aed2660-ffe8-4acd-b1d4-dfb12a515f76",
                                                "sense_id": "2a98106e-88e6-303c-91c2-7bff1b33879d",
                                                "text": "The EPROM programmer burns the data into the EPROM chip. When programming is completed, remove the EPROM chip and plug it into the circuit […]"
                                            },
                                            {
                                                "example_id": "f1b58524-0072-47d0-9343-3d05144d75ea",
                                                "sense_id": "2a98106e-88e6-303c-91c2-7bff1b33879d",
                                                "text": "This system comprises a boiler with its own thermostat to regulate the water temperature, a pump, a hot-water storage tank, a room thermostat and some form of timed programmer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f18176-e3d7-308e-94c8-10d6a6f2914b",
                                        "entry_id": "8452c5d1-ad0f-384c-8232-eb8d56e274cb",
                                        "glosses": [
                                            "A short film feature as part of a longer film program."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734f8cca-2d57-4b56-b1cd-2d4756738ea2",
                                                "sense_id": "49f18176-e3d7-308e-94c8-10d6a6f2914b",
                                                "text": "As a programmer, the Chan series is linked to the B picture, known for its low production value and overt, disruptive, unpolished, even lurid narratives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
