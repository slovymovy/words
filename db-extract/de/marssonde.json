                "senses": [
                    {
                        "sense_id": "32abcbc9-4f15-3a2b-b936-69fd76c52381",
                        "entry_id": "5237c227-fa14-3fff-84f4-1c47b0235a44",
                        "glosses": [
                            "Sonde (ein unbemannter Flugkörper), die in den Weltraum geschickt wird, um den Planeten Mars zu erforschen/untersuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3801c684-fb81-4299-94bd-6fbd7a02d7f0",
                                "sense_id": "32abcbc9-4f15-3a2b-b936-69fd76c52381",
                                "text": "„Die erste Marssonde Indiens hat am Sonntag die Erdumlaufbahn verlassen und den 680 Millionen Kilometer langen Weg zum Roten Planeten angetreten.“"
                            },
                            {
                                "example_id": "2da5a1f1-d8b3-4bcf-931b-34f9fd78dd75",
                                "sense_id": "32abcbc9-4f15-3a2b-b936-69fd76c52381",
                                "text": "„Mehr als elf Jahre gab es keine brauchbaren Informationen, jetzt scheint das Schicksal der Marssonde \"Beagle 2\" geklärt. Neue Fotos belegen, dass ihr die Landung auf dem Roten Planeten geglückt ist - sie dann aber den Dienst quittiert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
