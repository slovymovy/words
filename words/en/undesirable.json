    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d1b6713-ba16-3bf5-bfcb-870a54057902",
                    "sense_definition": "Not wanted or attractive because of being harmful, objectionable, or unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new medicine was effective, but it produced many <w>undesirable</w> side effects in patients.",
                            "target_lang_translations": {
                                "nl": "Het nieuwe medicijn was effectief, maar veroorzaakte veel <w>ongewenste</w> bijwerkingen bij patiënten."
                            }
                        },
                        {
                            "text": "Living right next to the noisy highway was considered an <w>undesirable</w> situation.",
                            "target_lang_translations": {
                                "nl": "Vlak naast de lawaaierige snelweg wonen werd beschouwd als een <w>onwenselijke</w> situatie."
                            }
                        }
                    ],
                    "antonyms": [
                        "desirable"
                    ],
                    "common_phrases": [
                        "undesirable side effects",
                        "undesirable consequences"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet gewild of aantrekkelijk omdat het schadelijk, bezwaarlijk of onaangenaam is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongewenst",
                                "target_lang_sense_clarification": "niet gewild of gezocht"
                            },
                            {
                                "target_lang_word": "onwenselijk",
                                "target_lang_sense_clarification": "niet wenselijk of passend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f002ea6-96b6-3680-8008-ca9bed45b43a",
                    "sense_definition": "A person who is considered objectionable, harmful, or socially unacceptable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club hired extra security to keep any <w>undesirables</w> from entering the venue.",
                            "target_lang_translations": {
                                "nl": "De club huurde extra beveiliging in om te voorkomen dat <w>ongewenste personen</w> de locatie zouden betreden."
                            }
                        },
                        {
                            "text": "Authorities considered the rebel leader an <w>undesirable</w> and refused to grant him a visa.",
                            "target_lang_translations": {
                                "nl": "De autoriteiten beschouwden de rebellenleider als een <w>ongewenst persoon</w> en weigerden hem een visum te verlenen."
                            }
                        }
                    ],
                    "synonyms": [
                        "criminal",
                        "villain"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die als verwerpelijk, schadelijk of sociaal onaanvaardbaar wordt beschouwd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongewenst persoon",
                                "target_lang_sense_clarification": "iemand die niet welkom is"
                            },
                            {
                                "target_lang_word": "ongewenst element",
                                "target_lang_sense_clarification": "onruststoker of ongewenst individu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
