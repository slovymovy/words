                "senses": [
                    {
                        "sense_id": "101dc710-d4e5-36d6-81b8-1b724bafc6e3",
                        "entry_id": "c338e7cb-99ed-32e7-aaa1-f2aa931fb5ce",
                        "glosses": [
                            "оборудовать что-либо радиоаппаратурой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d25ba0-346a-4b2d-9607-a979088af7d1",
                                "sense_id": "101dc710-d4e5-36d6-81b8-1b724bafc6e3",
                                "text": "Осоавиахим Украины обратился в СКВ с просьбой радиофицировать Славянский аэростат."
                            },
                            {
                                "example_id": "8e5815af-cbdc-468f-bc17-4e5fc5e11e01",
                                "sense_id": "101dc710-d4e5-36d6-81b8-1b724bafc6e3",
                                "text": "Зал института был забит, заполнены были коридоры и лестница, ведущая в зал. Физикам срочно пришлось их радиофицировать."
                            }
                        ]
                    },
                    {
                        "sense_id": "00c4fe8f-f2ed-3621-9385-5bc0f9562f25",
                        "entry_id": "c338e7cb-99ed-32e7-aaa1-f2aa931fb5ce",
                        "glosses": [
                            "широко распространять (распространить) радиоустановки, радиосвязь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56d5915-66c2-4241-8eb1-eee56f91e1b3",
                                "sense_id": "00c4fe8f-f2ed-3621-9385-5bc0f9562f25",
                                "text": "Задача ОДР [Общество друзей радио] ― помочь государству радиофицировать СССР, организовать правильное использование радио, распространять радиотехнические знания ― это работа многих лет."
                            }
                        ]
                    }
