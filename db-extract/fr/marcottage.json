                ],
                "senses": [
                    {
                        "sense_id": "ad2a73a1-2b7d-3939-bda7-8c440c651663",
                        "entry_id": "7e59efbd-714e-3d01-898c-ac8a9471168b",
                        "glosses": [
                            "Mode de reproduction végétale par lequel des tiges aériennes, entrant en contact avec le sol, créent de nouvelles racines donc un nouveau plant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "034c45db-5c53-4ed2-a812-b43bec21d6bd",
                                "sense_id": "ad2a73a1-2b7d-3939-bda7-8c440c651663",
                                "text": "Tertullien emprunte à la nature l’image du marcottage pour montrer comment la foi essaime de lieu en lieu, sans plan préconçu."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a8e1ccd-bce9-34ad-ab11-a08d3d453d6e",
                        "entry_id": "7e59efbd-714e-3d01-898c-ac8a9471168b",
                        "glosses": [
                            "Technique de multiplication des végétaux consistant à enterrer une partie aérienne d’une plante afin qu’elle produise des racines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c654180b-38aa-414f-b02b-15ddc7672577",
                                "sense_id": "1a8e1ccd-bce9-34ad-ab11-a08d3d453d6e",
                                "text": "Le marcottage consiste à provoquer, en un point déterminé du rameau, la formation de racines adventives capables d’alimenter la marcotte, qu’on sèvre ensuite, en la séparant du pied mère."
                            }
                        ]
                    }
                ],
