{
    "word_family": [
        "externality",
        "externalize",
        "externally",
        "exterior"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "227ca63b-ed58-32f7-b636-36dd3a201d0f",
                    "sense_definition": "Located on the outside of something; relating to the exterior.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>external</w> walls of the house need a fresh coat of paint before winter.",
                            "target_lang_translations": {
                                "ru": "<w>Внешние</w> стены дома нужно покрасить до наступления зимы.",
                                "zh": "冬天来临前，房子的<w>外墙</w>需要重新粉刷。"
                            }
                        },
                        {
                            "text": "You should check the <w>external</w> pipework for any signs of leaking or damage.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить <w>наружный</w> трубопровод на наличие признаков утечки или повреждений.",
                                "zh": "你应该检查一下<w>外置</w>管道，看看有没有泄漏或损坏的迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peripheral"
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external walls",
                        "external pipework",
                        "external surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный снаружи чего-либо; относящийся к внешней стороне.",
                        "zh": "位于某物外部的；与外观相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "находящийся снаружи"
                            },
                            {
                                "target_lang_word": "наружный",
                                "target_lang_sense_clarification": "относящийся к поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外部的",
                                "target_lang_sense_clarification": "位于物体外面"
                            },
                            {
                                "target_lang_word": "外表的",
                                "target_lang_sense_clarification": "与表面有关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b80ad1c-8124-3749-9e35-785cf6bbae0f",
                    "sense_definition": "Coming from or provided by a source outside of a particular organization, group, or person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to hire an <w>external</w> consultant to review their financial records.",
                            "target_lang_translations": {
                                "ru": "Компания решила нанять <w>внешнего</w> консультанта для проверки финансовой отчетности.",
                                "zh": "公司决定聘请一位<w>外部</w>顾问来审查财务记录。"
                            }
                        },
                        {
                            "text": "The project failed because of <w>external</w> pressure from the local government.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за <w>внешнего</w> давления со стороны местных властей.",
                                "zh": "由于来自当地政府的<w>外部</w>压力，该项目失败了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extraneous"
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external consultant",
                        "external pressure",
                        "external source",
                        "external factors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поступающий или предоставляемый из источника вне конкретной организации, группы или человека.",
                        "zh": "来自特定组织、团体或个人之外的来源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "сторонний, привлеченный извне"
                            },
                            {
                                "target_lang_word": "сторонний",
                                "target_lang_sense_clarification": "не принадлежащий к данной организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外部的",
                                "target_lang_sense_clarification": "从外部引入的"
                            },
                            {
                                "target_lang_word": "外聘的",
                                "target_lang_sense_clarification": "非本单位人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a1ae24d-d683-3c3d-aeac-042fc6de73d0",
                    "sense_definition": "Relating to or involving foreign countries or international relations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "international",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ministry is responsible for managing the country's <w>external</w> affairs and trade.",
                            "target_lang_translations": {
                                "ru": "Министерство отвечает за управление <w>внешними</w> делами и торговлей страны.",
                                "zh": "该部负责管理国家的<w>对外</w>事务和贸易。"
                            }
                        },
                        {
                            "text": "The nation's <w>external</w> trade has grown significantly over the last decade.",
                            "target_lang_translations": {
                                "ru": "<w>Внешняя</w> торговля страны значительно выросла за последнее десятилетие.",
                                "zh": "过去十年里，该国的<w>对外</w>贸易增长显著。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foreign"
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external affairs",
                        "external trade",
                        "external relations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к иностранным государствам или международным отношениям.",
                        "zh": "涉及外国或国际关系的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "международный, иностранный"
                            },
                            {
                                "target_lang_word": "внешнеполитический",
                                "target_lang_sense_clarification": "связанный с политикой других стран"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对外",
                                "target_lang_sense_clarification": "涉及国际事务的"
                            },
                            {
                                "target_lang_word": "外贸",
                                "target_lang_sense_clarification": "涉及国际贸易的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dd68da0-f236-35e4-bd6f-46571b7e630e",
                    "sense_definition": "Relating to medicines or substances intended for use on the outside of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This cream is for <w>external</w> use only and should not be swallowed.",
                            "target_lang_translations": {
                                "ru": "Этот крем предназначен только для <w>наружного</w> применения, его нельзя глотать.",
                                "zh": "此药膏仅供<w>外用</w>，切勿吞食。"
                            }
                        },
                        {
                            "text": "The doctor prescribed an <w>external</w> ointment to treat the skin rash.",
                            "target_lang_translations": {
                                "ru": "Врач прописал мазь для <w>наружного</w> применения для лечения кожной сыпи.",
                                "zh": "医生开了一种<w>外用</w>药膏来治疗皮疹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "superficial"
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external use only",
                        "external application"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к лекарствам или веществам, предназначенным для применения на поверхности тела.",
                        "zh": "指仅供身体表面使用的药物或物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наружный",
                                "target_lang_sense_clarification": "для применения на коже"
                            },
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "не для внутреннего употребления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外用",
                                "target_lang_sense_clarification": "仅限皮肤表面使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97328343-356b-302e-8d17-b0dab888e125",
                    "sense_definition": "Referring to hardware or devices that are not contained within the main computer casing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I keep all my backup files on an <w>external</w> hard drive for safety.",
                            "target_lang_translations": {
                                "ru": "В целях безопасности я храню все резервные копии файлов на <w>внешнем</w> жестком диске.",
                                "zh": "为了安全起见，我把所有备份文件都存在一个<w>外置</w>硬盘里。"
                            }
                        },
                        {
                            "text": "You can connect an <w>external</w> monitor to your laptop for a larger display.",
                            "target_lang_translations": {
                                "ru": "Вы можете подключить <w>внешний</w> монитор к ноутбуку для увеличения рабочей области.",
                                "zh": "你可以给笔记本电脑连接一个<w>外置</w>显示器以获得更大的显示区域。"
                            }
                        }
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external hard drive",
                        "external monitor",
                        "external device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к оборудованию или устройствам, которые не находятся внутри основного корпуса компьютера.",
                        "zh": "指未包含在计算机主机壳体内的硬件或设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "подключаемый снаружи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外置",
                                "target_lang_sense_clarification": "连接在设备外部的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4e9c500-2be1-328e-9505-0784ef3ac5c5",
                    "sense_definition": "Not being an essential or intrinsic part of the nature of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>external</w> circumstances of his life did not reflect his inner peace.",
                            "target_lang_translations": {
                                "ru": "<w>Внешние</w> обстоятельства его жизни не отражали его внутреннего спокойствия.",
                                "zh": "他生活中的<w>外部</w>环境并不能反映他内心的平静。"
                            }
                        },
                        {
                            "text": "We must distinguish between the core values and the <w>external</w> features of the culture.",
                            "target_lang_translations": {
                                "ru": "Мы должны различать основные ценности и <w>внешние</w> черты культуры.",
                                "zh": "我们必须区分文化的核心价值与<w>外部</w>特征。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extrinsic",
                        "accidental"
                    ],
                    "antonyms": [
                        "internal"
                    ],
                    "common_phrases": [
                        "external circumstances",
                        "external features"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся существенной или неотъемлемой частью природы чего-либо.",
                        "zh": "非事物本质的、非内在的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "поверхностный, несущественный"
                            },
                            {
                                "target_lang_word": "формальный",
                                "target_lang_sense_clarification": "касающийся только видимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外部的",
                                "target_lang_sense_clarification": "非本质的"
                            },
                            {
                                "target_lang_word": "表面的",
                                "target_lang_sense_clarification": "仅停留在外表的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "369ee851-85cb-3c08-9f12-0b9aba87c28f",
                    "sense_definition": "The outward parts, appearances, or non-essential features of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so focused on the <w>externals</w> of the ceremony that he forgot its meaning.",
                            "target_lang_translations": {
                                "ru": "Он был так сосредоточен на <w>внешних атрибутах</w> церемонии, что забыл о её смысле.",
                                "zh": "他太专注于仪式的<w>外在形式</w>，以至于忘记了它的意义。"
                            }
                        },
                        {
                            "text": "The <w>externals</w> of the building were impressive, but the interior was in ruins.",
                            "target_lang_translations": {
                                "ru": "<w>Внешний вид</w> здания был впечатляющим, но внутри всё было в руинах.",
                                "zh": "这座建筑的<w>外观</w>令人印象深刻，但内部却已破败不堪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "observe the externals",
                        "mere externals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешние части, видимость или несущественные черты чего-либо.",
                        "zh": "事物的外部部分、外观或非本质特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешние атрибуты",
                                "target_lang_sense_clarification": "формальные признаки"
                            },
                            {
                                "target_lang_word": "внешность",
                                "target_lang_sense_clarification": "наружный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外在形式",
                                "target_lang_sense_clarification": "表面的特征"
                            },
                            {
                                "target_lang_word": "外观",
                                "target_lang_sense_clarification": "外表样貌"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}