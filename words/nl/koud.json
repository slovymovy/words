                {
                    "sense_id": "f60f1740-506b-3f75-ac76-e4e837208ddb",
                    "sense_definition": "Zonder gevoel, medeleven of vriendelijkheid; afstandelijk in gedrag.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>koude</w> blik maakte mij een beetje bang.",
                            "target_lang_translations": {
                                "en": "His <w>cold</w> stare made me a bit scared.",
                                "ru": "Его <w>холодный</w> взгляд меня немного напугал.",
                                "pl": "Jego <w>zimne</w> spojrzenie trochę mnie przestraszyło.",
                                "de": "Sein <w>kalter</w> Blick machte mir ein wenig Angst.",
                                "fr": "Son regard <w>froid</w> m'a fait un peu peur.",
                                "it": "Il suo sguardo <w>freddo</w> mi ha spaventato un po'.",
                                "cs": "Jeho <w>chladný</w> pohled mě trochu vyděsil.",
                                "tr": "Onun <w>soğuk</w> bakışı beni biraz korkuttu.",
                                "es": "Su mirada <w>fría</w> me asustó un poco."
                            }
                        },
                        {
                            "text": "Ze reageerde erg <w>koud</w> op mijn enthousiaste voorstel.",
                            "target_lang_translations": {
                                "en": "She reacted very <w>coldly</w> to my enthusiastic proposal.",
                                "ru": "Она очень <w>холодно</w> отреагировала на мое полное энтузиазма предложение.",
                                "pl": "Zareagowała bardzo <w>chłodno</w> na moją entuzjastyczną propozycję.",
                                "de": "Sie reagierte sehr <w>kühl</w> auf meinen enthusiastischen Vorschlag.",
                                "fr": "Elle a réagi très <w>froidement</w> à ma proposition enthousiaste.",
                                "it": "Ha reagito in modo molto <w>freddo</w> alla mia proposta entusiasta.",
                                "cs": "Na můj nadšený návrh reagovala velmi <w>chladně</w>.",
                                "tr": "Benim coşkulu önerime çok <w>soğuk</w> bir tepki verdi.",
                                "es": "Ella reaccionó de manera muy <w>fría</w> a mi propuesta entusiasta."
                            }
                        }
