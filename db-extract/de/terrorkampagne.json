                            {
                                "example_id": "4dfc2a4c-30f7-4387-b75e-3022e9ca19ae",
                                "sense_id": "fda620c7-d399-3235-9dfe-3336215d62fe",
                                "text": "„Die Fünfte Brigade wie auch die Terrorkampagne, die sie durchführte, sind unter dem Namen «Gukurahundi» bekannt, die der Premier ihnen verlieh.“"
                            },
                            {
                                "example_id": "25929867-4d7e-41a5-ae7e-88d17411c6fb",
                                "sense_id": "fda620c7-d399-3235-9dfe-3336215d62fe",
                                "text": "„Ab dem Tag, nachdem die UN-Teilungsresolution verabschiedet wurde, waren die 75 000 Palästinenser der Stadt einer Terrorkampagne ausgesetzt, die Irgun und Hagana gemeinsam betrieben.“"
                            }
