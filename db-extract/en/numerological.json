                "senses": [
                    {
                        "sense_id": "be7751fb-7d80-3643-99cc-e8ef991cf53b",
                        "entry_id": "a468c6cb-0f27-362a-b03a-9e66d643a33e",
                        "glosses": [
                            "Of, pertaining to, or based on numerology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "aede15ae-39ed-497d-84df-3c0560df7ba9",
                                "sense_id": "be7751fb-7d80-3643-99cc-e8ef991cf53b",
                                "text": "If you can't make up your mind whether to choose astrological, numerological, or some other type of spiritual guidance, don't worry."
                            },
                            {
                                "example_id": "e996d5a6-9bcf-4480-b1b9-3b1eb0be8371",
                                "sense_id": "be7751fb-7d80-3643-99cc-e8ef991cf53b",
                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d980b94-635f-4c1a-ada2-cb31bce71883",
                        "source_entry_id": "a468c6cb-0f27-362a-b03a-9e66d643a33e",
                        "source_sense_id": "be7751fb-7d80-3643-99cc-e8ef991cf53b",
                        "source_sense_description": "Translations",
