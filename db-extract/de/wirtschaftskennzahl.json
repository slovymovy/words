                "senses": [
                    {
                        "sense_id": "55bb2901-2b09-3c42-bcfa-36c4fd0923a4",
                        "entry_id": "36a7d2bd-2d39-35c6-9515-b0dab335f26b",
                        "glosses": [
                            "errechnete Zahl, die Auskunft über die geschäftliche (wirtschaftliche) Lage (zum Beispiel eines Unternehmens oder einer Volkswirtschaft) gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe39ff74-0d94-4487-b9c2-2a723c6a9456",
                                "sense_id": "55bb2901-2b09-3c42-bcfa-36c4fd0923a4",
                                "text": "„Die Wirtschaftskennzahlen geben eine Übersicht über die Struktur und Entwicklung des Wirtschaftsraums Luzern. Sie ermöglichen den Vergleich des Kantons Luzern mit der übrigen Zentralschweiz sowie mit der Gesamtschweiz.“"
                            },
                            {
                                "example_id": "339b6907-3759-464a-9faf-8642ba3a7cce",
                                "sense_id": "55bb2901-2b09-3c42-bcfa-36c4fd0923a4",
                                "text": "„Welche Art von Wirtschaftskennzahlen kann nun das Wohlbefinden der deutschen direkt und indirekt beeinflussen?“"
                            },
                            {
                                "example_id": "0912817d-4445-43fd-86ea-d8d131248a78",
                                "sense_id": "55bb2901-2b09-3c42-bcfa-36c4fd0923a4",
                                "text": "„Die berüchtigte Exceltabelle wurde mit Wirtschaftskennzahlen gefüttert, und gestandene Firmenchefs mussten jungen Wirtschaftsabsolventen in Investmentfirmen plötzlich Rede und Antwort stehen. Der Shareholder-Value wurde zum Mantra.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
