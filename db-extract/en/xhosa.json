                                        "entry_id": "daae53be-8f59-32a0-aff1-7d90e9caa9a6",
                                        "glosses": [
                                            "lingua del Sudafrica, che fa parte del sottogruppo nguni delle lingue bantu. Lo xhosa è la lingua più parlata in Sudafrica dopo lo zulu, soprattutto nelle province di Eastern Cape e Western Cape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
