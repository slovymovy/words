                "senses": [
                    {
                        "sense_id": "34ad94fc-b541-3ad6-b101-b747df2b54d5",
                        "entry_id": "9b41b393-fa18-3e7d-a52d-54eaa014ae91",
                        "glosses": [
                            "van iets dat het de moeite waard is om te weten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1ad7182-3515-4d7d-815b-508b81f738d3",
                                "sense_id": "34ad94fc-b541-3ad6-b101-b747df2b54d5",
                                "text": "Nu kan je een doorzeurend probleem met nieuw vuur te lijf gaan. Maar als het bijvoorbeeld gaat over oppervlakkige straatinterviews blijft Van Meurs steken in hoe belachelijk het is en hoe klein de kans is dat daar iets wetenswaardig uit komt. Voor iemand die kritiek heeft op andermans inzichten onderbouwt hij de zijne maar matig. Ook een redenering voltooien of een gedachte afwikkelen is niet zijn sterkste punt."
                            },
                            {
                                "example_id": "39c0fa73-14a9-4b33-b880-3b0a38deb20b",
                                "sense_id": "34ad94fc-b541-3ad6-b101-b747df2b54d5",
                                "text": "De resultaten zijn gepubliceerd in The British Medical Journal, het wetenschappelijk tijdschrift dat er genoegen in schept om eenmaal per jaar de resultaten te presenteren van onderzoek dat er eigenlijk niet zo veel toe doet, maar daarom niet minder wetenswaardig is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ad64ff0-ff77-4b55-9f7d-d396aca48535",
                        "source_entry_id": "9b41b393-fa18-3e7d-a52d-54eaa014ae91",
                        "source_sense_id": "34ad94fc-b541-3ad6-b101-b747df2b54d5",
                        "target_lang_word": "interesting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interesting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b242de8c-8f19-3b12-95cc-8e05e9821e96",
                                        "entry_id": "ded7e743-9c94-33f0-8045-ff5bcf6e89e4",
                                        "glosses": [
                                            "Of concern; affecting, important."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c52dde38-81d5-425f-b10d-16a0e70e8657",
                                                "sense_id": "b242de8c-8f19-3b12-95cc-8e05e9821e96",
                                                "text": "He indeed had good reason to be offended; for though Dr. Swinfen's motive was good, he inconsiderately betrayed a matter deeply interesting and of great delicacy, which had been entrusted to him in conference […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e290a69e-3599-328d-80e7-9071415c8a40",
                                        "entry_id": "ded7e743-9c94-33f0-8045-ff5bcf6e89e4",
                                        "glosses": [
                                            "Arousing or holding the attention or interest of someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db8dbef-8004-4a7a-974a-b86a24752a86",
                                                "sense_id": "e290a69e-3599-328d-80e7-9071415c8a40",
                                                "text": "Cricket is not interesting to watch."
                                            },
                                            {
                                                "example_id": "9fe5d343-e221-4ece-9fbc-a6c621d58ef6",
                                                "sense_id": "e290a69e-3599-328d-80e7-9071415c8a40",
                                                "text": "Comics were just another form of entertainment to me, but it got to be more and more interesting every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ced8c97-4072-3fac-99c3-4a7a93d44e30",
                                        "entry_id": "ded7e743-9c94-33f0-8045-ff5bcf6e89e4",
                                        "glosses": [
                                            "Pregnant. (used with situation and condition)"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56b59ec-ee10-4ce8-94d2-b7bcc016dc01",
                                                "sense_id": "2ced8c97-4072-3fac-99c3-4a7a93d44e30",
                                                "text": "I found myself in a fair way of being a mother; and that I might be near my own relations, in such an interesting situation, I and my dear companion departed from H—n, not without great reluctance […]."
                                            },
                                            {
                                                "example_id": "b3029622-dd0a-47ab-b8b0-1f9f0bb7de05",
                                                "sense_id": "2ced8c97-4072-3fac-99c3-4a7a93d44e30",
                                                "text": "Mrs Lenville (who, as has been before hinted, was in an interesting state) rushed from the rear rank of ladies, and uttering a piercing scream threw herself upon the body."
                                            },
                                            {
                                                "example_id": "55452a04-ea08-4088-aa7c-f8d0929581fb",
                                                "sense_id": "2ced8c97-4072-3fac-99c3-4a7a93d44e30",
                                                "text": "I’m afraid I seem to make heavy weather of my interesting condition."
                                            }
                                        ]
                                    }
                                ]
                            },
