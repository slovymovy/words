                ],
                "senses": [
                    {
                        "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                        "entry_id": "c7ffc766-f193-329a-8ee0-9677cb357ef6",
                        "glosses": [
                            "Fahrt gegen den Feind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7c7229-f1b2-4b4c-8ae3-526680530f36",
                                "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                                "text": "„Es war selten, dass man ein U-Boot von einer Feindfahrt zurückkommen sah.“"
                            },
                            {
                                "example_id": "f4f025b7-6158-48d4-af36-7c4bff3ff750",
                                "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                                "text": "„Verstärkte aliierte Gegenmaßnahmen in der deutschen Blockadezone um Großbritannien führten dazu, daß zwischen März und Juli mehr als ein Drittel aller U-Boote auf Feindfahrt mit leeren Händen zurückkehrten.“"
                            },
                            {
                                "example_id": "ea7b7444-a0d8-4825-a776-07aace9b3f87",
                                "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                                "text": "„In der Behauptung gegen die zermürbende Tatenlosigkeit liegt die größte Leistung der Besatzung während wochenlanger Feindfahrt.“"
                            },
                            {
                                "example_id": "a14da4fd-882b-46e4-8f80-b44e9c66737c",
                                "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                                "text": "„Immer weniger U-Boote kehrten von Feindfahrten zurück.“"
                            },
                            {
                                "example_id": "add37a2e-0b90-440d-bc6d-28d1a08724d1",
                                "sense_id": "41b6cdec-2231-3a66-9dde-5c221e6e0bcd",
                                "text": "„Als das Boot überholt, aufgetankt, verproviantiert und mit Torpedos versorgt war, hätte es auslaufen und auf Feindfahrt gehen sollen, doch fehlte der Kommandant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
