                "senses": [
                    {
                        "sense_id": "04fbb54e-dd5c-306d-a026-64c52e0236e6",
                        "entry_id": "91e8cb0d-e33a-3763-8067-12caad2053b9",
                        "glosses": [
                            "Leiter eines Ministeriums, das für das Schulwesen zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c804ffa-3713-4937-823e-f8eca07ea956",
                                "sense_id": "04fbb54e-dd5c-306d-a026-64c52e0236e6",
                                "text": "„Sinowatz war lange Jahre Landespolitiker im Burgenland und trat 1971 als Unterrichtsminister in die Alleinregierung von Bundeskanzler Bruno Kreisky ein.“"
                            },
                            {
                                "example_id": "ca8a7186-00cc-4d80-ac1b-b46126de5ef6",
                                "sense_id": "04fbb54e-dd5c-306d-a026-64c52e0236e6",
                                "text": "„Durch Unterrichtsminister Graf Stadion an die Universität Wien berufen (Ernennung 6. Februar 1849), fiel [Hermann Bonitz] die Aufgabe zu, das Österreichische Mittelschulwesen zu reorganisieren und das Studium der klassischen Sprachen zu heben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
