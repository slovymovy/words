                ],
                "senses": [
                    {
                        "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                        "entry_id": "ac995105-8c85-3199-a985-86eb141677a8",
                        "glosses": [
                            "Sammeln von Erkenntnissen und Erarbeiten von Zusammenhängen, die dann als Idee/Theorie vorgestellt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4bf2b9-2880-4b3f-9053-1754ef970468",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "Im Moment sieht dieser Artikel nach Theoriefindung aus."
                            },
                            {
                                "example_id": "0d64c05a-8e75-4331-b10a-0932eb060803",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "Sein praktischer Vorteil für die Theoriefindung besteht darin, dass Theorien mit wenigen und einfachen Annahmen leichter falsifizierbar sind als solche mit vielen und komplizierten Annahmen."
                            },
                            {
                                "example_id": "567d98e3-70f8-4b16-9c70-810931dbf466",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "Bitte belegen, dass es sich nicht um Theoriefindung handelt."
                            },
                            {
                                "example_id": "d4b01b16-b060-4485-9de0-efb74d799a4d",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "Ohne Belege fällt der Text unter Theoriefindung."
                            },
                            {
                                "example_id": "4bfe0d98-3317-4b30-8113-aed1f754e8de",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "Der Text ist unbelegt und riecht zudem stark nach Theoriefindung."
                            },
                            {
                                "example_id": "21a19dd0-2d5f-4bc9-9ea8-0fc83703992b",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "„Nachweise müssen aber sein, frei formulierte Texte gelten als unerwünschte ‚Theoriefindung‘.“"
                            },
                            {
                                "example_id": "8b8d42bf-94da-459a-86a1-7572fa5bdeef",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "„René Wellek (Yale), der die Literatur wie Rüdiger als eine Garantie gegen den Verfall in die Barbarei benannte, plädierte, nicht zum erstenmal, für eine Theoriefindung der Wertung (‚theory of criticism‘) als dringlichste Aufgabe der Literaturwissenschaft.“"
                            },
                            {
                                "example_id": "1fd3ac94-aab4-4efe-a96c-97575aee2ab7",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "„Eine Leitlinie in der Wikipedia besagt, dass man dort keine Theoriefindung betreiben darf.“"
                            },
                            {
                                "example_id": "a0c503ef-89f8-4b9d-96a2-058e36a362de",
                                "sense_id": "63afd6f2-5b90-3620-8a34-0add4e934faf",
                                "text": "„Dabei ist es generell fraglich, inwiefern „feste“ Begriffsdefinitionen für eine praxisorientierte Theoriefindung möglich und sinnvoll sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
