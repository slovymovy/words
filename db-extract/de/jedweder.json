                ],
                "senses": [
                    {
                        "sense_id": "681485b1-c59b-3b78-92a4-33fda1a642eb",
                        "entry_id": "522af117-e5e5-3cfd-b343-1ae7ab58413f",
                        "glosses": [
                            "jeder einzelne, jeder erdenkliche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5737d4e9-7175-406c-bd8c-05c041c29172",
                                "sense_id": "681485b1-c59b-3b78-92a4-33fda1a642eb",
                                "text": "Deine Argumentation entbehrt jedweder Grundlage!"
                            },
                            {
                                "example_id": "4648773b-66b8-4d9e-bf1f-523283237603",
                                "sense_id": "681485b1-c59b-3b78-92a4-33fda1a642eb",
                                "text": "„Meine Integration in den Arbeitsmarkt fand übrigens ohne jedwede Diskriminierung durch meine Herkunft statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b65c1197-712e-4420-9e73-be7f77ad49a0",
                        "source_entry_id": "522af117-e5e5-3cfd-b343-1ae7ab58413f",
                        "source_sense_id": "681485b1-c59b-3b78-92a4-33fda1a642eb",
                        "source_sense_description": "jeder einzelne, jeder erdenkliche",
                        "target_lang_word": "any",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "any",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                        "entry_id": "97ba879f-d7a7-3309-8fd4-64c919fa8f31",
                                        "glosses": [
                                            "To even the slightest extent, at all."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ecc7fb-6be3-4325-978a-b9543c62a731",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "If you get any taller, you'll start having to duck through doorways!"
                                            },
                                            {
                                                "example_id": "ffdc0591-b7d6-4e65-a172-02358568dd72",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "That doesn't bother me any. (chiefly US usage)"
                                            },
                                            {
                                                "example_id": "338f639e-cdb0-42f1-b558-d60e9dab3f51",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "You don't seem to be any the worse after such a tragic experience."
                                            },
                                            {
                                                "example_id": "73a08c09-7850-4cca-b47d-3729ad333d41",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "I will not remain here any longer."
                                            },
                                            {
                                                "example_id": "fad4da97-e983-46d9-8cf3-86af293cbd52",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "I wasn't any too easy in my mind."
                                            },
                                            {
                                                "example_id": "1571d99c-d61e-424a-a195-d6c163a254e2",
                                                "sense_id": "2b8594dc-3a84-31d2-b76c-2a602acaabf4",
                                                "text": "'That wouldn't surprise me any.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "any",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                        "entry_id": "2e54302a-1526-30df-8915-62278a1ee8a1",
                                        "glosses": [
                                            "One at all; at least one; at least one kind of; some; a positive quantity of."
                                        ],
                                        "tags": [
                                            "in the negative or interrogative",
                                            "with plural or uncountable nouns"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43487a6-de0d-4657-af1f-dc3f70d359d0",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "Near-synonym: some"
                                            },
                                            {
                                                "example_id": "683a6538-7ce1-40c2-a370-1588bc381687",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "Do you have any biscuits?"
                                            },
                                            {
                                                "example_id": "d295b5c8-7557-4eac-ab19-6d479c83c420",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "Do you have any food?"
                                            },
                                            {
                                                "example_id": "a5e8c977-2b3b-4d2c-a6a1-0c0d54ecd991",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "Do you think there's any point to/in trying to explain?"
                                            },
                                            {
                                                "example_id": "5bab7719-c407-44a6-a59e-4d20cd437076",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "It won't do you any good."
                                            },
                                            {
                                                "example_id": "c57c7c6d-f611-4119-bee6-7c63db447e48",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "\"Give me your pen.\" — \"I don't have any pen.\""
                                            },
                                            {
                                                "example_id": "70b02a3a-4f6c-42ba-a206-0726ddafa0a9",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "No man knoweth the Son, but the Father; neither knoweth any man the Father, save the Son."
                                            },
                                            {
                                                "example_id": "9bfcf591-524d-44e4-8cc4-fd1a4c71f416",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "In the old days, to my commonplace and unobserving mind, he gave no evidences of genius whatsoever. He never read me any of his manuscripts,[…], and therefore my lack of detection of his promise may in some degree be pardoned."
                                            },
                                            {
                                                "example_id": "6292b4e3-7b10-4a0e-b2a5-056861ff47f3",
                                                "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                        "entry_id": "2e54302a-1526-30df-8915-62278a1ee8a1",
                                        "glosses": [
                                            "A/an, each or some, no matter its/their identity or nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319407a3-d194-4306-8431-a5555e2bee54",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "Choose any item you want."
                                            },
                                            {
                                                "example_id": "bc7aefba-164d-4c7d-9d92-9cc3e6f9e8a0",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "Any person may apply."
                                            },
                                            {
                                                "example_id": "0d29bae9-b7e8-4500-8f80-36b30f50f97b",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "Press any key to continue."
                                            },
                                            {
                                                "example_id": "e182c799-9a6b-4a4d-9391-b47f3b462ab8",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "The character '#' matches any digit 0–9."
                                            },
                                            {
                                                "example_id": "b29b9f29-5f54-4b15-b074-06a00c59623f",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "Please bring some plates — any plates will do."
                                            },
                                            {
                                                "example_id": "e32b33ee-a4d1-4ec5-a272-c2b714174709",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "I'll drink any whiskey you've got."
                                            },
                                            {
                                                "example_id": "d369fafe-d95d-4941-9aba-618c84df7e17",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "This new-comer was a man who in any company would have seemed striking. In complexion fair, and with blue or gray eyes, he was tall as any Viking, as broad in the shoulder."
                                            },
                                            {
                                                "example_id": "cdac5ea6-8ecf-4507-9228-d40645300bf8",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "[a-z]: A range of characters that matches any character in the specified range. For example, [a-z] matches any lowercase alphabetic character in the range a through z."
                                            },
                                            {
                                                "example_id": "cb4613a8-f8df-4018-be8f-53a42fa7424e",
                                                "sense_id": "683ecd69-f1b6-32ed-be64-2d362b98f88d",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6caea27-b528-3a52-a824-a86d0ab87ddf",
                                        "entry_id": "2e54302a-1526-30df-8915-62278a1ee8a1",
                                        "glosses": [
                                            "An unspecified but imminent (second, minute, day etc.)."
                                        ],
                                        "tags": [
                                            "with time designations"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e8f108-1a4e-4f72-9997-faf28e587dce",
                                                "sense_id": "b6caea27-b528-3a52-a824-a86d0ab87ddf",
                                                "text": "They'll be arriving any day."
                                            },
                                            {
                                                "example_id": "6d3872d8-df3d-417f-8d57-0f38b4f88d8e",
                                                "sense_id": "b6caea27-b528-3a52-a824-a86d0ab87ddf",
                                                "text": "I expect the phone to ring at any moment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "any",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1a50aa-9d91-36b8-984a-ce16d95b0d60",
                                        "entry_id": "7ce1b659-b4d3-3a79-9908-adc89094ed19",
                                        "glosses": [
                                            "Any thing(s) or person(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cc4363-c4b5-4ac5-8fd7-63e5485e78b7",
                                                "sense_id": "9c1a50aa-9d91-36b8-984a-ce16d95b0d60",
                                                "text": "Any may apply."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb498c2c-77b9-4fd3-ba05-f0e54c9247cf",
                        "source_entry_id": "522af117-e5e5-3cfd-b343-1ae7ab58413f",
                        "source_sense_id": "681485b1-c59b-3b78-92a4-33fda1a642eb",
                        "source_sense_description": "jeder einzelne, jeder erdenkliche",
                        "target_lang_word": "n’importe quel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "n’importe quel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                        "entry_id": "bb650640-ff94-34c2-b753-26773953d135",
                                        "glosses": [
                                            "Au moins un ou une et quelquefois plus, en parlant d'une sélection garantie dans un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2072160b-6264-4216-855c-f5106b27202b",
                                                "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                                "text": "Ajuste, ô fils quelconque d’Ève,\nN’importe quel calcul à n’importe quel rêve, […]"
                                            },
                                            {
                                                "example_id": "8646219b-603e-407e-b569-a6e03774ba9d",
                                                "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                                "text": "Et, en effet, n’importe à quel moment on touchât à de certaines cordes immortellement tendues en lui, il s’en échappait des résonances à renverser celui qui aurait eu l’imprudence de les effleurer »."
                                            },
                                            {
                                                "example_id": "5ff5473f-f25b-4dd9-9309-274d246400e1",
                                                "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                                "text": "Mais une fois établis les principes de la comptabilité, n’importe quel scribe s'en serait tiré au moins aussi bien que moi."
                                            },
                                            {
                                                "example_id": "32975e49-4121-4625-a923-379dcc658ea7",
                                                "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                                "text": "M. Louis Michel continue à donner l'impression au monde entier que le Congo est une porcherie où n'importe quel ignare peut devenir Chef de l’État et s'amuser à diriger n'importe comment."
                                            },
                                            {
                                                "example_id": "4fb3bd53-6d0e-4afa-a8b8-0f94af59b000",
                                                "sense_id": "f367a6b0-afdd-3410-8f57-437612c5a855",
                                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
