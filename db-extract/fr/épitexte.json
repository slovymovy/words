                        "entry_id": "32c90e47-f6e5-338f-9647-6902ecca040b",
                        "glosses": [
                            "Ensemble des éléments textuels et visuels qui entourent une œuvre écrite tels la présentation, la publicité, etc. Avec le péritexte, il forme le paratexte."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "6646f8d5-477b-4eac-a6ed-4938d84cece9",
                                "sense_id": "2c4398b0-186c-37f1-906d-81fc72b6e130",
                                "text": "Il est constitué d’un péritexte et d’un épitexte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
