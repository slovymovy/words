                        "glosses": [
                            "vlekje dat is ontstaan door het morsen van druppels verf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed79cf1-b606-40b0-96ee-49d131f9d0cd",
                                "sense_id": "e83665ff-7073-3391-bc42-7f5d04d7e736",
                                "text": "`Wie is hier oud?'Ids vult de deuropening. Zijn haar staat woest overeind en hij heeft verfspatten op zijn broek."
                            },
                            {
                                "example_id": "9f0e4b90-cb97-4132-93fa-cb2f29532e89",
                                "sense_id": "e83665ff-7073-3391-bc42-7f5d04d7e736",
                                "text": "De geschonken schets, inclusief de verfspatten van het schilderen, is vanaf 26 februari te zien, maakte het museum woensdag bekend. Directeur Beatrix Ruf noemt de schets een geweldige aanvulling op de collectie met werken van Karel Appel. Het museum maakte in het verleden al dankbaar gebruik van de schets voor de restauratie van de beroemde wandschildering."
                            }
                        ]
