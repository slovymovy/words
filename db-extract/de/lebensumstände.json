                "senses": [
                    {
                        "sense_id": "a4df46f6-5769-3983-b3a9-04211a8a95d1",
                        "entry_id": "1d0a6783-d93a-3a8a-938f-c9e24ef1208d",
                        "glosses": [
                            "Gesamtheit der Bedingungen, die das Leben einer Person beeinflussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f32f04-896e-4218-9eda-ff3004221029",
                                "sense_id": "a4df46f6-5769-3983-b3a9-04211a8a95d1",
                                "text": "„Csomas Lebensumstände mögen in Kanum besser gewesen sein, doch begannen jetzt die Jahre der Einsamkeit und Entbehrung ihren Tribut an seiner geistigen und seelischen Gesundheit zu fordern.“"
                            },
                            {
                                "example_id": "a8dc1058-d518-42b4-a922-fbfb52662555",
                                "sense_id": "a4df46f6-5769-3983-b3a9-04211a8a95d1",
                                "text": "Die Vergleichsgruppe als Kontrollgruppe sollte hinsichtlich der Faktoren Alter, Geschlecht und Lebensumstände mit den Mehrfachauffälligen vergleichbar sein."
                            },
                            {
                                "example_id": "49050350-a12f-4914-80b9-6d5d9c5ed09d",
                                "sense_id": "a4df46f6-5769-3983-b3a9-04211a8a95d1",
                                "text": "„Die besseren Lebensumstände ersparen uns das zwar, aber dafür leben wir in der Single-Hauptstadt aneinander vorbei.“"
                            },
                            {
                                "example_id": "bbc2eee8-9e9b-47cd-b015-ac287e991fb4",
                                "sense_id": "a4df46f6-5769-3983-b3a9-04211a8a95d1",
                                "text": "„Die Diskrepanz der Lebensumstände war frappierend, die Implikationen machten mich schaudern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
