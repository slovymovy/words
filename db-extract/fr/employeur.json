                "senses": [
                    {
                        "sense_id": "e1f32432-5a28-35e5-9ff4-c5b65db32a55",
                        "entry_id": "d781056c-ea70-3ccc-b11a-e6af4887b987",
                        "glosses": [
                            "Personne, entreprise ou autre organisme qui emploie des salariés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2970f2f7-9e65-4286-a865-4f41b2268b58",
                                "sense_id": "e1f32432-5a28-35e5-9ff4-c5b65db32a55",
                                "text": "Le non-paiement des cotisations sociales est constitutif d'infraction pénale dans le chef de l’employeur, ou de ses préposés et mandataires qui ont la responsabilité du paiement des cotisations."
                            },
                            {
                                "example_id": "f1d57259-4274-40c1-81b3-4a914576e287",
                                "sense_id": "e1f32432-5a28-35e5-9ff4-c5b65db32a55",
                                "text": "On voit aussi en quoi la notion centrale de co-investissement, présente chez Gary Becker, peut être reconceptualisée à la lumière de ces développements : pour pouvoir exister, le co-investissement employeur-salarié doit être précédé d’un investissement du seul salarié dans des formations plutôt générales et pré-adaptées aux exigences des employeurs c’est-à-dire permettant d’acquérir ces « qualités sociales », conditions de contrats implicites qui permettront des co-investissements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80b2d798-caca-4c27-8463-a5631ed87409",
                        "source_entry_id": "d781056c-ea70-3ccc-b11a-e6af4887b987",
                        "source_sense_id": "e1f32432-5a28-35e5-9ff4-c5b65db32a55",
                        "target_lang_word": "Arbeitgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                        "entry_id": "7f0b45f9-8e83-33b7-ad1e-698fe56952bd",
                                        "glosses": [
                                            "Person oder Firma, die Leute als Arbeiter oder Angestellte einstellt, beschäftigt und ihnen dafür Geld bezahlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74455a4-76de-462f-9791-a1fe82299cd1",
                                                "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                                "text": "Die Arbeitgeber haben vergangene Woche bereits ein dreiprozentiges Verdienstplus in Aussicht gestellt."
                                            },
                                            {
                                                "example_id": "d0935c45-8512-41f8-bbdd-3cecb49b5652",
                                                "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                                "text": "„Aber auch für die Menschen in der Region war die Straßenbahn ein bedeutender Arbeitgeber geworden.“"
                                            },
                                            {
                                                "example_id": "2e5671d4-a962-48b0-8087-ec3ef6460ff6",
                                                "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                                "text": "„Die Arbeitslosen waren ihre Arbeitgeber.“"
                                            },
                                            {
                                                "example_id": "43c1bb3a-9743-4057-939d-b989f58685c9",
                                                "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                                "text": "„Henriette Schneider bereitete den Haushalt ihrer Arbeitgeber auf das Schlimmste vor.“"
                                            },
                                            {
                                                "example_id": "b2b43b13-19b8-42ee-9201-b59d9deb005f",
                                                "sense_id": "3f5e3a72-6bf2-3de0-8f48-64fe18b82b95",
                                                "text": "„Sie berichten, dass Timos Arbeitgeber ein ausländerfeindliches Hass-Posting auf seiner Facebook-Seite entdeckt und ihm gekündigt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "445c5514-fbf4-4205-a29a-490ad5cb3efd",
                        "source_entry_id": "d781056c-ea70-3ccc-b11a-e6af4887b987",
