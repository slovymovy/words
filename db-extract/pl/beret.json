                    },
                    {
                        "translation_id": "ad823215-556e-4dfc-b608-3280ec80a3c1",
                        "source_entry_id": "970593a7-8f73-3f93-8c29-16d27acaf9ca",
                        "source_sense_id": "23c4c945-2333-3ce4-9a7c-dc9970a92d78",
                        "target_lang_word": "baret",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baret",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0143de78-0d4f-3783-b92d-d1dd9005aebf",
                                        "entry_id": "35381331-656c-37ad-a4af-16dac61d09dd",
                                        "glosses": [
                                            "druh pokrývky hlavy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320e2b32-0967-4ebc-962b-5fc767bf9651",
                                                "sense_id": "0143de78-0d4f-3783-b92d-d1dd9005aebf",
                                                "text": "Do zahrádky vešel statný, mladý muž, jenž sejmuv baret uctivě pozdravil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6170326a-0aa5-4d56-87ab-9e6f23657349",
                        "source_entry_id": "970593a7-8f73-3f93-8c29-16d27acaf9ca",
                        "source_sense_id": "23c4c945-2333-3ce4-9a7c-dc9970a92d78",
                        "target_lang_word": "béret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e94d1d-ea35-36d7-8342-eb7b1e3529fe",
                                        "entry_id": "573bd75c-b9a6-331b-a09b-f8be6297d517",
                                        "glosses": [
                                            "Toque de laine, ronde et plate, qui est la coiffure traditionnelle des paysans basques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5938a1dc-6c56-3c5b-928f-92fa485f6ce5",
                                        "entry_id": "573bd75c-b9a6-331b-a09b-f8be6297d517",
                                        "glosses": [
                                            "Coiffure spéciale de certains corps de troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee84402-4da0-47ca-b7e9-c10730b40910",
                                                "sense_id": "5938a1dc-6c56-3c5b-928f-92fa485f6ce5",
                                                "text": "En signe de non-conformisme, et pour accroître la violence de leur masque, ils portaient le béret exagérément penché sur l’oreille, le cuir en dehors. Plus la galette était aplatie, raide, énorme, voisine de l’auréole, plus ils en tiraient vanité. D’aucuns, même, y glissaient une charpente d’osier…"
                                            },
                                            {
                                                "example_id": "1db34474-aa38-4f21-8e87-bb058374dba3",
                                                "sense_id": "5938a1dc-6c56-3c5b-928f-92fa485f6ce5",
                                                "text": "Dès le moment où le lieutenant entra dans la pièce, je sus ce qui m'attendait. Coupé par un immense béret, son petit visage bien rasé, triangulaire et anguleux comme celui d'un fennec, souriait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                        "entry_id": "573bd75c-b9a6-331b-a09b-f8be6297d517",
                                        "glosses": [
                                            "Toute coiffure de la même forme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8a1f13d-00b0-43a0-9752-42620343e5ee",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "C’est vers cette latitude que les bérets commencent à se montrer ; ils sont tous bleus, et leur forme élégante est bien supérieure à celle des chapeaux."
                                            },
                                            {
                                                "example_id": "d578ac04-2bea-4c05-bb02-569386c70dfa",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "Deux minutes après, un foulard de coton au cou et son béret « Le Vengeur » planté sur la tignasse épaisse, il attendait dans une posture recueillie et digne les ultimes recommandations paternelles."
                                            },
                                            {
                                                "example_id": "edf3966d-fc47-4389-92c2-fe2edeb2142c",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "[…], Lestrange, procédant au rite habituel, fit mine d'enlever le béret, piqué d'une rose, dont Aïssa avait, ce jour-là, gaminement coiffé ses lourds cheveux..."
                                            },
                                            {
                                                "example_id": "961c42b8-f71c-4e6c-8d3d-12e31b3bf70d",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "Partout des nuées d'oiseaux […]. Ces volatiles sont si peu farouches, que l'un d'eux, prestement, enleva le béret d'un des matelots."
                                            },
                                            {
                                                "example_id": "8ce48b52-f7cc-481b-85b4-6b126760210e",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "- Je veux un bèret, un simple bèret, un bèret frââânçais.\n- (Ah nom de Dieu…) Voilà, monsieur…\n- À la bonne heure. Parce que le bèret, y a qu’ça qui m’va. La casquette, c’est bon pour les ouvriers ; le chapeau, c’est pas pratique ; tandis que le bèret, c’est simple, c’est chic, c’est coquet !"
                                            },
                                            {
                                                "example_id": "c8038134-f4ce-44d2-9acf-7e82f2169e5f",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "Une quarantaine d’individus hilares et rougeauds se reconnurent à leurs bérets en auvent et à leurs gourdes en bandoulière."
                                            },
                                            {
                                                "example_id": "b3fadff7-ec81-48f7-81e9-2e7259a258a1",
                                                "sense_id": "868e5207-1807-3318-8337-3aad67554b75",
                                                "text": "Je sais bien qu’il devait être vêtu comme l’étaient les petits garçons de son âge, mais quand je le revois maintenant, je dois effacer le chapeau melon que je vois sur sa tête et le remplacer par un béret de matelot, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f257b4e1-ff8d-474f-aa91-facea229533e",
                        "source_entry_id": "970593a7-8f73-3f93-8c29-16d27acaf9ca",
                        "source_sense_id": "23c4c945-2333-3ce4-9a7c-dc9970a92d78",
                        "target_lang_word": "boina",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boina",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "15c3c979-8a69-3330-a1f7-b48cb43ce703",
                                        "entry_id": "922c7df8-215f-3f0d-a8bc-11c3cb039de8",
                                        "glosses": [
                                            "Gorra redonda y chata, de lana, de una sola pieza y de uno u otro color."
                                        ],
                                        "tags": [
                                            "Vestimenta"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804ed77a-d2f5-45ef-bda0-82506a1f81b6",
                                                "sense_id": "15c3c979-8a69-3330-a1f7-b48cb43ce703",
                                                "text": "«Mucho —dice Fader. Levanta la mirada sobre sus delgadas gafas de lectura. Su barba descuidada y su boina vasca le dan aspecto de predicador. Reúne las carpetas con movimientos lentos»."
                                            },
                                            {
                                                "example_id": "cdf9d65f-7f89-48ad-951d-aa6e33c31546",
                                                "sense_id": "15c3c979-8a69-3330-a1f7-b48cb43ce703",
                                                "text": "«El Generalísimo vestía camisa azul y boina roja»."
                                            },
                                            {
                                                "example_id": "ecec21d3-c45f-43ef-b841-319e2de35c41",
                                                "sense_id": "15c3c979-8a69-3330-a1f7-b48cb43ce703",
                                                "text": "«—¿Qué es lo que han hecho? —preguntó Martín a uno de la partida que llevaba una boina a rayas»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
