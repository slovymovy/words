                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замахиваться",
                                "target_lang_sense_clarification": "поднимать руку или предмет для нанесения удара или броска"
                            },
                            {
                                "target_lang_word": "готовиться к удару",
                                "target_lang_sense_clarification": "общая фраза для подготовки к физическому действию"
