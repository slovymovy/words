                "senses": [
                    {
                        "sense_id": "bb6fd7be-8287-333c-b42c-7bcac0af4ef5",
                        "entry_id": "51e3cd44-0b18-320e-ac88-1b9974e5b701",
                        "glosses": [
                            "met veel mensen of zaken op één plaats samen komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38860f41-ffc0-49d1-a259-08e2fb16519b",
                                "sense_id": "bb6fd7be-8287-333c-b42c-7bcac0af4ef5",
                                "text": "Allemaal kijken ze nu omhoog, naar de wolken die samendrommen in een woeste dans."
                            },
                            {
                                "example_id": "76737786-cee9-476d-a314-8f0bbb99e04f",
                                "sense_id": "bb6fd7be-8287-333c-b42c-7bcac0af4ef5",
                                "text": "Het komt vaker voor dat zeeleeuwen samendrommen in de haven van Astoria. De dieren jagen daar op zalm en spiering, die in deze tijd van het jaar vanuit de Columbia-rivier naar zee trekken. Meestal gaat het om honderden zeeleeuwen, maar het worden er de laatste jaren steeds meer."
                            },
                            {
                                "example_id": "745f4ef3-5e0d-4a26-8064-db8d3f9cf2b2",
                                "sense_id": "bb6fd7be-8287-333c-b42c-7bcac0af4ef5",
                                "text": "Maar de Romeinse soldaten rukten dicht opeen op achter een muur van schilden en wanneer de vijand voor hen samendromde stootten ze de gladius schuin omhoog naar het hart of de lever van de vijand."
                            }
                        ]
                    }
