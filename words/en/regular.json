{
    "word_family": [
        "regularity",
        "regularize",
        "regularly",
        "irregular",
        "irregularity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53f0034c-ca76-378a-9ea6-257bf90cdbbf",
                    "sense_definition": "Happening at constant, predictable, or frequent intervals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made <w>regular</w> visits to the library every Saturday morning.",
                            "target_lang_translations": {
                                "ru": "Он наносил <w>регулярные</w> визиты в библиотеку каждое субботнее утро."
                            }
                        },
                        {
                            "text": "The doctor advised her to maintain <w>regular</w> exercise for better health.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал ей поддерживать <w>регулярные</w> физические нагрузки для улучшения здоровья."
                            }
                        }
                    ],
                    "synonyms": [
                        "periodic",
                        "frequent",
                        "cyclical"
                    ],
                    "antonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "regular intervals",
                        "regular exercise",
                        "regular basis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий через постоянные, предсказуемые или частые промежутки времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулярный",
                                "target_lang_sense_clarification": "происходящий через равные промежутки"
                            },
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "систематический"
                            },
                            {
                                "target_lang_word": "частый",
                                "target_lang_sense_clarification": "повторяющийся многократно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6681cfd1-ba79-3373-952c-6fb8b39d35f3",
                    "sense_definition": "Having the expected characteristics or appearances; normal, ordinary, or standard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a <w>regular</w> coffee without any extra flavors.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел <w>обычный</w> кофе без каких-либо добавок."
                            }
                        },
                        {
                            "text": "The store sells both <w>regular</w> and organic vegetables.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются как <w>обычные</w>, так и органические овощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "normal",
                        "ordinary",
                        "standard",
                        "usual"
                    ],
                    "antonyms": [
                        "outlandish",
                        "weird"
                    ],
                    "common_phrases": [
                        "regular size",
                        "regular price",
                        "regular guy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий ожидаемые характеристики или внешний вид; нормальный, обычный или стандартный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "рядовой, привычный"
                            },
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "соответствующий норме"
                            },
                            {
                                "target_lang_word": "стандартный",
                                "target_lang_sense_clarification": "типовой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e274091d-df45-330e-a9b3-027e41352759",
                    "sense_definition": "Having a constant pattern or showing evenness of form or appearance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was designed with <w>regular</w> rows of colorful flowers.",
                            "target_lang_translations": {
                                "ru": "Сад был спроектирован с <w>ровными</w> рядами ярких цветов."
                            }
                        },
                        {
                            "text": "She has very <w>regular</w> features and a symmetrical face.",
                            "target_lang_translations": {
                                "ru": "У неё очень <w>правильные</w> черты и симметричное лицо."
                            }
                        }
                    ],
                    "synonyms": [
                        "uniform",
                        "even",
                        "consistent"
                    ],
                    "antonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "regular pattern",
                        "regular shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий постоянный узор или демонстрирующий равномерность формы или внешнего вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правильный",
                                "target_lang_sense_clarification": "симметричный, пропорциональный"
                            },
                            {
                                "target_lang_word": "ровный",
                                "target_lang_sense_clarification": "однородный по форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abded4e0-d1b8-38f6-b462-26d39b83e17e",
                    "sense_definition": "Following a set or common pattern according to the normal rules of a given language.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word walked is the past tense of a <w>regular</w> verb.",
                            "target_lang_translations": {
                                "ru": "Слово walked — это форма прошедшего времени <w>правильного</w> глагола."
                            }
                        },
                        {
                            "text": "Students find it easier to learn <w>regular</w> verbs than irregular ones.",
                            "target_lang_translations": {
                                "ru": "Студентам легче учить <w>правильные</w> глаголы, чем неправильные."
                            }
                        }
                    ],
                    "synonyms": [
                        "standard",
                        "conventional"
                    ],
                    "antonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "regular verb",
                        "regular plural"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий установленному или общему образцу в соответствии с правилами языка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правильный",
                                "target_lang_sense_clarification": "лингв., подчиняющийся общим правилам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d161d82-6b36-3d21-be1b-c7cc342855e1",
                    "sense_definition": "Having bowel movements at constant intervals in the expected way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eating enough fiber is essential to keep your digestion <w>regular</w>.",
                            "target_lang_translations": {
                                "ru": "Употребление достаточного количества клетчатки необходимо для того, чтобы пищеварение было <w>регулярным</w>."
                            }
                        },
                        {
                            "text": "The patient reported that his bathroom habits were <w>regular</w>.",
                            "target_lang_translations": {
                                "ru": "Пациент сообщил, что стул у него <w>регулярный</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "steady"
                    ],
                    "antonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "keep you regular"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий регулярное опорожнение кишечника ожидаемым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулярный",
                                "target_lang_sense_clarification": "о работе организма"
                            },
                            {
                                "target_lang_word": "нормальный",
                                "target_lang_sense_clarification": "о пищеварении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a927dfc-8d71-3263-9b0f-fff245d93b0f",
                    "sense_definition": "Used for emphasis to mean utter, downright, or a complete example of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>regular</w> genius when it comes to fixing old cars.",
                            "target_lang_translations": {
                                "ru": "Он <w>настоящий</w> гений, когда дело касается ремонта старых машин."
                            }
                        },
                        {
                            "text": "The storm turned out to be a <w>regular</w> disaster for the small town.",
                            "target_lang_translations": {
                                "ru": "Шторм обернулся <w>сущим</w> бедствием для маленького городка."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "thorough",
                        "downright",
                        "utter"
                    ],
                    "common_phrases": [
                        "regular genius",
                        "regular hero"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used for emphasis in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления в значении «настоящий», «совершенный» или «полный»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "для усиления качества"
                            },
                            {
                                "target_lang_word": "сущий",
                                "target_lang_sense_clarification": "полный, абсолютный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad9bc45-8c92-3540-ad6e-82fca0689c67",
                    "sense_definition": "In geometry, having all sides of the same length and all angles of the same size.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A square is a <w>regular</w> polygon because all its sides are equal.",
                            "target_lang_translations": {
                                "ru": "Квадрат — это <w>правильный</w> многоугольник, потому что все его стороны равны."
                            }
                        },
                        {
                            "text": "The architect used <w>regular</w> hexagons in the floor tile design.",
                            "target_lang_translations": {
                                "ru": "Архитектор использовал <w>правильные</w> шестиугольники в дизайне напольной плитки."
                            }
                        }
                    ],
                    "synonyms": [
                        "equilateral",
                        "equiangular"
                    ],
                    "antonyms": [
                        "irregular"
                    ],
                    "common_phrases": [
                        "regular polygon",
                        "regular pentagon"
                    ],
                    "target_lang_definitions": {
                        "ru": "В геометрии: имеющий все стороны равной длины и все углы равной величины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правильный",
                                "target_lang_sense_clarification": "геометр., равносторонний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33bc09ea-0e1f-3a35-97bf-5e211f7a0a81",
                    "sense_definition": "Bound by religious rule; belonging to a monastic or religious order.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>regular</w> clergy lived in monasteries under strict communal rules.",
                            "target_lang_translations": {
                                "ru": "<w>Чёрное</w> духовенство жило в монастырях по строгим общинным правилам."
                            }
                        },
                        {
                            "text": "He studied the history of <w>regular</w> orders in medieval Europe.",
                            "target_lang_translations": {
                                "ru": "Он изучал историю <w>монашеских</w> орденов в средневековой Европе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "regular clergy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный религиозным уставом; принадлежащий к монашескому или религиозному ордену."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белое",
                                "target_lang_sense_clarification": "о духовенстве, живущем по уставу"
                            },
                            {
                                "target_lang_word": "регулярный",
                                "target_lang_sense_clarification": "церк., принадлежащий к ордену"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89410a48-38b8-3cd1-b11d-a05cd45aa798",
                    "sense_definition": "A frequent or routine visitor to a specific establishment, such as a bar or cafe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender already had a drink ready for one of his <w>regulars</w>.",
                            "target_lang_translations": {
                                "ru": "У бармена уже была готова выпивка для одного из его <w>завсегдатаев</w>."
                            }
                        },
                        {
                            "text": "As a <w>regular</w> at the cafe, she always gets the best table.",
                            "target_lang_translations": {
                                "ru": "Как <w>постоянному клиенту</w> кафе, ей всегда достается лучший столик."
                            }
                        }
                    ],
                    "synonyms": [
                        "frequenter",
                        "habitué",
                        "patron"
                    ],
                    "common_phrases": [
                        "bar regulars",
                        "local regulars"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частый или постоянный посетитель определенного заведения, например, бара или кафе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завсегдатай",
                                "target_lang_sense_clarification": "постоянный посетитель"
                            },
                            {
                                "target_lang_word": "постоянный клиент",
                                "target_lang_sense_clarification": "регулярно пользующийся услугами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80d89aac-4912-3b86-af81-d1d512fcb2f2",
                    "sense_definition": "A member of the permanent, professional armed forces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army consists of both <w>regulars</w> and part-time reserve soldiers.",
                            "target_lang_translations": {
                                "ru": "Армия состоит как из <w>кадровых военных</w>, так и из солдат резерва."
                            }
                        },
                        {
                            "text": "He has been a <w>regular</w> in the infantry for over ten years.",
                            "target_lang_translations": {
                                "ru": "Он служит в <w>регулярной</w> пехоте уже более десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "regular serviceman"
                    ],
                    "antonyms": [
                        "non-regular"
                    ],
                    "common_phrases": [
                        "army regulars"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военнослужащий постоянных, профессиональных вооруженных сил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадровый военный",
                                "target_lang_sense_clarification": "профессиональный солдат"
                            },
                            {
                                "target_lang_word": "солдат регулярных войск",
                                "target_lang_sense_clarification": "член постоянной армии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f06e7db0-0fce-3d57-b1a2-d19a89f6e54f",
                    "sense_definition": "In a regular manner; on a consistent basis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to make sure you are eating <w>regular</w> to stay healthy.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно следить за тем, чтобы питаться <w>регулярно</w>, чтобы оставаться здоровым."
                            }
                        },
                        {
                            "text": "He attends church <w>regular</w> every Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Он <w>постоянно</w> посещает церковь каждое воскресное утро."
                            }
                        }
                    ],
                    "synonyms": [
                        "regularly"
                    ],
                    "common_phrases": [
                        "feed them regular"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used instead of 'regularly' in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Регулярным образом; на постоянной основе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулярно",
                                "target_lang_sense_clarification": "постоянно"
                            },
                            {
                                "target_lang_word": "правильно",
                                "target_lang_sense_clarification": "разг., систематически"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}