                "senses": [
                    {
                        "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                        "entry_id": "4ce151a3-3858-3c9e-9997-2952d3190700",
                        "glosses": [
                            "sehr starkes Gefühl, das eine Person antreibt, tätig zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6856a111-7b7d-4b7c-9fcf-f4f4a941a831",
                                "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                                "text": "Wenn er Stress hat, reagiert er immer mit Arbeitswut."
                            },
                            {
                                "example_id": "7b83193b-dc1a-4f7e-b988-309c619dbbd0",
                                "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                                "text": "Sie kann eine Arbeitswut an den Tag legen, die einem Angst einjagt."
                            },
                            {
                                "example_id": "71144b96-b574-415e-90fc-984177636a68",
                                "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                                "text": "„Im Gegensatz zu seiner früheren Arbeitswut begann er jetzt, von dem Arbeitskommando fortzulaufen und lange Wanderungen die Straße entlang zu unternehmen.“"
                            },
                            {
                                "example_id": "ef1e2e9a-afca-4bcc-b4be-18345538955e",
                                "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                                "text": "„Schon in jenen jungen Jahren steigerte sich mein Vater in eine regelrechte Arbeitswut hinein, die sich auch im künstlerischen Bereich austobte.“"
                            },
                            {
                                "example_id": "11f4e617-cfb9-4289-bd2e-8b17eccebd31",
                                "sense_id": "50a55854-4034-3668-9f67-491ac426b8d0",
                                "text": "„Trotz besessener Lektüre und irrsinniger Arbeitswut gelingt es ihm nicht, die Flut der wabernden Sprache einzudämmen und zu verdichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
