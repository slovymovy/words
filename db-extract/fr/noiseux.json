                        ],
                        "examples": [
                            {
                                "example_id": "46b558ab-2b9c-4eb7-a463-1ac17ee9782b",
                                "sense_id": "6a88e8cc-597b-3e7d-9686-1770261df482",
                                "text": "Parquoy il est craint de tout le monde quand il est au signe du Taureau, il est mauvais, gourmand, paillard, noiseux, meurtrier, forceur & violeur de femmes"
                            }
                        ]
                    }
