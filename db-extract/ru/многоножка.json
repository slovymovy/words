                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4e581cf-5e1d-475f-b752-8883cef3e068",
                        "source_entry_id": "35faa94b-6dbd-3e6f-808a-8925f99bb356",
                        "source_sense_id": "d83ebd0a-f352-3a57-b0a5-77bf3fec4111",
                        "target_lang_word": "mille-pattes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mille-pattes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                        "entry_id": "b4e6d066-4580-3b87-8dfe-f62873744251",
                                        "glosses": [
                                            "Nom d’un sous-embranchement d’arthropodes qui ont un très grand nombre de pattes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7a035b-3294-4ee8-8a90-27681db8dd99",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Un serpent rim rock crowned snake (Tantilla oolitica) a été retrouvé mort avec un mille-pattes des Caraïbes dans la gueule."
                                            },
                                            {
                                                "example_id": "b0cc4cf0-880b-45f8-af81-c51ed2573518",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Une créature fossilisée ressemblant à un mille-pattes mise au jour en Écosse est devenue le plus ancien animal terrestre découvert jusqu'à maintenant. Ce pionnier de la vie a vécu il y a 425 millions d'années."
                                            },
                                            {
                                                "example_id": "0ebd4850-b959-4132-b65e-b43ca0fa4312",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Il me tardait que ce fût fini. Je me faisais horreur de prolonger cette scène (comme quand on n’ose pas appuyer le talon sur le mille-pattes)."
                                            },
                                            {
                                                "example_id": "3d63e066-8294-4314-91f5-501059bcf89c",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Les mille-pattes étaient parmi les premiers animaux à respiration aérienne sur Terre, note l'étude, et certaines espèces éteintes ont atteint plus de deux mètres de long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255c2255-383f-3b67-a8ac-6ff42f3b68e7",
                                        "entry_id": "b4e6d066-4580-3b87-8dfe-f62873744251",
                                        "glosses": [
                                            "Poids lourd, notamment semi-remorque."
                                        ],
                                        "tags": [
                                            "CB"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef3f5306-8340-4347-8a3e-43f64a0bd372",
                        "source_entry_id": "35faa94b-6dbd-3e6f-808a-8925f99bb356",
                        "source_sense_id": "d83ebd0a-f352-3a57-b0a5-77bf3fec4111",
                        "target_lang_word": "millepatte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millepatte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "418ca385-4e35-37aa-8140-1ccfa74ad1f9",
                                        "entry_id": "8017ea0e-9d1b-30c2-9743-6413aed653cd",
                                        "glosses": [
                                            "Variante orthographique de mille-pattes."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77fc2921-4c91-43c2-a7fa-c8b86b89566f",
                                                "sense_id": "418ca385-4e35-37aa-8140-1ccfa74ad1f9",
                                                "text": "Il a déjà été fait mention du millepatte et des millepattes ou du tire-fesse qui se transforme en des tire-fesses au pluriel, et la règle est véritablement beaucoup plus rationnelle à présent."
                                            },
                                            {
                                                "example_id": "bd41f87f-ae4f-45d3-9b3a-4bf15ead02ca",
                                                "sense_id": "418ca385-4e35-37aa-8140-1ccfa74ad1f9",
                                                "text": "La biodiversité des détritivores, tels que les millepattes et les cloportes, contribuent également de manière importante à la fragmentation des feuilles mortes et à sa décomposition. Ainsi, l’augmentation des populations de détritivores dans les agroécosystèmes peut par conséquent améliorer le recyclage des nutriments et la croissance des plantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
