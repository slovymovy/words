                "senses": [
                    {
                        "sense_id": "438cd19f-4a29-3183-9e22-5b6a627e1148",
                        "entry_id": "8a5e60d7-d7e2-3a04-bf3e-080fc1f4c3f1",
                        "glosses": [
                            "Variante de racoler."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fbbfe377-d69a-4cac-90c5-1b2d3590fd5e",
                                "sense_id": "438cd19f-4a29-3183-9e22-5b6a627e1148",
                                "text": "D’ailleurs, à coup d’annonces, à force de voyageurs, en offrant des avantages illusoires aux abonnés, on en avait raccolé deux mille."
                            },
                            {
                                "example_id": "fbd61e9d-9310-4414-bcf9-ec19c84f1144",
                                "sense_id": "438cd19f-4a29-3183-9e22-5b6a627e1148",
                                "text": "Je ne serais pas ici si je n’avais envie de me faire raccoler."
                            },
                            {
                                "example_id": "80c670e6-1a92-4c24-ab33-cdffab0e6e0e",
                                "sense_id": "438cd19f-4a29-3183-9e22-5b6a627e1148",
                                "text": "Montalembert, qui avait eu la honte de raccoler Bonaparte, n’eut même pas la peine de raccoler ceux-ci."
                            }
                        ]
                    }
                ],
