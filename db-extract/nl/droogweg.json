                "translations": [
                    {
                        "translation_id": "ded5e6bb-3c04-401d-adb3-ade7ac6a602f",
                        "source_entry_id": "0907b53a-dea8-3787-bf6c-8407053cd59f",
                        "source_sense_id": "8dd05e30-f76d-3388-8b40-03a8aa92ce61",
                        "source_sense_description": "op een neutrale toon",
                        "target_lang_word": "trocken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trocken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5167510-f01c-3cb8-8904-03ea914bd635",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "frei von Feuchtigkeit oder Nässe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbdf37ea-b026-41bd-b95a-630731477f26",
                                                "sense_id": "c5167510-f01c-3cb8-8904-03ea914bd635",
                                                "text": "Das Handtuch ist trocken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3177086-eb58-3f5b-ab8d-7c69729c9d9f",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "dürr, verdorrt, verdörrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97090b2-916f-4ad3-9056-43680d1d57aa",
                                                "sense_id": "b3177086-eb58-3f5b-ab8d-7c69729c9d9f",
                                                "text": "Die trockenen Blumen können auf den Komposthaufen geworfen werden."
                                            },
                                            {
                                                "example_id": "ca3e8683-a606-4590-81e1-d75a2b993324",
                                                "sense_id": "b3177086-eb58-3f5b-ab8d-7c69729c9d9f",
                                                "text": "Die Moore Weißrusslands speichern CO2. Liegen sie trocken, entweicht das Gas."
                                            },
                                            {
                                                "example_id": "b412a3cc-1657-4d4a-9d88-60f7e225d498",
                                                "sense_id": "b3177086-eb58-3f5b-ab8d-7c69729c9d9f",
                                                "text": "Wüsten sind die ultimativen Grenzgebiete. Hier präsentiert sich die Erde wie ein anderer Planet - weite, trockene Regionen, oft steinige oder sandige Einöden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fe60bf33-cc41-352c-9871-e306792a1af8",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "sachlich, nüchtern; langweilig, fade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b28b539-9aa0-45a6-b4b4-d09e92eac0ae",
                                                "sense_id": "fe60bf33-cc41-352c-9871-e306792a1af8",
                                                "text": "Ein trockener Vortrag begeistert wenig Zuhörer."
                                            },
                                            {
                                                "example_id": "05b1c854-9c19-463a-8c42-bd591372046b",
                                                "sense_id": "fe60bf33-cc41-352c-9871-e306792a1af8",
                                                "text": "Wissenschaft ist trocken und kompliziert – denken viele. Doch in einigen deutschen Uni-Städten gibt es jetzt so genannte Science-Slams. Dabei vermitteln junge Wissenschaftler Forschung so, dass sie Spaß macht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "89130d59-f928-3bd6-912d-5cc7429923a9",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "wenig Zucker enthaltend"
                                        ],
                                        "tags": [
                                            "Wein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37bb06cd-ccbf-41ec-970f-77b4ac868458",
                                                "sense_id": "89130d59-f928-3bd6-912d-5cc7429923a9",
                                                "text": "Bevorzugen Sie lieblichen oder trockenen Wein?"
                                            },
                                            {
                                                "example_id": "456dc458-db5e-4a0a-bb6f-0cc92cb451a7",
                                                "sense_id": "89130d59-f928-3bd6-912d-5cc7429923a9",
                                                "text": "In einigen Fällen (ca. 1/3) entwickelt sich aus dem Barrett-Syndrom [=Speiseröhren-Entzündung wegen zuviel Magensäure] Speiseröhrenkrebs. Betroffene sollten ihre Lebensweise verändern: trockener Wein, Obst, Süßigkeiten und Kaffee - aber auch Stress und Zigaretten regen die Produktion von Magensäure an."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3a01c65d-bc4a-366e-806f-19a1a5b9285e",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "(nach Alkoholproblem) keinen Alkohol mehr trinkend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3ef918-269d-470f-8f39-1cf8a201e771",
                                                "sense_id": "3a01c65d-bc4a-366e-806f-19a1a5b9285e",
                                                "text": "Er ist seit drei Monaten schon trocken."
                                            },
                                            {
                                                "example_id": "be8efcfd-6931-4b6e-a18d-86b2206829d9",
                                                "sense_id": "3a01c65d-bc4a-366e-806f-19a1a5b9285e",
                                                "text": "Mayer war Alkoholiker. Er fing an zu trinken, als ihm sein Leben zu schwierig wurde. Heute ist er trocken und träumt sogar von einer Beziehung: Im Internet hat er eine Frau kennengelernt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9a5e07a4-5d26-3374-bd83-1d985463c1bf",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "wenig oder zu wenig Fett enthaltend"
                                        ],
                                        "tags": [
                                            "Haut"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8569ab7e-664c-4d2f-ba1f-16bfaef10ddd",
                                                "sense_id": "9a5e07a4-5d26-3374-bd83-1d985463c1bf",
                                                "text": "Bei trockener Haut empfehlen wir eine Feuchtigkeitsmaske."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "21187f72-cb48-3fcc-9776-516beae64d14",
                                        "entry_id": "abd9f4d0-1a9f-36ac-9a88-a1240301ca4c",
                                        "glosses": [
                                            "im Zuge der körperlichen Entwicklung von kleinen Kindern bewusste Kontrolle über Blase und Darm habend"
                                        ],
