                "senses": [
                    {
                        "sense_id": "a7bc583d-afc6-3bda-91d6-5e3641457ced",
                        "entry_id": "a842dc0d-feca-36b9-8d85-a46717b652c1",
                        "glosses": [
                            "Morceau de pâte aminci avec un rouleau à pâtisserie, qui forme la croûte inférieure d’une pâtisserie et servant à foncer un moule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15db13b-68c7-4f1c-b280-55a2db7917f2",
                                "sense_id": "a7bc583d-afc6-3bda-91d6-5e3641457ced",
                                "text": "Faites une abaisse de pâte comme celle ci-dessus ; ensuite mettez deux feuilles de papier sur une planche et votre abaisse dessus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c5353cc-ffea-4546-9521-75636ee8631c",
                        "source_entry_id": "a842dc0d-feca-36b9-8d85-a46717b652c1",
                        "source_sense_id": "a7bc583d-afc6-3bda-91d6-5e3641457ced",
                        "target_lang_word": "Abaisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abaisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb6e6e0-a1e4-3981-9b3c-76f77acfd9ef",
                                        "entry_id": "efcc7853-c2c8-3d91-9a31-75f7aefd59c1",
                                        "glosses": [
                                            "dünn ausgerollter Teig für Kuchen- und Pastetenboden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed4638b0-6283-4abe-b53f-a54a31faab28",
                                                "sense_id": "8cb6e6e0-a1e4-3981-9b3c-76f77acfd9ef",
                                                "text": "Beim Ausrollen von Abbaise muss man darauf achten, dass der Teig dünn ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2106e178-f7df-49a8-aa5d-0736fc1aa3d0",
                        "source_entry_id": "a842dc0d-feca-36b9-8d85-a46717b652c1",
                        "source_sense_id": "a7bc583d-afc6-3bda-91d6-5e3641457ced",
                        "target_lang_word": "undercrust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undercrust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994d7b11-1c03-30fc-9c94-c0478c67f556",
                                        "entry_id": "cd587603-130a-38c4-9e77-a9f79e437b97",
                                        "glosses": [
                                            "A crust that forms the bottom of a pie, tart or other dish; a layer of pastry that supports the filling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fe04b54-5fac-4d35-b68f-273316390a64",
                                                "sense_id": "994d7b11-1c03-30fc-9c94-c0478c67f556",
                                                "text": "In the middle ages, our forefathers found themselves deficient in plates and so, for a substitute, an undercrust of bread served as a plate."
                                            },
                                            {
                                                "example_id": "045e3d6e-ab16-4d34-9ac0-f8c55934b081",
                                                "sense_id": "994d7b11-1c03-30fc-9c94-c0478c67f556",
                                                "text": "Mr. Gurney's dig at our pie referred to the soggy undercrust so many of our American cooks persist in making. The English never have an undercrust to their pies, one of the few respects, it seems to me, in which English cooking, which is generally atrocious, is superior to our own, which also belongs in many respects to the atrocious order."
                                            },
                                            {
                                                "example_id": "f5c79b80-b1c9-4d7c-a8ef-5893894d8168",
                                                "sense_id": "994d7b11-1c03-30fc-9c94-c0478c67f556",
                                                "text": "To study the effect of several factors on the soaking of the fruit into the undercrust, it was frozen before the filling was added as well as after the entire pie was made; the unfrozen undercrust was brushed with egg white, with fat, with sugar or with flour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4255ea-f117-3f0d-ac03-f020074b1d63",
                                        "entry_id": "cd587603-130a-38c4-9e77-a9f79e437b97",
                                        "glosses": [
                                            "The layer of material located beneath the crust of a planet or moon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfc0a4e-87ed-4e55-a53e-4e43fe407a22",
                                                "sense_id": "0d4255ea-f117-3f0d-ac03-f020074b1d63",
                                                "text": "It must therefore form the undercrust of all Gallia."
                                            },
                                            {
                                                "example_id": "4b329aa2-6c54-4a3b-8581-2f2fa0e84a61",
                                                "sense_id": "0d4255ea-f117-3f0d-ac03-f020074b1d63",
                                                "text": "The deposit consists of a hard crust of fairly pure halite as much as 40 cm thick overlying an undercrust of mixed salts and wet sand 30 cm thick; below this undercrust at an average depth of about 60 cm is the brine level."
                                            },
                                            {
                                                "example_id": "32d7e885-df8f-4407-ad5a-26638ce4c4e4",
                                                "sense_id": "0d4255ea-f117-3f0d-ac03-f020074b1d63",
                                                "text": "The differential geochemical character of crust and undercrust is reflected in elemntal concentrations (right panel), where the relative size of the font for each element denotes relative enrichment or depletion between crust and undercrusts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
