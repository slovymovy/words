                                ]
                            },
                            {
                                "target_word": "allant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a73a8a-0f7a-306b-a252-7f5e057f1bc2",
                                        "entry_id": "63eb7b4b-887d-3954-a8d7-999f02808ba8",
                                        "glosses": [
                                            "Participe présent d'aller."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b20111e-be9c-4396-b937-a9978a21ffe2",
                                                "sense_id": "b6a73a8a-0f7a-306b-a252-7f5e057f1bc2",
                                                "text": "Et les salvateurs monteront allant en la montagne de Sion pour juger la montagne d’Esau, et le royaume sera du Seigneur Jehovah."
                                            },
                                            {
                                                "example_id": "7f03b411-81ac-41e8-b0ea-09dc8761769f",
                                                "sense_id": "b6a73a8a-0f7a-306b-a252-7f5e057f1bc2",
                                                "text": "A moins d’une lieue de Vendœuvres, en allant sur le marais de Bellebouche, au lieu dit « le button aux fades », une famille d’hommes libres, venant de la région d’Erfurt, a été pourvue par notre souverain d’un domaine, en remplacement d’Aquitains qui avaient péri pendant la guerre, il y a cela plus de vingt ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
