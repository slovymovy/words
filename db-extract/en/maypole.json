                        "sense_id": "19d58bae-3461-364c-8a87-3bc945569f3b",
                        "entry_id": "c71d7c71-21ed-3322-98b6-8094c83975e5",
                        "glosses": [
                            "Maibaum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63209b11-84e7-4ab9-abe8-476a48cea103",
                                "sense_id": "19d58bae-3461-364c-8a87-3bc945569f3b",
                                "text": "\"His coat was gathered in at his waist, and was patched with as many colors as there are stripes upon a maypole in the springtide.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0089d9a-1c5c-4eb2-a893-64de6f8a8772",
                        "source_entry_id": "c71d7c71-21ed-3322-98b6-8094c83975e5",
                        "source_sense_id": "19d58bae-3461-364c-8a87-3bc945569f3b",
                        "source_sense_description": "Maibaum",
                        "target_lang_word": "Maibaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maibaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                        "entry_id": "f0fd418c-31ea-3260-8648-da8d0c681437",
                                        "glosses": [
                                            "langer, geschmückter Baum oder glatter Baumstamm, der bei Festen im Frühjahr, oft am 1. Mai, auf dem Festplatz oder am Haus aufgestellt wird"
                                        ],
                                        "tags": [
                                            "Brauchtum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2197e5f-d63f-4570-89d1-7264317f3813",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„Der Maibaum und das Aufstellen des geschmückten Baumes oder Stammes am letzten Tag des Aprils, am 1. Mai, an Pfingsten oder an Johanni ist ein in vielen Teilen Deutschlands aber auch in Nord- und Mitteleuropa verbreitetes Brauchtum.“"
                                            },
                                            {
                                                "example_id": "282ad9db-582a-4691-9843-2af732f9a5be",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„In jeder Region kann der Maibaum anders aussehen.“"
                                            },
                                            {
                                                "example_id": "f457e0eb-1d90-42cb-b3f6-290fa28ddc80",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„In der Nacht vom 30. April auf den 1. Mai werden aus geschmückten Birken wieder die Maibäume, die an Häusern und Laternen aufgestellt und befestigt werden.“"
                                            },
                                            {
                                                "example_id": "1a6f4f3b-22be-4a4f-b1a2-7fe8fd8f5baf",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„In der Nacht zum 1. Mai setzen traditionell Männer ihrer/ihrem Liebsten einen Maibaum (Birke) vor die Tür. “"
                                            },
                                            {
                                                "example_id": "977397ae-d1f2-4cfb-be92-59f473935f57",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„Alle vier Jahre stellt die 700-Seelen-Gemeinde im Oberland einen Maibaum auf.“"
                                            },
                                            {
                                                "example_id": "4b56a151-c0be-4b66-b550-c1b59ee6733a",
                                                "sense_id": "6ec0fbe2-ea11-3d64-8ce7-20e9d4e72f3e",
                                                "text": "„Vereinsinhalt ist die Pflege heimatlichen Brauchtums, wie das jährliche Aufstellen des Maibaumes am 1.Mai am Kirchplatz, Festzug mit Fahnenabordnungen und Stadtteilfest sowie die Durchführung verschiedener Veranstaltungen wie z.B. Sänger- und Musikantentreffen (Hoagartn und Mundartlesungen) um in Neuaubing bayerische Traditionen und Heimatgefühl zu vermitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maibaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b38520c7-559a-3e18-92ca-e35ec77ee7a1",
                                        "entry_id": "6c6bbb03-dc67-335b-b5f7-a1df0191e31a",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e450292-94d5-4d52-9d21-be4fd0772761",
                                                "sense_id": "b38520c7-559a-3e18-92ca-e35ec77ee7a1",
                                                "text": "Erinnerst Du Dich noch an Herrn Maibaum, unseren Geschichtslehrer?"
                                            },
                                            {
                                                "example_id": "a7e1c3ab-2936-46c4-9f97-018b2b465995",
                                                "sense_id": "b38520c7-559a-3e18-92ca-e35ec77ee7a1",
                                                "text": "Doris, wir sind heute Abend bei Maibaums eingeladen!"
                                            },
                                            {
                                                "example_id": "d0928f3f-5b92-4a9b-b50f-cb050efbfc97",
                                                "sense_id": "b38520c7-559a-3e18-92ca-e35ec77ee7a1",
                                                "text": "Die Maibaums haben tibetische Gebetsfahnen auf ihrem Balkon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
