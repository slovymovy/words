    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7214fcec-d123-3a9f-a898-b524e620f11a",
                "word": "cutaneous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ac13016-77a4-3c48-a530-945219827cf4",
                        "entry_id": "7214fcec-d123-3a9f-a898-b524e620f11a",
                        "glosses": [
                            "Of, relating to, existing on, or affecting the exterior skin, especially the cutis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c819bd00-65c8-462f-9b4f-1f9ff9aef2d7",
                                "sense_id": "3ac13016-77a4-3c48-a530-945219827cf4",
                                "text": "But during the hot fit the cutaneous absorbents act also with increased energy, and the exhalation is likewise increased by the greater heat of the skin; and hence it does not appear in drops on the surface, but is in part reabsorbed, and in part dissipated in the atmosphere. But as the mouths of the cutaneous absorbents are exposed to the cool air or bedclothes; whilst those of the capillary glands, which secrete the perspirable matter, are exposed to the warmth of the circulating blood; the former, as soon as the fever-fit begins to decline, lose their increased action first; and hence the absorption of the sweat is diminished, whilst the increased secretion of it continues for some hours afterwards, which occasions it to stand in drops upon the skin."
                            }
                        ]
                    }
                ],
                "translations": [
