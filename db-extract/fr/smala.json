                                "target_senses": [
                                    {
                                        "sense_id": "905c3e3d-5938-344c-94c6-9439eb5f983e",
                                        "entry_id": "26fb0cdc-7410-325a-8841-ecf30ec88513",
                                        "glosses": [
                                            "Menge von Gegenständen, die man unterwegs mit sich führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e953cc2f-2618-4301-9bff-54476a345a39",
                                                "sense_id": "905c3e3d-5938-344c-94c6-9439eb5f983e",
                                                "text": "„Wir gingen nun daran, einen Teil der Bagage auf die Loren zu packen.“"
                                            },
                                            {
                                                "example_id": "b8a9dd53-9571-40db-bcb3-34038feb0c3b",
                                                "sense_id": "905c3e3d-5938-344c-94c6-9439eb5f983e",
                                                "text": "„In Brünn war alles, was zum Hof gehörte, mit Packen beschäftigt, und die größere Bagage war bereits nach Olmütz abgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "926245e8-7f85-38f2-95ef-a95f6c13885e",
                                        "entry_id": "26fb0cdc-7410-325a-8841-ecf30ec88513",
                                        "glosses": [
                                            "Gruppe von Personen, die wenig geschätzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7775bd9-d5e8-4ed7-a53a-71bfd37caa64",
                                                "sense_id": "926245e8-7f85-38f2-95ef-a95f6c13885e",
                                                "text": "Musst du denn heute wieder die ganze Bagage kommen lassen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f54f4a54-751d-4b6b-ab5e-a5fa7279841d",
                        "source_entry_id": "e5f9220a-efbf-3693-bc5d-84f7d7ba2d45",
                        "target_lang_word": "tentenkamp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentenkamp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3abc9882-265f-322f-b802-5d58c7141fe2",
                                        "entry_id": "b193d30b-fc94-3cf0-ba6e-c2031c8d9f52",
                                        "glosses": [
                                            "een kamp met tenten als behuizing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98619cc5-8fc8-4a83-85d0-02280b23f201",
                                                "sense_id": "3abc9882-265f-322f-b802-5d58c7141fe2",
                                                "text": "Hun huis ligt vlak bij een tentenkamp."
                                            },
                                            {
                                                "example_id": "d51e4ed8-2e2c-4aee-8ae4-22d92f69e4f8",
                                                "sense_id": "3abc9882-265f-322f-b802-5d58c7141fe2",
                                                "text": "Op het plateau was een enorm tentenkamp gebouwd. Honderden tenten van allerlei vorm en kleur stonden in grote kringen om elkaar heen. In het midden van het kamp zag Nemo een tent, die twee keer zo groot was als de grootste in het hele kamp. Boven deze tent, die van zwart zeildoek was gemaakt en waarvoor twee onbeweeglijke schildwachten stonden, waaide een bloedrode vlag aan een lange stok."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1531873d-6e04-4fe9-ae55-1493f5e54f43",
                        "source_entry_id": "e5f9220a-efbf-3693-bc5d-84f7d7ba2d45",
                        "target_lang_word": "familie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9efdc2ac-f029-3212-b6bb-ed977a6a138e",
                                        "entry_id": "5d899108-e697-3d3a-8cca-fc93d9464df0",
                                        "glosses": [
                                            "groep mensen met (bloed)verwantschap door een gemeenschappelijke oorsprong"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c41fda-c51c-48cb-896c-7003e64764cf",
                                                "sense_id": "9efdc2ac-f029-3212-b6bb-ed977a6a138e",
                                                "text": "We zijn met de hele familie, inclusief alle klein- en achterkleinkinderen, naar de honderdste verjaardag van oma geweest."
                                            },
                                            {
                                                "example_id": "ec103e01-25fb-49e3-b353-d522d4a5231e",
                                                "sense_id": "9efdc2ac-f029-3212-b6bb-ed977a6a138e",
                                                "text": "Misschien was Marjorie Quick een telg uit de familie Skelton en bekleedde ze hier een of andere onbezoldigde functie."
                                            },
                                            {
                                                "example_id": "7527f868-8a55-4580-949a-fbb54e0168a2",
                                                "sense_id": "9efdc2ac-f029-3212-b6bb-ed977a6a138e",
                                                "text": "Misschien zou ik me op een gegeven moment vervelen met alleen mijn eigen gedachten als vermaak. Of zou ik mezelf heel hard tegenkomen, ook al wist ik nog steeds niet precies wat hiermee bedoeld werd. Ik was immers de constante prikkels van Internet, Netflix, vrienden en familie om me heen gewend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b33251d-e756-3bde-9413-943695fcca10",
                                        "entry_id": "5d899108-e697-3d3a-8cca-fc93d9464df0",
                                        "glosses": [
                                            "taxon, een groep dieren of planten, onderdeel van een orde en bestaande uit een of meer geslachten"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "764e83a5-a059-45cc-8c97-beae66f9c2be",
                        "source_entry_id": "e5f9220a-efbf-3693-bc5d-84f7d7ba2d45",
                        "target_lang_word": "gevolg",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gevolg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8480075-5b2b-34b2-8fb7-13d03e1b1cd8",
                                        "entry_id": "2ce1fe76-3452-3699-b199-53f488dd2103",
                                        "glosses": [
                                            "resultaat dat voortkomt uit iets anders (de oorzaak)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80643707-fe79-4752-9d72-cc615ad2c52e",
                                                "sense_id": "d8480075-5b2b-34b2-8fb7-13d03e1b1cd8",
                                                "text": "‘Dit virus en de maatregelen die wereldwijd worden genomen hebben wel enorme gevolgen voor de economie. Dat is dan zo, en daar zal de overheid zich ook op richten, maar nu gaat het om veiligheid. We moeten ons allemaal zo veel mogelijk aan de richtlijnen houden.’"
                                            },
                                            {
                                                "example_id": "4cfc1d2d-6c07-43b2-be42-a8d418f38acd",
                                                "sense_id": "d8480075-5b2b-34b2-8fb7-13d03e1b1cd8",
                                                "text": "`Ik weet het; zei de majordomus. 'Het was ijdele hoop dat dit u zou ontgaan. Ik vraag u met klem de grootmoedigheid op te brengen om mijn nederige excuses te aanvaarden. Deze uit de toon vallende decoratie is het jammerlijke gevolg van het enthousiasme van de nieuwe eigenaar.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "decd033b-0fdc-346e-ad94-2842ecdf3b97",
                                        "entry_id": "2ce1fe76-3452-3699-b199-53f488dd2103",
                                        "glosses": [
                                            "een groep die volgt, die er achteraan of later komt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26285024-7089-414d-bf11-9874c730a279",
                                                "sense_id": "decd033b-0fdc-346e-ad94-2842ecdf3b97",
                                                "text": "De twaalf apostelen vormden het gevolg van Jezus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
