                                                "example_id": "934dd963-7683-4786-a0e5-a0b1d7553281",
                                                "sense_id": "7f68f689-a24d-3128-bbd1-82bf6347be95",
                                                "text": "Die amerikanische Wandertaube ist seit 1914 ausgestorben."
                                            },
