                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95911c1b-f2b4-4dba-b85b-516d08023b23",
                                "sense_id": "ab121d84-4b2a-3137-ab34-517d9b178cd8",
                                "text": "„Ich hatte mir Kaneko als bedrohlich wirkenden, undeutlich sprechenden Schläger mit Reibeisenstimme vorgestellt.“"
                            },
                            {
                                "example_id": "236b7bfa-5916-44e0-8402-8ac8f8528d3f",
                                "sense_id": "ab121d84-4b2a-3137-ab34-517d9b178cd8",
                                "text": "„Carole hatte eine Reibeisenstimme, obwohl sie, zumindest derzeit, keine Raucherin war, soweit Shaw das sehen oder riechen konnte.“"
                            },
                            {
                                "example_id": "b488cfc0-2206-4a56-b4c4-591e0b3c8633",
                                "sense_id": "ab121d84-4b2a-3137-ab34-517d9b178cd8",
                                "text": "„Als ich zurückkam, dröhnte Kenny Rogers durch die Wohnung, seine Reibeisenstimme schmetterte den Schmachfetzen: ›She Believes in Me‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
