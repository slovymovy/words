{
    "word_family": [
        "peasantry",
        "peasantlike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fca09ee1-58c6-304d-aed9-411501d21987",
                    "sense_definition": "A member of a low social class who works on the land, such as a small farmer or agricultural laborer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agricultural_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>peasant</w> worked from dawn until dusk to harvest the wheat.",
                            "target_lang_translations": {
                                "ru": "Местный <w>крестьянин</w> работал от рассвета до заката, чтобы собрать урожай пшеницы."
                            }
                        },
                        {
                            "text": "In many historical societies, the <w>peasant</w> class formed the backbone of the economy.",
                            "target_lang_translations": {
                                "ru": "Во многих исторических обществах <w>крестьянское</w> сословие составляло основу экономики."
                            }
                        }
                    ],
                    "synonyms": [
                        "serf",
                        "rustic",
                        "peon"
                    ],
                    "antonyms": [
                        "noble",
                        "aristocrat"
                    ],
                    "common_phrases": [
                        "peasant class",
                        "poor peasant",
                        "local peasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель низшего социального класса, работающий на земле, например, мелкий фермер или сельскохозяйственный рабочий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "человек, занимающийся сельским трудом"
                            },
                            {
                                "target_lang_word": "мужик",
                                "target_lang_sense_clarification": "историческое название простолюдина-крестьянина"
                            },
                            {
                                "target_lang_word": "селянин",
                                "target_lang_sense_clarification": "устаревшее обозначение сельского жителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90dfb5ed-a36a-3bb0-a0ec-bc5dd686c9a4",
                    "sense_definition": "A person who lives in the country or a rural area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rural_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a simple <w>peasant</w> who had never traveled beyond his village.",
                            "target_lang_translations": {
                                "ru": "Он был простым <w>селянином</w>, который никогда не выезжал за пределы своей деревни."
                            }
                        },
                        {
                            "text": "The city dwellers often looked down upon the humble <w>peasant</w> from the hills.",
                            "target_lang_translations": {
                                "ru": "Горожане часто свысока смотрели на скромного <w>крестьянина</w> с холмов."
                            }
                        }
                    ],
                    "synonyms": [
                        "villager",
                        "rustic",
                        "countryman"
                    ],
                    "antonyms": [
                        "townie",
                        "city-dweller"
                    ],
                    "common_phrases": [
                        "simple peasant",
                        "country peasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий в сельской местности или в деревне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский житель",
                                "target_lang_sense_clarification": "человек, проживающий в деревне"
                            },
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "житель деревни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fcef095-04ac-3ce5-b3bb-ae6312e729b8",
                    "sense_definition": "An uncouth, crude, or ill-bred person who lacks social polish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncouth_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop eating with your hands like a <w>peasant</w> and use your fork.",
                            "target_lang_translations": {
                                "ru": "Перестань есть руками как <w>деревенщина</w>, пользуйся вилкой."
                            }
                        },
                        {
                            "text": "The wealthy businessman dismissed his critics as uneducated <w>peasants</w>.",
                            "target_lang_translations": {
                                "ru": "Богатый бизнесмен отмахнулся от своих критиков, назвав их необразованными <w>мужланами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "boor",
                        "yokel",
                        "churl",
                        "clodhopper"
                    ],
                    "antonyms": [
                        "gentleman"
                    ],
                    "common_phrases": [
                        "ignorant peasant",
                        "uneducated peasant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as an insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, неотесанный или невоспитанный человек, которому не хватает манер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "пренебрежительное обозначение неотесанного человека"
                            },
                            {
                                "target_lang_word": "мужлан",
                                "target_lang_sense_clarification": "грубый, невежественный человек"
                            },
                            {
                                "target_lang_word": "невежа",
                                "target_lang_sense_clarification": "человек, не знающий правил приличия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be50687d-13de-3a30-9289-5ccd1d25b25e",
                    "sense_definition": "Relating to or characteristic of people who work the land; simple or unsophisticated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peasant_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a hearty <w>peasant</w> dish made of simple root vegetables.",
                            "target_lang_translations": {
                                "ru": "Нам понравилось сытное <w>крестьянское</w> блюдо из простых корнеплодов."
                            }
                        },
                        {
                            "text": "The fashion designer was inspired by traditional <w>peasant</w> clothing from Eastern Europe.",
                            "target_lang_translations": {
                                "ru": "Модельер черпал вдохновение в традиционной <w>крестьянской</w> одежде из Восточной Европы."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustic",
                        "bucolic",
                        "unsophisticated"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "refined"
                    ],
                    "common_phrases": [
                        "peasant dish",
                        "peasant blouse",
                        "peasant food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям, работающим на земле, или характерный для них; простой или бесхитростный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестьянский",
                                "target_lang_sense_clarification": "относящийся к быту или сословию крестьян"
                            },
                            {
                                "target_lang_word": "деревенский",
                                "target_lang_sense_clarification": "простой, сельский стиль"
                            },
                            {
                                "target_lang_word": "простецкий",
                                "target_lang_sense_clarification": "незамысловатый, грубый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ce2d34-1e87-3a01-9693-08dc1d2abe98",
                    "sense_definition": "Lowly, vulgar, or lacking in moral principles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>peasant</w> slave, trapped by his own dishonest choices.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>рабской</w> душой, оказавшись в ловушке собственного нечестного выбора."
                            }
                        },
                        {
                            "text": "The play depicts the <w>peasant</w> behavior of those who betray their friends for money.",
                            "target_lang_translations": {
                                "ru": "Пьеса изображает <w>низкое</w> поведение тех, кто предает своих друзей ради денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "vulgar",
                        "base",
                        "lowly"
                    ],
                    "antonyms": [
                        "noble",
                        "honorable"
                    ],
                    "common_phrases": [
                        "peasant slave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to denote low moral status"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низменный, вульгарный или лишенный моральных принципов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабский",
                                "target_lang_sense_clarification": "низменный, лишенный достоинства"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкий по происхождению или духу (архаичное)"
                            },
                            {
                                "target_lang_word": "вульгарный",
                                "target_lang_sense_clarification": "грубый и низменный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}