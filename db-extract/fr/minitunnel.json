                "senses": [
                    {
                        "sense_id": "d8c08760-814d-3374-a7c1-4d57ac18cb67",
                        "entry_id": "d6537d73-4de8-3d15-a872-287dd3d42c1d",
                        "glosses": [
                            "tunnel de très petite taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227bf9ba-f76f-46b4-9b51-c0632f73030e",
                                "sense_id": "d8c08760-814d-3374-a7c1-4d57ac18cb67",
                                "text": "À l’entrée de ce trou noir, nous leur donnions simplement l’assurance qu'ils pourraient sortir une fois parvenus au fond, sans préciser toutefois la profondeur (une quinzaine de mètres) ni le fait qu’une cavité débouchait à l’air libre par un minitunnel."
                            },
                            {
                                "example_id": "cf0f6ade-298f-415d-9433-8bbef40361c4",
                                "sense_id": "d8c08760-814d-3374-a7c1-4d57ac18cb67",
                                "text": "Un car de tourisme espagnol s’est retrouvé coincé, ce dimanche matin vers 5h15, dans un des minitunnels du Grand Boulevard à hauteur du Romarin, dans la commune de La Madeleine."
                            }
                        ]
                    }
