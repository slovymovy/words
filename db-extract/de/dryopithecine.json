                "senses": [
                    {
                        "sense_id": "26f61482-43fe-3a73-9fbb-70cc1d77fa0a",
                        "entry_id": "b204423b-22d1-38b4-8ff9-5f98c36cea0b",
                        "glosses": [
                            "Mitglied einer Gruppe ausgestorbener Menschenaffen, die vor rund 20 bis 4 Millionen Jahren in Europa und Asien gelebt haben. Die Dryopithecinen gelten als die gemeinsamen, im mittleren Tertiär verbreiteten Vorfahren von Mensch und Menschenaffen."
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f78e623c-6966-4f37-b64a-0d49e513e8f0",
                                "sense_id": "26f61482-43fe-3a73-9fbb-70cc1d77fa0a",
                                "text": "\"Diesem Material kommt erhöhtes Interesse zu, da es evtl. eine intermediäre Stellung zwischen den afrikanischen und asiatischen Dryopithecinen nachweisen könnte.\""
                            },
                            {
                                "example_id": "cc1f5b01-303f-4f20-8edb-8805e44bd87c",
                                "sense_id": "26f61482-43fe-3a73-9fbb-70cc1d77fa0a",
                                "text": "„Als pliozäner Dryopithecine wird der Urschimpanse Anthropitecus postuliert, von dem Pan und die Hominiden abstammen.“"
                            },
                            {
                                "example_id": "44d81da3-6b76-4f7a-8fcd-b0bf6856dd2a",
                                "sense_id": "26f61482-43fe-3a73-9fbb-70cc1d77fa0a",
                                "text": "„Ramapithecus war schon früher in den Verdacht geraten, kein Dryopithecine […] zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
