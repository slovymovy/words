                "senses": [
                    {
                        "sense_id": "efdae6fd-6e75-33e3-babc-c7213417620c",
                        "entry_id": "1183d609-10bf-3c41-942c-e6f06d435660",
                        "glosses": [
                            "техн. ручная переносная машина с приводом от электродвигателя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a719ff-216c-4caa-b596-2ed85f452b5e",
                                "sense_id": "efdae6fd-6e75-33e3-babc-c7213417620c",
                                "text": "В близком родстве с дисковой пилой состоит многофункциональный электроинструмент ― углошлифовальная машинка (УШМ), или «болгарка»."
                            },
                            {
                                "example_id": "3ede615d-33fc-45aa-b21d-4a5f53e38633",
                                "sense_id": "efdae6fd-6e75-33e3-babc-c7213417620c",
                                "text": "Электрические инструменты бывают переносными (ручной электроинструмент) и стационарными (станки)."
                            }
                        ]
                    },
                    {
                        "sense_id": "28056503-495e-32c1-bcae-1ceb23f64108",
                        "entry_id": "1183d609-10bf-3c41-942c-e6f06d435660",
                        "glosses": [
                            "муз. электрический музыкальный инструмент"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9b4d3eb-fd89-49ea-8b4c-456ec4f99fc0",
                                "sense_id": "28056503-495e-32c1-bcae-1ceb23f64108",
                                "text": "Звучал ансамбль электроинструментов под управлением В. Мещерина."
                            }
                        ]
                    }
                ],
