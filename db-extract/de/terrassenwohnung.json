                ],
                "senses": [
                    {
                        "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                        "entry_id": "c224ef7a-c369-3f49-be7f-687eca4d089d",
                        "glosses": [
                            "eine Wohnung mit/an/auf/unter einer Terrasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241a846d-7706-4a7f-bae1-5f96c71b3359",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Geplant sind zweigeschoßige Reihenhäuser und Terrassenwohnungen, die kleinsten Einheiten werden 62 Quadratmeter haben.“"
                            },
                            {
                                "example_id": "7d1914e5-0d25-445d-9f3c-a44ae337040e",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Soll es nun eine Etagenwohnung sein, ein Penthouse oder lieber eine Terrassenwohnung?“"
                            },
                            {
                                "example_id": "23b0a954-d067-4979-9060-b250aaa282f0",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Zwei fast gleiche Wohnungen, von denen eine über eine Terrasse verfügt, die andere nicht, unterscheiden sich von der Miethöhe her um 13 Prozent: Geht man von einer Miethöhe von 6,96 Euro pro Quadratmeter aus, dann zahlt man für eine Terrassenwohnung noch einmal 99 Cent drauf.“"
                            },
                            {
                                "example_id": "463de433-8252-423f-ba98-484bf7564032",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Laut der Polizei war die unbekannte Täterschaft in Bäch in der Gemeinde Wollerau über die Eingangstüre in eine Terrassenwohnung eingedrungen.“"
                            },
                            {
                                "example_id": "af25e294-fe18-4a51-9416-96e4d2874ec7",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Kurz vor 2 Uhr stellte der Bewohner einer Terrassenwohnung in Stäfa Rauch in seiner Waschküche fest.“"
                            },
                            {
                                "example_id": "f0034f42-c458-4ea5-a6ef-bb775fc0d522",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Schon wieder haben Einbrecher in Kilchberg zugeschlagen: Aus einer Terrassenwohnung erbeuteten sie in der Nacht auf Samstag Schmuck im Wert von rund 100'000 Franken, teilt die Kantonspolizei mit.“"
                            },
                            {
                                "example_id": "486f4b9c-2e2b-4f1c-a5c7-a5e0c4707975",
                                "sense_id": "81f9cb11-184c-3a4c-93ea-9a0fbb76eca3",
                                "text": "„Anstelle der Fernsehstudios plant er den Bau von gehobenen Seniorenresidenzen in Form von Terrassenwohnungen mit einem umfangreichen Dienstleistungsangebot für die Bewohner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
