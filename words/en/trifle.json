{
    "word_family": [
        "trifling",
        "trifler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                    "sense_definition": "Anything that is of little importance or worth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was upset about such a <w>trifle</w> that did not really matter.",
                            "target_lang_translations": {
                                "zh": "她因为一件根本不重要的<w>琐事</w>而感到难过。"
                            }
                        },
                        {
                            "text": "Do not waste your energy on such <w>trifles</w> when there is real work to do.",
                            "target_lang_translations": {
                                "zh": "有正事要做的时候，别把精力浪费在这些<w>琐事</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "triviality",
                        "bagatelle"
                    ],
                    "common_phrases": [
                        "mere trifle"
                    ],
                    "target_lang_definitions": {
                        "zh": "微不足道的事物或琐事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "琐事",
                                "target_lang_sense_clarification": "指不重要的小事。"
                            },
                            {
                                "target_lang_word": "小事",
                                "target_lang_sense_clarification": "指价值不高或不重要的事情。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                    "sense_definition": "A very small amount of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add just a <w>trifle</w> of salt to the soup to improve the flavor.",
                            "target_lang_translations": {
                                "zh": "往汤里加<w>一点点</w>盐来提味。"
                            }
                        },
                        {
                            "text": "The room was a <w>trifle</w> too cold for comfort.",
                            "target_lang_translations": {
                                "zh": "房间里<w>稍微</w>有点冷，不太舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "modicum",
                        "smidgen"
                    ],
                    "common_phrases": [
                        "a trifle"
                    ],
                    "target_lang_definitions": {
                        "zh": "极少量；一点点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一点点",
                                "target_lang_sense_clarification": "表示数量非常少。"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "用于程度副词，表示程度很轻。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                    "sense_definition": "An English dessert made from custard, fruit, sponge cake, and whipped cream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We prepared a traditional <w>trifle</w> for the holiday dinner party.",
                            "target_lang_translations": {
                                "zh": "我们为节日晚宴准备了一份传统的<w>英式松糕</w>。"
                            }
                        },
                        {
                            "text": "The layers of the <w>trifle</w> looked beautiful in the glass bowl.",
                            "target_lang_translations": {
                                "zh": "玻璃碗里的<w>英式松糕</w>分层看起来很漂亮。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种英式甜点，由奶油冻、水果、海绵蛋糕和鲜奶油分层制成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "英式松糕",
                                "target_lang_sense_clarification": "指代这种特定的英式分层甜点。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                    "sense_definition": "To inconsequentially toy with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toy_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat at the table and <w>trifled</w> with his pen while thinking.",
                            "target_lang_translations": {
                                "zh": "他坐在桌边，思考时不停地<w>摆弄</w>着手中的笔。"
                            }
                        },
                        {
                            "text": "She <w>trifled</w> with her food because she was not hungry.",
                            "target_lang_translations": {
                                "zh": "因为不饿，她只是漫不经心地<w>摆弄</w>着盘子里的食物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fiddle"
                    ],
                    "common_phrases": [
                        "trifle with"
                    ],
                    "target_lang_definitions": {
                        "zh": "漫不经心地摆弄或玩弄某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "指无目的地玩弄物体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                    "sense_definition": "To deal with something or someone as if they were of little importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>trifle</w> with the feelings of others.",
                            "target_lang_translations": {
                                "zh": "你不应该<w>戏弄</w>别人的感情。"
                            }
                        },
                        {
                            "text": "The manager warned that he would not be <w>trifled</w> with during the meeting.",
                            "target_lang_translations": {
                                "zh": "经理警告说，会议期间不容许任何人<w>轻视</w>他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trifle with"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻视或戏弄某人或某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "指不严肃地对待他人感情。"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "指不把某人或某事放在眼里。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                    "sense_definition": "To squander or waste time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>trifle</w> away your youth on unproductive habits.",
                            "target_lang_translations": {
                                "zh": "不要把青春<w>虚度</w>在毫无意义的习惯上。"
                            }
                        },
                        {
                            "text": "They <w>trifled</w> away the entire afternoon doing nothing of value.",
                            "target_lang_translations": {
                                "zh": "他们整个下午什么有价值的事都没做，就这样<w>虚度</w>了光阴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fritter"
                    ],
                    "common_phrases": [
                        "trifle away"
                    ],
                    "target_lang_definitions": {
                        "zh": "虚度或浪费时间。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虚度",
                                "target_lang_sense_clarification": "指白白浪费时间或光阴。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}