                ],
                "senses": [
                    {
                        "sense_id": "5ec84ef3-7735-3ce4-ada1-7b74c0045c49",
                        "entry_id": "1224f38d-9f5c-3cb4-9118-f2c1cf0f9565",
                        "glosses": [
                            "Zusammenfassung strafrechtlicher Vorschriften in einem Gesetzbuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ef5949-d227-459c-89dd-3362fae2242b",
                                "sense_id": "5ec84ef3-7735-3ce4-ada1-7b74c0045c49",
                                "text": "„Sterilisation gegen den Willen der Betroffenen wird heute nach dem Strafgesetzbuch als schwere Körperverletzung geahndet.“"
                            },
                            {
                                "example_id": "9b656fc1-fbb4-48c7-ba2e-a42cbaf151cc",
                                "sense_id": "5ec84ef3-7735-3ce4-ada1-7b74c0045c49",
                                "text": "„Die einzigen Erkrankungen, die das Strafgesetzbuch als willenseinschränkend anerkennt, sind Schizophrenie oder ein Gehirntumor.“"
                            },
                            {
                                "example_id": "f4bdf556-d40d-4263-952e-04e3625ca6ff",
                                "sense_id": "5ec84ef3-7735-3ce4-ada1-7b74c0045c49",
                                "text": "„Aber es gab auch mindestens ebensoviel Herren, die schlicht gegen völlig unpolitische Paragraphen des portugiesischen Strafgesetzbuches verstoßen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
