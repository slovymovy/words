                "senses": [
                    {
                        "sense_id": "40c4ddda-a3ef-343e-82e1-516b91e29e47",
                        "entry_id": "44b9d708-4bfd-30ee-801a-69a438975c24",
                        "glosses": [
                            "Piss: urine."
                        ],
                        "tags": [
                            "Australia",
                            "British",
                            "euphemistic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9d2be45a-defa-41e0-89ec-4e1d03db9ddf",
                                "sense_id": "40c4ddda-a3ef-343e-82e1-516b91e29e47",
                                "text": "The spunk with his piddle comes bubbling."
                            }
                        ]
                    },
                    {
                        "sense_id": "10c2a9fd-1457-3cf5-b9bf-26c1ddde4103",
                        "entry_id": "44b9d708-4bfd-30ee-801a-69a438975c24",
                        "glosses": [
                            "A piss: an act of urination."
                        ],
                        "tags": [
                            "Australia",
                            "British",
                            "euphemistic",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0fe0f932-6345-498e-a59a-41553bf53804",
                                "sense_id": "10c2a9fd-1457-3cf5-b9bf-26c1ddde4103",
                                "text": "Piddle, urine; occ. the act of making water."
                            },
                            {
                                "example_id": "2a445ba9-4e85-472e-983e-82a2a1ecc282",
                                "sense_id": "10c2a9fd-1457-3cf5-b9bf-26c1ddde4103",
                                "text": "On the way out to the gardens, he had to stop for a piddle but was so weak he couldn't maintain his balance while lifting his rear leg."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c21d45c-a01d-334e-9922-b84c7f9c4112",
                        "entry_id": "44b9d708-4bfd-30ee-801a-69a438975c24",
                        "glosses": [
                            "Nonsense or a trivial matter."
                        ],
                        "tags": [
                            "British",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5c580f32-74b5-46f8-a146-9b227c36aac7",
                                "sense_id": "8c21d45c-a01d-334e-9922-b84c7f9c4112",
                                "text": "It's the alteration of the little words that makes all the difference between Poetry & piddle."
                            }
                        ]
                    }
