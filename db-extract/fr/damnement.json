                                                "example_id": "e5636c82-9ab3-4590-b71c-889edb873e40",
                                                "sense_id": "ec28d2dc-6fad-3524-a05a-a50bf21e123c",
                                                "text": "Cold temperatures, heavy rain, falling rocks, strong winds and glacier movement can damage the equipment."
