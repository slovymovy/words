                    },
                    {
                        "translation_id": "943f31c0-63ab-4bc6-8439-55adf0d3868c",
                        "source_entry_id": "080d7887-08cb-30d5-baad-990c25cd5b8e",
                        "source_sense_id": "77698062-9c3e-3177-aecc-8297eff280d9",
                        "source_sense_description": "weiblicher Vorname, obersorbische Form von Barbara",
                        "target_lang_word": "Barbara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                        "entry_id": "158777b3-6d73-39a6-b720-c06a3911c523",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e253c969-6197-4d0c-a64c-d23f0ece9ea0",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "My mother had a maid call'd Barbara; / She was in love, and he she lov'd prov'd mad / And did forsake her; […]"
                                            },
                                            {
                                                "example_id": "db3892cf-073e-41b5-9b6f-c54ae1d77f18",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "All in the merrye month of May / When greene buds they were swellin / Yong Jemmye Grove on his death-bed lay / For love of Barbara Allen."
                                            },
                                            {
                                                "example_id": "02933dbc-a06e-44b0-9d29-993cb563587b",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "\"What do you think they are going to name the baby? Anne; after her and her mamma. So very ugly a name!\" \"I don't think so,\" said Mr Carlyle. \"It is simple and unpretending. I like it much. Look at the long, pretentious names in our family - Archibald! Cornelia! And yours, too - Barbara! What a mouthful they all are!\" Barbara contracted her eyebrows. It was equivalent to saying that he did not like her name."
                                            },
                                            {
                                                "example_id": "80e3026b-116f-4412-806c-dd147dcd204c",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "\"Everybody in the next generation,\" suggested Dick, \"will be named Peter or Barbara - because at present all piquant literary characters are named Peter or Barbara.\""
                                            },
                                            {
                                                "example_id": "3aa6a6a8-1a43-4271-8876-af6f6a376766",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "'Barbara?' Barr―baah―rrah. Barbarian woman. Wild. Untamed. An incredibly sexy name."
                                            },
                                            {
                                                "example_id": "7e20c804-54cc-4809-a160-ca781440bb6d",
                                                "sense_id": "ada0cd98-caff-3879-8c5c-c3c9127656ed",
                                                "text": "Among Soloway’s congregants injured in the attack was Barbara Steinmetz, an 88-year-old Holocaust survivor who has become one of the most poignant symbols of the attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c3ade6-ba15-3c63-9c11-4598b8fe6a53",
                                        "entry_id": "158777b3-6d73-39a6-b720-c06a3911c523",
                                        "glosses": [
                                            "A syllogism in which all three propositions are of the form \\\"All X are Y\\\" or \\\"X is a Y\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5235b6a9-a55a-47eb-bc44-d7e8d69e6c64",
                                                "sense_id": "b4c3ade6-ba15-3c63-9c11-4598b8fe6a53",
                                                "text": "If you see a girl you like, prove it to her by Barbara and Celarent all the way to Fresison or whatever the logician's Omega is — I forget."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7af61876-93b7-412f-88de-e4c68a31f3f7",
                        "source_entry_id": "080d7887-08cb-30d5-baad-990c25cd5b8e",
