                        "glosses": [
                            "Experiencing stupefaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a55f87-9a37-4c4d-a61c-c94ffa4ed011",
                                "sense_id": "b0cbbc07-3cee-35e7-89e5-bd9481f7cd8c",
                                "text": "One stiff blind horse, his every bone a-stare, / Stood stupefied, however he came there: / Thrust out past service from the devil's stud!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b20f1122-b58d-3714-adda-30fab5685ce7",
                        "entry_id": "5ff0df1b-ec6d-38aa-b6e1-40679118b9b7",
                        "glosses": [
                            "Experiencing the influence of an ingested mind-altering substance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea72fbe0-bfe0-4f00-8b65-3a09f3cd8710",
                        "source_entry_id": "5ff0df1b-ec6d-38aa-b6e1-40679118b9b7",
                        "source_sense_description": "Experiencing stupefaction",
                        "target_lang_word": "bestürzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bestürzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                        "entry_id": "6ebb730c-6768-345e-bba4-74829f71301a",
                                        "glosses": [
                                            "(oft aus Trauer) tief erschrocken, bewegt; in negativer Weise überrascht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee5ee20-2edd-47dd-8651-35728af198d8",
                                                "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                                "text": "„Ich war zu bestürzt, um zu antworten.“"
                                            },
                                            {
                                                "example_id": "b3621fa8-7d87-41b2-8f84-8c58afafea8c",
                                                "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                                "text": "„Und wie bestürzt er aussah, ganz verlegen und erschrocken.“"
                                            },
                                            {
                                                "example_id": "eea44d0b-02e1-456c-a06a-4c3c374935fa",
                                                "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                                "text": "„Alle Parteien äußerten sich bestürzt über die Stimmengewinne der Republikaner.“"
                                            },
                                            {
                                                "example_id": "fc976b37-ea68-4312-b2e4-0fe5ed69d7bf",
                                                "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                                "text": "„Ich war ein wenig bestürzt, als er sagte: ‚Ich bin froh, daß ich das, was Ihr sagtet, nicht verstanden habe.‘“"
                                            },
                                            {
                                                "example_id": "9d906c7d-0a87-4821-bd86-42a07ea955f8",
                                                "sense_id": "d31f3ccd-516e-3fdd-b0b9-1b15822d9dfa",
                                                "text": "„Deinen Brief habe ich soeben erhalten und statt mich darüber zu freuen, war ich so bestürzt über den Inhalt Deines Briefes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
