                "translations": [
                    {
                        "translation_id": "d3aa6d30-6a4b-48fb-b5a4-15d95f09f6d0",
                        "source_entry_id": "56474935-1cdc-30b5-8291-1cc096ace6e6",
                        "source_sense_description": "to express",
                        "target_lang_word": "verbalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f3a132-0d19-38d0-8f9f-19736c811496",
                                        "entry_id": "7c1f8642-da8b-397a-b0be-f3c5f02ed5b4",
                                        "glosses": [
                                            "etwas versprachlichen, in Worte fassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a38c2fe-61d9-4833-8a0d-8287cd1d76ec",
                                                "sense_id": "71f3a132-0d19-38d0-8f9f-19736c811496",
                                                "text": "„Im Gegenteil, ich glaube, es wird sehr viel mehr verbalisiert.“"
                                            },
                                            {
                                                "example_id": "dda62bd9-c66a-49eb-b54e-60513519e3ab",
                                                "sense_id": "71f3a132-0d19-38d0-8f9f-19736c811496",
                                                "text": "„Zweifelsohne erhalten die Kinder durch derartige Expansionen wichtige Information, da sie Aspekte der Wirklichkeit enkodieren, die das Kind selbst nicht verbalisiert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98ac6783-28c8-33d7-89fb-564dc31097cf",
                                        "entry_id": "7c1f8642-da8b-397a-b0be-f3c5f02ed5b4",
                                        "glosses": [
                                            "ein Verb durch Anfügen eines Suffixes aus einer anderen Wortart erzeugen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
