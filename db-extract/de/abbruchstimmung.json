                                "example_id": "7d767113-a6dc-47e0-98ed-578e7d792155",
                                "sense_id": "658ecb19-3545-3587-aed5-b39470fbaa1c",
                                "text": "„Die Aufbruchsstimmung der Fans wandelte sich angesichts der aufgeweichten Böden auf den Zeltplätzen sehr schnell in eine Abbruchstimmung.“"
                            },
                            {
                                "example_id": "28cb8850-0f22-4153-9d8e-1078d8b52de4",
                                "sense_id": "658ecb19-3545-3587-aed5-b39470fbaa1c",
                                "text": "„Das Minus von zehn Prozentpunkten war Anlass für echte Abbruchstimmung.“"
                            }
