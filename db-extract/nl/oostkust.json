                "senses": [
                    {
                        "sense_id": "1c56ef49-7e53-307f-9141-054fde7c81cb",
                        "entry_id": "7b61d5f9-33cd-32bc-b8d9-032ba1a173ff",
                        "glosses": [
                            "de oostelijke zeeoever/kustgebied, de kust die in het oosten gelegen is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efb0519-5a69-4596-9198-fd8538783d1e",
                                "sense_id": "1c56ef49-7e53-307f-9141-054fde7c81cb",
                                "text": "Aan de oostkust ligt een mooi zandstrand."
                            },
                            {
                                "example_id": "3273d32a-bb88-4690-b740-a7197113e830",
                                "sense_id": "1c56ef49-7e53-307f-9141-054fde7c81cb",
                                "text": "Kabeljauw wordt traditioneel gevangen in de Noordzee en voor de oostkust van Canada."
                            },
                            {
                                "example_id": "be726f21-fa62-4dff-8c3b-46df7b85ffbf",
                                "sense_id": "1c56ef49-7e53-307f-9141-054fde7c81cb",
                                "text": "Hij had ooit de Appalachian Trail gelopen, 4000 kilometer langs de oostkust van Amerika."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c88681e3-5e12-4223-a4d6-8d37198edda9",
                        "source_entry_id": "7b61d5f9-33cd-32bc-b8d9-032ba1a173ff",
                        "source_sense_id": "1c56ef49-7e53-307f-9141-054fde7c81cb",
                        "source_sense_description": "oostelijke zeeoever",
                        "target_lang_word": "Ostküste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ostküste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                        "entry_id": "9b3a9c1d-b02c-3384-81eb-ee8faec51820",
                                        "glosses": [
                                            "Küste, die im Osten liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb181e6c-1189-4526-aea4-de86eff29760",
                                                "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                                "text": "Dass ihr gesichtsloser Internetkäufer von der amerikanischen Ostküste stammt, sieht sie auf einem Bildschirm. Dort blinkt ein Wort auf rotem Hintergrund: Massachusetts."
                                            },
                                            {
                                                "example_id": "9619857b-2158-49da-a622-5828f80f1dc6",
                                                "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                                "text": "Mehr als sechs Monate sind seit der Flut-Katastrophe vergangen, die Japan ins Chaos stürzte. Am 11. März 2011 verwüsteten ein Erdbeben und ein folgender Tsunami einen großen Teil der Ostküste."
                                            },
                                            {
                                                "example_id": "c55c6261-7aaf-4da5-aeeb-1691504a4d8b",
                                                "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                                "text": "„Demnach landet um das Jahr 205 nach Christus ein 1000 Mann starkes Heer an der Ostküste Jütlands.“"
                                            },
                                            {
                                                "example_id": "9e5b37d0-38ea-432c-bc46-2926da1bf291",
                                                "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                                "text": "„Den Aufständischen in anderen Städten entlang der nordamerikanischen Ostküste gelang es, die von der East India Company entsandten Schiffe voll beladen zurück nach London zu schicken.“"
                                            },
                                            {
                                                "example_id": "df0bd66c-05f6-4da0-a446-899d6a74f26b",
                                                "sense_id": "0977810c-eee4-35a5-83ca-daf038e6bcd8",
                                                "text": "„Die letzte dieser Gruppen waren die von der südafrikanischen Ostküste stammenden Ndebele unter Führung ihres Königs Mzilikazi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
