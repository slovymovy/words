                ],
                "senses": [
                    {
                        "sense_id": "c8a88030-816d-3f21-b5e6-17fcfe279efe",
                        "entry_id": "752eeba9-51b0-3c87-aad9-17943e747414",
                        "glosses": [
                            "Téléphoner en voyant son interlocuteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d53bb221-ba43-4f67-9c35-a938b447f92d",
                                "sense_id": "c8a88030-816d-3f21-b5e6-17fcfe279efe",
                                "text": "Il s’agit par exemple de lui offrir des lieux agréables, connectés, sociables, pour se poser, travailler, visiophoner dans de bonnes conditions, organiser une rencontre, ou pourquoi pas, se faire livrer quelques achats."
                            },
                            {
                                "example_id": "2d2daebc-c13b-4a98-8ebf-d446fbe0554a",
                                "sense_id": "c8a88030-816d-3f21-b5e6-17fcfe279efe",
                                "text": "J’ai visiophoné à ma sœur qui habite l’expansion 4, elle a paru étonnée quand j’ai parlé du manque d’eau."
                            },
                            {
                                "example_id": "2edf4919-2dae-4b56-bd48-97e911104d7d",
                                "sense_id": "c8a88030-816d-3f21-b5e6-17fcfe279efe",
                                "text": "Je n'avais prévenu personne. Et pourtant toute la journée des gens ont visiophoné pour prendre rendez-vous."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b641ae4-48b4-3aac-bb60-eebf4fa4093c",
                        "entry_id": "752eeba9-51b0-3c87-aad9-17943e747414",
                        "glosses": [
                            "Utiliser le visiophone pour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebaf3227-2d8f-43e1-9889-56dc0c312f33",
                                "sense_id": "0b641ae4-48b4-3aac-bb60-eebf4fa4093c",
                                "text": "Enquête téléphonée ou visiophonée"
                            }
                        ]
                    }
