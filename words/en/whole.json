    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                    "sense_definition": "Containing all components; complete and not divided.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I read the <w>whole</w> book in just one afternoon.",
                            "target_lang_translations": {
                                "ru": "Я прочитал <w>всю</w> книгу всего за один день.",
                                "zh": "我只用了一个下午就读完了<w>整本</w>书。"
                            }
                        },
                        {
                            "text": "The <w>whole</w> family decided to go on vacation together.",
                            "target_lang_translations": {
                                "ru": "<w>Вся</w> семья решила поехать в отпуск вместе.",
                                "zh": "<w>全</w>家人决定一起去度假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entire",
                        "complete",
                        "total",
                        "full"
                    ],
                    "antonyms": [
                        "partial",
                        "incomplete"
                    ],
                    "common_phrases": [
                        "the whole time",
                        "the whole world",
                        "whole day",
                        "whole life"
                    ],
                    "target_lang_definitions": {
