                    {
                        "translation_id": "222cf626-a03a-4f80-be54-ab914959803d",
                        "source_entry_id": "ffd73cc3-a267-351c-b826-f7df31a9a50b",
                        "source_sense_id": "ad8c02ea-2d37-3afb-bfbc-7adb68634776",
                        "target_lang_word": "herbicide",
