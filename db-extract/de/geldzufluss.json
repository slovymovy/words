                "senses": [
                    {
                        "sense_id": "4b8c31be-e6b4-3da6-9ad6-5cb2d0e85e76",
                        "entry_id": "c822a17b-7308-327b-acd8-3962402b9611",
                        "glosses": [
                            "Zufluss von Geld"
