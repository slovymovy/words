                "senses": [
                    {
                        "sense_id": "5330da82-9aa5-3880-a91d-ce01123bb0b6",
                        "entry_id": "4094dde5-d540-367c-84c8-64bf6d3f19e6",
                        "glosses": [
                            "Sorte de petit chausson de taille variable, d'origine russe, cuits au four ou frit, que l'on peut servir en entrée ou en accompagnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f501c6-62af-4099-af0c-b21f4246df59",
                                "sense_id": "5330da82-9aa5-3880-a91d-ce01123bb0b6",
                                "text": "Tu parles trop le matin, assène-t-elle à Tolya en poussant vers lui une assiette de pirojky encore chauds."
                            },
                            {
                                "example_id": "687bf868-e8da-4e16-b66a-930fd6227f6c",
                                "sense_id": "5330da82-9aa5-3880-a91d-ce01123bb0b6",
                                "text": "On veut pas te déranger, petit père, dit Vassili Deïtechev hypocrite. Bien sûr, si tu avais encore quelques pirojoks (Il se servait au samovar ; thé sans sucre qui l’aidait à faire descendre des lamelles de pommes de terre séchées.)"
                            }
                        ]
                    }
                ],
