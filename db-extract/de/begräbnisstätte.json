                "senses": [
                    {
                        "sense_id": "d004ab3c-eca8-3d5a-b987-270c3fcde37e",
                        "entry_id": "5ed56499-439e-34f8-bcd8-92fe34a705b6",
                        "glosses": [
                            "Stelle, wo jemand begraben liegt"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "2677d7cb-92cb-48b5-be3f-96d5ac7cb3bd",
                                "sense_id": "d004ab3c-eca8-3d5a-b987-270c3fcde37e",
                                "text": "Das Grab unter dem Birnbaum hätte ihm als Begräbnisstätte gefallen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c16ab0a0-d094-30b3-969d-ac80b6f9e9d6",
                        "entry_id": "5ed56499-439e-34f8-bcd8-92fe34a705b6",
                        "glosses": [
                            "Anlage mit Platz zum Begraben einer Reihe von Verstorbenen"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "df17264f-a97e-4c17-89b7-f56bf1704d35",
                                "sense_id": "c16ab0a0-d094-30b3-969d-ac80b6f9e9d6",
                                "text": "„224 Begräbnisstätten hat Berlin, mehr [als] jede andere Großstadt.“"
                            },
                            {
                                "example_id": "d6fbd6b5-38ef-4257-854d-6b0a2261a241",
                                "sense_id": "c16ab0a0-d094-30b3-969d-ac80b6f9e9d6",
                                "text": "„Der Zehrensdorfer Friedhof war keine ausschließlich islamische Begräbnisstätte.“"
                            },
                            {
                                "example_id": "6ce35a5f-33e9-4476-8c10-4c106add534a",
                                "sense_id": "c16ab0a0-d094-30b3-969d-ac80b6f9e9d6",
                                "text": "„Neben den zufällig gefundenen Gräbern kamen bei den genauen Untersuchungen zwei riesige Begräbnisstätten und eine Nekropole, eine Totenstadt, ans Tageslicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
