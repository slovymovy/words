    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [
            {
                "entry_id": "49c4ab25-698b-3f93-aec7-8e8db16ab071",
                "word": "комфортабельно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3d990803-21fe-37b2-b44f-945e736c38dc",
                        "entry_id": "49c4ab25-698b-3f93-aec7-8e8db16ab071",
                        "glosses": [
                            "удобно, с комфортом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85e8037-6f3c-4c4b-ae97-bbb0c4fc1ca9",
                                "sense_id": "3d990803-21fe-37b2-b44f-945e736c38dc",
                                "text": "Только учтите, у нас в самолете не слишком комфортабельно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e3d4b36-575e-4821-b851-69fd94860036",
                        "source_entry_id": "49c4ab25-698b-3f93-aec7-8e8db16ab071",
                        "source_sense_id": "3d990803-21fe-37b2-b44f-945e736c38dc",
                        "target_lang_word": "comfortable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comfortable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88c63a36-1cb9-3d40-a5f5-e2dd5e0dfe0b",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Providing physical comfort and ease; agreeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3653764-4db9-40ff-97ec-0946b323c942",
                                                "sense_id": "88c63a36-1cb9-3d40-a5f5-e2dd5e0dfe0b",
                                                "text": "This is the most comfortable bed I’ve ever slept in."
                                            },
                                            {
                                                "example_id": "964fb2dc-1cae-4664-9579-45209804c641",
                                                "sense_id": "88c63a36-1cb9-3d40-a5f5-e2dd5e0dfe0b",
                                                "text": "We toted in the wood and got the fire going nice and comfortable. Lord James still set in one of the chairs and Applegate had cabbaged the other and was hugging the stove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe18804-1dd6-35c5-a1ee-5001ac29b84c",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "In a state of comfort and content."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c1f788-fa60-489e-8dd8-eec1b24b6071",
                                                "sense_id": "1fe18804-1dd6-35c5-a1ee-5001ac29b84c",
                                                "text": "What a great guestroom! I'll be quite comfortable here."
                                            },
                                            {
                                                "example_id": "47fadd70-e6fe-48c6-97a6-5d5363009b3c",
                                                "sense_id": "1fe18804-1dd6-35c5-a1ee-5001ac29b84c",
                                                "text": "A great bargain also had been[…]the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2179b19-2c56-3362-a42e-42301f5f0d52",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Confident; relaxed; not worried about someone or something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "beef1f67-239c-3a17-a2d2-fc83b2ac87af",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Amply sufficient, satisfactory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a03b60d4-84d9-4dc3-b32e-f2d82e04ed98",
                                                "sense_id": "beef1f67-239c-3a17-a2d2-fc83b2ac87af",
                                                "text": "A comfortable income should suffice to consider oneself rich."
                                            },
                                            {
                                                "example_id": "0258a697-3ca0-405e-a4cc-ae5a85184dad",
                                                "sense_id": "beef1f67-239c-3a17-a2d2-fc83b2ac87af",
                                                "text": "The home team is ahead by a comfortable margin."
                                            },
                                            {
                                                "example_id": "1b90d4f4-fd87-426f-b1a0-bb176c27b990",
                                                "sense_id": "beef1f67-239c-3a17-a2d2-fc83b2ac87af",
                                                "text": "When Hape sauntered over for a try after only three minutes it looked as if England were destined for a comfortable victory, but Georgia are made of sterner stuff, as they showed when running Scotland close in Invercargill last week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b12208-e272-38be-9a78-454265ddb9eb",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Comforting, providing comfort; consolatory."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297ae8bc-f49d-4cdf-a426-73afd7ef5905",
                                                "sense_id": "78b12208-e272-38be-9a78-454265ddb9eb",
                                                "text": "he was going to make away himself; but meeting by chance his master Plotinus, who, perceiving by his distracted looks all was not well, urged him to confess his grief; which when he had heard, he used such comfortable speeches, that he redeemed him e faucibus Erebi[…]."
                                            },
                                            {
                                                "example_id": "3c3e2370-6e91-453a-8113-dd0235df8a16",
                                                "sense_id": "78b12208-e272-38be-9a78-454265ddb9eb",
                                                "text": "a comfortable provision made for their subsistence"
                                            },
                                            {
                                                "example_id": "e948293d-50dd-4510-bc34-17a16aa282da",
                                                "sense_id": "78b12208-e272-38be-9a78-454265ddb9eb",
                                                "text": "The commanding officer readily granted a reprieve, and Louis, who, on the arrival of this letter, had forborne to communicate its contents to Theodore, left it should torture him with false hope, now hastened to him with this comfortable news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a052f5-a9b3-3a03-988b-6fc56692adfc",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Strong; vigorous; valiant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae058684-ddc4-4993-b8ed-1cfe35fa5510",
                                                "sense_id": "b9a052f5-a9b3-3a03-988b-6fc56692adfc",
                                                "text": "Thy conceit is nearer death than thy powers. For my sake be comfortable; hold death a while at the arm's end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b85ab5-8967-3aac-a1f3-e518414326c1",
                                        "entry_id": "3bf7f164-5d79-3cb4-97d2-1fa6384d1698",
                                        "glosses": [
                                            "Serviceable; helpful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a1f744-d939-4107-8fc6-8960cda4ab88",
                                                "sense_id": "27b85ab5-8967-3aac-a1f3-e518414326c1",
                                                "text": "Be comfortable to my mother, your mistress, and make much of her."
                                            }
                                        ]
                                    }
                                ]
                            },
