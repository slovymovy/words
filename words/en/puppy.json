                },
                {
                    "sense_id": "45a5d82f-4d89-3aa3-8f90-3e91092b57c8",
                    "sense_definition": "A conceited, arrogant, and impertinent person, especially a young man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found my place taken by an ill-bred <w>puppy</w> with too much money.",
                            "target_lang_translations": {
                                "ru": "Я обнаружил, что мое место занято невоспитанным <w>щенком</w> с кучей денег.",
                                "zh": "我发现我的座位被一个有钱但没教养的<w>毛头小子</w>占了。"
                            }
                        },
                        {
                            "text": "He behaved like an arrogant <w>puppy</w> throughout the entire dinner.",
                            "target_lang_translations": {
                                "ru": "Весь ужин он вел себя как высокомерный <w>щенок</w>.",
                                "zh": "整个晚餐期间，他表现得像个傲慢的<w>毛头小子</w>。"
                            }
                        }
                    ],
                    "traits": [
