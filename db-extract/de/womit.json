                            {
                                "example_id": "2fe668a0-bb4f-41e4-b193-c3e7802b3041",
                                "sense_id": "280b8d6a-7161-3ec2-af4a-fd6bb5866af2",
                                "text": "Womit brauchst du Hilfe?",
                                "translation": "What do you need help with?",
                                "english": "What do you need help with?"
                            },
                            {
                                "example_id": "5d647ec7-2184-40fc-b175-68f669f54009",
                                "sense_id": "280b8d6a-7161-3ec2-af4a-fd6bb5866af2",
                                "text": "Wenn ich einen Menschen kennenlerne, frage ich sogleich: womit beschäftigt er sich? und wie? und in welcher Folge? und mit der Beantwortung der Frage ist auch mein Interesse an ihm auf zeitlebens entschieden.",
                                "translation": "Wilhelm Meister's Apprenticeship",
                                "english": "Wilhelm Meister's Apprenticeship"
                            },
                            {
                                "example_id": "057d1219-c4b2-4579-bd48-f146c320cdba",
                                "sense_id": "280b8d6a-7161-3ec2-af4a-fd6bb5866af2",
                                "text": "»Womit kann ich Ihnen dienen?« nahm die Ministerin noch einmal das Wort."
                            }
                        ]
                    },
                    {
                        "sense_id": "d94459a2-9181-3f4a-8993-cb93a82f6a60",
                        "entry_id": "e39a29ac-f9ea-3e06-8d0c-78418bb370f7",
                        "glosses": [
                            "with which; by which"
                        ],
                        "tags": [
                            "relative"
                        ],
                        "examples": [
                            {
                                "example_id": "d96a809c-cff1-403c-97bc-c106def9ef5f",
                                "sense_id": "d94459a2-9181-3f4a-8993-cb93a82f6a60",
                                "text": "„[…]Wenigstens, mein Lieber“, fuhr sie fort, „sollst du gewahr werden, daß deine Wünsche, die freundliche Lebhaftigkeit, womit du sie ausdrückst, mich nicht ungerührt, mich nicht unbewegt lassen.",
                                "translation": "Elective Affinities",
                                "english": "Elective Affinities"
                            }
                        ]
                    }
                ],
