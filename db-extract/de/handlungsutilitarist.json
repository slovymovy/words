                "senses": [
                    {
                        "sense_id": "97b335c6-6501-389e-bd1c-f99c1b8b0d82",
                        "entry_id": "e38c85ef-0de2-306b-a8f3-4a0f98180a07",
                        "glosses": [
                            "Anhänger des Handlungsutilitarismus"
                        ],
                        "tags": [
                            "Ethik"
                        ],
                        "examples": [
                            {
                                "example_id": "8cf1a0bd-e619-4f6a-a464-0d16eee0b4c3",
                                "sense_id": "97b335c6-6501-389e-bd1c-f99c1b8b0d82",
                                "text": "„Der kluge Handlungsutilitarist wird Rawls' Anregung dankbar aufnehmen, gleichzeitig aber betonen, daß im Fall der eine bestimmte Praxis konstituierenden Regeln nun eben die jeweilige gesamte Praxis utilitaristischen Standards genügen muß.“"
                            },
                            {
                                "example_id": "80358e2f-8586-4b77-8bc4-b4398ff0a65c",
                                "sense_id": "97b335c6-6501-389e-bd1c-f99c1b8b0d82",
                                "text": "„Der Handlungsutilitarist kann sich das nicht wünschen.“"
                            },
                            {
                                "example_id": "af5e1f03-e810-4af2-9cb1-7e1c62c04a06",
                                "sense_id": "97b335c6-6501-389e-bd1c-f99c1b8b0d82",
                                "text": "„Handlungsutilitaristen können aber auch dieser Argumentation nicht beipflichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
