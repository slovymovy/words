            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "da93732f-15bf-3bbc-9967-7a8af047458b",
                    "sense_definition": "archaiczna forma zaimka osobowego ja połączonego z ruchomą końcówką czasu przeszłego lub teraźniejszego pierwszej osoby pojedynczej (-m)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jam</w> jest ten, który widział upadek dawnego królestwa na własne oczy.",
                            "target_lang_translations": {
                                "en": "<w>I am</w> the one who saw the fall of the ancient kingdom with my own eyes."
                            }
                        },
                        {
                            "text": "Nie lękajcie się o przyszłość, albowiem <w>jam</w> wam wiernym przewodnikiem.",
                            "target_lang_translations": {
                                "en": "Do not fear for the future, for <w>I am</w> your faithful guide."
                            }
                        }
                    ],
                    "synonyms": [
                        "ja"
                    ],
                    "common_phrases": [
                        "jam jest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane w stylizacji biblijnej lub poetyckiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "archaic or elevated form of the first-person singular pronoun \"ja\" combined with the past/present first-person clitic \"-m\" (I, I am)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "I",
                                "target_lang_sense_clarification": "archaic/biblical first-person pronoun"
                            },
                            {
                                "target_lang_word": "I am",
                                "target_lang_sense_clarification": "when used in biblical/elevated assertions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb1d807e-7af4-3774-9884-25fd28bbdba9",
                    "sense_definition": "forma celownika liczby mnogiej zaimka trzeciej osoby; odpowiednik standardowego im",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary gospodarz powiedział <w>jam</w> całą prawdę o tym zdarzeniu.",
                            "target_lang_translations": {
                                "en": "The old farmer told <w>them</w> the whole truth about this incident."
                            }
                        },
                        {
                            "text": "Trzeba było <w>jam</w> pomóc przy żniwach, bo sami nie dali rady.",
                            "target_lang_translations": {
                                "en": "It was necessary to help <w>them</w> with the harvest because they couldn't manage on their own."
                            }
                        }
                    ],
                    "synonyms": [
                        "im"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "gwara mazurska"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "dialectal dative plural form of the third-person pronoun, equivalent to standard \"im\""
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "them",
                                "target_lang_sense_clarification": "dialectal dative pronoun"
                            },
                            {
                                "target_lang_word": "to them",
                                "target_lang_sense_clarification": "dialectal dative pronoun"
                            }
                        ]
                    }
                }
            ]
        },
        {
