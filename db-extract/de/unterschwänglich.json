                    }
                ],
                "senses": [
                    {
                        "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                        "entry_id": "00bcd54d-e684-373b-a7ed-455169a615dc",
                        "glosses": [
                            "nicht offen voller Emotionen auslebend/ausgelebt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7e1b5ecf-2bff-4027-9401-01dbf07f4e3a",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Auf dieses weisen daneben auch die Themen Vergänglichkeit und Tod, die in den ‚vergänglichen‘ Aufenthalten, ‚unterschwänglichen‘ Abschieden, ‚beerdlichen‘ Lehrern und schließlich in den ‚schnellen‘ Toden des letzten Verses gegenwärtig sind.“"
                            },
                            {
                                "example_id": "0c536149-118f-495a-8b99-6780f820bece",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Der positive Selbstwert spiegelt sich nicht in über- oder unterschwänglichen Gefühlszuständen, sondern in einer existenziellen Sicherheit der Unverletzbarkeit.“"
                            },
                            {
                                "example_id": "27786a6f-fa98-49ee-920b-bb43007d5d15",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Als Gegenbegriff zu überschwenglich – von (übermäßig) heftigen Gefühlsäußerungen begleitet – bezeichnet er Gelassenheit, und gelassen, unterschwänglich können die Abschiede sein.“"
                            },
                            {
                                "example_id": "7a5ea6a2-d285-4a54-b94c-13e72c34702f",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Trotz alledem beschlich mich immer wieder dieses unterschwängliche Schamgefühl, die einzige Überlebende zu sein.“"
                            },
                            {
                                "example_id": "96a3cbc3-6008-4b96-bc5b-5d8403404bb5",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Ich bedankte mich unterschwänglich, nahm die Mappe entgegen, und Frau Westphal entschwand.“"
                            },
                            {
                                "example_id": "b6f22534-8bea-4c8a-930e-17d3232a0a65",
                                "sense_id": "96c01854-5f38-3b49-8068-f5577651b62b",
                                "text": "„Er schreibt Glossen und Rezensionen, Porträts und — «so unterschwänglich wie möglich» — Gedichte, schreibt über Ilja Ehrenburg und Hemingway, über John Galsworthy und Upton Sinclair, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
