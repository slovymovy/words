                        "examples": [
                            {
                                "example_id": "39366346-3d74-4022-8d29-81ae9a47ebd3",
                                "sense_id": "d51ecfd0-ceb2-32e7-9626-e96cbe9e9b76",
                                "text": "\"Het was best even schrikken\", zegt filiaalleider Rik van Bree van kringloopwinkel Het Goed tegen Omroep Brabant. \"De werknemer die de tas vond, had gelukkig het vernuft om gelijk iemand van de leiding in te schakelen.\""
                            },
                            {
                                "example_id": "682655b2-5c2c-4237-825c-c1b7180bf93c",
                                "sense_id": "d51ecfd0-ceb2-32e7-9626-e96cbe9e9b76",
                                "text": "Bij De Waard werken vier mensen in de winkel in Heerde en ongeveer dertig mensen in de fabriek in Tsjechië. Het is nog onduidelijk wat er met het personeel gaat gebeuren. De winkel in Heerde blijft voorlopig open, zegt filiaalleider Pé Bouwman bij Omroep Gelderland. \"Het is hoogseizoen. We draaien eigenlijk prima.\""
                            }
                        ]
