                        "entry_id": "ff80295f-aec6-3005-80b3-f9d83cc3662d",
                        "glosses": [
                            "Est utilisé pour qualifier un temple sans colonnades latérales."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    }
