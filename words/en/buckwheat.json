            "senses": [
                {
                    "sense_id": "6dc01855-e395-3c6b-8f89-2ac64a9a732e",
                    "sense_definition": "The edible grain-like seeds of the buckwheat plant, commonly cooked or ground into flour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botany_and_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prepared a warm bowl of <w>buckwheat</w> porridge for breakfast.",
                            "target_lang_translations": {
                                "pl": "Przygotowała na śniadanie miskę ciepłej <w>kaszy gryczanej</w>."
                            }
                        },
                        {
                            "text": "Pancakes made from <w>buckwheat</w> flour are popular in many regions.",
                            "target_lang_translations": {
                                "pl": "Naleśniki z mąki <w>gryczanej</w> są popularne w wielu regionach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "buckwheat flour",
                        "buckwheat noodles",
                        "buckwheat honey"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jadalne ziarna gryki, często gotowane (np. jako kasza) lub mielone na mąkę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gryka",
                                "target_lang_sense_clarification": "ziarno gryki"
                            },
                            {
                                "target_lang_word": "kasza gryczana",
                                "target_lang_sense_clarification": "produkt spożywczy z nasion gryki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2d63e28-59bb-3da4-a584-0d4bbec23ce0",
                    "sense_definition": "An Asian plant (Fagopyrum esculentum) cultivated for its edible triangular seeds.",
