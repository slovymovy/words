                        ],
                        "form": "more frosted"
                    },
                    {
                        "form_id": "3da6bfc7-3ecf-47a8-b676-009b36d555df",
                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most frosted"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd2e3e90-08bc-341e-963f-bd19e6ea1b5b",
                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                        "glosses": [
                            "Covered in frost; frosty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c257dab7-180b-4385-bb37-a4e6b64d55a2",
                                "sense_id": "cd2e3e90-08bc-341e-963f-bd19e6ea1b5b",
                                "text": "Eiswein is made from frosted grapes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                        "glosses": [
                            "Translucent, appearing to be covered in frost."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ced6059-db15-431d-9ffb-772e5e59ab6f",
                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                "text": "She installed frosted windows, since there was a clear view of her bathroom from her neighbor's bedroom."
                            },
                            {
                                "example_id": "795905bc-60a1-4b6e-9e0c-5fcb30bf5918",
                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                "text": "The point of interest about this particular specimen was that it must have remained intact for at least a quarter of a century, as it had embossed in the frosted glass the initials of the old Great North of Scotland Railway in the form of a scroll, the sort of relic of pre-grouping days that can still be found here and there if one is observant."
                            },
                            {
                                "example_id": "b08e03b4-0047-4f39-8977-d20fca84a477",
                                "sense_id": "ce6eba42-c7fe-3e3c-be30-b8bb26555f7a",
                                "text": "The vestibule has a row of brass mailboxes and a varnished umbrella rack and a rubber mat on the marble floor and two doors, one to the right with frosted glass and another in front of them of wire-reinforced glass through which he sees rubber-treaded stairs."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ff3aa14-c421-3e66-b6c2-f8cfd109312c",
                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                        "glosses": [
                            "Damaged by frost."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba79abc0-a1c2-4ee1-b8c0-9b0dc2ddc9aa",
                                "sense_id": "8ff3aa14-c421-3e66-b6c2-f8cfd109312c",
                                "text": "Frosted fruit will be unsalable."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bb31d37-7e8e-34ec-89b8-a074bf8bddb5",
                        "entry_id": "886e8d1c-d4ae-30b8-820c-7accfd9ac5b5",
                        "glosses": [
                            "Extremely intoxicated."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "202a9550-bd64-43ca-a39c-3b1cf432f568",
                                "sense_id": "2bb31d37-7e8e-34ec-89b8-a074bf8bddb5",
                                "text": "I was so frosted after drinking that 12-pack."
                            }
                        ]
                    }
                ],
