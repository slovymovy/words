                        "examples": [
                            {
                                "example_id": "e8dccde0-aaf4-42dc-8125-3b3845313ffb",
                                "sense_id": "d9d5bdbf-14d4-3eb6-8a7b-699fad128922",
                                "text": "The fact that stuck in my head, however, that the prettiest thing to one crow is another crow, a male monkey sees a female monkey the way Romeo had ‘typee’ for his Juliet."
                            },
                            {
                                "example_id": "ae5f5a78-81a9-45f8-adaa-54900443b04f",
                                "sense_id": "d9d5bdbf-14d4-3eb6-8a7b-699fad128922",
                                "text": "Stephen continued to see more of Sarah, after the Black Friday riots. He had typee for her; she was constantly in his thoughts."
                            },
                            {
                                "example_id": "8834cb6e-c40a-4143-a1b5-af1be5c1c2a3",
                                "sense_id": "d9d5bdbf-14d4-3eb6-8a7b-699fad128922",
                                "text": "I played chasie (tag) with him and the other children in the yard, but I am certain Oswald never knew I had typee for him. The love affair was short lived, because we only lived there for a short time."
                            }
                        ]
                    }
