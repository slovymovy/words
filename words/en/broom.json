{
    "word_family": [
        "broomstick",
        "broomy",
        "broomball"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a3fed4c-db9c-3df4-8a93-6004ff93f945",
                    "sense_definition": "A domestic utensil with fibers bound together at the end of a long handle, used for sweeping.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>broom</w> to sweep the dust off the kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Она взяла <w>веник</w>, чтобы смести пыль с кухонного пола."
                            }
                        },
                        {
                            "text": "Please put the <w>broom</w> back in the closet after you finish cleaning.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поставь <w>метлу</w> обратно в кладовку после того, как закончишь уборку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "new broom",
                        "push broom",
                        "sweep with a broom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хозяйственный инструмент с волокнами, закрепленными на конце длинной ручки, используемый для подметания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метла́",
                                "target_lang_sense_clarification": "обычно для улицы или больших помещений"
                            },
                            {
                                "target_lang_word": "ве́ник",
                                "target_lang_sense_clarification": "обычно для дома, часто без длинной ручки"
                            },
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "современная щетка для пола на длинной ручке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0824c721-c8b1-3233-841c-b513f35cf8e7",
                    "sense_definition": "Any of several yellow-flowered shrubs of the family Fabaceae, with long, stiff, thin branches and small or few leaves.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hillside was covered in bright yellow <w>broom</w> during the spring.",
                            "target_lang_translations": {
                                "ru": "Весной склон холма был покрыт ярко-желтым <w>ракитником</w>."
                            }
                        },
                        {
                            "text": "Wild <w>broom</w> and brambles have made the old railway line impassable.",
                            "target_lang_translations": {
                                "ru": "Дикий <w>дрок</w> и ежевика сделали старую железнодорожную ветку непроходимой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow broom",
                        "wild broom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кустарник семейства Бобовые с желтыми цветами, длинными жесткими тонкими ветвями и мелкими листьями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раки́тник",
                                "target_lang_sense_clarification": "ботаническое название"
                            },
                            {
                                "target_lang_word": "дрок",
                                "target_lang_sense_clarification": "родственное растение с желтыми цветами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c86f1496-5100-36f0-a8d8-dd2b475d3845",
                    "sense_definition": "An implement with which players sweep the ice in curling to make a stone travel further and curl less.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curling team used their <w>brooms</w> vigorously to guide the stone toward the house.",
                            "target_lang_translations": {
                                "ru": "Команда по кёрлингу активно работала <w>щётками</w>, чтобы направить камень к «дому»."
                            }
                        },
                        {
                            "text": "A high-quality curling <w>broom</w> is essential for competitive play on the ice.",
                            "target_lang_translations": {
                                "ru": "Качественная <w>щётка</w> для кёрлинга необходима для соревновательной игры на льду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curling broom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвентарь, которым игроки в кёрлинг трут лед, чтобы камень катился дальше и меньше отклонялся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щётка",
                                "target_lang_sense_clarification": "спортивный инвентарь для кёрлинга"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                    "sense_definition": "A firearm, especially a shotgun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the lyrics, he mentions rising that <w>broom</w> when the street needs cleaning.",
                            "target_lang_translations": {
                                "ru": "В тексте песни он упоминает, что достает <w>ствол</w>, когда улицу нужно «почистить»."
                            }
                        },
                        {
                            "text": "The slang term <w>broom</w> is often used in drill music to refer to a shotgun.",
                            "target_lang_translations": {
                                "ru": "Сленговое слово <w>broom</w> часто используется в дрилл-музыке для обозначения дробовика."
                            }
                        }
                    ],
                    "synonyms": [
                        "boomstick",
                        "firearm",
                        "gun",
                        "piece"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in urban or criminal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огнестрельное оружие, особенно дробовик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пу́шка",
                                "target_lang_sense_clarification": "сленг для обозначения оружия"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "сленг для огнестрельного оружия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                    "sense_definition": "To sweep with a broom.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>broomed</w> the dirt floor clean before setting up the tent.",
                            "target_lang_translations": {
                                "ru": "Он <w>подмёл</w> земляной пол перед тем, как ставить палатку."
                            }
                        },
                        {
                            "text": "I spent the morning <w>brooming</w> the front steps to remove the fallen leaves.",
                            "target_lang_translations": {
                                "ru": "Я провел все утро, <w>подметая</w> крыльцо, чтобы убрать опавшие листья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broom the floor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подметать или чистить поверхность с помощью метлы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмета́ть",
                                "target_lang_sense_clarification": "процесс уборки"
                            },
                            {
                                "target_lang_word": "мести́",
                                "target_lang_sense_clarification": "совершать движения метлой"
                            },
                            {
                                "target_lang_word": "подмести́",
                                "target_lang_sense_clarification": "закончить уборку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15f1f81d-7ea2-3734-a450-18f1da8d8955",
                    "sense_definition": "To get rid of someone, such as firing an employee or breaking up with a partner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to <w>broom</w> him after he missed three shifts in a row.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>вышвырнуть</w> его после того, как он пропустил три смены подряд."
                            }
                        },
                        {
                            "text": "If you can't work with the team, the boss might <w>broom</w> you fast.",
                            "target_lang_translations": {
                                "ru": "Если ты не можешь работать в команде, босс может быстро тебя <w>уволить</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broom someone fast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for dismissing someone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавиться от кого-либо, например, уволить сотрудника или расстаться с партнером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́швырнуть",
                                "target_lang_sense_clarification": "грубо уволить или прогнать"
                            },
                            {
                                "target_lang_word": "метла́",
                                "target_lang_sense_clarification": "в контексте «вымести» кого-то"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "60af4199-687a-36c0-880a-268c3c188a9c",
                    "sense_definition": "The sound of a car engine, often used in imitation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child ran around the room shouting <w>broom</w> <w>broom</w> while holding his toy car.",
                            "target_lang_translations": {
                                "ru": "Ребенок бегал по комнате с игрушечной машинкой, крича «<w>врум</w>-<w>врум</w>»."
                            }
                        },
                        {
                            "text": "I'm in my car, <w>broom</w> <w>broom</w>, ready to drive away.",
                            "target_lang_translations": {
                                "ru": "Я в машине, <w>врум</w>-<w>врум</w>, готов ехать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "broom broom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "onomatopoeic imitation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук автомобильного двигателя, часто используемый при подражании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врум-врум",
                                "target_lang_sense_clarification": "звукоподражание мотору"
                            },
                            {
                                "target_lang_word": "ж-ж-ж",
                                "target_lang_sense_clarification": "детское подражание звуку машины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5da77940-d600-35c0-ad82-4a8b6992904b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Broom</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Брум</w> живет в этом районе уже более двадцати лет."
                            }
                        },
                        {
                            "text": "The author of the book is listed as Sarah <w>Broom</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги указана как Сара <w>Брум</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Брум",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf202c25-ea06-3f5a-874f-6a0d7fb92f02",
                    "sense_definition": "A village or locality in various parts of England, such as Bedfordshire or Warwickshire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to take a weekend trip to the quiet village of <w>Broom</w> in Bedfordshire.",
                            "target_lang_translations": {
                                "ru": "Они решили отправиться на выходные в тихую деревушку <w>Брум</w> в Бедфордшире."
                            }
                        },
                        {
                            "text": "The historic map shows the location of <w>Broom</w> near the river.",
                            "target_lang_translations": {
                                "ru": "На исторической карте показано расположение <w>Брума</w> у реки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to UK geography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня или местность в различных частях Англии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Брум",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}