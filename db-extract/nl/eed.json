                "senses": [
                    {
                        "sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                        "entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "glosses": [
                            "een plechtige verzekering dat men de waarheid spreekt of een belofte zal nakomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080554ab-b4ca-4a5f-b278-2757d9d2ecf5",
                                "sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                                "text": "Hij legde een eed af."
                            },
                            {
                                "example_id": "cffdac29-f91e-4357-96cb-0af93134dc3a",
                                "sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                                "text": "Volgens Harris tonen de opmerkingen van John Kelly aan dat Trump \"geen leger wil dat loyaal is aan de grondwet van de VS. Hij wil een leger dat hem persoonlijk trouw zal zijn, iemand die zijn bevelen zal gehoorzamen, zelfs als hij hen zegt de wet te overtreden of hun eed aan de grondwet te negeren\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "4190baf9-41f8-3bd8-99ff-066a1976314c",
                        "entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "glosses": [
                            "getuige"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f5fd06c-4e00-47a7-a4f4-0685ca04b9e9",
                        "source_entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "source_sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                        "source_sense_description": "een plechtige verzekering dat men de waarheid spreekt of een belofte zal nakomen",
                        "target_lang_word": "Eid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                        "entry_id": "6829860d-a00e-35cd-89ea-bbdb78f4225b",
                                        "glosses": [
                                            "feierliche Beteuerung eines Versprechens oder einer Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ab3356-5194-4255-9ad0-e60d5d01a1e1",
                                                "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                                "text": "Er schwor einen Eid auf seine Aussage."
                                            },
                                            {
                                                "example_id": "39247599-e9d2-4c5b-94aa-e72f976160bb",
                                                "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                                "text": "Sie leistete den vorgeschriebenen Eid."
                                            },
                                            {
                                                "example_id": "c7302c1d-6e2d-4f32-9ea4-30a61592ddff",
                                                "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                                "text": "„Der Eid soll die unterschiedlichen Gruppen der Freiheitskämpfer einen, ihren Mut zum Widerstand stärken.“"
                                            },
                                            {
                                                "example_id": "0a9f14d5-aec3-4857-ad69-30bac0bdc7c4",
                                                "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                                "text": "„Diese angenehme Aufgabe gestattete mir, alles gemächlich zu betrachten und zu streicheln, und ich muß dem Leser wohl nicht unter Eid versichern, daß ich mich der Aufgabe nach besten Kräften widmete.“"
                                            },
                                            {
                                                "example_id": "ff7538aa-488e-49f7-95f3-7063d3364fa2",
                                                "sense_id": "c8670b4d-8a6f-31f5-a688-8108b56cb7cf",
                                                "text": "„Ich kann einen Eid darauf ablegen, daß mir das Hören und Sehn verging, und ich starb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45bba360-5398-40f7-bf9a-b0177aed8d84",
                        "source_entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "source_sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                        "source_sense_description": "een plechtige verzekering dat men de waarheid spreekt of een belofte zal nakomen",
                        "target_lang_word": "Schwur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d520f5f-af6a-3b1d-a942-44ab743a73a8",
                                        "entry_id": "f10ff6f5-a1a1-38b2-9deb-a91942d0370d",
                                        "glosses": [
                                            "verbindliche Festlegung auf etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdb4a1b-379f-4c56-a326-597fde672500",
                                                "sense_id": "7d520f5f-af6a-3b1d-a942-44ab743a73a8",
                                                "text": "„Dem Entschluss, alten Familienschmuck zu verpfänden, stimmte die Ehefrau nur nach seinem Schwur zu, zumindest die Ringe wieder auszulösen.“"
                                            },
                                            {
                                                "example_id": "c3fdcc1c-65dd-4d26-9510-76f9e5f25e4b",
                                                "sense_id": "7d520f5f-af6a-3b1d-a942-44ab743a73a8",
                                                "text": "„Ein Schwur unter Liebenden bedeutet nach meiner Erfahrung am wenigsten.“"
                                            },
                                            {
                                                "example_id": "5dc2aefa-6ed4-4d08-9fb9-016d24f6aab1",
                                                "sense_id": "7d520f5f-af6a-3b1d-a942-44ab743a73a8",
                                                "text": "„Bald müssen sie erkennen, dass Schwüre allein nicht ausreichen, um ein ganzes Volk zum organisierten Widerstand zu führen – schon gar nicht gegen überlegenes Militär.“"
                                            },
                                            {
                                                "example_id": "6c4bbfec-b8fc-4dde-a1b9-58777e6d7a0f",
                                                "sense_id": "7d520f5f-af6a-3b1d-a942-44ab743a73a8",
                                                "text": "„Er hatte sich damals geschworen, sie nie wieder aufzusuchen – und seinen Schwur treu und fest gehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9685bda-0f01-3036-bde8-c291594d1368",
                                        "entry_id": "f10ff6f5-a1a1-38b2-9deb-a91942d0370d",
                                        "glosses": [
                                            "Eid vor einer dazu berechtigten Institution"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3f6024-9eb0-4e4a-b213-4a355821543b",
                                                "sense_id": "b9685bda-0f01-3036-bde8-c291594d1368",
                                                "text": "Sie mussten einen Schwur auf die Verfassung ablegen."
                                            },
                                            {
                                                "example_id": "8f846b6e-226f-4a13-9e3e-17c71be00976",
                                                "sense_id": "b9685bda-0f01-3036-bde8-c291594d1368",
                                                "text": "„Nach kurzer Messe las Hauptmann Turner mit Schwung, Pathos und erstaunlichem Organ den Schwur deutsch für die deutsche Mannschaft, die ihn wiederholte; dann kam der tschechische Schwur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b5ab041-3d85-427d-8dca-98234c009c1f",
                        "source_entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "source_sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                        "source_sense_description": "een plechtige verzekering dat men de waarheid spreekt of een belofte zal nakomen",
                        "target_lang_word": "oath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                        "entry_id": "6d55f677-3cc3-39d1-b12a-9a6732944bb6",
                                        "glosses": [
                                            "A solemn pledge or promise that invokes a deity, a ruler, or another entity (not necessarily present) to attest the truth of a statement or sincerity of one's desire to fulfill a contract or promise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98cc47e4-1b48-47b5-b48f-b43528c3bdbc",
                                                "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                                "text": "take an oath"
                                            },
                                            {
                                                "example_id": "054fdf8c-db20-4ae5-95f2-2fca7bd83000",
                                                "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                                "text": "swear an oath"
                                            },
                                            {
                                                "example_id": "5c634c20-1a7d-4cd1-b13a-36f589c3c4b8",
                                                "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                                "text": "break one's oath"
                                            },
                                            {
                                                "example_id": "eddafb00-7036-4d48-8d08-57a0ea9ece2f",
                                                "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                                "text": "But all of us took an oath to do our duty when we joined the Space Force, and I fully expect everyone to willingly keep their word. But you took no oath, and have no obligation."
                                            },
                                            {
                                                "example_id": "1da4badc-ce93-4e51-81c6-ab764a2a40d4",
                                                "sense_id": "6389a60a-f7e7-3a28-afbe-d777a34cb399",
                                                "text": "There are […] brought all the way from Bougainville to present their birth certificates and testify in this courtroom, under oath, as to their given names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642ff7e1-54e2-3713-9d30-d2ef3831a23a",
                                        "entry_id": "6d55f677-3cc3-39d1-b12a-9a6732944bb6",
                                        "glosses": [
                                            "A statement or promise which is strengthened (affirmed) by such a pledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84bd2cda-0dfa-45ed-b02a-44a1034e7427",
                                                "sense_id": "642ff7e1-54e2-3713-9d30-d2ef3831a23a",
                                                "text": "After taking the oath of office, she became the country's forty-third premier."
                                            },
                                            {
                                                "example_id": "c83770d6-8773-4d4f-83b2-4e9d8008b9ff",
                                                "sense_id": "642ff7e1-54e2-3713-9d30-d2ef3831a23a",
                                                "text": "The generals swore an oath of loyalty to the country."
                                            },
                                            {
                                                "example_id": "181516e7-7a77-4b36-9fea-010ead91abbd",
                                                "sense_id": "642ff7e1-54e2-3713-9d30-d2ef3831a23a",
                                                "text": "Wrex: [sigh] Before I left, I made an oath to my father's father.\nWrex: I swore to recover my family's battle armor. It was taken from him after the uprising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7124130f-a819-325d-b13c-42b597c56615",
                                        "entry_id": "6d55f677-3cc3-39d1-b12a-9a6732944bb6",
                                        "glosses": [
                                            "A light, irreverent or insulting appeal to a deity or other entity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "274c82d7-646d-3a2e-a67b-a01ecb508b2b",
                                        "entry_id": "6d55f677-3cc3-39d1-b12a-9a6732944bb6",
                                        "glosses": [
                                            "A curse, a curse word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08dc83dc-89d3-4417-ba5c-9bc8a8ab87c9",
                                                "sense_id": "274c82d7-646d-3a2e-a67b-a01ecb508b2b",
                                                "text": "The farther from the Senator's office, the darker and older the furniture, the freer fly four-letter oaths, the higher the heaps of unfiled and unattended papers culminating in a frenzy of pulp in the press section[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b3289e7-811a-39ea-b284-e918394d2e58",
                                        "entry_id": "d525d51a-ca18-358c-bc21-ec3324482840",
                                        "glosses": [
                                            "To pledge."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4729b661-6320-4180-8bf3-06dbc90b0b90",
                        "source_entry_id": "3871339a-38c3-3ea2-adb6-b64761994fd1",
                        "source_sense_id": "912cc012-171e-3982-bbc8-c92f22324f05",
                        "source_sense_description": "een plechtige verzekering dat men de waarheid spreekt of een belofte zal nakomen",
                        "target_lang_word": "serment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8862c650-0067-35cb-8733-bba558c310ac",
                                        "entry_id": "c429ccc1-a43e-3531-ad10-4b193c76e736",
                                        "glosses": [
                                            "Affirmation ou promesse faite en attestant Dieu, un être ou un objet sacré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8222747d-1bbf-4ca6-8dca-c49b60bae53a",
                                                "sense_id": "8862c650-0067-35cb-8733-bba558c310ac",
                                                "text": "Les faux serments que la justice autorise en France, ne doivent-ils pas être à jamais proscrits ?"
                                            },
                                            {
                                                "example_id": "d7042066-638b-43de-8568-6163e760bd30",
                                                "sense_id": "8862c650-0067-35cb-8733-bba558c310ac",
                                                "text": "Suivant le caractère des barbares, dont la fougue est violente, mais de peu de durée, ils se réconcilièrent en faisant de nouveau le serment de ne rien entreprendre l’un contre l’autre."
                                            },
                                            {
                                                "example_id": "fdf71b5d-0be4-45fc-bda2-789c9eaeacc0",
                                                "sense_id": "8862c650-0067-35cb-8733-bba558c310ac",
                                                "text": "Tout homme qui obtient ce qu'il désire, ou qui va l'obtenir, veut la durée : rien de plus naturel que les serments prodigués par les amoureux. Le bonheur spontané veut la durée. Mais de la durée vient l’ennui : c'est pourquoi beaucoup les confondent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a2b89b7-2f39-3126-a8bd-6c00cdc8b491",
                                        "entry_id": "c429ccc1-a43e-3531-ad10-4b193c76e736",
                                        "glosses": [
                                            "Promesse de respecter la constitution civile du clergé que faisaient les prêtres."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e38f6865-c434-4c86-96ca-220e54e6fe15",
                                                "sense_id": "2a2b89b7-2f39-3126-a8bd-6c00cdc8b491",
                                                "text": "[…] ; il étoit destiné, quand la révolution arriva, à occuper une des premières chaires dans l'université de Reims. Son refus de serment l'obligea de s'expatrier ; […]."
                                            },
                                            {
                                                "example_id": "0cacb118-5700-4819-b9e9-479ce5c121d2",
                                                "sense_id": "2a2b89b7-2f39-3126-a8bd-6c00cdc8b491",
                                                "text": "Il y a l'abbé Fortier, ce monarchiste rigide, qui bien certainement ne voudra pas se transformer en prêtre constitutionnel, et qui préférera la persécution au serment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
