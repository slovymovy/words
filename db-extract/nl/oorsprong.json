                "senses": [
                    {
                        "sense_id": "2b36bdd8-29ee-3cfb-9fe7-f6f150e356f3",
                        "entry_id": "ff00a91b-8033-33b3-bbb9-b0e209e96efa",
                        "glosses": [
                            "herkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7195ddf5-b78a-4ac6-a6f4-e51e67819464",
                                "sense_id": "2b36bdd8-29ee-3cfb-9fe7-f6f150e356f3",
                                "text": "Dirk Hut, van oorsprong Groninger, stond beneden op het platform en kon het zwiepende gevaarte maar nét ontwijken. Daarbij kwam hij hard tussen afgebroken onderdelen van het reuzenrad terecht."
                            },
                            {
                                "example_id": "1d2721dc-55dd-41c2-b3a7-d3ea792677ae",
                                "sense_id": "2b36bdd8-29ee-3cfb-9fe7-f6f150e356f3",
                                "text": "Hopelijk is dit boek niet alleen interessant voor sportliefhebbers die meer te weten willen komen over de oorsprong en geschiedenis van sport, maar ook voor wie zich afvraagt waarom sport zo belangrijk gevonden wordt."
                            },
                            {
                                "example_id": "367d75bf-92aa-4ad2-a715-9bc440d16ee9",
                                "sense_id": "2b36bdd8-29ee-3cfb-9fe7-f6f150e356f3",
                                "text": "De bedoeling van dit boek is hierbij behulpzaam te zijn. In de vele lees- en voorleesverhalen en de korte documentaties wordt iets van de oorsprong en de viering van onze jaarfeesten belicht."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b427f7d-159e-3a6a-aafb-757246396e8b",
