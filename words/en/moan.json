{
    "word_family": [
        "moaner",
        "moaning",
        "moanful"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc427366-d2f2-3d3c-800c-6034c2f64575",
                    "sense_definition": "To make a low, long sound expressing physical or mental pain, or sometimes pleasure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vocal-expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player began to <w>moan</w> softly while waiting for the medical team to arrive.",
                            "target_lang_translations": {
                                "ru": "Травмированный игрок начал тихо <w>стонать</w> в ожидании приезда медицинской бригады."
                            }
                        },
                        {
                            "text": "She could not help but <w>moan</w> with pleasure when she finally tasted the delicious dessert.",
                            "target_lang_translations": {
                                "ru": "Она не смогла сдержать <w>стон</w> удовольствия, когда наконец попробовала этот вкуснейший десерт."
                            }
                        }
                    ],
                    "synonyms": [
                        "groan"
                    ],
                    "antonyms": [
                        "laugh",
                        "cheer"
                    ],
                    "common_phrases": [
                        "moan with pleasure",
                        "moan in pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать низкий, протяжный звук, выражающий физическую или душевную боль, а иногда удовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стонать",
                                "target_lang_sense_clarification": "издавать звуки от боли или удовольствия"
                            },
                            {
                                "target_lang_word": "простонать",
                                "target_lang_sense_clarification": "издать стон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8890ecc4-1d57-3de6-a279-9f2d04310982",
                    "sense_definition": "To complain about something in an annoying or persistent way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>moaning</w> about the weather and just put on a warm coat before we leave.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>ныть</w> из-за погоды, просто надень теплое пальто перед выходом."
                            }
                        },
                        {
                            "text": "He is always <w>moaning</w> about his job, yet he never tries to find a new one.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>жалуется</w> на свою работу, но при этом даже не пытается найти новую."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "grumble",
                        "whinge",
                        "grouse",
                        "bellyache",
                        "gripe",
                        "beef"
                    ],
                    "antonyms": [
                        "praise",
                        "rejoice"
                    ],
                    "common_phrases": [
                        "moan about everything",
                        "stop moaning"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal British English to mean complaining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жаловаться на что-либо раздражающим или настойчивым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "надоедливо жаловаться"
                            },
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать недовольство вполголоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36fd7430-6560-3e54-b787-1524055c7787",
                    "sense_definition": "To say something while making a low, mournful sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal-expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "‘I am so tired,’ he <w>moaned</w> as he slumped down onto the old sofa.",
                            "target_lang_translations": {
                                "ru": "«Я так устал», — <w>простонал</w> он, плюхнувшись на старый диван."
                            }
                        },
                        {
                            "text": "She <w>moaned</w> her disapproval when she saw the huge pile of dishes in the sink.",
                            "target_lang_translations": {
                                "ru": "Она <w>высказала</w> свое недовольство со стоном, увидев огромную гору посуды в раковине."
                            }
                        }
                    ],
                    "synonyms": [
                        "groan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать что-либо, издавая при этом низкий, скорбный звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простонать",
                                "target_lang_sense_clarification": "сказать что-то со стоном"
                            },
                            {
                                "target_lang_word": "пробормотать",
                                "target_lang_sense_clarification": "сказать невнятно и жалобно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7d9677f-d800-3c81-92ca-892e3a753221",
                    "sense_definition": "To mourn or lament a person or a situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote several verses to <w>moan</w> the loss of his childhood home.",
                            "target_lang_translations": {
                                "ru": "Поэт написал несколько стихов, чтобы <w>оплакать</w> потерю дома своего детства."
                            }
                        },
                        {
                            "text": "They gathered in the hall to <w>moan</w> their fallen leader with songs and prayers.",
                            "target_lang_translations": {
                                "ru": "Они собрались в зале, чтобы <w>помянуть</w> своего павшего лидера песнями и молитвами."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemoan",
                        "bewail",
                        "mourn",
                        "lament"
                    ],
                    "antonyms": [
                        "celebrate"
                    ],
                    "common_phrases": [
                        "moan one's fate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this transitive use for mourning is less common in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оплакивать или сокрушаться о человеке или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "выражать скорбь"
                            },
                            {
                                "target_lang_word": "сетовать",
                                "target_lang_sense_clarification": "жаловаться на судьбу или обстоятельства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fd1d1f2-2d0b-3032-bba3-eafc30e235f1",
                    "sense_definition": "To cause someone to feel distress or sadness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sight of the abandoned animals <w>moaned</w> her heart deeply.",
                            "target_lang_translations": {
                                "ru": "Вид брошенных животных глубоко <w>опечалил</w> её сердце."
                            }
                        },
                        {
                            "text": "It <w>moans</w> me to see such talent go to waste in this city.",
                            "target_lang_translations": {
                                "ru": "Мне <w>больно</w> видеть, как такой талант пропадает зря в этом городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "grieve",
                        "sadden",
                        "distress"
                    ],
                    "antonyms": [
                        "gladden",
                        "delight"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "rarely used in this sense in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать страдание или печаль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печалить",
                                "target_lang_sense_clarification": "вызывать грусть"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "причинять душевную боль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15cb0772-36bf-3d28-914d-a725e32a36a2",
                    "sense_definition": "A low, mournful sound made by a person or animal, often indicating pain or grief.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vocal-sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient let out a deep <w>moan</w> when the nurse moved his broken leg.",
                            "target_lang_translations": {
                                "ru": "Пациент издал глубокий <w>стон</w>, когда медсестра пошевелила его сломанную ногу."
                            }
                        },
                        {
                            "text": "We heard the distant <w>moan</w> of the wind through the cracks in the old cabin.",
                            "target_lang_translations": {
                                "ru": "Мы слышали далекий <w>вой</w> ветра сквозь щели в старой хижине."
                            }
                        }
                    ],
                    "synonyms": [
                        "groan",
                        "wail",
                        "sigh",
                        "whimper"
                    ],
                    "common_phrases": [
                        "let out a moan",
                        "low moan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий, скорбный звук, издаваемый человеком или животным, часто указывающий на боль или горе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стон",
                                "target_lang_sense_clarification": "звук боли или страдания"
                            },
                            {
                                "target_lang_word": "стенание",
                                "target_lang_sense_clarification": "протяжный жалобный звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae47615-a614-3a35-ae85-44581c04c795",
                    "sense_definition": "An act of complaining or a specific complaint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of listening to your constant <w>moans</w> about the office politics.",
                            "target_lang_translations": {
                                "ru": "Мне надоело слушать твое вечное <w>нытье</w> по поводу офисных интриг."
                            }
                        },
                        {
                            "text": "He had a good <w>moan</w> about the service at the restaurant before leaving a small tip.",
                            "target_lang_translations": {
                                "ru": "Он вдоволь <w>пожаловался</w> на обслуживание в ресторане, прежде чем оставить небольшие чаевые."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "grumble",
                        "whinge"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
                        "have a moan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English to refer to a session of complaining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт жалобы или конкретная жалоба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нытье",
                                "target_lang_sense_clarification": "постоянные жалобы"
                            },
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "выражение неудовольствия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
