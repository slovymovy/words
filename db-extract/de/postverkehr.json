                "senses": [
                    {
                        "sense_id": "ddb3ae7c-0330-38fb-8f3a-dc7624eb9a31",
                        "entry_id": "cdd8b9a5-6c7a-3d22-b9f3-cb2db456d172",
                        "glosses": [
                            "Gesamtheit aller Leistungen, die der Beförderung von Postgut dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3880e03d-edbd-40da-a0db-0e81204e5fd7",
                                "sense_id": "ddb3ae7c-0330-38fb-8f3a-dc7624eb9a31",
                                "text": "„Sie brachen die Briefsiegel auf, lasen die Texte, verschlossen die Briefe wieder und schleusten sie dann erneut in den Postverkehr ein.“"
                            },
                            {
                                "example_id": "4bffd1c1-0618-4a57-b666-445e9cc3e35c",
                                "sense_id": "ddb3ae7c-0330-38fb-8f3a-dc7624eb9a31",
                                "text": "„Nach Einrichtung des Weltpostvereins und seines Standardportos verzeichnet der überseeische Postverkehr ebenso wie die Postdienste der beteiligten Länder gänzlich unerwartete Zuwachsraten.“"
                            },
                            {
                                "example_id": "24ab17d3-dca8-40d7-a166-4b811104e248",
                                "sense_id": "ddb3ae7c-0330-38fb-8f3a-dc7624eb9a31",
                                "text": "„Anfang Oktober wurde der Postverkehr zwischen dem sowjetisch besetzen Teil Deutschlands und den drei Westzonen wiederaufgenommen.“"
                            },
                            {
                                "example_id": "c9de2cfb-0196-47d5-b9d6-f47d1e440400",
                                "sense_id": "ddb3ae7c-0330-38fb-8f3a-dc7624eb9a31",
                                "text": "„Das alles zu erforschen oder festzuhalten, ist speziell bei kleinen Orten mit wenig Postverkehr nicht gerade einfach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
