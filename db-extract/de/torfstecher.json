                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70317d1e-fc2b-40fb-a643-2178cf56d573",
                                "sense_id": "12c2e16d-71e8-3d59-8a62-781cedd6ea58",
                                "text": "„Das norddeutsche Windeby-Mädchen, in den fünfziger Jahren von Torfstechern entdeckt, galt lange als ertränkte Ehebrecherin.“"
                            },
                            {
                                "example_id": "1528a7b9-da1d-4e86-80cc-5b36114f23d8",
                                "sense_id": "12c2e16d-71e8-3d59-8a62-781cedd6ea58",
                                "text": "„Als Grasmäher, Torfstecher und Seeleute verdienten sie dort den Unterhalt für ihre daheim gebliebenen Familien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
