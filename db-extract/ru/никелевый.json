                                                "sense_id": "6a9a2dce-1c25-3126-a425-27fb4896218d",
                                                "text": "Let me give you the nickel tour of the office."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nickel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "343e97df-2501-3c00-b796-eebbcbe05559",
                                        "entry_id": "5760abbd-5288-31c7-8da3-5ce0edaca242",
                                        "glosses": [
                                            "To plate with nickel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b94f2a7-fe0e-3359-a8b4-d486d2f98a30",
                                        "entry_id": "5760abbd-5288-31c7-8da3-5ce0edaca242",
                                        "glosses": [
                                            "To distribute airborne leaflet propaganda."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ccb1ed-5bc4-477e-85e3-7330abd2d341",
                                                "sense_id": "4b94f2a7-fe0e-3359-a8b4-d486d2f98a30",
                                                "text": "The 422d Bombardment Squadron extended the scope of its operations considerably in April and \"attacked\" Norwegian targets with the leaflet bomb. The number of cities nickeled per mission also increased until it was common for fifteen to twenty-five to be scheduled as targets for a five-plane mission."
                                            },
                                            {
                                                "example_id": "33440a44-4092-4600-9f3c-b9348ab345b6",
                                                "sense_id": "4b94f2a7-fe0e-3359-a8b4-d486d2f98a30",
                                                "text": "We flew numerous nickeling missions over the population centers of Southern France, dropping thousands of pounds of leaflets."
                                            },
                                            {
                                                "example_id": "318d1eaa-80c1-4056-a797-9f0d518ff673",
                                                "sense_id": "4b94f2a7-fe0e-3359-a8b4-d486d2f98a30",
                                                "text": "From southern Greece to northern Italy, nickeling supplied both occupied peoples and their occupiers with fairly frequent and generally accurate reports of the war — in many cases, their only authoritative source of information."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
