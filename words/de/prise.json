                },
                {
                    "sense_id": "8fc45450-3bc7-3937-869c-cc38bb1ca1d2",
                    "sense_definition": "Kleine Portion Schnupftabak, die auf einmal durch die Nase eingesaugt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "portion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte Herr zog eine kleine Dose hervor und nahm genüsslich eine <w>Prise</w> Tabak."
                        },
                        {
                            "text": "Vor dem Essen bot der Gastwirt seinen Gästen eine <w>Prise</w> feinen Schnupftabak an."
                        }
                    ],
                    "common_phrases": [
                        "eine Prise nehmen",
                        "eine Prise Tabak"
