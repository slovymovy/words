                                        "entry_id": "804adf09-181e-3dc2-ad22-170710297524",
                                        "glosses": [
                                            "Money paid by the government, special-purpose fund or similar to those who are unemployed and looking for work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
