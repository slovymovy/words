                                    {
                                        "sense_id": "5fa19783-876c-34e9-b79f-6a8352a39703",
                                        "entry_id": "8b211f88-5cac-3ec0-814b-beeeb25695a9",
                                        "glosses": [
                                            "Hose aus blauem Baumwollstoff mit Nieten"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be0e076-1bba-4e84-a686-5d0681a1852e",
                                                "sense_id": "5fa19783-876c-34e9-b79f-6a8352a39703",
                                                "text": "„Sie trug eine abgewetzte Nietenhose und eine erdbraune Jacke mit Fransen an den Ärmeln.“"
                                            },
                                            {
                                                "example_id": "62b783c4-f530-4c7f-9574-541dcd3752ab",
                                                "sense_id": "5fa19783-876c-34e9-b79f-6a8352a39703",
                                                "text": "„Ein großer schlaksiger Junge in schwarzen Nietenhosen und Lederjacke hatte bereits den nächsten Stuhl in den Händen, um ihn durch die Luft zu schleudern.“"
                                            },
                                            {
                                                "example_id": "28338147-dac1-41e0-b714-b327668b0079",
                                                "sense_id": "5fa19783-876c-34e9-b79f-6a8352a39703",
                                                "text": "„Da fängt der Lange mit den Nietenhosen an zu krähen wie ein Hahn, bloß dass er dabei nicht mit den Flügeln schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed1f24bc-6786-435a-9ee6-4c2b31da03f9",
                        "source_entry_id": "f3a53796-1f73-39df-a672-c8b4f6d1e84d",
