                            {
                                "example_id": "1204d60c-ab20-47db-83a5-74a5b98fbc52",
                                "sense_id": "8e0ae07b-ad88-37df-aef8-939c28add310",
                                "text": "„Etliche Bekannte des hervorragend vernetzten Adligen waren ebenfalls eingerückt, einige hatten ihre Verlobten in Nottrauungen geheiratet, andere Notexamina abgelegt, um ihr Studium vor dem Fronteinsatz abzuschließen.“"
                            },
                            {
                                "example_id": "7f06c287-4903-4fe2-b139-949c994c2dea",
                                "sense_id": "8e0ae07b-ad88-37df-aef8-939c28add310",
                                "text": "„Wir hatten mit unseren ersten Fronteinsätzen im Kanal gewissermaßen Pionierarbeit geleistet.“"
                            }
                        ],
