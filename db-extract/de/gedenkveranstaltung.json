                "senses": [
                    {
                        "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                        "entry_id": "e72ce4de-5653-3017-bcac-09678813cf82",
                        "glosses": [
                            "(meist offizielles) Treffen bekannter Personen/Organisationen (beispielsweise Politikern, Verbänden) zum Gedenken an eine verstorbene Persönlichkeit oder ein historisches Ereignis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3876e36f-6322-4874-84fd-6d6c09c22c2d",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[…] „noch 1953 lehnte der bayerische Landesbischof Hans Meiser ab, als man ihn zu einer Gedenkveranstaltung für Bonhoeffer einlud.“"
                            },
                            {
                                "example_id": "dc3693f5-eef7-4b79-93bf-13101894c2f6",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "„In diesem Jahr haben der Ministerpräsident Thüringens und amtierende Bundesratspräsident, Bodo Ramelow, sowie der Antiziganismusbeauftragte der Bundesregierung, Mehmet Daimagüler, die Gedenkveranstaltung in Auschwitz-Birkenau besucht.“"
                            },
                            {
                                "example_id": "a2f8929c-8ee5-4b18-86cc-d2b1523f0ef2",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "„An diesem Sonntag sind in der Hauptstadt Tunis Gedenkveranstaltungen für die ermordeten Aktivisten Chokri Belaid und Mohamed Brahmi angesetzt.“"
                            },
                            {
                                "example_id": "1a83dd6b-0ff1-496b-97b4-16f898ec2386",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "„In der Deutschen Kriegsgräberstätte Fricourt fand am 1. Juli 2016 die vom Volksbund Deutsche Kriegsgräberfürsorge organisierte zentrale deutsche Gedenkveranstaltung „100 Jahre Sommeschlacht“ statt.“"
                            },
                            {
                                "example_id": "deb005b0-98df-4836-8bf3-d64b5fabcddf",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken an die Pogromnacht am 9.11.1938:] „Im Schloss der Stadt Osnabrück findet eine von Schülern und Schülerinnen organisierte Gedenkveranstaltung statt.“"
                            },
                            {
                                "example_id": "e2aae825-069c-440d-95c9-c12f64fe883b",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken an das Olympiaattentat 1972 in München:] „In Fürstenfeldbruck gibt es bereits seit 1997 Gedenkveranstaltungen.“"
                            },
                            {
                                "example_id": "b1473f58-e2c4-47ee-b362-3caf505c4dcc",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken an den Brandanschlag von Mölln am 23.11.1992:] „»Mittlerweile haben wir keine Möglichkeit mehr, in Mölln eine offizielle Gedenkveranstaltung zu organisieren, weil die Stadt Mölln das einfach nicht haben möchte.«“"
                            },
                            {
                                "example_id": "87d6b131-fc8e-454a-88db-10cb066fbddf",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken an den Völkernmord in Ruanda 1994:] „Etliche ausländische Gäste nahmen an der offiziellen Gedenkveranstaltung teil, darunter auch die Schweizer Nationalratspräsidentin Marina Carobbio.“"
                            },
                            {
                                "example_id": "1858741b-aaad-4aa6-bcdd-c639b905d78c",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken an den Amoklauf an der Columbine Highschool 1999:] „In Littleton im US-Bundesstaat Colorado haben sich am Samstag über 2000 Menschen bei einer Gedenkveranstaltung versammelt.“"
                            },
                            {
                                "example_id": "4f56f771-3998-4814-b3da-f402c951d2b5",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[9/11:] „Mit mehreren großen Gedenkveranstaltungen haben die USA an die Opfer der Anschläge erinnert.“"
                            },
                            {
                                "example_id": "309e1c14-6ebc-4e0a-8475-0286adfcc0ab",
                                "sense_id": "3c87894b-86db-376f-9d76-99a2c6a67a5a",
                                "text": "[Gedenken zum Tod von Michail Gorbatschow im Deutschen Bundestag:] „An der Gedenkveranstaltung im Parlament nahm auch Bundespräsident Frank-Walter Steinmeier teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
