                        "target_lang_word": "Nubiër",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nubiër",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "17bb7a82-be9c-37e0-8185-3d5bdc1e5074",
                                        "entry_id": "e1cea315-8cdd-362d-a5d3-74b6f17d4cc8",
                                        "glosses": [
                                            "oorspronkelijke inwoner van het gebied in Egypte ten zuiden van Aswan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2768961e-3628-40b2-818c-c57c45499b06",
                                                "sense_id": "17bb7a82-be9c-37e0-8185-3d5bdc1e5074",
                                                "text": "Hier leven Nubiërs en Arabieren, moslims en christenen, vrouwen en mannen in een harmonie samen die Noord-Egypte vreemd is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e289d04-79a9-39bf-b664-ef3a1cb3e386",
                                        "entry_id": "e1cea315-8cdd-362d-a5d3-74b6f17d4cc8",
                                        "glosses": [
                                            "inwoner van het oude Nubië, aanduiding voor het gebied langs de Nijl tussen Khartoem en Aswan, soms ook gebruikt voor heel Sub-Saharaans Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b21d92-26e4-4ff2-b722-90b5a89aa33d",
                                                "sense_id": "3e289d04-79a9-39bf-b664-ef3a1cb3e386",
                                                "text": "Zestig jaar, tot de Assyriërs hen in 666 voor Christus verdreven, zaten de Nubiërs als zwarte koningen op de troon van een verenigd Egypte en Nubië."
                                            },
                                            {
                                                "example_id": "a3b6890c-a6c8-416d-a7c8-c91a65c43a16",
                                                "sense_id": "3e289d04-79a9-39bf-b664-ef3a1cb3e386",
                                                "text": "Maar dat ook bij leven een Nubiër een immens gezag wist uit te stralen, onthult het zwart-stenen 43 centimeter hoge beeld van een hyperatletische, beeldschone Amon-priester, die onoverwinnelijk op de toeschouwer lijkt af te lopen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
