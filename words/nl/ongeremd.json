                    "sense_id": "d8ce8e36-8c2c-3ebe-8a24-b5962ca6965a",
                    "sense_definition": "Zonder enige terughoudendheid of belemmering; vrij en spontaan in gedrag.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het behalen van haar diploma liet zij haar <w>ongeremde</w> vreugde blijken.Het kind vertoonde een <w>ongeremde</w> enthousiasme tijdens het feest.",
                            "target_lang_translations": {
                                "en": "After receiving her diploma, she showed her <w>unrestrained</w> joy. The child showed an <w>uninhibited</w> enthusiasm during the party."
                            }
                        },
                        {
                            "text": "Hij vertoonde een <w>ongeremde</w> enthousiasme tijdens het feestje.",
                            "target_lang_translations": {
                                "en": "He showed <w>uninhibited</w> enthusiasm during the party."
                            }
                        }
                    ],
                    "synonyms": [
                        "bandeloos",
                        "exuberant",
                        "impulsief",
                        "ongebonden",
                        "ongekunsteld",
                        "onstuimig",
                        "spontaan",
                        "teugelloos",
                        "tomeloos",
                        "uitbundig",
                        "wild"
                    ],
                    "antonyms": [
