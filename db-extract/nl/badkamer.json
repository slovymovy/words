                                "target_senses": [
                                    {
                                        "sense_id": "2e64e1f7-f069-3968-8f4a-802a7b806bb2",
                                        "entry_id": "49902399-8e0d-3ade-9254-fa50801c1e76",
                                        "glosses": [
                                            "Pièce d’une habitation, comportant une baignoire ou une douche, et réservée pour se laver et se baigner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b39d93e-731e-4e75-a105-b10e7637b963",
                                                "sense_id": "2e64e1f7-f069-3968-8f4a-802a7b806bb2",
                                                "text": "Dans la salle de bains attenante, elle respira une odeur d’eau de cologne et aussi un parfum chaud de corps masculin."
                                            },
                                            {
                                                "example_id": "60e5bf0c-7798-463d-b790-94b6808300dc",
                                                "sense_id": "2e64e1f7-f069-3968-8f4a-802a7b806bb2",
                                                "text": "Je pose les pieds sur la moquette tuftée bleu canard à la texture de plastique recyclé et me traîne jusqu’à la salle de bains."
                                            },
                                            {
                                                "example_id": "22416e0f-a456-44b1-866c-eace4d46a5fe",
                                                "sense_id": "2e64e1f7-f069-3968-8f4a-802a7b806bb2",
                                                "text": "Je grommelle quelque chose d’inintelligible, m'enferme dans sa salle de bains, jette un regard navré au flexible de douche, remplis le lavabo d'eau glacée, plonge la tête dedans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
