                "senses": [
                    {
                        "sense_id": "c54d4b49-3548-3c36-9617-241de92481cf",
                        "entry_id": "739af03f-d86b-3f40-9de5-5b24d6dc613a",
                        "glosses": [
                            "A tropical tree, Canarium ovatum, native to maritime Southeast Asia, New Guinea and northern Australia, and cultivated in the Philippines for its nuts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0412c1a2-ea35-4e6d-820c-e18f6416d780",
                                "sense_id": "c54d4b49-3548-3c36-9617-241de92481cf",
                                "text": "The pili is indigenous to the Philippines (Merrill 1912, 1923; Wester 1921; Brown 1954; Li 1970)."
                            },
                            {
                                "example_id": "25d0bdca-2c0d-4d0a-b6ae-0e617cdfa2d0",
                                "sense_id": "c54d4b49-3548-3c36-9617-241de92481cf",
                                "text": "Pili (Canarium ovatum) is the most important tree nut of the Philippines.[…]Natural populations of pili are found in forests and are threatened by human activities and natural disasters."
                            },
                            {
                                "example_id": "affb34e7-fdba-4ccd-8822-ad4c13ba00a3",
                                "sense_id": "c54d4b49-3548-3c36-9617-241de92481cf",
                                "text": "2012, M.N. Normah, S. K. Malik, R. Chaudhury, I. Salma, M. A. Makeen, Chapter 8: Conservation of Tropical Fruit Genetic Resources, M. N. Normah, H. F. Chin, Barbara M. Reed (editors, Conservation of Tropical Plant Species, page 143,\nThe crops covered by the project include jackfruit and other Artocarpus species, pili (Canarium ovatum), mangosteen and other Garcinia species, and durian (Durio zibethinus)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7bb5576-d3d8-3e8a-b431-ff174b0cc8f2",
                        "entry_id": "739af03f-d86b-3f40-9de5-5b24d6dc613a",
                        "glosses": [
                            "The edible nut of the tree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc6e58bd-304d-4236-9ece-3eaa6a65faea",
                                "sense_id": "f7bb5576-d3d8-3e8a-b431-ff174b0cc8f2",
                                "text": "Pili—pronounced “peeley”—is a distinctive, tear-shaped nut native to Southeast Asia and the Pacific islands. It’s here that roasted, fried, and sugared varieties of pili can be found for sale on nearly every street."
                            }
                        ]
                    }
