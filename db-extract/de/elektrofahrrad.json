                "senses": [
                    {
                        "sense_id": "f88723ea-9431-3d17-825f-0885be3535ec",
                        "entry_id": "378fee5f-5e17-37e5-821b-2abec71b4884",
                        "glosses": [
                            "Fahrrad mit Elektromotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a9644a5-39c1-46a4-a4a7-a061a566450b",
                                "sense_id": "f88723ea-9431-3d17-825f-0885be3535ec",
                                "text": "„Das höhere Gewicht der Elektrofahrräder und die höhere Durchschnittsgeschwindigkeit belasten Rahmen und Bremsen stärker als bei »Muskelfahrrädern«.“"
                            },
                            {
                                "example_id": "9ee918ca-f721-4b0b-8144-e7a9ec617c90",
                                "sense_id": "f88723ea-9431-3d17-825f-0885be3535ec",
                                "text": "„Zum Unfallhergang teilte die Polizei mit, dass die 39-Jährige aus dem Bezirk Tulln gegen 20.50 Uhr mit dem Elektrofahrrad samt dem mehrspurigen Fahrradanhänger auf der B19 im Freilandgebiet von Hausleiten in Richtung Tulln unterwegs gewesen sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
