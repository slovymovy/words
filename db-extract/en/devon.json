                        "entry_id": "89f542c0-befe-35b4-b912-585ddeba6232",
                        "glosses": [
                            "A male given name transferred from the place name, or a variant of Devin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3729a91e-1992-40b1-abb6-f23f32461e44",
                                "sense_id": "d498eba2-c275-3358-bc45-a14ec10befaa",
                                "text": "\"Is that his real name?\" I asked, touching the corner of the picture. \"Devil?\"\n\"I named him Devon James Jordan, but my oldest―my girl Sheena―she had trouble saying Devon and it came out Devil, and that stuck […]\""
                            }
                        ]
                    },
                    {
                        "sense_id": "398ea50f-b44f-39b4-a6da-7c7ccfa33f4b",
                        "entry_id": "89f542c0-befe-35b4-b912-585ddeba6232",
                        "glosses": [
                            "A female given name transferred from the place name, of modern American usage."
                        ],
                        "tags": [],
                        "examples": [
