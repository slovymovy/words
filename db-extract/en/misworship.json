                        "glosses": [
                            "False or wrong worship; mistaken practices in religion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f085bf4-1f5a-4cfb-832e-8c34f6dbd611",
                                "sense_id": "7b95f2c7-a045-3a5a-a296-f06b8544e986",
                                "text": "Might men be their own judges, there would be no heresy in the world, no misworship."
                            },
                            {
                                "example_id": "a14ae988-6f58-48e9-b8c0-101e4056879b",
                                "sense_id": "7b95f2c7-a045-3a5a-a296-f06b8544e986",
                                "text": "Such hideous inextricable jungle of misworships, misbeliefs, men, made as we are, did actually hold by, and live at home in."
                            }
                        ]
                    }
