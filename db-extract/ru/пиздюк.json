                        ],
                        "form": "пиздюко́м"
                    },
                    {
                        "form_id": "a9215ca5-dc9b-45b1-95e5-c40b0a60b5d0",
                        "entry_id": "45638774-99ba-3c13-b8bb-495c91be013b",
                        "tags": [
