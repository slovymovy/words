                        "glosses": [
                            "oficjalne pismo do władz, które zawiera prośby lub uwagi dotyczące ważnych dla ogółu sprawch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1b27bd-ba65-4887-8263-0e890359d7e2",
                                "sense_id": "236294a2-4096-36e1-a89e-bd42ea9cbd4f",
                                "text": "W tym samym czasie w Anglii zaczęto rozważać korzyści i niekorzyści płynące dla Wielkiej Brytanii z możliwej odbudowy państwa polskiego. Rozważania te znalazły wyraz w dwóch memoriałach, opracowanych jesienią 1916 r."
                            }
                        ],
