                "senses": [
                    {
                        "sense_id": "3c4a67d3-528d-3a26-94cb-0d42f920c49a",
                        "entry_id": "ea1d4e87-dc92-3f08-9c0f-83a728683c87",
                        "glosses": [
                            "Europäische Finanzstabilisierungsfazilität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488e68c0-6011-4b59-92f3-448e6a571472",
                                "sense_id": "3c4a67d3-528d-3a26-94cb-0d42f920c49a",
                                "text": "Die EFSF wurde geschaffen, um finanziell in Not geratenen Mitgliedsstaate[n] der Eurozone mit Krediten auszuhelfen."
                            },
                            {
                                "example_id": "d818bd83-d7a7-430b-984d-3071a2bd62c0",
                                "sense_id": "3c4a67d3-528d-3a26-94cb-0d42f920c49a",
                                "text": "Deutschland ist mit rund 28 Prozent an der bisherigen Kreditsumme, über die die EFSF verfügen kann, beteiligt."
                            },
                            {
                                "example_id": "2d12a682-9a0e-481e-a29a-e0e6320e7772",
                                "sense_id": "3c4a67d3-528d-3a26-94cb-0d42f920c49a",
                                "text": "Diese beinhaltet, dass sich die von den EU-Staaten gestellten Garantien für Kredite an notleidende Staaten erhöhen, sodass die Schlagkraft der EFSF erhöht wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
