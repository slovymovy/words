                ],
                "senses": [
                    {
                        "sense_id": "c5487d36-01a0-37f3-b290-c2351e58baca",
                        "entry_id": "0c6edb3a-73a0-3d3e-9485-909e21a9ec11",
                        "glosses": [
                            "großer Teil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714fb6b6-27a2-4873-be37-38bd9d8a1fc1",
                                "sense_id": "c5487d36-01a0-37f3-b290-c2351e58baca",
                                "text": "Ein Gutteil der Bevölkerung ist laut Umfragen nicht mit der geplanten Gesetzesänderung einverstanden."
                            },
                            {
                                "example_id": "dc9492be-5199-40b4-8546-1ab825084519",
                                "sense_id": "c5487d36-01a0-37f3-b290-c2351e58baca",
                                "text": "„Ein Gutteil des Gemüses aber soll im Sommer von einem eigens angelegten Feld bei Schneckenzüchter Andreas Gugumuck vor den Toren der Stadt kommen, der Fisch von der Naturteichwirtschaft Radlberg, das Fleisch von Qualitätsfleischhauer Höllerschmid aus dem Kamptal.“"
                            },
                            {
                                "example_id": "8f308ec9-8276-4505-890f-3d36623a12d1",
                                "sense_id": "c5487d36-01a0-37f3-b290-c2351e58baca",
                                "text": "„Ich döste einen Großteil der Nacht vor mich hin, in der Hoffnung, der nächste Tag würde es mir ermöglichen, einen Gutteil der über drei Jahre gehegten Liebesträume zu verwirklichen, genauso lange wie ich das Quartett schon kannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
