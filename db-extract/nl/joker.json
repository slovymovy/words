                                    },
                                    {
                                        "sense_id": "51fb3028-4832-3095-90d7-ea4f0b597bd8",
                                        "entry_id": "41ad8ba0-8450-3ba6-87c3-5eda0e9d8e6d",
                                        "glosses": [
                                            "Person oder Sache von besonderem Wert, die man zur gegebenen Zeit einsetzen kann"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466683ec-e6e6-41b1-9911-9e101a341d94",
                                                "sense_id": "51fb3028-4832-3095-90d7-ea4f0b597bd8",
                                                "text": "Im Team ist es wichtig, einen Joker zu haben, der aushilft, wenn nötig."
                                            },
                                            {
                                                "example_id": "727e377f-36a5-4809-abb8-0b2745c04f88",
                                                "sense_id": "51fb3028-4832-3095-90d7-ea4f0b597bd8",
                                                "text": "„Nachdem er in Dubai wegen eines Grippe-Infekts fehlte, wird er zu Rückrunden-Beginn nicht einmal mehr \"Joker\" Nummer eins sein.“"
                                            }
                                        ],
