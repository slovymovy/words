                                    {
                                        "sense_id": "65e3d604-dd3d-3d5b-a491-a4a9d8054acf",
                                        "entry_id": "0275f7ba-3d19-3246-8f80-db84bc5bee2e",
                                        "glosses": [
                                            "obilné zrno zbavené plev"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84da405-73a6-44d9-9e91-e89ac97c7a01",
                                                "sense_id": "65e3d604-dd3d-3d5b-a491-a4a9d8054acf",
                                                "text": "A tak jí přinesli z komory všecko do kuchyňky, hrách a kroupy a jáhly a krupici a mouku, také trochu čočky a pak ještě jiskřičku másla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "122d87a1-082b-3955-b37e-eab47d6539d7",
                                        "entry_id": "0275f7ba-3d19-3246-8f80-db84bc5bee2e",
                                        "glosses": [
                                            "zmrzlý kousek ledu vzniklý kondenzací atmosférických srážek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad83cbe-6f21-409c-9fe3-beea270b9393",
                                                "sense_id": "122d87a1-082b-3955-b37e-eab47d6539d7",
                                                "text": "Už nad Zátavou a Kestřany počalo mračno sypat kroupy, ale řídce jen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "543a9888-5272-4539-8075-d9599c98b40d",
