    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f4c50d30-784c-3fbd-8a74-e038673491a7",
                    "sense_definition": "Avec ménagement, délicatesse, sans brutalité ni violence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a posé <w>doucement</w> le bébé endormi dans son berceau."
                        },
                        {
                            "text": "Il faut manipuler ces verres fragiles très <w>doucement</w> pour ne pas les briser."
                        }
                    ],
                    "antonyms": [
                        "durement"
                    ],
                    "common_phrases": [
                        "poser doucement",
                        "fermer doucement"
                    ]
                },
                {
                    "sense_id": "7d29b114-b7a0-37e9-8a8a-416bdeaf493e",
                    "sense_definition": "Lentement, à petite vitesse, sans se presser.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture roulait <w>doucement</w> sur la route enneigée pour éviter de glisser."
                        },
                        {
                            "text": "Nous marchions <w>doucement</w> dans la forêt en profitant de l'air frais du matin."
                        }
                    ],
                    "common_phrases": [
                        "rouler doucement",
                        "marcher doucement"
                    ]
                },
                {
                    "sense_id": "884bddf0-b4f7-3119-850a-21247f36748e",
                    "sense_definition": "À voix basse, sans bruit ou avec un volume très faible.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parlez plus <w>doucement</w> pour ne pas réveiller les enfants qui dorment à côté."
                        },
                        {
                            "text": "Il a chuchoté très <w>doucement</w> la réponse à son voisin de classe."
                        }
                    ],
                    "common_phrases": [
                        "parler doucement",
                        "frapper doucement"
                    ]
                },
                {
                    "sense_id": "4e34c4a1-8b45-324d-b9d2-06a5967966c8",
                    "sense_definition": "Paisiblement, avec calme, sans agitation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand-père s'est endormi <w>doucement</w> dans son fauteuil après le repas."
                        },
                        {
                            "text": "Ils coulent des jours paisibles et vivent <w>doucement</w> à la campagne."
                        }
                    ],
                    "common_phrases": [
                        "vivre doucement",
                        "s'endormir doucement"
                    ]
                },
                {
                    "sense_id": "a5756fc6-a54e-3408-a55b-bcb0fdd6d59f",
                    "sense_definition": "Médiocrement, tant bien que mal, d'une manière passable.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son opération récente, le malade récupère tout <w>doucement</w> à la maison."
                        },
                        {
                            "text": "Les affaires reprennent très <w>doucement</w> après cette période de crise économique."
                        }
                    ],
                    "common_phrases": [
                        "tout doucement"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f5d2a1a7-5fa8-36c5-933b-49021719f360",
                    "sense_definition": "S'emploie pour inviter à ralentir, à faire attention ou à modérer son ardeur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Doucement</w>, vous allez casser cette assiette en la posant ainsi !"
                        },
                        {
                            "text": "Attendez une seconde, <w>doucement</w>, ne nous énervons pas pour si peu."
                        }
                    ],
                    "common_phrases": [
                        "doucement les basses"
                    ]
                },
                {
                    "sense_id": "c3dc4bfe-0100-346d-9a36-39d9a02cf2ff",
                    "sense_definition": "Formule servant à s'excuser ou à demander poliment le passage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Doucement</w>, laissez-moi passer pour que je puisse descendre du train."
                        },
                        {
                            "text": "<w>Doucement</w>, pardonnez-moi, je ne voulais pas vous bousculer dans le couloir."
                        }
                    ],
                    "synonyms": [
