                    {
                        "sense_id": "ba98ab9b-8d79-3d36-848d-a8c0981ed2d0",
                        "entry_id": "5192bc74-a97c-3ac9-8752-98b4ed3bec25",
                        "glosses": [
                            "The emergency department of a hospital."
                        ],
                        "tags": [
                            "Canada",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6067770a-f4eb-4ce1-9642-3b6b9fe9014f",
                                "sense_id": "ba98ab9b-8d79-3d36-848d-a8c0981ed2d0",
                                "text": "These EMS people, who should just walk into the emerg, drop their patient off, and then leave, are frozen in the emerg for a long period of time, because there aren't enough resources there."
                            },
                            {
                                "example_id": "54574195-888a-4acd-87ca-f4f69a099b55",
                                "sense_id": "ba98ab9b-8d79-3d36-848d-a8c0981ed2d0",
                                "text": "“Rather than going to emerg and getting admitted and having the condition over a period of time, we understand that the event happened fairly quickly."
                            },
                            {
                                "example_id": "5ced58ee-1184-4dcc-9720-7e27b6570d8b",
                                "sense_id": "ba98ab9b-8d79-3d36-848d-a8c0981ed2d0",
                                "text": "“What we've seen in the last few days is a number of cases that have come to emerg departments."
                            }
                        ]
                    }
                ],
