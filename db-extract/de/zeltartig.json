                ],
                "senses": [
                    {
                        "sense_id": "9a6e06f4-dd79-39e8-bccf-56334215879d",
                        "entry_id": "87be739e-777c-33a8-bad0-a6ec4edda1f3",
                        "glosses": [
                            "einem Zelt ähnelnd, wie ein Zelt aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1412a0f1-c5e3-4a18-825d-7d1bec01b501",
                                "sense_id": "9a6e06f4-dd79-39e8-bccf-56334215879d",
                                "text": "„Seit der islamischen Revolution vor 20 Jahren hatten sich die Frauen in die vorgeschriebene schwarze, zeltartige Kluft gehüllt.“"
                            },
                            {
                                "example_id": "5ea79627-f59b-49a2-a547-dfb6ad2cbaa3",
                                "sense_id": "9a6e06f4-dd79-39e8-bccf-56334215879d",
                                "text": "„Schnell bewegte er sich südwärts übers Dach bis zur Hausecke und kroch dort unter den zeltartigen Blechverschlag, den er an die Brüstung gelehnt hatte.“"
                            },
                            {
                                "example_id": "5811dc30-cd24-4404-a17c-f8c1a8b76e57",
                                "sense_id": "9a6e06f4-dd79-39e8-bccf-56334215879d",
                                "text": "„Man mag es sich einfach nicht vorstellen. Wie sie in dieser zeltartigen Wäsche mit den Armen ruderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
