                    {
                        "form_id": "e8a6f17e-bc11-49cb-9bbc-0fb2426e2153",
                        "entry_id": "67c51af7-33ab-3f15-9841-dad61673c297",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegsministerien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a035c7f-3c64-3fae-a46f-9ad5a15748ce",
                        "entry_id": "67c51af7-33ab-3f15-9841-dad61673c297",
                        "glosses": [
                            "für das Kriegswesen zuständiges Ministerium"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ac1b8711-7b41-4ebd-ace4-834a99530301",
                                "sense_id": "8a035c7f-3c64-3fae-a46f-9ad5a15748ce",
                                "text": "„Vom Kriegsministerium des Deutschen Reiches wurde eine Zensur verhängt, damit den Kriegsgegnern keine Veröffentlichungen über kriegswichtige wissenschaftliche Erkenntnisse zugänglich gemacht werden.“"
                            },
                            {
                                "example_id": "d26643df-c337-4b18-be5e-6c345621b1be",
                                "sense_id": "8a035c7f-3c64-3fae-a46f-9ad5a15748ce",
                                "text": "„In den frühen Morgenstunden fahre ich mit dem Chef der Infanterie zum Kriegsministerium nach München.“"
                            },
                            {
                                "example_id": "e0172d34-2531-4be7-a263-28a3bf945893",
                                "sense_id": "8a035c7f-3c64-3fae-a46f-9ad5a15748ce",
                                "text": "„Während die Munitionsfabriken längst eifrig produzieren und auch ein Mangel an Nahrung vorerst nicht zu befürchten steht, schenkt man im Kriegsministerium den essenziellen ökonomischen Fragen keinerlei Beachtung.“"
                            },
                            {
                                "example_id": "0e8b323f-2c9a-4947-8d5e-ee05205d1c9a",
                                "sense_id": "8a035c7f-3c64-3fae-a46f-9ad5a15748ce",
                                "text": "„Das Kriegsministerium ordnete den sofortigen Beginn der Arbeiten auf der Karthause an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
