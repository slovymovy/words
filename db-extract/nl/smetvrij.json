                        "target_lang_word": "innocent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innocent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a429b0e4-edbd-382a-a0d7-17239b9aa364",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Free from guilt, sin, or immorality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d1b648-da7c-499a-ac63-918496d3a3cc",
                                                "sense_id": "a429b0e4-edbd-382a-a0d7-17239b9aa364",
                                                "text": "I'm sure there's an innocent explanation for all this."
                                            },
                                            {
                                                "example_id": "740b87bf-8f0e-42c6-91c5-f705767616e0",
                                                "sense_id": "a429b0e4-edbd-382a-a0d7-17239b9aa364",
                                                "text": "The situation certainly looked bad, but it turned out that everything was innocent."
                                            },
                                            {
                                                "example_id": "6735aa06-322c-4fbd-af58-e18e71c52337",
                                                "sense_id": "a429b0e4-edbd-382a-a0d7-17239b9aa364",
                                                "text": "to offer up a weak, poor, innocent lamb to appease an angry god"
                                            },
                                            {
                                                "example_id": "ef1753fa-2fe8-4902-bac8-ff6207382ebb",
                                                "sense_id": "a429b0e4-edbd-382a-a0d7-17239b9aa364",
                                                "text": "2018 September 26, Brian Karem, \"Bethesda Resident Describes \"Culture Of Privilege\" Leading To Exploitation And Abuse\" in The Montgomery County Sentinelhttps://web.archive.org/web/20180927140428/https://mont.thesentinel.com/2018/09/26/bethesda-resident-describes-culture-of-privilege-leading-to-sexual-assault/\n\"These were not innocent times,\" she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364ac34c-2e3d-3c03-9f71-077a7023e7da",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Bearing no legal responsibility for a wrongful act."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f72fa2af-4147-30af-9336-5170337e932e",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Without wrongful intent; accidental or in good faith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab832f0-29f8-4f23-b67b-f7cc5c878927",
                                                "sense_id": "f72fa2af-4147-30af-9336-5170337e932e",
                                                "text": "He didn't mean anything by it; it was an innocent mistake."
                                            },
                                            {
                                                "example_id": "40bd432f-3633-4d67-8f12-799d6729f3c3",
                                                "sense_id": "f72fa2af-4147-30af-9336-5170337e932e",
                                                "text": "The child's innocent question revealed the embarrassing truth in front of everyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8409761-2238-3084-830f-12ec72f85d02",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Naive; artless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d76e75-0ac1-4277-81c6-31d33890bd7e",
                                                "sense_id": "f8409761-2238-3084-830f-12ec72f85d02",
                                                "text": "I can find out no rhyme to / 'lady' but 'baby' – an innocent rhyme;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8314df42-a819-3c87-bc68-9aef6f594b3c",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Not harmful; innocuous; harmless; benign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e63f8b-e2c2-4626-ad20-56966479a9f7",
                                                "sense_id": "8314df42-a819-3c87-bc68-9aef6f594b3c",
                                                "text": "The spear / Sung innocent, and spent its force in air."
                                            },
                                            {
                                                "example_id": "5112cd88-b0bf-4fdb-9330-4004a12890ce",
                                                "sense_id": "8314df42-a819-3c87-bc68-9aef6f594b3c",
                                                "text": "Although an innocent murmur is not an obstacle to participation in sports and exercise, a pathologic murmur may necessitate restrictions on the child's physical activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5553c3-905f-3d14-983b-5129b217dcd2",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Lacking (something), or knowledge of it."
                                        ],
                                        "tags": [
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf8d59f-be35-4b27-9bb1-88239ac3d5f1",
                                                "sense_id": "5e5553c3-905f-3d14-983b-5129b217dcd2",
                                                "text": "George was not a believer in modern innovations. The Abbey was innocent of anything so up to date as central heating."
                                            },
                                            {
                                                "example_id": "550e153b-a5b4-47d2-8f5f-ae64ad58ddf5",
                                                "sense_id": "5e5553c3-905f-3d14-983b-5129b217dcd2",
                                                "text": "At the beginning of July Stafford station was innocent of buildings, except for a couple of coach bodies to house the staff, but the temporary accommodation to cover the period of building the new station was well on the way to completion."
                                            },
                                            {
                                                "example_id": "1aadf318-30b5-44a4-9121-4bda50f2cba5",
                                                "sense_id": "5e5553c3-905f-3d14-983b-5129b217dcd2",
                                                "text": "Her only slight comfort is that they are not as bad as the new litter of Awful children who resulted from this marriage, Lisa, Adam, Jason, and Kristen. By all reports, they are entirely innocent of manners of any kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "489bcd01-9ebb-33ef-a3d9-83551d548c03",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Lawful; permitted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f976c3-d0b6-46bb-9e35-04793a5dea0b",
                                                "sense_id": "489bcd01-9ebb-33ef-a3d9-83551d548c03",
                                                "text": "an innocent trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a858473-2117-35cc-b143-6509370762d2",
                                        "entry_id": "a49cbe8c-4946-3e89-9599-e47cbdf514fa",
                                        "glosses": [
                                            "Not contraband; not subject to forfeiture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b7d27b-6813-4ad2-bc20-51a64f9e95dc",
                                                "sense_id": "0a858473-2117-35cc-b143-6509370762d2",
                                                "text": "innocent goods carried to a belligerent nation"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "innocent",
