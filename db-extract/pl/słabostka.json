                ],
                "translations": [
                    {
                        "translation_id": "a3fe0c0e-3930-4bc8-8ce2-ac8d2419c0f8",
                        "source_entry_id": "15bb946f-46bd-3c07-a26a-4880eaf417b2",
                        "source_sense_id": "3b0897f8-81b7-3e81-8dbb-663888d31f2b",
                        "target_lang_word": "foible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "A quirk, idiosyncrasy, frailty, or mannerism; an unusual habit that is slightly strange or silly."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31bc0fe-309f-4854-9ec7-4a00a330753c",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Try to look past his foibles and see the friendly fellow underneath."
                                            },
                                            {
                                                "example_id": "99b46f34-3bec-477b-ab72-5b9ad508bdcf",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "He knew that this was like the sudden impulse of a madman—incongruous even with his habitual foibles."
                                            },
                                            {
                                                "example_id": "cb5dcc11-40a0-449a-bb21-56f76c8e1f90",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Marguerite Blakeney was, above all, a woman, with all a woman’s fascinating foibles, all a woman’s most lovable sins."
                                            },
                                            {
                                                "example_id": "acc94236-640e-452f-941d-5c20a968d60c",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "They made up for the respect with which unconsciously they treated him by laughing at his foibles and lamenting his vices."
                                            },
                                            {
                                                "example_id": "b5f49ba0-5907-474f-83b2-e5f8f739b65d",
                                                "sense_id": "4d30a381-4d7a-3499-947d-d7f66132a4f5",
                                                "text": "Final fillip in the Vice-President's study has been a boning up on Premier Khrushchev's favorite foible, proverbs. The bibulous Russian leader likes to throw out homely homilies in his speeches and conversations[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a959a15b-681d-3f03-9f7b-30389f368ecb",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "A weakness or failing of character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0338debb-cab8-44a3-abdd-38bfd1069314",
                                                "sense_id": "a959a15b-681d-3f03-9f7b-30389f368ecb",
                                                "text": "Jesus is reverenced as the one man who has lived unspotted by the world, free from human foibles, able to redeem mankind by his example."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "271b12a5-a10a-3e51-b6e4-33d89bc91c71",
                                        "entry_id": "94deb8f3-4830-38b6-b45c-c982b0ac2a73",
                                        "glosses": [
                                            "Part of a sword between the middle and the point, weaker than the forte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "foible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e5ad001-1724-37f3-ad33-371391a61a42",
                                        "entry_id": "b515e309-7efa-3eaa-b65c-a29c7e769919",
                                        "glosses": [
                                            "Weak; feeble."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513c6ff7-cbae-4862-a2a2-7dc8105f1f0c",
                                                "sense_id": "1e5ad001-1724-37f3-ad33-371391a61a42",
                                                "text": "The good Fencing-maſters, in France eſpecially, when they preſent a Foyle or Fleuret to their Scholars, tell him it hath two Parts, one of which he calleth the Fort or ſtrong, and the other the Foyble or weak […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb826f47-0574-4a40-9141-f3572a65699f",
                        "source_entry_id": "15bb946f-46bd-3c07-a26a-4880eaf417b2",
                        "source_sense_id": "3b0897f8-81b7-3e81-8dbb-663888d31f2b",
                        "target_lang_word": "slabina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slabina",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "11f5ec0b-2a9c-3699-a1d2-93982c79f33f",
                                        "entry_id": "1c54fac3-7e85-320b-b633-c22015c7c8ac",
                                        "glosses": [
                                            "hledisko, z něhož je určitý objekt méně výkonný či odolný"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ef151d-c85a-4065-9da5-806dad38fae5",
                                                "sense_id": "11f5ec0b-2a9c-3699-a1d2-93982c79f33f",
                                                "text": "Ve většině předmětů by měl u maturity uspět, jen matematika je jeho slabina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5a2444-b55e-3bc7-a209-c660c4ee8a71",
                                        "entry_id": "1c54fac3-7e85-320b-b633-c22015c7c8ac",
                                        "glosses": [
                                            "část těla savců mezi nohou a žebry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0898f9-7781-42ac-86db-6fa78af1c708",
                                                "sense_id": "2a5a2444-b55e-3bc7-a209-c660c4ee8a71",
                                                "text": "Jezdec bodl koně do slabin a přešel do prudkého trysku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38af6978-b239-494f-9f3c-3ae9fa6a5b60",
                        "source_entry_id": "15bb946f-46bd-3c07-a26a-4880eaf417b2",
                        "source_sense_id": "3b0897f8-81b7-3e81-8dbb-663888d31f2b",
                        "target_lang_word": "Schwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "mangelnde körperliche oder geistige Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4057b4a-6120-4b59-895c-f424d19b1b53",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "Mich überkam plötzlich eine unerklärliche Schwäche in den Beinen."
                                            },
                                            {
                                                "example_id": "38775ebb-8556-4968-b538-df9495bfbd74",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Wobei ich eine klitzekleine Schwäche habe, die ich den Damen gern verschweige.“"
                                            },
                                            {
                                                "example_id": "6d99c57e-2a2d-4df2-a74c-807093a9b6a7",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Allgemeine Schwäche des Körpers und erhöhte Reizbarkeit des Nervensystems gesellen sich dazu.“"
                                            },
                                            {
                                                "example_id": "867dee60-c3ac-4dbb-aa75-25fae341ac8d",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Meine Schwäche ist wie weggeblasen.“"
                                            },
                                            {
                                                "example_id": "69ee443b-1417-461c-aed3-2dd30c8a8259",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "[Covid-19-Erkrankungen:] „Andere Genesene leiden unter einem Taubheitsgefühl, Schwäche und Gedächtniseinschränkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "charakterlicher Mangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8faae0-9017-4c24-8858-e56f63d34ea9",
                                                "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                                "text": "Mangelnder Einsatzwille ist keine Schwäche von ihm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "besondere Neigung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de28c156-b7e8-4512-b221-e7e364694eb3",
                                                "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                                "text": "Er hat eine Schwäche für dunkle Schokolade."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "sachliche Unvollkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a97410-90d0-42ab-9170-41197bf05ba6",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "Die Literaturkritiker versuchen, die Schwächen literarischer Werke herauszufinden."
                                            },
                                            {
                                                "example_id": "8f4b0b50-764a-4d76-bec9-c288d966b321",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
