{
    "word_family": [
        "classification",
        "classifier",
        "classifiable",
        "reclassify",
        "subclassify"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be13fb3d-d714-3561-9005-8e479e338903",
                    "sense_definition": "to arrange or organize things into groups or categories based on shared characteristics",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "categorization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologists <w>classify</w> living organisms into different kingdoms based on their cellular structure.",
                            "target_lang_translations": {
                                "ru": "Биологи <w>классифицируют</w> живые организмы по различным царствам на основе их клеточной структуры."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>classify</w> documents when they contain information relevant to multiple departments.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>классифицировать</w> документы, если они содержат информацию, относящуюся к нескольким отделам."
                            }
                        }
                    ],
                    "synonyms": [
                        "categorize",
                        "sort",
                        "label",
                        "pigeonhole",
                        "divide"
                    ],
                    "common_phrases": [
                        "classify documents",
                        "classify information",
                        "classify by type"
                    ],
                    "target_lang_definitions": {
                        "ru": "распределять или организовывать вещи по группам или категориям на основе общих характеристик"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классифицировать",
                                "target_lang_sense_clarification": "распределять по классам или разрядам"
                            },
                            {
                                "target_lang_word": "систематизировать",
                                "target_lang_sense_clarification": "приводить в систему"
                            },
                            {
                                "target_lang_word": "сортировать",
                                "target_lang_sense_clarification": "распределять по сортам или видам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a749a8de-aba8-33f7-af3d-acd693e70981",
                    "sense_definition": "to officially declare information or a document as a secret that is available only to authorized people",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secrecy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>classify</w> the report to protect national security interests.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>засекретить</w> отчет в целях защиты интересов национальной безопасности."
                            }
                        },
                        {
                            "text": "If they <w>classify</w> information, the public will not have access to the truth for many years.",
                            "target_lang_translations": {
                                "ru": "Если они <w>засекретят</w> информацию, общественность не будет иметь доступа к правде в течение многих лет."
                            }
                        }
                    ],
                    "antonyms": [
                        "declassify"
                    ],
                    "common_phrases": [
                        "classify as secret",
                        "classify information"
                    ],
                    "target_lang_definitions": {
                        "ru": "официально объявлять информацию или документ секретными, доступными только уполномоченным лицам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засекречивать",
                                "target_lang_sense_clarification": "делать секретным (процесс)"
                            },
                            {
                                "target_lang_word": "засекретить",
                                "target_lang_sense_clarification": "сделать секретным (результат)"
                            },
                            {
                                "target_lang_word": "присваивать гриф секретности",
                                "target_lang_sense_clarification": "официально ограничивать доступ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "190454bf-5c5f-375d-b7f1-23431e52986e",
                    "sense_definition": "to make something more elegant, stylish, or high-class",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to <w>classify</w> the old pub by adding velvet curtains and expensive lighting.",
                            "target_lang_translations": {
                                "ru": "Они попытались <w>облагородить</w> старый паб, добавив бархатные шторы и дорогое освещение."
                            }
                        },
                        {
                            "text": "Adding a bit of jazz music can really <w>classify</w> the atmosphere of the lounge.",
                            "target_lang_translations": {
                                "ru": "Немного джазовой музыки может действительно <w>придать лоск</w> атмосфере лаунджа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to mean making something classy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать что-либо более элегантным, стильным или высококлассным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать более изысканным"
                            },
                            {
                                "target_lang_word": "придавать лоск",
                                "target_lang_sense_clarification": "делать более стильным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}