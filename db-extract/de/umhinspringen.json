                "senses": [
                    {
                        "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                        "entry_id": "fa04e7c3-cbf8-300b-a4ad-7969e6928360",
                        "glosses": [
                            "hinüberspringen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "23f84332-a336-474d-b855-c12c64c94da4",
                                "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                                "text": "„…, so nimm a Ratz zu dir ins Bett und alle Flöh und Läus wern vo deim Kürpa auf d’Ratz ummispringa, weils eahna in dem warma Fell bessa taugt.“"
                            },
                            {
                                "example_id": "85cea1ed-c078-44e4-b42c-2f105da7592e",
                                "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                                "text": "„Spring nur gleich zum Bürgermeister ummi!“"
                            },
                            {
                                "example_id": "e0d2b451-a0e9-4e2b-a706-422ee5f6fc0b",
                                "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                                "text": "„Wiar i oft zum Pforra ummi spring und 'n gonzn Doixl füra bring“"
                            },
                            {
                                "example_id": "e2a768e9-4ff2-467a-8500-480b12225297",
                                "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                                "text": "„Weiß, Hannes, muaßt in die nächsten Täg amal umispringen, mir müssen's ausbessern.“"
                            },
                            {
                                "example_id": "f4cf4e05-e399-4085-8ccd-b73c701f4068",
                                "sense_id": "edc413ed-7fbd-3808-97aa-9c4963842267",
                                "text": "„Drum bin ich gleich ummi gsprungen auf d' Sebenalm und hab a paar Leut auftrieben, die den Hirsch heut noch aussi liefern ins Jagdhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
