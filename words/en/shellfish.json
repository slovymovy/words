            "senses": [
                {
                    "sense_id": "ec2f1dab-e099-3a15-9085-9c3753e8055d",
                    "sense_definition": "Aquatic animals with shells or exoskeletons, such as shrimp, crabs, and oysters, used as food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "seafood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant is famous for its <w>shellfish</w> platter, which includes fresh lobster and mussels.",
                            "target_lang_translations": {
                                "ru": "Ресторан славится своим ассорти из <w>морепродуктов</w>, которое включает свежих лобстеров и мидий."
                            }
                        },
                        {
                            "text": "Many people have a severe <w>shellfish</w> allergy and must avoid eating shrimp or clams.",
                            "target_lang_translations": {
                                "ru": "У многих людей наблюдается тяжелая аллергия на <w>моллюсков и ракообразных</w>, и им следует избегать употребления креветок или мидий."
                            }
                        }
                    ],
                    "synonyms": [
                        "seafood",
                        "crustaceans",
                        "mollusks"
                    ],
                    "common_phrases": [
                        "shellfish allergy",
                        "fresh shellfish",
                        "raw shellfish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водные животные с панцирем или раковиной, такие как креветки, крабы и устрицы, используемые в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моллюски и ракообразные",
                                "target_lang_sense_clarification": "как категория морепродуктов"
                            },
                            {
                                "target_lang_word": "морепродукты",
                                "target_lang_sense_clarification": "общее название для еды из морских обитателей"
                            },
                            {
                                "target_lang_word": "ракообразные",
                                "target_lang_sense_clarification": "креветки, крабы, омары"
                            },
                            {
                                "target_lang_word": "моллюски",
                                "target_lang_sense_clarification": "мидии, устрицы, гребешки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47a17e65-a7d7-3177-936e-1d611ad18f7f",
                    "sense_definition": "An aquatic invertebrate animal having a shell, such as a mollusc or crustacean.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marine biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marine biologists study how different types of <w>shellfish</w> adapt to changing ocean temperatures.",
                            "target_lang_translations": {
                                "ru": "Морские биологи изучают, как различные виды <w>панцирных животных</w> адаптируются к изменению температуры океана."
                            }
                        },
                        {
                            "text": "The local <w>shellfish</w> population has declined due to pollution in the coastal waters.",
                            "target_lang_translations": {
                                "ru": "Популяция местных <w>моллюсков</w> сократилась из-за загрязнения прибрежных вод."
                            }
                        }
                    ],
                    "synonyms": [
