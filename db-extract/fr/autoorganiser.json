                        "examples": [
                            {
                                "example_id": "2cde0255-7da0-4e94-a0ee-bcee89ac4f8a",
                                "sense_id": "f0e4ed1d-cc95-3645-9463-3e3630c47912",
                                "text": "D’autres conçoivent le peuple comme un acteur réel, comme une communauté. Ils cherchent à le libérer de ses entraves et à lui permettre de s’autoorganiser."
                            },
                            {
                                "example_id": "17a7d7b1-08c6-4068-ae1c-34704ee19917",
                                "sense_id": "f0e4ed1d-cc95-3645-9463-3e3630c47912",
                                "text": "La série désigne tout ensemble humain qui reçoit son unité de l’extérieur et qui est incapable de former une unité interne, incapable de s’autoorganiser."
                            }
                        ]
                    }
