                                        "entry_id": "0c6228e5-a9ba-3cf1-bbcb-ba192e70269c",
                                        "glosses": [
                                            "Any disintegration or fragmentation process."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "285924f6-c42d-45b1-93a5-2ebfb30a4bbd",
                                                "sense_id": "7e6c6117-e983-3e32-a2ec-359aac0bdb3c",
                                                "text": "demographic balkanization"
                                            },
                                            {
                                                "example_id": "6a028463-085e-40df-ae5e-e84de0c6e71c",
                                                "sense_id": "7e6c6117-e983-3e32-a2ec-359aac0bdb3c",
                                                "text": "Issues that are already hotly contested become even more divisive in the context of social balkanization."
                                            },
                                            {
                                                "example_id": "79cad8d7-4b56-4c07-b593-4c214bce9f6a",
                                                "sense_id": "7e6c6117-e983-3e32-a2ec-359aac0bdb3c",
                                                "text": "In other words, will the biometric future feature biometric centralization whereby one biometric would dominate multiple applications, or will we see biometric balkanization where multiple biometrics are used for multiple applications?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
