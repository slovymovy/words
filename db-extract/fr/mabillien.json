                        "glosses": [
                            "Habitué du bal Mabille."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5be77e77-c7cd-4d35-9543-0ee21ca53f3d",
                                "sense_id": "5d66e34b-dd60-3369-9f47-501b5c48d4bc",
                                "text": "Une douzaine de nègres se joignirent à la sarabande, mais au lieu d’en imiter la lente et monotone allure, ils exécutèrent des cavalier seul à rendre jaloux un mabillien de première année."
