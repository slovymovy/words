                        ]
                    },
                    {
                        "translation_id": "f55e873a-74e5-4beb-93bf-78e7f9427df7",
                        "source_entry_id": "547cf0a8-32d6-3b49-b66a-346c28ad56ec",
                        "source_sense_id": "6bef7680-c82e-3c57-ae7e-9be52b507f22",
