                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95742389-453f-4876-b145-b21355869a23",
                                                "sense_id": "b302a5e6-0c8b-3e34-83e1-9d53ba81f1fe",
                                                "text": "Он снял с головы котелок и застенчиво приглаживал ладонью белёсые волосы."
                                            },
                                            {
                                                "example_id": "634cad70-f4b6-47c6-97fd-34c747d79b6f",
                                                "sense_id": "b302a5e6-0c8b-3e34-83e1-9d53ba81f1fe",
                                                "text": "Из оврага выплывал и стлался по земле белёсый туман."
                                            },
                                            {
                                                "example_id": "c570163c-9193-4a6b-ab00-d255273f2d3c",
                                                "sense_id": "b302a5e6-0c8b-3e34-83e1-9d53ba81f1fe",
                                                "text": "Ярко-рыжие волосы, белёсые ресницы, широкий нос и резко выступающий вперёд подбородок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38dfdaaa-5f48-320e-ab6d-894384c303cb",
                                        "entry_id": "38f8009f-ba79-36ab-80a3-52d19e7634dc",
                                        "glosses": [
                                            "перен. лишённый яркости цвета, тусклый и светлый до белизны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "649730d5-69f0-4c19-8817-7409cbaa9dfb",
                                                "sense_id": "38dfdaaa-5f48-320e-ab6d-894384c303cb",
                                                "text": "Мёртво выдвигались из тумана пригородные кусты, белёсые от далёкого зарева."
                                            },
                                            {
                                                "example_id": "fd21e213-ec5f-471a-bd4b-78c11b5fbe84",
                                                "sense_id": "38dfdaaa-5f48-320e-ab6d-894384c303cb",
                                                "text": "Сам рассвет был кремово-бежевый, обещал спокойную погоду и белёсое солнце."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
