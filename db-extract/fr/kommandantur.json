                    {
                        "sense_id": "d42cd326-9ec1-3894-a479-771845e43c1c",
                        "entry_id": "e6d0d2a8-88b9-3fe1-85e4-007bb0a3e269",
                        "glosses": [
                            "Variante de Kommandantur."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d628d7a6-4f7e-4f52-bd3b-eb5fba536836",
                                "sense_id": "d42cd326-9ec1-3894-a479-771845e43c1c",
                                "text": "Toutes les kommandanturs reçurent ce genre de missives et des hommes et des femmes purent être arrêtés, torturés, déportés, fusillés alors qu'ils étaient innocents des faits dont ils étaient accusés."
                            },
                            {
                                "example_id": "657fa705-3094-458e-8831-0f00438468bf",
                                "sense_id": "d42cd326-9ec1-3894-a479-771845e43c1c",
                                "text": "Les Allemands, qui écrouent Marie de Croÿ le 6 septembre, distribuent à toutes les kommandanturs la description de son frère Reginald, qui s’est volatilisé."
                            }
                        ]
                    }
