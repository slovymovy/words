                                        "glosses": [
                                            "druh rybářské sítě na tyči"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35de154a-bb70-4768-b4b5-5d78da72e9f9",
                                                "sense_id": "28bc834f-8604-315e-8337-2a48acb0a8e2",
                                                "text": "Slýchal od starých rybáků, že jikrnáči již od časného jara na noc vyhledávají za dne sluncem vyhřátá místa. Zalovil tam a div že nevejskl. Nemohl čeřen ani vytáhnout."
                                            },
                                            {
                                                "example_id": "166235df-7a0e-4346-ba36-89db06ba2239",
                                                "sense_id": "28bc834f-8604-315e-8337-2a48acb0a8e2",
                                                "text": "Chtěl tomu uniknout; napadlo ho slovo „rybář“, a hle, zjevil se mu rybář nad šedivou vodou i s rybami v čeřen; řekl si „lešení“, a viděl skutečné lešení do poslední skoby a vazby. Dlouho se bavil tím, že vymýšlel slova pozoroval obrázky jimi promítnuté"
                                            }
                                        ]
                                    }
