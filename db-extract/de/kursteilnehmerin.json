                        "examples": [
                            {
                                "example_id": "f6a158e4-f858-4b60-b63a-e1eb0df68050",
                                "sense_id": "1f9a4b94-fff3-3cb4-a393-52e496749cfc",
                                "text": "„Immer neue Beispiele fallen ihnen ein, um der frisch dazugestoßenen Kursteilnehmerin aus dem Iran das Wort \"süchtig\", das Cahaya so eindringlich darzustellen versucht, auf Englisch, Arabisch, mit Händen und Füßen zu erklären.“"
                            },
                            {
                                "example_id": "e2700089-075b-439e-be2e-8725d9dec723",
                                "sense_id": "1f9a4b94-fff3-3cb4-a393-52e496749cfc",
                                "text": "„Anders ist das bei Berufsrückkehrerinnen: Hier reicht es meist, wenn eine Kursteilnehmerin irgendwann einmal zwölf Monate beitragspflichtig beschäftigt war.“"
                            }
                        ],
