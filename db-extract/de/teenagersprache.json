                "senses": [
                    {
                        "sense_id": "e76946d2-15b9-309e-8a64-db07592b9562",
                        "entry_id": "507607c3-1346-3afc-aca3-e76dcd96fc83",
                        "glosses": [
                            "Redeweise von Teenagern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f08031-8834-4b69-99ee-765c81c232f4",
                                "sense_id": "e76946d2-15b9-309e-8a64-db07592b9562",
                                "text": "„Perlmann ärgerte sich über ihre Jungmädchenbegeisterung und die Teenagersprache, die ihm bei ihrer Ankunft so gut gefallen hatte, weil sie zu dem roten Elefanten auf dem Koffer paßte.“"
                            },
                            {
                                "example_id": "7c8d4f01-0391-4d64-aa55-e3cbe12cdd78",
                                "sense_id": "e76946d2-15b9-309e-8a64-db07592b9562",
                                "text": "„Sie sind unter Bezeichnungen wie Studentensprache, Soldatensprache, Schülersprache oder Teenagersprache vielfach beschrieben worden als sprachlicher Ausdruck des Flegelalters.“"
                            },
                            {
                                "example_id": "59974d71-c9eb-4a3d-a121-f4b24de92de3",
                                "sense_id": "e76946d2-15b9-309e-8a64-db07592b9562",
                                "text": "„Aber es gab nicht nur Teenagermusik und -mode, sondern auch Teenagerfilme, -zeitschriften, -klubs und bald sogar ein eigenes Wörterbuch der Teenagersprache: \"Steiler Zahn und Zickendraht\".“"
                            },
                            {
                                "example_id": "2b15b91c-bd61-4d2b-bd70-7299e5c98025",
                                "sense_id": "e76946d2-15b9-309e-8a64-db07592b9562",
                                "text": "„Der kulturelle Einfluss wird auch in der Teenagersprache deutlich, die an einigen Schulen in der Region zu hören ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
