                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous effectuez des heures <w>supplémentaires</w>, elles apparaîtront clairement sur votre fiche de paie."
                        },
                        {
                            "text": "L'hôtel applique un coût <w>supplémentaire</w> pour l'accès aux équipements de bien-être."
                        }
                    ],
                    "synonyms": [
