                        "examples": [
                            {
                                "example_id": "650cd6b7-21bc-4868-ac03-f23b51c0c2d2",
                                "sense_id": "547f8352-d274-31cd-a1ae-8d37331afc53",
                                "text": "Den besten zehn Teilnehmern wurden heute Ehrenurkunden ausgehändigt."
                            },
                            {
                                "example_id": "68de8228-4971-4560-ac5a-a7e956d981a2",
                                "sense_id": "547f8352-d274-31cd-a1ae-8d37331afc53",
                                "text": "„Bei den Bundesjugendspielen bekam ich nur noch Ehrenurkunden und im Sport stets eine sichere Zwei.“"
                            },
                            {
                                "example_id": "94273831-cc79-446b-a355-cba6a71269ff",
                                "sense_id": "547f8352-d274-31cd-a1ae-8d37331afc53",
                                "text": "„An die Unsportlichen unter den Schülern haben die Kultusminister auch gedacht: Seit 1991 gibt es Teilnahme-Urkunden für alle, die keine Sieger- oder Ehrenurkunde ergattern konnten.“"
                            }
                        ],
