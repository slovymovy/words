    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dd2ac29-05b2-377f-a8b3-74eb6c329cf3",
                    "sense_definition": "Mettre à l'essai ou tester une idée, un procédé, une méthode pour en apprécier l'efficacité ou les effets.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "test",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'école a décidé d'<w>expérimenter</w> une nouvelle approche pédagogique pour motiver les élèves."
                        },
                        {
                            "text": "Nous <w>expérimentons</w> un nouvel outil informatique afin de faciliter le travail en équipe."
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "tester"
                    ],
                    "common_phrases": [
                        "expérimenter une nouvelle méthode",
                        "expérimenter un nouveau produit"
                    ]
                },
                {
                    "sense_id": "59ee0904-b29c-332d-94e4-e5006fd6147c",
                    "sense_definition": "Réaliser des démarches scientifiques et des manipulations contrôlées afin d'étudier un phénomène naturel ou de vérifier une hypothèse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques doivent <w>expérimenter</w> en laboratoire pour confirmer leurs théories."
                        },
                        {
                            "text": "Il est désormais interdit d'<w>expérimenter</w> sur les animaux dans cette industrie cosmétique."
                        }
                    ],
                    "common_phrases": [
                        "expérimenter en laboratoire",
                        "expérimenter sur les animaux"
                    ]
                },
                {
                    "sense_id": "888f4538-abb7-3df6-a634-14b48c7eac91",
                    "sense_definition": "Faire l'expérience intime ou concrète d'une émotion, d'une situation ou d'un état.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eprouver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant son long séjour à l'étranger, il a pu <w>expérimenter</w> un sentiment d'indépendance inédit."
                        },
                        {
                            "text": "Chaque individu est amené à <w>expérimenter</w> le deuil au cours de son existence."
                        }
                    ],
                    "synonyms": [
                        "éprouver",
                        "ressentir",
                        "vivre"
                    ],
                    "common_phrases": [
