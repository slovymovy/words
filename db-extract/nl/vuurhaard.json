                                    {
                                        "sense_id": "1cb13482-7a7d-3c6d-8828-64db5f119e4e",
                                        "entry_id": "bd0a6774-f687-3d00-ae32-27c991aebb72",
                                        "glosses": [
                                            "A supplementary meeting in The Church of Jesus Christ of Latter-day Saints."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a78aea5-77c1-4760-8048-f2fa8bd64088",
                                                "sense_id": "1cb13482-7a7d-3c6d-8828-64db5f119e4e",
                                                "text": "At a Brigham Young University fireside, President Hunter said, “If you feel that … what you do this year or in the years to come does not make you very famous, take heart[...]”"
                                            },
                                            {
                                                "example_id": "106d62a9-d6d2-48ee-b8c2-667b5821a160",
                                                "sense_id": "1cb13482-7a7d-3c6d-8828-64db5f119e4e",
                                                "text": "Thomas (that is not his real name) was one who had lost his way. We became acquainted at a special fireside attended by members one doesn’t normally see on Sunday[...] The day before, Thomas’s father had invited him to attend the fireside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc8328f-8f75-4c8a-85f8-adbdc73ff1e0",
                        "source_entry_id": "bca82b00-2210-320b-a3b1-01fc292c34fe",
