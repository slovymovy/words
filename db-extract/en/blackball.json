                        "sense_id": "3bcfa702-1177-3020-8d36-f4a8389b7837",
                        "entry_id": "1099d0eb-4c08-3cbd-ac71-6853ec48374a",
                        "glosses": [
                            "gegen jemanden bei der Aufnahme in einen Klub oder Gemeinschaft stimmen, meist in einer geheimen Abstimmung"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3ed1e3c1-c913-4519-9591-75d58861e754",
                                "sense_id": "3bcfa702-1177-3020-8d36-f4a8389b7837",
                                "text": "The club secretly blackballs applicants who are no lawyers or physicians.",
                                "translation": "Der Klub lehnt heimlich Bewerber ab, die keine Rechtsanwälte oder Ärzte sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c39f0ef-465d-40f9-96fd-a8cd4f96d002",
                        "source_entry_id": "1099d0eb-4c08-3cbd-ac71-6853ec48374a",
                        "source_sense_id": "3bcfa702-1177-3020-8d36-f4a8389b7837",
                        "source_sense_description": "gegen jemanden bei der Aufnahme in einen Klub oder Gemeinschaft stimmen",
                        "target_lang_word": "ablehnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablehnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                        "entry_id": "30bede61-ee37-37fc-b9a4-d7bcaba9be86",
                                        "glosses": [
                                            "zu etwas nein sagen; etwas zurückweisen oder missbilligen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2023a16e-1724-4e6b-8fb4-eb6f275e0f4c",
                                                "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                                "text": "Er lehnte den Vorschlag schlichtweg ab."
                                            },
                                            {
                                                "example_id": "d3c4068c-04e5-461d-a938-628205466f26",
                                                "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                                "text": "„Viele Umweltverbände lehnen Klimakompensation ab.“"
                                            },
                                            {
                                                "example_id": "4efd29ca-1d58-4e38-a180-af24969e4b2e",
                                                "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                                "text": "„Viele Menschen lehnen genveränderten Weizen als unkalkulierbares Risiko ab, […].“"
                                            },
                                            {
                                                "example_id": "9ab479d6-5b72-4992-8a40-bfffd6b7700d",
                                                "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                                "text": "„Sowohl im Deutschen Reich wie auch in Großbritannien lehnten führende Finanzmagnaten wie Warburg und Rothschild Krieg deshalb strikt ab, ja versuchten ihn mitunter sogar aktiv zu verhindern.“"
                                            },
                                            {
                                                "example_id": "395fb801-f5e6-4a28-9cdd-d4cad92b7ab7",
                                                "sense_id": "f370902f-8c39-3885-a083-609fc217ecaa",
                                                "text": "„Nun lehnte der Staat weitere Hilfen ab, nachdem sich eine akute Deckungslücke in Höhe eines zweistelligen Millionenbetrages aufgetan hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
