                                        "sense_id": "7360cf58-e027-3ab4-b4d4-f16e5d0b8385",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of enterprise resource planning."
                                        ],
                                        "tags": [
