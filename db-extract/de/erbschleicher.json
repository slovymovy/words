                ],
                "senses": [
                    {
                        "sense_id": "77ab396f-a4ef-3fe6-9e40-f94bb3eaf9c1",
                        "entry_id": "91707940-cfbc-343d-b7ec-561db079eca4",
                        "glosses": [
                            "Person, die auf unlautere Weise an ein Erbe herankommen will; die Erbschleicherei betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "042fccb0-289e-4054-9cd2-670b1837ff37",
                                "sense_id": "77ab396f-a4ef-3fe6-9e40-f94bb3eaf9c1",
                                "text": "„Erbschleicher bewegen sich im Graubereich, in dem ein Mensch beeinflussbar, aber noch nicht geschäftsunfähig ist.“"
                            },
                            {
                                "example_id": "5f993e6f-93de-4fc1-a869-a5a24b1a3e2a",
                                "sense_id": "77ab396f-a4ef-3fe6-9e40-f94bb3eaf9c1",
                                "text": "„Auch der weiteren Verwandtschaft - die sich eventuell als Erbschleicher einstellen könnte oder die sich abwenden könnte, wenn da nichts zu erwarten ist - wird nicht gern offen gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bd4d387-3a3e-46f0-98a4-436079703392",
                        "source_entry_id": "91707940-cfbc-343d-b7ec-561db079eca4",
                        "source_sense_id": "77ab396f-a4ef-3fe6-9e40-f94bb3eaf9c1",
                        "source_sense_description": "Person, die auf unlautere Weise an ein Erbe herankommen will; die Erbschleicherei betreibt",
                        "target_lang_word": "legacy hunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legacy hunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f239ff90-bef7-33b8-a6e2-eef385df5cd1",
                                        "entry_id": "577b6620-e9ff-3b10-9b06-64dfc75b758c",
                                        "glosses": [
                                            "One that strives after an inheritance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c45d2a-0495-4d99-be36-f8e6249095a4",
                                                "sense_id": "f239ff90-bef7-33b8-a6e2-eef385df5cd1",
                                                "text": "“[…] I am a great hunter, but not legacy hunter, that is a kind of hunting I despise—and I wish every hunter of that kind may be thrown out, or thrown off, and may never be in at the death!”"
                                            },
                                            {
                                                "example_id": "e6552dc6-6f3a-481b-af42-29f4027596dc",
                                                "sense_id": "f239ff90-bef7-33b8-a6e2-eef385df5cd1",
                                                "text": "I am a legacy-hunter, a parasite, a rich man's minion. I bitterly despise myself already. The very servants will sneer at me; the lowest groom in the stable will point at me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
