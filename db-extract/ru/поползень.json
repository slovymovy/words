                                                "example_id": "89317d1b-ed83-4082-aa3b-de58772e1072",
                                                "sense_id": "a239d72f-209c-3862-8766-53ae54bbcf25",
                                                "text": "Der Kleiber ist Vogel des Jahres 2006."
                                            },
