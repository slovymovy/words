                                "target_senses": [
                                    {
                                        "sense_id": "d98df233-cac7-3cf0-9805-8e733f8cdea0",
                                        "entry_id": "61036eaf-6b03-3ae1-a79d-ad13f2763ae1",
                                        "glosses": [
                                            "A river flowing through France, Belgium and the Netherlands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af570a3b-dd29-45c7-b074-ba5d3930666a",
                                                "sense_id": "d98df233-cac7-3cf0-9805-8e733f8cdea0",
                                                "text": "Perhaps as a child she watched for his ship coming up the Scheldt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee9ec24b-3093-4591-82a0-7ccb0e6ad1dd",
                        "source_entry_id": "01218a27-99ef-3897-87f3-de4a6081a76e",
                        "source_sense_id": "6a831942-07a2-3d7f-950c-b98f18393c69",
                        "source_sense_description": "een rivier die ontspringt in de gemeente Gouy in noordelijk Frankrijk",
                        "target_lang_word": "Escaut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Escaut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "720f160b-0cc4-3e29-ab89-3cd43735f381",
                                        "entry_id": "ba95b870-7f29-33a0-9eff-a20700ddf8ad",
                                        "glosses": [
                                            "Fleuve européen de plaine à débit lent de 355 km de long, qui traverse la France, la Belgique et les Pays-Bas avant de se jeter en mer du Nord."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aea8ad6-190e-4543-9179-378dfd800792",
                                                "sense_id": "720f160b-0cc4-3e29-ab89-3cd43735f381",
                                                "text": "Le vent se déclara contre les Espagnols, qui perdirent des navires sur les bas-fonds des bouches de l’Escaut."
                                            },
                                            {
                                                "example_id": "66e83d2f-18d3-41df-a3be-fe8ba8d9e0fd",
                                                "sense_id": "720f160b-0cc4-3e29-ab89-3cd43735f381",
                                                "text": "L’Escaut ne se jette point dans la Meuse, mais dans l'Océan ; tandis que la Sambre se jette dans la Meuse à Namur."
                                            },
                                            {
                                                "example_id": "c39850ad-27a2-45f4-8171-f5e865612e2b",
                                                "sense_id": "720f160b-0cc4-3e29-ab89-3cd43735f381",
                                                "text": "Après la Selle, un affluent de l’Escaut également fort intéressant est l’Herclain dont le lit se trouve presque toujours à sec. Je l'ai étudié depuis sa source à Mauroy et Honnechy jusqu'à Saint-Aubert."
                                            },
                                            {
                                                "example_id": "a5bc45e0-4b20-47bd-90e3-3e98c0a7e915",
                                                "sense_id": "720f160b-0cc4-3e29-ab89-3cd43735f381",
                                                "text": "Il y a encore trente ans, l’Escaut était l’un des fleuves les plus pollués d’Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f028cef1-23a3-344f-a2be-749ee8493b1c",
                                        "entry_id": "ba95b870-7f29-33a0-9eff-a20700ddf8ad",
                                        "glosses": [
                                            "Ancien département français dont le chef-lieu était Gand, ayant existé de 1795 à 1814."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1777c5e0-48d6-4adc-b8c5-4ae879be9bb7",
                                                "sense_id": "f028cef1-23a3-344f-a2be-749ee8493b1c",
                                                "text": "Dans le département de l’Escaut, un oratoire fut créé à Bruxelles, tandis que des communautés non officielles existaient à Gand, Etichove, Horebeke dans le département de l’Escaut, à Mater dans le département de la Lys, et à Anvers dans celui des Deux-Nèthes ; en 1804, Napoléon octroya aux protestants bruxellois la Chapelle de la Cour édifiée sur ordre de Charles de Lorraine en 1760."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
