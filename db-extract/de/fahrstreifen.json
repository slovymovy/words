                "senses": [
                    {
                        "sense_id": "b76cde3a-5ace-3a48-a30b-0eccee31bd69",
                        "entry_id": "2deeaa2b-f31f-3124-8b23-ded88ea3b96d",
                        "glosses": [
                            "der Bereich einer Straße, der einem Fahrzeug für die Fahrt in eine Richtung zur Verfügung steht"
                        ],
                        "tags": [
                            "Verkehrswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "d73e950e-9cdd-41c7-9bba-825a93ed0696",
                                "sense_id": "b76cde3a-5ace-3a48-a30b-0eccee31bd69",
                                "text": "Der Fahrstreifen kann, muss aber nicht durch Straßenmarkierungen, wie die Fahrbahnbegrenzung, die Fahrstreifenbegrenzung oder die Leitlinie, gekennzeichnet sein."
                            },
                            {
                                "example_id": "86a66a0d-76a9-41b0-903f-aad28f3656cb",
                                "sense_id": "b76cde3a-5ace-3a48-a30b-0eccee31bd69",
                                "text": "Kraftfahrzeuge sollten mittig in ihrem Fahrstreifen bleiben."
                            },
                            {
                                "example_id": "ec87d1ec-6052-41fe-994a-57ea0f39ac15",
                                "sense_id": "b76cde3a-5ace-3a48-a30b-0eccee31bd69",
                                "text": "Für Straßen mit mehr als einem Fahrstreifen für jede Richtung gilt in Deutschland die Richtgeschwindigkeit von 130 km/h."
                            }
                        ],
                        "sense_index_json": "\"1\""
