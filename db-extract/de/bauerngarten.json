                "senses": [
                    {
                        "sense_id": "a6a6fa7c-ae4e-3dc6-8f9c-31f086a3316e",
                        "entry_id": "6d22bdc9-7f42-3758-ae1f-23ab8c67b2db",
                        "glosses": [
                            "Garten, der als Teil eines Bauernhofs der Eigenversorgung mit Blumen, Gemüse, Kräutern, Obst … der Bewohner dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55fca62-f8cf-4603-b7fc-c864f08af8f9",
                                "sense_id": "a6a6fa7c-ae4e-3dc6-8f9c-31f086a3316e",
                                "text": "„Ich folgte dem schilfumsäumten Weg zu einem wilden Bauerngarten, der wiederum von einer hohen Hecke umgeben war.“"
                            },
                            {
                                "example_id": "47ef14d8-8091-42c4-b689-aa2796eca707",
                                "sense_id": "a6a6fa7c-ae4e-3dc6-8f9c-31f086a3316e",
                                "text": "Der ursprüngliche Bauerngarten wurde nicht direkt am Haus angelegt, sondern befand sich meist in einem eingezäunten Gebiet auf dem Grundstück des Bauern.“"
                            },
                            {
                                "example_id": "ede5822c-f4d9-42aa-815b-737c3325e1ce",
                                "sense_id": "a6a6fa7c-ae4e-3dc6-8f9c-31f086a3316e",
                                "text": "„Jeder halbwegs intakte Bauerngarten erinnert heute noch daran.“"
                            },
                            {
                                "example_id": "387baeb2-6206-4642-bfed-71d440e4f83c",
                                "sense_id": "a6a6fa7c-ae4e-3dc6-8f9c-31f086a3316e",
                                "text": "„Zu einer angenehmen Unterbrechung ihres Marsches gehörte die Entdeckung mehrerer Bienenstöcke in einem Bauerngarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
