                    {
                        "sense_id": "d140d754-d6b3-3210-94c7-cc5c1c81f2b1",
                        "entry_id": "a411ae20-7d7b-3509-bd29-0e1e11fcfa63",
                        "glosses": [
                            "Wearing a dress."
