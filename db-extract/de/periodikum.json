                "senses": [
                    {
                        "sense_id": "ed842ab5-1a93-341e-9e52-abd9849dcfcb",
                        "entry_id": "d83a1bf6-ddbf-3ac4-913d-d933f66bbff9",
                        "glosses": [
                            "etwas, das regelmäßig (periodisch) erscheint, zum Beispiel ein Magazin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c45c2e-6241-4922-be6f-b13942d99e17",
                                "sense_id": "ed842ab5-1a93-341e-9e52-abd9849dcfcb",
                                "text": "Diese Zeitschrift ist ein Periodikum."
                            },
                            {
                                "example_id": "2024b65d-3118-4d08-8e76-71135a4416e5",
                                "sense_id": "ed842ab5-1a93-341e-9e52-abd9849dcfcb",
                                "text": "„Wieland wollte kein Periodikum für seine eigenen Belange und Interessen, seine literarischen und politischen Ansichten, einen Platz zum Vorabdruck seiner eigenen Werke etwa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "041e72c6-15c6-4aae-b997-c33c8c8fd9ef",
                        "source_entry_id": "d83a1bf6-ddbf-3ac4-913d-d933f66bbff9",
                        "source_sense_id": "ed842ab5-1a93-341e-9e52-abd9849dcfcb",
                        "source_sense_description": "etwas, das regelmäßig (periodisch) erscheint, zum Beispiel ein Magazin",
                        "target_lang_word": "periodical",
