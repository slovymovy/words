                "senses": [
                    {
                        "sense_id": "d5a6dfba-7aad-3010-9626-5b13c1384fa6",
                        "entry_id": "fc198772-9fd1-307f-9e90-f46295f1f4fe",
                        "glosses": [
                            "nach einem Wachstumsstillstand oder einer Rezession einsetzender wirtschaftlicher Aufschwung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d6df8c-e23a-4d4e-9e28-ee2c02aa1a98",
                                "sense_id": "d5a6dfba-7aad-3010-9626-5b13c1384fa6",
                                "text": "„An Burris Bilder-Serien lässt sich auch der Wirtschaftsaufschwung nach dem Krieg ablesen. Arbeitete er zunächst mit Säcken aus Hilfslieferungen, so kommen später die Materialien der boomenden Industrie - Furnier und Plastikfolie - hinzu. So seien Burris Bilder auch eine \"Signatur der Zeit\", sagt Hortolani.“"
                            },
                            {
                                "example_id": "4a4f83c9-46d0-4ce5-8602-e28eed63e800",
                                "sense_id": "d5a6dfba-7aad-3010-9626-5b13c1384fa6",
                                "text": "„Die Sozialdemokratin Kirchner warf den Landwirten einen ungerechtfertigten Streik vor, da ihr Sektor am meisten vom Wirtschaftsaufschwung der vergangenen Jahre profitiert habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
