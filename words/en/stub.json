                {
                    "sense_id": "11bde3b0-81c2-36b1-8247-f22ce27ec4db",
                    "sense_definition": "A procedure that translates requests from external systems into a format suitable for processing and then submits those requests for processing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing_and_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The client application communicates with the remote service via a local <w>stub</w>.",
                            "target_lang_translations": {
                                "ru": "Клиентское приложение взаимодействует с удаленной службой через локальную <w>заглушку</w>.",
                                "zh": "客户端应用程序通过本地<w>存根</w>与远程服务进行通信。"
                            }
                        },
                        {
                            "text": "After receiving the network packet, the server <w>stub</w> calls the actual procedure.",
                            "target_lang_translations": {
                                "ru": "После получения сетевого пакета серверная <w>заглушка</w> вызывает саму процедуру.",
                                "zh": "在接收到网络数据包后，服务器端的<w>存根</w>会调用实际的程序。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "server stub",
                        "client stub"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical jargon in networking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процедура, которая преобразует запросы из внешних систем в подходящий формат для обработки.",
                        "zh": "在网络通信中，负责将外部请求转换为可处理格式的程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заглушка",
                                "target_lang_sense_clarification": "сетевой стаб"
                            }
