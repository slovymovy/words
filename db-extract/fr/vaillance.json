                "senses": [
                    {
                        "sense_id": "dd9a91a7-2444-3e96-ab80-a1fae3b0e833",
                        "entry_id": "c70533ea-35a9-3782-ad38-85864532cfa4",
                        "glosses": [
                            "Courage ; bravoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4272e20b-1148-443f-871f-3d4824382e64",
                                "sense_id": "dd9a91a7-2444-3e96-ab80-a1fae3b0e833",
                                "text": "Sa bonne grâce à souffrir, l’entêtement de sa vaillance la maintenaient souriante et droite."
                            },
                            {
                                "example_id": "24636354-b39f-4c63-9c21-e67bb6e3d781",
                                "sense_id": "dd9a91a7-2444-3e96-ab80-a1fae3b0e833",
                                "text": "Elle se laissa tomber dans un fauteuil car, en dépit de sa vaillance apparente, elle était terriblement lasse..."
                            },
                            {
                                "example_id": "43b310bf-fde5-404e-9281-ec31b8324ab9",
                                "sense_id": "dd9a91a7-2444-3e96-ab80-a1fae3b0e833",
                                "text": "Il sait jusqu'en ses os que la vertu cardinale de l'homme c'est le cœur à l'ouvrage, sa valeur première, cette vaillance. Une vaillance, oui, voilà ce qui est écrit en tête de sa table des valeurs."
                            }
                        ]
                    }
                ],
