                        "sense_id": "4bde8b4d-0dd3-34f5-86a8-5b1f2e0bd34e",
                        "entry_id": "35395d18-caaa-3fc4-9f3b-96df2655dff7",
                        "glosses": [
                            "Causing one to become disenchanted; disillusioning; making something unattractive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94637b0f-cacb-4823-997b-907bfccd89f9",
                                "sense_id": "4bde8b4d-0dd3-34f5-86a8-5b1f2e0bd34e",
                                "text": "The more the player knows that as they plug in and log on they are being played on by a vast technomarketing apparatus, the more disenchanting the virtual experience risks becoming."
                            },
                            {
                                "example_id": "d93c8e3d-7490-4341-8e23-c650437473c0",
                                "sense_id": "4bde8b4d-0dd3-34f5-86a8-5b1f2e0bd34e",
                                "text": "What could be more disenchanting than stores built to look like warehouses—comparatively cold, spare, and inelegant?"
                            },
                            {
                                "example_id": "b59049a0-04be-4e18-a978-cdd7c746f818",
                                "sense_id": "4bde8b4d-0dd3-34f5-86a8-5b1f2e0bd34e",
                                "text": "There is nothing more disenchanting than coming away from a class with the residue from the underside of someone's chair all over your favourite sweatshirt."
                            }
                        ]
                    }
                ],
