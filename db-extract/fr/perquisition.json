            {
                "entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
                "word": "perquisition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c38ca8d1-8885-44a1-94e5-a3cccda88b98",
                        "entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
                        "tags": [
                            "plural"
                        ],
                        "form": "perquisitions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                        "entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
                        "glosses": [
                            "Recherche exacte que l’on fait de quelque chose, de quelque personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a929c881-0b85-4ac9-9c38-4362f24f4ac0",
                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                "text": "Alors, malgré l’inutilité de sa première perquisition, il en recommença une seconde"
                            },
                            {
                                "example_id": "39dc3709-3841-4952-a7dc-9027b86a5715",
                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                "text": "Personne ne croit plus que les chrétiens se réfugiaient dans des carrières souter­raines pour échapper aux perquisitions de la police ; les catacombes furent creusées, à très grands frais, par des communautés disposant d'importantes ressources."
                            },
                            {
                                "example_id": "6fb65557-3099-456b-bef8-52d08415160c",
                                "sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                                "text": "Une perquisition chez lui nous a permis de mettre la main sur un fax, deux fusils de chasse à canon scié, des munitions, un attirail pour la fabrication de bombes artisanales, des manuels pour la manipulation des explosifs, des tracts signés Abou Kalybse, et une liste recensant vingt-trois intellectuels dont huit cochés d’une croix parmi lesquels figurent le poète Jamal Armad, Sissane Miloud de la télé et l’homme de spectacle Aït Méziane…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "436712c6-0434-4957-960c-35262c2b32d5",
                        "source_entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
                        "source_sense_id": "6d576dca-4cfd-37e1-a92a-9524520ee259",
                        "source_sense_description": "(Droit) (Police) Recherche exacte",
                        "target_lang_word": "Durchsuchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchsuchung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                        "entry_id": "76608f71-b617-3b1e-902e-19ab385fb9f8",
                                        "glosses": [
                                            "systematische Untersuchung von jemandem oder etwas, um gegebenenfalls etwas Verstecktes zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea8f284-27de-41cb-b5f5-3325c55f38c6",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "„Devereux nahm meinen Gürtel vom Tisch, den man mir bei meiner Durchsuchung abgenommen hatte, und wog ihn auf der Handfläche.“"
                                            },
                                            {
                                                "example_id": "6e4108ec-7424-4ddd-b2cb-889fdc04878c",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Im Zusammenhang mit den Kartellvorwürfen gegen mehrere deutsche Autobauer hat es Durchsuchungen der EU-Kommission bei BMW gegeben."
                                            },
                                            {
                                                "example_id": "6114e72c-ab28-4343-82e4-39ebb9a31c1b",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Zwei Tage nach den Durchsuchungen bei der Deutschen Bank geben die Ermittler Details bekannt: Es geht um dubiose Aktiendeals und den Versuch, den Staat um Millionen zu betrügen."
                                            },
                                            {
                                                "example_id": "b1fedf2f-695a-41f2-8b83-b32b637383d1",
                                                "sense_id": "339d6cfd-fec3-3e0d-aebc-3edccfafa139",
                                                "text": "Seit Tagen sorgen Behörden in Russland mit Durchsuchungen bei politischen Stiftungen und Nichtregierungsorganisationen für Aufsehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "618d7d6c-82e3-4a7d-9e44-ce355592e988",
                        "source_entry_id": "977cdb2b-d484-3f43-bc58-be13c720f92e",
