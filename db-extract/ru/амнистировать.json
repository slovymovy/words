                        ]
                    },
                    {
                        "translation_id": "915d312d-310c-4fdb-8e78-ad20df69280a",
                        "source_entry_id": "a2785af3-e9b7-3c0d-9bab-ff741ec362a7",
                        "target_lang_word": "bağışlamak",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bağışlamak",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b63fc80-fc94-3455-86de-3982c1d4cdfd",
                                        "entry_id": "8b25d1cd-fa3b-30f3-80bf-a5a8af40eccd",
                                        "glosses": [
                                            "bir mal veya hakkı karşılık beklemeden birine vermek, hibe etmek, teberru etmek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0636717-81d3-4ec7-8070-7b8d5d723633",
                                                "sense_id": "1b63fc80-fc94-3455-86de-3982c1d4cdfd",
                                                "text": "Ödünç aldığı parayı bile kendinden daha ihtiyaçlısına bağışlayan ancak bir masal adamıdır, değil mi"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5da8e04-b804-3944-8728-4f5c95445a69",
                                        "entry_id": "8b25d1cd-fa3b-30f3-80bf-a5a8af40eccd",
                                        "glosses": [
                                            "herhangi bir kötü davranış için ceza vermekten vazgeçmek, affetmek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0099edd4-79bd-4794-b9a8-e64aeeef673c",
                                                "sense_id": "c5da8e04-b804-3944-8728-4f5c95445a69",
                                                "text": "Çocuk elindeki çiçek demetini kumandanın ayağı altına atarak, babamı bağışlayınız, diyordu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48437b5c-1520-38a8-a970-0e0906acaef5",
                                        "entry_id": "8b25d1cd-fa3b-30f3-80bf-a5a8af40eccd",
                                        "glosses": [
                                            "görevden çekmek, almak"
                                        ],
