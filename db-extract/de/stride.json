                "senses": [
                    {
                        "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                        "entry_id": "2fa54795-8b4c-3e5d-9ec5-1de816d67d3b",
                        "glosses": [
                            "kurze Laufeinheit mit kontrollierter Beschleunigung"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "116344d1-e69a-4738-a058-0dd9b07fe8bc",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Bei Strides handelt es sich um eine Art Intervall-Lauf.“"
                            },
                            {
                                "example_id": "9cfbf2dc-fb1b-483d-bff1-0b854f492af3",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Strides sind kurze Sprints, bei denen langsam etwa 30 Sekunden lang, auf etwa 90 % der Maximalgeschwindigkeit beschleunigt wird.“"
                            },
                            {
                                "example_id": "5da2a856-f49d-41fa-92cf-5b5ab00e11fa",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Intervalle, Strides, Fartleks, Uphill-Training, schnelle Trainings und Wettkämpfe auf kürzeren Strecken sind hingegen eher ein Fall für wenig bis mäßig gedämpfte Schuhe.“"
                            },
                            {
                                "example_id": "d8a1f9e1-4799-4bb8-96de-c86ffea20f88",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Dabei kannst Du ihn gleichermaßen für die Kurzstrecke, Offroad-Fartleks und Strides, Uphillruns und dank seiner starken Dämpfung auch auf der Langstrecke und für das Ultra-Trailrunning nutzen.“"
                            },
                            {
                                "example_id": "a54ff42c-2689-42a2-b95c-0642ffb9ec05",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Auch für das Tempotraining mit Strides und Fartleks bei hohen Temperaturen ist der ST-4 wie gemacht.“"
                            },
                            {
                                "example_id": "b897f180-e9ca-4932-b371-99143d98f9ae",
                                "sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
                                "text": "„Entwickelt für Wettkämpfe und Trainings wie Tempoläufe, Fartleks und Strides, setzt der Cyclone 2 Maßstäbe mit neuester Pebax® Zwischensohlen-Technik und einer superleichten Konstruktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6bfaffb-69c5-474c-be25-a8ba9d83cd9f",
                        "source_entry_id": "2fa54795-8b4c-3e5d-9ec5-1de816d67d3b",
                        "source_sense_id": "a68766aa-f4f3-3b6c-b142-e1ab47d75941",
