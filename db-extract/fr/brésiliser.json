                "senses": [
                    {
                        "sense_id": "56fc60cf-758b-3ddc-8af4-97fa102582b3",
                        "entry_id": "2eeab9e5-61eb-3c23-9579-bc3b0202a850",
                        "glosses": [
                            "Donner un caractère brésilien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354d7d4d-22c8-429f-bca0-f7efbc24dc10",
                                "sense_id": "56fc60cf-758b-3ddc-8af4-97fa102582b3",
                                "text": "Certains auteurs comme Mario de Andrade (1893-1945) commencent à « brésiliser » la langue par l'introduction d'éléments tirés du parler quotidien."
                            },
                            {
                                "example_id": "fd52fbad-452e-4ad3-8925-2119410a7a65",
                                "sense_id": "56fc60cf-758b-3ddc-8af4-97fa102582b3",
                                "text": "Les Bleus doivent se \"brésiliser\" s'ils veulent gagner."
                            },
                            {
                                "example_id": "019e34ed-a7a7-4d60-8a8b-aa2ea3b57dcb",
                                "sense_id": "56fc60cf-758b-3ddc-8af4-97fa102582b3",
                                "text": "Il y a bien des années que le royaume, présenté comme un modèle d'ouverture, s'est \"brésilisé\", avec ses enfants de rue, ceux que R. Fisk appelle « des rejetés parmi les pauvres, des sans défense, des orphelins et des exclus, des renifleurs de colle »."
                            }
                        ]
                    }
