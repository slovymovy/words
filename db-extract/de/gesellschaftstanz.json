                "senses": [
                    {
                        "sense_id": "8451d064-02ec-31f3-8d05-097b6ba3bde9",
                        "entry_id": "d51c7187-fd17-39db-813f-49e240b9519f",
                        "glosses": [
                            "Tanz, der „in Gesellschaft“, das heißt entweder privat bei Feiern oder bei entsprechenden öffentlichen Tanzveranstaltungen, wie sogenannten Tanztees oder Bällen, in der Regel von Paaren, getanzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c618d85-8c09-48ca-a993-bb6ce5f52617",
                                "sense_id": "8451d064-02ec-31f3-8d05-097b6ba3bde9",
                                "text": "„\"Machen Sie noch eine Flasche auf.\" Die Band begann zu spielen. Paula stellte sich mit ihrem Glas an den Rand der Tanzfläche und schaute den Paaren zu. Jeder schien zu wissen, was ein Gesellschaftstanz war und wie man ihn ausführte. Vermutlich war das eine Grundvoraussetzung, um überhaupt einen Ball zu besuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
