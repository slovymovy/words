                                "target_senses": [
                                    {
                                        "sense_id": "fe0bbdeb-c16a-351f-9104-8181ff9d4b16",
                                        "entry_id": "2a9f930f-543f-35f0-8dab-9a66ff5a81c3",
                                        "glosses": [
                                            "Einstellung/Haltung, die die Entfaltungsmöglichkeiten des Individuums besonders hervorhebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00804dd-34aa-493b-a19e-c71719a6c6db",
                                                "sense_id": "fe0bbdeb-c16a-351f-9104-8181ff9d4b16",
                                                "text": "„Das Privatauto ist unzeitgemäßer Individualismus.“"
                                            },
                                            {
                                                "example_id": "c11dc503-3704-4595-9756-41ce1df4f647",
                                                "sense_id": "fe0bbdeb-c16a-351f-9104-8181ff9d4b16",
                                                "text": "„Individualismus hingegen führte zum Ableben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8df2345a-a4a5-44b6-a06b-76a62f88ade1",
                        "source_entry_id": "af95d3e4-6034-336c-bc09-95c04bb4d5a3",
                        "target_lang_word": "individualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
