                "senses": [
                    {
                        "sense_id": "cf3aaea5-00e3-396c-93bf-6edf41c8493b",
                        "entry_id": "98ad3304-a146-3863-bb75-38f72b1f9c49",
                        "glosses": [
                            "Matériau composé d'une couche mono-atomique d'atomes de silicium, similaire au graphène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b606a2cf-2fde-412b-acdc-92ac3b5f2b2c",
                                "sense_id": "cf3aaea5-00e3-396c-93bf-6edf41c8493b",
                                "text": "Depuis quelque temps, plusieurs groupes de recherche affirment avoir réussi à synthétiser un équivalent du graphène à base de silicium, le silicène."
                            },
                            {
                                "example_id": "85ea9249-dc70-45a7-9faf-b2bd3a034418",
                                "sense_id": "cf3aaea5-00e3-396c-93bf-6edf41c8493b",
                                "text": "Le silicène a été synthétisé pour la première fois en 2009 par Patrick Vogt, de l'Université technique de Berlin, alors qu'il travaillait pour quelques mois dans mon équipe à Marseille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1453bbd4-2d03-487e-a002-cf37ee954a95",
                        "source_entry_id": "98ad3304-a146-3863-bb75-38f72b1f9c49",
                        "source_sense_id": "cf3aaea5-00e3-396c-93bf-6edf41c8493b",
                        "target_lang_word": "silicene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silicene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5be5be28-3f8e-3d36-9c5f-b775d90a8393",
                                        "entry_id": "e4e2f513-b0c2-3a61-abc6-43a9832ff5e2",
                                        "glosses": [
                                            "A monolayer of silicon atoms packed together to resemble graphene."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f319ce1-1bfe-4edf-9796-db3c0c2b2838",
                                                "sense_id": "5be5be28-3f8e-3d36-9c5f-b775d90a8393",
                                                "text": "Thus, silicene has the same structure as a graphene sheet but it is composed of Si atoms instead of C atoms."
                                            },
                                            {
                                                "example_id": "ab8b05e7-8e98-46f2-8e60-6196fbb831aa",
                                                "sense_id": "5be5be28-3f8e-3d36-9c5f-b775d90a8393",
                                                "text": "However, silicene, the counterpart of graphene for silicon has not been found until now, although it has attracted strong theoretical attention since several years."
                                            },
                                            {
                                                "example_id": "5430e58b-5c01-411a-a284-574b6ee02429",
                                                "sense_id": "5be5be28-3f8e-3d36-9c5f-b775d90a8393",
                                                "text": "The electronic properties of silicene nano-ribbons and silicene sheets were found to resemble those of graphene."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silicene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
