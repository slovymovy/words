                        "glosses": [
                            "das Einüben bei aufführenden Künsten zur späten Tageszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02fca24-cecf-4007-a817-8c3c22c2ebe0",
                                "sense_id": "9f004e7a-b64f-3691-bfe6-b11b309104af",
                                "text": "„Startenor Pavol Breslik, der eigentlich am Nachmittag in der Oper sein sollte, blieb aufgrund des Schneefalles in München drei Stunden lang mit seinem Flieger hängen und schaffte es nur knapp zur Abendprobe.“"
                            },
                            {
                                "example_id": "f4692e12-ed9b-4134-b65f-a915c4c485e8",
                                "sense_id": "9f004e7a-b64f-3691-bfe6-b11b309104af",
                                "text": "Er konnte gestern nicht zur Abendprobe kommen, da er sehr stark verkühlt war."
                            }
                        ],
