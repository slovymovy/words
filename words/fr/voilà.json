                {
                    "sense_id": "cf3f292b-2254-32ea-9236-db4f83b6608f",
                    "sense_definition": "Sert à faire référence à ce qui vient d'être dit ou expliqué, ou à conclure une déclaration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voilà</w> tout ce que nous savons sur cette affaire.",
                            "target_lang_translations": {
                                "en": "<w>That's</w> all we know about this affair.",
                                "ru": "<w>Вот и всё</w>, что нам известно об этом деле.",
                                "nl": "<w>Dat is alles</w> wat we over deze zaak weten.",
                                "de": "<w>Das ist alles</w>, was wir über diese Angelegenheit wissen.",
                                "pl": "<w>Oto</w> wszystko, co wiemy o tej sprawie.",
                                "it": "<w>Ecco</w> tutto quello che sappiamo su questa faccenda.",
                                "cs": "<w>To je všechno</w>, co o té záležitosti víme.",
                                "tr": "Bu dava hakkında bildiğimiz her şey <w>işte</w> bu kadar.",
                                "es": "<w>Eso es</w> todo lo que sabemos sobre este asunto.",
                                "zh": "关于这件事，<w>这就是</w>我们所知道的全部。"
                            }
                        },
                        {
                            "text": "C'est une bonne proposition et <w>voilà</w> pourquoi nous l'acceptons.",
                            "target_lang_translations": {
                                "en": "It is a good proposal, and <w>that's</w> why we accept it.",
                                "ru": "Это хорошее предложение, и <w>вот почему</w> мы его принимаем.",
                                "nl": "Het is een goed voorstel en <w>vandaar dat</w> we het accepteren.",
                                "de": "Es ist ein guter Vorschlag, und <w>deshalb</w> nehmen wir ihn an.",
                                "pl": "To dobra propozycja i <w>dlatego</w> ją przyjmujemy.",
                                "it": "È una buona proposta, <w>ecco</w> perché la accettiamo.",
                                "cs": "Je to dobrý návrh a <w>proto</w> ho přijímáme.",
                                "tr": "Bu iyi bir öneri ve <w>işte</w> bu yüzden onu kabul ediyoruz.",
                                "es": "Es una buena propuesta y <w>por eso</w> la aceptamos.",
                                "zh": "这是个好提议，<w>这就是为什么</w>我们接受它。"
                            }
                        }
                    ],
                    "antonyms": [
                        "voici"
                    ],
                    "common_phrases": [
                        "voilà pourquoi",
                        "voilà tout",
                        "et voilà"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to refer back to what has just been said or explained, or to conclude a statement.",
                        "ru": "Используется для ссылки на только что сказанное или объяснённое либо для завершения высказывания.",
                        "nl": "Verwijst naar wat zojuist is gezegd of uitgelegd, of rondt een uitspraak af.",
                        "de": "Verweist auf etwas eben Gesagtes oder Erklärtes oder schließt eine Aussage ab.",
                        "pl": "Odnosi się do tego, co zostało właśnie powiedziane lub wyjaśnione, albo kończy wypowiedź.",
                        "it": "Serve a richiamare quanto appena detto o spiegato, oppure a concludere un'affermazione.",
                        "cs": "Odkazuje na to, co bylo právě řečeno nebo vysvětleno, nebo uzavírá výpověď.",
                        "tr": "Az önce söylenen ya da açıklanan şeye gönderme yapmak veya bir sözü bitirmek için kullanılır.",
                        "es": "Se usa para referirse a lo que acaba de decirse o explicarse, o para cerrar una afirmación.",
                        "zh": "用于回指刚刚说过或解释过的内容，或用来结束一句话。"
                    },
