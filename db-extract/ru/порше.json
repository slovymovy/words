                                        "sense_id": "856558b8-6749-36e5-b008-f2435b094589",
                                        "entry_id": "444cbe6a-0d71-3a56-8506-f68d8c0e9d5d",
                                        "glosses": [
                                            "deutscher Fahrzeughersteller mit Hauptsitz in Stuttgart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17321d79-f8a9-4753-b885-80ec765c1dd3",
                                                "sense_id": "856558b8-6749-36e5-b008-f2435b094589",
                                                "text": "„Die Affäre um manipulierte Abgaswerte bei Volkswagen weitet sich aus und erfasst nun auch die Konzerntochter Porsche.“"
                                            },
                                            {
                                                "example_id": "92e98909-03a1-404f-a23c-57b0f42b2ddc",
                                                "sense_id": "856558b8-6749-36e5-b008-f2435b094589",
                                                "text": "„Porsche hat ein starkes und unmissverständliches Signal gesetzt, dass rassistische Hetze keine Meinung, keine Dummheit, sondern ein Verbrechen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a970a135-f571-36ea-9839-6ef3bfcd6451",
                                        "entry_id": "444cbe6a-0d71-3a56-8506-f68d8c0e9d5d",
                                        "glosses": [
                                            "Fahrzeug des Fahrzeugherstellers Porsche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb635a1d-fff6-42e7-b5da-08b7a227e8ca",
                                                "sense_id": "a970a135-f571-36ea-9839-6ef3bfcd6451",
                                                "text": "„Er habe sich vor einigen Wochen einen rassigen Wagen, einen Porsche, gekauft.“"
                                            },
                                            {
                                                "example_id": "69a583b9-e2ed-47b5-9af2-4b27c0aab4c8",
                                                "sense_id": "a970a135-f571-36ea-9839-6ef3bfcd6451",
                                                "text": "„Draußen werfen ein paar Besoffene einen Porsche um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
