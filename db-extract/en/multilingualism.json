                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95a6a391-9bcc-4ae4-b66e-c674bbca53f9",
                                                "sense_id": "61cac69e-f1d6-3137-be47-9133709578c4",
                                                "text": "De laatste jaren heeft het concept van de meertaligheid aan belang gewonnen in de door de Raad van Europa gehanteerde benadering van taalleren."
