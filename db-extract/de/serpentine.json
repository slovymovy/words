                        "form": "die Serpentine"
                    },
                    {
                        "form_id": "330fe80f-3dbd-4147-82ec-be7a741df887",
                        "entry_id": "f8783fbe-b023-3ece-b096-d55671d57b13",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Serpentinen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c88cdf14-bfc0-3d7d-a780-8d07b173fc84",
                        "entry_id": "f8783fbe-b023-3ece-b096-d55671d57b13",
                        "glosses": [
                            "Straße oder Weg, in Schlangenlinien einen Berg hinauf oder hinab führend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfdcc540-9035-41b7-b1c8-50e7a0b0c3d5",
                                "sense_id": "c88cdf14-bfc0-3d7d-a780-8d07b173fc84",
                                "text": "„Lastwagen mit dem bunten Haufen aus der Gutleut–Kaserne keuchen die Serpentine hinauf.“"
                            },
                            {
                                "example_id": "f1600bf5-82c4-445d-a225-9ab0ea58c00a",
                                "sense_id": "c88cdf14-bfc0-3d7d-a780-8d07b173fc84",
                                "text": "„Man muss das Lenkrad hier mit beiden Händen drehen, wenn man mit dem Auto die fiesen Serpentinen abfährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                        "entry_id": "f8783fbe-b023-3ece-b096-d55671d57b13",
                        "glosses": [
                            "eine Kurve einer Serpentine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87ebe68a-0f04-435b-8851-a880d653f495",
                                "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                                "text": "Die Straße verläuft erst einen Kilometer geradeaus, dann geht es einige hundert Meter in Serpentinen weiter."
                            },
                            {
                                "example_id": "38e4c15d-e4a4-40f1-aa08-fdd887156cd9",
                                "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                                "text": "„Von nun an ging der Weg in Serpentinen steil nach oben, und wir kamen mit dem schweren Wagen nur noch im Schneckentempo vorwärts.“"
                            },
                            {
                                "example_id": "6095f2a3-1d22-4c06-b434-475bdcbf0527",
                                "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                                "text": "„In Serpentinen schrauben wir uns hinab zur Schlucht des Blauen Nils.“"
                            },
                            {
                                "example_id": "065deedd-1f43-43ff-91b2-da5592cd0f78",
                                "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                                "text": "„Die zahlreichen Serpentinen waren immer wieder in den Kehren, wo sich Wasser sammelte, vereist.“"
                            },
                            {
                                "example_id": "6afd358a-aeb6-4429-9633-c4408c8827c7",
                                "sense_id": "26ff2e5d-5316-3a9e-b85e-eefde5c0cb25",
                                "text": "„Wir fuhren an einen fantastischen Strand auf der anderen Inselseite und hinter drei Reisebussen musste ich mörderische Serpentinen überstehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "819b8e5a-5c8e-4f43-97b5-ba2ff90a56af",
                        "source_entry_id": "f8783fbe-b023-3ece-b096-d55671d57b13",
                        "source_sense_id": "c88cdf14-bfc0-3d7d-a780-8d07b173fc84",
                        "source_sense_description": "Straße oder Weg, in Schlangenlinien einen Berg hinauf oder hinab führend",
                        "target_lang_word": "switchback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "switchback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db5b0cce-2d6d-35cd-9109-ed9ff002238c",
                                        "entry_id": "61713fa9-dadd-314d-8e71-f7f3d8d57e44",
                                        "glosses": [
                                            "A railway track on a steep slope in a zigzag formation, in which a train travels in a reverse direction at each switch."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f9a0d2-4311-44fb-9175-2a35bccf3207",
                                                "sense_id": "db5b0cce-2d6d-35cd-9109-ed9ff002238c",
                                                "text": "\"Of course,\" said Harry, \"there will have to be a branch track built, and a ‘switch-back’ up the hill.\""
                                            },
                                            {
                                                "example_id": "a00740e9-e428-4e75-8e8c-44d345f8b41b",
                                                "sense_id": "db5b0cce-2d6d-35cd-9109-ed9ff002238c",
                                                "text": "Marriage was the switchback, the giant racer, the lobster teas, the guarantee that one would never be alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cce2e3a3-3cc1-3bd6-9fac-913e00f29d8d",
                                        "entry_id": "61713fa9-dadd-314d-8e71-f7f3d8d57e44",
                                        "glosses": [
                                            "A railway track on which there are steep ascents and descents, a train moving partially or fully by the force of gravity using the momentum generated when descending to travel up an ascending part of the track; especially (British, dated), such a track built for fun rides at an amusement park; a type of rollercoaster."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ffb824c-03ee-4f79-94a2-51b5f554398a",
                                                "sense_id": "cce2e3a3-3cc1-3bd6-9fac-913e00f29d8d",
                                                "text": "The WR faction claims that the Westbury route is better adapted to high speed, to which advocates of the SR route are apt to retort that the effect of modern diesel traction on schedules over the Salisbury–Exeter switchback has yet to be measured (the speed potential between Waterloo and Salisbury is scarcely disputable) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464e6554-a83d-3212-bcec-797f162e0085",
                                        "entry_id": "61713fa9-dadd-314d-8e71-f7f3d8d57e44",
                                        "glosses": [
                                            "A flight path consisting of a series of steep ascents and descents, generally flown as a stunt."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5168d8c-009f-3718-bbc0-70aca0823d48",
                                        "entry_id": "61713fa9-dadd-314d-8e71-f7f3d8d57e44",
                                        "glosses": [
                                            "A path or road having a series of steep ascents and descents."
                                        ],
                                        "tags": [
                                            "British",
                                            "attributive",
                                            "broadly",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54a8be39-95c5-4e79-8b8f-1daa1a3efddb",
                                                "sense_id": "f5168d8c-009f-3718-bbc0-70aca0823d48",
                                                "text": "The switchback road to Diabaig - pronounced 'Jer-vague' - passes through some of the most exhilarating scenery in Scotland. […] With a final swoop, the road plummets down into Diabaig, where cottages are dotted across the slopes of a rocky semi-circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341f182d-d533-39c5-a3db-4e20659af1ec",
                                        "entry_id": "61713fa9-dadd-314d-8e71-f7f3d8d57e44",
                                        "glosses": [
                                            "A sharp bend in a path or road which causes a traveller to almost reverse their direction of travel, especially one of a series of such bends on an incline; a hairpin bend; also a path or road having such a series of bends."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "attributive",
                                            "broadly",
                                            "figuratively",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e42731c9-47b9-4508-8e3e-6596c7ca5331",
                                                "sense_id": "341f182d-d533-39c5-a3db-4e20659af1ec",
                                                "text": "Already, we enter some airport bathrooms through a brief switchback of walls, so that we don’t ever grasp a door handle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "switchback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c02fc332-2adf-3912-8a3a-fc1e0a6c205e",
                                        "entry_id": "5cbaedb6-46b5-3b12-9fc9-4d84d9e9b4dc",
                                        "glosses": [
                                            "To take a zigzag course or path."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb5d0a1-9e11-47ec-9f14-d9691250e6d1",
                                                "sense_id": "c02fc332-2adf-3912-8a3a-fc1e0a6c205e",
                                                "text": "I climbed 6,683-foot Velka Svistovka, not the highest mountain in the Tatras but arguably the one with the best view. I started from Zelene pleso chata (pleso means \"lake\" and chata means \"hut\" in Slovak), and right after turning the first corner I started switchbacking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
