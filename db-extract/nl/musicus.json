                                    },
                                    {
                                        "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                        "entry_id": "911751eb-2b42-3d56-91f5-826f2b4e00c4",
                                        "glosses": [
                                            "тот, кто играет на каком-либо музыкальном инструменте (профессионал или любитель)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457ae20f-b2a2-4899-8f49-a817ce23c850",
                                                "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                                "text": ".. толстый господин с букетом провозгласил, что церемониальные танцы кончились, и приказал музыкантам играть менуэт."
                                            },
                                            {
                                                "example_id": "6e133c32-61da-41f7-bfec-d0ef4701024a",
                                                "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                                "text": "[Домна Пантелевна:] Муж-то мой, отец-то её, был музыкант, на флейте играл .."
                                            },
                                            {
                                                "example_id": "bec6a6b3-cbd9-4405-920e-b29b51a84d26",
                                                "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                                "text": "Пока художник и медик кончали кадриль, Васильев, чтобы не глядеть на женщин, осматривал музыкантов. На рояли играл благообразный старик в очках, .. на скрипке — молодой человек с русой бородкой, одетый по последней моде."
                                            },
                                            {
                                                "example_id": "e27be47e-114b-4805-a823-927b0c1e996d",
                                                "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                                "text": "На эстраду, обнесённую цветами, взошли музыканты .."
                                            },
                                            {
                                                "example_id": "0686216d-6c7d-4958-9b2c-f7e23631b192",
                                                "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                                                "text": "Музыканты вытащили из-под подбитых ветром пальто инструменты, и неожиданная и грустная мелодия старомодного романса поплыла над притихшей толпой .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0914bf5-bd17-3a5b-8aa6-89bda3eac7bf",
                                        "entry_id": "911751eb-2b42-3d56-91f5-826f2b4e00c4",
                                        "glosses": [
                                            "книжн. кто-либо, способный издавать мелодичные звуки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb729884-431f-469a-ac4e-c056796455aa",
                                                "sense_id": "b0914bf5-bd17-3a5b-8aa6-89bda3eac7bf",
                                                "text": "По голосу я сначала даже и не принял его за соловья, но потом разглядел и признал в нём пернатого музыканта."
                                            },
                                            {
                                                "example_id": "5602d335-e83d-4f46-b252-b51429cf8a40",
                                                "sense_id": "b0914bf5-bd17-3a5b-8aa6-89bda3eac7bf",
                                                "text": "Мне тоже очень хотелось видеть .. долину под снегом, послушать её тишину без птиц и летних музыкантов — кузнечиков .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "музыкант",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fea30ab8-9086-3a95-97c2-11c790966b52",
                                        "entry_id": "b223fce6-23ba-3aa3-bf97-90d1dfa6012f",
                                        "glosses": [
                                            "крим. жарг. вор"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4c014e1-cf6b-3d9c-b587-8343d8d06c16",
                                        "entry_id": "b223fce6-23ba-3aa3-bf97-90d1dfa6012f",
                                        "glosses": [
                                            "крим. жарг. человек, знающий воровской жаргон"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "музыкант",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "009166b8-eeb9-3ec3-8c07-b04bea06d90b",
                                        "entry_id": "861d08f7-2e51-35b7-b36b-e9260c1aa60a",
                                        "glosses": [
                                            "воен. жарг. то же, что вагнеровец; боец российской частной военной компании «Вагнер»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74350a7e-d950-4b9a-9231-c1601fb123f0",
                                                "sense_id": "009166b8-eeb9-3ec3-8c07-b04bea06d90b",
                                                "text": "Заместитель начальника Главного управления МВД по Запорожской области Алексей Селиванов отметил, что ключевая роль во взятии города принадлежит «музыкантам» из «оркестра» имени немецкого композитора, которые с 2014-го года помогают ЛНР в борьбе с украинским геноцидом русского населения."
                                            },
                                            {
                                                "example_id": "10022d5a-e00f-4353-8b0a-6071cc0e4417",
                                                "sense_id": "009166b8-eeb9-3ec3-8c07-b04bea06d90b",
                                                "text": "«Музыканты» у здания администрации города Попасная. Именно на плечи «оркестра» легла вся тяжесть боёв за этот населённый пункт."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
