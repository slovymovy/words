                                        "sense_id": "5ede5848-f64a-3e98-a905-8fab04fb82fb",
                                        "entry_id": "89457aef-dceb-377f-8f6c-d8023dc578cc",
                                        "glosses": [
                                            "eines der ältesten Antibiotika, hergestellt auf der Basis eines Schimmelpilzes"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97c06f0e-28af-491b-9b16-a6b0bd1020b2",
                                                "sense_id": "5ede5848-f64a-3e98-a905-8fab04fb82fb",
                                                "text": "„Das ‚Wundermedikament‘ Penicillin wurde erstmals während des Zweiten Weltkriegs in großem Maßstab eingesetzt, und man sah eine Zukunft ohne ansteckende Krankheiten voraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9d70b5f-0bd0-400f-9859-2b27487e8dc5",
                        "source_entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "source_sense_description": "antibiotic",
                        "target_lang_word": "Penizillin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Penizillin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                        "entry_id": "954e36e3-c7a8-3235-b984-6b32db313fe4",
                                        "glosses": [
                                            "eines der ältesten Antibiotika, hergestellt auf der Basis eines Schimmelpilzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d8e886-e2f8-45c9-9d76-4eb128cbadce",
                                                "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                                "text": "„Den keimtötenden Wirkstoff nannte er nach dem Pilz Penicillium notatum schlicht Penizillin. “"
                                            },
                                            {
                                                "example_id": "0b1678cc-d993-4356-b94a-dc3ad24a1a4e",
                                                "sense_id": "5a8c2022-c52c-3e49-8ec7-0eb78da6ae7b",
                                                "text": "„In Zeiten der Syphilis hat man andere Ängste als in Zeiten des Penizillins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
