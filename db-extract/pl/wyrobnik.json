                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nádeník",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ca75463b-a5b6-3c0b-9d84-6c65cb0887eb",
                                        "entry_id": "ecb41106-f8ce-3845-90d0-1c70fbf15a30",
                                        "glosses": [
                                            "(pomocný) dělník najímaný na jeden den, popř. vyplácený každý den"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd6f111-1c9f-4313-810e-74a346f0a02a",
                                                "sense_id": "ca75463b-a5b6-3c0b-9d84-6c65cb0887eb",
                                                "text": "Za kotelnou jezdí nádeníci s kolečkem cihel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "792858b4-8e91-4de8-80ae-33854396d093",
                        "source_entry_id": "8261e459-ca7d-3f55-a576-206e16f897a7",
                        "source_sense_id": "f54f5176-2eb5-3acd-b34e-7aaf5f88231d",
                        "target_lang_word": "Lohnarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lohnarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                                        "entry_id": "e5cfbb25-1336-3946-9c59-b45db6ee18ba",
                                        "glosses": [
                                            "Arbeiter, der einer Lohnarbeit nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a809130d-236a-42c6-bda0-e5dcc998b9a7",
                                                "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                                                "text": "„Nach Hal Draper bildet das industrielle Proletariat den Kern der Arbeiterklasse, danach kommt das nicht-industrielle Proletariat, also die Lohnarbeiter im Bereich der Dienstleistungen und der Landwirtschaft.“"
                                            },
                                            {
                                                "example_id": "b1e0b20b-94fc-4259-aacd-c2829eb4d417",
                                                "sense_id": "af2a221f-c3ec-3b60-bffd-6831b545f051",
                                                "text": "„Geldhäuser wie das der Fugger stiegen zu Montanunternehmen und dann zu Montanmonopolisten auf, während die in Eigenregie schürfenden und hüttenden Bergwerkler zu Lohnarbeitern absanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb62fe7-724f-42e6-a203-3d1e8d887135",
                        "source_entry_id": "8261e459-ca7d-3f55-a576-206e16f897a7",
                        "source_sense_id": "f54f5176-2eb5-3acd-b34e-7aaf5f88231d",
                        "target_lang_word": "Tagelöhner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagelöhner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                        "entry_id": "c7d19423-2899-3622-9957-76ce24f34b9b",
                                        "glosses": [
                                            "Arbeiter ohne festes Arbeitsverhältnis, der täglich seinen Lohn erhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef4eba36-3fb2-4325-a5bd-299b36669336",
                                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                                "text": "„Deshalb brüste ich mich stets damit, daß ich eine Zeit meines Lebens Tagelöhner war.“"
                                            },
                                            {
                                                "example_id": "0fed572a-0319-4345-a1c6-d18b27a243c7",
                                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                                "text": "„Die Entlassungen betrafen sowohl Tagelöhner und angelernte Arbeiter als auch besser bezahltes, ausgebildetes Personal.“"
                                            },
                                            {
                                                "example_id": "bb62b208-bbcb-4a18-859f-0202b3c47671",
                                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                                "text": "„Hier also ackerten geflüchtete Tagelöhner ohne Schutzkleidung unter den Plastikbergen und spritzen Fungizide und Insektizide auf die zarten Pflanzen, die dann mit EU-Gütesiegel auf unseren Tellern landeten.“"
                                            },
                                            {
                                                "example_id": "96149040-bc9e-4ca0-a718-49c104d2835f",
                                                "sense_id": "991a2381-bf9b-393d-839c-dd6f028f3575",
                                                "text": "„Am Anfang jeden Monats gab er ihr pflichtbewusst einen Teil des Geldes, das er als Tagelöhner auf dem Bau verdiente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
