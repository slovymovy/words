                            }
                        },
                        {
                            "text": "U ontvangt een vergoeding van <w>zegge</w> honderd euro.",
                            "target_lang_translations": {
                                "ru": "Вы получите компенсацию в размере <w>ровно</w> ста евро.",
                                "en": "You will receive a compensation of <w>namely</w> one hundred euros."
