                                    },
                                    {
                                        "sense_id": "4b3ee03d-4b83-3033-8567-146e3b56ad1a",
                                        "entry_id": "06d61b11-fd36-3d52-894e-e80a0928b1c1",
                                        "glosses": [
                                            "To exercise reason; to employ the mind in judging and inferring; to reason."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f73ecf4-540e-4799-9e06-39df0b3ee32b",
                                                "sense_id": "4b3ee03d-4b83-3033-8567-146e3b56ad1a",
                                                "text": "While he discours'd on heaven's mysterious\nThe world's original, and nature's cause"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0f2e95-cc35-3a1d-a7ae-e7232699f40a",
                                        "entry_id": "06d61b11-fd36-3d52-894e-e80a0928b1c1",
                                        "glosses": [
                                            "To produce or emit (musical sounds)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d85ba4b-d179-4139-a230-f8a66b63af3f",
                                                "sense_id": "dc0f2e95-cc35-3a1d-a7ae-e7232699f40a",
                                                "text": "Hamlet. […] Will you play upon this pipe? […] It is as easy as lying. Govern these ventages with your fingers and thumbs, give it breath with your mouth, and it will discourse most eloquent music."
                                            },
                                            {
                                                "example_id": "605cc57d-2bda-4148-a5f6-bad919667b9f",
                                                "sense_id": "dc0f2e95-cc35-3a1d-a7ae-e7232699f40a",
                                                "text": "Music discoursed on that melodious instrument, a Jew's harp, keeps the elfin women away from the hunter, because the tongue of the instrument is of steel."
                                            },
                                            {
                                                "example_id": "6d981dbe-2fa7-4175-8e4e-91e714e0eb84",
                                                "sense_id": "dc0f2e95-cc35-3a1d-a7ae-e7232699f40a",
                                                "text": "Dahl's Silver Cornet Band, augmented for the occasion to the grand total of fourteen pieces, discoursed sweet—well, discoursed music; let us not be too particular as to the quality of it."
                                            }
                                        ]
                                    }
                                ]
