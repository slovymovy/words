                ],
                "senses": [
                    {
                        "sense_id": "4eceed16-2c8a-3a8c-922d-0169f1e5dd2d",
                        "entry_id": "f931b5a1-a16b-3043-a93d-740200890000",
                        "glosses": [
                            "für den Frühling typisches Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10f6195-8147-498d-82f0-9d339375511e",
                                "sense_id": "4eceed16-2c8a-3a8c-922d-0169f1e5dd2d",
                                "text": "„Der Wintereinbruch, der enorme Schäden verursacht und manchen Rekord aufgestellt hat, geht zu Ende. Beständiges Frühlingswetter ist dennoch nicht in Sicht.“"
                            },
                            {
                                "example_id": "875ef01b-a51b-4e59-8d79-b7febacc2db5",
                                "sense_id": "4eceed16-2c8a-3a8c-922d-0169f1e5dd2d",
                                "text": "„Trotz des sonnigen Frühlingswetters lag über dem Arbeiterviertel eine explosive Stimmung.“"
                            },
                            {
                                "example_id": "df8de1d1-6786-4482-8bbe-33b0295a448e",
                                "sense_id": "4eceed16-2c8a-3a8c-922d-0169f1e5dd2d",
                                "text": "„Sie wurde krank, nachdem der Vater sie gegen Hallas Willen in kaltem Frühlingswetter, das am Nachmittag in Schneeregen und strengen, kalten Nordwind überging, auf einen Ausflug in dienstlichen Angelegenheiten mitgenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
