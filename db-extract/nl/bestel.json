                "senses": [
                    {
                        "sense_id": "745e50fc-bb81-3833-8b90-3da50becead2",
                        "entry_id": "c2dad332-3665-3f71-8592-3205deb2fe38",
                        "glosses": [
                            "een organisatie die als systeem een bepaald doel op een bepaalde manier dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6904c17a-4712-4d36-afcf-f3a29f25a328",
                                "sense_id": "745e50fc-bb81-3833-8b90-3da50becead2",
