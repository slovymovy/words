                        "sense_id": "ea171ceb-a4d5-3f5d-9e9b-a96dfe13d989",
                        "entry_id": "57e36760-a892-3e1b-bc18-dcbeda06b8a5",
                        "glosses": [
                            "Différence négative entre le cours à terme d’un actif et son cours au comptant."
