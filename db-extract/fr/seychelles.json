                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "466c98f0-c7e0-3875-b9db-e62477828e8f",
                                        "entry_id": "b1b1d83f-c4c3-3888-8640-1512a1d13670",
                                        "glosses": [
                                            "Inselgruppe im Indischen Ozean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73be812c-d377-4084-98e6-264e66e022a8",
                                                "sense_id": "466c98f0-c7e0-3875-b9db-e62477828e8f",
                                                "text": "„Die Inselgruppe der Seychellen, 1.600 km östlich von Kenia und nördlich von Madagaskar, ist Ausgangspunkt unserer Reise durch den Indischen Ozean.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d76765a-5c35-35cb-84f2-6fe9d7fad5c1",
                                        "entry_id": "b1b1d83f-c4c3-3888-8640-1512a1d13670",
                                        "glosses": [
                                            "aus dieser Inselgruppe bestehender Staat im Indischen Ozean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b707d6-236c-4743-9d85-f713be06a897",
                                                "sense_id": "9d76765a-5c35-35cb-84f2-6fe9d7fad5c1",
                                                "text": "Victoria ist die Hauptstadt der Seychellen."
                                            },
                                            {
                                                "example_id": "849c8657-e4c7-4481-890b-691b5e7aeb7e",
                                                "sense_id": "9d76765a-5c35-35cb-84f2-6fe9d7fad5c1",
                                                "text": "„Das Staatsoberhaupt ist in den Seychellen gleichzeitig auch der Regierungschef und setzt die Richter der zwei höchsten Gerichte ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
