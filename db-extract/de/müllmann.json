                                "target_senses": [
                                    {
                                        "sense_id": "03fd30e3-8cf6-3b73-8f29-f23c843a63a4",
                                        "entry_id": "5f985192-af08-33f4-ac99-d83d278f03f2",
                                        "glosses": [
                                            "A man with the job of collecting refuse from people's homes and transporting it to a refuse tip for processing."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c702de5a-da5c-471c-82d8-573421e2214c",
                                                "sense_id": "03fd30e3-8cf6-3b73-8f29-f23c843a63a4",
                                                "text": "Back then, in an unspecified period between 1950 and 1980, the binmen were stronger, more hardworking and more polite."
                                            }
                                        ]
