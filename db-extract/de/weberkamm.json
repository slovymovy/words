                                            {
                                                "example_id": "7f5717c4-5f1f-4082-8cfa-aa07fa4c67c2",
                                                "sense_id": "ac39ebae-3dfc-3149-87a1-77941bbc8e65",
                                                "text": "steadily mounting losses"
                                            },
                                            {
                                                "example_id": "4799591b-5f8f-4dd6-aba3-2a4a6415eb62",
                                                "sense_id": "ac39ebae-3dfc-3149-87a1-77941bbc8e65",
                                                "text": "The pupils display great eagerness for knowledge and facility of acquisition. […] No severity of discipline is used or required; the threat of expulsion from the privileges of instruction being sufficient to tame the most mounting spirit."
                                            },
                                            {
                                                "example_id": "b92d29ca-9a94-4c44-a684-b16b130b66f8",
                                                "sense_id": "ac39ebae-3dfc-3149-87a1-77941bbc8e65",
                                                "text": "About three or four minutes later still an express freight on the up main line ran into the wreckage at about 35 m.p.h. Its engine also overturned and 15 more wagons were added to the mounting pile of wreckage."
                                            }
                                        ]
                                    }
