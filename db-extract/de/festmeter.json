                "senses": [
                    {
                        "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                        "entry_id": "d1114ee7-f9f4-3e48-b68c-15e56f0a7f1d",
                        "glosses": [
                            "Raummaß für ein Kubikmeter (m³) fester Holzmasse gefällter Bäume"
                        ],
                        "tags": [
                            "Holzwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "a4220b2f-eb23-4864-b73d-9a2e3cfead71",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Wird ein Kubikmeter Holz ohne Hohlräume gestapelt, handelt es sich um einen Festmeter (Fm)."
                            },
                            {
                                "example_id": "353515b6-e3c5-491e-b497-29829e4883d2",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Denn je nachdem, ob es sich um Weich- oder Hartholz handelt und abhängig von der Maßeinheit bekommen sie unterschiedliche Mengenangaben: So entspricht 1,0 Raummeter das harten Buchenholzes mit 33 Zentimetern Scheitlänge 1,48 Schüttraummetern oder 0,62 Festmetern."
                            },
                            {
                                "example_id": "e35d9bc4-5b03-46c9-b57a-dd4c207966f0",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Österreichs Forstwirte beklagen niedrige Holzpreise, mit 75 Euro für einen Festmeter Fichten-Sägerundholz bewege man sich am unteren Rand des Preisbandes."
                            },
                            {
                                "example_id": "e017d99d-eee0-43db-981d-334a42778de9",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Der Preis für Nadelsägerundholz lag laut dem Verband im Jahr 2016 bei rund 89 Euro pro Festmeter und damit um 2,8 Prozent niedriger als im Jahr davor."
                            },
                            {
                                "example_id": "e78f4130-2acd-407d-8d3e-3223603d7ac1",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Die Schadholzmenge durch Borkenkäferbefall blieb 2016 unverändert bei 2,6 Millionen Festmeter."
                            },
                            {
                                "example_id": "f1d541a0-82ee-486b-ad70-cbfda4995595",
                                "sense_id": "29721adb-beef-31e5-a5ab-64e2fa7ba5ad",
                                "text": "Die Sägerei erreicht die Eigenwirtschaftlichkeit nach rund zwei Jahren bei einer Verarbeitungsmenge von 600 000 Festmetern Holz, und die maximale Kapazität ist auf 1 Million Festmeter ausgelegt (ab 2010)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
