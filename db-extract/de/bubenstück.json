                "senses": [
                    {
                        "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                        "entry_id": "7c74e77f-58f2-3149-9805-5885610f7077",
                        "glosses": [
                            "raffiniert eingefädelte und durchgeführte dreiste schelmische Aktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f1ccf2-ee9f-49dd-a6f9-70682d4e5f22",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Das gelungene Bubenstück hätte ihm eine erhebliche Aufmerksamkeit gesichert und einen gewaltigen Ansehensschub verschafft.“"
                            },
                            {
                                "example_id": "1b00de0d-cc1b-49b9-93f3-ca53c794bf14",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Zuzutrauen wäre den feurigen Südländern ein solches Bubenstück schon.“"
                            },
                            {
                                "example_id": "e6a6c03a-0957-4391-9044-227a91b9fc5b",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Über fünf Jahre liegt die Barschel-Affäre zurück – das schlimmste politische Bubenstück der westdeutschen Nachkriegsgeschichte.“"
                            },
                            {
                                "example_id": "0e0e8cac-c795-4e46-8c75-d41d4fd68371",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                            },
                            {
                                "example_id": "477c18d6-551c-4358-84de-80e003512cd9",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Von der Öffentlichkeit unbemerkt, läuft gerade ein unglaubliches Bubenstück in der EU-Gesetzgebung betreffs europaweiter Dienstzeitregelungen für Piloten ab.“"
                            },
                            {
                                "example_id": "8c73bcda-2ed9-45ea-8d1a-27219d54eaae",
                                "sense_id": "bae3af6f-cb46-3800-a00b-70fb658e3b56",
                                "text": "„Die Arbeit der ostdeutschen Meisterspione wird nicht bestraft, ihre Bubenstücke schon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
