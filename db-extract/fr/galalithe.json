        "fr-extract.jsonl": [
            {
                "entry_id": "eb0128ee-85fc-37cb-a881-0386c4ec200a",
                "word": "galalithe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "83593e85-872f-4fc7-876b-9df66f172f5f",
                        "entry_id": "eb0128ee-85fc-37cb-a881-0386c4ec200a",
                        "tags": [
                            "plural"
                        ],
                        "form": "galalithes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fabd0927-e54f-38fc-bfca-2582b8a5b5ab",
                        "entry_id": "eb0128ee-85fc-37cb-a881-0386c4ec200a",
                        "glosses": [
                            "Première matière plastique, obtenue (1879) à partir de la caséine traitée par le formol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ada6e13-652f-471b-966b-1dbd9159ad74",
                                "sense_id": "fabd0927-e54f-38fc-bfca-2582b8a5b5ab",
                                "text": "Jamais un livre de bord ne parlera du squelette poli comme un bibelot de galalithe remonté un soir à la lueur des falots, des profondeurs moites d'un navire."
                            },
                            {
                                "example_id": "d3d86ac9-cbee-4f17-92e3-bd731032df78",
                                "sense_id": "fabd0927-e54f-38fc-bfca-2582b8a5b5ab",
                                "text": "Je m’assis au bureau de mon grand-père, posai le carnet sur le buvard de son sous-main, pris son porte-plume à manche de galalithe, le plongeai dans la bouteille d’encre rouge et me mis à écrire pendant que les grandes personnes échangeaient des regards amusés."
                            },
                            {
                                "example_id": "cd50dca6-0043-4e19-a870-3efd9c53e768",
                                "sense_id": "fabd0927-e54f-38fc-bfca-2582b8a5b5ab",
                                "text": "L’urine de cheval fournit aussi des porte-plume en galalithe et de petits fromages de brebis qui seraient même peut-être plus crémeux, en certain sens, que les fromages de paraffine. Bref, on ne peut arrêter le progrès."
                            },
                            {
                                "example_id": "79b680b2-581a-470b-8913-f246ffa3ee1e",
                                "sense_id": "fabd0927-e54f-38fc-bfca-2582b8a5b5ab",
                                "text": "Un peu plus tardivement on a pu voir certaines grosses entreprises fabriquer leur propre galalithe et la travailler avant qu’elle ne durcisse totalement."
                            }
                        ]
                    }
                ],
