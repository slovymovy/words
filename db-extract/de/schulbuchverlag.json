                "senses": [
                    {
                        "sense_id": "abe82bff-2108-3bda-b5a4-712f2f45f1dd",
                        "entry_id": "fab09c97-dd48-3e46-a210-4035e2a3d200",
                        "glosses": [
                            "Verlag für Bücher (und anderer Medien), die von Schülern zum Lernen benutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803f0171-c968-4ea0-8ada-980273850d63",
                                "sense_id": "abe82bff-2108-3bda-b5a4-712f2f45f1dd",
                                "text": "„Den Schulbuchverlagen empfehlen die Wissenschaftler, ihre Redakteure gezielt zu sensibilisieren und sie regelmäßig weiterzubilden.“"
                            },
                            {
                                "example_id": "2ba8ef68-1a7e-4c89-8a92-10faa1e6ccd0",
                                "sense_id": "abe82bff-2108-3bda-b5a4-712f2f45f1dd",
                                "text": "„Die Eldriede will ihre Methode unbedingt in einem Schulbuchverlag veröffentlichen, um damit das Geld zu verdienen, mit dem sie sich an der Praxis des Diplon-Pädagogen beteiligen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
