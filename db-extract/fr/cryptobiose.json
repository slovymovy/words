                "senses": [
                    {
                        "sense_id": "bbdeffe6-0b1f-3afc-99d8-508fbb0af619",
                        "entry_id": "65d40911-41d2-32e4-ace5-65505941d2ca",
                        "glosses": [
                            "État complètement arrêté du métabolisme (tout du moins non-mesurable avec les techniques actuelles) d’un organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f73c5d-5423-4c63-b52b-b3a2d65e8b46",
                                "sense_id": "bbdeffe6-0b1f-3afc-99d8-508fbb0af619",
                                "text": "Les œufs normalement hydratés du deuxième type entrent en cryptobiose dans la période qui précède le retournement et éclosent de 36 à 95 jours plus tard (35 °C)."
                            },
                            {
                                "example_id": "d4ca9e12-baec-49bb-9248-473e5c0315be",
                                "sense_id": "bbdeffe6-0b1f-3afc-99d8-508fbb0af619",
                                "text": "Cet état appelé cryptobiose persiste jusqu’à ce que les conditions redeviennent favorables."
                            }
                        ]
                    }
                ],
