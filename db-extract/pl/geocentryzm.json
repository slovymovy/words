                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géocentrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                                        "entry_id": "edabfe26-a083-339e-9237-1ea63a17ac37",
                                        "glosses": [
                                            "Conception du monde plaçant la Terre au centre de l’univers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c47412e-9de1-4e16-9feb-22e5e1be5da3",
                                                "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                                                "text": "Le long et difficile détachement du géocentrisme, fixé par Ptolémée et associé à la physique qualitative d’Aristote, ne peut être réduit à un simple affrontement entre l’évidence des faits et le dogmatisme aveugle de l’Église."
                                            },
                                            {
                                                "example_id": "05391f95-b49e-486f-b0a4-f5db1592d1ff",
                                                "sense_id": "9a3346d5-4fe5-3bde-bd0e-4f857a0ad528",
                                                "text": "Si la connaissance du mouvement des planètes n’avait eu comme protocole de légitimation que le suffrage, nous en serions certainement encore au géocentrisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
