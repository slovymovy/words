                    }
                ],
                "senses": [
                    {
                        "sense_id": "23f00548-2af0-33ec-8f04-a5f65261d849",
                        "entry_id": "0f0f4d65-1987-3937-8823-5fac7c12fda3",
                        "glosses": [
                            "het accepteren, het geaccepteerd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab282e5-76be-4271-aecb-dd8c1a58a3e3",
                                "sense_id": "23f00548-2af0-33ec-8f04-a5f65261d849",
                                "text": "Juffrouw Banetti, die ook voor het landleven was gekomen, had het ook zomaar kunnen zeggen, maar dan had het wel stom geklonken. Maar Olive was anders, haar gedachteloze vastberadenheid en haar acceptatie van Teresa waren zo oprecht dat Teresa het meisje niet alleen haar gril vergaf, maar het zelfs prachtig vond dat schoenen haar niets konden schelen."
                            },
                            {
                                "example_id": "d3a3cbd8-677b-4366-b1da-c2210a97d3e0",
                                "sense_id": "23f00548-2af0-33ec-8f04-a5f65261d849",
                                "text": "Sommigen doen alles voor acceptatie door anderen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "414f3d81-b6d3-4598-a71e-c8df99529680",
                        "source_entry_id": "0f0f4d65-1987-3937-8823-5fac7c12fda3",
                        "source_sense_id": "23f00548-2af0-33ec-8f04-a5f65261d849",
                        "target_lang_word": "acceptation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acceptation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                        "entry_id": "1b0c3021-ee67-3fdf-bb3c-726c3682c067",
                                        "glosses": [
                                            "The meaning (sense) in which a word or expression is understood, or generally received."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f499218d-0cc3-4c03-bdd6-b33149e336c3",
                                                "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                                "text": "The term is to be used according to its usual acceptation."
                                            },
                                            {
                                                "example_id": "e5eca024-fc84-42e7-8654-7ec39cdec8f0",
                                                "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                                "text": "My words, in common Acceptation, / Could never give this Provocation"
                                            },
                                            {
                                                "example_id": "695f816e-7794-4f0b-a555-cade186bfa86",
                                                "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                                "text": "In its most proper acceptation, theory means the completed result of philosophical induction from experience."
                                            },
                                            {
                                                "example_id": "54d4228f-4abc-4f79-899e-6a625cd4d527",
                                                "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                                "text": "Farce, indeed, is a term which has been used by literary historians in two rather different shades of meaning. In one acceptation, derived from its use as applied to Maître Pathelin and other examples of fiteenth-century French dramatic humour, it does not so much connote something other than comedy, as a variety of comedy itself. It is a matter of temper and milieu."
                                            },
                                            {
                                                "example_id": "97b7ea82-b201-4859-9cfc-ee08b5931a70",
                                                "sense_id": "235a6812-2bc2-36de-9760-d128440e4b15",
                                                "text": "Sn may in the latter case designate the uncle, the cousin, or the nephew. None of these scholars, however, has dealt extensively with the third and largest acceptation of the word sn, namely its metaphorical one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bce824e-1681-3097-a732-ddbb4e82435c",
                                        "entry_id": "1b0c3021-ee67-3fdf-bb3c-726c3682c067",
                                        "glosses": [
                                            "Acceptance; reception; favorable reception or regard; the state of being acceptable."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42e0209b-9e23-426a-a5f1-b8571c5dc650",
                                                "sense_id": "2bce824e-1681-3097-a732-ddbb4e82435c",
                                                "text": "Finally, ſome things although not ſo required of neceſſity, that to leave them undone excludeth from Salvation, are notwithſtanding of so great dignity and acceptation with God, that moſt ample reward in Heaven is laid up for them."
                                            },
                                            {
                                                "example_id": "34e32653-d2bb-4024-bd7e-6f7ee79835a4",
                                                "sense_id": "2bce824e-1681-3097-a732-ddbb4e82435c",
                                                "text": "This is a faithful saying, and worthy of all acceptation, that Christ Jesus came into the world to save sinners; of whom I am chief."
                                            },
                                            {
                                                "example_id": "8c7d319b-3818-4b0c-af37-388005fed824",
                                                "sense_id": "2bce824e-1681-3097-a732-ddbb4e82435c",
                                                "text": "The acceptation of the anti-hegemony clause – President Carter in May 1978 had encouraged the Japanese to agree to it – compelled the Japanese government to confess publicly what everybody knew: omnidirectional diplomacy notwithstanding, Japan was more favourably disposed towards China than the Soviet Union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31016d06-0c8f-370e-9bdc-7243e2d86f34",
                                        "entry_id": "1b0c3021-ee67-3fdf-bb3c-726c3682c067",
                                        "glosses": [
                                            "The active divine decision to approve an act or circumstance, held by Scotists to be necessary to render it meritorious."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "828acf25-6509-49a0-b481-962fa672ef26",
                                                "sense_id": "31016d06-0c8f-370e-9bdc-7243e2d86f34",
                                                "text": "This does not, however, mean that the habit of created charity may be regarded as the formal cause of divine acceptation, considered from the standpoint of the one who elicits the act of acceptation (i.e., God), as this must be regarded as lying within the divine will itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac1e3d94-1fe2-445d-bf76-438ae4168b1b",
                        "source_entry_id": "0f0f4d65-1987-3937-8823-5fac7c12fda3",
                        "source_sense_id": "23f00548-2af0-33ec-8f04-a5f65261d849",
                        "target_lang_word": "acceptance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acceptance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The act of accepting; the receiving of something offered, with acquiescence, approbation, or satisfaction; especially, favourable reception; approval."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d196254b-13ae-4757-a610-398136a33157",
                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "the acceptance of a gift, office, doctrine, etc."
                                            },
                                            {
                                                "example_id": "6b323343-5e92-4142-bf8b-4e3ed98b6375",
                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "All the flockes of Kedar shall be gathered together vnto thee, the rams of Nebaioth shall minister vnto thee: they shall come vp with acceptance on mine altar, and I wil glorifie the house of my glory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b8e078d-a81d-31e9-b168-c15e371c20ed",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An instance of that act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73216d6a-e648-3793-9b1a-705de3a36558",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "Belief in something; agreement, assent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "089c969d-9895-30a3-ab08-3448943238b0",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The state of being accepted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277671ca-aba6-46d3-a0a9-0807e1176d68",
                                                "sense_id": "089c969d-9895-30a3-ab08-3448943238b0",
                                                "text": "The warrant I haue of your Honourable Diſpoſition, not the Worth of my vntutor'd Lines makes it aſſured of acceptance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5605821-3c96-3b2d-8d48-4c1c58d61198",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The usual or accepted meaning of a word or expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48c673c0-1322-3fbf-be2a-991444445112",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An assent and engagement by the person on whom a bill of exchange is drawn, to pay it when due according to the terms of the acceptance; the bill of exchange itself when accepted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73815f9c-66fb-32ca-8aa8-51ebe92d5e25",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "An agreeing to the action, proposals, or terms of another by some act which results in the conclusion of a legally binding contract; the reception or taking of a thing bought as that for which it was bought, or as that agreed to be delivered, or the taking of possession of a thing as owner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebe383e-2e82-4746-91e8-1f33532fef29",
                                                "sense_id": "73815f9c-66fb-32ca-8aa8-51ebe92d5e25",
                                                "text": "But what acts shall amount to such an acceptance is often a question of great nicety and difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df8b1be-8799-3486-981e-c4ee77e7feef",
                                        "entry_id": "d629bcf6-798c-3fed-9048-de94c9e2e379",
                                        "glosses": [
                                            "The act of an authorized representative of the government by which the government assents to ownership of existing and identified supplies, or approves specific services rendered, as partial or complete performance of a contract."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
