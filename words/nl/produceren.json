    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe9df9e3-6975-3a7d-83a5-94e43d38d246",
                    "sense_definition": "het op grote schaal of voortdurend maken of vervaardigen van goederen of producten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervaardigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze fabriek kan per dag duizenden auto's <w>produceren</w>.",
                            "target_lang_translations": {
                                "en": "This factory can <w>produce</w> thousands of cars per day.",
                                "ru": "Этот завод может <w>производить</w> тысячи автомобилей в день."
                            }
                        },
                        {
                            "text": "Het is belangrijk om op een duurzame manier goederen te <w>produceren</w>.",
                            "target_lang_translations": {
                                "en": "It is important to <w>produce</w> goods in a sustainable way.",
                                "ru": "Важно <w>производить</w> товары экологически устойчивым способом."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortbrengen",
                        "maken"
                    ],
                    "antonyms": [
                        "consumeren"
                    ],
                    "common_phrases": [
                        "duurzaam produceren",
                        "efficiënt produceren",
                        "op grote schaal produceren"
                    ],
                    "target_lang_definitions": {
                        "en": "the large-scale or continuous making or manufacturing of goods or products",
                        "ru": "крупномасштабное или непрерывное изготовление или производство товаров или изделий"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "produce",
                                "target_lang_sense_clarification": "to manufacture or generate goods"
                            },
                            {
                                "target_lang_word": "manufacture",
                                "target_lang_sense_clarification": "to make on a large scale using machinery"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "general term for creating or constructing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "производить",
                                "target_lang_sense_clarification": "изготавливать товары в промышленных масштабах"
                            },
                            {
                                "target_lang_word": "изготавливать",
                                "target_lang_sense_clarification": "делать что-либо, часто с использованием оборудования"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "создавать готовую продукцию для продажи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1c36573-bda5-3824-9d10-42eca78cd45e",
                    "sense_definition": "iets tot stand brengen of creëren, vaak in een artistieke of creatieve context",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bekende regisseur gaat volgend jaar een nieuwe film <w>produceren</w>.",
                            "target_lang_translations": {
                                "en": "The well-known director is going to <w>produce</w> a new film next year.",
                                "ru": "Известный режиссер собирается <w>продюсировать</w> новый фильм в следующем году."
                            }
                        },
                        {
                            "text": "Zij <w>produceert</w> prachtige muziek in haar eigen studio.",
                            "target_lang_translations": {
                                "en": "She <w>produces</w> beautiful music in her own studio.",
                                "ru": "Она <w>создает</w> прекрасную музыку в своей собственной студии."
                            }
                        }
                    ],
                    "synonyms": [
                        "maken",
                        "voortbrengen"
                    ],
                    "common_phrases": [
                        "een film produceren",
                        "muziek produceren"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring something into existence or create it, often in an artistic or creative context",
                        "ru": "создание чего-либо, часто в художественном или творческом контексте"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "produce",
                                "target_lang_sense_clarification": "to oversee the making of a film, record, or play"
                            },
                            {
                                "target_lang_word": "create",
                                "target_lang_sense_clarification": "to bring something into existence through artistic effort"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to create or compose something like music"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "продюсировать",
                                "target_lang_sense_clarification": "организовывать создание фильма или музыкального альбома"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "вызывать к жизни творческий продукт"
                            },
                            {
                                "target_lang_word": "писать",
                                "target_lang_sense_clarification": "сочинять музыку или тексты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}