                ],
                "senses": [
                    {
                        "sense_id": "bf90219f-3144-34a0-94da-62068d990130",
                        "entry_id": "7cc6773b-52c6-3f71-9fd4-5f63d5b58328",
                        "glosses": [
                            "Dire des bêtises, des frivolités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5a6547-92a8-4c54-b4cf-d848bbd3dce1",
                                "sense_id": "bf90219f-3144-34a0-94da-62068d990130",
                                "text": "Lui, férocement galant, frivolait : Je vous en supplie, relevez-vous."
                            }
                        ]
                    },
                    {
                        "sense_id": "38d90ef5-730f-3013-8819-9e74ccf2c35f",
                        "entry_id": "7cc6773b-52c6-3f71-9fd4-5f63d5b58328",
                        "glosses": [
                            "Voleter avec légèreté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68690a8-46e3-4e93-b99e-d1b06d5c4ab9",
                                "sense_id": "38d90ef5-730f-3013-8819-9e74ccf2c35f",
                                "text": "Un souffle délicieux court, vole et frivole au-dessus des grands damiers de poudre blanche que limitent et protègent, contre la morsure de l’eau et du vent, des rangées de pieux et de brise-lames, rejoints et serrés, comme dans les estampes d’Hokusaï."
                            },
                            {
                                "example_id": "84cd7a2e-87f1-4655-8188-fe8477eda76f",
                                "sense_id": "38d90ef5-730f-3013-8819-9e74ccf2c35f",
                                "text": "Elles frivolent partout, elles chichitent dans tous les coins, mes mains."
                            },
                            {
                                "example_id": "e492972d-ca36-45f2-b4ce-3a8d6350c08c",
                                "sense_id": "38d90ef5-730f-3013-8819-9e74ccf2c35f",
                                "text": "Ensuite, le vent tomba tout plat avec seulement, parfois, une risée follette qui frivolait dans les roseaux."
                            }
                        ]
                    }
                ],
