                                "example_id": "a381e332-5b90-470e-87ab-0ea1cee27943",
                                "sense_id": "afe0b0fa-7f86-3bb2-a315-9d2bc0eb6f4f",
                                "text": "Le badin Marot, le poète de cour, le goguenard, n’est donc pas seulement le réintroducteur de genres latins en français, un grand satirique, un épistolier hors du commun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e07b90-a6bc-4924-b9a7-d7adb9e7acb0",
                        "source_entry_id": "95bac3b1-35e6-3c7a-921e-51b8b9b76719",
                        "source_sense_id": "afe0b0fa-7f86-3bb2-a315-9d2bc0eb6f4f",
                        "target_lang_word": "Spaßmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spaßmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d11fb3a5-34c4-3c96-a8ee-fa9956b00505",
                                        "entry_id": "03190253-0569-3c90-bbba-d0defbd26251",
                                        "glosses": [
                                            "jemand, der andere mit seinen Späßen unterhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb303db-1f2c-4de6-81a9-8e4b51836622",
                                                "sense_id": "d11fb3a5-34c4-3c96-a8ee-fa9956b00505",
                                                "text": "„So sah sich Gustav Hackendahl auch gar nicht als der bezahlte Spaßmacher der anderen, nein, er wollte seinen Spaß an den Gästen haben.“"
                                            },
                                            {
                                                "example_id": "f7a69eee-2ae8-411c-af15-7a7c9afe00ba",
                                                "sense_id": "d11fb3a5-34c4-3c96-a8ee-fa9956b00505",
                                                "text": "„In der Klasse gab es viele Spaßmacher, die die schwächeren Schüler schikanierten.“"
                                            },
                                            {
                                                "example_id": "5e58c8c8-2e25-4570-8545-35dd3b513a78",
                                                "sense_id": "d11fb3a5-34c4-3c96-a8ee-fa9956b00505",
                                                "text": "„Andererseits erlauben Machthaber, glauben sie sich fest im Sattel, den Spaßmachern, sich auf ihre Kosten lustig zu machen.“"
                                            },
                                            {
                                                "example_id": "bbda9539-cc9f-4009-8552-8f4f25e2544a",
                                                "sense_id": "d11fb3a5-34c4-3c96-a8ee-fa9956b00505",
                                                "text": "„Man stellte mich vor, man sprach von mir, man hob mich in den Himmel; ich spielte den Spaßmacher, um diese Komplimente zu beenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf93a921-e7ee-43fa-be51-1a4e72311b26",
                        "source_entry_id": "95bac3b1-35e6-3c7a-921e-51b8b9b76719",
                        "source_sense_id": "afe0b0fa-7f86-3bb2-a315-9d2bc0eb6f4f",
                        "target_lang_word": "Spötter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spötter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                        "entry_id": "c0345d5f-9000-32f1-9009-54c2180ecc24",
                                        "glosses": [
                                            "Person, die (gern) spottet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71d7983-4953-42d5-85c0-66f94775b057",
                                                "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                                "text": "Er konnte alle Spötter Lügen strafen."
                                            },
                                            {
                                                "example_id": "d4dbe54d-0d48-4866-b09f-d33f20f176b6",
                                                "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                                "text": "„Der Junggeselle ist ein Spötter, und er weiß genau, was er erzählt.“"
                                            },
                                            {
                                                "example_id": "e15269da-a68f-4c2d-a618-89a1e86037e9",
                                                "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                                "text": "„Der unverbesserliche Spötter hat den durchdringenden Blick, Stil und ein Leberleiden.“"
                                            },
                                            {
                                                "example_id": "207bd3f3-2575-4523-b17c-fcef0f433f8b",
                                                "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                                "text": "„Militerni, ein Spötter ersten Ranges und Günstling des Marschalls d'Estrées, besaß Verstand und Bildung; aber ihm fehlte die Selbstzucht und vielleicht ein wenig das Feingefühl.“"
                                            },
                                            {
                                                "example_id": "1279b195-a1e5-47da-8838-eb21e82021ff",
                                                "sense_id": "21416caf-fd87-3660-95db-cb771d650a6f",
                                                "text": "„Den Namen des berühmten antiklerikalen Spötters wollte er in die Arena des Kulturkampfes zerren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14457e4b-c79b-3aa5-9949-b721fe46db82",
                                        "entry_id": "c0345d5f-9000-32f1-9009-54c2180ecc24",
                                        "glosses": [
                                            "Vogelart, die artfremde Stimmen und Klänge nachahmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c095015-204d-4957-8cbd-4817997e8fd4",
                                                "sense_id": "14457e4b-c79b-3aa5-9949-b721fe46db82",
                                                "text": "Der Graupapagei ist eine besonders begabter Spötter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58c14034-e172-386f-bc85-bb90511ad283",
                                        "entry_id": "c0345d5f-9000-32f1-9009-54c2180ecc24",
                                        "glosses": [
                                            "Vertreter der Vogelgattung Hippolais aus der Familie der Grasmückenartigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ad7a20-8214-40e9-bab5-466b4763b0a7",
                                                "sense_id": "58c14034-e172-386f-bc85-bb90511ad283",
                                                "text": "Spötter bauen Gesänge anderer Vogelarten virtuos in ihren eigenen Gesang ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
