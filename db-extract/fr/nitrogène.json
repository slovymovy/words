        "fr-extract.jsonl": [
            {
                "entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                "word": "nitrogène",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77861e6f-bd8e-45ce-9c65-88ee552ea802",
                        "entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                        "tags": [
                            "plural"
                        ],
                        "form": "nitrogènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                        "entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                        "glosses": [
                            "Ancienne désignation de l’azote."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ab4d39-d5fe-429f-ad74-e395d720f071",
                                "sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                                "text": "Il a voulu, expérimentalement, essayer l’action directe du nitrogène sur le métal fondu dans une atmosphère de ce gaz à forte pression, puis refroidi le plus rapidement possible en vue de retenir le maximum de gaz."
                            },
                            {
                                "example_id": "d54bfc08-ebd6-401c-9d35-178c5899b46c",
                                "sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                                "text": "À 8 h 30, ils avaient commencé d’insuffler du nitrogène dans le dernier réservoir de gaz pour pousser doucement le reste du poison dans les tuyauteries."
                            },
                            {
                                "example_id": "9c7df85c-950c-4f6a-95b9-160c9655d080",
                                "sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                                "text": "Au sein des substances apolaires ne possédant pas de nitrogène, comme, par exemple, les terpènes, on assiste à une association avec des molécules lipophiliques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dee7117-a868-4520-b43c-33ae7dc0664e",
                        "source_entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                        "source_sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                        "target_lang_word": "Stickstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stickstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69c1663-74b4-3522-bb2c-217e45fcf513",
                                        "entry_id": "dcd4b677-76c7-39d5-8d3d-9fc684472e12",
                                        "glosses": [
                                            "chemisches Element der fünften Hauptgruppe; wichtiger Bestandteil von Aminosäuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380896a8-8e16-42e1-adba-be1f9b974124",
                                                "sense_id": "a69c1663-74b4-3522-bb2c-217e45fcf513",
                                                "text": "Stickstoff hat einen Atomradius von rund 70 Pikometer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5acfe32e-7a5a-36c2-adca-76d8ed0d2977",
                                        "entry_id": "dcd4b677-76c7-39d5-8d3d-9fc684472e12",
                                        "glosses": [
                                            "farbloses, geruchloses, nicht brennbares Gas; Hauptbestandteil der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77e9ca8-3a86-4efe-b1a4-0f25b07c0a9e",
                                                "sense_id": "5acfe32e-7a5a-36c2-adca-76d8ed0d2977",
                                                "text": "„Die Gülle, die vom Hof nicht vollständig auszubringen ist, wird von Vertragsfirmen mit blankpolierten Tankwagen zum öffentlichen Wirtschaftsdüngerlager, oft auch in andere, teilweise weit entfernt liegende Regionen gefahren, wo die meisten Ackerbauern selbst keine Tiere mehr halten, dafür jedoch für ihren Anbau von Mais, Roggen und Weizen Phosphor, Stickstoff und Spurenelemente gut gebrauchen können.“"
                                            },
                                            {
                                                "example_id": "0b735f55-faa9-40a2-90a1-5dc6bc273d83",
                                                "sense_id": "5acfe32e-7a5a-36c2-adca-76d8ed0d2977",
                                                "text": "Um die Dreifachbindung des Stickstoffs aufzulösen, ist viel Energie nötig, nur bestimmte Mikroorganismen – aber keine Tiere oder Pflanzen – sind dazu in der Lage."
                                            },
                                            {
                                                "example_id": "3a994748-8078-45a8-8f65-76826de61b84",
                                                "sense_id": "5acfe32e-7a5a-36c2-adca-76d8ed0d2977",
                                                "text": "„Stickstoff ist aufgrund der hohen Bindungsenergie der N₂-Moleküle sehr reaktionsträge; er reagiert erst bei Temperaturen von mehreren Hundert Grad mit nennenswerter Geschwindigkeit.“"
                                            },
                                            {
                                                "example_id": "d34a6b4e-e424-4fe7-afd4-ebbeda42b503",
                                                "sense_id": "5acfe32e-7a5a-36c2-adca-76d8ed0d2977",
                                                "text": "„Die drei Pflanzen ergänzen einander: Bohnen nutzen den Mais als Kletterstangen, denn sie können den Stickstoff aus der Luft binden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f08f802-c060-48d4-8003-81c8b9a163f9",
                        "source_entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                        "source_sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
                        "target_lang_word": "nitrogen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrogen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1870af85-b623-30da-b5d0-f71ec4884fcb",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "The chemical element (symbol N) with an atomic number of 7 and atomic weight of 14.0067. It is a colorless and odorless gas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b662c2f-4f75-4f08-b3c1-b41f18519f0d",
                                                "sense_id": "1870af85-b623-30da-b5d0-f71ec4884fcb",
                                                "text": "All life depends on nitrogen; it is the building block from which nature assembles amino acids, proteins, and nucleic acids; the genetic information that orders and perpetuates life is written in nitrogen ink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0219d2-21c8-3e24-8d68-6b491013d427",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "Molecular nitrogen (N₂), a colorless, odorless gas at room temperature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1c33fee-91e6-4a6e-ac6b-fc7c82974807",
                                                "sense_id": "de0219d2-21c8-3e24-8d68-6b491013d427",
                                                "text": "Volatiles of kecap manis and its raw materials were extracted using Likens-Nickerson apparatus with diethyl ether as the extraction solvent. The extracts were then dried with anhydrous sodium sulfate, concentrated using a rotary evaporator followed by flushing using nitrogen until the volume was about 0.5 ml."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8612053-6bef-3df5-98bd-fe7cc0c9b235",
                                        "entry_id": "1588fbc0-4575-386e-a245-0ae7c11ff14c",
                                        "glosses": [
                                            "A specific nitrogen atom within a chemical formula, or a specific isotope of nitrogen."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90b9a3c-ab05-4b6e-9484-9ebce6d1c585",
                                                "sense_id": "e8612053-6bef-3df5-98bd-fe7cc0c9b235",
                                                "text": "The two nitrogens are located next to one another on the ring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dd9b0cc-d0b6-4ca7-87a0-4482dd41579e",
                        "source_entry_id": "30e2c13d-b280-3c6a-992c-69efa8b1b996",
                        "source_sense_id": "019210fc-7f77-3e27-813b-6bd04852d6cb",
