            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53ae6ac7-eabe-318b-a940-62c02d332424",
                    "sense_definition": "British standard spelling of <w>hemorrhage</w>; a copious discharge of blood from the blood vessels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered a severe brain <w>haemorrhage</w> and required immediate surgery.",
                            "target_lang_translations": {
                                "de": "Der Patient erlitt eine schwere Gehirn<w>blutung</w> und musste sofort operiert werden."
                            }
                        },
                        {
                            "text": "Doctors managed to stop the internal <w>haemorrhage</w> before it caused further damage.",
                            "target_lang_translations": {
                                "de": "Den Ärzten gelang es, die innere <w>Blutung</w> zu stoppen, bevor sie weiteren Schaden anrichtete."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleeding"
                    ],
                    "common_phrases": [
                        "brain haemorrhage",
                        "internal haemorrhage"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein starker Blutverlust aus den Blutgefäßen; eine Blutung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blutung",
                                "target_lang_sense_clarification": "allgemeiner Austritt von Blut"
                            },
                            {
                                "target_lang_word": "Hämorrhagie",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für starken Blutfluss"
                            },
                            {
                                "target_lang_word": "Blutsturz",
                                "target_lang_sense_clarification": "plötzlicher, sehr starker Blutverlust"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3ab363f-ef08-35fe-8cb3-c7e6282f4356",
                    "sense_definition": "British standard spelling of <w>hemorrhage</w>; to bleed copiously, or to lose something rapidly and in large quantities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The struggling company began to <w>haemorrhage</w> money after the failed product launch.",
                            "target_lang_translations": {
                                "de": "Das angeschlagene Unternehmen begann nach der missglückten Produkteinführung, Geld zu <w>verlieren</w>."
                            }
                        },
                        {
                            "text": "Without proper medical intervention, the wound will continue to <w>haemorrhage</w> dangerously.",
                            "target_lang_translations": {
                                "de": "Ohne angemessene medizinische Versorgung wird die Wunde weiterhin gefährlich <w>bluten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bleed"
                    ],
                    "common_phrases": [
                        "haemorrhage money",
                        "haemorrhage jobs"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Stark bluten oder etwas (wie Geld oder Arbeitsplätze) in großen Mengen und unkontrolliert verlieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bluten",
                                "target_lang_sense_clarification": "starken Blutverlust erleiden"
                            },
                            {
                                "target_lang_word": "verlieren",
                                "target_lang_sense_clarification": "im übertragenen Sinne für Geld oder Ressourcen in großen Mengen"
                            },
                            {
                                "target_lang_word": "hämorrhagieren",
                                "target_lang_sense_clarification": "medizinisch für stark bluten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
