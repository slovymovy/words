                        "form": "outrecuidante"
                    },
                    {
                        "form_id": "ec589eab-1836-483d-b8de-c1072435cda2",
                        "entry_id": "5332f7df-4e59-3cbb-a3e1-fcec0bf2e20b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "outrecuidantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "761618eb-e645-36f8-8e23-678f19d414d5",
                        "entry_id": "5332f7df-4e59-3cbb-a3e1-fcec0bf2e20b",
                        "glosses": [
                            "Qui a de l’outrecuidance, qui a une confiance excessive envers lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be2a328d-c677-48b4-a6f3-b379781e2851",
                                "sense_id": "761618eb-e645-36f8-8e23-678f19d414d5",
                                "text": "« M. de Talleyrand n’a-t-il pas commencé sa carrière en sachant tenir tête, par un mot heureux, à l’orgueil outrecuidant de madame la duchesse de Grammont ? »"
                            },
                            {
                                "example_id": "671f5ee6-c202-47e0-9a2f-c459a32b73aa",
                                "sense_id": "761618eb-e645-36f8-8e23-678f19d414d5",
                                "text": "Cette sympathie, je crois que je la mérite un peu; et je crois qu'il n'est pas trop outrecuidant de le penser et de le dire."
                            },
                            {
                                "example_id": "884ddf86-7227-495a-994d-77706b94ecf2",
                                "sense_id": "761618eb-e645-36f8-8e23-678f19d414d5",
                                "text": "Il n’affichait pas d’outrecuidantes prétentions : au contraire, il se piquait de connaître ses limites."
                            },
                            {
                                "example_id": "5dd17ee5-0feb-4433-ad55-33e28f4bc4bd",
                                "sense_id": "761618eb-e645-36f8-8e23-678f19d414d5",
                                "text": "Sa chevalerie l'avait décidément rendu plus outrecuidant."
                            }
                        ]
                    },
                    {
                        "sense_id": "280cfae9-e9e3-3529-9621-cdbae468f14d",
                        "entry_id": "5332f7df-4e59-3cbb-a3e1-fcec0bf2e20b",
                        "glosses": [
                            "Qui a une propension naturelle à se croire supérieur aux autres."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
