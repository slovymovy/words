                "senses": [
                    {
                        "sense_id": "5f0fbe44-13d7-380f-82b8-a65db24bf17e",
                        "entry_id": "84146341-4d56-3b95-a4f2-7ae23b116c8d",
                        "glosses": [
                            "прич. от ранить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "d2fa600c-5f84-4ae8-adf2-4ef5e7eb2de9",
                                "sense_id": "5f0fbe44-13d7-380f-82b8-a65db24bf17e",
                                "text": "Несколькими выстрелами она заставила их отступить на лестницу и в продолжение двух–трёх минут одна удерживала их, пока сама не упала, раненная в голову."
                            },
                            {
                                "example_id": "04dd72dd-cc9a-46ce-a64d-66d078edaab0",
                                "sense_id": "5f0fbe44-13d7-380f-82b8-a65db24bf17e",
                                "text": "Король и наследный принц были тяжело ранены и вскоре скончались."
                            },
                            {
                                "example_id": "89fe7ec7-6f50-4dde-9adb-04dd051721fd",
                                "sense_id": "5f0fbe44-13d7-380f-82b8-a65db24bf17e",
                                "text": "Дмитрий ехал на войну, где мог быть ранен, убит."
                            }
                        ]
                    }
                ],
