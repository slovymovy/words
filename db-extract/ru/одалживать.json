                "senses": [
                    {
                        "sense_id": "0708146e-5236-3f25-9090-3384499e609e",
                        "entry_id": "c2161d0e-4714-33f7-84de-dd89829f6c56",
                        "glosses": [
                            "давать в долг, взаймы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d02687-3c32-4080-b9e6-35bae0ef9bcb",
                                "sense_id": "0708146e-5236-3f25-9090-3384499e609e",
                                "text": "Ещё говорили о нём, что был скуп и не любил одалживать не только односельчанам, но даже и родственникам."
                            }
                        ]
                    },
                    {
                        "sense_id": "0de2e66a-48c3-3e29-aee0-a53aa073ad69",
                        "entry_id": "c2161d0e-4714-33f7-84de-dd89829f6c56",
                        "glosses": [
                            "прост. брать взаймы, занимать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849f02dd-26a8-40dc-8efe-ab8fc091bb7f",
                                "sense_id": "0de2e66a-48c3-3e29-aee0-a53aa073ad69",
                                "text": "А в другом городе он одалживал у кого-нибудь смычок, склеивал свою скрипку, с грехом пополам приводил в порядок костюмы и начинал работать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17d22df0-12c3-42f0-ae9b-dd38670a2990",
                        "source_entry_id": "c2161d0e-4714-33f7-84de-dd89829f6c56",
                        "source_sense_description": "давать взаймы",
                        "target_lang_word": "lend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8655be32-5a3e-3388-82b1-c67cc9a27631",
                                        "entry_id": "26185397-30a6-3c0b-8e2b-dd005f20d50b",
                                        "glosses": [
                                            "To allow to be used by someone temporarily, on condition that it or its equivalent will be returned."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4667e22d-6966-405c-9d35-5877350560b1",
                                                "sense_id": "8655be32-5a3e-3388-82b1-c67cc9a27631",
                                                "text": "I will only lend you my car if you fill up the tank."
                                            },
                                            {
                                                "example_id": "0ce6eb71-5a84-4f09-b6e5-697851e11531",
                                                "sense_id": "8655be32-5a3e-3388-82b1-c67cc9a27631",
                                                "text": "Where is that hundred euros I lent you months ago?"
                                            },
                                            {
                                                "example_id": "a8752beb-92ee-4dc6-b5c0-2fba5678b480",
                                                "sense_id": "8655be32-5a3e-3388-82b1-c67cc9a27631",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c71963-7481-377b-b77e-8bbe383e9f4c",
                                        "entry_id": "26185397-30a6-3c0b-8e2b-dd005f20d50b",
                                        "glosses": [
                                            "To make a loan."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e6a1872-b384-34d5-a1f4-5ddb47f4bc09",
                                        "entry_id": "26185397-30a6-3c0b-8e2b-dd005f20d50b",
                                        "glosses": [
                                            "To be suitable or applicable, to fit."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632cea2e-4721-4bc0-a9aa-007868c18308",
                                                "sense_id": "3e6a1872-b384-34d5-a1f4-5ddb47f4bc09",
                                                "text": "Poems do not lend themselves to translation easily."
                                            },
                                            {
                                                "example_id": "c8761edd-e4cf-4918-9e71-0debf1192008",
                                                "sense_id": "3e6a1872-b384-34d5-a1f4-5ddb47f4bc09",
                                                "text": "The long history of the past does not lend itself to a simple black and white interpretation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                        "entry_id": "26185397-30a6-3c0b-8e2b-dd005f20d50b",
                                        "glosses": [
                                            "To afford; to grant or furnish in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b72ab4a7-3b33-4372-aa98-483a6bbfafb2",
                                                "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                                "text": "Can you lend me some assistance?"
                                            },
                                            {
                                                "example_id": "97665591-5360-4470-9fab-7e96b34548e7",
                                                "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                                "text": "The famous director lent his name to the new film."
                                            },
                                            {
                                                "example_id": "ff8053d4-d776-4b6e-b735-6c9786f7ffa9",
                                                "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                                "text": "Cato, lend me for a while thy patience."
                                            },
                                            {
                                                "example_id": "a450467a-6032-4278-bce0-4b82d02344f4",
                                                "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                                "text": "Mountain lines and distant horizons lend space and largeness to his compositions."
                                            },
                                            {
                                                "example_id": "45054eed-ce88-4766-9ff4-b0b3aa4f1bd3",
                                                "sense_id": "065c5134-c25d-3d94-8fdc-f7c0ef7d7044",
                                                "text": "FORSEA absolutely condemns the political manipulation on the part of the junta, General Prayuth, the Thai Senate and the parties that lent their support for General Prayuth that led him to parliamentary victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c99b16-1998-37e8-95d3-f0e93d01a755",
                                        "entry_id": "26185397-30a6-3c0b-8e2b-dd005f20d50b",
                                        "glosses": [
                                            "To borrow."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                        "entry_id": "d0c8f17e-84b8-36ff-b0c7-c40899749b56",
                                        "glosses": [
                                            "Loan (permission to borrow (something))."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b393cf9-cebb-46a5-9bdb-e9daa2db2b1d",
                                                "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                                "text": "“But,” says Arthur, “I wouldn't be proud of your clothes, / For you've only the lend of them, as I suppose.”"
                                            },
                                            {
                                                "example_id": "58eb9ac8-4a07-4d9e-8ab3-c6610ae8530a",
                                                "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                                "text": "Yesterday asked Mr. Aray the lend of 8s. 6d. for a month."
                                            },
                                            {
                                                "example_id": "68243b6f-63a3-4b9f-86cf-593574c57e57",
                                                "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                                "text": "However, Weldon would soon note his declining potato yield, and his suspicions were confirmed one night when he confronted Joe with a jumper full of spuds. Somehow, Joe managed to talk his way out of trouble. 'I told him I was getting the lend of them,' Joe laughed. It wasn't only vegetables that were targeted, though. For generations of children who grew up on ..."
                                            },
                                            {
                                                "example_id": "d358c620-39e1-4914-a625-efe3dcd78ac1",
                                                "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                                "text": "Our thanks go to Diran Adebayo for his support, especially his lend of Everything You're Told Is True, to the website. It has been an honour to host […]"
                                            },
                                            {
                                                "example_id": "93b6cffd-9b78-40b2-b385-970a203b8c73",
                                                "sense_id": "55748b60-ce41-3238-8c96-dfb5d4bdd4e9",
                                                "text": "“Give these to your dad, Betsy, tell him thanks for the lend of them. I'm leaving next week, Betsy.” “Really, where are you going?” Betsy played dumb."
                                            }
                                        ]
                                    }
                                ]
