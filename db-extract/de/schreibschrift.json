                ],
                "senses": [
                    {
                        "sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                        "entry_id": "89a755b4-7560-3b2a-9aa4-d25f403fd0e6",
                        "glosses": [
                            "eine Schriftform, bei der die Buchstaben (Lettern) verbunden/zusammenhängend wiedergeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a0b50e-9903-4281-ac88-97a16426f5b7",
                                "sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                                "text": "Deine Schreibschrift ist unleserlich, also schreibe mir das bitte noch einmal in Druckschrift auf."
                            },
                            {
                                "example_id": "2afbab6e-6571-4669-bcbf-5f2cfe5d56e3",
                                "sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                                "text": "„Viele Praktiker lassen die Schreibschrift längst aus reiner Not weg: An Brennpunktschulen sind Lehrer oft froh, wenn die Kinder überhaupt halbwegs Lesbares zu Papier bringen.“"
                            },
                            {
                                "example_id": "9e7c3fd5-084b-4650-9553-35012c57c423",
                                "sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                                "text": "„Damit Ihr Interesse und Ihre Freude an diesen beiden Schreibschriften erhalten bleibt, durfte diese Fibel nur so umfangreich wie erforderlich und so ausführlich wie nötig sein.“"
                            },
                            {
                                "example_id": "0fc5d239-a4ca-4f86-9bd2-5f2203c71790",
                                "sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
                                "text": "„Der Umlaut wurde im Hochmittelalter durch ein e über dem umgelauteten Vokal markiert. In der neuzeitlichen Schreibschrift besteht e aus zwei Strichen, was noch in unserer Schreibschrift als Umlautstriche erhalten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7034af3-59f6-40bc-baa2-0de3e106247f",
                        "source_entry_id": "89a755b4-7560-3b2a-9aa4-d25f403fd0e6",
                        "source_sense_id": "6e8d0451-dcb3-3670-8bda-941d25b18500",
