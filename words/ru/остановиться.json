                            "target_lang_translations": {
                                "en": "I want to specifically <w>focus</w> on the results of the work.",
                                "es": "Quiero <w>centrarme</w> especialmente en los resultados del trabajo.",
                                "fr": "Je souhaite <w>m'arrêter</w> particulièrement sur les résultats du travail.",
                                "nl": "Ik wil apart <w>stilstaan</w> bij de resultaten van het werk.",
