                                "sense_id": "cd82f8e4-cf7c-323d-a006-2d3702c9bc46",
                                "text": "De zaadbank is belangrijk als voedselleverancier voor de vele vogelsoorten die er leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "15a2835b-f6ed-3641-8ad6-7fca16793a63",
                        "entry_id": "bb58e4ce-287a-3bc2-a44a-6b0225065885",
