                    "sense_definition": "Par bonheur, par chance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Heureusement</w>, le train avait quelques minutes de retard et nous avons pu monter."
                        },
                        {
                            "text": "J'avais oublié mes clés au bureau mais <w>heureusement</w> ma colocataire était chez nous."
                        }
                    ],
                    "antonyms": [
