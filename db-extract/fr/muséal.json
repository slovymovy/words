                "senses": [
                    {
                        "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                        "entry_id": "a8208862-ce90-3f1c-972b-2525e6ef5486",
                        "glosses": [
                            "Relatif au musée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a29bf00-06ba-480a-bff5-b6171f0fb977",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "Il [mon père] regardait ce fatras avec une politesse absente sauf quand il lisait à haute voix le commentaire muséal."
                            },
                            {
                                "example_id": "24401adf-b745-4e82-9622-c42025d6bed4",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "Elle est également titulaire d’une maîtrise en études muséales de l’université britannique de Leicester."
                            },
                            {
                                "example_id": "723ccf19-45a9-4443-a3e6-402cb672ccae",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "Courants contemporains de recherche en éducation muséale"
                            },
                            {
                                "example_id": "e36441f1-0b4e-4ef8-8f9f-08e7a08d07b6",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "La formation en muséologie et en éducation muséale à travers le monde"
                            },
                            {
                                "example_id": "3efb1e8f-b6e6-4ca0-979f-c61a43ae65bb",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "L’espace muséal attenant au site de la bataille."
                            },
                            {
                                "example_id": "53af7209-54ec-4948-9e4f-d6c8e315a5c0",
                                "sense_id": "dddbe76c-0b98-3a73-9ada-f916e6f7aa06",
                                "text": "Constitués de huit sites, les Musées d’art et d’histoire forment l’un des plus grands ensembles muséaux suisses."
                            }
                        ]
                    }
