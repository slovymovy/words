                ],
                "translations": [
                    {
                        "translation_id": "fcec99fd-6a81-4730-88ab-bd475ad4f218",
                        "source_entry_id": "21be79bb-6bd1-38ea-9842-ecd076ce157f",
                        "source_sense_description": "test made with a probe",
                        "target_lang_word": "Sondierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sondierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                        "entry_id": "6eba0bff-d086-3e94-af10-133f07590e2a",
                                        "glosses": [
                                            "systematische Erfassung von Gewässertiefen"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0382a40-9168-414a-a745-78aadf54e0a4",
                                                "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                                "text": "„Die schnellste Sondierung war von 2562 Faden in einer Stunde 28 Minuten und 8 Secunden in der Nähe von San-Diego.“"
                                            },
                                            {
                                                "example_id": "8a6811ba-c6ab-415f-9e87-fd839ded086f",
                                                "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                                "text": "„Sind viele Flußquerschnitte aufzunehmen, also bei einer Sondierung, bedient man sich vorteilhaft eines Profilschreibers, der beim Abrollen auf der Flußsohle Weg und Wasserdruck und damit gleichzeitig das Flußprofil aufzeichnet […]“"
                                            },
                                            {
                                                "example_id": "86c354ed-67df-4575-9eea-910752d3bc4f",
                                                "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                                "text": "„Bei der zweiten Sondierung des Flusses finden sie etwas.“"
                                            },
                                            {
                                                "example_id": "27894b66-6770-4e7f-87ef-0fc03d0ecfed",
                                                "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                                "text": "„Dieses Hinderniss lässt sich jedoch forträumen, und da schon die von Cortez im Jahre 1520 angeordneten Sondirungen denselben Wasserstand über der Barre ergaben, darf man annehmen, dass diese constant ist, dass also auch eine Vertiefung des Fahrwassers von dauerndem Nutzen sein wird.“"
                                            },
                                            {
                                                "example_id": "750b30ca-8854-4c99-a4f7-999ddb1b6693",
                                                "sense_id": "41312137-7c62-3ff1-957e-9c7a47be5c21",
                                                "text": "„Während das Material abgeladen, und die Ufer für den Brückenschlag zugerichtet werden, nimmt man die Sondirung des Flussbettes vor, nicht etwa in der Absicht um ein vollständiges Flussprofil zu erhalten, was viel zu zeitraubend, und durchaus unnöthig wäre, sondern um beiläufig bestimmen zu können, an welchen Stellen die vorhandene Wassertiefe 13 übersteigt, daher schwimmende Unterlagen erfordert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                        "entry_id": "6eba0bff-d086-3e94-af10-133f07590e2a",
                                        "glosses": [
                                            "Einsatz einer Sonde für allfällige Untersuchungen (von Organen oder Geweben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89cae9b7-e8dc-4a7c-9369-a1c9589fef75",
                                                "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                                "text": "„Unter Rechtsherzkatheteruntersuchung versteht man die Sondierung des rechten Herzens mit einem ein- oder mehrlumigen Katheter zur Messung von Druck, Fluß und Widerstand.“"
                                            },
                                            {
                                                "example_id": "a2ee16a9-c408-40c9-b755-6cf72f96796a",
                                                "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                                "text": "„Eine superselektive Katheterlage mit Sondierung eines Konusastes muss vor weiteren Kontrastmittelinjektionen korrigiert werden, da die Kontrastmittelinjektion regelhaft Kammerflimmern induziert.“"
                                            },
                                            {
                                                "example_id": "8f7d169e-d15f-4e79-b4e6-9717791e2558",
                                                "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                                "text": "„Mit seinem Charme und seiner ganzen Überredungskunst hat er die junge OP-Schwester davon überzeugt, daß die Sondierung des Herzens ganz ungefährlich sei.“"
                                            },
                                            {
                                                "example_id": "f4e66526-ab8d-4b74-a6cf-25ad2e70661b",
                                                "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                                "text": "„Die Sondierung erfolgt über den mittleren Nasengang.“"
                                            },
                                            {
                                                "example_id": "6f672c39-c56b-41a4-968b-a82ec0603fc8",
                                                "sense_id": "3dfe6de8-af88-3270-b9a7-f096e5014778",
                                                "text": "„In mehreren Studien konnte nämlich nachgewiesen werden, daß bei üblicher Sondierung die Oberflächenschicht einer bestehenden Initialkaries verletzt oder eingedrückt werden kann […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a77b7e26-19ed-3dae-ad21-45cc2f1089e6",
                                        "entry_id": "6eba0bff-d086-3e94-af10-133f07590e2a",
                                        "glosses": [
                                            "Einsatz einer Sonde für spezielle Zwecke, zum Beispiel Untersuchung der Boden- oder Untergrundbeschaffenheit, aber auch Einsatz einer Lawinensonde zur Suche nach Verschütteten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e167e2-9118-4cdb-92e3-a0ed74bed066",
                                                "sense_id": "a77b7e26-19ed-3dae-ad21-45cc2f1089e6",
                                                "text": "„Die Sondierung kann sowohl manuell als auch mechanisch ausgeführt werden.“"
                                            },
                                            {
                                                "example_id": "c3bf312f-fa47-4247-986c-2f3ec1a11979",
                                                "sense_id": "a77b7e26-19ed-3dae-ad21-45cc2f1089e6",
                                                "text": "Die Sondierungen werden von einer Arbeitsebene aus (z. B. Gelände oder Baugrubensohle) oder im Bohrloch vorgenommen.“"
                                            },
                                            {
                                                "example_id": "6125b72a-1d81-4b16-9df1-d419bf447e29",
                                                "sense_id": "a77b7e26-19ed-3dae-ad21-45cc2f1089e6",
                                                "text": "„Abweichend von der DIN 4094 wird empfohlen, nach dem erstmaligen Erreichen von 50 Schlägen, in einem der drei Sondierbereichen von jeweils 15 cm, die Eindringtiefe für diese 50 Schläge anzugeben und dann die Sondierung abzubrechen.“"
                                            },
                                            {
                                                "example_id": "0422667e-a565-4452-8a8e-3274f3ecd454",
                                                "sense_id": "a77b7e26-19ed-3dae-ad21-45cc2f1089e6",
                                                "text": "„Ist eine solche Linie durchsondiert, so rückt die gesamte Mannschaft 10–15 cm vor und führt die Sondierung auf der zweiten Linie durch usf. Alle fertigsondierten Strecken werden markiert, damit keine unnötige und zeitraubende Wiederholungsarbeit geleistet zu werden braucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d32dd3b9-caa4-363e-995c-90da7fcd7605",
                                        "entry_id": "6eba0bff-d086-3e94-af10-133f07590e2a",
                                        "glosses": [
                                            "Gespräch, um Situationen und Meinungen in Erfahrung zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef1c49b-bfbf-4ec2-94bc-191b5eb4e6f5",
                                                "sense_id": "d32dd3b9-caa4-363e-995c-90da7fcd7605",
                                                "text": "„In der Woche der Sondierungen soll es keine Zwischenstatements, keine Tweets aus den Sitzungen und auch keine Talkshow-Auftritte geben.“"
                                            },
                                            {
                                                "example_id": "5fd1661a-815a-4840-9be8-0fbe67f80ece",
                                                "sense_id": "d32dd3b9-caa4-363e-995c-90da7fcd7605",
                                                "text": "„Nach fast fünfzehnstündigen Sondierungen zeichnete sich am späten Abend noch keine Gesamteinigung ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
