                    },
                    {
                        "translation_id": "2839600e-e9b5-44f7-b84f-9cf02f947a82",
                        "source_entry_id": "a662d50b-13bd-386a-8804-0acfaf7be372",
                        "source_sense_id": "f4d79468-8b1f-348a-85e3-63a2bc684224",
                        "target_lang_word": "pandeist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pandeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                        "entry_id": "fce166e8-a812-3fc0-b54a-c790760444bf",
                                        "glosses": [
                                            "of or relating to pandeism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f448e5-4b89-496c-a314-cce70caba9a6",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "[Y]ou're drifting somewhere in the Pandeist or Deist dogma, where god is either the Universe itself or is a part of each person."
                                            },
                                            {
                                                "example_id": "6a7aa538-b569-43fc-b628-e4497eee3aa8",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "Indeed, most of the staff is either Hindu or Moslem, but they are full of these pan-deist ideas, and even Zahir deliberately used the Christian word \"God\" rather than \"Allah\" when talking with me."
                                            },
                                            {
                                                "example_id": "3deb4b78-39c4-45c9-bcb1-e73ada01c7b2",
                                                "sense_id": "9f5e2a8a-d3a2-3c3d-bc3d-6a46517246c6",
                                                "text": "[S]ome pragmatists (such as William James) took a more pantheist or pandeist approach by rejecting views of God as separate from the World."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pandeist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                        "entry_id": "2c224ad3-3fad-3e71-bcfb-c653c4d38332",
                                        "glosses": [
                                            "One who believes in pandeism, a blend of pantheism and deism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849697c1-bf22-48b1-ac8b-9df4e56a746e",
                                                "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                                "text": "Is Gordon a pan-deist, or a monotheist?"
                                            },
                                            {
                                                "example_id": "9fdafb36-b05d-4259-9c69-4ea30fc4e2dd",
                                                "sense_id": "3c993c17-cf38-3f4d-ab98-31634a2650a0",
                                                "text": "Does that mean that it holds a majority of Christians as its subjects? That it was founded by Christians? That it must hold only to what Christians say, ignoring Jews, Muslims, non-deists, pandeists, and all other non-Christians?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4416f7fd-5fde-3308-9068-d485748093a5",
                                        "entry_id": "2c224ad3-3fad-3e71-bcfb-c653c4d38332",
                                        "glosses": [
                                            "one who believes in the truth of all religions"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
