                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor took a <w>short</w> position on the tech stock.",
                            "target_lang_translations": {
                                "ru": "Инвестор открыл <w>короткую</w> позицию по акциям технологической компании."
                            }
                        },
                        {
                            "text": "I am <w>short</w> in General Motors because I think their sales are plunging.",
                            "target_lang_translations": {
                                "ru": "Я в <w>шорте</w> по General Motors, потому что думаю, что их продажи падают."
                            }
                        }
                    ],
                    "antonyms": [
                        "long"
                    ],
                    "common_phrases": [
                        "short position",
                        "short interest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/finance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовая позиция, приносящая прибыль при снижении цены актива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткий",
                                "target_lang_sense_clarification": "о позиции на рынке"
                            },
                            {
                                "target_lang_word": "шорт",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
