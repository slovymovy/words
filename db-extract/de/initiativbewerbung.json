                ],
                "senses": [
                    {
                        "sense_id": "65c8ac13-8e95-3ebe-a402-8c3c73b9391c",
                        "entry_id": "c7ed834d-61ce-360d-bf35-299dd732d6f6",
                        "glosses": [
                            "Bewerbung auf ein Arbeitsverhältnis, bei der man nicht auf eine Stellenausschreibung reagiert, sondern unaufgefordert seine Dienste als potenzieller Arbeitnehmer anbietet"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14954a11-12a8-4b26-8280-e08f69de7f10",
                        "source_entry_id": "c7ed834d-61ce-360d-bf35-299dd732d6f6",
                        "source_sense_id": "65c8ac13-8e95-3ebe-a402-8c3c73b9391c",
                        "target_lang_word": "speculative application",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculative application",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31e724f9-a8f6-3874-833e-d27ed8bb9059",
                                        "entry_id": "e1b41cfc-e615-36f6-945d-408d17ea42d5",
                                        "glosses": [
                                            "An application for a job with an employer who is not currently advertising any vacancies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481b0579-cd0e-4c4b-b72b-f2893ac91d3e",
                                                "sense_id": "31e724f9-a8f6-3874-833e-d27ed8bb9059",
                                                "text": "When writing a speculative application, it is best to find out the name of the company's personnel manager."
                                            },
                                            {
                                                "example_id": "b1ca8570-f125-403d-9113-1104d2259382",
                                                "sense_id": "31e724f9-a8f6-3874-833e-d27ed8bb9059",
                                                "text": "Many people who got their job through a speculative application often say it was a case of their CV hitting the right desk at the right time."
                                            },
                                            {
                                                "example_id": "4fd8d07a-5767-4db1-957d-bd65ba176538",
                                                "sense_id": "31e724f9-a8f6-3874-833e-d27ed8bb9059",
                                                "text": "There are of course no guarantees when you send in a speculative application; however, it can be something worth doing if there is an organization you are especially keen to work for that doesn't have any advertised opportunities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2366b562-b6a5-312d-8543-4ed909e8b39a",
                                        "entry_id": "e1b41cfc-e615-36f6-945d-408d17ea42d5",
                                        "glosses": [
                                            "An application for something (such as a permit) that one does not yet know that one definitely needs or that one does not necessarily qualify to receive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db86d1ca-2cd9-4aff-a978-67eb399440f1",
                                                "sense_id": "2366b562-b6a5-312d-8543-4ed909e8b39a",
                                                "text": "This speculative application by guides may result in more guided use being assigned than actually demanded. If launches are limited in the future, speculative application by guide services could displace non-commercial users."
                                            },
                                            {
                                                "example_id": "1a5ee75b-48cc-4351-88e0-27984a55e4b6",
                                                "sense_id": "2366b562-b6a5-312d-8543-4ed909e8b39a",
                                                "text": "Relief committees are likely to administer relief in different ways and on different principles, and the knowledge of this encourages speculative applications from the poor."
                                            },
                                            {
                                                "example_id": "e179252e-9a61-4da2-b1ec-cd40cc73f9fd",
                                                "sense_id": "2366b562-b6a5-312d-8543-4ed909e8b39a",
                                                "text": "However , there is one exception to this general rule; speculative applications ( i.e. made by developers where the tenant is not yet known ) are, with some exceptions, normally refused."
                                            },
                                            {
                                                "example_id": "063be9a5-a686-457b-ad4a-5da64f7f6fab",
                                                "sense_id": "2366b562-b6a5-312d-8543-4ed909e8b39a",
                                                "text": "The history of the Auction 83 translator applications strongly supports our view that speculative applications delay the processing of bona fide applications, thereby impeding efforts to bring new service to the public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c60505-1c72-3739-9760-d2f1194cb41a",
                                        "entry_id": "e1b41cfc-e615-36f6-945d-408d17ea42d5",
                                        "glosses": [
                                            "An application or use for something that is not known to actually work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0095a0f6-4965-48ce-9d54-630db519725c",
                                                "sense_id": "86c60505-1c72-3739-9760-d2f1194cb41a",
                                                "text": "Present, future, and speculative applications are summarized in table 5.1."
                                            },
                                            {
                                                "example_id": "a94c04e0-04e6-4ade-988b-4944737e118d",
                                                "sense_id": "86c60505-1c72-3739-9760-d2f1194cb41a",
                                                "text": "Are there other speculative applications for helium which have the potential for pushing ultimate demand beyond even the highest projections in the report?"
                                            },
                                            {
                                                "example_id": "b9d3f522-ee1f-4aec-9af2-f04ebbd3799f",
                                                "sense_id": "86c60505-1c72-3739-9760-d2f1194cb41a",
                                                "text": "The abstract should not refer to purported merits or speculative applications of the invention and should not compare the invention with the prior art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
