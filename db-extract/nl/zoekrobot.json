                "senses": [
                    {
                        "sense_id": "2c8f181a-64b2-306d-8e81-48bc4c6d8a0e",
                        "entry_id": "3c5da638-4956-3acd-b4f8-398e16c772c0",
                        "glosses": [
                            "programma dat actief het internet afspeurt naar informatie en de gevonden gegevens opslaat in een database"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83daaaba-5cd0-4b41-a0e7-599b404c52a9",
                                "sense_id": "2c8f181a-64b2-306d-8e81-48bc4c6d8a0e",
                                "text": "Het Amerikaanse internetbedrijf Google heeft een test gestart waarbij gebruikers ook hun Gmail-account, Google's e-maildienst, kunnen doorzoeken met de zoekrobot."
                            },
                            {
                                "example_id": "2b369075-2615-4cd6-92cc-f8f6307ba440",
                                "sense_id": "2c8f181a-64b2-306d-8e81-48bc4c6d8a0e",
                                "text": "België investeert 22 miljoen euro in een zoekrobot om signalen van terreurdreiging of radicalisering op sociale media op te sporen. De inlichtingendiensten en de federale politie kunnen binnen een of twee jaar gebruikmaken van de software."
                            },
                            {
                                "example_id": "2398c941-5dc2-47e3-aa62-15255a4201a4",
                                "sense_id": "2c8f181a-64b2-306d-8e81-48bc4c6d8a0e",
                                "text": "Lopez leerde achteraf dat de jurk ook zorgde voor het ontstaan van Google Images. ,,Blijkbaar zochten toen zoveel mensen naar foto’s van mij in die Versace-jurk dat Google begon na te denken over een betere manier om naar beelden te zoeken via de Google-zoekrobot. En zo ontstond Google Images.”"
                            }
                        ]
                    }
