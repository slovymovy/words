                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8426b755-e2ff-4f3c-9776-a2ef6971bc3d",
                        "source_entry_id": "644989b0-41e9-3c20-a6de-92e172476f12",
                        "source_sense_id": "8fe753e5-7991-32c1-8783-bdf5a5e22b3c",
                        "target_lang_word": "overstatement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overstatement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32c0b5f3-de43-3866-a706-4f41538f7813",
                                        "entry_id": "fc8669af-5ef4-3913-9248-29e7ef78ff3b",
                                        "glosses": [
                                            "An exaggeration; a statement in excess of what is reasonable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d5be98-b172-4b88-b34f-5b22a69cc496",
                                                "sense_id": "32c0b5f3-de43-3866-a706-4f41538f7813",
                                                "text": "The story he gave was something of an overstatement of the facts."
                                            },
                                            {
                                                "example_id": "24ac2374-d7a7-4bc3-886b-cacab17894f9",
                                                "sense_id": "32c0b5f3-de43-3866-a706-4f41538f7813",
                                                "text": "It would hardly be an overstatement to describe Drummond's next design as an outstanding British locomotive class, and possibly his masterpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0112f03-dea5-353a-b5de-2c2fa10a8fed",
                                        "entry_id": "fc8669af-5ef4-3913-9248-29e7ef78ff3b",
                                        "glosses": [
                                            "The tendency to overstate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4452bc-6d58-4fd2-9718-9b4b75753ad0",
                                                "sense_id": "d0112f03-dea5-353a-b5de-2c2fa10a8fed",
                                                "text": "She had a knack for overstatement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44246405-5eb4-4685-a5c1-e9a295bd2110",
                        "source_entry_id": "644989b0-41e9-3c20-a6de-92e172476f12",
                        "source_sense_id": "8fe753e5-7991-32c1-8783-bdf5a5e22b3c",
                        "target_lang_word": "exaggeration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exaggeration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce63c27-7a39-3d09-b148-10e3821690eb",
                                        "entry_id": "fc5dc73e-542e-3e90-84d6-bbfbafad4465",
                                        "glosses": [
                                            "The act of heaping or piling up."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc4b7404-5672-3a94-95f0-4e4551c88636",
                                        "entry_id": "fc5dc73e-542e-3e90-84d6-bbfbafad4465",
                                        "glosses": [
                                            "The act of exaggerating; the act of doing or representing in an excessive manner; a going beyond the bounds of truth, reason, or justice; a hyperbolical representation; hyperbole; overstatement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3c8582-1383-4d2c-8de0-893fa75393aa",
                                                "sense_id": "dc4b7404-5672-3a94-95f0-4e4551c88636",
                                                "text": "They say he's a millionnaire, but that's a massive exaggeration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57b5989e-ed0e-3bf1-8a02-9e60d9c74065",
                                        "entry_id": "fc5dc73e-542e-3e90-84d6-bbfbafad4465",
                                        "glosses": [
                                            "A representation of things beyond natural life, in expression, beauty, power, vigor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d08c6a-5105-4758-b4c9-ba15ba645bc5",
                        "source_entry_id": "644989b0-41e9-3c20-a6de-92e172476f12",
                        "source_sense_id": "8fe753e5-7991-32c1-8783-bdf5a5e22b3c",
                        "target_lang_word": "преувеличение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "преувеличение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                        "entry_id": "7a7ccf97-377e-3d02-ac95-5e0298b48ad9",
                                        "glosses": [
                                            "действие по значению гл. преувеличить; представение чего-либо в увеличенных по сравнению с действительностью размерах, придание чему-либо чрезмерно важного значения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c719bb7-544b-4f9c-99aa-bb1779107bbe",
                                                "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                                "text": "Я начинаю подозревать, что вы склонны к преувеличению."
                                            },
                                            {
                                                "example_id": "7d7b0cf9-649f-49e9-ab23-eb2763467699",
                                                "sense_id": "15fa5139-4ee5-364c-adc7-af116d058e30",
                                                "text": "Я знаю: прочитав мой рассказ, читатель упрекнёт меня в преувеличении."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                        "entry_id": "7a7ccf97-377e-3d02-ac95-5e0298b48ad9",
                                        "glosses": [
                                            "результат такого действия, то, что представлено в чрезмерно увеличенных размерах; то, чему придано чрезмерно важное значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80943b0d-7363-4d5a-8813-02d9907dbb55",
                                                "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                                "text": "Преувеличения росли не по дням, а по часам, принимая иногда чудовищные размеры."
                                            },
                                            {
                                                "example_id": "24c507e2-bf64-46ae-8b07-397b46a30029",
                                                "sense_id": "7347f5bd-2c87-3380-93af-67e79ed2525d",
                                                "text": "Подколесин в своем типическом виде, может быть, даже и преувеличение, но отнюдь не небывальщина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
