                "senses": [
                    {
                        "sense_id": "6e42bb1f-9f23-3fc5-b283-2619074ccd2c",
                        "entry_id": "5f72f367-313c-359e-a259-b82a3f6c8c27",
                        "glosses": [
                            "mit Buchstaben, Zahlen und/oder kurzen Wörtern/Phrasen versehene Tafel, die vorgeblich dazu dient, mit Geistern zu kommunizieren"
                        ],
                        "tags": [
                            "Esoterik",
                            "Okkultismus",
                            "Spiritismus"
                        ],
                        "examples": [
                            {
                                "example_id": "e152f4ec-ac1d-44ac-993b-db8970a5defb",
                                "sense_id": "6e42bb1f-9f23-3fc5-b283-2619074ccd2c",
                                "text": "„Die beiden hatten neben ihrer Liebe und ihren literarischen Interessen auch ein Faible für das Okkulte, für spiritistische Séancen, vor allem für das Spiel mit dem Ouija-Brett, bei dem ausgeschnittene Buchstaben und ein Weinglas eine Rolle spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43c2a168-deaf-490e-8c01-bf619af6127a",
                        "source_entry_id": "5f72f367-313c-359e-a259-b82a3f6c8c27",
                        "source_sense_id": "6e42bb1f-9f23-3fc5-b283-2619074ccd2c",
