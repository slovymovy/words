                        "glosses": [
                            "Qui ressemble au style de Jean Cocteau, ou qui le concerne."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1cb965d7-018b-4453-8d66-26999e5156c9",
                                "sense_id": "60c6b83b-2945-34de-a030-e1f82fec07a1",
                                "text": "[…] le parisianisme cocteauesque et le dilettantisme mondain, tout ce petit monde grouillant et hideux des hommes de lettres vieillissants, des éphèbes arrivistes, des salonnards fin de siècle et des professionnels de la culture."
                            },
                            {
                                "example_id": "09ed4f77-e606-4e76-bb05-c46c1a4578b5",
                                "sense_id": "60c6b83b-2945-34de-a030-e1f82fec07a1",
                                "text": "Dans une curieuse et très cocteauesque séquence au début du film, les mannequins de l’échoppe où travaille le petit tailleur prennent soudainement vie et font la haie à une charmante créature brune qui s’avance majestueusement."
                            }
                        ]
                    }
