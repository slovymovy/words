        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4aef981d-bd86-3f98-b319-e20e7d890c74",
                    "sense_definition": "Относящийся к полиции, принадлежащий или свойственный ей.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Возле нашего дома остановилась <w>полицейская</w> машина с включёнными мигалками.",
                            "target_lang_translations": {
                                "en": "A <w>police</w> car with flashing lights stopped near our house.",
                                "nl": "Vlak bij ons huis stopte een <w>politieauto</w> met zwaailichten aan."
                            }
                        },
                        {
                            "text": "Вчера я ходил в <w>полицейский</w> участок, чтобы подать заявление о краже.",
                            "target_lang_translations": {
                                "en": "Yesterday I went to the <w>police</w> station to file a theft report.",
                                "nl": "Gisteren ben ik naar het <w>politiebureau</w> gegaan om aangifte te doen van diefstal."
                            }
                        }
                    ],
                    "common_phrases": [
