                                        "glosses": [
                                            "A person who fishes with a hook and line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42885a0-c9db-4f81-9576-c505dee87ff6",
                                                "sense_id": "0c9b0e17-3ceb-3f1d-b493-b1aaa5685d86",
                                                "text": "A throng of anglers lined the trout stream on opening day of trout season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c922e0b-fe18-3929-977f-f9faa060e349",
                                        "entry_id": "4b79d1f8-2809-32ff-b84f-14dec3188f80",
                                        "glosses": [
                                            "An angler fish, Lophius piscatorius."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87db3e7-1a2e-44d6-8d84-af51a262b785",
                                                "sense_id": "5c922e0b-fe18-3929-977f-f9faa060e349",
                                                "text": "The angler lured a smaller fish into reach with the appendage on its head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c92332c-cb60-353f-98a7-484c7da1a817",
                                        "entry_id": "4b79d1f8-2809-32ff-b84f-14dec3188f80",
                                        "glosses": [
                                            "Someone who tries to work an angle; a person who schemes or has an ulterior motive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015e8d45-e404-40b8-84ff-bc5e70c27c89",
                                                "sense_id": "7c92332c-cb60-353f-98a7-484c7da1a817",
                                                "text": "Jonas was a consummate angler when it came the company's leave policy; he had it figured so he only needed to work six months out of the year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e6768e-db8a-39c6-90d1-0c11e5274a33",
                                        "entry_id": "4b79d1f8-2809-32ff-b84f-14dec3188f80",
                                        "glosses": [
                                            "A thief who uses a hooked stick to steal goods out of shop-windows, grates, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2967e5ca-4d73-46a0-923c-3259dfca0a53",
                                                "sense_id": "d4e6768e-db8a-39c6-90d1-0c11e5274a33",
                                                "text": "They are sure to be clyd in the night by the angler, or hooker, or such like pilferers that liue upon the spoyle of other poore people."
                                            },
                                            {
                                                "example_id": "49a9d310-8268-4989-9c71-d1a2ce06118d",
                                                "sense_id": "d4e6768e-db8a-39c6-90d1-0c11e5274a33",
                                                "text": "Rogue or rascal, frater, maunderer, / Irish Toyle, or other wanderer; / No dimber damber, angler, dancer, / Prig of cackler, prig of prancer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
