                ],
                "senses": [
                    {
                        "sense_id": "fc97be3d-745d-3f23-a636-57f4ff8b430c",
                        "entry_id": "e3e41111-fab4-391f-b520-8ae56f36a75f",
                        "glosses": [
                            "Chromosome dissemblable par rapport à son homologue."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "ac52b87a-7611-450d-b4e1-6d37afb4a0f9",
                                "sense_id": "fc97be3d-745d-3f23-a636-57f4ff8b430c",
                                "text": "Il est impossible de considérer les structures sexuelles comme le résultat d’une série de mutations dont l’hétérochromosome conserverait le pattern."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e01e63c-c86f-40f3-8bbf-1fbab892687d",
                        "source_entry_id": "e3e41111-fab4-391f-b520-8ae56f36a75f",
                        "source_sense_id": "fc97be3d-745d-3f23-a636-57f4ff8b430c",
                        "target_lang_word": "Heterochromosom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heterochromosom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6504eb-bee0-38e4-83bc-6aeece2449a7",
                                        "entry_id": "3bb24a00-8260-394b-ac7d-6e9ded257b8f",
                                        "glosses": [
                                            "geschlechtsbestimmendes Chromosom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253aab54-9667-4b82-8133-88a651773d18",
                                                "sense_id": "ba6504eb-bee0-38e4-83bc-6aeece2449a7",
                                                "text": "„Von den 23 Chromosomenpaaren werden die ersten 22 als Autosome oder Autosomen bezeichnet, das letzte Paar (Sexchromosomen) als Gonosomen oder Heterochromosomen.“"
                                            },
                                            {
                                                "example_id": "f1cb00cb-9947-40e5-96b9-eeff60ca9527",
                                                "sense_id": "ba6504eb-bee0-38e4-83bc-6aeece2449a7",
                                                "text": "„Die Geschichte der Heterochromosomen ist trotz vieler sehr gründlicher Untersuchungen in mancher Hinsicht noch wenig aufgeklärt, insbesondere besitzen wir nur sehr wenige Angaben über das Auftreten und Verhalten dieser Gebilde außerhalb der Vermehrungs- und Reifungsperiode, speziell auch in den früheren Etappen der Keimbahn und in den somatischen Zellen.“"
                                            },
                                            {
                                                "example_id": "ead92380-90f8-48d1-b7a1-978b7117cf18",
                                                "sense_id": "ba6504eb-bee0-38e4-83bc-6aeece2449a7",
                                                "text": "„Da weder Heterokinese noch ein Dimorphismus der Spermidenkerne nachzuweisen sind, so ist das hypothetische Heterochromosom als Chromosomenpaar mit gleich grossen Komponenten zu betrachten, wofür auch seine mitunter zu beobachtende Vierergruppenform spricht.“"
                                            },
                                            {
                                                "example_id": "e7f1ed37-b37a-4764-8fd8-8e9e590b0d46",
                                                "sense_id": "ba6504eb-bee0-38e4-83bc-6aeece2449a7",
                                                "text": "„Je nachdem nun die Eier von einem Samenfaden mit oder ohne Heterochromosom befruchtet werden, entwickeln sich aus ihnen weibliche oder männliche Individuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
