{
    "word_family": [
        "пыл",
        "пылкий"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6dc877e2-5597-386c-a928-013041356b38",
                    "sense_definition": "Ярко, жарко, с большой интенсивностью (об огне, свете или температуре).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солнце <w>пылко</w> светило в окна, наполняя комнату невыносимым зноем.",
                            "target_lang_translations": {
                                "pl": "Słońce <w>gorąco</w> świeciło w okna, wypełniając pokój nieznośnym upałem."
                            }
                        },
                        {
                            "text": "Костер <w>пылко</w> разгорался, освещая лица людей в темном лесу.",
                            "target_lang_translations": {
                                "pl": "Ognisko <w>żarliwie</w> się rozpalało, oświetlając twarze ludzi w ciemnym lesie."
                            }
                        }
                    ],
                    "synonyms": [
                        "ярко",
                        "жарко"
                    ],
                    "antonyms": [
                        "тускло",
                        "холодно"
                    ],
                    "common_phrases": [
                        "пылко светить",
                        "пылко гореть"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jasno, gorąco, z dużą intensywnością (o ogniu, świetle lub temperaturze)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "żarliwie",
                                "target_lang_sense_clarification": "w kontekście intensywnego żaru lub ognia"
                            },
                            {
                                "target_lang_word": "gorąco",
                                "target_lang_sense_clarification": "w odniesieniu do wysokiej temperatury lub intensywnego światła"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3ea1fc8-036b-361c-aa74-c694cdcc412e",
                    "sense_definition": "Страстно, с сильным душевным подъемом или жаром.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оратор <w>пылко</w> защищал свои убеждения перед собравшейся толпой.",
                            "target_lang_translations": {
                                "pl": "Mówca <w>żarliwie</w> bronił swoich przekonań przed zgromadzonym tłumem."
                            }
                        },
                        {
                            "text": "Молодой человек <w>пылко</w> признался в своих чувствах любимой девушке.",
                            "target_lang_translations": {
                                "pl": "Młody człowiek <w>namiętnie</w> wyznał swoje uczucia ukochanej dziewczynie."
                            }
                        }
                    ],
                    "synonyms": [
                        "пламенно",
                        "страстно",
                        "горячо"
                    ],
                    "antonyms": [
                        "бесстрастно"
                    ],
                    "common_phrases": [
                        "пылко спорить",
                        "пылко доказывать"
                    ],
                    "target_lang_definitions": {
                        "pl": "Namiętnie, z silnym uniesieniem duchowym lub zapałem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "żarliwie",
                                "target_lang_sense_clarification": "z wielkim zapałem i emocjonalnym zaangażowaniem"
                            },
                            {
                                "target_lang_word": "gorliwie",
                                "target_lang_sense_clarification": "z dużą energią i oddaniem sprawie"
                            },
                            {
                                "target_lang_word": "namiętnie",
                                "target_lang_sense_clarification": "w kontekście silnych uczuć osobistych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b55e5c5-88d8-368d-bdf8-971717fd2ca9",
                    "sense_definition": "Краткая форма среднего рода от прилагательного <w>пылкий</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его признание было <w>пылко</w> и искренне.",
                            "target_lang_translations": {
                                "pl": "Jego wyznanie było <w>żarliwe</w> i szczere."
                            }
                        },
                        {
                            "text": "Сердце юноши было <w>пылко</w> и открыто для новых впечатлений.",
                            "target_lang_translations": {
                                "pl": "Serce młodzieńca było <w>żarliwe</w> i otwarte na nowe wrażenia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma krótka przymiotnika 'żarliwy' w rodzaju nijakim."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "żarliwe",
                                "target_lang_sense_clarification": "odpowiednik przymiotnika w rodzaju nijakim"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}