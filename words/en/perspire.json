{
    "word_family": [
        "perspiration",
        "perspiratory",
        "unperspiring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cde55e5a-cceb-32ed-a25a-562b471f0a97",
                    "sense_definition": "To emit sweat through the pores of the skin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat caused everyone in the room to <w>perspire</w> heavily.",
                            "target_lang_translations": {
                                "es": "El intenso calor hizo que todos en la habitación <w>transpiraran</w> copiosamente."
                            }
                        },
                        {
                            "text": "He began to <w>perspire</w> nervously as he waited to give his presentation.",
                            "target_lang_translations": {
                                "es": "Empezó a <w>sudar</w> con nerviosismo mientras esperaba para dar su presentación."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweat"
                    ],
                    "common_phrases": [
                        "perspire heavily",
                        "perspire freely"
                    ],
                    "target_lang_definitions": {
                        "es": "Segregar sudor a través de los poros de la piel."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "transpirar",
                                "target_lang_sense_clarification": "dicho de una persona, expeler sudor"
                            },
                            {
                                "target_lang_word": "sudar",
                                "target_lang_sense_clarification": "expeler sudor por la piel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b21f02e-5ace-33f2-b84e-d2def9d1784d",
                    "sense_definition": "Of a fluid, to be excreted or exuded through the pores of the skin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine encouraged moisture to <w>perspire</w> through the skin.",
                            "target_lang_translations": {
                                "es": "El medicamento favoreció que la humedad se <w>exudara</w> a través de la piel."
                            }
                        },
                        {
                            "text": "Small droplets of fluid <w>perspire</w> during the physiological reaction.",
                            "target_lang_translations": {
                                "es": "Pequeñas gotitas de líquido <w>rezuman</w> durante la reacción fisiológica."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dicho de un líquido o humedad, salir o filtrarse a través de los poros de la piel o de otra superficie."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rezumar",
                                "target_lang_sense_clarification": "salir un líquido poco a poco a través de poros"
                            },
                            {
                                "target_lang_word": "exudar",
                                "target_lang_sense_clarification": "salir al exterior un líquido por poros"
                            },
                            {
                                "target_lang_word": "transpirar",
                                "target_lang_sense_clarification": "evaporarse o salir humedad a través de poros"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9453984f-11b7-3a96-84d5-545ce2c81ae7",
                    "sense_definition": "To cause someone to sweat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The humid afternoon air <w>perspired</w> the travelers walking along the road.",
                            "target_lang_translations": {
                                "es": "El aire húmedo de la tarde <w>hizo sudar</w> a los viajeros que caminaban por la carretera."
                            }
                        },
                        {
                            "text": "The strenuous uphill climb <w>perspired</w> the hikers within minutes.",
                            "target_lang_translations": {
                                "es": "La extenuante subida cuesta arriba <w>hizo transpirar</w> a los excursionistas en cuestión de minutos."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer que alguien sude."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacer sudar",
                                "target_lang_sense_clarification": "provocar la sudoración de alguien"
                            },
                            {
                                "target_lang_word": "hacer transpirar",
                                "target_lang_sense_clarification": "causar transpiración en alguien"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}