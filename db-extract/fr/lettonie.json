            {
                "entry_id": "f3add9e3-7d74-37c3-bcc2-fe251d5d6bcf",
                "word": "Lettonie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72ede650-6345-3d8a-8140-f7df6400137e",
                        "entry_id": "f3add9e3-7d74-37c3-bcc2-fe251d5d6bcf",
                        "glosses": [
                            "Pays d’Europe orientale, bordé par l’Estonie au nord, la Russie à l’est, la Lituanie au sud-ouest, la Biélorussie au sud-est, et la mer Baltique à l’ouest, et dont la capitale est Riga."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "93ea0cd8-de3d-467a-999d-bdd354a8721e",
                                "sense_id": "72ede650-6345-3d8a-8140-f7df6400137e",
                                "text": "Le géant gazier russe Gazprom a annoncé, samedi, avoir suspendu ses livraisons de gaz à la Lettonie, sur fond de tensions russo-occidentales en raison du conflit en Ukraine et des sanctions européennes sans précédent contre la Russie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "160a76da-5e94-48ac-ba0b-d8443d16c3eb",
                        "source_entry_id": "f3add9e3-7d74-37c3-bcc2-fe251d5d6bcf",
                        "source_sense_id": "72ede650-6345-3d8a-8140-f7df6400137e",
                        "target_lang_word": "Lettland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lettland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                        "entry_id": "4fd9679a-9f05-3fa6-99fe-ac81e32f17de",
                                        "glosses": [
                                            "europäisches Land im Baltikum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd6edef-5fe5-458c-a80c-c764d507c14b",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Lettland zählt zum Baltikum."
                                            },
                                            {
                                                "example_id": "1e4dbdc1-8ec8-432b-a20e-08cc3179f728",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Lettlands Hauptstadt ist Riga."
                                            },
                                            {
                                                "example_id": "52ef8755-4186-417d-9904-218326c0110c",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "Um das Lettland der Künstler zu finden, musst Du an den richtigen Stellen suchen."
                                            },
                                            {
                                                "example_id": "8f0dab6e-b7f3-40cc-91c4-7b7aa21c40dd",
                                                "sense_id": "0603e3bf-b29b-3ed1-90c0-3d54e6438ba8",
                                                "text": "„Sie fuhr nach Lettland zu meiner Frau, die damals dort studierte, und wohnte mit ihr in einem winzigen Zimmerchen unter unmöglichen Bedingungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a12d2129-c78a-4502-acc2-824ad59908e8",
                        "source_entry_id": "f3add9e3-7d74-37c3-bcc2-fe251d5d6bcf",
