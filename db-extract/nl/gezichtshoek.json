                    {
                        "translation_id": "7cc4e5ed-fbc0-47ac-b264-19e5e4d64371",
                        "source_entry_id": "d8c0e1c6-d601-3d4f-9589-e9a9c83f0f66",
                        "source_sense_id": "001385e1-d83b-3077-9225-5e8a32edc20d",
                        "source_sense_description": "de ruimtelijke hoek waaronder beeldschermen en displays van apparaten zijn af te lezen",
