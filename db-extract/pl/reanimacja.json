                                                "example_id": "62312ab9-f263-4729-bcaa-9bb545b5a7a2",
                                                "sense_id": "5a49a835-6b07-326a-a764-998a9f84136b",
                                                "text": "It is hard to sell a democratic partnership of nations from a stall that only stocks Conservative governments. Unionism needs a Labour revival in England."
                                            }
