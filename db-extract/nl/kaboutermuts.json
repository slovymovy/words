                        "entry_id": "b1bf8030-0946-3589-ae3d-4c093aa1a1fe",
                        "glosses": [
                            "spits toelopend hoofddeksel van textiel, zoals dat door kleine mensachtige sprookjesfiguren wordt gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cffb8a3-4afa-4422-abbb-f799f5b00091",
                                "sense_id": "4ccc3261-2c78-37b5-afe1-86b2df0962e9",
                                "text": "Hebben de jongens van Busch ook nog naar alle kanten uitstekende haren, Puckchen en Muckchen dragen een bolle muts en een ‘echte’ puntige kaboutermuts."
                            },
                            {
                                "example_id": "f376ea22-d2a3-4d50-8e25-e03e1a310e7a",
                                "sense_id": "4ccc3261-2c78-37b5-afe1-86b2df0962e9",
                                "text": "Om met een geest in contact te komen en aldus een ‘alfcappe’ of kaboutermuts te bemachtigen, gaat men op de kerstnacht naar een kerk, maar, zoals in de nota op het einde van de tekst wordt gezegd, kan men hetzelfde ‘experiment’ ook nog op drie andere hoogdagen in het jaar uitvoeren."
                            }
                        ]
                    }
