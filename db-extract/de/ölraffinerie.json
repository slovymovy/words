                "senses": [
                    {
                        "sense_id": "083d495f-3dbc-3f5e-a22b-7e7639c52a4a",
                        "entry_id": "13f900f1-a353-3d12-96f9-a692aa4dc3c8",
                        "glosses": [
                            "Anlage zur Verarbeitung von Erdöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c303144c-e386-4412-a6bf-93ef918b05a1",
                                "sense_id": "083d495f-3dbc-3f5e-a22b-7e7639c52a4a",
                                "text": "„Sie hatte die Kriege von 1967 und 1973 erlebt, als israelische Bomben die Ölraffinerie in Homs in die Luft jagten.“"
                            },
                            {
                                "example_id": "85e0f8bf-bdf5-4fb1-b921-096dd3fe9cc7",
                                "sense_id": "083d495f-3dbc-3f5e-a22b-7e7639c52a4a",
                                "text": "„Prante erinnerte sich, am Morgen desselben Tages kurz in Mains Haus gewesen zu sein, als er von einem Bewerbungsgespräch bei der örtlichen Ölraffinerie zurückgekommen war, sagte jedoch, er sei früh wieder gegangen, da er noch andere Job-Interviews hatte.“"
                            }
                        ],
