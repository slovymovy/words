                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f34d98-8bad-45b0-82fe-1f925fd00b6e",
                                "sense_id": "26d36f51-bfd6-333a-abdb-ea74fab59af2",
                                "text": "Les anoblis, les nouveaux anoblis sont quelquefois plus fiers que les anciens nobles."
                            },
                            {
                                "example_id": "f6238161-d74a-499e-8a76-df9b3162fc93",
                                "sense_id": "26d36f51-bfd6-333a-abdb-ea74fab59af2",
                                "text": "La plupart sont des anoblis, car, le principe étant qu’un magistrat doit être noble, il faut en anoblir le candidat par sa fonction ou prendre un anobli."
                            }
                        ]
                    }
