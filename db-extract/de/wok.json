                                        "sense_id": "f8440279-d00c-31dc-a74c-ff621596234f",
                                        "entry_id": "6e6c97e7-fd84-33a5-b068-84360f3108ff",
                                        "glosses": [
                                            "Ustensile de cuisson de forme hémisphérique, comparable à, mais plus profond qu'une grande poêle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ac48c5-a4e4-4783-900c-fd1cc31175cb",
                                                "sense_id": "f8440279-d00c-31dc-a74c-ff621596234f",
                                                "text": "J’aime mieux faire revenir les légumes dans le wok."
                                            },
                                            {
                                                "example_id": "31f86ed2-205f-4fa2-add3-9019f3b70583",
                                                "sense_id": "f8440279-d00c-31dc-a74c-ff621596234f",
                                                "text": "Ajouter à la sauce le riz et les nouilles aux œufs préalablement cuits et secouer énergiquement. Toute la clé de la recette tient à la secousse du wok - constamment projetés et agités, le riz et les nouilles ne collent pas, tandis que l’huile et les saveurs se répartissent uniformément sur les ingrédients."
                                            }
                                        ]
                                    }
                                ]
                            }
