                ],
                "senses": [
                    {
                        "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                        "glosses": [
                            "entscheidende Machtprobe, Kraftprobe zwischen zwei Kontrahenten, die zum endgültigen Untergang, zur endgültigen Vernichtung eines der beiden führt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "b2119da1-36a6-4614-a9da-6c1957e860ee",
                                "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                                "text": "„Im Vatikan bahnt sich ein Showdown zwischen dem Bischof von Limburg Franz-Peter Tebartz-van Elst und dem Vorsitzenden der Deutschen Bischofskonferenz Erzbischof Robert Zollitsch an.“"
                            },
                            {
                                "example_id": "a356bcf7-6a98-4f29-9ae1-f760b1742888",
                                "sense_id": "515cdf52-c08e-3baa-974c-ca5aa69af663",
                                "text": "„Am 12. Oktober 1999 kam es zum Showdown: Nawaz Sharif verweigerte Musharraf, der sich an Bord einer regulären Passagiermaschine der pakistanischen Fluggesellschaft PIA auf der Rückreise von Sri Lanka befand, die Einreise nach Pakistan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a804577-3d55-3309-8b27-7162ab0097f1",
                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                        "glosses": [
                            "Aufdecken der Karten, nachdem zwei oder mehr Spieler den gleichen Betrag gesetzt haben, um den Sieger der Runde zu ermitteln"
                        ],
                        "tags": [
                            "Poker"
                        ],
                        "examples": [
                            {
                                "example_id": "d7f3e827-17c7-440a-afb1-f0b4ac67b7fe",
                                "sense_id": "7a804577-3d55-3309-8b27-7162ab0097f1",
                                "text": "„In vier von fünf Spielen steigt der Profi gleich zu Beginn aus, weil ihm die Karten zu schlecht sind. Sehr selten kommt es unter Könnern überhaupt zum Showdown, bei dem am Ende alle ihr Blatt aufdecken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4432b60b-c996-3138-970d-bdf883c8d43d",
                        "entry_id": "6e328e82-5d1f-3593-b184-147461b39b64",
                        "glosses": [
                            "letzte, entscheidende Auseinandersetzung zwischen den (beiden) Helden, die meist blutig endet"
                        ],
                        "tags": [
                            "in Filmen",
                            "besonders Wildwestfilmen"
                        ],
                        "examples": [
                            {
                                "example_id": "3187a5ce-4a72-4f80-b22f-b702e8d852c1",
                                "sense_id": "4432b60b-c996-3138-970d-bdf883c8d43d",
                                "text": "„So behäbig wie der ganze Film verläuft dann auch der Showdown. Quälend, roh und direkt ballern die Männer so lange aufeinander, bis der Gegner tot zusammenbricht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
