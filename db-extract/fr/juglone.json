                        "sense_id": "2f98ce37-23c9-313a-a239-a9266d8ed024",
                        "entry_id": "367f20cd-249c-3893-9ec0-8795b208946b",
                        "glosses": [
                            "Substance cristalline extraite du brou de noix (5-hydroxy-1,4-naphtoquinone)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2cace99-6a54-4fd0-949a-a8a08cef2d85",
                                "sense_id": "2f98ce37-23c9-313a-a239-a9266d8ed024",
                                "text": "la juglandine ou juglone… Elle est utilisée en dermatologie car elle est antiseptique et astringente, kératinisante et analgésique, bref elle soigne les inflammations de la peau comme l’eczéma, le psoriasis ou l’impétigo, en ôtant la douleur et en éloignant les microbes."
                            },
                            {
                                "example_id": "7192d0b9-39b5-4855-ad70-d05bf3a45812",
                                "sense_id": "2f98ce37-23c9-313a-a239-a9266d8ed024",
                                "text": "Mais la plante qui se cache sous le nom juglone ne saute pas aux yeux. Un ancien nom donné à cette substance, nucine, est plus parlant : il fait penser à la noix, en latin \"nux\", \"nucis\"."
                            }
                        ]
                    }
