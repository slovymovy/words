                        "glosses": [
                            "The state of being a saint."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe7c12be-abe9-497d-aeff-b18898149f03",
                                "sense_id": "ab4a5cd9-9b61-3ce2-860f-4be9d87615a8",
                                "text": "He passed over several archbishops who would traditionally become cardinals to promote Gregory. He also moved Augustine Tolton, who died in 1897 after becoming the first African American priest, one step closer to sainthood."
                            },
                            {
                                "example_id": "390c0991-a3d5-48fe-b2b7-4b5d269e0397",
                                "sense_id": "ab4a5cd9-9b61-3ce2-860f-4be9d87615a8",
                                "text": "Prospective candidates for sainthood normally need to have two miracles attributed to them before they can be canonized."
                            }
                        ]
                    },
