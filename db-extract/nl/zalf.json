                ],
                "translations": [
                    {
                        "translation_id": "cedb2bde-fae2-483d-a54a-053d22b33412",
                        "source_entry_id": "45dfb692-5000-3c4b-8ac0-d1e4c74b9d08",
                        "source_sense_description": "smeerbare massa om op de huid aan te brengen",
                        "target_lang_word": "Salbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d74b3c8d-4f81-358d-b884-3aefde37218e",
                                        "entry_id": "3f68a5e2-c7ec-32ff-a99e-299b2fc3dd42",
                                        "glosses": [
                                            "eine halbfeste und homogen aussehende Arzneizubereitung, die zur Anwendung auf der Haut oder auf den Schleimhäuten bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bc1208-690d-4087-8c4b-e513c37cb7ee",
                                                "sense_id": "d74b3c8d-4f81-358d-b884-3aefde37218e",
                                                "text": "Der Arzt hat mir für meinen Hautausschlag eine Salbe verschrieben."
                                            },
                                            {
                                                "example_id": "f61db22a-4a1b-4a72-83c0-b3062fac92de",
                                                "sense_id": "d74b3c8d-4f81-358d-b884-3aefde37218e",
                                                "text": "„Nachdem er sich balbiert und die Perücke gekämmt, sich mit Salben und wohlduftenden Essenzen behandelt, wie es sich für einen vornehmen Mann geziemt, begann er, nach isländischem Brauch, aus einer großen Pfeife rauchend, auf und ab zu gehen.“"
                                            },
                                            {
                                                "example_id": "0ba7d64d-bda3-4700-a596-6b87a75d11be",
                                                "sense_id": "d74b3c8d-4f81-358d-b884-3aefde37218e",
                                                "text": "„Sylvias Hände rissen in der Kälte immer wieder ein und bluteten, bis ein nettes ungarisches Mädchen ihr eine Dose mit Salbe gab, die nach Schafspisse roch, aber ihre Haut während der Wintermonate schützte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e734c91-1169-4a50-91ae-dfeb65e9761e",
                        "source_entry_id": "45dfb692-5000-3c4b-8ac0-d1e4c74b9d08",
                        "source_sense_description": "smeerbare massa om op de huid aan te brengen",
                        "target_lang_word": "salve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e32676a-7e23-3af3-977a-f6bc817766c0",
                                        "entry_id": "0cd4fc18-8213-309b-a692-acd4e8748e28",
                                        "glosses": [
                                            "An ointment, cream, or balm with soothing, healing, or calming effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9032929e-4147-3170-8b51-e35cc5aaf71e",
                                        "entry_id": "0cd4fc18-8213-309b-a692-acd4e8748e28",
                                        "glosses": [
                                            "Any remedy or action that soothes or heals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808475e6-e6a0-4b8f-a151-fcc03c81625e",
                                                "sense_id": "9032929e-4147-3170-8b51-e35cc5aaf71e",
                                                "text": "Your forgiveness was a salve to my conscience and a balm to my wounded ego."
                                            },
                                            {
                                                "example_id": "9e100bdb-62d4-4892-8d97-00d4838f39b6",
                                                "sense_id": "9032929e-4147-3170-8b51-e35cc5aaf71e",
                                                "text": "[Title:] Tame March PCE inflation no salve after downbeat Q1 US GDP report"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "778c3ad0-6e34-3763-b67a-4384f4fb4d91",
                                        "entry_id": "4f926267-c6be-3273-8532-8ae3ef9ca118",
                                        "glosses": [
                                            "To calm or assuage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e510f53-04ec-49ef-aa5d-41af3041032a",
                                                "sense_id": "778c3ad0-6e34-3763-b67a-4384f4fb4d91",
                                                "text": "She feels guilty for pampering him, and salves her conscience by bossily ordering him to go and fetch the clothes from the line[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d36a90-4b1f-3fed-85ff-00fb5e79dc36",
                                        "entry_id": "4f926267-c6be-3273-8532-8ae3ef9ca118",
                                        "glosses": [
                                            "To heal by applications or medicaments; to apply salve to; to anoint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a9b468-e4c3-43ee-83b6-d6caf3f83546",
                                                "sense_id": "67d36a90-4b1f-3fed-85ff-00fb5e79dc36",
                                                "text": "I do beseech your majesty […] salve the long-grown wounds of my intemperance.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba67c80-91f3-3f07-8232-d979dfadc0a4",
                                        "entry_id": "4f926267-c6be-3273-8532-8ae3ef9ca118",
                                        "glosses": [
                                            "To heal; to remedy; to cure; to make good."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e07b7440-c3d3-4b89-9de2-18a74a1f7401",
                                                "sense_id": "6ba67c80-91f3-3f07-8232-d979dfadc0a4",
                                                "text": "But Ebranck salved both their infamies / With noble deedes."
                                            },
                                            {
                                                "example_id": "f65b5825-08ee-41f2-8331-0f7a657f5f17",
                                                "sense_id": "6ba67c80-91f3-3f07-8232-d979dfadc0a4",
                                                "text": "What may we do, then, to salve this seeming inconsistence?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "967f787e-a934-345e-a237-fc35e4f0272d",
                                        "entry_id": "4f926267-c6be-3273-8532-8ae3ef9ca118",
                                        "glosses": [
                                            "To salvage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4b47ad-f27c-4ca5-bfc0-68075defe191",
                                                "sense_id": "967f787e-a934-345e-a237-fc35e4f0272d",
                                                "text": "The interior woodwork was largely salved from the two cars, as well as the majority of the fittings and seats."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "166433ba-a32e-3455-ae95-1959534f2487",
                                        "entry_id": "f3b82e2b-522e-32c9-b5bc-81488f6c5005",
                                        "glosses": [
                                            "To save (the appearances or the phenomena); to explain (a celestial phenomenon); to account for (the apparent motions of the celestial bodies)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "180a7ca1-48ab-3821-88be-aac6ca2202f1",
                                        "entry_id": "f3b82e2b-522e-32c9-b5bc-81488f6c5005",
                                        "glosses": [
                                            "To resolve (a difficulty); to refute (an objection); to harmonize (an apparent contradiction)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63049fe-6e67-4e56-8caf-9e6e4904fc04",
                                                "sense_id": "180a7ca1-48ab-3821-88be-aac6ca2202f1",
                                                "text": "He which should hold it more rational to make the whole Universe move, and thereby to salve the Earths mobility, is more unreasonable...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89022f06-29f8-37c2-84ff-884b9c94b8a6",
                                        "entry_id": "f3b82e2b-522e-32c9-b5bc-81488f6c5005",
