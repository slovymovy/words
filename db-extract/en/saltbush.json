                "senses": [
                    {
                        "sense_id": "f3103130-e06e-31b6-af66-c381e89cd452",
                        "entry_id": "c54599e0-5a30-33da-b7ac-4e38465ddad3",
                        "glosses": [
                            "Any of the genus Atriplex of plants, especially Atriplex hortensis or Atriplex patula, found in dry habitats, that have edible leaves resembling spinach, including many desert and seashore plants and halophytes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "111ddda5-0fb8-4819-a1ba-b6a301a13f3d",
                                "sense_id": "f3103130-e06e-31b6-af66-c381e89cd452",
                                "text": "The sand is cold beneath our bare feet and the dunes damp and spicy with marram grass and saltbush."
                            },
                            {
                                "example_id": "b96e4512-fa4d-41ce-a864-da2c8a1a5e67",
                                "sense_id": "f3103130-e06e-31b6-af66-c381e89cd452",
                                "text": "The blasting music, not reduced one notch, continues to flow beautifully into the static of the surrounding saltbush, conveying the aura of the religiously spiritual in all worlds."
                            }
                        ]
                    },
