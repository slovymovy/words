                ],
                "senses": [
                    {
                        "sense_id": "a5ba8792-6937-307a-b5b1-dcb3f2ca1217",
                        "entry_id": "ba9b12c9-f43b-3e11-b320-9e4b8fcf9ad4",
                        "glosses": [
                            "An inhabitant of the planet Mercury."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d9957f84-e7bf-33ea-ac62-26c50e23bbd5",
                        "entry_id": "ba9b12c9-f43b-3e11-b320-9e4b8fcf9ad4",
                        "glosses": [
                            "One who is mercurial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e5a2fd-80a3-4931-a874-a3ddaf1b5429",
                                "sense_id": "d9957f84-e7bf-33ea-ac62-26c50e23bbd5",
                                "text": "When a Mercurian is connected with the arts, it is often possible to discern a lack of the heavy, thoroughgoing seriousness which some artists seem to feel is the least that life deserves."
                            },
                            {
                                "example_id": "db1de745-1c8f-4632-9212-248e9a29282d",
                                "sense_id": "d9957f84-e7bf-33ea-ac62-26c50e23bbd5",
                                "text": "The thumb of a Mercurian has a tendency to be stiff, as they love money and may have difficulty sharing it."
                            },
                            {
                                "example_id": "aee39d4e-dd5e-4627-a19e-8e6e483e29e2",
                                "sense_id": "d9957f84-e7bf-33ea-ac62-26c50e23bbd5",
                                "text": "Unfortunately yellow color is not unusual to find in the palm of a Mercurian."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16e30ef3-c4da-4340-b501-ee7616c0effe",
                        "source_entry_id": "ba9b12c9-f43b-3e11-b320-9e4b8fcf9ad4",
                        "source_sense_description": "someone from Mercury",
                        "target_lang_word": "Mercurien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mercurien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "748161d5-394f-3631-a5b7-3431bec96772",
                                        "entry_id": "a63628ab-9331-3c39-8eec-df4871d4c953",
                                        "glosses": [
                                            "Habitant imaginaire de la planète Mercure."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2663c019-585e-4617-85dd-88a2137a3c14",
                                                "sense_id": "748161d5-394f-3631-a5b7-3431bec96772",
                                                "text": "Le docteur Pétrus Goodsense […] a tellement perfectionné le télescope d’Herschell, qui ne grossit que de douze mille fois, qu’il est presque parvenu à lire les affiches de comédie et celles des biens à vendre dans les différentes planètes, où il y a des villes bâties et habitées, comme on le sait depuis le voyage de Cyrano de Bergerac dans la lune, et depuis celui de Micromégas et de l’habitant de Saturne […] Les Mercuriens n’admettent point de degrés dans les qualités qu’ils attribuent aux choses et aux personnes ; ils ne se servent que du superlatif. […] On s’attend bien qu’avec ce goût décidé pour l’exagération, les Mercuriens doivent avoir celui de l’inconstance ; car rien de ce qui est violent ne peut durer ; et il est nécessaire que des esprits toujours excessifs soient ballottés d’excès en excès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
