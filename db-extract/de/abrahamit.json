                "senses": [
                    {
                        "sense_id": "57d2d802-46e3-32cc-9333-c73d2efe8efc",
                        "entry_id": "e8b3052c-edc3-3d37-8c10-9cd0650234a4",
                        "glosses": [
                            "Anhänger der abrahamitischen Religionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bfe9ce-eecf-4726-bfee-871597cc28c2",
                                "sense_id": "57d2d802-46e3-32cc-9333-c73d2efe8efc",
                                "text": "Die Abrahamiten glauben nur an einen Gott."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf345e62-3fb9-3a8b-93c5-5c448dab3db0",
                        "entry_id": "e8b3052c-edc3-3d37-8c10-9cd0650234a4",
                        "glosses": [
                            "Anhänger der syrischen Sekte Abrahams von Antiochien im 9. Jahrhundert, die die Gottheit Christi leugnete"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8a29bca2-0ec1-44ef-8e6f-04086421d362",
                                "sense_id": "bf345e62-3fb9-3a8b-93c5-5c448dab3db0",
                                "text": "Die syrische Sekte der Abrahamiten leugnete die Gottheit Christi."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ec37f14a-753b-3733-aae4-3dc1069ff406",
                        "entry_id": "e8b3052c-edc3-3d37-8c10-9cd0650234a4",
                        "glosses": [
                            "Anhänger der Bauernsekte Böhmens im 18. Jahrhundert, die den kirchlichen Gottesdienst und fast alle christlichen Dogmen verwarf und nur an den Glauben Abrahams vor seiner Beschneidung glaubt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "127499b5-2b15-4bda-8df4-0fffee68fa97",
                                "sense_id": "ec37f14a-753b-3733-aae4-3dc1069ff406",
                                "text": "„Wie wenig noch allenthalben die Begriffe von der wahren Toleranz und von den unwidersprechlichen Rechten der Menschheit, in Absicht auf Glaubenssachen aufgeklärt sind, davon giebt die Geschichte von den Abrahamiten, Israeliten oder Deisten in Böhmen, ein trauriges Beyspiel.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
