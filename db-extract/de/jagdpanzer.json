                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c8cc71-60ab-42da-8d6a-5f9790dbdcb8",
                        "source_entry_id": "9c4e28c9-beb9-3c8f-b44a-211c3924af7b",
                        "source_sense_id": "92b79a24-56c6-3072-8ab6-84e425756e4d",
                        "source_sense_description": "Heer: Panzer, der vor allem für den Kampf gegen feindliche Panzer ausgerüstet ist",
                        "target_lang_word": "chasseur de chars",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasseur de chars",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3079d30-e2f3-3208-a424-eaef46e97375",
                                        "entry_id": "a394059e-c47c-3560-b181-796250330c28",
                                        "glosses": [
                                            "Véhicule automoteur équipé d’un armement suffisamment puissant (canon ou missiles) pour détruire les blindés ennemis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec6d1b3e-8dcd-404f-b0c9-4bf193d55485",
                                                "sense_id": "d3079d30-e2f3-3208-a424-eaef46e97375",
                                                "text": "Tandis que d’autres chars arrivaient, un chasseur de chars américain autotracté en mit successivement sept hors de combat mais cinq autres continuèrent à avancer vers les bâtiments de Dom. Bütgenbach."
                                            },
                                            {
                                                "example_id": "b104eb4f-606c-42b3-afc9-dd2abdf8c0b5",
                                                "sense_id": "d3079d30-e2f3-3208-a424-eaef46e97375",
                                                "text": "Quant aux Français,ils sont stoppés dans leur élan par l’armistice, le projet de chasseur de char, conçu à partir du tracteur de ravitaillement Lorraine 37L, n’aboutissant pas en raison de la défaite de 1940."
                                            },
                                            {
                                                "example_id": "b8d78bde-1c7e-42b8-b344-e862d49338d4",
                                                "sense_id": "d3079d30-e2f3-3208-a424-eaef46e97375",
                                                "text": "La classe des chasseurs de chars a connu son heure de gloire pendant la Seconde Guerre mondiale, où de nombreux véhicules improvisés ou spécifiquement conçus dans ce but étaient envoyés combattre des hordes apparemment inarrêtables de panzers allemands (et vice versa, avec les hordes de tanks de l’armée rouge lors de la deuxième partie de la guerre)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
