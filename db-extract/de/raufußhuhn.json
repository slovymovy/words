                "senses": [
                    {
                        "sense_id": "1472225b-c22b-356a-b702-07b95078967d",
                        "entry_id": "9c2e8859-56de-338f-805c-855130a1ea02",
                        "glosses": [
                            "Hühnervogel aus der Familie der Fasanenartigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2061f1-0fb6-40fd-b74e-86d2e645864d",
                                "sense_id": "1472225b-c22b-356a-b702-07b95078967d",
                                "text": "„›Er ist einem Raufußhuhn ausgewichen, über eine Steinmauer geflogen und auf dem Kirchhof gelandet! Praktisch, oder?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83ba3ea9-3921-4004-9476-21e6ee5ab430",
                        "source_entry_id": "9c2e8859-56de-338f-805c-855130a1ea02",
                        "source_sense_id": "1472225b-c22b-356a-b702-07b95078967d",
                        "source_sense_description": "Hühnervogel",
                        "target_lang_word": "grouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                                        "entry_id": "3189b5d4-d4eb-3354-9090-fd739d085282",
                                        "glosses": [
                                            "Any of various game birds of the subfamily Tetraoninae which inhabit temperate and subarctic regions of the Northern Hemisphere; specifically, the red grouse (Lagopus lagopus scotica) native to heather moorland on the British Isles."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e833f74b-bc03-4fd7-8fd2-516c1768d6f5",
                                                "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                                                "text": "Among fowls for the table [of King Henry VIII] are crocards, winders, runners, grows, and peions, but neither Turky or Guiney-fowl."
                                            },
                                            {
                                                "example_id": "ce035ea6-0c3d-4806-8b5c-2bb4963c7de9",
                                                "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                                                "text": "Looke to 't, young growſe: Ile lay it on, and ſure; / Take 't off who's wull."
                                            },
                                            {
                                                "example_id": "a123d3e3-9292-4b35-99f7-5aa166c13878",
                                                "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                                                "text": "The shy black grouse, “with an eye on every feather,” can only thrive in vast, absolutely undisturbed heath and moorlands. Therefore, unfortunately, there are not too many black grouse."
                                            },
                                            {
                                                "example_id": "c67ddd02-5e4c-40b7-bbf0-506b717ebb33",
                                                "sense_id": "b028d042-b704-3afc-964d-3ed6d1713050",
                                                "text": "I don’t know whether someone will go to the North Face this year. There you can find pure loneliness. In the base camp, you are only joined by snow grouses. Otherwise, it is extremely quiet, and you have the view of the North Face. You won’t meet anyone at the Kangshung Face too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf29b84-4769-30df-aa6f-956b5c94c5e3",
                                        "entry_id": "3189b5d4-d4eb-3354-9090-fd739d085282",
                                        "glosses": [
                                            "The flesh or meat of this bird eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3079d77-0bae-3022-a5e5-183b4cb3e3f1",
                                        "entry_id": "e84acc2f-2f7c-34c7-b425-208d9f92856b",
                                        "glosses": [
                                            "To hunt or shoot grouse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                        "entry_id": "901e4241-d7e8-3c93-a926-16fdf16e6189",
                                        "glosses": [
                                            "To complain or grumble."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22781b4a-0ea2-45f8-8de8-64264b0652de",
                                                "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                                "text": "If you're cast for fatigue by a sergeant unkind,\nDon't grouse like a woman, nor crack on, nor blind;\nBe handy and civil, and then you will find\nThat it's beer for the young British soldier."
                                            },
                                            {
                                                "example_id": "e33e412b-56e7-42d6-89a8-c09570002af0",
                                                "sense_id": "fd9341be-5a8a-306b-a56a-6567f1a81dbb",
                                                "text": "Grouse away!\" he growled. \"If grousin' made a man happy, you'd be the champion.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68fa3946-df2d-3e1c-822d-5b600c0839a8",
                                        "entry_id": "8aa704c2-16ac-3bfa-95ad-d4283028b621",
                                        "glosses": [
                                            "A cause for complaint; a grumble."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                        "entry_id": "28368d84-39de-3fdd-8cd5-89e35631a5c8",
                                        "glosses": [
                                            "Excellent."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d253685f-a061-436b-a0f3-c5b16ad288b8",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "I had a grouse day."
                                            },
                                            {
                                                "example_id": "86fce660-d3d0-4980-b543-c9e4e5b134a0",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "That food was grouse."
                                            },
                                            {
                                                "example_id": "15328279-f404-443e-a2b4-d641948e841d",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "Real grouse birthday this. First time he's had a party."
                                            },
                                            {
                                                "example_id": "0f40b470-f632-4d13-b1f1-f7ccea3e0bab",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "They were the grousest ladies she′d ever met."
                                            },
                                            {
                                                "example_id": "fb1e9615-662c-4645-b029-265a6ff9e8b9",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "Not a question but the gag of Mulder pissing on the ID4 poster was grouse."
                                            },
                                            {
                                                "example_id": "51f220e8-6504-4fa7-87fd-19b96a41ba49",
                                                "sense_id": "23b6fc18-0bcb-3462-ba75-dc924eb2ea39",
                                                "text": "I know, but I moved from riding bikes to flying and it is a great move. All riders without a fear of heights I know that flew with me thought it was grouse- and there are no coppers or speed limits up there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
