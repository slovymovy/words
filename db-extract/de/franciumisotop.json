                "senses": [
                    {
                        "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                        "entry_id": "b5a1903c-3d9c-309c-925c-6340e57eddd0",
                        "glosses": [
                            "Variante eines Franciumatoms, bei dem die Anzahl der Neutronen im Atomkern von der des stabilsten Isotops Francium-223 abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d68c7a-256a-49b0-916e-b7b3d499998a",
                                "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                                "text": "„Das 217 Fr ist sehr wahrscheinlich das beständigste Franciumisotop […]“"
                            },
                            {
                                "example_id": "e6066946-faad-4465-b5e7-0a6f5b551be8",
                                "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                                "text": "„Franciumisotope mit höherer Massenzahl müssen sehr kurzlebig sein und sind bisher nicht aufgefunden worden.“"
                            },
                            {
                                "example_id": "25d4b044-c1d1-43bd-be0a-325d3f122fd3",
                                "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                                "text": "„Insgesamt kennt man bis heute 23 Franciumisotope der Massenzahl 203 bis 224 (zwei Kernisomere der Massenzahl 204), die alle kurzlebig sind (Halbwertszeiten von 10-3 Sekunden bis 21.8 Minuten) und von denen einige angeführt seien […]“"
                            },
                            {
                                "example_id": "2a30da91-f437-41ca-8ab7-3b61ea40806a",
                                "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                                "text": "„Nach der Korrektur der Querschnitte von Franciumisotopen aus den Verteilungen des Actiniums und von Radonisotopen aus der Verteilung des Radiums können die Isotopenausbeuteverteilungen für diese Elemente berechnet und zur Korrektur der […]“"
                            },
                            {
                                "example_id": "4cc21a55-6f8b-4e3d-a00f-809d6c7aad33",
                                "sense_id": "52abe619-ebed-3e55-a6c1-ba74d9c0618d",
                                "text": "„Wegen der Kurzlebigkeit der verschiedenen Franciumisotopen, deren Halbwertszeiten zwischen 0,02 s und 22 min Schwanken, ist es kaum moglich, wagbare Mengen dieses Elements zu fassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
