                "senses": [
                    {
                        "sense_id": "f0e33d80-704c-3e69-85c6-a5fe003c11b3",
                        "entry_id": "079665a0-a78c-38cb-82b1-eb4009dcf9fb",
                        "glosses": [
                            "self-evident, evidently, obviously"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b05db3-e8fb-44a4-a2d6-2181705d726c",
                                "sense_id": "f0e33d80-704c-3e69-85c6-a5fe003c11b3",
                                "text": "Het is vanzelfsprekend dat water nat is.",
                                "translation": "It is self-evident that water is wet.",
                                "english": "It is self-evident that water is wet."
                            },
                            {
                                "example_id": "eaf599d3-b0bb-4c2c-8646-688cbea2f9b3",
                                "sense_id": "f0e33d80-704c-3e69-85c6-a5fe003c11b3",
                                "text": "Het antwoord op de vraag was vanzelfsprekend voor iedereen.",
                                "translation": "The answer to the question was obvious to everyone.",
                                "english": "The answer to the question was obvious to everyone."
                            },
                            {
                                "example_id": "b11d3d0b-f56a-4a8f-8ac2-554531d1dcdb",
                                "sense_id": "f0e33d80-704c-3e69-85c6-a5fe003c11b3",
                                "text": "Het feit dat de aarde rond is, is vanzelfsprekend voor moderne wetenschappers.",
                                "translation": "The fact that the earth is round is evident to modern scientists.",
                                "english": "The fact that the earth is round is evident to modern scientists."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f39e996-7a22-33a6-88dc-f86c0c698c85",
                        "entry_id": "079665a0-a78c-38cb-82b1-eb4009dcf9fb",
                        "glosses": [
                            "taken for granted, natural"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ccd20a6-83f9-409b-b9b1-487ead49fd58",
                                "sense_id": "4f39e996-7a22-33a6-88dc-f86c0c698c85",
                                "text": "In een gezonde relatie is wederzijds respect vanzelfsprekend.",
                                "translation": "In a healthy relationship, mutual respect is taken for granted.",
                                "english": "In a healthy relationship, mutual respect is taken for granted."
                            },
                            {
                                "example_id": "e6e73dcb-386d-4bc1-967b-9eaa539c9464",
                                "sense_id": "4f39e996-7a22-33a6-88dc-f86c0c698c85",
                                "text": "In deze moderne tijd is snel internet bijna vanzelfsprekend geworden.",
                                "translation": "In this modern age, fast internet has become almost natural.",
                                "english": "In this modern age, fast internet has become almost natural."
                            },
                            {
                                "example_id": "f3b3913c-d2e1-482a-b9b8-3c49aff3f801",
                                "sense_id": "4f39e996-7a22-33a6-88dc-f86c0c698c85",
                                "text": "Voor de meeste mensen is ademen vanzelfsprekend, tot je er problemen mee krijgt.",
                                "translation": "Breathing is taken for granted for most people, until they encounter problems with it.",
                                "english": "Breathing is taken for granted for most people, until they encounter problems with it."
                            }
                        ]
                    }
                ],
