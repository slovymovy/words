                                "example_id": "191bf1fd-043a-44e2-9266-9a49be3635ad",
                                "sense_id": "41d0ee7a-860f-331e-8a29-bc208409301f",
                                "text": "„Im Zusammenhang mit den geforderten operativen Ermittlungen ist vom IM je Angriffspunkt ein Groß-TBK [toter Briefkasten] zur Lagerung der operativen Technik anzulegen.“"
                            },
                            {
                                "example_id": "be136d2c-44ce-48d7-b279-63bf3d13277b",
                                "sense_id": "41d0ee7a-860f-331e-8a29-bc208409301f",
                                "text": "„Eine Variante hierzu ist der rollende TBK, der in einem Fortbewegungsmittel (häufig Eisenbahn) installiert ist.“"
                            },
                            {
                                "example_id": "677afea2-3aea-49a2-a52b-1009574db317",
                                "sense_id": "41d0ee7a-860f-331e-8a29-bc208409301f",
                                "text": "„Für die Übermittlung werde aber immer noch in der Regel ein «toter Briefkasten» eingesetzt, in der Fachsprache kurz TBK genannt, erklärt der Fachautor Günther K. Weisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
