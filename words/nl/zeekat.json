                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naval vessel",
                                "target_lang_sense_clarification": "a ship used for military purposes"
                            },
                            {
                                "target_lang_word": "sea cat",
                                "target_lang_sense_clarification": "literal translation often used for specific naval classes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
