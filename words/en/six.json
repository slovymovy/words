                },
                {
                    "sense_id": "003a4381-52dd-3b78-881d-3fd0745f4d71",
                    "sense_definition": "In cricket, a hit that crosses the boundary without bouncing, scoring six runs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman hit a <w>six</w> over the long-on boundary to win the match.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен ударил <w>шестёрку</w> через границу в районе лонг-она и выиграл матч.",
                                "zh": "击球手将球击出长击球区界外，打出一个<w>六分球</w>，赢得了比赛。"
                            }
                        },
                        {
                            "text": "His impressive century featured twelve <w>sixes</w> and several boundaries.",
                            "target_lang_translations": {
                                "ru": "В его впечатляющей сотне было двенадцать <w>шестёрок</w> и несколько ударов за границу.",
                                "zh": "他那令人印象深刻的百分表现中，包含了十二个<w>六分球</w>和几次界外球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a six"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in cricket-playing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: удар, при котором мяч пересекает границу поля без отскока и приносит 6 ранов (очков).",
                        "zh": "板球运动中，击球手将球直接击出界外，得六分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестёрка",
                                "target_lang_sense_clarification": "крикет: удар на шесть (мяч улетает за границу без отскока)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "六分球",
                                "target_lang_sense_clarification": "板球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5129408e-7866-35dc-b4e0-c787281841fa",
                    "sense_definition": "The area directly behind someone or something; the rear side.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot shouted to his wingman to watch his <w>six</w> during the dogfight.",
                            "target_lang_translations": {
                                "ru": "Пилот крикнул ведомому, чтобы тот прикрыл его <w>хвост</w> во время воздушного боя.",
                                "zh": "在空战中，飞行员大声提醒僚机注意他的<w>后方</w>。"
                            }
                        },
                        {
                            "text": "Don't worry about the intruders; I will cover your <w>six</w> while you move forward.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о нарушителях: я прикрою твой <w>хвост</w>, пока ты продвигаешься вперёд.",
                                "zh": "别担心那些入侵者，你向前推进时，我会负责掩护你的<w>后方</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch your six",
                        "cover my six"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military and aviation origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство прямо позади кого-либо/чего-либо; задняя сторона (в военном и авиационном жаргоне).",
                        "zh": "指某人或某物正后方的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шесть",
                                "target_lang_sense_clarification": "авиац./воен. сленг: задняя полусфера, «сзади» (как на циферблате)"
                            },
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "разг.: «хвост», то есть прямо сзади"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后方",
                                "target_lang_sense_clarification": "军事或航空术语，指背后"
                            }
                        ]
                    }
                }
            ]
