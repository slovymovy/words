                        "entry_id": "d72e577c-8231-3ee3-9548-087bb2594e4c",
                        "glosses": [
                            "Short pants; shorts."
                        ],
                        "tags": [
                            "South-Africa"
                        ],
                        "examples": [
                            {
                                "example_id": "d4074ab7-cc24-4f42-b5e3-18e965a9fb72",
                                "sense_id": "df4e30a5-d092-3dd7-be49-ede91539c65b",
                                "text": "And the few skirts which are past remaking are carefully cut down into small brookies for the young hopeful, who will get the last ounce of wear out of them."
                            },
                            {
                                "example_id": "f4775d33-8f85-4feb-8850-17b012f684d2",
                                "sense_id": "df4e30a5-d092-3dd7-be49-ede91539c65b",
                                "text": "[…] you cannot do a poopy in your brookie, […]"
                            },
                            {
                                "example_id": "6cb7db10-9baf-4004-8eba-b136d39ef069",
                                "sense_id": "df4e30a5-d092-3dd7-be49-ede91539c65b",
                                "text": "I notice, too, that the child is wearing red brookies [shorts]."
                            }
                        ]
                    }
