                        ],
                        "form": "das Wasserbad"
                    },
                    {
                        "form_id": "8ab36825-ae79-41cb-aee6-52ac6aaaff71",
                        "entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wasserbäder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16b87397-26b6-3f91-a5f7-626c8d4611d8",
                        "entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
                        "glosses": [
                            "ein mit Wasser gefüllter Behälter zur Zubereitung oder Aufbewahrung und zum Erwärmen von Speisen (in ähnlicher Weise auch im Labor zur schonenden Erwärmung von Flüssigkeiten angewandt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6424eda8-172c-4d4a-ad97-09f92eaa3a7f",
                                "sense_id": "16b87397-26b6-3f91-a5f7-626c8d4611d8",
                                "text": "Für ein Wasserbad benötigt man zwei ineinander passende Gefäße, wobei der größere mit heißem Wasser gefüllt wird."
                            },
                            {
                                "example_id": "b3c7dedf-bc06-4a42-a724-d6599d695943",
                                "sense_id": "16b87397-26b6-3f91-a5f7-626c8d4611d8",
                                "text": "„Dann verschafften sie sich alte Sardinenbüchsen, taten Kalbskoteletts hinein und legten sie in ein Wasserbad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83e87cc9-e37b-3b8b-8295-2de865ba8ab1",
                        "entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
                        "glosses": [
                            "Wasserbehälter, meist mit Fließwasser, zum Auswaschen von Fotopapier"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac24bc4-9203-40ac-8316-367f38043e39",
                                "sense_id": "83e87cc9-e37b-3b8b-8295-2de865ba8ab1",
                                "text": "Nach dem Fixieren wird das Foto im Wasserbad gewässert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "630421c9-e124-39d9-8442-6e2289651fe5",
                        "entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
                        "glosses": [
                            "Bad im Wasser"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "86d9d98d-8b51-4a3c-9c47-ea35b5b64179",
                                "sense_id": "630421c9-e124-39d9-8442-6e2289651fe5",
                                "text": "Nach dem Schwitzen in der Sauna stiegen wir in das Wasserbad."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecbd7b99-0822-482b-b184-4221b7b9b58c",
                        "source_entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
                        "source_sense_id": "16b87397-26b6-3f91-a5f7-626c8d4611d8",
                        "source_sense_description": "Wasserbehälter zur Behandlung von Lebensmitteln",
                        "target_lang_word": "bain-marie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bain-marie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                        "entry_id": "15d7d4fc-8395-35d2-bc96-4a046ca43181",
                                        "glosses": [
                                            "Récipient partiellement rempli d’un liquide qui est généralement de l’eau ou de l’huile, sur lequel on place un autre récipient contenant une préparation à cuire ou à réchauffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfca3b8d-b1a7-4958-ab5f-c56ba3933918",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "La coloration des crayons était autrefois presque uniquement obtenue avec le racine d’orcanette restant, au bain-marie, en contact avec la matière grasse."
                                            },
                                            {
                                                "example_id": "ee3e3313-6a8c-475c-9bc3-7a96d3973a3e",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "On les fait tiédir ou non au bain-marie, suivant l’état de tolérance du malade, les eaux froides pouvant subir cette préparation aussi bien que les eaux chaudes. — (Louis Caillon, Guide du malade à Vichy, Tunis, 1929, page 15)"
                                            },
                                            {
                                                "example_id": "62920f19-d890-40e2-95e7-eb145032be89",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "Quatre fours, six bouches, deux tables chauffantes, des bains-marie de cinquante litres, un foyer sous hotte où rôtir à l’aise les marcassins par douze."
                                            },
                                            {
                                                "example_id": "c82173a1-a274-496e-b13d-df2ff22c200f",
                                                "sense_id": "7bef3161-72e0-3d31-a143-d1c55213586d",
                                                "text": "Un cassoulet qui cuit au bain-marie, ça ne risque rien, sot!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d67eb9-6e06-308f-9ce5-458193575fb9",
                                        "entry_id": "15d7d4fc-8395-35d2-bc96-4a046ca43181",
                                        "glosses": [
                                            "Dans une situation problématique, bouillante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea18415c-a960-483a-ae64-a8f826baa62d",
                                                "sense_id": "b2d67eb9-6e06-308f-9ce5-458193575fb9",
                                                "text": "Rien ne va changer. Une humanité au bain-marie, des dévastations, des convulsions, beaucoup de bla-bla, presque plus de littérature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80e148b5-7a9c-4ac5-81c2-23580f5af4dc",
                        "source_entry_id": "67a4b315-02bd-37bb-ad42-30781f284fbb",
