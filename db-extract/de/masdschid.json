                "senses": [
                    {
                        "sense_id": "dba5f1de-1e50-3847-80d0-2c0b0796e81e",
                        "entry_id": "cbce8fc6-1dc3-3185-a4f0-5a35d4741eed",
                        "glosses": [
                            "muslimisches Gebetshaus, kleine Moschee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f91e52b-39a2-4d6f-af66-02fd9c39535e",
                                "sense_id": "dba5f1de-1e50-3847-80d0-2c0b0796e81e",
                                "text": "„Ich bin die Säule jenes Masdschid (Gebetsraum), der Prophet lehnte sich an mich.“"
                            },
                            {
                                "example_id": "a51d1223-de09-4bc9-b04b-0ed50ebc927c",
                                "sense_id": "dba5f1de-1e50-3847-80d0-2c0b0796e81e",
                                "text": "„In der Masdschid wurden die täglichen Gebetszeiten durch einen imam gehalten, der mit dem „Professor“ personengleich sein konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0555915-5715-4e78-96dd-2cb27d8fdffa",
                        "source_entry_id": "cbce8fc6-1dc3-3185-a4f0-5a35d4741eed",
                        "source_sense_id": "dba5f1de-1e50-3847-80d0-2c0b0796e81e",
                        "source_sense_description": "muslimisches Gebetshaus, kleine Moschee",
                        "target_lang_word": "masjid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masjid",
