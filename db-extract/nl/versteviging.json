                    {
                        "sense_id": "b9b2c60d-6be5-3782-b8d1-eb22952944ca",
                        "entry_id": "036abe0c-b022-3a64-a4b3-df9b51e1be2d",
                        "glosses": [
                            "het sterker maken van iets; het steviger maken van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdfc36a-2c5c-4a96-b4db-beb6eaf25482",
                                "sense_id": "b9b2c60d-6be5-3782-b8d1-eb22952944ca",
                                "text": "Hij had ze gebruikt ter versteviging van de steiger, toen de goten aan de straatzijde vernieuwd moesten worden."
                            },
                            {
                                "example_id": "adc25ed2-c30d-4b0a-8a97-02f415f9ee13",
                                "sense_id": "b9b2c60d-6be5-3782-b8d1-eb22952944ca",
                                "text": "Vrijwilliger Johan Lesscher wijst naar het zaagraam, dat al sinds het begin in 1771 in de nok van het dak zit. „Vroeger waren er drie. Je kunt de overblijfselen van de andere twee ook nog zien”, zegt hij, om vervolgens over te stappen op de enorme boomstam die in de Tweede Wereldoorlog is geplaatst ter versteviging. „Tijdens de oorlog moest hier van de Duitsers 24 uur per dag worden gezaagd, dus het moest stabieler allemaal.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7acb097b-34c2-4496-a271-0ab6222936dd",
                        "source_entry_id": "036abe0c-b022-3a64-a4b3-df9b51e1be2d",
                        "source_sense_id": "b9b2c60d-6be5-3782-b8d1-eb22952944ca",
                        "source_sense_description": "het sterker maken van iets; het steviger maken van iets",
