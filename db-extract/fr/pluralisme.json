        "fr-extract.jsonl": [
            {
                "entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                "word": "pluralisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "496ff352-0799-48d0-b841-a719b867bd95",
                        "entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                        "tags": [
                            "plural"
                        ],
                        "form": "pluralismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ec56c78-71ba-3e9b-86d9-e63838d1d46a",
                        "entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                        "glosses": [
                            "Cadre d’interaction dans lequel différents groupes montrent suffisamment de respect et de tolérance entre eux, pour pouvoir coexister et interagir sans trop de conflit ou assimilation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f949c2-59a2-44cb-804b-cc9485a6e057",
                                "sense_id": "0ec56c78-71ba-3e9b-86d9-e63838d1d46a",
                                "text": "Malheureusement, il n’existait aucun attachement philosophique au laïcisme et à ses valeurs de scepticisme, d’expérimentation et de tolérance, si essentielles au pluralisme politique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f77d8e56-e10f-39be-be90-33043bad649d",
                        "entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                        "glosses": [
                            "Système politique permettant l'expression d'idées divergentes et d'intérêts concurrents, et leur contribution à la prise de décision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31601828-0c18-42b9-b077-8cf550f63ba8",
                                "sense_id": "f77d8e56-e10f-39be-be90-33043bad649d",
                                "text": "À partir des années 1970, des chercheurs européens contestent la pertinence de la notion de pluralisme pour qualifier les modes de construction des politiques publiques sur le Vieux Continent."
                            },
                            {
                                "example_id": "079741f5-3fdb-4cb3-9b20-c6417be87c28",
                                "sense_id": "f77d8e56-e10f-39be-be90-33043bad649d",
                                "text": "Nous avons vu le terrorisme frapper les démocraties, des régimes illibéraux réduire le pluralisme et la liberté des médias, l’antisémitisme monter de manière inacceptable et des violations massives du droit international humanitaire dans la bande de Gaza, qui déstabilisent toute la région."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af194ef4-839a-4bf4-9781-9adaf0c4bf98",
                        "source_entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                        "target_lang_word": "Pluralismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pluralismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f95dc68c-1a49-3866-b077-05d8db6f2ef0",
                                        "entry_id": "e66cd554-68f2-34ac-a5f0-ac1f2c9a2696",
                                        "glosses": [
                                            "Anschauung, bei der Menschen oder Gruppierungen verschiedene Meinungen vertreten dürfen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b613978-b2b5-4bf7-a929-74f3cd6c7731",
                                                "sense_id": "f95dc68c-1a49-3866-b077-05d8db6f2ef0",
                                                "text": "Der Pluralismus führte zu einem besseren Ergebnis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04128d82-dbc4-3e01-8c82-4c7847ffa3a0",
                                        "entry_id": "e66cd554-68f2-34ac-a5f0-ac1f2c9a2696",
                                        "glosses": [
                                            "Vielfalt der gesellschaftlichen Kräfte"
                                        ],
                                        "tags": [
                                            "Politikwissenschaft",
                                            "deskriptiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2198c99e-bbf7-49c7-b88f-9b7326dccc5e",
                                                "sense_id": "04128d82-dbc4-3e01-8c82-4c7847ffa3a0",
                                                "text": "„Ohne Pluralismus kann es keine Demokratie geben.“"
                                            },
                                            {
                                                "example_id": "be5e2e27-b6d8-4ad5-ab37-fbbd9e9c1968",
                                                "sense_id": "04128d82-dbc4-3e01-8c82-4c7847ffa3a0",
                                                "text": "„Diese alte Bundesrepublik hatte es geschafft, mit Hilfe harter, nachhaltiger Kritik von Minderheiten zu einem Pluralismus zu finden, wie er seinesgleichen in westlichen Demokratien suchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "e29e7d81-9d22-3877-ab2a-a260e56d3f0c",
                                        "entry_id": "e66cd554-68f2-34ac-a5f0-ac1f2c9a2696",
                                        "glosses": [
                                            "Idee einer Gesellschaft mit auf mehrere Akteure verteilter politischer Macht, auf Wettbewerb beruhend"
                                        ],
                                        "tags": [
                                            "Politikwissenschaft",
                                            "normativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9a63ae-1091-4c29-92de-34598e10ec5f",
                                                "sense_id": "e29e7d81-9d22-3877-ab2a-a260e56d3f0c",
                                                "text": "Ernst Fraenkel entwickelte den klassischen Pluralismus zum Neopluralismus weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "5397d41f-8d91-313f-ba0b-4af3eac55362",
                                        "entry_id": "e66cd554-68f2-34ac-a5f0-ac1f2c9a2696",
                                        "glosses": [
                                            "Anschauung, bei der verschiedene Positionen, eine Vielzahl grundlegender und irreduzibler Ebenen in der Welt annehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf35e280-e16c-472d-8ec5-d2344cb7181c",
                                                "sense_id": "5397d41f-8d91-313f-ba0b-4af3eac55362",
                                                "text": "„Der Pluralismus stützt sich in metaphysischer, ontologischer und logischer Hinsicht auf die Mannigfaltigkeit des Wirklichen, die eine Mehrheit oberster Grundbestimmungen und die Annahme unterschiedlicher Seinselemente oder logischer Kategorien erfordert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7aa8ec4a-32de-3423-875b-6527296b9c74",
                                        "entry_id": "e66cd554-68f2-34ac-a5f0-ac1f2c9a2696",
                                        "glosses": [
                                            "Anschauung einer bestimmten Religion, dass andere Religionen zur eigenen gleichwertig sein können (= pluralistische Religionstheologie)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32682d17-02df-454b-a052-ac91ea7cc2de",
                        "source_entry_id": "91218785-4283-388d-8440-aa6fe03eb643",
                        "target_lang_word": "pluralism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluralism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ded13d59-87b6-39e7-b665-9f44f9b87f40",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The quality or state of being plural, or in the plural number."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2958dd7-b65b-493c-bd90-48c0d1a9596f",
                                                "sense_id": "ded13d59-87b6-39e7-b665-9f44f9b87f40",
                                                "text": "Polytheism was inherently tolerant of the worship of many gods, because no single god was thought to control all the phenomena that are vital for human life. The gods were believed to tolerate this pluralism, and several could be worshiped in the same sanctuary or addressed in the same prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc1e492-3da3-3213-9c4d-0b451280d6f0",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The state of a pluralist; the holding of more than one ecclesiastical living at a time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30bbcd36-ab7a-3086-a6e1-d47545bd67e1",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "A social system that permits smaller groups within a society to maintain their individual cultural identities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca63a745-1f96-494e-88f7-78f0819967de",
                                                "sense_id": "30bbcd36-ab7a-3086-a6e1-d47545bd67e1",
                                                "text": "Instead, it is more probable that globalization is leading to a plurality of pluralisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d5db0a-1bb5-3ada-abae-feeea3a5a57b",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The belief that there should be diverse and competing centers of power in society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5454c65-d73b-3016-b0ed-5649e445a020",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The acknowledgement of a diversity of political systems."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9811002a-a380-35e7-98dc-049e57937658",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The existence of differing legal systems in a population or area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67dbb2d5-1556-3d27-aa98-889aaa4955ec",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The belief that values can be simultaneously antagonistic and incommensurable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0067c36-cd02-431b-a2f6-7193805742a5",
                                                "sense_id": "67dbb2d5-1556-3d27-aa98-889aaa4955ec",
                                                "text": "Due to pluralism and conflicts within the good itself, such perfection, for Berlin, is not possible. A compromise does not bring us closer to a higher telos in history."
                                            },
                                            {
                                                "example_id": "5739b4b4-3f8e-4f05-a5f4-fc184042e75c",
                                                "sense_id": "67dbb2d5-1556-3d27-aa98-889aaa4955ec",
                                                "text": "Pluralism is a creative force because it admits of multiple ways to see a thing, multiple valuable paths to choose from."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a81b353c-431f-3fae-8712-3f482b58c844",
                                        "entry_id": "97ae5ad7-1ea1-355b-b6ea-fcc10cc0ebc5",
                                        "glosses": [
                                            "The belief that a plural predicate refers to its individuals rather than to a collective."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
