            {
                "entry_id": "3a886647-3902-3d6c-9175-f6b60a68164a",
                "word": "vaarde",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                        "entry_id": "3a886647-3902-3d6c-9175-f6b60a68164a",
                        "glosses": [
                            "enkelvoud verleden tijd van varen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1fb2a952-b33f-4bcd-8f12-1016a6d9f5e7",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Ik vaarde."
                            },
                            {
                                "example_id": "9fe3f67f-0f0d-42dd-844b-5617962083f1",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Jij vaarde."
                            },
                            {
                                "example_id": "c5ea8786-9003-4326-a524-984e3d0e3506",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Hij, zij, het vaarde."
                            },
                            {
                                "example_id": "0eda6e11-1859-4463-bfbf-7da05feaf701",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Zaterdag 22 juli hoorde ik op de radionieuwsdienst van 10.00 uur: ‘In Zeeland heeft de politie een man aangehouden die nog een boete had openstaan van 600.000 euro. Aanleiding tot de aanhouding: hij vaarde te snel.’ ‘Vaarde!’ Nog even en we hebben ook al geen sterke werkwoorden meer."
                            },
                            {
                                "example_id": "dc6865be-7cd2-4745-8ced-4efca75bd27d",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Reeds voor de zon in 't oosten blonk,\nWas Jacob aan de reê,\nEn zong een vrolijk deuntjen op\nEn vaarde diep in zee."
                            },
                            {
                                "example_id": "5e4f7e14-c6cd-4bc1-b037-abba02317a01",
                                "sense_id": "89e461b2-c021-3e7b-8759-93b54a14dff6",
                                "text": "Zyn schip lag op de reê,\nZoo vaarde hy in zee."
                            }
                        ]
                    }
                ],
