                                        "glosses": [
                                            "A formal, obligatory kind of school that typically begins with nursery school or first grade and ends at fifth or sixth grade."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "India",
                                            "New-Zealand",
