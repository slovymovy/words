                        "examples": [
                            {
                                "example_id": "229c7e82-a1a7-4626-a540-1735a606bc83",
                                "sense_id": "d48ea915-4669-304d-adf3-f53f6252782a",
                                "text": "Tussen twee grensposten is een klein stukje niemandsland."
                            }
                        ]
                    },
                    {
                        "sense_id": "df6805f8-c048-3602-a689-8c21a43d2474",
                        "entry_id": "bd371d8c-4047-37ae-827f-889ea40b62b7",
                        "glosses": [
                            "gebied tussen twee vijandelijke legers"
