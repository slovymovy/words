                    {
                        "translation_id": "92f51ef9-0ce2-4a37-86f0-e1e926c3a0f3",
                        "source_entry_id": "04d706b2-7823-36f2-9b80-0e5a240b52a2",
                        "source_sense_id": "11720686-65cd-3ada-84a8-d91adfb1ff99",
