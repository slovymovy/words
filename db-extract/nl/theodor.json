                                    {
                                        "sense_id": "4e8faef5-d0a6-3cb0-a903-689cf2aa8956",
                                        "entry_id": "60c51bac-2932-38f4-88f6-825e3edddc8d",
                                        "glosses": [
                                            "A diminutive of the male given name Thomas."
                                        ],
                                        "tags": [],
