    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7e0c40c-2f89-3a7a-a05e-62cbdbfcc941",
                    "sense_definition": "Paying close attention, watching, or listening carefully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was an <w>attentive</w> listener and never interrupted while others were speaking.",
                            "target_lang_translations": {
                                "pl": "Była <w>uważną</w> słuchaczką i nigdy nie przerywała, gdy inni mówili."
                            }
                        },
                        {
                            "text": "The students remained quiet and <w>attentive</w> throughout the entire lecture.",
                            "target_lang_translations": {
                                "pl": "Studenci pozostali cisi i <w>uważni</w> przez cały wykład."
                            }
                        }
                    ],
                    "synonyms": [
                        "heedful"
                    ],
                    "antonyms": [
                        "inattentive"
                    ],
                    "common_phrases": [
                        "attentive listener",
                        "attentive audience"
                    ],
                    "target_lang_definitions": {
                        "pl": "Skupiony, uważnie słuchający lub obserwujący."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "uważny",
                                "target_lang_sense_clarification": "skupiający uwagę, słuchający uważnie"
                            },
                            {
                                "target_lang_word": "baczny",
                                "target_lang_sense_clarification": "czujny, wnikliwy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88887250-126a-3bbc-976e-584f3eb5b36b",
                    "sense_definition": "Mindful of the needs or comfort of others; considerate and polite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consideration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel staff was extremely <w>attentive</w> and made sure we had everything we needed.",
                            "target_lang_translations": {
                                "pl": "Obsługa hotelowa była niezwykle <w>troskliwa</w> i upewniła się, że mamy wszystko, czego potrzebujemy."
                            }
                        },
                        {
                            "text": "He proved to be a caring and <w>attentive</w> partner during her long recovery.",
                            "target_lang_translations": {
                                "pl": "Okazał się troskliwym i <w>uważnym</w> partnerem podczas jej długiej rekonwalescencji."
                            }
                        }
                    ],
                    "synonyms": [
                        "mindful"
                    ],
                    "common_phrases": [
                        "attentive service",
                        "attentive host"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dbający o potrzeby i wygodę innych; troskliwy i uprzejmy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "troskliwy",
                                "target_lang_sense_clarification": "dbający o innych, opiekuńczy"
                            },
                            {
                                "target_lang_word": "uprzejmy",
                                "target_lang_sense_clarification": "usłużny, dbający o klienta lub gościa"
                            },
                            {
                                "target_lang_word": "uważny",
                                "target_lang_sense_clarification": "zwracający uwagę na czyjeś potrzeby"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}