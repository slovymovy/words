                                "target_senses": [
                                    {
                                        "sense_id": "b77902d8-426d-3cd2-b587-8935d85b4ec9",
                                        "entry_id": "01103732-aa50-3358-a630-e758063d0c83",
                                        "glosses": [
                                            "dusičnan alkalického kovu"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e383dd6-3e37-396e-be39-6370090a1c62",
                                        "entry_id": "01103732-aa50-3358-a630-e758063d0c83",
                                        "glosses": [
                                            "směs dusičnanů používaná jako hnojivo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c6e2ba-afe9-4689-a9f5-23c40dfd90e3",
                                                "sense_id": "0e383dd6-3e37-396e-be39-6370090a1c62",
                                                "text": "(Do zahradnické půdy) se dává hnůj, mrva, guano, listovka, drnovka, ornice, písek, sláma, vápno, kainit, Thomasova moučka, dětská moučka, ledek, rohovina, fosfáty, trus, krondaro, popel, rašelina, kompost, voda, pivo, vyklepané fajfky, ohořelé sirky, mrtvé kočky a mnohé jiné substance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9ac5085-2c8d-4bff-9211-bf3a0df03ab0",
                        "source_entry_id": "acb4568b-7483-38f7-9b8f-433b2aef7513",
                        "source_sense_id": "dd6c44db-37b7-3825-a457-c53fb3c9e5d1",
                        "target_lang_word": "Salpeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salpeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                        "entry_id": "75b7a541-95da-3e4d-ad90-1004131c81ff",
                                        "glosses": [
                                            "Bezeichnung für verschiedene Salze der Salpetersäure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d58d2f-7704-4988-8921-f37ecd1e024e",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "Salpeter spielt als Dünger in der Landwirtschaft eine Rolle."
                                            },
                                            {
                                                "example_id": "c7541a84-1a7b-4dad-b1cb-abde79f9656c",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Zur Herstellung von Munition, aber auch von Düngemitteln für die Landwirtschaft bilden Stickstoffverbindungen (Nitrate), darunter insbesondere Salpeter (NaNO₃) und Salpetersäure (HNO₃), einen unentbehrlichen Grundbestandteil.“"
                                            },
                                            {
                                                "example_id": "0ff41ce9-55da-4dd7-9cd1-8cfd4fafbe08",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Im Lauf des 19. Jahrhunderts kamen weitere Nutzungsbereiche für Salpeter hinzu.“"
                                            },
                                            {
                                                "example_id": "42854f72-50a8-422b-8f29-eda166072048",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Die Hauptfracht bestand aus Baumwolle, Salpeter und Ebenholz, doch vom Opium hatten wir immer noch vierhundert Kisten.“"
                                            },
                                            {
                                                "example_id": "a8ad78d7-5696-42b6-80f0-bfa39044afd6",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Aus dem Salpeter wurde mit Hilfe der Schwefelsäure durch Zersetzung Salpetersäure destilliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f225b0-cf41-4a90-ba79-37ff731bf9da",
                        "source_entry_id": "acb4568b-7483-38f7-9b8f-433b2aef7513",
                        "source_sense_id": "dd6c44db-37b7-3825-a457-c53fb3c9e5d1",
                        "target_lang_word": "селитра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "селитра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6b858e-c18c-3b44-a1ba-fe1bbbc599f1",
                                        "entry_id": "4488b4c7-46a0-383e-9ede-fc1b8d3daa09",
                                        "glosses": [
                                            "хим. минерал, содержащий нитраты щелочных и щелочноземельных металлов (натрия, калия, кальция, в том числе их кристаллогидратов) или аммония"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a68880-c4cc-4c7a-8616-e1f5e93a8765",
                                                "sense_id": "6a6b858e-c18c-3b44-a1ba-fe1bbbc599f1",
                                                "text": "Вокруг этих ям земля покрыта беловатым налётом соли и селитры, которыми почва везде насыщена в нижнем Египте."
                                            },
                                            {
                                                "example_id": "b4f421af-a889-45ef-a49e-f6da6f88d2f9",
                                                "sense_id": "6a6b858e-c18c-3b44-a1ba-fe1bbbc599f1",
                                                "text": "Над всем полем, прежде столь весёло-красивым, с его блёстками штыков и дымами в утреннем солнце, стояла теперь мгла сырости и дыма и пахло странной кислотой селитры и крови."
                                            },
                                            {
                                                "example_id": "9e1ba63b-634e-4494-8482-320eecc50550",
                                                "sense_id": "6a6b858e-c18c-3b44-a1ba-fe1bbbc599f1",
                                                "text": "Известный шведский химик XVIII в. Торберн Олаф Бергман обратился однажды к аптекарю с претензией на плохое качество проданной ему натриевой селитры: после прокаливания она давала с кислотами какие-то бурые пары."
                                            },
                                            {
                                                "example_id": "9f58feb9-d7cd-43b9-93e4-22ed24412279",
                                                "sense_id": "6a6b858e-c18c-3b44-a1ba-fe1bbbc599f1",
                                                "text": "Для предотвращения слеживания аммиачную селитру выпускают в виде гранул."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
