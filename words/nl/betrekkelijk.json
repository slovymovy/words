                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relatively",
                                "target_lang_sense_clarification": "to a certain degree"
                            },
                            {
                                "target_lang_word": "comparatively",
                                "target_lang_sense_clarification": "in comparison to others"
