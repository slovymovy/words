                    },
                    {
                        "form_id": "4399e240-b59c-4967-a63c-c4fd26e01568",
                        "entry_id": "09a59731-ed57-3532-b020-0d4d7025f906",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "crayeuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f8b0198-461b-365a-a618-bb407a17a1fe",
                        "entry_id": "09a59731-ed57-3532-b020-0d4d7025f906",
                        "glosses": [
                            "Qui est de la nature de la craie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea0b314-bcc9-4b60-bcd5-9b6ee79531cc",
                                "sense_id": "5f8b0198-461b-365a-a618-bb407a17a1fe",
                                "text": "Le ruisseau des Barres naît à Sévigny-Waleppe sur la craie marneuse et aboutit à l'Aisne en aval de Balham. Il coule aussi sur la craie. Ses alluvions, de grève crayeuse, sont recouvertes de limon jaune à Saint-Germainmont et à Juzancourt."
                            },
                            {
                                "example_id": "c987cad2-8ff5-42f7-b047-f79470bf800c",
                                "sense_id": "5f8b0198-461b-365a-a618-bb407a17a1fe",
                                "text": "Confirmant les observations déjà réalisées sur la coupe de Ménil-Lépinois, les blocs crayeux, en surface comme sur toute la profondeur de pénétration du gel (10 à 12 cm), sont entourés d'une enveloppe de glace de cryosuccion."
                            },
                            {
                                "example_id": "2715b3f3-12d7-49d4-900d-9d2f56d7b44b",
                                "sense_id": "5f8b0198-461b-365a-a618-bb407a17a1fe",
                                "text": "Les dieux se sont penchés sur le berceau de cette petite île isolée, couverte d'oliviers, sertie de plages et de falaises crayeuses."
                            },
                            {
                                "example_id": "dd3b4eae-e7f5-4c72-b42c-50976e135693",
                                "sense_id": "5f8b0198-461b-365a-a618-bb407a17a1fe",
                                "text": "Les falaises crayeuses de Douvres dressées face au Pas-de-Calais valurent à l'Angleterre son premier nom d'Albion — du mot latin albus signifiant « blanc » — qui lui fut donné par les marins de l'Antiquité."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c3bcb01-aa02-389d-86d8-2a9f5f9aaa10",
                        "entry_id": "09a59731-ed57-3532-b020-0d4d7025f906",
                        "glosses": [
                            "Qui rappelle la texture et la couleur de la craie."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "c61026d1-1187-4a62-811c-a1943656b9a5",
                                "sense_id": "4c3bcb01-aa02-389d-86d8-2a9f5f9aaa10",
                                "text": "La bonne pose devant moi une assiette avec un bout de camembert crayeux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a03ead2-83f8-4fcf-a13e-5c5ca509ab64",
                        "source_entry_id": "09a59731-ed57-3532-b020-0d4d7025f906",
                        "target_lang_word": "chalky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
