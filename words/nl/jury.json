            "senses": [
                {
                    "sense_id": "f58cc092-3762-3aba-8506-75a812eb4a31",
                    "sense_definition": "groep deskundigen die een oordeel velt over de prestaties van deelnemers aan een wedstrijd of prijsvraag",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>jury</w> van de danswedstrijd gaf de hoogste score aan het jongste koppel.",
                            "target_lang_translations": {
                                "ru": "<w>Жюри</w> танцевального конкурса поставило наивысший балл самой юной паре."
                            }
                        },
                        {
                            "text": "Uiteindelijk koos een professionele <w>jury</w> de winnaar van de schrijfwedstrijd.",
                            "target_lang_translations": {
                                "ru": "В итоге профессиональное <w>жюри</w> выбрало победителя писательского конкурса."
                            }
                        }
                    ],
                    "synonyms": [
                        "beoordelingscommissie"
                    ],
                    "common_phrases": [
                        "professionele jury",
                        "oordeel van de jury"
                    ],
                    "target_lang_definitions": {
                        "ru": "группа экспертов, оценивающая выступления участников конкурса или соревнования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жюри",
                                "target_lang_sense_clarification": "судейская коллегия конкурса или соревнования"
                            },
                            {
                                "target_lang_word": "судейская коллегия",
                                "target_lang_sense_clarification": "в спорте или конкурсах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf55402-3af8-3305-9a4e-1518af9a7f4a",
                    "sense_definition": "college van beëdigde burgers die in een rechtszaak over de schuld van een verdachte beslist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rechtspraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige landen beslist een <w>jury</w> of de verdachte schuldig is.",
                            "target_lang_translations": {
                                "ru": "В некоторых странах <w>присяжные</w> решают, виновен ли обвиняемый."
                            }
                        },
                        {
                            "text": "De advocaat probeerde de voltallige <w>jury</w> van de onschuld van zijn cliënt te overtuigen.",
                            "target_lang_translations": {
                                "ru": "Адвокат пытался убедить <w>коллегию присяжных</w> в полном составе в невиновности своего клиента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voltallige jury"
                    ],
                    "target_lang_definitions": {
                        "ru": "коллегия присяжных заседателей в суде, определяющая виновность подсудимого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суд присяжных",
                                "target_lang_sense_clarification": "судебный орган"
                            },
                            {
                                "target_lang_word": "присяжные",
                                "target_lang_sense_clarification": "члены коллегии присяжных заседателей"
                            },
                            {
                                "target_lang_word": "коллегия присяжных",
                                "target_lang_sense_clarification": "группа присяжных в суде"
                            }
                        ]
                    }
                }
            ]
