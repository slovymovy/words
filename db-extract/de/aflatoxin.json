                ],
                "senses": [
                    {
                        "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                        "entry_id": "3ec20275-440a-3280-a973-d14480949287",
                        "glosses": [
                            "mutagenes und krebserregendes Gift (Toxin), das von einigen Schimmelpilzarten gebildet wird"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "98341c9f-c213-49e4-a8c6-1f4a3c4aca2c",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„1990 begann der Irak mit der Produktion von erheblichen Mengen an Milzbrand-Endosporen, Botulinus-Toxin und Aflatoxin.“"
                            },
                            {
                                "example_id": "b952f8ee-f056-4038-b55a-2a880f469766",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„Aflatoxine sind tödliche Pilzgifte, die durch Schimmel auf Nüssen und Samen gebildet werden.“"
                            },
                            {
                                "example_id": "0045f5bd-111a-4b27-b375-81d6064beb4f",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„Die Molekülgruppe der Aflatoxine spielt wirtschaftlich eine große Rolle.“"
                            },
                            {
                                "example_id": "a58b9910-bbfa-436c-b8e1-d5b3972cbe99",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„Alleine in den Entwicklungsländern sind über 4,5 Milliarden Menschen regelmäßig zu hohen Dosen von Aflatoxinen ausgesetzt.“"
                            },
                            {
                                "example_id": "530e87ce-3fb8-4cdd-a859-2ea2c8d44d51",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„In Europa und den USA sind strenge Grenzwerte für Aflatoxine in Lebensmitteln festgesetzt, trotzdem sind sie auch hier in Pistazien, Erdnüssen und Trockenfrüchten nachweisbar.“"
                            },
                            {
                                "example_id": "7d3380d8-d73e-4451-8b1e-700dd325488a",
                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                "text": "„Aflatoxine sind thermostabil, sie können also durch Hitze nicht zerstört werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
