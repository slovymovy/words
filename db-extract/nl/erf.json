                        "target_lang_word": "basse-cour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basse-cour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8457b70-8593-39c3-89c8-30b1b81b742e",
                                        "entry_id": "cb2b2f40-ac8b-366c-942d-f797e7a453e1",
                                        "glosses": [
                                            "Cour d’une ferme, où l’on entasse le fumier, où se trouve assez ordinairement une mare d’eau et où l’on nourrit la volaille, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421c098d-71a5-4168-bc31-d4ea1705bbbf",
                                                "sense_id": "d8457b70-8593-39c3-89c8-30b1b81b742e",
                                                "text": "Une basse-cour, une étable, des toits à porcs faisaient face à la maison."
                                            },
                                            {
                                                "example_id": "30536f79-dfb9-4816-9f95-74e278d03f26",
                                                "sense_id": "d8457b70-8593-39c3-89c8-30b1b81b742e",
                                                "text": "Les volailles et autres animaux de basse-cour qui s’enfuient dans les propriétés voisines ne cessent pas d’appartenir à leur maître quoi qu’il les ait perdus de vue."
                                            },
                                            {
                                                "example_id": "4f85e9e0-fc10-472f-86a4-17c71e5418da",
                                                "sense_id": "d8457b70-8593-39c3-89c8-30b1b81b742e",
                                                "text": "On entendait, dans la basse-cour, crier les volailles que la servante poursuivait pour leur couper le cou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc5520b3-7c7a-31ea-bde4-bab33817c1c7",
                                        "entry_id": "cb2b2f40-ac8b-366c-942d-f797e7a453e1",
                                        "glosses": [
                                            "Les animaux domestiques, volaille essentiellement, qui y résident."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570da456-bd25-42d4-bbb5-c527cc6f0d86",
                                                "sense_id": "bc5520b3-7c7a-31ea-bde4-bab33817c1c7",
                                                "text": "Fille de basse-cour, servante qui s’occupait des animaux domestiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10495b95-4d21-35d1-9fbd-edee6ebcf784",
                                        "entry_id": "cb2b2f40-ac8b-366c-942d-f797e7a453e1",
                                        "glosses": [
