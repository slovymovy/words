                    },
                    {
                        "translation_id": "5178e291-5a8b-48f1-90b4-c1849ed29ea1",
                        "source_entry_id": "7fce58b8-635e-36f9-b519-888893edfcf7",
                        "source_sense_description": "back of an animal",
                        "target_lang_word": "Rücken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rücken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef908d20-6fd7-3f50-8ddd-081113858d76",
                                        "entry_id": "71ec1506-1aa9-35b9-bd47-220b7a5be4d5",
                                        "glosses": [
                                            "hintere Fläche des Oberkörpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b4583c-87ec-4045-a9da-9a6d90dfc2dc",
                                                "sense_id": "ef908d20-6fd7-3f50-8ddd-081113858d76",
                                                "text": "Du schnarchst, wenn du auf dem Rücken schläfst."
                                            },
                                            {
                                                "example_id": "b2510e32-f83a-4c0a-807f-62d7662d736b",
                                                "sense_id": "ef908d20-6fd7-3f50-8ddd-081113858d76",
                                                "text": "„Da lachte sie, stand rasch auf, ging ans Fenster, um das Buch weiter anzusehen, wandte mir den Rücken und ließ mich nach ihr rufen, soviel ich wollte.“"
                                            },
                                            {
                                                "example_id": "e4f24189-735c-4c65-823e-f171cfcb6e12",
                                                "sense_id": "ef908d20-6fd7-3f50-8ddd-081113858d76",
                                                "text": "„Und wenn ich etwas wie den frisch-feuchten Geruch der Wasserpumpe rieche, dann fühle ich mich einen Moment lang sowohl traurig als auch geborgen, und ich spüre geradezu die Wurzeln und Bucheckern in meinen Rücken zwicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc4b69db-1b56-3830-8d20-9b119e1db5c8",
                                        "entry_id": "71ec1506-1aa9-35b9-bd47-220b7a5be4d5",
                                        "glosses": [
                                            "Rückenschwimmen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541852c3-1f96-433e-9104-7debf39ffa33",
                                                "sense_id": "dc4b69db-1b56-3830-8d20-9b119e1db5c8",
                                                "text": "Unsere Staffel gewann die 200 m Rücken sowie die 400 m Lagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60e07adb-c7c8-34b0-b0d2-1423f8897a00",
                                        "entry_id": "71ec1506-1aa9-35b9-bd47-220b7a5be4d5",
                                        "glosses": [
                                            "Buchrücken"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b99a6d99-2cf2-483c-a78f-9db7413ff2f6",
                                                "sense_id": "60e07adb-c7c8-34b0-b0d2-1423f8897a00",
                                                "text": "Diese Bücher haben einen ledernen Rücken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e173da6b-c31c-3eb0-a379-2b0729213934",
                                        "entry_id": "71ec1506-1aa9-35b9-bd47-220b7a5be4d5",
                                        "glosses": [
                                            "langer Höhenzug"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a3fecf1-0440-47f3-9ac9-f2874e031c30",
                                                "sense_id": "e173da6b-c31c-3eb0-a379-2b0729213934",
                                                "text": "Der Mittelatlantische Rücken durchzieht den Atlantischen Ozean von Norden nach Süden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
