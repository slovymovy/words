    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "356bc943-4211-3ece-8d9c-39b967bf745d",
                    "sense_definition": "Een grote, drukke menigte mensen die dicht op elkaar staan en duwen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkelbediende leidde ons door het <w>gedrang</w> naar de balie.",
                            "target_lang_translations": {
                                "de": "Der Verkäufer führte uns durch das <w>Gedränge</w> zum Schalter."
                            }
                        },
                        {
                            "text": "Hij baande zich een weg door het drukke <w>gedrang</w> op het treinstation.",
                            "target_lang_translations": {
                                "de": "Er bahnte sich einen Weg durch das dichte <w>Gedränge</w> am Bahnhof."
                            }
                        }
                    ],
                    "synonyms": [
                        "massa",
                        "menigte",
                        "gedrum"
                    ],
                    "common_phrases": [
                        "het drukke gedrang",
                        "door het gedrang"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine große, dicht gedrängte Menschenmenge, die schiebt und drängelt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gedränge",
                                "target_lang_sense_clarification": "dicht stehende Menschenmenge"
                            },
                            {
                                "target_lang_word": "Getümmel",
                                "target_lang_sense_clarification": "lebhaftes Gedränge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3735101-cc23-34dc-ba6c-ee3c5d0ad7dc",
                    "sense_definition": "Een knelpositie of een situatie waarin iets bedreigd of in gevaar gebracht wordt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de bezuinigingen komt de kwaliteit van het onderwijs erg in het <w>gedrang</w>.",
                            "target_lang_translations": {
                                "de": "Durch die Einsparungen gerät die Qualität der Bildung stark in <w>Bedrängnis</w>."
                            }
                        },
                        {
                            "text": "Als we geen actie ondernemen, raakt het voortbestaan van ons project in het <w>gedrang</w>.",
                            "target_lang_translations": {
                                "de": "Wenn wir nicht handeln, gerät der Fortbestand unseres Projekts in <w>Gefahr</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "knel",
                        "gevaar"
                    ],
                    "common_phrases": [
                        "in het gedrang",
                        "in het gedrang komen",
                        "in het gedrang raken"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Notlage oder Situation, in der etwas gefährdet oder bedroht wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bedrängnis",
                                "target_lang_sense_clarification": "in einer schwierigen Situation"
                            },
                            {
                                "target_lang_word": "Gefahr",
                                "target_lang_sense_clarification": "Gefährdung von etwas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
