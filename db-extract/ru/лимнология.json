                "senses": [
                    {
                        "sense_id": "b2dd30a5-5061-3620-9184-a2d539899db3",
                        "entry_id": "af036a64-1247-367b-ae0e-6e2fb7c11337",
                        "glosses": [
                            "раздел гидрологии суши, изучающий водоёмы суши (озёра, водохранилища, пруды и др.), весь комплекс происходящих в них физических, химических и биологических процессов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30ae5b7f-d908-4536-872a-d2d580a7eea5",
                        "source_entry_id": "af036a64-1247-367b-ae0e-6e2fb7c11337",
                        "source_sense_id": "b2dd30a5-5061-3620-9184-a2d539899db3",
                        "target_lang_word": "limnology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                        "entry_id": "3a1f4852-5021-3094-a082-725bd3d776ce",
                                        "glosses": [
                                            "The science concerning the biological, physical and geological properties of fresh water bodies, especially lakes and ponds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61daaf38-7584-47d4-9330-50c070a5a92e",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "Although limnology is a young discipline, it has, over the past century, experienced marked growth. Its early descriptive period was a long one, given the enormous diversity of biota and environments in freshwater ecosystems."
                                            },
                                            {
                                                "example_id": "8e5eefa4-7a7e-4dc5-b77c-61fb7f5d6a2b",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "The exercises in this book were set forth initially because of our frustrations in teaching such a complex, multifaceted discipline as limnology."
                                            },
                                            {
                                                "example_id": "a97d38d9-0ee6-4107-96b0-8abdb2d6aba3",
                                                "sense_id": "4019b149-d068-34bd-904a-34e83391cfff",
                                                "text": "Reservoir limnology and water quality management are associated with functions such as flood control, hydropower generation, irrigation, and fishery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f3b805e-924d-40a2-938a-ecdb5f18caae",
                        "source_entry_id": "af036a64-1247-367b-ae0e-6e2fb7c11337",
                        "source_sense_id": "b2dd30a5-5061-3620-9184-a2d539899db3",
                        "target_lang_word": "limnologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limnologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7379acb0-8fc9-33be-8fe9-58a736cb2b3e",
                                        "entry_id": "9d0bcd0e-987f-3361-9acf-faa148ba14bc",
                                        "glosses": [
                                            "Science des eaux superficielles continentales ou intérieures (eau douce ou salée, stagnante ou mouvante, dans les lacs, rivières, marécages…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212750bc-6599-417a-b631-324abb5c8969",
                                                "sense_id": "7379acb0-8fc9-33be-8fe9-58a736cb2b3e",
                                                "text": "La limnologie est la discipline qui étudie les phénomènes hydrologiques et biologiques se rapportant aux lacs en relation avec leur environnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
