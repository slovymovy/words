                                        "glosses": [
                                            "Fluggesellschaft, die ihre Flüge zu sehr niedrigen Preisen anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df05a590-279e-46fd-9b42-aa7693755ec2",
                                                "sense_id": "764b7c90-d874-3822-b2af-a0aca74f33a4",
                                                "text": "Wir haben einen Flug bei einer Billigfluggesellschaft gebucht, um nach Berlin zu kommen."
                                            },
                                            {
                                                "example_id": "bd521e5e-3d2f-40dd-aad4-a2b2e84f5308",
                                                "sense_id": "764b7c90-d874-3822-b2af-a0aca74f33a4",
                                                "text": "Hilke hat als Stewardess schon bei zwei Billiggesellschaften gearbeitet."
                                            }
