                                        "entry_id": "aaae21d3-ef4f-3913-930c-2e83c6946ce0",
                                        "glosses": [
                                            "In a secure manner; without fear or apprehension; without danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50083eb5-a9a1-4d9f-969e-934d8dfa090f",
                                                "sense_id": "bb0ba900-94cd-3ecc-9321-e21ae0362e41",
                                                "text": "Check all personal items are securely stowed in the overhead lockers."
                                            },
                                            {
                                                "example_id": "209882e2-8924-4bf0-b08f-9ecfce85d6ef",
                                                "sense_id": "bb0ba900-94cd-3ecc-9321-e21ae0362e41",
                                                "text": "A square seat, about as wide and unyielding as a table-top, was strapped securely to each donkey, and to this seat we clung, with no secureness at all."
                                            },
                                            {
                                                "example_id": "79bc8118-2570-49c0-8ff7-9c325e1e32a4",
                                                "sense_id": "bb0ba900-94cd-3ecc-9321-e21ae0362e41",
                                                "text": "Only 5% of securely attached male subjects showed subsequent psychopathology compared to 40% of the insecurer attached males."
