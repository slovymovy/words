        "fr-extract.jsonl": [
            {
                "entry_id": "db6d944a-ca2b-3c25-94b0-f217c9474415",
                "word": "aromate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51fb2107-5c29-4bbd-839b-f2ce24286101",
                        "entry_id": "db6d944a-ca2b-3c25-94b0-f217c9474415",
                        "tags": [
                            "plural"
                        ],
                        "form": "aromates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                        "entry_id": "db6d944a-ca2b-3c25-94b0-f217c9474415",
                        "glosses": [
                            "Substance odoriférante appartenant généralement au règne végétal, plus rarement au règne animal, utilisée en médecine, en parfumerie et surtout en cuisine comme condiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c2e7abc-d1aa-40f9-8c94-459525a79766",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Le soleil, parvenu au zénith, brûlait de toute la force de ses feux, mais, sous les allées épaisses et sombres, il faisait doux pour se promener, et les fleurs, réchauffées par le soleil, triplaient leurs aromates."
                            },
                            {
                                "example_id": "d69eb236-762e-446e-b5cc-07a5ba9bac11",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Il suffit d’y ajouter l’herbe, l’aromate ou le condiment voulu."
                            },
                            {
                                "example_id": "442f4b02-d31c-45c7-8b52-6f436f48485d",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Unique aromate de la cuisson des grives, la sauge avait son petit buisson au jardin. Elle sortait du domaine culinaire pour entrer dans la pharmacopée domestique – au même titre que de nombreuses plantes aromatiques."
                            },
                            {
                                "example_id": "17d4b9fd-06e3-4261-876a-70601796c61b",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Les personnages royaux (Henri premier d’Angleterre, Louis XIV, Philippe le Hardi, par exemple) subissent l’embaumement qui consiste à remplir le cadavre éviscéré d’aromates tels que l’ambre, le miel, le musc, jusqu’aux obsèques."
                            },
                            {
                                "example_id": "0841ccc0-6231-4811-8931-2f4cd32fffef",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Le baume, le storax, la cannelle, l’encens, le genièvre, le girofle, la muscade, etc., sont des aromates."
                            },
                            {
                                "example_id": "34106f12-a322-47a6-9300-f92ccee3bd1f",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "Aromate précieux."
                            },
                            {
                                "example_id": "84aaf19f-88b0-4c03-ac22-c7da865ea44d",
                                "sense_id": "d3d4e076-1a08-30bf-84d6-b5174d5272fa",
                                "text": "La plupart des aromates croissent dans les pays chauds et nous arrivent du Levant."
                            }
                        ]
                    }
                ],
