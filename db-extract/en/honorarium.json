                        ]
                    },
                    {
                        "translation_id": "8cf7edc4-7b9d-4f28-aa39-6b01e9ff854e",
                        "source_entry_id": "267795c0-04df-3e5f-9dd2-c3cda00ba4f6",
                        "source_sense_id": "82273e73-7fe7-360c-9dda-65d1194e617f",
                        "source_sense_description": "compensation for services",
                        "target_lang_word": "honoraires",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honoraires",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "812252ba-4416-353e-86af-7dd227fd93b8",
                                        "entry_id": "3f1dd887-e0d4-31b0-b914-1d5e4c11cd86",
                                        "glosses": [
                                            "Rétribution que l’on donne à quelqu’un qui exerce une profession libérale."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e599c874-a67f-4daf-a522-2cbe1d71d1f5",
                                                "sense_id": "812252ba-4416-353e-86af-7dd227fd93b8",
                                                "text": "Une très grande partie des ressources réunies par nos ménages du XXᵉ siècle passe en oripeaux inutiles, en colifichets, en fioles, en brimborions, en honoraires de coiffeurs, en cosmétiques."
                                            },
                                            {
                                                "example_id": "80a43775-ae78-4482-b32e-f9439c4dc13a",
                                                "sense_id": "812252ba-4416-353e-86af-7dd227fd93b8",
                                                "text": "L'heure n'est plus où l’honoraire de l’avocat était une simple libéralité faite à un membre de la noblesse qui pouvait d'ailleurs s'en passer, ce qui allait de pair avec l’irrépétibilité devenue désuète."
                                            },
                                            {
                                                "example_id": "fcaf7569-07a9-42d6-841d-22a826d87f3d",
                                                "sense_id": "812252ba-4416-353e-86af-7dd227fd93b8",
                                                "text": "L’accidentologue, chargé d'étudier l’état de la chaussée, rendra un mémoire d’honoraires de 6 500 euros."
                                            },
                                            {
                                                "example_id": "4660e250-f48b-4f09-848b-9e58bf016240",
                                                "sense_id": "812252ba-4416-353e-86af-7dd227fd93b8",
                                                "text": "Cependant, il convient de retenir que les honoraires du radiesthésiste ne doivent pas être excessifs, sans quoi il perdrait rapidement sa clientèle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "honoraires",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5764349f-8df5-35cc-b29c-659a08f88c65",
                                        "entry_id": "241a9705-925e-340f-b087-15da84fb2e59",
