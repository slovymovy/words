                            },
                            {
                                "target_lang_word": "to pull out",
                                "target_lang_sense_clarification": "to withdraw from an agreement or deal"
                            },
                            {
                                "target_lang_word": "to give up",
                                "target_lang_sense_clarification": "to stop trying because it is too difficult"
                            },
                            {
                                "target_lang_word": "to back out",
                                "target_lang_sense_clarification": "to decide not to do something previously agreed upon"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "abandonner",
                                "target_lang_sense_clarification": "quitter une compétition ou une activité"
                            },
                            {
                                "target_lang_word": "laisser tomber",
                                "target_lang_sense_clarification": "renoncer à poursuivre une activité ou un projet"
                            },
                            {
                                "target_lang_word": "se désister",
                                "target_lang_sense_clarification": "retirer son engagement ou sa participation"
                            },
                            {
                                "target_lang_word": "décrocher",
                                "target_lang_sense_clarification": "perdre le rythme ou cesser de participer"
                            }
                        ]
