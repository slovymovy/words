                    {
                        "translation_id": "3de298bb-8d68-461c-af39-1c0432b3c18a",
                        "source_entry_id": "8cc2cf50-1a15-3266-956c-d1ebda51c5e6",
                        "source_sense_id": "cd9853a0-26c5-36fa-8fd3-657e3e8d051a",
                        "target_lang_word": "spachteln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spachteln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                        "entry_id": "13d5b3df-cb46-387c-bc3d-d833ef1f0c92",
                                        "glosses": [
                                            "eine zähflüssige Masse mit einem geeigneten Werkzeug (Spachtel) auf einen Untergrund aufbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbafa5b-4a2d-4ffa-b9cf-6f324928d9fa",
                                                "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                                "text": "Die Spachtelmasse in die Lücken füllen und dann glatt spachteln."
                                            },
                                            {
                                                "example_id": "ab6c38f6-fafe-4e7d-8bc8-37e3ba5a7353",
                                                "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                                "text": "Erst spachteln wir die Wand, dann wird sie gestrichen."
                                            },
                                            {
                                                "example_id": "460fb925-bc14-48a6-b8a9-b20c83ce9956",
                                                "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                                "text": "Als letztes spachteln sie die Fugen."
                                            },
                                            {
                                                "example_id": "04762158-85de-4dc8-a365-14d5fcfac6d3",
                                                "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                                "text": "„Er schmirgelt, spachtelt, schmirgelt wieder, bringt dann eine Grundierfarbe und darauf den Grundton auf.“"
                                            },
                                            {
                                                "example_id": "6e2fe90f-e414-453d-a3bf-a71d18e41483",
                                                "sense_id": "b8cf4908-2afc-3561-85ff-bb8fedcfd2e3",
                                                "text": "„Diese Gemälde sind mild in der Farbe, aber massig im Auftrag, die Tempera ist gespachtelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcada8a9-b418-3c4b-8418-de442e8f399c",
                                        "entry_id": "13d5b3df-cb46-387c-bc3d-d833ef1f0c92",
                                        "glosses": [
                                            "eher hastig und größere Mengen essen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612d9f86-341f-4152-a213-8e450bc26407",
                                                "sense_id": "fcada8a9-b418-3c4b-8418-de442e8f399c",
                                                "text": "„Jeder schaufelt sich erst den Teller voll, dann wird gespachtelt. Und gespachtelt. Und gespachtelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e645a23-a289-4362-8b6c-2b016f6b6816",
                        "source_entry_id": "8cc2cf50-1a15-3266-956c-d1ebda51c5e6",
                        "source_sense_id": "cd9853a0-26c5-36fa-8fd3-657e3e8d051a",
                        "target_lang_word": "mastiquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastiquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                        "entry_id": "8bd46698-0030-3894-aece-22441e071012",
                                        "glosses": [
                                            "Mâcher avec soin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8603355c-0215-46f5-a558-1140a2389efb",
                                                "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                                "text": "Et tous ces mets criaient des choses nonpareilles\nMais nom de Dieu !\nVentre affamé n’a pas d’oreilles\nEt les convives mastiquaient à qui mieux mieux."
                                            },
                                            {
                                                "example_id": "5067540d-6229-444c-b550-1fdea304a60f",
                                                "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                                "text": "Après la conversation de l’écurie, dont toute la famille Haudouin avait eu déjà des échos, on aurait pu croire que le repas allait être mastiqué dans un silence consterné."
                                            },
                                            {
                                                "example_id": "2d2236c9-43b6-4314-8e4a-472394a3a1ff",
                                                "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                                "text": "Lorsque je mangeais une côtelette, il m’arrivait de penser que je mastiquais une tranche d’une bête morte depuis plusieurs jours, et que j’imprégnais de gluante salive ce petit morceau de cadavre, et j’avais mal au cœur à l’idée que cette action répugnante n’était que le prélude d’un épouvantable dénouement."
                                            },
                                            {
                                                "example_id": "3e062b56-a4d6-49ce-8c57-e15e45e7aace",
                                                "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                                "text": "On y mange bien, ce que Michel ne dédaigne pas. Mais l’importance donnée à la boustifaille, par les femmes surtout, dégoûte cet amateur de plats simples. Il pense, comme Byron, qu’il n’y a pas grand plaisir à voir mastiquer une belle."
                                            },
                                            {
                                                "example_id": "6a9a1e2b-eb7e-432d-9565-653949f8a38a",
                                                "sense_id": "daba45df-ff46-3315-858f-64ad708f2169",
                                                "text": "La plupart des oiseaux ne peuvent pas mastiquer leur nourriture et le gésier renferme des gastrolithes (des petits cailloux ingérés, les pierres du gésier, du gravier) responsables du broyage de ce qui est ingéré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mastiquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "231b59ae-be4b-3cdb-9689-70267da10fb9",
                                        "entry_id": "05790806-ae8a-3d47-a46c-651700d48d53",
                                        "glosses": [
                                            "Joindre ou coller avec du mastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f7bbf47-730a-477d-8429-b50990261e10",
                                                "sense_id": "231b59ae-be4b-3cdb-9689-70267da10fb9",
                                                "text": "Le maquignon de bas étage […] travaille les oreilles, souffle les salières, burine les dents, place une queue postiche, taille les sabots, mastique les seimes, donne un coup de pinceau, refait une jeunesse, farde, corrige, embellit ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
