                        "glosses": [
                            "Se surexciter à soi-même son propre sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e13fa94-bc56-4ada-a76b-0037ab7d0388",
                                "sense_id": "6c6b21ac-3421-3aac-a428-5a12bcda7850",
                                "text": "Le gamin s'auto-surexcite pour compenser."
                            },
                            {
                                "example_id": "7e5dd396-0e1f-43d9-97a9-26201c13f32d",
                                "sense_id": "6c6b21ac-3421-3aac-a428-5a12bcda7850",
                                "text": "Trop commercial à mon goût, ce phénomène de masse, de consommation téléguidée (au sens propre du terme) avec des mouvements de foules, des excités de la carte bleue qui s'auto-surexcitent mutuellement comme si leur amour en dépendait… très peu pour moi."
                            }
                        ]
                    }
