                                "target_senses": [
                                    {
                                        "sense_id": "83a76c87-16f9-33e1-9eed-b4c4178bb863",
                                        "entry_id": "2bb81b5b-996f-3a48-ad75-59591eea14dc",
                                        "glosses": [
                                            "die Bedingungen erfüllen, um etwas machen zu können"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37ad78d2-a993-4641-957d-9026be4be3f3",
                                                "sense_id": "83a76c87-16f9-33e1-9eed-b4c4178bb863",
                                                "text": "„Sowohl die Fotografie als auch das Marketing sind verschiedene Fächer der Kommunikation. Und nur, weil Sie in einem gut sind, qualifiziert Sie das nicht automatisch für das andere.“"
                                            },
                                            {
                                                "example_id": "60b0913f-10f8-4770-91b5-b92b5f74db40",
                                                "sense_id": "83a76c87-16f9-33e1-9eed-b4c4178bb863",
                                                "text": "Die Mannschaft hat sich für das Viertelfinale qualifiziert."
                                            },
                                            {
                                                "example_id": "742e970f-8e97-48c5-8a60-5243e8125d1f",
                                                "sense_id": "83a76c87-16f9-33e1-9eed-b4c4178bb863",
                                                "text": "Die Plätze 1–3 qualifizierten sich direkt für die Olympischen Spiele."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0027b15-e36e-3186-ab37-d8784a78ff40",
                                        "entry_id": "2bb81b5b-996f-3a48-ad75-59591eea14dc",
                                        "glosses": [
                                            "jemanden weiterbilden, durch Lernen und Üben Kompetenzen erhöhen und geeignet machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad2bc83-4e0f-45a6-854b-ec10daaa1304",
                                                "sense_id": "c0027b15-e36e-3186-ab37-d8784a78ff40",
                                                "text": "„Die Maßnahme qualifiziert die Teilnehmer/innen in modularer Form für eine Stelle in Handwerksbetrieben.“"
                                            },
                                            {
                                                "example_id": "9d486b12-d3f8-4f96-8d3b-a2ba3b7e3e30",
                                                "sense_id": "c0027b15-e36e-3186-ab37-d8784a78ff40",
                                                "text": "„So könnte man seine umfassende Ausbildung verstehen, die ihn qualifiziert, den Menschen als Leib-, Seele- und Sozialnatur in seinen offenen Fragen und Problemen zu verstehen und ihm Hilfe anzubieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
