                "senses": [
                    {
                        "sense_id": "7a91d037-050b-301e-9a2d-d81d38ef06c9",
                        "entry_id": "6a087625-fd5a-33bc-8135-f5d326ca0a94",
                        "glosses": [
                            "to perpetuate, to prolong, to reinforce, to consolidate"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89c32f8b-c646-4ca9-bd1b-caf20c6c6a93",
                                "sense_id": "7a91d037-050b-301e-9a2d-d81d38ef06c9",
                                "text": "De wet is aangenomen om de vrede te bestendigen tussen de twee landen.",
                                "translation": "The law was passed to perpetuate peace between the two countries.",
                                "english": "The law was passed to perpetuate peace between the two countries."
                            },
                            {
                                "example_id": "a3020d3b-4dec-4fff-80c4-a95df10de0bb",
                                "sense_id": "7a91d037-050b-301e-9a2d-d81d38ef06c9",
                                "text": "Het nieuwe beleid zal de economische groei bestendigen en stimuleren.",
                                "translation": "The new policy will prolong and stimulate economic growth.",
                                "english": "The new policy will prolong and stimulate economic growth."
                            },
                            {
                                "example_id": "ac736f8b-1452-49ab-879d-998e13ada79a",
                                "sense_id": "7a91d037-050b-301e-9a2d-d81d38ef06c9",
                                "text": "De overheid heeft maatregelen genomen om de sociale cohesie te bestendigen en te versterken.",
                                "translation": "The government has taken measures to reinforce and strengthen social cohesion.",
                                "english": "The government has taken measures to reinforce and strengthen social cohesion."
                            },
                            {
                                "example_id": "da33d78d-2e66-4cf7-ba68-7aa298d3443c",
                                "sense_id": "7a91d037-050b-301e-9a2d-d81d38ef06c9",
                                "text": "De nieuwe regering zal proberen de hervormingen van het vorige regime te bestendigen en te consolideren.",
                                "translation": "The new government will try to consolidate and solidify the reforms of the previous regime.",
                                "english": "The new government will try to consolidate and solidify the reforms of the previous regime."
                            }
                        ]
                    }
                ],
