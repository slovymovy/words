                        "glosses": [
                            "Couteau pour scarifier la pâte du pain."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "348976ee-6679-42d6-b7da-3e690f77a2b8",
                                "sense_id": "c38501a5-f13e-3811-9024-142aecd564b7",
                                "text": "Les grignettes sont l’ustensile idéal pour scarifier la pâte à pain déjà formée. Elles disposent d’une lame très tranchante en acier inoxydable qui permet de couper sans exercer une forte pression."
                            }
