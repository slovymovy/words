                "senses": [
                    {
                        "sense_id": "9dbd2128-e6aa-3dad-ab0c-55a994c509d0",
                        "entry_id": "d17b8459-4fe8-3aec-9de6-cb46af672532",
                        "glosses": [
                            "Pore mit einem Durchmesser von 2 bis 50 Nanometern"
                        ],
                        "tags": [
                            "von Materialien"
                        ],
                        "examples": [
                            {
                                "example_id": "105efc36-fca4-48fe-a474-963825fce462",
                                "sense_id": "9dbd2128-e6aa-3dad-ab0c-55a994c509d0",
                                "text": "„Der Grund hierfür ist das Überlappen der elektrostatischen Doppelschicht in den Mikro- und Mesoporen der stationären Phase.“"
                            },
                            {
                                "example_id": "f2a9273c-216f-4f72-9c2b-20c9f532dc3d",
                                "sense_id": "9dbd2128-e6aa-3dad-ab0c-55a994c509d0",
                                "text": "„Eher der Anteil an Mesoporen am Gesamtporenvolumen bestimmt das Sackungsverhalten maßgebend.“"
                            },
                            {
                                "example_id": "87c6edfd-31c6-48c5-a00d-77c162ac0fe8",
                                "sense_id": "9dbd2128-e6aa-3dad-ab0c-55a994c509d0",
                                "text": "„Kleine Mesoporen im Silicagel-Gerüst vergrößern die spezifische Oberfläche und dienen der Verbesserung des Trennprozesses bei höheren Flussraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
