                        "cross_references": [
                            {
                                "target_word": "landscape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0b778d-80b9-3ef8-b030-111118c47ec6",
                                        "entry_id": "3bc54a5d-37d4-32cb-8dca-3f29a76ed3e5",
                                        "glosses": [
                                            "A portion of land or territory as defined by its landform, its geographical (and architectural) features."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f91c903-9b35-4df1-b48e-e177c97ac584",
                                                "sense_id": "9b0b778d-80b9-3ef8-b030-111118c47ec6",
                                                "text": "Its steel helped build America, from the skyscrapers dotting city landscapes to the cars speeding down highways, to the appliances inside millions of homes."
                                            },
                                            {
                                                "example_id": "ec7d6697-9ef7-4822-988e-9c40d76241f0",
                                                "sense_id": "9b0b778d-80b9-3ef8-b030-111118c47ec6",
                                                "text": "Piſcat[or]. [...] [T]heſe Hills though high, bleak, and craggy, breed and feed good Beef, and Mutton above ground, and afford good ſtore of Lead within. / Viat[or]. They had need of all thoſe commodities to make amends for the ill Land-ſchape: [...]"
                                            },
                                            {
                                                "example_id": "a65c14a3-c26d-497e-9212-f9852ffbc5dd",
                                                "sense_id": "9b0b778d-80b9-3ef8-b030-111118c47ec6",
                                                "text": "Ahead the flanks of the Pennines gleamed faintly in the moonlight, looking as though they themselves were part of some dry and deserted lunar landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cdfbe71-cf9e-30b2-9803-a2a6604939fe",
                                        "entry_id": "3bc54a5d-37d4-32cb-8dca-3f29a76ed3e5",
                                        "glosses": [
                                            "A portion of land which the eye can comprehend in a single view, including all the objects thus seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d83fbcc-4e6c-4322-b173-8c545b959e72",
                                                "sense_id": "3cdfbe71-cf9e-30b2-9803-a2a6604939fe",
                                                "text": "The rolling Chocolate Hills of Bohol in the Philippines could easily be mistaken for a child’s landscape drawing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bec061a-6afe-3ae0-98d5-aabe2f6c686d",
                                        "entry_id": "3bc54a5d-37d4-32cb-8dca-3f29a76ed3e5",
                                        "glosses": [
                                            "A sociological aspect of a physical area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b531bc8-14b5-410e-9c88-93a210002084",
                                                "sense_id": "2bec061a-6afe-3ae0-98d5-aabe2f6c686d",
                                                "text": "In light of such conceptualisations of the power of linguistic landscapes, we set out to examine the connection between the visual landscape and the spoken landscape in our institution[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8243186-97f4-3c15-a6ed-df642ed313eb",
                                        "entry_id": "3bc54a5d-37d4-32cb-8dca-3f29a76ed3e5",
                                        "glosses": [
                                            "A picture representing a real or imaginary scene by land or sea, the main subject being the general aspect of nature, as fields, hills, forests, water, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e848e8-04bb-48e5-8eb2-fb66f7caf2a9",
                                                "sense_id": "e8243186-97f4-3c15-a6ed-df642ed313eb",
                                                "text": "The mother, Ekaterina Pavlovna, who at one time had been handsome, but now, asthmatic, depressed, vague, and over-feeble for her years, tried to entertain me with conversation about painting. Having heard from her daughter that I might come to Shelkovka, she had hurriedly recalled two or three of my landscapes which she had seen in exhibitions in Moscow, and now asked what I meant to express by them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc79611e-1ccb-3606-82d9-6425cdff302d",
                                        "entry_id": "3bc54a5d-37d4-32cb-8dca-3f29a76ed3e5",
                                        "glosses": [
                                            "The pictorial aspect of a country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
