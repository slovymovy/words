                "senses": [
                    {
                        "sense_id": "f70388f5-d173-3e5b-b8c3-0c73335ea0cb",
                        "entry_id": "c68cea80-a1c4-31b8-97a0-8506a00197b8",
                        "glosses": [
                            "Découper en morceaux (paquets)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8a7e09-ed13-41ef-934f-adfb9c540a07",
                                "sense_id": "f70388f5-d173-3e5b-b8c3-0c73335ea0cb",
                                "text": "Est-ce que ça intéresse quelqu'un de les paquetiser ?"
                            },
                            {
                                "example_id": "8796b4c2-8834-4e1c-a6f5-957c2d935a99",
                                "sense_id": "f70388f5-d173-3e5b-b8c3-0c73335ea0cb",
                                "text": "L'option Diviser permet de paquetiser (fractionner) le contenu des fichiers en fonction d'un délimiteur défini par l'utilisateur."
                            },
                            {
                                "example_id": "f5cfb2a5-c0b0-4859-adc3-6f43a989ed49",
                                "sense_id": "f70388f5-d173-3e5b-b8c3-0c73335ea0cb",
                                "text": "Une solution simple serait de considérer le codec permettant de paquetiser la voix et de voir combien de bande passante est disponible."
                            }
                        ]
                    }
