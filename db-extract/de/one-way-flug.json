                        "glosses": [
                            "einfacher Flug zu einem bestimmten Ziel, Flug ohne (bereits gebuchten) Rückflug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12907dda-21b8-4c46-ad49-ca46ceb952a6",
                                "sense_id": "f477096c-8953-32d0-8314-75ce4e52979a",
                                "text": "Weil ich nicht wusste, wie lange ich in Honduras zu tun haben würde, buchte ich zunächst nur einen One-Way-Flug nach Tegucigalpa."
                            },
                            {
                                "example_id": "769a2f54-b546-460b-8074-83f788c98255",
                                "sense_id": "f477096c-8953-32d0-8314-75ce4e52979a",
                                "text": "„Kunden des Billigfliegers Easyjet können die Wartezeit jetzt auch in komfortablen Flughafen-Lounges überbrücken. Allerdings kann das teurer sein als ein One-Way-Flug zum günstigsten Preis.“"
                            }
                        ],
