                        "translation_id": "baab5eb1-d4c0-4c93-a3f1-e3b3b3704027",
                        "source_entry_id": "cd65fb57-23b2-3229-a8a9-7affdc5dbfda",
                        "source_sense_id": "b37c4862-84a4-3df8-bdf4-4ba0b2013741",
                        "target_lang_word": "qadi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qadi",
