                        "entry_id": "257f73aa-81f5-35b1-bdb0-310f169d5278",
                        "glosses": [
                            "im Mittelmeerraum weit verbreitete Art der Kiefern, die viel Harz produziert, eine schirmförmige Baumkrone besitzt und eine Höhe von 10 bis 20 Metern erreicht (Pinus halepensis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac83b6ab-1dc4-4537-ac3c-acf713dbf5b7",
                                "sense_id": "c6ac80ce-efda-34d3-891b-62cc344ef5ed",
                                "text": "Auf den Calanques in Südfrankreich kann man unter anderem die Aleppokiefer finden."
                            },
                            {
                                "example_id": "986287e2-112f-4b8f-badf-c51a3ad72dc2",
                                "sense_id": "c6ac80ce-efda-34d3-891b-62cc344ef5ed",
                                "text": "„Sie saßen auf der Terrasse, über die Mandelbäume und Aleppokiefern konnten sie in die Ebene sehen und weiter bis zum Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
