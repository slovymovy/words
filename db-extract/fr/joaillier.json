                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juwelenhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d228d25a-a851-3f10-bd54-6fe8ba0010aa",
                                        "entry_id": "ed4bf630-7c13-3614-8145-9b969b5efab0",
                                        "glosses": [
                                            "Person, die mit Juwelen handelt, Juwelen kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f91fbbf7-ade2-49d2-9983-35e1edec995c",
                                                "sense_id": "d228d25a-a851-3f10-bd54-6fe8ba0010aa",
                                                "text": "„Quanga der Jäger hatte in Begleitung von Hoom Feethos und Eibur Tsanth, zwei der abgefeimtesten und furchtlosesten Juwelenhändler, die in Iqqua zu finden waren, die Grenzen eines Gebietes überschritten, wohin Menschen sich nur selten vorwagten - und woher sie noch seltener wieder zurückkehrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
