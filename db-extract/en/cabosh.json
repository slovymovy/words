                        "glosses": [
                            "The entirety of something. (usually in the phrase \\\"the whole cabosh\\\")."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7326f32a-c9b5-4bfd-867a-304234e658bb",
                                "sense_id": "12a99b84-ae11-35e3-980e-c94b8f089618",
                                "text": "Out in Kansas one of these masters cum An bought at least ten miles of land around, To work the whole cabosh with boughten nigs, To keep the Eastern boys from settlin' there."
                            },
                            {
                                "example_id": "5c03514f-e7f5-4322-b89c-ef687fffed3a",
                                "sense_id": "12a99b84-ae11-35e3-980e-c94b8f089618",
                                "text": "But Colonel Robertson has gone to Vlady and his place has been taken by a typical Britisher in the person of Consul Hodgson, who took correct measures of the situation and in less than 48 hours herded the whole cabosh back into their own compounds."
                            },
                            {
                                "example_id": "9f704760-3f6b-4ec3-9098-34b49878e5e9",
                                "sense_id": "12a99b84-ae11-35e3-980e-c94b8f089618",
                                "text": "She would drive into Leeston to that posh hairdresser's, 'Sue and Nicky', and have the whole cabosh, especially a rinse to bring out the copper glints in her hair."
                            }
                        ]
                    }
