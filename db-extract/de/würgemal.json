                "senses": [
                    {
                        "sense_id": "c3c2f267-8afb-3f6b-833e-50c7dbe0d022",
                        "entry_id": "91fafcc3-a968-3086-afd5-702c4845d6e0",
                        "glosses": [
                            "durch Würgen entstandene Verfärbung der Haut, sichtbarer Fleck als Folge von Würgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a304c976-4207-40db-b26d-596e08a8daa5",
                                "sense_id": "c3c2f267-8afb-3f6b-833e-50c7dbe0d022",
                                "text": "„Nach den Würgemalen an ihrem Hals zu urteilen war der Tod durch Strangulieren eingetreten, wahrscheinlich mit einem zirka sechs Zentimeter breiten Gürtel.“"
                            },
                            {
                                "example_id": "15cdbc0b-910e-4fbe-9198-35e7c3cceefa",
                                "sense_id": "c3c2f267-8afb-3f6b-833e-50c7dbe0d022",
                                "text": "„Überall sickerte Blut aus Einschusslöchern; Klumpen von Hirnmasse, aus denen Flüssigkeit austrat, waren über eine ganze Wand verspritzt; De Witt hatte noch deutliche Würgemale dort am Hals, wo ich ihn umklammert gehalten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
