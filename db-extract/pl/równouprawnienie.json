                "senses": [
                    {
                        "sense_id": "02924526-8a20-32b0-b24c-3daa93663f5a",
                        "entry_id": "74deb955-2a95-39b2-a600-bb4125924884",
                        "glosses": [
                            "równość wobec prawa, możliwość korzystania z jednakowych praw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9017363-0915-4230-aca7-bbfc1240b27f",
                                "sense_id": "02924526-8a20-32b0-b24c-3daa93663f5a",
                                "text": "Zwolennikami równouprawnienia poligamii są natomiast zarówno postępowi lewicowcy, którzy w jej zabranianiu widzą \"rasistowskie prześladowanie mniejszości\", jak i prawicowi liberałowie, którzy podobny zakaz uważają za \"niebezpieczną ingerencję państwa w życie prywatne jednostki\""
                            },
                            {
                                "example_id": "3f278b9c-b011-41eb-87ac-a7fdc7cb1372",
                                "sense_id": "02924526-8a20-32b0-b24c-3daa93663f5a",
                                "text": "[…] w 1873 r. pisał, że równouprawnienie Żydów już się dokonało, a z tego faktu mogą wyniknąć korzyści dla kraju z uwagi, jak podkreślono, na pewne cechy tej ludności, np. pracowitość, rzutkość, zapobiegliwość itp. […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c76956-29e3-4a78-8f8d-b4a97714897b",
