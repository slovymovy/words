                "senses": [
                    {
                        "sense_id": "407bcf35-baf0-33dc-9f76-74ebea570806",
                        "entry_id": "d8545a35-629e-3778-a269-9ee69dcabac6",
                        "glosses": [
                            "to hang, to hang up"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a0e8e05-c579-3eff-9cf6-c45edab47a00",
                        "entry_id": "d8545a35-629e-3778-a269-9ee69dcabac6",
                        "glosses": [
                            "to hang (to execute by hanging)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b860870-44a6-4f1e-8609-ee1b49fd781a",
                                "sense_id": "9a0e8e05-c579-3eff-9cf6-c45edab47a00",
                                "text": "— Я тебе́ не слуга́, разбо́йник, — отвеча́л чё́рный, не пока́зывая боя́зни, — а тебя́ пове́сят, что́бы не смел тро́гать ца́рских люде́й!",
                                "translation": "\"I'm not your servant, you wretch,\" answered the black one without showing fear, \"and they'll hang you so you don't dare to touch royal people!\"",
                                "english": "\"I'm not your servant, you wretch,\" answered the black one without showing fear, \"and they'll hang you so you don't dare to touch royal people!\""
                            },
                            {
                                "example_id": "4c4ffc33-1eb2-4a6d-b849-377ce69ed9c1",
                                "sense_id": "9a0e8e05-c579-3eff-9cf6-c45edab47a00",
                                "text": "Пове́сить (непреме́нно пове́сить, дабы́ наро́д ви́дел) не ме́ньше 100 заве́домых кулако́в, богате́ев, кровопи́йцев.",
                                "translation": "Hang (hang without fail, so the people see) no fewer than one hundred known kulaks, rich men, bloodsuckers.",
                                "english": "Hang (hang without fail, so the people see) no fewer than one hundred known kulaks, rich men, bloodsuckers."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
