                "senses": [
                    {
                        "sense_id": "ff5777b3-350d-3da2-bd08-b655a188676e",
                        "entry_id": "be9b08ca-ed4c-34cd-9759-451d7e9c65cf",
                        "glosses": [
                            "The characteristic of being harmless."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8f049708-0fc4-4a3d-8f78-72a5ee0f3847",
                                "sense_id": "ff5777b3-350d-3da2-bd08-b655a188676e",
                                "text": "Already, at this very early date, the ritualists were moving towards the ideal of ahimsa (\"harmlessness\") that would become the indispensable virtue of the Indian Axial Age."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e72b0a9-5e2c-4489-ae59-62297b2289cc",
                        "source_entry_id": "be9b08ca-ed4c-34cd-9759-451d7e9c65cf",
                        "source_sense_id": "ff5777b3-350d-3da2-bd08-b655a188676e",
                        "source_sense_description": "the characteristic of being harmless",
                        "target_lang_word": "innocuité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innocuité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24a6c9da-dbf1-3f91-bc86-830b230693cd",
                                        "entry_id": "6788af7b-7cb4-3a37-8b94-51993f376a46",
                                        "glosses": [
                                            "Qualité d’une chose qui n’est pas nuisible."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be98f7cf-7b2c-4d31-88c6-ad42e89e8985",
                                                "sense_id": "24a6c9da-dbf1-3f91-bc86-830b230693cd",
                                                "text": "Nous estimons qu'un savon-pyrèthre, correctement préparé et dosé, peut être un pédiculicide particulièrement efficace et pratique : son innocuité absolue pour l'homme, sa grande toxicité pour les poux, le placent au premier rang des pédiculicides à proposer pour la prophylaxie familiale de la fièvre récurrente, du typhus exanthématique et de toutes infections véhiculées et transmises par les poux."
                                            },
                                            {
                                                "example_id": "58540bbe-1b06-43fc-b6f4-385ea3cdab6c",
                                                "sense_id": "24a6c9da-dbf1-3f91-bc86-830b230693cd",
                                                "text": "52 % des Français doutent de l’innocuité des OGM."
                                            },
                                            {
                                                "example_id": "fa4822de-178a-4f05-9682-a1b84a727584",
                                                "sense_id": "24a6c9da-dbf1-3f91-bc86-830b230693cd",
                                                "text": "Il lui parut enfin que son studio avait la plus parfaite innocuité pour son cerveau en voie de flaccidité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de48a47d-da98-4a9d-a326-6cbd1947b04b",
                        "source_entry_id": "be9b08ca-ed4c-34cd-9759-451d7e9c65cf",
                        "source_sense_id": "ff5777b3-350d-3da2-bd08-b655a188676e",
                        "source_sense_description": "the characteristic of being harmless",
