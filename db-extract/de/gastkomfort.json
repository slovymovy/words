                "senses": [
                    {
                        "sense_id": "61a34273-af11-3009-aac1-c7b5bdcfece6",
                        "entry_id": "aec8cc5e-16d6-3aaa-9cd1-b32c0f47fb56",
                        "glosses": [
                            "Komfort, den der Besucher eines Hotels, einer Bar, eines Flugzeuges während des Aufenthalts, ohne Aufpreis, genießt"
                        ],
                        "tags": [
                            "Touristik",
                            "Gastgewerbe"
                        ],
                        "examples": [
                            {
                                "example_id": "98200ca6-ff5c-46e4-be8e-2f0e8392bdd4",
                                "sense_id": "61a34273-af11-3009-aac1-c7b5bdcfece6",
                                "text": "Das Tool bestimmt den Grad an Komfort, den Passagiere unter unterschiedlichen witterungsbedingten Voraussetzungen empfinden, und hilft somit, Lösungen für Design und Technik zu finden, um den Gastkomfort auf Kreuzfahrtdecks und anderen Passagierschiffen zu maximieren."
                            },
                            {
                                "example_id": "50f9823a-47b8-4a68-8634-9b70331f48ab",
                                "sense_id": "61a34273-af11-3009-aac1-c7b5bdcfece6",
                                "text": "Dazu gehören innovative Bediensysteme, wie Sprach- und Sensorsteuerung und integrierte Displaysysteme sowie Lösungen zu Gastkomfort und Wellness."
                            },
                            {
                                "example_id": "15d9758e-0f0b-4d08-88d9-90f1a525d8c7",
                                "sense_id": "61a34273-af11-3009-aac1-c7b5bdcfece6",
                                "text": "Die schnelle und zuverlässige Handhabung über das Rezeptionsterminal Memory Desk erfüllt alle wichtigen Funktionen eines Hotelalltages, mit denen der Gastkomfort noch effektiver gestaltet wird (nur Modell HiPath 3500/3550)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
