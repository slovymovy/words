                                "target_senses": [
                                    {
                                        "sense_id": "e61a01c8-6aad-30ef-8386-a43d9a388d4b",
                                        "entry_id": "70207076-7dd7-3267-a271-812061f3dd79",
                                        "glosses": [
                                            "Synonyme de frigorifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf307eb9-6a89-4155-8ee2-60ec6eaf8674",
                                                "sense_id": "e61a01c8-6aad-30ef-8386-a43d9a388d4b",
                                                "text": "Enfin, il faut renforcer la réglementation portant sur les fluides frigorigènes, utilisés depuis une trentaine d'années. L'utilisation de la première génération de gaz (chlorofluorocarbure ou CFC) a été interdite en 1987 dans le cadre du Protocole de Montréal, en raison de leur effet destructeur pour la couche d'ozone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frigorigène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f62bd2ca-60ca-3dd1-bffd-794afa9df935",
                                        "entry_id": "f776299a-5d53-3d3b-a6cb-c6d07db225c0",
                                        "glosses": [
                                            "Synonyme de frigorifique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a027c8c2-4e73-44e7-9892-f8a4583f9467",
                                                "sense_id": "f62bd2ca-60ca-3dd1-bffd-794afa9df935",
                                                "text": "Certains frigorigènes exercent un effet de serre plusieurs milliers de fois plus puissant que le dioxyde de carbone."
                                            }
                                        ]
                                    }
