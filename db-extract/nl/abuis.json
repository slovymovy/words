                ],
                "senses": [
                    {
                        "sense_id": "ac77f0af-1df5-359c-900f-c22d51f0f2fd",
                        "entry_id": "709d399a-5b96-3bb3-afd8-e9378a7dc9cc",
                        "glosses": [
                            "misvatting, vergissing, misverstand, fout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d949b4-b0a5-4c32-9385-4d3453c40ada",
                                "sense_id": "ac77f0af-1df5-359c-900f-c22d51f0f2fd",
                                "text": "Per abuis hadden we de verkeerde brief opengemaakt."
                            },
                            {
                                "example_id": "83bfa468-e270-4700-ade9-4b8249e3198c",
                                "sense_id": "ac77f0af-1df5-359c-900f-c22d51f0f2fd",
                                "text": "De hond, Levi Shotz, is per abuis op de zwarte lijst gezet. De hond vermoedt dat die ernst, je zou het zelfs intelligentie kunnen noemen, die hij bij andere honden niet of nauwelijks bespeurt, bij hem is teweeggebracht doordat wijlen zijn baasje, een in ongenade geraakte historicus, hem zijn clandestiene politieke pamfletten voorlas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71c53273-a6c6-4ab4-ab2b-6991671923c0",
                        "source_entry_id": "709d399a-5b96-3bb3-afd8-e9378a7dc9cc",
                        "source_sense_id": "ac77f0af-1df5-359c-900f-c22d51f0f2fd",
                        "target_lang_word": "mistake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mistake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                        "entry_id": "aaccbadc-c83c-3bfb-9ede-f1ee50073f7c",
                                        "glosses": [
                                            "To understand wrongly, taking one thing or person for another."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d660307-3608-4b51-9896-2c1b8464c162",
                                                "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                                "text": "Sorry, I mistook you for my brother. You look very similar."
                                            },
                                            {
                                                "example_id": "020bbea1-f2d2-491f-a4c0-3ef3676198b1",
                                                "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                                "text": "Don't mistake my kindness for weakness."
                                            },
                                            {
                                                "example_id": "315a8069-f097-4ea1-9cc1-63524bf7ad87",
                                                "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                                "text": "My father’s purposes have been mistook;"
                                            },
                                            {
                                                "example_id": "7fb8fa96-a6a6-4b07-b83d-a1c0cbf905f3",
                                                "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                                "text": "The reigning error of his life was, that he mistook the love for the practice of virtue, and was indeed not so much a good man, as the friend of goodness."
                                            },
                                            {
                                                "example_id": "51b6af99-be18-446d-8c73-09b55e496734",
                                                "sense_id": "0ed62ce0-3c36-3ef3-ab45-4e38b3d3826f",
                                                "text": "Because I don't want to know\nI didn't want to know\nI just didn't want to know\nI just didn't want\nMistook the nods for an approval\nJust ignore the smoke and smile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03969066-9a37-3d03-a8ab-64aa81484ea9",
                                        "entry_id": "aaccbadc-c83c-3bfb-9ede-f1ee50073f7c",
                                        "glosses": [
                                            "To misunderstand (someone)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7601a39a-f1c5-43ba-bf76-506b907dc5b5",
                                                "sense_id": "03969066-9a37-3d03-a8ab-64aa81484ea9",
                                                "text": "Miſtake me not, my Lord, ’tis not my meaning / To raze one Title of your Honour out."
                                            },
                                            {
                                                "example_id": "ec5c30a8-f756-4c99-a0af-8471470490bf",
                                                "sense_id": "03969066-9a37-3d03-a8ab-64aa81484ea9",
                                                "text": "[…] at last she so evidently demonstrated her Affection to him to be much stronger than what she bore her own Son, that it was impossible to mistake her any longer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82f9622-7834-3e4c-8161-fa0b811e6ba5",
                                        "entry_id": "aaccbadc-c83c-3bfb-9ede-f1ee50073f7c",
                                        "glosses": [
                                            "To commit an unintentional error; to do or think something wrong."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ecf9e59-b339-4556-a07e-76b838ff58ec",
                                                "sense_id": "f82f9622-7834-3e4c-8161-fa0b811e6ba5",
                                                "text": "Impoſe me to what penance your inuention / Can lay vpon my ſinne, yet ſinn’d I not / But in miſtaking."
                                            },
                                            {
                                                "example_id": "83a66fea-f7f9-41ab-8f56-0e0467b77273",
                                                "sense_id": "f82f9622-7834-3e4c-8161-fa0b811e6ba5",
                                                "text": "1720, Jonathan Swift, “Letter to a Young Clergyman” in The Works of Jonathan Swift, London: Charles Elliot, 1784, Volume 10, pp. 6-7,\nNo gentleman thinks it is safe or prudent to send a servant with a message, without repeating it more than once, and endeavouring to put it into terms brought down to the capacity of the bearer; yet, after all this care, it is frequent for servants to mistake, and sometimes occasion misunderstandings among friends […]"
                                            },
                                            {
                                                "example_id": "0c4c89df-fb83-4046-99a9-d74d01d327a9",
                                                "sense_id": "f82f9622-7834-3e4c-8161-fa0b811e6ba5",
                                                "text": "\"Bah!\" said the Englishwoman: \"what knight ever feared cold? Besides, you mistake; the night is warm, and you look so handsome in your gown.\""
                                            },
                                            {
                                                "example_id": "4f60809e-79e4-4737-a256-144f17e00478",
                                                "sense_id": "f82f9622-7834-3e4c-8161-fa0b811e6ba5",
                                                "text": "There is also a chancellor, — no, I mistake, — a chandler and green-grocer, with his hands full of warts; […]",
                                                "translation": "Synthesis of the English Language (Charles Saville): English Text with Opposite French Translation",
                                                "english": "Synthesis of the English Language (Charles Saville): English Text with Opposite French Translation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "644a041b-f8e1-358a-bd97-d0e0ebfe0674",
                                        "entry_id": "aaccbadc-c83c-3bfb-9ede-f1ee50073f7c",
                                        "glosses": [
                                            "To take or choose wrongly."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a344085-bcd7-4c1c-b17b-4d6cc6c6cf26",
                                                "sense_id": "644a041b-f8e1-358a-bd97-d0e0ebfe0674",
                                                "text": "The better act of purposes mistook / Is to mistake again; though indirect, / Yet indirection thereby grows direct,"
                                            },
                                            {
                                                "example_id": "1be39991-c19c-41c9-8930-9d7388bf3b8c",
                                                "sense_id": "644a041b-f8e1-358a-bd97-d0e0ebfe0674",
                                                "text": "The Spear with erring Haste mistook its way,\nBut plung’d in Eniopeus’ Bosom lay."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mistake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4562ffd-10a0-329e-93f1-642f66c946da",
                                        "entry_id": "29804bd4-d92d-3925-ad51-0843d367cd23",
                                        "glosses": [
                                            "An error."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb357af-6781-43c7-b12f-368d9df969ad",
                                                "sense_id": "a4562ffd-10a0-329e-93f1-642f66c946da",
                                                "text": "There were too many mistakes in the test, that unfortunately you failed."
                                            },
                                            {
                                                "example_id": "3fd38130-de4d-483f-91e8-9faf556b7deb",
                                                "sense_id": "a4562ffd-10a0-329e-93f1-642f66c946da",
                                                "text": "He always did mistakes on purpose."
                                            },
                                            {
                                                "example_id": "2259c672-b740-4953-b640-72d55b6ca43e",
                                                "sense_id": "a4562ffd-10a0-329e-93f1-642f66c946da",
                                                "text": "He, that would write exactly, muſt avoid a Barbarous Pronunciation, and conſider for facility, or thorow miſtake, many words are not ſounded after the beſt dialect. Such as […] Wun, one."
                                            },
                                            {
                                                "example_id": "9b502b40-c591-43af-953b-ffb57f826a98",
                                                "sense_id": "a4562ffd-10a0-329e-93f1-642f66c946da",
                                                "text": "1877, Henry Heth, quoting Robert E. Lee, in \"Causes of the Defeat of Gen. Lee's Army at the Battle of GettysburgOpinions of Leading Confederate Soldiers.\", Southern Historical Society Papers (1877), editor Rev. J. WM. Jones http://books.google.com/books?id=iDIFAAAAQAAJ&pg=PA292&dq=lee+%22mistakes+were+made%22&hl=en&ei=fchaTbu4L8L98AaVs4n-DQ&sa=X&oi=book_result&ct=result&resnum=3&ved=0CDUQ6AEwAg#v=onepage&q=lee%20%22mistakes%20were%20made%22&f=false\nAfter it is all over, as stupid a fellow as I am can see that mistakes were made. I notice, however, that my mistakes are never told me until it is too late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2452b8-14c8-3edc-919e-828f403450b3",
                                        "entry_id": "29804bd4-d92d-3925-ad51-0843d367cd23",
                                        "glosses": [
                                            "A pitch which was intended to be pitched in a hard-to-hit location, but instead ends up in an easy-to-hit place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
