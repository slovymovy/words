                "translations": [
                    {
                        "translation_id": "dfc55743-e101-4f53-9b54-33999447c9aa",
                        "source_entry_id": "18498160-0f1d-3d2c-9988-91bc8ea48039",
                        "source_sense_id": "c3e0acf5-6765-382e-aeee-e7c18a3b8b24",
                        "source_sense_description": "een extra bepaling in een ambtelijke brief.",
                        "target_lang_word": "Klausel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klausel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a7ccd9-a679-344c-b346-4ed30d89edb8",
                                        "entry_id": "31fd3a26-64f7-30cc-97b5-2bfe0c9d032e",
                                        "glosses": [
                                            "Boolesche Funktion, die ausschließlich durch die disjunktive Verknüpfung von Literalen gebildet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6bc70d7-fc66-4520-865c-6efc98694003",
                                                "sense_id": "48a7ccd9-a679-344c-b346-4ed30d89edb8",
                                                "text": "Nach dem Urteil des EuGH wird es in den Verträgen neue Klauseln bzgl. des Datenschutzstandards geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf1643dd-0e42-357b-9fd8-5c183172e2b4",
                                        "entry_id": "31fd3a26-64f7-30cc-97b5-2bfe0c9d032e",
                                        "glosses": [
                                            "genau definierte Einzelbestimmung in Vertragswerken oder seltener auch in Gesetzen oder Verordnungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc390e9-2641-4604-9525-2232b7d4bc85",
                                                "sense_id": "cf1643dd-0e42-357b-9fd8-5c183172e2b4",
                                                "text": "Über einige Klauseln im Vertragsentwurf muss noch verhandelt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d4956b98-d571-3970-b1ff-fce43438fb4c",
                                        "entry_id": "31fd3a26-64f7-30cc-97b5-2bfe0c9d032e",
                                        "glosses": [
                                            "Vermerk auf der vollstreckbaren Ausfertigung eines Titels als Voraussetzung für die Zwangsvollstreckung durch die Justiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ee211-512f-4510-a930-4b70b36c0eaa",
                                                "sense_id": "d4956b98-d571-3970-b1ff-fce43438fb4c",
                                                "text": "„Als allgemeine Vollstreckungsvoraussetzungen werden Titel, Klausel und Zustellung bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fe1c12e0-a96f-3a67-a812-7d1a27215943",
                                        "entry_id": "31fd3a26-64f7-30cc-97b5-2bfe0c9d032e",
                                        "glosses": [
                                            "Losungswort eines Sparbuches"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "421a36fe-51d8-485e-8853-106e0bbab29d",
                                                "sense_id": "fe1c12e0-a96f-3a67-a812-7d1a27215943",
                                                "text": "„Wohl sagt Stanzl, daß bei solchen Sparbüchern die Nämlichkeit der Person in der Regel dadurch nachgewiesen werde, daß bei jeder Abhebung ein bei der Eröffnung des Sparkontos vereinbartes Losungswort (die Klausel) genannt werden müsse (Stanzl, Wechsel-, Scheck- und sonstiges Wertpapierrecht, § 59 II S. 155).“"
                                            },
                                            {
                                                "example_id": "51a72ddc-b5f9-4266-9ad2-94931c931a3d",
                                                "sense_id": "fe1c12e0-a96f-3a67-a812-7d1a27215943",
                                                "text": "„Anfang Mai 1987 übergab sie dem Beklagten, weil er ‚Geld sehen‘ und sich somit über die ‚Zahlungskräftigkeit‘ der Klägerin vergewissern wollte, ein Sparbuch mit Klausel und einem Einlagestand von 368.000 S, den sie am 15.6.1987 um 250.000 S erhöhte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d09369f6-c106-4af5-b968-706b934d4f1a",
                        "source_entry_id": "18498160-0f1d-3d2c-9988-91bc8ea48039",
                        "source_sense_id": "c3e0acf5-6765-382e-aeee-e7c18a3b8b24",
                        "source_sense_description": "een extra bepaling in een ambtelijke brief.",
                        "target_lang_word": "clause",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52a0bd68-9737-3c6e-abb2-503aedf2e23f",
                                        "entry_id": "445cda82-efba-3afc-86ba-e2bae963edd4",
                                        "glosses": [
                                            "A group of words that contains a subject and a verb; it may be part of a sentence or may constitute the whole sentence, depending on the syntax in each instance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebe6e014-4f4b-42d8-8424-eb2d31f6d5bc",
                                                "sense_id": "52a0bd68-9737-3c6e-abb2-503aedf2e23f",
                                                "text": "Near-synonyms: sentential, sentence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5377c5d-612f-3ac3-8b56-6ffdcf70121a",
                                        "entry_id": "445cda82-efba-3afc-86ba-e2bae963edd4",
                                        "glosses": [
                                            "A verb, its necessary grammatical arguments, and any adjuncts affecting them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "095cec68-ff2b-3852-8189-5b7b9a751bfc",
                                        "entry_id": "445cda82-efba-3afc-86ba-e2bae963edd4",
                                        "glosses": [
                                            "A verb along with its subject and their modifiers. If a clause provides a complete thought on its own, then it is an independent (superordinate) clause; otherwise, it is dependent (subordinate). (Independent clauses can be sentences; they can also be part of a sentence. Dependent clauses can only be part of a sentence.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "587a4d99-2462-41e1-a44a-5cfc804f7377",
                                                "sense_id": "095cec68-ff2b-3852-8189-5b7b9a751bfc",
                                                "text": "However, Coordination facts seem to undermine this hasty conclusion: thus, consider the following:\n (43) [Your sister could go to College], but [would she get a degree?]\n The second (italicised) conjunct is a Clause containing an inverted Auxiliary, would. Given our earlier assumptions that inverted Auxiliaries are in C, and that C is a constituent of S-bar, it follows that the italicised Clause in (43) must be an S-bar. But our familiar constraint on Coordination tells us that only constituents belonging to the same Category can be conjoined. Since the second Clause in (43) is clearly an S-bar, then it follows that the first Clause must also be an S-bar — one in which the C(omplementiser) position has been left empty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3a669f-6c67-3d53-be77-994b0a214c90",
                                        "entry_id": "445cda82-efba-3afc-86ba-e2bae963edd4",
                                        "glosses": [
                                            "A distinct part of a contract, a will or another legal document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda406db-235e-4c46-9215-23c7d3e917b6",
                                                "sense_id": "3a3a669f-6c67-3d53-be77-994b0a214c90",
                                                "text": "Mr. Waller adds that when the railway was authorised in 1897, one of the clauses of the Act authorising the transfer of the line to the North British Railway provided that that company should work it in perpetuity, and it was this clause that caused the interim interdict to be granted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eacbea6-06dc-3bf0-898c-1986eb7113c4",
                                        "entry_id": "445cda82-efba-3afc-86ba-e2bae963edd4",
                                        "glosses": [
                                            "A constituent (component) of a statement or query."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clause",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec7de13-2d1e-3af4-bb1b-0ad4aa3aecea",
                                        "entry_id": "079eb1b3-07d7-3aa1-8bf5-f456aeb2c5ba",
                                        "glosses": [
                                            "To amend (a bill of lading or similar document)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20858fe5-d04c-41c4-a479-b11136c78eab",
                                                "sense_id": "6ec7de13-2d1e-3af4-bb1b-0ad4aa3aecea",
                                                "text": "The question of clausing the bills of lading, so as to avoid \"dirtying\", which impairs its negotiability, may also be looked into"
                                            },
                                            {
                                                "example_id": "71eb5bf3-b6c4-46ce-ac61-9aa39832ef0e",
                                                "sense_id": "6ec7de13-2d1e-3af4-bb1b-0ad4aa3aecea",
                                                "text": "Any attempt to clause a Bill of Lading will be strenuously resisted by shippers, and they will obtain clean bills in the usual ways"
                                            },
                                            {
                                                "example_id": "eff3b505-38c8-4691-a1e0-d837dd4beb0b",
                                                "sense_id": "6ec7de13-2d1e-3af4-bb1b-0ad4aa3aecea",
                                                "text": "It was held that the bills of lading presented were in this case 'clean' as they contained no reservations by way of endorsement, clausing or otherwise to suggest that the goods were defective"
                                            },
                                            {
                                                "example_id": "21541212-6534-4528-88a3-d583ba607780",
                                                "sense_id": "6ec7de13-2d1e-3af4-bb1b-0ad4aa3aecea",
                                                "text": "There is little authority in English law dealing with the liability of a carrier who unnecessarily clauses a bill of lading."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9d9e402-90d1-4fc6-bc27-537b48c5e4b4",
                        "source_entry_id": "18498160-0f1d-3d2c-9988-91bc8ea48039",
                        "source_sense_id": "c3e0acf5-6765-382e-aeee-e7c18a3b8b24",
                        "source_sense_description": "een extra bepaling in een ambtelijke brief.",
                        "target_lang_word": "proviso",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proviso",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e286ad0-a0fb-3377-9b76-3405503a2cb3",
                                        "entry_id": "83584921-36d7-3383-bf32-d4a2b1e77edf",
                                        "glosses": [
                                            "A conditional provision to an agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f766d3-b602-4221-8a2c-d3ca31e70b81",
                                                "sense_id": "2e286ad0-a0fb-3377-9b76-3405503a2cb3",
                                                "text": "Now, with all these provisos in mind, what’s the best way to put spinach to work? All due respect to Popeye, a can may not be the tastiest way to introduce it to your table."
                                            },
                                            {
                                                "example_id": "e7429d00-d210-452a-b63a-71af5fdee6bf",
                                                "sense_id": "2e286ad0-a0fb-3377-9b76-3405503a2cb3",
                                                "text": "The biggest change in the governance of American horse racing was tucked into a 2020 federal spending bill. That proviso ultimately created the national Horseracing Integrity and Safety Authority, or HISA – a move that, after three previous legislative attempts, found support from federal lawmakers after a particularly deadly season at a California racetrack."
                                            },
                                            {
                                                "example_id": "4fbf3ff4-dfc4-4544-8055-be3e3ce817c1",
                                                "sense_id": "2e286ad0-a0fb-3377-9b76-3405503a2cb3",
                                                "text": "The writing has been on the wall that Americans’ support for mass deportation was subject to all kinds of caveats and provisos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aee8a82c-ff1c-40ea-bc11-3df4ba6b5fa2",
                        "source_entry_id": "18498160-0f1d-3d2c-9988-91bc8ea48039",
                        "source_sense_id": "c3e0acf5-6765-382e-aeee-e7c18a3b8b24",
