                        ],
                        "examples": [
                            {
                                "example_id": "2ba726bd-db48-494e-a8f4-55742d1d14c3",
                                "sense_id": "ca1d25da-4da7-3b50-998a-872f3a8123d1",
                                "text": "Tu as vu le zinfle, avec sa drôle de façon de marcher ?"
                            },
                            {
                                "example_id": "575f4e5f-e8ac-4b74-8cb5-42bb17f0e5fd",
                                "sense_id": "ca1d25da-4da7-3b50-998a-872f3a8123d1",
                                "text": "On s'invitait plutôt dehors, sur le trottoir torride à la fin des chaudes journées d'été, quand le cagnard épuisant fait place à la fraîcheur du soir. Les toulousaines et parfois les toulousains sortent des chaises, s'installent commodément, elles rient d'un \"zinfle\" qui passe, se font confidentielles ou laissent monter leur voix; ce qui ne les conduit pas forcément à la castagne !"
                            }
                        ]
                    }
