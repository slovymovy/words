                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "postrzępić się",
                                "target_lang_sense_clarification": "w formie imiesłowu lub czasu przeszłego"
                            },
                            {
                                "target_lang_word": "wystrzępić się",
                                "target_lang_sense_clarification": "w formie imiesłowu lub czasu przeszłego"
                            },
                            {
                                "target_lang_word": "spruć się",
