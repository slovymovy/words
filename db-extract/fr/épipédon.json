                        "entry_id": "a9311e14-0898-3dcc-811e-4969cb7fd271",
                        "glosses": [
                            "Partie supérieure d'un sol, qui contient de la matière organique de décomposition des végétaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f2ae44-763d-4c01-9b86-9b12d8c8e44e",
                                "sense_id": "4521b26c-47c1-33be-ba3e-256546add9b2",
                                "text": "Comme en milieu faiblement ferrallitique, la fertilité et les capacités de régénération par la jachère décroissent vers l’amont (plus sec et parfois décapé) qui perd plus facilement son épipédon."
                            },
                            {
                                "example_id": "f69f30c1-4af3-439b-a0fc-cd73457f4ea4",
                                "sense_id": "4521b26c-47c1-33be-ba3e-256546add9b2",
                                "text": "La plupart de ces nomenclatures fondent leur définition sur l'épaisseur de l'horizon humifère (parfois de l’épipédon), sur sa couleur, sur son taux de saturation en bases."
                            }
                        ]
                    }
