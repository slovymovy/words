                ],
                "senses": [
                    {
                        "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                        "entry_id": "effcf663-fc62-3465-aead-0f3f950a4502",
                        "glosses": [
                            "Auslöser für einen Vorfall, bei dem ein Schaden an Personen, Tieren oder Sachen entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3632c0e-b53a-4e9a-90f3-88d93bb16520",
                                "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                                "text": "„Es schickt sich nicht mehr, die Menschen anzuprangern, deren mangelhaft entwickelter Verkehrssinn und geringe Intelligenz die am häufigsten erkannten Unfallursachen sind.“"
                            },
                            {
                                "example_id": "1d34c101-78e9-43e7-bbe5-2c07d5fe0003",
                                "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                                "text": "„Dabei kennt die offizielle Verkehrsstatistik die Unfallursache Smartphone noch gar nicht.“"
                            },
                            {
                                "example_id": "7c7ed68b-a66f-4a82-b6b6-eb087ec8a95c",
                                "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                                "text": "„Unfallursache Nummer Eins bei Radfahrern ist übrigens: Verlust des Gleichgewichts; bei Badeunfällen: Wasser in der Lunge; bei Flugzeugabstürzen: Mangel an Auftrieb.“"
                            },
                            {
                                "example_id": "4af88a7c-63ad-49fe-a6b3-2b12af030f9e",
                                "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                                "text": "„Alkohol war im Jahr 2014 bei 4,5 Prozent aller Unfälle mit Personenschaden eine der Unfallursachen, wie das Statistische Bundesamt herausfand.“"
                            },
                            {
                                "example_id": "fdd66a2a-249b-413b-836f-49b185cf6bf8",
                                "sense_id": "03f1ef23-f56b-3ce6-8048-6958e10db210",
                                "text": "„Alkohol am Steuer sei immer noch eine der häufigsten Unfallursachen, sagte Dobrindt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
