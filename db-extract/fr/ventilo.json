                        "sense_id": "e49695bf-2e7e-38b4-b3cf-f1b9327e524d",
                        "entry_id": "b26e39d4-5a76-376e-9111-4cd9a03af8cb",
                        "glosses": [
                            "Ventilateur, machine qui fait circuler l’air."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "758406ee-bd44-4be5-b797-9a7637349cbd",
                                "sense_id": "e49695bf-2e7e-38b4-b3cf-f1b9327e524d",
                                "text": "– Mais j’ai des reflets, par en dessous, ça bouge, ne coupez pas le ventilo."
                            },
                            {
                                "example_id": "f3f67a58-88f1-4e89-b9ae-e841fe692f46",
                                "sense_id": "e49695bf-2e7e-38b4-b3cf-f1b9327e524d",
                                "text": "Première mauvaise surprise : les clim ne sont pas en fonctionnement, tout est ouvert car des tables sont installées sur des mini-balcons, on n’a pas d’air à l’intérieur malgré les ventilos et bonjour les moustiques…"
                            },
                            {
                                "example_id": "5c8affef-6d54-4ab2-a6bb-cf138fbdf4c7",
                                "sense_id": "e49695bf-2e7e-38b4-b3cf-f1b9327e524d",
                                "text": "L’endroit était situé sous les toits, et, malgré le ventilo, il y faisait une chaleur infernale."
                            }
                        ]
                    }
                ],
