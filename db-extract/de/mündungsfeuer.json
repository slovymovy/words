                "senses": [
                    {
                        "sense_id": "4ccd32a3-bad4-317e-a4b6-2bcd93d973e2",
                        "entry_id": "a750f2e2-f578-3470-8009-13dc52e5fafe",
                        "glosses": [
                            "Flamme, die sich beim Abfeuern einer Feuerwaffe an der Mündung des Laufes bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a67a7a-5fb5-49a3-b0bd-2ac1994cb6a5",
                                "sense_id": "4ccd32a3-bad4-317e-a4b6-2bcd93d973e2",
                                "text": "Das Mündungsfeuer verriet den Standort des Schützen."
                            },
                            {
                                "example_id": "34221503-ee8b-4344-bfb1-c4c8171c3e47",
                                "sense_id": "4ccd32a3-bad4-317e-a4b6-2bcd93d973e2",
                                "text": "„Rufe sind zu hören, dann blitzt Mündungsfeuer im Dunkel auf.“"
                            },
                            {
                                "example_id": "053b7b02-165e-4984-876b-2f857cd032ba",
                                "sense_id": "4ccd32a3-bad4-317e-a4b6-2bcd93d973e2",
                                "text": "„Der Himmel zitterte und wurde heller und dunkler unter dem Mündungsfeuer der Artillerie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
