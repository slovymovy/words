                        "glosses": [
                            "elegiac; expressing sorrow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17177cf2-9e6a-4613-8051-6b8d0102f22f",
                                "sense_id": "2bb5db46-5ff9-36f4-850b-1712fdb56372",
                                "text": "He gratefully sings unto God—yet follows this up with an elegiacal lamentation of his own suffering, not unmixed perhaps with the sorrows of afflicted patriotism."
                            },
                            {
                                "example_id": "3c19df51-3c69-4926-915a-0fbbaba64437",
                                "sense_id": "2bb5db46-5ff9-36f4-850b-1712fdb56372",
                                "text": "It is an exquisite addition to a branch of English literature, which is already very rich, the poetry of elegiacal regret."
                            },
                            {
                                "example_id": "92193992-b991-4666-9ffc-526e87008f80",
                                "sense_id": "2bb5db46-5ff9-36f4-850b-1712fdb56372",
                                "text": "Shakespeare antagonized the queen by permitting his play to be performed on the eve of the Essex rebellion, and he persisted in his contempt for her by refusing to write any elegiacal verses on Elizabeth's death."
                            }
                        ]
                    }
