                            "pregnant"
                        ],
                        "examples": [
                            {
                                "example_id": "f4fe04b7-31b1-435e-8070-a297829157e4",
                                "sense_id": "ea814ee8-1937-3e00-ad1a-9cc9156db53e",
                                "text": "Filet is het zachtste en duurste stukje lamsvlees. De smalle langwerpige stukken vlees worden uit de lamsrug gesneden. De stukken lamsfilet zijn donkerrood tot bruin gekleurd. Meestal zijn ze van alle vet ontdaan."
                            }
