                    {
                        "sense_id": "ff497197-03e7-3f58-8654-b2bd9b562ce3",
                        "entry_id": "39016ef0-08e4-3ed4-9f7d-66817dffd605",
                        "glosses": [
                            "von den Karaimen (auch Karaïmen (Karaim, Karaïm), Karäern, Karaiten) in Polen, Litauen und der Ukraine gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47364992-4a40-4f00-8702-46d382a79a30",
                                "sense_id": "ff497197-03e7-3f58-8654-b2bd9b562ce3",
                                "text": "„Seit dem Mittelalter ist Karaimisch eine bedeutende Literatursprache, die überwiegend in hebräischen Lettern geschrieben wurde.“"
                            },
                            {
                                "example_id": "95b5c947-9bbe-457f-a790-7a019923617a",
                                "sense_id": "ff497197-03e7-3f58-8654-b2bd9b562ce3",
                                "text": "Das Karaimische gilt heute als fast ausgestorben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83784a62-e528-4690-b007-f073c00521b5",
                        "source_entry_id": "39016ef0-08e4-3ed4-9f7d-66817dffd605",
                        "source_sense_id": "ff497197-03e7-3f58-8654-b2bd9b562ce3",
                        "target_lang_word": "Karaim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karaim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3466f3a-d684-3d74-8d56-51104d37ff04",
                                        "entry_id": "5b5ae264-4928-3790-8713-252b53e0b62e",
                                        "glosses": [
                                            "A Kipchak Turkic language, with Aramaic and Persian influences, spoken in Lithuania, Poland, the Crimea and the Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388057b6-81d4-4564-9140-c4103e697d88",
                                                "sense_id": "a3466f3a-d684-3d74-8d56-51104d37ff04",
                                                "text": "At times the discrepancy can be even greater: only 12.8% of the Karaim, a Turkic-speaking group living for the most part in Lithuania, declared Karaim as their native language."
                                            },
                                            {
                                                "example_id": "3b107d51-4e19-4c09-8915-78a2c6cdb16c",
                                                "sense_id": "a3466f3a-d684-3d74-8d56-51104d37ff04",
                                                "text": "For more than six hundred years, Karaim has been spoken as a community language in what is today Lithuania."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Karaim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76cd03d4-d628-320c-a6e1-80808cf1475d",
                                        "entry_id": "45dfeb0a-b762-3758-a897-dea41969cb97",
                                        "glosses": [
                                            "A member of an ethnic group in Central and Eastern Europe which traditionally spoke this (Turkic) language and practiced Karaite Judaism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d910bec-9b89-4212-9f18-8e89695a9e18",
                                                "sense_id": "76cd03d4-d628-320c-a6e1-80808cf1475d",
                                                "text": "He began to develop closer relations with his Karaim subjects and issued a charter to a Karaim named Iosif to try again to establish a mint. The Karaim Rabbi wrote that after the Christians had left, […]"
                                            },
                                            {
                                                "example_id": "cce23510-b4b1-4789-8608-3c09385faa37",
                                                "sense_id": "76cd03d4-d628-320c-a6e1-80808cf1475d",
                                                "text": "The term Karaim refers to both a people and to a religious system. Karaims are believers in the Old Testament but consider themselves to be of Turkic ethnic origin. They have traditionally used the Hebrew alphabet for writing their language, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "302f8952-e21c-3043-a4cf-cf27028ca9a0",
                                        "entry_id": "45dfeb0a-b762-3758-a897-dea41969cb97",
                                        "glosses": [
                                            "collective plural of Karaim."
                                        ],
                                        "tags": [
                                            "collective",
                                            "form-of",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56090206-62c7-4cc1-a3e2-1b836a7dec5c",
                                                "sense_id": "302f8952-e21c-3043-a4cf-cf27028ca9a0",
                                                "text": "At times the discrepancy can be even greater: only 12.8% of the Karaim, a Turkic-speaking group living for the most part in Lithuania, declared Karaim as their native language.\n[…]\n[…] the Karaim, who are by religion (though not ethnically) Jews, a unique survival of the adoption of Judaism as the official religion of the Khazar empire […]\n[…]\nThe Karaim are being rapidly assimilated, ethnically and especially linguistically, to the surrounding Russian population."
                                            },
                                            {
                                                "example_id": "5ca05d92-f612-48a9-969c-e23519729cf4",
                                                "sense_id": "302f8952-e21c-3043-a4cf-cf27028ca9a0",
                                                "text": "The Karaim\nA Turkic-speaking group practising a branch of Judaism, the Karaim are thought to be descended from the Khazars, a central Asian people who held sway over a steppe empire stretching between the Black and Caspian seas […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb67ca0f-160b-393e-8a7d-9ad92bf9d5a2",
                                        "entry_id": "45dfeb0a-b762-3758-a897-dea41969cb97",
                                        "glosses": [
                                            "A Karaite (especially an Eastern or Central European, Turkic-speaking one)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff94244e-f54e-4048-91fb-0c3a23d025d3",
                                                "sense_id": "eb67ca0f-160b-393e-8a7d-9ad92bf9d5a2",
                                                "text": "He added that he was not \"one of those Talmud Jews\"; that he belonged to the American Reformed Church, known in Russia as the Karaim Jews. […] As soon as General Kosloff understood that Moses was a Karaim Jew, he told the consul-general to send the man to him the next morning […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
