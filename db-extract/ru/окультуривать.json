                                        "sense_id": "77318969-8aad-38ba-bb30-5e921873e43f",
                                        "entry_id": "c1e70089-ee16-39fb-9e8b-9ba73368c2d4",
                                        "glosses": [
                                            "To make (more) fit for domestic life."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e3edce-de22-48a6-ace6-3055fdd79135",
                                                "sense_id": "77318969-8aad-38ba-bb30-5e921873e43f",
                                                "text": "\"To answer your question, Tai's fine. She mostly just smokes socially these days.\" \"You're domesticating her!\" \"We're domesticating each other. The other day I found myself reading a home decorating blog.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b288f9-4640-34c2-b4fa-c203fdf40a24",
                                        "entry_id": "c1e70089-ee16-39fb-9e8b-9ba73368c2d4",
                                        "glosses": [
                                            "To adapt to live with humans."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc304d0c-cf76-432c-aa28-032c954c9943",
                                                "sense_id": "91b288f9-4640-34c2-b4fa-c203fdf40a24",
                                                "text": "The Russians claim to have successfully domesticated foxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "251cce44-be45-3916-a217-2f5ec433acc6",
                                        "entry_id": "c1e70089-ee16-39fb-9e8b-9ba73368c2d4",
                                        "glosses": [
                                            "To adapt to live with humans."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420329d0-feb8-4f77-bc27-7044bdfa72ef",
                                                "sense_id": "251cce44-be45-3916-a217-2f5ec433acc6",
