                                    {
                                        "sense_id": "a102475a-bede-3207-8e23-5aa646de901f",
                                        "entry_id": "82dbd8e9-c768-36f8-b4d2-3daf0f137805",
                                        "glosses": [
                                            "das Gebiet um die Flüsse Euphrat und Tigris in Südost-Anatolien, Syrien und im Irak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19b9e40-a259-456c-9af3-c2b13ac24ff7",
                                                "sense_id": "a102475a-bede-3207-8e23-5aa646de901f",
                                                "text": "Die Sumerer lebten im Zweistromland."
                                            },
                                            {
                                                "example_id": "648b71ca-5c92-4a78-878c-690e03f9e57a",
                                                "sense_id": "a102475a-bede-3207-8e23-5aa646de901f",
                                                "text": "„In Bulgar an der Wolga handeln Kaufleute mit Waren, die über Handelsrouten vom Kaspischen Meer sowie aus den Zweistromland, Indien und China in ihre Stadt gelangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
