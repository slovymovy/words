                        ],
                        "examples": [
                            {
                                "example_id": "3027b967-58b8-47d0-887b-c2e656402efb",
                                "sense_id": "16088541-1b73-3c9a-9f19-afb435c783d1",
                                "text": "Мне стало любопытно, как-то он на этот раз выкрутится?"
