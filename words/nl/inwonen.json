                    "sense_id": "3bd3a98a-b6c7-3742-8be4-8ee7d8c46e76",
                    "sense_definition": "in hetzelfde huis als iemand anders wonen, vaak bij familie of als huurder van een kamer",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens zijn studie bleef hij nog een paar jaar bij zijn ouders <w>inwonen</w>.",
                            "target_lang_translations": {
                                "en": "During his studies, he continued <w>to live with</w> his parents for a few more years."
                            }
                        },
                        {
                            "text": "Zij <w>woont</w> al geruime tijd bij haar grootmoeder <w>in</w> om haar te helpen.",
                            "target_lang_translations": {
                                "en": "She <w>has been living with</w> her grandmother for quite some time to help her."
                            }
                        }
                    ],
                    "synonyms": [
                        "medebewonen"
                    ],
                    "common_phrases": [
                        "bij iemand inwonen"
                    ],
                    "target_lang_definitions": {
