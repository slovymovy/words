                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "180b3e4b-a0b2-46e1-a465-c90a4ae29abf",
                                                "sense_id": "16271c7f-46f4-37aa-a9bc-dbe3ef00d897",
                                                "text": "Bacha to dziewczyna swojska i z ikrą, więc zaprośmy ją na parapetówę!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db803a1f-66d5-4f03-a00f-bcc2c69f3843",
                        "source_entry_id": "9563958e-5ebf-36f4-9443-ae3b910746a1",
                        "source_sense_id": "0a3dc1a9-cdde-3a31-943b-51fafa40c951",
                        "source_sense_description": "red caviar",
                        "target_lang_word": "икра́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "икра́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                        "entry_id": "6a1de9a1-f75e-3ba1-b1c2-f270bd5a2cfd",
                                        "glosses": [
                                            "зоол. яйца рыб в виде мелких зёрен, также употребляется в пищу (гастрон.); яички, которые мечут лягушки и другие земноводные, и из которых выходят головастики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57df2d58-b0c0-4d88-b0ce-a017729f89b4",
                                                "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                                "text": "Рыбы мечут икру."
                                            },
                                            {
                                                "example_id": "766debec-1cce-47c9-b309-616ff6e6064c",
                                                "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                                "text": "Зернистая икра."
                                            },
                                            {
                                                "example_id": "cb47a763-1523-4222-8f02-ac2b58dfec66",
                                                "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                                "text": "Бутерброд с икрой."
                                            },
                                            {
                                                "example_id": "7237f7b7-adb8-4fca-a50a-ed92e1273d52",
                                                "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                                "text": "Икру мелкой рыбы солят ястыком, а икру красной рыбы пробивают в грохоты."
                                            },
                                            {
                                                "example_id": "1f50467e-3e0c-43eb-80de-b8f037e7b711",
                                                "sense_id": "a8197bfd-5f28-3821-bc6e-47b5c0130b26",
                                                "text": "Багряна ветчина, зелёны щи с желтком, // Румяно-жёлт пирог, сыр белый, раки красны, // Что смоль, янтарь — икра, и с голубым пером // Там щука пёстрая — прекрасны!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43891660-f15b-3571-827a-ea51637d7a69",
                                        "entry_id": "6a1de9a1-f75e-3ba1-b1c2-f270bd5a2cfd",
                                        "glosses": [
                                            "гастрон. кушанье, паштет из мелко изрубленных овощей, растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36dbf70-a0f2-409d-9727-bc203846b493",
                                                "sense_id": "43891660-f15b-3571-827a-ea51637d7a69",
                                                "text": "Растительная икра."
                                            },
                                            {
                                                "example_id": "edecc7e1-9f4f-4acb-a5e8-4445defc1809",
                                                "sense_id": "43891660-f15b-3571-827a-ea51637d7a69",
                                                "text": "Грибная икра."
                                            },
                                            {
                                                "example_id": "ac2be9b4-1850-4583-9f41-76c113d2a1bb",
                                                "sense_id": "43891660-f15b-3571-827a-ea51637d7a69",
                                                "text": "Баклажанная икра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473505a2-d208-3980-abfc-e681bb8263c2",
                                        "entry_id": "6a1de9a1-f75e-3ba1-b1c2-f270bd5a2cfd",
                                        "glosses": [
                                            "перен., устар. места в газете, замазанные в цензуре черной типографской краской"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "икра́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41a69c26-d61b-3b37-b659-500f9639beac",
                                        "entry_id": "9604ba9c-dc80-3756-919b-1d677659cd34",
                                        "glosses": [
                                            "анат. округлый выступ на задней стороне голени человека, образованный икроножными мышцами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d934011-3137-4457-bdae-cb5badb314ef",
                                                "sense_id": "41a69c26-d61b-3b37-b659-500f9639beac",
                                                "text": "И на икрах обнаженных, // Летним зноем обожженных, // Блещет бронзовый загар."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
