{
    "word_family": [
        "slothful",
        "slothfully"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e2f0fb5-f3da-3ed7-af4b-acd79f6289fc",
                    "sense_definition": "A slow-moving, tree-dwelling mammal native to South and Central America.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sloth</w> spends most of its life hanging upside down from tree branches.",
                            "target_lang_translations": {
                                "pl": "<w>Leniwiec</w> spędza większość swojego życia wisząc głową w dół na gałęziach drzew."
                            }
                        },
                        {
                            "text": "Because of its slow metabolism, a <w>sloth</w> does not need to eat very often.",
                            "target_lang_translations": {
                                "pl": "Ze względu na powolny metabolizm, <w>leniwiec</w> nie musi jeść zbyt często."
                            }
                        }
                    ],
                    "synonyms": [
                        "tardigrade"
                    ],
                    "common_phrases": [
                        "three-toed sloth"
                    ],
                    "target_lang_definitions": {
                        "pl": "Powolny, nadrzewny ssak pochodzący z Ameryki Południowej i Środkowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "leniwiec",
                                "target_lang_sense_clarification": "zwierzę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba29c3ea-ba06-3e5b-9bc0-f01a9514355a",
                    "sense_definition": "A state of extreme laziness or disinclination to work.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>sloth</w> prevented him from achieving his goals at work.",
                            "target_lang_translations": {
                                "pl": "Jego ciągłe <w>lenistwo</w> uniemożliwiło mu osiągnięcie celów w pracy."
                            }
                        },
                        {
                            "text": "The manager criticized the team for their <w>sloth</w> during the busy season.",
                            "target_lang_translations": {
                                "pl": "Kierownik skrytykował zespół za ich <w>lenistwo</w> w trakcie pracowitego sezonu."
                            }
                        }
                    ],
                    "antonyms": [
                        "diligence"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan skrajnego lenistwa lub niechęci do pracy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lenistwo",
                                "target_lang_sense_clarification": "brak chęci do działania"
                            },
                            {
                                "target_lang_word": "leniwiec",
                                "target_lang_sense_clarification": "osoba leniwa (potocznie)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc625e79-9a54-38bf-a310-eff1880f73ee",
                    "sense_definition": "To spend time in an idle or lazy manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "laziness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would often <w>sloth</w> away his weekends instead of studying for exams.",
                            "target_lang_translations": {
                                "pl": "Często <w>leniuchował</w> przez weekendy zamiast uczyć się do egzaminów."
                            }
                        },
                        {
                            "text": "It is easy to <w>sloth</w> around the house when you have no responsibilities.",
                            "target_lang_translations": {
                                "pl": "Łatwo jest <w>obijać się</w> w domu, kiedy nie ma się żadnych obowiązków."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sloth away"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb usage is rarely encountered in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Spędzanie czasu w sposób bezczynny lub leniwy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "leniuchować",
                                "target_lang_sense_clarification": "spędzać czas na nicnierobieniu"
                            },
                            {
                                "target_lang_word": "obijać się",
                                "target_lang_sense_clarification": "unikać pracy lub wysiłku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}