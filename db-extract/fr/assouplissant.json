                        "glosses": [
                            "Produit que l’on additionne à la lessive dans une machine à laver afin d’assouplir le linge lors du rinçage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e122dd8-2904-4cd7-ba14-fa5bc43f46cc",
                                "sense_id": "7c8989d2-f1d3-33f3-85ab-2033dc9ff373",
                                "text": "Cette poudre ayant un pouvoir adoucissant, vous pourrez même vous passer d’assouplissant, substance souvent suspectée de produire des réactions allergiques chez les personnes sensibles, en particulier les tout jeunes enfants."
                            }
                        ]
                    }
