                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4c357d-fa2a-49fe-9980-fe2b9a5e3777",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "Haar onophoudelijke zeuren bracht iedereen tot wanhoop."
                                            },
                                            {
                                                "example_id": "5e1f8bb3-b907-4700-aecc-24815afdf165",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "Overal waar je keek zag je leven in de woestijn. Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels."
                                            },
                                            {
                                                "example_id": "83b44377-52d4-4116-8000-d01b8c127433",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "De meisjes werden gek, schreeuwden onophoudelijk en gooiden kleren op het podium. Zelfs onderbroeken, werd er beweerd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onophoudelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0a50dffa-3aee-339d-bdd7-653083245560",
                                        "entry_id": "7d0d6796-edfd-3497-849e-27bb4aeeb18b",
                                        "glosses": [
                                            "zonder te stoppen, als maar doorgaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1616438e-d592-44b0-ad0b-52238bd471cf",
                                                "sense_id": "0a50dffa-3aee-339d-bdd7-653083245560",
                                                "text": "Het bleef, naar ons gevoel, de hele zomer onophoudelijk door regenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c99bcfbb-b979-46d3-b928-658a61d72e41",
                        "source_entry_id": "8c051f11-22d9-3ac7-964e-df30df03d9e0",
                        "source_sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                        "source_sense_description": "without pause or stop; not ending",
                        "target_lang_word": "incessant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incessant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                        "entry_id": "b7355963-edb9-3977-af56-1e28d42b00bc",
                                        "glosses": [
                                            "Qui ne cesse pas ; qui dure sans interruption ; qui est continu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34fe7273-2ae3-4792-82d4-0fcda83fa0ae",
                                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                                "text": "La nature a sur la matière vivante de tels droits, qu’il faut à l’homme des efforts incessants pour les contrebalancer."
                                            },
                                            {
                                                "example_id": "d2c269b2-25e0-4d66-9e73-1ca33bcc5687",
                                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                                "text": "Mais dans « Frenchie Shore », on ne parle pas uniquement de danses collées serrées ou de petits roulages de pelles, mais de fellations à peine floutées ou de tripotages incessants au bord de la piscine."
                                            },
                                            {
                                                "example_id": "06a0e245-8f64-4b02-8eec-33dce2be7e90",
                                                "sense_id": "38bb9083-5d4b-3f8a-9500-85e0bd13e7e9",
                                                "text": "D'un étage à l'autre, c'était un remue-ménage incessant de paras, qui montaient et descendaient, chassant devant eux des Musulmans, […], le tout dans un grand bruit de bottes, d'éclats de rire, de grossièretés et d'insultes entremêlés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "761616d5-8e4c-481e-a7c0-3e476b5daced",
