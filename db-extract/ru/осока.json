                    },
                    {
                        "translation_id": "a1078a04-f092-4f90-82a8-9ef488c6b2f4",
                        "source_entry_id": "9dab9894-64ec-34bc-acdd-b1d27c30dfb4",
                        "source_sense_id": "b2cb7c67-38e0-3d73-a6c6-a6efbbaa1ab6",
                        "target_lang_word": "laîche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laîche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "293d4c2f-b1c4-3863-a437-de4444fbf66c",
                                        "entry_id": "b3b5ed31-7a17-3bab-be4f-ca341dc4d103",
                                        "glosses": [
                                            "Carex, genre de plantes vivaces, à feuilles coupantes, qui croissent généralement dans les lieux humides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735e83c7-3b35-438e-b36e-442c4c2957e5",
                                                "sense_id": "293d4c2f-b1c4-3863-a437-de4444fbf66c",
                                                "text": "Pendant ce temps, le cri de la meute était devenu un Bouaf ! de dépit : les chiens avaient perdu la piste, leur course compacte se ramifiait en un réseau de recherches olfactives tout autour d’une clairière de laîches ; ils étaient trop impatients de retrouver le filet d’odeur perdu pour bien le chercher ; leur élan était retombé et déjà certains en profitaient pour lever la patte contre une pierre."
                                            },
                                            {
                                                "example_id": "23926cbd-c6b2-44df-b6ff-07f6648e5e69",
                                                "sense_id": "293d4c2f-b1c4-3863-a437-de4444fbf66c",
                                                "text": "De la Bresse au Dauphiné, herbes palustres, les laîches, qu'on utilise comme litière ; espèce de roseau qui servait parfois d'aliment au bétail. On dit aussi flaches."
                                            },
                                            {
                                                "example_id": "06298f0e-6394-44a6-b803-ea5e1edf4f03",
                                                "sense_id": "293d4c2f-b1c4-3863-a437-de4444fbf66c",
                                                "text": "L'animal était certainement occupé à brouter de la laîche, cette herbe qui pousse au bord de l’eau, ou à grignoter quelque racine de nénuphar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laîche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b59391f0-74cb-3f9f-a643-b773b0ad6d0c",
                                        "entry_id": "25793221-d4c2-3aae-8283-eccbfeaa5839",
                                        "glosses": [
                                            "Ver de terre, amorce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476a32fb-8402-40aa-8441-47533398d78c",
                                                "sense_id": "b59391f0-74cb-3f9f-a643-b773b0ad6d0c",
                                                "text": "On donne ce nom et celui de laiche à certains vers qui servent à nourrir des oiseaux ou à faire des appâts pour la pêche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b484f69-46bb-4931-b4c7-bfbd155a2354",
                        "source_entry_id": "9dab9894-64ec-34bc-acdd-b1d27c30dfb4",
                        "source_sense_id": "b2cb7c67-38e0-3d73-a6c6-a6efbbaa1ab6",
                        "target_lang_word": "carex",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carex",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ccd2da9-3c06-32fb-b448-40a867801b92",
                                        "entry_id": "3b1fbfc1-b622-3ba0-9a33-159156d109a4",
                                        "glosses": [
                                            "Genre de plantes de la famille des cypéracées appelées communément laîches, à tiges souvent de section triangulaire, à feuilles souvent coupantes, aux fleurs en épis, et dont beaucoup croissent dans les lieux humides, dans les régions tempérées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef9b9136-2a78-4636-84a1-5d6685503cd5",
                                                "sense_id": "6ccd2da9-3c06-32fb-b448-40a867801b92",
                                                "text": "Le Diagramma était imprimé sur du papyrus de carex, qui ressemble à du papier de soie."
                                            },
                                            {
                                                "example_id": "686c287c-8ab3-4102-a06b-2a517ce0418c",
                                                "sense_id": "6ccd2da9-3c06-32fb-b448-40a867801b92",
                                                "text": "Les papillons de nuit (hétérocères) suivants (classés par famille) se nourrissent de carex :",
                                                "translation": "plusie de la fétuque (Noctuidae)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
