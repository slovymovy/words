                    },
                    {
                        "sense_id": "c8058248-7fe0-303c-83b2-4fe1a2c8e35f",
                        "entry_id": "baec9ee8-15f9-39b1-a648-d0d53a10b8f7",
                        "glosses": [
                            "Traitement appliqué à un toxicomane ou à un alcoolique pour tenter de le libérer de sa dépendance à l’égard de la drogue, de l’alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b5f489-5faf-40be-8ab6-beb3f12df180",
                                "sense_id": "c8058248-7fe0-303c-83b2-4fe1a2c8e35f",
                                "text": "Une cure de désintoxication."
                            },
                            {
                                "example_id": "e2007739-f4f9-4972-a796-f80af475ab25",
                                "sense_id": "c8058248-7fe0-303c-83b2-4fe1a2c8e35f",
                                "text": "Le professeur Delay n’est pas opposé à contraindre certains « grands » toxicomanes à la désintoxication, mais il souligne que la loi ne le permet pas."
                            }
                        ]
                    }
                ],
