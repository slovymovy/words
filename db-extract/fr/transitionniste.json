                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c30fb29-6fb5-4810-ae52-26642a7f8d18",
                                "sense_id": "0e65c229-7794-3b85-a1a3-ced4e2c254d1",
                                "text": "Selon cette vue transitionniste, exposée en 1997, la variation n’est intrinsèquement ni gradualiste, ni saltationniste, elle passe d’une modalité à l'autre selon la complexification des génomes et des processus."
                            },
                            {
                                "example_id": "53a2639e-1f5a-4c96-9a89-feb00fbfca80",
                                "sense_id": "0e65c229-7794-3b85-a1a3-ced4e2c254d1",
                                "text": "Il importe donc de s’extraire de l’imaginaire transitionniste."
                            }
                        ]
                    }
