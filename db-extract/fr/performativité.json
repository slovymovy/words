                        "glosses": [
                            "Fait qu’un mot ou une expression constituent par eux-mêmes la chose qu’ils énoncent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ead1a3-abac-4e3c-a7a2-aafd3b722cc2",
                                "sense_id": "57534645-5d31-32bf-a444-21443e08a330",
                                "text": "« Parler aux objets relève d’un côté magique », comme si le simple fait d’énoncer quelque chose nous faisait espérer une performativité de la parole."
                            },
                            {
                                "example_id": "db122e78-83e2-4da9-95bd-c39395e75463",
                                "sense_id": "57534645-5d31-32bf-a444-21443e08a330",
                                "text": "Le second exemple est celui des concepts de performance et de performativité tels qu'ils sont présentés dans les travaux de la philosophe Judith Butler, c'est-à-dire abstraits et subordonnés à la linguistique."
                            }
                        ]
                    }
