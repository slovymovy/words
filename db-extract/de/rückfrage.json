                "senses": [
                    {
                        "sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                        "entry_id": "7fb52ef6-8b99-36fc-9140-c28adbe400cb",
                        "glosses": [
                            "allgemein: Frage zur Überprüfung eines bereits bekannten Sachverhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc4ca85-2442-44dc-95b8-675fb53cc601",
                                "sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                                "text": "Für Rückfragen stehen wir Ihnen jederzeit gerne zur Verfügung."
                            },
                            {
                                "example_id": "61554210-292f-4a87-ac79-f416aebb76be",
                                "sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                                "text": "Bei Rückfragen wenden Sie sich bitte an den Hersteller."
                            },
                            {
                                "example_id": "f13ece48-235b-44ee-aee7-71670668848a",
                                "sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                                "text": "Auf meine Rückfrage, wie lange denn die Garantie gälte, reagierte keiner."
                            },
                            {
                                "example_id": "6f50251d-b82e-4227-a108-d954e6f117e3",
                                "sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                                "text": "Zu Rückfragen stehen wir Ihnen telefonisch zur Verfügung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5c74535-9594-3816-9e8d-9448d03acd98",
                        "entry_id": "7fb52ef6-8b99-36fc-9140-c28adbe400cb",
                        "glosses": [
                            "Linguistik: andere Bezeichnung für Echofrage: Antwort auf eine Frage unter Verwendung/ Wiederholung eines Teils des Wortlauts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d8545cf-280b-466f-ba24-77657ac9a396",
                                "sense_id": "f5c74535-9594-3816-9e8d-9448d03acd98",
                                "text": "Auf die Frage: „Willst du morgen kommen?“ - kann eine Antwort mit Rückfrage erfolgen: „Ob ich morgen kommen will?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487dd88a-088a-46dc-b509-1614582d4d90",
                        "source_entry_id": "7fb52ef6-8b99-36fc-9140-c28adbe400cb",
                        "source_sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                        "source_sense_description": "allgemein: Frage zur Überprüfung eines bereits bekannten Sachverhalts",
                        "target_lang_word": "query",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "query",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8392dd85-d0f5-38ea-8d09-f58e9fce1494",
                                        "entry_id": "103e528d-94f0-31a0-a647-82157df7f0c9",
                                        "glosses": [
                                            "A question, an inquiry (US), an enquiry (UK)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a5d8e2-fcb3-4c5b-8469-5ab5939de284",
                                                "sense_id": "8392dd85-d0f5-38ea-8d09-f58e9fce1494",
                                                "text": "The teacher answered the student’s query concerning biosynthesis."
                                            },
                                            {
                                                "example_id": "2125a741-d275-4990-85a4-d37211782e97",
                                                "sense_id": "8392dd85-d0f5-38ea-8d09-f58e9fce1494",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3378a188-baf3-34c1-b521-3e1e881d5c2c",
                                        "entry_id": "103e528d-94f0-31a0-a647-82157df7f0c9",
                                        "glosses": [
                                            "A question mark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d37e90-5aac-4387-804b-baf02f757918",
                                                "sense_id": "3378a188-baf3-34c1-b521-3e1e881d5c2c",
                                                "text": "His Glossary has ‘bouchen, to stop people's mouths,’; but this is followed by a query, to show that it was but a guess. I have shown, from the MSS. and other sources, that it should be bonched, i.e. bunched, bumped, knocked, smote."
                                            },
                                            {
                                                "example_id": "6939d81d-5263-4147-a82f-bb5043c2d457",
                                                "sense_id": "3378a188-baf3-34c1-b521-3e1e881d5c2c",
                                                "text": "She had written in her diary: \"I don't think I am in a concentration-camp??????\", the queries growing larger and more numerous till they covered the entire page […]"
                                            },
                                            {
                                                "example_id": "92637be2-a4da-4eae-bac7-1352376b10bb",
                                                "sense_id": "3378a188-baf3-34c1-b521-3e1e881d5c2c",
                                                "text": "I refer you to your line above, where you use a query and a bang together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2c485a-da05-3d79-9532-5d25399121b7",
                                        "entry_id": "103e528d-94f0-31a0-a647-82157df7f0c9",
                                        "glosses": [
                                            "A set of instructions passed to a database."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1914200d-618c-4446-9825-596ad7b48a59",
                                                "sense_id": "7e2c485a-da05-3d79-9532-5d25399121b7",
                                                "text": "The database admin switched on query logging for debugging purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc820b8d-558f-34a0-95ff-9152dda3a36a",
                                        "entry_id": "103e528d-94f0-31a0-a647-82157df7f0c9",
                                        "glosses": [
                                            "Ellipsis of query letter."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a11668-2ad6-42f3-91fa-7e6fd76d863e",
                                                "sense_id": "bc820b8d-558f-34a0-95ff-9152dda3a36a",
                                                "text": "Although many agents accept email queries, check to see if they prefer mailed query letters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "query",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a57bffb-5502-351a-bf4d-23c257879072",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To ask a question."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d27b1601-1997-3495-8346-f8744537dd4d",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To ask, inquire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21bab0fb-1549-47f0-aaa5-ce54d0cef3d4",
                                                "sense_id": "d27b1601-1997-3495-8346-f8744537dd4d",
                                                "text": "I tried that once in an AOL thing called \"The Arena\", I can't remember who the celebrity was, but I posed some divinely thoughtful, inspired, well-crafted question, and they chose one, instead, that querried her favourite colour, quelle banel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c952d4ab-3013-3201-9e5b-eb1c7f65498e",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To question or call into doubt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da90157a-90d1-4092-8dfc-7d8e50ec9cd6",
                                                "sense_id": "c952d4ab-3013-3201-9e5b-eb1c7f65498e",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen. No one queried it. It was in the classic pattern of human weakness, mean and embarrassing and sad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716d3a56-dfe9-3b4d-8972-6b4247d4c0c6",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To pass a set of instructions to a database to retrieve information from it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e43c29c-3f5a-4ce3-8d92-7acd645d8bb6",
                                                "sense_id": "716d3a56-dfe9-3b4d-8972-6b4247d4c0c6",
                                                "text": "Linked tables can be accessed, queried, combined and reorganised much more flexibly and in a number of ways that may not be immediately predictable when the database is under construction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d397d2-690f-3acc-8548-b92708a820e9",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To send a private message to (a user on IRC)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96fca05d-a7d5-44f0-9766-871ee8d75770",
                                                "sense_id": "c2d397d2-690f-3acc-8548-b92708a820e9",
                                                "text": "He parted the channel saying \"SHUTUP!\"... so I queried him, asking if there was something I could do.. maybe talk..."
                                            },
                                            {
                                                "example_id": "84f52525-5aba-4a67-a86e-08f9afdd810e",
                                                "sense_id": "c2d397d2-690f-3acc-8548-b92708a820e9",
                                                "text": "if you know someone who is in the channel, you can query them and ask for the key."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4318b5-1cdc-340e-acfd-52424cc112f9",
                                        "entry_id": "7e18dfe7-d6db-3dd8-9ed0-41210227bd35",
                                        "glosses": [
                                            "To send out a query letter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00e8dcd9-7e42-4d6a-8f57-5a3dd51b7c3e",
                        "source_entry_id": "7fb52ef6-8b99-36fc-9140-c28adbe400cb",
                        "source_sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                        "source_sense_description": "allgemein: Frage zur Überprüfung eines bereits bekannten Sachverhalts",
                        "target_lang_word": "further inquiry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b3e7dc08-45c8-4e02-aed3-286fb38c0b61",
                        "source_entry_id": "7fb52ef6-8b99-36fc-9140-c28adbe400cb",
                        "source_sense_id": "cfdda2e7-0194-3284-9069-43f1d8950235",
                        "source_sense_description": "allgemein: Frage zur Überprüfung eines bereits bekannten Sachverhalts",
                        "target_lang_word": "question",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "question",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Interrogation, demande que l’on fait pour s’informer de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b66b578-fd38-49a3-a526-369758a41b57",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "Dumay ne demanda rien à son patron, il ne lui fit pas de questions sur ses projets."
                                            },
                                            {
                                                "example_id": "675ca10f-7a62-4ec4-9300-4cad00328339",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "Ils firent mille questions sur Julien. Elle répondait à chacune, mais eut soin de taire l’idée funèbre qui les concernait."
                                            },
                                            {
                                                "example_id": "c1b7e16a-4d9d-400a-8200-3f09d911de4b",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "L’incrédulité de Bert était ébranlée. Il posait des questions, et le soldat y répondait complaisamment."
                                            },
                                            {
                                                "example_id": "00368e92-b1e2-4866-ad7c-39c0509b5f8a",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "[…], n’avait-il point remarqué une superbe truite qui se calait sous un rocher de la rive.[…]. La question se posait seulement de savoir s’il la prendrait au filet ou à la main."
                                            },
                                            {
                                                "example_id": "3acb8774-a276-49fc-b85c-2ca488489f19",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "Quand nous blâmons les Bas-Alpins de déserter leur pays, ayons la franchise de nous poser cette question : et moi-même, si j’avais vingt ans, y resterais-je ?"
                                            },
                                            {
                                                "example_id": "11a51223-2154-4d36-9b97-fb59168fb0aa",
                                                "sense_id": "a5f4234d-bcb3-3e0f-8cce-22dd1181d363",
                                                "text": "L'a remplacée un petit bonhomme sans un poil sur le caillou, qui m'a bombardée de questions carrément barbantes, comme mes rêves, ma vie sexuelle et j’en passe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6273bafb-9c3d-3da7-bc49-2b23ebc35240",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Type de phrase pour demander une information, généralement avec un syntagme ou une particule interrogative, ou avec l’ordre des mots spécial. → voir phrase interrogative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfa9e102-a00e-3561-85d8-f8b0fe9c2145",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Phrase dont le but est d’inviter un auditeur, un lecteur à donner une explication, un renseignement, ou tout cas appelant une réponse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1112140-a313-4c98-b40d-383a3fafca0f",
                                                "sense_id": "cfa9e102-a00e-3561-85d8-f8b0fe9c2145",
                                                "text": "Question. Où parlez-vous français ? Réponse. Je parle français à la classe de français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebff60dc-aff3-31c4-ad5d-29cc53f3acca",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Interrogations que l’on adresse à un élève dans un examen."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ceeaaa-2b56-4466-830c-4af502751b6f",
                                                "sense_id": "ebff60dc-aff3-31c4-ad5d-29cc53f3acca",
                                                "text": "Cet élève répondit fort bien aux questions qu’on lui adressait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Proposition qu’il y a lieu d’examiner, de discuter, difficulté dont on cherche la solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a3e75e-4b48-462a-bfd6-a4425454db3b",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "La question du déplacement des pôles n'a pas encore rallié, non plus, tous les suffrages, j'y ferai simplement allusion."
                                            },
                                            {
                                                "example_id": "28d41c12-383e-44a8-89f0-9e8d6ffb6fd4",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "La question soulevée par Hoffman est plutôt celle de l’effondrement des barrières entre les sphères économiques, politiques et culturelles avec la militarisation de la vie elle-même."
                                            },
                                            {
                                                "example_id": "7d4f79b8-7029-4685-a097-1aa10adc24d5",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "Je n’insiste pas, car il existe des ouvrages sur ces questions, tels l’important mémoire de De Candolle et les travaux de A. Chevalier."
                                            },
                                            {
                                                "example_id": "65940a7b-b126-4a22-81b8-3d1b7a16af4c",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "La France demande que soit soumise au Tribunal de La Haye la question de savoir si le pacte franco-soviétique est compatible avec Locarno."
                                            },
                                            {
                                                "example_id": "23c0aa0a-f30b-4339-b718-d55ecb28151d",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "La question d’argent devient épineuse. Je ne peux plus vivre que pauvrement dans cette grande ville."
                                            },
                                            {
                                                "example_id": "d9bc8411-a59a-480d-a4c8-13e1ffee6483",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "Cette anthropologie approximative du peuple satyresque laisse de côté l'embarrassante question des satyreaux, dont on se demande comment ils ont bien pu être engendrés dans cet univers sans femmes: […]."
                                            },
                                            {
                                                "example_id": "5535a897-a326-43ff-a698-185fb6070ceb",
                                                "sense_id": "f7d39c84-cf9a-3ce2-8406-9e30da0a4588",
                                                "text": "D’autres parents encore, diplômés de filières scientifiques et techniques et plus dotés en capital économique, apprécient les histoires permettant de « répondre à des questions » ou faire des découvertes, notamment dans le domaine des sciences. Pour eux, l’écrit est alors envisagé comme une médiation vers des savoirs, notamment scolaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c7e6d29-31d0-3ea4-a3b8-67e86ef0dad2",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Affaire considérable soumise à l’examen du gouvernement, d’une assemblée, du public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643329a2-75fa-4dc5-b9f7-9f1d7de3b170",
                                                "sense_id": "5c7e6d29-31d0-3ea4-a3b8-67e86ef0dad2",
                                                "text": "M. Thiers revint alors au pouvoir le 1ᵉʳ mars 1840. A cette époque, le problème de la question d’Orient s’agitait en Europe, […]."
                                            },
                                            {
                                                "example_id": "77f8185b-3207-461f-ac15-92fa57abd88e",
                                                "sense_id": "5c7e6d29-31d0-3ea4-a3b8-67e86ef0dad2",
                                                "text": "Les rapports s’étaient tendus aussi entre les États-Unis et le Japon, à cause de l’éternelle question de la naturalisation des jaunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077106f4-4d22-365d-8d50-b03630c66703",
                                        "entry_id": "3934013c-6710-3605-a4ab-bb3ce9940d4b",
                                        "glosses": [
                                            "Torture qui était infligée aux accusés, en matière criminelle, pour leur arracher des aveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0402fbfe-39ff-48c3-97e2-29764cf94384",
                                                "sense_id": "077106f4-4d22-365d-8d50-b03630c66703",
                                                "text": "Mais elle nia d’abord tout obstinément jusqu’à ce qu’on l’appliquât à la question ; alors, ne pouvant résister à l’excès de la douleur, elle avoua que depuis longtemps, et de concert avec le démon, elle avait pratiqué la magie et les maléfices, …"
                                            },
                                            {
                                                "example_id": "3c0e6a66-eac8-40d8-9be9-359fb2e1f41f",
                                                "sense_id": "077106f4-4d22-365d-8d50-b03630c66703",
                                                "text": "— Reste, reste, dirent toutes les femmes, reste, mon enfant, n’aie pas peur, et dis-nous bien ce que tu vois.\n— Eh bien, c’est qu’on a couché le curé entre deux grandes planches qui lui serrent les jambes, et il y a des cordes autour des planches.\n— Ah ! c’est la question, dit un homme de la ville. Regarde bien, mon ami, que vois-tu encore ?"
                                            },
                                            {
                                                "example_id": "cf172736-4bef-4af0-b93b-69a6d3fcb79e",
                                                "sense_id": "077106f4-4d22-365d-8d50-b03630c66703",
                                                "text": "Sur 3 027 condamnés à des peines corporelles, 115 sont soumis à la question (3,7 %), dont 63 à la question préparatoire et 52 à la question préalable. Rapportés au total des inculpés, ces chiffres montrent que la torture est une pratique exceptionnelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "question",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1def39-5e99-39b7-a7d8-b59ef489586e",
                                        "entry_id": "703b6335-70ae-3344-bf5a-60c66a18d145",
                                        "glosses": [
                                            "Quant à"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5069598d-dd49-4ad1-9d13-1993935f59d9",
                                                "sense_id": "5a1def39-5e99-39b7-a7d8-b59ef489586e",
                                                "text": "Vois-tu, dans le monde entier, question rigolade et satisfaction, il n'y a que Paris qui compte, et dans Paris, Montmartre."
                                            },
                                            {
                                                "example_id": "227672cf-fc05-4963-8a4c-3a863aa2a5be",
                                                "sense_id": "5a1def39-5e99-39b7-a7d8-b59ef489586e",
                                                "text": "En plus, il y avait cette fille, une certaine Melissa, qui non seulement parlait comme un moulin mais, à première vue, battait Siobhan à plate couture question nunucherie."
                                            },
                                            {
                                                "example_id": "795c5290-4e36-4c25-a10a-86609b8ed0a2",
                                                "sense_id": "5a1def39-5e99-39b7-a7d8-b59ef489586e",
                                                "text": "Le maître des cérémonies fut pris au dépourvu. Question obsèques, il en connaissait pourtant un rayon…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
