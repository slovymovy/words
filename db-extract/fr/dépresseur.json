                        "sense_id": "299e6782-9c9b-3439-a541-e4cab127f039",
                        "entry_id": "4e31b07f-b4e6-3835-8f60-dba0696d8d3e",
                        "glosses": [
                            "Substance qui ralentit l’activité du système nerveux central."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfd51b3-c1ff-41c5-8621-c3a547101551",
                                "sense_id": "299e6782-9c9b-3439-a541-e4cab127f039",
                                "text": "Le barbiturique est un médicament agissant comme dépresseur du système nerveux central, et dont le spectre d’activité s’étend du sédatif à l’anesthésie."
                            },
                            {
                                "example_id": "21111698-8d31-4a6c-8f59-774830a069e9",
                                "sense_id": "299e6782-9c9b-3439-a541-e4cab127f039",
                                "text": "Ce médicament agit comme un dépresseur du système nerveux central et peut entraîner somnolence, vertiges, sensation de fatigue et de désorientation, évanouissement et troubles visuels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "effcceb6-acfb-4c69-af56-8e0e6a14c2d6",
                        "source_entry_id": "4e31b07f-b4e6-3835-8f60-dba0696d8d3e",
                        "source_sense_id": "299e6782-9c9b-3439-a541-e4cab127f039",
                        "target_lang_word": "depressant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depressant",
