                                        "glosses": [
                                            "medico specializzato nella diagnosi e nella cura delle malattie dell'apparato riproduttore femminile"
                                        ],
                                        "tags": [
                                            "professione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2fbac98-dd39-4f2d-af0c-f6d0b3813478",
                                                "sense_id": "5bb00571-4420-3517-adcd-f7b9ad70367b",
                                                "text": "non tutte le donne sono obbligate ad andare dal ginecologo che a prescindere infatti, qualora vi siano dei casi, non si occupa direttamente del parto né della gravidanza"
                                            },
                                            {
                                                "example_id": "c26fcc83-81f4-491e-b083-21ffcfb28c73",
                                                "sense_id": "5bb00571-4420-3517-adcd-f7b9ad70367b",
                                                "text": "si ritene che originariamente la funzione dei ginecologi sia la valutazione della castità femminile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47678ff6-45f3-38d8-aa3f-e63d7d53cead",
                                        "entry_id": "3f3a10f5-f354-3913-9aea-1028617f3246",
                                        "glosses": [
                                            "persona superficiale che, dietro una facciata di seriosa professionalità ed un atteggiamento studiato, irretisce maliziosamente con vanteria, disprezzo e irriverente derisione"
                                        ],
                                        "tags": [
