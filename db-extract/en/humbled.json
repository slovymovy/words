    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b8e807ce-0961-3125-94ee-5d5792c0f635",
                "word": "humbled",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "00f5c60f-0c05-419e-a927-1787fad74363",
                        "entry_id": "b8e807ce-0961-3125-94ee-5d5792c0f635",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more humbled"
                    },
                    {
                        "form_id": "53c9b3ef-b9e4-4a55-8931-c37aaa8cee35",
                        "entry_id": "b8e807ce-0961-3125-94ee-5d5792c0f635",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most humbled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                        "entry_id": "b8e807ce-0961-3125-94ee-5d5792c0f635",
                        "glosses": [
                            "(usually qualifying a first-person pronoun) Grateful for the support of others, touched; honored, flattered."
                        ],
                        "tags": [
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "ec9d3852-94c8-464f-a9e1-50c264ffdaab",
                                "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                                "text": "JJ: Are you humbled by such positive reactions from such a wide spectrum of people, from George A Romero to Harry Knowles?\nSP: Absolutely. Yeah, it's wonderful. ... We're very humbled and very pleased."
                            },
                            {
                                "example_id": "01bef0a8-6bcc-48b6-88d9-6c7aadc323de",
                                "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                                "text": "We are humbled by the responsibility the American people have placed with us, but this is not a time for celebration."
                            },
                            {
                                "example_id": "01720e28-aa5f-4b35-9795-2fb5f0604e79",
                                "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                                "text": "I cannot adequately express my sincere thanks to the Section leaders who saw fit to take a chance on me and ask me to get involved in leadership in the Section. Thank you for being excellent role models. I am honored and humbled to serve."
                            },
                            {
                                "example_id": "d472a6c3-a048-441c-b527-e9fd259a258e",
                                "sense_id": "55232707-37a6-3738-b343-da2c9d4f9e72",
                                "text": "\"Anytime I win an award of any kind I am honored and humbled,\" Espinoza said."
                            }
                        ]
                    },
                    {
                        "sense_id": "564a24c8-ca16-3e1e-b939-866fc7904829",
                        "entry_id": "b8e807ce-0961-3125-94ee-5d5792c0f635",
                        "glosses": [
                            "Overcome with humility; in awe of the strength of another or one's own weakness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376decc9-a1f7-4991-b0f2-0ec356eb4cb5",
                                "sense_id": "564a24c8-ca16-3e1e-b939-866fc7904829",
                                "text": "They would continue to suffer greatly but they have a strength that is remarkable. I am humbled by them and privileged to be with them."
                            },
                            {
                                "example_id": "162bcbd0-5573-4347-9916-f092f37b3d30",
                                "sense_id": "564a24c8-ca16-3e1e-b939-866fc7904829",
                                "text": "The written word, he often argued, could only ever be a low-fidelity reproduction of the fullness of being; any text was ultimately humbled by the reality that it sought to represent."
                            }
                        ]
                    }
                ],
