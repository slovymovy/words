                                        "entry_id": "90c659f5-9bc5-3e80-ba8f-fe3defa591e5",
                                        "glosses": [
                                            "A state similar to hibernation characterised by energy-conserving, very deep sleep."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
