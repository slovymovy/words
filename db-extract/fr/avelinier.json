                        "glosses": [
                            "Variété de noisetier qui porte les avelines (Corylus avellana)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4cb443c-4716-4cdd-87de-375a1f788648",
                                "sense_id": "a494389d-c7b9-3f06-ab71-9443229efc9e",
                                "text": "Le seul ornement en était une courte allée qu’ombrageait de chaque côté une haie d'aveliniers."
                            },
                            {
                                "example_id": "c39ade15-e076-4f87-9640-99f458d0a2fb",
                                "sense_id": "a494389d-c7b9-3f06-ab71-9443229efc9e",
                                "text": "L’avelinier gèle quand il neige et les oies sauvages, les pintades, les poules, les colombes et les dindes se pavanent sous le préau."
                            }
                        ]
                    }
