                        "entry_id": "adcea6ae-aa83-3d48-b90b-51a8b73baa2a",
                        "glosses": [
                            "Celle qui fait, qui vend ou qui loue des costumes de théâtre, de bal, etc."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cb7f3c7a-4a2f-39a1-9cae-f555bf586205",
                        "entry_id": "adcea6ae-aa83-3d48-b90b-51a8b73baa2a",
                        "glosses": [
                            "Celle qui s’occupe des costumes au théâtre, au cinéma, à la télévision, etc."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "1143e530-adfc-4e06-b0c4-1ddb151a9442",
                                "sense_id": "cb7f3c7a-4a2f-39a1-9cae-f555bf586205",
                                "text": "Ce soir-là, la costumière devait partir travailler au théâtre."
                            },
                            {
                                "example_id": "8dfd1a1f-29b3-4a73-8067-26ebc4719063",
                                "sense_id": "cb7f3c7a-4a2f-39a1-9cae-f555bf586205",
                                "text": "J’ai toujours dit à Marylin [Fitoussi], notre costumière : « Elle s’est enfermée, parce qu’elle arrive de la plage de Saint-Tropez, pieds nus. »"
                            },
                            {
                                "example_id": "78e5ab19-3260-4c21-9e02-7f2747ba5031",
                                "sense_id": "cb7f3c7a-4a2f-39a1-9cae-f555bf586205",
                                "text": "Seule la costumière, Marion Egner, connaît l’identité des stars cachées sous les masques conçus dans l’atelier."
                            }
                        ]
                    }
                ],
