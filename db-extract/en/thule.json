    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                "word": "Thule",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "49440322-6a33-3455-abb3-2e0970095209",
                        "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "glosses": [
                            "The semi-legendary island of classical antiquity considered to represent the northernmost location in the inhabited world (the Ecumene)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3494c63d-ccea-4537-a5f7-96fc86f0fc07",
                                "sense_id": "49440322-6a33-3455-abb3-2e0970095209",
                                "text": "I have reached these lands but newly // From an ultimate dim Thule."
                            },
                            {
                                "example_id": "c320f6f8-ced0-4c27-abcb-8496736c7943",
                                "sense_id": "49440322-6a33-3455-abb3-2e0970095209",
                                "text": "For distant India tremble may // Beneath your mighty rule, // And Thulé⁵ bow beneath your sway // Far in the Northern sea, // But if to care and want you’re prey, // No king are you, but slave."
                            },
                            {
                                "example_id": "17fd84ec-c286-4050-93d8-23fff21c2d70",
                                "sense_id": "49440322-6a33-3455-abb3-2e0970095209",
                                "text": "5. To the Romans Thulé, variously identified as Iceland or Mainland in the Shetland Isles, marked the extreme northern limit of the known world, just as India here stands for the farthest east."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fbbc1f7-3f79-3f2c-a89d-6110a85dd22b",
                        "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "glosses": [
                            "A nationalist and occultist group in Germany in the early 20th century, which included some of the founding members of the Nazi Party."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "766b751b-df93-3698-89f9-dc493f66f40f",
                        "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "glosses": [
                            "The historical Eskimo culture extending from Alaska to Greenland between the 6th and 14th centuries."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "377c1e2c-3ef8-343f-a20f-f6476a09d54c",
                        "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "glosses": [
                            "A settlement in northwestern Greenland established in 1910 by the Danish explorer Knud Rasmussen."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce638412-0a3e-3a89-8c0d-1a91946544d7",
                        "entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "glosses": [
                            "An air base built on the site in the 1940s."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d140916-b1f1-4482-9488-12e272c476e4",
                        "source_entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
                        "source_sense_description": "legendary island in the far north",
                        "target_lang_word": "Thulé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thulé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88422eb4-b08a-30c4-942b-e2f109766fad",
                                        "entry_id": "c8bd3fb5-58c9-346f-aea6-a8bccc0bd4b5",
                                        "glosses": [
                                            "Île lointaine non identifiée située au nord de l’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ce8a0c-e81f-41b1-a1a8-fce62dd6662a",
                                                "sense_id": "88422eb4-b08a-30c4-942b-e2f109766fad",
                                                "text": "Au loin, à l’infini, s’étendait la grande mer grise, la mer à travers les brumes de laquelle les soldats de César, dans l’angoisse et la fierté de se sentir parvenus aux confins du monde, avaient cru entrevoir Thulé."
                                            },
                                            {
                                                "example_id": "5675cfa2-2ad9-498f-8e40-d051878c0621",
                                                "sense_id": "88422eb4-b08a-30c4-942b-e2f109766fad",
                                                "text": "Au lieu de lui reprocher ses gaspillages, il fallait admirer sa prodigalité : il ressemblait à ce roi de Thulé, qu’il aimait à citer, et qui n’hésita pas à jeter à la mer sa plus belle coupe d’or pour la chance d’un soupir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbce8b2-8dfb-3319-93f2-852cf86868fc",
                                        "entry_id": "c8bd3fb5-58c9-346f-aea6-a8bccc0bd4b5",
                                        "glosses": [
                                            "Groenland."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3317e79-dd6c-437c-802a-046f0052c992",
                                                "sense_id": "3cbce8b2-8dfb-3319-93f2-852cf86868fc",
                                                "text": "Dans les stations de Thulé, particulièrement favorisées par leur très faible densité de population, les ventes provenant de la chasse peuvent rapporter 20 000 francs par an et par tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6538e1b4-28ac-496b-a567-0fa1d768de7a",
                        "source_entry_id": "751281c2-22a2-35f6-a06c-cb6b29a1885e",
