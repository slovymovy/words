                    {
                        "sense_id": "b94424db-826f-3b60-93cc-0533b3ec4bd1",
                        "entry_id": "2921ff27-bfa7-34a6-822b-056193390ad7",
                        "glosses": [
                            "To inhabit, frequent, or haunt."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "81acaf08-7343-4995-967d-b79802e19783",
                                "sense_id": "b94424db-826f-3b60-93cc-0533b3ec4bd1",
                                "text": "Your dead, and ancient holy sisters, too\nwho lost their order's head by ordered sword,\nso all would nevermore enhaunt our door."
                            },
                            {
                                "example_id": "7f7a3463-4217-4d72-a044-e24f6f030268",
                                "sense_id": "b94424db-826f-3b60-93cc-0533b3ec4bd1",
                                "text": "Wilt thou inhaunt thy selfe, and draw with wicked men to fit?"
                            },
                            {
                                "example_id": "701b6103-cae7-4934-bf05-f4e5bc252662",
                                "sense_id": "b94424db-826f-3b60-93cc-0533b3ec4bd1",
                                "text": "Pinprick spiders inhaunt the nether regions — inhaunt is to inhabit in a haunting way — and vie with lurid grotto larvae, wormy creatures with flabby wings which are as veiny and pulsating as an engorged penis."
                            }
                        ]
                    }
