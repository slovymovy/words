                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bde3043-4ffc-42a3-ab93-206b9b5aedf3",
                                "sense_id": "a950f3a7-9c6c-3b1c-96a0-395aa471323d",
                                "text": "„Sie hatte fast die schmale Straße erreicht, die durch das Kieferndickicht zurück zum Haus ihrer Mutter führte, als um sie herum das blaue Licht zu pulsieren begann und die Baumstämme und das tote braune Gras am Straßenrand beleuchtete.“"
                            },
                            {
                                "example_id": "fda95edc-3730-431f-a393-455958bb6e83",
                                "sense_id": "a950f3a7-9c6c-3b1c-96a0-395aa471323d",
                                "text": "„Sie ruckelten um die letzte Kurve unterhalb des Kieferndickichts und kamen vor der Olive Branch Negro Baptist Church schütternd zum Stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
