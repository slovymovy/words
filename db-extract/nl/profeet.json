                    }
                ],
                "senses": [
                    {
                        "sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                        "entry_id": "3cce175e-3a5a-3aea-a3d8-e7d1d229ddfe",
                        "glosses": [
                            "een persoon die boodschappen van een godheid aan de mensen doorgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbee14f2-4913-4677-8c53-7143ab6f52f9",
                                "sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                                "text": "om een verschil van mening over de opvolging van de profeet (1300 jaar geleden) worden nu nog elke dag bommen geplaatst"
                            },
                            {
                                "example_id": "794e6f05-702e-4cb0-8d55-1a16cc55d42c",
                                "sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                                "text": "Aangezien ik niks kon zeggen pakte zij het boek De profeet van Kahlil Gibran uit haar rugzak en begon mij hardop voor te lezen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bc93997-54f1-308c-a19a-e0a9b19b01f9",
                        "entry_id": "3cce175e-3a5a-3aea-a3d8-e7d1d229ddfe",
                        "glosses": [
                            "iemand die de toekomst voorspelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698772f6-27a4-4dce-bd8e-2c6671e32ad8",
                                "sense_id": "3bc93997-54f1-308c-a19a-e0a9b19b01f9",
                                "text": "Tijdens Fall Gelb en de Battle of Brittan (1940) verstrooiden Duitse vliegtuigen pamfletten met slecht vertaalde toekomstvoorspellingen van de Middeleeuwse profeet Nostradamus"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f645dae-a03a-4fe3-9e22-1e3c3acb2566",
                        "source_entry_id": "3cce175e-3a5a-3aea-a3d8-e7d1d229ddfe",
                        "source_sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                        "source_sense_description": "een persoon die boodschappen van een godheid aan de mensen doorgeeft",
                        "target_lang_word": "Prophet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prophet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaee2106-0434-3f6c-82b1-65cc3a44ecc1",
                                        "entry_id": "047598dc-9c0b-3467-946e-19015146ec5d",
                                        "glosses": [
                                            "Person, die sich durch einen Gott zur Verkündigung von Botschaften einer Religion berufen sieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca35a898-1d0c-482c-8e2d-38ba47255629",
                                                "sense_id": "aaee2106-0434-3f6c-82b1-65cc3a44ecc1",
                                                "text": "„Die Wirkungszeit des Propheten in Jerusalem beträgt etwa 40 Jahre.“"
                                            },
                                            {
                                                "example_id": "adc00d69-ec6b-4237-bbb0-aa0791ace541",
                                                "sense_id": "aaee2106-0434-3f6c-82b1-65cc3a44ecc1",
                                                "text": "„Der gehorsame Prophet ist ganz Werkzeug seines Gottes. Nicht er selbst ist von Interesse, sondern die Botschaft und ihre Wirkung.“"
                                            },
                                            {
                                                "example_id": "db8d51a1-c304-4b28-bafe-3d75991adc7a",
                                                "sense_id": "aaee2106-0434-3f6c-82b1-65cc3a44ecc1",
                                                "text": "„Schon zweihundert Jahre vor Christi Geburt hatten andere Propheten verkündet, der versprochene Messias werde der Erlöser der ganzen Welt sein.“"
                                            },
                                            {
                                                "example_id": "b223959c-dd4f-4ed7-8a79-88ef0dcd6eb5",
                                                "sense_id": "aaee2106-0434-3f6c-82b1-65cc3a44ecc1",
                                                "text": "„Welch ein Prophet war der Barbesitzer im Nebenberuf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e3ef6cc-14ca-4889-994d-02fa0f5b322e",
                        "source_entry_id": "3cce175e-3a5a-3aea-a3d8-e7d1d229ddfe",
                        "source_sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                        "source_sense_description": "een persoon die boodschappen van een godheid aan de mensen doorgeeft",
                        "target_lang_word": "prophet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prophet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d7824f3-69ca-3bbe-8b06-b876617fcad8",
                                        "entry_id": "7574912d-b5ad-3df6-a55e-cefd58d88265",
                                        "glosses": [
                                            "Someone who speaks by divine inspiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5576c74-45a9-4041-ba62-d50bc52d5353",
                                                "sense_id": "5d7824f3-69ca-3bbe-8b06-b876617fcad8",
                                                "text": "Muslims believe that Muhammad was the final prophet sent to mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab2b13a-dbf5-3dea-bae4-91c1c21b258b",
                                        "entry_id": "7574912d-b5ad-3df6-a55e-cefd58d88265",
                                        "glosses": [
                                            "Someone who predicts the future; a soothsayer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cbe5cde-3692-431e-a1fe-7be9b6d93e62",
                        "source_entry_id": "3cce175e-3a5a-3aea-a3d8-e7d1d229ddfe",
                        "source_sense_id": "5dbfdb9b-4e8a-308e-b6ff-3a1297cb56e4",
                        "source_sense_description": "een persoon die boodschappen van een godheid aan de mensen doorgeeft",
                        "target_lang_word": "prophète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prophète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                        "entry_id": "c9c436d9-f9fc-3615-b07e-5ed617c3aa77",
                                        "glosses": [
                                            "Personnage qui, par inspiration divine, prédit l’avenir, ou révèle aux hommes une vérité importante."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "517f93c3-e58d-42e9-9b3d-09365b349b17",
                                                "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                                "text": "Les deux voies naturelles pour entrer au cabinet des Dieux et y prévoir le cours des destinées sont la fureur et le sommeil. Ceci est plaisant à considérer : par la dislocation que les passions apportent à notre raison, nous devenons vertueux; par son extirpation que la fureur ou l’image de la mort apporte, nous devenons prophètes et divins."
                                            },
                                            {
                                                "example_id": "2b82f3d4-e649-417d-b254-4bf1820a82e5",
                                                "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                                "text": "Nous sommes obligés logiquement parlant, de considérer Nostradamus comme un excellent prophète, puisque tous les événements prédits dans ses Centuries se sont aussi parfaitement réalisés."
                                            },
                                            {
                                                "example_id": "43387d65-80e0-4ffb-ae09-31e879bb7b48",
                                                "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                                "text": "Un autre prophète, nommé Mathieu Mazel, de Soudorgues, et peut-être parent d'Abraham, tint une assemblée nocturne sur la montagne de l'Irou, près de Saumane."
                                            },
                                            {
                                                "example_id": "4aae378c-f45b-426c-a471-7cffd3ef5041",
                                                "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                                "text": "La Moussotte ne se connaissait plus; elle en oublia de se peigner, cassa de la vaisselle et se répandit par tout le village en imprécations dont l’énergie ne cédait en rien à celle des prophètes de la Bible."
                                            },
                                            {
                                                "example_id": "39e0b5d5-6142-48ee-bf0d-aab66c5d1629",
                                                "sense_id": "eca1f52e-df3d-3dce-844e-4f81c20dea15",
                                                "text": "Nous ne savons rien du prophète lui-même, sinon le contenu et les circonstances concrètes de son intervention dans la vie de son peuple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3a4085b-02f8-3ae8-bc99-41bda0c82ed8",
                                        "entry_id": "c9c436d9-f9fc-3615-b07e-5ed617c3aa77",
                                        "glosses": [
                                            "Celui qui, par conjecture ou par hasard, annonce ce qui doit arriver."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346dbb9a-bf50-43fd-9465-96da2f124ed5",
                                                "sense_id": "e3a4085b-02f8-3ae8-bc99-41bda0c82ed8",
                                                "text": "Les araignées, les araignées sont les véritables prophètes de la nature, les véritables aiguilles de l’horloge atmosphérique."
                                            },
                                            {
                                                "example_id": "5e6c7417-0108-4cb7-8f9a-1662a6f9850d",
                                                "sense_id": "e3a4085b-02f8-3ae8-bc99-41bda0c82ed8",
                                                "text": "Le monde musulman est un grand corps malade qui fait quelques progrès, mais je ne suis pas prophète, on ne sait pas dans quelle direction ça va basculer."
                                            },
                                            {
                                                "example_id": "ff1d3093-ee2e-44cf-ac56-a6b898afd20a",
                                                "sense_id": "e3a4085b-02f8-3ae8-bc99-41bda0c82ed8",
                                                "text": "C’est un bon métier que celui de prophète, mais à la condition d’y éviter les trop grosses bourdes et de ne pas montrer aux simples mortels combien est peu sensible parfois l’écart entre une prédiction et une bévue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
