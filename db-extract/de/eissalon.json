                ],
                "senses": [
                    {
                        "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                        "entry_id": "af6aa839-5872-30b3-8dad-46ed120e063f",
                        "glosses": [
                            "Lokal zum sitzenden Verzehr von Speiseeis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "396810e8-337a-4747-8272-ffe56aa58f2b",
                                "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                                "text": "„Ein Eissalon in Berlin am angesagten Kollwitzplatz zum Beispiel, der als einer der besten der Hauptstadt gilt, wirbt mit sage und schreibe 75 verschiedenen Sorten Eis, die dort im Laufe des Jahres verkauft werden.“"
                            },
                            {
                                "example_id": "e4656df3-b090-4fa8-991c-87b2f9f5bdd2",
                                "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                                "text": "„Die fachliche Qualifikation zum Antritt eines Gastgewerbes in der Betriebsart einer Kaffeekonditorei oder eines Eissalons ist weiters durch das Zeugnis über die erfolgreich abgelegte Meisterprüfung im Handwerk der Konditoren (Zuckerbäcker) einschließlich der Lebzelter und der Konditen-, Gefrorenes- und Schokoladewarenerzeugung (§ 94 Z 40 GewO 1994) als erfüllt anzusehen.“"
                            },
                            {
                                "example_id": "080e1fc3-25e5-4998-8ec8-658c45805cb0",
                                "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                                "text": "„Natürlich sperrt noch immer der Großteil der Eissalons im Winter zu.“"
                            },
                            {
                                "example_id": "c2ba465a-e25c-4794-a787-e746e00327aa",
                                "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                                "text": "„Am Platzl herrscht kulinarisch Münchens Promi-Koch Alfons Schuhbeck - gleich neben seinem Orlando-Bistro lockt die süße Sünde im Eissalon.“"
                            },
                            {
                                "example_id": "83558c02-7ddc-4412-a438-17dae2cedc72",
                                "sense_id": "8a9c48c1-a157-3299-9293-b80844018ef0",
                                "text": "„Nachdem [Kurt Tichy] 1950 die Meisterprüfung als Zuckerbäcker abgelegt hatte, eröffnete er 1952 in Simmering einen Eissalon, den er 1955 auf den Reumannplatz verlegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
