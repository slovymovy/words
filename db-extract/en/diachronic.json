    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1b421445-a079-3da4-8435-966865af0029",
                "word": "diachronic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "33c2a9c2-7b31-4226-bb1c-71fcc6f8ca48",
                        "entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more diachronic"
                    },
                    {
                        "form_id": "afc8ac22-07f4-40bd-b28e-3bc7a6cecdd7",
                        "entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most diachronic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78b51a8c-0bcd-35a9-812e-ae3e160417ed",
                        "entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "glosses": [
                            "Occurring over or changing with time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5573b4d4-93f1-41d2-9a47-99b52bef2255",
                                "sense_id": "78b51a8c-0bcd-35a9-812e-ae3e160417ed",
                                "text": "[…] one salient value of archival magazine preservation is that individual issues register, however unintentionally, the small, incremental, diachronic movements within a culture."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                        "entry_id": "1b421445-a079-3da4-8435-966865af0029",
                        "glosses": [
                            "Of, pertaining to or concerned with changes that occur over time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418da6e3-0735-4b84-ae46-c08afbe6597f",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "It is plain that natural science has developed more diachronic concern, more of the longer historical approach in its interests and repertory, in the last two centuries than in the two millennia before."
                            },
                            {
                                "example_id": "440a03b1-578e-4312-b79f-e66673ee9edb",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "I also take a more diachronic perspective and relate the growth of empire to changes in the regional market system as they occurred in the transition from the Early Aztec to the Late Aztec periods."
                            },
                            {
                                "example_id": "34646f6a-da72-4429-b1d8-269eff9c5159",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "In short, it's usual for the syuzhet to appear more diachronic at the beginning and more synchronic at the end."
                            },
                            {
                                "example_id": "1a0fae91-9ff9-409a-a7cb-809de471fa1b",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "Rethinking the revolution issue is therefore the key to any novel interpretation, but it needs to be addressed in a more diachronic and synchronic fashion, comparing the Wende to earlier German upheavals and to the concurrent transformation of East Central Europe."
                            },
                            {
                                "example_id": "1f2d29a0-093c-4641-a35b-c355077deb86",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "2012, Paolo Ramat, Sturtevant's paradox revisited, Thomas Stolz, Hitomi Otsuka, Aina Urdze, Johan van der Auwera (editors), Irregularity in Morphology (and Beyond), [page 61],\nConsequently, the perspective will be more diachronic than synchronic."
                            },
                            {
                                "example_id": "631be6b3-503e-4ed9-a6bb-251c920d104a",
                                "sense_id": "1c7f8d75-26c1-3d30-bacd-b02f450a0c1f",
                                "text": "However, his interpretation and conclusion receive their rationale almost as often from the subjective horizon as the more diachronic oriented commentaries do."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
