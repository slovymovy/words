                                        "glosses": [
                                            "Sucre formé par deux oses (sucres simples non-hydrolysable)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f04b4a-833e-4cad-beee-9f1dda96be5d",
                                                "sense_id": "a04b31e3-212a-349d-94e8-ecf51a2ad7ce",
                                                "text": "Les diholosides de ce type, dont font partie le tréhalose, l’isotréhalose et le saccharose, sont parfois appelés « sucres tréhalosiques »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75b300a9-5cb1-4212-b177-1ef2d132176c",
                        "source_entry_id": "d7b6602e-9c3c-3a0c-8dd3-6505f4ecfeeb",
                        "source_sense_id": "f33f110f-4cd0-31a2-b16b-7f992f4c8820",
                        "source_sense_description": "a sugar consisting of two monosaccharides",
                        "target_lang_word": "Disaccharid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
