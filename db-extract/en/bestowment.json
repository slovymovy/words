                                        "entry_id": "9c5bc9c7-9ce5-3552-8d61-8885c8ce8417",
                                        "glosses": [
                                            "Übertragung des Eigentums an einer Sache ohne Erwartung einer Gegenleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0ba06d-33c9-40e6-a06a-7fbeed84b19e",
                                                "sense_id": "95f38632-e0ff-3dc7-b7a9-8b8a936a1893",
                                                "text": "Das Auto war ein Geschenk meiner Eltern."
                                            },
                                            {
                                                "example_id": "33d047e1-5d18-48df-a224-6b6b0b465ed1",
                                                "sense_id": "95f38632-e0ff-3dc7-b7a9-8b8a936a1893",
                                                "text": "„Simen Tjing schickte Yüä-an mit den Geschenken hin und nahm dann mit Tschen Djing-dji das Essen ein.“"
                                            },
                                            {
                                                "example_id": "e853616f-d40d-4e78-ab32-7a505ed8ccca",
                                                "sense_id": "95f38632-e0ff-3dc7-b7a9-8b8a936a1893",
                                                "text": "„Donald Trump ist käuflich. Er verdient an der eigenen Kryptowährung und nimmt Geschenke aus Katar an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e669905d-3a50-30dc-824a-e18f8be2bd1b",
                                        "entry_id": "9c5bc9c7-9ce5-3552-8d61-8885c8ce8417",
                                        "glosses": [
                                            "die in Form eines Geschenkes^([1]) überlassene Sache (oft liebevoll verpackt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0451d1-3881-4ecd-97fe-9f7a52fee334",
                                                "sense_id": "e669905d-3a50-30dc-824a-e18f8be2bd1b",
                                                "text": "Er überreichte mir ein Geschenk mit einer roten Schleife."
                                            },
                                            {
                                                "example_id": "3227d08f-5f15-4c6f-a71f-91a5fa087c2c",
                                                "sense_id": "e669905d-3a50-30dc-824a-e18f8be2bd1b",
                                                "text": "„Das schönste Geschenk aber hatten Hanna und Paul für mich.“"
                                            },
                                            {
                                                "example_id": "b6d6df16-7969-4a02-8c1c-dd58b6220b89",
                                                "sense_id": "e669905d-3a50-30dc-824a-e18f8be2bd1b",
                                                "text": "„Die Belowa bewunderte die Geschenke und war von ihrem Kleiderstoff ganz hingerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
