                                        "entry_id": "8b5e9606-0c6c-36a6-8aec-5ab2b9f248a9",
                                        "glosses": [
                                            "grande pietra, pietrone monumentale eretto da popolazioni preistoriche per motivi religiosi"
                                        ],
                                        "tags": [],
