                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8dd42828-091c-3239-8470-4f806d46e512",
                        "entry_id": "65c02559-ac82-3a7b-a71a-5eda77f0fd2d",
                        "glosses": [
                            "Grundriss"
                        ],
                        "tags": [],
