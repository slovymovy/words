                "forms": [
                    {
                        "form_id": "b66b995f-5fa6-4dae-9d93-ceed2a774bf9",
                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "tags": [
                            "plural"
                        ],
                        "form": "gazomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "glosses": [
                            "Appareil servant à emmagasiner le gaz et à lui donner, pendant la consommation, une pression constante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff8afc5-ed10-4cb5-b054-76589e27b5a8",
                                "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                                "text": "Le gazomètre de cette usine à gaz."
                            }
                        ]
                    },
                    {
                        "sense_id": "7faa2540-8c82-311d-86cc-df85cb7b0241",
                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "glosses": [
                            "Ce même appareil qui donne aussi la mesure du gaz dépensé."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "glosses": [
                            "Grand réservoir contenant le gaz à distribuer."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "a42d3ac1-9d02-4c00-817a-b639ec765f67",
                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                "text": "Ces tanks, situés contre la digue, au sud […] de la borne 15, sont deux immenses réservoirs à pétrole en forme de gazomètres, déjà troués comme des écumoires, […]."
                            },
                            {
                                "example_id": "45e8d1fd-89c8-41a1-81c6-1caec06b7573",
                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                "text": "Il contemplait la vaste usine à gaz de Bun Hill. Au-dessus des gazomètres pressés les uns contre les autres, trois formes étranges apparurent, […] des ballons que l’on gonflait pour les ascensions hebdomadaires de l’Aéro-Club."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce30cf37-6c65-420a-838d-4b9d197d7a7c",
                        "source_entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "source_sense_description": "Appareil de mesure",
                        "target_lang_word": "gasmeter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gasmeter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "177b6eef-a73c-3a56-8ce6-f02d4cd54b11",
                                        "entry_id": "a2245374-f0b2-3212-97a3-75b07f4d38e6",
                                        "glosses": [
                                            "een meetinstrument dat meet hoeveel je gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a98c3f-728a-4b78-bea3-b5797115ff7f",
                                                "sense_id": "177b6eef-a73c-3a56-8ce6-f02d4cd54b11",
                                                "text": "Geld, macht en historische wrevel speelden Moskou en Kiev parten en voor het eerst in de geschiedenis werd de gaskraan twee weken lang dichtgedraaid. Europa wist niks beters te doen dan waarnemers naar de meetstations aan de Russisch-Oekraïense grens te sturen die inderdaad concludeerden dat de gasmeters op nul bleven staan."
                                            },
                                            {
                                                "example_id": "a30f28f4-dd02-446e-ad02-092331ad28a5",
                                                "sense_id": "177b6eef-a73c-3a56-8ce6-f02d4cd54b11",
                                                "text": "Zonnehof - de naam van de stolpboerderij in Enge Wormer is toepasselijk. Want eigenlijk is het een kleine energiecentrale. Eigenaar Dick Beets: 'Wat betreft elektriciteit en verwarming zijn we al klimaatneutraal. Nu wil ik alleen de gasmeter nog op 0 krijgen.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebb2c5b5-0937-423f-9b8f-f08eed28a6ff",
                        "source_entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "source_sense_description": "Grand réservoir",
                        "target_lang_word": "Gasbehälter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "becd11f1-3d83-4503-8712-552b87cd60f2",
                        "source_entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "source_sense_description": "Grand réservoir",
                        "target_lang_word": "Gasometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gasometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                        "entry_id": "2ffc7197-12df-3be6-a091-5c38a604c2e6",
                                        "glosses": [
                                            "großer Behälter, der zur Lagerung großer Gasmengen bei Normtemperatur und -druck dient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ffd416-1f5b-4d5e-b697-c58b8fd063b6",
                                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                                "text": "Der Gasometer in Oberhausen ist Europas größter Scheibengasbehälter."
                                            },
                                            {
                                                "example_id": "213494ce-0bcb-4aa5-9953-07025184990b",
                                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                                "text": "„Ich hatte das Gefühl, als wäre mein Knie so dick und rund wie ein Gasometer.“"
                                            },
                                            {
                                                "example_id": "1586d788-6343-42b1-aac2-9a0b0f7d9579",
                                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                                "text": "„Drei Runden später in der Haarnadelkurve am Gasometer bekam er Anschluss an ihn und hängte sich wie ein Terrier an seine Hinterräder.“"
                                            },
                                            {
                                                "example_id": "f15e8062-0f42-4b44-853d-bc53350d80e7",
                                                "sense_id": "eca4318d-1279-3268-b22f-0c79207c8833",
                                                "text": "„Der graue Gasometer ist faltig zusammengesackt wie ein riesiger alter Bovist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84b2475b-6612-4e45-8a06-f8c557d54e2d",
                        "source_entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                        "source_sense_description": "Grand réservoir",
                        "target_lang_word": "gasholder",
