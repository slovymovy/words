                                        "glosses": [
                                            "Obtener ventaja en un evento deportivo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58af4af6-20d0-473f-90c4-06fde3d758af",
                                                "sense_id": "a183636a-5496-378c-872d-97f03850526a",
                                                "text": "Debutó con la Selección absoluta el 15 de agosto de 2001 en un partido amistoso ante Grecia en el que ya anotó 20 puntos."
                                            },
                                            {
                                                "example_id": "a7554eca-6688-411c-8d63-d30baafcdd0d",
                                                "sense_id": "a183636a-5496-378c-872d-97f03850526a",
                                                "text": "Anotó 44 puntos, su récord personal hasta ese momento, en la derrota de los Grizzlies ante Seattle el 28 de Marzo de 2006."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a1311ceb-0398-3061-ad98-f5fd4ea844b7",
                                        "entry_id": "6a7f9554-8f97-3419-ae92-2e0a0306041d",
                                        "glosses": [
                                            ". Inscribirse para participar en un evento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d94ccc8-429d-4f28-b544-ec0b154dfd13",
                                                "sense_id": "a1311ceb-0398-3061-ad98-f5fd4ea844b7",
                                                "text": "Después de terminar su entrenamiento de cirujano de vuelo en 1984, se anotó en el Hospital de la Marina en Adak, Alaska como Director de Servicios Médicos."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
