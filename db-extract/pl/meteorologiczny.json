                    {
                        "translation_id": "5a0e1ed1-f584-4040-add7-10d32607c3a8",
                        "source_entry_id": "d1078f54-f955-331e-a2cd-cf40f63b6eb0",
                        "source_sense_id": "f3cf6860-13bf-30c5-b2bb-3a6fe7182c30",
