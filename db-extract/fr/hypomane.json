                        "glosses": [
                            "Atteint par, ou relatif à l’hypomanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7089981-b301-4f5c-a7c6-e54ad5c6cfc7",
                                "sense_id": "c8d59002-2618-3c75-92cf-af0fab06362b",
                                "text": "Une certaine instabilité psycho-motrice peut cependant se manifester jusque vers 6 ou 7 ans, souvent en rapport avec la sensibilité dépressive encore plus ou moins vive, et se trouver qualifiée d’hypomane par certains pour éviter de considérer comme pathologique ce comportement alors dans les variations de la normale."
                            }
                        ]
                    }
