                            {
                                "target_lang_word": "Ксёндз",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Ksiądz",
                                "target_lang_sense_clarification": "Polish surname"
                            }
                        ]
