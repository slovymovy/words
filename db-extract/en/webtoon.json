                ],
                "senses": [
                    {
                        "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                        "entry_id": "bebcec65-6ae2-35f1-afa1-784cc65fb8b2",
                        "glosses": [
                            "An animated cartoon published on the World Wide Web."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "bac8e4a1-b334-486c-a703-ae0d7d3d8b6f",
                                "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                                "text": "Have a webtoon! Elf Life: http://www.elflife.com"
                            },
                            {
                                "example_id": "389a4f3a-0afc-4401-8d59-ff5444fcd3db",
                                "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                                "text": "As Flash Webtoons and animated shorts have become more and more popular, a spate of tools have cropped up to facilitate their creation."
                            },
                            {
                                "example_id": "5a790334-6f89-4acf-9bbb-665c9a98ad14",
                                "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                                "text": "Ren & Stimpy creator John Kricfalusi used Flash animation to bring cartoons (sometimes called online cartoons or webtoons) to the Internet."
                            },
                            {
                                "example_id": "636d1cf3-527d-452e-a601-bc4f3a6f575d",
                                "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                                "text": "More and more cartoons are made using special techniques with a lot of help from computers. Some people are making cartoons for the internet. These are called webtoons. You could make a webtoon, too."
                            },
                            {
                                "example_id": "629e32bb-1b06-422e-9f85-2ba1cc99f454",
                                "sense_id": "998799e0-8e31-38c4-91a7-d173223991ea",
                                "text": "When it comes to Flash animated cartoons, also called webtoons, the first noted use was in 1999 when Ren & Stimpy creator John Kricfalusi set out to bring cartoons to the Web. Soon after, webtoons began popping up everywhere."
                            }
                        ]
                    },
                    {
                        "sense_id": "31ebab23-8fe9-3011-8d66-4c700f3d07c6",
                        "entry_id": "bebcec65-6ae2-35f1-afa1-784cc65fb8b2",
                        "glosses": [
                            "A kind of Korean comic that is published digitally for reading on a smartphone or computer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb0115b-2cab-4081-b86e-295b3efb255d",
                                "sense_id": "31ebab23-8fe9-3011-8d66-4c700f3d07c6",
                                "text": "We can read a webtoon using an application on our phone."
                            },
                            {
                                "example_id": "4c786ddc-1e8d-4df3-8c59-43744edea678",
                                "sense_id": "31ebab23-8fe9-3011-8d66-4c700f3d07c6",
                                "text": "Now producing a branded webtoon and adding a webtoon platform to a company's overall promotional branding strategy makes it look in-step with the times and popular culture."
                            },
                            {
                                "example_id": "189dd64d-1c5b-48d7-852b-a989f34411be",
                                "sense_id": "31ebab23-8fe9-3011-8d66-4c700f3d07c6",
                                "text": "Easy access is another positive trait of webtoons—facile because of the elimination of distribution hassles, […]"
                            }
                        ]
                    }
                ],
