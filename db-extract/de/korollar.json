                "senses": [
                    {
                        "sense_id": "265882a0-cb88-3a35-98fb-a7fa229b2777",
                        "entry_id": "a61ecbdd-30e4-3ff6-971d-33aaa0ed8c61",
                        "glosses": [
                            "Sammlung von Feststellungen oder Folgerungen, die sich aus einem Satz oder einer Definition ohne großen Aufwand ergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182254ea-3a0f-4146-9a43-9f57f537ec6b",
                                "sense_id": "265882a0-cb88-3a35-98fb-a7fa229b2777",
                                "text": "Als direkte Folgerung aus dem Satz von Leibniz erhält man das Korollar A, B, C und D."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2b9e6b1-195e-4d7b-8458-05e8d5e22f03",
                        "source_entry_id": "a61ecbdd-30e4-3ff6-971d-33aaa0ed8c61",
                        "source_sense_id": "265882a0-cb88-3a35-98fb-a7fa229b2777",
                        "target_lang_word": "corollary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corollary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80ca4c3a-7834-3a30-9b6c-cf6bdad240a8",
                                        "entry_id": "bc9d4c36-65f1-3970-9143-381786edf4e2",
                                        "glosses": [
                                            "A gift beyond what is actually due; an addition or superfluity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75db5749-42f5-3843-94f4-9463a0958afc",
                                        "entry_id": "bc9d4c36-65f1-3970-9143-381786edf4e2",
                                        "glosses": [
                                            "An a fortiori occurrence, as a result of another effort without significant additional effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4576f8-85ad-4aff-8d05-b3a0ed32c149",
                                                "sense_id": "75db5749-42f5-3843-94f4-9463a0958afc",
                                                "text": "Finally getting that cracked window fixed was a nice corollary of redoing the whole storefront."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0eaef49-16f0-3027-bc6c-9523ff0f5852",
                                        "entry_id": "bc9d4c36-65f1-3970-9143-381786edf4e2",
                                        "glosses": [
                                            "A proposition which follows easily from the statement or proof of another proposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55601f6-549a-41bf-b925-e61114e13bed",
                                                "sense_id": "e0eaef49-16f0-3027-bc6c-9523ff0f5852",
                                                "text": "We have proven that this set is finite and well ordered; as a corollary, we now know that there is an order-preserving map from it to the natural numbers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corollary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dae3932-e84f-31a8-a04e-33db114cb22c",
                                        "entry_id": "a6afcdb4-528c-3a87-9f7c-176c48b08c45",
                                        "glosses": [
                                            "Occurring as a natural consequence or result; attendant; consequential."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc6b5dd-538c-4071-844c-b74e4c54d322",
                                                "sense_id": "0dae3932-e84f-31a8-a04e-33db114cb22c",
                                                "text": "However, given current sensibilities about individual privacy and data protection, the recording of oral data is becoming increasingly onerous for researchers who are obliged to navigate an often time-consuming and complex series of administrative requirements and corollary review processes in order to be granted ethics clearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dceffec7-3a44-3617-b000-0dea5399bbdd",
                                        "entry_id": "a6afcdb4-528c-3a87-9f7c-176c48b08c45",
                                        "glosses": [
                                            "Forming a proposition that follows from one already proved."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44e97218-8633-4019-887e-33a0fca1a623",
                        "source_entry_id": "a61ecbdd-30e4-3ff6-971d-33aaa0ed8c61",
                        "source_sense_id": "265882a0-cb88-3a35-98fb-a7fa229b2777",
                        "target_lang_word": "corollaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corollaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1afb95-a4a7-3e88-985d-02b5b2f4455f",
                                        "entry_id": "91f97af7-3fca-369a-9475-a2ecf402104d",
                                        "glosses": [
                                            "Énoncé directement déduit d'un autre déjà prouvé ou admis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ab385d-5134-470e-a3b5-6305065f7676",
                                                "sense_id": "3d1afb95-a4a7-3e88-985d-02b5b2f4455f",
                                                "text": "Le théorème d’Al-Kashi a pour corollaire le théorème de Pythagore."
                                            },
                                            {
                                                "example_id": "b6c57d9c-1574-4cdd-af56-5ef35dddc505",
                                                "sense_id": "3d1afb95-a4a7-3e88-985d-02b5b2f4455f",
                                                "text": "Le théorème 1 peut donc être vu comme un corollaire du théorème 2.",
                                                "translation": "Éric Delaygue, Propriétés arithmétiques des applications miroir, Institut Fourier, 2011, page 14"
                                            },
                                            {
                                                "example_id": "846e4a7f-cbf7-48bd-afc6-3811565e97d8",
                                                "sense_id": "3d1afb95-a4a7-3e88-985d-02b5b2f4455f",
                                                "text": "Corollaire de la conjecture de Mogridge (1990), selon laquelle le développement de la voirie en milieu urbain ne réduit pas la congestion, la régulation de la mobilité par la congestion est avancée par les économistes.",
                                                "translation": "Iragael Joly, L’allocation au temps de transport, Université Lumière Lyon 2, 2005"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4e97eb-e9e8-3811-bdf1-6c493d6c351f",
                                        "entry_id": "91f97af7-3fca-369a-9475-a2ecf402104d",
                                        "glosses": [
                                            "Conséquence naturelle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745d8815-41a8-4784-bd2b-820b8a15dfb4",
                                                "sense_id": "7d4e97eb-e9e8-3811-bdf1-6c493d6c351f",
                                                "text": "Cette dernière disposition a pour corollaire une autre mesure interdisant aux copistes de prendre des libertés avec les manuscrits."
                                            },
                                            {
                                                "example_id": "b83aa7ff-3473-4be2-90b5-51d1b90436d9",
                                                "sense_id": "7d4e97eb-e9e8-3811-bdf1-6c493d6c351f",
                                                "text": "La télévision élevée à la dignité de récompense... et, par corollaire, la lecture ravalée au rang de corvée... c’est de nous, cette trouvaille..."
                                            },
                                            {
                                                "example_id": "8169f692-25e2-49a4-b433-0e852bcb981c",
                                                "sense_id": "7d4e97eb-e9e8-3811-bdf1-6c493d6c351f",
                                                "text": "Le rap s’africanise, se « maghrébise », s’islamise en s’enferrant dans une contradiction existentielle : faire disparaître la réalité qui constitue le corollaire de son identité."
                                            },
                                            {
                                                "example_id": "65593557-34c0-48bb-a61f-ad9b34614325",
                                                "sense_id": "7d4e97eb-e9e8-3811-bdf1-6c493d6c351f",
                                                "text": "Le libre échange implique comme corollaire un affrontement économique acharné entre les pays, les entreprises et les populations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corollaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                                        "entry_id": "1b7fe039-0304-3828-81f7-63c6ca8a04af",
                                        "glosses": [
                                            "Qui est la suite logique et directe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0601c900-8669-4be4-8789-90731ca3bfa8",
                                                "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                                                "text": "Les problèmes corollaires à ta solution sont difficiles à résoudre."
                                            },
                                            {
                                                "example_id": "52d8a8e1-676d-443f-920d-c6ec6b89e6c9",
                                                "sense_id": "59a6c110-e9fd-3b1e-b4e9-af271d917460",
                                                "text": "L’obsession du voyage, pour un cœur jeune, est presque toujours corollaire de celle de l’amour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
