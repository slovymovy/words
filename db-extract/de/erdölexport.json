                "senses": [
                    {
                        "sense_id": "9d552d90-b0a0-3e1a-a53f-d60c459f1ea5",
                        "entry_id": "3c7bfa28-7b3d-30a2-8140-37ae6602ffaa",
                        "glosses": [
                            "Export von Erdöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220172b1-c0a1-45e8-8b94-a86e33c7ce39",
                                "sense_id": "9d552d90-b0a0-3e1a-a53f-d60c459f1ea5",
                                "text": "„Die Haupteinnahmequellen Ägyptens sind der Erlös aus dem Erdölexport und der Benutzung des Sueskanals sowie die Gastarbeiterüberweisungen und der Tourismus.“"
                            },
                            {
                                "example_id": "e0d525be-fe6f-4f3b-9436-7392a6b38a29",
                                "sense_id": "9d552d90-b0a0-3e1a-a53f-d60c459f1ea5",
                                "text": "„Die venezolanische Wirtschaft, die fast vollständig vom Erdölexport abhängig ist, befindet sich derzeit in einer schweren Krise, geprägt von Hyperinflation, Versorgungsengpässen und Hungersnöten.“"
                            },
                            {
                                "example_id": "d22d0fee-7007-4917-a26f-4cea4999a2d2",
                                "sense_id": "9d552d90-b0a0-3e1a-a53f-d60c459f1ea5",
                                "text": "„Der Osten des Sudan, der hauptsächlich von den Ethnien der Bedscha und Rashaida bewohnt wird, ist eine arme und unterentwickelte Region, deren Bewohner kaum von den dortigen Bodenschätzen oder von den Einnahmen aus dem Erdölexport profitieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
