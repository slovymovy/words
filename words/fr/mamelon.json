                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bébé tète le <w>mamelon</w> avec force pendant l'allaitement maternel."
                        },
                        {
                            "text": "Elle a appliqué une crème apaisante pour soulager une douleur persistante au <w>mamelon</w>."
                        }
                    ],
                    "synonyms": [
                        "tétin",
                        "téton"
                    ],
                    "common_phrases": [
