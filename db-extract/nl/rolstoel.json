                "senses": [
                    {
                        "sense_id": "994147c4-98dd-39bf-b887-c85223367bcd",
                        "entry_id": "984e42a1-50e8-3bdd-a9d2-27fcb5d22619",
                        "glosses": [
                            "vervoermiddel voor mensen die slecht ter been zijn"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9279a780-5ff8-4596-89be-56c1172f6eb1",
                        "source_entry_id": "984e42a1-50e8-3bdd-a9d2-27fcb5d22619",
                        "source_sense_id": "994147c4-98dd-39bf-b887-c85223367bcd",
                        "source_sense_description": "vervoermiddel voor mensen die slecht ter been zijn",
                        "target_lang_word": "Rollstuhl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rollstuhl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                        "entry_id": "a0cbd875-9acd-3889-b833-8375b303a3eb",
                                        "glosses": [
                                            "Fahrzeug für Menschen, die aufgrund körperlicher Behinderung oder Verletzung nicht oder nur schlecht gehen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f5d936-b723-4b6b-ba9c-dcdc6d1bbca3",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "Der Rollstuhl ermöglicht es diesen Menschen, weiterhin mobil zu sein."
                                            },
                                            {
                                                "example_id": "a88abeae-194d-42d1-81a0-f5ce1c2f7031",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "Menschen, die im Rollstuhl sitzen, haben Schwierigkeiten, zu hohe Bordsteinkanten hinaufzufahren."
                                            },
                                            {
                                                "example_id": "ed7b356d-73b8-468e-a70c-cdf9e0920224",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "„Einäugige und Einarmige schieben in kleinen Korbwagen mit Wachstuchdecken die Schwerverletzten, die nur noch im Rollstuhl leben können.“"
                                            },
                                            {
                                                "example_id": "e15e983d-68a8-4a94-9d8b-61ca530026c0",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "„Für seinen Rollstuhl wurde eine schiefe Ebene auf die Treppen gelegt.“"
                                            },
                                            {
                                                "example_id": "f8f11ac7-e396-44a9-ac54-1632e175cb39",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "„Was ich nicht sah, aber sie sahen, war, dass für mich unsichtbar eine Zuhörerin in einem Rollstuhl meinen Gesang über sich ergehen lassen musste.“"
                                            },
                                            {
                                                "example_id": "d9379c7a-f86f-43a2-9f9d-4b2de11eaa00",
                                                "sense_id": "e41cad50-8a97-3f97-834b-710f1630645a",
                                                "text": "„Nicht gehfähige Kranke waren von Pflegern und Schwestern in Rollstühlen an die Tische geschoben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed53a040-cbba-4c9c-906f-9f619f8e2c8a",
                        "source_entry_id": "984e42a1-50e8-3bdd-a9d2-27fcb5d22619",
                        "source_sense_id": "994147c4-98dd-39bf-b887-c85223367bcd",
                        "source_sense_description": "vervoermiddel voor mensen die slecht ter been zijn",
                        "target_lang_word": "wheelchair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wheelchair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c28976d1-d1ce-3b91-8e94-af71f5ab5a52",
                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "A chair mounted on large wheels for the transportation or use of a sick or disabled person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "048d3b61-440d-4c80-ae8a-6eb679b132eb",
                                                "sense_id": "c28976d1-d1ce-3b91-8e94-af71f5ab5a52",
                                                "text": "\"And there are aspirations that we must rightly meet - people travelling in a wheelchair should be able to get on and off the train.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ee9d483-f3ea-394b-93f6-c879717ebcf7",
                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "Designed for use by wheelchairbound people."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f3f0372-900d-3539-bc92-00bdfd12d47d",
                                        "entry_id": "3f4c2577-f9e2-3b5a-b260-7f21efea3a8c",
                                        "glosses": [
                                            "Any device involving wheels designed to assist a non-human animal with locomotion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c034b92-e2bd-46bd-a870-cc825c897ff9",
                                                "sense_id": "9f3f0372-900d-3539-bc92-00bdfd12d47d",
                                                "text": "To build the wheelchair, Dale Ryder attached wheels from a toy plane to an axle that fits over Mrs. T’s shell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wheelchair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                        "entry_id": "22ae845e-28ad-3568-b8b8-22a244767167",
                                        "glosses": [
                                            "to move using a wheelchair"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3ff60d-fb60-4993-8dff-b15b49ea9ba4",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "Almost all of them learned wheelchairing and all learned to manage to eat by themselves."
                                            },
                                            {
                                                "example_id": "e3dc392f-204d-40fd-9d04-a615dac31ddd",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "People who took part walked, jogged, ran, rollerbladed and wheelchaired the five kilometers"
                                            },
                                            {
                                                "example_id": "35c92482-0643-4594-87e3-8dd31e5b693d",
                                                "sense_id": "b7c371cd-1387-382e-a710-e70b0348f04b",
                                                "text": "They strolled, ran, walked and wheelchaired the track."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5535eeb5-873d-45fe-8424-c0572523dd2f",
                        "source_entry_id": "984e42a1-50e8-3bdd-a9d2-27fcb5d22619",
                        "source_sense_id": "994147c4-98dd-39bf-b887-c85223367bcd",
                        "source_sense_description": "vervoermiddel voor mensen die slecht ter been zijn",
                        "target_lang_word": "fauteuil roulant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fauteuil roulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7da063bb-1004-3e27-a7bc-f3f40e71426f",
                                        "entry_id": "fab29fe7-ce8b-3536-b63a-c8076ecf795a",
                                        "glosses": [
                                            "Matériel en forme de fauteuil, destiné au déplacement des personnes à mobilité réduite ou paralysées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a82226af-af39-4e76-9f0e-ea7732a28de9",
                                                "sense_id": "7da063bb-1004-3e27-a7bc-f3f40e71426f",
                                                "text": "Car dans beaucoup de villes françaises, pour se rendre d’un point A à un point B en fauteuil roulant, la route la plus courte est souvent impraticable."
                                            },
                                            {
                                                "example_id": "bdd774c0-e8bf-4692-b473-814e30da3b76",
                                                "sense_id": "7da063bb-1004-3e27-a7bc-f3f40e71426f",
                                                "text": "Pour la deuxième animation, ils se sont déplacés en fauteuil roulant. Ils se sont ainsi rendu compte de la complexité de faire un parcours en évitant des obstacles et la difficulté de circuler à l’intérieur d’un bâtiment."
                                            },
                                            {
                                                "example_id": "6e23c199-7c33-4ddf-9fef-66e878ae3381",
                                                "sense_id": "7da063bb-1004-3e27-a7bc-f3f40e71426f",
                                                "text": "Dreeft est une paire de roues équipées d’un système de freinage par rétropédalage, adaptable à tout fauteuil roulant manuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
