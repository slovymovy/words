                    "sense_definition": "Einen ungeklärten Sachverhalt, ein Verbrechen oder ein Rätsel untersuchen und die Wahrheit darüber herausfinden.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "untersuchen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizei konnte den schwierigen Fall nach wochenlangen Ermittlungen endlich erfolgreich <w>aufklären</w>."
                        },
                        {
                            "text": "Der Journalist möchte die Hintergründe des Skandals vollständig <w>aufklären</w>."
                        }
                    ],
                    "synonyms": [
