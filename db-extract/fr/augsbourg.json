        "fr-extract.jsonl": [
            {
                "entry_id": "ce7eba4b-0819-38cb-be84-51c0ce2605c7",
                "word": "Augsbourg",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0df23285-1be1-3936-83e4-87905b673155",
                        "entry_id": "ce7eba4b-0819-38cb-be84-51c0ce2605c7",
                        "glosses": [
                            "Ville, commune et arrondissement d’Allemagne, située dans le Land de Bavière, chef-lieu du district de Souabe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876024d7-5732-4c83-99a3-fc5ae4a875a4",
                                "sense_id": "0df23285-1be1-3936-83e4-87905b673155",
                                "text": "Après avoir décroché l’or en 2014 et 2021, et l’argent en 2009, le kayakiste français Boris Neveu a complété sa collection de médailles mondiales individuelles en slalom avec le bronze, samedi, sur le bassin d’Augsbourg, dans le sud de l’Allemagne."
                            },
                            {
                                "example_id": "44e84c00-a9ca-43a0-82ef-38b1e89ed469",
                                "sense_id": "0df23285-1be1-3936-83e4-87905b673155",
                                "text": "Les Rennais restaient sur trois victoires face à Caen (2-1), Augsbourg (3-2) et Nantes (1-0)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc994788-87f6-4969-8fd5-a5c2c0b8dc5d",
                        "source_entry_id": "ce7eba4b-0819-38cb-be84-51c0ce2605c7",
                        "source_sense_id": "0df23285-1be1-3936-83e4-87905b673155",
                        "target_lang_word": "Augsburg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augsburg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                        "entry_id": "e43f1d35-f2d2-3f9b-bcec-4f43657e5166",
                                        "glosses": [
                                            "kreisfreie Stadt in Bayern, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd30a33-46bc-441b-8ec4-1f2ef58f1aa2",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "Augsburg ist nach Trier die zweitälteste Stadt Deutschlands."
                                            },
                                            {
                                                "example_id": "c1980a1f-fadf-499c-addc-cb3b36f6e68b",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "Ich bin in Augsburg geboren."
                                            },
                                            {
                                                "example_id": "79a3f016-63bb-4382-a230-a60fe3411c00",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "Ich habe in Augsburg meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "432296ff-4c11-4269-a129-b38e39fa42fc",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "Nach Augsburg führen viele Wege."
                                            },
                                            {
                                                "example_id": "5176f010-9542-4f05-8576-27cbda9f51c8",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "„Mit der Belagerung verschärfte sich in Augsburg die bereits bestehende Nahrungsmittelknappheit drastisch weiter.“"
                                            },
                                            {
                                                "example_id": "dce8b266-7f29-45c3-8716-eb336fcde54a",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "„Nun fand ich sie, reichlich mit allem versehen und auf dem Sprung, nach Augsburg zu fahren; so malte ich mir im voraus die Freuden aus, die mir ein derartiges Zusammentreffen verschaffen würde.“"
                                            },
                                            {
                                                "example_id": "8a157615-8fbb-44ad-ba86-bece95c1ccb9",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "„Deutsche Städte wie Mainz, Frankfurt, Augsburg und Nürnberg waren Vorreiter des Buchdrucks.“"
                                            },
                                            {
                                                "example_id": "dab42fbf-345d-4c3d-9598-2affc7172d1c",
                                                "sense_id": "346d9dbc-c208-3c59-be4f-b7c2fd10cb6f",
                                                "text": "„Die deutsche Partnerstadt des heutigen Maracaibo ist weder Augsburg noch Nürnberg, sondern Bremen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a32197a2-8b74-3ae7-84cd-c21452eca999",
                                        "entry_id": "e43f1d35-f2d2-3f9b-bcec-4f43657e5166",
                                        "glosses": [
                                            "Namensbestandteil des Landkreises Augsburg, Bayern, D"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
