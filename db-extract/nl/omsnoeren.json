                "senses": [
                    {
                        "sense_id": "e1324421-48c7-30a6-900b-e717c34430e5",
                        "entry_id": "10e92dca-a165-309e-8c39-015a03b3787d",
                        "glosses": [
                            "iets, iemand of zichzelf omspannen met een koord of iets wat daarop lijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d54da9a-3a2b-4883-897c-c2066eccba2e",
                                "sense_id": "e1324421-48c7-30a6-900b-e717c34430e5",
                                "text": "Het is belangrijk dat wij alle balken van het vlot stevig omsnoeren."
                            },
                            {
                                "example_id": "9e32ef0f-52e9-49bf-8f52-295341663db0",
                                "sense_id": "e1324421-48c7-30a6-900b-e717c34430e5",
                                "text": "De riem werd werd strak omgesnoerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2706b45-72d6-3873-8f04-382c5ca86819",
                        "entry_id": "10e92dca-a165-309e-8c39-015a03b3787d",
                        "glosses": [
                            "omspannen worden met een koord of iets wat daarop lijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55cc74e6-48fc-4cc4-bd66-f9e9fe677651",
                                "sense_id": "b2706b45-72d6-3873-8f04-382c5ca86819",
                                "text": "Het touw wordt gebruikt om het middel te omsnoeren."
                            },
                            {
                                "example_id": "fdaa8314-5495-4f58-b1ee-0cf5de21f1bf",
                                "sense_id": "b2706b45-72d6-3873-8f04-382c5ca86819",
                                "text": "\"Het is een blok\", geeft bewoonster Charlotte van Zadelhoff (41) toe. \"Maar het functioneert. Ik vind het mooi. Van buiten zo'n zwart fort en als je binnenkomt zie je al dat wit.\" Ze wijst op de balustrades, witte ringen in de lucht die de binnenplaats omsnoeren. \"Driehonderd mensen wonen hier heel tevreden. Het is toch belachelijk zo'n gebouw te slopen?\" Hoogstens mag de tuin verbeterd worden, vinden de bewoners."
                            }
                        ]
                    }
