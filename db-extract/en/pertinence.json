                        "target_lang_word": "Bedeutsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bedeutsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Eigenschaft, bedeutsam, wichtig, ausschlaggebend zu sein; Wichtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087414e0-12f3-4bb5-a149-274a73ee82fe",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„In der Corona-Pandemie zeigt sich die ungeheure Bedeutsamkeit des Individuums in der modernen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "1840a7c7-73ee-44df-afee-b09a4862b93b",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„Der Glanz und die Farbe stechen hervor und machen die Bedeutsamkeit des Anlasses deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Sinn von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16635d33-8716-462c-b47e-217d1f156cc9",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Ich wollte die tiefe Bedeutsamkeit von allem, was geschehen war, nicht abschwächen, deshalb schaltete ich weder den Fernsehapparat an noch nahm ich ein Buch zur Hand oder zerstreute mich auf irgendeine andere Weise.“"
                                            },
                                            {
                                                "example_id": "7fabda17-9cec-4ffb-8ccc-4f3318bb7158",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Die Idee der Feier war echt künstlerisch aufgefasst und geschmackvoll und glänzend ausgeführt; die musikalische Begleitung, die Dichtung gaben die tiefe Bedeutsamkeit des Festes schön und ansprechend wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f66191f-984e-420f-b7ce-af4fc40a1652",
                        "source_entry_id": "a7de38f1-c522-3035-8484-3c060ad62e01",
