{
    "word_family": [
        "futile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b4b7d79-b30f-3785-a902-b0ed077aa9ab",
                    "sense_definition": "The quality of being useless or having no chance of success.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uselessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team realized the <w>futility</w> of their efforts after the storm destroyed the bridge.",
                            "target_lang_translations": {
                                "ru": "Команда осознала <w>бесполезность</w> своих усилий после того, как шторм разрушил мост."
                            }
                        },
                        {
                            "text": "He finally understood the <w>futility</w> of arguing with someone who refuses to listen.",
                            "target_lang_translations": {
                                "ru": "Он наконец понял <w>тщетность</w> споров с тем, кто отказывается слушать."
                            }
                        }
                    ],
                    "synonyms": [
                        "uselessness",
                        "pointlessness",
                        "ineffectiveness"
                    ],
                    "antonyms": [
                        "usefulness",
                        "effectiveness"
                    ],
                    "common_phrases": [
                        "sense of futility",
                        "sheer futility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество чего-либо бесполезного или не имеющего шансов на успех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесполе́зность",
                                "target_lang_sense_clarification": "отсутствие пользы или смысла в действиях"
                            },
                            {
                                "target_lang_word": "тще́тность",
                                "target_lang_sense_clarification": "безуспешность, напрасность усилий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8431d0a5-d3e5-3069-b078-be2ba74777b7",
                    "sense_definition": "A useless or pointless act or thing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "uselessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was filled with bureaucratic <w>futilities</w> that served no real purpose.",
                            "target_lang_translations": {
                                "ru": "Отчет был полон бюрократических <w>бессмыслиц</w>, которые не имели никакой реальной цели."
                            }
                        },
                        {
                            "text": "They spent the afternoon discussing various <w>futilities</w> instead of addressing the main problem.",
                            "target_lang_translations": {
                                "ru": "Они провели день, обсуждая всякие <w>пустяки</w>, вместо того чтобы заняться главной проблемой."
                            }
                        }
                    ],
                    "synonyms": [
                        "triviality",
                        "nonsense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезное или бессмысленное действие, вещь или занятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмы́слица",
                                "target_lang_sense_clarification": "глупое или нелепое действие"
                            },
                            {
                                "target_lang_word": "пустя́к",
                                "target_lang_sense_clarification": "незначительная, бесполезная вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23418337-56ba-353e-8fa8-18cb44793106",
                    "sense_definition": "The state of being unimportant or lacking substance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unimportance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character was defined by her <w>futility</w> and lack of serious ambition.",
                            "target_lang_translations": {
                                "ru": "Персонаж характеризовался своей <w>ничтожностью</w> и отсутствием серьезных амбиций."
                            }
                        },
                        {
                            "text": "He grew tired of the <w>futility</w> of their social circle and sought more meaningful connections.",
                            "target_lang_translations": {
                                "ru": "Он устал от <w>пустоты</w> их круга общения и искал более значимых связей."
                            }
                        }
                    ],
                    "synonyms": [
                        "insignificance",
                        "triviality"
                    ],
                    "antonyms": [
                        "importance",
                        "significance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние незначительности или отсутствия глубины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничто́жность",
                                "target_lang_sense_clarification": "отсутствие важности или значимости"
                            },
                            {
                                "target_lang_word": "пустота́",
                                "target_lang_sense_clarification": "отсутствие содержания или смысла"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}