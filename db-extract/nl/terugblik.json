                ],
                "translations": [
                    {
                        "translation_id": "f1c6fa80-60d0-4070-82cf-2ee0bf452f54",
                        "source_entry_id": "c1f52bd8-9f6e-35b3-ab4e-dafc30fdde4c",
                        "source_sense_id": "bb16dbb7-518f-37b7-8bbf-cd8a4197fcda",
                        "source_sense_description": "een blik op voorbijgegane zaken",
                        "target_lang_word": "Rückblick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückblick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                        "entry_id": "52c8f276-699e-3f28-be6d-a17d95355ea7",
                                        "glosses": [
                                            "bewusste Erinnerung an Vergangenes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcb3a5e-b6d8-40b1-bd01-1dacb3eed595",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Bescheidenheit lehrt ein kurzer Rückblick auf die reichhaltigen Überlieferungen aus früheren Epochen.“"
                                            },
                                            {
                                                "example_id": "85066508-48d6-4486-aea5-ab88ad1c5984",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Verständlich werden diese Wendungen erst durch den Rückblick auf das 19. Jahrhundert.“"
                                            },
                                            {
                                                "example_id": "9b6aacb6-86b5-4f56-b97e-cced6464caa9",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Das alles denke ich mir im Rückblick auf diese ferne Zeit, und über Spekulationen gelangen meine Gedanken nicht hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b843db62-5bf9-33b0-a59c-78c76fd423d8",
                                        "entry_id": "52c8f276-699e-3f28-be6d-a17d95355ea7",
                                        "glosses": [
                                            "Bericht über etwas Abgeschlossenes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600a7cc8-4153-4617-b5d5-c7d2402a054f",
                                                "sense_id": "b843db62-5bf9-33b0-a59c-78c76fd423d8",
                                                "text": "Auf der Jahreshauptversammlung gab der Vorsitzende einen Rückblick auf die Aktivitäten des Vereins im vergangenen Jahr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69cfcdfc-9fea-4ceb-aac4-b3c03052a7c3",
                        "source_entry_id": "c1f52bd8-9f6e-35b3-ab4e-dafc30fdde4c",
                        "source_sense_id": "bb16dbb7-518f-37b7-8bbf-cd8a4197fcda",
                        "source_sense_description": "een blik op voorbijgegane zaken",
                        "target_lang_word": "retrospect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retrospect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                        "entry_id": "4271d2f2-855b-37a3-99dc-d68a039b71e6",
                                        "glosses": [
                                            "Consideration of past times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100fc49c-d6b1-4d6d-922f-18105c21b2ae",
                                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                                "text": "My mind, calmer and stronger now than last night, made for itself some imperious rules, prohibiting under deadly penalties all weak retrospect of happiness past; commanding a patient journeying through the wilderness of the present..."
                                            },
                                            {
                                                "example_id": "fae6ae5c-1ab4-468e-b474-479fdc350ae5",
                                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                                "text": "Whether, like Colin, in retrospect Willie Lee and Baptist would feel that what has vanished was greater than what was achieved, is not something we can predict."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retrospect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e01e2f-36a6-345d-813d-74171274a4fc",
                                        "entry_id": "b13c9359-96a2-3449-b1c6-060a1b232143",
                                        "glosses": [
                                            "To look or refer back to; to reflect on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4541df6-1dea-4fa5-8d40-68501d32f3e8",
                                                "sense_id": "f2e01e2f-36a6-345d-813d-74171274a4fc",
                                                "text": "To give a correct idea of the circumstances which have gradually produced this conviction, it may be useful to retrospect to an early period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
