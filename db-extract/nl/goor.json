                                                "sense_id": "d33fd25a-31bc-34af-93f9-56804a03ad43",
                                                "text": "A squalid attempt to buy votes."
                                            },
                                            {
                                                "example_id": "e39942c4-c29b-4a6a-aa0e-5a31fce30542",
                                                "sense_id": "d33fd25a-31bc-34af-93f9-56804a03ad43",
                                                "text": "Minister, I hardly think that we can exploit our Sovereign by involving her in some might call a squalid vote-grubbing exercise."
                                            }
                                        ]
