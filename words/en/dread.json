                            {
                                "target_lang_word": "grauenvoll",
                                "target_lang_sense_clarification": "entsetzlich, furchtbar"
                            },
                            {
                                "target_lang_word": "schauderhaft",
                                "target_lang_sense_clarification": "sehr negative Gefühle auslösend"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可怕的",
                                "target_lang_sense_clarification": "令人恐惧的"
                            },
                            {
                                "target_lang_word": "恐怖的",
                                "target_lang_sense_clarification": "极度令人害怕的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9fb4d3-9db6-3f6e-9b42-e32db84251cf",
                    "sense_definition": "Inspiring awe or held in fearful respect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document was addressed to their most high and <w>dread</w> sovereign.",
                            "target_lang_translations": {
                                "ru": "Документ был адресован их высочайшему и <w>грозному</w> государю.",
                                "de": "Das Dokument war an ihren erhabenen und <w>grosen</w> Herrscher adressiert.",
                                "zh": "这份文件是呈给他们至高无上且<w>威严的</w>君主的。"
                            }
                        },
                        {
                            "text": "He stood before the <w>dread</w> tribunal to answer for his crimes.",
                            "target_lang_translations": {
                                "ru": "Он предстал перед <w>грозным</w> трибуналом, чтобы ответить за свои преступления.",
                                "de": "Er stand vor dem <w>grosen</w> Tribunal, um sich für seine Verbrechen zu verantworten.",
                                "zh": "他站在<w>威严的</w>法庭前，为自己的罪行接受审判。"
                            }
                        }
                    ],
                    "synonyms": [
                        "venerable",
                        "awesome"
                    ],
                    "common_phrases": [
                        "dread sovereign"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical or formal titles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внушающий благоговение или вызывающий почтительный страх.",
                        "de": "Ehrfurcht einflößend oder mit respektvoller Angst betrachtet.",
                        "zh": "令人敬畏的或因恐惧而受到尊重的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грозный",
