                    {
                        "sense_id": "09b74ec4-5774-39e4-bbd7-ac14cdce53c2",
                        "entry_id": "e38ee0be-8df5-300e-a9f5-ad508311c472",
                        "glosses": [
                            "A philosophical doctrine espousing that all or some material things possess life, or that all life is inseparable from matter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9bbee4-f1f2-46b6-a5ef-caf593726b35",
                                "sense_id": "09b74ec4-5774-39e4-bbd7-ac14cdce53c2",
                                "text": "[…] is it not melancholy to hear a man like Steffens somniloquise in such a mystifying cant of Hylozoism, of Pickism, a hodge-podge of the grossest materialism, and the most fantastic yet maudlin moonery?"
                            }
                        ]
                    }
                ],
                "translations": [
