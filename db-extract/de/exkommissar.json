                        "examples": [
                            {
                                "example_id": "12c05e02-3c3a-4fb0-a8e2-15247d3eeffa",
                                "sense_id": "5b50cb42-9385-36d3-8555-b720fe0c48f9",
                                "text": "„Umständlich hob Hohenstein den Deckel an und der Exkommissar starrte auf einen in offenbar noch feuchter Erde gebetteten Totenschädel.“"
                            },
                            {
                                "example_id": "0898161c-eb73-409c-b844-63e3f895fcc0",
                                "sense_id": "5b50cb42-9385-36d3-8555-b720fe0c48f9",
                                "text": "„Der Thalkirchner Exkommissar riss die stahlblauen Augen auf.“"
                            },
                            {
                                "example_id": "8d1e09be-950e-4a59-9698-80072b191bbc",
                                "sense_id": "5b50cb42-9385-36d3-8555-b720fe0c48f9",
                                "text": "„Exkommissar Mario Monti warnte in Alpbach vor einer neuen Ära in der EU, in der die Kompromissfähigkeit unter den großen Mitgliedstaaten verloren gehe.“"
                            },
                            {
                                "example_id": "3528e351-1f80-4718-826f-63765dc012ac",
                                "sense_id": "5b50cb42-9385-36d3-8555-b720fe0c48f9",
                                "text": "„Auf die Osteuropa-Tour hätte Pröll auch Exkommissar Franz Fischler, Stabilitätspaktkoordinator Erhard Busek oder den Ostexperten Wolfgang Petritsch schicken können.“"
                            }
                        ],
