    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                "word": "dumbness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "12fffc74-5f5d-4a89-9240-976902c1c0c2",
                        "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "dumbnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76cb9578-9248-3b78-9e6a-4c6efcf3b7b9",
                        "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "glosses": [
                            "The state of being mute: that is, of not communicating vocally, whether from selective mutism (refusal to speak) or from an inability to speak."
                        ],
                        "tags": [
                            "dated",
                            "offensive",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f6f789e2-ef2c-4ad9-a4d4-8f150fcdb8de",
                                "sense_id": "76cb9578-9248-3b78-9e6a-4c6efcf3b7b9",
                                "text": "He was a deaf-mute. His dumbness did not seem to matter when we were boys."
                            }
                        ]
                    },
                    {
                        "sense_id": "94c0bb81-25a4-3ae5-84d9-54a4bf55066d",
                        "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "glosses": [
                            "Muteness, silence; abstention from speech."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b53a161b-2392-4a18-8100-44b399ef9b62",
                                "sense_id": "94c0bb81-25a4-3ae5-84d9-54a4bf55066d",
                                "text": "There was speech in their dumbness."
                            }
                        ]
                    },
                    {
                        "sense_id": "9194db65-929f-3009-bbbd-960e7181042c",
                        "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "glosses": [
                            "Show or gesture without words; pantomime; dumb-show."
                        ],
                        "tags": [
                            "dated",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9d07a4bc-f62d-4f4c-8b7b-a531e8b75408",
                                "sense_id": "9194db65-929f-3009-bbbd-960e7181042c",
                                "text": "To the dumbness of the gesture one might interpret."
                            }
                        ]
                    },
                    {
                        "sense_id": "a807d4b1-8941-3bdf-9b4e-37bded54dc45",
                        "entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "glosses": [
                            "The quality of being stupid or foolish."
                        ],
                        "tags": [
                            "informal",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c45e84b4-22f0-401b-b940-236a49258bfd",
                        "source_entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "source_sense_description": "the state of being mute",
                        "target_lang_word": "Stummheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stummheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                        "entry_id": "ae9b8844-29f0-3768-aec3-b1c1e668a020",
                                        "glosses": [
                                            "Unfähigkeit, sich äußern zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4f01c1-097e-4eb4-8896-0f931999044e",
                                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                                "text": "„An der Stummheit meiner Eltern, an ihrer Sprachlosigkeit hatte ich mitzutragen.“"
                                            },
                                            {
                                                "example_id": "7fc8a987-84cb-4df7-8852-aed346153da4",
                                                "sense_id": "74b8c0e4-dac0-35c9-b9f1-e81ce2f6f0ef",
                                                "text": "„Der Zeichner stand in beredter Stummheit neben ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0ed3746-8070-4eeb-a393-2b95a7a12121",
                        "source_entry_id": "85068260-286a-37d2-8f37-418285c369b5",
                        "source_sense_description": "the state of being mute",
                        "target_lang_word": "Mutitas",
