                        "cross_references": [
                            {
                                "target_word": "devastation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9998da72-adde-3588-82b8-9746144d458b",
                                        "entry_id": "c43d4268-d1f2-35c6-9f1e-37267d016767",
                                        "glosses": [
                                            "The act of devastating, or the state of being devastated; a laying waste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5a10df-50b1-421e-ae69-57f338788b86",
                                                "sense_id": "9998da72-adde-3588-82b8-9746144d458b",
                                                "text": "Perhaps as startling as the sheer toll was the devastation to some of the state’s well-known locales. Boardwalks along the beach in Seaside Heights, Belmar and other towns on the Jersey Shore were blown away. Amusement parks, arcades and restaurants all but vanished. Bridges to barrier islands buckled, preventing residents from even inspecting the damage to their property."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad67de0a-849c-3197-bd47-5dba5a31e134",
                                        "entry_id": "c43d4268-d1f2-35c6-9f1e-37267d016767",
                                        "glosses": [
                                            "Waste or misapplication of the assets of a deceased person by an executor or administrator; devastavit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "553970be-b944-4c45-945e-baef7e1f2743",
                        "source_entry_id": "f02a29e4-bfc3-3c25-af18-af6e12d7687f",
                        "source_sense_id": "cb59a959-d495-309a-8140-1b09c182a62b",
                        "source_sense_description": "vollkommene Zerstörung",
                        "target_lang_word": "ravage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "847d8b48-cf2b-3ba2-a4ce-6beba7b404cd",
                                        "entry_id": "3a8088eb-11b5-3da0-beb7-dec7c1af915f",
                                        "glosses": [
                                            "To devastate, destroy or lay waste to something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78679cc6-5003-469b-81aa-ba13baed2b83",
                                                "sense_id": "847d8b48-cf2b-3ba2-a4ce-6beba7b404cd",
                                                "text": "Already Cæſar\nHas ravaged more than half the Globe, and ſees\nMankind grown thin by his deſtructive Sword:\nShould he go further, Numbers would be wanting\nTo form new Battels, and ſupport his Crimes."
                                            },
                                            {
                                                "example_id": "c5206351-37d9-448f-b023-a1cd748acdca",
                                                "sense_id": "847d8b48-cf2b-3ba2-a4ce-6beba7b404cd",
                                                "text": "But the most important service which Probus rendered to the republic was the deliverance of Gaul, and the recovery of seventy flourishing cities oppressed by the barbarians of Germany, who, since the death of Aurelian, had ravaged that great province with impunity."
                                            },
                                            {
                                                "example_id": "bbfc0ed1-f3f9-4087-941d-38b724fbef31",
                                                "sense_id": "847d8b48-cf2b-3ba2-a4ce-6beba7b404cd",
                                                "text": "Now Azaēlos, the king of Syria, made war on the Israelites and their king Jehu, and ravaged the eastern parts of the country across the Jordan […] spreading fire everywhere and plundering everything and inflicting violence on all who fell into his hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e80ff58f-691c-3f60-a65e-4ebbbf6c2ca9",
                                        "entry_id": "3a8088eb-11b5-3da0-beb7-dec7c1af915f",
                                        "glosses": [
                                            "To pillage or plunder destructively; to sack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b925cbf7-ad73-3296-b1b3-31b8bbc0281f",
                                        "entry_id": "3a8088eb-11b5-3da0-beb7-dec7c1af915f",
                                        "glosses": [
                                            "To wreak destruction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "696d00ba-e4d4-3f37-a9ea-34f0a404b9aa",
                                        "entry_id": "3a8088eb-11b5-3da0-beb7-dec7c1af915f",
                                        "glosses": [
                                            "To have vigorous sexual intercourse with."
                                        ],
