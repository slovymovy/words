                        "source_entry_id": "36a9391a-fce3-374f-9f2f-28f0386cc9b1",
                        "source_sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                        "source_sense_description": "Inselgruppe im Atlantik nahe Nordamerika, britisches Überseegebiet",
