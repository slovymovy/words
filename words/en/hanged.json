{
    "word_family": [
        "hang",
        "hanger",
        "hanging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "400824ca-3390-3ac6-b5c2-cb7377a477bd",
                    "sense_definition": "Simple past and past participle of <w>hang</w> when referring to the method of execution or suspension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was <w>hanged</w> at dawn for his crimes.",
                            "target_lang_translations": {
                                "tr": "Mahkum, işlediği suçlar nedeniyle şafak vakti <w>asıldı</w>."
                            }
                        },
                        {
                            "text": "They <w>hanged</w> the heavy painting on the wall using a strong wire.",
                            "target_lang_translations": {
                                "tr": "Ağır tabloyu güçlü bir tel kullanarak duvara <w>astılar</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hanged by the neck"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini idam etmek için asmak veya bir nesneyi bir yere asmak eyleminin geçmiş zaman hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "asılmak",
                                "target_lang_sense_clarification": "İdam edilmek anlamında."
                            },
                            {
                                "target_lang_word": "asmak",
                                "target_lang_sense_clarification": "Bir nesneyi bir yere tutturmak anlamında."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d9abac5-db09-3f55-a1c0-621682d85a5b",
                    "sense_definition": "Used as an intensifier to express strong annoyance or disbelief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>hanged</w> if I know where he hid the keys.",
                            "target_lang_translations": {
                                "tr": "Anahtarları nereye sakladığını biliyorsam <w>kahrolayım</w>."
                            }
                        },
                        {
                            "text": "I do not care a <w>hanged</w> bit about his opinion.",
                            "target_lang_translations": {
                                "tr": "Onun fikri umurumda bile <w>değil</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "damned",
                        "cursed"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in older literature or informal emphatic speech."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Şaşkınlık, kızgınlık veya inançsızlık belirtmek için kullanılan eski veya gayriresmi bir pekiştirme sözcüğü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "lanet",
                                "target_lang_sense_clarification": "Bir durumu vurgulamak için kullanılan kaba bir ifade."
                            },
                            {
                                "target_lang_word": "kahrolası",
                                "target_lang_sense_clarification": "Hoşnutsuzluk belirtmek için kullanılan bir sıfat."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}