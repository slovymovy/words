    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "619d30d5-b58e-3ec1-9e6e-d8aee1aec0cd",
                    "sense_definition": "Seria następujących po sobie zdarzeń, czynności lub zjawisk; trwanie czegoś w czasie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sequence_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>ciągu</w> ostatniego roku firma znacznie zwiększyła swoje zyski.",
                            "target_lang_translations": {
                                "ru": "В <w>течение</w> последнего года компания значительно увеличила свою прибыль.",
                                "en": "Over the <w>course</w> of the past year, the company significantly increased its profits."
                            }
                        },
                        {
                            "text": "To był nieszczęśliwy <w>ciąg</w> wypadków, które doprowadziły do katastrofy.",
                            "target_lang_translations": {
                                "ru": "Это была несчастливая <w>череда</w> случайностей, которые привели к катастрофе.",
                                "en": "It was an unfortunate <w>series</w> of events that led to the catastrophe."
                            }
                        }
                    ],
                    "synonyms": [
                        "następstwo",
                        "tok",
                        "bieg",
                        "przebieg",
                        "szereg"
                    ],
                    "antonyms": [
                        "przerwa"
                    ],
                    "common_phrases": [
                        "w ciągu",
                        "dalszy ciąg",
                        "ciąg zdarzeń",
                        "ciąg przyczynowo-skutkowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия последовательных событий, действий или явлений; продолжительность чего-либо во времени.",
                        "en": "A series of successive events, actions, or phenomena; the passage or unfolding of something over time."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "череда",
                                "target_lang_sense_clarification": "событий, происшествий"
                            },
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "времени (в выражении \"w ciągu\")"
                            },
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "последовательность событий"
                            },
                            {
                                "target_lang_word": "последовательность",
                                "target_lang_sense_clarification": "общая"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "of events or incidents"
                            },
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "passage of time or progression of events"
                            },
                            {
                                "target_lang_word": "chain",
                                "target_lang_sense_clarification": "succession of occurrences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7448f75-6ab5-3347-9640-603c333b6430",
                    "sense_definition": "Szereg rzeczy, obiektów lub pomieszczeń ustawionych jedno za drugim lub obok siebie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wzdłuż głównej ulicy ciągnie się <w>ciąg</w> luksusowych sklepów.",
                            "target_lang_translations": {
                                "ru": "Вдоль главной улицы тянется <w>ряд</w> роскошных магазинов.",
                                "en": "A <w>row</w> of luxury shops stretches along the main street."
                            }
                        },
                        {
                            "text": "Na piętrze pałacu mieści się <w>ciąg</w> reprezentacyjnych sal przechodzących jedna w drugą.",
                            "target_lang_translations": {
                                "ru": "На втором этаже дворца расположен <w>ряд</w> парадных залов, переходящих один в другой.",
                                "en": "On the first floor of the palace, there is a <w>series</w> of staterooms opening into one another."
                            }
                        }
                    ],
                    "synonyms": [
                        "rząd",
                        "szereg"
                    ],
                    "common_phrases": [
                        "ciąg budynków",
                        "ciąg komunikacyjny",
                        "ciąg pieszy",
                        "ciąg technologiczny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ряд вещей, объектов или помещений, расположенных друг за другом или рядом.",
                        "en": "A continuous line or succession of objects, buildings, or rooms arranged one after another."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "объектов, зданий"
                            },
                            {
                                "target_lang_word": "вереница",
                                "target_lang_sense_clarification": "длинная цепь объектов"
                            },
                            {
                                "target_lang_word": "линия",
                                "target_lang_sense_clarification": "расположение в ряд"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "row",
                                "target_lang_sense_clarification": "line of physical objects or shops"
                            },
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "continuous succession of rooms or elements"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "arrangement of objects side by side"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "023b3727-f5f2-362a-ae73-442c00c1b562",
                    "sense_definition": "Uporządkowany zbiór liczb lub innych elementów, w którym każdy element ma swoje określone miejsce.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence_math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na lekcji matematyki musieliśmy obliczyć sumę wyrazów tego <w>ciągu</w>.",
                            "target_lang_translations": {
                                "ru": "На уроке математики мы должны были вычислить сумму членов этой <w>последовательности</w>.",
                                "en": "In maths class, we had to calculate the sum of the terms of this <w>sequence</w>."
                            }
                        },
                        {
                            "text": "<w>Ciąg</w> Fibonacciego występuje często w przyrodzie.",
                            "target_lang_translations": {
                                "ru": "<w>Последовательность</w> Фибоначчи часто встречается в природе.",
                                "en": "The Fibonacci <w>sequence</w> often appears in nature."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ciąg arytmetyczny",
                        "ciąg geometryczny",
                        "wyraz ciągu",
                        "ciąg liczbowy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in mathematics context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорядоченный набор чисел или других элементов, где каждый элемент имеет свое определенное место.",
                        "en": "An ordered set of numbers or other elements where each member has a specific position."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовательность",
                                "target_lang_sense_clarification": "математическая"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sequence",
                                "target_lang_sense_clarification": "mathematics, ordered progression of numbers"
                            },
                            {
                                "target_lang_word": "progression",
                                "target_lang_sense_clarification": "arithmetic or geometric series"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1062b80d-b06b-36c9-ae88-b1462d51a23d",
                    "sense_definition": "Ruch powietrza lub spalin w przewodzie kominowym albo wentylacyjnym wywołany różnicą ciśnień.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie mogę rozpalić w kominku, ponieważ nie ma odpowiedniego <w>ciągu</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу разжечь камин, так как нет соответствующей <w>тяги</w>.",
                                "en": "I can't light the fireplace because there is not enough <w>draft</w>."
                            }
                        },
                        {
                            "text": "Kominiarz sprawdził przewody wentylacyjne i potwierdził dobry <w>ciąg</w>.",
                            "target_lang_translations": {
                                "ru": "Трубочист проверил вентиляционные каналы и подтвердил хорошую <w>тягу</w>.",
                                "en": "The chimney sweep checked the ventilation ducts and confirmed a good <w>draft</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cug"
                    ],
                    "common_phrases": [
                        "ciąg w kominie",
                        "ciąg kominowy",
                        "wsteczny ciąg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение воздуха или газов в дымоходе или вентиляции, вызванное разницей давлений.",
                        "en": "The flow of air or flue gas through a chimney or ventilation shaft caused by pressure difference."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "воздуха в трубе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "draft",
                                "target_lang_sense_clarification": "flow of air in a chimney or vent"
                            },
                            {
                                "target_lang_word": "draught",
                                "target_lang_sense_clarification": "British spelling, airflow in a flue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26866355-d619-3054-9e0e-2cce8e67acf0",
                    "sense_definition": "Siła wytwarzana przez silnik, która wprawia pojazd (np. samolot, rakietę) w ruch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pilot zwiększył <w>ciąg</w> silników, aby szybciej wystartować.",
                            "target_lang_translations": {
                                "ru": "Пилот увеличил <w>тягу</w> двигателей, чтобы быстрее взлететь.",
                                "en": "The pilot increased the engine <w>thrust</w> to take off faster."
                            }
                        },
                        {
                            "text": "Rakieta potrzebuje ogromnego <w>ciągu</w>, żeby pokonać grawitację Ziemi.",
                            "target_lang_translations": {
                                "ru": "Ракете требуется огромная <w>тяга</w>, чтобы преодолеть гравитацию Земли.",
                                "en": "A rocket requires immense <w>thrust</w> to overcome Earth's gravity."
                            }
                        }
                    ],
                    "common_phrases": [
                        "siła ciągu",
                        "ciąg silnika",
                        "ciąg startowy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical / aviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, создаваемая двигателем, которая приводит транспортное средство в движение.",
                        "en": "The propulsive force produced by an engine that drives a vehicle forward."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "двигателя"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "thrust",
                                "target_lang_sense_clarification": "engine propulsive power"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a68e7bc-8837-3ab1-ba18-5793af4cd714",
                    "sense_definition": "Długotrwały, nieprzerwany okres nadmiernego picia alkoholu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój sąsiad wpadł w alkoholowy <w>ciąg</w> i nie wychodzi z domu od tygodnia.",
                            "target_lang_translations": {
                                "ru": "Мой сосед ушел в <w>запой</w> и не выходит из дома уже неделю.",
                                "en": "My neighbour went on an alcohol <w>binge</w> and hasn't left the house for a week."
                            }
                        },
                        {
                            "text": "Leczenie jest trudne, gdy pacjent jest w długim <w>ciągu</w>.",
                            "target_lang_translations": {
