                        "glosses": [
                            "Qui peut être dépassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d02c84-400e-441a-967a-468a3f08b7cf",
                                "sense_id": "b99ce5e2-6017-3ace-911a-ad2c5b2bc1f3",
                                "text": "Ayant une suffisante connaissance des taudis de Marseille, je m’imaginais que leur misère n’était guère dépassable."
                            },
                            {
                                "example_id": "0a22dd63-6ff8-4ae1-a45c-e1b2ebfa01c2",
                                "sense_id": "b99ce5e2-6017-3ace-911a-ad2c5b2bc1f3",
                                "text": "Pour certains motifs (achats, accompagnement d’enfants à l’école, établissement culturel, lieu de culte, démarches administratives ou juridiques), cette limite des 10 km est dépassable, mais en restant dans son département."
                            },
                            {
                                "example_id": "b1c9f563-e4a2-4bef-b17f-c3127ffd7d41",
                                "sense_id": "b99ce5e2-6017-3ace-911a-ad2c5b2bc1f3",
                                "text": "De manière plus rationnelle, j’ai essayé de montrer pourquoi la polygamie était dépassée. Certains penseurs défendent que ce n’est pas dépassable, parce que c’est écrit dans le Coran."
                            }
                        ]
                    }
