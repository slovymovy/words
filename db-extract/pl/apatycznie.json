                                        "entry_id": "d150114b-85c6-3704-9fe5-c70134b97228",
                                        "glosses": [
                                            "In a lackadaisical manner; without enthusiasm or interest; perfunctorily."
                                        ],
                                        "tags": [],
                                        "examples": []
