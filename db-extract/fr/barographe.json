        "fr-extract.jsonl": [
            {
                "entry_id": "2d45bd29-e1fc-3684-bcaf-8dd3b517ba64",
                "word": "barographe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d04f3775-e153-427c-a9d3-f6f387438cd6",
                        "entry_id": "2d45bd29-e1fc-3684-bcaf-8dd3b517ba64",
                        "tags": [
                            "plural"
                        ],
                        "form": "barographes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                        "entry_id": "2d45bd29-e1fc-3684-bcaf-8dd3b517ba64",
                        "glosses": [
                            ", Appareil qui enregistre la pression atmosphérique dans la durée."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "2ca81cc4-9ff8-4f06-9a09-757ee771ec2e",
                                "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                                "text": "Un barographe n’est autre qu’un altimètre, dont l’aiguille de très grande dimension et munie à son extrémité d’une plume se déplace sur un cylindre enregistreur."
                            },
                            {
                                "example_id": "c4fe1592-2124-43e6-aed1-4f0b1848ad8b",
                                "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                                "text": "Mais la principale cause d'erreur provient de ce que, dans la plupart des barographes, le jeu des organes varie avec la température ; il conviendrait donc, pour les sondages convenablement organisés, d'imposer des barographes compensés […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "297775e6-3b14-4f42-b510-38235f8f1a1e",
                        "source_entry_id": "2d45bd29-e1fc-3684-bcaf-8dd3b517ba64",
                        "source_sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                        "target_lang_word": "barograph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "972358d7-df25-344b-8556-642b09f4e249",
                                        "entry_id": "64346bbd-9009-3621-a36b-a777439ab39b",
                                        "glosses": [
                                            "A type of barometer that continuously records air pressure on a sheet or rotating drum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e56320-cb35-492f-8251-20a572e14716",
                                                "sense_id": "972358d7-df25-344b-8556-642b09f4e249",
                                                "text": "Thanks to their barograph, however, they could judge their height above the sea."
                                            },
                                            {
                                                "example_id": "f798803e-e812-46e7-bbd2-ec09838ac956",
                                                "sense_id": "972358d7-df25-344b-8556-642b09f4e249",
                                                "text": "At noon the barograph curve turned up and the wind moderated, the sky gradually clearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b56e2d4-6f4b-3e73-a1a8-2ca1be7d80a2",
                                        "entry_id": "64346bbd-9009-3621-a36b-a777439ab39b",
                                        "glosses": [
                                            "An illuminated glass plate covered by a pressure sensitive sheet, used to measure pressure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468676a5-cadb-4243-a0f9-2ac20c28abec",
                                                "sense_id": "8b56e2d4-6f4b-3e73-a1a8-2ca1be7d80a2",
                                                "text": "A module in the program calculates the load acting on the barograph at the instant of image grabbing ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
