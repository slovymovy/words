                        "sense_id": "017d597e-a02c-3ece-92c8-0b24e751e077",
                        "entry_id": "2c0a30df-6a21-3fd5-99ff-9c3bc4e36f4f",
                        "glosses": [
                            "Commémorant une fête civile ou religieuse, ou un événement, sans être obligatoirement chômé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fea13d-71ff-438a-9bdb-164e635cefdd",
                                "sense_id": "017d597e-a02c-3ece-92c8-0b24e751e077",
                                "text": "Ce magasin est fermé le dimanche et les autres jours fériés ou, elliptiquement, les dimanches et jours fériés."
                            },
                            {
                                "example_id": "892b7b12-409f-4eeb-9fbf-3d54cd1a92c1",
                                "sense_id": "017d597e-a02c-3ece-92c8-0b24e751e077",
                                "text": "2017, une année très fériée."
                            }
                        ]
                    },
                    {
                        "sense_id": "947a4faf-8b8c-359c-9d82-9963a791af8e",
                        "entry_id": "2c0a30df-6a21-3fd5-99ff-9c3bc4e36f4f",
                        "glosses": [
                            "Qui évoque l’inoccupation d’un jour férié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840dbba2-e5e1-459b-a3d2-4bba433893af",
                                "sense_id": "947a4faf-8b8c-359c-9d82-9963a791af8e",
                                "text": "Nous nous asseyions entre les iris au bord de l’eau. Dans le ciel férié flânait longuement un nuage oisif."
                            }
                        ]
                    }
