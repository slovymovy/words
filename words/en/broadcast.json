                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбросной",
                                "target_lang_sense_clarification": "о методе посева"
                            },
                            {
                                "target_lang_word": "сплошной",
                                "target_lang_sense_clarification": "без разделения на ряды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撒播的",
                                "target_lang_sense_clarification": "指播种方式"
                            }
                        ]
