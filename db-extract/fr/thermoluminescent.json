                        "glosses": [
                            "Qui possède la propriété appelée la thermoluminescence."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "caa471cf-1ad8-4e4e-b370-e02f2a5c975e",
                                "sense_id": "fefeca23-dffb-319e-a949-d09dfd98cf55",
                                "text": "Certains corps, tels que la fluorine, deviennent lumineux quand on les chauffe ; ils sont thermoluminescents ; leur luminosité s’épuise au bout de quelque temps ; mais la faculté de devenir de nouveau lumineux par la chaleur est restituée à ces corps par l’action d’une étincelle et aussi par l’action du radium."
                            }
                        ]
