                "senses": [
                    {
                        "sense_id": "4fc5bbc8-9048-3111-80dc-b1762da32980",
                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "glosses": [
                            "A steam-powered heavy road roller."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "072f80a7-32f3-3c52-8ea2-2ed15d2b6097",
                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "glosses": [
                            "Any heavy road roller."
                        ],
                        "tags": [
                            "broadly",
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "glosses": [
                            "Any seemingly irresistible force."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "aa5c187c-44c6-4e3a-8c4b-780d5c12e550",
                                "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                                "text": "Well, I'm a steamroller, babe / I'm bound to roll all over you"
                            },
                            {
                                "example_id": "b84cb402-6445-4593-8156-77f557a1f87d",
                                "sense_id": "7acce077-730b-3f25-b6bf-95fb5a4b192c",
                                "text": "England's last line-out in World Cup rugby had been stolen by New Zealand in a dramatic conclusion to the final three years ago, but the driving maul remains a potent weapon and flanker Sadia Kabeya was decisive as England fired up the steamroller once more."
                            }
                        ]
                    },
                    {
                        "sense_id": "69e93e91-c51d-388b-82fd-e3808a330af4",
                        "entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "glosses": [
                            "A pipe, used for smoking cannabis, open at both ends and having a bowl near one end."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "151036a0-b3ae-40d6-8965-32ff051697e7",
                                "sense_id": "69e93e91-c51d-388b-82fd-e3808a330af4",
                                "text": "It's more about him testing his wares. He rolls joints. He doesn't own a bong, hookah, smoking pipe, chillum, vaporizer, scale, dugout system, grinder, or steamroller."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1fd4639-07e2-4671-9b3b-b0f0efd4a227",
                        "source_entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "source_sense_description": "steam-powered road roller",
                        "target_lang_word": "parní válec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "08f4905a-09b2-45ee-a54b-6924000ef743",
                        "source_entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
                        "source_sense_description": "steam-powered road roller",
                        "target_lang_word": "rouleau compresseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouleau compresseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f19927a4-851e-3629-9291-682730be9f45",
                                        "entry_id": "7b593666-c0c3-3ccf-9bd2-0e3895a379d6",
                                        "glosses": [
                                            "Engin servant à tasser une chaussée, un revêtement."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124bf658-09ed-4d86-aa5d-fb2db561806b",
                                                "sense_id": "f19927a4-851e-3629-9291-682730be9f45",
                                                "text": "Les rouleaux compresseurs sont nécessaires pour bâtir des routes goudronnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                        "entry_id": "7b593666-c0c3-3ccf-9bd2-0e3895a379d6",
                                        "glosses": [
                                            "Chose ou personne qui avance et écrase tout sur son passage, implacablement (parfois suivi de la préposition de)."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630b38b0-7621-4281-b9c9-a3467e9f81fc",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Le rouleau compresseur de l’armée d’invasion avançait inexorablement en direction de la capitale, et rien n’y résistait."
                                            },
                                            {
                                                "example_id": "9ce33ecd-c3a8-4fbb-b130-29bbff8e5150",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Nadal est un rouleau compresseur : le joueur de tennis enchaîne en effet les victoires, et semble invincible."
                                            },
                                            {
                                                "example_id": "6de92666-aa5b-4f85-90f5-b7de676dee97",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Cet album est un véritable rouleau compresseur, pour les oreilles – attention aux décibels – comme pour les ventes."
                                            },
                                            {
                                                "example_id": "fda8c85d-d7c9-4eb2-8c66-9404d815fac7",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Le rouleau compresseur du capitalisme industriel fait son lot de victimes."
                                            },
                                            {
                                                "example_id": "2448e2da-88d1-49ae-9504-d459a0c620aa",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Son style rouleau compresseur est modérément goûté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd3cf83e-adce-416d-8ffb-fc668419cd11",
                        "source_entry_id": "15bc1dea-030c-3768-a82e-6e7225765e14",
