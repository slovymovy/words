                "senses": [
                    {
                        "sense_id": "a7098cb3-8609-3eec-9ae4-d2b1126cb969",
                        "entry_id": "3078f327-4595-39f6-815e-55198e1c88f7",
                        "glosses": [
                            "Trouble bipolaire, faisant alterner des phases extrêmes du psychisme, entre euphorie et dépression mélancolique."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9705d870-f80b-4565-8b92-619a77929d01",
                                "sense_id": "a7098cb3-8609-3eec-9ae4-d2b1126cb969",
                                "text": "La « cyclophrénie » est, par conséquent, une forme particulière de l’organisation psychique, consistant dans la tendance à présenter, de temps à autre, des accès psychopathiques aigus, de telle ou telle forme."
                            },
                            {
                                "example_id": "ba2539b9-54fb-4515-be7c-30ca09d1d9ac",
                                "sense_id": "a7098cb3-8609-3eec-9ae4-d2b1126cb969",
                                "text": "Si l’on s’en tient à la distinction du plan du syndrome et du plan de la maladie, il n’est pas possible d’opposer à la cyclophrénie, maladie hyperthymique, le syndrome schizophrénique mais bien l’hébéphrénie, maladie hypothymique."
                            },
                            {
                                "example_id": "b9b1da1c-4411-43cb-8a04-cce277422d97",
                                "sense_id": "a7098cb3-8609-3eec-9ae4-d2b1126cb969",
                                "text": "Le trouble bipolaire est donc une pathologie périodique, une cyclophrénie."
                            }
                        ]
                    }
                ],
