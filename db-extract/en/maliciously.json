                        "sense_id": "25e306fb-7fe2-3cff-b422-85ef30194c7d",
                        "entry_id": "fd814fe0-d373-3f61-a637-329645b4b3bd",
                        "glosses": [
                            "In a malicious manner, or for malicious reasons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebef569f-eab3-4fdb-acec-e08a35cbbcdd",
                                "sense_id": "25e306fb-7fe2-3cff-b422-85ef30194c7d",
                                "text": "\"Theer, govison, (blockhead) tak that,\" and Jack flings maliciously at him the wisp of rushes wherewith he has rubbed down his own bemudded person."
                            },
                            {
                                "example_id": "e3dfb99b-2713-41f3-ad4e-65ceb774a01a",
                                "sense_id": "25e306fb-7fe2-3cff-b422-85ef30194c7d",
                                "text": "All of these base qualities combined compose a maliciously beautyless whole not to be found in other countries, and prove conclusively the brutal power of great sums of money for the enforcement of vulgarity[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f34bd09b-af9d-4b05-afd5-16d906c098e6",
                        "source_entry_id": "fd814fe0-d373-3f61-a637-329645b4b3bd",
                        "source_sense_id": "25e306fb-7fe2-3cff-b422-85ef30194c7d",
                        "source_sense_description": "In a malicious manner",
                        "target_lang_word": "malicieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
