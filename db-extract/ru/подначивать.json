                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a888b93-2433-4919-ae83-96aa55141e03",
                                                "sense_id": "b5c61688-840e-3bd0-b055-bae8613a1ce8",
                                                "text": "I might have been an unfortunate little bull in a Spanish arena, I got so smartingly touched up by these moral goads."
                                            }
