        "pl-extract.jsonl": [
            {
                "entry_id": "96aaaf6f-4fe3-313d-ba07-6525e53e75ce",
                "word": "wrap",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3fdf1dff-0d57-36db-8c09-f949a0302795",
                        "entry_id": "96aaaf6f-4fe3-313d-ba07-6525e53e75ce",
                        "glosses": [
                            "rodzaj kanapki wykonanej z okrągłego placka (np. tortilli czy pity) z zawiniętym w środku nadzieniem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40bf328c-e37c-478f-bd04-8296166bcedd",
                        "source_entry_id": "96aaaf6f-4fe3-313d-ba07-6525e53e75ce",
                        "source_sense_id": "3fdf1dff-0d57-36db-8c09-f949a0302795",
                        "target_lang_word": "wrap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f20e83-a59e-35f5-b867-a6420eb8cab4",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To enclose (an object) completely in any flexible, thin material such as fabric or paper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72503d8b-7a22-4d26-9573-168d94aba46e",
                                                "sense_id": "e9f20e83-a59e-35f5-b867-a6420eb8cab4",
                                                "text": "Christmas gifts are commonly known to be wrapped in paper."
                                            },
                                            {
                                                "example_id": "ab60a2d4-1984-4381-bc64-bb9a04628bb8",
                                                "sense_id": "e9f20e83-a59e-35f5-b867-a6420eb8cab4",
                                                "text": "I then dried these over a flame, and then, wrapping the formes and re-sealing them with my court seals — for my only commission, you see, was to report as to whether the type was unpied, and text ungarbled, and the formes all ready […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6010d85b-e803-395b-94e7-c639d4b7b6d0",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To enclose or coil around an object or organism, as a form of grasping."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2212e233-832d-4af8-98ac-c0dd70df38f6",
                                                "sense_id": "6010d85b-e803-395b-94e7-c639d4b7b6d0",
                                                "text": "A snake wraps itself around its prey."
                                            },
                                            {
                                                "example_id": "e3e973bf-fe5f-4c8d-ad06-5a2df31ac190",
                                                "sense_id": "6010d85b-e803-395b-94e7-c639d4b7b6d0",
                                                "text": "Like one who wraps the drapery of his couch / About him, and lies down to pleasant dreams."
                                            },
                                            {
                                                "example_id": "a8f58f89-59e5-44c1-8f38-02b1a126b977",
                                                "sense_id": "6010d85b-e803-395b-94e7-c639d4b7b6d0",
                                                "text": "The prehistoric caribou they had already liberated was wrapped in a space blanket and carefully tied to a sled. The Science Foundation team had then moved on to a deep translucent blue seam in the ice that proved to be a window on the rest of the ungulant herd standing poised in suspended animation, as if waiting for time to start again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a7d1ab2-2505-3cae-a65d-bb89b7e88161",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To conceal by enveloping or enfolding; to hide."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16994f5b-fe5e-4693-a4ce-7d2e1dbc5918",
                                                "sense_id": "0a7d1ab2-2505-3cae-a65d-bb89b7e88161",
                                                "text": "wise poets that wrap truth in tales"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9293dfb-19a9-32ed-9eca-dbe4bd989fd4",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To finish shooting (filming) a video, television show, or movie."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27c642e-e200-4aa7-886c-106c0ce42a32",
                                                "sense_id": "f9293dfb-19a9-32ed-9eca-dbe4bd989fd4",
                                                "text": "To avoid going over budget, let's make sure we wrap by ten. (compare wrap up 2)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6ea06e-802f-35b8-936e-a6e23a74df27",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To break a continuous line (of text) onto the next line"
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6432e674-f5fb-4d57-824f-475ae018c706",
                                                "sense_id": "3a6ea06e-802f-35b8-936e-a6e23a74df27",
                                                "text": "I wrapped the text so that I wouldn't need to scroll to the right to read it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96942e6e-fda1-3142-867d-270a7ca501f4",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To make functionality available through a software wrapper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e3b7d92-8059-3465-ba34-46bb499e3864",
                                        "entry_id": "07b42be7-4353-3d64-ac25-4d8b5a11ac62",
                                        "glosses": [
                                            "To (cause to) reset to an original value after passing a maximum."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ab866c-6208-42bd-90f0-4da299fa9cb0",
                                                "sense_id": "5e3b7d92-8059-3465-ba34-46bb499e3864",
                                                "text": "The row counter wraps back to zero when no more rows can be inserted."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6718698a-68e3-33f5-8761-0a38b84eb026",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "Paper or sheeting that is wrapped around something to protect, contain, or conceal it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27a51bc2-3cfa-3138-a4bf-1f568b38a3a2",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "A loose piece of women's clothing that one wraps around the body; a shawl or scarf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "affc68af-f1e7-35a8-81b5-8c139e5607d2",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "An outer garment worn as protection while riding, travelling etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a2b715-dae9-4de9-9894-12367658a7d5",
                                                "sense_id": "affc68af-f1e7-35a8-81b5-8c139e5607d2",
                                                "text": "‘I see you have had our Lowick Cicero here,’ she said, seating herself comfortably, throwing back her wraps, and showing a thin but well-built figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468c1eca-2728-36c4-993d-699b874f5049",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "A type of food consisting of various ingredients wrapped in a tortilla or pancake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d892edc-0129-3a7c-a6ca-0bcf7536a0a5",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "The completion of all or a major part of a performance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f371a8e-2b9c-469e-9589-6e56f81011a4",
                                                "sense_id": "2d892edc-0129-3a7c-a6ca-0bcf7536a0a5",
                                                "text": "But she could knock off right after the wrap, have dinner, and take a later flight."
                                            },
                                            {
                                                "example_id": "3230c203-cada-4365-82e4-3c95240e7de2",
                                                "sense_id": "2d892edc-0129-3a7c-a6ca-0bcf7536a0a5",
                                                "text": "The first time I met him is when we went to the – after the wrap party, we went to a little sound room – or a little screening room and watched the preview"
                                            },
                                            {
                                                "example_id": "e2ddea95-76fb-4617-b0d9-b009a16344f0",
                                                "sense_id": "2d892edc-0129-3a7c-a6ca-0bcf7536a0a5",
                                                "text": "And that's a wrap on \"News Watch.\" For Judy, Jim, Cal and Kirsten, I'm Jon Scott. We'll see you again next week.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482bf123-fe6e-39d4-9323-622bc0b3458c",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "A wraparound mortgage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "860f6e75-8bcd-350b-94e6-f553c6e101fa",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "A complete news report ready for broadcast, incorporating spoken reporting and other material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb4b567a-5f88-4949-87d5-f743bf36ad10",
                                                "sense_id": "860f6e75-8bcd-350b-94e6-f553c6e101fa",
                                                "text": "This is a news report from the scene of the event. When a voicer and an actuality are combined into one complete story, it's known as a wrap."
                                            },
                                            {
                                                "example_id": "4053446e-240d-4f24-80ef-83d5b773d181",
                                                "sense_id": "860f6e75-8bcd-350b-94e6-f553c6e101fa",
                                                "text": "Attend a news conference, and prepare a wrap or package."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f912ab-bb93-31a2-baa4-1a3a8b00fdea",
                                        "entry_id": "d743d1ba-398c-338e-b3c2-614d30a2793f",
                                        "glosses": [
                                            "The act of wrapping"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb40d5dc-4b8f-4412-95a7-c0b158cfebc9",
                                                "sense_id": "95f912ab-bb93-31a2-baa4-1a3a8b00fdea",
                                                "text": "Give the present a quick wrap before James sees it."
                                            }
                                        ]
                                    }
                                ]
                            },
