                        "form": "den Gebeinen"
                    },
                    {
                        "form_id": "96665c45-4fa0-4617-87d8-d9626ebccba9",
                        "entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gebein"
                    },
                    {
                        "form_id": "3a3ef916-1a40-4b5b-85b7-09e8ee681f33",
                        "entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gebeine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0180fd5e-f8a5-3296-b7f6-95f6263ba56b",
                        "entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "glosses": [
                            "Knochen, Skelett des lebenden Menschen"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "2db70f75-3690-4dba-bc16-438eb3460050",
                                "sense_id": "0180fd5e-f8a5-3296-b7f6-95f6263ba56b",
                                "text": "„Schon hatten sie einen Theil zurückgelegt als ein furchtbares: „O Gott!“ der Mutter eisig durchs Gebein rieselte. Sie wendet sich, und sieht – entsetzlicher Anblick – Rosalien, welche auf dem gefährlichsten Punkte mit dem Fuße gestrauchelt.“ (1845)"
                            },
                            {
                                "example_id": "98da8dae-6724-441c-9fab-e7182dc91fab",
                                "sense_id": "0180fd5e-f8a5-3296-b7f6-95f6263ba56b",
                                "text": "„Da sagte der Mensch: Diese endlich ist Gebein von meinem Gebein und Fleisch von meinem Fleisch; diese soll Männin heißen, denn vom Mann ist sie genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                        "entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "glosses": [
                            "sterbliche Reste, besonders Knochen; Skelett eines Toten"
                        ],
                        "tags": [
                            "literary",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "14f885a5-e21c-4593-a1d7-10fa2eee37ce",
                                "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                                "text": "„Doch dann zwingen Angriffe der Wikinger die Hüter der Gebeine erneut zur Flucht.“"
                            },
                            {
                                "example_id": "5bb9eaab-eff6-4e7a-9d15-97e6bebc2391",
                                "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                                "text": "„Zwölf Jahre später wurden seine Gebeine nach Caracas überführt.“"
                            },
                            {
                                "example_id": "e8b36ef1-8a89-47a8-a057-3f572bbd5701",
                                "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                                "text": "„Doch ihre Gebeine sind spurlos verschwunden, außer von ganz wenigen, die bei den Häusern bestattet wurden.“"
                            },
                            {
                                "example_id": "6be84a55-c6a7-48bc-88e3-72c8805cce89",
                                "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                                "text": "\"als 1524 die Gebeine des Benno von Meißen erhoben wurden, verfasste Luther seine Schrift 'Wider den neuen Abgott …'\""
                            },
                            {
                                "example_id": "da086d14-3986-4381-b3db-bdb908772c3f",
                                "sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                                "text": "\"Ein Teil der Nikolaus-Gebeine wird in der Freiburger Kathedrale verwahrt. Doch nun macht ein türkischer Archäologe den Schweizern die Reliquie streitig - …\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4cfc6f2-9b89-4867-b0f5-924ea3ceaef7",
                        "source_entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "source_sense_id": "0180fd5e-f8a5-3296-b7f6-95f6263ba56b",
                        "source_sense_description": "gehoben: Knochen, Skelett des lebenden Menschen",
                        "target_lang_word": "squelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Ensemble des os d’un organisme vertébré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891e5d23-cd09-4df5-a492-a1d01d0609bc",
                                                "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                                "text": "L’existence de mille Cuvier n’aurait pas suffit à recomposer les squelettes des êtres organiques couchés dans ce magnifique ossuaire."
                                            },
                                            {
                                                "example_id": "6f8ac8dd-bacc-49f1-8f45-469dc59bbeec",
                                                "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                                "text": "Ce baudrier était passé en sautoir autour du cou d’un cadavre ou plutôt d’un squelette, car les chairs du cadavre avaient été rongées, et les os en avaient été nettoyés comme pour un cabinet d’anatomie ou un atelier de peinture."
                                            },
                                            {
                                                "example_id": "3dc83e1f-45fe-49ca-bbc0-8cf73481deef",
                                                "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                                "text": "Le squelette peut être divisé en deux sous-groupes, le squelette axial et le squelette appendiculaire. Le squelette axial est constitué par les os du crâne (cranium), la colonne vertébrale, les côtes et le sternum, alors que le squelette appendiculaire est constitué par les os des membres supérieurs et inférieurs."
                                            },
                                            {
                                                "example_id": "ba518c97-4d07-4720-b825-eb07b5df54a1",
                                                "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                                "text": "Les jeunes filles […] se forgent des idées chimériques sur les hommes […] mais plus tard, quand il n’est plus temps de s’affranchir du malheur, la trompeuse apparence qu’elles ont embellie, leur première idole enfin se change en un squelette odieux."
                                            },
                                            {
                                                "example_id": "8ab4e99b-085a-4af2-b649-9dd5ad69b860",
                                                "sense_id": "50d53acc-0c2c-3d0b-b3fe-2c8f6de6f5be",
                                                "text": "Comme des doigts de squelettes, les branches des noyers heurtent la fenêtre qui ne s’ouvre plus, le sentier est effacé, la chatte est peut-être morte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136ea8e2-fccb-3a3b-b96e-078fe3b388a2",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Structure permettant le maintien de la forme d’un organisme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d985743f-38ab-4d9d-b3ef-e8cdbde2c2fd",
                                                "sense_id": "136ea8e2-fccb-3a3b-b96e-078fe3b388a2",
                                                "text": "Les insectes disposent d’un squelette externe formé par de la chitine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6fab195-5420-39f3-8e0d-8898db2e77c8",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Personne extrêmement maigre et décharnée."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cca8cc6-0a97-4706-94f4-418c4718ba9d",
                                                "sense_id": "a6fab195-5420-39f3-8e0d-8898db2e77c8",
                                                "text": "C’est un squelette, un vrai squelette, un squelette ambulant."
                                            },
                                            {
                                                "example_id": "97bb793b-5f5f-464f-9930-3cb2a8df8f2a",
                                                "sense_id": "a6fab195-5420-39f3-8e0d-8898db2e77c8",
                                                "text": "Le lendemain, Rose accouchait d’un enfant de sept mois, un petit squelette affreux, maigre à donner des frissons, et qui semblait souffrir sans cesse, tant il crispait douloureusement ses pauvres mains décharnées comme des pattes de crabe."
                                            },
                                            {
                                                "example_id": "cd4b736c-8ab5-4d29-85b5-58bb48ff7f73",
                                                "sense_id": "a6fab195-5420-39f3-8e0d-8898db2e77c8",
                                                "text": "Mais au départ, les conséquences d’un tel régime sur sa santé interrogent : « Des gens s’inquiétaient pour moi. Ils pensaient que j’allais devenir un squelette en trois mois »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4fbc8e-f335-3a85-85f8-cc483ee5f9c6",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Structure porteuse qui soutient un ensemble."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62789a64-83e2-4816-a154-d9fbedd3c9f0",
                                                "sense_id": "bc4fbc8e-f335-3a85-85f8-cc483ee5f9c6",
                                                "text": "Au milieu des prairies artificielles […] s’élèvent des espèces de forts carrés […] que domine une roue dentée, pareille à un squelette de feu d’artifice éteint."
                                            },
                                            {
                                                "example_id": "1328cd78-d0a6-4e43-886b-73e153d3ca45",
                                                "sense_id": "bc4fbc8e-f335-3a85-85f8-cc483ee5f9c6",
                                                "text": "La lune, échancrée par sa décroissance et ensanglantée par les dernières traces de l’orage, se levait derrière la petite ville d’Armentières, qui détachait sur sa lueur blafarde la silhouette sombre de ses maisons et le squelette de son haut clocher découpé à jour."
                                            },
                                            {
                                                "example_id": "923406b2-7998-4b0c-9d8d-30c8fa326ccb",
                                                "sense_id": "bc4fbc8e-f335-3a85-85f8-cc483ee5f9c6",
                                                "text": "Néanmoins la vectorisation entraîne des imprécisions et des pertes d’informations qui peuvent être parfois gênantes pour des traitements ultérieurs. Pour vectoriser une image il faut au préalable extraire le squelette des objets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d088b2-466f-3cc3-a11c-fc6a077a156a",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Structure de base sur laquelle tout repose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976a9f7e-76b9-427b-adc9-1c8abe73a64b",
                                                "sense_id": "41d088b2-466f-3cc3-a11c-fc6a077a156a",
                                                "text": "Nous avons vu que le squelette géologique de Chausey était entièrement granitique […]"
                                            },
                                            {
                                                "example_id": "990de654-9459-494e-ba30-a79e63cac250",
                                                "sense_id": "41d088b2-466f-3cc3-a11c-fc6a077a156a",
                                                "text": "Ces immenses aéronefs allemands étaient formés d’un squelette à côtes d’acier et d’aluminium, recouvert d’une enveloppe extérieure, résistante et non élastique, qui abritait à l’intérieur un ballon à gaz en tissu caoutchouté imperméable, coupé en compartiments dont le nombre variait de cinquante à cent."
                                            },
                                            {
                                                "example_id": "72e6e501-1834-43fe-8d24-9758ec3e6251",
                                                "sense_id": "41d088b2-466f-3cc3-a11c-fc6a077a156a",
                                                "text": "L’association entre les pâtes optimisées et un squelette granulaire dont la demande en eau a été définie permet la formulation de bétons autoplaçants."
                                            },
                                            {
                                                "example_id": "ff8b95ce-cd79-4169-ac8b-38538ea762ed",
                                                "sense_id": "41d088b2-466f-3cc3-a11c-fc6a077a156a",
                                                "text": "Les chimistes organiciens, conscient de l’aspect ludique propre aux synthèses chimiques […] se sont attelés par défi à la création d’hydrocarbures dont le squelette carboné correspond aux polyèdres réguliers que sont les solides platoniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023859d5-32ce-3c33-abb8-cc2f0cfd1d63",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Ce qui reste d’une telle structure."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b500ca22-459c-40de-8775-5147ae3399d6",
                                                "sense_id": "023859d5-32ce-3c33-abb8-cc2f0cfd1d63",
                                                "text": "Un amphithéâtre aux gradins récemment déblayés, un forum silencieux, des voies désertes, tout un squelette de grande cité défunte, toute la gloire triomphante des Césars vaincue par le temps et résorbée par les entrailles jalouses de cette terre d’Afrique qui dévore lentement, mais sûrement, toutes les civilisations étrangères ou hostiles à son âme…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c30768-d335-3177-87a6-c960d4196f3b",
                                        "entry_id": "dd653783-8e1e-3048-b603-6695ea4b2119",
                                        "glosses": [
                                            "Ensemble de courbes formées par la réduction d’une forme dans laquelle elles sont centrées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1101ebb-6ab6-4cbc-b281-7659d7eebb83",
                        "source_entry_id": "20d20609-f7da-3fc1-808c-46fc39727753",
                        "source_sense_id": "5a85dbfa-e481-3a23-b4b4-7f275bd5d193",
                        "source_sense_description": "gehoben, im Plural: sterbliche Reste, besonders Knochen; Skelett eines Toten",
                        "target_lang_word": "ossements",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ossements",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3180e2-1fe2-3ed3-a5f0-f28476dd75f6",
                                        "entry_id": "914011e7-e585-355c-aa76-7db41c78142a",
                                        "glosses": [
                                            "Pluriel de ossement : os décharnés des hommes ou des animaux morts."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f543d000-3094-42dd-a3fb-57a67844069e",
                                                "sense_id": "bd3180e2-1fe2-3ed3-a5f0-f28476dd75f6",
                                                "text": "Puis il s'agissait d'anéantir jusqu'au nom, jusqu'au souvenir, jusqu'aux ossements des rois; il s'agissait de rayer de l'histoire quatorze siècles de monarchie."
                                            },
                                            {
                                                "example_id": "420905ca-5191-4c53-ae68-1712aae8c2a5",
                                                "sense_id": "bd3180e2-1fe2-3ed3-a5f0-f28476dd75f6",
                                                "text": "Des maisons de neige, il ne restait naturellement plus rien; mais les cendres refroidies et les ossements de phoques attestaient encore le passage des Esquimaux."
                                            },
                                            {
                                                "example_id": "afeaa1a6-f97c-4cbe-90a0-af8f6e8d4d86",
                                                "sense_id": "bd3180e2-1fe2-3ed3-a5f0-f28476dd75f6",
                                                "text": "Les barbares n'oublièrent le chemin de Rome qu'après l'avoir détruite… Les Sarrasins d'Abdérame dorment dans les plaines de Tours ! La charrue broie encore sur son passage, les ossements des Huns dans les champs catalauniques !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
