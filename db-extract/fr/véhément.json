                    }
                ],
                "senses": [
                    {
                        "sense_id": "e23bd4d7-4726-3b34-9d35-30e5669c9321",
                        "entry_id": "31e28023-3bce-3fe2-ad25-a41078134747",
                        "glosses": [
                            "Qui est impétueux, passionné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bbc56c-4a29-48bb-a62b-27a299b4fc93",
                                "sense_id": "e23bd4d7-4726-3b34-9d35-30e5669c9321",
                                "text": "Mais messieurs, est-ce bien la licence des écrits véhéments que vous voulez proscrire ou les vérités hardies qui vous désespèrent."
                            },
                            {
                                "example_id": "7293009b-db05-44bc-b43f-57ea3a8b1a12",
                                "sense_id": "e23bd4d7-4726-3b34-9d35-30e5669c9321",
                                "text": "Joséphine […] pissa dans ses jupes de détresse en remarquant l’altération des traits du Pape à cette apostrophe véhémente."
                            },
                            {
                                "example_id": "d77bcef2-5ae1-439d-968c-cdf399d60b50",
                                "sense_id": "e23bd4d7-4726-3b34-9d35-30e5669c9321",
                                "text": "La discussion devint véhémente […]. Une rixe s'ensuivit. Et lorsque d'autres paysans accoururent pour les séparer, ils trouvèrent le jeune homme mort, le crâne fendu d'un coup de pioche."
                            }
                        ]
                    },
                    {
                        "sense_id": "be68c87c-d4a2-3367-9a0a-b9277da53fb8",
                        "entry_id": "31e28023-3bce-3fe2-ad25-a41078134747",
                        "glosses": [
                            "Violent, intense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23473fba-dfc8-41f8-bd87-49d901069de3",
                                "sense_id": "be68c87c-d4a2-3367-9a0a-b9277da53fb8",
                                "text": "L’une de ces filles avait les cheveux d’un roux très véhément, couleur qui est très fréquente en Espagne, où il y a beaucoup de blondes et surtout beaucoup de rousses, contre l’idée généralement reçue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95c464f6-1008-46be-abf8-38897920287f",
                        "source_entry_id": "31e28023-3bce-3fe2-ad25-a41078134747",
                        "target_lang_word": "heftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c54b59c8-5aa3-375a-b6e6-35e921a1c000",
                                        "entry_id": "a0ec34e2-1ecf-3b90-b001-9db887bd910c",
                                        "glosses": [
                                            "mit großer Intensität; sehr stark"
                                        ],
                                        "tags": [
                                            "adjektivisch und adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c037e3-1c32-4803-8288-80f617dffc27",
                                                "sense_id": "c54b59c8-5aa3-375a-b6e6-35e921a1c000",
                                                "text": "Heftiger Wind schlug uns ins Gesicht."
                                            },
                                            {
                                                "example_id": "178145a6-5f9d-4f1b-9817-412125b595ae",
                                                "sense_id": "c54b59c8-5aa3-375a-b6e6-35e921a1c000",
                                                "text": "Was er uns anbot, war ganz schön heftig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                        "entry_id": "a0ec34e2-1ecf-3b90-b001-9db887bd910c",
                                        "glosses": [
                                            "sehr, tüchtig, deftig, doll; heftiglich, heftiglichen, arg"
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c52af0-b1f4-4cc9-8bd9-2db0cafb96cb",
                                                "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                                "text": "Was er uns anbot, war ganz schön heftig."
                                            },
                                            {
                                                "example_id": "599d8aaa-ef12-424f-9d78-32fab2a9a7a4",
                                                "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                                "text": "Uns plagte heftig der Hunger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49c67047-7fcc-4402-866c-06fefdce6221",
                        "source_entry_id": "31e28023-3bce-3fe2-ad25-a41078134747",
                        "target_lang_word": "vehement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vehement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39dab9bc-65fe-3e16-bcb0-c5c89b448a32",
                                        "entry_id": "fcd2fc26-6c8c-3579-a10c-6a8ec80c7e2c",
                                        "glosses": [
                                            "Showing strong feelings; passionate; forceful or intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb1f9d8-7763-45ef-860f-090c9ede25df",
                                                "sense_id": "39dab9bc-65fe-3e16-bcb0-c5c89b448a32",
                                                "text": "The man made a vehement display of contempt."
                                            },
                                            {
                                                "example_id": "db267697-bf64-42ef-bafa-dff7e27cd9d8",
                                                "sense_id": "39dab9bc-65fe-3e16-bcb0-c5c89b448a32",
                                                "text": "Yet the Fiends ſeemed to come nearer and nearer, but when they were come even almoſt at him, he cried out with a moſt vehement voice, I will walk in the ſtrength of the Lord God; ſo they gave back, and came no further."
                                            },
                                            {
                                                "example_id": "85d51cce-da38-46fe-b7ae-e5e0bcbc179f",
                                                "sense_id": "39dab9bc-65fe-3e16-bcb0-c5c89b448a32",
                                                "text": "Amy shook her head, vehement. \"The vine didn't kill them. The Mayans did. They tried to flee and the Mayans shot them. The vine just claimed their bodies once they'd been shot. There's no thought involved in that. No—\""
                                            },
                                            {
                                                "example_id": "9d35d973-9b19-4dca-8dd0-98fd5520c432",
                                                "sense_id": "39dab9bc-65fe-3e16-bcb0-c5c89b448a32",
                                                "text": "“He’s a 70-year-old childless warmonger and he has no stake in the future of this country,” Dans said. “He is the very reason that MAGA started in the first place, and we only have to look at 2016 when he was a vehement Trump hater. A leopard doesn’t change its spots.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
