                ],
                "senses": [
                    {
                        "sense_id": "0239e3fd-c881-33dc-b281-57ef3ac827b7",
                        "entry_id": "a2b9089f-9763-31d8-8b8e-ce9d1ad2aee7",
                        "glosses": [
                            "Décoction de plusieurs plantes, de substances végétales, ordinairement très chargée et très composée."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "1ef89791-3be8-4967-a96a-e4ae94f1f819",
                                "sense_id": "0239e3fd-c881-33dc-b281-57ef3ac827b7",
                                "text": "Les natifs préparent avec les feuilles un apozème qui calme les coliques et possède des propriétés purgatives et anthelmintiques."
                            },
                            {
                                "example_id": "41dd8601-8d0b-4b1a-ad6a-ccd4bc8b13aa",
                                "sense_id": "0239e3fd-c881-33dc-b281-57ef3ac827b7",
                                "text": "Fournier ordonne dès le lendemain un apozème purgatif, dont l’activité doit être proportionnée à l’abondance des évacuations du jour précédent, à la nature et à la rapidité des accidents tant internes qu’externes."
                            },
                            {
                                "example_id": "02d52bc6-c640-4bd8-9575-b440c4d6a236",
                                "sense_id": "0239e3fd-c881-33dc-b281-57ef3ac827b7",
                                "text": "Cet apozeme fait résoudre les humeurs gluantes qui sont dans le poumon."
                            }
                        ]
                    }
                ],
