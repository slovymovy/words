                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "772a68ea-d9a1-44f6-a023-b528216652e8",
                        "source_entry_id": "8e279c6b-08e8-3e00-9c01-0840ebc24648",
