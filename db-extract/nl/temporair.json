                "senses": [
                    {
                        "sense_id": "ed8dbe5b-11ae-3bc1-b73d-bbb7417e7b45",
                        "entry_id": "62c674cd-dc73-3bb0-9cef-6a7061bbb769",
                        "glosses": [
                            "tijdelijk, dus niet blijvend of structureel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6341b68a-b456-4531-ac42-b7f4985fec4d",
                                "sense_id": "ed8dbe5b-11ae-3bc1-b73d-bbb7417e7b45",
                                "text": "De tijdelijke opslag die de KRO-bazen Yvonne de Haan en Taco Rijssemus hebben ontvangen in 2013, blijkt toch minder temporair te zijn."
                            },
                            {
                                "example_id": "1f489c61-e29e-4e15-bac1-180b70f6f79c",
                                "sense_id": "ed8dbe5b-11ae-3bc1-b73d-bbb7417e7b45",
                                "text": "Holland Festival-tijd. De Nederlandse componist, veelal beroemder buiten dan binnen de grenzen, mag even zijn kunstje vertonen. Rob Zuidam laat zich de temporaire interesse Vlaams-vriendelijk aanleunen."
                            },
                            {
                                "example_id": "227cf81b-a849-4ece-bceb-b82064b01994",
                                "sense_id": "ed8dbe5b-11ae-3bc1-b73d-bbb7417e7b45",
                                "text": "Decennia onderhandelingen om Turkije louter toezeggingen te doen als het bijvoorbeeld de mensenrechtensituatie in het land verbetert worden door een temporair probleem tenietgedaan."
                            }
                        ]
                    }
