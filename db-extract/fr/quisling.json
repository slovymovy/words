                "translations": [
                    {
                        "translation_id": "4e3db713-a82b-428a-83b4-3113972605a4",
                        "source_entry_id": "33babf54-e2ed-37f1-9ba1-0f0a24907682",
                        "source_sense_id": "b713ffb3-ba93-30da-81ad-d4d13b1a9dae",
