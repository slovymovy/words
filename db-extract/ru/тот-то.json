                ],
                "senses": [
                    {
                        "sense_id": "2d0d43da-feef-3be9-a4fe-0790fc213520",
                        "entry_id": "f1fc0402-a4f4-3bc3-a86e-998a5475ca3c",
                        "glosses": [
                            "that (one)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8183b72-39a6-4e02-8fd3-be5a7f83bd9c",
                                "sense_id": "2d0d43da-feef-3be9-a4fe-0790fc213520",
                                "text": "Да во́т же ― хоте́л ведь Ша́хов уби́ть и тре́тьего челове́ка, а то́т-то вообще́ ни при чём.",
                                "translation": "Well, you know, Shakhov also wanted to kill the third person but that one has nothing to do with anything at all.",
                                "english": "Well, you know, Shakhov also wanted to kill the third person but that one has nothing to do with anything at all."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f7bc59-834e-3605-af8b-6911f0e5fb56",
                        "entry_id": "f1fc0402-a4f4-3bc3-a86e-998a5475ca3c",
                        "glosses": [
                            "so and so (often duplicated after и (i))"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52a9716-6b04-4312-9ac4-471f9a410554",
                                "sense_id": "54f7bc59-834e-3605-af8b-6911f0e5fb56",
                                "text": "Мне пе́редали, что звони́л то́т-то и то́т-то.",
                                "translation": "I was told that so and so person called.",
                                "english": "I was told that so and so person called."
                            }
                        ]
                    }
                ],
