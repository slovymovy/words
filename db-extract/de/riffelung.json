                "senses": [
                    {
                        "sense_id": "ae7854ae-de6d-303e-85ee-ab212fe90e07",
                        "entry_id": "fb6ed419-358c-390c-a181-fbb88f7a8b19",
                        "glosses": [
                            "die Eigenschaft einer Oberfläche, geriffelt zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "48de23e2-5d09-4aba-a8b5-f2010981431d",
                                "sense_id": "ae7854ae-de6d-303e-85ee-ab212fe90e07",
                                "text": "„Zudem wirkte die Riffelung als Versteifung und bot so bei geringerer Masse einen erhöhten mechanischen Widerstand gegen auftreffende Schläge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a5538b8-c74f-3ae7-a322-9f9542e48190",
                        "entry_id": "fb6ed419-358c-390c-a181-fbb88f7a8b19",
                        "glosses": [
                            "Bereich mit geriffelter Oberfläche, zum Beispiel der Rand von Münzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b40ee41-3121-4fbb-bc27-35680946c7b3",
                                "sense_id": "3a5538b8-c74f-3ae7-a322-9f9542e48190",
                                "text": "„Sie hat nach unten hin zwei gebogene Schenkel, welche nur am unteren Ende eine Riffelung aufweisen mit dem Zweck, dass beim Walken das Leder nicht beschädigt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b402fc5b-069d-4155-91ec-5106a8f3eec6",
                        "source_entry_id": "fb6ed419-358c-390c-a181-fbb88f7a8b19",
                        "source_sense_id": "ae7854ae-de6d-303e-85ee-ab212fe90e07",
                        "source_sense_description": "kein Plural: die Eigenschaft einer Oberfläche, geriffelt zu sein",
                        "target_lang_word": "cannelure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannelure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                        "entry_id": "85d2e3c1-dfa3-3b9b-ab65-eaa16759f889",
                                        "glosses": [
                                            "Sillon creusé dans du bois, de la pierre ou dans un métal parallèlement à une arête."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d2034d-a1ab-465f-8992-5d5c896e4406",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "La cannelure orne bien une colonne. Les cannelures des consoles et des gaines sont plus petites à une extrémité qu’à l’autre."
                                            },
                                            {
                                                "example_id": "b57862eb-a417-46c9-9b3c-66b92839fc0e",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "Cannelures à vive arête. Cannelures à côte. Cannelures ornées."
                                            },
                                            {
                                                "example_id": "d5e7c12d-5351-4c49-954e-967792c22363",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "Des cuvettes et des cannelures creusées dans les angles de ces blocs, semblent révéler leur abominable usage, et avoir servi à faire couler le sang."
                                            },
                                            {
                                                "example_id": "877ad647-90e0-4d06-89ad-08f0e84f15e6",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "L’ancienne chambre à coucher de Mlle de Vénérande, arrondie aux angles, avec un plafond en forme de coupole, était tendue de velours bleu, lambrissée de satin blanc rehaussé d’or et de cannelures en marbre."
                                            },
                                            {
                                                "example_id": "6735a4af-3c63-4f64-96bc-d0b8d392d8a9",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "Les solives énormes du plafond étaient enjolivées de cannelures, finement ciselées."
                                            },
                                            {
                                                "example_id": "d63d4671-aeb5-4258-ade1-cfaa2aef74ca",
                                                "sense_id": "89a6ceae-71df-352d-b7d1-539be2b4b1ea",
                                                "text": "C'était un bâtiment funéraire en forme de temple grec avec fronton en triangle, crépi, deux marches menant à un stylobate à trois colonnes (à cannelures, avec volutes, feuilles d'acanthe, corniche, denticules au fronton, de la cimaise au rampant), pronaos, grille en fer forgé et, au tympan, sculptées en haut-relief, les lettres \"Famille Pelletier\" en grandes capitales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be5077de-2d11-33d4-b94c-7abffb8985bc",
                                        "entry_id": "85d2e3c1-dfa3-3b9b-ab65-eaa16759f889",
                                        "glosses": [
                                            "Stries profondes qu’on remarque sur la tige de certaines plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ac340c-c591-415b-a3f0-a49ded33feeb",
                                                "sense_id": "be5077de-2d11-33d4-b94c-7abffb8985bc",
                                                "text": "La tige de la bette a des cannelures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8c7a249-b765-3b72-9e24-4d7763f1eacc",
                                        "entry_id": "85d2e3c1-dfa3-3b9b-ab65-eaa16759f889",
                                        "glosses": [
                                            "Défaut formé par ces stries dans le bois d’une tige."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6237ebc-7f3f-40d7-8d32-42673ec21533",
                                                "sense_id": "f8c7a249-b765-3b72-9e24-4d7763f1eacc",
                                                "text": "L’annélation n’est pas recommandée avec le charme dont les cannelures de l’écorce rendent l’opération délicate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd923053-0ab9-325f-a881-8d8da38785c0",
                                        "entry_id": "85d2e3c1-dfa3-3b9b-ab65-eaa16759f889",
                                        "glosses": [
                                            "Gouttière ou sillon pratiqué sur divers instruments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
