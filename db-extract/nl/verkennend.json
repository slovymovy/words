            {
                "entry_id": "b1e19172-11b5-3544-aa78-ce41444bb760",
                "word": "verkennend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62877070-0cb9-369d-831c-234ee5d24328",
                        "entry_id": "b1e19172-11b5-3544-aa78-ce41444bb760",
                        "glosses": [
                            "bezig met iets te onderzoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257563d7-24f1-401f-9129-7be85cf5244c",
                                "sense_id": "62877070-0cb9-369d-831c-234ee5d24328",
                                "text": "De PvdA is samen met VVD, CDA en ChristenUnie door Forum-informateur Annemarie van Gaal gevraagd om met FvD deel te nemen aan verkennende gesprekken om te zien of coalitievorming mogelijk is."
                            },
                            {
                                "example_id": "2f4dd26f-7efe-4079-89d0-554da40d063f",
                                "sense_id": "62877070-0cb9-369d-831c-234ee5d24328",
                                "text": "De Maakplaatsen zijn een initiatief van Universiteit Twente, ROC van Twente en Tetem en bieden een programma waarmee kinderen, jongeren en ook volwassenen zich kunnen ontwikkelen tot 'verkennende, ontdekkende en creatieve mensen'. Van Engelshoven: „Cultuur groeit en bloeit in alle provincies. Met deze impuls wil ik die ontwikkeling verder stimuleren.”"
                            },
                            {
                                "example_id": "a533e1ca-1e62-4ee9-9b3f-d116888f5311",
                                "sense_id": "62877070-0cb9-369d-831c-234ee5d24328",
                                "text": "Ruim een jaar geleden kwam het ministerie met een ‘verkennende maatschappelijke kosten-batenanalyse’ (MKBA) voor de luchtvaart."
                            }
                        ]
                    }
