                        "glosses": [
                            "Not fungible, not interchangeable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "224ad096-0aa0-48c8-825d-4b187bd97493",
                                "sense_id": "4cf758c3-9145-3396-b54d-a8c3cec6830d",
                                "text": "But the claim that love of certain sorts—romantic, maternal, filial—is nonfungible means that this emotion is directed only to the particular individuals who manifest those properties."
                            },
                            {
                                "example_id": "0d23f9b8-8f5c-42c1-89cb-db9f05b98e79",
                                "sense_id": "4cf758c3-9145-3396-b54d-a8c3cec6830d",
                                "text": "Horses, slaves, and so forth, are non-fungible things, because they differ individually in value and cannot be exchanged indifferently one for another."
                            }
                        ]
                    }
                ],
