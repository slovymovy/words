                    "sense_definition": "dun papier zonder lijm dat gebruikt wordt om een sigaret te rollen of om vocht op te nemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "papier",
                    "name_type": "no",
