                        ]
                    },
                    {
                        "translation_id": "f1fedd56-a4b0-4a33-b795-c4da83496025",
                        "source_entry_id": "28dcdf65-664a-3fb1-ac55-97e67caa2509",
                        "source_sense_id": "9f63fab5-5c01-3e99-9318-2fb8ead7f6e4",
                        "source_sense_description": "Protestant calviniste français",
                        "target_lang_word": "гугенот",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гугенот",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79df0382-aef4-3008-80c7-23a51f3ba7ab",
                                        "entry_id": "be2fd13c-a5e5-3c34-8150-119fef6e7762",
                                        "glosses": [
                                            "истор., религ. последователь кальвинизма во Франции в XVI–XVII вв"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05094c7e-8ad0-4a94-97a0-1dff555c74a2",
                                                "sense_id": "79df0382-aef4-3008-80c7-23a51f3ba7ab",
                                                "text": "Воображаю себе, что я хожу по Парижу, в мае 1588 года, в буйный день баррикад и в предшествовавшие оному дни; что я попеременно, то в залах Лувра, то во дворце Гиза, то в парижском шинке, то в домах граждан, лигистов и гугенотов."
                                            },
                                            {
                                                "example_id": "a3dd96c2-ecb3-49a5-aa1f-1628763e30f8",
                                                "sense_id": "79df0382-aef4-3008-80c7-23a51f3ba7ab",
                                                "text": "Кровь гугенотов, пролитая во Франции, подобно маслу, пролитому на огонь, ожесточила пламя мятежа в Нидерландах."
                                            },
                                            {
                                                "example_id": "8f142d42-7219-4db6-be85-26c6e338f0e0",
                                                "sense_id": "79df0382-aef4-3008-80c7-23a51f3ba7ab",
                                                "text": "При мне в ночь святого Варфоломея правоверные католики с молитвой на устах избивали жен и детей гугенотов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
