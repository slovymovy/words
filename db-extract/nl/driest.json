                "senses": [
                    {
                        "sense_id": "10189492-9dcf-39d7-be53-739d2bda4b97",
                        "entry_id": "b462e933-1cfc-3427-a5d5-426b05d76b2f",
                        "glosses": [
                            "wild en woest, met ongefundeerde moed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81130b00-ff09-4177-aaed-09d7b39c077c",
                                "sense_id": "10189492-9dcf-39d7-be53-739d2bda4b97",
                                "text": "Reizen in de schaduw van Trump blijkt een ontwrichtende ervaring te zijn. De Republikeinse kandidaat boort weliswaar ‘fascistoïde sentimenten’ aan bij zijn aanhangers, maar zijn drieste optreden hoeft volgens Waling niet alleen maar ‘negatief’ te zijn. Hij heeft bovendien geen greintje sympathie voor tegenstander Hillary Clinton, die niet in haar eerste leugentje is gestikt. Wie Trump probeert te begrijpen in de context van een ‘vastgeroest partijsysteem’ komt volgens hem een heel eind. Je moet hem niet benaderen als ‘de ziekte van Amerika’, maar ‘hooguit als het symptoom’ daarvan."
                            },
                            {
                                "example_id": "ffa57a80-f330-465e-bff1-1b1c4b214aec",
                                "sense_id": "10189492-9dcf-39d7-be53-739d2bda4b97",
                                "text": "Elke aflevering komen er mensen van buiten hun kringetje binnen, wat leidt tot agressie maar ook hoop. Want wie weet wat Guus (gastacteur Bram Van Der Kelen) voor hen zou kunnen betekenen? Ook in deel 3 gaan ze er vol voor, Sanne den Hartogh, Sadettin Kirmiziyüz (Kil en Doc), Isabelle Houdtzagers en Hannah van Lunteren (Gina en Branka). Een en ander eindigt in een driest verjaardagsfeest, met fijne muziek, lichteffecten, dans en een, jawel, een mysteryguest. Daarover meer in deel 4. Binnenkort, in De Paarden-kathedraal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91125482-68f9-45c2-838f-7408ed4aac57",
                        "source_entry_id": "b462e933-1cfc-3427-a5d5-426b05d76b2f",
                        "source_sense_id": "10189492-9dcf-39d7-be53-739d2bda4b97",
                        "source_sense_description": "wilde woeste uitingen van onnadenkende, ongefundeerde moed",
                        "target_lang_word": "audacious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audacious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0ffe819-777f-3467-9dfd-8527da528a75",
                                        "entry_id": "84192c1a-bab3-3eb9-b079-410e127a4a3a",
                                        "glosses": [
                                            "Showing willingness to take bold risks; recklessly daring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa56e8f-8c96-4ca6-b7c9-46b7f8556bbe",
                                                "sense_id": "c0ffe819-777f-3467-9dfd-8527da528a75",
                                                "text": "It was an audacious thing for her to attempt, but boldness had often served her turn before."
                                            },
                                            {
                                                "example_id": "0f2dcdd5-19c2-4e45-bff2-dda5a9d4bc41",
                                                "sense_id": "c0ffe819-777f-3467-9dfd-8527da528a75",
                                                "text": "22 March 2012, Scott Tobias, AV Club The Hunger Gameshttp://www.avclub.com/articles/the-hunger-games,71293/\nThat such a safe adaptation could come of The Hunger Games speaks more to the trilogy’s commercial ascent than the book’s actual content, which is audacious and savvy in its dark calculations."
                                            },
                                            {
                                                "example_id": "aa077c04-9055-4e44-a409-c980c3c4dd5b",
                                                "sense_id": "c0ffe819-777f-3467-9dfd-8527da528a75",
                                                "text": "The audacious hijacking in Paris of a van carrying the baggage of a Saudi prince to his private jet is obviously an embarrassment to the French capital, whose ultra-high-end boutiques have suffered a spate of heists in recent months."
                                            },
                                            {
                                                "example_id": "0009eac8-61dc-4641-8dfd-84ed5b953753",
                                                "sense_id": "c0ffe819-777f-3467-9dfd-8527da528a75",
                                                "text": "Cuba’s economy minister described \"audacious\" measures to tame inflation…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da373f06-34ab-3e7f-b89e-807595b125e0",
                                        "entry_id": "84192c1a-bab3-3eb9-b079-410e127a4a3a",
                                        "glosses": [
                                            "Impudent, insolent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b4faa8-2744-4011-8a2e-71fa77afe55e",
                        "source_entry_id": "b462e933-1cfc-3427-a5d5-426b05d76b2f",
                        "source_sense_id": "10189492-9dcf-39d7-be53-739d2bda4b97",
