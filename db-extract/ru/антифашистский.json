                    {
                        "translation_id": "8fef43b2-7c78-4245-8ed9-1775066398dc",
                        "source_entry_id": "19090283-3944-366d-8ce8-b08ec47f8fa1",
                        "source_sense_id": "6c745808-a527-34d9-a18b-ee394d4271e2",
                        "target_lang_word": "antifaschistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifaschistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa709cb7-2a43-3b59-be4e-c60e9609de24",
                                        "entry_id": "540d78f5-6b96-3663-b7fe-59deb1776cd1",
                                        "glosses": [
                                            "den Faschismus ablehnend, engagiert gegen faschistoide Strukturen, Tendenzen, Gruppen"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3852cdf3-6ec6-48cc-a5f7-0642997d799e",
                                                "sense_id": "fa709cb7-2a43-3b59-be4e-c60e9609de24",
                                                "text": "„Wir organisieren eine antifaschistische Demo. Machst Du mit?“"
                                            },
                                            {
                                                "example_id": "bbad35e6-3054-4fe9-bae0-6faef98adddf",
                                                "sense_id": "fa709cb7-2a43-3b59-be4e-c60e9609de24",
                                                "text": "Die Sängerin Nina Hagen: „[…] Ich bin […] seit meiner Kindheit ein antifaschistisch und politisch geprägter Mensch. Mein Papa war ja ein Antifaschist und ein Überlebender des Zweiten Weltkriegs, der - anders als mein Großvater -Nazifolter und Diktatur überlebt hat.“"
                                            },
                                            {
                                                "example_id": "279d94cd-c989-4561-8841-855689423ea8",
                                                "sense_id": "fa709cb7-2a43-3b59-be4e-c60e9609de24",
                                                "text": "In einem Fall drangen tagsüber sogar mehrere Neonazis in das Wohnhaus einer antifaschistischen Familie aus Fürth ein und besprühten deren Eingangstüren mit Drohparolen. In einem anderen Fall bespritzen Anti- Antifa AktivistInnen [sic] das Wohnhaus einer antifaschistischen Familie aus Fürth mit schwarzem Lack."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a2aac36-a4cb-48fd-8a44-0fac60868279",
                        "source_entry_id": "19090283-3944-366d-8ce8-b08ec47f8fa1",
                        "source_sense_id": "6c745808-a527-34d9-a18b-ee394d4271e2",
                        "target_lang_word": "antifascistisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifascistisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cba2a4f5-67c6-3ed4-8d4a-ebeb2c78bb79",
                                        "entry_id": "b8e9a460-4570-3b35-82e1-bb6f7b06c54d",
                                        "glosses": [
                                            "het fascisme bestrijdend; strijdend tegen extreemrechts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d944109-0ae1-45ed-a43b-cc5815c1599d",
                                                "sense_id": "cba2a4f5-67c6-3ed4-8d4a-ebeb2c78bb79",
                                                "text": "RTV Oost meldt dat een Russische rapgroep afgelopen weekend tijdens een antifascistisch festival in Duitsland opgeroepen heeft naar Enschede te komen om ook te demonstreren tegen Pegida. Met een spandoek op het podium wordt gezegd om in verzet te komen."
                                            },
                                            {
                                                "example_id": "2601a864-bf87-4aaa-963c-2430d8ce43dc",
                                                "sense_id": "cba2a4f5-67c6-3ed4-8d4a-ebeb2c78bb79",
                                                "text": "De dreiging vanuit deze groepen is gering. Door de tegenreactie van groepen met een antifascistisch gedachtengoed lijkt de dreiging vaak groter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63e9eadb-01e1-46c1-a206-b66c3ad2b906",
                        "source_entry_id": "19090283-3944-366d-8ce8-b08ec47f8fa1",
                        "source_sense_id": "6c745808-a527-34d9-a18b-ee394d4271e2",
