                ],
                "senses": [
                    {
                        "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                        "entry_id": "f9645334-ab4c-3e2b-a07a-2d69956a80d5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e297543-956e-4b42-97e8-2815df94ed49",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Frau Vögle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "597e3d1d-c8da-4929-8b9d-4130abb3e3cc",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Herr Vögle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6cbc4476-8dfc-4cfe-a249-c51dfc3b67be",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Die Vögles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3baa4ecd-330e-4d52-8dd7-ab15801d91bb",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Der Vögle trägt nie die Pullover, die die Vögle ihm strickt."
                            },
                            {
                                "example_id": "c11527b3-bf96-4a62-ace1-859989584757",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vögle kommt, geht der Herr Vögle.“"
                            },
                            {
                                "example_id": "33441797-97a4-452d-920e-d6b7927821fb",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Vögle kommt und geht."
                            },
                            {
                                "example_id": "5d73144d-38f3-4019-9c0f-49f81a582103",
                                "sense_id": "e72e8136-1d4e-30ce-aea4-a705f7292c52",
                                "text": "Vögles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
