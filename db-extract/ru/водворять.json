                "senses": [
                    {
                        "sense_id": "f929f63a-2bb7-3494-aba0-fdb90933110d",
                        "entry_id": "7d75f641-ac7e-3586-877a-881fbc348ed1",
                        "glosses": [
                            "поселять, помещать кого-либо где-либо, куда-либо (обычно в принудительном порядке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ab8ad0-999e-4c20-92e3-1bcd9155789b",
                                "sense_id": "f929f63a-2bb7-3494-aba0-fdb90933110d",
                                "text": "И действительно, меня в тот же день водворяют обратно в палату, отбирают халат."
                            }
                        ]
                    },
                    {
                        "sense_id": "19a0f124-11be-3d72-9f2a-34f257443988",
                        "entry_id": "7d75f641-ac7e-3586-877a-881fbc348ed1",
                        "glosses": [
                            "возвращать в принудительном порядке на прежнее место жительства"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "151ef8c4-8369-3306-adad-9c92fa9242fd",
                        "entry_id": "7d75f641-ac7e-3586-877a-881fbc348ed1",
                        "glosses": [
                            "помещать, устанавливать что-либо на прежнее, положенное и т.п. место"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a382bcf2-f7af-4ee7-8c4f-034af300cfeb",
                                "sense_id": "151ef8c4-8369-3306-adad-9c92fa9242fd",
                                "text": "Но Надя находит фотографию в снегу и по возвращении в дом водворяет её на место."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c40ee4e-4579-3b82-bb70-3e65dacdfda7",
                        "entry_id": "7d75f641-ac7e-3586-877a-881fbc348ed1",
                        "glosses": [
                            "устанавливать или восстанавливать порядок, тишину и т.п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5f03f7-7827-46d2-b046-db5f503e2739",
                                "sense_id": "8c40ee4e-4579-3b82-bb70-3e65dacdfda7",
                                "text": "Это ― его «недобрый труд» в истории: творить людям зло для их же блага, водворять мир войной."
                            }
                        ]
                    }
