                                "example_id": "8d72cd7a-9b76-4379-b663-1692323d58c5",
                                "sense_id": "c8aaa94f-d936-3ebc-8678-66fa8908d12d",
                                "text": "„Die vaginalen, analen und oralen Abstriche haben allerdings keine Samenspuren nachweisen können.“"
                            },
                            {
                                "example_id": "047a2894-3d8d-40cb-b7ef-fbc43b8e91d5",
                                "sense_id": "c8aaa94f-d936-3ebc-8678-66fa8908d12d",
                                "text": "„Man fand Samenspuren auf ihrer Leiche, aber die DNS-Analyse war in der Gerichtsmedizin 1979 noch nicht bekannt.“"
                            },
                            {
                                "example_id": "db069196-9d92-4b12-ba1f-097e327bf6b2",
                                "sense_id": "c8aaa94f-d936-3ebc-8678-66fa8908d12d",
                                "text": "„Er starrte auf das Fernschreiben, während der Pathologe weiter tönte: vom Fehlen vaginaler Abschürfungen und dem Vorhandensein alter Samenspuren.“"
                            },
                            {
                                "example_id": "c09cde90-9819-4360-af65-e677ecb11c86",
                                "sense_id": "c8aaa94f-d936-3ebc-8678-66fa8908d12d",
                                "text": "„Die DNA-Analyse hatte eine Übereinstimmung mit den Samenspuren an Comfort ergeben.“"
                            }
