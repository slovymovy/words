                        "entry_id": "61ad9015-86aa-33eb-98f5-064ecd4c7ef6",
                        "glosses": [
                            "een cirkel op het aardoppervlak, parallel aan de evenaar, waarop alle punten met gelijke geografische breedte (noord of zuid) liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f212c16-ed28-4b72-a479-580e124d5cbd",
                                "sense_id": "9cfb3f08-f8cf-36d1-b902-b8cb7a2c13e3",
                                "text": "Eindhoven en Londen liggen op dezelfde breedtegraad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce768baf-338a-4e58-8113-9e1512ac4d1c",
                        "source_entry_id": "61ad9015-86aa-33eb-98f5-064ecd4c7ef6",
