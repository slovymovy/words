                        "entry_id": "281234a2-c353-316a-92be-72dbeeb2a9a1",
                        "glosses": [
                            "Lier les vergues avec des rabans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f239109e-9623-4975-bd91-815e81bea3e5",
                                "sense_id": "5e50bbda-8628-3391-9c9a-7b9a8967f1bf",
                                "text": "Ils serrent le chalut le long de la lisse, rabantent les diabolos, embarquent et saisissent les panneaux divergents."
                            },
                            {
                                "example_id": "f5b91156-827b-4b39-9f04-99239d7a09b3",
                                "sense_id": "5e50bbda-8628-3391-9c9a-7b9a8967f1bf",
                                "text": "Dans la mâture, les voiles en vergue, quoique rabantées avec soin, ont été mises en lambeaux, Journ. offic. 11 mai 1873, p. 3048, 3e col."
                            }
                        ]
                    }
