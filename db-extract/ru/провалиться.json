                                "target_senses": [
                                    {
                                        "sense_id": "0da61f99-716e-308f-a356-e0d74de304b6",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Se mettre, se poster, se tenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6931cb67-e7cc-4087-9675-b366691fb2a0",
                                                "sense_id": "0da61f99-716e-308f-a356-e0d74de304b6",
                                                "text": "Dans la ville neuve également, où des domestiques se plantèrent sur le seuil des maisons cossues, ils sentirent moins de sympathie que dans les rues désertes du quartier Saint-Marc, dont les vieux hôtels gardaient un silence ami."
                                            },
                                            {
                                                "example_id": "4dc9e235-b8c1-4fea-b586-72f6223973c4",
                                                "sense_id": "0da61f99-716e-308f-a356-e0d74de304b6",
                                                "text": "Une femme sans bras se plante devant le public, bien droite dans sa robe rouge ; …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e71daa-4447-37e4-9b32-3deb39c3fed9",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Tomber."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd311305-4601-46a3-9a3f-532a415991e1",
                                                "sense_id": "48e71daa-4447-37e4-9b32-3deb39c3fed9",
                                                "text": "Mon fils a voulu monter un talus à bicyclette et il s’est planté lamentablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4361e7d-eff9-38f7-b2e6-d328b9a3a2ff",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Tomber.",
                                            "Se tromper, échouer, ne pas réussir complètement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1290ebd8-a99e-486d-8244-61dee13f359b",
                                                "sense_id": "c4361e7d-eff9-38f7-b2e6-d328b9a3a2ff",
                                                "text": "Je me suis complètement planté à mon examen de math."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531c233f-6bb8-31f8-b840-7ae65478df03",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Tomber en panne, se scratcher."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0648a1e-2ab8-4d48-bb53-cb93da73ae23",
                                                "sense_id": "531c233f-6bb8-31f8-b840-7ae65478df03",
                                                "text": "Les ordinateurs sont de plus en plus puissants, mais ils se plantent toujours aussi souvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92beeb71-7f8f-3c2d-9be1-5ba88fc45818",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Rater son coup, son examen, son projet."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a828418-69e4-441d-8f85-54a1638584e0",
                                                "sense_id": "92beeb71-7f8f-3c2d-9be1-5ba88fc45818",
                                                "text": "Il s’est planté dans son examen d’algèbre."
                                            },
                                            {
                                                "example_id": "15f83697-dfea-4c12-b37f-d0bcb3f57b76",
                                                "sense_id": "92beeb71-7f8f-3c2d-9be1-5ba88fc45818",
                                                "text": "C'est pour ça, je pense, que je m'attendais pas du tout à ce qui s'est passé pour le deuxième album. C'est comme si j'avais pris pour acquis que j'avais … un filet de sécurité de succès. Mais dans le fond, c'était juste une illusion. Je me suis plantée solide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4565d9-e575-3386-b84c-3e65a938dc8c",
                                        "entry_id": "3c12175a-64c1-3eec-a4bf-e3aeb4a32675",
                                        "glosses": [
                                            "Se tromper lourdement."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aeeb212-acc0-4f35-bf7d-ef683d3efa94",
                                                "sense_id": "6e4565d9-e575-3386-b84c-3e65a938dc8c",
                                                "text": "La ministre se plante si elle croit que l’opposition ne trouvera rien à redire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
