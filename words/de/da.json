                    "semantic_group_id": "zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich wollte gerade das Haus verlassen, und genau <w>da</w> klingelte das Telefon."
                        },
                        {
                            "text": "Der Zug hielt plötzlich an, und von <w>da</w> an mussten wir zu Fuß gehen."
