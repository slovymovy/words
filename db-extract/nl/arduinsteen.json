                        "examples": [
                            {
                                "example_id": "c93aa40b-1606-4508-9d2a-c0fd2a5c8935",
                                "sense_id": "52ad22d8-614c-3d77-99ea-29bae265e9cf",
                                "text": "Veel winkelstraten liggen geplaveid met fossielen. Echt waar! Fossielen van zo’n 300 miljoen jaar oud, om precies te zijn. Die witte overblijfselen van koralen, zeeslakjes, schelpen (brachiopoden) en mosdiertjes vind je gewoon in donkerblauwe Belgische arduinsteen, die vaak wordt gebruikt in keukentabletten, vensterbanken, tegels en … stoepranden. Hoog tijd om ze eens van dichtbij te onderzoeken."
                            }
                        ]
