                        "sense_id": "58e726ed-0bf1-3eb0-83e1-554511a6006a",
                        "entry_id": "2de2e721-4f94-3b89-a534-7bf0ce3e2138",
                        "glosses": [
                            "een zaak waar het hart naar uitgaat"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ca21be6-eb60-4a81-a519-a97a8f82eb2e",
                                "sense_id": "58e726ed-0bf1-3eb0-83e1-554511a6006a",
                                "text": "Als ik de motie lees, dan zie ik daar de hartenklop van onze partij. Het is ook de hartenklop van onze fractie."
                            },
                            {
                                "example_id": "a4afde81-04d6-40bc-977d-d1d837dbea42",
                                "sense_id": "58e726ed-0bf1-3eb0-83e1-554511a6006a",
                                "text": "We lieten ons opslokken door de 24 uurs­economie. Door de mythe dat we steeds meer moeten produceren en consumeren om gelukkig te zijn. We verloren het leven op het ritme van de schepping. Dat breekt ons op. Dom je hartenklop steeds te laten opjagen."
                            },
                            {
                                "example_id": "26387bea-84f9-4f1b-9983-372956d156b9",
                                "sense_id": "58e726ed-0bf1-3eb0-83e1-554511a6006a",
                                "text": "Pulse (2010) (Polsslag, 2011): zeer uiteenlopende verhalen waarin de personages worden voortgestuwd door de hartenklop van het leven"
                            }
                        ]
                    },
                    {
                        "sense_id": "e2d53d23-7bf4-3f6d-95a4-56ca3d6a1428",
