                "senses": [
                    {
                        "sense_id": "35eadc1c-3eb5-3581-b9fc-fde207ce3933",
                        "entry_id": "36d45649-c75f-3950-94c5-6dca85c7b21f",
                        "glosses": [
                            "heldere korte geluiden voortbrengen zoals bij een klokkenspel van kleine belletjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576f9305-cf44-461e-89e4-02114a2e2a27",
                                "sense_id": "35eadc1c-3eb5-3581-b9fc-fde207ce3933",
                                "text": "Bakkers en slagers rijden die dag weer op een transportfiets met voorop een mand en een bel die veel lijkt op een dingdong in de hal. Trams tingelen kerkklokken luiden. Het carillon declameert vrolijke liedjes dames met klokrok staan elegant op hun kop. De arrenslee schudt jinglebellend de sneeuw van zich. Alles is vol klingelend leven zoals het ooit was bedoeld.."
                            },
                            {
                                "example_id": "e709803c-0899-477d-b7bb-8c9d8a106de2",
                                "sense_id": "35eadc1c-3eb5-3581-b9fc-fde207ce3933",
                                "text": "Het liedje wiegt op een ontspannen zomeravondritme, waarop eventueel ook een voorzichtige chachacha te dansen valt, en in het refrein tingelen de gitaren als bouzouki's in een olijfboomgaard."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5f0b85-32c1-35d2-861d-40221c9af33a",
                        "entry_id": "36d45649-c75f-3950-94c5-6dca85c7b21f",
                        "glosses": [
                            "niet heel goed pianospelen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5823ddcd-afa0-38da-9b43-e238c0f8956a",
                        "entry_id": "36d45649-c75f-3950-94c5-6dca85c7b21f",
                        "glosses": [
                            "tengels aanbrengen op een muur als voorbereiding op het aanbrengen van behang"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f269b2a-0360-49c2-96ac-12cffd745473",
                        "source_entry_id": "36d45649-c75f-3950-94c5-6dca85c7b21f",
                        "source_sense_id": "35eadc1c-3eb5-3581-b9fc-fde207ce3933",
                        "source_sense_description": "helder klinkend geluid maken",
