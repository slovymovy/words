                    },
                    {
                        "translation_id": "0b7e6eed-4f1a-4f57-81db-53847b1c0096",
                        "source_entry_id": "f67cd30d-cc85-3757-8fb1-9bcaae6e3b4b",
                        "source_sense_id": "283c3cdb-d6a4-3832-9b80-e6f078abce73",
                        "source_sense_description": "Halm von Gras",
                        "target_lang_word": "травинка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "травинка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                        "entry_id": "d78a4f27-dd8a-3367-84a9-617398a7003d",
                                        "glosses": [
                                            "стебелёк, побег травы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b049d3d-cce6-4099-8b8e-1b970e6c7a1b",
                                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                                "text": "Несколько травинок, муравей, ползущий с одной из них вниз головою, какие-то кусочки сора от прошлогодней травы — вот весь мой мир."
                                            },
                                            {
                                                "example_id": "8a8896eb-7769-4430-aa75-0747f3a11611",
                                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                                "text": "Молча шёл он впереди, покусывая сорванную травинку〈…〉"
                                            },
                                            {
                                                "example_id": "3574aa06-512f-442a-9ebf-58a386547e1a",
                                                "sense_id": "f2c0a278-ff26-3c64-aa2f-c195ade49820",
                                                "text": "Петя с длинною клюкою и сумочкой за плечами шёл впереди. Хватая на бегу травинки, за ним толклись овцы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
