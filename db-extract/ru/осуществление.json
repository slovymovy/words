                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                        "entry_id": "2ad2fd6d-5e89-3f7f-b40e-eb160c8f7482",
                        "glosses": [
                            "действие по значению гл. осуществить, осуществлять, осуществиться, осуществляться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa6d3fc-fcf8-4483-b2f8-fc64e8a73db6",
                                "sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                                "text": "Тяжёл был первый шаг к неуважению будущего своего супруга и к осуществлению мысли повелевать им по произволу…"
                            },
                            {
                                "example_id": "033faaa2-dabb-4fbe-95f8-d6c94bedb659",
                                "sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                                "text": "На какой стороне, ввиду таких обстоятельств, станет деятель, который осуществление интересов большинства считает главною задачей своих усилий?"
                            },
                            {
                                "example_id": "9c9527d3-38e1-445c-942a-a3168e00ffbf",
                                "sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                                "text": "Вера же есть осуществление ожидаемого и уверенность в невидимом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27f77b1a-645f-477e-8a50-b339033bcb3a",
                        "source_entry_id": "2ad2fd6d-5e89-3f7f-b40e-eb160c8f7482",
                        "source_sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                        "target_lang_word": "realization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd821ed-729a-3354-9040-ba58cceb378b",
                                        "entry_id": "44d0368b-0c65-3d9d-aaa1-d1208aef29cf",
                                        "glosses": [
                                            "The act of realizing, as:",
                                            "An act of figuring out or becoming aware."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6c61a5-f08a-4e4f-8121-969a34ed3882",
                                                "sense_id": "9fd821ed-729a-3354-9040-ba58cceb378b",
                                                "text": "He came to the startling realization that he had never really known the truth."
                                            },
                                            {
                                                "example_id": "de9d9e7c-2abd-483f-9ef5-49eb7a8005c1",
                                                "sense_id": "9fd821ed-729a-3354-9040-ba58cceb378b",
                                                "text": "A bath is a lovely relaxing event, until the realization that you're soaking in your own crud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4d9296-6721-32fe-87d5-497f641b41cd",
                                        "entry_id": "44d0368b-0c65-3d9d-aaa1-d1208aef29cf",
                                        "glosses": [
                                            "The act of realizing, as:",
                                            "The act of making real."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e0abe7-d5b7-4b12-b813-0120e58d5c64",
                                                "sense_id": "3f4d9296-6721-32fe-87d5-497f641b41cd",
                                                "text": "The realization of the plan took several years."
                                            },
                                            {
                                                "example_id": "f74ce2c7-8927-40ef-bdd0-926fab02961a",
                                                "sense_id": "3f4d9296-6721-32fe-87d5-497f641b41cd",
                                                "text": "He did not stay around long enough to see the realization of the idea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e24c71d-a25e-37f8-9f0f-4d69f84d702e",
                                        "entry_id": "44d0368b-0c65-3d9d-aaa1-d1208aef29cf",
                                        "glosses": [
                                            "The act of realizing, as:",
                                            "The result of an artistic effort."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1346ab73-a1f4-4f60-a8dd-f7672c9a6fb9",
                                                "sense_id": "3e24c71d-a25e-37f8-9f0f-4d69f84d702e",
                                                "text": "The painter's realization of her concept was breathtaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94522944-2bce-3a9f-8daf-8795c7ecf99a",
                                        "entry_id": "44d0368b-0c65-3d9d-aaa1-d1208aef29cf",
                                        "glosses": [
                                            "The act of realizing, as:",
                                            "The manner in which a phoneme is pronounced."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de2c431-ff94-4615-9cc9-9c8a57e86668",
                                                "sense_id": "94522944-2bce-3a9f-8daf-8795c7ecf99a",
                                                "text": "The realization of -nd as -nn- is not uncommon in the Nuorese dialects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8d67560-f8f5-4687-a35c-d2840dfed63d",
                        "source_entry_id": "2ad2fd6d-5e89-3f7f-b40e-eb160c8f7482",
                        "source_sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                        "target_lang_word": "accomplishment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplishment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c1c264-e6b6-3ec7-ae55-2a02cd284726",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "The act of accomplishing; completion; fulfilment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c621f557-5275-419a-aeb8-c38089e5269f",
                                                "sense_id": "44c1c264-e6b6-3ec7-ae55-2a02cd284726",
                                                "text": "the accomplishment of an enterprise, of a prophecy, etc"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "That which completes, perfects, or equips thoroughly; acquirement; attainment; that which constitutes excellence of mind, or elegance of manners, acquired by education or training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4864e481-118a-4364-95d5-a6bf6332f28b",
                                                "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                                "text": "I’ll make a proof how I advance in / My new accomplishment of dancing."
                                            },
                                            {
                                                "example_id": "547453aa-1949-4466-b698-62d79f6daa39",
                                                "sense_id": "ee70385a-044f-30c1-b90f-444b942bf7fc",
                                                "text": "Accomplishments have taken virtue’s place, / And wisdom falls before exterior grace ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2151462-37cb-3103-a869-21615015a491",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "Something accomplished; an achievement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5627ce5b-4207-4caf-8a5f-dfb42b8db4f5",
                                                "sense_id": "b2151462-37cb-3103-a869-21615015a491",
                                                "text": "Increasing sales by 20% in the last quarter was seen as a major accomplishment for the business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e865e8f5-515d-39b3-a1ae-b32b47313be7",
                                        "entry_id": "09529955-bc32-3442-8ff1-644a5ba00cdb",
                                        "glosses": [
                                            "The lexical aspect (aktionsart) of verbs or predicates that change over time until a natural end point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75624f2c-3941-4ba6-a757-750a409d4e8f",
                                                "sense_id": "e865e8f5-515d-39b3-a1ae-b32b47313be7",
                                                "text": "Thus it is attested that some children have taken an accomplishment verb like disappear, which does not have a causative counterpart, and used it as a causative accomplishment in sentences like He disappeared it, i.e. ‘He made it disappear.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "119304c4-1f0f-4fa0-9f9b-1754733e7eeb",
                        "source_entry_id": "2ad2fd6d-5e89-3f7f-b40e-eb160c8f7482",
                        "source_sense_id": "8a5a1c80-0405-38b0-bf89-786ba1870d35",
                        "target_lang_word": "implementation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implementation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                        "entry_id": "2a699989-a5b0-30f4-a8c8-23f4073add69",
                                        "glosses": [
                                            "The process of moving an idea from concept to reality. In business, engineering and other fields, implementation refers to the building process rather than the design process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9494fe81-047c-46f1-8a3e-f05e610ee9ff",
                                                "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                                "text": "Now that the requirements are complete we can move on to implementation."
                                            },
                                            {
                                                "example_id": "20b38cf2-6a88-43e6-a37b-52ade72f39ae",
                                                "sense_id": "4b2b9a21-de56-390b-acbe-03992a41fad3",
                                                "text": "The Group has recently concentrated on two main objectives, the implementation of a Code of Practice on minor station improvements and the preparation of a stock list of approved items of equipment for railway stations."
                                            }
                                        ]
                                    },
                                    {
