                                                "sense_id": "5841e3f2-198b-3a06-aa99-5f0c563f3c61",
                                                "text": "„Ein Ausdruck äußerster selbstischer Lust erfüllte ihr aufgerissenes, umherwanderndes Auge, und als sie mit dem Hintern zu rotieren begann, während mein Schwanz nur halb in ihr steckte, fing sie an, an ihrer Unterlippe zu kauen.“"
                                            },
                                            {
                                                "example_id": "50d7ebaf-5a42-4ed4-a413-128c27f47441",
                                                "sense_id": "5841e3f2-198b-3a06-aa99-5f0c563f3c61",
                                                "text": "„Aber die Schönheit, das muß wahr sein, macht selbstisch, und wer selbstisch ist, ist undankbar und treulos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
