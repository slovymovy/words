                                        "entry_id": "cb2b5bb6-7b94-3b2e-91b9-83eba909ee0d",
                                        "glosses": [
                                            "The winged indehiscent fruit of trees such as the ash, elm or maple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a18878d-5903-4d59-ab8a-6fa5be45233f",
                                                "sense_id": "808b30a7-e2b2-39ab-8b0f-f98c981a6ef8",
                                                "text": "The fruit is a nut, samara or drupe, containing a single seed with a straight embryo and little or no endosperm."
                                            }
