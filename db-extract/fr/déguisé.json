                "senses": [
                    {
                        "sense_id": "455a5419-4997-3232-93ee-ad8afa160a77",
                        "entry_id": "df0e0f6a-db6e-31b5-8fbf-fcaed6ae75d8",
                        "glosses": [
                            "Qui a pris un déguisement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7237cdc-867c-40cb-bf5d-a4e87184754b",
                                "sense_id": "455a5419-4997-3232-93ee-ad8afa160a77",
                                "text": "Qui t’aurait reconnu déguisé de la sorte ?"
                            },
                            {
                                "example_id": "03b0203f-787b-4f5f-a36a-67ffe3e558a1",
                                "sense_id": "455a5419-4997-3232-93ee-ad8afa160a77",
                                "text": "Ne m’aurait-il pas mieux valu passer une longue et délicieuse vie chez le roi Lycomède, déguisé en fille, avec les princesses filles de ce roi ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "1fe02ea5-71cb-3771-8bdf-888380a8932d",
                        "entry_id": "df0e0f6a-db6e-31b5-8fbf-fcaed6ae75d8",
                        "glosses": [
                            "Caché sous des apparences trompeuses."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "83f34394-320f-4f6d-8749-80cf13de6d97",
                                "sense_id": "1fe02ea5-71cb-3771-8bdf-888380a8932d",
                                "text": "Des sentiments déguisés."
                            },
                            {
                                "example_id": "3df24a05-5ba5-4816-9370-e989b2bf4885",
                                "sense_id": "1fe02ea5-71cb-3771-8bdf-888380a8932d",
                                "text": "La vérité déguisée par les flatteurs."
                            },
                            {
                                "example_id": "32768a45-82cf-4a33-b9f2-70433c1aabf5",
                                "sense_id": "1fe02ea5-71cb-3771-8bdf-888380a8932d",
                                "text": "Et je prends tous ces biens pour des maux déguisés."
                            },
                            {
                                "example_id": "83e6f7eb-6e5d-4016-b7de-4ccfc6b3704e",
                                "sense_id": "1fe02ea5-71cb-3771-8bdf-888380a8932d",
                                "text": "Un abrégé historique de la vie de plusieurs princes, où leurs vices ne sont pas déguisés."
                            }
                        ]
                    }
                ],
