                "senses": [
                    {
                        "sense_id": "0ae151ca-0283-3393-adbe-5ddb98f30671",
                        "entry_id": "3b9ce991-7768-3a0c-a483-dffea61dd4c5",
                        "glosses": [
                            "Besteck, Geschirr und Ziergegenstände aus Silber, mit denen festliche Tafeln eingedeckt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90523e4c-377b-4a04-a262-aa4c89cdd6de",
                                "sense_id": "0ae151ca-0283-3393-adbe-5ddb98f30671",
                                "text": "Für die anstehende Hochzeitsfeier wurde schon das Tafelsilber poliert."
                            },
                            {
                                "example_id": "3939db79-39ce-46f1-89b7-6300b7277d3a",
                                "sense_id": "0ae151ca-0283-3393-adbe-5ddb98f30671",
                                "text": "„Er war aus Preußen gekommen, um die ruritanische Armee zu reorganisieren, und nach kurzer Zeit in Begleitung der Gattin des Großkämmerers, zweier kostbarer Leuchter aus der Schloßkapelle und des Tafelsilbers der königlichen Garde südwärts verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d29b8a7-35e5-3c02-825d-173be3d5d176",
                        "entry_id": "3b9ce991-7768-3a0c-a483-dffea61dd4c5",
                        "glosses": [
                            "wertvoller, kostbarer Besitz"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3a69ff56-f745-423c-8db2-696bb79c69a0",
                                "sense_id": "4d29b8a7-35e5-3c02-825d-173be3d5d176",
                                "text": "„Er zeigt, was passieren kann, wenn eine Stadt ihr Tafelsilber an eine Heuschrecke verkauft – und dieses Tafelsilber fast alle bezahlbaren Wohnungen der Stadt sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
