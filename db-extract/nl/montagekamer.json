                        "glosses": [
                            "ruimte waarin apparatuur staat waarmee men ruwe opnames kan bewerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062e791e-5e26-4e66-9c18-3f068651fa2e",
                                "sense_id": "871d75ba-e76d-37b0-82d8-772b7ce3d786",
                                "text": "Hij bezorgde me een vijfendertigmillimeterkopie van de laatste gevechtsscène en gaf me toegang tot de montagekamer op school."
                            },
                            {
                                "example_id": "ddd6e51f-e2fb-4f9a-aa42-3503569d68f7",
                                "sense_id": "871d75ba-e76d-37b0-82d8-772b7ce3d786",
                                "text": "Een onconventionele man. Maar na een paar draaidagen vroeg je hem bij voorkeur aan. Want, alhoewel gebruiksaanwijzing, hij kon filmen in een onnavolgbaar tempo. Hij droeg dan ook een schat aan ervaring met zich mee en eenmaal in de montagekamer kwam je nooit een shot tekort. Veel shots overhouden? Nee ook weer niet. Daarom was íe zo snel."
                            }
                        ]
                    }
