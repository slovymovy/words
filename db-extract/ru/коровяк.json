                                            {
                                                "example_id": "17297908-8004-4c9c-a3d5-1723024923e6",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "Si votre chaussure vous irrite le pied, mettez-y une feuille de molène."
                                            },
                                            {
                                                "example_id": "3de771b9-42f1-4004-b3c3-65dafc157319",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "De sa main restée libre, il écarta des feuilles de molène poussées entre les interstices."
                                            },
                                            {
                                                "example_id": "ca9dbeb7-d967-4476-a391-6d888705961a",
                                                "sense_id": "7a7c11b9-d537-304d-8635-0b9c72919b2a",
                                                "text": "Les tiges des molènes de l'année dernière se dressent sur le banc de sable comme des bougies sans flamme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
