        "ru-extract.jsonl": [
            {
                "entry_id": "9ed13c14-edac-34a8-86ba-d519ee5cd7df",
                "word": "свыше",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8811acf9-f26f-3efc-9d2d-cf684fc52d1d",
                        "entry_id": "9ed13c14-edac-34a8-86ba-d519ee5cd7df",
                        "glosses": [
                            "разг. сверху"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f119eb5-4163-4d5d-8137-7f0a43c21421",
                                "sense_id": "8811acf9-f26f-3efc-9d2d-cf684fc52d1d",
                                "text": "Несутся свыше звуки лир; // В очарованьях тонет мир!.."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fbf93aa-a457-3e34-b78c-fd744e9d0fa5",
                        "entry_id": "9ed13c14-edac-34a8-86ba-d519ee5cd7df",
                        "glosses": [
                            "поэт., высок. и религ. от Бога, высшего разума"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad8e5640-7cc5-42c6-8ddf-5821bb3b77ed",
                                "sense_id": "9fbf93aa-a457-3e34-b78c-fd744e9d0fa5",
                                "text": "Сошло дыханье свыше, // И я слова распознаю: // «Гафиз, зачем мечтаешь, // Что сам творишь ты песнь свою?..»"
                            },
                            {
                                "example_id": "84cb216e-5076-45cc-8b71-1962750a7f2b",
                                "sense_id": "9fbf93aa-a457-3e34-b78c-fd744e9d0fa5",
                                "text": "Я видел груды тёмных скал, // Когда поток их разделял. // И думы их я угадал: // Мне было свыше то дано!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "70e176f2-028f-3640-9552-bdf1dc3f8135",
                "word": "свыше",
                "pos": "prep",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26e1c02b-130a-37d9-b269-8513219e4410",
                        "entry_id": "70e176f2-028f-3640-9552-bdf1dc3f8135",
                        "glosses": [
                            "разг. больше, чем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d41e3a7-8438-457e-afdc-cdd52b3e11bf",
                                "sense_id": "26e1c02b-130a-37d9-b269-8513219e4410",
                                "text": "…Всех фигур около сорока и все свыше человеческого роста!"
                            },
                            {
                                "example_id": "43d9756f-864c-4c5d-b4ef-76130c8a1fe8",
                                "sense_id": "26e1c02b-130a-37d9-b269-8513219e4410",
                                "text": "— Да-с! Страна! — горячо вскричал я. — Побольше вашей, во всяком случае… Свыше пятидесяти губерний, две столицы, реки какие!"
                            }
                        ]
                    }
                ],
