                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fcac9b02-4577-33f3-a777-47c4df4bfc58",
                        "entry_id": "f5700b60-fe83-3562-b95b-7d5df8f25b4a",
                        "glosses": [
                            "Relatif au césarisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f998aecb-e718-4d96-977c-165d7008380b",
                                "sense_id": "fcac9b02-4577-33f3-a777-47c4df4bfc58",
                                "text": "Résistance donc acharnée de la part des hommes qui gouvernent aux procédés césariens dont ils discernent à quoi ils aboutiraient."
                            }
                        ]
                    },
                    {
                        "sense_id": "9eaba551-fcef-3c10-bd37-e84f129bd46b",
                        "entry_id": "f5700b60-fe83-3562-b95b-7d5df8f25b4a",
                        "glosses": [
                            "Relatif à l’incision chirurgicale de la matrice pour faire venir un nouveau-né au monde."
                        ],
                        "tags": [],
                        "examples": [
