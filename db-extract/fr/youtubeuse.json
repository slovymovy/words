                        "tags": [],
                        "form": "YouTubeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5df0c79c-5d89-35ef-8645-e1a5cbda6587",
                        "entry_id": "8b3f9557-72e4-38b7-9ee0-85dc6b600945",
                        "glosses": [
                            "Internaute utilisatrice du site web YouTube."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "727e8117-45d7-3ac3-8f84-4418f784dd69",
                        "entry_id": "8b3f9557-72e4-38b7-9ee0-85dc6b600945",
                        "glosses": [
                            "Utilisatrice qui publie des vidéos sur YouTube."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9120d3-31b6-44af-98df-d222218d245c",
                                "sense_id": "727e8117-45d7-3ac3-8f84-4418f784dd69",
                                "text": "En 2007, Michelle Phan, youtubeuse américaine enflamme la toile avec sa vidéo sur smoky eyes en comptabilisant 50 000 vues en une semaine."
                            },
                            {
                                "example_id": "1c31a4e9-89f9-4626-9654-5aac205a092f",
                                "sense_id": "727e8117-45d7-3ac3-8f84-4418f784dd69",
                                "text": "Pour les noms d’activité, par exemple, personne ne bouge si ce n’est pas valorisé : youtubeur, youtubeuse ne font pas débat. Par contre, bâtonnière, procureuse, écrivaine, autrice… Là, c’est insupportable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71016283-9ed6-40c2-a1dc-65d239f0658f",
                        "source_entry_id": "8b3f9557-72e4-38b7-9ee0-85dc6b600945",
                        "target_lang_word": "YouTuber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "YouTuber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a5f54f-3c92-391c-b86a-da081b65ba9c",
                                        "entry_id": "5f944ae6-6ee8-3e86-a86e-3833a63b1567",
                                        "glosses": [
                                            "A user of the video-sharing website YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63bee397-cb77-36c5-ab2f-1a483fd95d04",
                                        "entry_id": "5f944ae6-6ee8-3e86-a86e-3833a63b1567",
                                        "glosses": [
                                            "A video creator on YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5c88303-8afb-449e-a1d8-4f5fdbf774d1",
                                                "sense_id": "63bee397-cb77-36c5-ab2f-1a483fd95d04",
                                                "text": "YouTuber and sister traditionalist Lacey Lynn commented on this video, extolling Faucheux and Collett because they had “red pilled me and I owe yall so much."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78689b32-7f57-4da6-ae98-c261617fe562",
                        "source_entry_id": "8b3f9557-72e4-38b7-9ee0-85dc6b600945",
                        "target_lang_word": "YouTubian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "YouTubian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b93b43d-2ac1-378b-8017-a57b862cfc89",
                                        "entry_id": "17b08d31-0610-39dd-8766-efc302689f60",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2701245-2d6a-473c-b8b4-f828f3af4f98",
                                                "sense_id": "3b93b43d-2ac1-378b-8017-a57b862cfc89",
                                                "text": "As large as the current Google database is, even bigger shocks are coming. An avalanche of digital video measured in exabytes (10 to the 18th power, or 1,000 petabytes) is hurtling down from the mountainsides of panicked Big Media and bubbling up from the YouTubian depths."
                                            },
                                            {
                                                "example_id": "31dad46b-231f-4d0e-8528-fc47ddf46254",
                                                "sense_id": "3b93b43d-2ac1-378b-8017-a57b862cfc89",
                                                "text": "First I'm going to do something prototypically YouTubian: I'm going to talk about myself."
                                            },
                                            {
                                                "example_id": "fb446afe-fac6-499c-bcb6-8c2335eed8a4",
                                                "sense_id": "3b93b43d-2ac1-378b-8017-a57b862cfc89",
                                                "text": "In these YouTubian times, there's a certain peril in conducting a multi-city stand-up comedy tour: Punch lines precede their progenitor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "YouTubian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7757ceaf-3270-3257-8d73-364fa0d0a943",
                                        "entry_id": "b1e03d0c-d989-3115-8b2d-c687efae75fc",
                                        "glosses": [
                                            "A user of video-sharing website YouTube."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cdc6a62-ed69-4c62-a34a-ab2ecc6693ff",
                                                "sense_id": "7757ceaf-3270-3257-8d73-364fa0d0a943",
                                                "text": "YouTubians, as many of us now refer to ourselves, have started to focus not only on the events of our own lives and the expression of our own views, but on the welcome response of others, from not only around the nation, but around the world."
                                            },
                                            {
                                                "example_id": "b3df1bf4-2d49-4dc2-a222-e581dcd9ae1f",
                                                "sense_id": "7757ceaf-3270-3257-8d73-364fa0d0a943",
                                                "text": "Millions of us YouTubians laughed, out-loud some of us, as we watched a middle aged lady walk into the retaining wall of an ornamental fountain, fall head first into the water, thrash around as if being attacked by piranhas for a few seconds, clamber out and then continue to shop as if nothing had happened."
                                            },
                                            {
                                                "example_id": "7a735d9e-656a-4604-8670-eba351ad3ea1",
                                                "sense_id": "7757ceaf-3270-3257-8d73-364fa0d0a943",
                                                "text": "I took a video and posted it to YouTube, where my fellow YouTubians charitably pointed out I was crazy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7921d720-7c03-4c06-a9bc-3af85a60a0a2",
