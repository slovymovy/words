{
    "word_family": [
        "Jesuit"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6c6017dc-fde6-382a-aaf7-71f7c404a739",
                    "sense_definition": "The central figure of Christianity, revered by Christians as the Son of God and the Messiah, and regarded as a prophet in Islam.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "religious_figure",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Christians believe that <w>Jesus</w> taught people to love one another.",
                            "target_lang_translations": {
                                "ru": "Христиане верят, что <w>Иисус</w> учил людей любить друг друга.",
                                "zh": "基督徒相信<w>耶稣</w>教导人们要彼此相爱。"
                            }
                        },
                        {
                            "text": "The story of the birth of <w>Jesus</w> is celebrated at Christmas.",
                            "target_lang_translations": {
                                "ru": "История рождения <w>Иисуса</w> празднуется в Рождество.",
                                "zh": "圣诞节庆祝关于<w>耶稣</w>诞生的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Jesus Christ",
                        "Christ",
                        "Son of God"
                    ],
                    "common_phrases": [
                        "Jesus of Nazareth",
                        "baby Jesus",
                        "thank Jesus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная фигура христианства, почитаемая христианами как Сын Божий и Мессия, а в исламе — как пророк.",
                        "zh": "基督教的中心人物，被基督徒尊为上帝之子和弥赛亚，在伊斯兰教中被视为先知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Иисус",
                                "target_lang_sense_clarification": "религиозная фигура"
                            },
                            {
                                "target_lang_word": "Иисус Христос",
                                "target_lang_sense_clarification": "полное имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耶稣",
                                "target_lang_sense_clarification": "基督教的中心人物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bd97b7b-6022-3544-9ef7-856b2cce7e41",
                    "sense_definition": "A male given name common in Spanish-speaking cultures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I introduced my friend <w>Jesus</w> to the rest of the team.",
                            "target_lang_translations": {
                                "ru": "Я представил своего друга <w>Хесуса</w> остальной части команды.",
                                "zh": "我把我的朋友<w>赫苏斯</w>介绍给了团队里的其他人。"
                            }
                        },
                        {
                            "text": "Is <w>Jesus</w> coming to the party tonight?",
                            "target_lang_translations": {
                                "ru": "<w>Хесус</w> придет сегодня на вечеринку?",
                                "zh": "<w>赫苏斯</w>今晚会来参加派对吗？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Spanish culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, распространенное в испаноязычных культурах.",
                        "zh": "在西班牙语文化中常见的男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хесус",
                                "target_lang_sense_clarification": "испанское имя"
                            },
                            {
                                "target_lang_word": "Иисус",
                                "target_lang_sense_clarification": "транслитерация написания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赫苏斯",
                                "target_lang_sense_clarification": "西班牙语人名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "48e58d40-0de3-39a5-9079-5ccfb471ea36",
                    "sense_definition": "An exclamation used to express strong emotion, such as surprise, shock, anger, or exasperation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jesus</w>, that car almost hit us!",
                            "target_lang_translations": {
                                "ru": "<w>Господи</w>, эта машина чуть не сбила нас!",
                                "zh": "<w>天啊</w>，那辆车差点撞到我们！"
                            }
                        },
                        {
                            "text": "Oh <w>Jesus</w>, I completely forgot about the meeting.",
                            "target_lang_translations": {
                                "ru": "О <w>Боже</w>, я совсем забыл о встрече.",
                                "zh": "噢<w>天啊</w>，我完全忘了开会的事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Christ",
                        "God",
                        "Jesus Christ",
                        "Lord",
                        "Heavens"
                    ],
                    "common_phrases": [
                        "sweet Jesus",
                        "oh Jesus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered mild blasphemy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для выражения сильных эмоций, таких как удивление, шок, гнев или раздражение.",
                        "zh": "用于表达强烈情绪（如惊讶、震惊、愤怒或恼火）的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Господи",
                                "target_lang_sense_clarification": "восклицание"
                            },
                            {
                                "target_lang_word": "Боже",
                                "target_lang_sense_clarification": "восклицание"
                            },
                            {
                                "target_lang_word": "Иисусе",
                                "target_lang_sense_clarification": "устаревшее/редкое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天啊",
                                "target_lang_sense_clarification": "表达惊讶的感叹词"
                            },
                            {
                                "target_lang_word": "老天",
                                "target_lang_sense_clarification": "表达震惊或恼火的感叹词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99655ce6-4440-3bde-ad5a-c1f137951255",
                    "sense_definition": "A specific personal interpretation, artistic depiction, or conceptualization of the Christian savior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author presents a <w>Jesus</w> who is more of a philosopher than a miracle worker.",
                            "target_lang_translations": {
                                "ru": "Автор представляет такого <w>Иисуса</w>, который больше философ, чем чудотворец.",
                                "zh": "作者笔下的<w>耶稣</w>更像是一位哲学家，而非行神迹者。"
                            }
                        },
                        {
                            "text": "Every artist paints their own <w>Jesus</w> based on their culture and beliefs.",
                            "target_lang_translations": {
                                "ru": "Каждый художник рисует своего <w>Иисуса</w>, основываясь на своей культуре и убеждениях.",
                                "zh": "每位艺术家都会根据自己的文化和信仰描绘出属于他们自己的<w>耶稣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal Jesus",
                        "historical Jesus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная личная интерпретация, художественное изображение или концептуализация христианского спасителя.",
                        "zh": "对基督教救世主的一种特定个人解读、艺术描绘或概念化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Иисус",
                                "target_lang_sense_clarification": "образ или интерпретация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耶稣",
                                "target_lang_sense_clarification": "艺术或文化中的形象"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f43bb336-3ae6-39ad-9a5e-cc60aea7c664",
                    "sense_definition": "To subject someone to excessive Christian preaching, proselytizing, or moralizing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept <w>Jesusing</w> me about my lifestyle until I had to leave the room.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>читать мне мораль</w> по поводу моего образа жизни, пока мне не пришлось выйти из комнаты.",
                                "zh": "他一直对我<w>说教</w>，谈论我的生活方式，直到我不得不离开房间。"
                            }
                        },
                        {
                            "text": "I don't want to be <w>Jesused</w> every time I visit my family.",
                            "target_lang_translations": {
                                "ru": "Я не хочу, чтобы мне <w>проповедовали</w> каждый раз, когда я навещаю семью.",
                                "zh": "我不想每次探望家人时都被他们<w>说教</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать кого-либо навязчивой христианской проповеди или нравоучениям.",
                        "zh": "强迫他人接受过度的基督教说教、传教或道德说教。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читать проповеди",
                                "target_lang_sense_clarification": "навязчиво обращать в христианство, читать мораль"
                            },
                            {
                                "target_lang_word": "проповедовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说教",
                                "target_lang_sense_clarification": "指代强迫性的道德或宗教说教"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}