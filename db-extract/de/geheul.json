                                    {
                                        "sense_id": "e2e82982-0c77-3a1a-9f9d-ebee4aaf1ff8",
                                        "entry_id": "139b43a9-9db2-3383-9f83-a6fc84d821b0",
                                        "glosses": [
                                            "Pluriel de hurlement."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc94a9a0-b9da-4194-bc5c-513fca196a6b",
                                                "sense_id": "e2e82982-0c77-3a1a-9f9d-ebee4aaf1ff8",
                                                "text": "Leurs hurlements et les miens retentissent, les tentatives d’agression se poursuivent."
                                            },
                                            {
                                                "example_id": "18d90409-c322-469a-b105-fee03decf19d",
                                                "sense_id": "e2e82982-0c77-3a1a-9f9d-ebee4aaf1ff8",
                                                "text": "Et les bêtes poussaient leurs hurlements de haine,\nEt l’étalon, soufflant du feu par les naseaux,\nBroyait les vieux palmiers comme autant de roseaux,\nEt le grand Cavalier gardien de la Géhenne\nMêlait sa clameur âpre aux cris des animaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
