                    "frequency": "High",
                    "semantic_group_id": "wielkosc_przewaga",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W parlamencie partia rządząca zdobyła <w>przytłaczającą</w> większość głosów.",
                            "target_lang_translations": {
                                "ru": "В парламенте правящая партия получила <w>подавляющее</w> большинство голосов."
                            }
                        },
                        {
                            "text": "Ilość nowych obowiązków w nowej pracy okazała się po prostu <w>przytłaczająca</w>.",
                            "target_lang_translations": {
                                "ru": "Количество новых обязанностей на новой работе оказалось просто <w>непосильным</w>."
