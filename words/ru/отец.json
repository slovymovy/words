            "senses": [
                {
                    "sense_id": "d829afb6-a8c8-37a2-9e73-0b2714205549",
                    "sense_definition": "Мужчина по отношению к своим детям.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kinship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <w>отец</w> работает инженером на заводе.",
                            "target_lang_translations": {
                                "en": "My <w>father</w> works as an engineer at the factory.",
                                "zh": "我的<w>父亲</w>在工厂当工程师。"
                            }
                        },
                        {
                            "text": "В выходные мы всей семьёй ездили в гости к <w>отцу</w>.",
                            "target_lang_translations": {
                                "en": "On the weekend, our whole family went to visit <w>father</w>.",
                                "zh": "周末我们全家去探望了<w>父亲</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "папа́ша",
                        "па́па",
                        "па́почка",
                        "ба́тя",
                        "роди́тель"
                    ],
                    "antonyms": [
                        "мать",
                        "сын",
                        "дочь"
                    ],
                    "common_phrases": [
                        "родной отец",
                        "стать отцом",
                        "многодетный отец",
                        "дом отца"
                    ],
                    "target_lang_definitions": {
                        "en": "A male parent in relation to his children.",
                        "zh": "与子女有血缘关系的男性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "father",
                                "target_lang_sense_clarification": "male parent"
                            }
                        ],
                        "zh": [
