                "senses": [
                    {
                        "sense_id": "0c3dcdeb-06ef-3e23-82db-7c0161ddc378",
                        "entry_id": "451015a6-a8da-3f1c-abbc-b24ead6c2b1d",
                        "glosses": [
                            "Fahrer eines Taxis"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ff367165-c610-4625-b909-dc26be5ed1ad",
                                "sense_id": "0c3dcdeb-06ef-3e23-82db-7c0161ddc378",
                                "text": "Der Taxichauffeur war seinem Fahrgast beim Einsteigen behilflich."
                            },
                            {
                                "example_id": "38846656-df11-4a25-8fbd-5c55756f9be2",
                                "sense_id": "0c3dcdeb-06ef-3e23-82db-7c0161ddc378",
                                "text": "„Eine asphaltierte, aber kaum befahrene Straße und ein schweigsamer, vom Ramadan geschwächter Taxichauffeur ließen mich allein mit der Wüste.“"
                            },
                            {
                                "example_id": "54a63943-a01a-4fcb-aecc-05df87321073",
                                "sense_id": "0c3dcdeb-06ef-3e23-82db-7c0161ddc378",
                                "text": "„Mein Taxichauffeur bat um eine Zigarette.“"
                            },
                            {
                                "example_id": "a586c829-88c5-4351-959c-49e86e906d9c",
                                "sense_id": "0c3dcdeb-06ef-3e23-82db-7c0161ddc378",
                                "text": "„Aber mir gefiel das alles, der Lärm auf den Straßen, das Gedränge an den Haltestellen, der Anblick der in ihren Ledermänteln übern Volant gelümmelten Taxichauffeure, wie sie an ihrer Thermosflasche nippten und die Tagesereignisse mit ihrem trockenen Witz glossierten – es war die Großstadt, und sie wirkte sensationell und erfrischend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7997ee4-ecb4-4432-a64c-7c8317505136",
                        "source_entry_id": "451015a6-a8da-3f1c-abbc-b24ead6c2b1d",
