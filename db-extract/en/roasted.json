                        "source_entry_id": "31cff8e4-9399-37d7-8283-8f41694045b5",
                        "source_sense_id": "19e82e91-797c-3251-a8fa-7d90a65bd560",
                        "source_sense_description": "cooked by roasting",
                        "target_lang_word": "grillé",
