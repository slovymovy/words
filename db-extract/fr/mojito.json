                    {
                        "translation_id": "66d84600-18df-4458-b8ee-e191a9ee3f5f",
                        "source_entry_id": "0cb8f9a5-74f0-38ec-9508-1ece69fdb6a6",
                        "source_sense_id": "fda9c7b2-25de-3301-b498-d89ffd8328a8",
