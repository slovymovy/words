                        "examples": [
                            {
                                "example_id": "05f38f89-da98-4dc9-bd0b-7456e4881d43",
                                "sense_id": "23b8fb03-1f1e-3d43-8bd9-61efb3bcfb7c",
                                "text": "„Durch solche Unglücksfälle hat die Große Armee mehr Soldaten verloren als durch feindliche Kugeln, erklärte Albrecht.“"
                            },
                            {
                                "example_id": "aafc3ba8-7c45-404b-9324-af4adb52318c",
                                "sense_id": "23b8fb03-1f1e-3d43-8bd9-61efb3bcfb7c",
                                "text": "„Doch in meinem Alter und bei meiner mangelnden Kenntnis möglicher Unglücksfälle war es mir unmöglich, eine Umsicht aufzubringen, die nur die Folge langer Erfahrung sein konnte.“"
                            }
                        ],
