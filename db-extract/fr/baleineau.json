                "senses": [
                    {
                        "sense_id": "54492e4f-40f5-36e1-82df-fc021a3704ab",
                        "entry_id": "321619fd-b653-332b-839b-39d25eaeea2b",
                        "glosses": [
                            "Petit de la baleine."
                        ],
                        "tags": [
                            "Cétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "152dcb96-186e-4147-bcef-813137342cc1",
                                "sense_id": "54492e4f-40f5-36e1-82df-fc021a3704ab",
                                "text": "Mais auprès de la baleine de monsieur le professeur, la mienne n’était qu’un baleineau."
                            },
                            {
                                "example_id": "3ea1ea20-b094-4d02-bb08-c35a74cbd420",
                                "sense_id": "54492e4f-40f5-36e1-82df-fc021a3704ab",
                                "text": "Des bénévoles et des vacanciers ont pu remettre à la mer les 42 baleines survivantes. … L’une des femelles a même donné naissance à un baleineau immédiatement après avoir été remise à la mer"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8e3273-447e-4b9b-aa3b-ace2c452da4d",
                        "source_entry_id": "321619fd-b653-332b-839b-39d25eaeea2b",
                        "source_sense_id": "54492e4f-40f5-36e1-82df-fc021a3704ab",
