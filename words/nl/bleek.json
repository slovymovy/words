            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "313c8ca1-591b-3a51-affe-aa40392ed6ed",
                    "sense_definition": "Met weinig kleur in het gezicht, vaak door ziekte, schrik of vermoeidheid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_face",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zag erg <w>bleek</w> toen hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "He looked very <w>pale</w> when he heard the bad news.",
                                "ru": "Он выглядел очень <w>бледным</w>, когда услышал плохие новости.",
                                "pl": "Wyglądał bardzo <w>blado</w>, kiedy usłyszał złą wiadomość."
                            }
                        },
                        {
                            "text": "Na een week griep zag haar gezicht nog steeds wat <w>bleek</w>.",
                            "target_lang_translations": {
                                "en": "After a week of flu, her face still looked somewhat <w>pale</w>.",
                                "ru": "После недели гриппа ее лицо все еще выглядело немного <w>бледным</w>.",
                                "pl": "Po tygodniu grypy jej twarz wciąż wyglądała na nieco <w>bladą</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pips",
                        "witjes",
                        "wit"
                    ],
                    "common_phrases": [
                        "bleek zien",
                        "lijkbleek",
                        "doodsbleek",
                        "een bleke neus halen"
                    ],
                    "target_lang_definitions": {
                        "en": "Having little color in the face, often due to illness, shock, or fatigue.",
                        "ru": "Бледный, лишенный румянца (обычно из-за болезни, испуга или усталости).",
                        "pl": "Mający mało koloru na twarzy, często z powodu choroby, strachu lub zmęczenia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pale",
                                "target_lang_sense_clarification": "lacking color in the face"
                            },
                            {
                                "target_lang_word": "pallid",
                                "target_lang_sense_clarification": "unhealthily pale"
                            }
                        ],
                        "ru": [
