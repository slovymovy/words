{
    "word_family": [
        "редкий",
        "редкость",
        "реденький",
        "редчать",
        "прореживать",
        "проредить"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fb5e1411-e67a-3fd5-909f-b14bf28ac59e",
                    "sense_definition": "С низкой частотой; в небольшом количестве за единицу времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезда здесь ходят <w>редко</w>.",
                            "target_lang_translations": {
                                "nl": "Treinen rijden hier <w>zelden</w>.",
                                "en": "Trains <w>rarely</w> run here."
                            }
                        },
                        {
                            "text": "Мы видимся очень <w>редко</w> из-за работы.",
                            "target_lang_translations": {
                                "nl": "Wij zien elkaar heel <w>zelden</w> vanwege werk.",
                                "en": "We see each other very <w>rarely</w> because of work."
                            }
                        }
                    ],
                    "synonyms": [
                        "и́зредка",
                        "неча́сто",
                        "вре́мя от вре́мени"
                    ],
                    "antonyms": [
                        "ча́сто"
                    ],
                    "common_phrases": [
                        "очень редко",
                        "довольно редко"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een lage frequentie; niet vaak.",
                        "en": "With a low frequency; not often."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zelden",
                                "target_lang_sense_clarification": "algemeen woord voor iets dat niet vaak gebeurt"
                            },
                            {
                                "target_lang_word": "weinig",
                                "target_lang_sense_clarification": "in de context van frequentie of hoeveelheid"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rarely",
                                "target_lang_sense_clarification": "general term for something that does not happen often"
                            },
                            {
                                "target_lang_word": "seldom",
                                "target_lang_sense_clarification": "a slightly more formal synonym for rarely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9eddda9-2bfd-30e2-9cdd-e287040ce2d4",
                    "sense_definition": "На большом расстоянии друг от друга, неплотно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вы огурцы посадили очень <w>редко</w>, так не сажают!",
                            "target_lang_translations": {
                                "nl": "Jullie hebben de komkommers heel <w>ver uit elkaar</w> geplant, zo plant je ze niet!",
                                "en": "You planted the cucumbers too <w>sparsely</w>, that's not how you plant them!"
                            }
                        },
                        {
                            "text": "В лесу деревья стоят <w>редко</w>.",
                            "target_lang_translations": {
                                "nl": "In het bos staan de bomen <w>ver uit elkaar</w>.",
                                "en": "In the forest, the trees are spaced <w>thinly</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "негусто",
                        "жидко"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met grote tussenruimtes; niet dicht op elkaar.",
                        "en": "With large spaces between; not densely packed."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ver uit elkaar",
                                "target_lang_sense_clarification": "met veel ruimte tussen objecten"
                            },
                            {
                                "target_lang_word": "dun",
                                "target_lang_sense_clarification": "bijvoorbeeld bij beplanting of haar"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sparsely",
                                "target_lang_sense_clarification": "used for objects or plants spread out with large gaps"
                            },
                            {
                                "target_lang_word": "thinly",
                                "target_lang_sense_clarification": "used for density, such as planting or hair"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e3e240e-02f0-3ebe-b4d7-239afb2cc771",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>редкий</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это явление в нашей местности <w>редко</w>.",
                            "target_lang_translations": {
                                "nl": "Dit verschijnsel is <w>zeldzaam</w> in onze regio.",
                                "en": "This phenomenon is <w>rare</w> in our area."
                            }
                        },
                        {
                            "text": "Такое поведение для него <w>редко</w>.",
                            "target_lang_translations": {
                                "nl": "Zulk gedrag is <w>zeldzaam</w> voor hem.",
                                "en": "Such behavior is <w>uncommon</w> for him."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Korte vorm van het bijvoeglijk naamwoord 'zeldzaam'.",
                        "en": "Short form of the adjective 'rare'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zeldzaam",
                                "target_lang_sense_clarification": "iets dat niet vaak voorkomt"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rare",
                                "target_lang_sense_clarification": "something that does not occur often"
                            },
                            {
                                "target_lang_word": "uncommon",
                                "target_lang_sense_clarification": "not typical or frequent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}