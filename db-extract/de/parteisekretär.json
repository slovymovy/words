                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534fc2ea-9477-4f2c-bdd7-1494ae73b409",
                                "sense_id": "5e46d704-2bb0-3be6-a4a1-db93594adecf",
                                "text": "„Sein Cousin war Oberster Parteisekretär in Kasachstan und seine Frau eine bildhübsche Blondine aus Wilnius.“"
                            },
                            {
                                "example_id": "1a62b448-58ab-458d-b893-5ea1f65ee881",
                                "sense_id": "5e46d704-2bb0-3be6-a4a1-db93594adecf",
                                "text": "„Seine untergebenen Kollegen machten sich über ihn lustig - als Parteisekretär hätte er ohne weiteres auch Marlboros aus Hongkong, gewissermaßen durch die ›Hintertür‹, beschaffen können - aber Vorsicht war ihm zur zweiten Natur geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
