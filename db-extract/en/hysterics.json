                "senses": [
                    {
                        "sense_id": "24f68cd2-a274-3658-a9d1-a91a28311e28",
                        "entry_id": "95209066-26e4-3f55-a4d2-8cc15147e792",
                        "glosses": [
                            "Hysteria; a bout of hysteria."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7780ccc3-c78d-4a9a-bf96-3660c2f8c8ea",
                                "sense_id": "24f68cd2-a274-3658-a9d1-a91a28311e28",
                                "text": "Her hysterics are uncontrollable."
                            },
                            {
                                "example_id": "5eefb27c-2136-4cbf-ad93-77b53f46e264",
                                "sense_id": "24f68cd2-a274-3658-a9d1-a91a28311e28",
                                "text": "The jokes had me in hysterics."
                            },
                            {
                                "example_id": "2b40f7c5-34ee-486f-858d-34b8e7623587",
                                "sense_id": "24f68cd2-a274-3658-a9d1-a91a28311e28",
                                "text": "But when they went to tread down the earth, it seemed to her like sacrilege; and, forgetting every thing in one strong emotion, she sprang forward to prevent it. The effort was too much; and, for the first time, she sank back in the arms of the servants in strong hysterics!"
                            },
                            {
                                "example_id": "5b277717-d286-4707-aa41-c6fd095ec31f",
                                "sense_id": "24f68cd2-a274-3658-a9d1-a91a28311e28",
                                "text": "\"How such swooning daughters can do it, constantly fainting and having hysterics, is a mystery to me,\" said Muriel Jane. \"Ho, they're a pretty sly lot,\" said Silvander Dan."
                            }
                        ]
                    }
