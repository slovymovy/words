                    {
                        "translation_id": "f5e00130-912c-42b2-b37e-17a8e807288d",
                        "source_entry_id": "053ffb77-ffed-3e00-b38e-a29feffd4698",
                        "source_sense_description": "Chevet, coussin long et cylindrique",
                        "target_lang_word": "bolster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bolster",
