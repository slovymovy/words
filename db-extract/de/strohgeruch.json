                ],
                "senses": [
                    {
                        "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                        "entry_id": "388e633e-764c-3fb7-92b0-d0fb239b05c4",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von trockenem Stroh stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10ea384-9a03-4bfb-8fd9-1c530443de69",
                                "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                                "text": "„Das indessen sich entwickelnde kohlensaure Gas bleibt im Wasser gebunden u. das Weichwasser nimmt einen Strohgeruch u. gelbe Farbe an.“"
                            },
                            {
                                "example_id": "c7663c69-bbb1-4391-91cc-2a3dc9858aeb",
                                "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                                "text": "„Nie habe er den feuchten Strohgeruch der Postkutsche, in der er, „wie Wild verstaut“, als einziger Passagier die etwa fünfzig Kilometer aus Kent nach London zurücklegte, wohin sein Vater versetzt worden war, vergessen.“"
                            },
                            {
                                "example_id": "db538984-cf27-45c2-ac27-4ffb8d448f5e",
                                "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                                "text": "„Vom Feld weht Strohgeruch heran.“"
                            },
                            {
                                "example_id": "d0606fbd-fac3-488f-9542-d86618e92cc2",
                                "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                                "text": "„Mit simplen Mitteln hat Janine Weger lustige Kostüme und ein heimeliges Bühnenbild geschaffen, das durch den Strohgeruch einen weiteren Sinn der Zuschauer mit einbezieht.“"
                            },
                            {
                                "example_id": "78f6fecc-fc8c-4873-a7bf-e47cc54ae548",
                                "sense_id": "b2152163-ce87-3062-8946-541f72897206",
                                "text": "„Der typische Strohgeruch ist ein weiterer Grund, weswegen hauptsächlich Alternativen für eine Herstellung eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
