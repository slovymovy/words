                "forms": [],
                "senses": [
                    {
                        "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                        "entry_id": "eda92609-3f91-32b8-bfdc-2bafb9b85942",
                        "glosses": [
                            "Participe passé du verbe renaître."
                        ],
                        "tags": [
                            "form-of",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9be1db54-6bf0-4b7f-8d06-b4b465547aa1",
                                "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                                "text": "Quand l’un d’eux est mort, sa place reste nécessairement vacante jusqu’à ce qu’on ait appris qu’il est rené dans une famille quelconque."
                            },
                            {
                                "example_id": "0d09a97a-b6c3-48a4-a925-b5af45062a6f",
                                "sense_id": "f905921f-0e00-3211-8dd8-e9bc2140c7f4",
                                "text": "Quand un de ces personnages est mort, on attend qu’il renaisse ; sa place reste vacante. Au bout d’un certain temps, on apprend qu’il est rené en tel endroit"
                            }
                        ]
                    }
                ],
