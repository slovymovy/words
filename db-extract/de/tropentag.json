                "senses": [
                    {
                        "sense_id": "311f22fe-6528-3d36-aae7-bbb46423c286",
                        "entry_id": "a0f00f67-7fc1-3e65-b29f-8ff464df877f",
                        "glosses": [
                            "Tag, an dem die Außentemperatur einen Höchstwert von 30 °C erreicht oder übersteigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5da37cd-f472-44c1-9801-38db8adb6f72",
                                "sense_id": "311f22fe-6528-3d36-aae7-bbb46423c286",
                                "text": "„Steigen die Tagestemperaturen gar auf 30 Grad und mehr, sprechen Meteorologen von einem \"heißen Tag\" oder Tropentag.“"
                            },
                            {
                                "example_id": "6fcb830f-fab1-4dfe-a20c-e5773111606d",
                                "sense_id": "311f22fe-6528-3d36-aae7-bbb46423c286",
                                "text": "„Und an einem Tropentag wie diesem hoffte wohl so mancher, dass die lebensherbstliche Schattierung des Konzertprogramms die glühende Augusthitze womöglich ein wenig lindern würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
