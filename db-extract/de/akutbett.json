                "senses": [
                    {
                        "sense_id": "745d1ff7-f7a3-30c3-a1dd-d7a01d0399b6",
                        "entry_id": "04a99112-c655-3abd-bff2-f32845166f3e",
                        "glosses": [
                            "Vorrichtung, die dafür konstruiert wurde, dass akutkranke Personen darin schlafen oder sich ausruhen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6dbba64-b44d-44bd-b604-235c49e16e8b",
                                "sense_id": "745d1ff7-f7a3-30c3-a1dd-d7a01d0399b6",
                                "text": "„Ob jemand tatsächlich ein Akutbett braucht, entscheiden der aufnehmende Arzt und jener Arzt, der den Patienten untersucht.“"
                            },
                            {
                                "example_id": "0083b905-0db1-4f98-9cfb-9a9f3aff4d22",
                                "sense_id": "745d1ff7-f7a3-30c3-a1dd-d7a01d0399b6",
                                "text": "„Experten gehen davon aus, dass ein Bett im Patientenhotel, auch wenn es über die Fallpauschale abgerechnet wird, deutlich günstiger sein könnte als ein Akutbett im Krankenhaus.“"
                            },
                            {
                                "example_id": "b8e81c33-6d60-469b-8042-5cc854677563",
                                "sense_id": "745d1ff7-f7a3-30c3-a1dd-d7a01d0399b6",
                                "text": "„Bis zu 800 Euro betragen pro Tag übrigens die Kosten für ein Akutbett in einem Krankenhaus, in einem Pflegeheim sind es in Salzburg im Schnitt 225 Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
