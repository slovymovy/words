                                        "entry_id": "a66d8c12-f24d-35bd-b8ec-84e350807339",
                                        "glosses": [
                                            "smysl k vnímání sladkého, slaného, kyselého a hořkého"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc771bc-5d57-48e5-820f-29c04de16bb1",
                                                "sense_id": "d978c90a-f3d9-35a0-93a2-964b23fdfbb5",
                                                "text": "Chuť je smysl, který dovoluje vnímat chemické látky rozpuštěné ve slinách nebo vodě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b047cd77-1fe2-3f23-a015-4ad7423102ba",
                                        "entry_id": "a66d8c12-f24d-35bd-b8ec-84e350807339",
                                        "glosses": [
                                            "smyslový vjem chuti [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9fcbb7-a0b7-4bcb-9cbc-035a9b7f1d3b",
                                                "sense_id": "b047cd77-1fe2-3f23-a015-4ad7423102ba",
                                                "text": "V chuti bývá středně plné, většinou hrubější s kratším chuťovým dopadem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a69f2768-a44d-3d10-89da-cac50c036666",
                                        "entry_id": "a66d8c12-f24d-35bd-b8ec-84e350807339",
                                        "glosses": [
                                            "nutkání"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc43db4f-37c7-4014-93a3-2f3636c3e966",
                                                "sense_id": "a69f2768-a44d-3d10-89da-cac50c036666",
                                                "text": "Taky máte možná někdy chuť lidi obejmout za to, jací jsou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c67d10b-81cb-44d0-8f82-237ff3ff6208",
                        "source_entry_id": "ba2be13a-bdd7-3ba5-b65b-977d9022a6b8",
                        "source_sense_id": "3aafec91-bfbd-36bd-9ebb-446143ec9721",
                        "source_sense_description": "dringende, starke Lust auf etwas",
                        "target_lang_word": "chutě",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chutě",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a4c06b-605e-3bd7-bf1e-a3448e9abd46",
                                        "entry_id": "c6e1c03d-094e-3f3e-bf70-bb9f51bafe27",
                                        "glosses": [
                                            "svižně, rychle, hbitě, spěšně"
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb68b413-ead9-4844-a1d6-a140f8badfc6",
                                                "sense_id": "d1a4c06b-605e-3bd7-bf1e-a3448e9abd46",
                                                "text": "Nuže, srdce svého k šlechtění, chutě dej se, dítě, do čtení!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c259fe-e955-394a-a369-2b1db4091fe0",
                                        "entry_id": "c6e1c03d-094e-3f3e-bf70-bb9f51bafe27",
                                        "glosses": [
                                            "s chutí"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a083e58-c663-46aa-9767-93b5b42ff459",
                                                "sense_id": "c7c259fe-e955-394a-a369-2b1db4091fe0",
                                                "text": "Bylo mu stále opravovati a kostky vyměňovati. Ba dopouštěl se takových chyb, že se tomu sám divil; a nejednou se chutě zasmál, vida, kterak dal např. kamzíkovi místo růžků paznehty, místo brady ocásek a místo plecí kus skály."
                                            },
                                            {
                                                "example_id": "87805ec6-b077-4557-8476-3f7db85a49e7",
                                                "sense_id": "c7c259fe-e955-394a-a369-2b1db4091fe0",
                                                "text": "Jen bijte, je nás nemnoho, my přece odoláme, jen palte chutě do toho, vždyť ještě srdce máme!"
                                            }
                                        ]
                                    }
                                ]
