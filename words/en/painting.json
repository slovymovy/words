                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>painting</w> the kitchen walls a bright yellow.",
                            "target_lang_translations": {
                                "ru": "Он <w>красит</w> стены кухни в ярко-жёлтый цвет.",
                                "zh": "他正在把厨房的墙壁<w>粉刷</w>成亮黄色。"
                            }
                        },
                        {
                            "text": "The children are <w>painting</w> pictures of their families.",
                            "target_lang_translations": {
                                "ru": "Дети <w>рисуют</w> портреты своих семей.",
                                "zh": "孩子们正在<w>画</w>他们的家人。"
                            }
                        }
                    ],
