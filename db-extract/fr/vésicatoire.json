                                                "sense_id": "9463e728-f758-3ff4-95be-c7786f70deaf",
                                                "text": "„Da seine Seitenstiche durch Blutegel nicht behoben wurden, nahm er seine Zuflucht zu einem Zugpflaster, dessen Wirkung sich auf die Nieren schlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
