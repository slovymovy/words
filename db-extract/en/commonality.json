                        "target_lang_word": "communité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c8af4c8-9470-3723-b554-039a9d93b8d2",
                                        "entry_id": "04ea9591-13a3-33cf-9982-dc521a82ea45",
                                        "glosses": [
                                            "Qualité de ce qui est commun, du point de vue de la conception, de la fabrication et de la maintenance ; l'ensemble de ces caractères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11e123a-b2bd-4103-ad77-adc45f5ef3d4",
                                                "sense_id": "6c8af4c8-9470-3723-b554-039a9d93b8d2",
                                                "text": "La communité, dans le domaine de l'astronautique ou aéronautique, est un ensemble des caractères communs à plusieurs matériels du point de vue de la conception, de la fabrication ou de la maintenance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "994d20c1-b2df-422c-af03-66f671ff96db",
                        "source_entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "source_sense_description": "such shared characteristic",
                        "target_lang_word": "Gemeinsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemeinsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                        "entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                                        "glosses": [
                                            "Eigenschaft, die bei zwei oder mehr Personen oder Gegenständen identisch ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb32ea84-5378-472d-8fce-f0abdc4200bd",
                                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                                "text": "Wir hatten einfach keinerlei Gemeinsamkeiten. Deshalb haben wir uns getrennt."
                                            },
                                            {
                                                "example_id": "56d306a4-8b73-47a5-a7cc-5693a19d8a9d",
                                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                                "text": "Die Vertreter einer Pflanzengattung zeigen meist deutliche morphologische Gemeinsamkeiten."
                                            },
                                            {
                                                "example_id": "d019920d-7911-4838-9b16-698fb9fc1a3f",
                                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                                "text": "„Auch die Biographien von Feuchtwanger und Kisch weisen eine Gemeinsamkeit auf, nämlich ihre Erfahrungen mit dem Exil.“"
                                            },
                                            {
                                                "example_id": "40b1a3d6-8ba7-4410-9557-bd778d952a39",
                                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                                "text": "„Es gab hier eine Gemeinsamkeit der Atmosphäre, wie sie auch von den Einrichtungen und Gesten der Stadt ausging, zu der er nicht gehörte, die ihn aber immer stärker in den Bann zog.“"
                                            },
                                            {
                                                "example_id": "0a96b449-c79c-444b-9cb5-24cfdc0b81af",
                                                "sense_id": "e8e74033-fbac-36ed-8686-1a5234725b91",
                                                "text": "„Die Gemeinsamkeit erschöpft sich auf den ersten Blick im lateinischen Alphabet, dessen einheitsstiftende Kraft durch eine Schriftreform mit der Einführung der karolingischen Minuskel allerdings noch verstärkt wurde, und einigen Merkmalen der zweiten Lautverschiebung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f60855bc-65bc-33ee-a434-d5a2f0d20a8b",
                                        "entry_id": "ddf7ae1b-8577-38a4-96a7-9c3f83272ad3",
                                        "glosses": [
                                            "friedliches, harmonisches Zusammensein von Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "669c3dd9-f7d3-42f1-ab9b-f989f8519bd8",
                                                "sense_id": "f60855bc-65bc-33ee-a434-d5a2f0d20a8b",
                                                "text": "Die beiden lebten in trauter Gemeinsamkeit zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "432472fe-fc1e-4006-b06c-2854d0887736",
                        "source_entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
