                "senses": [
                    {
                        "sense_id": "31da6c0f-f0ba-3b7a-8549-fdff42c340ac",
                        "entry_id": "447f8d39-a661-3af8-be67-128720bbc17e",
                        "glosses": [
                            "Stille, wie sie in einem Grab herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc29d844-9650-4979-9c5a-59d63574025a",
                                "sense_id": "31da6c0f-f0ba-3b7a-8549-fdff42c340ac",
                                "text": "„Seit Sophie verschwunden war, herrschte in dem frauenlosen Hause (denn Tante Praskovia war bestenfalls ein Phantom) die Grabesstille eines Klosters.“"
                            },
                            {
                                "example_id": "82265345-832c-4dbb-8423-a94c23f47364",
                                "sense_id": "31da6c0f-f0ba-3b7a-8549-fdff42c340ac",
                                "text": "„Grabesstille herrschte am folgenden Morgen im Speisesaale des Gasthofes zum Bayou Sarah, wo sich die Gäste soeben zum Frühstücke niederließen, als der Donnerruf ›ein Dampfschiff‹ erschallte.“"
                            },
                            {
                                "example_id": "8ee21ac5-44fe-4e94-942f-0473f79054cd",
                                "sense_id": "31da6c0f-f0ba-3b7a-8549-fdff42c340ac",
                                "text": "„Über Deutschland herrscht Grabesstille, über dem Schutt der Städte, in den verlassenen Wohnvierteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
