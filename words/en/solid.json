                {
                    "sense_id": "05e701ed-d158-3b7a-9e33-4ffea775fd41",
                    "sense_definition": "Written as a single word without any spaces or hyphens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In American English, 'lifestyle' is usually written as a <w>solid</w> word.",
                            "target_lang_translations": {
                                "ru": "В американском английском слово «lifestyle» обычно пишется <w>слитно</w>.",
                                "tr": "Amerikan İngilizcesinde 'lifestyle' kelimesi genellikle <w>bitişik</w> yazılır."
                            }
                        },
                        {
                            "text": "The editor asked me to change the hyphenated term to a <w>solid</w> compound.",
                            "target_lang_translations": {
                                "ru": "Редактор попросил меня заменить термин, пишущийся через дефис, на <w>слитное</w> сложное слово.",
                                "tr": "Editör benden tire ile yazılan terimi <w>bitişik</w> yazılan bir bileşik kelimeyle değiştirmemi istedi."
                            }
                        }
                    ],
                    "synonyms": [
