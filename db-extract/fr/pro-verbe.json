                                "target_senses": [
                                    {
                                        "sense_id": "70f22206-d2dc-3518-bada-b35ab0153149",
                                        "entry_id": "2c7ce66f-cb93-3647-888e-477e4122d2c4",
                                        "glosses": [
                                            "A pro-form used to substitute for a verb or verb phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7adc86-c2d8-477a-abf6-bacada4a64d0",
                                                "sense_id": "70f22206-d2dc-3518-bada-b35ab0153149",
                                                "text": "“They herd cattle, and raise corn, just as we used to do”; i.e., to herd cattle and raise corn. Do is sometimes thus used as a sort of pro-verb to represent an active verb or a phrase."
                                            },
                                            {
                                                "example_id": "e4b86416-21c8-4abd-9c80-759b587b2027",
                                                "sense_id": "70f22206-d2dc-3518-bada-b35ab0153149",
                                                "text": "The pro-verb do is like a pronoun; just as a pronoun replaces the entire NP, the pro-verb replaces an entire VP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
