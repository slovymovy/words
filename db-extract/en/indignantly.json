                                            {
                                                "example_id": "6232408c-123e-45af-aff1-37bfb2653fb8",
                                                "sense_id": "45e27904-0d0d-38f8-8337-001045a30dce",
                                                "text": "Ich war zutiefst empört über die Frechheit der Schüler."
                                            },
                                            {
                                                "example_id": "7ff57793-da5e-4a0e-8fd9-967cb2046744",
                                                "sense_id": "45e27904-0d0d-38f8-8337-001045a30dce",
                                                "text": "Empört verließ er das Gebäude, nachdem ihm lauter Vorwürfe gemacht wurden."
                                            },
                                            {
                                                "example_id": "c41ce6c0-2cbb-4787-bd24-98a84b36ca01",
                                                "sense_id": "45e27904-0d0d-38f8-8337-001045a30dce",
                                                "text": "Kommentar: Empört Euch? - Kurz bevor sich die Weltelite in Davos trifft, provoziert Oxfam einen Aufreger: Die reichsten 62 Menschen haben zusammen so viel Vermögen wie die ärmere Hälfte der Weltbevölkerung. Lohnt Empörung, fragt Vanessa Fischer?"
                                            },
                                            {
                                                "example_id": "4636a0e9-0c63-470d-a38d-b106af2a5f47",
                                                "sense_id": "45e27904-0d0d-38f8-8337-001045a30dce",
                                                "text": "Eine Steuer auf Internet-Nutzung? Das trieb empörte Gegner zu Tausenden auf Ungarns Straßen. Jetzt zeigen die Proteste Wirkung: Die Regierung Orbán zieht ihre Steuer-Pläne zurück."
                                            },
                                            {
                                                "example_id": "4cc69fa2-4f49-4579-854d-efb2b122ed4f",
                                                "sense_id": "45e27904-0d0d-38f8-8337-001045a30dce",
                                                "text": "Die Unterstützer der beiden Angeklagten im Gerichtssaal reagierten empört auf den Ausschluss der Öffentlichkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
