                "senses": [
                    {
                        "sense_id": "7e63d9e9-0242-3ea4-981a-63de20a96e0d",
                        "entry_id": "778f780f-e215-3acc-8787-234580dd5c5a",
                        "glosses": [
                            "beschuldigende, vermanende preek of toespraak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "315c60ee-6e43-4bb7-9856-e0d791092620",
                                "sense_id": "7e63d9e9-0242-3ea4-981a-63de20a96e0d",
                                "text": "Op 10 augustus 1566 preekte Sebastiaan Matte een opruiend sermoen in Steenvoorde, een stadje op het Vlaamse platteland, bij de grens met Frankrijk."
                            },
                            {
                                "example_id": "98d6e52e-d704-458e-ad42-b654068465c6",
                                "sense_id": "7e63d9e9-0242-3ea4-981a-63de20a96e0d",
                                "text": "Toen ze met haar wijsvinger, met een doekje erom gewonden, op het portier wilde schrijven 'Ik ben een viezerik', beende ik boos naar buiten. Dat had ik natuurlijk niet moeten doen. Ik kreeg een sermoen van een half uur over verantwoordelijkheid, burenhulp, en de samenhang tussen mijn auto en mijn denken. 'Wie zo smerig is, denkt ook vies!'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bb96adb-6cf5-48e1-ab45-be5b757c50d7",
                        "source_entry_id": "778f780f-e215-3acc-8787-234580dd5c5a",
                        "source_sense_id": "7e63d9e9-0242-3ea4-981a-63de20a96e0d",
                        "source_sense_description": "beschuldigende, vermanende preek of toespraak",
                        "target_lang_word": "sermon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To discourse to or of, as in a sermon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3bf762-d23c-4472-8894-7e4066cb51e0",
                                                "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                                "text": "January 23 1583, Edmund Spenser, letter to Walter Raleigh\nTo some I know this methode will seem displeasaunt, which had rather have good discipline delivered plainly in way of precepts, or sermoned at large, as they use, then thus clowdily enwrapped in allegorical devises"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To tutor; to lecture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3368e2-c273-4024-9d00-841f3e850449",
                                                "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                                "text": "Come, sermon me no further."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "Religious discourse; a written or spoken address on a religious or moral matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c313a5-8464-4bac-88f3-6db45f027d69",
                                                "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdec74ea-8b19-36e5-8c06-7e5782a5d89a",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "A lengthy speech of reproval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
