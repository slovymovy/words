                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d7e067f3-c9a8-4be4-8d69-38ce0b8c237c",
                        "entry_id": "40bc0816-c3c7-3d34-93da-856eb8619fa4",
