                "senses": [
                    {
                        "sense_id": "e02d2ebb-bf07-35ee-ab4c-b5faf9280ee4",
                        "entry_id": "15698799-df65-3169-9b75-78aaf123b1bd",
                        "glosses": [
                            "zeitlicher Abschnitt im Leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "177d48d0-4eaf-4c58-9967-26afcc9df5b2",
                                "sense_id": "e02d2ebb-bf07-35ee-ab4c-b5faf9280ee4",
                                "text": "„In den verschiedenen Lebensphasen hatte ich Gewohnheiten, ohne die ich nicht sein konnte, bis ich merkte, daß eine Abhängigkeit bestand.“"
                            },
                            {
                                "example_id": "911a7b56-db20-4b1a-aa02-ed5ae5fb1c2e",
                                "sense_id": "e02d2ebb-bf07-35ee-ab4c-b5faf9280ee4",
                                "text": "„Sie übersprangen ein paar Lebensphasen, oder sagen wir besser, sie genossen ihre Jugend in vollen Zügen.“"
                            },
                            {
                                "example_id": "94f1006a-ab83-4090-b5a7-426574f5b008",
                                "sense_id": "e02d2ebb-bf07-35ee-ab4c-b5faf9280ee4",
                                "text": "„Vor langer Zeit, in meiner freiesten Lebensphase, hatte ich sechs Jahre lang am Stück in Afrika als Lehrer gearbeitet.“"
                            },
                            {
                                "example_id": "7b613d78-7fa2-48c3-b492-25b0efabd705",
                                "sense_id": "e02d2ebb-bf07-35ee-ab4c-b5faf9280ee4",
                                "text": "„Der Kriegsbeginn markiert für Jünger 1914 indes nicht allein eine neue Lebensphase, damit einher geht die allmähliche und stufenweise erfolgende, nach dem Waffenstillstand vom 11. November 1918 noch entscheidend beschleunigte Entwicklung zum Schriftsteller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
