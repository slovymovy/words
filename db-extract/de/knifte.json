                "senses": [
                    {
                        "sense_id": "68c87836-590e-3332-bb15-93a29fb45fa3",
                        "entry_id": "3fa0c2f1-e13e-3376-ad03-68022db286f8",
                        "glosses": [
                            "belegte Brotscheibe; Butterbrot"
                        ],
                        "tags": [
                            "westmitteldeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "22da8a61-e36c-4ee7-aafc-4444feaad816",
                                "sense_id": "68c87836-590e-3332-bb15-93a29fb45fa3",
                                "text": "Ich werde mir mal eine Knifte reindrehen."
                            },
                            {
                                "example_id": "8180c0f7-a5b7-4654-8389-03d54d8fba45",
                                "sense_id": "68c87836-590e-3332-bb15-93a29fb45fa3",
                                "text": "Wenn Du Hunger hast, mach dir eine Knifte."
                            },
                            {
                                "example_id": "62576c3d-d5f2-4be9-b15d-7f7853006222",
                                "sense_id": "68c87836-590e-3332-bb15-93a29fb45fa3",
                                "text": "Es gab jeden Abend nur Kniften."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5923f81-cee7-3b53-807e-48ca02d0d47e",
                        "entry_id": "3fa0c2f1-e13e-3376-ad03-68022db286f8",
                        "glosses": [
                            "Handfeuerwaffe"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a1546eb-7621-48c1-8be6-fa64677ecda0",
                                "sense_id": "a5923f81-cee7-3b53-807e-48ca02d0d47e",
                                "text": "Er zog die Knifte und drückte ab."
                            },
                            {
                                "example_id": "bc4ed70f-1958-48e6-8a4d-05c5dbc6d6b4",
                                "sense_id": "a5923f81-cee7-3b53-807e-48ca02d0d47e",
                                "text": "Diese Knifte ist im Schützenverein sehr beliebt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f103841-ce52-4903-9591-67f9c78e62f1",
                        "source_entry_id": "3fa0c2f1-e13e-3376-ad03-68022db286f8",
                        "source_sense_id": "68c87836-590e-3332-bb15-93a29fb45fa3",
                        "source_sense_description": "westmitteldeutsch: belegte Brotscheibe; Butterbrot",
                        "target_lang_word": "tartine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tartine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2767d8-5c5f-3a33-95b0-60387372ed4f",
                                        "entry_id": "2fb41bb2-3706-347b-aa98-71fbd069868e",
                                        "glosses": [
                                            "Tranche de pain sur laquelle on a étalé, par exemple, du beurre ou de la confiture, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0cc1c7-1350-46fa-879c-96e60d12d858",
                                                "sense_id": "1c2767d8-5c5f-3a33-95b0-60387372ed4f",
                                                "text": "Grandet tira de son gousset un couteau de corne à grosse lame, coupa une tartine, prit un peu de beurre, l’étendit soigneusement, et se mit à manger debout."
                                            },
                                            {
                                                "example_id": "f98b30c8-3d6f-4418-b6a1-9bc968678e87",
                                                "sense_id": "1c2767d8-5c5f-3a33-95b0-60387372ed4f",
                                                "text": "J’accoudais à l’une ou l’autre fenêtre une mélancolie, un dédain tous deux feints, à l’heure où les petites Blancvillain et les Trinitet passaient, mordant leur tartine de quatre heures, épaissie de haricots rouges figés dans une sauce au vin."
                                            },
                                            {
                                                "example_id": "60e5feb6-6c69-4699-9e52-7d65933b5fb1",
                                                "sense_id": "1c2767d8-5c5f-3a33-95b0-60387372ed4f",
                                                "text": "« – Leurs pères ont beaucoup d’argent. Il y en a un qui s’appelle Picot et il est tellement riche que tous les matins, sur ses tartines, il met du beurre des deux côtés. »"
                                            },
                                            {
                                                "example_id": "2cbfcfb5-8839-495b-b532-baf950acbd58",
                                                "sense_id": "1c2767d8-5c5f-3a33-95b0-60387372ed4f",
                                                "text": "Elle doit se faire chier à lui toaster les tartines de son petit-déjeuner avant même que le réveil ne sonne, puis à enquiller sur le ménage […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a7d3a87-64c6-3f2a-909c-6f7327d0e6ff",
                                        "entry_id": "2fb41bb2-3706-347b-aa98-71fbd069868e",
                                        "glosses": [
                                            "Désigne un long texte, un long message, développement banal, ennuyeux et languissant, etc."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b055ca-b6f0-43f9-a9e1-48fe5118f0ef",
                                                "sense_id": "7a7d3a87-64c6-3f2a-909c-6f7327d0e6ff",
                                                "text": "Lucien dut subir de la part du bon Gauthier ce que les jeunes gens de Paris appellent une tartine sur l’Amérique, la démocratie, les préfets choisis forcément par le pouvoir central parmi les membres des conseils généraux, etc."
                                            },
                                            {
                                                "example_id": "fc66b1cd-5423-4633-8e30-319ca28c0755",
                                                "sense_id": "7a7d3a87-64c6-3f2a-909c-6f7327d0e6ff",
                                                "text": "Après tout, on devrait pouvoir écrire des tartines sur la société anglaise pour dénoncer la glorification du Lapinou anglais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dc7b952-e3e8-352e-86f7-2362914e8fc2",
                                        "entry_id": "2fb41bb2-3706-347b-aa98-71fbd069868e",
                                        "glosses": [
                                            "Présentation surabondante et ostentatoire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad6d149-431b-44bb-9de0-c8db8178e500",
                                                "sense_id": "7dc7b952-e3e8-352e-86f7-2362914e8fc2",
                                                "text": "Jean-Marc luttait contre une sourde indignation devant cette fortune étalée en tartines du vestibule aux chambres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfb897c-96ef-395c-9377-047eb90c7ba2",
                                        "entry_id": "2fb41bb2-3706-347b-aa98-71fbd069868e",
                                        "glosses": [
                                            "Éditorial en première page d’un journal."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06c2b86-ee68-410c-af5b-ca75ac47374d",
                                                "sense_id": "1cfb897c-96ef-395c-9377-047eb90c7ba2",
                                                "text": "On appelle Premier-Paris, la tartine qui doit se trouver en tête d’une feuille publique, tous les jours, et sans laquelle il paraît que, faute de cette nourriture, l’intelligence des abonnés maigrirait."
                                            },
                                            {
                                                "example_id": "181cb870-960d-4468-acc5-0dad47ea55ae",
                                                "sense_id": "1cfb897c-96ef-395c-9377-047eb90c7ba2",
                                                "text": "Dans l’argot journalistique du temps, le Premier Paris se nomme la tartine et son auteur le tartinier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9fea69f-46e0-3f64-9b0b-78dde46f2ac9",
                                        "entry_id": "2fb41bb2-3706-347b-aa98-71fbd069868e",
                                        "glosses": [
                                            "Petite tarte, dans le sens de claque."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b07422-0bdb-4782-8b33-d2c5e1aaa994",
                                                "sense_id": "a9fea69f-46e0-3f64-9b0b-78dde46f2ac9",
                                                "text": "« Bon ben je vous préviens, je vous écoute 30 secondes pas une de plus. Si il y a un mot plus haut que l’autre, je vous mets toute la tartine dans la gueule et je rentre chez moi, j’ai pas que ça à glander. »"
                                            }
                                        ]
                                    }
                                ]
                            },
