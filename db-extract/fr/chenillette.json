            {
                "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                "word": "chenillette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ac647ea-6391-4346-aa4e-90c3901cca02",
                        "entry_id": "18c173e8-fabb-3d43-b240-cc30c7db299c",
                        "tags": [
                            "plural"
