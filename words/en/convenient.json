{
    "word_family": [
        "convenience",
        "conveniently",
        "inconvenience",
        "inconvenient"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "185971d0-899d-3131-84cd-6ef86e56f114",
                    "sense_definition": "Serving to reduce a difficulty or accessible with minimum effort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel is in a very <w>convenient</w> location near the train station.",
                            "target_lang_translations": {
                                "ru": "Отель находится в очень <w>удо́бном</w> месте рядом с железнодорожным вокзалом.",
                                "zh": "这家酒店位置非常<w>方便</w>，靠近火车站。"
                            }
                        },
                        {
                            "text": "Please choose a <w>convenient</w> time for us to have a meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выберите <w>удо́бное</w> время для нашей встречи.",
                                "zh": "请选一个我们开会<w>方便</w>的时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "easy",
                        "handy",
                        "useful"
                    ],
                    "antonyms": [
                        "inconvenient"
                    ],
                    "common_phrases": [
                        "convenient location",
                        "convenient time",
                        "very convenient",
                        "convenient way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помогающий избежать трудностей или доступный с минимальными усилиями.",
                        "zh": "指使用起来省力、方便，或位置、时间等容易接近、安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удо́бный",
                                "target_lang_sense_clarification": "наиболее распространенный вариант для обозначения комфорта или легкости доступа"
                            },
                            {
                                "target_lang_word": "подходя́щий",
                                "target_lang_sense_clarification": "используется, когда речь идет о выборе времени или места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方便",
                                "target_lang_sense_clarification": "指做事容易，不费力或时间、地点合适"
                            },
                            {
                                "target_lang_word": "便利",
                                "target_lang_sense_clarification": "指设施或交通等条件优越，易于使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9739976-ff2c-316c-90de-018476a1dc92",
                    "sense_definition": "Suspiciously timely or helpful in a way that serves someone's specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It seems a little too <w>convenient</w> that the evidence went missing right before the trial.",
                            "target_lang_translations": {
                                "ru": "Выглядит подозрительно <w>кстати</w>, что улики исчезли прямо перед судом.",
                                "zh": "证据在审判前夕消失，这看起来未免太<w>凑巧</w>了。"
                            }
                        },
                        {
                            "text": "How <w>convenient</w> that you forgot your wallet when the bill arrived.",
                            "target_lang_translations": {
                                "ru": "Как <w>кстати</w>, что ты забыл кошелек, когда принесли счет.",
                                "zh": "账单一来你就忘了带钱包，真是太<w>凑巧</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "how convenient",
                        "too convenient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подозрительно своевременный или полезный для достижения чьих-то целей.",
                        "zh": "指事情发生得过于巧合，往往带有讽刺意味，暗示某人从中获利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кстати",
                                "target_lang_sense_clarification": "используется в ироничном контексте, когда что-то происходит подозрительно вовремя"
                            },
                            {
                                "target_lang_word": "вы́годный",
                                "target_lang_sense_clarification": "подчеркивает, что ситуация служит чьим-то интересам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凑巧",
                                "target_lang_sense_clarification": "指事情发生得非常巧合，常用于讽刺"
                            },
                            {
                                "target_lang_word": "有利",
                                "target_lang_sense_clarification": "指情况的发展对某人特别有好处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65da34b-f124-3b41-9dfb-3678afcc9538",
                    "sense_definition": "Fit, suitable, or appropriate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king sought a marriage alliance that was <w>convenient</w> to the interests of the state.",
                            "target_lang_translations": {
                                "ru": "Король искал брачный союз, который был <w>соотве́тствующим</w> интересам государства.",
                                "zh": "国王寻求一种对国家利益<w>适宜</w>的联姻。"
                            }
                        },
                        {
                            "text": "Such rude behavior is not <w>convenient</w> for a person of your high standing.",
                            "target_lang_translations": {
                                "ru": "Такое грубое поведение не <w>уме́стно</w> для человека вашего высокого положения.",
                                "zh": "如此粗鲁的行为对于你这样身份高贵的人来说并不<w>得体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expedient"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'suitable' or 'appropriate' instead"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий, соответствующий или уместный.",
                        "zh": "指符合某种要求、利益或场合，即得体或适宜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уме́стный",
                                "target_lang_sense_clarification": "соответствующий обстоятельствам или нормам поведения"
                            },
                            {
                                "target_lang_word": "соотве́тствующий",
                                "target_lang_sense_clarification": "отвечающий определенным требованиям или интересам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适宜",
                                "target_lang_sense_clarification": "指符合某种条件或需要"
                            },
                            {
                                "target_lang_word": "得体",
                                "target_lang_sense_clarification": "指言行举止符合身份或场合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}