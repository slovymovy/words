                "senses": [
                    {
                        "sense_id": "1bf1ae61-a4cc-3248-8755-68decf24d6c6",
                        "entry_id": "c0adc513-d449-3c07-aeec-2d867cc4769f",
                        "glosses": [
                            "Donner un caractère vierzonnais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8a3fb9-0aad-469e-b7b6-05797abaebfc",
                                "sense_id": "1bf1ae61-a4cc-3248-8755-68decf24d6c6",
                                "text": "Et toi, pendant ce temps-là, tu peaufinais ton art en vierzonnant Vesoul, en vesoulant Vierzon, en Anversant Honfleur, en honfleurisant Dutronc."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b7454de-306b-3b3a-8b58-c8e0c80c2aeb",
                        "entry_id": "c0adc513-d449-3c07-aeec-2d867cc4769f",
                        "glosses": [
                            "Vivre à Vierzon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8423d019-42b0-4712-a0ac-84fe58522c2b",
                                "sense_id": "9b7454de-306b-3b3a-8b58-c8e0c80c2aeb",
                                "text": "Je continue à Vierzonner."
                            },
                            {
                                "example_id": "732a48ec-ec21-400a-81e1-2625d417697f",
                                "sense_id": "9b7454de-306b-3b3a-8b58-c8e0c80c2aeb",
                                "text": "On l'a toujours connu ce cochon de bâtiment qui ne veut plus rien dire aujourd'hui, certes, mais qui aimante encore une certaine façon de Vierzonner."
                            }
                        ]
                    }
