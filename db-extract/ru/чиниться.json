                "senses": [
                    {
                        "sense_id": "9e069d24-e4da-3d5b-9da1-45a4280b90e5",
                        "entry_id": "da70d8f4-c73b-36e9-87ac-902582360c33",
                        "glosses": [
                            "страд. к чинить; ремонтироваться; чинить свои вещи"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "1624ac7c-94ea-488c-a5d9-0816886f7710",
                                "sense_id": "9e069d24-e4da-3d5b-9da1-45a4280b90e5",
                                "text": "Некоторые корабли лежат почти на боку и чинятся."
                            },
                            {
                                "example_id": "7ee69cef-295d-4b17-abe2-5c8d6213e81d",
                                "sense_id": "9e069d24-e4da-3d5b-9da1-45a4280b90e5",
                                "text": "Так как мост чинился, то нам пришлось идти пешком, в то время как государь переехал Дунай на катере."
                            }
                        ]
                    }
                ],
