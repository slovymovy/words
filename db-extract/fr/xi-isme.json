                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xiism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ead11bdb-5c05-3cb1-bbf9-5a7d9193b373",
                                        "entry_id": "b005f643-596c-36bf-b0fd-8957d09c1612",
                                        "glosses": [
                                            "The political philosophy practised by Xi Jinping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c724f16-9550-4177-b1fa-8d4300cea8e5",
                                                "sense_id": "ead11bdb-5c05-3cb1-bbf9-5a7d9193b373",
                                                "text": "Could language be introduced into the party charter that subsequent generations might look back on and identify as the early precursors for something grander, say the eventual adoption of a new \"-ism\" (say, \"Xi-ism\" with Confucian characteristics) at a future Party Congress?"
                                            },
                                            {
                                                "example_id": "43cf89af-92fa-491b-9ffd-e46924494f19",
                                                "sense_id": "ead11bdb-5c05-3cb1-bbf9-5a7d9193b373",
                                                "text": "Based on a Gramscian analytical framework inspired by Bob Jessop, this article provides an anatomy of Xiism (2012–) as an emergent hegemonic project"
                                            },
                                            {
                                                "example_id": "3257d126-5af0-429a-851b-de9c2000c436",
                                                "sense_id": "ead11bdb-5c05-3cb1-bbf9-5a7d9193b373",
                                                "text": "Whether Xiism represents an updating of Maoism, reflection of a contemporary “populist” moment in global politics, or both is another question of clear relevance to the analysis of charismatic leadership in the current and likely future setting."
                                            },
                                            {
                                                "example_id": "8ecf7b8a-6ee2-45e0-809b-3a5b18d5083e",
                                                "sense_id": "ead11bdb-5c05-3cb1-bbf9-5a7d9193b373",
                                                "text": "Xiism constitutes an ideology defined entirely by the metric of the Chinese struggle for greatness in the existing world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
