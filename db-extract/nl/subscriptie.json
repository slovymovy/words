                                        "glosses": [
                                            "meist durch Vorauszahlung gesichertes Anrecht auf (meist) regelmäßige Inanspruchnahme bestimmter Leistungen oder Waren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4d11df-e5c4-48e3-b222-d5c38813b130",
                                                "sense_id": "de410d65-b6b2-31f7-ac15-2c888ced5d88",
                                                "text": "Zähle mal all deine Abonnements auf!"
                                            },
                                            {
                                                "example_id": "6bdccb28-bd9a-4dc9-8c48-d746194dda60",
                                                "sense_id": "de410d65-b6b2-31f7-ac15-2c888ced5d88",
                                                "text": "Ich muss mein Abonnement verlängern, da es demnächst erlischt."
                                            },
                                            {
                                                "example_id": "d8c0cf9c-78de-40c8-97e4-cc84c2478069",
                                                "sense_id": "de410d65-b6b2-31f7-ac15-2c888ced5d88",
                                                "text": "„Da Eduard sonntags das Abonnement gesperrt hat, ist das sogar ein hervorrragender Ausweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
