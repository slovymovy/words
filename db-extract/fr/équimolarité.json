                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc82b23c-38cd-3dbc-9cbe-610313970d02",
                        "entry_id": "38fb0783-c572-362d-8a1b-fdf49047be04",
                        "glosses": [
                            "Propriété des corps chimiques présentant la même concentration molaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760a127b-dc3f-4055-b3ce-5b4d6bd20e5c",
                                "sense_id": "fc82b23c-38cd-3dbc-9cbe-610313970d02",
                                "text": "Enfin, il faudrait, dans cette perspective, tenir compte encore de la dissociation du complexe métachromatique dont le coefficient expliquerait que le maximum métachromatique ne soit pas obtenu pour l’équimolarité des constituants."
                            },
                            {
                                "example_id": "0666956d-d692-41ed-846f-43f3b228f178",
                                "sense_id": "fc82b23c-38cd-3dbc-9cbe-610313970d02",
                                "text": "Dans les systèmes catanioniques classiques, une plus ou moins large zone de précipité est généralement présente à température ambiante autour de l’équimolarité."
                            },
                            {
                                "example_id": "96ba9f54-a51a-4140-b28b-a0d796a51fc2",
                                "sense_id": "fc82b23c-38cd-3dbc-9cbe-610313970d02",
                                "text": "De plus, la formule chimique du bleu égyptien nous démontre l’équimolarité des atomes de cuivre et de calcium."
                            }
                        ]
                    }
