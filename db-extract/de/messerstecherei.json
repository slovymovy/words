                    {
                        "sense_id": "c4a0231e-dff3-31b0-9571-da3a4eda54b0",
                        "entry_id": "857174be-810b-33cf-9664-7fa83e084f48",
                        "glosses": [
                            "Kampf mit jemandem oder Angriff auf jemanden, bei dem mit einem Messer zugestochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af0cb6dc-3546-4ad7-ab6e-05d4d2988a52",
                                "sense_id": "c4a0231e-dff3-31b0-9571-da3a4eda54b0",
                                "text": "Vor der Diskothek kam es gestern zu einer Messerstecherei."
                            },
                            {
                                "example_id": "07d16b69-4617-49f8-a697-b55347aa584f",
                                "sense_id": "c4a0231e-dff3-31b0-9571-da3a4eda54b0",
                                "text": "„Es dauerte nicht lange, und wir wurden zu einer Messerstecherei im Zentrum gerufen.“"
                            },
                            {
                                "example_id": "971f4657-92be-4ee6-b083-f79e5e1cd2c2",
                                "sense_id": "c4a0231e-dff3-31b0-9571-da3a4eda54b0",
                                "text": "„Ein paar Tage später gab es Prügeleien zwischen den Parlamentariern, die sogar in Messerstechereien ausarteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
