                        "examples": [
                            {
                                "example_id": "ac62edf5-c604-43b9-82e5-0cee005ef71f",
                                "sense_id": "059bab77-b78c-3422-b8cd-079095a07dca",
                                "text": "Les deux frères payaient ainsi l’agression d’un chauffeur de bus à Angoulême où un jet de lacrymo et des coups avaient été échangés."
                            },
                            {
                                "example_id": "57f8ee53-a95e-41a3-b4a2-1c2a850efa79",
                                "sense_id": "059bab77-b78c-3422-b8cd-079095a07dca",
                                "text": "Quand j'irais au manifs antifa tu seras parmi ceux qui nous balancent des lacrymo !"
                            },
                            {
                                "example_id": "d7ceb340-e54d-4f30-9a1a-0a90d4b39f77",
                                "sense_id": "059bab77-b78c-3422-b8cd-079095a07dca",
                                "text": "Le vent souffle dans leur direction et ce sont eux qui récupèrent les lacrymos qu’ils nous balancent."
                            }
                        ]
                    }
