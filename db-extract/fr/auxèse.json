                                        "entry_id": "0d1aff31-f651-3139-aa17-8b9ec9ff7638",
                                        "glosses": [
                                            "A rhetorical device whereby the subject matter is made greater, particularly",
                                            "Overstatement, hyperbole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be4876ac-0217-4065-a518-638f5c3f93f9",
                                                "sense_id": "30e97d90-a81f-34d0-a545-3b1bc1b2855f",
                                                "text": "Avxesis, when we vse a greater word for a lesse, or thus, when the word is greater then the thing is in deede."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdab39fe-76d2-3d3d-a5e6-34b6602e8575",
                                        "entry_id": "0d1aff31-f651-3139-aa17-8b9ec9ff7638",
                                        "glosses": [
                                            "A rhetorical device whereby the subject matter is made greater, particularly",
                                            "Arrangement of a series in ascending order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9062c00-7f46-33b1-ba5a-f4a74ba2e8aa",
                                        "entry_id": "0d1aff31-f651-3139-aa17-8b9ec9ff7638",
                                        "glosses": [
                                            "Biological growth, (now usually restricted to) expansion or growth of an organism apart from that due to cellular division."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911b8185-1858-45dd-ac0e-bf3cba2e353f",
                                                "sense_id": "e9062c00-7f46-33b1-ba5a-f4a74ba2e8aa",
                                                "text": "Auxesis, augmentation, increase."
                                            },
                                            {
                                                "example_id": "0cf62042-69a8-4bef-a918-5306b872eb47",
                                                "sense_id": "e9062c00-7f46-33b1-ba5a-f4a74ba2e8aa",
                                                "text": "Botanists do still distinguish between auxesis or growth by expansion, and merisis or growth by cell-multiplication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8eed719-1ec1-35ef-b6c3-4e45778b53f6",
