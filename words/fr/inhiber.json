    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b93166c1-7d7e-3521-aa52-2c0b0047e8d3",
                    "sense_definition": "Ralentir, bloquer ou restreindre une action, une faculté psychologique ou un comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La peur excessive peut <w>inhiber</w> les capacités de réflexion lors d'un examen important."
                        },
                        {
                            "text": "Sa grande timidité l'<w>inhibe</w> dès qu'elle doit s'exprimer devant un large public."
                        }
                    ],
                    "synonyms": [
                        "freiner",
                        "bloquer",
                        "entraver",
                        "paralyser"
                    ],
                    "antonyms": [
                        "désinhiber"
                    ],
                    "common_phrases": [
                        "inhiber l'action"
                    ]
                },
                {
                    "sense_id": "c49cdb8b-34f6-37ad-bfe3-60074db3dcef",
                    "sense_definition": "Ralentir ou empêcher un processus biologique, physiologique ou une réaction chimique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament permet d'<w>inhiber</w> la prolifération des cellules malades dans l'organisme."
                        },
                        {
                            "text": "La molécule <w>inhibe</w> efficacement l'activité de cette enzyme digestive."
                        }
                    ],
                    "synonyms": [
                        "neutraliser",
                        "bloquer"
                    ],
                    "common_phrases": [
                        "inhiber une enzyme",
                        "inhiber la sécrétion"
                    ]
                },
                {
                    "sense_id": "f8f10e90-fa7e-35dd-8e48-84186a5f5d6e",
                    "sense_definition": "Défendre expressément ou prohiber par voie de justice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interdiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal lui <w>inhiba</w> formellement d'entreprendre des travaux sur le terrain disputé."
                        },
                        {
                            "text": "Une ancienne ordonnance <w>inhibait</w> tout commerce sans l'autorisation préalable du roi."
                        }
                    ],
                    "synonyms": [
