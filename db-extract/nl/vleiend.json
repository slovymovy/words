                                        "glosses": [
                                            "Free; provided at no charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a75dce8-c5f9-40ec-911d-664e8bf3be46",
                                                "sense_id": "db4d22a7-fcf2-37f0-be04-c2e98f7ea78e",
                                                "text": "complimentary drinks"
                                            },
                                            {
                                                "example_id": "8968eaee-125a-4e65-beea-75bd65eefa1c",
                                                "sense_id": "db4d22a7-fcf2-37f0-be04-c2e98f7ea78e",
                                                "text": "In the evenings, Ward and PJ offer guests a complimentary drink. This gesture seems to reinforce the hosts' desire to make everyone feel welcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30dd974b-f485-338e-a41b-8595f0f8f00b",
                                        "entry_id": "98f26e82-ca98-32e4-92a8-3db5c0aec3e2",
                                        "glosses": [
                                            "With respect to the closing of a letter, formal and professional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a77f7a-b254-408e-b944-e8efa7556419",
                                                "sense_id": "30dd974b-f485-338e-a41b-8595f0f8f00b",
                                                "text": "The complimentary closing is the word grouping used to bring the message or text to a close."
                                            }
