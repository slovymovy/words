                    },
                    {
                        "sense_id": "c7cdcf25-74b5-371b-93af-28007c99def6",
                        "entry_id": "2d5a3ac5-566f-383c-9157-a3642df548b2",
                        "glosses": [
                            "The residence of a female religious community, a monastery for nuns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7134328-0835-4482-b7dd-f74a8308fa84",
                                "sense_id": "c7cdcf25-74b5-371b-93af-28007c99def6",
                                "text": "Get thee to a nunnery, why wouldst thou be a breeder of sinners?"
                            }
                        ]
                    },
                    {
                        "sense_id": "34eeafa3-d0f5-3476-bf72-c16a6f78d431",
                        "entry_id": "2d5a3ac5-566f-383c-9157-a3642df548b2",
                        "glosses": [
                            "Synonym of brothel."
                        ],
                        "tags": [
                            "humorous",
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "93e4e91d-a5a8-4f68-81fd-7426c46085ae",
                                "sense_id": "34eeafa3-d0f5-3476-bf72-c16a6f78d431",
                                "text": "[To] some one Gentleman generally acquainted, they giue... free priuiledge thenceforward in theyr Nunnery, to procure them frequentance..."
                            },
                            {
                                "example_id": "e14fc15b-53f2-4ade-a81d-5549643a99bc",
                                "sense_id": "34eeafa3-d0f5-3476-bf72-c16a6f78d431",
                                "text": "To the antipapist Tudors nunnery was a slang term for a brothel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84a2762f-a969-45bd-87cc-8d186767dcf9",
                        "source_entry_id": "2d5a3ac5-566f-383c-9157-a3642df548b2",
                        "source_sense_description": "residence for nuns",
                        "target_lang_word": "nonnenklooster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonnenklooster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "43da2d2e-a120-3493-9c35-bfcf0d87d072",
                                        "entry_id": "1318cba6-a852-30ff-bdaf-8df25597bb73",
                                        "glosses": [
                                            "klooster voor vrouwen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad208062-1a45-4880-9567-68fd40cb6e36",
                                                "sense_id": "43da2d2e-a120-3493-9c35-bfcf0d87d072",
                                                "text": "Voor het Franse Rode Kruis repatrieerde zij na de oorlog Fransen uit Polen en stuitte ze bij toeval op een nonnenklooster waar Sovjetsoldaten gruwelijk hadden huisgehouden: twintig nonnen waren vermoord en vijfentwintig verkracht, vaak tientallen malen. Vijf nonnen waren zwanger en ervoeren dat als een schande. Madeleine hielp ze zo discreet mogelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5253b99a-8558-4031-a044-8f2488976b11",
                        "source_entry_id": "2d5a3ac5-566f-383c-9157-a3642df548b2",
                        "source_sense_description": "residence for nuns",
                        "target_lang_word": "couvent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couvent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                        "entry_id": "43263d39-ebed-30c0-b039-d4bb5d2af805",
                                        "glosses": [
                                            "Maison dans laquelle des religieux ou des religieuses vivent en commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f3754af-aa86-42d2-acbd-d022b8451502",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "Les poules du couvent couvent."
                                            },
                                            {
                                                "example_id": "69b6dffb-224a-42c1-86da-cd07aff0a04d",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "Accoutumées à la vie du couvent, elles n’en pouvaient plus concevoir d’autre. Un matin, leurs grilles ayant été brisées, elles avaient frémi de se trouver libres."
                                            },
                                            {
                                                "example_id": "fccd0406-99d7-47fc-9280-baf0b0ba4f46",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "[…] Rinaldi expliquait si gaiement comme quoi, son père le destinant à la moinaille, on l’avait enfermé en un couvent d’où il s’était enfui, un beau jour, avec la caisse de l’économe, la nièce de l’abbé et une douzaine de mots latins dans la cervelle pour tout bagage […]"
                                            },
                                            {
                                                "example_id": "4935534c-412f-4d80-acea-cc8d8cf9ac37",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "Les valeurs auxquelles le monde contemporain tient le plus et qu’il considère comme les vraies valeurs de vertu, ne se réalisent pas dans les couvents, mais dans la famille […]"
                                            },
                                            {
                                                "example_id": "02744209-5a05-4f65-a6e0-8abc0cd84074",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "Je quitte le lieutenant licencié et regagne le couvent, où la sœur converse m’annonce qu’un ami est venu me demander."
                                            },
                                            {
                                                "example_id": "218ced83-5cba-4137-9dbe-00ba10d2432c",
                                                "sense_id": "98e224a4-0f58-3c86-a485-db750b1efa87",
                                                "text": "La vermine des catacombes s’épanouissait lentement au soleil ; les couvents et monastères champignonnaient, rongeant le sol gaulois comme une lèpre hideuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8590cf19-8907-3e08-a500-f72c11cc6d0e",
                                        "entry_id": "43263d39-ebed-30c0-b039-d4bb5d2af805",
                                        "glosses": [
                                            "Ensemble des religieux ou des religieuses qui sont dans une même communauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2807fd9c-80a6-4f45-8f70-676620dfad97",
                                                "sense_id": "8590cf19-8907-3e08-a500-f72c11cc6d0e",
                                                "text": "C’est un couvent bien réglé. - Tout le couvent s’assembla pour l’élection de l’abbesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37da0dcd-2df3-3b8e-9906-289d838f06dd",
                                        "entry_id": "43263d39-ebed-30c0-b039-d4bb5d2af805",
                                        "glosses": [
                                            "Maison d’éducation dirigée par des religieuses."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07cb72aa-f07e-4db1-ab85-5bcabc9df02c",
                                                "sense_id": "37da0dcd-2df3-3b8e-9906-289d838f06dd",
                                                "text": "Ainsi que nous l’avons dit, doña Luz avait été élevée dans un couvent, sur le seuil duquel venaient sans écho mourir les bruits du monde."
                                            },
                                            {
                                                "example_id": "cf0e6c9c-d4cc-485c-9524-10d24e876d1b",
                                                "sense_id": "37da0dcd-2df3-3b8e-9906-289d838f06dd",
                                                "text": "Dès qu’elle sait épeler, ses parents la mettent en pension dans un couvent de Dominicaines, situé près de Bruxelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couvent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2835192b-a558-3220-9501-ecad91df8cde",
                                        "entry_id": "69b05d6f-a729-3c7e-906b-a8d8e67b6e21",
                                        "glosses": [
                                            "Troisième personne du pluriel de l’indicatif présent de couver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37076540-24a4-46a4-aaf2-0253a488d8d7",
                                                "sense_id": "2835192b-a558-3220-9501-ecad91df8cde",
                                                "text": "Les poules du couvent couvent."
                                            },
                                            {
                                                "example_id": "ace35b30-05d9-4982-9103-95a82e468611",
                                                "sense_id": "2835192b-a558-3220-9501-ecad91df8cde",
                                                "text": "Si elle le pouvait, elle couverait leurs champs comme couvent les poules, bras écartés pour les protéger, elle les rassemblerait sous elle, elle s’assiérait sur les jeunes pousses pour les garder du gel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f80979-4120-35df-94eb-821fff3dc77a",
                                        "entry_id": "69b05d6f-a729-3c7e-906b-a8d8e67b6e21",
                                        "glosses": [
                                            "Troisième personne du pluriel du subjonctif présent de couver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
