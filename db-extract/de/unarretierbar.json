                    {
                        "form_id": "ccca6c20-dd08-4dca-8f87-5663236af3c1",
                        "entry_id": "90fe9228-3cf8-3b04-a104-1789e4a3b79c",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unarretierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                        "entry_id": "90fe9228-3cf8-3b04-a104-1789e4a3b79c",
                        "glosses": [
                            "so, dass es nicht arretiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f62350-de1c-4e51-b073-11a1639dfa4b",
                                "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                                "text": "„[»Sein des Seienden«], das kein höchstes oder begründendes Sein wäre und deswegen unarretierbar und unbenennbar bleibt ….“"
                            },
                            {
                                "example_id": "458f6f08-4d4e-4b6c-8ee8-e027849d4ad3",
                                "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                                "text": "„Jenem Leerraum, um den Leupold bei der Herstellung der Wetterfahnen besorgt ist, entspricht jenes andere Vakuum, das durch den zunehmenden Widerwillen der Intellektuellen im Laufe der Neuzeit entstanden ist, »die Idee der göttlichen Offenbarung oder die Idee der Metaphysik« noch »ernst zu nehmen«. Ihm verdankt moderne Wahrnehmung ihre unarretierbare Beweglichkeit.“"
                            },
                            {
                                "example_id": "7f4e3b94-1b54-42d0-ad8a-9a64a5ba282c",
                                "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                                "text": "„Nur für Nicht-Griechen und Nicht-Adlige zeigt sich das Problem der Schönheit unarretierbar in endloser Iteration.“"
                            },
                            {
                                "example_id": "a37df35c-ca81-468c-a228-3ad807711727",
                                "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                                "text": "„Unarretierbar, einfach zu installieren und auszuschalten, leicht zu verstauen aufgrund der Leichtigkeit.“"
                            },
                            {
                                "example_id": "40b22754-c87c-486a-9963-d9e5bfcb1f05",
                                "sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                                "text": "„Der Auslösemechanismus, wenn man den als solchen überhaupt bezeichnen darf, funktioniert bei einer von zwei gekauften Fallen gerade so, bei der zweiten gar nicht,– schlicht unarretierbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60fba8c2-b130-4af0-9fb6-92605fd3d3db",
                        "source_entry_id": "90fe9228-3cf8-3b04-a104-1789e4a3b79c",
                        "source_sense_id": "5b155088-be13-3837-ab40-62b7c2cdf9d0",
                        "source_sense_description": "so, dass es nicht arretiert werden kann",
                        "target_lang_word": "unstoppable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unstoppable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                        "entry_id": "d52897ee-1f2e-359f-9a15-bfe9bc4238ca",
                                        "glosses": [
                                            "Unable to be stopped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087e0ab7-614d-4611-820b-d010934c91e1",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "Their \"greatly unstoppable fight\" against the cause was a joke."
                                            },
                                            {
                                                "example_id": "162aead1-59c4-4e01-a674-14d6cc39fa93",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "In these early days of silent pictures, the accent was chiefly on thrills and danger as provided by supposedly unstoppable locomotives with crooks or maniacs on the footplate."
                                            },
                                            {
                                                "example_id": "77d75dd2-0210-4443-852a-b8e96b66ac17",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "However Russian Pavlyuchenko stunned his compatriots with an unstoppable 25-yard drive into the top corner."
                                            },
                                            {
                                                "example_id": "8de8c845-2eab-45b5-a930-23070b56aca1",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "I'm so powerful / I don't need batteries to play / I'm so confident / Yeah, I'm unstoppable today"
                                            },
                                            {
                                                "example_id": "ec603c51-5806-4a4a-9ab1-c851a054f616",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "20 January 2017, Donald Trump, Inauguration Speech\nWhen America is united, America is totally unstoppable."
                                            },
                                            {
                                                "example_id": "93db8a2c-6796-4f64-9f87-7a401aa5bdc9",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "These trains were ordered years before the pandemic, commissioned to tackle a problem that has (for now) gone away. Passenger numbers are no longer increasing at an unstoppable rate, driven by rising central London employment. The extra capacity is not currently needed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
