                "senses": [
                    {
                        "sense_id": "c8c7acc6-a16d-31db-9f6d-f56ddaaf4d00",
                        "entry_id": "ff55a5fb-3229-367b-a250-dc32aeb0855b",
                        "glosses": [
                            "женское отчество от имени Генрих"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e46787-2de0-4845-984a-96ffab65288d",
                                "sense_id": "c8c7acc6-a16d-31db-9f6d-f56ddaaf4d00",
                                "text": "Мы сговорились, что завтра все втроём нанесём визит Шарлотте Генриховне."
                            },
                            {
                                "example_id": "c9463a50-a4ba-4ff1-b182-6660e018bda1",
                                "sense_id": "c8c7acc6-a16d-31db-9f6d-f56ddaaf4d00",
                                "text": "В детстве у меня была няня, Луиза Генриховна."
                            },
                            {
                                "example_id": "0550e0a8-b92c-4407-b115-45cfe27d1089",
                                "sense_id": "c8c7acc6-a16d-31db-9f6d-f56ddaaf4d00",
                                "text": "А Марту Генриховну никто глупой не считал, между тем как в нашем городе бытовую глупость определяют быстро и безошибочно."
                            }
                        ]
                    }
