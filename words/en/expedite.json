{
    "word_family": [
        "expedition",
        "expeditious",
        "expediter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9fb1acf-e55b-328e-8624-bc668e062584",
                    "sense_definition": "To accelerate the progress of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired more staff to <w>expedite</w> the shipping process.",
                            "target_lang_translations": {
                                "ru": "Компания наняла больше сотрудников, чтобы <w>ускорить</w> процесс доставки."
                            }
                        },
                        {
                            "text": "New technology will <w>expedite</w> the construction of the new bridge.",
                            "target_lang_translations": {
                                "ru": "Новые технологии помогут <w>ускорить</w> строительство нового моста."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerate",
                        "hasten",
                        "speed up"
                    ],
                    "antonyms": [
                        "impede",
                        "slow down"
                    ],
                    "common_phrases": [
                        "expedite the process",
                        "expedite delivery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать более быстрым ход или развитие чего-либо; ускорять процесс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "процесс, ход событий"
                            },
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "способствовать развитию или движению"
                            },
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "содействовать более быстрому протеканию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae41e12-3335-3977-9ad6-6f06bdb42f6b",
                    "sense_definition": "To perform a task fast and efficiently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team worked hard to <w>expedite</w> the final report before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда усердно работала, чтобы <w>быстро подготовить</w> итоговый отчет до дедлайна."
                            }
                        },
                        {
                            "text": "We need to <w>expedite</w> these administrative tasks to save time.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>быстро справиться</w> с этими административными задачами, чтобы сэкономить время."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispatch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять задачу или дело быстро и эффективно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быстро выполнять",
                                "target_lang_sense_clarification": "задачу, работу"
                            },
                            {
                                "target_lang_word": "быстро справляться",
                                "target_lang_sense_clarification": "с поручением, обязанностями"
                            },
                            {
                                "target_lang_word": "оперативно решать",
                                "target_lang_sense_clarification": "вопрос или задачу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e730d68d-627c-3a7b-b18a-15f199cb55e8",
                    "sense_definition": "To free from impediment or release.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer worked to <w>expedite</w> the release of the prisoner.",
                            "target_lang_translations": {
                                "ru": "Адвокат работал над тем, чтобы <w>ускорить</w> освобождение заключенного."
                            }
                        },
                        {
                            "text": "The new policy aims to <w>expedite</w> the movement of goods through customs.",
                            "target_lang_translations": {
                                "ru": "Новая политика направлена на то, чтобы <w>облегчить</w> и ускорить прохождение товаров через таможню."
                            }
                        }
                    ],
                    "synonyms": [
                        "liberate",
                        "release"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic or formal."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождать от препятствий или ускорять выдачу, освобождение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "выдачу, освобождение, прохождение"
                            },
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "устранять препятствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8419d316-8a23-3725-a02b-61896c62feed",
                    "sense_definition": "To perform the duties of an expediter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was hired to <w>expedite</w> the flow of materials on the factory floor.",
                            "target_lang_translations": {
                                "ru": "Его наняли, чтобы <w>координировать и ускорять</w> движение материалов в заводском цеху."
                            }
                        },
                        {
                            "text": "She will <w>expedite</w> the logistics for the upcoming international conference.",
                            "target_lang_translations": {
                                "ru": "Она будет <w>курировать</w> логистику предстоящей международной конференции."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Координировать и форсировать перемещение грузов, материалов или этапы проекта в роли экспедитора или диспетчера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспедировать",
                                "target_lang_sense_clarification": "сопровождать и контролировать поставки"
                            },
                            {
                                "target_lang_word": "координировать",
                                "target_lang_sense_clarification": "сроки и логистику"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c50cca36-a854-3e2b-b5ef-24f82ab3d7f6",
