{
    "word_family": [
        "everydayness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92cdb22c-161f-35ee-8758-311aed96aa38",
                    "sense_definition": "Common, ordinary, or typical of usual life.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Computers have become an essential part of <w>everyday</w> life.",
                            "target_lang_translations": {
                                "ru": "Компьютеры стали неотъемлемой частью <w>повседневной</w> жизни.",
                                "zh": "电脑已成为<w>日常</w>生活中不可或缺的一部分。"
                            }
                        },
                        {
                            "text": "She writes stories about <w>everyday</w> people and their struggles.",
                            "target_lang_translations": {
                                "ru": "Она пишет рассказы об <w>обычных</w> людях и их трудностях.",
                                "zh": "她写的故事是关于<w>普通</w>人及其生活挣扎的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mundane",
                        "routine",
                        "unremarkable",
                        "workaday",
                        "ordinary",
                        "normal"
                    ],
                    "common_phrases": [
                        "everyday life",
                        "everyday problems",
                        "everyday language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычный, привычный или типичный для повседневной жизни.",
                        "zh": "指普通的、平常的或日常生活中的典型事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повседневный",
                                "target_lang_sense_clarification": "относящийся к быту, жизни"
                            },
                            {
                                "target_lang_word": "обыденный",
                                "target_lang_sense_clarification": "заурядный, привычный"
                            },
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "простой, типичный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日常",
                                "target_lang_sense_clarification": "指平时的、非特殊的"
                            },
                            {
                                "target_lang_word": "普通",
                                "target_lang_sense_clarification": "指平常的、不特别的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c979647b-669b-3a45-8a0a-fa8c83ddb2fa",
                    "sense_definition": "Happening or appearing every day.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rain is an <w>everyday</w> occurrence during the monsoon season.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди — <w>ежедневное</w> явление в сезон муссонов.",
                                "zh": "季风季节里，大雨是<w>每日</w>都会发生的事情。"
                            }
                        },
                        {
                            "text": "Checking email has become an <w>everyday</w> habit for most workers.",
                            "target_lang_translations": {
                                "ru": "Проверка электронной почты стала <w>ежедневной</w> привычкой для большинства работников.",
                                "zh": "查看电子邮件已成为大多数员工<w>每日</w>的习惯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "daily",
                        "quotidian",
                        "day-to-day"
                    ],
                    "common_phrases": [
                        "everyday occurrence",
                        "everyday event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или появляющийся каждый день.",
                        "zh": "指每天发生或出现的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежедневный",
                                "target_lang_sense_clarification": "происходящий каждый день"
                            },
                            {
                                "target_lang_word": "каждодневный",
                                "target_lang_sense_clarification": "повторяющийся изо дня в день"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "每日",
                                "target_lang_sense_clarification": "指每一天"
                            },
                            {
                                "target_lang_word": "每天",
                                "target_lang_sense_clarification": "指每一天"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8fb8130-1288-3edd-aed2-f71af7c5a161",
                    "sense_definition": "Suitable for ordinary days rather than special occasions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put on her <w>everyday</w> clothes and went to the market.",
                            "target_lang_translations": {
                                "ru": "Она надела свою <w>повседневную</w> одежду и пошла на рынок.",
                                "zh": "她穿上<w>便服</w>就去市场了。"
                            }
                        },
                        {
                            "text": "These simple glasses are for <w>everyday</w> use, not for parties.",
                            "target_lang_translations": {
                                "ru": "Эти простые стаканы предназначены для <w>повседневного</w> использования, а не для вечеринок.",
                                "zh": "这些简单的杯子是供<w>日常</w>使用的，不是为了聚会准备的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "workaday"
                    ],
                    "common_phrases": [
                        "everyday clothes",
                        "everyday wear",
                        "everyday use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий для обычных дней, а не для особых случаев.",
                        "zh": "指适合平时使用而非特殊场合使用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повседневный",
                                "target_lang_sense_clarification": "для обычного использования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便服",
                                "target_lang_sense_clarification": "指平时穿的衣服"
                            },
                            {
                                "target_lang_word": "日常",
                                "target_lang_sense_clarification": "指适合平时使用的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2d89e41-735e-34f9-b2f9-83eb789b4fa1",
                    "sense_definition": "The routine or ordinary aspects of daily life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a vacation to escape the <w>everyday</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужен отпуск, чтобы сбежать от <w>повседневности</w>.",
                                "zh": "我们需要去度假以逃离<w>日常生活</w>。"
                            }
                        },
                        {
                            "text": "The artist finds beauty in the <w>everyday</w>.",
                            "target_lang_translations": {
                                "ru": "Художник находит красоту в <w>обыденном</w>.",
                                "zh": "这位艺术家在<w>日常琐事</w>中发现了美。"
                            }
                        }
                    ],
                    "synonyms": [
                        "routine"
                    ],
                    "common_phrases": [
                        "escape the everyday"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рутинные или обычные аспекты повседневной жизни.",
                        "zh": "指日常生活中的琐事或平淡的方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повседневность",
                                "target_lang_sense_clarification": "рутина, быт"
                            },
                            {
                                "target_lang_word": "обыденность",
                                "target_lang_sense_clarification": "привычный ход вещей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日常生活",
                                "target_lang_sense_clarification": "指平时的生活琐事"
                            },
                            {
                                "target_lang_word": "琐事",
                                "target_lang_sense_clarification": "指平淡的日常事务"
                            }
                        ]
                    }
                }
            ]
        }
    ]
