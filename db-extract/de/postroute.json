                "senses": [
                    {
                        "sense_id": "140ba2fa-33c4-33f5-975f-16064ea64454",
                        "entry_id": "b6dc8b0d-6360-3ead-acca-5b28b91e1905",
                        "glosses": [
                            "Strecke, die von der Post bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c38e46-e587-45b7-a1dc-f59806f4c909",
                                "sense_id": "140ba2fa-33c4-33f5-975f-16064ea64454",
                                "text": "„Hugh Finlay's Expedition endete im Juni 1774, als politische Unruhen die Postrouten zunehmend unsicher machten und er als Nachfolger von Benjamin Franklin zum Generalpostmeister der Kolonien ernannt worden war.“"
                            },
                            {
                                "example_id": "37b3d27f-11d5-4a3d-81f0-8c711435c199",
                                "sense_id": "140ba2fa-33c4-33f5-975f-16064ea64454",
                                "text": "„Die Korrespondenz mit ihren Familien in Europa und zwischen den Plantagen in Alta Verapaz hat uns ein umfangreiches postgeschichtliches Material beschert, anhand dessen wir die Stempel, Verwendungszwecke und Postrouten im Norden Guatemals untersuchen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
