                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5bd62c-5eac-4bb1-8102-61ceeb8bcee8",
                                                "sense_id": "cb9bbeb4-0687-3ba8-9caa-8ed6df4f357b",
                                                "text": "South Korea is seeking cooperation from China to produce artificial rain to help fight increasing pollution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee68f21e-cc4e-310b-8e11-7a68e56c0c5f",
                                        "entry_id": "3384c942-0f2b-36de-8967-0fe8259d4be0",
                                        "glosses": [
                                            "Association for mutual benefit, such as for purposes of production or purchase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03768224-9e99-45bc-bf06-f72bb7472fce",
                        "source_entry_id": "d06b9498-3129-3fa2-b30c-af1ce03209c8",
                        "source_sense_id": "3f84f91d-84de-3370-aa54-b26217e43c0b",
                        "target_lang_word": "Kooperation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kooperation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f02712d7-0bb4-3db9-90e7-750e679ea210",
                                        "entry_id": "7193746b-152c-3603-ad20-c3530623e6fd",
                                        "glosses": [
                                            "Zusammenbringen von Handlungen zweier oder mehrerer Personen (Systeme), sodass die Wirkungen der Handlungen zum Nutzen aller dieser Personen (Systeme) führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b76f39-bfd9-4ff3-a275-d93f439871d0",
                                                "sense_id": "f02712d7-0bb4-3db9-90e7-750e679ea210",
                                                "text": "Das System von Wiktionary beruht auf dem Prinzip der Kooperation."
                                            },
                                            {
                                                "example_id": "e4efbd21-6767-49d9-bba6-3dbcd19ea144",
                                                "sense_id": "f02712d7-0bb4-3db9-90e7-750e679ea210",
                                                "text": "„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "2ef90346-71e7-4982-b50f-fe51ca0bcf04",
                                                "sense_id": "f02712d7-0bb4-3db9-90e7-750e679ea210",
                                                "text": "„Kooperation setzt prinzipielle Gleichwertigkeit und Gleichberechtigung der Partner voraus, d.h. kein Fachunterricht sollte als Bedarfsfüller eines anderen missbraucht und zur Mitbewältigung fachfremder Belange umfunktioniert werden, wie es häufig etwa mit dem Deutschunterricht geschieht.“"
                                            },
                                            {
                                                "example_id": "48f7b36d-af16-4201-b072-019a3cb5621e",
                                                "sense_id": "f02712d7-0bb4-3db9-90e7-750e679ea210",
                                                "text": "„In den meisten Fällen herrscht ein Geist von Kooperation und gegenseitigem Verstehen, und es hat sich eine Art guter Beziehung entwickelt, die gewöhnlich gravierende Meinungsverschiedenheiten verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6db109a4-af9d-4e08-9621-604ac8887704",
                        "source_entry_id": "d06b9498-3129-3fa2-b30c-af1ce03209c8",
                        "source_sense_id": "3f84f91d-84de-3370-aa54-b26217e43c0b",
                        "target_lang_word": "Zusammenarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                        "entry_id": "54d35c7c-f4a5-3337-8bd8-0048c5686b65",
                                        "glosses": [
                                            "das gemeinschaftliche Arbeiten an einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e0e432-39e1-46a5-a7dc-d90ffe116d56",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "Aufgrund der komplexen Anforderungen waren sie zur Zusammenarbeit gezwungen."
                                            },
                                            {
                                                "example_id": "a16ff781-06a3-40e2-bde5-a79580b1ee88",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "„Das Komitee sollte Arbeitsgruppen für die verschiedenen Gebiete ernennen, die in Zusammenarbeit mit Filmexperten Empfehlungen und Vorschläge für einen Produktionsplan und seine praktische Verwirklichung vorlegen würden.“"
                                            },
                                            {
                                                "example_id": "a35170d5-0a80-46b0-a567-920e6d60e04b",
                                                "sense_id": "f4fcff40-0d0f-32e2-918b-3a264d987965",
                                                "text": "„Wielands Zusammenarbeit mit Schweitzer war eng, was nicht die Regel war und ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
