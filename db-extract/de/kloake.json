                        "form": "die Kloake"
                    },
                    {
                        "form_id": "c36dd8f0-54d0-47f6-a5bf-94268b10d82c",
                        "entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kloaken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                        "entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "glosses": [
                            "unterirdischer Kanal zur Wegleitung von Abwasser"
                        ],
                        "tags": [
                            "Städtebau",
                            "Infrastruktur"
                        ],
                        "examples": [
                            {
                                "example_id": "99335aa3-c7ba-436e-a4f7-146717a11aa0",
                                "sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                                "text": "„Jenseits des Fensters befindet sich ein kurzer unterirdischer Gang, der zur recht großen und tiefen Kloake des Hauses führte, die unter dem Synagogenhof lag.“"
                            },
                            {
                                "example_id": "717b57c0-3298-47b3-a066-590b51e7a25e",
                                "sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                                "text": "„Dann lachte er laut auf, kniete sich in die Kloake und grub mit beiden Händen, um die Hinterräder freizubekommen.“"
                            },
                            {
                                "example_id": "d9479d41-448a-480a-b38a-9e41d3a7e47d",
                                "sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                                "text": "„Sie war bucklig und sah abscheulich aus, hatte nur noch einen einzigen Zahn, stank wie eine Kloake und gab entsetzliche Töne von sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bc9eef60-92c1-3cbc-9c8c-e9138721d017",
                        "entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "glosses": [
                            "Endabschnitt des Darms, wenn in diesen zusätzlich Harnleiter und Geschlechtsorgane münden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "040c4dbc-c410-4bc3-a1be-d16c388b4220",
                                "sense_id": "bc9eef60-92c1-3cbc-9c8c-e9138721d017",
                                "text": "„Wie Haie, Amphibien, Reptilien und Vögel weisen auch die Ameisenigel und Schnabeltiere eine Kloake auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd060dda-bd70-4acf-b9fa-57954a285eee",
                        "source_entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "source_sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                        "source_sense_description": "Bauwesen, Städtebau, Infrastruktur: unterirdischer Kanal zur Wegleitung von Abwasser",
                        "target_lang_word": "sewage system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "80aa9794-9634-4fdf-9037-29103efd84d2",
                        "source_entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "source_sense_id": "2849b809-4d44-3c8a-b0dd-d402d18efb3e",
                        "source_sense_description": "Bauwesen, Städtebau, Infrastruktur: unterirdischer Kanal zur Wegleitung von Abwasser",
                        "target_lang_word": "cloaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Lieu destiné à recevoir les immondices, égout, dépotoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff5cde56-0001-4210-85d4-0b9fea7a6bdc",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Tomber dans un cloaque."
                                            },
                                            {
                                                "example_id": "459eeb6b-5dbb-4e63-9700-cbef52557d0f",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Un cloaque infect."
                                            },
                                            {
                                                "example_id": "aad68d00-21b5-4d7a-834e-d1375b0053d4",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Il [Napoléon] proclame que le Kremlin, arsenal, magasins, tout est détruit ; que désormais Moscou n'est plus qu'un amas de décombres, qu'un cloaque impur et malsain, sans importance politique et militaire"
                                            },
                                            {
                                                "example_id": "79c4d7ec-2d05-4b25-a2a0-6abf07f5a5a6",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Quelquefois, l'égout de Paris se mêlait de déborder, […]. Par moments, cet estomac de la civilisation digérait mal, le cloaque refluait dans le gosier de la ville, et Paris avait l'arrière-goût de sa fange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Lieu malpropre et malsain, bas-fond."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c61366-830c-4595-a212-084c6633eb87",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Des types hideux, effrayants, fourmilleront dans ces cloaques impurs comme les reptiles dans les marais."
                                            },
                                            {
                                                "example_id": "833a4740-8a5e-41bc-96ed-f9daa63dc115",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Il parvint ainsi jusqu’à certaine ruelle mal famée, appelée rue des Singes, un vrai cloaque, tant au moral qu’au physique."
                                            },
                                            {
                                                "example_id": "bade5e25-16c5-42e4-ba64-9639423a6c12",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Les ruelles étaient devenues plus étroites et plus sordides encore ; le pavé disparaissant sous des tas d'immondices n'était qu'un vaste cloaque pourrissant à ciel ouvert."
                                            },
                                            {
                                                "example_id": "e5c9d27b-a290-42a1-9989-128e41f4f115",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Sam et Federica n’auraient jamais imaginé qu’ils quitteraient un jour ce cloaque humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8374eb6-d083-3afc-9b5a-9ddb66cafc9d",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Cavité ou réceptacle commun au système digestif et au système uro-génital que forme l’extrémité du canal intestinal chez les oiseaux, les batraciens et les reptiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecbd394-589a-47f8-8eec-c38177d3a843",
                                                "sense_id": "b8374eb6-d083-3afc-9b5a-9ddb66cafc9d",
                                                "text": "Peu à peu, le ventre de la femelle grossit, s’élargit vers le bas. Enfin les premiers ovules apparaissent au cloaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9bf9e55-4c38-4aeb-9bf4-82e995cbf491",
                        "source_entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "source_sense_id": "bc9eef60-92c1-3cbc-9c8c-e9138721d017",
                        "target_lang_word": "cloaca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloaca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "A sewer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2ed69a-67fe-4915-9db4-f3b8b192622b",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "The Thames, polluted with the filthy effusions of the cloacae."
                                            },
                                            {
                                                "example_id": "a423af0a-16c6-4a5a-a8dd-1a1bd0959d7d",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "[…] that tremendous cloaca of Pauperism […]"
                                            },
                                            {
                                                "example_id": "624d9826-a0ba-43b7-a2ba-1ae0308e9ae9",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "After working an hour, I began to speculate on the distance one had to go before the cloaca was reached the chances we had of missing it altogether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93925cb0-9f93-377b-9d36-60eccda58b3e",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "The opening in reptiles, amphibians and birds, as well as elasmobranchians, lobe-finned fishes, marsupials and monotreme mammals, which serves as the common outlet for the urogenital ducts and rectum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a909108-d4f9-43ef-8615-28167030130a",
                                                "sense_id": "93925cb0-9f93-377b-9d36-60eccda58b3e",
                                                "text": "In birds the rectum, at the termination of its canal, forms an oval or elongated pouch […] and then expands into a cavity, which has been named cloaca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "An outhouse or lavatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12ab41a-26d0-4d8a-8cdd-36ab8c0fba04",
                                                "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                                "text": "To every house […] a cloaca."
                                            },
                                            {
                                                "example_id": "2fd0ec35-a07c-40bb-be94-dd61fb769d2a",
                                                "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                                "text": "Only think of that cloaca being supplied daily with such dainty bibliographical treasures!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a59b75-3c56-3bb9-bfe8-9b392bc6974c",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "A duct through which gangrenous material escapes a body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83944d1-8434-4e30-8413-7a5ce3980435",
                                                "sense_id": "b6a59b75-3c56-3bb9-bfe8-9b392bc6974c",
                                                "text": "Across this shell [sc. of bone] small holes are eaten, by which the matter escapes, and which are called cloacae (Weidmann)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54135835-8651-3ec7-ad38-9d682554140a",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "Structure in the embryo during the development of the reproductive and urinary systems."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e872fd80-5c3b-4678-86bd-3de559c5c392",
                        "source_entry_id": "65472421-eecf-3363-984c-4a28919246e5",
                        "source_sense_id": "bc9eef60-92c1-3cbc-9c8c-e9138721d017",
                        "target_lang_word": "cloaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Lieu destiné à recevoir les immondices, égout, dépotoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff5cde56-0001-4210-85d4-0b9fea7a6bdc",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Tomber dans un cloaque."
                                            },
                                            {
                                                "example_id": "459eeb6b-5dbb-4e63-9700-cbef52557d0f",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Un cloaque infect."
                                            },
                                            {
                                                "example_id": "aad68d00-21b5-4d7a-834e-d1375b0053d4",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Il [Napoléon] proclame que le Kremlin, arsenal, magasins, tout est détruit ; que désormais Moscou n'est plus qu'un amas de décombres, qu'un cloaque impur et malsain, sans importance politique et militaire"
                                            },
                                            {
                                                "example_id": "79c4d7ec-2d05-4b25-a2a0-6abf07f5a5a6",
                                                "sense_id": "4c7be8ff-7a34-3a10-a7ef-2d13192a20f4",
                                                "text": "Quelquefois, l'égout de Paris se mêlait de déborder, […]. Par moments, cet estomac de la civilisation digérait mal, le cloaque refluait dans le gosier de la ville, et Paris avait l'arrière-goût de sa fange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Lieu malpropre et malsain, bas-fond."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c61366-830c-4595-a212-084c6633eb87",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Des types hideux, effrayants, fourmilleront dans ces cloaques impurs comme les reptiles dans les marais."
                                            },
                                            {
                                                "example_id": "833a4740-8a5e-41bc-96ed-f9daa63dc115",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Il parvint ainsi jusqu’à certaine ruelle mal famée, appelée rue des Singes, un vrai cloaque, tant au moral qu’au physique."
                                            },
                                            {
                                                "example_id": "bade5e25-16c5-42e4-ba64-9639423a6c12",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Les ruelles étaient devenues plus étroites et plus sordides encore ; le pavé disparaissant sous des tas d'immondices n'était qu'un vaste cloaque pourrissant à ciel ouvert."
                                            },
                                            {
                                                "example_id": "e5c9d27b-a290-42a1-9989-128e41f4f115",
                                                "sense_id": "d3a6906e-5651-3218-b65a-b49c0b9a5069",
                                                "text": "Sam et Federica n’auraient jamais imaginé qu’ils quitteraient un jour ce cloaque humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8374eb6-d083-3afc-9b5a-9ddb66cafc9d",
                                        "entry_id": "9d490161-caa3-3702-97f0-24bcf4915599",
                                        "glosses": [
                                            "Cavité ou réceptacle commun au système digestif et au système uro-génital que forme l’extrémité du canal intestinal chez les oiseaux, les batraciens et les reptiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecbd394-589a-47f8-8eec-c38177d3a843",
                                                "sense_id": "b8374eb6-d083-3afc-9b5a-9ddb66cafc9d",
                                                "text": "Peu à peu, le ventre de la femelle grossit, s’élargit vers le bas. Enfin les premiers ovules apparaissent au cloaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
