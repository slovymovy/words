                                        "entry_id": "97e66659-10c6-316d-80ed-9c2bf2a38048",
                                        "glosses": [
                                            "embarcação submersível autônoma especialmente desenhada e construída para suportar altíssima pressão, usada para exploração e pesquisa em zonas abissais marinhas ou em lagos de grande profundidade"
                                        ],
                                        "tags": [
                                            "Oceanografia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1950878-838e-4816-8901-ab06cbc42e40",
                                                "sense_id": "7e340ab1-e882-3da8-a4b3-9721f1b3b1fd",
                                                "text": "Em janeiro de 1960, Jacques Piccard e Don Walsh fizeram a primeira e única viagem tripulada ao local, a bordo do batiscafo suíço Trieste."
                                            }
