                "senses": [
                    {
                        "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                        "entry_id": "8de411bf-c6f6-349d-b341-442c77f5d572",
                        "glosses": [
                            "Stadt im Nordwesten des mexikanischen Bundesstaats Baja California"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55538013-0a3c-4c73-bab3-c811200137e0",
                                "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                                "text": "„›Vor zehn oder elf Jahren in Tijuana. Ich hab's ausprobiert. Das ist alles.‹“"
                            },
                            {
                                "example_id": "3df18486-22b8-4e28-ae20-6de90f8a6385",
                                "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                                "text": "„›Sobald ihr in Tijuana seid, quartiert euch in einem Hotel ein und wartet auf uns.‹“"
                            },
                            {
                                "example_id": "1a916ab2-04e6-406e-beca-bbefe307819f",
                                "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                                "text": "„1993 wird ein noch nicht fertiggestellter Tunnel entdeckt, der Tijuana mit San Diego verbinden sollte, er liegt 20 Meter unter der Erde und ist fast 450 Meter lang.“"
                            },
                            {
                                "example_id": "5c94efd9-d2b7-4c9d-bd4d-142b5a60a35e",
                                "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                                "text": "„›Wir sind dann runter nach Tijuana gefahren und haben den Film in einem großen Haus außerhalb der Stadt gemacht.‹“"
                            },
                            {
                                "example_id": "f2870e36-9071-42ee-930b-bd6d3476928f",
                                "sense_id": "242eb623-d61c-3e65-9d8c-96342dc342b6",
                                "text": "„Wir würden nach Mexiko-City fliegen und dort Jasons Kontaktperson treffen. Der würde uns nach Tijuana und über die Grenze bis nach San Francisco und Oakland bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
