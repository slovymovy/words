                    },
                    {
                        "form_id": "bbb90f87-bc04-411a-be97-b536dde1c6f8",
                        "entry_id": "18b1c673-8209-3842-84d4-eeed08e034a5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "politichienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b757ff16-e599-373c-a8f2-c23ea885be99",
                        "entry_id": "18b1c673-8209-3842-84d4-eeed08e034a5",
                        "glosses": [
                            "Homme politique jugé combinard et plus souvent motivé par son intérêt personnel que par celui de sa nation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cbab579-d78f-4d63-9a19-ec5a0a572fc2",
                                "sense_id": "b757ff16-e599-373c-a8f2-c23ea885be99",
                                "text": "« Au conseil des ministres, on se regarde... en politichiens de faïence »"
                            },
                            {
                                "example_id": "c2baa8cc-2b19-4082-bbe3-bdd48aa0aa35",
                                "sense_id": "b757ff16-e599-373c-a8f2-c23ea885be99",
                                "text": "Pendant que les « politichiens » se distribuaient les maroquins, le pouvoir continuait sournoisement sa persécution à l'encontre des nationaux."
                            },
                            {
                                "example_id": "fa3db2ef-7d80-483b-811d-58a36b071346",
                                "sense_id": "b757ff16-e599-373c-a8f2-c23ea885be99",
                                "text": "Les politichiens contemporains sont de petits despotes homaisiens en puissance, des accros du privilège, trop souvent les parasites d'une bête malade."
                            },
                            {
                                "example_id": "d42f435f-d5ed-4821-9969-aa9a4d670f91",
                                "sense_id": "b757ff16-e599-373c-a8f2-c23ea885be99",
                                "text": "Les querelles de « politichiens », ce mot de De Gaulle, sont indignes de la gravité des crises que la France doit surmonter. Ça suffit !"
                            }
                        ]
                    }
                ],
