                "translations": [
                    {
                        "translation_id": "68deca5c-5190-4892-a26d-00eba835d664",
                        "source_entry_id": "837bad41-b3e1-3159-b92c-6c3c76a89d83",
                        "source_sense_id": "a764ee22-fed8-3312-8963-8d0d84757988",
                        "target_lang_word": "jingle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jingle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01ab36bc-444d-3df1-abb3-a7f268ae68cd",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "The sound of metal or glass clattering against itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017ce217-4d5b-4c19-9e3e-0afc5ede7d84",
                                                "sense_id": "01ab36bc-444d-3df1-abb3-a7f268ae68cd",
                                                "text": "He heard the jingle of her keys in the door and turned off the screen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3613cba1-75c3-3b0b-b312-e607f181fe0d",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "A small piece of metal attached to a musical instrument, such as a tambourine, so as to make a jangling sound when the instrument is played."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7bc75f-d7d2-485d-8c3d-699e47546ef8",
                                                "sense_id": "3613cba1-75c3-3b0b-b312-e607f181fe0d",
                                                "text": "Her tambourine didn't come with any jingles attached."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0fb327-44b2-3c8e-a8c1-544542a775f0",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "A memorable short song, or in some cases a snippet of a popular song with its lyrics modified, used for the purposes of advertising a product or service in a TV or radio commercial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47397a3f-5396-497f-a92d-a5b2faf32b90",
                                                "sense_id": "7a0fb327-44b2-3c8e-a8c1-544542a775f0",
                                                "text": "That used-car dealership's jingle has been stuck in my head since we heard that song."
                                            },
                                            {
                                                "example_id": "f58c01c4-fba6-4585-b3cb-61e9cc4410a6",
                                                "sense_id": "7a0fb327-44b2-3c8e-a8c1-544542a775f0",
                                                "text": "The best of friends become the worst of enemies when Barney makes a hilarious attack ad where he viciously pummels a cardboard cut-out of Homer before special guest star Linda Ronstadt joins the fun to both continue the attack on the helpless Homer stand-in and croon a slanderously accurate, insanely catchy jingle about how “Mr. Plow is a loser/And I think he is a boozer.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf72493-2578-3d26-9ceb-b82896c34c77",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "A carriage drawn by horses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37df1b2e-a0a2-4bd9-81e4-b2757b8a9532",
                                                "sense_id": "7cf72493-2578-3d26-9ceb-b82896c34c77",
                                                "text": "They drove in a jingle across Cork while it was still early morning and Stephen finished his sleep in a bedroom of the Victoria Hotel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c72e35b7-f080-390e-85a1-daba8e780778",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "A brief telephone call."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d338002f-84f7-4d6f-9d1a-495346d02968",
                                                "sense_id": "c72e35b7-f080-390e-85a1-daba8e780778",
                                                "text": "Give me a jingle when you find out something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2e9f8b-3d1f-3d77-8436-cbce8a42b497",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "A jingle shell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b0ce120-de1b-3d9b-89bf-8296d4922394",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "Coin money."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1f5a41a-3c39-4ef5-a13b-30f2ad4cd2bd",
                                                "sense_id": "3b0ce120-de1b-3d9b-89bf-8296d4922394",
                                                "text": "If all you folks who donate your hard-earned jingle to PETA aren't convinced of your ill-advised ways yet, you should probably check this out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af13031f-d2f8-3d73-8402-411baff94a3b",
                                        "entry_id": "c56eb6a5-8a8b-3033-98ec-68df7b3659c4",
                                        "glosses": [
                                            "Pee, urine."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jingle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72db365-1445-3a7e-b192-5c0f46c7fc34",
                                        "entry_id": "ad5eac6d-c488-348c-8be1-2cfb7570a235",
                                        "glosses": [
                                            "To make a noise of metal or glass clattering against itself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8dcec3-e12d-47f4-8273-7d0d548fb86e",
                                                "sense_id": "f72db365-1445-3a7e-b192-5c0f46c7fc34",
                                                "text": "The beads jingled as she walked."
                                            },
                                            {
                                                "example_id": "fcacf60e-ad49-4759-9942-1c6f79be63b7",
                                                "sense_id": "f72db365-1445-3a7e-b192-5c0f46c7fc34",
                                                "text": "He heard then a warm heavy sigh, softer, as she turned over and the loose brass quoits of the bedstead jingled. Must get those settled really."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92602a5c-6d7e-30c0-97d9-1a894bc71a49",
                                        "entry_id": "ad5eac6d-c488-348c-8be1-2cfb7570a235",
                                        "glosses": [
                                            "To cause to make a noise of metal or glass clattering against itself."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb321aa-bf0b-45c6-89c8-b1de250207a7",
                                                "sense_id": "92602a5c-6d7e-30c0-97d9-1a894bc71a49",
                                                "text": "She jingled the beads as she walked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a4612c-6105-37f9-8c55-f0795056e1b6",
                                        "entry_id": "ad5eac6d-c488-348c-8be1-2cfb7570a235",
                                        "glosses": [
                                            "To rhyme or sound with a jingling effect."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab564fb6-fcbd-46f4-b594-5cea16acfb6a",
                                                "sense_id": "a8a4612c-6105-37f9-8c55-f0795056e1b6",
                                                "text": "jingling street ballads"
                                            }
