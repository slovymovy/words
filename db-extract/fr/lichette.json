                ],
                "senses": [
                    {
                        "sense_id": "55be52c5-b8d2-335d-bff2-fd3fb1e1d32c",
                        "entry_id": "3406036c-ad40-33ce-9c42-ef8fb9d275e3",
                        "glosses": [
                            "Petite tranche de pain."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a8a4e949-a63f-41a0-9f23-0d01670e0afd",
                                "sense_id": "55be52c5-b8d2-335d-bff2-fd3fb1e1d32c",
                                "text": "En pleine miche il nous taillait des lichettes à tremper dans un doigt de vin d’Irancy."
                            },
                            {
                                "example_id": "ac052396-0602-470f-ba93-8cb2cbda1b66",
                                "sense_id": "55be52c5-b8d2-335d-bff2-fd3fb1e1d32c",
                                "text": "Mes deux compagnons n’étaient pas oubliés : j’aimais tellement mon Papillon que parfois je lui mettais un « soupçon » de beurre sur sa lichette ; je crois qu’il me remerciait avec ses bons yeux."
                            }
                        ]
                    },
                    {
                        "sense_id": "54049b92-5b3e-32f4-9efc-40f0bda8865d",
                        "entry_id": "3406036c-ad40-33ce-9c42-ef8fb9d275e3",
                        "glosses": [
                            "Petite quantité d’un liquide, d’un aliment."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8a35917e-c634-409b-a64c-a1da83454907",
                                "sense_id": "54049b92-5b3e-32f4-9efc-40f0bda8865d",
                                "text": "Du susucre, oui, avec une lichette de stevia ou de sirop d’agave plutôt que de sucre raffiné, l’ennemi public number one."
                            },
                            {
                                "example_id": "f392867e-ee61-4533-86f4-2b66ec7432ef",
                                "sense_id": "54049b92-5b3e-32f4-9efc-40f0bda8865d",
                                "text": "Bon ! (Voyant qu’elle reboit une lichette de vodka) D’abord molo avec la vodka hein ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "30c70344-997b-3d72-8b7e-5d6dcccdbcd9",
                        "entry_id": "3406036c-ad40-33ce-9c42-ef8fb9d275e3",
                        "glosses": [
                            "Action de sucer fortement la peau ou résultat de cette action ; suçon."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbb40af-505b-444f-addc-7aa94673a19f",
                                "sense_id": "30c70344-997b-3d72-8b7e-5d6dcccdbcd9",
                                "text": "Mise en application : viens là que j’te fasse une lichette, coquin !"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ef48ff3-a8f3-3585-ad3e-9f6bef08a305",
                        "entry_id": "3406036c-ad40-33ce-9c42-ef8fb9d275e3",
                        "glosses": [
                            "Petite attache, faite de tissu, d’une serviette ou chaînette métallique dans le col d'un vêtement (de pluie), servant à les suspendre."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0df8e7d0-e714-4b49-b28c-a3ed899ccabd",
                        "source_entry_id": "3406036c-ad40-33ce-9c42-ef8fb9d275e3",
                        "target_lang_word": "Stückchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stückchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                                        "glosses": [
                                            "kleiner Teil von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e83887-3f44-44b5-b0f1-8bd95b596adc",
                                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                                "text": "Gibst du mir noch ein Stückchen Brot?"
                                            },
                                            {
                                                "example_id": "9fea275a-84b6-4e6b-ad62-20e75b0efa3e",
                                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                                "text": "„Ein Stückchen weiter weg, fast so weit, daß er sie gerade eben noch sehen konnte, traten zwei Gestalten auf den Straßenrand; dann drehten sie sich um und kamen, auf dem Rain entlanggehend, auf ihn zu.“"
                                            },
                                            {
                                                "example_id": "bcc195fb-ac3a-47fd-9506-c5d984de4cfe",
                                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                                "text": "„Sie streuten kleine Stückchen ihrer Butterbrote auf den Fenstersims und ein Rotkehlchen kam und pickte sie auf.“"
                                            },
                                            {
                                                "example_id": "91668dcf-f3e0-4e24-8f27-9635daf6efa3",
                                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                                "text": "„Ich stöberte in den Kellern umher und in den Brandresten der Wohnungen, fand dort ein bißchen Grütze, da ein paar Stückchen Brot, dumpfiges Mehl und Wasser in Wannen oder Eimern und Krügen.“"
                                            },
                                            {
                                                "example_id": "a6b43c75-551f-426a-98ba-aac296616171",
                                                "sense_id": "3ff2ff25-d46f-3e88-84d1-8c5e76a05ebc",
                                                "text": "„Lange betrachteten die beiden das Stückchen Land, auf das sie der Zufall verschlagen hatte, dennoch kamen sie über ihr weiteres Schicksal zu keinem bestimmten Schluß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b0fd79e-d296-3a9a-8f83-7d877d2e7051",
                                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                                        "glosses": [
                                            "kleine, unbestimmte Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9acfdc12-7489-4c83-a363-6089cee034bd",
                                                "sense_id": "0b0fd79e-d296-3a9a-8f83-7d877d2e7051",
                                                "text": "Möchtest du ein Stückchen Zucker in den Tee?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1c745650-e217-382a-8057-578598913f1e",
                                        "entry_id": "ddba8ca0-2126-3412-bbc2-56d54f67de76",
                                        "glosses": [
                                            "süßes Kleingebäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edecf52-9a93-47a7-b818-0c3c408953d9",
                                                "sense_id": "1c745650-e217-382a-8057-578598913f1e",
                                                "text": "Ich habe mir beim Bäcker ein süßes Stückchen geholt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "604ef6a9-33e6-4a3b-8512-488b328539a1",
