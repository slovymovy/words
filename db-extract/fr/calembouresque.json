                        "examples": [
                            {
                                "example_id": "80f304f7-6751-4be6-8837-b33598768181",
                                "sense_id": "8dd220a0-6b00-3448-bbbc-56f0387c73ad",
                                "text": "Cette vue nette des choses donnait à Flamboche une très rare aptitude à vite et bien définir les gens, avec un tour d'expression, au reste, presque toujours caricatural, et souvent calembouresque, et qui par cela même plaisait singulièrement à Chugnard."
                            },
                            {
                                "example_id": "3c672370-2a1e-4693-ba74-3e4f42ccd969",
                                "sense_id": "8dd220a0-6b00-3448-bbbc-56f0387c73ad",
                                "text": "Les pochoirs de Miss Tic montraient généralement des figures féminines, piquées à des magazines ou issues d’autoportraits photographiques, accompagnées de petits aphorismes calembouresques."
                            }
                        ]
