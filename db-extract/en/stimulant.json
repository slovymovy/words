            {
                "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                "word": "stimulant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "066bd369-b7cd-4bd8-abbe-22c040437057",
                        "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                        "tags": [
