                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
                                        "glosses": [
                                            "The forcible ending of a siege; liberation from similar military peril."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8bdc927-7950-4b39-9949-0b879378e73f",
                                                "sense_id": "53c29822-0da6-35f6-982e-a713d4c9a5b2",
                                                "text": "The rescue of Jerusalem was the original motive of the Crusaders"
                                            }
