                    {
                        "form_id": "f862f9fd-aee4-43c9-bee2-ff66a0a4de9d",
                        "entry_id": "f03ae8ef-8a5e-3838-9fba-e2c2b492ec85",
                        "tags": [
                            "accusative",
                            "plural"
