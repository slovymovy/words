                "senses": [
                    {
                        "sense_id": "369ae3d9-b31e-3845-b7d2-3397f4be1e2b",
                        "entry_id": "feec0af7-a7c8-3932-91a3-23067856302d",
                        "glosses": [
                            "Prévoir des fonds insuffisants en tant que provision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65180a21-8dfb-4aee-835e-1a315d752439",
                                "sense_id": "369ae3d9-b31e-3845-b7d2-3397f4be1e2b",
                                "text": "En décembre, le parquet national financier avait ouvert une enquête préliminaire après une plainte de Greenpeace reprochant à EDF la publication d’un \"bilan inexact\" et la diffusion d’\"informations trompeuses\". L’ONG s’appuyait sur une étude du cabinet AlphaValue estimant que l’électricien avait sous-provisionné les coûts du démantèlement."
                            },
                            {
                                "example_id": "0a6463e0-969f-4155-a0ab-bb7ad4de08bd",
                                "sense_id": "369ae3d9-b31e-3845-b7d2-3397f4be1e2b",
                                "text": "En n’intégrant pas les risques dans leurs prix, les banques ont peut-être largement sous-provisionné leurs portefeuilles de créances."
                            }
                        ]
                    }
