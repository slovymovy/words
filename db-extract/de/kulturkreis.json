                ],
                "senses": [
                    {
                        "sense_id": "9d26765b-ea71-394d-afee-6f52150e73ea",
                        "entry_id": "897ded0c-f0b0-3fa8-9bce-6b2c93955038",
                        "glosses": [
                            "Bereich, in dem ähnliche/gleiche kulturelle Vorstellungen und/oder Gepflogenheiten gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12023735-fa9a-40aa-8908-71feb218cf71",
                                "sense_id": "9d26765b-ea71-394d-afee-6f52150e73ea",
                                "text": "„Tatsächlich sind solche Verwünschungen in unserem Kulturkreis aus der Mode gekommen, wohl hauptsächlich deshalb, weil wir nicht mehr daran glauben, dass uns jemand bei ihrer Umsetzung helfen kann.“"
                            },
                            {
                                "example_id": "614637d4-ef66-4455-b2f1-289b1480d989",
                                "sense_id": "9d26765b-ea71-394d-afee-6f52150e73ea",
                                "text": "„Im Laufe der Jahrhunderte bildeten sich folgende Hauptarten von Ordalien in unserem Kulturkreis heraus.“"
                            },
                            {
                                "example_id": "a1e269b7-1bdc-4859-abb5-936f3d6e7797",
                                "sense_id": "9d26765b-ea71-394d-afee-6f52150e73ea",
                                "text": "„Durch die ganze Geschichte des aschkenasischen Judentums hindurch, besonders in der Zeit bis 1600, wurden zudem wiederholt Einflüsse aus den anderen jüdischen Kulturkreisen aufgenommen und zum Bestandteil der eigenen Tradition gemacht.“"
                            },
                            {
                                "example_id": "21ccab57-023e-435e-a7b6-318654d3e71b",
                                "sense_id": "9d26765b-ea71-394d-afee-6f52150e73ea",
                                "text": "„Konkreter sind die zahlreichen archäologischen Funde, die man aufgrund ihrer auffälligen Gemeinsamkeiten einem übergreifenden Kulturkreis zuordnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
