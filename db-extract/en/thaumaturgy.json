                ],
                "senses": [
                    {
                        "sense_id": "93da2c80-9c30-3a83-9f36-7cb08a556aa4",
                        "entry_id": "6639ffa1-5be9-39c5-bd18-44805977103a",
                        "glosses": [
                            "The working of miracles, wonderworking; magic, witchcraft, wizardry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b8d8411-78cf-4bf8-8734-709580f97fa4",
                                "sense_id": "93da2c80-9c30-3a83-9f36-7cb08a556aa4",
                                "text": "On all subjects known to man, from the Thirty-nine Articles of our English Church, down to pyrotechnics, legerdemain, magic, both black and white, thaumaturgy, and necromancy, he favoured the world (which world was the nursery where I lived amongst my sisters) with his select opinions."
                            },
                            {
                                "example_id": "2390711b-bc90-4b7e-92e5-168419b229cf",
                                "sense_id": "93da2c80-9c30-3a83-9f36-7cb08a556aa4",
                                "text": "There were astonishing changes. The small hours found Mr. Maydig and Mr. Fotheringay careering across the chilly market square under the still moon, in a sort of ecstasy of thaumaturgy, Mr. Maydig all flap and gesture, Mr. Fotheringay short and bristling, and no longer abashed at his greatness"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7babf335-98b7-4aa7-bbb8-b203d388d563",
                        "source_entry_id": "6639ffa1-5be9-39c5-bd18-44805977103a",
                        "source_sense_id": "93da2c80-9c30-3a83-9f36-7cb08a556aa4",
                        "source_sense_description": "the working of miracles",
                        "target_lang_word": "thaumaturgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thaumaturgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4dd3be6-abf2-3251-bcff-9dda512aa965",
                                        "entry_id": "624401b5-6c3c-370d-bd5f-28b8be96d76e",
                                        "glosses": [
                                            "Art du thaumaturge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dab88d-6c47-496c-a830-c4dd72f3c461",
                                                "sense_id": "f4dd3be6-abf2-3251-bcff-9dda512aa965",
                                                "text": "Mr Merritt a toujours reconnu n’avoir rien vu de vraiment horrible à la ferme de Pawtuxet Road, mais il a déclaré que les titres des volumes traitant de thaumaturgie, d’alchimie et de théologie, avaient suffi à lui inspirer une véritable répulsion."
                                            },
                                            {
                                                "example_id": "7844e240-409c-414f-892c-bfe457dfaaab",
                                                "sense_id": "f4dd3be6-abf2-3251-bcff-9dda512aa965",
                                                "text": "La thaumaturgie tenait une grande place dans les doctrines d’Apollonius de Tyane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb431da0-b5cf-4340-8cbe-c75e0daa5139",
