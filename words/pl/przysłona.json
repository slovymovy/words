    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ad25091-eb13-3244-8029-ce3e81763c4e",
                    "sense_definition": "część obiektywu regulująca wielkość otworu, przez który światło wpada do wnętrza aparatu lub kamery",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optyka_i_fotografia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W słoneczny dzień odpowiednio ustawiona <w>przysłona</w> pozwala uniknąć prześwietlenia zdjęcia.",
                            "target_lang_translations": {
                                "ru": "В солнечный день правильно выставленная <w>диафрагма</w> позволяет избежать переэкспонирования снимка."
                            }
                        },
                        {
                            "text": "Mniejsza <w>przysłona</w> wymaga dłuższego czasu naświetlania.",
                            "target_lang_translations": {
                                "ru": "Меньшая <w>диафрагма</w> требует более длинной выдержки."
                            }
                        }
                    ],
                    "synonyms": [
                        "apertura",
                        "diafragma",
                        "przesłona"
                    ],
                    "common_phrases": [
                        "regulacja przysłony",
                        "otwarcie przysłony"
                    ],
                    "target_lang_definitions": {
                        "ru": "деталь объектива, регулирующая размер отверстия, через которое свет попадает внутрь фотоаппарата или камеры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диафрагма",
                                "target_lang_sense_clarification": "механизм объектива"
                            },
                            {
                                "target_lang_word": "апертура",
                                "target_lang_sense_clarification": "оптический элемент, диафрагма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69df820f-2322-3549-9478-0472386f8809",
                    "sense_definition": "przedmiot lub osłona, która częściowo zakrywa coś i czyni to niewidocznym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsta <w>przysłona</w> z mgły utrudniała kierowcom widoczność na drodze.",
                            "target_lang_translations": {
                                "ru": "Густая <w>пелена</w> тумана ухудшала видимость водителям на дороге."
                            }
                        },
                        {
                            "text": "Wtedy materiałowa <w>przysłona</w> nagle opadła, odsłaniając przygotowany obraz.",
                            "target_lang_translations": {
                                "ru": "Тогда тканевая <w>завеса</w> внезапно упала, открыв подготовленную картину."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesłona"
                    ],
                    "common_phrases": [
                        "cienka przysłona"
                    ],
                    "target_lang_definitions": {
                        "ru": "предмет, преграда или завеса, частично или полностью скрывающая что-либо из виду"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завеса",
                                "target_lang_sense_clarification": "скрывающая преграда, пелена"
                            },
                            {
                                "target_lang_word": "заслонка",
                                "target_lang_sense_clarification": "закрывающее приспособление, экран"
                            },
                            {
                                "target_lang_word": "ширма",
                                "target_lang_sense_clarification": "перегородка, заслон"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "о тумане, дыме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e043528-248c-3aad-be2b-f73c0d131a3d",
                    "sense_definition": "wartość liczbowa określająca stopień otwarcia otworu względnego w obiektywie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "optyka_i_fotografia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fotograf ustawił <w>przysłonę</w> f/2.8, aby uzyskać małą głębię ostrości.",
                            "target_lang_translations": {
                                "ru": "Фотограф выставил <w>диафрагму</w> f/2.8, чтобы получить малую глубину резкости."
                            }
                        },
                        {
                            "text": "Duża <w>przysłona</w> oznacza, że do matrycy dociera bardzo dużo światła.",
                            "target_lang_translations": {
                                "ru": "Открытая <w>диафрагма</w> означает, что на матрицу попадает очень много света."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wartość przysłony"
                    ],
                    "target_lang_definitions": {
                        "ru": "числовое значение, определяющее степень открытия относительного отверстия объектива"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диафрагма",
                                "target_lang_sense_clarification": "числовое значение, диафрагменное число"
                            },
                            {
                                "target_lang_word": "диафрагменное число",
                                "target_lang_sense_clarification": "число f-стоп"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}