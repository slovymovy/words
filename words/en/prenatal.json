    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4b56e114-8d8d-3281-88cd-c25362510b95",
                    "sense_definition": "Occurring, existing, or performed before birth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular <w>prenatal</w> care is essential for monitoring the health of both mother and baby.",
                            "target_lang_translations": {
                                "zh": "定期的<w>产前</w>护理对于监测母婴健康至关重要。"
                            }
                        },
                        {
                            "text": "The doctor recommended several <w>prenatal</w> tests during the first trimester.",
                            "target_lang_translations": {
                                "zh": "医生建议在孕早期做几项<w>产前</w>检查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antenatal"
                    ],
                    "antonyms": [
                        "postnatal"
                    ],
                    "common_phrases": [
                        "prenatal care",
                        "prenatal vitamins",
                        "prenatal diagnosis",
                        "prenatal development"
                    ],
                    "target_lang_definitions": {
                        "zh": "出生前的；产前的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "产前的",
                                "target_lang_sense_clarification": "指分娩前或出生前的阶段、检查或护理"
                            },
                            {
                                "target_lang_word": "出生前的",
                                "target_lang_sense_clarification": "指婴儿出生之前的状态或发展"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "924b1a75-085b-30ec-988f-2de9e63aaac2",
                    "sense_definition": "A dietary supplement, typically a multivitamin, formulated for pregnant people.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was advised to take a daily <w>prenatal</w> containing folic acid.",
                            "target_lang_translations": {
                                "zh": "医生建议她每天服用含叶酸的<w>孕妇维生素</w>。"
                            }
                        },
                        {
                            "text": "He bought a bottle of gummy <w>prenatals</w> from the pharmacy.",
                            "target_lang_translations": {
                                "zh": "他从药店买了一瓶软糖型<w>孕妇维生素</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily prenatal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an informal truncation of prenatal vitamin"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "孕期复合维生素；产前补充剂"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孕妇维生素",
                                "target_lang_sense_clarification": "专为孕妇调配的复合维生素补充剂"
                            },
                            {
                                "target_lang_word": "产前复合维生素",
                                "target_lang_sense_clarification": "孕期服用的多种维生素膳食补充剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7934e356-4a83-3364-85d3-5c0668687fbb",
                    "sense_definition": "A pregnant individual who is awaiting childbirth.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic organized a support group specifically for new <w>prenatals</w>.",
                            "target_lang_translations": {
                                "zh": "诊所专门为初次怀孕的<w>孕妇</w>组织了一个互助小组。"
                            }
                        },
                        {
                            "text": "Special nutrition classes were offered to all <w>prenatals</w> at the community hospital.",
                            "target_lang_translations": {
                                "zh": "社区医院为所有<w>待产妇</w>提供了专项营养课程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "待产孕妇；即将分娩的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孕妇",
                                "target_lang_sense_clarification": "怀孕待产的女性"
                            },
                            {
                                "target_lang_word": "待产妇",
                                "target_lang_sense_clarification": "等待分娩的孕妇"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}