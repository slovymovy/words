                        ],
                        "examples": [
                            {
                                "example_id": "25478f63-053b-492d-8f7c-067eef07ee1a",
                                "sense_id": "ea6b9f94-1018-3484-8f6d-dfe475684ea1",
                                "text": "Je veux refuser de suivre ces longs calculs sur leur trace méandreuse."
                            },
                            {
                                "example_id": "16bf104f-5daa-45b5-ba82-43ae063761c6",
                                "sense_id": "ea6b9f94-1018-3484-8f6d-dfe475684ea1",
                                "text": "La fulgurance du crash tranche avec la lenteur de la réponse judiciaire. Depuis la mise en examen initiale d’Air France et d’Airbus – la compagnie et le constructeur de l’avion –, dix ans d’instruction méandreuse se sont écoulés."
                            }
                        ]
