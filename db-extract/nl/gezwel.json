                "translations": [
                    {
                        "translation_id": "391143a4-21a4-4143-9376-8a6f72309313",
                        "source_entry_id": "d1eddeeb-66a5-37cb-ac3c-a7f9b16d400f",
                        "source_sense_id": "58d70ac2-1129-381f-9adf-d27e5f18faa0",
                        "source_sense_description": "een onnatuurlijke verdikking in het weefsel",
                        "target_lang_word": "Geschwulst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwulst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                        "entry_id": "af7c3888-c4ca-31af-88cf-d7e8e2687b09",
                                        "glosses": [
                                            "Schwellung des Gewebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eddfb37-480e-4fbc-91b5-d3128330e0d9",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "Am Hals hatte sich eine Geschwulst gebildet."
                                            },
                                            {
                                                "example_id": "6e2e959a-822c-4b5d-8d3e-09d30467c242",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "„In der Nacht wurde die Geschwulst so dick wie eine große Birne, so daß ich am Ostersonntag nicht aufstehen und zur Messe gehen konnte.“"
                                            },
                                            {
                                                "example_id": "5c0e68bd-f678-4826-9113-3f2a5b294cf7",
                                                "sense_id": "7d58e45d-a356-3bdf-9f83-e2153aba254d",
                                                "text": "„Die Initiatoren der Studie kommen klar und unmissverständlich zu dem Schluss, dass die Behandlungsergebnisse deutlich besser sind, wenn man nach der chirurgischen Entfernung der Geschwulst eine Chemotherapie anstelle der bisher üblichen Strahlentherapie durchführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69660dcf-b22c-41a3-bf68-efc675dd79c9",
                        "source_entry_id": "d1eddeeb-66a5-37cb-ac3c-a7f9b16d400f",
                        "source_sense_id": "58d70ac2-1129-381f-9adf-d27e5f18faa0",
                        "source_sense_description": "een onnatuurlijke verdikking in het weefsel",
                        "target_lang_word": "Tumor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tumor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                        "entry_id": "9d996a01-3de5-3d9a-9a4b-cae7b47b89d4",
                                        "glosses": [
                                            "Wucherung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e114c3-d380-4ce3-a234-f29ab6b4acf2",
                                                "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                                "text": "„Nur etwa fünf Prozent der Tumore sind erblich bedingt, die übergroße Mehrheit entsteht spontan.“"
                                            },
                                            {
                                                "example_id": "893d076f-7172-4f6d-aee8-3d814ed123fd",
                                                "sense_id": "452d09f2-d887-349d-93f3-47678d8af68b",
                                                "text": "„Weil durch das Kernspinntomogramm die Art des Tumors nicht zu ermitteln war, musste Herman im Juni 1988 eine schmerzhafte Biopsie über sich ergehen lassen, bei der ein Loch in die Schädeldecke gebohrt und eine Probe des Tumorgewebes entnommen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99c3177c-4e66-3877-ac9b-93961bd5d0ad",
                                        "entry_id": "9d996a01-3de5-3d9a-9a4b-cae7b47b89d4",
                                        "glosses": [
                                            "Schwellung (unklarer Ursache)"
                                        ],
                                        "tags": [
                                            "seltener allgemeiner"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
