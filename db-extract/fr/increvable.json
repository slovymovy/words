                                                "text": "My abandoned heart"
                                            },
                                            {
                                                "example_id": "d867ed39-f30c-4aa1-8d9f-761ed7913a69",
                                                "sense_id": "056f45a6-9425-3212-8742-74cf8d6637f7",
                                                "text": "Just doesn't understand"
                                            },
                                            {
                                                "example_id": "10790593-d513-459e-997a-70dfcf0621b6",
                                                "sense_id": "056f45a6-9425-3212-8742-74cf8d6637f7",
                                                "text": "My undying love for you"
                                            },
                                            {
                                                "example_id": "14dd121c-94a5-4837-a088-aa79d9b1c771",
                                                "sense_id": "056f45a6-9425-3212-8742-74cf8d6637f7",
                                                "text": "Won't let me wait - Janet Jackson - Come Back to Me"
                                            }
                                        ]
                                    }
