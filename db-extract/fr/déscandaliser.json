                "senses": [
                    {
                        "sense_id": "fc3e9420-6eb9-392b-ab40-28cc85c5b393",
                        "entry_id": "a0519a4b-25dd-3ba7-9a8e-cd6418cf4785",
                        "glosses": [
                            "Faire perdre son caractère scandaleux à."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "48e73524-9525-3e08-9503-f97ad36d5529",
                        "entry_id": "a0519a4b-25dd-3ba7-9a8e-cd6418cf4785",
                        "glosses": [
                            "Faire perdre son caractère scandaleux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1daecb9-7668-43fa-a154-7b267fdde1f0",
                                "sense_id": "48e73524-9525-3e08-9503-f97ad36d5529",
                                "text": "Il est utile, à ce point, de revenir un moment à la préface de Barrès, qui dès l'abord, nous était apparue quelque peu suspecte dans son désir de \"déscandaliser le texte de Rachilde."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cba0ab7-25d2-38ce-a3a6-7b9a26a56d26",
                        "entry_id": "a0519a4b-25dd-3ba7-9a8e-cd6418cf4785",
                        "glosses": [
                            "Faire cesser d’être scandalisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3546b309-4d5c-4ee7-9373-6db6b12f44b5",
                                "sense_id": "3cba0ab7-25d2-38ce-a3a6-7b9a26a56d26",
                                "text": "Abysse soupire mais reprend bien vite, histoire de déscandaliser la jeune demoiselle."
                            },
                            {
                                "example_id": "37767d28-0369-4e6a-9da1-18348062a798",
                                "sense_id": "3cba0ab7-25d2-38ce-a3a6-7b9a26a56d26",
                                "text": "J'écris pour me déscandaliser de l'infidélité de l'aimé qui, au moment même où il m'aura charmée, sera toujours déjà perdu."
                            }
                        ]
                    }
