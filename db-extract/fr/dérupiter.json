                        "sense_id": "fbf634ed-53b1-3f33-8e3c-ab6d353e8e6b",
                        "entry_id": "58ddb951-3913-3aab-bcf6-85be9e5d36c1",
                        "glosses": [
                            "Tomber (en montagne)."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "1370b624-1e80-4c14-b2b8-2ea4edde4bc3",
                                "sense_id": "fbf634ed-53b1-3f33-8e3c-ab6d353e8e6b",
                                "text": "Notre montagne est dangereuse, suivez bien les chemins, ne vous écartez pas au pied du mont César : il est maudit, le diable y fait dérupiter des pierres sans arrêt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9168f728-ebe1-39d8-854d-b8bcd2115d27",
                        "entry_id": "58ddb951-3913-3aab-bcf6-85be9e5d36c1",
                        "glosses": [
                            "Dévaler."
                        ],
                        "tags": [
