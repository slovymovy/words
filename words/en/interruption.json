{
    "word_family": [
        "interrupt",
        "interrupter",
        "uninterrupted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c8d0973-850f-35a9-9aba-0c950c7a5f55",
                    "sense_definition": "An action or event that stops an activity or process from continuing smoothly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stopping_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to finish writing the report without any <w>interruption</w>.",
                            "target_lang_translations": {
                                "tr": "Raporu yazmayı hiç <w>bölünmeden</w> bitirmeye çalıştım."
                            }
                        },
                        {
                            "text": "Frequent phone calls caused constant <w>interruption</w> to her work.",
                            "target_lang_translations": {
                                "tr": "Sık gelen telefon aramaları işinin sürekli <w>aksamasına</w> neden oldu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "without interruption",
                        "constant interruption"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir faaliyetin veya sürecin sorunsuz bir şekilde devam etmesini engelleyen bir eylem veya olay."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bölünme",
                                "target_lang_sense_clarification": "bir işin veya sürecin aksaması durumu"
                            },
                            {
                                "target_lang_word": "kesinti",
                                "target_lang_sense_clarification": "bir sürecin veya akışın durması"
                            },
                            {
                                "target_lang_word": "aksama",
                                "target_lang_sense_clarification": "bir faaliyetin sekteye uğraması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a432b529-7d09-3c77-85ce-c5a568c42462",
                    "sense_definition": "The act of speaking when someone else is already talking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stopping_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He listened politely to the teacher without making a single <w>interruption</w>.",
                            "target_lang_translations": {
                                "tr": "Öğretmeni hiç <w>sözünü kesmeden</w> kibarca dinledi."
                            }
                        },
                        {
                            "text": "Pardon the <w>interruption</w>, but there is an urgent phone call for you.",
                            "target_lang_translations": {
                                "tr": "<w>Böldüğüm</w> için kusura bakmayın ama sizin için acil bir telefon var."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pardon the interruption"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başka biri konuşurken sözünü kesme eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "söz kesme",
                                "target_lang_sense_clarification": "birinin konuşmasını bölme"
                            },
                            {
                                "target_lang_word": "araya girme",
                                "target_lang_sense_clarification": "konuşma esnasında araya laf sokma"
                            },
                            {
                                "target_lang_word": "bölme",
                                "target_lang_sense_clarification": "konuşmayı kesintiğe uğratma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2abe068d-54b3-370d-b16e-1a4989518087",
                    "sense_definition": "A temporary period or break during which an ongoing activity or service ceases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stopping_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe winter weather caused a brief <w>interruption</w> of power supply.",
                            "target_lang_translations": {
                                "tr": "Şiddetli kış havası, elektrik arzında kısa süreli bir <w>kesintiye</w> yol açtı."
                            }
                        },
                        {
                            "text": "Passengers were informed of an unexpected <w>interruption</w> of service along the railway line.",
                            "target_lang_translations": {
                                "tr": "Yolcular, demir yolu hattında beklenmedik bir sefer <w>kesintisi</w> olduğu konusunda bilgilendirildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiatus",
                        "pause"
                    ],
                    "common_phrases": [
                        "interruption of service"
                    ],
                    "target_lang_definitions": {
                        "tr": "Devam eden bir faaliyetin veya hizmetin durduğu geçici bir süre veya ara."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kesinti",
                                "target_lang_sense_clarification": "hizmet veya güç akışının durması"
                            },
                            {
                                "target_lang_word": "ara",
                                "target_lang_sense_clarification": "geçici duraklama"
                            },
                            {
                                "target_lang_word": "duraklama",
                                "target_lang_sense_clarification": "hizmette yaşanan geçici duraksama"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}