                "senses": [
                    {
                        "sense_id": "12e24be5-fef4-3d70-8981-7c317d99b266",
                        "entry_id": "d7ba352c-a066-336a-9559-dc5446a1b898",
                        "glosses": [
                            "Aiguiser en utilisant une pierre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8115b862-93c1-47c3-b626-c49ffc07910f",
                                "sense_id": "12e24be5-fef4-3d70-8981-7c317d99b266",
                                "text": "Au lieu de pierre à émouler, on peut se servir d’un morceau de tilleul, de sapin ou de toute autre bois tendre, bien poli, sur lequel on étend un peu de sable ou de grès très-fin."
                            },
                            {
                                "example_id": "37df42a7-e5a9-44d5-a80c-cf49cf8cef57",
                                "sense_id": "12e24be5-fef4-3d70-8981-7c317d99b266",
                                "text": "Au détriment des causeries sans fin de l’oratoire, faucons et lances reprirent faveur: on n'entendait que destriers piaffer et veneurs jouer des fanfares; chacun émoulait des lances pour courir en champ clos."
                            },
                            {
                                "example_id": "fef27711-f9bd-47ba-b75d-dfe1079b77b0",
                                "sense_id": "12e24be5-fef4-3d70-8981-7c317d99b266",
                                "text": "L’exposant est établi depuis 3 ans, il a une machine à vapeur de la force d’un cheval, 5 machines à polir et émouler, et occupe constamment 3 ouvriers."
                            }
                        ]
                    }
                ],
