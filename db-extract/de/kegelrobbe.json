                "senses": [
                    {
                        "sense_id": "63804fb5-fef7-3e7d-989d-78db81abc919",
                        "entry_id": "77af9d13-0299-3156-9a98-3283644add4f",
                        "glosses": [
                            "im nordatlantischen Raum verbreitete Robbenart, die bis zu 300 Kilogramm schwer und 2,5 Meter groß werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b63614a-0752-4bb8-8959-240b2248655c",
                                "sense_id": "63804fb5-fef7-3e7d-989d-78db81abc919",
                                "text": "„Die Kegelrobbe, die bis zu 2,30 Meter lang werden kann, verdankt ihren Namen der kegelförmigen Schnauze.“"
                            },
                            {
                                "example_id": "43bb0066-6945-4cfe-9a2f-1c0862ce083d",
                                "sense_id": "63804fb5-fef7-3e7d-989d-78db81abc919",
                                "text": "„Die Kegelrobbe ist das größte Raubtier, das heute in Deutschland frei lebt.“"
                            },
                            {
                                "example_id": "5d0b88cb-ddf6-4ab8-b998-eace25afe1d1",
                                "sense_id": "63804fb5-fef7-3e7d-989d-78db81abc919",
                                "text": "„Die kleine Insel gefällt aber nicht nur menschlichen Besuchern, sondern auch Seehunden und Kegelrobben, die seit einigen Jahren hier auch ihren Nachwuchs zur Welt bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
