                "senses": [
                    {
                        "sense_id": "3789e1ad-c7a9-37bd-bd87-cc2ae63c2ecc",
                        "entry_id": "65dd4aec-d484-34ad-9e69-9785b1b4ff99",
                        "glosses": [
                            "ein Kunstgriff, bei dem ein mehr oder weniger beliebiges Objekt die Handlung in Gang setzt oder vorantreibt, ohne dass es selbst von großer Bedeutung ist"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "01342d7f-a832-4627-b0c3-c6f40a6aad8a",
                                "sense_id": "3789e1ad-c7a9-37bd-bd87-cc2ae63c2ecc",
                                "text": "„Der MacGuffin ist für die Figuren der Handlung von höchster Bedeutung, spielt aber für den Erzähler keine Rolle.”"
                            },
                            {
                                "example_id": "e2ff103b-9c5b-48de-a5fa-49be7c6bdfea",
                                "sense_id": "3789e1ad-c7a9-37bd-bd87-cc2ae63c2ecc",
                                "text": "„An dieser Stelle soll es nicht um Punisher als verbitterten Anti-Helden gehen, der Menschen umbringt, sondern darum, dass er einen MacGuffin in seinem eigenen Geschichte darstellt, ein Objekt, auf das es eigentlich nicht ankommt.”"
                            },
                            {
                                "example_id": "2d525152-9df2-4bd2-ae0c-da7e86040b16",
                                "sense_id": "3789e1ad-c7a9-37bd-bd87-cc2ae63c2ecc",
                                "text": "Alfred Hitchcock prägte den Begriff MacGuffin."
                            },
                            {
                                "example_id": "4c8bde6b-e8a4-4bd0-8e6e-3e67ecd80dc2",
                                "sense_id": "3789e1ad-c7a9-37bd-bd87-cc2ae63c2ecc",
                                "text": "Der Koffer aus „Pulp Fiction” ist ein bekannter MacGuffin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
