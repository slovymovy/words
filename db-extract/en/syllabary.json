                        "entry_id": "8556cd15-80fe-34f0-92d2-b17d9a2341fe",
                        "glosses": [
                            "A table or list of syllabic letters or syllables."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f2e4ee7d-1cd7-3218-bada-43030879773b",
                        "entry_id": "8556cd15-80fe-34f0-92d2-b17d9a2341fe",
                        "glosses": [
                            "A writing system where each character represents a complete syllable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1904ee3b-d9a1-492c-ad96-fda3b533d988",
                                "sense_id": "f2e4ee7d-1cd7-3218-bada-43030879773b",
                                "text": "It shouldn't be hard to come up with a musical syllabary in which pitches code for vowels and timbres code for consonants."
                            },
                            {
                                "example_id": "7cfd0b8c-de8e-439c-abf1-7e6af2dec61e",
                                "sense_id": "f2e4ee7d-1cd7-3218-bada-43030879773b",
                                "text": "Bamum is a syllabary developed between 1896 and 1910, used for writing the Bamum language in western Cameroon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d4ff4e4-c987-4bb9-8ff1-84afbb005d3e",
                        "source_entry_id": "8556cd15-80fe-34f0-92d2-b17d9a2341fe",
