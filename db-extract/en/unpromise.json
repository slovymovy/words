                        "examples": [
                            {
                                "example_id": "50ca47ad-f473-441f-a7b3-bf22285fe321",
                                "sense_id": "6bcd1652-5dac-3081-b1a7-78c7ea291d1f",
                                "text": "Promises are no fetters: with that tongue\nThy promise past, unpromise it again."
                            },
                            {
                                "example_id": "6f38fe55-40e7-464b-a438-0b5150cb5e07",
                                "sense_id": "6bcd1652-5dac-3081-b1a7-78c7ea291d1f",
                                "text": "\"But I promised Annie we'd take them, Joseph.\" \" Well , you're just going to have to unpromise her!\""
                            },
                            {
                                "example_id": "5c043946-e598-4544-b15b-6161aff2c125",
                                "sense_id": "6bcd1652-5dac-3081-b1a7-78c7ea291d1f",
                                "text": "It wouldn't be a promise if you could just unpromise it."
                            }
                        ]
                    }
