                                "target_senses": [
                                    {
                                        "sense_id": "79905f1f-fbae-338a-9446-b9a123b75f46",
                                        "entry_id": "ed239ce6-61dd-31d7-8f4f-58df60600d42",
                                        "glosses": [
                                            "Partie de l’astronomie qui étudie la chute des bolides et météorites sur la terre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969821d9-a9d3-41f6-ac7f-70347314b01a",
                                                "sense_id": "79905f1f-fbae-338a-9446-b9a123b75f46",
                                                "text": "Il était capable de guetter pendant des mois entiers l’apparition d’un phénomène cosmique. Il avait d’ailleurs une spécialité, les bolides et les étoiles filantes, et ses découvertes dans cette branche de la météorologie méritaient d’être citées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "929da71a-07fd-36ff-8aa9-087eac367d36",
                                        "entry_id": "ed239ce6-61dd-31d7-8f4f-58df60600d42",
                                        "glosses": [
                                            "Discipline ayant pour objet l'étude des phénomènes atmosphériques et de leurs variations, et qui a pour objectif de prévoir à court terme les variations du temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c01b101b-68a5-4597-9ca0-36624ddc2229",
                                                "sense_id": "929da71a-07fd-36ff-8aa9-087eac367d36",
                                                "text": "Les plus importants phénomènes de la météorologie revêtent la forme cyclonique."
                                            },
                                            {
                                                "example_id": "75b92a70-50cf-4f36-a020-407a8de5248f",
                                                "sense_id": "929da71a-07fd-36ff-8aa9-087eac367d36",
                                                "text": "En parlant à tour de rôle devant le microphone, nous aurions dû dire que notre victoire était celle de la technique aéronautique française et de la météorologie, beaucoup plus que le triomphe de deux hommes."
                                            },
                                            {
                                                "example_id": "e7bd9c59-412b-4351-ad1d-840112e17528",
                                                "sense_id": "929da71a-07fd-36ff-8aa9-087eac367d36",
                                                "text": "Comme il appliquait à la météorologie provençale une science acquise dans le Roussillon, il se trompait assez souvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5a4c78-c856-32a7-aafc-0ccbb73b18bc",
                                        "entry_id": "ed239ce6-61dd-31d7-8f4f-58df60600d42",
                                        "glosses": [
                                            "Organisme officiel ou service chargé de cette étude ; l'ensemble des observations effectuées et les prévisions établies par ses soins."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b91ca1-3f08-4702-8b33-17d68cd485e7",
                                                "sense_id": "ce5a4c78-c856-32a7-aafc-0ccbb73b18bc",
                                                "text": "La Météorologie nationale."
                                            },
                                            {
                                                "example_id": "f1279179-4fe5-4625-b9c7-3438ac05b511",
                                                "sense_id": "ce5a4c78-c856-32a7-aafc-0ccbb73b18bc",
                                                "text": "La météorologie fait de nos jours des prévisions assez fiables jusqu’à cinq jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
