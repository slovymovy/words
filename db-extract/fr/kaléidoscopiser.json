                "senses": [
                    {
                        "sense_id": "6168bbbd-c5aa-356a-bcc6-243f3cdf3bce",
                        "entry_id": "52a82f02-71db-3db5-9571-95ad282e9fbc",
                        "glosses": [
                            "Donner un caractère kaléidoscopique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90f4c50-3e87-4102-a170-922793ebf2b8",
                                "sense_id": "6168bbbd-c5aa-356a-bcc6-243f3cdf3bce",
                                "text": "Il n'est qu'à entendre ce qu'elle fait du temps, comment elle le kaléidoscopise, précisément à la manière dont l'inconscient effectue avec le temps un permanent remue-ménage, remue-méninges."
                            },
                            {
                                "example_id": "662d84e9-d21d-4c03-aeb3-cec46ba51854",
                                "sense_id": "6168bbbd-c5aa-356a-bcc6-243f3cdf3bce",
                                "text": "Compte tenu de cette présence d'un discours social (d'un discours social résiduel) dans la lecture d'un autre discours social, nous serions prêts à proposer d'ouvrir, de «kaléidoscopiser» le statut du texte hégémonique dans le discours social."
                            },
                            {
                                "example_id": "48995ac7-52be-48cc-a6ba-f3d21c102b3e",
                                "sense_id": "6168bbbd-c5aa-356a-bcc6-243f3cdf3bce",
                                "text": "La vision se « kaléidoscopise » : un cercle sans fin."
                            }
                        ]
                    }
                ],
