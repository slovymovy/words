                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exorciser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c319ed8-6d02-38ff-aa3d-ebfbf4af77a0",
                                        "entry_id": "b5118483-be4b-383e-a5c2-fcf9b4ccabe4",
                                        "glosses": [
                                            "Pour les croyants, s’efforcer de chasser les démons du corps d’un possédé en se servant des prières et des cérémonies de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284d1910-647b-4726-a9ad-3aed79b22557",
                                                "sense_id": "9c319ed8-6d02-38ff-aa3d-ebfbf4af77a0",
                                                "text": "Exorciser un possédé."
                                            },
                                            {
                                                "example_id": "b8fa0283-5cfc-4fd5-8333-9ee406af7186",
                                                "sense_id": "9c319ed8-6d02-38ff-aa3d-ebfbf4af77a0",
                                                "text": "— Tes parents m'ont appris que tu ne passais pas les fêtes chez eux, ils m'ont invité, j'ai dit non, ils essaieraient encore de me faire exorciser. A la place, c'est la fête du slip à Mykonos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "883d7956-a5bd-36e2-90af-8e8ca7562001",
                                        "entry_id": "b5118483-be4b-383e-a5c2-fcf9b4ccabe4",
                                        "glosses": [
                                            "Assainir en éliminant un phénomène immatériel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87877a88-f5e5-4fca-9eab-33616694cfb9",
                                                "sense_id": "883d7956-a5bd-36e2-90af-8e8ca7562001",
                                                "text": "Emménager dans un appartement, c'est d'abord y poser son empreinte, sa patte, c'est le désenvoûter de l'anonymat, l'exorciser des présences antérieures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e588d87f-e294-4a1f-9034-e9460962b60b",
                        "source_entry_id": "f828ec74-df60-3c7b-bad9-44416e37d573",
                        "source_sense_description": "to drive out an evil spirit",
                        "target_lang_word": "exorzieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exorzieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5ad7a72-9816-3172-99b5-35fb4a916bb2",
                                        "entry_id": "d5624410-7c69-355a-b3d9-4d9241ca8da8",
                                        "glosses": [
                                            "böse Geister oder Dämonen durch rituelle Beschwörung aus einem Menschen vertreiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d639a0-7c1b-48a2-bc83-ce759b86e084",
                                                "sense_id": "e5ad7a72-9816-3172-99b5-35fb4a916bb2",
                                                "text": "Und wenn er seine Hand auf sie legt, soll er alle fremden Geister exorzieren, dass sie aus ihnen entfliehen und von da an nicht mehr zurückkehren."
                                            },
                                            {
                                                "example_id": "1dbcfa51-92f9-401b-96be-2212b06c810a",
                                                "sense_id": "e5ad7a72-9816-3172-99b5-35fb4a916bb2",
                                                "text": "Von 1634 bis 1637 wurde er als Exorzist nach Loudun geschickt, um Ursulinen zu exorzieren, die für besessen gehalten wurden …"
                                            },
                                            {
                                                "example_id": "68abfafc-5354-48f1-818f-7e7682c8b1a4",
                                                "sense_id": "e5ad7a72-9816-3172-99b5-35fb4a916bb2",
                                                "text": "Von 1635 bis 1651 zeigte er Anzeichen von Schizophrenie und wird selbst exorziert."
                                            },
                                            {
                                                "example_id": "f974ec43-2613-4ea5-9bd1-698028e3b77f",
                                                "sense_id": "e5ad7a72-9816-3172-99b5-35fb4a916bb2",
                                                "text": "Fort, Ihr Gespenster! ich spreche jetzt von einem Manne, dessen Name schon eine exorzierende Macht ausübt, ich spreche von Immanuel Kant!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c04c2970-6290-4320-bcd5-1bc85acbd37f",
                        "source_entry_id": "f828ec74-df60-3c7b-bad9-44416e37d573",
                        "source_sense_description": "to drive out an evil spirit",
                        "target_lang_word": "austreiben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austreiben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4d860f1-aee2-3d33-b4d6-786a5a9d6737",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "Weidevieh auf die Weide treiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f447560-36b6-4f3b-afe8-fb7863cb4add",
                                                "sense_id": "b4d860f1-aee2-3d33-b4d6-786a5a9d6737",
                                                "text": "Kühe sollten möglichst früh ausgetrieben werden, auch wenn die Gefahr besteht, dass sie wegen ungünstiger Witterungsbedingungen nochmals kurzfristig eingestellt werden müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "030f3bb0-b68e-30ce-86b9-11731958084f",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "gelöste Gase aus einer Flüssigkeit entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5852d19b-a17f-4a73-8c7f-2e63241e8c16",
                                                "sense_id": "030f3bb0-b68e-30ce-86b9-11731958084f",
                                                "text": "CO2 und O2 haben tatsächlich nichts miteinander zu tun. Das heißt auch, CO2 kann keinen Sauerstoff austreiben."
                                            },
                                            {
                                                "example_id": "3a2a79db-9d6e-48d0-a82c-95e15a34074b",
                                                "sense_id": "030f3bb0-b68e-30ce-86b9-11731958084f",
                                                "text": "Der Effekt der Kohlensäureminderung basiert auf zwei Phänomenen: Zum einen liefern die Blasen einen starken mechanischen Impuls beziehungsweise eine Turbulenz, welche die Kohlensäure austreiben kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5e2c51d-7e6a-32e2-9b90-4016e244ad33",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "jemandem etwas vehement abgewöhnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdabfe30-f783-4be2-aaac-7b2e1f86713a",
                                                "sense_id": "a5e2c51d-7e6a-32e2-9b90-4016e244ad33",
                                                "text": "Sie sollen Gewalt, Korruption und Dummheit austreiben."
                                            },
                                            {
                                                "example_id": "897e3efd-2da6-40c9-ab9e-a2b6850266a0",
                                                "sense_id": "a5e2c51d-7e6a-32e2-9b90-4016e244ad33",
                                                "text": "Der würde schon dem Brandauer seine Bettlägerigkeit und dem Deutelmoser seine Flausen austreiben, seine »fahrlässige Körperverletzung« und »pflichtvergessene Sorglosigkeit«, die hier eine Sense stehen läßt und dort zur Bändigung eines rasenden Mutterschweins einen Professor und einen Tanzlehrer verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "99532de2-ae11-349d-8598-f052f9ad4725",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "durch Beschwörung verbannen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc03089-c043-4dae-840e-5d9c589aa0ff",
                                                "sense_id": "99532de2-ae11-349d-8598-f052f9ad4725",
                                                "text": "Gegen Ende dieser Zeit ließ er Herodes wissen, dass er so lange Dämonen austreiben und Menschen heilen würde, bis sein irdischer Auftrag erfüllt wäre (vgl. Lukas 13,32)."
                                            },
                                            {
                                                "example_id": "f8a59e1c-5032-4c1b-8615-3cda2edf2e9f",
                                                "sense_id": "99532de2-ae11-349d-8598-f052f9ad4725",
                                                "text": "Dann passierte das Martyrium, das dann Gott sei Dank doch nicht zum Tod führte: Die Rumänin wollte der Waldviertlerin den „Teufel austreiben“ und fügte ihr dazu zahlreiche oberflächliche Schnittwunden sowie eine Stichwunde zu, die jedoch nicht lebensgefährlich waren."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "dc787c35-1450-3c14-9a61-34bc5c4aca0b",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "etwas oder jemanden vertreiben"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766a2fdb-0af4-4fff-b483-ee9ab26f0db5",
                                                "sense_id": "dc787c35-1450-3c14-9a61-34bc5c4aca0b",
                                                "text": "Du weißt, wo er und der Ähnl die Bären austrieben und wo die Knochen der Riesen im Sande liegen, die Thor mit den Felsen erschlug."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9c5800df-cf0d-3ce5-8df2-a2860d179e74",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "den Teig ausrollen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a810e725-5656-48b1-af35-bb00c73c9c70",
                                                "sense_id": "9c5800df-cf0d-3ce5-8df2-a2860d179e74",
                                                "text": "Den Teig mit der Nudelmaschine in dünne 10x10 cm große Blätter austreiben."
                                            },
                                            {
                                                "example_id": "782309b8-9e20-4998-8c19-f7d05f4e753c",
                                                "sense_id": "9c5800df-cf0d-3ce5-8df2-a2860d179e74",
                                                "text": "Anschließend den Teig austreiben und möglichst schnell verarbeiten, damit er nicht austrocknet."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "dc428e18-d7dc-3f2e-8eea-fd2d38fc6d18",
                                        "entry_id": "ca5cda0e-3650-3465-8971-57a4656930b9",
                                        "glosses": [
                                            "grün werden; neue Triebe hervorbringen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a099ba6b-1f52-409f-9075-d237f51bc928",
                                                "sense_id": "dc428e18-d7dc-3f2e-8eea-fd2d38fc6d18",
                                                "text": "Meist leiden die zweijährigen Himbeerruten von Sommerhimbeeren unter Winterschäden, wenn sie nicht gut austreiben: In die Wachstumsrisse, die in der Rinde der einjährigen Ruten entstanden sind, dringen Pathogene ein, Pilze, allenfalls auch Bakterien, und verursachen Schäden."
                                            },
                                            {
                                                "example_id": "378f74e5-5fee-4d6f-9e67-a41bef6d1b35",
                                                "sense_id": "dc428e18-d7dc-3f2e-8eea-fd2d38fc6d18",
                                                "text": "… brach er sich von jeder Strauchart ein paar kurze Zweigspitzen ab. Die steckte er zu Hause in ein Wasserglas, wo sie bald austrieben, jedes auf seine Weise."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
