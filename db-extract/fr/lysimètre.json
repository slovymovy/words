                "entry_id": "3c7fd8ce-4697-3623-98b0-7e042e630b8f",
                "word": "lysimètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "967e7e00-15ef-4862-baeb-5a688085997d",
                        "entry_id": "3c7fd8ce-4697-3623-98b0-7e042e630b8f",
                        "tags": [
                            "plural"
                        ],
                        "form": "lysimètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05946663-73a9-398f-aed9-14aa42bd6658",
                        "entry_id": "3c7fd8ce-4697-3623-98b0-7e042e630b8f",
                        "glosses": [
                            "Dispositif permettant d’étudier et de mesurer l’évolution de l’eau dans un sol."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "e9c040ca-a9f2-4305-82de-7be83ce0d997",
                                "sense_id": "05946663-73a9-398f-aed9-14aa42bd6658",
                                "text": "L’étude consiste à suivre, en lysimètres sur plusieurs années, la répartition de l’azote apporté entre les drainages, la matière organique du sol et les récoltes."
                            },
                            {
                                "example_id": "91f14d51-4244-41bb-9bbc-5cc22317ca64",
                                "sense_id": "05946663-73a9-398f-aed9-14aa42bd6658",
                                "text": "La mesure de l’évapotranspiration de référence sur gazon au moyen d'un évapotranspiromètre ou lysimètre à drainage s’effectue au sein d’un anneau de garde."
                            },
                            {
                                "example_id": "aaaf7f7d-fc10-4aae-b477-c91b76aae64d",
                                "sense_id": "05946663-73a9-398f-aed9-14aa42bd6658",
                                "text": "Les lysimètres sont des dispositifs qui nous permettent d’observer l’infiltration des précipitations dans le sol, jusqu’à atteindre une profondeur où le flux d’eau ne peut plus être repris par la végétation et va donc recharger la nappe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10e2ae27-133b-4f60-895a-dacf2880625a",
                        "source_entry_id": "3c7fd8ce-4697-3623-98b0-7e042e630b8f",
                        "source_sense_id": "05946663-73a9-398f-aed9-14aa42bd6658",
                        "target_lang_word": "Lysimeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lysimeter",
