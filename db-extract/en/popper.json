                        "examples": []
                    },
                    {
                        "sense_id": "98c2ed1b-e33a-3af3-991f-ebc58aafb3fd",
                        "entry_id": "0e47271c-a792-3a18-9672-315318c6cc1d",
                        "glosses": [
                            "A floating lure designed to splash when the fishing line is twitched."
                        ],
