                "senses": [
                    {
                        "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                        "entry_id": "49d910ea-23e5-33cc-80dd-c0aa80d824df",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55496829-b57e-46bd-a752-ea22515a2d47",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Frau Hüpschle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "92bdd8bd-01ef-44d2-b383-4deba92f6010",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Herr Hüpschle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8b363062-ce92-42a3-b0c1-fe03f98802bd",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Die Hüpschles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "83dfe6ee-3fe2-4a28-b0a7-3ff749ff13e9",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Der Hüpschle trägt nie die Schals, die die Hüpschle ihm strickt."
                            },
                            {
                                "example_id": "268650a5-fcaa-40ce-9a13-7a77ccd83c85",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hüpschle kommt, geht der Herr Hüpschle.“"
                            },
                            {
                                "example_id": "1edeb988-1e14-4fb6-ae70-9c4666d761c1",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Hüpschle kommt und geht."
                            },
                            {
                                "example_id": "033ef6e0-7961-4ae8-bb28-d728388f7ce6",
                                "sense_id": "389540fa-5e62-36ce-834d-54dc4ef46efa",
                                "text": "Hüpschles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
