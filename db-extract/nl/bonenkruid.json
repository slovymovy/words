                    {
                        "translation_id": "75cbfd88-7a49-4b8d-88ae-eabbbc06a8b8",
                        "source_entry_id": "3197e525-e8fe-38f8-8c13-8fa26a94e090",
                        "target_lang_word": "ajedrea",
