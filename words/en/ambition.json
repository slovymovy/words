{
    "word_family": [
        "ambitious",
        "ambitiously",
        "ambitiousness",
        "unambitious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ba72e6d-3908-35e5-ab8a-bad802b34d80",
                    "sense_definition": "A strong desire and determination to achieve success, power, or wealth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desire_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has enough <w>ambition</w> to become the CEO of the company one day.",
                            "target_lang_translations": {
                                "ru": "У неё достаточно <w>амбиций</w>, чтобы однажды стать генеральным директором компании.",
                                "zh": "她有足够的<w>抱负</w>，有朝一日能成为公司的首席执行官。"
                            }
                        },
                        {
                            "text": "His political <w>ambition</w> drove him to work long hours every single day.",
                            "target_lang_translations": {
                                "ru": "Его политическое <w>честолюбие</w> заставляло его работать допоздна каждый божий день.",
                                "zh": "他的政治<w>野心</w>驱使他每天长时间工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drive",
                        "determination",
                        "aspiration",
                        "eagerness",
                        "motivation"
                    ],
                    "antonyms": [
                        "apathy",
                        "laziness",
                        "indifference"
                    ],
                    "common_phrases": [
                        "lack of ambition",
                        "burning ambition",
                        "personal ambition",
                        "full of ambition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное желание и решимость достичь успеха, власти или богатства.",
                        "zh": "指对成功、权力或财富的强烈渴望和决心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честолюбие",
                                "target_lang_sense_clarification": "стремление к успеху и славе"
                            },
                            {
                                "target_lang_word": "амбиции",
                                "target_lang_sense_clarification": "притязания, стремление к достижениям (обычно мн. ч.)"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱负",
                                "target_lang_sense_clarification": "远大的志向"
                            },
                            {
                                "target_lang_word": "野心",
                                "target_lang_sense_clarification": "对权势或成功的强烈欲望"
                            },
                            {
                                "target_lang_word": "雄心",
                                "target_lang_sense_clarification": "宏伟的志向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e992113-8f85-3e00-a6e0-85cd69285a1a",
                    "sense_definition": "Something that a person very much wants to achieve or do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "goal_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My main <w>ambition</w> is to travel around the world before I turn thirty.",
                            "target_lang_translations": {
                                "ru": "Моя главная <w>цель</w> — объехать весь мир до тридцати лет.",
                                "zh": "我主要的<w>目标</w>是在三十岁之前环游世界。"
                            }
                        },
                        {
                            "text": "He finally achieved his lifelong <w>ambition</w> of writing a published novel.",
                            "target_lang_translations": {
                                "ru": "Он наконец осуществил свою давнюю <w>мечту</w> — написать и опубликовать роман.",
                                "zh": "他终于实现了出版一部小说的毕生<w>梦想</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goal",
                        "aim",
                        "objective",
                        "dream",
                        "target",
                        "aspiration"
                    ],
                    "common_phrases": [
                        "lifelong ambition",
                        "achieve an ambition",
                        "realize an ambition",
                        "main ambition"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, чего человек очень хочет достичь или сделать; заветная цель.",
                        "zh": "一个人非常想要实现或完成的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "то, к чему стремятся"
                            },
                            {
                                "target_lang_word": "мечта",
                                "target_lang_sense_clarification": "заветное желание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标",
                                "target_lang_sense_clarification": "想要达到的境地或标准"
                            },
                            {
                                "target_lang_word": "梦想",
                                "target_lang_sense_clarification": "渴望实现的愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2c53ff3-d341-3102-9492-67b3f4099cf2",
                    "sense_definition": "The act of going around to solicit votes or support for an office.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "canvassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, candidates practiced <w>ambition</w> by walking through the city to ask for votes.",
                            "target_lang_translations": {
                                "ru": "В древние времена кандидаты практиковали <w>сбор голосов</w>, обходя город с просьбами о поддержке.",
                                "zh": "在古代，候选人通过在城中走动来<w>拉票</w>。"
                            }
                        },
                        {
                            "text": "The historical text described his <w>ambition</w> for the consulship as aggressive and persistent.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте его <w>соискание</w> должности консула описывалось как агрессивное и настойчивое.",
                                "zh": "史料描述他<w>谋求</w>执政官职位的行为既激进又执着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "canvassing",
                        "solicitation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the original Latin meaning of going around to canvass for votes."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по сбору голосов или поддержки для получения должности (историческое).",
                        "zh": "（古语）为谋求职位而四处奔走拉票的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соискание",
                                "target_lang_sense_clarification": "должности или голосов"
                            },
                            {
                                "target_lang_word": "сбор голосов",
                                "target_lang_sense_clarification": "предвыборная агитация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉票",
                                "target_lang_sense_clarification": "四处奔走争取选票"
                            },
                            {
                                "target_lang_word": "谋求",
                                "target_lang_sense_clarification": "设法取得职位或支持"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79c83e5a-8c20-3f34-8ffb-32ff723b0525",
                    "sense_definition": "To strongly desire or seek after something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "desire_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young prince <w>ambitioned</w> the throne despite being far down the line of succession.",
                            "target_lang_translations": {
                                "ru": "Молодой принц <w>домогался</w> трона, несмотря на то, что был далеко в очереди престолонаследия.",
                                "zh": "尽管继承顺位很靠后，那位年轻的王子依然<w>企图</w>夺取王位。"
                            }
                        },
                        {
                            "text": "They <w>ambitioned</w> a victory that was nearly impossible to achieve.",
                            "target_lang_translations": {
                                "ru": "Они <w>жаждали</w> победы, которой было почти невозможно достичь.",
                                "zh": "他们<w>渴望</w>获得一场几乎不可能实现的胜利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "covet",
                        "crave",
                        "desire"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used as a verb in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно желать чего-либо или стремиться к чему-либо.",
                        "zh": "强烈地渴望或追求某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "сильно хотеть"
                            },
                            {
                                "target_lang_word": "домогаться",
                                "target_lang_sense_clarification": "настойчиво добиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渴望",
                                "target_lang_sense_clarification": "迫切地希望"
                            },
                            {
                                "target_lang_word": "企图",
                                "target_lang_sense_clarification": "图谋，追求"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}