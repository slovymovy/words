                                                "sense_id": "db3057f4-82e4-347a-83e9-5b342efa83cc",
                                                "text": "„Ein Googolplex ist wesentlich größer als die 48. Mersenne-Primzahl.“"
                                            },
                                            {
                                                "example_id": "ab4a1fa0-c5dd-4146-900f-b4d7a2e068f8",
                                                "sense_id": "db3057f4-82e4-347a-83e9-5b342efa83cc",
                                                "text": "„Ein Googolplex ist viel größer als ein Googol, aber immer noch endlich, wie der Namensgeber betonte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
