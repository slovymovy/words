                    "sense_definition": "Op een aangename, behaaglijke of plezierige manier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plezierig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat <w>genoeglijk</w> een kopje warme thee te drinken bij de open haard.",
                            "target_lang_translations": {
                                "de": "Er saß <w>behaglich</w> am Kamin und trank eine Tasse heißen Tee."
                            }
                        },
                        {
                            "text": "De oude vrienden zaten urenlang <w>genoeglijk</w> te praten over vroeger.",
                            "target_lang_translations": {
                                "de": "Die alten Freunde saßen stundenlang <w>gemütlich</w> zusammen und sprachen über früher."
                            }
                        }
                    ],
                    "common_phrases": [
                        "genoeglijk kletsen",
                        "genoeglijk keuvelen"
                    ],
