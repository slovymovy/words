                                    {
                                        "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "mit Stil und Chic, modisch und geschmackvoll gekleidet und frisiert"
                                        ],
                                        "tags": [
                                            "meist mit dem Fokus auf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3534f401-bdac-4a78-8596-62687bc24292",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Sie trägt einen eleganten Mantel."
                                            },
                                            {
                                                "example_id": "d00d2065-a2e8-488a-8c62-26e2b3664cf7",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Die Prinzessin galt zu ihrer Zeit als eine der elegantesten Frauen weltweit."
                                            },
                                            {
                                                "example_id": "dff83727-c10c-4986-b8a0-ad0e6020b7e5",
                                                "sense_id": "301b5436-5754-376a-970a-c50e9f50aa29",
                                                "text": "Er zeichnet sich durch einen eleganten Laufstil aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "auf gewandte, geschickte Weise zustandegekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d9b968-a345-4c09-9d9a-9b85de4448b4",
                                                "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                                "text": "Da hast du aber noch mal ganz elegant die Kurve gekriegt."
                                            },
                                            {
                                                "example_id": "8293dd07-bc4e-45f0-843d-f6e8fb4b3af7",
                                                "sense_id": "7c3fed62-68cc-3366-932e-1dad53757819",
                                                "text": "Letztlich wurde das Problem dann ganz elegant gelöst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                        "entry_id": "d879930e-725a-354f-8037-992b0a6b0b31",
                                        "glosses": [
                                            "auf eine feine und meist kultivierte Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92058cbc-a4f2-46b6-8e28-fcd71d39e861",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Das Essen findet in einem eleganten Restaurant statt."
                                            },
                                            {
                                                "example_id": "273d42fa-9e71-41e4-bfb5-bd5ee3183766",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Sie lächelte und zuckte elegant mit den Schultern."
                                            },
                                            {
                                                "example_id": "5023066f-d9c4-41e1-90bd-1a91594be0ad",
                                                "sense_id": "41a21ee9-b13e-39db-81bc-48d70760c8ed",
                                                "text": "Es ist eine Freude zuzuhören, denn er findet immer so elegante Formulierungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d63b14f-902e-49b6-8bb1-599a84eac0f1",
                        "source_entry_id": "fbac9f71-7653-3f81-8488-485f0d30708f",
                        "source_sense_id": "b05c951b-e9b1-3c41-9d65-43169e31dfe9",
                        "source_sense_description": "elegant, vornehm",
                        "target_lang_word": "vornehm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vornehm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                        "entry_id": "0dbe4da0-ee7b-3c5e-accc-ce92f25796be",
                                        "glosses": [
                                            "dem äußeren Erscheinungsbild nach höheren, besser gestellten gesellschaftlichen Kreisen zugehörig, in der Art und Weise dieser Kreise oder sich auf diese Kreise beziehend, von besonderer Feinheit und Feinfühligkeit oder sich durch andere positive Eigenschaften auszeichnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23eaf1ec-872c-4a66-be01-ad33ca7262c0",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Das Aschenputtel, das sie früher einmal war, war sie nicht mehr, nun gehörte sie zu den vornehmeren Leuten."
                                            },
                                            {
                                                "example_id": "d5a7c4ec-3043-45d6-ab7c-ce99ea2275ab",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Tu hier nicht so vornehm, wir sind unter uns."
                                            },
                                            {
                                                "example_id": "1fd974b3-1231-4c54-9e15-a27d7c2cdf72",
                                                "sense_id": "2af7af13-ca95-3843-adba-bf8f2f8a9901",
                                                "text": "Nachdem er sich etwas hatte zuschulden kommen lassen, was den Sitten eines vornehmen Hauses widersprach, musste er das Haus verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                        "entry_id": "0dbe4da0-ee7b-3c5e-accc-ce92f25796be",
                                        "glosses": [
                                            "äußerst wichtig, äußerst bedeutend, äußerst dringend (als erstes vorzunehmen)"
                                        ],
                                        "tags": [
                                            "im Superlativ auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3e53b2-b615-41ad-899f-ada5db5f1c9b",
                                                "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                                "text": "„Weil jedes Gemeinwesen gebildete und tüchtige Leute braucht, ist es vornehmste Pflicht der Städte für entsprechende Schulen zu sorgen.“ Martin Luther"
                                            },
                                            {
                                                "example_id": "3b69564f-ca36-42e6-be7e-a0edd98a5dc6",
                                                "sense_id": "806da118-a868-3543-899d-b19ea26b575f",
                                                "text": "„Als seine vornehmste Pflicht betrachtete er deshalb seinen Einsatz bei den Manövern und Gefechten.“ (Internet-Beleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
