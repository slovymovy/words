                "senses": [
                    {
                        "sense_id": "ea17beeb-3d75-3e63-ae79-49c6099e08ef",
                        "entry_id": "534e8782-f5e7-39ac-9024-512dd92adcde",
                        "glosses": [
                            "Écrire en commun avec quelqu’un d’autre (ou plusieurs autres)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f595db0-4ae6-40f6-b9ac-3a7a28c7d9dd",
                                "sense_id": "ea17beeb-3d75-3e63-ae79-49c6099e08ef",
                                "text": "Le lecteur semble ici invité à co-écrire la critique, du moins se voit-il questionné dans son rôle de spectateur de danse, activé dans la difÚculté à nommer ce qu'il voit."
                            },
                            {
                                "example_id": "2776290f-b05d-4215-a78d-a2afc2121bfa",
                                "sense_id": "ea17beeb-3d75-3e63-ae79-49c6099e08ef",
                                "text": "Ils avaient été nombreux à co-écrire l'étrange fiction qui avait transformé Bruno Dössekker en Binjamin Wilkomirski, et à l'aider à transplanter ses souvenirs helvétiques dans l'enfer nazi."
                            },
                            {
                                "example_id": "7e2c3e8f-b69d-4031-9759-2655c9cb1d16",
                                "sense_id": "ea17beeb-3d75-3e63-ae79-49c6099e08ef",
                                "text": "André Labarthe et Jacques Siclier ont commencé à écrire ensemble aux Cahiers du cinéma puis dans d'autres revues, […]. Ils ont co-écrit des articles et un livre."
                            }
                        ]
                    }
                ],
