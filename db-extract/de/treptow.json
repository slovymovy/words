                        "entry_id": "e315aa01-dcaf-37da-917a-b7cfdaf26bd8",
                        "glosses": [
                            "eine Stadt an dem Fluss Rega in Polen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da0cac0-9b4f-4d6e-8781-24e7fd658d89",
                                "sense_id": "2278942b-d1f2-32fd-a3bf-725f42e00e23",
                                "text": "Treptow an der Rega liegt in Polen und nahe der Ostsee."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b50ee337-d6de-3b1f-97d7-cd0f9f6fad1c",
                        "entry_id": "e315aa01-dcaf-37da-917a-b7cfdaf26bd8",
                        "glosses": [
                            "eine Ortschaft in der Landgemeinde Stargard Szczeciński in Polen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a4159a5-a28e-4906-91ac-697863ba72e8",
                                "sense_id": "b50ee337-d6de-3b1f-97d7-cd0f9f6fad1c",
                                "text": "Die polnische Landgemeinde Stargard in Pommern hat dreißig Ortsteile, wovon einer Trzebiatów (Treptow) ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9a549391-428c-3cd3-9410-237582e4cd5c",
                        "entry_id": "e315aa01-dcaf-37da-917a-b7cfdaf26bd8",
                        "glosses": [
                            "eine Landgemeinde im historisch Landkreis Teltow (Preußen), seit 1920 Teil Berlins"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d989a7ba-1868-4d8e-b38e-c512af6a383e",
                                "sense_id": "9a549391-428c-3cd3-9410-237582e4cd5c",
                                "text": "In Treptow gab es Wälder und Seen, die Ausflügler lockten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "dfc4867a-df74-32c4-858f-9a3f5ac07a30",
                        "entry_id": "e315aa01-dcaf-37da-917a-b7cfdaf26bd8",
                        "glosses": [
                            "ältere Bezeichnung für den Ortsteil Alt-Treptow von Berlin im Bezirk Treptow-Köpenick (Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ec8109-eb3b-4857-b8b0-9f7c50dd8266",
                                "sense_id": "dfc4867a-df74-32c4-858f-9a3f5ac07a30",
                                "text": "Der Ortsteil Treptow umschloss dabei das Gebiet zwischen Kreuzberg, Neukölln, Stralau und der Ringbahn zuzüglich des Treptower Parks. Dieser Ortsteil trägt heute die Bezeichnung Alt-Treptow."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "8e76fffb-436b-398c-8f02-5463d28468cf",
                        "entry_id": "e315aa01-dcaf-37da-917a-b7cfdaf26bd8",
                        "glosses": [
                            "ein Bezirk in Berlin (Deutschland)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5e3bc11e-e359-4837-b0ea-0f2814b398c3",
                                "sense_id": "8e76fffb-436b-398c-8f02-5463d28468cf",
                                "text": "1920 wurde der Bezirk Treptow in Berlin gebildet und 2001 mit dem Bezirk Köpenick zusammengelegt."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
