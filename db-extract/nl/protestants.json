                            {
                                "example_id": "f655d509-11dc-4235-8db1-b998e95eae79",
                                "sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                                "text": "In Nederland zijn er ooit door verschillende kerkscheuringen vele protestantse stromingen ontstaan."
                            },
                            {
                                "example_id": "22fa0a5a-82c7-48f9-80c6-488d830cfe52",
                                "sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                                "text": "Van protestants tot katholiek, pinkstergemeenschappen, synagogen en oecumenische vieringen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75b08ed8-d02c-4613-8e04-a68fa4c3b02f",
                        "source_entry_id": "66d935e8-065b-3cb2-8d2a-4065de3f1dbd",
                        "source_sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                        "source_sense_description": "gerelateerd aan het protestantisme",
                        "target_lang_word": "protestantisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protestantisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca84e89-3356-3ea3-8421-6d95cfb7f7e2",
                                        "entry_id": "c05f32e5-46e5-3f53-b184-6466c3f05139",
                                        "glosses": [
                                            "der evangelisch-lutherischen Kirche angehörend, evangelisch-lutherische Kirchengemeinschaften sind aus der Reformation des 16. Jahrhunderts hervorgegangen und vertreten Glaubenslehren, die zum Teil im Widerspruch zum Katholizismus stehen"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36309d3-e197-4437-83f5-fa90865e1f0d",
                                                "sense_id": "4ca84e89-3356-3ea3-8421-6d95cfb7f7e2",
                                                "text": "Der Neue [Papst] sei zu protestantisch, zu authentisch, ein Individualist und \"Andersmacher\". Die Kurie werde es schwerhaben mit ihm."
                                            },
                                            {
                                                "example_id": "a6be6074-7014-4bbd-a26b-93caf64a4f9b",
                                                "sense_id": "4ca84e89-3356-3ea3-8421-6d95cfb7f7e2",
                                                "text": "Das protestantische Pfarrhaus ist ein deutscher Mythos. In den letzten Jahren der DDR war es eine Keimzelle der Revolution."
                                            },
                                            {
                                                "example_id": "1b8c295b-aecd-4846-97a8-dd3abdaab017",
                                                "sense_id": "4ca84e89-3356-3ea3-8421-6d95cfb7f7e2",
                                                "text": "„Sein protestantischer Tutor bläut dem Kindkönig Verachtung für seine katholische Mutter ein – aber auch Gelehrsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ef41f9d-6d08-34d2-a014-b853a572c66b",
                                        "entry_id": "c05f32e5-46e5-3f53-b184-6466c3f05139",
                                        "glosses": [
                                            "einen Protestanten charakterisierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8debb223-6737-4c38-ae93-314adcf9cd9d",
                                                "sense_id": "4ef41f9d-6d08-34d2-a014-b853a572c66b",
                                                "text": "Dagegen hat Merkel das protestantische Prinzip in der Union etabliert: Am Anfang stehen mehrere Überzeugungen, am Ende die Mehrheit und dazwischen der Kompromiss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cdb6751-6489-443d-b9cb-d0162294fcba",
                        "source_entry_id": "66d935e8-065b-3cb2-8d2a-4065de3f1dbd",
                        "source_sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                        "source_sense_description": "gerelateerd aan het protestantisme",
                        "target_lang_word": "evangelisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evangelisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bb3ba4-a133-3b18-bcf4-03213d813bb6",
                                        "entry_id": "a1db0f6c-1245-3073-9105-682377a8bd30",
                                        "glosses": [
                                            "zur Glaubensgemeinschaft der Protestanten gehörend, zur evangelischen Kirche gehörend, der evangelischen Lehre entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3421449-c298-44c3-8030-790c9509faee",
                                                "sense_id": "e9bb3ba4-a133-3b18-bcf4-03213d813bb6",
                                                "text": "Ich habe mir ein evangelisches Gesangbuch gekauft."
                                            },
                                            {
                                                "example_id": "fafa0b78-122a-434e-8ff0-1a7a951a709d",
                                                "sense_id": "e9bb3ba4-a133-3b18-bcf4-03213d813bb6",
                                                "text": "„Das geistliche Amt war jetzt - durchaus im evangelischen Sinne - in erster Linie ein Lehramt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af507d7a-3cae-3268-ab08-c602d2719eb9",
                                        "entry_id": "a1db0f6c-1245-3073-9105-682377a8bd30",
                                        "glosses": [
                                            "auf das Evangelium bezogen, dem Evangelium gemäß, auf das Evangelium zurückgehend"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf1639d-4e35-48b6-93ac-24f0983d3559",
                                                "sense_id": "af507d7a-3cae-3268-ab08-c602d2719eb9",
                                                "text": "Das Mönchsgelübde verpflichtet katholische Ordensleute auf die evangelischen Räte Armut, Gehorsam und Keuschheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47123093-6bfe-4f1b-81b3-57f76a2759ad",
                        "source_entry_id": "66d935e8-065b-3cb2-8d2a-4065de3f1dbd",
                        "source_sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                        "source_sense_description": "gerelateerd aan het protestantisme",
                        "target_lang_word": "Protestant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protestant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c247fc72-1926-322e-935f-d89c6102eeae",
                                        "entry_id": "3e8d992b-9e84-3757-ae99-5deb08452a6a",
                                        "glosses": [
                                            "A member of any of several Christian denominations which separated from the Roman Catholic Church based on theological or political differences during the Reformation (or in some cases later)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1648355-827a-3fdc-ac9f-744724599b0a",
                                        "entry_id": "3e8d992b-9e84-3757-ae99-5deb08452a6a",
                                        "glosses": [
                                            "A member of the Church of England or Church of Ireland, as distinct from Protestant nonconformists or dissenters"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4470bb3b-2045-44c6-a223-c0d4e496b48b",
                                                "sense_id": "e1648355-827a-3fdc-ac9f-744724599b0a",
                                                "text": "To unite the whole people of Ireland; to abolish the memory of all past dissensions; and to substitute the common name of Irishman in place of the denominations of Protestant, Catholic, and Dissenter—these were my means."
                                            },
                                            {
                                                "example_id": "7c1ea611-e253-44d1-a90e-5f672de068e7",
                                                "sense_id": "e1648355-827a-3fdc-ac9f-744724599b0a",
                                                "text": "MR. SEXTON said, he had always understood that the difference between Protestants and Presbyterians was not a difference of creed, but as to episcopacy and practice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Protestant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669eda50-350f-3f2d-8cc1-43aedb5d9cec",
                                        "entry_id": "e5a3c6e6-8aad-3237-b65c-5dfce09f1bc9",
                                        "glosses": [
                                            "Of or pertaining to several denominations of Christianity that separated from the Roman Catholic Church based on theological or political differences during the Reformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35116fc7-7e49-4ee8-8267-60d6194dc2fe",
                                                "sense_id": "669eda50-350f-3f2d-8cc1-43aedb5d9cec",
                                                "text": "It is not perhaps too much to say, that a more harmonious, a more decorous, a more loyal, a more Protestant, a more Christian meeting, never took place within the walls of our ancient city."
                                            },
                                            {
                                                "example_id": "bd86768f-7530-48bb-b605-2a0367bfa00f",
                                                "sense_id": "669eda50-350f-3f2d-8cc1-43aedb5d9cec",
                                                "text": "To make this perfectly clear, we shall contrast a few of the most Protestant with a few of the most Roman Catholic counties."
                                            },
                                            {
                                                "example_id": "987d6a8d-6d04-4a01-aea8-26a8be7e0e59",
                                                "sense_id": "669eda50-350f-3f2d-8cc1-43aedb5d9cec",
                                                "text": "For reasons to do with the predominantly Lutheran rather than Calvinist heritage (and to some extent with the postwar division of Germany which hived off the more Protestant East), the participation of Protestants in the CDU has been small."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cee7aa6-adf5-4a85-9d1b-712508333ae4",
                        "source_entry_id": "66d935e8-065b-3cb2-8d2a-4065de3f1dbd",
                        "source_sense_id": "8b88bca7-8293-31f7-8ff3-bfc591750f4f",
                        "source_sense_description": "gerelateerd aan het protestantisme",
                        "target_lang_word": "protestant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protestant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                        "entry_id": "9e16b0f4-dfcb-3fd4-af38-e8c5bf21e6d3",
                                        "glosses": [
                                            "Partisan de la Réforme, comme luthérien ou calviniste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5936ed3e-5cff-4afc-acb5-dc72a6e722e6",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "Je regrettais par moments de n’être pas protestant, afin de pouvoir être philosophe sans cesser d’être chrétien. Puis je reconnaissais qu’il n’y a que les catholiques qui soient conséquents."
                                            },
                                            {
                                                "example_id": "7ac519ef-068c-4086-be1b-4373f61728ec",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "C’est les Jésuites qui ont fait assassiner Henri IV ; c’est encore eux qui ont fait révoquer l’Édit de Nantes, à la suite de quoi tous les protestants ont été obligés de quitter la France ; […]."
                                            },
                                            {
                                                "example_id": "9d430108-d10a-466f-a762-ea7cd40b9e10",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "[…] : les protestants s’organisèrent militairement partout où cela leur était possible ; ils faisaient des expéditions en pays catholiques, expulsant les prêtres, introduisant le culte réformé et promulguant des lois de proscription contre les papistes."
                                            },
                                            {
                                                "example_id": "59cd4c9a-b446-4012-bb0b-ae9e88c48ec2",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "Voici, par exemple, au bord de la route qui me conduit à Montauban, le joli bourg de Réalville, fondé, à ce qu’il paraît, par Philippe le Bel et où, par la suite, se déroulèrent de tragiques épisodes de la vaine lutte entre catholiques et protestants."
                                            },
                                            {
                                                "example_id": "ec118eb4-3d42-4192-ba60-9ad0b431b444",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "Pour le protestant, seule la loi divine est légitime, et le rapport à Dieu doit être direct, sans intermédiaire."
                                            },
                                            {
                                                "example_id": "f6cbf0d6-1b5e-4c20-82ad-5f403e77f3a3",
                                                "sense_id": "0ba6e804-17ad-30c5-ace9-f510503766a7",
                                                "text": "Quelques jours plus tard, les médias relaient la mort d’un autre jeune missionnaire, le protestant John Allen Chau, qui s’est acharné à se rendre une bible à la main sur l’île North Sentiment de l’archipel Andaman, dans l’océan Indien, dont les habitants rejettent explicitement tout contact avec le monde extérieur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protestant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3637f7-7a11-33e1-b6a3-e51d81b1e5da",
                                        "entry_id": "640d627e-af9f-32a9-88f6-8bbfcfa661d2",
                                        "glosses": [
                                            "Relatif au protestantisme, à la Réforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e16aa3-729f-475e-b316-5133b7d8fcad",
                                                "sense_id": "5a3637f7-7a11-33e1-b6a3-e51d81b1e5da",
                                                "text": "[…] ; on comprenait peu le rapprochement de deux partis aussi haineux que l’étaient à cette heure le parti protestant et le parti catholique : […]"
                                            },
                                            {
                                                "example_id": "1a68a8c8-277c-417a-a2b4-6664335fafae",
                                                "sense_id": "5a3637f7-7a11-33e1-b6a3-e51d81b1e5da",
                                                "text": "C’était un plastron en flanelle rouge, l’un de ces talismans quasi hygiéniques qui, avec les pilules et les spécialités pharmaceutiques, remplacent, chez les peuples protestants de la chrétienté, les images et les reliques miraculeuses."
                                            },
                                            {
                                                "example_id": "f113cf66-cc16-4929-b1e5-85628592db50",
                                                "sense_id": "5a3637f7-7a11-33e1-b6a3-e51d81b1e5da",
                                                "text": "Il faut ensuite établir la relation exacte, au sein même de la réforme protestante, entre le culte réformé par Bucer et le culte réformé, une seconde fois, par Marbach et Pappus."
                                            },
                                            {
                                                "example_id": "4edfa070-ba65-481d-9d53-0a2608d9a4f4",
                                                "sense_id": "5a3637f7-7a11-33e1-b6a3-e51d81b1e5da",
                                                "text": "La hauteur des plafonds y est beaucoup trop solennelle pour moi, mais le regard se focalise en bas, sans jamais de rideaux – sans doute une persistance de l’attitude protestante qui veut qu’il n’y ait rien à cacher, et tout autant l’arrogance de montrer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protestant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3122dca3-3552-3dbf-9a60-59f22e169254",
                                        "entry_id": "36f72f5e-ab49-3f56-935d-06c47aa6fb68",
                                        "glosses": [
                                            "Participe présent de protester."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8a342a9-ee8e-4834-b753-378bac9f8159",
                                                "sense_id": "3122dca3-3552-3dbf-9a60-59f22e169254",
                                                "text": "On craignait que les émigrés enhardis n’exerçassent tous des violences sur les acquéreurs de leurs biens, pour en préparer la restitution en protestant ainsi contre un injuste dépouillement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
