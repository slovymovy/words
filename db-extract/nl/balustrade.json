                "senses": [
                    {
                        "sense_id": "c3c6bf1b-c03b-367b-8791-43924c6d08c1",
                        "entry_id": "98d059b7-4f1d-302b-a17a-37b9a9d3fe1a",
                        "glosses": [
                            "een laag hekwerk dat een min of verheven standplaats omsluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bcc486e-ac94-4d1e-ae32-5e90e2cafd26",
                                "sense_id": "c3c6bf1b-c03b-367b-8791-43924c6d08c1",
                                "text": "De balustrade viel uit elkaar, wat zeer grote gevolgen zou kunnen hebben."
                            },
                            {
                                "example_id": "5c64419e-904c-483c-a837-45bed29c78c5",
                                "sense_id": "c3c6bf1b-c03b-367b-8791-43924c6d08c1",
                                "text": "Een paar verkopers hingen ongeïnteresseerd over de balustrade."
                            },
                            {
                                "example_id": "d09ff04b-8b16-4c77-9af7-27c95c4b8431",
                                "sense_id": "c3c6bf1b-c03b-367b-8791-43924c6d08c1",
                                "text": "Toen Gottfrid op zaterdag middag met zijn twee assistenten aankwam om wat extra werk te doen, zo als hij zei, had hij de versiering van de balustrade van het speelhuisje als voorwendsel gebruikt, aangebeld bij het grote huis en gezegd dat er een smaakkwestie was die hij met de ingenieur moest bespreken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2811d362-917e-437d-bfd7-6431c7e92934",
                        "source_entry_id": "98d059b7-4f1d-302b-a17a-37b9a9d3fe1a",
                        "source_sense_id": "c3c6bf1b-c03b-367b-8791-43924c6d08c1",
                        "source_sense_description": "een laag hekwerk dat een min of verheven standplaats omsluit",
                        "target_lang_word": "Balustrade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balustrade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                        "entry_id": "986c4520-27c9-339a-9b18-1feb2ec00741",
                                        "glosses": [
                                            "Brüstung oder Geländer, das aus einer niedrigen Säulenreihe besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ac71fb-011f-42b0-a49b-e6baf1f41c05",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "Die Balustraden im Schloss müssten dringend renoviert werden."
                                            },
                                            {
                                                "example_id": "dd45f752-25ef-4317-b249-57785af1caee",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "„Ich setze mich auf eine Balustrade und lasse die Beine baumeln.“"
                                            },
                                            {
                                                "example_id": "0f92f555-bdba-4ee7-9675-5140bf1b1574",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "„In der Nacht träumte ich, in dem Innenhof eines orientalischen Hauses zu stehen, und auf der Balustrade des ersten Stocks drängten sich so viele Frauen, wie draufpassten.“"
                                            },
                                            {
                                                "example_id": "4a86adb5-0d25-426f-bb21-f0763e1a91cf",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "„Oben auf der Balustrade sitzen goldverziert der schöne (kleine) Krishna und die schöne (kleine) Radha.“"
                                            },
                                            {
                                                "example_id": "397977a2-8d28-4743-8134-a7357177861e",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "„Die Luftverschmutzung hatte die prallen Pobacken der Putten auf den Balustraden geschwärzt.“"
                                            },
                                            {
                                                "example_id": "e1278723-add7-473b-ac78-cf1974b79cca",
                                                "sense_id": "c41a6a8a-24fb-3078-bd84-b9740de0e60d",
                                                "text": "„Die Schrotkugeln prasselten auf die Balustrade im ersten Stock und ließen einige Fensterscheiben bersten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb3ebc7f-4eb7-4d78-a30e-5f97ff255c53",
                        "source_entry_id": "98d059b7-4f1d-302b-a17a-37b9a9d3fe1a",
