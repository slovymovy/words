                                "example_id": "e8b3b5c5-df13-4198-8e37-9c15a894dcba",
                                "sense_id": "fc098e38-e465-328c-a4b5-82e0421bc217",
                                "text": "La pratique du finning, bien qu’interdite par de nombreux pays depuis les années 2000, serait toujours abondamment utilisée par les navires pêchant à la palangre."
                            },
                            {
                                "example_id": "381912d8-a1d2-41a4-980f-1248bbe7f2e0",
                                "sense_id": "fc098e38-e465-328c-a4b5-82e0421bc217",
                                "text": "Mais si le finning est interdit, comment est-ce alors possible q’'un tiers des ailerons arrivant à Hong Kong proviennent encore d’Europe ?"
                            },
                            {
                                "example_id": "026581f7-f636-4d1f-a21e-591d0dba2ccc",
                                "sense_id": "fc098e38-e465-328c-a4b5-82e0421bc217",
                                "text": "Si de nombreux pays interdisent le finning dans leurs eaux nationales, les eaux internationales ne sont pas réglementées, sauf quelques exceptions."
                            }
                        ]
                    }
