                "senses": [
                    {
                        "sense_id": "36832392-60e2-3a36-9cad-36d0f2df920b",
                        "entry_id": "5f2ede78-1889-3422-b291-be784702ac14",
                        "glosses": [
                            "Vaincre à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e83e2c-c3e2-4618-9314-4d232c818874",
                                "sense_id": "36832392-60e2-3a36-9cad-36d0f2df920b",
                                "text": "Vaincre et revaincre, triompher mille fois de la même difficulté est l’objet du sport et le fondement des joies qu’on en tire."
                            },
                            {
                                "example_id": "9c749803-a91d-4cc7-8348-6fb201d72fb0",
                                "sense_id": "36832392-60e2-3a36-9cad-36d0f2df920b",
                                "text": "Mais il leur faut toujours revaincre, et lorsqu'en 1128 Alep se donnera enfin à un maître fort, il suffira de quelques années pour renverser la situation au bénéfice des musulmans."
                            }
                        ]
                    }
