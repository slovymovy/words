                                "target_senses": [
                                    {
                                        "sense_id": "23baa836-510a-3650-a90a-ceda19b8078c",
                                        "entry_id": "73c06ba4-887a-3c51-850c-01ee556d5665",
                                        "glosses": [
                                            "Synonym of liftshaft."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04d5e525-f5ea-4228-a06f-3b2a48167d14",
                                                "sense_id": "23baa836-510a-3650-a90a-ceda19b8078c",
                                                "text": "You know when winter comes to visit these big cities and / the wind starts howling through the elevator shafts"
                                            },
                                            {
                                                "example_id": "a9b24585-1553-40a6-9736-6be5ec78338f",
                                                "sense_id": "23baa836-510a-3650-a90a-ceda19b8078c",
                                                "text": "Any visitor to New York over the past few years will have witnessed this curious new breed of pencil-thin tower. Poking up above the Manhattan skyline like etiolated beanpoles, they seem to defy the laws of both gravity and commercial sense. They stand like naked elevator shafts awaiting their floors, raw extrusions of capital piled up until it hits the clouds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6caaecc-71c3-4d6e-8d9d-65f8067e91d1",
                        "source_entry_id": "fe5c676f-25f4-39b5-9b6b-0614f02dc492",
                        "source_sense_id": "ce0fec82-0e43-3e69-970e-8b12694f4931",
                        "source_sense_description": "hohler, senkrechter Raum, in dem sich ein Aufzug auf und ab bewegt",
