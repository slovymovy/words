                "senses": [
                    {
                        "sense_id": "de97e280-f174-3f1c-975b-6a17cd1adca8",
                        "entry_id": "1eb581a5-da2d-337f-bc96-5880d428a037",
                        "glosses": [
                            "представляющий собой утопию; основанный на мечтах и фантазиях; несбыточный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7938cdd2-080d-4810-91ed-719556a1202e",
                                "sense_id": "de97e280-f174-3f1c-975b-6a17cd1adca8",
                                "text": "Рассудок Обломова так успел с детства сложиться, что даже в самом отвлеченном рассуждении, в самой утопической теории имел способность останавливаться на данном моменте и затем не выходить из этого status quo, несмотря ни на какие убеждения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c893b21-46e3-4e3e-beb9-df8d26ec8a28",
                        "source_entry_id": "1eb581a5-da2d-337f-bc96-5880d428a037",
                        "source_sense_id": "de97e280-f174-3f1c-975b-6a17cd1adca8",
                        "target_lang_word": "utopian",
