                        "glosses": [
                            "Disparition de la capacité de l’organisme à répondre à une substance à laquelle il réagissait auparavant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffca5296-3841-4d39-97e2-a04a7f07110e",
                                "sense_id": "cea46db1-1a05-3545-805f-c4efbd2e0fcf",
                                "text": "La tolérance périphérique est acquise par délétion clonale ou par anergie."
                            },
                            {
                                "example_id": "000f3ad2-3daf-4edf-a31a-d7e10f6af33f",
                                "sense_id": "cea46db1-1a05-3545-805f-c4efbd2e0fcf",
                                "text": "L’anergie est un état de non-réponse spécifique induit dans un lymphocyte T par une stimulation antigénique non accompagnée des signaux de costimulation délivrés par certaines molécules membranaires des cellules présentatrices d'antigènes (CD80, CD86)."
                            }
                        ]
                    },
