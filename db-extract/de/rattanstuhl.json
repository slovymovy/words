                ],
                "senses": [
                    {
                        "sense_id": "e2b7b650-adf4-3976-a586-80f19c971762",
                        "entry_id": "9166da5d-bad9-3c35-b80b-1bc2e5b2841e",
                        "glosses": [
                            "Stuhl aus Rattan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a9cefd2-b0e5-4afd-b971-8f641c7a0ef2",
                                "sense_id": "e2b7b650-adf4-3976-a586-80f19c971762",
                                "text": "„Ama entschied sich für einen der Rattanstühle.“"
                            },
                            {
                                "example_id": "1b5830e3-54bc-49fc-9a81-a1c76c2d357a",
                                "sense_id": "e2b7b650-adf4-3976-a586-80f19c971762",
                                "text": "„Wir betraten die rundum verglaste Terrasse an der Rückseite des Hauses und nahmen auf bequemen Rattanstühlen Platz.“"
                            },
                            {
                                "example_id": "bafd337d-3f41-471e-b6e3-474b4f62b9e4",
                                "sense_id": "e2b7b650-adf4-3976-a586-80f19c971762",
                                "text": "„Am nächsten Morgen saßen wir auf den Rattanstühlen um den mit Frühstück beladenen Tisch in Jeans Orangerie, seinem Glashaus voller Tomatenpflanzen, und tunkten unsere Croissants in Milchkaffee, der leicht verbrannt schmeckte.“"
                            },
                            {
                                "example_id": "5f8f084f-c9ff-4f7c-b108-7cc811d495a3",
                                "sense_id": "e2b7b650-adf4-3976-a586-80f19c971762",
                                "text": "„Er ging durch die Wohnräume, vorbei am Esstisch und den Rattanstühlen mit Stahlgestell, die so fein federten, wenn man sich daraufsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
