    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "149355bc-3929-3247-a81c-24eb9092c356",
                    "sense_definition": "Of or pertaining to the Republican Party of the United States.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "us_politics_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Republican</w> candidate spent the final days of the campaign visiting key states.",
                            "target_lang_translations": {
                                "ru": "<w>Республиканский</w> кандидат провёл последние дни кампании, посещая ключевые штаты.",
                                "zh": "这位<w>共和党</w>候选人在竞选的最后几天里走访了关键州。"
                            }
                        },
                        {
                            "text": "She has always voted for the <w>Republican</w> party in national elections.",
                            "target_lang_translations": {
                                "ru": "Она всегда голосовала за <w>Республиканскую</w> партию на национальных выборах.",
                                "zh": "她在全国大选中总是投票给<w>共和党</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Republican Party",
                        "Republican candidate",
                        "Republican senator",
                        "Republican nomination"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Республиканской партии США.",
                        "zh": "指美国共和党的，或与美国共和党有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "республика́нский",
                                "target_lang_sense_clarification": "о партии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共和党的",
                                "target_lang_sense_clarification": "形容词，指美国共和党"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "265fac59-4504-30f3-be3e-b13de758debc",
                    "sense_definition": "Advocating or supporting a republic as a form of government.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_politics_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country adopted a <w>republican</w> constitution after the revolution ended the monarchy.",
                            "target_lang_translations": {
                                "ru": "Страна приняла <w>республиканскую</w> конституцию после того, как революция покончила с монархией.",
                                "zh": "革命结束君主制后，该国通过了一部<w>共和制</w>宪法。"
                            }
                        },
                        {
                            "text": "He holds strong <w>republican</w> views and believes that hereditary power is unjust.",
                            "target_lang_translations": {
                                "ru": "Он придерживается твёрдых <w>республиканских</w> взглядов и считает, что наследственная власть несправедлива.",
                                "zh": "他持有坚定的<w>共和主义</w>观点，认为世袭权力是不公正的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anti-monarchist"
                    ],
                    "antonyms": [
                        "monarchist"
                    ],
                    "common_phrases": [
                        "republican government",
                        "republican movement",
                        "republican ideals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживающий республиканскую форму правления.",
                        "zh": "主张或支持共和制作为政府形式的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "республика́нский",
                                "target_lang_sense_clarification": "о форме правления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共和制的",
                                "target_lang_sense_clarification": "形容词，指政治体制"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8dcd4424-f405-365f-91d9-f311776e47b9",
                    "sense_definition": "A member or supporter of the Republican Party in the United States.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "us_politics_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Republicans</w> gathered at the convention to select their nominee.",
                            "target_lang_translations": {
                                "ru": "Многие <w>республиканцы</w> собрались на съезде, чтобы выбрать своего кандидата.",
                                "zh": "许多<w>共和党人</w>聚集在大会上推选他们的候选人。"
                            }
                        },
                        {
                            "text": "He is a registered <w>Republican</w> but often votes independently on local issues.",
                            "target_lang_translations": {
                                "ru": "Он зарегистрированный <w>республиканец</w>, но часто голосует независимо по местным вопросам.",
                                "zh": "他是一名注册<w>共和党人</w>，但在地方议题上经常独立投票。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "registered Republican",
                        "moderate Republican",
                        "conservative Republican"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член или сторонник Республиканской партии США.",
                        "zh": "美国共和党的成员或支持者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "республика́нец",
                                "target_lang_sense_clarification": "член партии"
                            },
                            {
                                "target_lang_word": "республика́нка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共和党人",
                                "target_lang_sense_clarification": "名词，指美国共和党成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                    "sense_definition": "Someone who favors a republic as a form of government.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_politics_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a staunch <w>republican</w>, she argued passionately for the abolition of the monarchy.",
                            "target_lang_translations": {
                                "ru": "Будучи убеждённой <w>республиканкой</w>, она страстно выступала за отмену монархии.",
                                "zh": "作为一名坚定的<w>共和主义者</w>，她热切地主张废除君主制。"
                            }
                        },
                        {
                            "text": "The meeting was attended by both monarchists and <w>republicans</w> to discuss the future of the state.",
                            "target_lang_translations": {
                                "ru": "На встрече присутствовали как монархисты, так и <w>республиканцы</w>, чтобы обсудить будущее государства.",
                                "zh": "保皇派和<w>共和主义者</w>都参加了这次会议，共同讨论国家的未来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anti-monarchist"
                    ],
                    "antonyms": [
                        "monarchist"
                    ],
                    "common_phrases": [
                        "staunch republican"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник республики как формы правления.",
                        "zh": "主张共和制作为政府形式的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "республика́нец",
                                "target_lang_sense_clarification": "сторонник республики"
                            },
                            {
                                "target_lang_word": "республика́нка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共和主义者",
                                "target_lang_sense_clarification": "名词，指政治理念支持者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dea2f00-f473-34ae-84f6-e469d194eb2d",
                    "sense_definition": "An Irish nationalist who supports a united Ireland.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "irish_politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agreement was a significant step for Irish <w>Republicans</w> seeking peace in the region.",
                            "target_lang_translations": {
                                "ru": "Это соглашение стало значительным шагом для ирландских <w>республиканцев</w>, стремящихся к миру в регионе.",
                                "zh": "该协议对于寻求地区和平的爱尔兰<w>共和派</w>来说是重要的一步。"
                            }
                        },
                        {
                            "text": "Historically, <w>Republicans</w> in Ireland have campaigned for independence from British rule.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>республиканцы</w> в Ирландии боролись за независимость от британского правления.",
                                "zh": "历史上，爱尔兰的<w>共和派</w>一直致力于争取脱离英国统治的独立。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Irish Republican"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Ireland"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ирландский националист, выступающий за единую Ирландию.",
                        "zh": "支持爱尔兰统一的爱尔兰民族主义者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "республика́нец",
                                "target_lang_sense_clarification": "ирландский националист"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱尔兰共和派",
                                "target_lang_sense_clarification": "名词，指爱尔兰政治派别"
