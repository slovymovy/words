                                        "sense_id": "f3f5f36e-3429-3e26-8f31-1c403e0cb847",
                                        "entry_id": "74bc7b3b-7a17-360f-9d0f-cfdc2188a762",
                                        "glosses": [
                                            "Having a specified rank."
                                        ],
                                        "tags": [
