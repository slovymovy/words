                    {
                        "form_id": "4336608b-9adf-4226-9ebe-16f7d135dad3",
                        "entry_id": "65e04998-4d20-3526-b3e1-d8bde71b596c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Suchtrupps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                        "entry_id": "65e04998-4d20-3526-b3e1-d8bde71b596c",
                        "glosses": [
                            "Personengruppe, deren Aufgabe die Suche nach einem vermissten Gegenstand oder Lebewesen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a785a87-8c89-4ca9-96ef-cb987e749273",
                                "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                                "text": "„Die Vorstellung, dass ich wahrscheinlich viel zu weit vom Weg abgekommen war, um von einem Suchtrupp entdeckt zu werden, brachte mich ebenfalls keine Sekunde aus der Fassung.“"
                            },
                            {
                                "example_id": "cbbbaf01-3414-426e-98e6-e78afcdb669c",
                                "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                                "text": "„Es war schon Nachmittag, und im Suchtrupp dachten einige daran, eine Rast einzulegen, als man die Entdeckung machte.“"
                            },
                            {
                                "example_id": "6e99f4d4-536a-4b68-80c2-92d1e6416d9e",
                                "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                                "text": "„Ein Mann des Suchtrupps, Farmer King, machte Anstalten, Cooper anzusprechen, doch dann wanderte sein Blick an diesem vorbei und er zeigte den anderen Männern, was er sah.“"
                            },
                            {
                                "example_id": "006ae020-12e0-4083-8a8d-e6284c8db556",
                                "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                                "text": "„Ich werde mich dem Suchtrupp anschließen.“"
                            },
                            {
                                "example_id": "f35c6d64-44c9-4495-9b63-7027d6d5981e",
                                "sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                                "text": "„Ein frühzeitiger Anruf von Dewey hätte hingegen dafür sorgen können, dass sie einen ordentlichen Suchtrupp losschickten, bevor die Sicht völlig abhandenkam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ff7e055-e7c2-4e09-b404-62bf4fc4da28",
                        "source_entry_id": "65e04998-4d20-3526-b3e1-d8bde71b596c",
                        "source_sense_id": "e37f11fc-3d99-3a74-b263-fdc7a9bc2331",
                        "source_sense_description": "Personengruppe, deren Aufgabe die Suche nach einem meist vermissten Gegenstand oder Lebewesen ist",
                        "target_lang_word": "search party",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "search party",
