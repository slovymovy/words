                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Spaans",
                                "target_lang_sense_clarification": "aanduiding van herkomst of eigendom"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55c83b49-9540-3855-b2eb-2e1d2f7435a0",
                    "sense_definition": "Созданный, изготовленный или выведенный в Испании или испанцами.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отношение к Испании",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завод закупил новое <w>испанское</w> оборудование.",
                            "target_lang_translations": {
                                "nl": "De fabriek heeft nieuwe <w>Spaanse</w> apparatuur gekocht."
                            }
                        },
                        {
                            "text": "Это <w>испанское</w> вино очень популярно в мире.",
                            "target_lang_translations": {
                                "nl": "Deze <w>Spaanse</w> wijn is erg populair in de wereld."
                            }
                        }
                    ],
                    "common_phrases": [
                        "испанское вино"
                    ],
                    "target_lang_definitions": {
