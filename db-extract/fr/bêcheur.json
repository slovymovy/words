                        "entry_id": "96526f21-d135-3ddf-ab7d-8b6cd41aa2a1",
                        "glosses": [
                            "Celui qui bêche, qui retourne la terre d’un jardin à l’aide d’une bêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8c6110-3786-43ae-8e8c-2fe3ce83984c",
                                "sense_id": "d5dcfe54-c564-30d0-b0b5-653a1e6b7115",
                                "text": "Le bêcheur suivi du planteur met en place environ 700 plants par jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fee8a39-2fd5-3252-abc7-ad6fd3667a4d",
                        "entry_id": "96526f21-d135-3ddf-ab7d-8b6cd41aa2a1",
                        "glosses": [
                            "Celui qui bêche, qui dit du mal des autres."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "43022a75-682d-3f2a-a428-697c4f8f825c",
                        "entry_id": "96526f21-d135-3ddf-ab7d-8b6cd41aa2a1",
                        "glosses": [
                            "Celui qui est prétentieux et snob."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b74eef07-04af-44cb-9123-ead2dcfbf361",
                                "sense_id": "43022a75-682d-3f2a-a428-697c4f8f825c",
                                "text": "La petite blonde bêcheuse doit adorer toute cette nature qui sue partout son jus ! C’est en plein son genre, cette hostie-là."
                            }
                        ]
                    }
