            {
                "entry_id": "d4d4e3b6-94aa-3b60-a17f-63a36b9caf06",
                "word": "clave",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "57ac52a3-a6be-3ed2-9925-e1215a4641bd",
                        "entry_id": "d4d4e3b6-94aa-3b60-a17f-63a36b9caf06",
                        "glosses": [
                            "simple past and past participle of cleave"
                        ],
                        "tags": [
                            "archaic",
                            "form-of",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "79e7f18b-3a02-4d29-83c5-82cf95752867",
                                "sense_id": "57ac52a3-a6be-3ed2-9925-e1215a4641bd",
                                "text": "And Abraham rose up early in the morning, and saddled his ass, and took two of his young men with him, and Isaac his son, and clave the wood for the burnt offering, and rose up, and went unto the place of which God had told him."
                            },
                            {
                                "example_id": "a096562e-dc27-478c-bcfe-a2c25d81c2e4",
                                "sense_id": "57ac52a3-a6be-3ed2-9925-e1215a4641bd",
                                "text": "And they lifted up their voice, and wept again: and Orpah kissed her mother in law; but Ruth clave unto her."
                            },
                            {
                                "example_id": "41e27220-14d9-4173-b6f9-dd4fa7f7800f",
                                "sense_id": "57ac52a3-a6be-3ed2-9925-e1215a4641bd",
                                "text": "Sir Launcelot put his shield afore him, and put the stroke away of the one giant, and with his sword he clave his head asunder."
                            },
                            {
                                "example_id": "a3e4eb0d-c07b-41df-bbbf-f9ac684a60ee",
                                "sense_id": "57ac52a3-a6be-3ed2-9925-e1215a4641bd",
                                "text": "Suddenly a peal of thunder, resonant even above the din of the swinish revelry, clave the very roof and laid a hush of feat upon the boisterous company."
                            }
                        ]
                    }
                ],
