                    {
                        "sense_id": "ca43fe3b-7fe8-3195-aa61-19648a0d3907",
                        "entry_id": "51faa887-d2d6-3421-b310-624ac1fa64c0",
                        "glosses": [
                            "D’une manière topographique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a629e7db-38c2-41d2-a3d1-4d308b048601",
                                "sense_id": "ca43fe3b-7fe8-3195-aa61-19648a0d3907",
                                "text": "Topographiquement parlant, nous avons peu d'observations à faire sur cette chaussée à peu près rectilinéaire de six grandes lieues qui nous reste à parcourir de Thonon à Genève."
                            },
                            {
                                "example_id": "d47600d8-09c9-4e28-ba3d-0aded0f4173b",
                                "sense_id": "ca43fe3b-7fe8-3195-aa61-19648a0d3907",
                                "text": "Les espèces plus haut citées se retrouvent encore sur des aires réduites qui, sans être rocheuses, présentent une très faible couverture de terre végétale formant autant de petites unités topographiquement et floristiquement bien définies."
                            }
                        ]
                    }
