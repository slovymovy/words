                "senses": [
                    {
                        "sense_id": "6863b4f1-6f84-3f3d-bb5b-e5a83939465b",
                        "entry_id": "a6ce8f35-2165-38dc-a453-6eaa514ab20f",
                        "glosses": [
                            "Flotter de façon nonchalante et sans énergie à la surface de l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3388ad1-3e3c-42d1-9e2f-da357407ff01",
                                "sense_id": "6863b4f1-6f84-3f3d-bb5b-e5a83939465b",
                                "text": "Le témoin interrogé par les policiers a remarqué un corps qui flottoyait dans la rivière. Il s'agissait du cadavre d'une personne portée disparue depuis six jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "29622e1a-c753-3a74-b3a6-4f3787627a9f",
                        "entry_id": "a6ce8f35-2165-38dc-a453-6eaa514ab20f",
                        "glosses": [
                            "Vivre avec nonchalance, se la couler douce, réagir de façon légère face à une situation décourageante."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f83f63b2-4978-4f2e-a6c6-9e2204605bd1",
                                "sense_id": "29622e1a-c753-3a74-b3a6-4f3787627a9f",
                                "text": "- Ne te laisse pas accabler par ces évènements Elisabeth... Dans la vie, il faut se laisser flottoyer un peu, ne pas prendre les choses trop à coeur... Rappelle-toi les mots de Jack Kerouac : \"Et c'est ainsi, dit Dean, que je déambule dans l'existence, je la laisse me promener.\""
                            }
                        ]
                    }
                ],
