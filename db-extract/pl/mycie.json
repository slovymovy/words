                                "target_senses": [
                                    {
                                        "sense_id": "bf2863b1-3fab-39bf-aeb0-e17c9db3e7e0",
                                        "entry_id": "e1b38f5f-7e18-3780-a3ea-642536df52e1",
                                        "glosses": [
                                            "das Reinigen von etwas in oder auch mit einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2741f418-d0ed-41ba-b875-7251e0b5b391",
                                                "sense_id": "bf2863b1-3fab-39bf-aeb0-e17c9db3e7e0",
                                                "text": "„Durch das gebündelte Ausschwemmen beim Waschen kann leicht der Eindruck übermäßigen Haarausfalls entstehen.“"
                                            },
                                            {
                                                "example_id": "e5992556-eab1-4730-b015-7b5f64de6ea7",
                                                "sense_id": "bf2863b1-3fab-39bf-aeb0-e17c9db3e7e0",
                                                "text": "„Für das Waschen von Autos auf öffentlichen Straßen gilt ähnliches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54abd00a-30c4-484b-a4e6-19826533a831",
                        "source_entry_id": "4ea756f3-fd46-3f96-9b34-beeda9bc2283",
                        "source_sense_id": "236332ab-5e70-350c-8b34-dbc3ab68aaf0",
                        "target_lang_word": "мытьё",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мытьё",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db85f53d-4145-393b-8c5d-51378294efe1",
                                        "entry_id": "f2abe356-b32a-3655-a43d-e31b2ea52c29",
                                        "glosses": [
                                            "действие по значению гл. мыть; мыться, очищение от грязи, пыли и т. п. с помощью воды или другой жидкости, а также результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb56873f-17d3-439e-a44f-265da17cace7",
                                                "sense_id": "db85f53d-4145-393b-8c5d-51378294efe1",
                                                "text": "Все другие средства для мытья головы не могут выдержать сравнения с хорошим мылом, так как они не в состоянии совершенно очистить голову от грязи и сальных выделений кожи."
                                            },
                                            {
                                                "example_id": "f0ce5f30-64a4-4c93-a69d-a7bb1ceb376a",
                                                "sense_id": "db85f53d-4145-393b-8c5d-51378294efe1",
                                                "text": "Обернувшись, я обнаружила уборщицу, занятую мытьём окна."
                                            },
                                            {
                                                "example_id": "d89a6532-aeb5-4f07-b879-e5376a7a941f",
                                                "sense_id": "db85f53d-4145-393b-8c5d-51378294efe1",
                                                "text": "Влажная губка и жидкость для мытья посуды отлично отмоют внутренние поверхности микроволновки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa62b6-0c39-3f64-8497-cf63c62b0956",
                                        "entry_id": "f2abe356-b32a-3655-a43d-e31b2ea52c29",
                                        "glosses": [
                                            "разг. то же, что стирка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7713c9ed-62b8-4954-919c-18b07961a224",
                                                "sense_id": "dafa62b6-0c39-3f64-8497-cf63c62b0956",
                                                "text": "Целый день принуждены мы были остаться в Глухове за мытьём белья."
                                            },
                                            {
                                                "example_id": "acd67ef4-4f46-415d-9dc1-603979c2c60b",
                                                "sense_id": "dafa62b6-0c39-3f64-8497-cf63c62b0956",
                                                "text": "Баба обещал доставить нам большое удобство: мытьё белья в голландской фактории."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
