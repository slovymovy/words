                "translations": [
                    {
                        "translation_id": "d3edccc1-7147-41e6-988e-dd9e632a8dfc",
                        "source_entry_id": "19afd838-c998-38ae-b0e0-fdd7877e20b7",
                        "source_sense_id": "b1f6b48c-57da-3886-a81f-aa560e872bde",
                        "target_lang_word": "secluded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secluded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41078995-430b-367e-8c33-9219431112e7",
                                        "entry_id": "75615e88-48b5-33a1-af65-4887d572c5b8",
                                        "glosses": [
                                            "Hidden, isolated, remote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b382323-7aed-4282-ac63-65abc21c6a47",
                                                "sense_id": "41078995-430b-367e-8c33-9219431112e7",
                                                "text": "Hidden in the mountains is a small secluded village that not many people know of."
                                            },
                                            {
                                                "example_id": "98bd27d9-6014-4b86-8979-20a9de21e358",
                                                "sense_id": "41078995-430b-367e-8c33-9219431112e7",
                                                "text": "No one, however, thought of the haughty and secluded young gentleman who […] when he rode on his black hunter into Dublin, avoided the village, and took the high-road by Inchicore."
                                            },
                                            {
                                                "example_id": "37ec8d39-7463-49f9-a47e-7887a094e473",
                                                "sense_id": "41078995-430b-367e-8c33-9219431112e7",
                                                "text": "In the swamp in secluded recesses, / A shy and hidden bird is warbling a song."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secluded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f7d3c8-d575-32f0-93a1-0737af205e10",
                                        "entry_id": "c3091ed0-19c7-35f2-913a-cb3b4f13b62a",
                                        "glosses": [
                                            "simple past and past participle of seclude"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cba12f69-0b9a-4d0f-978d-aa000bca879c",
                        "source_entry_id": "19afd838-c998-38ae-b0e0-fdd7877e20b7",
                        "source_sense_id": "b1f6b48c-57da-3886-a81f-aa560e872bde",
                        "target_lang_word": "out-of-the-way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out-of-the-way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                        "entry_id": "1c5b7954-f78f-3c77-8486-1ca302b683e8",
                                        "glosses": [
                                            "Remote or secluded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cc9186-ed96-4e4a-b9f2-7371d4309cd1",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "I know this out-of-the-way hotel where we could stay."
                                            },
                                            {
                                                "example_id": "98375b31-6209-4f3e-9446-e5d3a2371cc4",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "It was from no choice of my own that I was brought up in an out-of-the-way pallazzo, with nothing to do but to fall in love."
                                            },
                                            {
                                                "example_id": "d2f4724b-210e-455a-9cc9-ce7817887e3c",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "“Even Darjiling is a little out-of-the-way hole.”"
                                            },
                                            {
                                                "example_id": "191c39c2-a589-40d8-b4f5-9457b819b3d1",
                                                "sense_id": "6ff5a5f6-6664-3749-b147-ba69eb230c9d",
                                                "text": "Passenger numbers had been rising sharply. But the replacement of the services by buses, which take far longer because of the number of stations in out-of-the-way villages on the route, will ensure they plummet again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b28e6bbf-fcf5-4a54-bef4-e36b2e819116",
                        "source_entry_id": "19afd838-c998-38ae-b0e0-fdd7877e20b7",
                        "source_sense_id": "b1f6b48c-57da-3886-a81f-aa560e872bde",
                        "target_lang_word": "discret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discret",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d98a9dfb-4fb8-3cd7-b645-d982fd05e605",
                                        "entry_id": "38f26961-f08c-37f1-a9a6-dc6e0cec0e8b",
                                        "glosses": [
                                            "Qui ne se fait pas remarquer, par exemple qui est réservé, retenu dans ses paroles et dans ses actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82249364-c04a-441d-9395-74c87150557b",
                                                "sense_id": "d98a9dfb-4fb8-3cd7-b645-d982fd05e605",
                                                "text": "Il est extrêmement discret."
                                            },
                                            {
                                                "example_id": "2a05e216-a665-4e68-a32b-096ea2b64008",
                                                "sense_id": "d98a9dfb-4fb8-3cd7-b645-d982fd05e605",
                                                "text": "À Trunvel, Saint-Vio ou encore Nérizellec, les étangs peu profonds permettent un développement biologique spectaculaire où les roselières abritent des animaux aussi rares que discrets."
                                            },
                                            {
                                                "example_id": "f69ef366-7719-44ba-b07c-23c9fbb5a87e",
                                                "sense_id": "d98a9dfb-4fb8-3cd7-b645-d982fd05e605",
                                                "text": "Le mercato des Mauves aura été plutôt discret mais la direction compte bien sur les arrivées last minute de Leander Dendoncker dans l’entrejeu et surtout de Samuel Edozie pour rebooster les troupes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21958053-cdf6-3280-8443-84ffc0b65a9e",
                                        "entry_id": "38f26961-f08c-37f1-a9a6-dc6e0cec0e8b",
                                        "glosses": [
                                            "Qui sait garder un secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2b5e66-e0c3-4d8b-8ef8-8c2984f4fa51",
                                                "sense_id": "21958053-cdf6-3280-8443-84ffc0b65a9e",
                                                "text": "Un homme discret."
                                            },
                                            {
                                                "example_id": "efcfbfec-54d1-4550-8973-f75036fb74ca",
                                                "sense_id": "21958053-cdf6-3280-8443-84ffc0b65a9e",
                                                "text": "Une femme discrète."
                                            },
                                            {
                                                "example_id": "496bad0b-cd1b-46dc-8213-6eea9a2bdfcc",
                                                "sense_id": "21958053-cdf6-3280-8443-84ffc0b65a9e",
                                                "text": "— Ma chère enfant, pour moi il n’y a pas de gens discrets : il y a les gens qui parlent parce qu’ils savent, et il y a les gens qui se taisent parce qu’ils ne savent pas ; seulement, comme c’est assez humiliant de ne pas savoir, on s’abrite derrière la discrétion et l’on se fait une vertu de sa maladresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c5b92e-9f2b-3e3c-a97d-fe37bd218a84",
                                        "entry_id": "38f26961-f08c-37f1-a9a6-dc6e0cec0e8b",
                                        "glosses": [
                                            "Distinct, séparé, discontinu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036848bd-0f20-416f-9032-32c1a349bf2f",
                                                "sense_id": "f7c5b92e-9f2b-3e3c-a97d-fe37bd218a84",
                                                "text": "Quantité discrète, par opposition à Quantité continue : Assemblage de plusieurs choses distinctes les unes des autres, comme les nombres, les grains d’un tas de blé."
                                            },
                                            {
                                                "example_id": "7197beec-56d2-476b-9fb4-dc85ce658fde",
                                                "sense_id": "f7c5b92e-9f2b-3e3c-a97d-fe37bd218a84",
                                                "text": "Les nombres entiers forment une suite de valeurs discrètes, par opposition aux nombres réels qui, eux, forment un ensemble continu."
                                            },
                                            {
                                                "example_id": "9c9d8be5-46a5-4987-b336-e02bb77745dc",
                                                "sense_id": "f7c5b92e-9f2b-3e3c-a97d-fe37bd218a84",
                                                "text": "L’arithmétique a pour objet la quantité discrète."
                                            },
                                            {
                                                "example_id": "e18c7cca-c630-4097-ba73-56216580c79c",
                                                "sense_id": "f7c5b92e-9f2b-3e3c-a97d-fe37bd218a84",
                                                "text": "Comment expliquer qu’une dynamique sous-jacente décrite par les équations continues de Turing donne un comportement mésoscopique discret, écaille par écaille, décrit par les automates cellulaires de von Neumann ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b634a57-d5d5-35c7-9a58-f4b8712e3839",
                                        "entry_id": "38f26961-f08c-37f1-a9a6-dc6e0cec0e8b",
                                        "glosses": [
                                            "Se dit d’un espace topologique dont tous les points sont isolés. Qualifie également la topologie d’un tel espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e6db51-9760-497f-9060-77fae9a18ec5",
                                                "sense_id": "9b634a57-d5d5-35c7-9a58-f4b8712e3839",
                                                "text": "Un espace discret ; une topologie discrète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e78d5f-d6e6-3603-a97c-0a65d72d4d03",
                                        "entry_id": "38f26961-f08c-37f1-a9a6-dc6e0cec0e8b",
                                        "glosses": [
                                            "Qualifie un type de donnée pour lequel l’ensemble des valeurs possibles est discret (au sens mathématique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ce1368-8c64-4e08-a494-d7e90828587e",
                                                "sense_id": "81e78d5f-d6e6-3603-a97c-0a65d72d4d03",
                                                "text": "Variable discrète ; Sa valeur évolue régulièrement dans une plage de valeurs, de 1 à 15 par exemple. Permet de réaliser une action un certain nombre de fois."
                                            },
                                            {
                                                "example_id": "70c1b47c-a424-4234-be55-58c550ffdbfb",
                                                "sense_id": "81e78d5f-d6e6-3603-a97c-0a65d72d4d03",
                                                "text": "Un « mot » à 8 (resp. n) bits ne peut stocker que 2⁸ = 256 valeurs (resp. 2ⁿ) différentes, de « 0 » à « 255 », ou de « - 128 » à « + 128 ». Les « valeurs » traitées par les ordinateurs sont donc essentiellement discrètes, mais, juxtaposées en grand nombre, elles peuvent donner l'illusion du continu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
