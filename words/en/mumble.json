{
    "word_family": [
        "mumbler",
        "mumbling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aae2e8a3-17a6-3d28-ad19-f7f50eb81e26",
                    "sense_definition": "To speak in a low, unclear way that is difficult to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please try not to <w>mumble</w> so I can hear you better.",
                            "target_lang_translations": {
                                "zh": "请尽量不要<w>嘟囔</w>，这样我才能听得更清楚。",
                                "cs": "Prosím, zkus <w>nemumlat</w>, abych tě lépe slyšel."
                            }
                        },
                        {
                            "text": "He <w>mumbled</w> an apology and walked away quickly.",
                            "target_lang_translations": {
                                "zh": "他<w>咕哝</w>着道了歉，然后快步走开了。",
                                "cs": "Rychle <w>zamumlal</w> omluvu a odešel."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutter",
                        "murmur"
                    ],
                    "antonyms": [
                        "enunciate",
                        "articulate"
                    ],
                    "common_phrases": [
                        "mumble under breath"
                    ],
                    "target_lang_definitions": {
                        "zh": "说话声音低沉、含糊不清，让人难以听懂。",
                        "cs": "Mluvit potichu a nesrozumitelně, takže je obtížné rozumět."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘟囔",
                                "target_lang_sense_clarification": "指说话声音小且含糊，常带有不满或不情愿的情绪。"
                            },
                            {
                                "target_lang_word": "咕哝",
                                "target_lang_sense_clarification": "指低声说话，声音模糊，常用于自言自语或抱怨。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "mumlat",
                                "target_lang_sense_clarification": "obecný výraz pro nesrozumitelnou řeč s nízkou hlasitostí"
                            },
                            {
                                "target_lang_word": "brumlat",
                                "target_lang_sense_clarification": "často spojeno s nespokojeností nebo mluvením pod vousy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ad40112-eca0-3f60-81b0-2558ade02ec3",
                    "sense_definition": "To chew food slowly and gently with the lips closed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat in the corner to <w>mumble</w> his crust of bread.",
                            "target_lang_translations": {
                                "zh": "老人坐在角落里，缓慢地<w>咀嚼</w>着他的面包皮。",
                                "cs": "Stařec seděl v koutě a pomalu <w>přežvykoval</w> svou kůrku chleba."
                            }
                        },
                        {
                            "text": "She <w>mumbled</w> on a piece of hard candy for a long time.",
                            "target_lang_translations": {
                                "zh": "她含着一块硬糖<w>咀嚼</w>了很久。",
                                "cs": "Dlouho <w>přežvykovala</w> kousek tvrdého bonbonu."
                            }
                        }
                    ],
                    "synonyms": [
                        "chew",
                        "munch"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指用嘴唇闭合的方式缓慢而轻柔地咀嚼食物。",
                        "cs": "Pomalé a jemné žvýkání jídla se zavřenými ústy."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咀嚼",
                                "target_lang_sense_clarification": "指牙齿和嘴唇配合缓慢磨碎食物的动作。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přežvykovat",
                                "target_lang_sense_clarification": "pomalé rozmělňování potravy v ústech"
                            },
                            {
                                "target_lang_word": "žvýkat",
                                "target_lang_sense_clarification": "obecný proces zpracování potravy v ústech"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2336bc0-1d2c-32ae-beaf-ba6cd13d5240",
                    "sense_definition": "A quiet, unclear sound made by someone speaking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All I could hear was a <w>mumble</w> from the next room.",
                            "target_lang_translations": {
                                "zh": "我只能听到隔壁房间传来一阵<w>嘟囔声</w>。",
                                "cs": "Slyšel jsem jen <w>mumlání</w> z vedlejší místnosti."
                            }
                        },
                        {
                            "text": "He spoke in a barely comprehensible <w>mumble</w>.",
                            "target_lang_translations": {
                                "zh": "他说话的声音含糊不清，几乎听不出什么<w>咕哝声</w>。",
                                "cs": "Mluvil jen stěží srozumitelným <w>mumláním</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutter",
                        "murmur"
                    ],
                    "target_lang_definitions": {
                        "zh": "指说话时发出的低沉、含糊不清的声音。",
                        "cs": "Tichý, nesrozumitelný zvuk vydávaný při mluvení."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘟囔声",
                                "target_lang_sense_clarification": "指听起来模糊不清的低语。"
                            },
                            {
                                "target_lang_word": "咕哝声",
                                "target_lang_sense_clarification": "指低沉且难以辨认的说话声。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "mumlání",
                                "target_lang_sense_clarification": "zvukový projev nesrozumitelné řeči"
                            },
                            {
                                "target_lang_word": "brumlání",
                                "target_lang_sense_clarification": "tichý, hlubší zvukový projev"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}