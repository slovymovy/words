                        ],
                        "form": "das Luftloch"
                    },
                    {
                        "form_id": "2441fc49-e533-4e3d-9960-9ab0528661ac",
                        "entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Luftlöcher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                        "entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
                        "glosses": [
                            "Öffnung zum Aus- und Eintreten der Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7199a923-d02d-4db6-8b4b-69216bbce1ce",
                                "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                                "text": "Gritta stieg auf den Felsblock, der vor dem Luftloch der Höhle lag."
                            },
                            {
                                "example_id": "f5261a0f-6228-4d7e-aa56-9fdc6a8f7edf",
                                "sense_id": "86e104f7-222f-3da1-9190-87907b42ed4e",
                                "text": "„Man sah auch, wie er durch seine Luftlöcher mächtige Fontänen ausstieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                        "entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
                        "glosses": [
                            "Fallwind, der Flugzeuge absacken lässt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "99b6d978-9e21-4d91-96fb-3aa58507b1c4",
                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                "text": "„Fliegen mit Kleinkind. Ich würde mich nicht als leichtfertigen Menschen betrachten, ich gehe nur nicht gleich vom Schlimmsten aus. Beinahe-Abstürze, Notlandungen, gigantische Luftlöcher? Hätte ich in der Luft jemals um mein Leben bangen müssen, würde ich überhaupt nicht mehr fliegen, ohne Kind nicht und mit Kind erst recht nicht.“"
                            },
                            {
                                "example_id": "e492afe8-89ec-44f2-8b6b-f696df53c53b",
                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                "text": "„Doch wieder gab es während der Reise ein großes Luftloch und ein paar kleinere Turbulenzen, die den Passagieren zuweilen schweißnasse Hände bereiteten.“"
                            },
                            {
                                "example_id": "5eb85718-e131-4683-a699-41b814ab10a8",
                                "sense_id": "dcf2abdb-0ad9-3ebb-80a5-4df53d34ef90",
                                "text": "„Sie durchflogen Luftlöcher, und in der Maschine wurde es ganz still.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e6b1bb7-bc07-4723-beb3-b5d4ffddaea0",
                        "source_entry_id": "d3fc9fa9-9f78-3af5-a4f9-04343111648a",
