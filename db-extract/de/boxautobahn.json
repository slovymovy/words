                "senses": [
                    {
                        "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                        "entry_id": "64ab7c60-618a-3a12-b77c-6a34b8295851",
                        "glosses": [
                            "Fahrbahn für Boxautos (Autoskooter)"
                        ],
                        "tags": [
                            "südwestdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "04eeff7c-b27f-4d35-b5d5-5d7617eabdc1",
                                "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                                "text": "„Am Samstag findet ab 19.30 Uhr auf der Boxautobahn die Inthronisation des Johannes Kirw statt, ab 20 Uhr gibt es für eine halbe Stunde Freifahrten für Kinder und Jugendliche auf der Boxautobahn und den Fahrgeschäften.“"
                            },
                            {
                                "example_id": "637ab95b-8424-4be4-822a-41bb5fab574c",
                                "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                                "text": "„Hinter dem Rathaus ein kleiner Rummel mit Karussells für die Großen und für die Kleinen und der Boxautobahn.“"
                            },
                            {
                                "example_id": "f8a2cd7d-1149-4300-a359-6e68893f62be",
                                "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                                "text": "„Locker die Linke am Lenkrad, gleitet er geschmeidig über die Boxautobahn – und rumms.“"
                            },
                            {
                                "example_id": "5b78aafb-ebde-4987-a275-8ad363bf0338",
                                "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                                "text": "„Am Sonntagmorgen wurde die Boxautobahn zum ungewöhnlichen, aber stimmungsvollen Ort des Kerwe-Gottesdienstes.“"
                            },
                            {
                                "example_id": "0f9356d0-657e-48cc-b844-196acceb2e39",
                                "sense_id": "6272ef9f-9e07-3c84-8d65-11ad79d59123",
                                "text": "„Da hat doch tatsächlich einer die A8 mit einer Boxautobahn verwechselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
