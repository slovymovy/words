                        "sense_id": "60cc85cb-85be-303f-9096-f3e56f3bc5dd",
                        "entry_id": "b4e04696-60ac-3dd7-a6b2-cc3821683e4c",
                        "glosses": [
                            "Diminution d’étendue et de durée."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "24a739df-a74d-460a-8e30-bbd0ed02a251",
                                "sense_id": "60cc85cb-85be-303f-9096-f3e56f3bc5dd",
                                "text": "Cette allée de traverse sert beaucoup à l’accourcissement du chemin."
                            },
                            {
                                "example_id": "d4c42118-011b-4490-9c13-5e34a5f9ee01",
                                "sense_id": "60cc85cb-85be-303f-9096-f3e56f3bc5dd",
                                "text": "L’accourcissement des jours est déjà très sensible dans le mois de septembre."
                            },
                            {
                                "example_id": "a61bd8fa-4cc5-443d-a09e-e4c2843732a6",
                                "sense_id": "60cc85cb-85be-303f-9096-f3e56f3bc5dd",
                                "text": "Cependant, le soir surtout, on commençait à avoir conscience de l’accourcissement des jours."
                            }
                        ]
                    }
                ],
