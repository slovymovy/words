                                "target_senses": [
                                    {
                                        "sense_id": "39eda875-8ea7-3a0a-8313-7b16a37ce16e",
                                        "entry_id": "aa3819d4-ecd0-37bf-aa13-7b5a6848d0f4",
                                        "glosses": [
                                            "A country in Western Europe that has borders with the Netherlands, Germany, Luxembourg and France. Official name: Kingdom of Belgium. Capital and largest city: Brussels."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6fbda5a-1126-4a90-9cd1-776139b10b55",
                                                "sense_id": "39eda875-8ea7-3a0a-8313-7b16a37ce16e",
                                                "text": "The higher levels of chlorate were discovered during routine testing at the company's production facility in Ghent, Belgium, according to an unnamed company spokesperson quoted by the AFP news agency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb744c60-0891-4f12-be10-6e5c091dc84c",
                        "source_entry_id": "0e3b44e9-426c-339f-ac15-f4284c32ea8c",
                        "source_sense_id": "2a348b8f-3eae-3fde-8127-731fbe01b2f0",
