{
    "word_family": [
        "cornu",
        "cornet",
        "cornucopia"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cc53013-6465-321c-aabd-20ceea2077f0",
                    "sense_definition": "A mythical horse with a single, straight, spiraled horn on its forehead.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mythical_creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many fairy tales, a <w>unicorn</w> is a symbol of purity and magic.",
                            "target_lang_translations": {
                                "zh": "在许多童话故事中，<w>独角兽</w>是纯洁和魔法的象征。"
                            }
                        },
                        {
                            "text": "The children drew a beautiful <w>unicorn</w> with a long, spiraled horn.",
                            "target_lang_translations": {
                                "zh": "孩子们画了一只长着长长螺旋角的漂亮<w>独角兽</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种神话中的马，额头上长有一只笔直的螺旋状角。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "独角兽",
                                "target_lang_sense_clarification": "指神话中额头长角的马。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e03ac3bf-6a90-3f0f-887f-b007e0ba16c7",
                    "sense_definition": "Someone or something that is extremely rare and difficult to find.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Finding a job that pays well and offers total freedom is like finding a <w>unicorn</w>.",
                            "target_lang_translations": {
                                "zh": "找到一份既高薪又完全自由的工作简直就像寻找<w>独角兽</w>一样难。"
                            }
                        },
                        {
                            "text": "True experts in this niche field are a <w>unicorn</w> in the current job market.",
                            "target_lang_translations": {
                                "zh": "在这个细分领域，真正的专家在当前的就业市场上简直是<w>凤毛麟角</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "one in a million",
                        "rarity",
                        "rare bird"
                    ],
                    "target_lang_definitions": {
                        "zh": "指极其罕见、难以寻觅的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "稀有之物",
                                "target_lang_sense_clarification": "比喻极其罕见的人或事物。"
                            },
                            {
                                "target_lang_word": "凤毛麟角",
                                "target_lang_sense_clarification": "成语，形容珍贵而稀少的人或事物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cd7f521-7065-3a95-8a33-7d71a31a8c4f",
                    "sense_definition": "A private startup company with a valuation exceeding one billion U.S. dollars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many investors hope to find the next tech <w>unicorn</w> before it goes public.",
                            "target_lang_translations": {
                                "zh": "许多投资者都希望在下一家科技公司上市前将其发掘为<w>独角兽企业</w>。"
                            }
                        },
                        {
                            "text": "The company became a <w>unicorn</w> after its latest round of venture capital funding.",
                            "target_lang_translations": {
                                "zh": "在最新一轮风险投资后，这家公司成功<w>成为独角兽</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "估值超过十亿美元的未上市初创公司。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "独角兽企业",
                                "target_lang_sense_clarification": "商业术语，指估值超过十亿美元的初创公司。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e676e69-dfa4-3c9b-9dcd-2bccdd8dbf62",
                    "sense_definition": "Extremely rare and hard to find.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He possesses a <w>unicorn</w> talent that is almost impossible to replicate.",
                            "target_lang_translations": {
                                "zh": "他拥有一种几乎无法复制的<w>罕见的</w>天赋。"
                            }
                        },
                        {
                            "text": "The antique book is a <w>unicorn</w> item for serious collectors.",
                            "target_lang_translations": {
                                "zh": "对于严肃的收藏家来说，这本古籍是<w>罕见的</w>珍品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rare bird"
                    ],
                    "target_lang_definitions": {
                        "zh": "极其罕见的，难以找到的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "罕见的",
                                "target_lang_sense_clarification": "形容事物非常少见。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9df7e4f2-92b8-3760-807a-04756d764a7a",
                    "sense_definition": "To reach a valuation of over one billion dollars while privately held.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "business_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software startup finally <w>unicorned</w> after a massive investment from abroad.",
                            "target_lang_translations": {
                                "zh": "在获得一笔巨额海外投资后，这家软件初创公司终于<w>成为独角兽</w>。"
                            }
                        },
                        {
                            "text": "Few companies have <w>unicorned</w> in such a short period of time.",
                            "target_lang_translations": {
                                "zh": "很少有公司能在如此短的时间内<w>成为独角兽</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指公司在未上市阶段估值达到十亿美元以上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "成为独角兽",
                                "target_lang_sense_clarification": "指公司估值达到十亿美元门槛。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}