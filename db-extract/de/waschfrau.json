                "senses": [
                    {
                        "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                        "entry_id": "a78e3ade-fbf8-3f29-a56b-9d854c524413",
                        "glosses": [
                            "Frau, die gewerbsmäßig wäscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d775e84a-a682-4fea-9195-d3107e6f1364",
                                "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                                "text": "„Mit dem Französischparlieren kam eine schlesische Waschfrau im unruhigen Jahre 1807 viel wendiger zu Rande.“"
                            },
                            {
                                "example_id": "a49f57e7-6d86-4d84-bd01-9c4f61dbc41d",
                                "sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                                "text": "„Sie sah aus wie eine ärgerliche, schöne Waschfrau und gleichzeitig wie etwas, das vom Mond hergeflogen war und sich nicht zurechtfinden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a584d5b8-e99e-4c4d-a7a8-fe1ed1918be5",
                        "source_entry_id": "a78e3ade-fbf8-3f29-a56b-9d854c524413",
                        "source_sense_id": "e2119b2b-772d-3322-b2d5-4b6a7a01f475",
                        "source_sense_description": "Frau, die gewerbsmäßig wäscht",
                        "target_lang_word": "blanchisseuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blanchisseuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12ab9600-a71e-3e7a-b3c0-3b58b1598ac1",
                                        "entry_id": "5911f7c7-2697-3608-a41f-6392c0559f30",
                                        "glosses": [
                                            "Femme qui blanchit du linge, des toiles, de la cire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e1b6fc-e384-4475-824a-7a5ef9a0d08a",
                                                "sense_id": "12ab9600-a71e-3e7a-b3c0-3b58b1598ac1",
                                                "text": "Il y avait grand vacarme de blanchisseuses ; elles criaient, parlaient, chantaient du matin au soir le long du bord."
                                            },
                                            {
                                                "example_id": "231186de-e06d-4586-866c-fd21c2f91c34",
                                                "sense_id": "12ab9600-a71e-3e7a-b3c0-3b58b1598ac1",
                                                "text": "Il s’agit de lâcher cette petite fille chez une blanchisseuse, la sœur à Godet, et qu’elle s’y impatronise…"
                                            },
                                            {
                                                "example_id": "cfa40c81-6f67-4ce7-a84f-2f2b0228d63e",
                                                "sense_id": "12ab9600-a71e-3e7a-b3c0-3b58b1598ac1",
                                                "text": "GUSTAVE – Qu’a-t-il depuis que nous sommes ici à fouiller dans ces vieux papiers ?\nJULIETTE – Je ne sais pas. Il est un peu fou. Mais comme il est en même temps méticuleux, cela donne des résultats extraordinaires. Il doit chercher une vieille note de blanchisseuse."
                                            }
                                        ]
                                    }
                                ]
                            }
