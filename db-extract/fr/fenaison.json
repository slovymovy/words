                                "target_senses": [
                                    {
                                        "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                                        "glosses": [
                                            "The cutting of grass and subsequently curing it to make hay as fodder for animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc98ad8-6d5f-4b4f-8c82-4274473e8ca2",
                                                "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                                                "text": "The red-painted farm-houses, peculiar to Norway, lay picturesquely scattered on the higher points of the undulating valley, where men and women were busy hay-making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                                        "glosses": [
                                            "Taking full advantage of an opportunity while it lasts"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19bc38e-239c-444f-bc30-95e3e8188440",
                                                "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                                                "text": "In their haymaking days, the Spoonful created a string of '60s chestnuts: \"Do You Believe In Magic?\", \"You Didn't Have To Be So Nice,\" \"Daydream,\" \"Summer In The City,\" \"Nashville Cats.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcc23f53-3b30-41a3-a535-eb4eea49cb68",
                        "source_entry_id": "3edfa5ad-5f48-3f60-b3a5-fd6e6b9d050a",
                        "source_sense_description": "époque du fanage",
                        "target_lang_word": "fienagione",
