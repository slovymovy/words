                                        "sense_id": "b8c4426d-1c21-3b95-9e2d-aadb788aaa97",
                                        "entry_id": "697d7063-e1e2-3c08-8a66-6800add345b9",
                                        "glosses": [
                                            "The property of being effective, of achieving results."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d484ea-6096-440a-befb-7f7a9b2cf4fc",
                                                "sense_id": "b8c4426d-1c21-3b95-9e2d-aadb788aaa97",
                                                "text": "The effectiveness of the drug was well established."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ba6e8db-a392-3832-a161-ab6000368625",
                                        "entry_id": "697d7063-e1e2-3c08-8a66-6800add345b9",
                                        "glosses": [
                                            "The capacity or potential for achieving results."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d0d95a-3843-4a3b-802f-9952df774dd5",
                                                "sense_id": "1ba6e8db-a392-3832-a161-ab6000368625",
                                                "text": "The problem with these precedents is that the Security Council did not authorize intervention in Syria, and an intervention there will thus harm, not help, the Council’s credibility and effectiveness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c008f6-ca9f-348d-855c-adef1a718155",
                                        "entry_id": "697d7063-e1e2-3c08-8a66-6800add345b9",
                                        "glosses": [
                                            "The degree to which something achieves results."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67390dfc-de22-4cd6-a7d7-b63dc0402087",
                                                "sense_id": "86c008f6-ca9f-348d-855c-adef1a718155",
                                                "text": "He questioned the effectiveness of the treatment."
                                            },
                                            {
                                                "example_id": "aa617d08-4c53-4f97-998f-f235f6f1e74e",
                                                "sense_id": "86c008f6-ca9f-348d-855c-adef1a718155",
                                                "text": "United were having more possession but a sign of the effectiveness of Liverpool's defence was that it took the visitors 76 minutes to force Mignolet into serious action, when he dived to punch away a shot from substitute Nani."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24f1b2a3-b067-45f5-907b-6867e9273ca9",
                        "source_entry_id": "4dbf0f6b-92ab-3c4e-9d8e-accb0e078a80",
                        "source_sense_id": "b0d89514-cadc-3687-ba34-a3d2bbcd8a8b",
                        "target_lang_word": "efficacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "efficacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8edeee-7de4-3af1-b390-ead82ba69d6d",
                                        "entry_id": "8ca63c91-9038-3193-bd09-eb8f52ef71e2",
                                        "glosses": [
                                            "Caractère de ce qui est efficace."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa202d5c-8335-48a9-beee-907ac119ca6f",
                                                "sense_id": "6f8edeee-7de4-3af1-b390-ead82ba69d6d",
                                                "text": "Les résultats obtenus sur la commune de Martigny sont assez surprenants par le maintien d’une assez bonne efficacité du tébufénozide et l’existence d’une résistance au thiaclopride et au chlorpyrifos-éthyl."
                                            },
                                            {
                                                "example_id": "d3a82d10-c06a-4662-9f03-8b27075582ae",
                                                "sense_id": "6f8edeee-7de4-3af1-b390-ead82ba69d6d",
                                                "text": "Même s’ils en font rêver plus d’un, tout le monde n’investit pas des tracteurs high-tech. À tous ceux qui recherchent la simplicité et l’efficacité avant tout, cet essai est fait pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb04ff7b-2ad9-3d85-81e4-83a8ca346242",
                                        "entry_id": "8ca63c91-9038-3193-bd09-eb8f52ef71e2",
                                        "glosses": [
                                            "Capacité de produire un résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f18496-5659-41c1-9326-02e4bc47ddce",
                                                "sense_id": "eb04ff7b-2ad9-3d85-81e4-83a8ca346242",
                                                "text": "Eh bien, continua Coconnas gravement, ce grand homme ne me paraît pas s’être abusé quand […] il regarde la vertu comme une plante balsamique d’un impérissable parfum et d’une efficacité souveraine pour la guérison des blessures."
                                            },
                                            {
                                                "example_id": "6e121844-ddbd-402c-9618-a1d9d9a65d18",
                                                "sense_id": "eb04ff7b-2ad9-3d85-81e4-83a8ca346242",
                                                "text": "Soutenus dans le ciel par les avions de la coalition (qui, à partir de la fin septembre, avaient concentré quasiment tous leurs efforts sur Kobané), ultra-déterminés, ultra-organisés, renforcés par leurs bataillons féminins d’une redoutable efficacité, les YPG reconquirent, mètre après mètre, la moitié de la ville que les djihadistes leur avaient prise, avant de les en chasser complètement le 25 janvier."
                                            },
                                            {
                                                "example_id": "e15f1c23-bc07-499a-b4ce-8b6fcac15d41",
                                                "sense_id": "eb04ff7b-2ad9-3d85-81e4-83a8ca346242",
                                                "text": "Seront examinés successivement : l’efficacité graminicide, l’efficacité dicotylédonicide et la sélectivité à l’égard du colza de l’association propyzamide + diuron (Kerb ultra)."
                                            },
                                            {
                                                "example_id": "c076ccd3-6005-4d7a-be42-f82f354c976f",
                                                "sense_id": "eb04ff7b-2ad9-3d85-81e4-83a8ca346242",
                                                "text": "L’inspection ante-mortem peut améliorer l’efficacité de l’opération en éliminant un certain nombre d’animaux qui seraient impropres à la consommation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a603875-1ee8-3c71-8710-c3243ba35a79",
                                        "entry_id": "8ca63c91-9038-3193-bd09-eb8f52ef71e2",
                                        "glosses": [
                                            "Caractère d’une personne efficace, d’un comportement, d’une action efficace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099a4c93-bf65-49f5-90b7-c8c038578cbb",
                                                "sense_id": "4a603875-1ee8-3c71-8710-c3243ba35a79",
                                                "text": "Pour ce qui concerne le travail manuel, l’efficacité (efficiency) suffit ; il faut être capable de faire les choses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
