                "senses": [
                    {
                        "sense_id": "1e2104ba-2c1e-3695-a16f-0867171c4bbc",
                        "entry_id": "f51e5a2e-df8b-3b7c-be3b-c4f062a74090",
                        "glosses": [
                            "ein Greifvogel auf den Philippinen, alternative Bezeichnung für den Philippinenadler (Pithecophaga jefferyi)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3459f7-a883-4f32-bffc-7e48025787a9",
                                "sense_id": "1e2104ba-2c1e-3695-a16f-0867171c4bbc",
                                "text": "„Der Philippinenadler oder Affenadler gilt als einer der seltensten und mächtigsten Vögel der Welt.“"
                            },
                            {
                                "example_id": "5784d177-bf1b-4243-900a-57065bec0b6a",
                                "sense_id": "1e2104ba-2c1e-3695-a16f-0867171c4bbc",
                                "text": "„Anschließend erzählten ihm die Einheimischen, das Tier fresse Affen, weshalb Whitehead den Vogel Affenadler nannte - Pithecophaga jefferyi (den Zusatz verlieh er zu Ehren seines Vaters Jeffery). Die wissenschaftliche Bezeichnung trägt der Adler bis heute, sein Rufname aber hat sich geändert.“"
                            },
                            {
                                "example_id": "e2baa508-14bf-44dc-b708-496f1e9ee98c",
                                "sense_id": "1e2104ba-2c1e-3695-a16f-0867171c4bbc",
                                "text": "„Was läuft hier noch alles frei herum? Leoparden? Bären? Gorillas? Affenadler?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c783458-92af-3820-8471-5a5804d36d22",
                        "entry_id": "f51e5a2e-df8b-3b7c-be3b-c4f062a74090",
                        "glosses": [
                            "ein Greifvogel in Südamerika, alternative Bezeichnung für die Harpyie (Harpia harpyja)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60edae0d-3cb6-4eaf-b600-833f6c31952a",
                                "sense_id": "5c783458-92af-3820-8471-5a5804d36d22",
                                "text": "„Harpyien können mit ihren bis zu sieben Zentimeter langen Krallen selbst große Affen aus den Baumwipfeln reißen, weshalb sie auch Affenadler genannt werden.“"
                            },
                            {
                                "example_id": "b3054d23-fffc-4a7b-8a35-7b547ad47a04",
                                "sense_id": "5c783458-92af-3820-8471-5a5804d36d22",
                                "text": "„Mit einer Spannweite bis zu 230 Zentimetern und einem durchschnittlichen Gewicht der Weibchen von 7,3 Kilogramm gehört diese auch „Affenadler“ genannte Art zu den größten Adlern."
                            },
                            {
                                "example_id": "54082757-8835-44c6-93d4-69d002cb78d4",
                                "sense_id": "5c783458-92af-3820-8471-5a5804d36d22",
                                "text": "„Was läuft hier noch alles frei herum? Leoparden? Bären? Gorillas? Affenadler?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
