                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f33cbb-d5e2-47ba-acaf-2c94b73331ad",
                                "sense_id": "52085544-833d-3f07-af6d-e7c59e9b95b3",
                                "text": "„Als Russland im Jahr 1856 nach dem Ende des (verloren gegangenen) Krimkriegs gezwungen wird, seine Schwarzmeerflotte aufzulösen, steht die russische Regierung vor dem Problem, finanzielle Übergangslösungen für die Offiziere zu finden.“"
                            },
                            {
                                "example_id": "fa793ee4-d3d2-4627-a8cb-de6de20549d2",
                                "sense_id": "52085544-833d-3f07-af6d-e7c59e9b95b3",
                                "text": "„Für Kiew war die Präsenz der russischen Schwarzmeerflotte ein Provisorium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
