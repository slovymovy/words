                    {
                        "sense_id": "dcf3ad0d-7603-3539-8be3-61b18aaad912",
                        "entry_id": "4db519d4-5ff2-3076-90a3-50753d26bbb2",
                        "glosses": [
                            "ensemble van artiesten die samen een voorstelling geven met humoristisch toneel, zang, dans, en voordracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d97b42-f724-4dfc-b327-0622500481d2",
                                "sense_id": "dcf3ad0d-7603-3539-8be3-61b18aaad912",
                                "text": "Farbod Moghaddam is de winnaar van het Leids Cabaret Festival. In de finale in de Leidsche Schouwburg liet hij vanavond Kasper van der Laan en cabaretgroep Jeroens Clan achter zich."
                            },
                            {
                                "example_id": "16e1062d-1391-4a7d-abb8-b8dbf8c9d3ce",
                                "sense_id": "dcf3ad0d-7603-3539-8be3-61b18aaad912",
                                "text": "Vervolgens werkte hij een jaar bij cabaretgroep Lurelei. In 1971 richtte hij Theater van de Lach op. Met dit toneelgezelschap speelde hij 26 jaar lang circa 3400 voorstellingen, waarin standaard altijd veelvuldig deuren open- en dichtgingen. Meer dan twee miljoen mensen bezochten deze voorstellingen."
                            }
                        ]
                    }
