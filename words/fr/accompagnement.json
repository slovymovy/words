    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f0348d3-71c3-3775-9c02-5e77b660192d",
                    "sense_definition": "Aliment ou garniture qui complète le plat principal d'un repas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme <w>accompagnement</w>, vous préférez des légumes sautés ou du riz ?"
                        },
                        {
                            "text": "Ce délicieux rôti de bœuf est servi avec un <w>accompagnement</w> de pommes de terre."
                        }
                    ],
                    "synonyms": [
                        "garniture"
                    ],
                    "common_phrases": [
                        "servi en accompagnement",
                        "choisir un accompagnement"
                    ]
                },
                {
                    "sense_id": "2dad32dd-5066-382c-a94a-8b31cbfc772a",
                    "sense_definition": "Action de guider, de soutenir ou d'escorter quelqu'un dans une démarche ou un parcours.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette structure offre un <w>accompagnement</w> personnalisé aux créateurs d'entreprise."
                        },
                        {
                            "text": "Le patient bénéficie d'un suivi régulier et d'un <w>accompagnement</w> attentif par les soignants."
                        }
                    ],
                    "synonyms": [
                        "aide",
                        "assistance",
                        "soutien"
                    ],
                    "antonyms": [
                        "abandon"
                    ],
                    "common_phrases": [
                        "mesures d'accompagnement",
                        "accompagnement personnalisé"
                    ]
                },
                {
                    "sense_id": "6cdeb20d-fa09-3456-aa5c-4de6b08c6153",
                    "sense_definition": "Partie instrumentale ou vocale secondaire destinée à soutenir la mélodie principale d'un morceau musical.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La soliste chante magnifiquement avec un doux <w>accompagnement</w> au piano."
                        },
                        {
                            "text": "Un simple <w>accompagnement</w> de guitare suffit à créer une ambiance chaleureuse."
                        }
                    ],
                    "common_phrases": [
                        "accompagnement au piano",
                        "accompagnement musical"
                    ]
                },
                {
                    "sense_id": "0402a79d-f8f2-3798-a53b-859549580a4f",
                    "sense_definition": "Élément accessoire qui s'ajoute à une chose principale pour la compléter ou l'embellir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les illustrations constituent un très bel <w>accompagnement</w> pour ces poèmes."
                        },
                        {
                            "text": "Cet accessoire sert d'<w>accompagnement</w> discret à la pièce maîtresse du décor."
                        }
                    ],
                    "synonyms": [
