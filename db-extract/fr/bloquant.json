                ],
                "senses": [
                    {
                        "sense_id": "5e6dc275-28f9-30a4-beba-2ca6dc23da47",
                        "entry_id": "887c5d40-46ff-3a85-9714-489747a35121",
                        "glosses": [
                            "Qui bloque, empêche un processus de suivre son cours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67ba2c8-5a08-43d6-a830-2be3b2303414",
                                "sense_id": "5e6dc275-28f9-30a4-beba-2ca6dc23da47",
                                "text": "Il s’agit également d’éviter les conflits ou de faire en sorte que ceux-ci ne soient pas bloquants, voire qu’ils puissent être profitables."
                            },
                            {
                                "example_id": "c0283eaa-d508-433b-8a20-078385a3a259",
                                "sense_id": "5e6dc275-28f9-30a4-beba-2ca6dc23da47",
                                "text": "Trop d’idées préconçues, d’opinions toutes faites sur les langues circulent dans le corps social, font écran à une perception plus exacte des réalités et des problèmes, et finissent par former des mythes bloquants qui dénaturent, voire interdisent toute réflexion."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d3c47ef-d53a-362c-b2ce-7fc37a86024b",
                        "entry_id": "887c5d40-46ff-3a85-9714-489747a35121",
                        "glosses": [
                            "Qui participe à un blocus maritime."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f464a7e5-eb9d-4755-be7c-77183bdf5d59",
                                "sense_id": "1d3c47ef-d53a-362c-b2ce-7fc37a86024b",
                                "text": "Des frégates en passant par les Ras, entre l’Iste d'Ouessant & la côte, peuvent échapper à l’armée bloquante ; mais cette manœuvre serait impossible à une escadre."
                            },
                            {
                                "example_id": "146d475f-b12d-4002-a53c-1123ecc6e725",
                                "sense_id": "1d3c47ef-d53a-362c-b2ce-7fc37a86024b",
                                "text": "Le blocus ne devient pas fictif parce qu’un navire aura profité de la nuit, du brouillard ou de quelque autre cause accidentelle pour tromper la surveillance des vaisseaux bloquants."
                            }
                        ]
                    }
                ],
