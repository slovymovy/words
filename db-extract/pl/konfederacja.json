                    },
                    {
                        "translation_id": "8dc05d66-91bd-4aea-9d1b-f8828f704b7b",
                        "source_entry_id": "3607baf5-442c-32f8-b1fd-c9e515608cd5",
                        "source_sense_id": "a609fdc6-37c0-3d0c-b0be-7cc4777315b2",
                        "target_lang_word": "confédération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confédération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Union entre divers États, ou provinces d’un État, qui s’associent sans créer un État fédéral et qui maintiennent leur autonomie (procédure d’unanimité ou véto)."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43523500-36bf-41d6-a43f-137674541193",
                                                "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                                "text": "De tous les États qui forment la vaste confédération mexicaine, l’État de Sonora est le seul qui, […], ait conservé une physionomie à part."
                                            },
                                            {
                                                "example_id": "45bb52bc-7977-4cfb-8aed-e7ba92b529fb",
                                                "sense_id": "48a1cfbb-aee3-3645-8791-c8718f3e1db3",
                                                "text": "Dans une confédération, les États gardent leur souveraineté et sont reconnus comme tels. Dans une fédération, même si les États demeurent autonomes dans leur sphère de juridiction, seul l’État central jouit de cette reconnaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Regroupement flexible de différentes entités politiques, parfois de manière temporaire pour faire face à une menace commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd5a1f8-8987-4822-a9c1-2fc4b4ae6ffe",
                                                "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                                "text": "Le département du Doubs était occupé, pendant la période celtique, par les Séquanes, qui formaient une des plus puissantes confédérations de la Gaule et qui prirent part aux expéditions des Gaulois en Italie et dans la vallée du Danube."
                                            },
                                            {
                                                "example_id": "c8e4f616-ee58-4453-b99b-9dd812127185",
                                                "sense_id": "87aacc74-491d-3185-9a70-029b44e96ab4",
                                                "text": "La confédération béotienne, à l’inverse des ligues péloponnésiennes ou athéniennes, ne semble pas avoir d’abord été une symmachie, mais bien plutôt se rattacher à ces Koina qui rassemblaient autour d’un sanctuaire les cités d’un même ethnos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                        "entry_id": "2447e602-e27b-3995-a26a-704e0ebed21b",
                                        "glosses": [
                                            "Groupe constitué en vue de la défense d’intérêts communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6da8e4-b3f3-42c2-8fd0-44d2f8ea1a33",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération générale du Travail."
                                            },
                                            {
                                                "example_id": "5eb14056-b190-4833-8ba7-0e4afc0ab982",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération luxembourgeoise du Commerce."
                                            },
                                            {
                                                "example_id": "7f7b7227-024e-4630-ac35-20d46621baff",
                                                "sense_id": "e2f21434-35ee-3560-b5c1-5ec803181d03",
                                                "text": "La confédération des provinces et territoires du Canada (1867)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
