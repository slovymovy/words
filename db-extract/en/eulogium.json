                ],
                "senses": [
                    {
                        "sense_id": "1ed04741-e8a2-3a9e-b2ca-00cf6a04c117",
                        "entry_id": "2f0ad46f-41fb-3d0b-b2e3-fd18934de2a8",
                        "glosses": [
                            "A eulogy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1f58e2-f2ae-46a0-9b2c-b822e8d2bdaa",
                                "sense_id": "1ed04741-e8a2-3a9e-b2ca-00cf6a04c117",
                                "text": "Oh, wonderful poet, thou shalt be immortal, if my eulogiums can make thee so!"
                            },
                            {
                                "example_id": "dbbe0354-223b-4003-8d9c-e098962246f1",
                                "sense_id": "1ed04741-e8a2-3a9e-b2ca-00cf6a04c117",
                                "text": "Her eulogium on Rousseau was accidentally put into my hands, and her sentiments, the sentiments of too many of her sex, may serve as the text for a few comments."
                            },
                            {
                                "example_id": "7d09a781-cc6f-4681-96fd-bc55c86c3063",
                                "sense_id": "1ed04741-e8a2-3a9e-b2ca-00cf6a04c117",
                                "text": "Let the grave close over the hand that has laboured through feverish midnights,—over the warm heart that beat so painfully; let the ear be closed to that applause which was its sweetest music;—and then how lavish we grow of all that was before so harshly denied! Then the marble is carved with eulogium; then the life is written; and thousands are lavish of pity and sympathy: every thing is given when it is too late to give anything!"
                            },
                            {
                                "example_id": "7af9cef7-7f99-4f9f-95f0-039c47c22555",
                                "sense_id": "1ed04741-e8a2-3a9e-b2ca-00cf6a04c117",
                                "text": "--and you have been weak enough, traitor, to listen to the eulogiums of a nurse on her child!\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
