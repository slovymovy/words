                "senses": [
                    {
                        "sense_id": "d6f1a203-2118-322b-bd2a-5ab46d02a71f",
                        "entry_id": "3b22efc6-1724-3abf-baae-aa2a075e1112",
                        "glosses": [
                            "Menge der Bedeutungsbestandteile von mehreren Sememen; Bedeutung eines Archilexems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36cf3a2-b760-4dca-bf65-3dbb6c29c6fd",
                                "sense_id": "d6f1a203-2118-322b-bd2a-5ab46d02a71f",
                                "text": "„Wird eine ganze Reihe von Sememen einem allgemeinen Semem untergeordnet, wird von manchen Sprachwissenschaftlern dieses übergeordnete Semem Archisemem, das übergeordnete Lexem Archilexem genannt (Pottier 1964).“"
                            },
                            {
                                "example_id": "40dae27d-fef5-4388-91b5-0ef21402a652",
                                "sense_id": "d6f1a203-2118-322b-bd2a-5ab46d02a71f",
                                "text": "„Die Intersektion aller Sememe einer Lexemgruppe ergibt das Archisemem, dem ein Archilexem entsprechen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
