                                "target_lang_sense_clarification": "che crea ostacolo fisico per le sue dimensioni"
                            },
                            {
                                "target_lang_word": "ostacolante",
                                "target_lang_sense_clarification": "che impedisce o rallenta attivamente un'azione"
                            }
                        ]
