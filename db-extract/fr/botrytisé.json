                "senses": [
                    {
                        "sense_id": "3c1a6745-4d4c-3432-a330-12a05043ed57",
                        "entry_id": "0dc6d5ac-bf0f-34cf-8a90-5332b1bf97ef",
                        "glosses": [
                            "Qualifie un raisin gagné par la pourriture noble, et le vin qui en est issu."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "3fcf096c-fd14-4820-969f-02cd7cd50e08",
                                "sense_id": "3c1a6745-4d4c-3432-a330-12a05043ed57",
                                "text": "L’essor du champignon est ralenti, la baie se dessèche et ses sucres se concentrent. Puis les vendanges sont faites par tries successives et les grains botrytisés récoltés avec délicatesse."
                            },
                            {
                                "example_id": "accb6dfb-1ffc-4391-a32d-97a3cf135abf",
                                "sense_id": "3c1a6745-4d4c-3432-a330-12a05043ed57",
                                "text": "À l’automne, la peau des grains de raisins botrytisés est de couleur violette. La pulpe est alors une sorte de confiture dorée."
                            },
                            {
                                "example_id": "01cde59b-1777-44bd-9b9c-509f152da533",
                                "sense_id": "3c1a6745-4d4c-3432-a330-12a05043ed57",
                                "text": "À l’instar de l’Autriche, notre survol de la Hongrie vinicole sera succinct. Il en ciblera le fleuron : le mythique tokay, plus ancien vin botrytisé au monde et proclamé « vin des rois et roi des vins » par nul autre que Louis XIV."
                            }
                        ]
                    }
                ],
