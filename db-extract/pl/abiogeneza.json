                    {
                        "translation_id": "0f32c682-39b0-4a1b-93f2-f0d1b33cacab",
                        "source_entry_id": "45ae9855-89e1-3528-a696-a86470b9255d",
                        "source_sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                        "target_lang_word": "абиогенез",
