                                        "entry_id": "99deb9f4-57ec-3f13-9dd2-ce5be00b9d8e",
                                        "glosses": [
                                            "jemandes Gefühle durch abwertende Worte, Gesten oder Handlungen verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68513554-ee6d-4387-bb6a-f4833a31a11c",
                                                "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                                "text": "„Wenn Du mich noch einmal solch beleidigende Ausdrücken verwendest gibt's richtig Ärger!“"
