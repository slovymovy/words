            {
                "entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
                "word": "marathi",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c520ab03-a783-30e2-a0ad-3271f6d509c7",
                        "entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
                        "glosses": [
                            "Relatif aux Marathis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5326284c-f3ff-4206-b021-8585a92b7002",
                                "sense_id": "c520ab03-a783-30e2-a0ad-3271f6d509c7",
                                "text": "La vie d’un saint et poète marathi du XVIIIᵉ siècle, dont les chants captivent les paysans malgré la jalousie d’un mauvais prêtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5776deb-3d06-30e6-882d-938db50b761a",
                        "entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
                        "glosses": [
                            "Relatif au marathe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "574605e4-e199-4ef6-99b0-7ca5826e39fd",
                                "sense_id": "c5776deb-3d06-30e6-882d-938db50b761a",
                                "text": "Les fondamentalistes hindous vont donc officiellement lui redonner son identité, en imposant le nom en langue marathi qu’ont toujours utilisé habitants de Bombay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a50ae8df-8058-4546-bc53-77fba61f1ce4",
                        "source_entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
                        "source_sense_description": "relatif aux Marathis",
                        "target_lang_word": "Marathi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marathi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89e44254-7367-3a31-ae72-b523aa9acfe0",
                                        "entry_id": "bf28bef9-bee8-3207-b063-72105a9e9cd4",
                                        "glosses": [
                                            "An Indo-Aryan language that is the predominant language spoken in the state of Maharashtra, India."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4ef02dc-2ccf-485d-a576-72b0a4adfd37",
                                                "sense_id": "89e44254-7367-3a31-ae72-b523aa9acfe0",
                                                "text": "I made a pact with her that she would teach me more Marathi and I could teach her the English alphabet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Marathi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ede5b2-7b2f-3869-8145-99496699c535",
                                        "entry_id": "5e2ec49c-ec71-3826-8224-7231900971e3",
                                        "glosses": [
                                            "A person of a Marathi-speaking people from the state of Maharashtra; a person of or from Maharashtra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376aecb7-beb1-4e53-a235-cfe63df9658e",
                                                "sense_id": "b2ede5b2-7b2f-3869-8145-99496699c535",
                                                "text": "1882, R. V. Modak, History of the Native Churches Associated with the American Marathi Mission..., in Memorial Papers of the American Marathi Mission, 1813-1881, American Marathi Mission, page 11,\nIn March 1831, Moroba, a Marathi, was received to the church."
                                            },
                                            {
                                                "example_id": "e029e1e1-8bfd-427a-971e-098ad38a184a",
                                                "sense_id": "b2ede5b2-7b2f-3869-8145-99496699c535",
                                                "text": "'These people want places reserved for Marathis in railways jobs, so they’re attacking candidates across the city … Bhai, this'll turn ugly before you know it.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Marathi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                                        "entry_id": "ebb7d333-c248-3002-809d-ac8fc08bebfa",
                                        "glosses": [
                                            "Pertaining to the state of Maharashtra, to the Marathi-speaking people from the state, or to the Marathi language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3511d558-8780-4aef-a1ca-8153b917a4a0",
                                                "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                                                "text": "2022, Hrishikesh Sudhakar Ingle, Marathi Cinema, Cultural Space, and Liminality, Oxford University Press, unnumbered page,\nIn formulating the idea of a vernacular performative, the intention has been to situate Marathi filmmaking of the 1950s within a post-studio scenario."
                                            },
                                            {
                                                "example_id": "93e91765-cdb8-4332-b56e-73ce128766d7",
                                                "sense_id": "7d53b65b-3fbd-337f-9ab0-88030cdaef22",
                                                "text": "For years now, local parties in Mumbai had campaigned for Marathi people to get preferential treatment – land, housing, jobs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cc1b1e3-7bc6-4124-b345-d9708c7b5300",
                        "source_entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
