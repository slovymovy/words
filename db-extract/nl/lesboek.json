                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "530bd488-ae5d-4303-b174-d1883d34a2a6",
                                "sense_id": "ba98ee17-5f40-3288-9fed-e187a020d06a",
                                "text": "Op de middelbare school heet een lesboek een schoolboek op de universiteit een studieboek."
