                                    },
                                    {
                                        "sense_id": "34fc3457-592d-398d-b9e6-7cac722f8711",
                                        "entry_id": "b6c0e94b-8dda-36a9-8b3b-dde2772368f0",
                                        "glosses": [
                                            "Ladentheke in einer Apotheke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557d3d4d-f378-45df-89cf-6c19f895b0a7",
                                                "sense_id": "34fc3457-592d-398d-b9e6-7cac722f8711",
                                                "text": "Beim Beratungsgespräch in der Apotheke wünscht man sich Diskretion an der Tara."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e6bbb1d8-afb1-329e-b52e-0aa76ec028c8",
                                        "entry_id": "b6c0e94b-8dda-36a9-8b3b-dde2772368f0",
                                        "glosses": [
                                            "eine Göttin"
                                        ],
                                        "tags": [
                                            "hinduistisch und buddhistisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92478a95-9f64-451a-a20d-b039b219d410",
                                                "sense_id": "e6bbb1d8-afb1-329e-b52e-0aa76ec028c8",
                                                "text": "Tara verkörpert all das, was die tibetischen Buddhisten als die \"weibliche Allweisheit\" schätzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
