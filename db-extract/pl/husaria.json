                "senses": [
                    {
                        "sense_id": "a35e3815-6231-3644-9cf6-d9794377766f",
                        "entry_id": "ea77c0fb-eb20-3ece-b018-23965d00fd2c",
                        "glosses": [
                            "lekka formacja kawaleryjska w XVI-wiecznej Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04f2aff-6aed-484a-acd0-d85bb52856ec",
                                "sense_id": "a35e3815-6231-3644-9cf6-d9794377766f",
                                "text": "Dopiero w drugiej połowie XVI wieku husaria stała się stopniowo główną siłą uderzeniową wojsk Rzeczypospolitej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5faab1af-f084-3939-a373-de1a3073276c",
                        "entry_id": "ea77c0fb-eb20-3ece-b018-23965d00fd2c",
                        "glosses": [
                            "ciężka jazda polska od połowy XVI do XVIII w."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c568139-beb8-422e-a809-6f6767ea5347",
                                "sense_id": "5faab1af-f084-3939-a373-de1a3073276c",
                                "text": "Sobieski zabrał z Krakowa ok. 27 tys. wojsk koronnych, w tym 24 chorągwie husarii, i 29 lipca, nie czekając na spóźniających się Litwinów, pomaszerował śpiesznie na odsiecz Wiedniowi"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
