                    },
                    {
                        "form_id": "1dad3efc-6a79-42f5-83c4-1b1e18634a59",
                        "entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most indubitably"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                        "entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "glosses": [
                            "In a manner that leaves no possibility of doubt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86617ae7-a0da-4c8b-b229-aa6813c87142",
                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                "text": "Now his first suspicion was indubitably confirmed."
                            },
                            {
                                "example_id": "2983e14b-ccc8-4b30-94dc-1163495867da",
                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                "text": "Near-synonyms: verifiably, provably"
                            },
                            {
                                "example_id": "04471c59-748a-42e7-b85f-4970a6f826fd",
                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                "text": "The world is indubitably one if you look at it in one way, but as indubitably is it many, if you look at it in another. It is both one and many—let us adopt a sort of pluralistic monism."
                            },
                            {
                                "example_id": "b34a0cb4-9e16-4f0d-8f85-0b3304ac3e76",
                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                "text": "They were all indubitably, aggressively alive! Everybody was alive once more!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27952578-3288-43f4-acc0-7b40a072038e",
                        "source_entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "source_sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                        "source_sense_description": "Undoubtedly; unquestionably",
                        "target_lang_word": "ongetwijfeld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongetwijfeld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "224c2001-c48f-3576-9dda-052cb09c9a01",
                                        "entry_id": "f73da4b1-9425-37f9-99fe-f490b7d07312",
                                        "glosses": [
                                            "waarover zekerheid bestaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3615f278-a42d-4668-b7f8-5e557c2aff09",
                                                "sense_id": "224c2001-c48f-3576-9dda-052cb09c9a01",
                                                "text": "Dat is ongetwijfeld het geval."
                                            },
                                            {
                                                "example_id": "659a039a-172e-4524-965d-a032c2d9704f",
                                                "sense_id": "224c2001-c48f-3576-9dda-052cb09c9a01",
                                                "text": "Ze had een zoon die zijn eindexamen had gehaald als extraneus in Harnôsand, ze had ongetwijfeld zijn studie gefinancierd met al haar gezwoeg."
                                            },
                                            {
                                                "example_id": "906f07a5-d51f-4acc-9adc-72708f8bd8d4",
                                                "sense_id": "224c2001-c48f-3576-9dda-052cb09c9a01",
                                                "text": "Hij pakte hem op en bekeek de man, ongetwijfeld haar voormalige."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fcd242c-1ebb-41dc-9d40-b927ed64fbd9",
                        "source_entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                        "source_sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
