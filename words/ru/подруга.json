                    "sense_id": "b65bb00f-377b-3551-b763-60df76f724d2",
                    "sense_definition": "Женщина или девочка, с которой кто-либо состоит в дружеских отношениях; женская форма слова <w>друг</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "friendship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя лучшая <w>подруга</w> всегда помогает мне советом.",
                            "target_lang_translations": {
                                "en": "My best <w>friend</w> always helps me with advice.",
                                "nl": "Mijn beste <w>vriendin</w> helpt me altijd met advies.",
                                "pl": "Moja najlepsza <w>przyjaciółka</w> zawsze pomaga mi radą.",
                                "de": "Meine beste <w>Freundin</w> hilft mir immer mit gutem Rat.",
                                "fr": "Ma meilleure <w>amie</w> m'aide toujours de ses conseils.",
                                "it": "La mia migliore <w>amica</w> mi aiuta sempre con i suoi consigli.",
                                "cs": "Moje nejlepší <w>kamarádka</w> mi vždycky pomůže radou.",
                                "tr": "En iyi <w>arkadaşım</w> bana her zaman tavsiyeleriyle yardımcı olur.",
                                "es": "Mi mejor <w>amiga</w> siempre me ayuda con sus consejos."
                            }
                        },
                        {
                            "text": "Мы с <w>подругой</w> договорились встретиться в кафе.",
                            "target_lang_translations": {
                                "en": "My <w>friend</w> and I agreed to meet at a cafe.",
                                "nl": "Mijn <w>vriendin</w> en ik hebben afgesproken om in een café af te spreken.",
                                "pl": "Umówiłam się z <w>przyjaciółką</w> na spotkanie w kawiarni.",
                                "de": "Meine <w>Freundin</w> und ich haben uns verabredet, uns in einem Café zu treffen.",
                                "fr": "Mon <w>amie</w> et moi avons convenu de nous retrouver dans un café.",
                                "it": "Io e la mia <w>amica</w> abbiamo deciso di incontrarci in un bar.",
                                "cs": "Domluvily jsme se s <w>kamarádkou</w>, že se sejdeme v kavárně.",
                                "tr": "<w>Arkadaşımla</w> kafede buluşmak üzere sözleştik.",
                                "es": "Mi <w>amiga</w> y yo acordamos vernos en una cafetería."
                            }
                        }
                    ],
                    "synonyms": [
                        "приятельница"
