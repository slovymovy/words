                "senses": [
                    {
                        "sense_id": "ee7553cb-47a3-3d39-afcf-a865bfa6a085",
                        "entry_id": "07c13fad-3b5a-3415-ac46-ce0ae49e84e1",
                        "glosses": [
                            "Une des espèces d'animaux chordés crâniates agnathes marins nécrophages ressemblant à une anguille gluante, à bouche circulaire entourée de barbillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61eddf7b-5f89-4d78-b5c5-d4a288291c10",
                                "sense_id": "ee7553cb-47a3-3d39-afcf-a865bfa6a085",
                                "text": "Les myxines sont des nécrophages des profondeurs marines qui dévorent les animaux morts."
                            },
                            {
                                "example_id": "d0125acf-c4c0-403c-850c-4a58381e9804",
                                "sense_id": "ee7553cb-47a3-3d39-afcf-a865bfa6a085",
                                "text": "La myxine est une créature primitive semblable à une anguille dépourvue de colonne vertébrale vivant au fond des océans."
                            }
                        ]
                    }
                ],
