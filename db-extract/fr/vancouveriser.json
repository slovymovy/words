                        "glosses": [
                            "Donner un caractère rappelant Vancouver à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a251972e-a6db-4169-ace0-aae68b9b3ace",
                                "sense_id": "d8574feb-94c3-362b-8505-a3217c812e18",
                                "text": "Aux Etats-Unis et au Moyen-Orient, les architectes et les urbanistes parlent désormais de « Vancouveriser » leurs métropoles."
                            },
                            {
                                "example_id": "10585460-3698-405b-8d50-0546f51ec2ed",
                                "sense_id": "d8574feb-94c3-362b-8505-a3217c812e18",
                                "text": "La poésie est plus que Vancouverisée, ici !"
                            },
                            {
                                "example_id": "bf6a35d7-93e9-4306-bb16-695f5bae7696",
                                "sense_id": "d8574feb-94c3-362b-8505-a3217c812e18",
                                "text": "Le temps commence justement à se \"vancouveriser: il commence à pleuvoir souvent en d'autres termes."
                            }
                        ]
