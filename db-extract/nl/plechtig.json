                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8954d4-b063-4dd2-9795-080b53f557ee",
                                                "sense_id": "9d32ba88-3cda-374c-b895-24199d547220",
                                                "text": "Whereas the accentuated linearism, the angular stylization of the folds, the rhythmical course of the outlining and the solemn frontality conjoined with an air of regality in the pose seem to recall the formal repertory of the Corbolinus Master and his group […]"
                                            }
