{
    "word_family": [
        "lopen",
        "doorlopen",
        "overlopen",
        "volgelopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f5d14c5-e0ad-39fa-bbf2-eb04f1b20a83",
                    "sense_definition": "zich vullen met water door een overstroming of lekkage",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overstroming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de onophoudelijke regens was de polder helemaal <w>ondergelopen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the incessant rains, the polder was completely <w>flooded</w>."
                            }
                        },
                        {
                            "text": "De brandweer moest komen helpen omdat de kelder begon <w>onder</w> te <w>lopen</w>.",
                            "target_lang_translations": {
                                "en": "The fire department had to come help because the basement started to <w>flood</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "overstromen",
                        "inunderen"
                    ],
                    "antonyms": [
                        "leeglopen",
                        "opdrogen"
                    ],
                    "common_phrases": [
                        "kelder laten onderlopen",
                        "geheel ondergelopen land"
                    ],
                    "target_lang_definitions": {
                        "en": "to fill with water due to a flood or leak"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flood",
                                "target_lang_sense_clarification": "to be covered with water"
                            },
                            {
                                "target_lang_word": "to be submerged",
                                "target_lang_sense_clarification": "to be completely underwater"
                            },
                            {
                                "target_lang_word": "to inundate",
                                "target_lang_sense_clarification": "to overwhelm with water"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b22ead2b-7ca9-3e79-a8e7-d68ff6f6e5fe",
                    "sense_definition": "iemand inhalen of achterhalen, meestal door hard te lopen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inhalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De snelle atleet wist zijn tegenstander vlak voor de finish te <w>onderlopen</w>.",
                            "target_lang_translations": {
                                "en": "The fast athlete managed to <w>overtake</w> his opponent just before the finish line."
                            }
                        },
                        {
                            "text": "Hij probeerde de ontsnapte dief nog te <w>onderlopen</w> in de smalle steegjes.",
                            "target_lang_translations": {
                                "en": "He still tried to <w>outrun</w> the escaped thief in the narrow alleys."
                            }
                        }
                    ],
                    "synonyms": [
                        "inhalen",
                        "achterhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "to overtake or catch up with someone, usually by running fast"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to overtake",
                                "target_lang_sense_clarification": "to catch up with and pass"
                            },
                            {
                                "target_lang_word": "to outrun",
                                "target_lang_sense_clarification": "to run faster than someone else"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a951d4ee-1a7a-325f-89b1-f953af19f733",
                    "sense_definition": "iets verstoren of verhinderen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verstoren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn constante onderbrekingen <w>onderliepen</w> de voortgang van de belangrijke vergadering.",
                            "target_lang_translations": {
                                "en": "His constant interruptions <w>disrupted</w> the progress of the important meeting."
                            }
                        },
                        {
                            "text": "Het was niet de bedoeling om de ceremoniële processie op deze wijze te <w>onderlopen</w>.",
                            "target_lang_translations": {
                                "en": "It was not the intention to <w>thwart</w> the ceremonial procession in this manner."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstoren",
                        "verhinderen",
                        "dwarsbomen"
                    ],
                    "antonyms": [
                        "bevorderen",
                        "faciliteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze betekenis komt zelden voor in modern taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to disrupt or prevent something from happening"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to disrupt",
                                "target_lang_sense_clarification": "to interrupt an event or activity"
                            },
                            {
                                "target_lang_word": "to thwart",
                                "target_lang_sense_clarification": "to prevent someone from accomplishing something"
                            },
                            {
                                "target_lang_word": "to undermine",
                                "target_lang_sense_clarification": "to lessen the effectiveness of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}