                        "glosses": [
                            "Ordnung der Klasse Echte Farne; ausdauernde Kräuter mit großen gefiederten Laubblättern, deren Vermehrung durch Sporen erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86062a2a-c23e-4d8c-962d-1e8531e3c19c",
                                "sense_id": "ae6cd8d8-e63d-355c-bae8-594d8698a5b7",
                                "text": "Die Sporenkapseln der Tüpfelfarnartigen bilden sich auf der Unterseite der Laubblätter und haben keinen Schleier als Schutz."
                            },
                            {
                                "example_id": "e569c71d-9c2d-40e9-81e0-93c0c7958f1e",
                                "sense_id": "ae6cd8d8-e63d-355c-bae8-594d8698a5b7",
                                "text": "Zu den Tüpfelfarnartigen zählen auch epiphytisch lebende Arten mit humussammelnden Nischenblättern."
                            }
                        ],
