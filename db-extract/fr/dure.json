                    {
                        "sense_id": "b88f2573-374a-32df-8f3c-2460063975a4",
                        "entry_id": "835375ca-d54f-3494-8a43-ed954e5a59aa",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de durer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "448072ba-a964-472a-b8c8-12f707232e72",
                                "sense_id": "b88f2573-374a-32df-8f3c-2460063975a4",
                                "text": "Dans mon étrave, à deux-cents mètres, de gros jets d’eau, de grands sauts qui « splashent » ; ça dure un bon moment, puis le gros cétacé, comme son nom l’indique, s’en va, notre première baleine."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c52f0b8-9a9d-3c52-88da-c75a74422ead",
                        "entry_id": "835375ca-d54f-3494-8a43-ed954e5a59aa",
                        "glosses": [
                            "Première personne du singulier du présent du subjonctif de durer."
                        ],
