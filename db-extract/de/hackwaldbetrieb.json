                "senses": [
                    {
                        "sense_id": "3d6f449e-0522-3cbb-b273-0c4d90001aa3",
                        "entry_id": "e7161f37-ee17-301e-94c1-02630e18334f",
                        "glosses": [
                            "Nutzungsform des Waldes, bei der die wenige Meter hohen Stangen der Eiche, Buche oder Kastanie geschlagen und geschält (Gerbrinde) und als Rebstangen etc. verwendet werden. Die Stümpfe bleiben im Boden, das Reisig wird über die Fläche verteilt und verbrannt (Aschedüngung). Nach oberflächlichem Hacken wird Roggen gesät und mit der Sichel geerntet. Nach einigen Jahren bestockt sich aus den Stümpfen wiederum der Niederwald."
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "8ae336f7-6036-47d8-b635-ec6cbfa850f8",
                                "sense_id": "3d6f449e-0522-3cbb-b273-0c4d90001aa3",
                                "text": "Hackwaldbetrieb findet sich im Schwarzwald, den Vogesen, im Moseltal und im Westerwald."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
