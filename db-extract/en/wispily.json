                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7cf8695-2946-4b83-9824-e8178c407597",
                                "sense_id": "530c6e08-dcdf-3443-8d5d-055a0243c9a0",
                                "text": "From some far seaward cisterns of the air billows of fog poured down over the city of San Francisco; rebounding like smoke from the summer-heated fronts of hills, they settled in shady hollows and caught wispily at rows of trees."
                            },
                            {
                                "example_id": "ef209f80-5ad3-4533-b850-1879fe8fccd9",
                                "sense_id": "530c6e08-dcdf-3443-8d5d-055a0243c9a0",
                                "text": "“Yes,” said Julia, vaguely and wispily. “Yes, dear, you have.”"
                            },
                            {
                                "example_id": "808e48b4-1920-4ea4-af2f-f89462280d6f",
                                "sense_id": "530c6e08-dcdf-3443-8d5d-055a0243c9a0",
                                "text": "A man and his dog were going to materialize, were going to appear out of thin air—wispily at first, becoming, finally, as substantial as any man and dog alive."
                            },
                            {
                                "example_id": "215d1793-281b-456e-96f8-415bd6ee7e89",
                                "sense_id": "530c6e08-dcdf-3443-8d5d-055a0243c9a0",
                                "text": "He caught a last glimpse of Mitzi’s large breasts bulging out above her brassiere, wispily veiled by the negligee."
                            },
                            {
                                "example_id": "3ae3b027-ba39-4d36-a3d0-b14f9ea876e9",
                                "sense_id": "530c6e08-dcdf-3443-8d5d-055a0243c9a0",
                                "text": "But the fat man remains, as does the cashier, who is wispily blond, with a bony hillbilly nose and translucent white skin."
                            }
                        ]
                    }
