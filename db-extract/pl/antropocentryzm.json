                "senses": [
                    {
                        "sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                        "entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "glosses": [
                            "przekonanie, wedle którego człowiek to ośrodek świata, a wszystko w przyrodzie dzieje się ze względu na niego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52283ff0-bbfe-42c4-93b9-8d57d493bd2a",
                                "sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                                "text": "(…) w polskiej humanistyce zwierzęta były tak długo nieobecne, że wiele aspektów ufundowanego na antropocentryzmie stosunku ludzi do zwierząt nie zostało jeszcze opisanych i zrozumianych"
                            },
                            {
                                "example_id": "6269415a-59fa-4a69-907e-b0d881cc0e9e",
                                "sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                                "text": "Freud zadaje antropocentryzmowi coup de grâce wykazując, iż rzekomy „król stworzenia\" nie jest gospodarzem nawet na tym ściśle prywatnym folwarczku, jakim jest jego własna osobowość"
                            },
                            {
                                "example_id": "8a10bf02-8fe0-45ec-922e-1cc9b1f10d96",
                                "sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                                "text": "Antropocentryzm jest charakterystyczną cechą myślenia inspirowanego religią chrześcijańską"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3cf23df7-74a3-3da3-8326-7fc037369389",
                        "entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "glosses": [
                            "interpretacja świata wyłącznie z punktu widzenia doświadczenia człowieka"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d8f6b00-915b-4723-9334-260d5264d6da",
                        "source_entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "source_sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                        "target_lang_word": "anthropocentrism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropocentrism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef64aa0-e174-3ae9-8c52-e57db1d3eeed",
                                        "entry_id": "70859259-2215-3653-808e-29bfff32cb36",
                                        "glosses": [
                                            "A viewpoint or theory that places human beings at the center of everything, giving preference to human beings above all other considerations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a011151-1d29-4c0c-8955-e0e22595aee1",
                                                "sense_id": "7ef64aa0-e174-3ae9-8c52-e57db1d3eeed",
                                                "text": "Is challenging anthropocentrism irrelevant and unhelpful? The arguments against human—centredness I have advanced in the previous chapter include a strongly prudential one for the human species — that anthropocentrism leads to […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "895c611e-f003-4d24-8fa5-dd156ea08580",
                        "source_entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "source_sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
