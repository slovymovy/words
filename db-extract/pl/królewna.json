                "senses": [
                    {
                        "sense_id": "a0de6371-3ded-3836-bd40-7832283923ff",
                        "entry_id": "6bf443d5-59f4-353f-a59a-a61b24f09b19",
                        "glosses": [
                            "córka króla i/lub królowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a167d9-b302-4581-b523-cf3374b674bf",
                                "sense_id": "a0de6371-3ded-3836-bd40-7832283923ff",
                                "text": "Spotykał już wielokrotnie księżniczki, a nawet królewny, włóczące się z trupami wędrownych aktorów i szczęśliwe, że zdołały zbiec przed zgrzybiałym, ale wciąż spragnionym potomka królem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "33feb107-b715-3c2e-af5b-358ed21b1cb9",
                        "entry_id": "6bf443d5-59f4-353f-a59a-a61b24f09b19",
                        "glosses": [
                            "żona królewicza"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4b79905f-b396-32ce-ab1b-cbb5d227edc8",
                        "entry_id": "6bf443d5-59f4-353f-a59a-a61b24f09b19",
                        "glosses": [
                            "kobieta lub dziewczyna uważająca, że inni powinni jej usługiwać"
                        ],
