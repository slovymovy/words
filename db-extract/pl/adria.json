                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6136bde2-7d9f-3e23-8e8c-2061a17df232",
                                        "entry_id": "d21a9a48-544a-30d5-adfc-9147368b0241",
                                        "glosses": [
                                            "Adriatisches Meer; der Teil des Mittelmeeres, der nördlich der Straße von Otranto liegt und die Apenninhalbinsel von der Balkanhalbinsel trennt"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01dfba1b-432b-4573-9fc4-870961568f1a",
                                                "sense_id": "6136bde2-7d9f-3e23-8e8c-2061a17df232",
                                                "text": "Sie fährt alle zwei Jahre im Sommer an die Adria."
                                            },
                                            {
                                                "example_id": "1fbf011e-c16e-4e5b-9c2c-998b84bb1dac",
                                                "sense_id": "6136bde2-7d9f-3e23-8e8c-2061a17df232",
                                                "text": "„Die Kelten mußten für ihren Angriff schwer büßen. Der betreffende Stamm, die Senonen, wurde in seinem Gebiet an der Adria aufgesucht und von dort vertrieben.“"
                                            },
                                            {
                                                "example_id": "03050e47-bba6-4855-b19b-4462c3fbc1bf",
                                                "sense_id": "6136bde2-7d9f-3e23-8e8c-2061a17df232",
                                                "text": "Unseren letzten Urlaub verbrachten wir an der Adria."
                                            },
                                            {
                                                "example_id": "2f66847b-9ed7-48d9-bb1c-fa7539a0c18f",
                                                "sense_id": "6136bde2-7d9f-3e23-8e8c-2061a17df232",
                                                "text": "Das Lagerfeuer an der Adria erlosch erst am frühen Morgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Adria",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "964e23be-cad2-33ce-a043-b781b75567e1",
                                        "entry_id": "0ebd2a3d-eb0d-375d-b2ec-8ebd6312ff00",
                                        "glosses": [
                                            "Stadt in der italienischen Provinz Rovigo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3470dc9b-f831-4066-9b40-b5f99e1a426a",
                                                "sense_id": "964e23be-cad2-33ce-a043-b781b75567e1",
                                                "text": "Das Podelta ist nur circa 30 Kilometer von Adria entfernt."
                                            },
                                            {
                                                "example_id": "75d7c91c-9272-4400-b639-293f5637665e",
                                                "sense_id": "964e23be-cad2-33ce-a043-b781b75567e1",
                                                "text": "Von Adria bis Venedig sind es circa 50 Kilometer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
