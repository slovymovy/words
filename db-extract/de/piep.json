                            },
                            {
                                "target_word": "peep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb8786b-88df-3733-81c3-127d54995634",
                                        "entry_id": "49b07b63-d750-3b1e-928f-fe65d56a8446",
                                        "glosses": [
                                            "To look, especially through a narrow opening, or while trying not to be seen or noticed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508c82cd-0664-416c-9743-34c5c03954b0",
                                                "sense_id": "2fb8786b-88df-3733-81c3-127d54995634",
                                                "text": "The man peeped through the small hole."
                                            },
                                            {
                                                "example_id": "a328084c-1154-478b-b3ce-e15824a7a7c9",
                                                "sense_id": "2fb8786b-88df-3733-81c3-127d54995634",
                                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                                            },
                                            {
                                                "example_id": "403732df-f504-4b79-aeff-0748a3e08d04",
                                                "sense_id": "2fb8786b-88df-3733-81c3-127d54995634",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5afa98-95c8-30b5-9ff6-efde4423ccf0",
                                        "entry_id": "49b07b63-d750-3b1e-928f-fe65d56a8446",
                                        "glosses": [
                                            "To begin to appear; to look forth from concealment; to make the first appearance."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df046b1-d26d-40e7-ac1c-22d4a5f4fc17",
                                                "sense_id": "4b5afa98-95c8-30b5-9ff6-efde4423ccf0",
                                                "text": "When flowers first peeped, and trees did blossoms bear."
                                            },
                                            {
                                                "example_id": "0d30872a-6592-4a86-bab7-c55b136c4a9c",
                                                "sense_id": "4b5afa98-95c8-30b5-9ff6-efde4423ccf0",
                                                "text": "They first caught crabs and quohogs in the sand; grown bolder, they waded out with nets for mackerel; more experienced, they pushed off in boats and captured cod; and at last, launching a navy of great ships on the sea, explored this watery world; put an incessant belt of circumnavigations round it; peeped in at Behring’s Straits; and in all seasons and all oceans declared everlasting war with the mightiest animated mass that has survived the flood; most monstrous and most mountainous!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc8aa79-354b-3725-b223-9406d9e0fc1d",
                                        "entry_id": "49b07b63-d750-3b1e-928f-fe65d56a8446",
                                        "glosses": [
                                            "To take a look at; check out."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acad9ae0-ff52-49e3-a436-e0bac0d8c64a",
                                                "sense_id": "acc8aa79-354b-3725-b223-9406d9e0fc1d",
                                                "text": "Did you peep that video I sent you?"
                                            },
                                            {
                                                "example_id": "9d6708a1-0822-4c76-b5ae-dbbaa70c8c4c",
                                                "sense_id": "acc8aa79-354b-3725-b223-9406d9e0fc1d",
                                                "text": "Peep me, I'm fabulous, I work with the hardest working women at Kay Jeweler's, selling the finest jewels to the richest people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f02f684-c000-310b-ab91-f0ac56743ac6",
                                        "entry_id": "49b07b63-d750-3b1e-928f-fe65d56a8446",
                                        "glosses": [
                                            "To see, uncover."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95ae95bb-dce8-4d87-bf71-7aff4b745a89",
                                                "sense_id": "7f02f684-c000-310b-ab91-f0ac56743ac6",
                                                "text": "A lot of females were hesitant about getting with Pimp. He had a hard edge to him that made it impossible not to peep his cruel nature."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                        "entry_id": "654b17c7-ed3a-315f-9124-f72e7f4ab018",
                                        "glosses": [
                                            "A quick look or glimpse, especially a furtive one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5abe6e-411b-4090-b701-904f885f532c",
                                                "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                                "text": "I was sick with dread, but I bravely said: \"I'll just take a peep inside. / I guess he's cooked, and it's time I looked\"; […] then the door I opened wide."
                                            },
                                            {
                                                "example_id": "9eee8cc6-f18b-4406-8f65-67a6f92a025d",
                                                "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                                "text": "So saying she loosened some ivory screws of the guitar, so as to open a peep lengthwise through its interior."
                                            },
                                            {
                                                "example_id": "95435065-4b16-4d97-acaa-c0b85fd68a66",
                                                "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                                "text": "But at last Mr. Fox gave the order to stop. \"I think,\" he said, \"we had better take a peep upstairs now and see where we are. I know where I want to be, but I can't possibly be sure we're anywhere near it.\""
                                            },
                                            {
                                                "example_id": "7b4adec1-eac3-4459-9ed5-45462e64e9df",
                                                "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                                "text": "Another wheel toy was a baker's barrow on wheels, 14 inches high; it was filled with buns, loaves, and crumpets and came from Hamley's. This toy in 1959 was a peep into the past, for wheeled barrows such as this one, had not been in use for a number of years."
                                            },
                                            {
                                                "example_id": "df0648fa-6879-4e4d-a7cc-93edcc01c9c0",
                                                "sense_id": "9dad2995-fbda-3ffd-b00c-9c99a7e09280",
                                                "text": "He did manage a brief peep at the building’s Rotunda as he called on members of the Senate Judiciary Committee in July."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cd58bd-b39d-39bf-953c-c9b1927ca548",
                                        "entry_id": "654b17c7-ed3a-315f-9124-f72e7f4ab018",
                                        "glosses": [
                                            "The first partial appearance of something; a beginning to appear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a0e919-3883-4186-aa4a-48d360d36109",
                                                "sense_id": "51cd58bd-b39d-39bf-953c-c9b1927ca548",
                                                "text": "the peep of day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b094ba4a-5809-3d9c-89bd-9e159174dcb2",
                                        "entry_id": "654b17c7-ed3a-315f-9124-f72e7f4ab018",
                                        "glosses": [
                                            "A peepshow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f235abd4-487a-4cb2-b56a-132c8a8e824a",
                                                "sense_id": "b094ba4a-5809-3d9c-89bd-9e159174dcb2",
                                                "text": "A boring lusterless attempt at pornography, a niche above the racks of pulp pocketbooks sold in the front room of peeps."
                                            }
                                        ]
                                    }
                                ]
