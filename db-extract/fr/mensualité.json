                    {
                        "sense_id": "1b7c12c5-42d9-336b-bc46-8783543a0ec4",
                        "entry_id": "3e7a05ff-dc67-369c-a993-73067ffd2d32",
                        "glosses": [
                            "Somme d’argent qu’on verse chaque mois en suivant des clauses contractuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b827ca3d-4ab5-44f8-bf49-2f5d544075f5",
                                "sense_id": "1b7c12c5-42d9-336b-bc46-8783543a0ec4",
                                "text": "Il n’a pu verser la dernière mensualité de l’année à la compagnie d’assurances."
                            },
                            {
                                "example_id": "5ca46218-db79-4e25-bf98-4fe03443be83",
                                "sense_id": "1b7c12c5-42d9-336b-bc46-8783543a0ec4",
                                "text": "Cet outil fait ressortir le principe du crédit amortissable : les échéances remboursées sont constantes, mais les parts respectives de capital remboursé et d’intérêts dans chaque mensualité identique varient chaque mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "715c4f93-f596-37dd-a8da-ebd50b683102",
                        "entry_id": "3e7a05ff-dc67-369c-a993-73067ffd2d32",
                        "glosses": [
                            "Partie de son traitement annuel qu’un fonctionnaire, un employé reçoit chaque mois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e579d6a-1b98-4916-ab7f-890f4569b637",
                                "sense_id": "715c4f93-f596-37dd-a8da-ebd50b683102",
                                "text": "Toucher sa mensualité."
                            }
                        ]
                    }
