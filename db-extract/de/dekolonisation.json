                "senses": [
                    {
                        "sense_id": "3f2cb9e0-8e05-3f45-b468-1859dfb6d982",
                        "entry_id": "3af77494-b198-38b6-8f54-dea727a4f7d2",
                        "glosses": [
                            "Entlassung, Lossagung einer Kolonie von wirtschaftlicher, politischer, kultureller etc. Abhängigkeit, Einflussnahme der Kolonialmacht, die Abhängigkeit der Kolonie aufheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba73288-b7ee-4f11-8877-d8fd8c2d6852",
                                "sense_id": "3f2cb9e0-8e05-3f45-b468-1859dfb6d982",
                                "text": "„Kolonisation wie Dekolonisation hat es immer schon gegeben, es sind permanente Vorgänge der Weltgeschichte.“"
                            },
                            {
                                "example_id": "9f9fa85f-18e5-4bea-a1da-73ad24a96d84",
                                "sense_id": "3f2cb9e0-8e05-3f45-b468-1859dfb6d982",
                                "text": "„In wenigen Jahrzehnten hatten sich die Kolonialreiche im Zuge der sogenannten Dekolonisation fast vollständig aufgelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
