            {
                "entry_id": "2eee8949-0d48-395b-bc8c-f47b6cd90a05",
                "word": "succulence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d0eab7d-49b0-40ab-97cf-c208f3bd7356",
                        "entry_id": "2eee8949-0d48-395b-bc8c-f47b6cd90a05",
