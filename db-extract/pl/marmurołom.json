                "senses": [
                    {
                        "sense_id": "2927b6e9-e430-3e4d-90cf-5a0921e9ecff",
                        "entry_id": "634d5335-e679-342d-ad19-d774c503bed2",
                        "glosses": [
                            "kopalnia, w której wydobywa się marmur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63cd903-65a2-4985-a379-3c24dc4104f5",
                                "sense_id": "2927b6e9-e430-3e4d-90cf-5a0921e9ecff",
                                "text": "Biuro przedstawiło projekt techniczny marmurołomu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eef67e1-1bc5-4719-ae21-42996ca9d3e9",
                        "source_entry_id": "634d5335-e679-342d-ad19-d774c503bed2",
                        "source_sense_id": "2927b6e9-e430-3e4d-90cf-5a0921e9ecff",
                        "target_lang_word": "marble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74b71f7e-91b2-3080-a4eb-6d6ddb6f310a",
                                        "entry_id": "ecef8f38-cf84-337f-9500-24914139a8bf",
                                        "glosses": [
                                            "A metamorphic rock of crystalline limestone."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c807a8d0-1669-4861-8aac-774b2e88f262",
                                                "sense_id": "74b71f7e-91b2-3080-a4eb-6d6ddb6f310a",
                                                "text": "Open thy marble jaws, O tomb / And hide me, earth, in thy dark womb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baffe698-cf14-30c8-8f00-ef877fc041ee",
                                        "entry_id": "ecef8f38-cf84-337f-9500-24914139a8bf",
                                        "glosses": [
                                            "A small ball used in games, originally of marble but now usually of glass or ceramic."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1036c2b9-27f1-3c29-98b0-2c6afc67f422",
                                        "entry_id": "ecef8f38-cf84-337f-9500-24914139a8bf",
                                        "glosses": [
                                            "Statues made from marble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f182c849-fd82-4031-a17b-42bdf3489ffa",
                                                "sense_id": "1036c2b9-27f1-3c29-98b0-2c6afc67f422",
                                                "text": "The Elgin Marbles were originally part of the temple of the Parthenon."
                                            },
                                            {
                                                "example_id": "f88d5471-e1d8-45b8-971b-fe9094ff47d5",
                                                "sense_id": "1036c2b9-27f1-3c29-98b0-2c6afc67f422",
                                                "text": "[I]t was a portrait of the Library, though not strictly correct as to its contents, since all the best of the marbles displayed in various parts of the house were brought into the painting by the artist, who made it up into a picturesque composition according to his own taste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4a1d71-851f-3b1a-b830-8ef773dac1ed",
                                        "entry_id": "ecef8f38-cf84-337f-9500-24914139a8bf",
                                        "glosses": [
                                            "The marbling in meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a5ccb5-a91d-457d-a44c-e212c94a3b46",
                                                "sense_id": "be4a1d71-851f-3b1a-b830-8ef773dac1ed",
                                                "text": "The marble is graded using the Australian system."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3041c056-9710-36ba-bee4-fbef52d862b3",
                                        "entry_id": "7eb70980-1a41-34d3-9761-b3ee3bf6fb5a",
                                        "glosses": [
                                            "To cause (something to have) the streaked or swirled appearance of certain types of marble, for example by mixing viscous ingredients incompletely, or by applying paint or other colorants unevenly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ad20aa-4f48-4cfa-a664-e3ebe269e8b2",
                                                "sense_id": "3041c056-9710-36ba-bee4-fbef52d862b3",
                                                "text": "The small clouds which chequered the sky, as they passed along, spread their flitting shadows on the distant mountains, and seemed to marble them; a beauty which I do not recollect has struck any painter."
                                            },
                                            {
                                                "example_id": "a0800a2d-c0fc-4790-877c-b5b087f4b5e5",
                                                "sense_id": "3041c056-9710-36ba-bee4-fbef52d862b3",
                                                "text": "In the operation of marbling the edges of the books, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641e1463-7f7b-3ffc-98e8-331fcae19068",
                                        "entry_id": "7eb70980-1a41-34d3-9761-b3ee3bf6fb5a",
                                        "glosses": [
                                            "To get or have the streaked or swirled appearance of certain types of marble, for example due to the incomplete mixing of viscous ingredients, or the uneven application of paint or other colorants."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df01e05d-f1a3-41aa-9a00-28a3636f4475",
                                                "sense_id": "641e1463-7f7b-3ffc-98e8-331fcae19068",
                                                "text": "Scent the entire batch and then color half with the blue colorant. Pour both parts back into your soap pot. Do not stir. Pour in a circular motion into a block mold. The pouring action will cause the soap to marble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6573f41d-6a5e-3ff9-bcb7-eed33b59814f",
                                        "entry_id": "7eb70980-1a41-34d3-9761-b3ee3bf6fb5a",
                                        "glosses": [
                                            "To cause meat, usually beef, pork, or lamb, to be interlaced with fat so that its appearance resembles that of marble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ad5d80-bc78-4743-a680-86add855e957",
                                                "sense_id": "6573f41d-6a5e-3ff9-bcb7-eed33b59814f",
                                                "text": "Their flesh is soft (tender), and they throw a portion of their fat among the lean so as to marble it. The beef is of a better quality and they take on fat much easier."
                                            },
                                            {
                                                "example_id": "ba2d8e7e-3c8f-4f31-95fc-6ade08c8efaf",
                                                "sense_id": "6573f41d-6a5e-3ff9-bcb7-eed33b59814f",
                                                "text": "The Merino sheep is likely to put his weight largely into tallow around the stomach, intestines and on his kidneys, instead of mixing fairly with the meat, instead of marbling the meat."
                                            },
                                            {
                                                "example_id": "cf08e479-66e8-4fe7-8261-4784a3b79b42",
                                                "sense_id": "6573f41d-6a5e-3ff9-bcb7-eed33b59814f",
                                                "text": "Either by forcing the lardoon out with a plunger, by pushing it with a knife point, or by trailing it behind the needle, the cook artificially marbles the meat. For French cooks intent on larding, traditionally, the choice fat was the lard gras (pork fat)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                                        "entry_id": "7eb70980-1a41-34d3-9761-b3ee3bf6fb5a",
                                        "glosses": [
                                            "To become interlaced with fat; (of fat) to interlace through meat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e35af74d-adf2-4c19-b5b4-28e9bd520e73",
                                                "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                                                "text": "We've gone mostly to black bulls — Angus bulls because today the packers like black cattle. They seem to marble better."
                                            },
                                            {
                                                "example_id": "9e2eb456-1adf-46fc-a154-5cba6e735ae0",
                                                "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                                                "text": "As we feed these cattle corn their meat marbles. By marbling, I mean the red meat cells are surrounded with fat"
                                            },
                                            {
                                                "example_id": "48b74b8e-768a-4af5-b825-56be069d15de",
                                                "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                                                "text": "... claims probably stem from people having eaten beef from older, thinner animals which had rarely had enough excess energy in their diet to cause the meat to marble."
                                            },
                                            {
                                                "example_id": "d4f39a0d-f664-421d-831a-3dae2270df47",
                                                "sense_id": "fbbd6c60-39fc-3a25-aeb5-44bce1048bff",
                                                "text": "The exercising of the cattle causes the fat to marble right through the animal — and much of the flavour is found in the fat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94839d57-a16f-3594-9cb1-fabb0b3ef202",
                                        "entry_id": "7eb70980-1a41-34d3-9761-b3ee3bf6fb5a",
                                        "glosses": [
                                            "To lace or be laced throughout."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045fb84a-4467-4f09-ac97-460ddca64e54",
                                                "sense_id": "94839d57-a16f-3594-9cb1-fabb0b3ef202",
                                                "text": "Was he the reason for the bitterness that seemed to marble her character?"
                                            },
                                            {
                                                "example_id": "ef88410a-759d-45fa-9f66-47878bc4b9ef",
                                                "sense_id": "94839d57-a16f-3594-9cb1-fabb0b3ef202",
                                                "text": "'Nobody who has been to war ever talks about it,' he says. But then he does talk, and generously, mining his memory and following the vein of a life marbled with experience: 'I mean, I am in my nineties; […]'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10fd9830-cd5e-355c-9d4e-5cbb630c446f",
                                        "entry_id": "da92656c-76a8-3868-8999-00ec25f2bb9f",
                                        "glosses": [
                                            "Made of, or resembling, marble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac541ef-4d23-47f9-8dd8-58e9f2e2c2d5",
                                                "sense_id": "10fd9830-cd5e-355c-9d4e-5cbb630c446f",
                                                "text": "a marble mantel"
                                            },
                                            {
                                                "example_id": "86e12f29-50b8-4ee3-b172-24cfbfcb02d8",
                                                "sense_id": "10fd9830-cd5e-355c-9d4e-5cbb630c446f",
                                                "text": "marble paper"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e2ba295-00c7-3460-957a-78a3ffe0127e",
                                        "entry_id": "da92656c-76a8-3868-8999-00ec25f2bb9f",
                                        "glosses": [
                                            "Cold; hard; unfeeling."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d6e4088-ea88-448c-bbdb-cd6647440375",
                                                "sense_id": "6e2ba295-00c7-3460-957a-78a3ffe0127e",
                                                "text": "a marble heart"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5a766c3-6b13-4770-945d-1cdf9b69a068",
                        "source_entry_id": "634d5335-e679-342d-ad19-d774c503bed2",
                        "source_sense_id": "2927b6e9-e430-3e4d-90cf-5a0921e9ecff",
                        "target_lang_word": "quarry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                        "entry_id": "3527c95f-e556-326e-b266-9af69d727bb9",
                                        "glosses": [
                                            "A site for mining stone, such as limestone, or slate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abab18b1-b9cb-493a-b17e-9a48e6c9c778",
                                                "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                                "text": "Michelangelo personally quarried marble from the world-famous quarry at Carrara."
                                            },
                                            {
                                                "example_id": "5ee27f9b-7a92-4667-bb5b-d4800b025b12",
                                                "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                                "text": "Yet theſe are the men cry'd out againſt for ſchiſmaticks and ſectaries; as if, while the Temple of the Lord was building, ſome cutting, ſome ſquaring the marble, others hewing the cedars, there ſhould be a ſort of irrationall men who could not conſider there muſt be many ſchiſms and many diſſections made in the quarry and the timber, ere the houſe of God can be built."
                                            },
                                            {
                                                "example_id": "e969e64a-043e-4a1e-9b2b-6085f771b731",
                                                "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                                "text": "There have been found certain Cements under Earth, that are very ſoft, and yet taken forth into the Sun, harden as hard as Marble: There are alſo ordinary Quarries in Sommerſet-shire, which in the Quarry cut ſoft to any bigneſs, and in the Building prove firm, and hard."
                                            },
                                            {
                                                "example_id": "affd048f-aeea-4e9a-879d-0943b30b3420",
                                                "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                                "text": "There was a good quarry of limestone on the farm […]"
                                            },
                                            {
                                                "example_id": "47d910a8-2dd7-4448-8cf6-ef811d0759ab",
                                                "sense_id": "c5772d2a-51d4-36e0-b196-ec5f1d335591",
                                                "text": "This is itself a cheerless spot, particularly on a rainy day, when, overshadowed by the great massif of rock that towers in the background, and surrounded by the grey and cheerless quarries, it has a depressing character much in contrast with the green verdure encountered on the northern end of this interesting branch line."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a784dfd3-c472-3fdf-bca9-63308e4bae77",
                                        "entry_id": "e6de84f2-2f18-3851-b63f-f97809de64ae",
                                        "glosses": [
                                            "To obtain (or mine) stone by extraction from a quarry."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c19eb3d-a6f5-42bd-ba64-29845dfc14a8",
                                                "sense_id": "a784dfd3-c472-3fdf-bca9-63308e4bae77",
                                                "text": "The incloſing of this country might alſo be effected, were the landlord to quarry the ſtones, and build the walls at his expence, and the tenant to carry the materials, and pay intereſt for the money advanced by the landlord."
                                            },
                                            {
                                                "example_id": "2204fb34-28d9-4441-b994-5a28a37f4394",
                                                "sense_id": "a784dfd3-c472-3fdf-bca9-63308e4bae77",
                                                "text": "The stone of which this town and church was built, is somewhat of the nature of \"rotten limestone,\"—is quite light in color,—quarries out regularly and easily,—is soft, when first quarried, but becomes hard on exposure to the air."
                                            },
                                            {
                                                "example_id": "d6367415-4a08-4932-960c-4471bc2a1c3e",
                                                "sense_id": "a784dfd3-c472-3fdf-bca9-63308e4bae77",
                                                "text": "In Lexington, which was just then establishing itself as the principal town in Kentucky, he found work quarrying stone for a tavern keeper. Once again, the wages were low, and his employer \"strove by every means in his power to take advantage of me.\""
                                            },
                                            {
                                                "example_id": "79da331a-d747-49b5-bbc4-2315ee7b03ec",
                                                "sense_id": "a784dfd3-c472-3fdf-bca9-63308e4bae77",
                                                "text": "Today the extractive industry utilizes sand and gravel reserves and quarries stone in Wingdale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4785d5f2-7f08-3192-9bc7-58b30dc774f5",
                                        "entry_id": "e6de84f2-2f18-3851-b63f-f97809de64ae",
                                        "glosses": [
                                            "To extract or slowly obtain by long, tedious searching."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d01a7e4d-d5f6-432a-ac56-44ca732c1b68",
                                                "sense_id": "4785d5f2-7f08-3192-9bc7-58b30dc774f5",
                                                "text": "They quarried out new, interesting facts about ancient Egypt from old papyri."
                                            },
                                            {
                                                "example_id": "6ded8a2d-b904-4323-95e6-b28537723a03",
                                                "sense_id": "4785d5f2-7f08-3192-9bc7-58b30dc774f5",
                                                "text": "The second part of Aristotle's work requires little description. […] It has been largely quarried by the grammarians and lexicographers of later ages, from whom modern students of Athenian antiquities have derived their information; […]"
                                            },
                                            {
                                                "example_id": "09c68c56-d0ab-41f7-9dbb-67361fd390ca",
                                                "sense_id": "4785d5f2-7f08-3192-9bc7-58b30dc774f5",
                                                "text": "They will be guided and inspired by such utterance as Parrington's diagnosis of Sinclair Lewis, where he quarries out a vein of his own enduring liberalism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deef9fae-e543-3f17-87a5-e8477b2afa92",
                                        "entry_id": "1860410f-6a07-37b3-9ce5-153e3d990e1f",
                                        "glosses": [
                                            "A part of the entrails of a hunted animal, given to the hounds as a reward."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ed46e1-35f3-4939-9ca7-b00ce78de1d3",
                                                "sense_id": "deef9fae-e543-3f17-87a5-e8477b2afa92",
                                                "text": "Quarry, among hunters, is ſometimes uſed for part of the viſcera of the beaſt taken; given by way of reward to the hounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c9e661-20e2-3366-a5ed-8935242e9cd9",
                                        "entry_id": "1860410f-6a07-37b3-9ce5-153e3d990e1f",
                                        "glosses": [
                                            "An animal, often a bird or mammal, which is hunted."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed6157a-b7a7-43b6-bf9d-21c37b229b4c",
                                                "sense_id": "78c9e661-20e2-3366-a5ed-8935242e9cd9",
                                                "text": "Is it not our very Caſe now, that when our Souls, Good-Names, Bodies and Fortunes are at Stake, we muſt be running out at Check, after every Crow, Buzzard, or Jack-daw that comes in the way, and leave the main Chance at laſt at Six and Seven? Nay, and here's this more in't too, that the Quarry would not be worth the taking up neither, if we could Catch it; beſide, that it flies away ſtill before us, and is never to be Overtaken."
                                            },
                                            {
                                                "example_id": "31f6511f-0429-43d5-b044-f9e9c6b286ad",
                                                "sense_id": "78c9e661-20e2-3366-a5ed-8935242e9cd9",
                                                "text": "Nofi Raranta, 37, the town's main clove dealer, is also the top hunter, employing about a hundred men who comb the surrounding forests for quarry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d18d1b5a-3caa-31ca-932c-99679b3caa00",
                                        "entry_id": "1860410f-6a07-37b3-9ce5-153e3d990e1f",
                                        "glosses": [
                                            "An object of search or pursuit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da055ed9-3e31-430a-b4ee-e2280303fcce",
                                                "sense_id": "d18d1b5a-3caa-31ca-932c-99679b3caa00",
                                                "text": "In a verſe, when a worde of three ſillables cannot thruſt in but ſidelings, to joynt him even, we are oftentimes faine to borrowe ſome leſſer quarry of elocution from the Latine, alwaies retaining this for a principle, that a leake of indeſinence , as a leake in a ſhip, muſt needly be ſtopt with what matter ſoever."
                                            },
                                            {
                                                "example_id": "60933fe2-012c-4b2d-84e9-f7ad1f673476",
                                                "sense_id": "d18d1b5a-3caa-31ca-932c-99679b3caa00",
                                                "text": "Meanwhile his Ladie, which this outrage ſaw, / Whileſt they together for the quarrey ſtroue, / Into the couert did her ſelfe withdrw, / And cloſely hid her ſelfe within the groue."
                                            },
                                            {
                                                "example_id": "4144da84-5517-4dd9-aee7-3fb0c0512b79",
                                                "sense_id": "d18d1b5a-3caa-31ca-932c-99679b3caa00",
                                                "text": "A US State Department website advertised a reward of up to $1m (£500,000) for the capture of its quarry [Abdul Hadi al Iraqi], who was described as 5ft 11in (180cm) tall, with a pale complexion, \"a moustache and a long, heavy beard that is starting to grey\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78568b16-56f8-3b6a-90a2-0d6eb6972e1f",
                                        "entry_id": "d6f0fc49-e2a5-3d89-bda4-587b373d7bac",
                                        "glosses": [
                                            "To secure prey; to prey, as a vulture or harpy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c660b8b7-a883-4615-876a-e23f7c7abd31",
                                                "sense_id": "78568b16-56f8-3b6a-90a2-0d6eb6972e1f",
                                                "text": "What's an Eternal Circulation of the ſame Things, as well as the ſame Steps, without Advancing one Inch of Ground towards his Journey's End, but Ixion in the Wheel? And all this while, with Cares, and Horrors at his Heart, like the Vultur that's Day and Night Quarrying upon Prometheus's Liver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c967b4e2-b6e3-3081-b6a3-c13b549e6eea",
                                        "entry_id": "655689b9-f44c-3362-be66-c719be65af11",
                                        "glosses": [
                                            "A diamond-shaped tile or pane, often of glass or stone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec66d20f-5038-4a38-93e6-420b6cd6eb76",
                                                "sense_id": "c967b4e2-b6e3-3081-b6a3-c13b549e6eea",
                                                "text": "The boyes playing at ſtooleball, by chaunce broke a quarry of the glaſſe, whereupon he complayned to the Towneſhip, and either had, or did his utmoſt to haue the poor boy whipt, […]"
                                            },
                                            {
                                                "example_id": "49bf5f30-2e77-404d-991e-261233c0a4f5",
                                                "sense_id": "c967b4e2-b6e3-3081-b6a3-c13b549e6eea",
                                                "text": "A window towards the eaſt (whoſe fractured quarries proclaimed the ravages of time) admitted a dim, ſhadowy light, over the whole manſion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
