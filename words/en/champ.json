                },
                {
                    "sense_id": "53bf6e97-495a-354b-88ec-fd27aed807a5",
                    "sense_definition": "A traditional Irish dish made of mashed potatoes mixed with chopped scallions, butter, and milk.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother always serves roast beef with a large bowl of <w>champ</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда подает ростбиф с большой миской <w>чампа</w>.",
                                "zh": "我祖母总是用一大碗<w>香葱土豆泥</w>来搭配烤牛肉。",
                                "es": "Mi abuela siempre sirve rosbif con un gran tazón de <w>champ</w>."
                            }
                        },
                        {
                            "text": "The restaurant offers traditional <w>champ</w> as a side dish.",
                            "target_lang_translations": {
                                "ru": "Ресторан предлагает традиционный <w>чамп</w> в качестве гарнира.",
                                "zh": "这家餐厅提供传统的<w>香葱土豆泥</w>作为配菜。",
                                "es": "El restaurante ofrece <w>champ</w> tradicional como guarnición."
                            }
                        }
                    ],
                    "synonyms": [
                        "poundies"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Irish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционное ирландское блюдо из картофельного пюре с нарезанным зеленым луком, маслом и молоком.",
                        "zh": "一种传统的爱尔兰菜肴，由土豆泥混合葱花、黄油和牛奶制成。",
                        "es": "Plato tradicional irlandés hecho de puré de patatas mezclado con cebolleta picada, mantequilla y leche."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чамп",
                                "target_lang_sense_clarification": "ирландское блюдо"
