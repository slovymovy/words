                "senses": [
                    {
                        "sense_id": "cefbaf27-27a2-323c-b024-4d1682839fd4",
                        "entry_id": "46ded90c-9b3b-3d15-b769-683a27c4dd10",
                        "glosses": [
                            "To outdo or surpass (someone) in military skill or leadership."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0a873970-9c47-4766-b896-24e829bd25db",
                                "sense_id": "cefbaf27-27a2-323c-b024-4d1682839fd4",
                                "text": "In general, our Generals were out generalled on Long Island, and Sullivan and Stirling with 1000 Men were made Prisoners, in Consequence of which, and several other unfortunate Circumstances, a Council of War thought it prudent to retreat from that Island, and Governors Island and then from New York."
                            },
                            {
                                "example_id": "151b2c81-07b9-44b2-9ca8-a6dfb2fa9737",
                                "sense_id": "cefbaf27-27a2-323c-b024-4d1682839fd4",
                                "text": "The door closed after him, and his nephew felt that he had been completely outgeneraled. He now saw, what he had only suspected before, that his uncle wished him to marry Constance."
                            },
                            {
                                "example_id": "fc406a3a-d8d7-45bf-adca-981911ffc7dc",
                                "sense_id": "cefbaf27-27a2-323c-b024-4d1682839fd4",
                                "text": "With far fewer troops at his disposal, Frederick had out-generaled and out-manoeuvred the flower of Austro-French chivalry – and out-strategized it too [...]."
                            }
                        ]
                    }
                ],
