                    {
                        "translation_id": "73033877-d9e9-4565-93a7-496f0bd31dc6",
                        "source_entry_id": "17fcdeef-611f-3b1d-b0a4-e73cdbba2807",
                        "source_sense_id": "d2baf506-4120-3cf9-88ad-3dedee151462",
                        "source_sense_description": "primary circuit board of a computer",
                        "target_lang_word": "ма́ма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ма́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9d4d03-317e-3eb9-ae68-42a5d148affe",
                                        "entry_id": "e249b9e5-1f47-3ee6-be17-afbbbf4ba4c5",
                                        "glosses": [
                                            "разг. в семейном общении и в разговоре детей о родной матери — то же, что мать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ccacdb-3290-40f3-aeab-9c513329b0cf",
                                                "sense_id": "6c9d4d03-317e-3eb9-ae68-42a5d148affe",
                                                "text": "У нас в доме уже несколько дней как приготовлялись справлять день рождения мамы."
                                            },
                                            {
                                                "example_id": "6191317d-c0e0-48c1-970b-88db2c26c146",
                                                "sense_id": "6c9d4d03-317e-3eb9-ae68-42a5d148affe",
                                                "text": "Мама думает, что я была у Лилии, а Лилина мама думает, что Лиля была у меня."
                                            },
                                            {
                                                "example_id": "4419b05f-ab96-4632-b64a-9a6da605b00a",
                                                "sense_id": "6c9d4d03-317e-3eb9-ae68-42a5d148affe",
                                                "text": "Как всегда передавай привет Ане, маме и папе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd91799a-fb1c-3019-96b6-5cedec86dec3",
                                        "entry_id": "e249b9e5-1f47-3ee6-be17-afbbbf4ba4c5",
                                        "glosses": [
                                            "ласк. тёща или свекровь (обычно в семейном обращении)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58db3f5-8c42-4106-8114-ab398ada8e95",
                                                "sense_id": "bd91799a-fb1c-3019-96b6-5cedec86dec3",
                                                "text": "— Мам… — обращалась она [Людка] к Ирине. Ирину коробила простонародная манера называть свекровь мамой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "442db7a8-ca5b-3d28-bcc7-d48a30583b78",
                                        "entry_id": "e249b9e5-1f47-3ee6-be17-afbbbf4ba4c5",
                                        "glosses": [
                                            "устар. кормилица, нянька"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe4d3ab-00b5-4d1f-be03-3ddaef997cd7",
                                                "sense_id": "442db7a8-ca5b-3d28-bcc7-d48a30583b78",
                                                "text": "Пусть же все добрые люди увидят, что мама и что мать родная."
                                            },
                                            {
                                                "example_id": "6d52dd21-6ac1-4f24-a2aa-3ba9eaf14c59",
                                                "sense_id": "442db7a8-ca5b-3d28-bcc7-d48a30583b78",
                                                "text": "Я жила в Яссах на конце города; закутавшись, видала иногда свою дочь в прогулках с мамою, но никогда не смела показать своё лицо ни ей, ни слугам княжеским, потому что Мариорица и тогда была в меня вся вылита."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61acc9f-d8f7-3391-a07a-8439acfa88b9",
                                        "entry_id": "e249b9e5-1f47-3ee6-be17-afbbbf4ba4c5",
                                        "glosses": [
                                            "техн. жарг. часть разъёма с гнёздами"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9aa9836-ab1e-3ab0-93ec-8f37f279d67b",
                                        "entry_id": "e249b9e5-1f47-3ee6-be17-afbbbf4ba4c5",
                                        "glosses": [
                                            "комп. жарг. то же, что материнская плата"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
