                "senses": [
                    {
                        "sense_id": "24a384bc-7850-329c-a059-9137e0bb6bca",
                        "entry_id": "441cdb37-14d4-3ab6-a387-769459d7870e",
                        "glosses": [
                            "In a direction from which the wind blows, against or towards the wind."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4a1de3de-138f-4882-9067-d68fa10de2c9",
                                "sense_id": "24a384bc-7850-329c-a059-9137e0bb6bca",
                                "text": "We beat our way windward."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "378eb3cb-02df-4508-8f02-f89e53f77432",
                        "source_entry_id": "441cdb37-14d4-3ab6-a387-769459d7870e",
