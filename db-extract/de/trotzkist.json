                    {
                        "translation_id": "b1165de1-c057-434e-b048-f4ab322ec3ef",
                        "source_entry_id": "1b10fe1d-c07a-374d-8ef7-443709e1451c",
                        "source_sense_id": "e5961874-7434-3b61-94a1-d2e70c4cb35c",
                        "source_sense_description": "Anhänger des Trotzkismus",
                        "target_lang_word": "Trotskyite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                        "entry_id": "abbbe8ac-1e85-3d76-8f48-4df91da18b83",
                                        "glosses": [
                                            "An advocate of the communist doctrines of Leon Trotsky (born Лев Дави́дович Бронште́йн (Lev Davídovič Bronštéjn) / Lev Davidovich Bronstein)."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a790af-3884-48a7-a0c6-c94e1caed0d7",
                                                "sense_id": "c3e2b437-921d-3851-8ede-acab670bf609",
                                                "text": "A great number of disillusioned young men in the Western world are saying now that it is Stalin who is to blame and proclaiming themselves Trotskyites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trotskyite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                        "entry_id": "99f055d2-40b0-3708-b699-fe3a5bbf0618",
                                        "glosses": [
                                            "Of, relating to, supporting, or advocating the doctrines of Leon Trotsky."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08604fe-e9d3-4a7b-8bd8-d61e61b51399",
                                                "sense_id": "0b53fd30-793d-35ff-8423-1d3026b17389",
                                                "text": "[…] [her] father had fought in the Lincoln Brigade but now provided janitorial supplies to factories by day and attended Trotskyite meetings by night […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7db8f609-4904-4d9c-8c79-c3a3959eace4",
                        "source_entry_id": "1b10fe1d-c07a-374d-8ef7-443709e1451c",
                        "source_sense_id": "e5961874-7434-3b61-94a1-d2e70c4cb35c",
                        "source_sense_description": "Anhänger des Trotzkismus",
                        "target_lang_word": "trotskiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trotskiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "023c69e0-066d-3b0c-8cf7-45e9a4719e23",
                                        "entry_id": "5ef65e06-27e1-33fc-a97a-3b10e0072de5",
                                        "glosses": [
                                            "Relatif à Léon Trotski."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1abbcba5-8397-4fd6-b9db-8a27bfcda562",
                                                "sense_id": "023c69e0-066d-3b0c-8cf7-45e9a4719e23",
                                                "text": "Staline a battu l’opposition de gauche, trotskiste, en lui reprochant de vouloir révoquer la NEP et imposer une industrialisation trop coûteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f623b0-7503-3638-b1e5-380b78376d83",
                                        "entry_id": "5ef65e06-27e1-33fc-a97a-3b10e0072de5",
                                        "glosses": [
                                            "Relatif au trotskisme."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trotskiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f2327f9-5ecf-3367-a1dc-b28b18a03dbd",
                                        "entry_id": "3a58de00-0c0f-370e-87a1-a68e97165cc2",
                                        "glosses": [
                                            "Partisan de Léon Trotski ou du trotskisme."
                                        ],
                                        "tags": [
                                            "Communisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c61c937-7ea5-4e00-b2e5-4b112cc8606f",
                                                "sense_id": "5f2327f9-5ecf-3367-a1dc-b28b18a03dbd",
                                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
