                "senses": [
                    {
                        "sense_id": "7cc2aaae-8770-3d1d-8e33-456b4b487718",
                        "entry_id": "c989dee3-6449-353b-8776-c7690d55fce0",
                        "glosses": [
                            "Gesetz, das den rechtlichen Umgang mit Schwarzarbeit regelt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "59fcf655-dd04-4270-aae3-418c6d341ea8",
                                "sense_id": "7cc2aaae-8770-3d1d-8e33-456b4b487718",
                                "text": "„Die Richter entschieden damals, dass Schwarzarbeiter zumindest einen Anspruch auf Ersatz des Wertes ihrer Arbeit haben. Vor dem Hintergrund des Schwarzarbeitergesetzes aus dem Jahr 2004 änderte der BGH seine Ansicht jetzt.“"
                            },
                            {
                                "example_id": "5a911eac-5eae-47b6-af30-cde22ac512ff",
                                "sense_id": "7cc2aaae-8770-3d1d-8e33-456b4b487718",
                                "text": "„Er sitzt in Untersuchungshaft und wird sich wegen verschiedener Delikte verantworten müssen, darunter gewerbsmäßiger Betrug, Anstiftung zum Leistungsbetrug und Beihilfe zum Verstoß gegen das Schwarzarbeitergesetz.“"
                            },
                            {
                                "example_id": "c5006ad2-bebd-45ee-84c0-7d17d97d8970",
                                "sense_id": "7cc2aaae-8770-3d1d-8e33-456b4b487718",
                                "text": "„Der Werkvertrag sei nichtig, da er gegen das Schwarzarbeitergesetz verstoße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
