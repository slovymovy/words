                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ffd1485-2231-4aca-ba65-27307a5a0e99",
                                                "sense_id": "19f1a9da-8470-3c6d-a5ff-34af6e891762",
                                                "text": "The file is writable only for users in the admin group."
                                            },
                                            {
                                                "example_id": "15d9edb2-5c5c-4ea6-b221-4fb99cb82a6f",
                                                "sense_id": "19f1a9da-8470-3c6d-a5ff-34af6e891762",
                                                "text": "I burned my family's vacation photos onto a writable CD."
                                            },
                                            {
                                                "example_id": "64eee5b8-784d-4097-805d-b77dd8dc3b58",
                                                "sense_id": "19f1a9da-8470-3c6d-a5ff-34af6e891762",
                                                "text": "The following code snippet shows how to check whether a writable database already exists, and if not, create an editable copy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "927fc149-4105-366e-a42e-db480d1c7972",
                                        "entry_id": "3d338d6d-0670-3342-ae78-1e6e0d67b4c6",
                                        "glosses": [
