                ],
                "senses": [
                    {
                        "sense_id": "f99720bd-4d85-3419-9068-dc08ff66bb06",
                        "entry_id": "5e1721b5-3412-346c-9b4e-404c22615314",
                        "glosses": [
                            "miłośnik kotów, człowiek lubiący koty lub mający wiele kotów"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "230c5812-8014-4f70-93c6-dc4b71dbe857",
                                "sense_id": "f99720bd-4d85-3419-9068-dc08ff66bb06",
                                "text": "Jestem kociarzem. Mam 13-letnią śliczną kotkę, którą bardzo lubię, a której muszę służyć bezinteresownie, i w dzień i w nocy, bo nieraz budzi mnie w nocy z jakimś życzeniem. Wiem, że ona jest do mnie przywiązana na swój koci sposób"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
