                                "example_id": "70b27380-754d-49b5-92a6-15f5a00a8953",
                                "sense_id": "91ae4b67-709a-310c-8a21-751e7f69acd8",
                                "text": "Il ne fait pas d’erreur de com : il fait comme les gonzes d’extrême droite genre Le Pen : dire une horreur et la faire démentir et exégétiser par ses godillots."
                            },
                            {
                                "example_id": "2fe73fb0-7461-4d21-bf91-4bd5eb6cfc6c",
                                "sense_id": "91ae4b67-709a-310c-8a21-751e7f69acd8",
                                "text": "La puissance insensée des clichés et des lieux communs à exégétiser."
                            },
                            {
                                "example_id": "ae05fe26-f968-457f-be7b-0771925e7a9d",
                                "sense_id": "91ae4b67-709a-310c-8a21-751e7f69acd8",
                                "text": "Moi aussi, je suis obligé d’exégétiser mon propre verbiage."
                            }
                        ]
