                    }
                ],
                "senses": [
                    {
                        "sense_id": "effadfb7-7e26-346a-a336-5b35ccc48ab2",
                        "entry_id": "e499355a-7a43-3cf7-8a20-87beee8b4f0c",
                        "glosses": [
                            "auf einer Mauer von romanischen, griechischen und russisch-orthodoxen Kirchen konstruierter Gebäudeteil, in dem die Glocken untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7d8359f-afa0-4739-897e-bf5941b8f821",
                        "source_entry_id": "e499355a-7a43-3cf7-8a20-87beee8b4f0c",
                        "source_sense_id": "effadfb7-7e26-346a-a336-5b35ccc48ab2",
                        "source_sense_description": "auf einer Mauer von Kirchen konstruierter Gebäudeteil, in dem die Glocken untergebracht sind",
                        "target_lang_word": "Glockenwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glockenwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f623f8d5-30e7-3e11-bfba-7408de299996",
                                        "entry_id": "06837b05-b23e-37ac-b3c5-dee7423118c0",
                                        "glosses": [
                                            "derjenige sehr ursprünglich geformte Gebäudeteil romanischer Kirchen und Kapellen, der die Glocken aufnimmt und nicht als Turm volumenmäßig, sondern nur flächig als Mauerwerk ausgeführt ist (Fachbegriff: das Kodonostasion)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9057525-f294-44f8-95dc-51a64065687c",
                                                "sense_id": "f623f8d5-30e7-3e11-bfba-7408de299996",
                                                "text": "„Glockenwand […] wird ein freistehender oder auf der östlichen oder westlichen Kirchenmauer stehender wandartiger Bau genannt, der so viele – meist mit Bögen überwölbte – Öffnungen hat wie Glocken vorgesehen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8aadeb0-a751-3523-ab3d-b0dd1764ce7a",
                                        "entry_id": "06837b05-b23e-37ac-b3c5-dee7423118c0",
                                        "glosses": [
                                            "freistehende Wand, die die Kirchenglocken aufnimmt, häufig in der griechisch- und der russisch-orthodoxen Kirche zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7dcb96-398f-4422-b3fc-a2ac6af5b378",
                                                "sense_id": "e8aadeb0-a751-3523-ab3d-b0dd1764ce7a",
                                                "text": "Eine Besonderheit des russisch- orthodoxen Kultes stellt die freistehende, oder auch als Bauteil hochstehend eingefügt, die Glockenwand dar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ea026da-93e8-4f3d-9a4d-95f0a839e6a3",
                        "source_entry_id": "e499355a-7a43-3cf7-8a20-87beee8b4f0c",
                        "source_sense_id": "effadfb7-7e26-346a-a336-5b35ccc48ab2",
                        "source_sense_description": "auf einer Mauer von Kirchen konstruierter Gebäudeteil, in dem die Glocken untergebracht sind",
                        "target_lang_word": "Glockenmauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glockenmauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6b0977-7fde-3bb8-925b-dfa71929b3e9",
                                        "entry_id": "a005c9f3-9b17-3e39-b2e7-c749c7abaed6",
                                        "glosses": [
                                            "derjenige sehr ursprünglich geformte Gebäudeteil romanischer Kirchen und Kapellen, der die Glocken aufnimmt und nicht als Turm volumenmäßig, sondern nur flächig als Mauerwerk ausgeführt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4255bd-6f6b-48fe-a975-e791321b2d39",
                                                "sense_id": "ac6b0977-7fde-3bb8-925b-dfa71929b3e9",
                                                "text": "\"Der Stil ist eindeutig neoromanisch. Glockenmauer an der Fassade, ein Kreuzgratgewölbe, Rundbogenfenster, Kreuzwegstationen in Mosaik von Robert Scherer sind im Kirchhof zu finden.\""
                                            },
                                            {
                                                "example_id": "7a2daa8b-d20a-4fa3-a33c-dff7e0121d61",
                                                "sense_id": "ac6b0977-7fde-3bb8-925b-dfa71929b3e9",
                                                "text": "\"Die zweistöckige Glockenmauer hat drei Bögen.\""
                                            },
                                            {
                                                "example_id": "95d58769-34e2-4be8-b475-2abd9abc1e96",
                                                "sense_id": "ac6b0977-7fde-3bb8-925b-dfa71929b3e9",
                                                "text": "\"Unten befindet sich das ursprüngliche Beinhaus, oben ein Kultraum, im Westen schließt das Gebäude mit einer Glockenmauer ab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3361e80d-0cb5-4dc5-80af-71dc1d8c8fca",
                        "source_entry_id": "e499355a-7a43-3cf7-8a20-87beee8b4f0c",
                        "source_sense_id": "effadfb7-7e26-346a-a336-5b35ccc48ab2",
                        "source_sense_description": "auf einer Mauer von Kirchen konstruierter Gebäudeteil, in dem die Glocken untergebracht sind",
                        "target_lang_word": "Kodonostasion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kodonostasion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abcf3d72-4fd5-34d0-ab90-2fc2298b5533",
                                        "entry_id": "dc9eaeaf-a10c-30c0-84a9-b8bdd2cae0e0",
                                        "glosses": [
                                            "freistehender oder auf der östlichen oder westlichen Kirchenmauer stehender häufig mit einem Satteldach versehener wandartiger Bau, der so viele – meist mit Bögen überwölbte – Öffnungen hat, wie Glocken für diesen Bauteil vorgesehen sind; beispielsweise an romanischen, aber auch griechischen und russisch-orthodoxen Kirchenbauten"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d7eae9b-33b3-4dc4-a9b7-3ca5922c1c37",
                                                "sense_id": "abcf3d72-4fd5-34d0-ab90-2fc2298b5533",
                                                "text": "„[…] Glockenwand (Kodonostasion, russ. Zvonnica) wird ein freistehender oder auf der östlichen oder westlichen Kirchenmauer stehender wandartiger Bau genannt, der so viele – meist mit Bögen überwölbte – Öffnungen hat wie Glocken vorgesehen sind. […]“"
                                            },
                                            {
                                                "example_id": "ca4324ee-1a82-44ec-ac47-684f5db3f539",
                                                "sense_id": "abcf3d72-4fd5-34d0-ab90-2fc2298b5533",
                                                "text": "„[…] Bei kleinen Kirchen gab es freistehende ‚offene‘ Glockentürme, die auch im Bereich der orthodoxen Kirche weit verbreitet sind. Kennzeichnender noch sind die sogenannten Kodonostasien (russ. звонница), bei denen in die Öffnung(en) der Wand je eine Glocke eingehängt ist. […]“"
                                            },
                                            {
                                                "example_id": "3feb2e21-a991-44a3-b9bf-feb7118525a8",
                                                "sense_id": "abcf3d72-4fd5-34d0-ab90-2fc2298b5533",
                                                "text": "„Die Glocken der Skiti Kavsokalyvia im Kodonostasion (Glockenturm) an der Kirche Aghia Triada. Der Name ‚Skiti‘ leitet sich mit Sicherheit von den uralten, ebenfalls sogenannten Ansiedlungen von Mönchen in Ägypten her.“"
                                            },
                                            {
                                                "example_id": "787c132a-f67a-4403-ab18-817f1f9120e0",
