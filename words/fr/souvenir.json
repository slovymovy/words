{
    "word_family": [
        "ressouvenir",
        "souvenance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39d41629-fd4c-350f-bee1-9e994cdf0200",
                    "sense_definition": "Se rappeler une chose passée, garder ou faire revenir dans son esprit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>souviens</w> parfaitement de mon premier voyage en train."
                        },
                        {
                            "text": "Est-ce que tu te <w>souviens</w> de ce que le professeur nous a demandé ?"
                        }
                    ],
                    "synonyms": [
                        "rappeler"
                    ],
                    "common_phrases": [
                        "se souvenir de",
                        "se souvenir parfaitement",
                        "ne plus se souvenir"
                    ]
                },
                {
                    "sense_id": "cd179b79-3efe-3145-af5e-6e4db7efb97c",
                    "sense_definition": "Conserver le ressentiment d'un affront ou d'un tort, souvent en vue d'une vengeance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ressentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu m'as trahi et je m'en <w>souviendrai</w> le moment venu."
                        },
                        {
                            "text": "Il lui a dit qu'il se <w>souviendrait</w> de cette humiliation publique."
                        }
                    ],
                    "common_phrases": [
                        "s'en souvenir longtemps"
                    ]
                },
                {
                    "sense_id": "e50d05ed-f0a7-345b-86b5-9c3141025c65",
                    "sense_definition": "Ne pas oublier une promesse, une consigne ou une affaire dont on doit prendre soin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur s'est <w>souvenu</w> de votre demande lors de la réunion de ce matin."
                        },
                        {
                            "text": "J'espère que vous vous <w>souviendrez</w> de notre accord avant de signer le contrat."
                        }
                    ],
                    "common_phrases": [
                        "se souvenir d'une promesse"
                    ]
                },
                {
                    "sense_id": "296b1fce-2407-3112-8f86-ec834023a6d7",
                    "sense_definition": "Revenir à l'esprit, à la mémoire, dans une tournure impersonnelle.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il lui <w>souvint</w> brusquement qu'il avait oublié d'éteindre les lumières du salon."
                        },
                        {
                            "text": "C'était, s'il m'en <w>souvient</w>, au cours d'un été particulièrement chaud."
                        }
                    ],
                    "common_phrases": [
                        "qu'il m'en souvienne"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Tournure impersonnelle littéraire"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c742a74a-1de3-3430-afcb-5477d19b2b1e",
                    "sense_definition": "Image, idée ou sentiment du passé qui demeure ou revient dans la mémoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce voyage à la montagne m'a laissé un très beau <w>souvenir</w>."
                        },
                        {
                            "text": "Ils aiment regarder de vieilles photos pour évoquer leurs <w>souvenirs</w> d'enfance."
                        }
                    ],
                    "synonyms": [
                        "souvenance"
                    ],
                    "common_phrases": [
                        "garder un souvenir",
                        "évoquer des souvenirs"
                    ]
                },
                {
                    "sense_id": "bb23e628-06a0-3059-b30f-7ce59d5a6753",
                    "sense_definition": "Objet acheté ou reçu que l'on conserve pour se rappeler un lieu, une personne ou un événement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une petite tour Eiffel en <w>souvenir</w> de ses vacances à Paris."
                        },
                        {
                            "text": "Les touristes se pressent dans cette boutique pour trouver un joli <w>souvenir</w>."
                        }
                    ],
                    "common_phrases": [
                        "boutique de souvenirs",
                        "rapporter un souvenir"
                    ]
                },
                {
                    "sense_id": "ff21739f-ba0f-3f1c-9638-8d854df51c31",
                    "sense_definition": "Présent donné pour témoigner son affection ou en guise d'adieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue m'a offert un stylo en <w>souvenir</w> de notre collaboration."
                        },
                        {
                            "text": "Elle a accepté cette bague comme un précieux <w>souvenir</w> d'amitié."
                        }
                    ],
                    "common_phrases": [
                        "en souvenir de",
                        "cadeau souvenir"
                    ]
                },
                {
                    "sense_id": "2bac5627-78d4-38e0-a33b-3b518b4c8cd6",
                    "sense_definition": "Célébration ou hommage rendu à la mémoire d'une personne ou d'un événement marquant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commemoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une cérémonie a été organisée pour honorer le <w>souvenir</w> des combattants."
                        },
                        {
                            "text": "Le monument a été érigé afin de perpétuer le <w>souvenir</w> de cette victoire."
                        }
                    ],
                    "common_phrases": [
                        "perpétuer le souvenir"
                    ]
                },
                {
                    "sense_id": "7a3c6dce-cd72-3bf2-a18d-aeaafff7a91e",
                    "sense_definition": "Récit autobiographique ou recueil de mémoires personnelles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ecrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivain a consacré les dernières années de sa vie à rédiger ses <w>souvenirs</w>."
                        },
                        {
                            "text": "Ce livre de <w>souvenirs</w> décrit avec émotion la vie rurale au siècle dernier."
                        }
                    ],
                    "common_phrases": [
                        "publier ses souvenirs"
                    ]
                },
                {
                    "sense_id": "3e73cb25-9110-32b9-8c26-bf0e7c356507",
                    "sense_definition": "Faculté mentale de garder le passé en mémoire ; la mémoire elle-même.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet événement tragique restera gravé à jamais dans mon <w>souvenir</w>."
                        },
                        {
                            "text": "Avec les années, son visage s'est peu à peu effacé de mon <w>souvenir</w>."
                        }
                    ],
                    "synonyms": [
                        "remembrance"
                    ],
                    "common_phrases": [
                        "avoir le souvenir de"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens classique au singulier"
                        }
                    ]
                }
            ]
        },
