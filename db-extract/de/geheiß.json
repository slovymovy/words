                    {
                        "form_id": "7a1e15e3-739d-4dcc-99bf-6d339378cfa3",
                        "entry_id": "76bbc7e5-5f7e-39b6-aad4-3618960a5de9",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Geheiß"
                    },
                    {
                        "form_id": "20e406a5-2b50-4fd0-857c-3cf32d0c50ba",
                        "entry_id": "76bbc7e5-5f7e-39b6-aad4-3618960a5de9",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Geheiß"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                        "entry_id": "76bbc7e5-5f7e-39b6-aad4-3618960a5de9",
                        "glosses": [
                            "Gebot (meist von einer übergeordneten oder mit Macht ausgestatteten Person), Anordnung"
                        ],
                        "tags": [
                            "meist in der Wendung „auf Geheiß von jemandem“"
                        ],
                        "examples": [
                            {
                                "example_id": "f3d9af38-1633-4504-8c66-b9427df9ae73",
                                "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                                "text": "Auf Geheiß seines Vaters verließ Karl schon in jungen Jahren die Familie, um in der Fremde eine Lehrstelle anzutreten."
                            },
                            {
                                "example_id": "9ea51e83-3a42-4333-92dd-31f9a3ef0e39",
                                "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                                "text": "„Oder wirkt ein Gift, das ihm ein bestochener Mundschenk auf Geheiß von Basileios möglicherweise eingeflößt hat?“"
                            },
                            {
                                "example_id": "de87de0f-ca95-4f83-b322-eb8698a92711",
                                "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                                "text": "„Auf Goldlotos Geheiß wärmte Schlehenblüte den Wein an.“"
                            },
                            {
                                "example_id": "535e697e-50ca-4c16-ac6d-62be492ba9b4",
                                "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                                "text": "„Und wenn ihn das Geheiß seines Vaters, wie er meinte, oder richtiger zu sprechen, sein Traum zu dem weiten Zuge veranlaßt hatte, so scheint es ebenso gewiß, daß er diesem allmählich einen zweiten Endzweck dann unterschob, als er am Bayou mit der vermeintlichen Verlegenheit seiner Feinde näher bekannt wurde.“"
                            },
                            {
                                "example_id": "bd467a49-3aaf-4e6a-938a-01eddfb74549",
                                "sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                                "text": "„Akbar floh nach Persien, wo er wenige Jahre später starb. Sambhaji aber wurde auf Aurangzebs Geheiß grausam zu Tode gefoltert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e9c5932-d4ec-404c-a667-dc3dafa25198",
                        "source_entry_id": "76bbc7e5-5f7e-39b6-aad4-3618960a5de9",
                        "source_sense_id": "4845fb7e-4655-325b-8a3e-b5dab6d6e37e",
                        "target_lang_word": "behest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                        "entry_id": "aa3f81bd-6859-31f6-84cc-acac852a1d00",
                                        "glosses": [
                                            "A command, bidding; sometimes also, an authoritative request; now usually in the phrase at the behest of and at one's behest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a583882-e48e-4b8e-b978-17fc2a7055e1",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "Sophie felt she should sit on too though she knew it to be an irrational fantasy of hers that these little services were held at his behest."
                                            },
                                            {
                                                "example_id": "c0e92c7b-1753-437d-a015-19a781ce4f23",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "Moſt great and puiſant Monarke of the earth,\nYour Baſſoe wil accompliſh your beheſt: […]"
                                            },
                                            {
                                                "example_id": "d33ce080-a18d-4ad1-90bd-980555c01b1e",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "to do his master's high behest"
                                            },
                                            {
                                                "example_id": "722fadb8-dddf-46e4-8617-279d5ca33a2d",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "I have spells for the north, I have charms for the west, / And the south and the east must obey my behest."
                                            },
                                            {
                                                "example_id": "60e1fe22-186d-4738-83d6-fc51062af546",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "Paul did not dare pronounce, let matters rest, / His master having given him no behest."
                                            },
                                            {
                                                "example_id": "662f19f5-2285-4d7c-969c-28e2e55e5afe",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "The London Midland Region has announced receipt of authority from the Ministry of Transport to resume the reconstruction of Stafford station and layout, interrupted at the Minister's behest; contracts have now been placed for the erection of the new station buildings and the yardmaster's office."
                                            },
                                            {
                                                "example_id": "be2dca82-754c-4656-a07e-f97275225183",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "And young Mr. Fleetwood Vibe was here at the behest of his father, Wall Street eminence Scarsdale Vibe, who was effectively bankrolling the Expedition."
                                            },
                                            {
                                                "example_id": "de2f93e6-8a31-4556-8108-d57326089938",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "the House of Representatives will try to water down even this feeble effort at the behest of the unions whose members enjoy some of the most lavish policies."
                                            },
                                            {
                                                "example_id": "29b0a0b9-9317-4afb-99e9-2335355cc2fe",
                                                "sense_id": "07ad4c88-eab3-302a-82d5-72fde2ba0b30",
                                                "text": "The Manchester United manager, Sir Alex Ferguson, is to meet with the BBC director general, Mark Thompson, at the behest of the Premier League in a bid to resolve their long-running feud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd479cf-c9a8-38ef-a364-c50948a55998",
                                        "entry_id": "aa3f81bd-6859-31f6-84cc-acac852a1d00",
                                        "glosses": [
                                            "A vow; a promise."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09419505-b8d4-4464-a1ca-6195ff4880d2",
                                                "sense_id": "7dd479cf-c9a8-38ef-a364-c50948a55998",
                                                "text": "c. 1440, Markaryte Paston, letter to John Paston\nThe time is come that I should send it her, if I keep the behest that I have made."
                                            }
                                        ]
                                    }
                                ]
                            },
