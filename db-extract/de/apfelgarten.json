                        "examples": [
                            {
                                "example_id": "3b79bb74-ef93-4d30-aab2-a03e17b48a25",
                                "sense_id": "03422525-b58b-3715-a801-1b2eae6186cf",
                                "text": "„Schwester Edna machte einen langen Spaziergang durch den Apfelgarten auf dem Hügel.“"
                            },
                            {
                                "example_id": "2e2c4427-da4d-4a36-9e08-dd3cb150cfc1",
                                "sense_id": "03422525-b58b-3715-a801-1b2eae6186cf",
                                "text": "„Die Türme von Smolensk vor Augen, biwakierte das Bataillon im Apfelgarten eines verlassenen Gutshauses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
