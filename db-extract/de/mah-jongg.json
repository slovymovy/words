                                        "entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                                        "glosses": [
                                            "A game (originally Chinese) for four players, using a collection of tiles divided into five or six suits."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21ae1f3a-7d33-4124-a976-b26286e83a02",
                                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                                "text": "My usual mahjong kaki."
                                            },
                                            {
                                                "example_id": "0a98867f-d550-4c60-b7de-79cf20da84a3",
                                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                                "text": "While most of the country has spent the weekend counting hongbaos and mahjong tiles, those guys have been out there salvaging hongbaos and half of Thomson Road."
                                            },
                                            {
                                                "example_id": "73626a85-6022-46d9-8c98-295d3e25d083",
                                                "sense_id": "a5fe2d05-82bf-3636-902e-3a8c719b83db",
                                                "text": "Ho Sau-Mei, one of Hong Kong’s last mahjong tile carvers, is getting old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c2c313c-b856-36a7-843e-8d615a48829f",
                                        "entry_id": "b8904e64-59a0-3cf1-8039-92510ba3a1cd",
                                        "glosses": [
                                            "A solitaire game using the same tiles, where the player wins by removing pairs of matching exposed tiles until none remain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
