                        "glosses": [
                            "A damp consisting chiefly of carbon dioxide, so called for its ability to asphyxiate."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c9dfd5ea-e93a-415a-b02f-2f1f6509be5a",
                                "sense_id": "6523ae8d-a0c7-3f39-80ea-650288105d06",
                                "text": "\"Now, when you described the Wigan coal explosion last month, could you not have gone down and helped those people, in spite of the choke-damp?\" \"I did.\" \"You never said so.\" \"There was nothing worth bucking about.\" \"I didn't know.\" She looked at me with rather more interest."
                            }
                        ]
