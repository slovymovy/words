                        "glosses": [
                            "A type of cocky, working-class man in early twentieth-century Greece, associated with violent behaviour, alcohol and hashish, and celebrated in various folk songs."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ae10f74a-d385-4e2f-88cf-487ca77ad3b4",
                                "sense_id": "aa439bc5-dea8-3a0e-baaf-8817fef6f1fe",
                                "text": "Impoverished, disenfranchised, the mangas lived by petty crime and occasional labor."
                            },
                            {
                                "example_id": "0fb31b08-9711-4ca0-8a2b-9ba116abf006",
                                "sense_id": "aa439bc5-dea8-3a0e-baaf-8817fef6f1fe",
                                "text": "The mangas was expected to cock a snook at authority, to be quick with a knife and ruthless in avenging insult."
                            }
                        ]
                    }
