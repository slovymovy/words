                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5e501a57-b1ac-3c53-bdb1-5d427a3b0de3",
                        "entry_id": "175f1e7e-4dff-3119-bcc1-1902b227bfd9",
                        "glosses": [
                            "drzewo lub krzew wierzby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264ff975-66af-4510-87ad-54032232aa6f",
                                "sense_id": "5e501a57-b1ac-3c53-bdb1-5d427a3b0de3",
                                "text": "Oficer skoczył, ile tchu w koniu; hetman zaś posunął się dalej, gdzie pod wierzbiną na łące stała chorągiew laudańska, i zatrzymał się tuż przed nią."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "baa651ef-af5d-372a-bfa5-c78f2032f73b",
                        "entry_id": "175f1e7e-4dff-3119-bcc1-1902b227bfd9",
                        "glosses": [
                            "gałązki wierzbowe"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "5a0b984c-1c8b-36ff-a2f1-f88a32a403d0",
                        "entry_id": "175f1e7e-4dff-3119-bcc1-1902b227bfd9",
                        "glosses": [
                            "drewno wierzbowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8282ef18-5da8-4e5b-903b-4c00861bc55c",
                                "sense_id": "5a0b984c-1c8b-36ff-a2f1-f88a32a403d0",
                                "text": "Hej, fujarko ma z wierzbiny • Hej, fujarko ma wierzbowa"
                            },
                            {
                                "example_id": "1bc0d029-9f91-4a46-bc3c-cd6e6a2eecb8",
                                "sense_id": "5a0b984c-1c8b-36ff-a2f1-f88a32a403d0",
                                "text": "Dziękuję ci, mój braciszku, • Mój ty jedyny, • Żeś wykręcił fujareczkę • Dla mnie z wierzbiny."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac560159-584e-4db9-8eb9-528595d3b22b",
                        "source_entry_id": "175f1e7e-4dff-3119-bcc1-1902b227bfd9",
                        "source_sense_id": "5a0b984c-1c8b-36ff-a2f1-f88a32a403d0",
                        "target_lang_word": "Weidenholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weidenholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8674e8d-a0bc-3e2f-8735-6b5347370094",
                                        "entry_id": "076e9a49-efd4-3fa3-ad94-41497e101a0e",
                                        "glosses": [
                                            "Holzart des Laubbaumes Weide (Salix)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a74a54c-430f-4c0c-9bee-9a9c9f89aafc",
                                                "sense_id": "e8674e8d-a0bc-3e2f-8735-6b5347370094",
                                                "text": "„Er wusste nicht, ob Weidenholz am besten für einen Bogen geeignet war oder eine andere Art.“"
                                            },
                                            {
                                                "example_id": "7c2cbce6-79e6-4848-8a12-e67ace5d63d3",
                                                "sense_id": "e8674e8d-a0bc-3e2f-8735-6b5347370094",
                                                "text": "„Interessanterweise nutzten die jungsteinzeitlichen Jäger nicht immer nur eine Holzart für ihre Pfeile, sondern kombinierten in den Schäften auch härteres Olivenholz mit leichterem und flexiblerem Weiden- und Schilfholz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
