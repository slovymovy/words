                                "pl": "Tutaj <w>dawniej</w> był gęsty i ciemny las.",
                                "de": "Hier war <w>früher</w> ein dichter und dunkler Wald.",
                                "fr": "Il y avait <w>autrefois</w> une forêt dense et sombre ici.",
                                "it": "Qui <w>prima</w> c'era una foresta fitta e scura.",
                                "cs": "Zde <w>dříve</w> byl hustý a temný les.",
                                "tr": "Burada <w>eskiden</w> sık ve karanlık bir orman vardı.",
                                "es": "Aquí <w>antes</w> había un bosque espeso y oscuro."
                            }
                        },
                        {
                            "text": "Всё в доме осталось, как <w>прежде</w>.",
                            "target_lang_translations": {
                                "en": "Everything in the house remained as <w>before</w>.",
                                "zh": "屋里的一切都和<w>以前</w>一样。",
                                "nl": "Alles in huis bleef zoals <w>voorheen</w>.",
                                "pl": "Wszystko w domu zostało tak, jak <w>dawniej</w>.",
                                "de": "Alles im Haus ist geblieben wie <w>zuvor</w>.",
                                "fr": "Tout dans la maison est resté comme <w>auparavant</w>.",
                                "it": "Tutto in casa è rimasto come <w>prima</w>.",
                                "cs": "Vše v domě zůstalo jako <w>dříve</w>.",
                                "tr": "Evdeki her şey <w>eskisi</w> gibi kaldı.",
                                "es": "Todo en la casa permaneció como <w>antes</w>."
                            }
                        }
