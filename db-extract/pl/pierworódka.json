                                        "examples": [
                                            {
                                                "example_id": "3c2e4551-7fd5-4244-886c-983694d1e32a",
                                                "sense_id": "00167f9f-7822-3514-9e18-6eedcf2ad990",
                                                "text": "Nejvíce dětí se rodí ženám ve věku 29–32 let, typická prvorodička je osmadvacet až devětadvacet let stará."
                                            }
                                        ]
