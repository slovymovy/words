                        "cross_references": [
                            {
                                "target_word": "altsächsisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6492e891-567c-33d5-936e-6e95be36a6c0",
                                        "entry_id": "4c44ab8a-fc99-30fd-9ea1-4bcb55c58922",
                                        "glosses": [
                                            "sich auf das Altsächsische, die älteste Form der niederdeutschen Sprache, beziehend (in Gebrauch vom 9. bis Anfang des 12. Jahrhunderts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120c1453-ffa3-495b-bce1-4da375bec457",
                                                "sense_id": "6492e891-567c-33d5-936e-6e95be36a6c0",
                                                "text": "Die Adjektive ‚obersächsisch‘ und ‚altsächsisch‘ beziehen sich auf zwei Sprachformen, die inhaltlich nichts miteinander zu tun haben."
                                            },
                                            {
                                                "example_id": "b3c47eaa-16a7-4eb3-b59a-182afa46d63d",
                                                "sense_id": "6492e891-567c-33d5-936e-6e95be36a6c0",
                                                "text": "Es sind nur wenige altsächsische Texte überliefert worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dd1f4a3-e7db-32ac-a2b6-5391c6682360",
                                        "entry_id": "4c44ab8a-fc99-30fd-9ea1-4bcb55c58922",
                                        "glosses": [
                                            "sich auf den auch Altsachsen genannten spätantiken und frühmittelalterlichen Volksstamm der Sachsen beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ac68c5-f6dd-4acc-8cc2-40e9845770f0",
                                                "sense_id": "5dd1f4a3-e7db-32ac-a2b6-5391c6682360",
                                                "text": "Die altsächsischen Teilstämme hießen Westfalen, Engern, Ostfalen und Nordalbingier."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc53675a-1f68-329e-8d80-b88cc84fe55d",
                                        "entry_id": "4c44ab8a-fc99-30fd-9ea1-4bcb55c58922",
                                        "glosses": [
                                            "sich auf das z. T. ebenfalls Altsachsen genannte frühmittelalterliche Stammesherzogtum Sachsen beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d92f89a9-47bc-49d1-9964-100ccfb1761f",
                                                "sense_id": "dc53675a-1f68-329e-8d80-b88cc84fe55d",
                                                "text": "Der altsächsische Nordthüringgau lag zwischen unterer Bode, oberer Aller, Ohre und mittlerer Elbe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "216bc9d7-8832-331f-8f97-a5bc2cd095d8",
                                        "entry_id": "4c44ab8a-fc99-30fd-9ea1-4bcb55c58922",
                                        "glosses": [
                                            "sich auf den westsächsischen Dialekt des Altenglischen (Angelsächsischen) beziehend"
                                        ],
