    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "200e543f-7492-388b-a7c8-a7e585640bff",
                    "sense_definition": "Iets van iemand wegnemen of stelen, vaak op een onrechtmatige of stiekeme manier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief wist ongemerkt een kostbaar schilderij uit het museum te <w>ontwenden</w>.",
                            "target_lang_translations": {
                                "en": "The thief managed to unnoticedly <w>steal</w> a valuable painting from the museum."
                            }
                        },
                        {
                            "text": "Het is strafbaar om andermans eigendommen te <w>ontwenden</w> zonder toestemming.",
                            "target_lang_translations": {
                                "en": "It is a punishable offense to <w>appropriate</w> someone else's property without permission."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontvreemden",
                        "stelen",
                        "jatten",
                        "ontnemen"
                    ],
                    "antonyms": [
                        "teruggeven",
                        "schenken"
                    ],
                    "common_phrases": [
                        "goederen ontwenden",
                        "stiekem ontwenden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formele of juridische term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take or steal something from someone, often in an unlawful or sneaky manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pilfer",
                                "target_lang_sense_clarification": "to steal things of little value, often in a sneaky way"
                            },
                            {
                                "target_lang_word": "to purloin",
                                "target_lang_sense_clarification": "to steal, especially in a formal or literary context"
                            },
                            {
                                "target_lang_word": "to abstract",
                                "target_lang_sense_clarification": "to remove or take away, often euphemistically for stealing"
                            },
                            {
                                "target_lang_word": "to steal",
                                "target_lang_sense_clarification": "to take another person's property without permission"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b29e9d9-7643-3a43-bf17-2ee4a77c76ec",
                    "sense_definition": "Meervoud verleden tijd van <w>ontwennen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verleden_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen we vorig jaar stopten met roken, <w>ontwenden</w> we langzaam aan de dagelijkse gewoonte.",
                            "target_lang_translations": {
                                "en": "When we stopped smoking last year, we slowly <w>broke</w> the daily habit."
                            }
                        },
                        {
                            "text": "Zij <w>ontwenden</w> snel aan de luxe nadat ze naar het platteland verhuisden.",
                            "target_lang_translations": {
                                "en": "They quickly <w>got unused</w> to the luxury after they moved to the countryside."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural past tense of 'ontwennen' (to break a habit, to wean, or to get unused to)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "broke the habit of",
                                "target_lang_sense_clarification": "past tense plural, stopped being accustomed to something"
                            },
                            {
                                "target_lang_word": "got unused to",
                                "target_lang_sense_clarification": "past tense plural, lost the habit of"
                            },
                            {
                                "target_lang_word": "weaned off",
                                "target_lang_sense_clarification": "past tense plural, gradually stopped a habit or dependency"
                            }
                        ]
                    }
                }
            ]
        }
    ]
