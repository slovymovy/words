        "fr-extract.jsonl": [
            {
                "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                "word": "étrivière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee7d5ef7-4281-406b-b9f3-767902e4b757",
                        "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                        "tags": [
                            "plural"
                        ],
                        "form": "étrivières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27e2c4a8-4834-3e9d-a903-3b92d2706be8",
                        "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                        "glosses": [
                            "Sangle qui suspend l’étrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73b0dea7-175d-41b1-8621-8cf4dbdbc9d5",
                                "sense_id": "27e2c4a8-4834-3e9d-a903-3b92d2706be8",
                                "text": "Des courroies étaient adaptées à leurs selles, nous supposions qu’elles servaient à fixer le cavalier, et cependant si le cheval tombait, l’homme était à l’instant libre. Je me rappelle que ces décevantes et compliquées étrivières furent appelées, un moment, la question prussienne."
                            },
                            {
                                "example_id": "8428d49f-2eb7-4f4e-b560-14721eee19cd",
                                "sense_id": "27e2c4a8-4834-3e9d-a903-3b92d2706be8",
                                "text": "Les étriers, larges et pesants, sont attachés à des anneaux de fer au moyen d’étrivières très courtes en soie ou en lanières de cuir tressées."
                            }
                        ]
                    },
                    {
                        "sense_id": "55a3079b-d889-3982-b794-60b20fcd355e",
                        "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                        "glosses": [
                            "Coups qu’on donne avec cette sangle."
                        ],
                        "tags": [
                            "dated",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fce8514e-d33c-48cf-80c5-37d2bb1f492c",
                                "sense_id": "55a3079b-d889-3982-b794-60b20fcd355e",
                                "text": "Prenez garde ! dit son maître ; si vous accordez tant de licences à votre langue, on vous enverra à la loge du gardien, qui vous donnera les étrivières."
                            },
                            {
                                "example_id": "d84b91c5-7cb8-4900-a3e1-de828b818fd9",
                                "sense_id": "55a3079b-d889-3982-b794-60b20fcd355e",
                                "text": "Tous ces Anglais sont insolents […] Heureusement, Soult va leur donner les étrivières."
                            },
                            {
                                "example_id": "eba77053-79c2-41f8-a615-db863606666b",
                                "sense_id": "55a3079b-d889-3982-b794-60b20fcd355e",
                                "text": "Ce qui l’intéresse c’est, deux fois par semaine, d’aller se faire donner les étrivières, tantôt du côté de Courcelles, chez Plum, tantôt au fond d’une arrière boutique de la rue d’Orsel."
                            },
                            {
                                "example_id": "75f35121-3b06-45d6-97a3-d7e123d7d77b",
                                "sense_id": "55a3079b-d889-3982-b794-60b20fcd355e",
                                "text": "[…] Quelque choſe qu’on puiſſe faire,\nOn ne ſçauroit le reformer.\nCoups de fourche ny d’étrivieres\nNe luy font changer de manieres […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e24818-1a4d-3b2f-9d83-42ef0c5c265d",
                        "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                        "glosses": [
                            "Tout mauvais traitement qui humilie."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4c775d68-1a51-4623-b261-608e01c160d9",
                                "sense_id": "f3e24818-1a4d-3b2f-9d83-42ef0c5c265d",
                                "text": "Il s’est laissé donner les étrivières."
                            }
                        ]
                    },
                    {
                        "sense_id": "c624a639-2817-3f42-b852-357ef2df35f5",
                        "entry_id": "c5092296-55f9-3bf0-9d90-c220fc9e964b",
                        "glosses": [
                            "Tresses de cheveux."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "84a8b24d-ea63-4df8-8d52-6c64e9caf388",
                                "sense_id": "c624a639-2817-3f42-b852-357ef2df35f5",
                                "text": "Ma mère gémissait de me voir massacrer ces étrivières d’or châtain, qui me valaient, chaque matin, de me lever une demi-heure plus tôt que mes camarades d’école."
                            }
                        ]
                    }
                ],
