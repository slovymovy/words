                        "entry_id": "56474935-1cdc-30b5-8291-1cc096ace6e6",
                        "glosses": [
                            "To speak or to use words to express."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "39552b52-dfd1-40f7-8851-3de237a283d3",
                                "sense_id": "80851ba5-b376-3c90-868b-89a7ec4e97aa",
                                "text": "Bill became tongue-tied and could not verbalize his thoughts in the presence of the girl he had a crush on."
                            }
                        ]
                    },
                    {
                        "sense_id": "921a44dd-6852-30d3-a311-af0eb3d8e6f5",
