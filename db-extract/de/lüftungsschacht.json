                "senses": [
                    {
                        "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                        "entry_id": "718bf6ff-d362-3c03-8e24-1328250792ca",
                        "glosses": [
                            "selbst, dinglich, der Be- und Entlüftung dienender Schacht"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "6f0041fb-ad9b-4827-9042-ca75b0cc7311",
                                "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                                "text": "Über einen Lüftungsschacht wird die Schachtlüftung mit und ohne Ventilator realisiert."
                            },
                            {
                                "example_id": "ebcdef0c-00a7-462e-9b43-970d22199682",
                                "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                                "text": "„MEA Lüftungsschächte können an die erforderliche Höhe durch Aufeinandersetzen von bis zu 7 Schachtelementen angepasst werden“"
                            },
                            {
                                "example_id": "99814b0f-456d-4d1d-bc44-19328ce81250",
                                "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                                "text": "„Ein ausgebüxtes Kätzchen hat die Feuerwehr in Essen aus einer Badezimmerwand herausgemeißelt. \"Flöckchen\" war am Samstag zunächst zu einem Sonnenbad auf das Hausdach eines Mehrfamilienhauses geschlichen und dann auf der Flucht vor der herannahenden Feuerwehr in einen Lüftungsschacht geraten.“"
                            },
                            {
                                "example_id": "85d97b36-c1b3-411b-981c-81ebce2b5df5",
                                "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                                "text": "„Ein Arbeiter ist am Dienstagmorgen beim Sturz in einen tiefen Lüftungsschacht tödlich verletzt worden.“"
                            },
                            {
                                "example_id": "b7f1a6b3-b7cb-4cd5-814d-78aa0f3e638d",
                                "sense_id": "2a6d2dff-b494-368d-b61d-18b5f5afbcb2",
                                "text": "„Das eigentliche Heiligtum lag tief unter der Oberfläche, sodass Lüftungsschächte erforderlich waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
