                ],
                "senses": [
                    {
                        "sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "glosses": [
                            "принятие какого-либо закона или решение какого-либо особо важного вопроса в жизни государства всенародным голосованием, опросом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3badf23d-e539-4452-a9db-299d983664ff",
                                "sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                                "text": "Граждане проголосовали на референдуме за сохранение франкоязычной провинции Квебек в составе Канады."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "551faca3-c4c0-4c91-8aae-d3805ee2c330",
                        "source_entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "source_sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "target_lang_word": "referendum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "referendum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                        "entry_id": "4070f833-38b4-3e44-b8bf-7b42faad3810",
                                        "glosses": [
                                            "A direct popular vote on a proposed law or constitutional amendment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bcc566-cef3-496e-a491-d158cffa2b81",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "a referendum on …"
                                            },
                                            {
                                                "example_id": "d663936e-4f2d-4ac6-823f-2448e7d781be",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "In some cases, a referendum on the proposed bond issue must be held."
                                            },
                                            {
                                                "example_id": "54881714-0832-4699-9c8a-e932da37eedd",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "Article 74: The Republic of Karakalpakstan shall have the right to secede from the Republic of Uzbekistan on the basis of a nation-wide referendum held by the people of Karakalpakstan."
                                            },
                                            {
                                                "example_id": "673248b8-8ed8-42a6-9176-94b75f46d52a",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "Although the Cook Islands held a referendum in 1994, when voters rejected a name change, the yearning for a decolonised identity has not disappeared."
                                            },
                                            {
                                                "example_id": "4e4b3365-3194-4657-8b19-fa61722c48ec",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "[Salvador] Illa ascribed the nationalist surge in Catalonia that fuelled support for the 2017 referendum – and Brexit in the UK – as populist responses to the financial crisis of 2008."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7746282b-147a-3950-b8b5-29ac42d14d32",
                                        "entry_id": "4070f833-38b4-3e44-b8bf-7b42faad3810",
                                        "glosses": [
                                            "An action, choice, etc., which is perceived as passing judgment on another matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98fc076e-0924-4cb0-be4f-14cca2dc7de6",
                                                "sense_id": "7746282b-147a-3950-b8b5-29ac42d14d32",
                                                "text": "My father is taking my decision on whether to go to university as a referendum on his performance as a parent, and it's very stressful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64e8fda6-e38f-486d-b057-aa24018ee82c",
                        "source_entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "source_sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "target_lang_word": "plebiscite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plebiscite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "A direct popular vote on an issue of public importance, such as an amendment to the constitution, a change in the sovereignty of the nation, or some government policy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eacf62-ada4-48f0-939b-00ec74b12f30",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "A political result, we may also say aim, of the frumentarian plebiscite of Gaius was to disattach the city populace from its conservative moorings and to enlist it in the service of reform."
                                            },
                                            {
                                                "example_id": "b2bfb294-7101-4115-8434-6c3b06bda2ab",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "Then something changed, and Mr. Mitterrand said he thought it would be a good idea if the Constitution allowed plebiscites, on the recommendation of the President, on issues involving personal freedoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d83936-a608-380e-bbaf-9ed24d2dd9f6",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "An expression of the public's views on an issue, whether legally binding or not."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc92c3a5-b94c-38a2-99c6-af64d1bae287",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "Synonym of plebiscitum (“a law enacted by the common people, under the superintendence of a tribune or some subordinate plebeian magistrate, without the intervention of the senate”)."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a47c696a-2d0c-4e80-bc54-92cf9d76274e",
                        "source_entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "source_sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "target_lang_word": "Referendum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Referendum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc027f3e-f67f-341a-b55a-b1d7b850ef03",
                                        "entry_id": "196e2612-530f-3b4f-9b15-d7bcddccad41",
                                        "glosses": [
                                            "Abstimmung durch eine Volksabstimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2673f372-e59d-497f-a7c1-905c7324c40c",
                                                "sense_id": "cc027f3e-f67f-341a-b55a-b1d7b850ef03",
                                                "text": "„Präsident Charles de Gaulle lässt schließlich ein Referendum zu – mit eindeutigem Ergebnis: Mehr als 95 Prozent der wahlbeteiligten Algerier votieren für die Selbstbestimmung des Landes.“"
                                            },
                                            {
                                                "example_id": "58fd134f-8194-4c6b-81e2-a71c8e93b61d",
                                                "sense_id": "cc027f3e-f67f-341a-b55a-b1d7b850ef03",
                                                "text": "„Doch im Dezember 2015 ließ Kagame ein Referendum über eine Verfassungsänderung abhalten, die es ihm ermöglicht, über das Jahr 2017 hinaus im Amt zu bleiben.“"
                                            },
                                            {
                                                "example_id": "64f94bd2-9914-467e-972f-b6f2f6ea476a",
                                                "sense_id": "cc027f3e-f67f-341a-b55a-b1d7b850ef03",
                                                "text": "„Das italienische Verfassungsgericht hat einen Antrag auf ein Referendum zur Entkriminalisierung der Sterbehilfe abgelehnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                        "entry_id": "196e2612-530f-3b4f-9b15-d7bcddccad41",
                                        "glosses": [
                                            "Einspruch gegen ein vom Parlament (Bund, Kanton, Gemeinde) erlassenes Gesetz oder gegen gewisse sonstige parlamentarische Beschlüsse durch eine qualifizierte Anzahl Wahlberechtigter, über den mittels einer Volksabstimmung entschieden wird"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b47fa53-fca0-41f9-bd6d-e4446171b08e",
                                                "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                                "text": "„Bundesgesetze und andere Erlasse der Bundesversammlung unterstehen dem fakultativen Referendum nach Artikel 141 der Bundesverfassung. Die grosse Mehrheit dieser Erlasse treten in Kraft, ohne dass darüber vorher eine Volksabstimmung stattfindet. Die Stimmbürgerinnen und Stimmbürger, die eine Volksabstimmung wünschen, können jedoch das Referendum ergreifen..“"
                                            },
                                            {
                                                "example_id": "dfb723d0-c637-4a9c-9db2-23b5018b55bb",
                                                "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                                "text": "„Bürgerinnen und Bürger können eine Volksabstimmung über bestimmte Entscheide des Grossen Rats (zum Beispiel Gesetze oder Beschlüsse über neue einmalige Ausgaben von mehr als fünf Millionen Franken) verlangen. Damit ein Referendum zustande kommt, braucht es innert der Sammelfrist von neunzig Tagen nach der Publikation im Amtsblatt die Unterschrift von 3'000 Stimmberechtigten.“"
                                            },
                                            {
                                                "example_id": "cff6dd2d-1fce-450f-a7da-dd7e394504f3",
                                                "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                                "text": "„Mit einer Initiative kann der Erlass, die Änderung oder die Aufhebung von initiativfähigen Reglementen oder Beschlüssen verlangt werden, beispielsweise die Änderung der Gemeindeordnung. Eine Initiative ist vorgängig der Stadtkanzlei zur Vorprüfung einzureichen. Sie ist zustande gekommen, wenn innert sechs Monaten 5000 Stimmberechtigte das Initiativbegehren unterzeichnen. Initiativen werden den Stimmberechtigten zur Abstimmung unterbreitet, wenn sie einen Gegenstand aus ihrem Zuständigkeitsbereich betreffen oder wenn der Stadtrat sie ablehnt. Mit einem Referendum kann die Abstimmung über ein vom Stadtrat beschlossenes Reglement, über ausserordentliche Gemeindesteuern oder über neue Ausgaben von mehr als zwei bis sieben Millionen Franken verlangt werden. Das Referendumsbegehren ist innert 60 Tagen von 1500 Stimmberechtigten zu unterzeichnen und bei der Stadtkanzlei einzureichen.“"
                                            },
                                            {
                                                "example_id": "cb4d9cae-c12b-4968-bb77-0ee4bae85659",
                                                "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                                "text": "„Am 15. Mai wird über das Referendum gegen die EU-Verordnung der Grenzüberwachungs-Agentur Frontex abgestimmt.“"
                                            },
                                            {
                                                "example_id": "d093651a-6d88-40ce-a0e8-75025c52afa0",
                                                "sense_id": "581f266e-ca29-3a2e-a483-957d6c30e7e5",
                                                "text": "„Das Referendum gegen das Covid-19-Gesetz ist klar gescheitert – doch ein neues ist schon lanciert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52d478d-acf3-490a-84be-4084712f9799",
                        "source_entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "source_sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "target_lang_word": "Volksbefragung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volksbefragung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba600213-8f68-35ce-8174-bd91a487dcf5",
                                        "entry_id": "dc743665-4183-336b-9d38-3d670f4c1031",
                                        "glosses": [
                                            "nicht verbindliche Erhebung der Meinung der stimmberechtigten Wähler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2daf9020-9289-4583-9194-27959c2745bd",
                                                "sense_id": "ba600213-8f68-35ce-8174-bd91a487dcf5",
                                                "text": "„Im Zeitraum vom 4. November 1971 bis zum 18. Juni 1973 fungierte Leopold Gratz als Geschäftsführender Klubobmann des Klubs der Sozialistischen Abgeordneten und Bundesräte, bis er als Nachfolger des wegen einer nicht wunschgemäß ausgegangenen Volksbefragung über die Verbauung des Sternwarteparks zurückgetretenen Felix Slavik zum neuen Wiener Bürgermeister gewählt wurde.“"
                                            },
                                            {
                                                "example_id": "4d1ab642-aead-4351-802b-c2f64cd445c8",
                                                "sense_id": "ba600213-8f68-35ce-8174-bd91a487dcf5",
                                                "text": "„Die gegen massive Kritik von der Regierungsmehrheit durchgedrückten unverbindlichen Volksbefragungen verstoßen gegen die Bayerische Verfassung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff249fb-1022-4927-8420-6c022b43350c",
                        "source_entry_id": "dd819bdf-39d9-3ecf-9915-a091121b4c05",
                        "source_sense_id": "6b62c1cb-5f29-3ed5-ba20-a6a02c496075",
                        "target_lang_word": "Volksentscheid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volksentscheid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                        "entry_id": "4a853040-ed60-3a89-b32b-35e2efb9e619",
                                        "glosses": [
                                            "Entscheidung über einen Gesetzentwurf durch Abstimmung des Wahlvolks"
                                        ],
                                        "tags": [
                                            "Gesetzgebung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8e4566-f638-4ff1-ab2c-d5cb249e1bc3",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„Niedersachsen: … Im Volksentscheid muss ein Viertel der Wahlberechtigten, bei Verfassungsänderungen die Hälfte zustimmen.“"
                                            },
                                            {
                                                "example_id": "6c50df0a-ec42-463f-9aab-ee5bdb972e27",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„Der stillgelegte Berliner Flughafen Tempelhof bleibt eine grüne Wiese. Bei einem Volksentscheid stimmte eine Mehrheit der Bürger deutlich gegen eine Bebauung der Ränder des Flughafenareals.“"
                                            },
                                            {
                                                "example_id": "44b57fe6-ab3b-4d83-b163-8ae4e5958453",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„Klare Entscheidung in Berlin: Bei einem bundesweit bisher einzigartigen Volksentscheid votiert eine Mehrheit für die Enteignung großer Immobilienunternehmen.“"
                                            },
                                            {
                                                "example_id": "02d85116-07a6-45ac-bdc7-9ded7cfb678e",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "[Schweiz:] „Bei dem Volksentscheid sprachen sich 64,1 Prozent der Wahlberechtigten für die \"Ehe für alle\" aus, wie die Behörden des Landes mitteilten.“"
                                            },
                                            {
                                                "example_id": "71410684-0966-4992-83eb-850f3a722e6b",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„Begriffe wie Volksabstimmung, Volksentscheid, Volksinitiative suggerieren, dass das ganze Volk direkt abstimmt.“"
                                            },
                                            {
                                                "example_id": "06859f2a-8704-4ce6-ba3a-043d00e0e95c",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„Aber führen Volksentscheide ganz unabhängig von der Beteiligungsrate nicht zu mehr Zufriedenheit mit der Demokratie?“"
                                            },
                                            {
                                                "example_id": "713c4116-fbda-4ab1-a208-5955d6f330c2",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "„[…] es [ist] kein Zufall, dass die Grünen […] die Forderung nach einem bundesweiten Volksentscheid aus ihrem Grundsatzprogramm gestrichen und auch die SPD, die diese Forderung seit über 100 Jahren vertrat, diese fallengelassen hat.“"
                                            },
                                            {
                                                "example_id": "b9b4c8f4-2e2b-475b-9240-6a5844155d8c",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "[Baden-Württemberg:] „Das Bundesland im Südwesten Deutschlands ist das einzige Bundesland, das durch einen Volksentscheid entstand. 1952 fusionieren die Länder Württemberg-Baden, Baden und Württemberg-Hohenzollern.“"
                                            },
                                            {
                                                "example_id": "9ea84953-1f33-47ca-b4e8-ff47f384fd34",
                                                "sense_id": "2177b664-c1ed-3c84-aa61-4e65e6e85889",
                                                "text": "Wir kennen den Volksentscheid als obligatorischen Volksentscheid in Fällen der Änderung der Ländergrenzen, als fakultativen bei verfassungsändernden Gesetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
