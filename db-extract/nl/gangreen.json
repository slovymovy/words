        "nl-extract.jsonl": [
            {
                "entry_id": "e63bf972-7c0d-311b-850c-44b202897786",
                "word": "gangreen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "191ddb45-3a93-31f6-9222-bc4abbc32819",
                        "entry_id": "e63bf972-7c0d-311b-850c-44b202897786",
                        "glosses": [
                            "de afsterving en ontbinding van een levend organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7108d86c-d0a9-459b-beb8-3cdd974f2310",
                                "sense_id": "191ddb45-3a93-31f6-9222-bc4abbc32819",
                                "text": "Het vochtige gangreen had een rottingsstank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7035a4d-ef81-40fd-92ea-49f81e042977",
                        "source_entry_id": "e63bf972-7c0d-311b-850c-44b202897786",
                        "source_sense_id": "191ddb45-3a93-31f6-9222-bc4abbc32819",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "Gangrän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gangrän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77a612e7-c894-3512-ab79-63a2da0926b8",
                                        "entry_id": "b1515f8b-428a-357f-9978-e97846c1571d",
                                        "glosses": [
                                            "eine Gewebsnekrose, meist infolge von Blutunterversorgung, bei der das betroffene Gewebe durch Verwesung und Autolyse zerfällt und sich als Folge von Hämoglobinabbau verfärbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9460d9-9644-435d-b6b3-3f53d3dd0072",
                                                "sense_id": "77a612e7-c894-3512-ab79-63a2da0926b8",
                                                "text": "„Seit das Gangrän in seinem rechten Bein ausgebrochen war, hatte er keine Schmerzen mehr, und mit dem Schmerz war die Panik verschwunden, und jetzt empfand er nur noch eine große Müdigkeit und Wut darüber, dass es aus mit ihm war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1312c113-bf06-4f23-bb5f-eea317902d04",
                        "source_entry_id": "e63bf972-7c0d-311b-850c-44b202897786",
                        "source_sense_id": "191ddb45-3a93-31f6-9222-bc4abbc32819",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "gangrene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gangrene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "160a37f0-3408-30f4-acde-0ced1bdf4f64",
                                        "entry_id": "cf59500d-0e04-3a68-830c-e6e3fd448f21",
                                        "glosses": [
                                            "The necrosis and rotting of flesh, usually caused by lack of blood supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90c2e84-0226-4ca3-b12d-106376ae9f67",
                                                "sense_id": "160a37f0-3408-30f4-acde-0ced1bdf4f64",
                                                "text": "If gangrene sets in, we may have to amputate the foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf22b52-42f9-34a8-9fd3-5bb5a764f36b",
                                        "entry_id": "cf59500d-0e04-3a68-830c-e6e3fd448f21",
                                        "glosses": [
                                            "A damaging or corrupting influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045bd68b-e00e-46ac-899d-e74b03dc1fa2",
                                                "sense_id": "8cf22b52-42f9-34a8-9fd3-5bb5a764f36b",
                                                "text": "Women should earn equal wages with men for equal work done. Child marriages and polygamy are a gangrene on society."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gangrene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To produce gangrene in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4784e1d-4a62-432a-b0d3-539bdfe18a28",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "Vulneration or section sometimes procures a Gangrene, when the vital Principle is so debilitated, or enormous by the would, that instead of a good suppuration and vigorous transmutation, a depraved matter is generated, which corrupts and gangrenes the part: and thus a small cut of a finger or Toe hath gangrened, and killed the person: but in greater Wounds, the danger is greater, as more frequently to happen."
                                            },
                                            {
                                                "example_id": "3f3ec4aa-c8a4-49b0-b8b9-7d0897fdd43b",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "An intensely biting frost will gangrene the membrane ; a foggy state of the atmosphere, with low, black, stagnant exhalations, accompanied with sudden, frequent intermissions, interchanges, and oscillations of dryness and moisture, expansion and condensation, will corrupt and putrify both the membrane and the mucous discharge."
                                            },
                                            {
                                                "example_id": "812a7eaa-b181-4f13-8cde-ab3617209586",
                                                "sense_id": "bad9b5ba-0943-32bb-a67b-1dc9a6232294",
                                                "text": "For where it chances to be successful, it is like the copper shot of the Mexicans, which gangrenes the wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To be affected with gangrene."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f97ea5-9c11-4fc1-a757-c36179b8cc2d",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "If a man had a sore leg, and he should go to an honest, judicious chirurgeon, and he should only bid him keep it warm, and anoint it with such an oil, (an oil well known) that would do the cure; haply he would not much regard him, because he knows the medicine, beforehand an ordinary medicine; but if he should go to a surgeon that should tell him, your leg will gangrene within three days, and it must be cut off, and you will die, unless you do something that I could tell you, what listening there would be to this man?"
                                            },
                                            {
                                                "example_id": "2ed63a8c-1377-4f56-b0cb-a9fd6c3aa83f",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "The leg will gangrene if the superficial femoral vessels be torn."
                                            },
                                            {
                                                "example_id": "ef502132-a507-457c-afce-9605283470b8",
                                                "sense_id": "9a141f28-626c-3380-ab23-84dbbf2a5e07",
                                                "text": "If not, the toe will gangrene and fall off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                        "entry_id": "463ee025-bf0f-371b-9bd7-2eaeff53290c",
                                        "glosses": [
                                            "To corrupt; To cause to become degenerate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075cfc29-e8f7-401f-b087-0495cb0ca63e",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "That is true,” replied Almira, “nothing can be performed without labor, and where there is labor there will be discontent, and where there is no labor there will be heart-burning and jealousy about insignificant trifles, such as gangrenes the real pleasures of contemplation within these walls; walls, which would otherwise hold out an asylum, much to be prized by those who have been unfortunate, who have lost all their friends, or who are weary of the world.\""
                                            },
                                            {
                                                "example_id": "a89d4fb2-6f4c-40fc-b9ca-594600498620",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "The Stuart Restoration period was a necessary sequence of the Puritan period, and there is a similar cause for the sensualism that gangrenes the heart of our morbidly prudish Society of to-day."
                                            },
                                            {
                                                "example_id": "717a07a5-d082-4ab1-8c34-0d8e4b5cb003",
                                                "sense_id": "d38a0015-ed22-3e17-add0-973d5fe8af1c",
                                                "text": "The same delusion will gangrene England within the lifetime of most men of military age unless she will realize that gold is dross ; that her poets, her artists, and her scholars are her very soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86a1e92-15e1-492b-8af0-17247d24859a",
                        "source_entry_id": "e63bf972-7c0d-311b-850c-44b202897786",
                        "source_sense_id": "191ddb45-3a93-31f6-9222-bc4abbc32819",
                        "source_sense_description": "de afsterving en ontbinding van een levend organisme",
                        "target_lang_word": "gangrène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gangrène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "785d5041-5499-3872-b413-c1081d7d0cca",
                                        "entry_id": "3c695d80-52cb-3ac9-bd8f-d01d9458ca69",
                                        "glosses": [
                                            "Mortification locale des tissus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01c9171-5139-4a44-af2a-c3da26c22a5b",
                                                "sense_id": "785d5041-5499-3872-b413-c1081d7d0cca",
                                                "text": "Gangrène gazeuse ou foudroyante, Complication de certaines plaies, surtout des plaies de guerre, consécutive à une infection par — essentiellement — Clostridium perfringens, caractérisée par la mortification des tissus et la production de gaz, dont la marche est rapide et aboutit souvent à la mort."
                                            },
                                            {
                                                "example_id": "ed7c9e41-c121-4fe4-a7f4-537a4e37c292",
                                                "sense_id": "785d5041-5499-3872-b413-c1081d7d0cca",
                                                "text": "Il est très possible que cette compression violente ait causé la gangrène et que la patiente en soit morte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6fc1e6e-8d63-39f3-8d4a-8c4f1921241d",
                                        "entry_id": "3c695d80-52cb-3ac9-bd8f-d01d9458ca69",
                                        "glosses": [
                                            "Mal émanant des doctrines pernicieuses, de la corruption des mœurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2db30cd-4666-4be6-8b86-4a4a046ae1e3",
                                                "sense_id": "b6fc1e6e-8d63-39f3-8d4a-8c4f1921241d",
                                                "text": "Pour lui, il n’était de joli départ pour les frontières qu’après avoir nettoyé le pays de la gangrène réactionnaire qui rongeait les forces vives de la nation."
                                            },
                                            {
                                                "example_id": "70bef3db-e121-499e-9985-702f9c886ec4",
                                                "sense_id": "b6fc1e6e-8d63-39f3-8d4a-8c4f1921241d",
                                                "text": "Le goût immodéré des Réunionnais pour leurs sacro-saintes bagnoles, et l’insuffisance criante et structurelle du réseau routier – essentiellement dû à la topographie de ce caillou en forme de cône planté au milieu de l’océan – étant les principales causes de cette gangrène."
                                            }
                                        ]
                                    }
                                ]
                            },
