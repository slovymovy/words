                                        "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                        "entry_id": "0b4a90a9-94d0-36b2-aa92-cb0efd757050",
                                        "glosses": [
                                            "Mitglied einer religiösen islamischen Ordensgemeinschaft, zu dessen Riten Musik und rhythmische Tänze gehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4397731-b994-4bcf-9b80-f5a38324ea7d",
                                                "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                                "text": "Zahlreiche Derwische legen das Armutsgelübde ab und leben in mönchisch zurückgezogener Askese."
                                            },
                                            {
                                                "example_id": "2dc3010b-1b9e-452b-b5c0-d8da639521c9",
                                                "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                                "text": "„Die drehenden Derwische sind besonders in der Türkei zu einer touristischen Attraktion geworden, der Heimat des Mevlevi-Ordens aus Konya.“"
                                            },
                                            {
                                                "example_id": "29fa027e-c187-4bee-8533-71daca686d2e",
                                                "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                                "text": "„Ich wählte den zweiten Weg und kam in ein Gewölbe, wo ich an einem von vier Lämpchen erhellten Grabstein aus weißem Marmor einen alten Derwisch erblickte, der Gebete murmelte.“"
                                            },
                                            {
                                                "example_id": "79f7003b-13bd-4a4f-8e00-754d47677785",
                                                "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                                "text": "„Um Derwischgeschichten zu erzählen, sollte man erst mal Derwische verstehen, und um sie zu verstehen, müsse man nach Kairo, wo heutzutage die stärksten Derwische seien.“"
                                            },
                                            {
                                                "example_id": "5d300731-85c9-4559-ae76-7f8f93d55d56",
                                                "sense_id": "36a34060-37dd-3be8-9396-c00b495deccf",
                                                "text": "„Till, rotverbrannt, sommersprossig, tanzte und redete wie ein Derwisch, er reizte sein Publikum bis zum Lachschmerz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
