            "senses": [
                {
                    "sense_id": "cc13a839-bf78-38c7-bd28-dafd9b61f991",
                    "sense_definition": "het plaatsvinden van een voorval of situatie; werkelijkheid worden",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "voorvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet niet precies wat er gisterenavond is <w>gebeurd</w>.",
                            "target_lang_translations": {
                                "en": "I don't know exactly what <w>happened</w> last night.",
                                "ru": "Я не знаю точно, что <w>произошло</w> вчера вечером."
                            }
                        },
                        {
                            "text": "Zoiets mag nooit meer <w>gebeuren</w> in de toekomst.",
                            "target_lang_translations": {
                                "en": "Something like that must never <w>happen</w> again in the future.",
                                "ru": "Подобное никогда больше не должно <w>случиться</w> в будущем."
                            }
                        }
                    ],
                    "synonyms": [
                        "geschieden",
                        "spelen",
                        "plaatsvinden",
                        "voorvallen"
                    ],
                    "common_phrases": [
                        "wat is er gebeurd",
                        "zou nooit gebeuren",
                        "staan te gebeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "the occurrence of an event or situation; to become reality",
                        "ru": "происхождение события или ситуации; становление реальностью"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to take place or occur"
                            },
