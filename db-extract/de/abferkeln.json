                "senses": [
                    {
                        "sense_id": "37575b09-cb00-301e-b80d-d1e2b0dc3096",
                        "entry_id": "5156fe1a-1344-34a9-94c9-05e4269513d4",
                        "glosses": [
                            "die Ferkel gebären"
                        ],
                        "tags": [
                            "von der Sau"
                        ],
                        "examples": [
                            {
                                "example_id": "206e8a22-1d4d-4638-99df-86ed1ebea0ac",
                                "sense_id": "37575b09-cb00-301e-b80d-d1e2b0dc3096",
                                "text": "„Damit die Sau im Liegebereich ihr Nest baut und darin abferkelt, muss dieser trocken und eingestreut und mit geschlossenen Wänden umgeben sein.“"
                            },
                            {
                                "example_id": "2766e90e-a47e-4ec4-ae27-ea8b3e464b0e",
                                "sense_id": "37575b09-cb00-301e-b80d-d1e2b0dc3096",
                                "text": "„Dadurch kann es passieren, daß eine Sau mitten in der Gruppe der tragenden Sauen oder gemeinsam mit einer anderen Sau im selben Nest abferkelt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
