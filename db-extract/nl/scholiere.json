                        "examples": [
                            {
                                "example_id": "a1246fb8-e8c7-40ae-8178-4fd267d0cdfe",
                                "sense_id": "9522f8b0-3ab0-3116-b288-102002e5716e",
                                "text": "Advocate Fleur Zijderveld vroeg vrijspraak voor haar cliënt. Het OM heeft volgens haar geen bewijs dat Angelo S. daadwerkelijk betrokken is geweest bij de dood van de scholiere uit Bunschoten."
                            },
                            {
                                "example_id": "235e5d9c-d0d4-4ff0-8e3b-72812031dc7d",
                                "sense_id": "9522f8b0-3ab0-3116-b288-102002e5716e",
                                "text": "Tessa Schror uit Westervoort is geslaagd. Alsnog. ,,En ja, dit keer wel echt. Gelukkig’’, zegt de scholiere. ,,Wat een opluchting.’’"
                            },
                            {
                                "example_id": "8e27b62e-9346-4d3d-aa74-91128f755d3a",
                                "sense_id": "9522f8b0-3ab0-3116-b288-102002e5716e",
                                "text": "Scholiere Makayla Phillips uit Canyon Lake (Californië) is de laatste kandidaat van het dertiende seizoen van America's Got Talent die in één klap door is naar de finale. De 15-jarige brunette pakte jurylid Heidi Klum in met haar vertolking van Warrior van Demi Lovato."
                            }
                        ]
                    }
