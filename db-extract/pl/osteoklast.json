                    {
                        "sense_id": "0a96b757-9b9a-3660-9bf0-dadcf00fa197",
                        "entry_id": "daae12d7-d29b-3940-b54f-4c9afa14230c",
                        "glosses": [
                            "wielojądrzasta komórka zdolna do resorpcji tkanki kostnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7f0f10-7ee3-48ed-a3da-8befeb44bc95",
                                "sense_id": "0a96b757-9b9a-3660-9bf0-dadcf00fa197",
                                "text": "W kościach kalcytonina hamuje aktywność osteoklastów oraz osteolizę osteocytową, natomiast pobudza biosyntezę macierzy kostnej przez osteoblasty."
                            }
                        ],
