                            {
                                "example_id": "cf967d77-43f3-4f53-bf35-1bca88e11ff5",
                                "sense_id": "f084a884-b990-33c7-a4fa-436b566669b1",
                                "text": "Os innominé, un des noms de l’os iliaque."
                            },
                            {
                                "example_id": "9bd927c5-1c42-46df-a99c-ec0f0723af91",
                                "sense_id": "f084a884-b990-33c7-a4fa-436b566669b1",
                                "text": "Artère innominée, une des grandes artères du corps."
