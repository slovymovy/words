                        "sense_id": "dec0c7d6-731b-3e52-9a95-d68a921718bf",
                        "entry_id": "adb23083-d975-3958-a8c7-eb551348fef0",
                        "glosses": [
                            "That does not respond to stimuli; unresponsive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fbed99d-c5ef-4484-9714-09126ea46cc7",
                                "sense_id": "dec0c7d6-731b-3e52-9a95-d68a921718bf",
                                "text": "The church bells, faintly and fitfully heard, clanged their invitation to an irresponsive town; […]"
                            },
                            {
                                "example_id": "f5baaf56-ccc7-41dc-84d6-e5890d40f6d8",
                                "sense_id": "dec0c7d6-731b-3e52-9a95-d68a921718bf",
                                "text": "At dawn some weeks back it had creaked across the plain, and at a point where the scrub curved, the husband had stopped the horse while the woman parted the tilt and waved goodbye to the bent, irresponsive old man and his dog."
                            },
                            {
                                "example_id": "b8d8eb68-ac53-434d-bfe9-f64f761e3bd6",
                                "sense_id": "dec0c7d6-731b-3e52-9a95-d68a921718bf",
                                "text": "I had seen him once in that brown coat; I touched its sleeve, but it was limp and irresponsive to that faint call of memory."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
