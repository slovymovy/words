                        "sense_id": "19802b51-90a3-37c7-8cc5-f2021dae45b0",
                        "entry_id": "2d64cf79-7f67-3ace-9e3f-2371c19ca005",
                        "glosses": [
                            "vrouw die boeken schrijft die ook door kinderen met plezier gelezen kunnen worden"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3297fad5-92e3-4e84-b5ce-57a0de5310ed",
                                "sense_id": "19802b51-90a3-37c7-8cc5-f2021dae45b0",
                                "text": "Toen hij begin jaren negentig zijn vrouw, een bekende kinderboekenschrijfster, leerde kennen, ontwaarde hij via haar ineens het goddelijk licht."
                            },
                            {
                                "example_id": "3247ff20-64ba-4c6e-bf84-760cb754564d",
                                "sense_id": "19802b51-90a3-37c7-8cc5-f2021dae45b0",
                                "text": "Ook Anna Woltz, kinderboekenschrijfster en de auteur van het kinderboekenweekgeschenk dit jaar, roemt die techniek. \"Het zijn prachtige tekeningen. Ook voor volwassenen is het heel leuk om naar te kijken. Je ziet gewoon voor je dat hij aan het knippen is.\""
                            },
                            {
                                "example_id": "eaf2b774-f827-41a4-a662-038b397c954f",
                                "sense_id": "19802b51-90a3-37c7-8cc5-f2021dae45b0",
                                "text": "Kinderboekenschrijfster Manon Sikkel, bekend van onder andere de boeken over Geheim agent oma en Elvis Watt, is sinds 1 april 2019 Kinderboekenambassadeur van Nederland."
                            }
                        ]
                    }
