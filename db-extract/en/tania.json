                    {
                        "sense_id": "2ed53b47-a4b2-3875-bc6d-4cfe8173c9bf",
                        "entry_id": "e1119b11-6a1e-3f9b-9f15-fe9c51df54a2",
                        "glosses": [
                            "A diminutive of the female given names Tatiana or Tetyana."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f4ee51-27c9-458e-ae19-73244c99e804",
                                "sense_id": "2ed53b47-a4b2-3875-bc6d-4cfe8173c9bf",
                                "text": "\"Does she? What a name that child has got. Tania.\"\n\"That's not so odd a name,\" Hazel said. \"Not nowadays.\"\n\"I know. They all have outlandish international names, like Tania and Natasha and Erin and Solange and Carmen. No one has family names. These girls with rooster hair I see on the streets. They pick the names. They're the mothers.\""
                            }
                        ]
                    }
