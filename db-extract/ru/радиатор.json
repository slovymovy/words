                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3503e1b-8c57-40f9-86b8-74e1d9ea8946",
                                                "sense_id": "9b283f37-2808-3516-a72f-09afd179fc70",
                                                "text": "The radiator kept the apartment warm during winter."
                                            },
