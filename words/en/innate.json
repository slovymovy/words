{
    "word_family": [
        "innately",
        "innateness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a629241-a885-3716-ad82-805292cd2eae",
                    "sense_definition": "Inborn; existing or having existed since birth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child showed an <w>innate</w> talent for music from a very young age.",
                            "target_lang_translations": {
                                "zh": "这个孩子从小就表现出一种<w>天生</w>的音乐才华。"
                            }
                        },
                        {
                            "text": "Humans have an <w>innate</w> ability to learn languages quickly during childhood.",
                            "target_lang_translations": {
                                "zh": "人类在童年时期具有一种<w>与生俱来</w>的快速语言学习能力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inborn",
                        "native",
                        "natural"
                    ],
                    "antonyms": [
                        "acquired",
                        "learned"
                    ],
                    "common_phrases": [
                        "innate ability",
                        "innate talent"
                    ],
                    "target_lang_definitions": {
                        "zh": "天生的；与生俱来的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天生",
                                "target_lang_sense_clarification": "指生来就有的，常用于形容能力或特质。"
                            },
                            {
                                "target_lang_word": "与生俱来",
                                "target_lang_sense_clarification": "形容某种特质从出生时就伴随而来。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "873f8c25-3e3f-342b-ac4c-838516722516",
                    "sense_definition": "Instinctive; coming from instinct.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had an <w>innate</w> sense of danger when walking alone at night.",
                            "target_lang_translations": {
                                "zh": "她独自在夜间行走时，有一种<w>本能</w>的危险感。"
                            }
                        },
                        {
                            "text": "The animal's <w>innate</w> desire to protect its young is very strong.",
                            "target_lang_translations": {
                                "zh": "动物保护幼崽的<w>本能</w>欲望非常强烈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "natural"
                    ],
                    "common_phrases": [
                        "innate desire",
                        "innate sense"
                    ],
                    "target_lang_definitions": {
                        "zh": "本能的；出于直觉的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "本能",
                                "target_lang_sense_clarification": "指生物不学而能的反应或行为。"
                            },
                            {
                                "target_lang_word": "直觉",
                                "target_lang_sense_clarification": "指不经过逻辑推理而直接感知的心理状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20397c68-b63f-345f-a43a-d1f0792ed134",
                    "sense_definition": "Originating in the intellect, rather than acquired through experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "natural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often debate whether humans possess <w>innate</w> ideas about morality.",
                            "target_lang_translations": {
                                "zh": "哲学家们经常争论人类是否拥有关于道德的<w>天赋</w>观念。"
                            }
                        },
                        {
                            "text": "The theory suggests that logic is an <w>innate</w> quality of the human mind.",
                            "target_lang_translations": {
                                "zh": "该理论认为逻辑是人类思维的一种<w>天赋</w>特质。"
                            }
                        }
                    ],
                    "antonyms": [
                        "acquired"
                    ],
                    "common_phrases": [
                        "innate ideas"
                    ],
                    "target_lang_definitions": {
                        "zh": "天赋的；源于理智而非后天经验的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天赋",
                                "target_lang_sense_clarification": "指天生具有的才能或观念。"
                            },
                            {
                                "target_lang_word": "先验",
                                "target_lang_sense_clarification": "哲学用语，指不依赖于经验的知识。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efed5f15-9197-32db-b300-eec870322220",
                    "sense_definition": "Joined by the base to the very tip of a filament.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flower features an <w>innate</w> anther attached directly to the filament.",
                            "target_lang_translations": {
                                "zh": "这种花的花药呈<w>基着生</w>状态，直接附着在花丝上。"
                            }
                        },
                        {
                            "text": "Botanists classify the stamen structure by observing the <w>innate</w> anther position.",
                            "target_lang_translations": {
                                "zh": "植物学家通过观察<w>基着生</w>的花药位置来对雄蕊结构进行分类。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "innate anther"
                    ],
                    "target_lang_definitions": {
                        "zh": "（植物学）内生的；基着生的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "基着生",
                                "target_lang_sense_clarification": "植物学专业术语，指花药基部直接着生在花丝顶端。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec565a82-6e94-3b83-99fb-591a0d4b689d",
                    "sense_definition": "To cause to exist; to call into being.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes how the creator sought to <w>innate</w> life into the void.",
                            "target_lang_translations": {
                                "zh": "古籍中描述了造物主如何试图向虚无中<w>赋予</w>生命。"
                            }
                        },
                        {
                            "text": "Scholars analyze how the author attempts to <w>innate</w> a sense of wonder in the reader.",
                            "target_lang_translations": {
                                "zh": "学者们分析了作者如何试图在读者心中<w>赋予</w>一种惊奇感。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "赋予；使产生（古语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赋予",
                                "target_lang_sense_clarification": "给予某种特质或生命。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}