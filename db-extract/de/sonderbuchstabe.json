                "senses": [
                    {
                        "sense_id": "96b1573c-6fc0-31ee-974e-fbcd3a649e21",
                        "entry_id": "3e729ad6-be85-368c-bf14-41b88ec8ea61",
                        "glosses": [
                            "Buchstabe, der speziell in einem Alphabet vorkommt und in (vielen) anderen nicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b969cc-0045-49e2-95ab-aff4a2e6590d",
                                "sense_id": "96b1573c-6fc0-31ee-974e-fbcd3a649e21",
                                "text": "„Er ist komplett sinnfrei, hat keinerlei polnische Sonderbuchstaben und löst jedes Mal, wenn man ihn auf einer Party rezitiert, allgemeines Entzücken aus.“"
                            },
                            {
                                "example_id": "6e094140-1df5-4baa-8341-c044dabb7844",
                                "sense_id": "96b1573c-6fc0-31ee-974e-fbcd3a649e21",
                                "text": "„Das Alphabet, mit dem die spanische Sprache (span. español), die nach ihrer Ursprungsregion auch als kastilische Sprache (span. castellano) genannt wird, geschrieben wird, besteht aus den 26 Buchstaben „a“ bis „z“ und aus 3 nationalen Sonderbuchstaben.“"
                            },
                            {
                                "example_id": "2166dcd6-ce8a-423e-aade-aaab1fd25013",
                                "sense_id": "96b1573c-6fc0-31ee-974e-fbcd3a649e21",
                                "text": "„Ein typisches Beispiel hierfür sind im Deutschen die Umlaute ö, ä, ü und der Sonderbuchstabe ß (Diese Buchstaben können z.B. in Spanien dann nicht richtig (also wie im Deutschen) dargestellt werden.)).“"
                            },
                            {
                                "example_id": "82df6562-e43b-4858-b05c-727e1b533073",
                                "sense_id": "96b1573c-6fc0-31ee-974e-fbcd3a649e21",
                                "text": "„Im technischen Bereich wurden schon vor einigen Jahren Sonderbuchstaben aufgenommen, zum Beispiel deutsche oder dänische. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
