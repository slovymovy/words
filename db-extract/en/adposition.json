                                        "entry_id": "006ed02c-ef15-3119-9b08-f50b67a7a385",
                                        "glosses": [
                                            "Oberbegriff für unflektierbare Wörter, die eine Ergänzung in einem bestimmten Kasus fordern"
                                        ],
                                        "tags": [
                                            "Wortarten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea04ca37-7fb1-40cf-8705-c8a1a356ddda",
                                                "sense_id": "060afeb7-b4e1-3f96-abdc-94b0219fc3e2",
                                                "text": "Adpositionen bestimmen den Kasus des Satzgliedes, zu dem sie gehören."
                                            },
                                            {
                                                "example_id": "c823b728-ef62-45cf-b4dc-bedd7cff6cb3",
                                                "sense_id": "060afeb7-b4e1-3f96-abdc-94b0219fc3e2",
                                                "text": "Die Adposition „bei“ in dem Satzglied „bei meiner Wohnung“ ist eine Präposition und bestimmt, dass dieses Satzglied im Dativ steht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d86574d-1838-4ca0-a706-906e36dda1c5",
                        "source_entry_id": "02586b4f-d2e9-3df0-a248-ebc622812435",
                        "source_sense_id": "499898c1-b78a-3d7f-881e-e5246a1e537a",
                        "source_sense_description": "element combining with a phrase and indicating how to interpret the phrase in the context",
                        "target_lang_word": "Präposition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
