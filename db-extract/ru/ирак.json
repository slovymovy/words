                                "target_senses": [
                                    {
                                        "sense_id": "987bbbdc-0d58-3f63-92b8-56b1e55ab0e0",
                                        "entry_id": "ce729043-0e25-3948-a3de-806009cada6b",
                                        "glosses": [
                                            "państwo w Azji ze stolicą w Bagdadzie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
