                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd9fba1-c99a-414f-962c-1d60ca3afbdf",
                                                "sense_id": "eaa0f3c3-bed7-3fe5-b040-8cdbe96a26d6",
                                                "text": "„Die Generalstaatsanwaltschaft teilte mit, den Frauen von der Punkband \"Pussy Riot\" werde Rowdytum aus religiösem Hass und Beleidigung von Gläubigen vorgeworfen.“"
                                            }
                                        ],
