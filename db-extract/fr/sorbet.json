        "fr-extract.jsonl": [
            {
                "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                "word": "sorbet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7efa9ea5-4f6e-4afd-bd5a-e7d6e4057386",
                        "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "tags": [
                            "plural"
                        ],
                        "form": "sorbets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                        "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "glosses": [
                            "Breuvage glacé en neige, parfumé aux liqueurs ou au jus de fruits. On dit aujourd’hui dans ce sens « margarita »."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "42943919-bbe7-4be7-beb6-b06f824cb54f",
                                "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                                "text": "La petite créole ne croyait pas à l’hiver et ne connaissait le froid que pour avoir pris des sorbets."
                            },
                            {
                                "example_id": "0fd33079-3c43-4484-932c-202a0c511098",
                                "sense_id": "3a55aaf9-8b00-33a4-8b82-5ff681272669",
                                "text": "On entendait, de tous côtés, les carillons des vendeurs de sorbet, de pignolats et de lait caillé, les timbales des astrologues en plein vent, les chansons des guzlares aveugles, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "99fa00c1-816f-391d-bbbd-306837ec3e1a",
                        "entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "glosses": [
                            "Glace à base d’eau, de fruits et de sucre avec parfois adjonction d'alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b0c4b5-cf5b-4fc4-a558-2c96b04ceb5c",
                                "sense_id": "99fa00c1-816f-391d-bbbd-306837ec3e1a",
                                "text": "J’ai accompagné d’une demi-bouteille de champigny de la mousse de pintadeau au genièvre, une crépine de pied de porc aux lentilles, un sorbet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae97111-7a01-4803-9a68-d9cff603a083",
                        "source_entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "source_sense_description": "glace à l’eau",
                        "target_lang_word": "Wassereis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wassereis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1229b4c-815d-3338-8dfd-029b84bf3f9b",
                                        "entry_id": "c6b33618-8aaf-31f1-ba09-4faa327e64e0",
                                        "glosses": [
                                            "Speiseeis mit Wasser als Basis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48763e3b-8acb-49f2-95d4-f41d9be1bd83",
                                                "sense_id": "d1229b4c-815d-3338-8dfd-029b84bf3f9b",
                                                "text": "Alle Kinder lieben Wassereis!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                        "entry_id": "c6b33618-8aaf-31f1-ba09-4faa327e64e0",
                                        "glosses": [
                                            "Eis aus H₂O (im Unterschied zu Trockeneis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c704e60-58e9-47ae-ae87-7e5447208ac2",
                                                "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                                "text": "„Der Planet Mars besitzt an seinen beiden Polen auffällige, dauerhafte Eiskappen, die aus gefrorenem Kohlendioxid und Wassereis zusammengesetzt sind.“"
                                            },
                                            {
                                                "example_id": "b623f5d6-b2d1-4ebb-8c22-6142b56f3d2a",
                                                "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                                "text": "„Waren hier flüchtige Substanzen – Wassereis? – aus der Bodenprobe verdunstet und das Bodenmaterial in die entstehenden Hohlräume gesackt?“"
                                            },
                                            {
                                                "example_id": "fbfe14d0-402b-4900-9b75-fa8de293f9c1",
                                                "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                                "text": "„Das Wassereis auf dem Mars ist einer Untersuchung zufolge sehr uneinheitlich unter der Oberfläche verteilt.“"
                                            },
                                            {
                                                "example_id": "3c4de372-67f8-427f-9798-640fe88fb814",
                                                "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                                "text": "„Das Bild zeigt Wassereis am Boden eines Kraters in der Nähe des Mars-Nordpols.“"
                                            },
                                            {
                                                "example_id": "c9c2017b-d59c-45f4-b18d-820b7cebb5b1",
                                                "sense_id": "e995efb5-cb6d-34f9-8453-3d93b9bcf552",
                                                "text": "„Die Sonde entdeckt Wassereis am Südpol und Wasserdampf in der Atmosphäre des Roten Planeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "043ef9f9-5e67-485b-802b-19ee930bdc46",
                        "source_entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "source_sense_description": "glace à l’eau",
                        "target_lang_word": "Sorbet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorbet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33344d85-1a34-3dc1-be9d-712b7b3425dc",
                                        "entry_id": "1c5d886c-69b1-3310-8306-6c4b29a1a34e",
                                        "glosses": [
                                            "Eisspeise aus einer Masse aus Fruchtsaft, Fruchtpüree, Zucker, Zuckersirup und Aromastoffen, die im Gegensatz zu Eiscreme keine Milchprodukte enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b50adb5d-c68b-45ee-8fc3-1fcf29783a82",
                                                "sense_id": "33344d85-1a34-3dc1-be9d-712b7b3425dc",
                                                "text": "„Während Sorbet aus dem Supermarkt oft nur aus Wasser, Zucker, Farbstoffen und Aroma besteht, kann für selbst gemachtes Sorbet frisches Obst verwendet werden, was besser schmeckt und sehr gesund ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8706303-df0a-4783-9b49-1ddba3538508",
                        "source_entry_id": "ee2422f3-0605-3a33-86cb-4d365b8a8d62",
                        "source_sense_description": "glace à l’eau",
                        "target_lang_word": "Eis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7861d88-ef84-3827-ac13-d9099635cbb3",
                                        "entry_id": "c457d21a-f6cc-30ee-b125-898fbd1a2bd9",
                                        "glosses": [
                                            "Wasser im festen Aggregatzustand; gefrorenes Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e09157f-8c3f-45db-9fbd-7fd4ac783be8",
                                                "sense_id": "b7861d88-ef84-3827-ac13-d9099635cbb3",
                                                "text": "Es ist so kalt, dass Wasser sofort zu Eis gefriert."
                                            },
                                            {
                                                "example_id": "36f2b24b-6333-4e9b-be5d-7ce80edac8ef",
                                                "sense_id": "b7861d88-ef84-3827-ac13-d9099635cbb3",
                                                "text": "Bei \"Eis\" mag man an Winter, Schnee und Frost denken, an arktische Temperaturen und überfrierende Nässe. Vermutlich ist jedoch vielen der Gedanke an einen Eisbecher an einem warmen Sommertag angenehmer."
                                            },
                                            {
                                                "example_id": "7478f89a-fdea-4319-b640-4725b826b1b3",
                                                "sense_id": "b7861d88-ef84-3827-ac13-d9099635cbb3",
                                                "text": "Das Eis in den Polarmeeren scheint ein unbelebter Ort zu sein. Zwar laufen Eisbären oder Pinguine auf seiner Oberfläche, Fische und Robben schwimmen unter ihm her - das Eis selbst hingegen ist für viele nichts weiter als ein Klumpen gefrorenes Wasser."
                                            },
                                            {
                                                "example_id": "f122ca36-e020-49fd-acd2-7b477d0228a4",
                                                "sense_id": "b7861d88-ef84-3827-ac13-d9099635cbb3",
                                                "text": "„Dolochow, der mitten in der Menschenmasse stand, zwängte sich bis an den Rand des Dammes durch, stiess dabei zwei Soldaten um und lief dann auf das schlüpfrige Eis, das den Teich bedeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "859bbeac-cf08-3d29-bad6-89b651b3e56c",
                                        "entry_id": "c457d21a-f6cc-30ee-b125-898fbd1a2bd9",
                                        "glosses": [
                                            "Speiseeis, eine gefrorene Süßspeise"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424ccf36-854a-469c-8910-c8f7ca521c10",
                                                "sense_id": "859bbeac-cf08-3d29-bad6-89b651b3e56c",
                                                "text": "„Das Eis ist sehr lecker!“"
                                            },
                                            {
                                                "example_id": "f8c4edc6-7512-4696-b0c6-6b5498bbc1da",
                                                "sense_id": "859bbeac-cf08-3d29-bad6-89b651b3e56c",
                                                "text": "Eiscreme ist köstlich. Hat aber - vor allem, wenn es warm ist - einen entscheidenden Nachteil: sie schmilzt. Und nichts ist nerviger als sich verflüssigendes Eis, wenn es klebrig über die Finger läuft, man dem flüssigen Sahne-Schokoladen- oder Erdbeerzeug nicht mehr hinterherkommt und es unkontrolliert aufs T-Shirt tropft."
                                            },
                                            {
                                                "example_id": "ffdb7226-0b9b-4a95-abdb-f856b2983bf1",
                                                "sense_id": "859bbeac-cf08-3d29-bad6-89b651b3e56c",
                                                "text": "„Der eine trank Whisky, der andere aß Eis mit Schlagsahne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Eis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80d565fa-64f9-3cf8-b167-f33c284836c2",
                                        "entry_id": "994ba6fd-39ee-3c3a-851a-34b83a392c1e",
                                        "glosses": [
                                            "Ton mit 352 Hz und alle Töne im Oktavabstand dazu, um einen Halbton erhöhtes E"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04cdfa5a-0575-4506-a3aa-fa1c67585f82",
                                                "sense_id": "80d565fa-64f9-3cf8-b167-f33c284836c2",
                                                "text": "Denke bitte daran in Takt 5 ein Eis zu spielen!"
                                            }
