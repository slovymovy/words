            {
                "entry_id": "f84a8b9c-6c2e-38cd-9b2c-4be9fc37f5e8",
                "word": "pédestrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                        "entry_id": "f84a8b9c-6c2e-38cd-9b2c-4be9fc37f5e8",
                        "glosses": [
                            "À pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2f6071-eee7-44e4-8f27-888a689aa51c",
                                "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                                "text": "J’eus, par exemple, de cette façon M. de Feins, écuyer de la reine et capitaine de cavalerie dans le régiment de la Reine, lequel eut la constance de passer plusieurs jours à Motiers, et même de me suivre pédestrement jusqu’à la Ferrière, menant son cheval par la bride, sans avoir avec moi d’autre point de réunion, sinon que nous connaissions tous deux mademoiselle Fel, et que nous jouions l’un et l’autre au bilboquet."
                            },
                            {
                                "example_id": "4e68e896-8777-4d83-9a55-32efa04179b7",
                                "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                                "text": "Tel brille présentement qui a fait son entrée pédestrement, avec son paquet au bout de sa rapière et tenant ses souliers à la main de peur de les user. »"
                            },
                            {
                                "example_id": "224ded88-1dbc-410a-a114-1169a08ec40e",
                                "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                                "text": "Il alluma un cigare, releva le collet de son pardessus et s'achemina pédestrement vers l'hôtel du Rhin, […]."
                            },
                            {
                                "example_id": "17a86793-7661-46d5-94f2-b69e8f5b194b",
                                "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                                "text": "Aller pédestrement, le nez en l'air, à la découverte de quelque beau paysage ou de quelque ruine curieuse, […]"
                            },
                            {
                                "example_id": "4baff962-b7b6-4347-8fb8-46340e556881",
                                "sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                                "text": "Quand le cycliste revenait, pédestrement, haletant et fourbu, Grubb n’écoutait aucune récrimination."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97495bb8-b488-4d77-9e47-5cf1af91f5a3",
                        "source_entry_id": "f84a8b9c-6c2e-38cd-9b2c-4be9fc37f5e8",
                        "source_sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                        "target_lang_word": "zu Fuß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zu Fuß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e23fc72b-3a9a-313b-b62e-9c48de416600",
                                        "entry_id": "4c0d8ffc-fb5e-3644-a394-8f075e2014a9",
                                        "glosses": [
                                            "durch Fortbewegung auf den Füßen"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99ae3c2-fbc8-4289-9a33-5ba1871b6c93",
                                                "sense_id": "e23fc72b-3a9a-313b-b62e-9c48de416600",
                                                "text": "Zu Fuß dauert der Weg ins Stadtzentrum ungefähr 20 Minuten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0abe9866-0d32-3f0c-be86-e5bc5171b216",
                                        "entry_id": "4c0d8ffc-fb5e-3644-a394-8f075e2014a9",
                                        "glosses": [
                                            "ohne arbeitssparende Technik"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2c0e61c-2ebc-4cd9-b596-a928618dec26",
                                                "sense_id": "0abe9866-0d32-3f0c-be86-e5bc5171b216",
                                                "text": "Es dauert ewig, die Aufgabe zu Fuß auszurechnen. Nimm lieber die Formel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b8e66bb-69af-4f1f-91ef-14ffbb430e06",
                        "source_entry_id": "f84a8b9c-6c2e-38cd-9b2c-4be9fc37f5e8",
                        "source_sense_id": "38428ebd-8272-3061-92a8-064990dcb440",
                        "target_lang_word": "on foot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on foot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "On one's feet; walking, jogging or running but not in a vehicle or on the back of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e355d4-82fc-4ba7-9d5e-224e8e133732",
                                                "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                                "text": "The pub's not far: let's go on foot."
                                            },
                                            {
                                                "example_id": "0dd1056a-4dc4-4d08-bb84-07f74e140c93",
                                                "sense_id": "68a13ba3-1f55-3843-a2f0-7c3d289adc83",
                                                "text": "At the same time, the encroachment of vegetation proceeds apace, and broom and brambles have already made portions of the line impassable, even on foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e2add1-61ae-3097-9361-9bbf2a7de121",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "On the move; astir."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                        "entry_id": "a8e591e7-30f5-32a7-a3d2-204973909d1c",
                                        "glosses": [
                                            "In progress or in preparation; active, in operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1d5172-4c91-4ef2-9a01-2917d8799903",
                                                "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                                "text": "[W]ithin a short time it was generally believed at Naples, that a treaty of marriage was on foot between Zeluco and the young lady in question […]."
                                            },
                                            {
                                                "example_id": "1e75ec81-3773-4d7a-89db-000afadcea38",
                                                "sense_id": "34e82013-6ae1-3be0-97c6-6e2bb4096175",
                                                "text": "‘I didn't know anything of this sort was on foot.’ Brangwen smiled awkwardly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
