                        "examples": [
                            {
                                "example_id": "9d3c2d40-611a-4184-ad7a-f6e8eeeb1eca",
                                "sense_id": "44d40328-c0fd-3030-8aa6-c03690a9bc4c",
                                "text": "„Bis vor wenigen Jahren fanden im Engelsberger Marmorsteinbruch Bildhauersymposien statt.“"
                            },
                            {
                                "example_id": "00cfa14d-a8dd-402a-ae73-fb03b29d154e",
                                "sense_id": "44d40328-c0fd-3030-8aa6-c03690a9bc4c",
                                "text": "„Sie betreffen unter anderem einen mutmaßlich betrügerischen Versuch Cuencas, Severein, mit dem er früher eine gemeinsame Gesellschaft in Gibraltar unterhalten hatte, einen Marmorsteinbruch zu verkaufen.“"
                            }
                        ],
