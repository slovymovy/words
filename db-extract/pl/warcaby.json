                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc14f872-2d91-4495-9fe5-9842726bb918",
                        "source_entry_id": "036b3022-4872-3659-a7db-53fb7c8a5b33",
                        "source_sense_id": "108caf93-1a81-331a-a344-47163ec35182",
                        "target_lang_word": "Dame",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dame",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                        "entry_id": "02ffd8bf-c2f4-34c0-bbc6-1f808cfe75d1",
                                        "glosses": [
                                            "Frau"
                                        ],
                                        "tags": [
                                            "allgemeine unpersönliche Anrede im Plural verwendet oder höfliche Bezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3149b088-ebbf-41b4-8774-bc00f1810462",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "„Sehr geehrte Damen und Herren, …“"
                                            },
                                            {
                                                "example_id": "260a67e6-951b-4297-a658-9942a65d3e39",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "Erst drüben die Dame, dann du. (Volker Lechtenbrink)"
                                            },
                                            {
                                                "example_id": "f6650a5c-cdcc-4c3b-83a6-095c1e86ffe4",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "„Hier schwiegen die beiden Damen für eine volle Minute.“"
                                            },
                                            {
                                                "example_id": "fdeb1a55-f81d-4d71-9a89-c75a0023f3ac",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "„Die Dame trank ziemlich rasch und still ihre Flasche, zahlte und ging schlafen.“"
                                            },
                                            {
                                                "example_id": "67da2b67-f79d-4ca2-9003-8274324395a1",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "„Als ich das Lokal verließ, sah ich eine ältere Dame beim schwierigen Versuch, ihren Mantel anzuziehen.“"
                                            },
                                            {
                                                "example_id": "2d9d075f-9234-4593-858d-c2b0e05a4888",
                                                "sense_id": "ae73046b-962c-3baf-a084-b04aca98331f",
                                                "text": "„Den Sänften der Damen folgten in schlichteren Tragstühlen die Dienerfrauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf43b68d-5db4-3591-8847-02087fd2bb6c",
                                        "entry_id": "02ffd8bf-c2f4-34c0-bbc6-1f808cfe75d1",
                                        "glosses": [
                                            "Spielkarte in verschiedenen Kartenspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb187ea-03f6-48ee-af13-48264632df85",
                                                "sense_id": "cf43b68d-5db4-3591-8847-02087fd2bb6c",
                                                "text": "Beim Nullspiel sticht die Dame den Buben."
                                            },
                                            {
                                                "example_id": "7bc90855-b97c-4e77-8983-aee549699d14",
                                                "sense_id": "cf43b68d-5db4-3591-8847-02087fd2bb6c",
                                                "text": "„Ehe er Besorgungen macht, packt er die Zettel aus, blättert sie durch, legt sie dann aus wie eine Patience und ordnet sie nach ihrer Wichtigkeit, indem er kleine Häufchen bildet, so wie man Asse, Könige, Damen, Buben voneinander scheidet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d2970865-135e-3b6d-8c88-a9eb9750a728",
                                        "entry_id": "02ffd8bf-c2f4-34c0-bbc6-1f808cfe75d1",
                                        "glosses": [
                                            "die mächtigste Schachfigur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96646e0-f114-446c-aa59-072a7046705a",
                                                "sense_id": "d2970865-135e-3b6d-8c88-a9eb9750a728",
                                                "text": "Eine Dame ist schwächer als zwei Türme."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9a114d0b-c966-338e-b336-f296848dd3b6",
                                        "entry_id": "02ffd8bf-c2f4-34c0-bbc6-1f808cfe75d1",
                                        "glosses": [
                                            "durch Aufeinanderlegen von zwei Spielsteinen gebildete Spielfigur beim Damespiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8cfb10-3e6b-4776-922c-9e94456ddb72",
                                                "sense_id": "9a114d0b-c966-338e-b336-f296848dd3b6",
                                                "text": "„Erreicht ein Spielstein die gegnerische Grundlinie, wird er zur Dame befördert.“"
                                            },
                                            {
                                                "example_id": "85a38083-754a-416f-91f9-7adb23e225a0",
                                                "sense_id": "9a114d0b-c966-338e-b336-f296848dd3b6",
                                                "text": "„Stellen wir uns, um weniger abstrakt zu sein, eine Partie auf dem Damebrett vor, deren Steine auf vier Damen herabgeschmolzen sind und wo ein Versehen natürlich nicht zu erwarten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "59f6ee2b-1500-32d3-b625-2a4f9eb1d0c4",
                                        "entry_id": "02ffd8bf-c2f4-34c0-bbc6-1f808cfe75d1",
                                        "glosses": [
                                            "Bezeichnung des weiblichen Partners"
                                        ],
                                        "tags": [
                                            "ganz besonders beim Tanzen",
                                            "Tanzsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357d4081-62b6-4b39-a3f8-f63c5f0375d9",
                                                "sense_id": "59f6ee2b-1500-32d3-b625-2a4f9eb1d0c4",
                                                "text": "Er hat sie für diesen Tanz als seine Dame gewählt."
                                            },
                                            {
                                                "example_id": "4a904319-cb88-4a57-9b0e-8f455cf5b547",
                                                "sense_id": "59f6ee2b-1500-32d3-b625-2a4f9eb1d0c4",
                                                "text": "Der Herr führt, die Dame folgt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dame",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e672f5b-9386-3d70-ac13-b31516943de2",
                                        "entry_id": "c874af4c-c6d2-3e4d-a4f4-4c3dc60c2668",
