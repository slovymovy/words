                        "glosses": [
                            "To define too rigidly, or in too much depth."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7f6fc889-1434-4961-a6f4-4dc7e4f4e66e",
                                "sense_id": "4c2c3042-4bb5-3593-9af5-b470cad68270",
                                "text": "Most students want to overdefine every flower and leaf. In the assignment above, I spoke of “the essence of flowers.” If you overdefine and explain every petal, you will lose the sense of softness and mystery."
                            },
                            {
                                "example_id": "8c77bd88-1b6b-4190-b044-992f4b1c3fc5",
                                "sense_id": "4c2c3042-4bb5-3593-9af5-b470cad68270",
                                "text": "The adolescent search for a new and a reliable identity can perhaps best be seen in the persistent endeavor to define, to overdefine, and to redefine oneself and each other in often ruthless comparison […]"
                            }
                        ]
                    }
