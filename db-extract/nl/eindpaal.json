                                "sense_id": "b835138c-a511-3a7d-8c35-48202ea9eb53",
                                "text": "Beiden zetten hun paarden tot het uiterste aan en naderden de eindpaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "adce4224-44bb-30c7-b840-576b2bb57907",
                        "entry_id": "4d91b497-d87a-3874-97dc-bf5099950d27",
                        "glosses": [
                            "het uiteindelijke doel"
