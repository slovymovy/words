                    "frequency": "High",
                    "semantic_group_id": "fragilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plante a des feuilles très <w>délicates</w> qui ne supportent pas le soleil direct."
                        },
                        {
                            "text": "Il faut manipuler ces verres anciens avec précaution car ils sont particulièrement <w>délicats</w>."
                        }
                    ],
                    "synonyms": [
                        "fragile"
                    ],
                    "antonyms": [
                        "robuste"
                    ],
                    "common_phrases": [
                        "santé délicate"
                    ]
                },
                {
                    "sense_id": "d3bea41b-ab64-3013-b264-a2b054e835a0",
                    "sense_definition": "Qui exige beaucoup de prudence, de tact ou d'habileté ; difficile, embarrassant.",
