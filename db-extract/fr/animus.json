                                        "entry_id": "9ef64f80-af4c-36ea-9fc6-d3c7f60181bf",
                                        "glosses": [
                                            "A feeling of enmity, animosity or ill will."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
