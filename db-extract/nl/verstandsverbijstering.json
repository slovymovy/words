                ],
                "senses": [
                    {
                        "sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                        "entry_id": "62cb56ca-d20c-337d-8e8e-243901f5f4bc",
                        "glosses": [
                            "tijdelijk ontbreken van normale verstandelijke vermogens door hevige emotie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478a4450-bf9b-429e-b75c-3a8140cd3edd",
                                "sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                                "text": "In het hoofdstuk ’De zaak Nulde en de mens achter het monster’ staat onder meer dat Rowena geen makkelijk meisje is en af en toe een „corrigerende tik” krijgt van J., die zichzelf als redder ziet van moeder Wanda. „In een vlaag van verstandsverbijstering” zouden ze hebben besloten niet de hulpdiensten te bellen nadat ze het meisje levenloos hadden aangetroffen."
                            },
                            {
                                "example_id": "240733ea-afab-4050-a31c-d230275ba10b",
                                "sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                                "text": "Gordon legt in Koffietijd uit dat hij geen afscheid van zijn woning kon nemen. 'Ik had in een vlaag van verstandsverbijstering het voor de tweede keer in de verkoop gezet. Ik wilde eigenlijk naar Amsterdam enzo, ik heb al iets daar, maar dat is niet zo heel erg groot.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f562ac7-c2a9-441b-9b8f-df95f0265b4a",
                        "source_entry_id": "62cb56ca-d20c-337d-8e8e-243901f5f4bc",
                        "source_sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                        "source_sense_description": "tijdelijk ontbreken van normale verstandelijke vermogens door hevige emotie",
                        "target_lang_word": "insanity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                        "entry_id": "f71bf44b-01f7-3605-a6bc-deb57582936a",
                                        "glosses": [
                                            "The state of being insane; madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b947b7-8ea9-4924-aaaf-6d4646a42d22",
                                                "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                                "text": "The defendant pleaded insanity in the hope of getting a reduced sentence."
                                            },
                                            {
                                                "example_id": "ffddcfba-80d6-47c3-b219-69c4148dee33",
                                                "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                                "text": "But the bed-side of Lady Marchmont had a darker lesson than the grave, the ravings of insanity revealed the fiery world of that beating and passionate heart. Ethel could only feel too fearful, too humbled, for judgment; but she wept, even while she prayed, beside her early friend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ef2338e-5cda-494b-92c1-5c2d9a926814",
                        "source_entry_id": "62cb56ca-d20c-337d-8e8e-243901f5f4bc",
                        "source_sense_id": "41e7f0b4-21d3-3952-a353-4801281fda3f",
                        "source_sense_description": "tijdelijk ontbreken van normale verstandelijke vermogens door hevige emotie",
                        "target_lang_word": "lunacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
