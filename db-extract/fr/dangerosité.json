                                        "sense_id": "6448444d-1723-30d8-b4d7-4f9fab101739",
                                        "entry_id": "2b1ca2a3-efc0-3acf-b158-0a991c0e69af",
                                        "glosses": [
                                            "die Eigenschaft, gefährlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc99a909-d795-48dc-a49d-64b22a8638c9",
                                                "sense_id": "6448444d-1723-30d8-b4d7-4f9fab101739",
                                                "text": "Die Gefährlichkeit der Situation ist nicht zu unterschätzen."
                                            },
                                            {
                                                "example_id": "6421a1a6-b1f5-4479-a1e2-55e153603838",
                                                "sense_id": "6448444d-1723-30d8-b4d7-4f9fab101739",
                                                "text": "„Um die Gefährlichkeit des Alkohols zu demonstrieren, legt der Lehrer in der Biologiestunde einen Wurm in ein Glas mit Schnaps und einen in ein Glas mit Wasser.“"
                                            }
