                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f96db0a-b510-3d11-aa81-b268c1a6cd63",
                                        "entry_id": "7971f527-b1bc-3b14-9fda-5d3f668a2f2c",
