                                    {
                                        "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                        "entry_id": "175539c3-b3f9-3e34-9059-25cd7e2905c7",
                                        "glosses": [
                                            "am Rand in Fäden (Fransen) aufgelöst"
                                        ],
                                        "tags": [
                                            "von Kleidungsstücken oder Textilien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e8439e-47fa-432e-9cf7-cbcdaac88354",
                                                "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                                "text": "„Er trug Jeans und einen NYU-Pullover, der an den Ärmeln schon ganz ausgefranst war.“"
                                            },
                                            {
                                                "example_id": "7b646970-46bc-4681-b35d-fa71120cdde6",
                                                "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                                "text": "„Auf Fines Kopf thronte eine Wollmütze mit einem Norwegermuster, an der Seite mit einem kleinen Bommel versehen, der schon ein wenig ausgefranst war.“"
                                            },
                                            {
                                                "example_id": "233cd93b-1f6c-4a12-b305-e3892e1a417e",
                                                "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                                "text": "„Ich wusste, dass ich bei diesem Stoff (zu zart, um ihn direkt zu besticken) zur Verstärkung Flicken aufnähen musste, außerdem war der Riss stark ausgefranst.“"
                                            },
                                            {
                                                "example_id": "84eb8902-4ca2-47a1-ba38-f2975fff6497",
                                                "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                                "text": "„Tula erhob sich von oben, schwang ihre Arme und warf kleine, ausgefranste Beutel den Abhang hinunter.“"
                                            },
                                            {
                                                "example_id": "8d2742bf-b360-4f0b-bf25-4636945e6473",
                                                "sense_id": "9f2f88ee-78f5-383b-b167-3581e903497e",
                                                "text": "„Und, der Hosenanzug scheint ausgefranste Hosenbeinenden zu haben, ebenso ausgefranste Ärmelenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
