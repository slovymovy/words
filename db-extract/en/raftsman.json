                                "target_senses": [
                                    {
                                        "sense_id": "46eecd8c-5e9c-3a2e-837d-68a76332880c",
                                        "entry_id": "0a6935b9-8a2a-3ee0-b573-d9b5760fe5ae",
                                        "glosses": [
                                            "człowiek zajmujący się spławianiem rzeką drewna, zboża i innych towarów; flisak"
                                        ],
                                        "tags": [
                                            "professional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b364d08-0996-4d6a-a05b-37f79a6d5f0c",
                                                "sense_id": "46eecd8c-5e9c-3a2e-837d-68a76332880c",
                                                "text": "Po drodze Toruń, gościnny Toruń witał oryla – do dziś mam w oczach ten piękny widok w zachodu chwile…"
                                            },
                                            {
                                                "example_id": "17cd6a8f-678b-47af-98e4-05fe3e4b6c4d",
                                                "sense_id": "46eecd8c-5e9c-3a2e-837d-68a76332880c",
                                                "text": "Cisza w komnacie trwała. Za oknem królewskiej świetlicy płynął w tej chwili żagiel. Nawoływali się oryle"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "04121de0-3d53-30a2-8da4-3af6f4d5c673",
