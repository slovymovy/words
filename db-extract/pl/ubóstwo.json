                                "sense_id": "33613a15-b3e1-38b2-bd05-d44c92508835",
                                "text": "Janek wychowywał się w ubóstwie i nie chodził do szkoły."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d1b9d0da-b2b5-3c72-991e-2b7f4de57540",
