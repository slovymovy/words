{
    "word_family": [
        "prospective",
        "prospector",
        "prospectus",
        "prospecting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19c6f0fc-a953-3ced-a3a2-631a64837430",
                    "sense_definition": "the possibility or likelihood of some future event occurring",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "future_possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prospect</w> of a new job in another city was both exciting and a bit scary.",
                            "target_lang_translations": {
                                "ru": "<w>Перспектива</w> новой работы в другом городе была одновременно захватывающей и немного пугающей."
                            }
                        },
                        {
                            "text": "There is little <w>prospect</w> of success if we do not work together as a team.",
                            "target_lang_translations": {
                                "ru": "Мало <w>шансов</w> на успех, если мы не будем работать вместе как одна команда."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "prospect of success",
                        "daunting prospect",
                        "future prospects"
                    ],
                    "target_lang_definitions": {
                        "ru": "возможность или вероятность того, что какое-то событие произойдет в будущем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "ожидаемое событие в будущем"
                            },
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "вероятность наступления события"
                            },
                            {
                                "target_lang_word": "шанс",
                                "target_lang_sense_clarification": "вероятность успеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b88be071-5120-315d-825a-40d2b1d6db10",
                    "sense_definition": "a person or organization regarded as a potential customer or client",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business_potential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sales team spent the entire afternoon calling every new <w>prospect</w> on their list.",
                            "target_lang_translations": {
                                "ru": "Команда по продажам провела весь день, обзванивая каждого нового <w>потенциального клиента</w> в своем списке."
                            }
                        },
                        {
                            "text": "We need to identify a sales <w>prospect</w> who has the budget for our premium services.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>потенциального покупателя</w>, у которого есть бюджет на наши услуги премиум-класса."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "sales prospect",
                        "potential prospect",
                        "business prospect"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business and sales contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек или организация, рассматриваемые как потенциальный покупатель или клиент"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциальный клиент",
                                "target_lang_sense_clarification": "в бизнесе и продажах"
                            },
                            {
                                "target_lang_word": "перспективный заказчик",
                                "target_lang_sense_clarification": "возможный покупатель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e39df416-0cce-3df0-b4ad-f4e7adfb8228",
                    "sense_definition": "a person, especially an athlete, who is expected to be successful in the future",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "future_possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young pitcher is considered a top <w>prospect</w> for the major leagues next year.",
                            "target_lang_translations": {
                                "ru": "Молодой питчер считается самым <w>перспективным игроком</w> для высшей лиги в следующем году."
                            }
                        },
                        {
                            "text": "Scouts are watching the game to see which <w>prospect</w> has the most talent.",
                            "target_lang_translations": {
                                "ru": "Скауты наблюдают за игрой, чтобы увидеть, кто из <w>кандидатов</w> наиболее талантлив."
                            }
                        }
                    ],
                    "common_phrases": [
                        "top prospect",
                        "exciting prospect",
                        "young prospect"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, особенно спортсмен, от которого ожидают больших успехов в будущем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспективный игрок",
                                "target_lang_sense_clarification": "о молодом таланте"
                            },
                            {
                                "target_lang_word": "надежда",
                                "target_lang_sense_clarification": "тот, с кем связывают ожидания"
                            },
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "претендент на успех"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3e0ea94-b32b-3ab3-a811-d2b337a87ff3",
                    "sense_definition": "a wide, beautiful view of an area of land; a landscape",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the balcony, we enjoyed a wide <w>prospect</w> of the valley and the mountains beyond.",
                            "target_lang_translations": {
                                "ru": "С балкона нам открывался широкий <w>вид</w> на долину и горы за ней."
                            }
                        },
                        {
                            "text": "The painter captured the beautiful <w>prospect</w> of the river at sunset.",
                            "target_lang_translations": {
                                "ru": "Художник запечатлел прекрасную <w>панораму</w> реки на закате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wide prospect",
                        "panoramic prospect",
                        "pleasing prospect"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "широкий, красивый вид на местность; ландшафт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "панорама, открывающаяся взору"
                            },
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "вид вдаль"
                            },
                            {
                                "target_lang_word": "панорама",
                                "target_lang_sense_clarification": "широкий обзор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8af6723-0457-31b5-9768-8d0343cd6261",
                    "sense_definition": "to search an area for gold, oil, or other valuable minerals",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people moved west to <w>prospect</w> for gold during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие люди отправились на запад, чтобы <w>искать</w> золото."
                            }
                        },
                        {
                            "text": "The company plans to <w>prospect</w> for oil in the northern territories this summer.",
                            "target_lang_translations": {
                                "ru": "Этим летом компания планирует проводить <w>разведку</w> нефти на северных территориях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prospect for gold",
                        "prospect for oil",
                        "prospect for minerals"
                    ],
                    "target_lang_definitions": {
                        "ru": "исследовать местность в поисках золота, нефти или других полезных ископаемых"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разведывать",
                                "target_lang_sense_clarification": "искать месторождения"
                            },
                            {
                                "target_lang_word": "вести разведку",
                                "target_lang_sense_clarification": "о полезных ископаемых"
                            },
                            {
                                "target_lang_word": "искать",
                                "target_lang_sense_clarification": "заниматься поисками золота или нефти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "41f25446-0fd3-3f76-ac57-53fab57bf12b",
                    "sense_definition": "the name of various towns, suburbs, or administrative areas in the United States and Australia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He decided to move his family to a quiet neighborhood in <w>Prospect</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил перевезти свою семью в тихий район в <w>Проспекте</w>."
                            }
                        },
                        {
                            "text": "The local council of the City of <w>Prospect</w> met to discuss the new park.",
                            "target_lang_translations": {
                                "ru": "Местный совет города <w>Проспект</w> собрался, чтобы обсудить новый парк."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "название различных городов, пригородов или административных районов в США и Австралии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Проспект",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
