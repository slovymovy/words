                            "Austrian German"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "761dc81b-9d56-3851-8a2a-80d4a23262b0",
                        "entry_id": "cd2189f0-53e3-3e46-a261-7493e5e78db6",
                        "glosses": [
                            "Zeitraum, der die Jahre 70 bis 79 eines Jahrhunderts oder Lebens umfasst"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
