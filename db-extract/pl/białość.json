                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c24391-922d-4bb1-ae54-75602562a834",
                                "sense_id": "7e9825b3-62f0-33d0-9d1a-17d8b3807126",
                                "text": "Nadmienia się dodatkowo, że dla otrzymania większej białości i pulchności pszennego pieczywa, posługują się piekarze potażem, biorąc 3 do 4 gramów potażu na 1 litr płynu, w którym się ciasto rozczynia"
                            },
                            {
                                "example_id": "0412ab09-c95c-4f86-aa7a-81a5df08be05",
                                "sense_id": "7e9825b3-62f0-33d0-9d1a-17d8b3807126",
                                "text": "Fosforyczną białością powlekły się ściany / Nagich, skrzesanych turni; wielka cieniu rzeka / Ogarnia je i niesie w mroku oceany"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
