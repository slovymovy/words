                        "translation_id": "358d74d6-da94-404f-a0ef-5b6d80df32b9",
                        "source_entry_id": "2a59a9d2-e0ad-393b-b008-4d07cce486a8",
                        "source_sense_id": "449d46d0-ef37-3bdd-be5c-95070d2c66bb",
