                                    },
                                    {
                                        "sense_id": "e0341ff5-de95-3cb0-bb4f-592c75afa42e",
                                        "entry_id": "c4803791-3220-3cf6-95a0-af53453b0c4f",
                                        "glosses": [
                                            "One who, or that which, generates, begets, causes, or produces.",
                                            "A subordinate piece of code which, given some initial parameters, will generate multiple output values on request."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551ce48e-17d7-4ce4-a3f1-e3dc336ef089",
                                                "sense_id": "e0341ff5-de95-3cb0-bb4f-592c75afa42e",
                                                "text": "When you come across something that looks like a listcomp but is surrounded by parentheses, you're looking at a generator: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8241a0c0-22d5-3854-8136-7a3a9ac1ca68",
                                        "entry_id": "c4803791-3220-3cf6-95a0-af53453b0c4f",
                                        "glosses": [
                                            "A piece of apparatus, equipment, etc, to convert or change energy from one form to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76222fd7-76ac-3ce5-a808-dc57a326be59",
                                        "entry_id": "c4803791-3220-3cf6-95a0-af53453b0c4f",
                                        "glosses": [
                                            "A piece of apparatus, equipment, etc, to convert or change energy from one form to another.",
                                            "Especially, a machine that converts mechanical energy into electrical energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e00c9f2-7c9a-4cc3-a810-712f1763c97c",
                                                "sense_id": "76222fd7-76ac-3ce5-a808-dc57a326be59",
                                                "text": "Heating in the passenger sections is by electricity obtained from the main generator. When heating is dictated by the operation of a thermostat in the roof of the motor coach, engine idling speed is 600 r.p.m. instead of the normal 450 r.p.m. in order to produce a high enough generator voltage output at rest."
                                            },
                                            {
                                                "example_id": "4c4f3cb2-311a-4610-967a-87c7e0a4d28d",
                                                "sense_id": "76222fd7-76ac-3ce5-a808-dc57a326be59",
                                                "text": "Using a tractor fan, shock absorbers, PVC pipes, a bicycle frame and anything else he could lay his hands on, he then built a rudimentary wooden tower, plonked his home-made generator on the top, and eventually got one, and then four bulbs to light up."
                                            },
                                            {
                                                "example_id": "b1c95518-1d36-4606-9dad-103f5fd50c02",
                                                "sense_id": "76222fd7-76ac-3ce5-a808-dc57a326be59",
                                                "text": "WIND\nSince 2001, Taipower has installed eight wind-powered generators on Penghu, and in 2004 the main island's first commercial wind farm — located in Shihmen Township, Taipei County, and built by Taipower — went online."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0201618-1819-493e-bcab-858a1b277897",
                        "source_entry_id": "7e2e4979-de73-36c9-b706-f789cd266949",
                        "source_sense_id": "d5c13240-7dc3-3a08-b88e-d8d65312a590",
                        "source_sense_description": "een apparaat of persoon die iets genereert (doet ontstaan)",
                        "target_lang_word": "générateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "générateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7dbcdf4-698f-3104-8189-1862e6306a7f",
                                        "entry_id": "687fe4ce-4f38-3fd7-976a-e0e56d3587cb",
                                        "glosses": [
                                            "Qui sert à engendrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3bbc307-a060-49ce-9d11-9ddbd37206a3",
                                                "sense_id": "a7dbcdf4-698f-3104-8189-1862e6306a7f",
                                                "text": "Cela tient à ce que ce remède, qui est la seule science de certains praticiens, est un excitant qui, momentanément, a redonné une animation factice aux organes générateurs. Mais comme la cause réelle de l’affaiblissement de la virilité n’a pas été attaquée, elle persiste […]."
                                            },
                                            {
                                                "example_id": "4381eeeb-740a-45d2-91c3-457a516f658c",
                                                "sense_id": "a7dbcdf4-698f-3104-8189-1862e6306a7f",
                                                "text": "En disant que tout vient de l’eau et que tout y retourne, Thalès, fait observer Plutarque, se fondait sur trois faits: Le premier, que la semence génératrice de tous les animaux est liquide ; d’où il conjecturait que l’élément humide a dû être le principe de toutes choses."
                                            },
                                            {
                                                "example_id": "028c1bb4-f5ff-4fcc-8b61-8f7acbcf9114",
                                                "sense_id": "a7dbcdf4-698f-3104-8189-1862e6306a7f",
                                                "text": "Si, en effet, l’activité génératrice s’emploie à la propagation de l’espèce, l’effort sera intense, et, en même temps, profonde la joie ressentie de cet accomplissement fonctionnel, fin dernière de l’animalité. L’effort générateur peut, dans certaines espèces animales, être tel qu’il épuise la vie avec lui, et provoque à sa suite la mort même de l’animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb6a517-4e10-38a7-a0e6-c571f2476da4",
                                        "entry_id": "687fe4ce-4f38-3fd7-976a-e0e56d3587cb",
                                        "glosses": [
                                            "D’où découlent un certain nombre de conséquences."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97cb6766-fc3b-476d-abff-b2b6cc156497",
                                                "sense_id": "9fb6a517-4e10-38a7-a0e6-c571f2476da4",
                                                "text": "C’est parce que le fait générateur de l’impôt, c’est la mise en distribution du dividende, c’est l’échéance de l’obligation. Par conséquent, toutes les fois que l’on se trouvera en présence de ce fait générateur de l’impôt dans l’application de la loi nouvelle, c’est-à-dire d’une mise en distribution postérieure au 1er janvier, le droit deviendra exigible, quelle que soit l’époque à laquelle le revenu ait été acquis."
                                            },
                                            {
                                                "example_id": "de3d6cfe-ef98-456d-85a9-de27e7f17751",
                                                "sense_id": "9fb6a517-4e10-38a7-a0e6-c571f2476da4",
                                                "text": "Les anciens avaient justement montré le rôle de l’organisme vivant comme cause génératrice des maladies, les éléments extérieurs en étant les causes provocatrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2a5081-6055-3110-a8f8-4c42c413dd23",
                                        "entry_id": "687fe4ce-4f38-3fd7-976a-e0e56d3587cb",
                                        "glosses": [
                                            "Qui produit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3264b5ed-b8b3-4755-a8c6-e53010608149",
                                                "sense_id": "2e2a5081-6055-3110-a8f8-4c42c413dd23",
                                                "text": "L’usine génératrice doit être établie de préférence vers le milieu de la ligne, de sorte que les canalisations en partant soient le plus courtes possible et que, par suite, la perte de charge soit réduite au minimum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce0b1f1b-1ad5-3cca-ae33-1bf91bf91f3d",
                                        "entry_id": "687fe4ce-4f38-3fd7-976a-e0e56d3587cb",
                                        "glosses": [
                                            "Qualifie le polygone dont la révolution autour d’un de ses côtés forme un solide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141af8da-e65e-4b36-b68d-c1813a259327",
                                                "sense_id": "ce0b1f1b-1ad5-3cca-ae33-1bf91bf91f3d",
                                                "text": "Le rectangle générateur doit être regardé comme un véritable rayon-plan, si l’on peut s’exprimer ainsi, car il engendre le cylindre droit absolument de la même manière que le rayon-ligne engendre le cercle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fcf9e13-5b76-3de2-ae13-cdf131937c21",
                                        "entry_id": "687fe4ce-4f38-3fd7-976a-e0e56d3587cb",
                                        "glosses": [
                                            "Qualifie la ligne formant l’axe autour duquel se fait cette révolution."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642418e3-07c0-4f54-94cf-e8930912c301",
                                                "sense_id": "7fcf9e13-5b76-3de2-ae13-cdf131937c21",
                                                "text": "L’aire engendrée sur une surface de révolution par la rotation d’un segment méridien a pour mesure le produit de ce segment par l'arc moyen qu’il décrit.\nIl est entendu que les facteurs de ce produit sont respectivement, l’un la longueur rectifiée du segment générateur, l’autre la moyenne des arcs décrits par les différents points de ce même segment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
