                "senses": [
                    {
                        "sense_id": "87d6b28f-15f7-32d9-bbf4-7083682d8710",
                        "entry_id": "74e6af61-9b1b-36e2-b37a-3cea474f98c2",
                        "glosses": [
                            "Eigenschaft von etwas, anzuschwellen, durch Wasseraufnahme an Volumen zuzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965e78d8-4e17-40d9-bcd6-36f9aac481f1",
                                "sense_id": "87d6b28f-15f7-32d9-bbf4-7083682d8710",
                                "text": "„Charakteristisch für viele Kunststoffe ist deren Quellbarkeit (oder auch Löslichkeit) durch organische Lösemittel oder auch Wasser.“"
                            },
                            {
                                "example_id": "093e8056-ef23-486d-a047-b02b9755d101",
                                "sense_id": "87d6b28f-15f7-32d9-bbf4-7083682d8710",
                                "text": "„Der Chromlichtdruck beruht auf der Eigenschaft mancher organischer Körper beim Zusatz von Chromsäuresalzen am Lichte ihre Löslichkeit, Quellbarkeit oder Hygroskopität zu ändern (abzuschwächen).“"
                            },
                            {
                                "example_id": "00aeb02f-bdca-4ca6-a149-c1935e4e4b06",
                                "sense_id": "87d6b28f-15f7-32d9-bbf4-7083682d8710",
                                "text": "„Die Diffusionsgeschwindigkeit des Stoffes im Redoxharz wird wiederum abhängig sein von der Quellbarkeit des Harzes.“"
                            },
                            {
                                "example_id": "8013bb89-6220-436c-bcdd-6d13578763e1",
                                "sense_id": "87d6b28f-15f7-32d9-bbf4-7083682d8710",
                                "text": "„Außerdem lassen sich reaktive Gruppen einfügen, um Biomoleküle an Oberflächen zu fixieren und Hydrogele mit einstellbaren Festigkeiten und Quellbarkeiten zu erzeugen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
