                        ],
                        "examples": [
                            {
                                "example_id": "38c4aebe-d8c3-41c4-9af6-a885adc66ed7",
                                "sense_id": "8fe16532-46f5-39af-a0f0-e9f636925434",
                                "text": "J’aime pas son blase, je sors pas avec lui.",
                                "translation": "Ik heb een hekel aan zijn neus, ik ga niet met hem uit."
                            }
                        ]
