                    }
                ],
                "translations": [
                    {
                        "translation_id": "5da3999c-c417-48d4-bc48-67ded2032c2f",
                        "source_entry_id": "bc247f96-f6dc-3a1d-af73-ca546f56ebf7",
                        "source_sense_id": "0055a099-1110-3169-86e7-e7a078d9072e",
                        "target_lang_word": "message",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                                        "entry_id": "e299bc21-4dc1-354b-8550-2cd9f8db3a95",
                                        "glosses": [
                                            "A communication, or what is communicated; any concept or information conveyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c6faa00-9760-4b98-a717-36c2459c338a",
                                                "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                                                "text": "We've just received an urgent message from the President."
                                            },
                                            {
                                                "example_id": "fe6c64a7-888b-47ed-a563-c6cd9ea7fe19",
                                                "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                                                "text": "He received a message telling him to update his laptop."
                                            },
                                            {
                                                "example_id": "0fffe663-8d15-48a7-af00-bc0b343b449e",
                                                "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                                                "text": "I have a message from God unto thee."
                                            },
                                            {
                                                "example_id": "9a6b7dcf-7026-418b-ae85-558fb3bd1600",
                                                "sense_id": "45add5f5-db27-33c5-8b4b-73ea704ee623",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370d526b-91b6-3e74-982b-6e5dcac95f18",
                                        "entry_id": "e299bc21-4dc1-354b-8550-2cd9f8db3a95",
                                        "glosses": [
                                            "An underlying theme or conclusion to be drawn from something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cd06d3-c7c5-4dc8-bc1a-a30ddc8d0f35",
                                                "sense_id": "370d526b-91b6-3e74-982b-6e5dcac95f18",
                                                "text": "The main message of the novel is that time heals all wounds."
                                            },
                                            {
                                                "example_id": "ba441685-d3f8-4e80-8f30-7514a9ba03cc",
                                                "sense_id": "370d526b-91b6-3e74-982b-6e5dcac95f18",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89dbe6df-16b5-320a-b376-8952a49a1526",
                                        "entry_id": "e299bc21-4dc1-354b-8550-2cd9f8db3a95",
                                        "glosses": [
                                            "An errand."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d0dc14-8fe8-4d57-a843-35ecdfa8a763",
                                                "sense_id": "89dbe6df-16b5-320a-b376-8952a49a1526",
                                                "text": "I had been on a message for my father, and was walking home along the road, when I saw a tall, fine lassie coming over the bogland on the right hand side of the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea9da29-4b62-3b6d-affb-cc7ccde8c69d",
                                        "entry_id": "e299bc21-4dc1-354b-8550-2cd9f8db3a95",
                                        "glosses": [
                                            "See messages (“groceries, shopping”)."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "message",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fabbdc4e-f1d1-3969-9cbf-c048015de074",
                                        "entry_id": "e27c4d17-4e8a-3dbc-8376-b4dacbfe71b9",
                                        "glosses": [
                                            "To send a message to; to transmit a message to, e.g. as text via a cell phone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d51cb6-d93a-41ab-9d20-60a1d154272a",
                                                "sense_id": "fabbdc4e-f1d1-3969-9cbf-c048015de074",
                                                "text": "Just message me for directions."
                                            },
                                            {
                                                "example_id": "c856ab67-3766-4b61-8efe-c4a94f56efb4",
                                                "sense_id": "fabbdc4e-f1d1-3969-9cbf-c048015de074",
                                                "text": "I messaged her about the concert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1211b5ea-5c1f-3154-87f2-a3835b8a1fcc",
                                        "entry_id": "e27c4d17-4e8a-3dbc-8376-b4dacbfe71b9",
                                        "glosses": [
                                            "To send (something) as a message; usually refers to electronic messaging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765a1767-8d30-4ea4-b079-f17cb72a307d",
                                                "sense_id": "1211b5ea-5c1f-3154-87f2-a3835b8a1fcc",
                                                "text": "She messaged me the information yesterday."
                                            },
                                            {
                                                "example_id": "f5d2c92b-264d-4bbf-a72d-3446029ba2a1",
                                                "sense_id": "1211b5ea-5c1f-3154-87f2-a3835b8a1fcc",
                                                "text": "Please message the final report by fax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc2d9224-c0f0-325a-99c1-d6ab9a90c3bb",
                                        "entry_id": "e27c4d17-4e8a-3dbc-8376-b4dacbfe71b9",
                                        "glosses": [
                                            "To send a message or messages; to be capable of sending messages."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e34e13-d1ad-4cf5-88bd-82925c1eb258",
                                                "sense_id": "bc2d9224-c0f0-325a-99c1-d6ab9a90c3bb",
                                                "text": "We've implemented a new messaging service."
                                            },
                                            {
                                                "example_id": "f1213c0d-deb2-4b66-84c2-1215873887c6",
                                                "sense_id": "bc2d9224-c0f0-325a-99c1-d6ab9a90c3bb",
                                                "text": "The runaway computer program was messaging non-stop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff74f92-c59d-34ff-981d-b227e08a757f",
                                        "entry_id": "e27c4d17-4e8a-3dbc-8376-b4dacbfe71b9",
                                        "glosses": [
                                            "To bear as a message."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5afc54a5-a0ea-46f6-b887-d900d0d4c489",
                        "source_entry_id": "bc247f96-f6dc-3a1d-af73-ca546f56ebf7",
                        "source_sense_id": "0055a099-1110-3169-86e7-e7a078d9072e",
                        "target_lang_word": "торжественное",
