                "senses": [
                    {
                        "sense_id": "07568aa4-2b16-393f-8d92-8a98cc361536",
                        "entry_id": "442f434e-b0a5-32f2-845d-14eab0c4d124",
                        "glosses": [
                            "ungewöhnlich langer Satz"
                        ],
                        "tags": [
                            "salopp. scherzhaft"
                        ],
                        "examples": [
                            {
                                "example_id": "714aa630-0b07-439c-83cd-b6e3933194f5",
                                "sense_id": "07568aa4-2b16-393f-8d92-8a98cc361536",
                                "text": "„Der Bandwurmsatz ist das verbreitetste Übel unseres Prosastils.“"
                            },
                            {
                                "example_id": "21c5d74f-a87d-4c62-a455-406fc0af7f05",
                                "sense_id": "07568aa4-2b16-393f-8d92-8a98cc361536",
                                "text": "„»Bandwurmsätze« zu vermeiden, ist eine sprichwörtliche Formel für die Aufforderung zum kurzen Satz.“"
                            },
                            {
                                "example_id": "222e531f-6d47-4b83-94b3-9c92cf717171",
                                "sense_id": "07568aa4-2b16-393f-8d92-8a98cc361536",
                                "text": "„Noch viele Beispiele öffentlichen Sprachdesasters ließen sich anführen, aber schließen wir mit den Schachtel- und Bandwurmsätzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
