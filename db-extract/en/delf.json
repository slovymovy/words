                        "examples": [
                            {
                                "example_id": "ac0813e5-d2d0-4a6c-affe-bff21ccd3dc1",
                                "sense_id": "4a95c9c3-e6b1-35b1-90f4-4cb58fbac959",
                                "text": "Five nothings in five plates of delf"
                            },
                            {
                                "example_id": "8983259e-cffd-4384-b015-203c3d613d35",
                                "sense_id": "4a95c9c3-e6b1-35b1-90f4-4cb58fbac959",
                                "text": "Suddenly a beautiful delf blue-and-white flower-pot, which had been set on the window-sill of an upper storey, fell to the ground with a crash, and the fragments spluttered up around my father's legs."
                            },
                            {
                                "example_id": "5ab4ed3d-fcd3-4196-af17-93510487bbc6",
                                "sense_id": "4a95c9c3-e6b1-35b1-90f4-4cb58fbac959",
                                "text": "That's all—do what we do, but noblier done— / Use plate, whereas we eat our meals off delf, / (To use a figure)."
                            },
                            {
                                "example_id": "29b0069a-2233-4a22-92ed-b99a4e0e97aa",
                                "sense_id": "4a95c9c3-e6b1-35b1-90f4-4cb58fbac959",
                                "text": "Men can't munch from meatless pots and doughless delf."
                            }
                        ]
                    }
