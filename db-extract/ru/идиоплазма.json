                                        "glosses": [
                                            "das auch den Kerninhalt einschließende Protoplasma der Keimzellen, das die gesamte Erbsubstanz enthält"
                                        ],
                                        "tags": [
                                            "Genetik",
                                            "Wissenschaftsgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c7517a-0bd3-4def-a98a-60c84c143ef7",
                                                "sense_id": "259d11a0-59d3-34d9-9c74-4d9b392de0ee",
                                                "text": "Keimplasma ist eine historische Bezeichnung für die Vererbungssubstanz, die nur durch Zellteilung und in ihrer Gesamtheit nur in der Keimbahn weitergegeben wird, was die Vererbung erworbener Eigenschaften ausschließt."
                                            }
