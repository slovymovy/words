                "senses": [
                    {
                        "sense_id": "64c62aee-789e-38d6-9aa5-7355d4455d0a",
                        "entry_id": "110434a1-09a2-3caa-adcb-1da8057c649c",
                        "glosses": [
                            "пробуя, съесть или выпить немного; попробовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0de242b-0712-4a4b-a7d7-87ca35a3d2bd",
                                "sense_id": "64c62aee-789e-38d6-9aa5-7355d4455d0a",
                                "text": "Всем хотелось поскорее оказаться на берегу и отведать редкого лакомства, которое в те времена подавали только к королевскому столу, а тут его были целые горы."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eea2610-3f68-39e3-a635-106e52b7d8b0",
                        "entry_id": "110434a1-09a2-3caa-adcb-1da8057c649c",
                        "glosses": [
                            "испытать на опыте, познать (обычно плохое)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214513bd-7dc4-4bf4-bec8-139f5a91fd6f",
                                "sense_id": "3eea2610-3f68-39e3-a635-106e52b7d8b0",
                                "text": "Немало горя пришлось ему с тех пор отведать."
                            }
                        ]
                    }
