                "senses": [
                    {
                        "sense_id": "8ff3cb31-6fdd-3cbd-ba0e-fea24a2832f1",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "One who or that which lags behind; a laggard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3139ec99-d879-4e4e-bc72-df2545e41d9b",
                                "sense_id": "8ff3cb31-6fdd-3cbd-ba0e-fea24a2832f1",
                                "text": "The economic time series can be segregated into leaders, laggers and coinciders in relation to movements in aggregate economic activity."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc0055aa-5aae-328e-bb40-3430bc941da2",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "One who installs lagging."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b793a9f-fb66-4d3f-9a0a-f5a24c03aa9c",
                                "sense_id": "cc0055aa-5aae-328e-bb40-3430bc941da2",
                                "text": "In particular, Turner & Newall doggedly contested any claims from the largest high-risk group outside the scheduled factory areas — the laggers."
                            }
                        ]
                    },
                    {
                        "sense_id": "2db0d17a-4509-3d60-b076-36d195c74d0e",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "A player who lags (has a poor or slow network connection)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fa0c68cb-d774-3893-8dcc-788b64365aed",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "A marker used in the game of hopscotch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c87875-3597-4698-961c-dcc3ecdaea3e",
                                "sense_id": "fa0c68cb-d774-3893-8dcc-788b64365aed",
                                "text": "2015 Kathleen, Kage, and the Company, Laggers.\nLaggers, Dear Readers, in case you grew up ignorant of hopscotch, are the markers you use when playing the game."
                            },
                            {
                                "example_id": "ec07f53d-0849-4585-9ce3-0166830a4477",
                                "sense_id": "fa0c68cb-d774-3893-8dcc-788b64365aed",
                                "text": "In the 1950s, the game was called hopscotch and the object thrown a lagger /'lagar/. Lagger is apparently related to the verb lag."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f17332e-0c99-3fe1-b817-781f45630172",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "A police informant."
                        ],
