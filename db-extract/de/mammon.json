                                "target_senses": [
                                    {
                                        "sense_id": "f036da6c-e42b-365c-85f3-cd0e48870679",
                                        "entry_id": "4eafbf6d-9c9a-35f6-9254-e74f0937ad16",
                                        "glosses": [
                                            "утроба, брюхо, желудок как символ алчности, обжорства, стяжательства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
