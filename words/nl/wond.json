                    "sense_id": "b5629f06-4118-3ebb-8138-24c8b338eef4",
                    "sense_definition": "een beschadiging van het levende weefsel van een lichaam",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichamelijk letsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door zijn val had hij een diepe <w>wond</w> in zijn been.",
                            "target_lang_translations": {
                                "en": "Because of his fall, he had a deep <w>wound</w> in his leg."
                            }
                        },
                        {
                            "text": "De verpleegster maakte de <w>wond</w> voorzichtig schoon met een ontsmettend middel.",
                            "target_lang_translations": {
                                "en": "The nurse carefully cleaned the <w>wound</w> with a disinfectant."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonde"
