                            "duifachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "61450f34-4798-4fb2-8c4b-0d4977a0e4a0",
                                "sense_id": "0a4ed4f6-9042-3917-b78f-42c3fb829c00",
                                "text": "Twee grote ravioli, gevuld met boerenkool, lagen in een fijne en tegelijk krachtige consommé van bosduif, verrijkt met kleine Aziatische paddenstoelen en snippers gerookt rundvlees."
                            },
                            {
                                "example_id": "08d99706-c5d3-442a-86e2-b48b30eca095",
                                "sense_id": "0a4ed4f6-9042-3917-b78f-42c3fb829c00",
                                "text": "Kook het braadvocht los met een scheutje water, zeef en klop op met koude boter. Kruid de saus met peper en zout. Verdeel de karnemelkpuree, schorseneren en bosduif over borden. Werk af met de saus."
                            }
                        ]
                    }
