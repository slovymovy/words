                                        "entry_id": "aef9b006-5b1f-3572-874a-a4f50d1296d6",
                                        "glosses": [
                                            "materiał łatwopalny uzyskiwany z hub, stosowany do rozniecania ognia za pomocą krzesiwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d58274-5d3d-4b21-a351-c3b50b4caded",
                                                "sense_id": "8a00a3c6-66a8-3e89-bf82-fced58be1276",
                                                "text": "Kobieta dmucha na nią delikatnie, a kiedy hubka się zapala, dotyka nią przygotowanej słomy, nie przestając dmuchać"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
