                    },
                    {
                        "translation_id": "2af88792-7a7c-4f63-bdbc-7d30f910aacd",
                        "source_entry_id": "2ca8d937-e832-30f1-b3fe-a74294501333",
                        "source_sense_id": "df8c9586-5b32-3fff-a235-c547d1ab9374",
                        "source_sense_description": "to see again",
                        "target_lang_word": "revoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a30d8216-043e-3d8e-87ee-649e57e66b4d",
                                        "entry_id": "7cf803cf-1e45-3c59-be13-045b2254af0b",
                                        "glosses": [
                                            "Voir de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2cf20d-896f-47d5-94e3-4829ab5713c0",
                                                "sense_id": "a30d8216-043e-3d8e-87ee-649e57e66b4d",
                                                "text": "Quoi qu’il en soit, l’espérance de revoir le pauvre baron gai et gaillard m’a bien épargné de la tristesse."
                                            },
                                            {
                                                "example_id": "ee5bd76d-bd8d-4fc0-b0fe-b21e1dce0fbe",
                                                "sense_id": "a30d8216-043e-3d8e-87ee-649e57e66b4d",
                                                "text": "Albert et Ludwig se revirent avec plaisir, tous deux venaient de combattre contre les infidèles, l’un au midi, l’autre au nord."
                                            },
                                            {
                                                "example_id": "e16743e1-56bd-4917-9d9e-557e06c7b06d",
                                                "sense_id": "a30d8216-043e-3d8e-87ee-649e57e66b4d",
                                                "text": "Et je sais pourquoi ce soleil sur les choses et en moi : parce que je te reverrai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                        "entry_id": "7cf803cf-1e45-3c59-be13-045b2254af0b",
                                        "glosses": [
                                            "Examiner de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dda38ba3-7193-4839-968b-7763f80e61bb",
                                                "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                                "text": "Un cours créé en 2011 et revu en 2014."
                                            },
                                            {
                                                "example_id": "62caa1ed-3ca1-4eea-82f3-e23a0748de9e",
                                                "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                                "text": "Revoir un manuscrit, un ouvrage pour le corriger."
                                            },
                                            {
                                                "example_id": "c570e816-7d04-41d8-9d88-5582609d4dae",
                                                "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                                "text": "Revoir des épreuves, un compte."
                                            },
                                            {
                                                "example_id": "49c693b6-0ac1-4b00-94cf-76ef8dd9552b",
                                                "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                                "text": "Obtenir un arrêt pour faire revoir un procès."
                                            },
                                            {
                                                "example_id": "b541fea0-8145-4317-a3e6-4f7a90021eb5",
                                                "sense_id": "2faf5ffe-e67f-391d-aec6-734966d2e7a7",
                                                "text": "C’est un homme qui examine les choses avec soin ; après lui il n’y a plus à revoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65eef938-7c19-366f-8654-eabcbfb92120",
                                        "entry_id": "7cf803cf-1e45-3c59-be13-045b2254af0b",
                                        "glosses": [
                                            "Prendre connaissance de la force du cerf, par le pied, les fumées, les abattures, les portées, les foulées, le frayoir, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f855d1-810b-4e56-a566-0435a1cca3c4",
                                                "sense_id": "65eef938-7c19-366f-8654-eabcbfb92120",
                                                "text": "Il faut que les piqueurs aient l’œil à terre dans tous les lieux où ils croiront de pouvoir en revoir, afin d’aider à leurs chiens, & s’assurer que c’est le cerf de la meute qu’ils chassent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f32a4484-c58d-3635-8748-b3a5416b1a3a",
                                        "entry_id": "7cf803cf-1e45-3c59-be13-045b2254af0b",
                                        "glosses": [
                                            "Se souvenir de son passé."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e68c55bf-d32f-4e21-9b04-271cf8b38def",
                                                "sense_id": "f32a4484-c58d-3635-8748-b3a5416b1a3a",
                                                "text": "Pour elle j’étais l’amant, non le séducteur; elle revoyait son premier rendez-vous, elle ressentait le premier baiser; elle se revirginisait! Pauvre Gretchen!"
                                            },
                                            {
                                                "example_id": "cbeb46ab-1b55-4b74-87af-b840e5bb982a",
                                                "sense_id": "f32a4484-c58d-3635-8748-b3a5416b1a3a",
                                                "text": "Les premiers souvenirs de Louis Pasteur dataient de cette époque. Il se revoyait enfant, heureux de courir sur la route qui conduit au village d’Aiglepierre."
                                            },
                                            {
                                                "example_id": "e0f75799-01e0-4c54-992b-bf79b6b01495",
                                                "sense_id": "f32a4484-c58d-3635-8748-b3a5416b1a3a",
                                                "text": "Je me revois tout chétif, tout mièvre, suivant les cours du catéchisme, où j’arrivais bon premier. Ma piété, mon application épataient le bon curé."
                                            },
                                            {
                                                "example_id": "7927e007-d179-484c-b488-1e3e01969b96",
                                                "sense_id": "f32a4484-c58d-3635-8748-b3a5416b1a3a",
                                                "text": "Il se mit à boire plus que la normale, faisant livrer des cubis de bon pinard (en quantité ça coûte moins cher) toujours en perce à la souillarde, et je me revois échapper à la tablée bruyante et discordante où il s’échauffait en parlant politique […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                        "entry_id": "8e2ab62a-49fb-39cd-8d09-5f966cf17f79",
                                        "glosses": [
                                            "Action de voir à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cde1e85-c333-4316-8679-57ff62e9d451",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Adieu jusqu’au revoir. — Il m’a dit à revoir."
                                            },
                                            {
                                                "example_id": "353ddefc-1e5e-46b1-94c9-62ffa013324a",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Mais, au jour du revoir, une porte s’ouvre et l’enclos renaît et le tulipier fleurit, même au cœur du plus âpre hiver."
                                            },
                                            {
                                                "example_id": "77d41b6b-911e-4aff-be4b-22a074bd618b",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Je devais retrouver mes cousines le lendemain, au temple, et cela seul occupait mes pensées ; car mon esprit d’enfant attachait une grande importance à cette sanctification de notre revoir."
                                            },
                                            {
                                                "example_id": "430e0d44-c531-4e7c-bfe1-cabaeb4b0e62",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Du reste, la perspective d’un très prochain revoir enlevait à mon adieu ce qu’il eût pu avoir de tragique."
                                            },
                                            {
                                                "example_id": "b4cc27f7-53c2-4c95-b7ed-cb0f5690f812",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Pour Port-Vendres ne sais rien encore pour la bonne raison que ne peux guère avoir ma permission précisée d’avance mais vais tâcher de profiter de ma situation de brigadier fourrier pour hâter ce revoir."
                                            },
                                            {
                                                "example_id": "8d521bd6-2518-4984-9da6-98b44923d404",
                                                "sense_id": "47cda029-c79b-3452-8b99-1190607cec48",
                                                "text": "Ces quelques heures lui avaient donc suffi pour épuiser la joie du revoir, attendue depuis trois mois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44717107-2e67-4f44-b845-c9f00d0651dc",
                        "source_entry_id": "2ca8d937-e832-30f1-b3fe-a74294501333",
                        "source_sense_id": "df8c9586-5b32-3fff-a235-c547d1ab9374",
