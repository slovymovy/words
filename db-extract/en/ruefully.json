                        "glosses": [
                            "In a rueful manner; causing, feeling, or expressing regret or sorrow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a92e395-d0ef-4184-8c9d-cbb01b375423",
                                "sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                                "text": "He smiled ruefully at me."
                            },
                            {
                                "example_id": "ff0a261b-8363-41bb-8663-af68722bd2e0",
                                "sense_id": "6f2ebf48-72b3-3b01-b45a-1ae81f00eb03",
                                "text": "He pushed his straw hat back, scratched his head, and laughed ruefully."
                            }
                        ]
                    }
                ],
