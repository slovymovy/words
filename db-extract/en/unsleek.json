                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb8d71c-6b78-4d73-b9a2-618d42be8895",
                                "sense_id": "2ff1f271-5a4b-3fdc-84ba-d666f1c0dcf0",
                                "text": "Then she that saw him lying unsleek, unshorn, Gaunt as it were the skeleton of himself, Uttered a little tender dolorous cry."
                            },
                            {
                                "example_id": "5f14a112-2f18-4e84-ad7f-bef0b4960633",
                                "sense_id": "2ff1f271-5a4b-3fdc-84ba-d666f1c0dcf0",
                                "text": "Bruce Nauman uses neon not to advertise a product or service but to make absurd or insulting proclamations, and his fiberglass is heavy and unsleek."
                            },
                            {
                                "example_id": "23253bba-59d6-4ab9-bf37-458a41d2d0ca",
                                "sense_id": "2ff1f271-5a4b-3fdc-84ba-d666f1c0dcf0",
                                "text": "Photographs of the unsleek, inland-dwelling and mostly male clique that, with various cast shifts, has developed the Onion sensibility over 20 years, beginning at the University of Wisconsin, reveal a Midwestern chain gang that seems to know exactly what they’re about."
                            }
                        ]
