                ],
                "senses": [
                    {
                        "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                        "entry_id": "74afe820-897e-3325-a779-e1181df69864",
                        "glosses": [
                            "Tabelle, in der Vorfälle bei Eintreten eines Zustandes und die ihnen zugewiesenen Attributswerte enthalten sind"
                        ],
                        "tags": [
                            "Stochastik",
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "5ae92bcf-79a9-480d-b3ee-d4a6f4aa6d36",
                                "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                                "text": "„Sie können neue Fälle, Attribute oder Attributswerte in die Fallmatrix importieren.“"
                            },
                            {
                                "example_id": "5586e479-9b29-4368-9551-d310719f0a72",
                                "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                                "text": "„Als bedeutsam wurde die Gewichtung der Interprofessionalität in Gesundheitsfachberufen hervorgehoben (BIBB), womit u.a. eine konkrete Anknüpfungsperspektive an das Vorgängerprojekt AQiG aufgezeigt wird, z.B. an die hier entstandene heuristische Fallmatrix zur Unterrichtsplanung (vgl. z.B. Sieger et al. 2010, S.209).“"
                            },
                            {
                                "example_id": "860df6e6-3ffc-4119-ab0a-8e605debb746",
                                "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                                "text": "„Die hieraus gewonnenen Erkenntnisse fließen ein in die Heuristische Fallmatrix als Instrument für die Bildungspraxis.“"
                            },
                            {
                                "example_id": "1ce1d1be-0f49-4cb8-94aa-f765ff2083e1",
                                "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                                "text": "„Diese erweiterte Fallmatrix besteht aus fünf Kapiteln: Kommunikationsthemen, Literacy Instruction, Inhalt Instruction, Learner Unterschiede und Bildungsplanung.“"
                            },
                            {
                                "example_id": "3269cd24-07c4-4c9e-baed-0ae93491aaea",
                                "sense_id": "6c5ad68b-de9b-3d9e-b76b-7d8420400b08",
                                "text": "Die Gesamtnetzwerkmatrizen wurden gebildet, indem darin alle einzelnen Fallmatrizen eingetragen wurden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
