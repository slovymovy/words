                            {
                                "example_id": "8a2f83ce-ffea-4c3a-a8ac-3e6abdc109ea",
                                "sense_id": "b402f01e-9e09-32ec-82bf-8cf0fa202b39",
                                "text": "Побойся бога!",
                                "translation": "Aie la crainte de Dieu !"
                            },
                            {
                                "example_id": "cd16b26b-59a1-4b50-bd53-4846ebbda23a",
                                "sense_id": "b402f01e-9e09-32ec-82bf-8cf0fa202b39",
                                "text": "Я не побоюсь сказать ему всю правду.",
                                "translation": "Je ne crains pas de lui dire toute la vérité."
                            },
                            {
                                "example_id": "0ace8589-7cbc-40ce-be82-200e010b7ae8",
                                "sense_id": "b402f01e-9e09-32ec-82bf-8cf0fa202b39",
                                "text": "Хотел пойти, да побоялся.",
                                "translation": "Il voulait venir, mais il a eu peur."
                            }
                        ]
