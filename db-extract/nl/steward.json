                                    {
                                        "sense_id": "a32734ec-e568-34c3-a55a-49cd554bd447",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "One who attends; one who works with or watches over someone or something."
