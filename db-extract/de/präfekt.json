                "senses": [
                    {
                        "sense_id": "447e7d67-2da9-31b9-865c-bbacad8e5b84",
                        "entry_id": "25135cb5-c5d1-3a1a-a8c6-090bd6f951d3",
                        "glosses": [
                            "hoher Beamter im Römischen Reich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4502b33-0dc2-399a-b1c4-d6e69e5f189b",
                        "entry_id": "25135cb5-c5d1-3a1a-a8c6-090bd6f951d3",
                        "glosses": [
                            "oberster Verwaltungsbeamter in Frankreich (Departement), Italien (Provinz), Japan und verschiedener anderer Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acab547d-0cfb-4d13-aeff-3de2f9b55a83",
                                "sense_id": "e4502b33-0dc2-399a-b1c4-d6e69e5f189b",
                                "text": "„Übrigens würde er dem Präfekten darüber Bericht erstatten.“"
                            },
                            {
                                "example_id": "fe9527c5-fee5-425e-8e31-102afe293a09",
                                "sense_id": "e4502b33-0dc2-399a-b1c4-d6e69e5f189b",
                                "text": "„Der Präfekt blieb neben dem Tisch stehen und tauchte den Gänsekiel in die Tinte, um etwas zu notieren.“"
                            },
                            {
                                "example_id": "63769dcc-bf30-40bf-bba5-e24db2efcf88",
                                "sense_id": "e4502b33-0dc2-399a-b1c4-d6e69e5f189b",
                                "text": "„Manchmal frage ich mich, was wohl der selbstherrliche Präfekt des Pariser Départements Seine dazu gesagt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c8e61f08-b8ec-31c8-a84c-0f8412b367bd",
                        "entry_id": "25135cb5-c5d1-3a1a-a8c6-090bd6f951d3",
                        "glosses": [
                            "katholischer Geistlicher mit besonderen Aufgaben in einer leitenden Position"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30385432-e41b-45c3-8def-631741a4542a",
                                "sense_id": "c8e61f08-b8ec-31c8-a84c-0f8412b367bd",
                                "text": "„Wenn uns der Präfekt alle im Bett sah, legte auch er sich hin.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "6a8273e1-2448-3a7b-b51f-e0724c811952",
