                        "source_entry_id": "16f059f8-1373-3fc5-8b84-fc04e14cfacf",
                        "source_sense_id": "58e72202-f06c-35c6-8ca4-8ab3eb7fdb1b",
                        "source_sense_description": "umgangssprachlich: jemand, der einem anderen etwas nicht gönnt, neidische Person",
                        "target_lang_word": "envieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                        "entry_id": "a2b4ee87-781d-3218-88c6-bd261575d273",
                                        "glosses": [
                                            "Qui a de l’envie, qui est sujet à l’envie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab5048-261e-4c2c-b69b-bd636be3a774",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Il est envieux de ma bonne fortune."
                                            },
                                            {
                                                "example_id": "bc3112e2-b08c-4872-b9cf-4adc4fe3f37f",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Envieux du bien d’autrui."
                                            },
                                            {
                                                "example_id": "7191c727-e314-49d7-8631-62e92a6cf79d",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Un esprit envieux."
                                            },
                                            {
                                                "example_id": "98daf1e8-bed7-44ef-a717-854b8d80afa3",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Un regard envieux."
                                            },
                                            {
                                                "example_id": "6eca1694-c51b-416c-bfa2-ecb6c6c72288",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "– Pourquoi être envieuse ? Je comprends pas qu’on soit envieuse du moment qu’on a sa part… pas vrai, Rose ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "envieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                        "entry_id": "c190dc56-9b11-386e-b0c8-739babf08c6f",
                                        "glosses": [
                                            "Personne qui envie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af0f4e6-d84d-4dc1-a6f8-3d9dbd7902ba",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Un envieux n’a jamais de repos."
                                            },
                                            {
                                                "example_id": "a7653817-4e22-4e6e-9ea1-c1c07174eed2",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Les envieux sont injustes."
                                            },
                                            {
                                                "example_id": "2b8fa4f6-9af7-4e97-ba64-2b094a60ed20",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "En dépit des envieux."
                                            },
                                            {
                                                "example_id": "e2cdb10b-11ab-4c08-8a25-8a0c0c034199",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Et alors lorsqu’un choix est ainsi ratifié par toute une Nation, que peuvent valoir les cris de quelques envieux ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2a0a0bf-5a67-4a86-bdae-43009712959c",
                        "source_entry_id": "16f059f8-1373-3fc5-8b84-fc04e14cfacf",
                        "source_sense_id": "58e72202-f06c-35c6-8ca4-8ab3eb7fdb1b",
                        "source_sense_description": "umgangssprachlich: jemand, der einem anderen etwas nicht gönnt, neidische Person",
                        "target_lang_word": "jaloux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaloux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui éprouve une envie se manifestant par le désir qu'une personne bénéficiant d'une situation perçue comme meilleure à la sienne perde son avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4315cf94-a187-4570-8656-16362d2ac8a1",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "La mort jalouse semblait vouloir que rien ne survécût de la jeune fille, pas même son image."
                                            },
                                            {
                                                "example_id": "7728ff91-b0ab-4a23-a427-0d0aa0fbe59b",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "On remarqua beaucoup, à Plassans, une série d’attaques dirigées par le fils contre les personnes que le père recevait chaque soir dans le fameux salon jaune. La richesse des Roudier et des Granoux exaspérait Aristide au point de lui faire perdre toute prudence. Poussé par ses aigreurs jalouses d’affamé, il s’était fait de la bourgeoisie une ennemie irréconciliable, lorsque l’arrivée d’Eugène et la façon dont il se comporta à Plassans vinrent le consterner."
                                            },
                                            {
                                                "example_id": "7f28db41-2dca-4316-8e96-b4adaaea007e",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "Le neveu du cheikh Gaafar, qui, tout jeune homme avait lorgné avec une admiration jalouse l’épouse de son oncle, s’enhardit jusqu’à demander sa main."
                                            },
                                            {
                                                "example_id": "8307573e-e802-404d-9949-499f1b8bfdf4",
                                                "sense_id": "0348c8de-ba1e-35e7-b0df-983d929b64b3",
                                                "text": "Il était jaloux. Comment peut-on être jaloux de quelqu'un qui n'a rien à voir avec vous? Parce qu'on est un jaloux . Toute gloire lui était une usurpation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui éprouve un agacement plus ou moins prononcé causé par le sentiment qu'une personne qu'on aime, aime elle-même — ou pourrait aimer — une autre personne, ou seulement en soit approchée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db654c79-0084-441e-9277-e3a0664d8066",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Si Titus est jaloux, Titus est amoureux."
                                            },
                                            {
                                                "example_id": "8a9f32a8-b0c1-4a79-9a3f-bfee8bbce14b",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Jalouse !… Je suis jalouse de tout ce qui t’approche. Pour que tes robes ne t’aient pas seule, je les mets quand tu les as portées."
                                            },
                                            {
                                                "example_id": "7f8f87ed-69c3-4b36-9263-c92ff4fe06ae",
                                                "sense_id": "0a3b44d2-5195-372a-b68c-c3a10a250be1",
                                                "text": "Il fallait me dire : « Tu vois, tous ces hommes ont à toi… », me laisser rêver que le monde entier m’appartenait, mais tu as refermé tes bras jaloux sur tout mon avenir, et je n’ai pas voulu, je n’ai pas pu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui tient beaucoup, qui est fort attaché à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8874782f-ce5e-48b5-b0b6-555bfa3275d5",
                                                "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                                "text": "L’esprit républicain, jaloux à l’excès de sa liberté, prend ombrage de tout ce qui peut lui donner des entraves et se révolte contre la seule idée d’un maître."
                                            },
                                            {
                                                "example_id": "06cd1e39-f9a1-40c2-bfed-22382137e55d",
                                                "sense_id": "f18bdcae-a598-342a-8533-62b359a83a9a",
                                                "text": "Il est jaloux du bâton de commandement qu’il tient dans sa main tremblante, et il sait bien que votre poing vigoureux est là pour l’étreindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f43aeb9-0102-3921-8273-82529c01b0b5",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qui a à cœur, qui est très désireux de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175a87d7-7eaa-4415-a46c-c3b6251cb654",
                                                "sense_id": "3f43aeb9-0102-3921-8273-82529c01b0b5",
                                                "text": "Je suis jaloux d’acquérir, de conserver votre estime. Je suis jaloux de vous prouver le désir que j’ai de vous servir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22790053-7836-3ce2-b969-dd4aac637357",
                                        "entry_id": "e3d064cf-4d59-3890-afe6-da50c904195d",
                                        "glosses": [
                                            "Qualifie un vaisseau qui roule énormément."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3288c0c0-7791-4aec-bb42-8188463c6654",
                                                "sense_id": "22790053-7836-3ce2-b969-dd4aac637357",
                                                "text": "La mauvaise galère qui roulait bord sur bord était jalouse, ne portait pas bien la voile et ne sentait pas la mer, tandis que la galère bien équilibrée était en estive, fine de voiles et s’abrivait à plaisir (elle conservait sa vitesse initiale — Zysberg — ), quand elle avait perdu son erre, elle était morte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaloux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0819c1a-f793-3912-848f-6a37d16a945c",
                                        "entry_id": "790c7c2f-3de8-3847-9d86-b4e145075fa5",
                                        "glosses": [
                                            "Celui qui a de la jalousie à propos de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2369ecf5-06a8-48e0-8f8f-50b4798a180a",
                                                "sense_id": "f0819c1a-f793-3912-848f-6a37d16a945c",
                                                "text": "Votre sort fait bien des jaloux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15175b15-8248-3ceb-a200-710ff00a0517",
                                        "entry_id": "790c7c2f-3de8-3847-9d86-b4e145075fa5",
                                        "glosses": [
                                            "Celui qui garde jalousement sa place, ses privilèges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a56a8ad-2008-4850-8f30-00898908574a",
                                                "sense_id": "15175b15-8248-3ceb-a200-710ff00a0517",
                                                "text": "Ô misère ! Ai-je dit à l’implacable Maître,\nAu Jaloux, tourmenteur du monde et des vivants,\nQui gronde dans la foudre et chevauche les vents :\nLa vie assurément est bonne, je veux naître !\nQue m’importait la vie au prix où tu la vends ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
