                ],
                "senses": [
                    {
                        "sense_id": "90e0d095-783b-3a61-bb6c-059d388039d3",
                        "entry_id": "24a62d33-b51f-304a-8f69-7bd32034ba42",
                        "glosses": [
                            "Manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b52a0fc-912a-4c55-96d7-d996ff4e2bd3",
                                "sense_id": "90e0d095-783b-3a61-bb6c-059d388039d3",
                                "text": "Un verbe assez laid a de nouveau cours aussi dans les cités, gameler, en gros remplir sa gamelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd1f3e9a-62d3-3ad0-accd-3a3caa90f963",
                        "entry_id": "24a62d33-b51f-304a-8f69-7bd32034ba42",
                        "glosses": [
                            "Faire un baiser en entrelaçant les langues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c171f2a-9f83-4cb2-b1de-7fa7193e6bb2",
                                "sense_id": "fd1f3e9a-62d3-3ad0-accd-3a3caa90f963",
                                "text": "Gameler, c'est quand le garçon met la langue dans la bouche de la fille et que les deux tournent leur langue dans le sens inverse."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccf1f711-dce0-3cab-8709-68fc4fd99317",
                        "entry_id": "24a62d33-b51f-304a-8f69-7bd32034ba42",
                        "glosses": [
                            "ou Tomber, chuter."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1bd29a3a-620d-4037-8e83-9a3bffebb104",
                                "sense_id": "ccf1f711-dce0-3cab-8709-68fc4fd99317",
                                "text": "Ce papa va se gameler avec son hoverboard, mais avec classe, en mode superman."
                            },
                            {
                                "example_id": "eaf011ee-d606-44cf-b5e0-536fe0c14a86",
                                "sense_id": "ccf1f711-dce0-3cab-8709-68fc4fd99317",
                                "text": "Avec les précédents singles comme autant de tour de chauffe, il était raisonnable de penser que The Wolfhounds n'allait pas se gameler."
                            },
                            {
                                "example_id": "b55a1bdc-2ba2-4685-a9ee-38671ae6fbe0",
                                "sense_id": "ccf1f711-dce0-3cab-8709-68fc4fd99317",
                                "text": "Bref, « segwit est en train de se gameler en beauté », c'est n'importe quoi."
                            },
                            {
                                "example_id": "5b89746a-e0d6-4298-9d17-baddac547080",
                                "sense_id": "ccf1f711-dce0-3cab-8709-68fc4fd99317",
                                "text": "Certains vont tourner, tourner, gameler, galérer."
                            }
                        ]
                    }
                ],
