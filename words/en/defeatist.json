{
    "word_family": [
        "defeatism",
        "defeat"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5ee870e-5109-3a41-8a08-73272983171d",
                    "sense_definition": "Showing a tendency to expect failure or to give up easily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>defeatist</w> attitude made the rest of the team feel like giving up.",
                            "target_lang_translations": {
                                "zh": "他那<w>失败主义的</w>态度让团队里的其他人也想放弃了。"
                            }
                        },
                        {
                            "text": "It is <w>defeatist</w> to assume you will fail before you even try.",
                            "target_lang_translations": {
                                "zh": "还没尝试就认定自己会失败，这是一种<w>失败主义的</w>想法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pessimistic",
                        "hopeless",
                        "resigned"
                    ],
                    "antonyms": [
                        "optimistic",
                        "determined"
                    ],
                    "common_phrases": [
                        "defeatist attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出容易预料失败或轻易放弃的倾向。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "失败主义的",
                                "target_lang_sense_clarification": "形容具有悲观、容易放弃态度的。"
                            },
                            {
                                "target_lang_word": "悲观的",
                                "target_lang_sense_clarification": "指对事物发展持消极看法。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27f50d93-e062-39fa-af98-6145b1935175",
                    "sense_definition": "A person who expects failure or gives up easily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not be a <w>defeatist</w> when faced with a difficult challenge.",
                            "target_lang_translations": {
                                "zh": "面对困难的挑战时，不要做一个<w>失败主义者</w>。"
                            }
                        },
                        {
                            "text": "The coach refused to listen to any <w>defeatists</w> on the team.",
                            "target_lang_translations": {
                                "zh": "教练拒绝听取队里任何<w>失败主义者</w>的言论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pessimist"
                    ],
                    "antonyms": [
                        "optimist"
                    ],
                    "target_lang_definitions": {
                        "zh": "预料会失败或轻易放弃的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "失败主义者",
                                "target_lang_sense_clarification": "指在困难面前容易丧失信心的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}