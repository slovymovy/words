                                        "examples": [
                                            {
                                                "example_id": "84f80c19-bb72-4d5b-b036-040b2e4c23a6",
                                                "sense_id": "2579fb30-254b-3fe8-83f5-31776b47bd9a",
                                                "text": "At first glance, one could critically dismiss The Wire as reflective of the banalization of violence, for violence is everywhere..."
