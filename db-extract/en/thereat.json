                                            {
                                                "example_id": "370a0c28-0b6c-4141-a0ad-e82381f1bf0d",
                                                "sense_id": "4661ce2c-53b9-3f43-b4a2-8a2c17c24eda",
                                                "text": "Hij keek daar maar even naar."
                                            }
