                                    {
                                        "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                        "entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
                                        "glosses": [
                                            "Messinstrument für den Wasserverbrauch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61aafe4d-3408-4461-b5d2-e5f0ea695c62",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Heute wird die Wasseruhr abgelesen."
                                            },
                                            {
                                                "example_id": "f207bc22-a19c-464d-a178-75d9e3695d48",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Mit Hilfe der Wasseruhr ermittelt der Versorger den Verbrauch und kann danach eine Rechnung stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                        "entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
                                        "glosses": [
                                            "Uhr, bei der der Abfluss von Wasser als Zeitmesser dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dadfd1e-2552-4561-8e84-ce2150ba773a",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Etwas später waren nur die dumpfen Töne der Wasseruhr vernehmbar.“"
                                            },
                                            {
                                                "example_id": "8e446278-eacf-472a-a87b-764a8f2b23eb",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Sie zeigte auf die neben dem Bett stehende Wasseruhr.“"
                                            },
                                            {
                                                "example_id": "2b110eff-93a9-4388-be88-f721372bf9f2",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Zur Stundenmessung dienen neben der nur nachts möglichen Sternobservation die Sonnenuhr und die Wasseruhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
