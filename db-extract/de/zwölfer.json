                            "singular"
                        ],
                        "form": "den Zwölfer"
                    },
                    {
                        "form_id": "f9a72778-69f1-4fab-bd3c-09a6a400fd19",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zwölfer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "etwas mit Größe, Wert, Maß oder Nummer zwölf"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "53e61e05-d855-4e9f-b5dd-85cd00a8f412",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "„Er riet, ich sollte mich auf den Rücken legen, rückte sogar eine alte Decke als Unterlage heraus und reichte mir die Schraubenschlüssel, den Dreizehner oder den Zwölfer.“"
                            },
                            {
                                "example_id": "3bbdc3dd-623d-49a2-b484-58fe3f18fca0",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "„Der Zwölfer flog mit gespreizten Armen in den Strafraum, überschlug sich und blieb auf.“"
                            },
                            {
                                "example_id": "50653ad7-dcea-418a-9713-9a8710f7d279",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "Welchen Schraubenschlüssel brauchst du? — Den Zwölfer!"
                            },
                            {
                                "example_id": "57b2fd36-22ed-4546-9396-86c67d053768",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "„An diesem Morgen stehe ich an der Bushaltestelle und warte auf den Zwölfer, der mich in Richtung Stadt bringen soll.“"
                            },
                            {
                                "example_id": "c124bb7f-0580-4530-9cb1-727a79eabdeb",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "„Wach machte es auch, stellte ich erfreut fest, stieg am Bahnhof mit neuer Munterkeit um und erwischte tatsächlich noch den Zwölfer nach Selling.“"
                            },
                            {
                                "example_id": "80e1bcfe-1aa4-45dc-ae9f-af2f65e18933",
                                "sense_id": "bfd5129e-046d-368b-a337-ff9423ba9052",
                                "text": "„»Nimm lieber den Zwölfer«, sagte Pieper. Er griff in die Werkzeugkiste und hielt Vandreyke einen anderen Schraubenschlüssel hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28b8addd-784c-3928-a2c3-22b9d4691580",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "höchste Gewinnstufe beim Toto"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "3aedd48e-11d5-49af-97b6-4b2503d3ccbf",
                                "sense_id": "28b8addd-784c-3928-a2c3-22b9d4691580",
                                "text": "Ich würde gerne mal einen Zwölfer tippen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "Schüler der zwölften Klasse"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "be09a507-3820-40b3-9264-8e68f5c077be",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "Meine Zwölfer haben mich heute wieder geärgert."
                            },
                            {
                                "example_id": "baeab900-60fb-40e1-86f9-61cea3d8bc94",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "„Noch eine Woche, dann sind die Zwölfer mit der Schule fertig.“"
                            },
                            {
                                "example_id": "ae56174a-23f6-4af9-a70f-22e69f97adbf",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "„Durch die Verabschiedung des 13. Jahrgangs vollzieht sich ein Übergang auch für die Zwölfer, die nun den neuen Abschlussjahrgang bilden.“"
                            },
                            {
                                "example_id": "16f4c457-09a5-4909-93ad-2b36ab532d0c",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "„Doch selbst die Zwölfer, die bereits mit ihrer Ausbildung begonnen hatten und an der Schwelle ins Erwachsenenleben standen, mussten noch endlose Listen mit Regeln auswendig lernen und wurden mit der neuesten Technologie vertraut gemacht.“"
                            },
                            {
                                "example_id": "181d1654-3279-4dc7-8ce0-43b95edc157b",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "„Der Direktor schnauzte mächtig die Zwölfer an, die im vorigen Jahr in der Pause lieber Skat gespielt hatten, statt sich auf den Unterricht vorzubereiten. Die Schule selbst ein Musterbeispiel an sozialistischer Fehlkonstruktion.“"
                            },
                            {
                                "example_id": "44863740-82f3-4050-8d3e-34ff0524054f",
                                "sense_id": "1e394a1e-bab6-3d90-8cb5-75d7c46c3980",
                                "text": "„Die Zwölfer, deren Leistungskurs er jetzt noch hätte, waren auf Geschichts-Exkursion in Berlin, somit hatte er für heute frei.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9a14a206-57a9-3dbd-9fd6-e1b6a65fbad4",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "Geldstück mit dem Wert von zwölf Währungseinheiten"
                        ],
                        "tags": [
                            "outdated",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "fcb56cf8-88d8-4a72-abf7-abcb4380752c",
                                "sense_id": "9a14a206-57a9-3dbd-9fd6-e1b6a65fbad4",
                                "text": "Er hatte einen ganzen Sack voll Zwölfer dabei."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "9ff55985-6e8d-3581-bc86-74914b3cbdc4",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "die Zahl 12 selbst"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "85ebe895-3647-4919-9bea-4ee1958f07ed",
                                "sense_id": "9ff55985-6e8d-3581-bc86-74914b3cbdc4",
                                "text": "Ein Zwölfer besteht aus einer Eins und einer Zwei."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "6d3b7ac7-839f-3fad-9b77-930d63136962",
                        "entry_id": "2d31a9be-325c-31f9-851f-8a2635444b29",
                        "glosses": [
                            "eine von zwölf Personen, die ein Ganzes ausmachen, zum Beispiel Mitglied eines Zwölfergerichts oder einer Ausschussbehörde"
                        ],
