                "senses": [
                    {
                        "sense_id": "bece3c71-74ea-30f9-b761-be3ef726871a",
                        "entry_id": "861c6240-1f98-36b8-b343-031037ef89e5",
                        "glosses": [
                            "der dünne, flächige, aus Stahl hergestellte Teil der Schneideinrichtung einer Säge, der am Rand mit den Sägezähnen ausgerüstet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cc5301-e761-4da5-aa75-1b4efa97ed2d",
                                "sense_id": "bece3c71-74ea-30f9-b761-be3ef726871a",
                                "text": "Das Sägeblatt muss ausgewechselt werden."
                            },
                            {
                                "example_id": "ec668ed5-608a-4297-a316-573012c0fc0d",
                                "sense_id": "bece3c71-74ea-30f9-b761-be3ef726871a",
                                "text": "„Er zeigt mir, wie es gemacht wird, wie man den Stamm legen muß, damit seine Spannung das Sägeblatt nicht einklemmt, sondern freigibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
