                                                "sense_id": "b6869fc1-9351-39b8-8d5a-d8d5efe3df65",
                                                "text": "I dare not whisper to myself a pension on this side of absolute incapacitation and infirmity, till years have sucked me dry."
                                            },
                                            {
                                                "example_id": "7d6efd8d-80d4-4949-a6f0-44b55ce47911",
                                                "sense_id": "b6869fc1-9351-39b8-8d5a-d8d5efe3df65",
                                                "text": "The incapacitation of South Dakota Senator Tim Johnson has put all eyes in Washington on what is normally a little-noticed Senate vote now scheduled for Jan. 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b2bb02-c529-30dd-8b83-c07a02309d9d",
                                        "entry_id": "3ace12a1-88ad-387b-9e15-246528c693cb",
                                        "glosses": [
                                            "The act of incapacitating or state of being incapacitated; incapacity; disqualification.",
                                            "The imprisonment of a would-be offender, which prevents them from offending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
