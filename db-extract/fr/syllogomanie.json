                    },
                    {
                        "translation_id": "9852cf58-5d3f-47da-8233-8e52c6095c45",
                        "source_entry_id": "bfd6e96b-f2d8-3cef-903c-4fd78fa305d8",
                        "source_sense_id": "b71bef5b-630c-3c45-8e56-89d4b222ecc5",
                        "target_lang_word": "syllogomania",
