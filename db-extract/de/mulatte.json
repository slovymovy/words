                ],
                "senses": [
                    {
                        "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                        "entry_id": "8b5818aa-c899-3cb8-8e6e-30e6ff009662",
                        "glosses": [
                            "Mensch mit einem schwarzen und einem weißen Elternteil"
                        ],
                        "tags": [
                            "teilweise als diskriminierend wahrgenommen"
                        ],
                        "examples": [
                            {
                                "example_id": "4bfbad97-6c0b-4b7d-a944-23281cc201b1",
                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                "text": "In der Karibik gibt es sehr viele Mulatten."
                            },
                            {
                                "example_id": "03ce1a5b-271f-4c2e-99ff-b7f485e3e721",
                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                "text": "„Mulatten waren schon von Anfang an zugelassen gewesen und hatten dieses Gremium sehr schnell dominiert; Menschen jedoch, in deren Adern kein Tropfen portugiesisches Blut floss, hatten hart um ihre Aufnahme kämpfen müssen.“"
                            },
                            {
                                "example_id": "320b8c74-f14f-497e-9bec-1b7c7438dceb",
                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                "text": "„Hallo und Mintzlaff waren aus dem Kurhaus in eine Bar übersiedelt, die ›Chez nous‹ hieß und in der eine aus Negern und Mulatten bestehende Tanzkapelle am Werke war.“"
                            },
                            {
                                "example_id": "1cdbb361-099e-453c-b033-af60d9f80776",
                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                "text": "„In der Wissenschaft kennt man die einfache Rassenmischung zwischen Weiß und Schwarz, siehe die Mulatten und Mischlinge der Antillen.“"
                            },
                            {
                                "example_id": "9b6b38f5-5dde-454e-b76c-630155a4e46f",
                                "sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                                "text": "„Dennoch bekamen wir nur zwei Bediente zu Gesicht, und zwar einen jungen Mulatten und eine Mulattin gleichen Alters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76468dfd-d448-4c8e-ba93-2e7eb3f06083",
                        "source_entry_id": "8b5818aa-c899-3cb8-8e6e-30e6ff009662",
                        "source_sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
                        "source_sense_description": "teilweise als diskriminierend wahrgenommen: Mensch mit einem schwarzen und einem weißen Elternteil",
                        "target_lang_word": "mulatto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mulatto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5100079a-5919-3822-900b-2673f1feea16",
                                        "entry_id": "c631765c-3924-3957-9911-305cc517ceb8",
                                        "glosses": [
                                            "A person of mixed black and white descent, especially a person with one black and one white parent or two mulatto parents."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "historical",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d5e3a2b-0802-44a5-8fb1-46e6aa6c9864",
                                                "sense_id": "5100079a-5919-3822-900b-2673f1feea16",
                                                "text": "Respectable folk who did not want trouble stayed withindoors; but young apprentices were abroad in force; Negroes and mulattoes; rope- makers and laborers from along the waterfront; and sailors hastening ashore from the ships […]"
                                            },
                                            {
                                                "example_id": "c044d0cb-9420-43a2-a8a9-3ecf164cc8f8",
                                                "sense_id": "5100079a-5919-3822-900b-2673f1feea16",
                                                "text": "The supermodelesque mulatto woman licked her lips and smiled invitingly."
                                            },
                                            {
                                                "example_id": "ec1b34fd-626c-4aee-8c5d-c1db54f0207a",
                                                "sense_id": "5100079a-5919-3822-900b-2673f1feea16",
                                                "text": "The official mouthpiece of the Rosas government, La Gaceta Mercantil, praised Afro-Argentines as “valiant defenders of liberty who have won fame and glory in a hundred battles,” adding that “General Rosas so appreciates the mulattos and morenos that he has no objection to seating them at his table and eating with them.”\nIn other respects, however, the persistence of racism against Afro-Argentines, Indians, and gauchos showed regrettable continuities with the colonial past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea5b09fb-9928-4dad-b2c8-c594a88c6e90",
                        "source_entry_id": "8b5818aa-c899-3cb8-8e6e-30e6ff009662",
                        "source_sense_id": "01f62510-c3b1-3488-b95e-9cdb1d23bbd4",
