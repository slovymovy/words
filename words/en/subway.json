    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23cc163c-cf37-3810-9e85-c7401b059a8d",
                    "sense_definition": "An underground railway system used for mass transit in urban areas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He takes the <w>subway</w> to work every morning to avoid traffic.",
                            "target_lang_translations": {
                                "ru": "Он ездит на <w>метро</w> на работу каждое утро, чтобы избежать пробок.",
                                "zh": "他每天早上都<w>坐地铁</w>去上班，以避开交通拥堵。"
                            }
                        },
                        {
                            "text": "The new <w>subway</w> station is located right next to the museum.",
                            "target_lang_translations": {
                                "ru": "Новая станция <w>метро</w> находится прямо рядом с музеем.",
                                "zh": "新的<w>地铁</w>站就在博物馆旁边。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metro",
                        "underground",
                        "tube",
                        "rapid transit"
                    ],
                    "common_phrases": [
                        "take the subway",
                        "subway station",
                        "subway line",
                        "on the subway",
                        "subway map"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система подземного железнодорожного транспорта для массовых перевозок в городских районах.",
                        "zh": "城市中用于大众运输的地下铁路系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метро́",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "подзе́мка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "метрополите́н",
                                "target_lang_sense_clarification": "официальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地铁",
                                "target_lang_sense_clarification": "通用名称"
                            },
                            {
                                "target_lang_word": "地下铁",
                                "target_lang_sense_clarification": "较正式的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a50734b3-4519-3b76-bbbc-53988d982d33",
                    "sense_definition": "An underground tunnel for pedestrians to cross a road or railway safely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walkway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is safer to use the <w>subway</w> than to run across the busy highway.",
                            "target_lang_translations": {
                                "ru": "Безопаснее воспользоваться <w>подземным переходом</w>, чем перебегать оживленное шоссе.",
                                "zh": "走<w>地下通道</w>比横穿繁忙的公路更安全。"
                            }
                        },
                        {
                            "text": "The pedestrian <w>subway</w> was well lit and clean.",
                            "target_lang_translations": {
                                "ru": "Пешеходный <w>подземный переход</w> был хорошо освещен и чист.",
                                "zh": "这条行人<w>地下通道</w>灯火通明且干净整洁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "underpass"
                    ],
                    "common_phrases": [
                        "pedestrian subway",
                        "use the subway",
                        "through the subway"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземный туннель для безопасного перехода пешеходов через дорогу или железнодорожные пути.",
                        "zh": "供行人安全穿过道路或铁路的地下通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзе́мный перехо́д",
                                "target_lang_sense_clarification": "пешеходный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地下通道",
                                "target_lang_sense_clarification": "行人专用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8775d6c1-0c6f-3a56-b9fb-781cfb6eb07a",
                    "sense_definition": "An underground channel or tunnel used to house pipes, cables, or sewers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers accessed the electrical cables through a service <w>subway</w>.",
                            "target_lang_translations": {
                                "ru": "Инженеры добрались до электрических кабелей через служебный <w>технический туннель</w>.",
                                "zh": "工程师通过一条检修<w>地下管廊</w>进入了电缆区域。"
                            }
                        },
                        {
                            "text": "The old brick <w>subway</w> carries water pipes beneath the city streets.",
                            "target_lang_translations": {
                                "ru": "Старый кирпичный <w>коллектор</w> несет водопроводные трубы под городскими улицами.",
                                "zh": "这条古老的砖砌<w>地下管道</w>在城市街道下方输送水管。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземный канал или туннель, используемый для прокладки труб, кабелей или канализации.",
                        "zh": "用于容纳管道、电缆或下水道的地下通道或隧道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коллектор",
                                "target_lang_sense_clarification": "технический канал"
                            },
                            {
                                "target_lang_word": "технический туннель",
                                "target_lang_sense_clarification": "инженерное сооружение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地下管廊",
                                "target_lang_sense_clarification": "工程设施"
                            },
                            {
                                "target_lang_word": "地下管道",
                                "target_lang_sense_clarification": "技术通道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "042e2b74-0bd8-31da-8ab5-f52cfa85b7b0",
                    "sense_definition": "To travel to a destination using an underground railway system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>subway</w> downtown instead of taking a taxi.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>поехать на метро</w> в центр города вместо того, чтобы брать такси.",
                                "zh": "我们决定<w>坐地铁</w>去市中心，而不是打车。"
                            }
                        },
                        {
                            "text": "She <w>subwayed</w> across the city to meet her friends for dinner.",
                            "target_lang_translations": {
                                "ru": "Она <w>поехала на метро</w> через весь город, чтобы встретиться с друзьями за ужином.",
                                "zh": "她<w>坐地铁</w>穿过全城去和朋友吃晚饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "subway around town"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать куда-либо, используя систему подземного железнодорожного транспорта.",
                        "zh": "乘坐地铁前往某地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на метро",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "добираться на метро",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坐地铁",
                                "target_lang_sense_clarification": "交通方式"
                            },
                            {
                                "target_lang_word": "乘地铁",
                                "target_lang_sense_clarification": "较正式的表达"
                            }
                        ]
                    }
                }
            ]
        }
