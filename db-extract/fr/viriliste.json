                "senses": [
                    {
                        "sense_id": "8cae1891-dc11-30b7-a8c3-981413d47f5d",
                        "entry_id": "1e24c1b3-7284-3564-a876-44a1a015b867",
                        "glosses": [
                            "Adepte du virilisme comme idéologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebaf192-ca23-4fe2-af69-9a0fcac9af20",
                                "sense_id": "8cae1891-dc11-30b7-a8c3-981413d47f5d",
                                "text": "Les virilistes sont masculinistes, mais tous les masculinistes ne sont pas virilistes. Ce que défendent ces derniers ? Une image de l'homme fort, courageux et dominant - vis-à-vis des femmes mais aussi des autres hommes."
                            },
                            {
                                "example_id": "5b904214-78ca-4df2-bb27-7ee2c7e9a189",
                                "sense_id": "8cae1891-dc11-30b7-a8c3-981413d47f5d",
                                "text": "Pour montrer leur aversion du monde scolaire, certains jeunes virilistes multiplient les conduites d’indiscipline et d’incivilité. Confronter un enseignant ou le narguer constitue pour eux des signes de virilité."
                            }
                        ]
                    }
