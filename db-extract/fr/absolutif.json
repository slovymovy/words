                    },
                    {
                        "translation_id": "4c6d9dba-2d0a-4814-8820-b348308137b9",
                        "source_entry_id": "dba83862-995a-3736-be0a-7a1252e293b3",
                        "source_sense_id": "8b18f00d-f40d-3869-b9e4-eed6d556be8c",
