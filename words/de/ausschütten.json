                {
                    "sense_id": "d1501b94-6f10-3791-8f58-d64632d2aa15",
                    "sense_definition": "Eine Flüssigkeit oder Schüttgut durch Neigen des Behälters herausfließen lassen oder entleeren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ausleeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>schüttete</w> das schmutzige Wasser nach dem Putzen einfach im Garten <w>aus</w>."
                        },
                        {
                            "text": "Pass bitte auf, dass du den vollen Eimer nicht versehentlich auf dem Teppich <w>ausschüttest</w>."
                        }
                    ],
                    "synonyms": [
                        "ausgießen"
                    ],
                    "common_phrases": [
                        "einen Eimer ausschütten",
                        "schmutziges Wasser ausschütten"
                    ]
                },
                {
                    "sense_id": "356ac8c8-0a37-30db-959e-92bc5c1ba022",
                    "sense_definition": "Erwirtschaftete Gewinne oder Dividenden an Teilhaber, Aktionäre oder Berechtigte auszahlen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das erfolgreiche Unternehmen wird dieses Jahr eine hohe Dividende an seine Aktionäre <w>ausschütten</w>."
                        },
                        {
                            "text": "Der Vorstand beschloss, nur einen Teil des Gewinns an die Anleger <w>auszuschütten</w>."
                        }
                    ],
                    "synonyms": [
                        "auszahlen"
                    ],
                    "common_phrases": [
                        "eine Dividende ausschütten",
                        "Gewinne ausschütten"
                    ]
                }
            ]
        },
        {
