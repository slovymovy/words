            {
                "entry_id": "cf79265f-ce15-364e-8c47-d75934477479",
                "word": "normie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c99e5efc-f988-4fbd-be81-5c4e0a8804cb",
                        "entry_id": "cf79265f-ce15-364e-8c47-d75934477479",
                        "tags": [
                            "plural"
                        ],
                        "form": "normies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "285358c0-fb6f-32e3-8e2a-8d929106a792",
                        "entry_id": "cf79265f-ce15-364e-8c47-d75934477479",
                        "glosses": [
                            "A normal person; one with commonly held, normative beliefs, neurology, tastes or interests."
                        ],
                        "tags": [
                            "Internet",
                            "derogatory",
                            "slang",
                            "sometimes",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "aa30ab23-6b1e-4d22-ba0b-669c1f3f4b77",
                                "sense_id": "285358c0-fb6f-32e3-8e2a-8d929106a792",
                                "text": "This place is a sure cure for a gimp's feeling out of place and a sure cure for a normie feeling awkward around a wheelchair."
                            },
                            {
                                "example_id": "bf829297-0fc7-48e0-822c-9ed3a3417134",
                                "sense_id": "285358c0-fb6f-32e3-8e2a-8d929106a792",
                                "text": "You'll start eating like a normie. In fact, a small amount of food will one day look like a lot."
                            },
                            {
                                "example_id": "afc456ac-9894-4a10-9301-56da1d5a817d",
                                "sense_id": "285358c0-fb6f-32e3-8e2a-8d929106a792",
                                "text": "It is a career disaster now to signal your left-behind cluelessness as a basic bitch, normie or a member of the corrupt media mainstream in any way."
                            }
                        ]
                    },
                    {
                        "sense_id": "675d7ebd-a389-39b5-a57e-bbaf6bf88cf7",
                        "entry_id": "cf79265f-ce15-364e-8c47-d75934477479",
                        "glosses": [
                            "A person who is not a member of an ingroup, such as a fandom or other (online) community; an outsider."
                        ],
                        "tags": [
                            "Internet",
                            "derogatory",
                            "slang",
                            "sometimes",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c58517ab-8610-3a02-bbdf-4d251016807a",
                        "entry_id": "cf79265f-ce15-364e-8c47-d75934477479",
                        "glosses": [
                            "A nonalcoholic."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "98c36e1e-9aa9-46b5-9f27-7b02ed55578c",
                                "sense_id": "c58517ab-8610-3a02-bbdf-4d251016807a",
                                "text": "Be jovial but not a comedian. We have a sense of humor that the normies don't have."
                            }
                        ]
                    }
                ],
