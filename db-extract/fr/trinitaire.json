        "fr-extract.jsonl": [
            {
                "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                "word": "trinitaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20f2eab4-3400-4117-8e25-2ae82261d030",
                        "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "trinitaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                        "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                        "glosses": [
                            "Relatif à la trinité des chrétiens ou des hindous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "426d68f1-746d-437b-9373-ef07e50043e0",
                                "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                                "text": "Réciproquement, la même distinction permettait de réfuter les objections contre le dogme trinitaire des trois Personnes en un seul Dieu."
                            },
                            {
                                "example_id": "3f28b705-8fbe-4a8c-a8df-3733aeda3a5f",
                                "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                                "text": "Cependant, perçu par une pensée pure, Dieu est trinitaire dans chaque expression de l’univers. Telles sont les religions trinitaires comme l’hindouisme, (Brahman, Vishnou, Shiva) et telle est la Trinité du christianisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "67985d05-d760-3c61-836c-6e3b13e93204",
                        "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                        "glosses": [
                            "Relatif à La Trinité, commune des Alpes-Maritimes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62dfe244-9c3b-4bf6-a331-472dc46b4809",
                        "source_entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                        "target_lang_word": "Trinitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trinitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1337bcc9-c6c6-3312-b711-971e6eda113b",
                                        "entry_id": "4f0bc5b7-b468-34e1-8945-68c410c18b22",
                                        "glosses": [
                                            "Someone who believes in the Trinity, the three persons of the Godhead."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95b50772-3b7b-3a37-862b-b5667f6b33ba",
                                        "entry_id": "4f0bc5b7-b468-34e1-8945-68c410c18b22",
                                        "glosses": [
                                            "A member of the Trinitarian order."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Trinitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "953bbc57-d17b-389b-b42d-914670c88ca9",
                                        "entry_id": "320b8752-47da-3abd-9ec8-52cc6b36556f",
                                        "glosses": [
                                            "Believing in the Trinity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a0cb5d-358e-43f4-ad95-0893d6dfa775",
                                                "sense_id": "953bbc57-d17b-389b-b42d-914670c88ca9",
                                                "text": "It was no less than whether the psychic movement in Britain was destined to take a Unitarian or a Trinitarian course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906a1443-94b1-3df4-bd89-f627d0cda66e",
                                        "entry_id": "320b8752-47da-3abd-9ec8-52cc6b36556f",
                                        "glosses": [
                                            "Of or pertaining to the Trinity (the three persons of the Godhead) or to the doctrine of Trinity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62c657d-9eb4-4f8b-8d5f-f628d5b34bff",
                                                "sense_id": "906a1443-94b1-3df4-bd89-f627d0cda66e",
                                                "text": "The influence of trinitarian iconography is evident to varying degrees. Teresa and Elizabeth, for example, make reference to particular visual images of the Trinity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                        "entry_id": "320b8752-47da-3abd-9ec8-52cc6b36556f",
                                        "glosses": [
                                            "Of or pertaining to a trinity, a group of three (almost exclusively when compared to the Christian Trinity)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82551eb2-551d-4cda-8e4c-e7363e4d7162",
                                                "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                                "text": "In polytheism we find also a tendency to a trinitarian grouping of gods, and in each threefold group one god who was at least primus inter pares."
                                            },
                                            {
                                                "example_id": "667d6e03-244c-4b49-8f98-128d92683770",
                                                "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                                "text": "See PL 210.54C and James J. Sheridan's stimulating observations on the Trinitarian grouping of Nature, Genius, and Truth (in his note on p. 218)."
                                            },
                                            {
                                                "example_id": "012cb629-f81a-4f96-bf10-92b805862e68",
                                                "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                                "text": "It is in Hastings' Encyclopedia of Religion and Ethics: […]"
                                            },
                                            {
                                                "example_id": "0a532fc4-64d7-482a-8128-764a7af3eddd",
                                                "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                                "text": "[…] The ancient Egyptians believed in the Trinitarian group of Osiris, Isis and Horus while the Hindus had Brahma, Vishnu and Shiva, and the later Christians described God as God the Father, the Son and the Holy Spirit."
                                            },
                                            {
                                                "example_id": "52a4b71a-489c-4d89-b090-3ce2326d3c29",
                                                "sense_id": "a0402419-a0b6-3edb-8650-7ece0ca358f1",
                                                "text": "[…] singularity is transformed into the trinitarian triad of abstract unity (universality), differentiation (particularity and finite singularity), and return (infinite singularity),"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac9fcca-5b31-4436-8f8b-13eef37d0b27",
                        "source_entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                        "target_lang_word": "trinitario",
                        "target_lang_code": "es",
