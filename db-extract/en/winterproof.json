                "translations": [
                    {
                        "translation_id": "f01dfa39-874f-4a54-9c7e-7d71829d689f",
                        "source_entry_id": "52306af3-d200-3024-b9ac-89d1ad120276",
                        "source_sense_id": "eead9988-566f-3e1a-88c9-59abb576c357",
                        "source_sense_description": "Translations",
                        "target_lang_word": "winterfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winterfest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                        "entry_id": "b486bf65-c691-3382-ba77-8395875eacf2",
                                        "glosses": [
                                            "auf winterliche Temperaturen, Eis und Schnee vorbereitet oder dafür geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e680dd1-b96a-4dfa-aaac-69dcdfd321c7",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "So machen Sie Ihr Auto winterfest: Winterreifen aufziehen, Frostschutz im Kühlwasser prüfen, Frostschutz in Scheibenwasserbehälter nachfüllen, die Türgummis mit Talkum einpudern, Batterie und Licht checken, Unterbodenschutz prüfen, auf evtl. Lackschäden prüfen."
                                            },
                                            {
                                                "example_id": "2b2a8975-b723-4f3a-a177-38a14f54dc1f",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "„Das Camp Lipa war vor einer Woche von der Internationalen Organisation für Migration geräumt worden, weil die bosnischen Behörden es nicht winterfest gemacht hatten.“"
                                            },
                                            {
                                                "example_id": "2ca3c231-9462-478f-a2f8-a49f4639cec1",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "„Im größten Lager Kara Tepe auf Lesbos leben rund 7500 Menschen in nicht winterfesten Zelten noch immer ohne ausreichend Wasser, sanitäre Anlagen oder Strom.“"
                                            },
                                            {
                                                "example_id": "fbbeda29-5733-436a-b459-06fdadbf2c46",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "„Im Herbst sollte auch der Gartenteich winterfest gemacht werden.“"
                                            },
                                            {
                                                "example_id": "230ac4b3-a1c6-4e84-8d5f-df58e8cc417b",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "„Die Gartengeräte werden jetzt winterfest gemacht, kälteempfindliche Kübelpflanzen kommen spätestens jetzt ins Winterquartier.“"
                                            },
                                            {
                                                "example_id": "b5989342-bf5b-4529-8ae6-f6b4769081f2",
                                                "sense_id": "3b717a6d-54ee-394e-b819-717478bdaae4",
                                                "text": "„Die Tage werden kürzer und die ersten kalten Nächte kündigen den nahenden Winter an. Im Garten gilt es nun, diesen „winterfest“ zu machen“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                        "entry_id": "b486bf65-c691-3382-ba77-8395875eacf2",
                                        "glosses": [
                                            "als Pflanze fähig, den Winter (mit kalten Temperaturen, Eis und Schnee) draußen zu überstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81856f25-ebe5-4b92-897d-203cdc66c260",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "Bekannte winterfeste Pflanzen sind Schneeglöckchen, Hyazinthen, Winterlinge, Phlox und Salbei."
                                            },
                                            {
                                                "example_id": "31c0a001-e1ce-44a3-952d-61fefd8af552",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "„Sie können entweder winterfeste Pflanzen wählen, wenn Sie nicht jedes Jahr neu bepflanzen möchten, oder einjährige Pflanzen, wenn Sie mehr Abwechslung haben wollen.“"
                                            },
                                            {
                                                "example_id": "239230d8-1708-437a-b832-90b8bbcb0632",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "„Nicht absolut winterfeste Pflanzen wie Rosmarin oder Artischocken graben Sie besser aus und überwintern Sie im Haus bzw. Keller.“"
                                            },
                                            {
                                                "example_id": "f08afd34-d029-49ff-b4ea-fada202a6ffe",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "„Winterfeste Pflanzen müssen vielleicht eingepackt werden und nicht winterfeste Pflanzen sollten nun nach drinnen umziehen.“"
                                            },
                                            {
                                                "example_id": "5bee103c-a3b0-4962-8075-35d10a623006",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "„BUHLERT (1906) fand, daß die winterfesten Weizensorten eine geringere Wurzelmasse entwickelt hatten als die weniger winterharten, auch war die Ausdehnung des Wurzelsystems geringer.“"
                                            },
                                            {
                                                "example_id": "eae6f277-0561-45a1-93c4-7c815f44abc7",
                                                "sense_id": "dca64551-1e03-3d1b-bf23-45944d79a761",
                                                "text": "[Frankensteiner Weizen:] „Er stammt aus Schlesien; schon in den dreissiger Jahren unseres Jahrhunderts wurde er von den Landwirthen Ostböhmens gern von dort bezogen und als ein ertragsreicher und durchaus winterfester Weizen gelobt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
