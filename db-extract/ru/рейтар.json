                "translations": [
                    {
                        "translation_id": "72eb9b4f-cdc1-4fe6-aabc-1926c5fc519c",
                        "source_entry_id": "72b4fb01-02fb-38e2-9a57-e484f8a27884",
                        "source_sense_id": "eba03c21-a308-38ae-bdd9-a766ede6f7bd",
                        "source_sense_description": "historisch: gemieteter Soldat der Kavallerie; Soldat zu Pferde",
                        "target_lang_word": "Reiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                        "entry_id": "31683f20-3c7e-3a73-8705-951ab01a7b83",
                                        "glosses": [
                                            "jemand, der (auf einem Pferd, Esel, Kamel oder Ähnliches) reitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94c746ef-9fc3-4298-8708-b0c255db5ad0",
                                                "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                                "text": "Der Reiter fiel vom Pferd, als dieses sich durch die laute Musik gestört fühlte."
                                            },
                                            {
                                                "example_id": "0e07b50a-08dc-4d0c-9c3c-59b3d334d0c1",
                                                "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                                "text": "„Und nun also haben die Reiter Stolp verlassen, blutjung, viel zu jung fürs Sterben.“"
                                            },
                                            {
                                                "example_id": "a7ebc86d-7cf4-4a2c-8a55-2e342daf907e",
                                                "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                                "text": "„Ein Trupp Reiter, der eine Kutsche begleitete, überholte sie während der Honigmahlzeit.“"
                                            },
                                            {
                                                "example_id": "df1b998e-acf8-4b84-8645-ecb8582b9266",
                                                "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                                "text": "„Die Reiter verschwanden jetzt in einer Bodenfalte und tauchten erst nach einigen Minuten wieder auf.“"
                                            },
                                            {
                                                "example_id": "0967d5b6-cb82-4404-a2b1-407d33dca96c",
                                                "sense_id": "8755c769-7be6-3934-8c60-5c412e79f1cf",
                                                "text": "„Nur wenige Reiter begegneten ihnen, unter diesen auch ein paar Offiziere von Schachs Regiment.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d9666fa-6221-345d-b37e-37f56d91509e",
                                        "entry_id": "31683f20-3c7e-3a73-8705-951ab01a7b83",
                                        "glosses": [
                                            "aufgesetztes, leichtes Laufgewicht bei feinen Präzisionswaagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae210777-c215-4749-9af0-a46e9deeb47b",
                                                "sense_id": "5d9666fa-6221-345d-b37e-37f56d91509e",
                                                "text": "Der Reiter wird so weit nach rechts verschoben, bis die Waage im Gleichgewicht ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57a49e0a-0edd-37b0-9aae-f409088d8218",
                                        "entry_id": "31683f20-3c7e-3a73-8705-951ab01a7b83",
                                        "glosses": [
                                            "aufklemmbare, meist farbige Markierung zur Kennzeichnung von Karten in einer Kartei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1068c8fb-bf32-4e8d-a1bf-c7bcb1a225bf",
                                                "sense_id": "57a49e0a-0edd-37b0-9aae-f409088d8218",
                                                "text": "Register kann man selber basteln, indem man auf jeden Blattrand in unterschiedlicher Höhe einen Reiter aus einem gefalteten Papierkreis aufgeklebt und mit einem Buchstaben versieht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2b6cc0fe-046d-3ef2-8d57-d9789f25887d",
                                        "entry_id": "31683f20-3c7e-3a73-8705-951ab01a7b83",
                                        "glosses": [
                                            "überstehender Abschnitt in grafischen Benutzeroberflächen, der wie [3] fungiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa61bb4-34e9-465b-8fd6-1654f385b1f4",
                                                "sense_id": "2b6cc0fe-046d-3ef2-8d57-d9789f25887d",
                                                "text": "Die einzelnen Reiter sind am oberen Bildschirmrand zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Reiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19506859-13ea-3824-8cbc-9fcab6e94417",
                                        "entry_id": "faeee3a5-a4bb-366c-9735-959bf51e3261",
                                        "glosses": [
