                "senses": [
                    {
                        "sense_id": "2e94b790-18b5-344f-96ff-4aae1533567b",
                        "entry_id": "937280e0-95c7-35cc-8cb6-337b9f59e001",
                        "glosses": [
                            "pertaining to jihad or jihadism"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "90a6c772-05ab-490b-b0a9-e7468e9ef2a7",
                                "sense_id": "2e94b790-18b5-344f-96ff-4aae1533567b",
                                "text": "What is unbearable, in fact, is the feeling, 13 years after 9/11, that America has been chasing its tail; that, in some whack-a-mole horror show, the quashing of a jihadi enclave here only spurs the sprouting of another there; that the ideology of Al Qaeda is still reverberating through a blocked Arab world whose Sunni-Shia balance (insofar as that went) was upended by the American invasion of Iraq."
                            },
                            {
                                "example_id": "c273afed-41cf-4a42-aecf-73f21d58f07c",
                                "sense_id": "2e94b790-18b5-344f-96ff-4aae1533567b",
                                "text": "Yet people are miserable and disillusioned, joining jihadi groups in among the largest numbers per capita of any country in the world, and making up the majority of boat-borne migrants to Italy this year."
                            }
                        ]
                    }
