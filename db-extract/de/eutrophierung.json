                        "source_entry_id": "7f94b618-24d4-3287-a412-0f58809b7d84",
                        "source_sense_id": "fd4c15a9-e688-34c0-aa03-591bdd9e3162",
                        "source_sense_description": "übermäßiger Nährstoffeintrag in ein Gewässer",
                        "target_lang_word": "eutrofização",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eutrofização",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "e65195a0-6372-3f7d-bf64-8f8411a3b6f2",
                                        "entry_id": "16519cbe-acce-32b4-ac02-3368ed93a332",
                                        "glosses": [
                                            "fenômeno causado pelo excesso de nutrientes (nitratos, fosfatos e matéria orgânica) num corpo o que leva à proliferação excessiva de algas, que, ao entrarem em decomposição, levam ao aumento descontrolado do número de micro-organismos decompositores aeróbios que acabam por diminuir drasticamente a quantidade de oxigênio dissolvido da água, impedindo a vida de peixes e outros animais aquáticos e fazendo com que a água perca sua qualidade"
                                        ],
                                        "tags": [
                                            "Biologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c4aa1d-87c4-4903-89c8-77e09f56c08c",
                                                "sense_id": "e65195a0-6372-3f7d-bf64-8f8411a3b6f2",
                                                "text": "O processo de eutrofização faz com que rios que recebem esgoto fiquem com odor desagradável."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "928f644e-c9f3-362b-9e0e-782663926e8b",
