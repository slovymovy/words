                                "target_senses": [
                                    {
                                        "sense_id": "c48a8a27-6781-3925-95f6-e3bbcbc8f204",
                                        "entry_id": "e23563cb-2d46-386a-93e8-0efd21b5ac7d",
                                        "glosses": [
                                            "Stratified with two alternating types of strata."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f6bb51-ff40-4dea-bbf5-62ae3fd3bc28",
                                                "sense_id": "c48a8a27-6781-3925-95f6-e3bbcbc8f204",
                                                "text": "Some of the enormous fragments of chalk which are interstratified with drift have not only layers of undisturbed flints, but also sandpipes in the middle of them, or cylindrical cavities filled with sand and gravel […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
