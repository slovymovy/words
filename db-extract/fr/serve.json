                    {
                        "sense_id": "0ae9a2c7-f455-3a64-b555-36975c34ad4d",
                        "entry_id": "c1fdb251-3220-3786-96ef-a45db23640af",
                        "glosses": [
                            "Troisième personne du singulier du présent du subjonctif de servir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0b7a0f-0a27-4a3d-826a-88416ec4cb59",
                                "sense_id": "0ae9a2c7-f455-3a64-b555-36975c34ad4d",
                                "text": "Autrefois, je rechignais à table : « Dono, ne commence pas à pichorgner ! Veux-tu qu’on te serve des ortolans ? »"
                            },
                            {
                                "example_id": "01fd9174-d909-442a-889b-21fcdcd44838",
                                "sense_id": "0ae9a2c7-f455-3a64-b555-36975c34ad4d",
                                "text": "Et toi, que cette lettre te serve: lutter!"
                            },
                            {
                                "example_id": "dbd9a7e9-dd07-42f1-ad2a-c49b5d124144",
                                "sense_id": "0ae9a2c7-f455-3a64-b555-36975c34ad4d",
                                "text": "Compte tenu de la durée de vie de certains radioéléments, le principal atout d’une pile nucléaire tient dans son incomparable durée d’utilisation… qu’on s’en serve ou pas ; et cela sans échauffement de la pile."
                            }
                        ]
                    }
