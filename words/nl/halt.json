                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trein kwam langzaam tot <w>halt</w> op het station.",
                            "target_lang_translations": {
                                "en": "The train slowly came to a <w>halt</w> at the station.",
                                "ru": "Поезд медленно <w>остановился</w> на станции.",
                                "pl": "Pociąg powoli <w>zatrzymał się</w> na stacji.",
                                "de": "Der Zug kam am Bahnhof langsam zum <w>Halt</w>.",
                                "fr": "Le train est lentement arrivé à l'<w>arrêt</w> en gare.",
                                "it": "Il treno è giunto lentamente a un <w>arresto</w> in stazione.",
                                "cs": "Vlak na nádraží pomalu <w>zastavil</w>.",
                                "tr": "Tren istasyonda yavaşça <w>durdu</w>.",
                                "es": "El tren se <w>detuvo</w> lentamente en la estación.",
                                "zh": "火车在车站缓慢地<w>停止</w>了。"
                            }
                        },
                        {
                            "text": "De wandelaars hielden even <w>halt</w> om van het uitzicht te genieten.",
                            "target_lang_translations": {
                                "en": "The hikers <w>stopped</w> for a moment to enjoy the view.",
                                "ru": "Туристы сделали небольшой <w>привал</w>, чтобы насладиться видом.",
                                "pl": "Wędrowcy zrobili krótki <w>postój</w>, aby nacieszyć się widokiem.",
                                "de": "Die Wanderer machten kurz <w>Halt</w>, um die Aussicht zu genießen.",
                                "fr": "Les randonneurs ont fait une courte <w>halte</w> pour profiter de la vue.",
                                "it": "Gli escursionisti hanno fatto una breve <w>sosta</w> per godersi il panorama.",
                                "cs": "Turisté si udělali krátkou <w>pauzu</w>, aby si vychutnali výhled.",
                                "tr": "Yürüyüşçüler manzarayı izlemek için kısa bir <w>mola verdiler</w>.",
                                "es": "Los senderistas hicieron una <w>parada</w> breve para disfrutar de las vistas.",
                                "zh": "徒步旅行者<w>停顿</w>了一会儿，欣赏风景。"
                            }
                        },
                        {
                            "text": "We moeten deze negatieve ontwikkeling een <w>halt</w> toeroepen.",
                            "target_lang_translations": {
                                "en": "We must put a <w>stop</w> to this negative development.",
                                "ru": "Мы должны положить <w>конец</w> этому негативному развитию.",
                                "pl": "Musimy <w>położyć kres</w> temu negatywnemu zjawisku.",
                                "de": "Wir müssen dieser negativen Entwicklung Einhalt <w>gebieten</w>.",
                                "fr": "Nous devons mettre un <w>arrêt</w> à ce développement négatif.",
                                "it": "Dobbiamo porre un <w>freno</w> a questo sviluppo negativo.",
                                "cs": "Musíme tomuto negativnímu vývoji učinit <w>přítrž</w>.",
                                "tr": "Bu olumsuz gelişmeye bir <w>dur demeliyiz</w>.",
                                "es": "Debemos poner <w>freno</w> a este desarrollo negativo.",
                                "zh": "我们必须<w>制止</w>这种负面发展。"
                            }
                        }
