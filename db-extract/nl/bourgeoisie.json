                "translations": [
                    {
                        "translation_id": "50e2c69a-f17d-4b80-8539-952e7ad1e948",
                        "source_entry_id": "a93bb1f2-570e-39fe-a0ed-51ae6005f562",
                        "source_sense_id": "d2376f52-6706-38bd-8050-f2df489b8cb9",
                        "target_lang_word": "Bourgeoisie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bourgeoisie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9baef98d-54d1-31cb-a63c-b9133f6b1251",
                                        "entry_id": "9662dcb5-995a-3b32-9093-ec56ffcde387",
                                        "glosses": [
                                            "gehobenes, einflussreiches, gutsituiertes Bürgertum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe22c0ad-7344-49b6-ad8f-6e68cd383b2e",
                                                "sense_id": "9baef98d-54d1-31cb-a63c-b9133f6b1251",
                                                "text": "Die Industriellenfamilien der Gründerzeit gehören zur Bourgeoisie."
                                            },
                                            {
                                                "example_id": "9b7bba2e-6be6-4ee7-a543-88cca5059a81",
                                                "sense_id": "9baef98d-54d1-31cb-a63c-b9133f6b1251",
                                                "text": "Angehörige der Bourgeoisie werden auch Bourgeois genannt."
                                            },
                                            {
                                                "example_id": "28996c09-1f10-4bfd-b6c7-4480b6539b47",
                                                "sense_id": "9baef98d-54d1-31cb-a63c-b9133f6b1251",
                                                "text": "„Es gibt drei Gründe, warum die Hyperbourgeoisie die alten, konsolidierten Bourgeoisien ersetzt und sich nicht damit begnügt, ihnen einfach eine höhere Ebene hinzuzufügen.“"
                                            },
                                            {
                                                "example_id": "8de12281-fc5a-4f0c-807b-7665d133c828",
                                                "sense_id": "9baef98d-54d1-31cb-a63c-b9133f6b1251",
                                                "text": "„Das Prager Deutschtum war Bourgeoisie, Militär und Beamtenschaft, deutschjüdischer Mittelstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ace6a0ab-5be1-32f1-b762-7bd8da00a363",
                                        "entry_id": "9662dcb5-995a-3b32-9093-ec56ffcde387",
                                        "glosses": [
                                            "im Kapitalismus derjenige Teil der Gesellschaft, der über Produktionsmittel und Macht verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7295cd84-2add-4482-9125-25a08d448670",
                                                "sense_id": "ace6a0ab-5be1-32f1-b762-7bd8da00a363",
                                                "text": "„Für Karl Marx dagegen war Bolívar ein Repräsentant der Bourgeoisie.“"
                                            },
                                            {
                                                "example_id": "7c0852c8-d72f-46b2-9773-30db292bac36",
                                                "sense_id": "ace6a0ab-5be1-32f1-b762-7bd8da00a363",
                                                "text": "„Was interessierten mich Debatten um die Sykophanten der Bougeoisie, was ging mich die Entwicklung der Produktivkräfte in der kapitalistischen Produktion an, was Schachergeist, Überbau und Klassenspezifik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed9d413b-3928-48df-a697-f26b4c79bf93",
                        "source_entry_id": "a93bb1f2-570e-39fe-a0ed-51ae6005f562",
