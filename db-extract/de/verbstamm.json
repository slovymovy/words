                ],
                "senses": [
                    {
                        "sense_id": "daa2a9b4-2bce-384d-b224-9b2413ace866",
                        "entry_id": "025d53b3-3881-3651-80fd-1e58d6f3a06a",
                        "glosses": [
                            "Wortstamm eines Verbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a600f8f-93e5-47eb-929c-a901d46f7fd6",
                                "sense_id": "daa2a9b4-2bce-384d-b224-9b2413ace866",
                                "text": "„Bei einer Reihe von Verben ist das Endungs-e allerdings verbindlich, etwa, wenn der Verbstamm auf d/t oder Konsonant plus m/n endet: Atme gleichmäßig! Rechne gefälligst sorgfältiger! Arbeite nicht so viel!“"
                            },
                            {
                                "example_id": "d148f03c-0820-4764-8a92-ba2518ac177a",
                                "sense_id": "daa2a9b4-2bce-384d-b224-9b2413ace866",
                                "text": "„Zwar werden Dinge wie Vergangenheit, Imperativ, Passiv in Kreolsprachen tatsächlich selten durch auf den Verbstamm folgende Endungen angezeigt. Doch gibt es stattdessen in der Regel vorangestellte Elemente.“"
                            },
                            {
                                "example_id": "65d7df09-f203-4814-be80-cb0736e52620",
                                "sense_id": "daa2a9b4-2bce-384d-b224-9b2413ace866",
                                "text": "„Die Bezeichnung Inflektiv - stellenweise ist auch von “freien Verbstämmen“ die Rede - bringt zum Ausdruck, dass die verwendeten Verbstämme keine Flektionsendungen tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
