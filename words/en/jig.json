                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>jig</w> for mackerel from the edge of the pier.",
                            "target_lang_translations": {
                                "nl": "Ze besloten vanaf de rand van de pier op makreel te <w>pilkeren</w>."
                            }
                        },
                        {
                            "text": "He spent the cold morning <w>jigging</w> through a hole in the ice.",
                            "target_lang_translations": {
                                "nl": "Hij bracht de koude ochtend door met <w>jiggen</w> door een gat in het ijs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jig for fish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Vissen door verzwaard kunstaas ritmisch op en neer te bewegen in het water."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "jiggen",
                                "target_lang_sense_clarification": "vistechniek"
                            },
                            {
                                "target_lang_word": "pilkeren",
                                "target_lang_sense_clarification": "vissen met verticaal kunstaas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "691853cd-1a38-3de9-bc38-df32a514b721",
                    "sense_definition": "To play truant or stay away from school without permission.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "truancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers decided to <w>jig</w> school and hang out at the mall instead.",
                            "target_lang_translations": {
                                "nl": "De tieners besloten van school te <w>spijbelen</w> en in plaats daarvan in het winkelcentrum rond te hangen."
                            }
                        },
                        {
                            "text": "He was caught after he tried to <w>jig</w> his morning classes.",
                            "target_lang_translations": {
                                "nl": "Hij werd betrapt nadat hij probeerde te <w>spijbelen</w> van zijn ochtendlessen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in Australia and Canadian Maritimes"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Spijbelen of zonder toestemming wegblijven van school."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spijbelen",
                                "target_lang_sense_clarification": "wegblijven van school"
                            },
                            {
                                "target_lang_word": "brossen",
                                "target_lang_sense_clarification": "Belgisch-Nederlands voor spijbelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d7e843-f688-38d2-9d24-76a506f1f59c",
                    "sense_definition": "To sing or perform to the fast rhythm of a jig.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minstrel began to <w>jig</w> a humorous ballad for the crowd.",
                            "target_lang_translations": {
                                "nl": "De minstreel begon een komische ballade vrolijk <w>voor te dragen</w> voor de menigte."
                            }
                        },
                        {
                            "text": "He would merrily <w>jig</w> a tune whenever the guests requested one.",
                            "target_lang_translations": {
                                "nl": "Hij <w>zong</w> altijd vrolijk een deuntje wanneer de gasten daarom vroegen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zingen of optreden op het snelle ritme van een jig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opzeggen",
