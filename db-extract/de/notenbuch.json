                    {
                        "sense_id": "870ec466-f512-3f2d-8fb5-7ff299ec2766",
                        "entry_id": "ad5b0180-fb14-361a-a1d8-1aec69ac7880",
                        "glosses": [
                            "Buch, in dem die Noten für ein oder mehrere Musikstücke verzeichnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b6d5e3-5bd5-46cd-bb99-796de9d166d1",
                                "sense_id": "870ec466-f512-3f2d-8fb5-7ff299ec2766",
                                "text": "Manche Musikliebhaber nehmen ein Notenbuch mit ins Konzert."
                            },
                            {
                                "example_id": "9fee0e7d-8e18-4263-abe2-8379a29e3f1f",
                                "sense_id": "870ec466-f512-3f2d-8fb5-7ff299ec2766",
                                "text": "„Sie setzte sich bei diesen Worten ans Spinett und spielte außerordentlich gut auswendig mehrere Stücke; dann ließ sie sich ein wenig bitten und begleitete sich aus einem Notenbuch zu einem Lied in einer Weise, daß die Liebe mich auf der Stelle in den siebenten Himmel versetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
