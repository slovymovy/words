                    {
                        "sense_id": "d05a7a6d-da1e-3f16-a1b6-29dc795f198f",
                        "entry_id": "df4b6793-1e25-34bb-81ce-7ed851570a4b",
                        "glosses": [
                            "apparently, it seems"
