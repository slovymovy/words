                "senses": [
                    {
                        "sense_id": "a20b4ff5-a908-37e7-a9e5-9874928b3743",
                        "entry_id": "2a39122d-869e-3388-96b8-73723261b850",
                        "glosses": [
                            "czynne parowanie wody z nadziemnych części roślin przez aparaty szparkowe, skórkę i przetchlinki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a15edb-1011-4560-b70d-bd276511231b",
                                "sense_id": "a20b4ff5-a908-37e7-a9e5-9874928b3743",
                                "text": "Ponad 97% traconej przez roślinę wody należy przypisać transpiracji szparkowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bdb55a98-617c-3462-ae0d-81dcefaaa938",
                        "entry_id": "2a39122d-869e-3388-96b8-73723261b850",
                        "glosses": [
                            "pocenie się"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "da6ca17b-1c8d-4c2f-90c1-1dce75ac6a86",
                                "sense_id": "bdb55a98-617c-3462-ae0d-81dcefaaa938",
                                "text": "… pan Horacy zaczął silnie potnieć. Transpiracja ta pomyślnie oddziałała na usposobienie straszliwego starca, …"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d553c5c0-ed12-4a85-bb74-97937f0eb788",
                        "source_entry_id": "2a39122d-869e-3388-96b8-73723261b850",
                        "source_sense_id": "a20b4ff5-a908-37e7-a9e5-9874928b3743",
                        "target_lang_word": "transpiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transpiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f9df75-c677-3b6f-b1bd-6c84addc6d81",
                                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                                        "glosses": [
                                            "The loss of water by evaporation in terrestrial plants, especially through the stomata; accompanied by a corresponding uptake from the roots."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2d1e8a-02f3-3bd9-93b4-6f2a695cf000",
                                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                                        "glosses": [
                                            "The process of giving off water vapour through the skin or mucous membranes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cce67282-7b52-38e7-b416-fffd1bf41dfb",
                                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                                        "glosses": [
                                            "The passage of gases through fine tubes."
                                        ],
                                        "tags": [
