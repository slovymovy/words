                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Retorte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                        "entry_id": "efbe43e8-db80-38e7-be42-d19cb090d625",
                                        "glosses": [
                                            "Gefäß zum Destillieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea2d27b-f0e6-4bf4-89c5-03fe0c58bb2d",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "Retorten wurden schon im Mittelalter benutzt."
                                            },
                                            {
                                                "example_id": "a6c63f7e-fcb3-4c69-922c-956d221a6d5b",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Böttger betrachtet wieder einmal enttäuscht den Niederschlag in der Retorte.“"
                                            },
                                            {
                                                "example_id": "2defa33a-4bdb-4651-8984-afd129e776eb",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Eine doppelte Reihe von mit Glasstöpseln verschlossenen Flaschen stand in einem Regal an der Wand gegenüber der Tür, und der Tisch war vollständig bedeckt mit einem Durcheinander von Bunsenbrennern, Reagenzgläsern und Retorten.“"
                                            },
                                            {
                                                "example_id": "79d47c8d-2d35-46cc-a6d7-045f056301f7",
                                                "sense_id": "588e1afc-bc67-3aca-8bc8-aa7d2a45de61",
                                                "text": "„Sie schütteten sie in die Retorte, gossen Alkohol hinzu, zündeten das Feuer an und warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cf39956-18cc-490b-b9f6-47986a23829b",
                        "source_entry_id": "3e6a519c-695d-3a5d-849a-66642e9c3a52",
