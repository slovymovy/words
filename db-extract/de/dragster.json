                "senses": [
                    {
                        "sense_id": "38f9f5ac-e047-3525-b66e-3a3302e5df17",
                        "entry_id": "675b83f4-1ead-3a6a-a38a-e1904d947b69",
                        "glosses": [
                            "Fahrzeug, das speziell für die Teilnahme an Beschleunigungsrennen (Dragsterrennen) gebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25025eef-55c5-4ec3-9ec4-361981adaf8c",
                                "sense_id": "38f9f5ac-e047-3525-b66e-3a3302e5df17",
                                "text": "„Eine Achtelmeile, also exakt 201,17 Meter lang, ist die Rennstrecke, auf der sich am Sonntag in Mariazell Dragster, Motorräder, Karts und Serienfahrzeuge aller Art duellieren werden.“"
                            },
                            {
                                "example_id": "e7864742-eb5c-4101-9677-d2a60cbbc053",
                                "sense_id": "38f9f5ac-e047-3525-b66e-3a3302e5df17",
                                "text": "„Einer der Wagen, ein so genannter Dragster, war am Samstagabend bei einer Vorführung plötzlich direkt in die Menge gerast.“"
                            },
                            {
                                "example_id": "81af9c0c-c41f-418a-97fa-2bf9cd76bef9",
                                "sense_id": "38f9f5ac-e047-3525-b66e-3a3302e5df17",
                                "text": "„Zwei klassische Dragster stehen rechts, Radstand um die neun Meter, ein futuristisches Motorrad daneben und ein unscheinbarer BMW E 30.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
