                    {
                        "form_id": "e7c2e1c1-5b36-4bd6-8154-8cb7550db324",
                        "entry_id": "50665710-dc5e-361d-af80-bcae460eae9e",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "surcroit"
