                "senses": [
                    {
                        "sense_id": "0d47c067-224a-332c-8f06-8bc751752a0f",
                        "entry_id": "fddff0ca-ac5b-3619-8455-f5b42a145d79",
                        "glosses": [
                            "The belief that a society or system should be run by an elite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b6d11613-f9cc-3a55-9bd4-7b1dac8904a4",
                        "entry_id": "fddff0ca-ac5b-3619-8455-f5b42a145d79",
                        "glosses": [
                            "The superior attitude or behaviour associated with an elite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7edb97d-dd40-47f9-a00d-be78a0ba5ead",
                                "sense_id": "b6d11613-f9cc-3a55-9bd4-7b1dac8904a4",
                                "text": "Dati launched a blistering attack on the prime minister, François Fillon, under whom she served as justice minister, accusing him of sexism, elitism, arrogance and hindering the political advancement of ethnic minorities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ff40502-981a-4e1f-bfbc-a2871928c8b1",
                        "source_entry_id": "fddff0ca-ac5b-3619-8455-f5b42a145d79",
