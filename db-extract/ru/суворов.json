                "senses": [
                    {
                        "sense_id": "aa22a288-0a12-303a-805c-ac71ea011cfc",
                        "entry_id": "54e3489b-5b31-3527-ba70-d1d5f288ce16",
                        "glosses": [
                            "a surname, Suvorov"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9ff63a-2278-4b51-951f-3858076dc405",
                                "sense_id": "aa22a288-0a12-303a-805c-ac71ea011cfc",
                                "text": "Че́рез пере́днюю дя́дюшка провёл свои́х госте́й в ма́ленькую за́лу с складны́м столо́м и кра́сными сту́льями, пото́м в гости́ную с берёзовым кру́глым столо́м и дива́ном, пото́м в кабине́т с обо́рванным дива́ном, иста́сканным ковро́м и с портре́тами Суво́рова, отца́ и ма́тери хозя́ина и его́ самого́ в вое́нном мунди́ре.",
                                "translation": "“Uncle” led the visitors through the anteroom into a small hall with a folding table and red chairs, then into the drawing room with a round birchwood table and a sofa, and finally into his private room where there was a tattered sofa, a worn carpet, and portraits of Suvórov, of the host's father and mother, and of himself in military uniform.",
                                "english": "“Uncle” led the visitors through the anteroom into a small hall with a folding table and red chairs, then into the drawing room with a round birchwood table and a sofa, and finally into his private room where there was a tattered sofa, a worn carpet, and portraits of Suvórov, of the host's father and mother, and of himself in military uniform."
                            }
                        ]
                    }
