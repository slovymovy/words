                                        "entry_id": "0fc78dee-5d0a-305f-b63c-613bffb445dd",
                                        "glosses": [
                                            "The act of producing giggles; high-pitched laughter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7c715c-d70b-4c32-9fb0-9ae295a23116",
                                                "sense_id": "c9a48690-309c-3616-bd0b-c24d60aa4a64",
                                                "text": "Once there, he blushingly went through the procedure, having to fold and refold the flag about three times, to the twitterings and gigglings of twelve little girls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a10876a-d6e4-4700-a33f-ba40158c485f",
                        "source_entry_id": "59df9b86-7cbe-3c96-b27a-86e3bacd11f4",
                        "source_sense_id": "01bd03cb-faca-32de-a74e-4490503c60dd",
