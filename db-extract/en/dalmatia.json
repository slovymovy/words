                    {
                        "translation_id": "889daccb-612c-4d73-a4b2-9dd13fafdfe6",
                        "source_entry_id": "fe53929c-06b6-3843-be05-574763ba54a9",
                        "source_sense_id": "cc0629d8-920d-3684-a0be-3daa9117a8f8",
