                "senses": [
                    {
                        "sense_id": "7e74929e-69ab-3f32-92e3-62471d8f3105",
                        "entry_id": "9423f318-6593-36d1-a8d3-64bc7ed22d1a",
                        "glosses": [
                            "de uitwerking van iets op het gemoed of de geest, de indruk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e02e6b-c565-4bbf-872e-0de44cb5a043",
                                "sense_id": "7e74929e-69ab-3f32-92e3-62471d8f3105",
                                "text": "Mijn eerste impressie van het schilderij was dat het dramatisch slecht was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd56fa9-72bb-4bae-8af0-af41f0e9a096",
                        "source_entry_id": "9423f318-6593-36d1-a8d3-64bc7ed22d1a",
                        "source_sense_id": "7e74929e-69ab-3f32-92e3-62471d8f3105",
