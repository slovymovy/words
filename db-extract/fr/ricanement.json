                                        "sense_id": "54686d90-bff5-37cd-8a91-86ffccc41c3f",
                                        "entry_id": "ed46b42b-0060-37a4-bbf8-6b0551cde469",
                                        "glosses": [
                                            "A partly suppressed or broken laugh."
                                        ],
