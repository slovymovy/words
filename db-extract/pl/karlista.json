                    },
                    {
                        "translation_id": "9051ccae-2ab5-4430-9cd9-84330682632b",
                        "source_entry_id": "e422dd6e-c48b-39a7-b217-232d580869eb",
                        "source_sense_id": "ef13febd-2107-32f9-94ba-0cec9f6567c8",
                        "target_lang_word": "carliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa885a58-3ad3-3225-8027-b4a329a7095d",
                                        "entry_id": "f4d9e875-47cf-3507-ab93-b5ff448e8e29",
                                        "glosses": [
                                            "Relatif au carlisme et aux partisans de Charles X de France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bec0c4-ee4c-4970-8bca-6b9066c7914f",
                                                "sense_id": "fa885a58-3ad3-3225-8027-b4a329a7095d",
                                                "text": "J’avais parcouru une partie de la Vendée pied à pied ; je commençais à être fatigué du langage carliste que j’y entendais."
                                            },
                                            {
                                                "example_id": "4ec3485d-6b34-463e-aaf0-3d0befaaf005",
                                                "sense_id": "fa885a58-3ad3-3225-8027-b4a329a7095d",
                                                "text": "[…]; aussi les légitimistes étaient-ils divisés entre eux; ils formaient deux partis presque distincts : le parti carliste, composé en général d'hommes graves, circonspects, restés fidèles à Charles X, parce qu'ils regardaient son abdication comme nulle; et le parti henriquinquiste, beaucoup plus nombreux que le précédent, comprenant tous les hommes d'action et la plupart des publicistes."
                                            },
                                            {
                                                "example_id": "8a83c564-8a25-4160-877e-567f1bdafcbf",
                                                "sense_id": "fa885a58-3ad3-3225-8027-b4a329a7095d",
                                                "text": "Un certain Jacobeus, ouvrier imprimeur impliqué dans le complot légitimiste de la rue des Prouvaires, trouve la mort. […]. Pour le moment , le cadavre de Jacobeus encombre, et la presse d'opposition carliste, comme celle des républicains, profite de l'aubaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d46f20-df7d-30ec-8131-50c4bd67b9d1",
                                        "entry_id": "f4d9e875-47cf-3507-ab93-b5ff448e8e29",
                                        "glosses": [
                                            "Relatif au carlisme et aux partisans de Don Carlos d’Espagne."
                                        ],
                                        "tags": [
                                            "Espagne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5eba3a9-d168-48c7-a8a7-3c67cfc1b33e",
                                                "sense_id": "41d46f20-df7d-30ec-8131-50c4bd67b9d1",
                                                "text": "Dans ces temps de dissensions politiques, il arrive souvent que les toreros christinos ne vont pas au secours des toreros carlistes en danger, et réciproquement."
                                            }
                                        ]
                                    }
                                ]
                            },
