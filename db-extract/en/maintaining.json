                                    {
                                        "sense_id": "1d015a39-77eb-371c-a2fe-4c3483dafb3b",
                                        "entry_id": "6a7f5ca0-9cf7-3b12-9154-ec535428fd43",
                                        "glosses": [
                                            "Zustand der Untätigkeit, bis ein bestimmter Zustand trifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deef3215-313e-4ec4-9d88-85d614c822ce",
                                                "sense_id": "1d015a39-77eb-371c-a2fe-4c3483dafb3b",
                                                "text": "„Er war überzeugt davon, dass dies seine letzte Chance war. Erst nach zwanzig Jahren des Wartens hatte er sie bekommen.“"
                                            },
                                            {
                                                "example_id": "1a657943-8fc0-40db-9ab3-cfb881d9e6ff",
                                                "sense_id": "1d015a39-77eb-371c-a2fe-4c3483dafb3b",
                                                "text": "„Warten ist für die meisten tote Zeit, die überbrückt werden muss und als eine Spanne gilt, mit der sich nichts Vernünftiges anfangen lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b11208b7-409a-3fe9-bfe6-ef27dcbbbe22",
                                        "entry_id": "6a7f5ca0-9cf7-3b12-9154-ec535428fd43",
                                        "glosses": [
                                            "Vorgang/Handlung, bei der ein technischer Zustand überprüft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5583f1ae-cd2a-4399-9592-84e6b0cfb599",
                                                "sense_id": "b11208b7-409a-3fe9-bfe6-ef27dcbbbe22",
                                                "text": "„Ihre Aufgaben umfassen unter anderem […] das Aufstellen und Warten von Seezeichen, die Verhütung und Bekämpfung von Ölverschmutzungen sowie der Betrieb von Eisbrechern.“"
                                            },
                                            {
                                                "example_id": "82ab51ad-9795-4fa3-b8cc-cda1e4f4f211",
                                                "sense_id": "b11208b7-409a-3fe9-bfe6-ef27dcbbbe22",
                                                "text": "„AVG TuneUp […] ist eine […] Systemsoftware für Microsoft Windows, die unterschiedliche Dienstprogramme (utilities) zum Analysieren, Konfigurieren und Warten von Computern enthält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
