    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5fd52e1-b0f5-3b86-ae3b-a94ceb8b7339",
                    "sense_definition": "Dont le son ou l'intensité a été assourdi ou amorti ; contenu, réprimé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous entendions un bruit <w>étouffé</w> venant de la pièce voisine.",
                            "target_lang_translations": {
                                "en": "We could hear a <w>muffled</w> noise coming from the next room.",
                                "ru": "Мы слышали <w>приглушённый</w> шум из соседней комнаты.",
                                "de": "Aus dem Nebenzimmer hörten wir ein <w>gedämpftes</w> Geräusch.",
                                "es": "Oíamos un ruido <w>amortiguado</w> que venía de la habitación contigua.",
                                "zh": "我们听到隔壁房间传来一阵<w>闷</w>响。"
                            }
                        },
                        {
                            "text": "Il laissa échapper un rire <w>étouffé</w> derrière sa main pendant le discours.",
                            "target_lang_translations": {
                                "en": "He let out a <w>stifled</w> laugh behind his hand during the speech.",
                                "ru": "Во время речи он, прикрыв рот рукой, издал <w>сдавленный</w> смешок.",
                                "de": "Während der Rede ließ er hinter seiner Hand ein <w>unterdrücktes</w> Lachen hören.",
                                "es": "Durante el discurso, soltó una risa <w>sofocada</w> detrás de la mano.",
                                "zh": "他在演讲时用手掩着嘴，发出一阵<w>压抑</w>的笑声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amorti",
                        "assourdi",
                        "feutré"
                    ],
                    "antonyms": [
                        "éclatant",
                        "retentissant"
                    ],
                    "common_phrases": [
                        "bruit étouffé",
                        "rire étouffé",
                        "son étouffé"
                    ],
                    "target_lang_definitions": {
                        "en": "Describing a sound that has been dampened or made quieter, or a laugh or feeling that has been held back.",
                        "ru": "Об ослабленном или приглушённом звуке либо о смехе и чувстве, которое сдержали.",
                        "de": "Bezeichnet einen abgeschwächten Klang oder ein zurückgehaltenes Lachen oder Gefühl.",
                        "es": "Dicho de un sonido que se ha amortiguado o de una risa o sentimiento que se ha contenido.",
                        "zh": "形容声音被削弱而变得低沉，也指笑声或情感被克制、压住。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "muffled",
                                "target_lang_sense_clarification": "sound dulled by a barrier"
                            },
                            {
                                "target_lang_word": "stifled",
                                "target_lang_sense_clarification": "laugh or cry held back"
                            },
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "quieter or less intense tone"
                            }
                        ],
                        "ru": [
