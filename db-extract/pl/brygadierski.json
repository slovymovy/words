                "translations": [
                    {
                        "translation_id": "5eb660fb-d761-4a43-bfea-8985717e4597",
                        "source_entry_id": "11557fe2-c831-3278-a4c7-bd9d78420b70",
                        "source_sense_id": "f0b7b394-d1ef-35e5-a2ed-5b7557059a54",
                        "target_lang_word": "бригадирский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бригадирский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b54576ad-61af-3d3e-aa43-ce6d42733732",
                                        "entry_id": "b6492173-10b3-3009-a905-8c0cb46170d3",
                                        "glosses": [
                                            "принадлежащий бригадиру; свойственный бригадиру"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ae8639-e5a4-4818-b60c-3c73c07758f8",
                                                "sense_id": "b54576ad-61af-3d3e-aa43-ce6d42733732",
                                                "text": "— Но, но, стой, как велено! — услышал я бригадирский голос."
                                            },
                                            {
                                                "example_id": "a00344c2-93ca-467a-a896-74db971bad6d",
                                                "sense_id": "b54576ad-61af-3d3e-aa43-ce6d42733732",
                                                "text": "Шатун стоял грудью в стену, и теперь стал понятен бригадирский маневр: просто жеребцу некуда было податься и дровни бы пятились вместе с лошадью."
                                            },
                                            {
                                                "example_id": "e8504ea4-3386-4824-a5b5-5c31ac2e9474",
                                                "sense_id": "b54576ad-61af-3d3e-aa43-ce6d42733732",
                                                "text": "То, что она так по-братски назвала меня «мужиком», даже как-то ободрило, — опять чувствуя себя здешним, я с волнением сбил снег с валенок и вслед за Евдокией вошел в бригадирский дом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
