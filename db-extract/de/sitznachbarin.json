                        "entry_id": "eba6a8bb-7f67-3f9a-abc3-42701493e6d3",
                        "glosses": [
                            "weibliche Person, welche neben einer anderen Person, auf einer Sitzgelegenheit sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf49ce9-ad14-4ba8-a202-91aee382c006",
                                "sense_id": "8534cf3f-16ba-3ce8-a632-9d38bd7153ef",
                                "text": "„Kurz vor dem Abflug veröffentlichte Niall Horan ein Bild von sich und seiner Sitznachbarin im Flugzeug.“"
                            },
                            {
                                "example_id": "ebe7c568-2476-4974-b308-11da2de2dd17",
                                "sense_id": "8534cf3f-16ba-3ce8-a632-9d38bd7153ef",
                                "text": "„Ihre Sitznachbarin will wissen, ob der Kölner Dom ein touristischer oder ein religiöser Ort ist.“"
                            }
                        ],
