                "senses": [
                    {
                        "sense_id": "64bd6e34-aeb1-3999-b1ca-0516aa474262",
                        "entry_id": "6a3cd6a2-7e05-344b-afb9-90142ee998ea",
                        "glosses": [
                            "een traag, sloom, langzaam, slap tempo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab0f3f0-634f-4788-959b-acff5a6b6282",
                                "sense_id": "64bd6e34-aeb1-3999-b1ca-0516aa474262",
                                "text": "Dan volgt na een halve minuut hét moment van de dag voor Mette en Jille. Het geweer van Van Oostrum knalt, als een klappertjespistool. En weg is de Ladies Tour, zij het aanvankelijk nog in een sukkelgang over het parcours van De Stofwolk. Maar dat tempo gaat zeker versnellen wanneer zo meteen de Needse berg als eerste hobbel in zicht komt."
                            },
                            {
                                "example_id": "3019bc53-d49a-4881-b8a1-fac7ebacc1a5",
                                "sense_id": "64bd6e34-aeb1-3999-b1ca-0516aa474262",
                                "text": "En dan de Fransen in het verkeer…. Claxonneren volop en constant in een sukkelgangetje op de middelste baan blijven rijden, het schijnt schering en inslag te zijn. Niemand houdt zich ook aan de verkeersregels en de rustplaatsen langs de snelwegen zijn smerig en overvol."
                            }
                        ]
                    }
