        "de-extract.jsonl": [
            {
                "entry_id": "2359f0b6-1073-353a-8945-64d36c614ad3",
                "word": "zueinander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22c6b256-63b6-3c82-af38-7514e86e6ad8",
                        "entry_id": "2359f0b6-1073-353a-8945-64d36c614ad3",
                        "glosses": [
                            "der/die/das eine zum anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd34ca4-e083-42f3-b4eb-137690553c8b",
                                "sense_id": "22c6b256-63b6-3c82-af38-7514e86e6ad8",
                                "text": "Es ist immer noch unklar, wie sie zueinander stehen."
                            },
                            {
                                "example_id": "90ba1614-0d4c-4a39-84c6-d39e1cae94c6",
                                "sense_id": "22c6b256-63b6-3c82-af38-7514e86e6ad8",
                                "text": "„Von den einfachsten Viren bis zu den größten Landtieren haben die Lebewesen, die die Erde bevölkern, stets sehr vielschichtige Beziehungen zueinander und zu ihrer jeweiligen Umgebung geknüpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0b4ad76-c9f1-4eda-8ff5-2fabd72524ca",
                        "source_entry_id": "2359f0b6-1073-353a-8945-64d36c614ad3",
                        "source_sense_id": "22c6b256-63b6-3c82-af38-7514e86e6ad8",
                        "source_sense_description": "der/die/das eine zum anderen",
                        "target_lang_word": "to each other",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29116649-a797-4afd-9380-d9d01c476c3e",
                        "source_entry_id": "2359f0b6-1073-353a-8945-64d36c614ad3",
                        "source_sense_id": "22c6b256-63b6-3c82-af38-7514e86e6ad8",
                        "source_sense_description": "der/die/das eine zum anderen",
                        "target_lang_word": "ensemble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ensemble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcacf45e-b8b3-3360-96ab-cac469f99812",
                                        "entry_id": "d6671654-3a94-3fd5-a869-0be73260aeb1",
                                        "glosses": [
                                            "L’un avec l’autre : les uns avec les autres ; conjointement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ad1cd5-ff66-41cc-a3f2-879808a4c159",
                                                "sense_id": "bcacf45e-b8b3-3360-96ab-cac469f99812",
                                                "text": "Le maitre fut de l'avis du serviteur et ils passèrent ensemble de l'autre côté du vaste piédestal de la colonne."
                                            },
                                            {
                                                "example_id": "deb66e4e-d724-40b5-b32c-6d976c0d1ea5",
                                                "sense_id": "bcacf45e-b8b3-3360-96ab-cac469f99812",
                                                "text": "[…], et nous avons été ensemble boire une petite goutte au débit d’à côté ; le pauvre vieux ne déteste pas ça, quoi qu’il n’en ait jamais abusé."
                                            },
                                            {
                                                "example_id": "93c3e97f-135f-49aa-8ac4-ddb5c31aab9a",
                                                "sense_id": "bcacf45e-b8b3-3360-96ab-cac469f99812",
                                                "text": "Nous étions ensemble dans un sympathique café du quartier Villeray.\nEnsemble. Mot magique, mot unique, mot sur lequel on ne peut que fantasmer, mot qu’on a envie d’étreindre, de masser, de décortiquer, de démonter, de faire revivre sous tous les anagrammes possibles pour en faire ressortir tous les potentiels. En. Semble.\nSemble… Oui, on craint qu’il n’y ait là qu’illusion, et pourtant, le mot d’un seul bloc, « ensemble », paraît si solide, si complet, si suffisant."
                                            },
                                            {
                                                "example_id": "28bf24eb-deac-4fd0-89ed-578af5eaec3d",
                                                "sense_id": "bcacf45e-b8b3-3360-96ab-cac469f99812",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f81cbe-e4df-368f-a1ad-5e1c7387b11c",
                                        "entry_id": "d6671654-3a94-3fd5-a869-0be73260aeb1",
                                        "glosses": [
                                            "En même temps, concomitamment, simultanément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc5d2f9e-b921-4aa7-a277-0764b902ccff",
                                                "sense_id": "26f81cbe-e4df-368f-a1ad-5e1c7387b11c",
                                                "text": "Les deux trains sont arrivés ensemble."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ensemble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f684630-914a-3050-bfb2-45a88ff73c1e",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Réunion d’éléments qui forment un tout, une totalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44095fd4-c4a6-4c0b-862d-67af81a372b0",
                                                "sense_id": "9f684630-914a-3050-bfb2-45a88ff73c1e",
                                                "text": "Celui-ci repose en grande partie sur la cotisation de l’ensemble de la communauté vigneronne."
                                            },
                                            {
                                                "example_id": "68a508f2-c6e3-410a-873f-df3f880d15d6",
                                                "sense_id": "9f684630-914a-3050-bfb2-45a88ff73c1e",
                                                "text": "La profusion de détails gracieux ne nuit en rien à l’ensemble qui conserve toute sa majesté."
                                            },
                                            {
                                                "example_id": "e2c53f47-4b2f-44f4-833a-ace16d025ffa",
                                                "sense_id": "9f684630-914a-3050-bfb2-45a88ff73c1e",
                                                "text": "[…] on pourrait dire que le soldat était convaincu que la moindre défaillance du moindre des troupiers pouvait compromettre le succès de l’ensemble et la vie de tous ses camarades - et que le soldat agissait en conséquence."
                                            },
                                            {
                                                "example_id": "23a64d5a-c8ba-45c1-94d1-d333789cb526",
                                                "sense_id": "9f684630-914a-3050-bfb2-45a88ff73c1e",
                                                "text": "Or il se trouve que très fréquemment de nombreux arbres sont les uns à côté des autres. Ils peuvent être d’espèces différentes, chacun luttant avec le voisin pour la lumière ; l’ensemble forme un groupement homogène appelé forêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5473829-5dd0-340a-9098-9191d815dfe7",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Unité résultant du concours harmonieux des diverses parties d’un tout ; accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e62261-5409-486f-ac6b-7b372f900f34",
                                                "sense_id": "a5473829-5dd0-340a-9098-9191d815dfe7",
                                                "text": "[…] un goût malsain me retenait parmi ces êtres dont j’écoutais de loin les appels, les gémissements. […] ils me parvenaient sans ensemble mais souvent si fervents qu’ils réveillaient en moi d’inavouables appétits."
                                            },
                                            {
                                                "example_id": "c28dbd61-8a87-47c6-bcb8-c937077b532e",
                                                "sense_id": "a5473829-5dd0-340a-9098-9191d815dfe7",
                                                "text": "Dès l'automne, la Fougère Aigle aux frondes desséchées attriste de sa teinte rouille la tonalité déjà grise de l’ensemble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290e4fc2-db87-35c0-9410-2df1ddd32eb7",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Collection d’éléments harmonisés, assortis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b404aaf-8278-4efd-81d5-91ce387a0ce2",
                                                "sense_id": "290e4fc2-db87-35c0-9410-2df1ddd32eb7",
                                                "text": "Ensemble mobilier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd579d1f-7be7-3163-a65e-43a514e08a65",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Costume féminin composé de deux ou trois pièces, équivalent du complet masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ffaf410-7527-4f21-904c-42dfa5bc8e77",
                                                "sense_id": "dd579d1f-7be7-3163-a65e-43a514e08a65",
                                                "text": "Le 22 novembre 1963, Jackie Kennedy porte son ensemble rose devenu culte. […]. Un tailleur jupe en laine rose gansé de noir, assorti joli­ment avec son chapeau tambou­rin, sorte de bibi aux bords rigides qu’elle a large­ment démo­cra­tisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9947035a-1d3a-3a5c-b63e-c35e7bdbeabc",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Collection d’éléments mathématiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10676ea6-fbee-4277-b181-19ec303b4964",
                                                "sense_id": "9947035a-1d3a-3a5c-b63e-c35e7bdbeabc",
                                                "text": "On pourrait confondre ensemble et propriété en identifiant un ensemble avec la propriété qui le définit. Ce n'est pas le point de vue adopté : l’ensemble ne retient que le résultat final, c'est-à-dire les objets sélectionnés, et non la propriété utilisée pour opérer la sélection."
                                            },
                                            {
                                                "example_id": "45f8cae3-6ab6-4b8e-98e1-cb4a97d066c2",
                                                "sense_id": "9947035a-1d3a-3a5c-b63e-c35e7bdbeabc",
                                                "text": "L’ensemble ne contenant aucun élément est appelé l’ensemble vide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d2c9f6-f057-3db5-9659-c24bd4d1fb04",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Groupe plus ou moins important d’habitations bénéficiant de certains équipements collectifs."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11098259-27e6-4665-9db5-c4fb96fb7004",
                                                "sense_id": "d7d2c9f6-f057-3db5-9659-c24bd4d1fb04",
                                                "text": "Inclus dans ce site, les puits ne sont qu’un élément d'un vaste ensemble fortifié qui s’étend au plateau latéritique situé au sud du village de Diamon."
                                            },
                                            {
                                                "example_id": "ebeea119-d727-4b1d-897d-9bd0c37a151e",
                                                "sense_id": "d7d2c9f6-f057-3db5-9659-c24bd4d1fb04",
                                                "text": "Grands ensembles, ensembles immobiliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8071f9dd-c305-3ac8-bd4e-25d17c846ad3",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Groupe de musiciens, de chanteurs ; formation musicale, orchestre, chorale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b5a158-9899-496f-b3ed-d5f92f3ed158",
                                                "sense_id": "8071f9dd-c305-3ac8-bd4e-25d17c846ad3",
                                                "text": "En 1973, quand le centre d'activités culturelles et de loisirs de Sully organisait son « florilège musical » en présentant un récital de guitare, un récital d'orgue et un concert de l’Ensemble instrumental Andrée Colson, tu n'étais pas intéressé encore ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af32632b-5960-3823-8afb-147e26142c26",
                                        "entry_id": "3a675e05-899f-3da3-82f2-6bf6e2eaf675",
                                        "glosses": [
                                            "Type abstrait de données non ordonnées et sans doublon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
