                        "examples": [
                            {
                                "example_id": "04033a88-4fee-4b04-88e3-e137673e9cc2",
                                "sense_id": "ed994659-842b-3e39-a42b-62c7f619be94",
                                "text": "„Die Schusterwerkstatt ernährt gerade den Vater und den Ältesten, die außerdem noch einige Fleckchen Land bewirtschaften und eine Kuh und einige Schafe haben.“"
                            },
                            {
                                "example_id": "46806d66-46a3-4369-b531-2ab4887d8216",
                                "sense_id": "ed994659-842b-3e39-a42b-62c7f619be94",
                                "text": "„Der letzte Tippelt, der hier wohnte, war Christas Onkel Rudolf, bis zur Aussiedlung hatte er unterm Dach seine Schusterwerkstatt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
