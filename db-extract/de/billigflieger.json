                "senses": [
                    {
                        "sense_id": "c32ed901-d1a6-3376-b1ec-7f63fb1e985b",
                        "entry_id": "412e3f90-074a-37e3-8929-3c37a1f1d3b3",
                        "glosses": [
                            "Fluggesellschaft, die ihre Flüge zu sehr niedrigen Preisen anbietet, oder eines ihrer Flugzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fbe7436-cfae-4355-a2f3-254d8932ca27",
                                "sense_id": "c32ed901-d1a6-3376-b1ec-7f63fb1e985b",
                                "text": "Viele Urlauber erreichen ihr Ziel mit Billigfliegern."
                            },
                            {
                                "example_id": "704e43f4-beba-4a3a-9a22-095a80a9e025",
                                "sense_id": "c32ed901-d1a6-3376-b1ec-7f63fb1e985b",
                                "text": "„Dann fing er an, auf diese verdammten Billigflieger zu schimpfen, in denen man zwischen halb vertrottelten Beamten wie in Sardinenbüchsen eingeklemmt hockte, und schwor, nie wieder wolle er sich auf diese Weise eingeengt fühlen.“"
                            },
                            {
                                "example_id": "42f79a8e-efea-4cd4-ac0a-6e7df07ec8b6",
                                "sense_id": "c32ed901-d1a6-3376-b1ec-7f63fb1e985b",
                                "text": "„Nach einer erneuten Boardkarten-Kontrolle verlassen die drei vermeintlich blinden Passagiere den Billigflieger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
