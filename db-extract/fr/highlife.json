                "senses": [
                    {
                        "sense_id": "d33bccab-6264-3840-bbb7-a82fda27df40",
                        "entry_id": "e9ca5d83-b4a7-371e-8d2c-73df5b258da4",
                        "glosses": [
                            "Genre musical du Ghana, né dans les années 1920, précurseur de l’afrobeat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1d08dd-fafd-48d8-b996-0f15c18ba294",
                                "sense_id": "d33bccab-6264-3840-bbb7-a82fda27df40",
                                "text": "Saxophoniste, pianiste, chanteur, Fela apparaît comme le musicien africain le plus connu du continent et comme un opposant politique de première grandeur. D’abord musicien de highlife (mélange de rythmes traditionnels ghanéens, de jazz et de fanfare), il découvre la soul américaine et donne naissance à l’afrobeat (croisement de la soul et du highlife)."
                            },
                            {
                                "example_id": "69f3f419-59e8-42d9-9ee8-5ab27fd48539",
                                "sense_id": "d33bccab-6264-3840-bbb7-a82fda27df40",
                                "text": "On écoutait de la musique toute la journée et je découvrais de nouveaux styles comme le highlife, l’afrobeat, le funk, la soul, la rumba."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc21e1e5-ca57-3bef-a12a-c609224f5c23",
                        "entry_id": "e9ca5d83-b4a7-371e-8d2c-73df5b258da4",
                        "glosses": [
                            "Grand monde, haute société."
                        ],
                        "tags": [
                            "Anglicism",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "28bf4d20-eab7-4d08-af7c-2445cb1102ed",
                                "sense_id": "dc21e1e5-ca57-3bef-a12a-c609224f5c23",
                                "text": "Ce regard la signait grande dame, femme de highlife, malgré la bourgeoise épaisseur de ses formes et l’enluminure de son teint."
                            },
                            {
                                "example_id": "c6867173-474c-4c0f-a94e-79958ec2a10e",
                                "sense_id": "dc21e1e5-ca57-3bef-a12a-c609224f5c23",
                                "text": "Le défilé s’achevait. Les dernières calèches ne faisaient point partie de la cavalcade. Elles appartenaient au highlife et circulaient, promenant les curieuses élégantes qui s’y prélassaient."
                            }
                        ]
                    }
