                        "examples": [
                            {
                                "example_id": "9844f6ee-697c-40bd-bc2b-3f30375919a7",
                                "sense_id": "4d87faff-e042-3f7a-8684-1f3bfd71a1f0",
                                "text": "Na rynku jest bardzo duży wybór różnego rodzaju środków do uszczelniania, m.in.: silikony, pianki, wyciskacze, specjalne taśmy, kleje. Takim wypełniaczem jest silikon szklarski – jednoskładnikowe szczeliwo, które pod wpływem działania powietrza i wilgoci utwardza się, tworząc elastyczne i wytrzymałe uszczelnienie elastomerowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
