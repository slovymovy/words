                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d69190b-5ef3-4c3f-8bde-2e4c57e06864",
                        "source_entry_id": "8050605e-beac-3e40-a62b-88a41f874ae8",
                        "source_sense_id": "e5639ec7-9379-3aaf-8f88-07f3ac8130cf",
                        "target_lang_word": "cramp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cramp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddefc67-52eb-3bbd-98bb-d80e5c2c3a1d",
                                        "entry_id": "078519e1-98cf-3ef3-90e2-2742436a4be2",
                                        "glosses": [
                                            "A painful contraction of a muscle which cannot be controlled; (sometimes) a similar pain even without noticeable contraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0467bc0c-e85f-42a2-939d-3375c2b6b462",
                                                "sense_id": "4ddefc67-52eb-3bbd-98bb-d80e5c2c3a1d",
                                                "text": "He retired hurt at 31 due to a leg cramp."
                                            },
                                            {
                                                "example_id": "5ebfafa8-2c11-4bd0-ac3b-ec1b7751b993",
                                                "sense_id": "4ddefc67-52eb-3bbd-98bb-d80e5c2c3a1d",
                                                "text": "August 1534, Margaret Roper (or Thomas More in her name), letter to Alice Alington\nthe cramp also that divers nights gripeth him in his legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3bfbd5b-4b49-3bd5-8b36-b2a739d9e766",
                                        "entry_id": "078519e1-98cf-3ef3-90e2-2742436a4be2",
                                        "glosses": [
                                            "That which confines or contracts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f19d6b-b9b5-44a4-bdce-0e11b1c62403",
                                                "sense_id": "f3bfbd5b-4b49-3bd5-8b36-b2a739d9e766",
                                                "text": "A narrow Fortune is undoubtedly a Cramp to a great Mind."
                                            },
                                            {
                                                "example_id": "99b5419d-d04f-48ae-b97c-d56d303f6769",
                                                "sense_id": "f3bfbd5b-4b49-3bd5-8b36-b2a739d9e766",
                                                "text": "How does it grate upon his thankleſs ear, / Crippling his pleaſures with the cramp of fear!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c4510e-2d77-3976-8bf9-aac56c348590",
                                        "entry_id": "078519e1-98cf-3ef3-90e2-2742436a4be2",
                                        "glosses": [
                                            "A clamp for carpentry or masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3287de8f-e0ed-3418-8d0a-8c38bdfb7387",
                                        "entry_id": "078519e1-98cf-3ef3-90e2-2742436a4be2",
                                        "glosses": [
                                            "A piece of wood having a curve corresponding to that of the upper part of the instep, on which the upper leather of a boot is stretched to give it the requisite shape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cramp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac7e24a2-5655-3dae-8955-fd924693a1d9",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "(of a muscle) To contract painfully and uncontrollably."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d214a29-2c92-3821-89f7-d4a9ce545ebb",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To affect with cramps or spasms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a17dab-ff5c-43d8-803c-b4ccfa991659",
                                                "sense_id": "7d214a29-2c92-3821-89f7-d4a9ce545ebb",
                                                "text": "The collar of the tunic scratched my neck, the steel helmet made my head ache, and the puttees cramped my leg muscles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b964690f-fcb1-36c6-ba96-270aa86704ef",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To prohibit movement or expression of."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82eb9112-a7ea-441a-9336-b6a6cde7e169",
                                                "sense_id": "b964690f-fcb1-36c6-ba96-270aa86704ef",
                                                "text": "You're cramping my style."
                                            },
                                            {
                                                "example_id": "e1beecd8-30a8-4da2-aab0-8b9ba48ca4b8",
                                                "sense_id": "b964690f-fcb1-36c6-ba96-270aa86704ef",
                                                "text": "But the front of the animal , which was in full , was narrow and cramped , and unequal in dignity to the side"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5496ba-e426-32f5-abbc-203f38c8b89f",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To restrain to a specific physical position, as if with a cramp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbb6f33-e7a7-4e9f-b0df-da5cb40117f1",
                                                "sense_id": "0c5496ba-e426-32f5-abbc-203f38c8b89f",
                                                "text": "You're going to need to cramp the wheels on this hill."
                                            },
                                            {
                                                "example_id": "ee12b94d-a0fa-4f56-b0fc-36413bb85dac",
                                                "sense_id": "0c5496ba-e426-32f5-abbc-203f38c8b89f",
                                                "text": "when the gout cramps my joints"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55cefa5a-24a9-3052-8962-9399cfdc89f2",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To fasten or hold with, or as if with, a cramp iron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2d19961-3e79-3e19-81ef-24fb7443a4a1",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To bind together; to unite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5448c18c-03ff-403a-90b9-7d92dcd3b2ea",
                                                "sense_id": "e2d19961-3e79-3e19-81ef-24fb7443a4a1",
                                                "text": "The […] fabric of universal justice is well cramped and bolted together in all its parts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1770eb6-8fd1-3274-af1e-7a87af0fa66b",
                                        "entry_id": "af9c6086-c2a8-365d-99f1-ef4eb9fe4d36",
                                        "glosses": [
                                            "To form on a cramp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8b55c1-12e7-402c-a87d-9f5c6d2fe87d",
                                                "sense_id": "b1770eb6-8fd1-3274-af1e-7a87af0fa66b",
                                                "text": "to cramp boot legs"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cramp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96fc4c16-e6b7-37c5-833b-2262f32732ff",
                                        "entry_id": "7eeeb508-d742-38e3-9c82-e1134e58cd67",
                                        "glosses": [
                                            "cramped; narrow"
