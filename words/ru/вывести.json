                            },
                            {
                                "target_lang_word": "develop",
                                "target_lang_sense_clarification": "new varieties or strains"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "kweken",
                                "target_lang_sense_clarification": "planten of dieren"
                            },
                            {
                                "target_lang_word": "fokken",
                                "target_lang_sense_clarification": "dieren"
                            },
                            {
                                "target_lang_word": "ontwikkelen",
                                "target_lang_sense_clarification": "nieuwe variëteiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bef546d-4e60-3e23-a038-3f6cb8fc7352",
                    "sense_definition": "Прийти к логическому заключению или получить формулу на основе рассуждений",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент смог самостоятельно <вывести> сложную математическую формулу.",
                            "target_lang_translations": {
                                "en": "The student was able to independently <derive> a complex mathematical formula.",
                                "nl": "De student was in staat om zelfstandig een complexe wiskundige formule af te <leiden>."
                            }
                        },
                        {
                            "text": "Из этих фактов можно <вывести> интересную закономерность.",
                            "target_lang_translations": {
                                "en": "From these facts, one can <deduce> an interesting pattern.",
                                "nl": "Uit deze feiten kan men een interessant patroon <concluderen>."
                            }
                        }
                    ],
                    "synonyms": [
