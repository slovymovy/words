                                "target_senses": [
                                    {
                                        "sense_id": "0b0a7d0b-dabc-3109-b30a-210c9c8bfd30",
                                        "entry_id": "156bb7d0-baaf-3414-a971-e6b15a990f20",
                                        "glosses": [
                                            "Kanada betreffend, aus Kanada kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76ffedf-a03d-4e8e-91bf-0dcac45564e9",
                                                "sense_id": "0b0a7d0b-dabc-3109-b30a-210c9c8bfd30",
                                                "text": "Die kanadischen Ureinwohner werden „First Nations“ genannt."
                                            },
                                            {
                                                "example_id": "c6014000-c29e-483f-8e64-14a58e0c5085",
                                                "sense_id": "0b0a7d0b-dabc-3109-b30a-210c9c8bfd30",
                                                "text": "„Das kanadische Parlament hat einem Militäreinsatz im Kampf gegen die Dschihadistengruppe \"Islamischer Staat\" (IS) zugestimmt.“"
                                            },
                                            {
                                                "example_id": "780e6323-20c3-436b-a73b-37a25b8eb9ba",
                                                "sense_id": "0b0a7d0b-dabc-3109-b30a-210c9c8bfd30",
                                                "text": "So betrachtet ist Ottawa die kanadischste Stadt des Landes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "941e0d10-987a-4417-b75f-1cf4b1396c7f",
                        "source_entry_id": "d722a04e-bdf7-3d79-947b-fca8d48db158",
                        "target_lang_word": "Dollar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dollar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                        "entry_id": "606fb922-7ea1-3259-a5fa-137c58c037eb",
                                        "glosses": [
                                            "Währungseinheit in verschiedenen Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf741aa-93c1-4033-a1e9-351c293e8aef",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "Diese Jeans kostet 25 Dollar."
                                            },
                                            {
                                                "example_id": "dc0ec809-6acd-446a-a69a-9c435d3e974e",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "Sie warf mehrere Dollars auf den Tisch."
                                            },
                                            {
                                                "example_id": "5f5f5b53-f3fd-491b-aafd-780a2dd2df19",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "„Mehr als 370 Mrd. Dollar Währungsreserven hat Brasilien angehäuft.“"
                                            },
                                            {
                                                "example_id": "96cf22a9-74ba-4df7-a1a0-d22e592c1a2c",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "„Und ich saß da, um sechzig Dollar ärmer, und hatte ein Stück Papier in der Hand.“"
                                            },
                                            {
                                                "example_id": "15bfb4f7-df59-4cd2-a940-7f1cdc5ca982",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "„Ich bekam eine Kopie meines Lehrlingsvertrags, zusammen mit einer Summe von zehn Dollar, die mir vermutlich Sir Thomas Hardy zukommen ließ.“"
                                            },
                                            {
                                                "example_id": "985261d3-9c59-4d40-81c7-40a8faebbaf8",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "„Mr. Lane drückte auf den Knopf der Ladenkasse und holte einen halben Dollar aus dem Fach.“"
                                            },
                                            {
                                                "example_id": "5ad16c74-99f2-436c-856d-e5fc770d8742",
                                                "sense_id": "64998717-f4f5-322d-a3f0-043a132ba9c4",
                                                "text": "„Ich legte die hundert Dollars auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38eec32e-8d86-4cf1-a77e-eae57a55f1de",
                        "source_entry_id": "d722a04e-bdf7-3d79-947b-fca8d48db158",
                        "target_lang_word": "Münze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Münze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                        "entry_id": "a53d474d-a59b-3da2-a26f-3c89b894a080",
                                        "glosses": [
                                            "flaches, meist kreisförmiges und geprägtes Stück Metall, das als Zahlungsmittel benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4afecc-5849-4bef-9e5c-c508d2aeb238",
                                                "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                                "text": "Ich zahle lieber mit Münzen."
                                            },
                                            {
                                                "example_id": "428e341d-bd40-4e2e-b21a-a212542e05fa",
                                                "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                                "text": "„Sie sind nur durch die Zeit ein wenig verfärbt, wie Münzen in den Taschen eines vergessenen Anzugs.“"
                                            },
                                            {
                                                "example_id": "655d7633-5a6b-4fee-9756-706874fc8e4f",
                                                "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                                "text": "„Die venezianischen Münzen sind nicht gerändert.“"
                                            },
                                            {
                                                "example_id": "d46a52f2-8af6-4c3f-aecb-59a7b97326a7",
                                                "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                                "text": "„Ich erschrak, als die erste Münze in meinen Hut fiel: Es war ein Groschen, er traf die Zigarette, verschob sie zu sehr an den Rand.“"
                                            },
                                            {
                                                "example_id": "7bd1e83a-7c69-4123-b745-3e047863a971",
                                                "sense_id": "d7c6fc6d-4d88-3625-aad0-c2b4f6bb7152",
                                                "text": "„Die Archäologen jedenfalls fanden zahllose Votivgaben, die belegen, dass vier Jahrhunderte lang an den Ort gepilgert wurde, darunter waren 700 Münzen aus 450 Jahren, Statuen für Apollo und die Sirona sowie den Merkur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "283f3703-a922-3b81-99b9-c0e9357f24cf",
                                        "entry_id": "a53d474d-a59b-3da2-a26f-3c89b894a080",
                                        "glosses": [
                                            "Institution zur Herstellung von [1]: Kurzform für Münzprägeanstalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c4b673-77fb-4a1c-9782-bb1f23d123f8",
                                                "sense_id": "283f3703-a922-3b81-99b9-c0e9357f24cf",
                                                "text": "Ein Teil der Euro-Münzen wurde in der Münze in Bern geprägt."
                                            },
                                            {
                                                "example_id": "b54a3271-03b7-4b0b-8c3c-c5bc675c6423",
                                                "sense_id": "283f3703-a922-3b81-99b9-c0e9357f24cf",
                                                "text": "„1442 wurde die englische Münze in Calais geschlossen, die von den Geldeinnahmen aus dem Wollverkauf des Calaiser Stapels lebte.“"
                                            },
                                            {
                                                "example_id": "83cb9d1c-fe7c-462b-8351-b217c4492fd4",
                                                "sense_id": "283f3703-a922-3b81-99b9-c0e9357f24cf",
                                                "text": "„Ich erhielt sie in holländischen Dukaten, die in der Münze von Mitau geprägt worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
