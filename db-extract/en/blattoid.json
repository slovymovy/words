                        "entry_id": "08ba1858-9b2f-3432-8887-f6f8286c9053",
                        "glosses": [
                            "Any member of the Blattoidea superfamily of cockroaches and termites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfa1050-9fcb-4f84-a170-a9576814229f",
                                "sense_id": "350d47b2-58d5-3dd9-8bfc-f4e1002b42a9",
                                "text": "This result, however, is much younger than some “roachoid” fossils and clearly invalidates the hypothesis suggesting that winged “blattoids” would date back to the Devonian."
                            },
                            {
                                "example_id": "6b949897-2198-411f-81a1-88f1248fbfd3",
                                "sense_id": "350d47b2-58d5-3dd9-8bfc-f4e1002b42a9",
                                "text": "However, a subgroup analysis (by order) indicated that the DGC facilitated gaseous exchange in dipterans (0.43 ± 0.34; estimate ± 95% CI; p = 0.01), but not in blattoids (p = 0.89) or orthopterans (p = 0.57) (Figure 5a)."
                            }
                        ]
                    }
