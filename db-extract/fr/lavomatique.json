                        "entry_id": "8ae90e7e-2eed-3e4d-b5b3-7e4f83ff0f64",
                        "glosses": [
                            "Laverie automatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd267fa0-871b-4377-98c3-ca4ad295b869",
                                "sense_id": "b07c3d8b-a091-3853-9f94-6c00f68c52e4",
                                "text": "Il observait la vitre du café situé derrière lui, dans laquelle se reflétait le lavomatique du trottoir d’en face ainsi que la silhouette debout devant la vitrine à l’intérieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4f6bfcb-44c4-4187-b01a-60d46aa1118b",
                        "source_entry_id": "8ae90e7e-2eed-3e4d-b5b3-7e4f83ff0f64",
                        "source_sense_id": "b07c3d8b-a091-3853-9f94-6c00f68c52e4",
                        "target_lang_word": "launderette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "launderette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17f8bd27-3ea8-3698-bb3c-4766c56e843b",
                                        "entry_id": "8a48f4c5-c8dc-36dc-bc07-f8e52738cefa",
                                        "glosses": [
                                            "A place that has facilities for washing and drying clothes that the public may pay to use."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16d7e08a-a450-3d73-8c79-645fd2fcf83e",
                                        "entry_id": "8a48f4c5-c8dc-36dc-bc07-f8e52738cefa",
                                        "glosses": [
                                            "A money laundering operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed57cf2-7bca-4cc0-9f8e-b198c1474e11",
                                                "sense_id": "16d7e08a-a450-3d73-8c79-645fd2fcf83e",
                                                "text": "The distinction is by no means watertight as any 'money launderette' may become a money launderer – and hence be guilty of a money laundering offence – the moment it knowingly engages in a money laundering operation."
                                            },
                                            {
                                                "example_id": "eb58890e-f3d2-450a-9eb7-c942a1aef920",
                                                "sense_id": "16d7e08a-a450-3d73-8c79-645fd2fcf83e",
                                                "text": "From drug money to terrorist finance: the launderette's many different washing cycles"
                                            },
                                            {
                                                "example_id": "f0f33f83-8b99-4064-b211-0a981df428af",
                                                "sense_id": "16d7e08a-a450-3d73-8c79-645fd2fcf83e",
                                                "text": "This is a stage at which the proceeds of illegal activity are introduced into the financial system and therefore it is the most vulnerable stage in the launderette. Perhaps this is why anti-money laundering measures are concerned about “Know Your Customer Principle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "970e0f20-db2c-4f82-aefe-1be947100ca3",
                        "source_entry_id": "8ae90e7e-2eed-3e4d-b5b3-7e4f83ff0f64",
                        "source_sense_id": "b07c3d8b-a091-3853-9f94-6c00f68c52e4",
                        "target_lang_word": "laundromat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laundromat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec3c114-2cd6-33e9-9c8b-803f7eabab7a",
                                        "entry_id": "bfd9986e-d942-3c09-8dcf-4e11902b0eae",
                                        "glosses": [
                                            "A self-service laundry facility with (traditionally) coin-operated (which now may use other per-load payment methods) washing machines, dryers, and sometimes ironing or pressing machines, open to the public for washing clothing and household cloth items."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df13edfe-5b71-4053-ac55-c84e55970222",
                                                "sense_id": "6ec3c114-2cd6-33e9-9c8b-803f7eabab7a",
                                                "text": "In Virginia, gone are the weekly outings to Walmart to stock up on provisions; to El Ranchito, the Mexican convenience store, to buy shell-shaped concha pastries; and to the laundromat to machine wash heavily soiled garments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "259aa6d6-8ed3-3de4-9829-07610a329422",
                                        "entry_id": "bfd9986e-d942-3c09-8dcf-4e11902b0eae",
                                        "glosses": [
                                            "A money laundering operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bceab74-d949-4621-a27a-1b6af40f238d",
                                                "sense_id": "259aa6d6-8ed3-3de4-9829-07610a329422",
                                                "text": "The Russian laundromat was soon nicknamed the Moldovan laundromat, as it centred on transactions between Russia and the small, poor country locked between Ukraine and Romania."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
