                                    {
                                        "sense_id": "0a4e15e3-601f-3dc1-872f-466d0612aa25",
                                        "entry_id": "0ea78ac9-aaac-3b3a-b2f1-716db33a12c9",
                                        "glosses": [
                                            "der Standpunkt der Transzendentalphilosophie Immanuel Kants, der sich mit den apriorischen, notwendigen Bedingungen der Möglichkeit von Erkenntnis befasst"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e05bd00-306a-362c-86c6-b6cbca438ae0",
                                        "entry_id": "0ea78ac9-aaac-3b3a-b2f1-716db33a12c9",
                                        "glosses": [
                                            "der Standpunkt des vom deutschen Idealismus beeinflußten amerikanischen Neu-Idealismus Ralph Waldo Emersons, Henry David Thoreaus und anderen (vgl. [1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a57919-27c2-4e88-96a8-f5e1f5b8b0e5",
                                                "sense_id": "8e05bd00-306a-362c-86c6-b6cbca438ae0",
                                                "text": "„Nach 1830 empfing die Literatur der USA entscheidende Antriebe von der idealistischen Lebensphilosophie des Transzendentalismus, der sich in Neuengland entfaltete und im Werk von R. W. Emerson, H. D. Thoreau und H. Beecher-Stowe (gegen Sklaventum) weltweite Wirkung ausstrahlte.“"
                                            },
                                            {
                                                "example_id": "7f41a069-87d7-4e1d-9f40-80d63112b7f2",
                                                "sense_id": "8e05bd00-306a-362c-86c6-b6cbca438ae0",
                                                "text": "„Die Romandichter dieser Zeit, N. Hawthorne und H. Melville, setzten sich schöpferisch mit dem Transzendentalismus auseinander, indem sie dessen optimistische Weltanschauung in Frage stellten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
