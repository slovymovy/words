                        "cross_references": [
                            {
                                "target_word": "Typhus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                        "entry_id": "da84a2b6-aa3d-30f9-945a-329142014d06",
                                        "glosses": [
                                            "schwere, fieberhafte Darminfektionskrankheit, die verbunden ist mit fleckigem Hautausschlag und Benommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2264355-e5a1-4363-b092-5eb378624d2a",
                                                "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                                "text": "Vor seiner Fernreise ließ er sich gegen Typhus impfen."
                                            },
                                            {
                                                "example_id": "929439c3-0d2a-40ac-ba68-f29cdf1afb3f",
                                                "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                                "text": "„Nach der Flut sind Millionen Menschen von Seuchen wie Cholera und Typhus bedroht.“"
                                            },
                                            {
                                                "example_id": "f76a32d1-8eeb-405c-b1d2-561741f684c1",
                                                "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                                "text": "„Gelbsucht und Typhus sind aus der Mode gekommen.“"
                                            },
                                            {
                                                "example_id": "dc26aba1-35d6-456b-8214-5b08bb41ca6b",
                                                "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                                "text": "„Der Ausbruch von Typhus wurde von einem Gefängnisarzt bestätigt.“"
                                            },
                                            {
                                                "example_id": "66f2ac44-e55d-4c9f-964b-51e7091b3586",
                                                "sense_id": "875723ee-1e50-31af-a3ce-9fb67369bc7e",
                                                "text": "„Die besorgte Mutter holte den Arzt, und der stellte Typhus fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08a6387f-ebe8-47cf-9ab9-409dc87aa7a7",
