                                        "entry_id": "26cdd065-67d9-3a09-bcc1-07174c5ead0b",
                                        "glosses": [
                                            "Any of many extinct primitive amphibians (labyrinthodonts) of the order Temnospondyli, from the Carboniferous, Permian and Triassic periods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d28bfe-351b-47fc-9e89-f7b7151ac2d6",
                                                "sense_id": "497556c8-6caa-30b5-8576-2c1095ce5d12",
                                                "text": "Experts disagree over whether temnospondyls were ancestral to modern amphibians (frogs, salamanders and caecilians), or whether the whole group died out without leaving descendants."
                                            },
                                            {
                                                "example_id": "943fbeb9-797c-4600-9f11-8ce23f8924ac",
                                                "sense_id": "497556c8-6caa-30b5-8576-2c1095ce5d12",
                                                "text": "Nigerpeton is a temnospondyl, more closely related to modern amphibians than to amniotes, but far bigger than today's diminutive amphibians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
