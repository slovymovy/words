                "translations": [
                    {
                        "translation_id": "743acf43-2168-452b-a22c-9afa6e77cbc8",
                        "source_entry_id": "023eb1f5-d559-3cdb-9a98-a7563691b7d0",
                        "source_sense_id": "457f5720-5f09-3ff7-9422-85649811ef76",
                        "target_lang_word": "shovel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shovel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3a30de-c630-3534-9aaa-0c4da2a3a6e8",
                                        "entry_id": "5b8f1c2f-6b40-3151-9164-d4607850d1a9",
                                        "glosses": [
                                            "A hand tool with a handle, used for moving portions of material such as earth, snow, and grain from one place to another, with some forms also used for digging. In strict usage differentiated from a spade, which is designed solely for small-scale digging and incidental tasks such as chopping of small roots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5d0f68-ac94-4b2f-9f2b-a8bbaf75987e",
                                                "sense_id": "8d3a30de-c630-3534-9aaa-0c4da2a3a6e8",
                                                "text": "It was said that such train crews kept a spare shovel on board because, on numerous occasions, the beginner had not only zealously thrown coal into the firebox but had let the shovel go as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2069cb38-b8bd-3ef7-8c42-38ffea3909f3",
                                        "entry_id": "5b8f1c2f-6b40-3151-9164-d4607850d1a9",
                                        "glosses": [
                                            "A mechanical part of an excavator with a similar function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd0c8b05-2724-3f14-95d7-22a18cb0cb41",
                                        "entry_id": "5b8f1c2f-6b40-3151-9164-d4607850d1a9",
                                        "glosses": [
                                            "Any shovel in the above senses, or any spade."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49f88cd6-049f-3726-9265-1b5bc18ec016",
                                        "entry_id": "5b8f1c2f-6b40-3151-9164-d4607850d1a9",
                                        "glosses": [
                                            "Ellipsis of shovel hat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6791dc7-10ea-4e53-a1ae-8754adc56e97",
                                                "sense_id": "49f88cd6-049f-3726-9265-1b5bc18ec016",
                                                "text": "No one seems to like the offer, and the umpire is just coming down, when a queer old hat, something like a doctor of divinity's shovel, is chucked on to the stage […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shovel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                        "entry_id": "a7a755f8-98f5-3e9a-b7e1-69992017e324",
                                        "glosses": [
                                            "To move materials with a shovel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49f6997-81c8-4976-9a5c-c16893d32689",
                                                "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                                "text": "The workers were shovelling gravel and tarmac into the pothole in the road."
                                            },
                                            {
                                                "example_id": "f4d5e8ec-b3e3-43e9-9839-a86827cd42c9",
                                                "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                                "text": "After the blizzard, we shoveled the driveway for the next two days."
                                            },
                                            {
                                                "example_id": "5135dbcd-8db0-47ab-822a-04f16e4b0faa",
                                                "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                                "text": "I don't mind shoveling, but using a pickaxe hurts my back terribly."
                                            },
                                            {
                                                "example_id": "fbc1d85f-8186-4437-9c47-6a4b945aabf3",
                                                "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                                "text": "Off again, a fierce light now trailing out behind us from the open furnace door, lighting up the fireman as he shovelled more coal on to the furnace, [...]."
                                            },
                                            {
                                                "example_id": "ca951667-e7ed-4922-a264-e39c28bbc246",
                                                "sense_id": "abbc3477-326b-3f6e-8ee5-69c7bc985631",
                                                "text": "The coal is then transferred to broad-gauge wagons for transport to Dublin. The transhipment is a rather laborious business, the coal being shovelled by hand from one wagon to another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f105528-dde5-37d6-b04e-a72c45ced198",
                                        "entry_id": "a7a755f8-98f5-3e9a-b7e1-69992017e324",
                                        "glosses": [
                                            "To move with a shoveling motion."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b5e3f59-45cf-4376-b2eb-8269f2296659",
                                                "sense_id": "6f105528-dde5-37d6-b04e-a72c45ced198",
                                                "text": "Already late for work, I shovelled breakfast into my mouth as fast as possible."
                                            },
                                            {
                                                "example_id": "fe5b18d0-9996-4ff2-b806-18a9c9e2c4e8",
                                                "sense_id": "6f105528-dde5-37d6-b04e-a72c45ced198",
                                                "text": "The keeper then seemed to claw it out with fabulous reflexes only for TV replays to show the ball had most probably crossed the line before Forster had shovelled it away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
