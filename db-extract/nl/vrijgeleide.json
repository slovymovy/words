                "senses": [
                    {
                        "sense_id": "88e6bb57-aa7b-3d48-8a58-d3d3094bb2ee",
                        "entry_id": "4c525122-0b5a-3c49-9f0f-400db86666f7",
                        "glosses": [
                            "officieel document waarin staat dat iemand toestemming heeft door een vijandig gebied af te reizen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edb3905-4c1a-42c5-9d23-41a8996c677f",
                                "sense_id": "88e6bb57-aa7b-3d48-8a58-d3d3094bb2ee",
                                "text": "Geruchten dat de Amerikanen samenwerken met IS doen al de ronde sinds de herverovering van Raqqa, in oktober dit jaar. Toen kregen een aantal IS-terroristen en hun familieleden een vrijgeleide van de Amerikanen om uit Raqqa te vertrekken. Dat zouden niet enkele honderden, maar enkele duizenden terroristen zijn geweest."
                            },
                            {
                                "example_id": "f2f2e26c-f9c3-4e4a-b547-3b0de2931e66",
                                "sense_id": "88e6bb57-aa7b-3d48-8a58-d3d3094bb2ee",
                                "text": "Op 9 januari werd eveneens in Parijs een gijzeling uitgevoerd in de supermarkt l'Hyper Cacher. De gijzelnemer doodde vier mensen voor de politie hem doodschoot. Het doel van zijn actie was geweest een vrijgeleide voor de toen nog levende twee aanslagplegers op Charlie Hebdo te krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2a6c25b-da64-35be-a306-d633a7a34c59",
                        "entry_id": "4c525122-0b5a-3c49-9f0f-400db86666f7",
                        "glosses": [
                            "de vrije hand krijgen om te kunnen handelen zoals het je goeddunkt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
