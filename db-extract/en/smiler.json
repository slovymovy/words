                        "glosses": [
                            "A fan of American singer and actress Miley Cyrus."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fcebca19-e4e3-4838-b116-f545d2f05df6",
                                "sense_id": "b5b89963-e297-329e-9d07-3d9c952ef096",
                                "text": "When she rose to the throne of the iTunes charts with her single “Royals”, she was met with some hateful tweets from Smilers (aka Miley Cyrus fans)."
                            },
                            {
                                "example_id": "659b5339-0b68-4610-8c7d-29c758ef70a2",
                                "sense_id": "b5b89963-e297-329e-9d07-3d9c952ef096",
                                "text": "Smilers can expect tweets revolving around Miley's dogs, hit new album Bangerz and selfies with her classic tongue pose."
                            },
                            {
                                "example_id": "93cd7cf3-2c0f-4e1c-8685-994abffc6940",
                                "sense_id": "b5b89963-e297-329e-9d07-3d9c952ef096",
                                "text": "The singer, who missed Jingle Ball because of bad weather in the Big Apple, invited thousands of Smilers — the not-so-clever nickname given to her adoring acolytes — to attend the afternoon soundcheck before her sold-out show at TD Garden."
                            }
                        ]
                    }
