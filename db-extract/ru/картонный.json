                "senses": [
                    {
                        "sense_id": "43fb35fb-3f2d-3ff1-92a8-9a48bfa947b8",
                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным картон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad88f91f-9d64-4c3f-81a1-4036031e1148",
                                "sense_id": "43fb35fb-3f2d-3ff1-92a8-9a48bfa947b8",
                                "text": "Ни с того ни с сего возникли пожары на бумажном и картонном заводах."
                            }
                        ]
                    },
                    {
                        "sense_id": "012e5ccf-8a68-3755-9f03-8d0e2ae55883",
                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                        "glosses": [
                            "свойственный картону, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaea08cb-dea3-499b-a240-63203cba97f6",
                                "sense_id": "012e5ccf-8a68-3755-9f03-8d0e2ae55883",
                                "text": "Вместе они вытащили на лужайку стол и стулья, в чемодане Захара нашлась пачка чесночных крекеров картонного авиационного вкуса…"
                            }
                        ]
                    },
