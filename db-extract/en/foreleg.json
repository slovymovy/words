                                    {
                                        "sense_id": "d643a253-3b9a-37f6-8df7-93f9b0dafdf4",
                                        "entry_id": "7ef01dfb-4fc3-36ba-b7ab-ccf5822844a9",
                                        "glosses": [
                                            "vorderes Bein eines Tieres (von Hund, Katze, Rehwild und Ähnlichem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ee8d20-146e-4dfd-8c73-7d103d0c5703",
                                                "sense_id": "d643a253-3b9a-37f6-8df7-93f9b0dafdf4",
                                                "text": "„Wolf setzte sich nieder, hob den Kopf empor, sah seinem Herrn treuherzig in die Augen, warf sich mehrere Male unruhig von einem Vorderlauf auf den andern und stieß plötzlich ein klagendes Geheul aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fdf3a4c-8fa3-4715-9bb5-23499a232ec7",
                        "source_entry_id": "a7cff1c6-f8f4-31e9-8e81-7d81b16832aa",
                        "source_sense_id": "5f0bf468-2f95-38bc-b680-f9837d157be2",
                        "source_sense_description": "either of the two legs towards the front of a four-legged animal",
                        "target_lang_word": "Vorderbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorderbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                        "entry_id": "6b02b299-c58d-3544-8f91-11407f0d9222",
                                        "glosses": [
                                            "bei Tieren mit vier oder mehr Beinen eine der vorderen Gliedmaßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004d2097-b443-4bdc-9192-2895a769028a",
                                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                                "text": "Der Hund hat eine Verletzung am Hinterbein."
                                            },
                                            {
                                                "example_id": "275bdb20-8d7f-4144-8582-913a6c0d2946",
                                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                                "text": "„Der Wolf warf ihr nur einen flüchtigen Seitenblick zu, und statt zuzufassen, wie sie es sonst immer tat, hob Milka plötzlich die Rute in die Höhe und stemmte die Vorderbeine gegen den Boden.“"
                                            },
                                            {
                                                "example_id": "2bb2d265-3273-4984-a203-b2dd4ee60600",
                                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                                "text": "„Darauf löste er das Tau von den Vorderbeinen des Pferdes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
