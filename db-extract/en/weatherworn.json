                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a402c2c9-7bf5-415a-ba3b-f721197ba22c",
                                "sense_id": "650ddea6-607a-377f-8b77-9e1684ae5c55",
                                "text": "His hair, gray as the underwing of the owl whose note he forged, straggled in uncut disarray from under the drooping rim of a battered and weatherworn hat."
                            },
                            {
                                "example_id": "ff5bbb23-82fc-4f87-a1d3-a0d0d8fc7bd4",
                                "sense_id": "650ddea6-607a-377f-8b77-9e1684ae5c55",
                                "text": "Old Heck said again, his weatherworn features working convulsively, \"it's more than a mortal man can endure and stand!\""
                            },
                            {
                                "example_id": "b804d1a6-ce8a-4bf4-b9c3-697122330d6d",
                                "sense_id": "650ddea6-607a-377f-8b77-9e1684ae5c55",
                                "text": "A weather-worn Vauxhall thirty landaulette was awaiting us, and bumped us for six or seven miles over by-paths and lanes which, in spite of their natural seclusion, were deeply rutted and showed every sign of heavy traffic."
                            }
                        ]
                    }
