                "senses": [
                    {
                        "sense_id": "44438615-098b-3754-b26a-98f18594847a",
                        "entry_id": "a84c1577-858f-3423-8b52-8ee075407284",
                        "glosses": [
                            "Prinzip bei der Verwendung von Wortschriften, das darin besteht, nur die wichtigen Wörter zu schreiben (und die anderen auszulassen)"
                        ],
                        "tags": [
                            "speziell Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "0512df44-ce67-4922-84f7-7d16e0ac9c20",
                                "sense_id": "44438615-098b-3754-b26a-98f18594847a",
                                "text": "„Solange das Sumerische gesprochen wurde, das heißt eine lebende Sprache war, konnte man die gleichsam selektive Schreibweise, Schlagwortprinzip (englisch catchword principle) genannt, aufrechterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b5908a7-66d9-3fbc-99ae-c0742c751686",
                        "entry_id": "a84c1577-858f-3423-8b52-8ee075407284",
                        "glosses": [
                            "Art und Weise der Erschließung der Buchbestände"
                        ],
                        "tags": [
                            "Bibliothek"
                        ],
                        "examples": [
                            {
                                "example_id": "e3823b86-4f60-450e-92e9-5be090944cb7",
                                "sense_id": "6b5908a7-66d9-3fbc-99ae-c0742c751686",
                                "text": "„Ab dem Erwerbungsjahr 1994 erfolgt die sachliche Erschließung der neueren sportwissenschaftlichen Literatur nach dem Schlagwortprinzip und ist sowohl über den Online-Katalog als auch über den Südwestdeutschen Bibliotheksverbund (SWB) recherchierbar.“"
                            },
                            {
                                "example_id": "e5e1f1c9-252d-461e-85b3-954f576ac7b7",
                                "sense_id": "6b5908a7-66d9-3fbc-99ae-c0742c751686",
                                "text": "„Die andere Möglichkeit der sachlich-inhaltlichen Erschließung bietet das sachalphabetische oder Schlagwortprinzip.“"
                            },
                            {
                                "example_id": "0ada9d68-8252-43ca-8dd7-5f9dc4d88efc",
                                "sense_id": "6b5908a7-66d9-3fbc-99ae-c0742c751686",
                                "text": "„Er hat die Akten in grossen Gruppen aufgestellt und auch ein Verzeichnis begonnen, dessen Ordnung nach dem Schlagwortprinzip sich aber nicht durchführen liess.“"
                            },
                            {
                                "example_id": "5f61c397-606d-4b4f-bb7f-cef4c530de97",
                                "sense_id": "6b5908a7-66d9-3fbc-99ae-c0742c751686",
                                "text": "„Wenn auch seiner Entstehung nach keineswegs der jüngste - das Schlagwortprinzip findet in seinen Grundzügen schon in den Bibliothekskatalogen des Mittelalters Anwendung;…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
