                                    {
                                        "sense_id": "71a8e398-9739-3bc3-a323-db4d7b115708",
                                        "entry_id": "77693ca8-88b5-381a-83f4-d787ae2d39f8",
                                        "glosses": [
                                            "Baruch ben Neria, secrétaire du prophète Jérémie."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c2b923-249f-4a03-93ee-06e3387a5673",
                                                "sense_id": "71a8e398-9739-3bc3-a323-db4d7b115708",
                                                "text": "Voici les paroles du livre qu’écrivit Baruch, fils de Néreïas ; fils de Maasias, fils de Sédécias, fils de Sédéï, fils de Helcias, à Babylone, la cinquième année, le premier jour du mois, au temps où les Chaldéens avaient pris Jérusalem et l’avaient brûlée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                        "entry_id": "77693ca8-88b5-381a-83f4-d787ae2d39f8",
                                        "glosses": [
                                            "Livre de l’Ancien Testament, attribué au secrétaire de Jérémie."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445d8806-11f4-4d5a-a2a2-c9fd5842c70f",
                                                "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                                "text": "Le livre de Baruch est deutérocanonique, il n’est pas reconnu par les Protestants."
                                            },
                                            {
                                                "example_id": "7142d959-3f76-4601-b188-a1494ee42de7",
                                                "sense_id": "8486dcb8-1ad9-3924-879b-e6bb41324525",
                                                "text": "Celui qui nous était le plus familier était La Fontaine, […]. Sa biographie me révéla qu’une grande ferveur religieuse s’emparait parfois de lui. La lecture d’un livre de Baruch, disciple de Jérémie, avait tellement soulevé son enthousiasme qu’il arrêtait les passants et leur posait la question :\n« Avez-vous lu Baruch ? « Avez-vous lu Baruch ? »"
                                            }
                                        ]
                                    }
                                ]
                            },
