{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "3e5e092d-fb51-317e-81c0-74b4432c6784",
                    "sense_definition": "Употребляется для обозначения субъекта, который имеет что-либо или обладает чем-либо (соответствует глаголу «иметь»).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>У</w> меня есть интересная книга для тебя.",
                            "target_lang_translations": {
                                "en": "I <w>have</w> an interesting book for you.",
                                "de": "Ich <w>habe</w> ein interessantes Buch für dich.",
                                "pl": "<w>Mam</w> dla ciebie interesującą książkę."
                            }
                        },
                        {
                            "text": "Скажите, <w>у</w> вас есть свободное время сегодня вечером?",
                            "target_lang_translations": {
                                "en": "Tell me, do you <w>have</w> free time this evening?",
                                "de": "Sagen Sie, <w>haben</w> Sie heute Abend etwas Freizeit?",
                                "pl": "Proszę powiedzieć, czy <w>ma</w> pan dziś wieczorem wolny czas?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "у меня есть",
                        "у тебя есть",
                        "у нас есть",
                        "у вас есть"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to denote a subject who has something or possesses something (corresponds to the verb \"to have\").",
                        "de": "Wird verwendet, um auszudrücken, dass jemand etwas besitzt oder hat (entspricht dem Verb „haben“).",
                        "pl": "Wskazuje na podmiot, który coś posiada lub ma (odpowiada czasownikowi „mieć”)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "functional translation indicating possession"
                            },
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "literal translation, rarely used in modern English for possession"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "haben",
                                "target_lang_sense_clarification": "Funktionale Übersetzung, die Besitz anzeigt (in Verbindung mit dem Dativ-Objekt)."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mieć",
                                "target_lang_sense_clarification": "tłumaczenie funkcjonalne wyrażające posiadanie"
                            },
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "konstrukcja przyimkowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ab5828d-11c2-3ed6-91d9-afac5d355b63",
                    "sense_definition": "Указывает на нахождение в непосредственной близости, рядом с кем-либо или чем-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились встретиться <w>у</w> входа в парк.",
                            "target_lang_translations": {
                                "en": "We agreed to meet <w>at</w> the entrance to the park.",
                                "de": "Wir haben uns verabredet, uns <w>am</w> Parkeingang zu treffen.",
                                "pl": "Umówiliśmy się na spotkanie <w>przy</w> wejściu do parku."
                            }
                        },
                        {
                            "text": "Моя бабушка живёт в маленьком домике <w>у</w> моря.",
                            "target_lang_translations": {
                                "en": "My grandmother lives in a small house <w>by</w> the sea.",
                                "de": "Meine Großmutter lebt in einem kleinen Haus <w>am</w> Meer.",
                                "pl": "Moja babcia mieszka w małym domku <w>nad</w> morzem."
                            }
                        }
                    ],
                    "synonyms": [
                        "около",
                        "возле",
                        "рядом",
                        "близ",
                        "недалеко"
                    ],
                    "common_phrases": [
                        "у окна",
                        "у двери",
                        "у моря",
                        "у входа"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates being in immediate proximity, next to someone or something.",
                        "de": "Gibt an, dass sich jemand oder etwas in unmittelbarer Nähe befindet.",
                        "pl": "Wskazuje na położenie w bezpośredniej bliskości, obok kogoś lub czegoś."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at",
                                "target_lang_sense_clarification": "indicating specific location"
                            },
                            {
                                "target_lang_word": "by",
                                "target_lang_sense_clarification": "indicating proximity"
                            },
                            {
                                "target_lang_word": "near",
                                "target_lang_sense_clarification": "indicating close distance"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "an",
                                "target_lang_sense_clarification": "Gibt einen Ort an, der in unmittelbarer Nähe oder Berührung ist."
                            },
                            {
                                "target_lang_word": "bei",
                                "target_lang_sense_clarification": "Gibt eine räumliche Nähe zu einer Person oder einem Ort an."
                            },
                            {
                                "target_lang_word": "neben",
                                "target_lang_sense_clarification": "Gibt eine räumlich angrenzende Position an."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "wskazuje bliskość miejsca"
                            },
                            {
                                "target_lang_word": "przy",
                                "target_lang_sense_clarification": "w bezpośrednim sąsiedztwie"
                            },
                            {
                                "target_lang_word": "koło",
                                "target_lang_sense_clarification": "blisko, w pobliżu"
                            },
                            {
                                "target_lang_word": "obok",
                                "target_lang_sense_clarification": "w pobliżu czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0da8c6ad-2c4e-3cc9-bfc1-c4b96c129e6f",
                    "sense_definition": "Указывает на принадлежность части целому, свойства предмету или физического состояния субъекту (часто используется с частями тела).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера <w>у</w> меня сильно болела голова.",
                            "target_lang_translations": {
                                "en": "Yesterday <w>my</w> head hurt badly.",
                                "de": "Gestern <w>hatte</w> ich starke Kopfschmerzen.",
                                "pl": "Wczoraj bardzo <w>bolała mnie</w> głowa."
                            }
                        },
                        {
                            "text": "Одна ножка <w>у</w> этого старого стула сломалась.",
                            "target_lang_translations": {
                                "en": "One leg <w>of</w> this old chair broke.",
                                "de": "Ein Bein <w>von</w> diesem alten Stuhl ist abgebrochen.",
                                "pl": "Jedna noga <w>od</w> tego starego krzesła się złamała."
                            }
                        }
                    ],
                    "common_phrases": [
                        "у меня болит",
                        "ножка у стула",
                        "глаза у кошки"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates belonging of a part to a whole, properties to an object, or physical state to a subject.",
                        "de": "Zeigt die Zugehörigkeit eines Teils zu einem Ganzen, eine Eigenschaft eines Objekts oder einen körperlichen Zustand an.",
                        "pl": "Wskazuje na przynależność części do całości, cechę przedmiotu lub stan fizyczny podmiotu."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of",
                                "target_lang_sense_clarification": "indicating a part belonging to a whole"
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "functional translation for physical states"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "von",
                                "target_lang_sense_clarification": "Drückt die Zugehörigkeit eines Teils zu einem Ganzen aus."
                            },
                            {
                                "target_lang_word": "haben",
                                "target_lang_sense_clarification": "Funktionale Übersetzung für körperliche Zustände oder Beschwerden."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "przynależność części do całości lub cechy"
                            },
                            {
                                "target_lang_word": "mieć",
                                "target_lang_sense_clarification": "tłumaczenie funkcjonalne w stanach fizycznych"
                            },
                            {
                                "target_lang_word": "od",
                                "target_lang_sense_clarification": "część należąca do całości (np. noga od krzesła)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86060f97-ab39-3dd1-abc3-025f0c23a11c",
                    "sense_definition": "Указывает на лицо или источник, от которого исходит действие, информация или объект (отобрать, узнать, спросить).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу попросить <w>у</w> тебя прощения за опоздание.",
                            "target_lang_translations": {
                                "en": "I want to ask forgiveness <w>from</w> you for being late.",
                                "de": "Ich möchte dich <w>um</w> Entschuldigung für meine Verspätung bitten.",
                                "pl": "Chcę prosić cię <w>o</w> wybaczenie za spóźnienie."
                            }
                        },
                        {
                            "text": "Студент решил узнать <w>у</w> друга домашнее задание.",
                            "target_lang_translations": {
                                "en": "The student decided to find out the homework <w>from</w> a friend.",
                                "de": "Der Student beschloss, das Freund <w>nach</w> den Hausaufgaben zu fragen.",
                                "pl": "Student postanowił dowiedzieć się <w>od</w> kolegi, co jest zadane."
                            }
                        }
                    ],
                    "common_phrases": [
                        "узнать у друзей",
                        "спросить у учителя",
                        "взять у брата"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates the person or source from which an action, information, or object proceeds.",
                        "de": "Bezeichnet die Person oder Quelle, von der eine Handlung, Information oder ein Objekt ausgeht.",
                        "pl": "Wskazuje na osobę lub źródło, od którego pochodzi czynność, informacja lub obiekt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "from",
                                "target_lang_sense_clarification": "indicating source or origin"
                            },
                            {
                                "target_lang_word": "of",
                                "target_lang_sense_clarification": "used with verbs of asking"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "von",
                                "target_lang_sense_clarification": "Gibt die Quelle oder den Ursprung an."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "od",
                                "target_lang_sense_clarification": "źródło pochodzenia lub uzyskania czegoś"
                            },
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "w konstrukcjach typu pytać lub szukać u kogoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "04ed35f2-be79-34fb-9b9e-dbf781bcc732",
                    "sense_definition": "Выражает сильные эмоции: страх, удивление, угрозу или укоризну.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>У</w>, какой ты хитрый, всё предусмотрел!",
                            "target_lang_translations": {
                                "en": "<w>Oh</w>, how cunning you are, you foresaw everything!",
                                "de": "<w>Oh</w>, wie schlau du bist, du hast an alles gedacht!",
                                "pl": "<w>O</w>, jaki jesteś cwany, wszystko przewidziałeś!"
                            }
                        },
                        {
                            "text": "<w>У</w>, как холодно сегодня на улице!",
                            "target_lang_translations": {
                                "en": "<w>Ooh</w>, how cold it is outside today!",
                                "de": "<w>Ooh</w>, wie kalt es heute draußen ist!",
                                "pl": "<w>Brr</w>, jak zimno jest dzisiaj na dworze!"
                            }
                        }
                    ],
                    "synonyms": [
                        "о",
                        "ах"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение эмоций"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses strong emotions: fear, surprise, threat, or reproach.",
                        "de": "Drückt starke Emotionen wie Angst, Überraschung, Drohung oder Tadel aus.",
                        "pl": "Wyraża silne emocje: strach, zdziwienie, groźbę lub wyrzut."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "expression of surprise or emotion"
                            },
                            {
                                "target_lang_word": "ooh",
                                "target_lang_sense_clarification": "expression of sensation or emotion"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "Ausdruck von Überraschung oder Emotion."
                            },
                            {
                                "target_lang_word": "ooh",
                                "target_lang_sense_clarification": "Ausdruck von Empfindung oder Emotion."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "o",
                                "target_lang_sense_clarification": "wykrzyknik zdziwienia lub emocji"
                            },
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "wykrzyknik emocjonalny"
                            },
                            {
                                "target_lang_word": "uu",
                                "target_lang_sense_clarification": "wykrzyknik zaskoczenia lub ostrzeżenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb73421-f6bb-38d7-a125-d5ae4548a32e",
                    "sense_definition": "Звукоподражание вою волка, собаки или завыванию ветра.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ветер за окном выл протяжно и грустно: <w>у</w>-у-у.",
                            "target_lang_translations": {
                                "en": "The wind outside the window howled long and sadly: <w>ooo</w>-ooo-ooo.",
                                "de": "Der Wind heulte draußen vor dem Fenster lang und traurig: <w>uuu</w>-uuu-uuu.",
                                "pl": "Wiatr za oknem wył przeciągle i smutno: <w>u</w>-u-u."
                            }
                        },
                        {
                            "text": "Голодный волк в лесу затянул своё <w>у</w>-у-у.",
                            "target_lang_translations": {
                                "en": "A hungry wolf in the forest began his <w>howl</w>.",
                                "de": "Ein hungriger Wolf im Wald begann sein <w>Geheul</w>.",
                                "pl": "Głodny wilk w lesie zaczął swoje <w>u</w>-u-u."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Onomatopoeia for the howling of a wolf, dog, or wind.",
                        "de": "Lautmalerei für das Heulen eines Wolfes, Hundes oder den Wind.",
                        "pl": "Dźwiękonaśladownictwo wycia wilka, psa lub zawodzenia wiatru."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "howl",
                                "target_lang_sense_clarification": "description of the sound"
                            },
                            {
                                "target_lang_word": "ooo",
                                "target_lang_sense_clarification": "onomatopoeic representation"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "heulen",
                                "target_lang_sense_clarification": "Beschreibung des Geräusches."
                            },
                            {
                                "target_lang_word": "uuu",
                                "target_lang_sense_clarification": "Lautmalerische Darstellung."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uuu",
                                "target_lang_sense_clarification": "dźwiękonaśladowczy odgłos wycia"
                            },
                            {
                                "target_lang_word": "u",
                                "target_lang_sense_clarification": "imitacja odgłosu"
                            }
                        ]
                    }
                }
            ]
        },
