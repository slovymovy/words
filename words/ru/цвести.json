    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1129b181-135f-38ee-835c-5f0d455b6ace",
                    "sense_definition": "иметь распустившиеся цветки",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bloom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной в саду начинают <w>цвести</w> яблони.",
                            "target_lang_translations": {
                                "en": "In spring, apple trees begin to <w>bloom</w> in the garden."
                            }
                        },
                        {
                            "text": "Эти цветы будут <w>цвести</w> до самой осени.",
                            "target_lang_translations": {
                                "en": "These flowers will <w>bloom</w> until autumn."
                            }
                        }
                    ],
                    "antonyms": [
                        "вянуть",
                        "увядать"
                    ],
                    "common_phrases": [
                        "сады цветут",
                        "цветут цветы"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce flowers or be in a state of having open flowers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bloom",
                                "target_lang_sense_clarification": "To produce flowers or be in a state of flowering."
                            },
                            {
                                "target_lang_word": "blossom",
                                "target_lang_sense_clarification": "To have or open into flowers, often used for fruit trees."
                            },
                            {
                                "target_lang_word": "flower",
                                "target_lang_sense_clarification": "To put forth blooms."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09a93b78-e379-378b-8ce9-881884d9cd58",
                    "sense_definition": "находиться в поре физического расцвета, быть здоровым и красивым",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flourish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>цвела</w> от счастья после хороших новостей.",
                            "target_lang_translations": {
                                "en": "She was <w>blooming</w> with happiness after the good news."
                            }
                        },
                        {
                            "text": "В молодости она <w>цвела</w> и привлекала все взгляды.",
                            "target_lang_translations": {
                                "en": "In her youth, she <w>flourished</w> and caught everyone's eye."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be in a state of physical prime, health, or beauty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bloom",
                                "target_lang_sense_clarification": "To be in a state of healthful, growing youth and vigor."
                            },
                            {
                                "target_lang_word": "flourish",
                                "target_lang_sense_clarification": "To be in a period of peak health or success."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9c3ab8a-4684-3bbf-9e58-a7956a22d4db",
                    "sense_definition": "успешно развиваться, преуспевать",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flourish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Город начал <w>цвести</w> благодаря новым инвестициям.",
                            "target_lang_translations": {
                                "en": "The city began to <w>flourish</w> thanks to new investments."
                            }
                        },
                        {
                            "text": "Искусство в этой стране <w>цвело</w> в эпоху Возрождения.",
                            "target_lang_translations": {
                                "en": "Art in this country <w>flourished</w> during the Renaissance."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To develop successfully or thrive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flourish",
                                "target_lang_sense_clarification": "To grow or develop in a healthy or vigorous way."
                            },
                            {
                                "target_lang_word": "thrive",
                                "target_lang_sense_clarification": "To prosper or flourish."
                            },
                            {
                                "target_lang_word": "blossom",
                                "target_lang_sense_clarification": "To begin to thrive or develop successfully."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c92d97f-4f5e-3ece-88a0-6504aafb2cfa",
                    "sense_definition": "покрываться ряской или тиной",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "overgrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом пруд начинает <w>цвести</w> из-за жары.",
                            "target_lang_translations": {
                                "en": "In summer, the pond begins to <w>bloom</w> due to the heat."
                            }
                        },
                        {
                            "text": "Вода в озере <w>цвела</w> и стала зелёной.",
                            "target_lang_translations": {
                                "en": "The water in the lake was <w>blooming</w> and turned green."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become covered with algae or pond scum, typically due to warm water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bloom",
                                "target_lang_sense_clarification": "Specifically refers to an algal bloom."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f36f6f2-237d-3fa7-a056-a68169000764",
                    "sense_definition": "покрываться сыпью или прыщами",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overgrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Лицо подростка начало <w>цвести</w> из-за аллергии.",
                            "target_lang_translations": {
                                "en": "The teenager's face began to <w>break out</w> due to an allergy."
                            }
                        },
                        {
                            "text": "Кожа <w>цвела</w> мелкими красными пятнами.",
                            "target_lang_translations": {
                                "en": "The skin was <w>breaking out</w> in small red spots."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To break out in a rash or pimples."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "To develop a skin condition like a rash or acne."
                            }
                        ]
                    }
                }
            ]
        }
    ]
