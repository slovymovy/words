                "senses": [
                    {
                        "sense_id": "bf7774c9-1990-3e2a-a379-0d3c27bde57f",
                        "entry_id": "407f02fc-949f-3715-b55f-b3b4b405e15c",
                        "glosses": [
                            "het vermogen om moed te tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d71f0b-7f0a-434c-9d3e-bbb02a942a68",
                                "sense_id": "bf7774c9-1990-3e2a-a379-0d3c27bde57f",
                                "text": "Heb jij de durf om het anders te doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8ba6430-d0c7-3547-a06b-14c7493d47e7",
                        "entry_id": "407f02fc-949f-3715-b55f-b3b4b405e15c",
                        "glosses": [
                            "iets kunnen doen wat nuttig is maar ook gevaarlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa5c194-ffb8-446c-837b-a2c326cc5a81",
                                "sense_id": "f8ba6430-d0c7-3547-a06b-14c7493d47e7",
                                "text": "Hij had de durf om tegen zijn baas te zeggen dat het werk te zwaar en te gevaarlijk is."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
                "word": "durf",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0266f0c2-e533-3ba3-850b-37ea6441c3cb",
                        "entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
                        "glosses": [
                            "eerste persoon enkelvoud tegenwoordige tijd van durven"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7a75cba3-f873-4481-9df5-241dc60456a2",
                                "sense_id": "0266f0c2-e533-3ba3-850b-37ea6441c3cb",
                                "text": "Ik durf."
                            }
                        ]
                    },
                    {
                        "sense_id": "d32242e8-2eb8-33df-a364-dc66d0afa5a2",
                        "entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
                        "glosses": [
                            "gebiedende wijs van durven"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c05584ef-09d9-4c79-81b4-f309f0aad930",
                                "sense_id": "d32242e8-2eb8-33df-a364-dc66d0afa5a2",
                                "text": "Durf!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c8e44eb9-50b4-3223-aec1-27b313ee81a9",
                        "entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
                        "glosses": [
                            "tweede persoon enkelvoud tegenwoordige tijd van durven"
                        ],
                        "tags": [
                            "form-of",
                            "inversion"
                        ],
                        "examples": [
                            {
                                "example_id": "33272b79-61e9-409b-9176-f002c2f232f9",
                                "sense_id": "c8e44eb9-50b4-3223-aec1-27b313ee81a9",
                                "text": "Durf je?"
                            },
                            {
                                "example_id": "7c31b0a2-924c-454a-ae1d-1c7fffdee47e",
                                "sense_id": "c8e44eb9-50b4-3223-aec1-27b313ee81a9",
                                "text": "'Ik durf er al mijn pannen onder te verwedden dat vrouwen achter gesloten deuren nog steeds gemberkoekmannetjes eten, wat de burgemeesters ook mogen zeggen'."
                            },
                            {
                                "example_id": "ae9b1bc1-fab4-418e-a403-1a4d139f3151",
                                "sense_id": "c8e44eb9-50b4-3223-aec1-27b313ee81a9",
                                "text": "'Geloofde u dat hij erheen ging om te werken?' 'Hoe durf je hier te komen' 'U zult hem nooit zo goed leren kennen als ik'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f1d6e50-e52e-421f-af7e-555d60f41600",
                        "source_entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
                        "source_sense_id": "0266f0c2-e533-3ba3-850b-37ea6441c3cb",
                        "source_sense_description": "het vermogen om moed te tonen",
                        "target_lang_word": "courage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The quality of being confident, not afraid or easily intimidated, but without being incautious or inconsiderate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b353f3f-4f3a-4761-9749-392d73548b3d",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "A great part of courage is the courage of having done the thing before."
                                            },
                                            {
                                                "example_id": "9a657da2-9fef-4405-9f52-9485ca4e917a",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "There is a stubbornness about me that never can bear to be frightened at the will of others. My courage always rises at every attempt to intimidate me."
                                            },
                                            {
                                                "example_id": "b4be87e1-43eb-44b9-9360-44ded218bd70",
                                                "sense_id": "a4046406-1b2c-3e3c-9a22-1a790747a367",
                                                "text": "It takes a lot of courage to be successful in business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to overcome one's fear, do or live things which one finds frightening."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8df93de8-46c6-4591-a43d-2cd69a183f44",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "He plucked up the courage to tell her how he felt."
                                            },
                                            {
                                                "example_id": "afa74805-5552-49f1-8618-b7d3a970bf01",
                                                "sense_id": "8319b27a-ec95-304a-87e8-c60771dcebb2",
                                                "text": "Courage is resistance to fear, mastery of fear—not absence of fear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                        "entry_id": "285b2616-5168-36ec-9fa5-02f5f66372fc",
                                        "glosses": [
                                            "The ability to maintain one's will or intent despite either the experience of fear, frailty, or frustration; or the occurrence of adversity, difficulty, defeat or reversal. Moral fortitude."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecb03c0-b960-4f81-abae-f078fe64ce20",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "“Courage is not simply one of the virtues but the form of every virtue at the testing point, which means at the point of highest reality.”"
                                            },
                                            {
                                                "example_id": "65b4e4b6-a6b2-4791-9278-cfe48e886ae1",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I wanted you to see what real courage is, instead of getting the idea that courage is a man with a gun in his hand. It's when you know you're licked before you begin, but you begin anyway and see it through no matter what."
                                            },
                                            {
                                                "example_id": "151d52c3-76a5-4403-9b39-ece09f2f7928",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "Courage isn't having the strength to go on - it is going on when you don't have strength."
                                            },
                                            {
                                                "example_id": "3a40a8b8-d3a3-4d2c-b565-bb77172b4f1b",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "2008, Maya Angelou, address for the 2008 Cornell University commencement\nCourage is the most important of all the virtues because without courage, you can't practice any other virtue consistently."
                                            },
                                            {
                                                "example_id": "49791790-df56-4ddd-acfd-fd8987fdb2bb",
                                                "sense_id": "85467f70-3872-319b-924c-e90be7347aba",
                                                "text": "I hope you live a life you’re proud of. If you find that you’re not, I hope you have the courage to start all over again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                        "entry_id": "8abb55a0-abb8-3084-ad11-f0e20171d040",
                                        "glosses": [
                                            "To encourage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d4a34c-9ad8-4a9e-9aad-a0d010baf4f8",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "And wete yow wel sayd kynge Arthur vnto Vrres syster I shalle begynne to handle hym and serche vnto my power not presumyng vpon me that I am soo worthy to hele youre sone by my dedes / but I wille courage other men of worshyp to doo as I wylle doo"
                                            },
                                            {
                                                "example_id": "7caf610b-b4f2-469d-961b-e18b32573b02",
                                                "sense_id": "8f7739d2-a44b-368d-bb46-f18ec5f09c13",
                                                "text": "Paul writeth unto Timothy, to instruct him, to teach him, to exhort, to courage him, to stir him up,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9028d45-9a05-4609-b8c3-b12393885a92",
                        "source_entry_id": "fbc878eb-9f2b-31a3-9269-d2c78c612804",
