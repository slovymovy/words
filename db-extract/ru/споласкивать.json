                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2355173e-701b-4654-9ec8-d062dd60f56d",
                                                "sense_id": "a88c701a-388e-330e-8350-1d8b48d6cc2a",
                                                "text": "On rentre dans le club habillés comme des princes\nFresh, fresh, fresh en jeans ou en pinces\nMets toi bien, ce soir c'est moi qui rince\nSi tu danses à la Carlton."
                                            }
                                        ]
                                    },
