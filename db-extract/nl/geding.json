                "senses": [
                    {
                        "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                        "entry_id": "a2a0b8bc-eab6-3561-9f51-4df019fe03b1",
                        "glosses": [
                            "Instance, cause, procédure, procès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "effe5a50-7dea-47b4-bd46-9769c8c8d017",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "in het geding betrekken",
                                "translation": "mettre en cause, appeler en cause"
                            },
                            {
                                "example_id": "2ee48345-cede-4a93-b469-46a033c41145",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "het in het geding betrekken",
                                "translation": "mise en cause"
                            },
                            {
                                "example_id": "7308f84f-9cd6-465b-aa78-46c4557e0d55",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "een kort geding instellen tegen",
                                "translation": "assigner quelqu’un en référé"
                            },
                            {
                                "example_id": "2ab02abe-1e45-4171-8b41-6e5e4a6c4a9c",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "afloop van het geding",
                                "translation": "dénouement de l’instance"
                            },
                            {
                                "example_id": "60388799-c8bb-4730-962e-334986c5f7f0",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "in het geding zijn",
                                "translation": "être en cause"
                            },
                            {
                                "example_id": "598341d3-8375-49eb-a237-382b9ee59fcb",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "kort geding",
                                "translation": "référé"
                            },
                            {
                                "example_id": "010efd85-9982-49c3-9cf9-8b48c1950e89",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "een kort geding aanspannen",
                                "translation": "engager une procédure en référé"
                            },
                            {
                                "example_id": "0d63b147-8fea-4e7b-99ef-d2ae30512c43",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "het stuk wordt buiten het geding gehouden",
                                "translation": "la pièce sera rejetée"
                            },
                            {
                                "example_id": "5f684cfc-82d9-4aee-a089-ef4c2cc07e6d",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "buiten het geding stellen",
                                "translation": "mettre hors d’instance, mettre hors de cause"
                            },
                            {
                                "example_id": "9fdda8ac-c068-4b27-852f-c3b37a4a34b1",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "hervatting van het geding",
                                "translation": "reprise d’instance"
                            },
                            {
                                "example_id": "b53b1c87-affd-4a88-8144-4cf395a560ff",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "in elke stand van het geding",
                                "translation": "en tout état de cause"
                            },
                            {
                                "example_id": "3dad5d34-82a3-47ef-b9ab-f45b7ec1297f",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "het voeren van gedingen",
                                "translation": "l’engagement de procédures"
                            },
                            {
                                "example_id": "4f0ec98a-fc87-4fe7-b3e6-8fb91d477cd5",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "appelvonnis in kort geding",
                                "translation": "arrêt de référé"
                            },
                            {
                                "example_id": "47d1f6ce-e114-4b43-b5e3-981a93fbecba",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "recht doende in kort geding",
                                "translation": "statuant en référé"
                            },
                            {
                                "example_id": "cb4fc203-6e54-4c4b-b317-478e7f91be90",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "kort geding rechter",
                                "translation": "juge des référés"
                            },
                            {
                                "example_id": "2ba0888f-a215-4c83-997e-4401ca6440d3",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "het geding schorsen",
                                "translation": "suspendre la procédure"
                            },
                            {
                                "example_id": "f029b335-086d-4263-aa50-456e35979c95",
                                "sense_id": "123eb36c-4946-32f1-a283-d82c3e4720fa",
                                "text": "in kort geding recht spreken",
                                "translation": "rendre une ordonnance de référé"
                            }
                        ]
                    }
