                        "entry_id": "a92d1f74-2bad-3f80-a808-0418ed43cf83",
                        "glosses": [
                            "To do something wrong; to break a rule or offend."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dda95f74-5dfa-4444-9cb5-25ac74815ab1",
                                "sense_id": "a6ab3914-4d85-390c-b1aa-d573fa79bee8",
                                "text": "Some offenders were called to judgment where offences were technical and unaccompanied by any intention to wrongdo, whereas hardened offenders were sometimes let off with less than their deserts."
                            },
                            {
                                "example_id": "913f2312-ce0f-454b-a8f1-2d012c0229e3",
                                "sense_id": "a6ab3914-4d85-390c-b1aa-d573fa79bee8",
                                "text": "To overdo can be as hard on allergies as to wrongdo, so you'll not want to take on too many activities at once."
                            },
                            {
                                "example_id": "7ff4d2a1-06b8-43b3-9c8d-4d88e5a9169a",
                                "sense_id": "a6ab3914-4d85-390c-b1aa-d573fa79bee8",
                                "text": "As in society as a whole, the masses have to suffer because of the wrongdoings or the willingness to wrongdo of the few."
                            }
                        ]
                    }
