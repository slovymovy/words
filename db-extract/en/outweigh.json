                                    {
                                        "sense_id": "380f6c0f-43f5-3567-981b-a7abbde59c13",
                                        "entry_id": "417d97dc-5477-3056-abdc-ad5b41ba4f14",
                                        "glosses": [
                                            "uscire per sopravanzo dalla misura o dal limite prestabiliti, tollerati o auspicati; esuberare"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88fc214c-9a64-45f4-b7b0-4f4e647f7440",
                                                "sense_id": "380f6c0f-43f5-3567-981b-a7abbde59c13",
                                                "text": "Signore, il mio discorso eccede la brevità, ma non eccede la mia ragione."
                                            },
                                            {
                                                "example_id": "2805d81d-1c3d-457b-978e-a5937e34472e",
                                                "sense_id": "380f6c0f-43f5-3567-981b-a7abbde59c13",
                                                "text": "Fate a mio modo, Candido, soggiunse, continuate il vostro viaggio: io ve l'ho sempre detto, tutto è per il peggio, la somma de' mali eccede troppo la somma de' beni: partite, e non dispero che diventiate manicheo, seppur già non lo siete."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eccedere",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "a0fb45bb-0fa5-30a2-becd-0534512e6a5a",
                                        "entry_id": "adede5e8-c625-3483-9bd0-1ee8076424e3",
                                        "glosses": [
                                            "portarsi oltre, spingersi al di là del confine che separa ciò che è o che è percepito come equilibrato, moderato, normale o ammissibile da ciò che che è o è sentito come esecrabile in quanto esagerazione o esasperazione"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fedd66a1-d4fb-4251-8afc-89abb1401fb2",
                                                "sense_id": "a0fb45bb-0fa5-30a2-becd-0534512e6a5a",
                                                "text": "Nei tempi andati l’autorità dei genitori, degli educatori e dei maestri pesava troppo su’ figli e sugli alunni; all’età nostra generalmente si eccede in fatto di libertà, in ogni educazione domestica, privata e pubblica (proemio di Angelo Valdarnini a La pedagogia di Immanuel Kant)"
                                            },
                                            {
                                                "example_id": "8af045d3-e5df-4594-9b9b-ed4a24e219e6",
                                                "sense_id": "a0fb45bb-0fa5-30a2-becd-0534512e6a5a",
                                                "text": "Nella calma immensa signoreggiava il lusso che non eccede nello sfarzo chiassoso."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
