                    },
                    {
                        "translation_id": "ae79f7bd-0e0f-413a-a7fb-7b1e6ef87f05",
                        "source_entry_id": "c6a280cc-5178-3d62-8c4e-3ef4d08134ea",
                        "source_sense_id": "4e8d8614-7b5a-3086-8275-b9c18767a8de",
                        "source_sense_description": "Fleisch, Gericht",
                        "target_lang_word": "spareribs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spareribs",
