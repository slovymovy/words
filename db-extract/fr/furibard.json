                                        "examples": [
                                            {
                                                "example_id": "799b9856-a5ff-45fd-b15d-6574bd1b8189",
                                                "sense_id": "24cfb4f5-9b69-3c05-adce-159df763825e",
                                                "text": "Nach seiner Niederlage ging er wutentbrannt nach Hause."
                                            },
                                            {
                                                "example_id": "7915baee-7a84-4a5f-831b-0f44879824e8",
                                                "sense_id": "24cfb4f5-9b69-3c05-adce-159df763825e",
                                                "text": "Der betrogene Ehemann ging wutentbrannt auf den Liebhaber seiner Frau los."
                                            },
                                            {
                                                "example_id": "f85ac063-68a9-4643-a928-3e0fb6656563",
                                                "sense_id": "24cfb4f5-9b69-3c05-adce-159df763825e",
                                                "text": "„Als sich eine Gruppe ZANU(PF)-Politiker, zu denen auch Jonathan Moyo zählte, bei einem Geheimtreffen in Tsholotsho am 18. November 2004 darauf verständigte, schlug ein wutentbrannter Mugabe zurück und entließ im Februar 2005 Informationsminister Jonathan Moyo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
