                "senses": [
                    {
                        "sense_id": "8ef4c46f-3892-375e-9721-a953b4e19012",
                        "entry_id": "f4ca0cfd-7a72-3ff8-b5ea-f790f2212370",
                        "glosses": [
                            "Étendre et fixer contre une muraille ou un treillage les branches d’un arbre dont on veut faire un espalier."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "fbd4f257-efcc-426b-b7ad-4df622260b32",
                                "sense_id": "8ef4c46f-3892-375e-9721-a953b4e19012",
                                "text": "Palisser des pêchers, des poiriers."
                            },
                            {
                                "example_id": "9edc2c7e-5d4c-47d6-bdd6-c0a82f88e2a2",
                                "sense_id": "8ef4c46f-3892-375e-9721-a953b4e19012",
                                "text": "Au Mas Vieux, depuis quatre jours, on palisse, on gâche, on renfaîte, on descelle, on perce, on abat les plafonds."
                            }
                        ]
                    }
