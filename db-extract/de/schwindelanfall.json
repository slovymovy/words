                "senses": [
                    {
                        "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                        "entry_id": "6eb09f36-9026-3eea-b8aa-07fbd866b5b3",
                        "glosses": [
                            "plötzlich auftretendes Gefühl von verlorenem Gleichgewicht, Schwindel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e364e88e-2dc6-43a6-8793-b1deda459a01",
                                "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                                "text": "Seit sie schwanger ist, wird sie von Schwindelanfällen heimgesucht."
                            },
                            {
                                "example_id": "df093dc2-5e04-4ecb-a34d-2c951c92b26c",
                                "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                                "text": "„Ein leichtes Unwohlsein, ein Schwindelanfall, haben mich verhindert aufzustehen.“"
                            },
                            {
                                "example_id": "2a0cd2d4-2531-4a37-b489-2a8255057208",
                                "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                                "text": "„Diese erzählte genau, wie Simen Tjing beim Kämmen einen Schwindelanfall bekommen habe und zusammengebrochen sei.“"
                            },
                            {
                                "example_id": "e372fe57-bc26-4476-bd29-a44ae5735f07",
                                "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                                "text": "„Ich zerstreute seine Befürchtungen mit den Worten, mich hätte ein kleiner Schwindelanfall genötigt hinauszugehen, um ihn durch die frische Luft zu vertreiben.“"
                            },
                            {
                                "example_id": "82396eb5-bea1-45ca-9794-d7a2da769600",
                                "sense_id": "6259d756-2b9f-33e3-97ab-4a26109e1dd1",
                                "text": "„Eines Tages packte ihn ein Schwindelanfall, und da er nicht hinabzusteigen wagte, schrie er, damit ihm Pécuchet zu Hilfe käme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
