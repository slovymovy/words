                        "cross_references": [
                            {
                                "target_word": "flottage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc326cf-b1da-3593-b6d7-d6aeee97d724",
                                        "entry_id": "fc30b548-66d2-348d-ae1f-dbe85222e7ad",
                                        "glosses": [
                                            "Transport du bois par eau, lorsqu’on le fait flotter."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441079fd-d06e-48c4-b0ca-0970800829a0",
                                                "sense_id": "6cc326cf-b1da-3593-b6d7-d6aeee97d724",
                                                "text": "Cette rivière est commode pour le flottage."
                                            },
                                            {
                                                "example_id": "44840e38-b802-4beb-bc2d-745a107c3d5c",
                                                "sense_id": "6cc326cf-b1da-3593-b6d7-d6aeee97d724",
                                                "text": "Le flottage du bois sur la Sarre présente une histoire, des techniques et réglementations identiques à celles des Oualous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee3cd02c-0969-3f3b-8b1f-16a835d8947a",
                                        "entry_id": "fc30b548-66d2-348d-ae1f-dbe85222e7ad",
                                        "glosses": [
                                            "Procédé de traitement du bois qui consiste en son immersion dans l'eau pour éliminer la sève. Ensuite on obtient des bois plus résistant au pourrissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed75489a-65ad-4dfd-b091-6c4783716e3c",
                                                "sense_id": "ee3cd02c-0969-3f3b-8b1f-16a835d8947a",
                                                "text": "IMMERSION OU FLOTTAGE des bois . – Un des moyens les plus employés pour conserver les bois, principalement les bois durs, consiste à hâter leur dessiccation en les immergeant pendant trois ou quatre mois dans une eau stagnante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdbe9362-6819-3789-b97a-be506a29ec51",
                                        "entry_id": "fc30b548-66d2-348d-ae1f-dbe85222e7ad",
                                        "glosses": [
                                            "Partie du bois qui masque un assemblage par tenon et mortaise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adedc3c2-0d9e-3df1-933b-40b9a73f7599",
                                        "entry_id": "fc30b548-66d2-348d-ae1f-dbe85222e7ad",
                                        "glosses": [
                                            "Séparation de corps solides par leur différence de densité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce085267-8616-4716-a99f-685d11303c22",
                                                "sense_id": "adedc3c2-0d9e-3df1-933b-40b9a73f7599",
                                                "text": "En cette fin d'année 1937, des ateliers de flottage sont en projet ou en cours d'installation dans plusieurs charbonnages français. On doit y applaudir puisqu'il n'y a pas moyen meilleur d'épurer les schlamms et les poussiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f873b1-b11e-4976-b261-7bb92dcae157",
                        "source_entry_id": "ef8d1f03-c15f-361a-b45a-da0352e2a123",
                        "source_sense_id": "4d7301ee-7dfd-3819-95c4-a16f0ec4a1e9",
                        "target_lang_word": "Flößerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flößerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                                        "entry_id": "e7c451d4-a7ab-3894-96ab-292eb0fa74a3",
                                        "glosses": [
                                            "Gesamtheit der Aktivitäten um den Transport von Baumstämmen auf dem Wasser mittels Flößen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2b514d-2583-436a-accf-80c08536404d",
                                                "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                                                "text": "„Im 17. Jahrhundert erfolgte aufgrund der zunehmenden Flößerei eine Sohlenvertiefung auf vier Meter, an der Wasserlinie auf vierzehn Meter Breite.“"
                                            },
                                            {
                                                "example_id": "b096133e-0653-4eba-970a-2d512ba9d9dd",
                                                "sense_id": "4d0f8d95-2dc3-3652-9167-7eec7cc6ba85",
                                                "text": "„Ohne Flößerei wäre die Versorgung der Städte mit Bauholz gar nicht möglich gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
