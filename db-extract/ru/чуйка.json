                "senses": [
                    {
                        "sense_id": "055be945-968a-3074-8aa7-7c0f6a1a8b7e",
                        "entry_id": "840699cc-d13b-3b6f-bffb-4afae9bee6d1",
                        "glosses": [
                            "устар. старинная мужская верхняя одежда в виде длинного суконного кафтана, распространённая в мещанской среде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f99d1ba-b51a-45fd-a5a3-d2caa4171c02",
                                "sense_id": "055be945-968a-3074-8aa7-7c0f6a1a8b7e",
                                "text": ".. и для чего непременно хотят меня укутать в шарф и ваточную чуйку?"
                            },
                            {
                                "example_id": "c9b51dbe-4ed4-4421-aaa0-afa2806664b3",
                                "sense_id": "055be945-968a-3074-8aa7-7c0f6a1a8b7e",
                                "text": "Нанковая чуйка, с собачьим воротником, появилась на его плечах только в начале ноября."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
