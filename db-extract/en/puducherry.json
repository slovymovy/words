                        "source_entry_id": "6720ec72-94f8-3dbf-93b6-b5ae09a11769",
                        "source_sense_description": "Puducherry, India",
                        "target_lang_word": "Pondichéry",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pondichéry",
