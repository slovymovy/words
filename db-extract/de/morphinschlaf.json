                ],
                "senses": [
                    {
                        "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                        "entry_id": "09dec9e0-527b-3acd-a101-ab0025e029da",
                        "glosses": [
                            "Schlaf unter der Wirkung von Morphin (Morphium)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67466819-8f8d-4dd9-b29d-cd5d8729c15a",
                                "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                                "text": "„Der Halbtote schlief immer noch tief und fest seinen Morphinschlaf, und Benny entschied, dass sie ihn vorerst liegen lassen sollten, wo er war.“"
                            },
                            {
                                "example_id": "8e0036b7-1aa7-4d6a-aac7-1ba21d6a2d40",
                                "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                                "text": "„Der mögliche Volumenmangelschock trotz gleichzeitiger Gabe eines Kreislaufmittels und der anschließende Morphinschlaf können die ursprüngliche Vergiftungssymptomatik verschleiern.“"
                            },
                            {
                                "example_id": "faa088e4-bfa7-4af8-8ac9-ddf8441a5b34",
                                "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                                "text": "„Auf der Suche nach einem wirksamen Mittel, welches als Gegengift gegen Überdosierungen mit Narkotica und Hypnotica dienen könnte, stießen wir auf das Coramin, dessen Weckwirkung gegenüber dem Chloralhydratschlaf und dem Morphinschlaf schon von UHLMANN festgestellt worden war.“"
                            },
                            {
                                "example_id": "f41b85dd-cdf3-4c18-8ad0-ece720afa478",
                                "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                                "text": "„Unterdessen erwachte Sabrina aus ihrem Morphinschlaf und begann zu schreien.“"
                            },
                            {
                                "example_id": "9b690248-24d0-4fbc-83c7-5cc11101474c",
                                "sense_id": "740b3e08-294f-3f07-bd1d-ab28553ce946",
                                "text": "„Auf der anderen Seite würde er damit einen ziemlichen Wirbel verursachen, wenn er Alfred Schulze mitten in der Nacht aus dessen Morphinschlaf wecken und nach unten bringen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
