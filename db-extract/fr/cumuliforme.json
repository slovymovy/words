                    {
                        "sense_id": "0459a727-3284-321e-8e5c-2bd3eff0e7e3",
                        "entry_id": "aed63afa-a819-3e51-8638-91846fb24f2f",
                        "glosses": [
                            "Qui présente l’aspect d’un nuage de type cumulus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ff78c3-340d-4164-b71b-f4a720775ea3",
                                "sense_id": "0459a727-3284-321e-8e5c-2bd3eff0e7e3",
                                "text": "Dans le ciel clair, une rampe rectiligne de nuages cumuliformes borde la côte et fait jouer les ombres sur la petite ville de Tamano que l’on peut distinguer dans le lointain."
                            },
                            {
                                "example_id": "5f3c0ab9-ffb4-432c-b3bc-74ee4ae71c58",
                                "sense_id": "0459a727-3284-321e-8e5c-2bd3eff0e7e3",
                                "text": "On distingue deux grandes formes de nuages : stratiformes ou cumuliformes."
                            },
                            {
                                "example_id": "44724f6d-45aa-471f-9f3b-c1e03f1c99c8",
                                "sense_id": "0459a727-3284-321e-8e5c-2bd3eff0e7e3",
                                "text": "Près des côtes d’Afrique du Nord, de l’Algérie et de la Tunisie, la structure irrégulière des nuages aux dimensions mouvantes, indique une nébulosité cumuliforme (cumulus) …"
                            },
                            {
                                "example_id": "31e6f88f-e418-4c89-bb24-531ec59289a8",
                                "sense_id": "0459a727-3284-321e-8e5c-2bd3eff0e7e3",
                                "text": "La partie inférieure du nuage voile ainsi le tronc de la partie arborescente cumuliforme."
                            }
                        ]
                    }
                ],
