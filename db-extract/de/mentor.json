                    {
                        "form_id": "5f5a9902-fc1d-4d91-ad13-b81d05fc15c3",
                        "entry_id": "cbba5dc0-5148-3d5d-9498-12aa77ccc3fd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mentoren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0e16976-7f5c-3325-852b-b31a5929ad81",
                        "entry_id": "cbba5dc0-5148-3d5d-9498-12aa77ccc3fd",
                        "glosses": [
                            "ein Fürsprecher oder Förderer"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1aa48af7-adb1-45cb-97d0-8f91a4dcf817",
                                "sense_id": "b0e16976-7f5c-3325-852b-b31a5929ad81",
                                "text": "Ein Mentor sollte viel Erfahrung besitzen."
                            },
                            {
                                "example_id": "ab784e0c-beb1-404a-92e0-afb98e05d6e6",
                                "sense_id": "b0e16976-7f5c-3325-852b-b31a5929ad81",
                                "text": "„Ich ging sogleich zu meinem Mentor, dem Pater Giorgi, um ihm über alles Bericht zu erstatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b4b383c6-be06-3a80-8976-28dd7f31ae6d",
                        "entry_id": "cbba5dc0-5148-3d5d-9498-12aa77ccc3fd",
                        "glosses": [
                            "ein erfahrener Lehrer, der angehende Lehrer beim Einstieg in die Berufspraxis begleitet"
                        ],
                        "tags": [
                            "Pädagogik"
                        ],
                        "examples": [
                            {
                                "example_id": "fa68b813-5932-46de-b21a-c3be388164e3",
                                "sense_id": "b4b383c6-be06-3a80-8976-28dd7f31ae6d",
                                "text": "Mein Mentor hat mir geraten, eine kurze Pause in der Ausbildung zu machen."
                            },
                            {
                                "example_id": "e76512d7-79ab-4394-b9ed-8bd6a8164e00",
                                "sense_id": "b4b383c6-be06-3a80-8976-28dd7f31ae6d",
                                "text": "„Zu Lämmerts akademischen Mentoren gehörte Richard Alewyn, ein prominenter Remigrant, der im Exil keine seiner Qualifikation entsprechende Stellung finden konnte und sich mit Sprachunterricht an einem Mädchencollege durchgebracht hatte…“"
                            },
                            {
                                "example_id": "6518620f-2d93-4c0f-a9e5-fd8c80dfde00",
                                "sense_id": "b4b383c6-be06-3a80-8976-28dd7f31ae6d",
                                "text": "„In einem Gespräch, das der uralte Mentor einmal mit Robert führte, redete er von den erdbewegenden Kräften der Dämonen.“"
                            },
                            {
                                "example_id": "006d224f-4a01-4b82-86da-cbfc2234d336",
                                "sense_id": "b4b383c6-be06-3a80-8976-28dd7f31ae6d",
                                "text": "„Die Parallele, die er hier zieht, ist die Einladung, die Philipp von Makedonien an Aristoteles als Mentor seines Sohnes Alexander ergehen läßt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
