                "senses": [
                    {
                        "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                        "entry_id": "99a6323c-ddd8-3acf-a7e6-b9bc1c655cbe",
                        "glosses": [
                            "Rückschau auf das vorhergehende Jahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d341fe-9992-4d9b-90b6-6c32e4c1728e",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "Bei meinem persönlichen Jahresrückblick stellte ich fest, dass sich bei mir sehr viel verändert hat."
                            },
                            {
                                "example_id": "303600a3-56d4-4cb8-be4f-8eb0ce56beaf",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Kurz vor Silvester öffnete ich im Rahmen meines Jahresrückblickes die Kiste, um nachzusehen, was mich im letzten Jahr alles so beschäftigt hatte.“"
                            },
                            {
                                "example_id": "2134f324-c82e-4031-8935-67aa1c0a18e3",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "Am Silvestertag gibt es im Fernsehen sicher wieder einen Jahresrückblick."
                            },
                            {
                                "example_id": "7149e02e-b7ec-4605-80dd-bd0a147bef0e",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Sie haben keine Lust mehr auf Jahresrückblicke? Verstehen wir.“"
                            },
                            {
                                "example_id": "90c84061-5c21-4f0d-afdd-8dc99f68a1e8",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Beim Jahresrückblick im Fernsehen auf das Jahr 2013 kam mir der flüchtige Gedanke: Alles ändert sich, aber irgendwie bleibt doch alles beim Alten.“"
                            },
                            {
                                "example_id": "7f0afc83-9137-4c9d-b9fb-b91a52da98b1",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Der Jahresrückblick 2009 stellt die wichtigsten Ergebnisse und Trends des vergangenen Jahres zur Wirtschafts-, Arbeitsmarkt- und Bevölkerungsentwicklung in kompakter Form dar.“"
                            },
                            {
                                "example_id": "59d29f9a-4404-42a4-af73-daa8d9935a96",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Im Dezember gilt es, Bilanz zu ziehen – beim schrecklichen 2020 eigentlich sehr einfach. Aber dann gibt es ja noch die musikalischen Jahresrückblicke.“"
                            },
                            {
                                "example_id": "dd9c3b92-b5bc-40fe-91ea-8b1d82c65899",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Selbst das sonst schon etwas konservativere Musikmagazin ‚Rolling Stone‘ nahm Eilishs Platte in die Top 10 ihres Jahresrückblick 2019 auf.“"
                            },
                            {
                                "example_id": "f8dde06c-a1fd-4ead-ace4-8ef4749bdc6e",
                                "sense_id": "1a2af77a-a3f9-3070-9da0-5ae9f116faab",
                                "text": "„Der Virologe Christian Drosten ist im Corona-Jahr zum Star bei Twitter geworden. Der Mediziner hat 2020 in dem sozialen Netzwerk deutschlandweit das größte Wachstum an Followern verzeichnet, wie aus dem Jahresrückblick des US-Unternehmens für Deutschland hervorgeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
