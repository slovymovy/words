                        "glosses": [
                            "Moine ou prêtre bouddhiste de Thaïlande ou de Birmanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb08fd4-0080-44da-b6d9-a0323aa7060c",
                                "sense_id": "1e916b41-fec6-3318-ae32-05ceac464c7e",
                                "text": "Voici ce que l'on entend par un phra dans le système bouddhiste. C'est un être qui, pendant des myriades d'existences différentes, a travaillé à acquérir une prodigieuse quantité de mérites."
                            },
                            {
                                "example_id": "97cdc0b6-afe8-45d8-92be-fd6dc90823a3",
                                "sense_id": "1e916b41-fec6-3318-ae32-05ceac464c7e",
                                "text": "Un phra doit garder 1'abstinence de toute nourriture depuis midi jusqu'au lendemain matin. Un phra ne peut sortir sans avoir un eventail, tenu de manière à ce que sa vue ne se porte pas à plus de deux mètres devant lui."
                            }
                        ]
                    }
