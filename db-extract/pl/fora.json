                                            "A brief extra performance, done after the main performance is complete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66d73cc-9aad-425e-afcd-49058dca42cf",
                                                "sense_id": "c7071a55-6093-3fc1-a409-e366b268cb2e",
                                                "text": "To play an encore."
                                            },
                                            {
                                                "example_id": "e527b952-add5-462a-9bdd-94628b93fcf7",
                                                "sense_id": "c7071a55-6093-3fc1-a409-e366b268cb2e",
                                                "text": "Can I get an encore? We want more!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b5ed65-e2e6-3475-aa72-ce307cd3c8b7",
                                        "entry_id": "77137dc9-b9d5-3e4c-b1e7-01a4185ad418",
                                        "glosses": [
                                            "A call or demand (as by continued applause) for a repeat performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c754e8-8e1b-4e38-9179-864792ee1a20",
                                                "sense_id": "e9b5ed65-e2e6-3475-aa72-ce307cd3c8b7",
                                                "text": "The encores were numerous."
                                            }
                                        ]
                                    }
                                ]
                            },
