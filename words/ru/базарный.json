    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eee30bac-d960-3b15-aac4-5508ae94f985",
                    "sense_definition": "Связанный с базаром, рынком или торговлей на нём; относящийся к базару.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "рыночный",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое воскресенье на центральной площади открывалась большая <w>базарная</w> торговля.",
                            "target_lang_translations": {
                                "en": "Every Sunday, large-scale <w>market</w> trading opened on the central square."
                            }
                        },
                        {
                            "text": "Мы договорились встретиться около старых ворот на <w>базарной</w> площади.",
                            "target_lang_translations": {
                                "en": "We agreed to meet near the old gates on the <w>market</w> square."
                            }
                        }
                    ],
                    "synonyms": [
                        "рыночный"
                    ],
                    "common_phrases": [
                        "базарная площадь",
                        "базарный день",
                        "базарный ряд"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to a bazaar, market, or market trading."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "market",
                                "target_lang_sense_clarification": "used as an adjective or noun adjunct for things pertaining to a market"
                            },
                            {
                                "target_lang_word": "bazaar",
                                "target_lang_sense_clarification": "pertaining specifically to an oriental or open-air bazaar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a6cf9f6-396e-31a9-9594-ab518f1234ad",
                    "sense_definition": "Шумный, крикливый, грубый или бесцеремонный, подобный шумной рыночной перебранке.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "крикливый",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В коридоре неожиданно поднялся громкий <w>базарный</w> шум, мешавший работать.",
                            "target_lang_translations": {
                                "en": "Suddenly, a loud, <w>clamorous</w> noise broke out in the corridor, disrupting work."
                            }
                        },
                        {
                            "text": "Он перебил собеседника в крайне грубой, неприятной и совершенно <w>базарной</w> манере.",
                            "target_lang_translations": {
                                "en": "He interrupted his interlocutor in an extremely rude, unpleasant, and thoroughly <w>vulgar</w> manner."
                            }
                        }
                    ],
                    "synonyms": [
                        "крикливый",
                        "грубый"
                    ],
                    "antonyms": [
                        "интеллигентный",
                        "вежливый"
                    ],
                    "common_phrases": [
                        "базарный шум",
                        "базарная баба",
                        "базарная брань"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное разговорное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Noisy, clamorous, coarse, or vulgar, reminiscent of a loud marketplace brawl."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vulgar",
                                "target_lang_sense_clarification": "coarse, loud, or uncouth"
                            },
                            {
                                "target_lang_word": "clamorous",
                                "target_lang_sense_clarification": "loud and rowdy"
                            },
                            {
                                "target_lang_word": "fishwife-like",
                                "target_lang_sense_clarification": "shrill, coarse, or shrewish"
                            }
                        ]
                    }
                }
            ]
        }
    ]
