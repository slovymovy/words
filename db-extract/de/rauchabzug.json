                "senses": [
                    {
                        "sense_id": "de01b285-2fba-3a19-aad7-30d613dad641",
                        "entry_id": "0b704fa4-5817-38ce-92b9-a56e72c89326",
                        "glosses": [
                            "Vorrichtung für die Ableitung von Rauch"
                        ],
                        "tags": [
                            "Brandschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "730bfb4b-da1b-465c-b56e-83d5691f5a4d",
                                "sense_id": "de01b285-2fba-3a19-aad7-30d613dad641",
                                "text": "„Die Bundesländer schreiben in den jeweiligen Landesbauordnungen vor, dass Treppenräume mit einem Rauchabzug, mit einer Rauchabzugsvorrichtung oder einer Öffnung zur Rauchableitung ausgerüstet sein müssen.“"
                            },
                            {
                                "example_id": "9539f6cf-b9a5-46f5-87f9-d0aba9b6766e",
                                "sense_id": "de01b285-2fba-3a19-aad7-30d613dad641",
                                "text": "„Ein Problem stellte noch der Rauchabzug dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c97a4516-1ced-4da0-b858-ea92b4da636d",
                        "source_entry_id": "0b704fa4-5817-38ce-92b9-a56e72c89326",
                        "source_sense_id": "de01b285-2fba-3a19-aad7-30d613dad641",
                        "source_sense_description": "Brandschutz: Vorrichtung für die Ableitung von Rauch",
                        "target_lang_word": "cheminée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheminée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "628feb11-adcc-3be5-a1be-94815fb99333",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Construction abritant un âtre, où l’on fait du feu, et comportant un conduit pour donner issue à la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c2ffd7-09a0-466f-b2d6-6bce603b9b70",
                                                "sense_id": "628feb11-adcc-3be5-a1be-94815fb99333",
                                                "text": "Enfin, une immense cheminée leur offrait un moyen d’éclairer et de réchauffer à la fois leur sommeil."
                                            },
                                            {
                                                "example_id": "d30cdd8c-ae4d-447c-976f-81e01fcc4e92",
                                                "sense_id": "628feb11-adcc-3be5-a1be-94815fb99333",
                                                "text": "Les deux éléments de l’architecture qui ont dépéri avec la civilisation industrielle et ses techniques, sont la cheminée et l’escalier."
                                            },
                                            {
                                                "example_id": "78bce399-b8d7-4e48-a53a-d5973934d84e",
                                                "sense_id": "628feb11-adcc-3be5-a1be-94815fb99333",
                                                "text": "Si vous surmontez votre maison d'une cheminée, et qu'un voisin s'avise que le feng-shui en est mécontent, vous serez obligé de la démolir si vous n'êtes pas dans un port à traité."
                                            },
                                            {
                                                "example_id": "d2ee1add-d841-478b-8d14-1a3517c246d6",
                                                "sense_id": "628feb11-adcc-3be5-a1be-94815fb99333",
                                                "text": "Elle ouvre le premier tiroir de sa coiffeuse pour s'emparer de l’original de son travail. Elle va le détruire, le réduire en cendres dans la jolie cheminée du salon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Partie inférieure de cette construction qui lui sert d’encadrement en avançant dans une pièce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4adc7f37-d242-4e9f-babc-9c7fdf000e65",
                                                "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                                "text": "Jetant un coup d’œil sur la pendule de la cheminée […], j’eus le plaisir de voir que j’avais encore vingt minutes à moi."
                                            },
                                            {
                                                "example_id": "579bb51d-42c9-4809-87c2-591f2dedef17",
                                                "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                                "text": "Rétoil, qui est marbrier au cimetière de Volvic et nous a promis à chacun sa meilleure inscription, grave en attendant dans le marbre de la cheminée […]"
                                            },
                                            {
                                                "example_id": "7f9883bf-395c-4ece-a2ea-8533b31ebaed",
                                                "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                                "text": "Il n’y a dans la chambre qu’une bougie allumée qui tremble sur la cheminée."
                                            },
                                            {
                                                "example_id": "f1373c14-a109-461a-8be6-a80307c30ce0",
                                                "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                                "text": "La garniture d’andrinople rouge de la cheminée ondulait par instant […]"
                                            },
                                            {
                                                "example_id": "052bd770-3dc8-46ba-b831-bd39a0048021",
                                                "sense_id": "e73c300f-e509-3694-bbdd-45b2f0886c5b",
                                                "text": "Un livre à demi ouvert sur mes genoux croisés, je suis assis devant la cheminée, où flambe le premier feu de la saison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd34b709-38e2-3ab6-8cfb-08b4fc8861cf",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Partie supérieure du conduit en maçonnerie qui domine le toit ; souche."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6cd2b01-7dbd-47c0-ab79-3df9ff94ae9f",
                                                "sense_id": "cd34b709-38e2-3ab6-8cfb-08b4fc8861cf",
                                                "text": "Les cheminées et les toits de chaume, à droite et à gauche de la route, dépassaient à peine les montagnes de neige […]"
                                            },
                                            {
                                                "example_id": "b9c6ab6f-7504-42c4-a799-2b7e3b28291a",
                                                "sense_id": "cd34b709-38e2-3ab6-8cfb-08b4fc8861cf",
                                                "text": "On n’entend plus que les cris des volailles et des porcs saignés ; les cheminées fument, tout Ramscapelle s’emplit de la joyeuse animation d’un marché oriental."
                                            },
                                            {
                                                "example_id": "57d615d3-bdfc-44a4-b072-efd921e9e5c9",
                                                "sense_id": "cd34b709-38e2-3ab6-8cfb-08b4fc8861cf",
                                                "text": "Il put compter les petites cabanes des jardins, les unes ouvertes à tous vents, et que traversait, ce soir-là, le zéphir, les autres surmontées de cheminées immenses, ridicules, sur ce toit mesquin, avec leur bicorne de fer-blanc, comme un gendarme qui conduit une voiture à âne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec6aa8ce-c9d3-3bbe-a917-98d08631a88b",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Conduit d’évacuation des fumées."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2b9b3e-6ce4-4113-bb1a-53f81fc52801",
                                                "sense_id": "ec6aa8ce-c9d3-3bbe-a917-98d08631a88b",
                                                "text": "D’ailleurs, Bakou possède des quartiers, qui sont bien russes de mœurs et d’aspect […] et au bout de ces rues, un port moderne, dont l’atmosphère s’encrasse des fumées de la houille, vomies par la cheminée des steamers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f3f5f5d-2689-36b6-9c43-f3a41f9390f4",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Petite ouverture sur le dessus d’une pâte d’une tourte pour permettre à la vapeur de s'échapper lors de la cuisson."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15f5e9e-2a0b-4b13-a39d-6c67cef7b98b",
                                                "sense_id": "0f3f5f5d-2689-36b6-9c43-f3a41f9390f4",
                                                "text": "Terminer en réalisant une cheminée : prendre un triangle de papier cuisson, le rouler et le planter dans la tourte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f4bb503-0e8d-317b-b1c6-b7229313773d",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Couloir étroit plus ou moins vertical (fissure large, dièdre) permettant l’insertion du corps du grimpeur et l’usage de techniques particulières."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664650fe-192b-4199-829a-8414ab88d3af",
                                                "sense_id": "0f4bb503-0e8d-317b-b1c6-b7229313773d",
                                                "text": "Cheminée aux parois lisses que l’alpiniste doit monter à la manière des ramoneurs, en s’aidant des reins et des genoux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23adb005-1848-3518-8174-19596231602c",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Partie d’un fusil à percussion où se mettait la capsule et qui communiquait le feu à la charge."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98437bbb-169c-36ca-8ff7-56343ab81630",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Partie du clétage de certains instruments à vent solidaire du corps, servant à faire la jointure entre les tampons plats des clapets et le corps arrondi au niveau des trous."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b2935bf-13b2-4f3e-9406-91b80f2848e6",
                                                "sense_id": "98437bbb-169c-36ca-8ff7-56343ab81630",
                                                "text": "Cette flûte a des cheminées soudées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c455311-8239-3d23-868f-71be162ebec4",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Conduit plus ou moins vertical servant à l’aération ou au transport de matériaux, personnels, etc."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd526590-0dba-3c20-9253-31f4a64c70af",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ebcd92-caa6-471a-aa17-5b480825c0ed",
                                                "sense_id": "cd526590-0dba-3c20-9253-31f4a64c70af",
                                                "text": "Dans son modèle, des membranes minérales qui constituent de minuscules pores à l’intérieur des roches des cheminées séparent l’eau alcaline de l’eau plus acide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e23786-e619-349e-97fd-c8d5b252197b",
                                        "entry_id": "39bb36cd-7de1-3ac1-9aff-a3730850b919",
                                        "glosses": [
                                            "Ligne."
                                        ],
                                        "tags": [
                                            "Vallée d’Aoste"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
