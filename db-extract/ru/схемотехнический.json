                                                "sense_id": "788cabd3-3aa4-3ab9-9c90-3ae9aedf6b5c",
                                                "text": "circuite of words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f7cfb7-6cec-3eb2-9c18-6af8d8796d8d",
