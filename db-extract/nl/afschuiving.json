                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9c53e8b-fcca-486d-8bab-66ea0722cac0",
                                                "sense_id": "ad242450-7817-323d-8c47-5083be5de764",
                                                "text": "That might explain why the last three major earthquakes occurred not at San Andreas faults, where it would seem natural to expect them, but in both adjacent fault groups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc9bf97-2f04-3dc5-a553-8cbd1aeb8ce8",
                                        "entry_id": "0c38f6aa-8e0e-33d2-a146-19fd8107ef25",
                                        "glosses": [
