                        "examples": [
                            {
                                "example_id": "316dfd37-c464-4314-b9c6-afa744c33319",
                                "sense_id": "26c9f5ed-3937-3cb7-aa31-2513efe10317",
                                "text": "Die Abrichtung (Dressur) soll das Pferd dahin bringen, daß es widerstandslos, schnell und sicher den Willen des Reiters ausführt; da nun aber die Dressur verschiedene Ziele verfolgt, so muß eine zweckentsprechende Auswahl des Pferdes, sei es für die Jagd, den Rennplatz, als Soldaten- oder Damenpferd etc., nach seinem Körperbau und Temperament getroffen werden."
                            }
                        ]
                    }
