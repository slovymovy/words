                "senses": [
                    {
                        "sense_id": "d138e429-32a8-3e91-9aa4-2d3face58d38",
                        "entry_id": "cd9eeef1-ea78-313c-b5c0-72700e274aef",
                        "glosses": [
                            "Teindre en rouge avec du brésil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "03057aed-8232-35f3-bba0-ef1710993061",
                        "entry_id": "cd9eeef1-ea78-313c-b5c0-72700e274aef",
                        "glosses": [
                            "Réduire en petits morceaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ec4871-bc01-4e71-b6d1-d16d4517f1fb",
                                "sense_id": "03057aed-8232-35f3-bba0-ef1710993061",
                                "text": "Il sortit deux cigarettes de son paquet. Il les vida à moitié, les brésillant de sa main humaine, selon une technique bien au point."
                            },
                            {
                                "example_id": "57c1e464-2c93-434b-ba75-0b05bef4372a",
                                "sense_id": "03057aed-8232-35f3-bba0-ef1710993061",
                                "text": "Si vous voyez le postillon allant à tout brésiller et refuser un verre de vin, questionnez le conducteur ; il vous répond, le nez au vent, l’œil sur l’espace : — La Concurrence est devant !"
                            }
                        ]
                    },
                    {
                        "sense_id": "33185e5a-448f-3d64-a1ee-5ae09bf89b97",
                        "entry_id": "cd9eeef1-ea78-313c-b5c0-72700e274aef",
                        "glosses": [
                            "Se fendre en petits morceaux."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b827bb2f-6b26-4c9f-bd84-6457d88837b0",
                                "sense_id": "33185e5a-448f-3d64-a1ee-5ae09bf89b97",
                                "text": "Ainsi donc, à la cognée tierce,\nle chêne bronche et jà s’effondre,\nl’arbre roi craque et se brésille,\nl’arbre aux cent cimes s’agenouille."
                            }
                        ]
                    }
