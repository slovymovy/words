                ],
                "senses": [
                    {
                        "sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
                        "entry_id": "cefb9282-f281-3702-9e46-6dec55fbc520",
                        "glosses": [
                            "Durée d’une moitié d’une heure, c’est-à-dire trente minutes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d75dfd4-a8ea-46b3-9659-ae66af342532",
                                "sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
                                "text": "La nuit est froide. Je me réchauffe en arpentant le pont à grands pas pendant une demi-heure."
                            },
                            {
                                "example_id": "687ad208-f237-4517-b3bf-bd587b60650a",
                                "sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
                                "text": "Le deuxième axe de « Bonjour ! » sera l’information, avec un journal de dix minutes toutes les demi-heures présenté par Garance Pardigon, talent de la rédaction, et une interview politique menée par Adrien Gindre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afd757fe-38d2-4aa3-8c2b-2d16a4e91aa3",
                        "source_entry_id": "cefb9282-f281-3702-9e46-6dec55fbc520",
                        "source_sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
