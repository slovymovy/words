                        ]
                    },
                    {
                        "translation_id": "e98bdb99-6813-4c87-ac50-aab6168286f0",
                        "source_entry_id": "c6f6b4bc-18d9-3e4e-adb1-147ce5b579cb",
                        "source_sense_id": "824cef78-e5c5-3fd9-824c-08bcc355ba61",
                        "source_sense_description": "gezichtsuitdrukking",
                        "target_lang_word": "mimique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3912499-4766-3aab-9304-2b8339a43ee7",
                                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                                        "glosses": [
                                            "Qui concerne les mimes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69716d99-f7e2-4f1a-b1f2-6e27f11e8060",
                                                "sense_id": "e3912499-4766-3aab-9304-2b8339a43ee7",
                                                "text": "PHILISTION, de Magnésie, poëte mimique, ou composeur de farces, vivoit à Rome peu après Horace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                                        "glosses": [
                                            "Qui imite, qui exprime par le geste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035da332-c309-4552-8a30-0db18de7a40f",
                                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                                "text": "On trouve peu d’exemples de séquences dont le comique soit exclusivement visuel et mimique."
                                            },
                                            {
                                                "example_id": "a4fb2df8-7a7b-4590-b8de-194ae57f45e4",
                                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                                "text": "Son absence eut toutefois des avantages ; elle nous évita de nous obséder par ses mimiques et réactions, lors de la cérémonie, et de penser à la période Biden qui s’ouvrait pour les États-Unis."
                                            },
                                            {
                                                "example_id": "14a90b46-4849-4b47-8223-018bae9991aa",
                                                "sense_id": "c41fa734-231c-3dac-b8b6-9fc7d4ebcafd",
                                                "text": "Signes mimiques. – Langage mimique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112a2375-ea7c-31a0-9368-2102b0f4cbd2",
                                        "entry_id": "e4f85ce9-7b37-361b-9a84-94e294790875",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b3c0f5-2921-47bb-a964-6bdc8a2ce4f7",
                                                "sense_id": "112a2375-ea7c-31a0-9368-2102b0f4cbd2",
                                                "text": "LES VARIÉTÉS DE L’HEXAMÈTRE\nPartagé en deux hémistiches ce vers devient le priapéen; Le buccolique, quand il l’est en deux, et une dipodie, séparées par une pause. Les deux premières dipodies forment le vers alcmanien; Les deux dernières le phalisque; La dernière l’adonique; Le dernier hémistiche forme le phérécratien; Une fraction d’un spondée et de deux dactyles forme un glyconique; Et une fraction impaire forme le dactylique tétramètre catalectique. C’est un composé de trois pieds et demi ou une epthémimérie. Le miurus ou téliambe, mentionné dans le même tableau, n’est que le résultat d’un accident prosodique. Mais chacune de ces variétés a sa valeur mimique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mimique",
