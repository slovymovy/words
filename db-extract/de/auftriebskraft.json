                "senses": [
                    {
                        "sense_id": "a5fa7316-5d57-3099-a015-98b17c662024",
                        "entry_id": "3393fc7b-75ae-3ded-9642-67bed994d1c7",
                        "glosses": [
                            "eine nach oben gerichtete Kraft, die auf Körper in Flüssigkeiten oder Gasen wirkt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "0ac2eada-6a67-4d96-8786-f3de1f6e0164",
                                "sense_id": "a5fa7316-5d57-3099-a015-98b17c662024",
                                "text": "Ein schwimmender Eisberg befindet sich im Gleichgewicht. Seine Gewichtskraft und die Auftriebskraft sind also gleich groß."
                            },
                            {
                                "example_id": "ab0d4ef5-a44e-4d68-916e-252586847995",
                                "sense_id": "a5fa7316-5d57-3099-a015-98b17c662024",
                                "text": "„Ursache der Auftriebskraft ist, dass der Flüssigkeitsdruck an der Unterseite des Körpers größer ist als der Druck an der Oberseite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
