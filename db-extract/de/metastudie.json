                        "entry_id": "75b539f8-440b-37f7-a18f-3f0eff0003e9",
                        "glosses": [
                            "wissenschaftliche Untersuchung, die mehrere vorhandene Studien auswertet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35bca351-cbeb-4998-b4f8-187f4c4d0eb3",
                                "sense_id": "4f7b5df2-9d82-3d73-9de5-e1a5b8b63f4b",
                                "text": "„Laut einer neuen Metastudie auf Basis von fast 100 anderen Studien tun 800 Gramm Grünzeug und Früchte besonders gut.“"
                            },
                            {
                                "example_id": "e5a32f0b-ffc1-49f1-a0fd-bc61c88fceaa",
                                "sense_id": "4f7b5df2-9d82-3d73-9de5-e1a5b8b63f4b",
                                "text": "„In einer amerikanischen Metastudie sind über sechshundert Psychopathen, Straftäter und gewaltbereite Menschen untersucht worden.“"
                            }
                        ],
