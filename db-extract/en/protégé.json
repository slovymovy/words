                                    {
                                        "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                        "entry_id": "920d87c7-7b56-3ad3-a566-dd68aeb89c80",
                                        "glosses": [
                                            "Personne qui bénéficie d’une protection de la part de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d990fa2-c277-4e40-bec3-50f5f27fd7cc",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "Le protégé ne peut se passer de la compétence du protecteur, de sa force et de sa vigilance."
                                            },
                                            {
                                                "example_id": "86337f49-7425-46cb-8344-5875db1e6010",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "C’est sa protégée."
                                            },
                                            {
                                                "example_id": "057eb6e1-3d25-4fca-8cd3-04d3c5e4a1e5",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "Cet homme est un des protégés du ministre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "733ae2d7-8c97-3aab-9f38-5854fde83ed7",
                                        "entry_id": "3b464c46-52a0-37d5-922d-50f14006fcb5",
                                        "glosses": [
                                            "Participe passé de protéger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5fe076-5d3e-4ea6-8e84-120498ea87d0",
                                                "sense_id": "733ae2d7-8c97-3aab-9f38-5854fde83ed7",
                                                "text": "Aussi le bélier avait-il besoin d’être protégé des actions des assiégés : il était donc habituellement couvert par un chat ou manteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d11eaf16-4956-42d0-9cb3-5246737d97b8",
                        "source_entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                        "source_sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                        "source_sense_description": "person who is guided and supported",
                        "target_lang_word": "protégée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protégée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a25a34c-f35e-3b2e-ad0d-9154d7c86519",
                                        "entry_id": "7ab427a7-d528-3ebf-a521-8d3b5e54fb09",
                                        "glosses": [
                                            "Femme protégée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddd18f57-27cd-4f77-ab9a-3c56ed08aa04",
                                                "sense_id": "2a25a34c-f35e-3b2e-ad0d-9154d7c86519",
                                                "text": "Donc, la châtelaine mignarde ma protégée, la baisotte, la glitouille, s’incline pour une caresse du médius en accent circonflexe sur le délicat bigornuche rose, lui glousse des embryons de mots, des soupirs pâmants, des inarticuleries qui flanquent le bâton de Guignol dans le bénoche de l’ami Sana."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protégée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d02bbf-d761-3b59-bb50-e665c8830847",
                                        "entry_id": "44f7449c-0874-3a23-9c24-f86ff329f28c",
                                        "glosses": [
                                            "Féminin singulier de protégé."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "protégée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e34831-4c25-3340-8e44-04a315f61d9f",
                                        "entry_id": "378555fc-0695-37b9-9384-da062c9268af",
                                        "glosses": [
                                            "Participe passé féminin singulier de protéger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b6256b-76e6-42d4-82f3-7898906d4e94",
                                                "sense_id": "62e34831-4c25-3340-8e44-04a315f61d9f",
                                                "text": "En conférant ainsi aux droits positifs, aux droits du citoyen, un tel privilège sur les droits de l’homme, elle pourrait nous faire oublier que ses propres droits de citoyenne allemande ne l’ont pourtant pas protégée et que tout État peut \"décitoyenniser\" - dénaturaliser - certains de ses membres comme le fit l’Allemagne nazie, et d’autres pays dans une moindre mesure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "187e50c3-ca1b-40ae-b311-c0eb36f9b25c",
                        "source_entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                        "source_sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                        "source_sense_description": "person who is guided and supported",
                        "target_lang_word": "Günstling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Günstling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                        "entry_id": "96089c1d-e8f2-3c5b-a408-e4c51f91780d",
                                        "glosses": [
                                            "jemand, der wohlwollend von jemand anderem behandelt und bevorzugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e2432c-cb83-4f36-98b9-6f397440442b",
                                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                                "text": "„Aber unter seinen Günstlingen war auch nicht ein wirklich tüchtiger Mensch.“"
                                            },
                                            {
                                                "example_id": "97dcb056-7b8a-4dfe-ade7-b67abd734f60",
                                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                                "text": "„Zuspruch sucht der verwaiste König bei Günstlingen.“"
                                            },
                                            {
                                                "example_id": "30bafdd7-3b28-46d5-aa07-e226441e107d",
                                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                                "text": "„Noch in der Hauptstadt hatte der Haushalter Di-Tjän dem Musterprüfling Zai mitgeteilt, daß in Klarenfluß ein Tausendschaftsführer und Günstling seiner Durchlaucht namens Simen lebe, der einer bedeutenden, reichen und wohlgesitteten Familie angehöre.“"
                                            },
                                            {
                                                "example_id": "f3ebd9a7-26e9-4bec-a1cf-2dca6f63cf2a",
                                                "sense_id": "3d86c6d0-453f-3e61-8378-6aa96268ad6f",
                                                "text": "„Nachdem ich Zeuge dieser Szenen gewesen und der Senator mich mit diesem Gespräch beehrt hatte, wurde ich sein Günstling.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d07cf41-2174-4618-8c51-6ad7ea89cf43",
                        "source_entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                        "source_sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                        "source_sense_description": "person who is guided and supported",
                        "target_lang_word": "Protegé",
                        "target_lang_code": "de",
                        "note": "both with a negative connotation",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protegé",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                        "entry_id": "0cd5bd77-1e8d-3aa5-8a0c-55cd287e6724",
                                        "glosses": [
                                            "junge Person, die von einer älteren Person mit gesellschaftlichem Einfluss und/oder mehr Erfahrung auf einem Gebiet gefördert wird"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "439b4dc0-87d7-4826-9e41-efe0a9fb947a",
                                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                                "text": "Mein Protegé macht große Fortschritte."
                                            },
                                            {
                                                "example_id": "7985c597-717a-4c58-96ce-8e868be4f958",
                                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                                "text": "„Roth lud sein Protegé ein, an seinem Seminar teilzunehmen, wo er auf die beinahe krankhaft schüchterne Frau zeigte und »Harpo!« rief, wenn er sie aufforderte, etwas zu sagen.“"
                                            },
                                            {
                                                "example_id": "9fc568da-aa71-4a62-b500-8a4d52d51427",
                                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                                "text": "„Da solche Protegés immer auch illoyal werden und im schlimmsten Fall sich sogar gegen die pakistanischen Streitkräfte wenden können, gehört es zu den größten Herausforderungen für die Armee, solche Entwicklungen im Auge zu behalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f027ce34-c403-4fc3-9e4a-f6351d531061",
                        "source_entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                        "source_sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                        "source_sense_description": "person who is guided and supported",
                        "target_lang_word": "Mündel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mündel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "096b6044-7459-3b17-9727-2c82a48d755b",
                                        "entry_id": "56d61995-787f-3660-ba11-bfcff1f138f7",
                                        "glosses": [
                                            "deutsches Familienrecht: minderjährige Person, die unter Vormundschaft steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a93cd9-316b-49e7-ab3e-b47dbdd339f4",
                                                "sense_id": "096b6044-7459-3b17-9727-2c82a48d755b",
                                                "text": "„Wenn der Vormund Geld für sein Mündel entgegennehme, müsse das vom Vormundschaftsgericht genehmigt werden - diese Schutzvorschrift zu Gunsten des Mündels solle Veruntreuung durch den Vormund erschweren.“"
                                            },
                                            {
                                                "example_id": "b750e625-0edf-4436-b290-090c097c0b6d",
                                                "sense_id": "096b6044-7459-3b17-9727-2c82a48d755b",
                                                "text": "„Soweit die Staatskasse den Vormund oder Gegenvormund befriedigt, gehen Ansprüche des Vormundes oder Gegenvormunds gegen den Mündel auf die Staatskasse über.“"
                                            },
                                            {
                                                "example_id": "295299ba-9b70-48bd-abea-9ff47de660d0",
                                                "sense_id": "096b6044-7459-3b17-9727-2c82a48d755b",
                                                "text": "„Es ist absolut nicht hinnehmbar, dass ich im politischen Geschehen meines Landes keine Stimme haben soll, denn ich bin kein Mündel Amerikas; ich gehöre zu den ersten Amerikanern, die an diesen Küsten landeten.“"
                                            },
                                            {
                                                "example_id": "0d08e68c-4e0d-4f07-a7be-60eda0490291",
                                                "sense_id": "096b6044-7459-3b17-9727-2c82a48d755b",
                                                "text": "„Graf Daniele, der Senior der Familie, hatte eine Contessa Gozzi geehelicht, und ein reicher junger Pächter, der ein Mündel der alten Contessa geheiratet hatte, war mit Frau und Schwägerin dazu eingeladen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10c5b711-e040-42b1-a9d2-ba1794ad4c84",
                        "source_entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                        "source_sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                        "source_sense_description": "person who is guided and supported",
                        "target_lang_word": "Schützling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schützling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                        "entry_id": "57e96714-55de-3215-b83d-750d3f24c4c0",
                                        "glosses": [
                                            "jemand, der sich in jemandes Obhut befindet oder von jemandem betreut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03070928-4bc2-4b40-aabf-2584c4012b58",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "Der Heimerzieher musste seinen Posten räumen, als herauskam, dass er einen seiner Schützlinge geschlagen hat."
                                            },
                                            {
                                                "example_id": "e6175b37-8ff6-402e-9012-a341b5ffa975",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "Die Tierfreundin pflegt verletzte Wildtiere gesund und kümmert sich dabei sehr liebevoll um ihre Schützlinge."
                                            },
                                            {
                                                "example_id": "3d2e0c7e-61c9-4911-b8ba-2accebc9d783",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "„Sie ist untröstlich, und auch Sofia weiß nicht, wie sie ihrem Schützling wieder Lebensmut geben soll.“"
                                            },
                                            {
                                                "example_id": "e4f8fac4-a1e2-42b1-85c0-4adb2f1e630b",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "„Wieck konnte nicht nur bei diesen Gelegenheiten feststellen, dass sein Schützling gern über den Durst trank.“"
                                            },
                                            {
                                                "example_id": "85e21b94-ed85-452a-9680-8b9aa50ed1be",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "„Ich blieb unnachgiebig; Madame d'Urfé ihrerseits lachte über die Narrheiten ihrer angeblichen Nichte und zeigt sich sehr erfreut, als sie mich ihr gegenüber und den Schützling des mächtigen Selenis neben sich sitzen sah.“"
                                            },
                                            {
                                                "example_id": "b6059a84-7eef-4491-be42-2327862ac252",
                                                "sense_id": "f5f362e7-bd90-3f76-ba73-41791cee35ee",
                                                "text": "„Er richtete, so gut das in der Eile gehen wollte, mit der Jacke eine Art Lager für seinen Schützling her, der teilnahmslos für alles, was auch um ihn vorging, sich das ruhig gefallen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
