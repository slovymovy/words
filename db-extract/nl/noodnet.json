                        "sense_id": "28fbd8ca-acbb-3fef-9c81-7819243fba3e",
                        "entry_id": "da0e3e71-3cfc-368d-813e-ce26c58499ad",
                        "glosses": [
                            "netwerk waarmee hulpdiensten tijdens een ramp met elkaar kunnnen communiceren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1721653a-51fa-47e9-8e0d-b3ee9ee57b34",
                                "sense_id": "28fbd8ca-acbb-3fef-9c81-7819243fba3e",
                                "text": "De bouw van een nieuw digitaal netwerk waarmee politie en hulpverleners elkaar kunnen bereiken bij een ramp loopt opnieuw bijna een jaar vertraging op. Het huidige Nationaal Noodnet, dat stamt uit 1991, is ernstig verouderd."
                            },
                            {
                                "example_id": "30ede31d-6614-4376-9a57-a42a1dac5f4e",
                                "sense_id": "28fbd8ca-acbb-3fef-9c81-7819243fba3e",
                                "text": "Ook nu maakt enorm harde wind, de uitval van de elektriciteit en van het telefoonnet het de hulpdiensten moeilijk. Ze kunnen alleen maar met elkaar communiceren via enkele vaste telefoonaansluitingen. Er is geen mobiel noodnet."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1898e00-c52f-3ed8-90f3-f37281a59f78",
                        "entry_id": "da0e3e71-3cfc-368d-813e-ce26c58499ad",
                        "glosses": [
                            "netwerk dat men gebruikt als het reguliere netwerk is uitgevallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae239eb-fa3c-4630-850e-7f2c4b954eec",
                                "sense_id": "c1898e00-c52f-3ed8-90f3-f37281a59f78",
                                "text": "Na de brand bij Vodafone drong minister Maxime Verhagen van Economische Zaken aan op een noodnet waarnaar in dit soort situaties kan worden uitgeweken. Hierover is inmiddels al op ambtelijk niveau overlegd gepleegd met de telecomproviders. Knopen zijn nog niet doorgehakt."
                            }
                        ]
                    }
