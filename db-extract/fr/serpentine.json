                                    },
                                    {
                                        "sense_id": "ed5a2457-6ce8-392a-b044-8f96bd945451",
                                        "entry_id": "0a40e80e-c88f-31d4-9821-a70ec0a6ba9c",
                                        "glosses": [
                                            "Of, or having attributes associated with, the serpent referred to in the book of Genesis in the Bible, such as craftiness or deceitfulness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3aef99-9d00-44b1-a130-ee1d8a31300e",
                                                "sense_id": "ed5a2457-6ce8-392a-b044-8f96bd945451",
                                                "text": "The wily criminal was known for his serpentine behavior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c7f2294-a578-31aa-9dd4-f90dbe218a6b",
                                        "entry_id": "0a40e80e-c88f-31d4-9821-a70ec0a6ba9c",
                                        "glosses": [
                                            "Having the form or shape of a snake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150bf7b7-78b5-4405-8481-7b65d6fe19dc",
                                                "sense_id": "7c7f2294-a578-31aa-9dd4-f90dbe218a6b",
                                                "text": "There are serpentine species of lizards which do not have legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c941de-5e75-334f-98f3-447a0c2bf08a",
                                        "entry_id": "0a40e80e-c88f-31d4-9821-a70ec0a6ba9c",
                                        "glosses": [
                                            "Curving in alternate directions; sinuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daed1fc1-cbe4-4a1f-ac60-a6a87ea83558",
                                                "sense_id": "35c941de-5e75-334f-98f3-447a0c2bf08a",
                                                "text": "The serpentine path through the mountains was narrow and dangerous."
                                            },
                                            {
                                                "example_id": "91484105-7862-481b-a095-ab4bdbd2494d",
                                                "sense_id": "35c941de-5e75-334f-98f3-447a0c2bf08a",
                                                "text": "So! keep looking so— / My serpentining beauty, rounds on rounds!"
                                            },
                                            {
                                                "example_id": "28be49af-ea29-4e25-af53-b57779ef2b90",
                                                "sense_id": "35c941de-5e75-334f-98f3-447a0c2bf08a",
                                                "text": "Between Magherafelt and Macfin its length of 29¼ miles made a rather serpentine line on the map, as it attempted to serve the rather scattered towns and villages that lie between the River Bann and the Dungiven Mountains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa21da11-8ce1-3fdf-8a6a-ed909264e8fe",
                                        "entry_id": "0a40e80e-c88f-31d4-9821-a70ec0a6ba9c",
                                        "glosses": [
                                            "Pertaining to the serpentine subgroup of minerals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75474553-9f41-4c78-9fae-1078fc95c299",
                                                "sense_id": "aa21da11-8ce1-3fdf-8a6a-ed909264e8fe",
                                                "text": "serpentine soils"
                                            }
                                        ]
