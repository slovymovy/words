                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a63a982-fbf4-4aff-ae52-16bb3b0f7363",
                                                "sense_id": "d5b16beb-8201-37d8-a417-30d68bab838e",
                                                "text": "Nach einer langen Reise nach Shanghai sahen sie zwar die Sonnenfinsternis, aber wegen der Überdeckung der Sonne mit dichten Wolken nicht die Sonne!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4dc9b76-ef43-3ee3-8df7-086991c2b9f4",
                                        "entry_id": "33a97141-97bc-3cef-b834-a3ade21e06ad",
                                        "glosses": [
                                            "Abstand zwischen der Oberfläche des Betons und dessen Bewehrungsstahl, Betondeckung"
                                        ],
                                        "tags": [
                                            "Bautechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab8075bd-2b8b-4cf0-b988-4b7b600a7b04",
                                                "sense_id": "c4dc9b76-ef43-3ee3-8df7-086991c2b9f4",
                                                "text": "„Bei dieser Versichertengruppe sind nämlich die Kosten nicht nur voll gedeckt, es entsteht sogar eine leichte Überdeckung zugunsten der Allgemeinversicherten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21410121-3cf7-3011-b434-6df2f3fbdbf9",
