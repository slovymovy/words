                    },
                    {
                        "sense_id": "e3c8923a-95f5-3bf9-8c6b-00e3c601be81",
                        "entry_id": "6bdb2505-71e2-3b0d-adb4-992d1adb05e9",
                        "glosses": [
                            "Tomber malade."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6d9bf6-c2d0-4d5e-8193-065734f29c70",
                                "sense_id": "e3c8923a-95f5-3bf9-8c6b-00e3c601be81",
                                "text": "He sickened rapidly, and later died."
                            }
                        ]
                    },
                    {
                        "sense_id": "b29d6c54-2206-3ccc-9791-a2c3fd83034a",
                        "entry_id": "6bdb2505-71e2-3b0d-adb4-992d1adb05e9",
                        "glosses": [
                            "Écœurer."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2d236195-1d54-4c53-b64e-3d72ad54fcd3",
                                "sense_id": "b29d6c54-2206-3ccc-9791-a2c3fd83034a",
                                "text": "It sickens me to think of the large loss of life."
                            },
                            {
                                "example_id": "7b7ae8e5-0b4b-4cb3-a57b-d9682537ee79",
                                "sense_id": "b29d6c54-2206-3ccc-9791-a2c3fd83034a",
                                "text": "His arrogant behaviour sickens me.",
                                "translation": "Son caractère arrogant m’écœure."
                            }
                        ]
