                        "entry_id": "6351eff6-7cd5-33f3-818d-e21040548772",
                        "glosses": [
                            "Méthode consistant à énoncer un mot dont la lettre initiale représente la lettre de l’alphabet que l’on souhaite transmettre au récepteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e814e4-79f4-4502-ba90-9d03bd765d15",
                                "sense_id": "f5059626-8257-3eb7-a19e-7489f7bdd696",
                                "text": "A comme Anatole, est une acrophonie."
                            },
                            {
                                "example_id": "48312bd7-ff20-4ed7-aaf1-50f388fa7925",
                                "sense_id": "f5059626-8257-3eb7-a19e-7489f7bdd696",
                                "text": "L’acrophonie est utilisée lors de communications radio ou téléphoniques lorsque les transmissions sont mauvaises ou pour faire passer un message important."
                            },
                            {
                                "example_id": "45871fc0-623e-4849-bfcc-05fc5a93d371",
                                "sense_id": "f5059626-8257-3eb7-a19e-7489f7bdd696",
                                "text": "En 1943, E. Drioton proposait une lecture du texte selon le principe de l’acrophonie."
                            }
                        ]
                    }
                ],
