                                                "sense_id": "c8e629a0-d7ce-3840-b9ee-1a6dce0349b5",
                                                "text": "Βγήκε έξω στα κρυφά."
                                            },
                                            {
                                                "example_id": "f45e8da5-c628-416c-a4ae-f703ba3f00cd",
                                                "sense_id": "c8e629a0-d7ce-3840-b9ee-1a6dce0349b5",
                                                "text": "Δε λιποθύμησε πραγματικά, το έκανε στα ψέματα."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4582db3f-0c4b-3814-8478-17568da73824",
                                        "entry_id": "f7dc90a1-28d7-3951-afc4-fcb8df0d9f75",
                                        "glosses": [
                                            "δηλώνει:",
                                            "ποσότητα ή αριθμό κατά προσέγγιση"
                                        ],
                                        "tags": [
                                            "με αιτιατική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa595a9-b610-4077-98f7-11cd07341652",
                                                "sense_id": "4582db3f-0c4b-3814-8478-17568da73824",
                                                "text": "Το εμπόρευμα είναι (γύρω) στα είκοσι κιλά."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049406f7-b016-3888-ac6e-e95b1c53c9c3",
                                        "entry_id": "f7dc90a1-28d7-3951-afc4-fcb8df0d9f75",
                                        "glosses": [
