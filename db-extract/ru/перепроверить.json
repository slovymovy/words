                "senses": [
                    {
                        "sense_id": "a8c51cf0-3571-3df9-9815-48e4ec607c7d",
                        "entry_id": "113db0e6-adfc-3ce4-8431-92fed073da08",
                        "glosses": [
                            "повторно проверить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fae98d1-8809-4537-baae-7a406dad3bb8",
                                "sense_id": "a8c51cf0-3571-3df9-9815-48e4ec607c7d",
                                "text": "Десять раз перепрове́рили, не забыли ли чего важного."
                            },
                            {
                                "example_id": "1b1a750e-f454-4833-b546-eb26b5fd05a1",
                                "sense_id": "a8c51cf0-3571-3df9-9815-48e4ec607c7d",
                                "text": "Постарайтесь не верить на слово, а важную для вас информацию перепрове́рить, чтобы не разочароваться."
                            },
                            {
                                "example_id": "1fcf27be-608a-42ae-8c0b-1299aee24433",
                                "sense_id": "a8c51cf0-3571-3df9-9815-48e4ec607c7d",
                                "text": "Медики перепроверили теорию о том, что боль передаётся из места повреждения с помощью микроглии ― особых клеток нервной системы."
                            }
                        ]
                    }
