                "senses": [
                    {
                        "sense_id": "ea0b1cd8-bc96-3c5e-a1c0-0c30052741a2",
                        "entry_id": "acc2be0f-58f9-3617-a99d-a068abeda216",
                        "glosses": [
                            "Person, die eine Kamelherde hütet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8655d6b7-5fa5-416e-ae71-b2915f1d5d4b",
                                "sense_id": "ea0b1cd8-bc96-3c5e-a1c0-0c30052741a2",
                                "text": "„In Wirklichkeit werdet ihr dort einen Ziegenhirten antreffen. Oder, mit etwas Glück, einen Kamelhirten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bddfe95-90cf-4db7-baca-a8fa8b22cf0f",
                        "source_entry_id": "acc2be0f-58f9-3617-a99d-a068abeda216",
                        "source_sense_id": "ea0b1cd8-bc96-3c5e-a1c0-0c30052741a2",
                        "source_sense_description": "Person, die eine Kamelherde hütet",
                        "target_lang_word": "camel herder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b23cfa75-31f8-445d-ae8c-274dba90d61d",
                        "source_entry_id": "acc2be0f-58f9-3617-a99d-a068abeda216",
                        "source_sense_id": "ea0b1cd8-bc96-3c5e-a1c0-0c30052741a2",
                        "source_sense_description": "Person, die eine Kamelherde hütet",
                        "target_lang_word": "chamelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chamelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "822535e5-2724-31c3-8f6c-d5c0eae52b9c",
                                        "entry_id": "42f8ed33-33df-3a3b-ae91-5889a9967f35",
                                        "glosses": [
                                            "Personne chargée de conduire et de soigner des chameaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5140991b-9779-483c-97aa-d4e0db549635",
                                                "sense_id": "822535e5-2724-31c3-8f6c-d5c0eae52b9c",
                                                "text": "Elle était si préoccupée par l'image obsédante du jeune bijoutier qu'elle ne remarquait ni les âniers, ni les chameliers qui la poursuivaient de leurs cris : « Gare! Gare! » … ."
                                            },
                                            {
                                                "example_id": "5638ba88-0c6b-431d-8e71-7186e3dbb6fd",
                                                "sense_id": "822535e5-2724-31c3-8f6c-d5c0eae52b9c",
                                                "text": "Outre l'avion, qui représente environ 30 % du prix du voyage, nous devons payer les 4 x 4 et les chauffeurs — pour les transferts — les chameaux et les chameliers — pour le portage — et, bien sûr, le guide."
                                            },
                                            {
                                                "example_id": "a0d3132e-dd3a-458c-a59d-9c24f97134a3",
                                                "sense_id": "822535e5-2724-31c3-8f6c-d5c0eae52b9c",
                                                "text": "À Merzouga, nous avons séjourné à l'auberge de Mohamed Alla quelques jours et il nous a organisé une très agréable excursion de deux jours dans les dunes de l'erg Chebbi, avec chameaux et chamelier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3e136de-c796-36d2-88da-91335b273387",
                                        "entry_id": "42f8ed33-33df-3a3b-ae91-5889a9967f35",
                                        "glosses": [
                                            "Soldat monté à dos de chameau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c9ca85-578e-436b-a752-8bfa8a0ffb9a",
                                                "sense_id": "b3e136de-c796-36d2-88da-91335b273387",
                                                "text": "La chamellerie est constituée d’unités de chameliers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chamelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "784c332d-2659-3135-9ff8-b8e50b7b76e2",
                                        "entry_id": "df6e231b-5c47-3c10-95b2-3751099677ef",
                                        "glosses": [
                                            "Qui est relatif à une activité impliquant un chameau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df51cb87-e835-4605-b518-fde8a9767ee2",
                                                "sense_id": "784c332d-2659-3135-9ff8-b8e50b7b76e2",
                                                "text": "Et afghane, russe ou chinoise, de toute l’Asie du milieu, terre immense des herbes et des sables, des caravanes chamelières et des cavaliers infatigables."
                                            },
                                            {
                                                "example_id": "e8a5acc6-7b60-408b-96a5-3ce32402b025",
                                                "sense_id": "784c332d-2659-3135-9ff8-b8e50b7b76e2",
                                                "text": "Club chamelier à Tiznit, la Perle Traditionnelle du Sud"
                                            },
                                            {
                                                "example_id": "eeb35e7f-93c7-468f-b407-7fdb6c8187bc",
                                                "sense_id": "784c332d-2659-3135-9ff8-b8e50b7b76e2",
                                                "text": "C'est là-bas qu'enfants, nous avions appris à […] quémander un peu d'argent aux touristes qui faisaient des randonnées chamelières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
