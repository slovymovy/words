{
    "word_family": [
        "nevel",
        "nevelen",
        "benevelen",
        "nevelachtig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "932d7e21-13a4-37f4-a82e-89dabd6aa090",
                    "sense_definition": "Bedekt met of gekenmerkt door nevel of mist; onduidelijk zichtbaar door weersomstandigheden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de vroege ochtend was het landschap erg <w>nevelig</w>.",
                            "target_lang_translations": {
                                "en": "In the early morning, the landscape was very <w>misty</w>."
                            }
                        },
                        {
                            "text": "We moesten voorzichtig rijden door het <w>nevelige</w> bos.",
                            "target_lang_translations": {
                                "en": "We had to drive carefully through the <w>foggy</w> forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "mistig",
                        "heiig"
                    ],
                    "antonyms": [
                        "helder",
                        "klaar"
                    ],
                    "common_phrases": [
                        "nevelig weer",
                        "een nevelige ochtend"
                    ],
                    "target_lang_definitions": {
                        "en": "Covered with or characterized by mist or fog; indistinctly visible due to weather conditions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "misty",
                                "target_lang_sense_clarification": "characterized by mist or light fog"
                            },
                            {
                                "target_lang_word": "foggy",
                                "target_lang_sense_clarification": "covered with thick fog"
                            },
                            {
                                "target_lang_word": "hazy",
                                "target_lang_sense_clarification": "slightly obscured by haze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab3b2cd0-827e-37cb-b9c0-143f7b7324c6",
                    "sense_definition": "Met betrekking tot gedachten, ideeën of herinneringen: onduidelijk, vaag of onbestemd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij had slechts een <w>nevelige</w> herinnering aan die gebeurtenis uit haar jeugd.",
                            "target_lang_translations": {
                                "en": "She had only a <w>hazy</w> memory of that event from her childhood."
                            }
                        },
                        {
                            "text": "Zijn plannen voor de toekomst bleven nogal <w>nevelig</w>.",
                            "target_lang_translations": {
                                "en": "His plans for the future remained rather <w>vague</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaag",
                        "onduidelijk",
                        "wazig",
                        "nebulous"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "helder",
                        "concreet"
                    ],
                    "common_phrases": [
                        "een nevelig idee",
                        "nevelige herinneringen"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to thoughts, ideas, or memories: unclear, vague, or indefinite."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "not clearly expressed or outlined"
                            },
                            {
                                "target_lang_word": "hazy",
                                "target_lang_sense_clarification": "unclear or indistinct in mind or memory"
                            },
                            {
                                "target_lang_word": "nebulous",
                                "target_lang_sense_clarification": "ill-defined or vague"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}