                ],
                "senses": [
                    {
                        "sense_id": "ce78f8cc-8bf4-3fc7-ae05-b5423f5a8706",
                        "entry_id": "1d80180e-1846-3a41-97b7-4f20b9a6f5c4",
                        "glosses": [
                            "to forge together, to forge into one"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6cf785f-60e4-48a7-b170-2d35359c4633",
                                "sense_id": "ce78f8cc-8bf4-3fc7-ae05-b5423f5a8706",
                                "text": "Hij vroeg aan de smid of zij dit kon aansmeden.",
                                "translation": "He asked the smith whether she could forge this together.",
                                "english": "He asked the smith whether she could forge this together."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a5596ae-a1b3-343b-94c6-58fbc0581322",
                        "entry_id": "1d80180e-1846-3a41-97b7-4f20b9a6f5c4",
                        "glosses": [
                            "to put (restraints) into place, either forged shut or fastened in another way"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a71c459e-a08e-429a-adcd-9e47b03d8ac6",
                                "sense_id": "6a5596ae-a1b3-343b-94c6-58fbc0581322",
                                "text": "O hoe wogen die gruwelijke boeien, door een duivels man hun aangesmeed.",
                                "translation": "Oh, how heavy weighed those gruesome bonds, placed onto them by a devilish man.",
                                "english": "Oh, how heavy weighed those gruesome bonds, placed onto them by a devilish man."
                            }
                        ]
                    }
                ],
