                "translations": [
                    {
                        "translation_id": "6402b94b-36a4-40ef-8650-453bef1faba0",
                        "source_entry_id": "9a6b5586-93f1-370a-92a9-49d7e9912c26",
                        "source_sense_id": "191c58dc-bff8-34d5-a4b7-3271d9a6bf49",
                        "target_lang_word": "snowstorm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowstorm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddfa9747-360f-3477-92d5-7f31be0555cc",
                                        "entry_id": "a8f86327-03a9-3a6d-b8aa-923fe207c9c0",
                                        "glosses": [
                                            "Bad weather involving blowing winds and snow, or blowing winds and heavy snowfall amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9390d75-5e6b-4845-b317-caabadb7398f",
                                                "sense_id": "ddfa9747-360f-3477-92d5-7f31be0555cc",
                                                "text": "Dined at Melville Castle, whither I went through a snow-storm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eaefe8d-a6cf-3965-bf6a-8137b3e6326e",
                                        "entry_id": "a8f86327-03a9-3a6d-b8aa-923fe207c9c0",
                                        "glosses": [
                                            "A snow globe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f1ea61-2a2b-4671-acd1-d321f86f6fbf",
                                                "sense_id": "4eaefe8d-a6cf-3965-bf6a-8137b3e6326e",
                                                "text": "As we made our way down, my eye was caught by a snowstorm—one of those little glass balls, with a baby cottage inside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e4e9936-5165-45c1-9ed6-cafbe1bdf758",
                        "source_entry_id": "9a6b5586-93f1-370a-92a9-49d7e9912c26",
                        "source_sense_id": "191c58dc-bff8-34d5-a4b7-3271d9a6bf49",
                        "target_lang_word": "tempête de neige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tempête de neige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ac19c3-406c-3012-9781-1967fb74c078",
                                        "entry_id": "79dfeb2c-07ea-3af3-b028-ed04b92db3ea",
                                        "glosses": [
                                            "Phénomène météorologique produit par une dépression météorologique hivernale importante, qui se caractérise par des chutes de neige importantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57a8b17-2a7d-4866-b324-1f3c614b7712",
                                                "sense_id": "b2ac19c3-406c-3012-9781-1967fb74c078",
                                                "text": "9 novembre 1878 : Traversé le Brenner par une tempête de neige. […] À travers les flocons de neige ou aperçoit les hauts sommets, pareils aux gigantesques fantômes des dieux de la mythologie du Nord qui gardent le passage ; il semble qu’ils vont nous anéantir par les avalanches suspendues à leurs flancs. Sur le revers méridional la tempête cesse et nous arrivons à Vérone par une nuit splendide qu’illumine la lune sans un nuage."
                                            },
                                            {
                                                "example_id": "868027c0-5e1c-47fd-a993-e37b2f18bdbf",
                                                "sense_id": "b2ac19c3-406c-3012-9781-1967fb74c078",
                                                "text": "Ce qui s’était passé dans les Balkans, un autre correspondant dans une lettre adressée à la Politische correspondenz le raconte : « La tempête de neige, écrit-il, a sévi avec une telle violence dans le défilé de Schipka qu’aucun être humain n’a pu résister en plein air. […] Le vent était si violent qu’il a renversé les huttes bâties au moyen de gros troncs d’arbres, et les soldats qui s’y trouvaient ont à grand’peine échappé à la mort. Deux jours durant la neige qui tombait empêchait de distinguer un homme à quinze pas de distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c85ecb86-3ea7-451c-ae16-67e548ede461",
                        "source_entry_id": "9a6b5586-93f1-370a-92a9-49d7e9912c26",
                        "source_sense_id": "191c58dc-bff8-34d5-a4b7-3271d9a6bf49",
                        "target_lang_word": "Schneesturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneesturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                        "entry_id": "319741ee-4acd-388c-af52-90be2a168f48",
                                        "glosses": [
                                            "starker Schneefall bei Wind, Sturm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beeb612e-3d93-4328-84f7-bd10f6c36bf8",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "Bei den Schneestürmen brach Chaos auf den Straßen aus."
                                            },
                                            {
                                                "example_id": "c95794f4-c13c-4248-a5ea-42f7a66ba438",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Als ich unten im Zentrum ankam, war der Schneefall zu einem undurchdringlichen Schneesturm angewachsen.“"
                                            },
                                            {
                                                "example_id": "4b027378-4db4-44e3-ab06-57d886fa8359",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Am Dienstag kam ein Schneesturm auf, und am Freitag hatten wir rodelfrei.“"
                                            },
                                            {
                                                "example_id": "dd9d1b34-6084-4135-9e16-07dfa0d4a409",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Dass das Leben in der Kolonie auch seine Schattenseiten hatte, lässt sich erahnen, wenn Perley schreibt, es gebe selten mehr als vier Schneestürme im Jahr.“"
                                            },
                                            {
                                                "example_id": "55f9997d-649b-4c55-9ac2-b612634f7534",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Die telephonischen Verbindungen zwischen uns und Munau waren seit ein paar Tagen unterbrochen, ohne daß wir wußten, ob der Schneesturm oder der Feind daran schuld war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
