                "senses": [
                    {
                        "sense_id": "68c3c095-33f3-35d7-920e-16ea1148a4c3",
                        "entry_id": "dcff0f0e-7670-3777-86a0-ee1466e10ad8",
                        "glosses": [
                            "Remplacer tout identifiant personnel par des pseudonymes ne permettant pas d’identifier les personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba6ea5d-6b59-4990-98ac-051497958400",
                                "sense_id": "68c3c095-33f3-35d7-920e-16ea1148a4c3",
                                "text": "Autre recommandation de Thierry Dor : « regarder dans quelle mesure vous pouvez anonymiser, pseudonymiser les données.»"
                            },
                            {
                                "example_id": "d1a89261-17cf-4955-8fe9-9ae2e828b339",
                                "sense_id": "68c3c095-33f3-35d7-920e-16ea1148a4c3",
                                "text": "La Commission y détaille deux cas principaux : si les données sont anonymisées à bref délai (dans les minutes suivant leur collecte) et si les données sont immédiatement pseudonymisées puis anonymisées ou détruites au bout de 24h."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c1293ce-22d5-4bb8-944b-858b708edd6b",
                        "source_entry_id": "dcff0f0e-7670-3777-86a0-ee1466e10ad8",
                        "source_sense_id": "68c3c095-33f3-35d7-920e-16ea1148a4c3",
                        "target_lang_word": "pseudonymisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudonymisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77065d0f-ba07-3159-9bf7-b6e2bc774163",
                                        "entry_id": "2522254f-6750-3939-a5c0-10e80f80d9af",
                                        "glosses": [
                                            "mit einem Kennnamen versehen; die Identität verbergen, indem ein anderer Name (ein Pseudonym) oder ein Kennzeichen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd09920-fb75-4f61-bd50-0a7174339e55",
                                                "sense_id": "77065d0f-ba07-3159-9bf7-b6e2bc774163",
                                                "text": "„Die von einer diagnostizierenden Einrichtung übermittelten Daten sind, soweit Satz 3 nicht etwas anderes bestimmt, vor der Speicherung zu pseudonymisieren, sofern und solange nicht eine behandelnde Einrichtung Daten über die betroffene Person und zu der betreffenden Krebserkrankung übermittelt hat.“"
                                            },
                                            {
                                                "example_id": "ad4d7653-2cda-4cc6-b2b6-8cac2e7341f9",
                                                "sense_id": "77065d0f-ba07-3159-9bf7-b6e2bc774163",
                                                "text": "„Wenn ein Vorfall nach Art. 34 (b) auch die privaten Beziehungen oder das Privatleben eines Betroffenen (Kunde, Abonnent) betreffen, so muss der Verantwortliche den Betroffenen benachrichtigen, es sei denn die CNIL stellt fest, dass der Verantwortliche die Daten ausreichend pseudonymisiert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd8ee99e-1266-46e2-9903-e6b679f4c21a",
                        "source_entry_id": "dcff0f0e-7670-3777-86a0-ee1466e10ad8",
                        "source_sense_id": "68c3c095-33f3-35d7-920e-16ea1148a4c3",
