                    {
                        "sense_id": "98cbfe1d-2509-32ec-88df-d145e012fffe",
                        "entry_id": "1ce4607b-5edf-3ad3-b4b7-8988f4a52274",
                        "glosses": [
                            "een vrij fors stuk drukwerk dat op muren of ramen aangebracht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e64a55-cae6-483a-bbd8-c7dd85342c45",
                                "sense_id": "98cbfe1d-2509-32ec-88df-d145e012fffe",
                                "text": "Hij had zijn raam volgeplakt met affiches van alle linkse partijen."
                            },
                            {
                                "example_id": "0075a067-e386-41a3-91a0-d594bcb409ec",
                                "sense_id": "98cbfe1d-2509-32ec-88df-d145e012fffe",
                                "text": "Hij stapte op lijn 11 richting Mairie des Lilas, klapte een stoeltje uit en staarde wezenloos naar een affiche van een Engelse taalschool."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99ff453c-fb4b-4d06-854b-612f6649a40c",
                        "source_entry_id": "1ce4607b-5edf-3ad3-b4b7-8988f4a52274",
                        "source_sense_id": "98cbfe1d-2509-32ec-88df-d145e012fffe",
                        "source_sense_description": "een vrij fors stuk drukwerk dat op muren of ramen aangebracht kan worden",
                        "target_lang_word": "affiche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                        "entry_id": "4bf52bba-c1ed-3dca-a1e8-4c55b8443213",
                                        "glosses": [
                                            "Feuille souple ou rigide affichant un message, ou une image, imprimé ou écrit que l’on applique contre les murs pour donner connaissance au public de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6899807-8146-4403-917d-847eacc90ac7",
                                                "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                                "text": "Elle collectionne aussi toutes les plaques officielles des rues, et à chaque instant un généreux donateur arrive, apportant des panonceaux ou des affiches."
                                            },
                                            {
                                                "example_id": "2375ebb4-c3a8-4621-9197-5cf1a3727249",
                                                "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                                "text": "[…], je lis avec effarement, à plusieurs encoignures, des affiches enluminées […]. « Engagez-vous dans l’armée coloniale ! » s’écrie l’autre, toute enluminée de perroquets, toute rehaussée de nudités affriolantes."
                                            },
                                            {
                                                "example_id": "471ceeb4-6fe2-49e4-8dcb-7e8a3bc7afe3",
                                                "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                                "text": "[…], elle considéra, sans bouger, une affiche qui représentait une gitane devant un paysage andalou."
                                            },
                                            {
                                                "example_id": "a892ec6f-c0df-4e0c-bcb1-94dcdd9ad039",
                                                "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                                            },
                                            {
                                                "example_id": "2b6ff002-2d46-47ba-9647-9e2794ac1200",
                                                "sense_id": "f19bf0a5-163d-3690-aeea-c90d33a1205c",
                                                "text": "Le détournement d’affiche par les militants adverses, le plus souvent par graffiti ou bombage, constitue une pratique aussi ancienne que l’affiche politique elle-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63fc405a-08ac-3348-a4d1-9b7d14f07b3d",
                                        "entry_id": "4bf52bba-c1ed-3dca-a1e8-4c55b8443213",
                                        "glosses": [
                                            "Ensemble des artistes ou spectacles programmés dans un lieu ou lors d’un événement culturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7aedad-254f-4438-98dd-585a69b27be8",
                                                "sense_id": "63fc405a-08ac-3348-a4d1-9b7d14f07b3d",
                                                "text": "La Cantatrice chauve est à l’affiche du théâtre de la Huchette depuis 1957."
                                            },
                                            {
                                                "example_id": "df857f27-5a5a-4acb-819b-bc3369ef0715",
                                                "sense_id": "63fc405a-08ac-3348-a4d1-9b7d14f07b3d",
                                                "text": "Ce festival a une affiche éclectique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a0cd1c-8435-37bd-84c5-d5263c36f6ae",
                                        "entry_id": "4bf52bba-c1ed-3dca-a1e8-4c55b8443213",
                                        "glosses": [
                                            "Action d'afficher (au sens figuré)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f710ea-bc62-4091-8bd4-b700817122be",
                                                "sense_id": "61a0cd1c-8435-37bd-84c5-d5263c36f6ae",
                                                "text": "Il échappe au mépris des autres par l´affiche du mépris qu'il fait de lui-même."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56420c08-bf00-315c-a057-20b07cdc2b64",
                                        "entry_id": "c0319a59-6f7f-3cac-872d-e4c2cef1df30",
                                        "glosses": [
