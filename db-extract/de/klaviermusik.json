                "senses": [
                    {
                        "sense_id": "0df6ae7e-3746-3b12-9687-a33351784814",
                        "entry_id": "8d687bcf-8626-3156-a20d-45b2df202f5e",
                        "glosses": [
                            "Musik, die speziell für Klavier komponiert beziehungsweise nur mit dem Klavier gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f04d9a-ea6e-4c7b-bf6e-a167665c87b4",
                                "sense_id": "0df6ae7e-3746-3b12-9687-a33351784814",
                                "text": "„Bei Klaviermusik hat man das Gefühl, das nachzuvollziehen, was der Komponist getan hat, und darum tritt man bis zu einem gewissen Grad in seinen Geist ein.“"
                            },
                            {
                                "example_id": "20ce421c-f433-4825-b41a-bafe9565c483",
                                "sense_id": "0df6ae7e-3746-3b12-9687-a33351784814",
                                "text": "„Klaviermusik ertönt, wir drehen uns um.“"
                            },
                            {
                                "example_id": "d7ecd7be-fd65-4222-91d8-658a3a20272d",
                                "sense_id": "0df6ae7e-3746-3b12-9687-a33351784814",
                                "text": "„Der Raum war erfüllt von einer dichten Wolke Klaviermusik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
