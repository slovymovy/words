                "senses": [
                    {
                        "sense_id": "f8bb9313-c96c-347e-aa3f-ae85b95e9b15",
                        "entry_id": "48779711-1ec3-342c-9421-395403ed1860",
                        "glosses": [
                            "onderdeel van een rangschikking, rang, groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fb08f4-57ae-4ada-9dea-394adbc0e247",
                                "sense_id": "f8bb9313-c96c-347e-aa3f-ae85b95e9b15",
                                "text": "Nu moet blijken of de aanstormende knapen mannen zijn geworden en de grote mannen grote mannen zijn gebleven. Het is veelzeggend dat Vincenzo Nibali, zonder twijfel behorend tot de laatste categorie, pas hierna bepaalt of hij vol voor het geel in Parijs gaat of dat hij voortaan mikt op ritwinst."
                            },
                            {
                                "example_id": "4c1ceb2c-9d4a-4dfb-bace-4a9650a3eb9b",
                                "sense_id": "f8bb9313-c96c-347e-aa3f-ae85b95e9b15",
                                "text": "Geen enkele stem kon haar kinderen terugbrengen, hoe lief de telefoontjes ook bedoeld waren. Dit gesprek viel echter in een andere categorie."
                            }
                        ]
                    },
