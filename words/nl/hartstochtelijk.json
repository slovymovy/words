    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1afbcb36-34f9-32fb-a695-3d8dce267f5f",
                    "sense_definition": "met een zeer sterk gevoel van liefde, verlangen of enthousiasme",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was meteen <w>hartstochtelijk</w> verliefd op haar prachtige glimlach.",
                            "target_lang_translations": {
                                "en": "He was immediately <w>passionately</w> in love with her beautiful smile."
                            }
                        },
                        {
                            "text": "De jonge muzikant speelt altijd op een <w>hartstochtelijke</w> manier viool.",
                            "target_lang_translations": {
                                "en": "The young musician always plays the violin in a <w>passionate</w> way."
                            }
                        }
                    ],
                    "synonyms": [
