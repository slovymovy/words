                    {
                        "translation_id": "206f01bd-076c-4e23-b56f-15c392670047",
                        "source_entry_id": "b965c090-ed66-3d63-8a2e-6954e6d1521d",
                        "source_sense_id": "f8b39ce1-6792-3f55-bb36-05aa73a15139",
                        "target_lang_word": "Verkehrsunfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkehrsunfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                        "entry_id": "e82b274f-d17e-33c8-bd1b-cd76cf577318",
                                        "glosses": [
                                            "Vorfall im Verkehrsleben, der einen Sachschaden und/oder Personenschaden zur Folge hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c76786-6c85-4884-991f-7f68b5cddca2",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„Urspüngliche Aufgabe der Polizei war der Schutz der Gesellschaft vor Verkehrsunfällen und vor Verbrechen.“"
                                            },
                                            {
                                                "example_id": "ebe1b89f-146b-4f66-bb7c-9bd278f47e3c",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„Ich vermute, dass der eigentliche Grund für die paar Verkehrsunfälle die Blitzer sind, die über die gesamte Route 1 verteilt stehen.“"
                                            },
                                            {
                                                "example_id": "757103c2-9753-45f6-840c-f578f010341a",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„Verunglückten Fußgänger ab 65 Jahren bei Verkehrsunfällen 2017, trugen die Unfallgegner in knapp Dreiviertel der Unfälle die Hauptschuld. Meist waren dies Autofahrer.“"
                                            },
                                            {
                                                "example_id": "752f11af-0710-4123-94e4-16941696e881",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„»Was wir aus den letzten Jahren aber wissen: Es gibt in Deutschland wesentlich mehr Hitzetote als Tote durch Verkehrsunfälle.«“"
                                            },
                                            {
                                                "example_id": "9e5e293d-3cd1-474c-88ba-7c27a00ad140",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "Zur Ermittlung der Ursachen von Verkehrsunfällen können Unfallrekonstruktionsgutachten erstellt werden, die zum Beispiel von den Gerichten zur Ermittlung des Verschuldens oder einer Haftungsquote oder von Autoherstellern zur Verbesserung ihrer Modelle eingeholt werden."
                                            },
                                            {
                                                "example_id": "9a932577-1aea-4820-a35f-d21fa5312be3",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„Auch Wahrnehmungsgenauigkeit und Wahrnehmungsgedächtnis spielen uns manchmal einen Streich: Wir meinen, die Fahrzeuge und Personen, die an einem Verkehrsunfall beteiligt waren, genau gesehen zu haben, geraten aber in Schwierigkeiten, wenn wir sie beschreiben sollen.“"
                                            },
                                            {
                                                "example_id": "f338f18e-be79-490e-8562-6afa2dbc8b56",
                                                "sense_id": "e20f6101-1d85-3ded-a9ec-56b557c477c3",
                                                "text": "„Die Zahl der Verkehrsunfälle auf dem Weg zur Schule ist im ersten Halbjahr 2025 bundesweit um rund fünf Prozent gestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72669748-0e3c-3b97-a513-e904dd7c9204",
                                        "entry_id": "e82b274f-d17e-33c8-bd1b-cd76cf577318",
                                        "glosses": [
                                            "ungewollte Schwangerschaft, Verhütungspanne"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee1f5f9-50c9-4be0-8cbb-8ebd1ac6d0c9",
                                                "sense_id": "72669748-0e3c-3b97-a513-e904dd7c9204",
                                                "text": "Meine Schwangerschaft war ein Verkehrsunfall."
                                            },
                                            {
                                                "example_id": "bec3f177-e9f2-410c-842f-519c7652179a",
                                                "sense_id": "72669748-0e3c-3b97-a513-e904dd7c9204",
                                                "text": "„Es gibt Möglichkeiten, eine unerwünschte Schwangerschaft im Nachhinein zu verhindern, wenn Sie ungeschützten Verkehr oder einen \"Verkehrsunfall\" hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
