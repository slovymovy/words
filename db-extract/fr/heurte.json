                                    },
                                    {
                                        "sense_id": "b3212eb9-cb7c-3605-9e45-c5864189db5d",
                                        "entry_id": "71698a79-f477-3c53-9e6a-34b402b1eb12",
                                        "glosses": [
                                            "To cause (somebody) emotional pain."
