                                        "glosses": [
                                            "Fachfrau, die sich beruflich mit der Herstellung, Reparatur und dem Verkauf optischer Geräte beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb9dab5-06d0-449d-bc4a-87dad1a8ca87",
                                                "sense_id": "54acb6ae-4353-3067-b9df-bcdf452d9d80",
                                                "text": "Da sollten Sie zur Optikerin Ihres Vertrauens gehen und sich beraten lassen."
