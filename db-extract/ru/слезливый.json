                                    {
                                        "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Accompanied by tears; crying, or about to cry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4762eb59-7d71-4afb-9084-6892ce470b15",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "Aaron got a little tearful until Laura came to reassure him."
                                            },
                                            {
                                                "example_id": "8a6bb657-913f-4e86-b124-097d17089f7f",
                                                "sense_id": "fe499b1b-0d3c-36f2-86d8-fd6b05178f6b",
                                                "text": "The week that was yet to elapse, she spent in wandering through her uncle's favourite walks in hours of tearful vigil, beside his tomb, and in collecting together every trifle on which he had set a value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                        "entry_id": "a1468301-e974-3048-8a1a-ae0a57df1f45",
                                        "glosses": [
                                            "Sorrowful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83d4fa2-464a-4690-b443-ec5460465a6f",
                                                "sense_id": "4aba2a0d-5afd-349e-ae09-04f78d4e402a",
                                                "text": "Receiving the news of Joseph Beam's death two days after Christmas was a piercing blow that sent me into a tearful and contemplative stupor from which I have not yet emerged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b911dae5-7612-4566-8b37-b178e9a850ec",
                        "source_entry_id": "162815d0-2c41-3682-9bab-817fc4cabdbe",
                        "target_lang_word": "lachrymose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
