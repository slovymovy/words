                        "glosses": [
                            "współistnienie (zwierząt, kultur, ludzi, grup społecznych itp.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0724d90b-2f9d-4469-8db9-6bc1a066b62c",
                                "sense_id": "ff0b0b50-b46f-35bf-8304-17052c2b4052",
                                "text": "Od dobrej koegzystencji tak licznych i odmiennych religijnie, językowo, obyczajowo i prawnie społeczności zależało powodzenie w funkcjonowaniu państwa"
