                "senses": [
                    {
                        "sense_id": "2f36e611-60d7-3a9b-ae54-bac18d16aec6",
                        "entry_id": "bd477bfd-c6b5-3d32-919c-9b8ab91a0414",
                        "glosses": [
                            "To die."
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "49e8bd24-e7f3-3e96-a040-d47e50582f5d",
                        "entry_id": "bd477bfd-c6b5-3d32-919c-9b8ab91a0414",
                        "glosses": [
                            "To succumb or be overcome with emotion, heat, etc.; to faint or swelter"
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "83dc0d29-1a6d-43e2-b956-787474b19651",
                                "sense_id": "49e8bd24-e7f3-3e96-a040-d47e50582f5d",
                                "text": "Immediatly in smoldering heate of Love the t'one did swelt,"
                            },
                            {
                                "example_id": "cc5f6dff-14f1-448c-aa38-a0b5f1ccc425",
                                "sense_id": "49e8bd24-e7f3-3e96-a040-d47e50582f5d",
                                "text": "Thine Israel, o God, had never endured so hard a bondage under Pharaoh, as to be over-swelted in the Egyptian furnaces"
                            },
                            {
                                "example_id": "45ec798f-1ee4-470d-9a2e-1eaa9dea6f2c",
                                "sense_id": "49e8bd24-e7f3-3e96-a040-d47e50582f5d",
                                "text": "Her deare hart nigh swelt, And eft gan into tender teares to melt."
                            }
                        ]
                    }
                ],
