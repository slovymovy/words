{
    "word_family": [
        "insensibilité",
        "insensiblement",
        "insensibiliser",
        "insensibilisation",
        "sensible",
        "sensibilité",
        "sensiblement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e15fe5e-b0d5-3871-8185-506defb48f84",
                    "sense_definition": "Qui n'éprouve pas d'émotions, qui reste indifférent ou dépourvu de compassion envers autrui ou face aux événements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté totalement <w>insensible</w> à la détresse de ses voisins."
                        },
                        {
                            "text": "Elle n'est pas <w>insensible</w> au charme de cette vieille bâtisse en pierre."
                        }
                    ],
                    "antonyms": [
                        "sensible"
                    ],
                    "common_phrases": [
                        "rester insensible",
                        "insensible aux louanges",
                        "cœur insensible"
                    ]
                },
                {
                    "sense_id": "c8cb6fae-0c33-3f42-9886-a0d714b5269c",
                    "sense_definition": "Qui est privé de sensation physique ou qui ne ressent pas la douleur corporelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'anesthésie locale, sa gencive est devenue complètement <w>insensible</w> pendant plusieurs heures."
                        },
                        {
                            "text": "À cause du froid extrême, ses doigts étaient devenus <w>insensibles</w>."
                        }
                    ],
                    "antonyms": [
                        "sensible"
                    ],
                    "common_phrases": [
                        "rendre insensible"
                    ]
                },
                {
                    "sense_id": "0b40acb7-63b3-3419-91d3-1443ffd446a1",
                    "sense_definition": "Qui est si faible, discret ou progressif qu'on ne peut guère le percevoir par les sens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mouvement de l'aiguille des heures est <w>insensible</w> : on ne la voit pas avancer."
                        },
                        {
                            "text": "Cette pente presque <w>insensible</w> facilite la marche des randonneurs."
                        }
                    ],
                    "synonyms": [
                        "imperceptible"
                    ],
                    "antonyms": [
                        "sensible"
                    ],
                    "common_phrases": [
                        "pente insensible",
                        "changement insensible"
                    ]
                }
            ]
        }
    ]
}