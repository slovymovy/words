                "senses": [
                    {
                        "sense_id": "7443f2fb-3890-3149-982b-38ba3fcfa864",
                        "entry_id": "3c023995-3ec9-3025-a593-4bcb03fc3117",
                        "glosses": [
                            "midnight mass or early morning mass (at Christmas and Easter)"
                        ],
                        "tags": [
                            "Westphalia",
                            "feminine",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "46270c8d-c047-49a1-918c-bcb9935d02d6",
                                "sense_id": "7443f2fb-3890-3149-982b-38ba3fcfa864",
                                "text": "2013, Verena Hellenthal, Weihnachten im Münsterland, Sutton Verlag, 93.\nHöhepunkt dieses Festes war die Uchte, die Messe, welche in der Nacht vom 24. auf den 25. Dezember stattfand. Meist fand diese Uchte zwischen drei und fünf Uhr morgens statt.",
                                "translation": "The culmination of this feast was the nocturnal mass, the mass that was held during the night of December 24th to 25th. Most often this nocturnal mass took place between three and five o'clock in the morning.",
                                "english": "The culmination of this feast was the nocturnal mass, the mass that was held during the night of December 24th to 25th. Most often this nocturnal mass took place between three and five o'clock in the morning."
                            },
                            {
                                "example_id": "0b65061f-2233-4a41-a538-e3b7252d2010",
                                "sense_id": "7443f2fb-3890-3149-982b-38ba3fcfa864",
                                "text": "Nach der Bescherung essen wir, dann spielen wir Karten, und dann gehen wir in die Uchte.",
                                "translation": "After opening the presents we have dinner, then we play cards, and then we go to midnight mass.",
                                "english": "After opening the presents we have dinner, then we play cards, and then we go to midnight mass."
                            }
                        ]
                    }
