                                                "example_id": "a7666f44-9c58-4be4-9cfb-43eb9757ad09",
                                                "sense_id": "6413e7bb-978a-313d-800f-789fc504142c",
                                                "text": "L'ajout d’huile parafinique ou de mouillant au bentazon, au bromophénoxime et à l’ioxynil diminue la sélectivité de ces produits surtout celle de l’ioxynil et est de ce fait déconseillé."
                                            },
                                            {
                                                "example_id": "204dd6b0-ea3f-4f61-9151-19aa9d3f00dc",
                                                "sense_id": "6413e7bb-978a-313d-800f-789fc504142c",
                                                "text": "« Les poissons crus et les fruits de mer crus sont déconseillés chez la femme enceinte », ajoute le Dʳ Plumey."
                                            },
                                            {
                                                "example_id": "a2393d7c-3150-436b-9dcf-3b09d7986d6c",
                                                "sense_id": "6413e7bb-978a-313d-800f-789fc504142c",
                                                "text": "La Haute Autorité de Santé (HAS) en France a déconseillé le vaccin Moderna pour les hommes de moins de 30 ans, en raison d’un risque mineur de myocardite ou péricardite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c57f7c8-2be4-4843-b8a5-d2543145ab9d",
                        "source_entry_id": "a5978b9d-7f31-324d-a097-15c0f7109957",
                        "source_sense_description": "уговорить кого-либо отменить намерение",
                        "target_lang_word": "décourager",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décourager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                        "entry_id": "493e0615-a20a-349d-8198-42a449ca241b",
                                        "glosses": [
                                            "Dépourvoir de courage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e615d1-def0-4ed4-b853-38562b1b8049",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Mais il ne se laissa pas décourager : si tous les bras retombaient impuissants devant l'œuvre à accomplir, si personne ne donnait le bon exemple, le mal triompherait toujours, incurable."
                                            },
                                            {
                                                "example_id": "74f7896f-1c04-48da-89cf-b93f1f038fe1",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Celui-là est défendu contre les quémandeurs trop opiniâtres par une sorte de femelle revêche, bourrue, grimaçante, qui s'entend à merveille à décourager les volontés les plus obstinées."
                                            },
                                            {
                                                "example_id": "20120d3b-cd84-46df-a57b-a4a2b03f5641",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Devant la réprobation presque unanime qui accueillit mon exposé, je me décourageai et me ralliai à l'interprétation probabiliste de Born, Bohr et Heisenberg […]."
                                            },
                                            {
                                                "example_id": "922f8872-4e9c-4c1d-9f6b-e59c43a60a56",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Seul, malade, et décourageant de moi comme j’avais le secret — et le talent — de le faire, je trouvais enfin l’extrême, vers où je tendais aveuglément."
                                            },
                                            {
                                                "example_id": "301b0ce8-cad9-4e0c-b868-429109201403",
                                                "sense_id": "883963af-c01d-3ac9-9611-a4ae7d21fd9d",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3098472d-5378-4d7b-bd01-666cf1d4be85",
                        "source_entry_id": "a5978b9d-7f31-324d-a097-15c0f7109957",
                        "source_sense_description": "перестать говорить; замолчать",
                        "target_lang_word": "se taire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se taire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                        "entry_id": "934abda3-fc1d-366c-aa0c-8cbb8f070795",
                                        "glosses": [
                                            "Garder le silence ; s’abstenir de parler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb996e08-5915-4701-a048-6b8e6ecd227b",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "Cette terrible histoire des Vaudois, dois-je en parler ou m’en taire ? En parler ? Elle est trop cruelle ; personne ne la racontera sans que la plume n'hésite, et que l'encre, en écrivant, ne blanchisse de larmes."
                                            },
                                            {
                                                "example_id": "5650621f-6900-464f-aecc-990260c01293",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "– Je suis citoyen britannique ! – continua Bert, obstiné. – Vous n’êtes pas obligés d’écouter, mais rien ne me force à me taire."
                                            },
                                            {
                                                "example_id": "7024e245-4af3-46f1-9f7c-27edfe1dcf83",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "Il se lève, en proie à une grande agitation, va fermer la porte de la chambre de sa femme puis se tait : il se tait activement, en dévorant une foule de paroles, les unes chevauchant les autres."
                                            },
                                            {
                                                "example_id": "322bc116-2d58-4295-ab51-242ef636978c",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "bdb0286b-6f1e-40e6-b740-67731ebbe453",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "Même les hirondelles s’étaient tues, et seul le bruissement du vent dans les feuilles et le craquettement de la cigale donnaient un peu de répit au silence étouffant d'un soir d'été."
                                            },
                                            {
                                                "example_id": "215252bb-2b98-4936-9571-9f3eb7a02196",
                                                "sense_id": "453b51b1-aa2d-3aad-b616-ac91056d2428",
                                                "text": "Il a manqué une belle occasion de se taire, il a parlé mal à propos, il s’est fait du tort en parlant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3bb9f7c-8767-3a6c-8993-5ea82f216210",
                                        "entry_id": "934abda3-fc1d-366c-aa0c-8cbb8f070795",
                                        "glosses": [
                                            "Ne pas divulguer un secret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d9d820-dc32-4b12-b78f-e62a743858b3",
                                                "sense_id": "e3bb9f7c-8767-3a6c-8993-5ea82f216210",
                                                "text": "Ne pouvoir se taire d’une chose, la publier partout, en parler sans cesse."
                                            },
                                            {
                                                "example_id": "0cb3a94c-3fc1-4287-b50d-97a8be0739fc",
                                                "sense_id": "e3bb9f7c-8767-3a6c-8993-5ea82f216210",
                                                "text": "Il ne peut se taire sur le service, du service que vous lui avez rendu."
                                            },
                                            {
                                                "example_id": "98c20d7f-a91a-42ef-88b9-f3b273b33fe7",
                                                "sense_id": "e3bb9f7c-8767-3a6c-8993-5ea82f216210",
                                                "text": "En de telles circonstances, tous les ressentiments doivent se taire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
