                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "488b5d4b-5868-39cf-9061-d2f3411e1e28",
                                        "entry_id": "47ecca00-726f-333a-80d6-68ccbb65bd5b",
                                        "glosses": [
                                            "Espèce de grands crocodiles (Crocodylus porosus) vivant en Asie du Sud, en Asie du Sud-Est et en Océanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280e5f86-cc7d-4562-87c1-26c09bb7370e",
                                                "sense_id": "488b5d4b-5868-39cf-9061-d2f3411e1e28",
                                                "text": "C’est probablement le plus gros crocodile marin jamais capturé. Samedi, aux Philippines, des dizaines d'autochtones sont parvenus à capturer un spécimen de 6,40 mètres et pesant près de 1.075 kilogrammes qui hantaient les eaux dans la région du village de Bunawan, dans le sud de l’archipel."
                                            },
                                            {
                                                "example_id": "4658d926-f0a0-4181-b8c2-1b74f5afb45b",
                                                "sense_id": "488b5d4b-5868-39cf-9061-d2f3411e1e28",
                                                "text": "Le gigantesque crocodile marin possède une diète variée qui inclut souvent de grosses proies comme les buffles, les sangliers, les singes et... les humains !"
                                            },
                                            {
                                                "example_id": "5f0398e0-4033-43bf-b556-772780cc05ce",
                                                "sense_id": "488b5d4b-5868-39cf-9061-d2f3411e1e28",
                                                "text": "Les articles de grande taille sont rares mais en 1967 un bar portatif recouvert en peau de crocodile marin s’est vendu à Paris 7 500 dollars E.-U, prix qui serait bien plus élevé aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
