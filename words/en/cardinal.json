                                "target_lang_sense_clarification": "название цвета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深红色",
                                "target_lang_sense_clarification": "一种深而鲜明的红色"
                            },
                            {
                                "target_lang_word": "绛红色",
                                "target_lang_sense_clarification": "偏鲜亮的深红"
                            }
                        ]
