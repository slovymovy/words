                                                "sense_id": "ee6cc33f-4a42-3e89-9f7c-a0f39e8a9f16",
                                                "text": "„Zu den Morbilliviren gehören auch die Erreger der Staupe und der Rinderpest sowie das menschliche Masernvirus.“"
                                            },
                                            {
                                                "example_id": "eba14c13-c822-4e63-aedd-0c3c3eb81eaf",
                                                "sense_id": "ee6cc33f-4a42-3e89-9f7c-a0f39e8a9f16",
                                                "text": "„Als 1897 die Rinderpest ausbrach und 95 Prozent der Herden verendeten, geriet das traditionelle Gefüge endgültig aus den Fugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
