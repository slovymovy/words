                "senses": [
                    {
                        "sense_id": "8d04de6f-56e7-3d97-ab90-fd54b76849c4",
                        "entry_id": "d4587584-6522-3498-8c3f-a13b19229146",
                        "glosses": [
                            "Sorte de tondeuse à gazon automotrice, sur lequel l'on peut s’asseoir pour tondre la pelouse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5a4a3fd9-9db8-4b03-82bd-6bfd56eb43bc",
                                "sense_id": "8d04de6f-56e7-3d97-ab90-fd54b76849c4",
                                "text": "Intriguée, elle se posta à la fenêtre, pour découvrir un homme aux cheveux grisonnants en train de tondre la pelouse, installé sur le vieux tracteur-tondeuse de son grand-père. Elle sortit dans le jardin comme une flèche."
                            },
                            {
                                "example_id": "d24f4021-d811-4f43-a68f-e89c928e4201",
                                "sense_id": "8d04de6f-56e7-3d97-ab90-fd54b76849c4",
                                "text": "L’éco-pâturage consiste à remplacer les tracteurs-tondeuses par des moutons ou d'autres herbivores."
                            },
                            {
                                "example_id": "410ee157-0cd2-41a3-90c7-431ce3300e1f",
                                "sense_id": "8d04de6f-56e7-3d97-ab90-fd54b76849c4",
                                "text": "La fête de la saint Léger s'est déroulée à partir du samedi, avec un beau soleil, pour accueillir la première course de tracteurs-tondeuses, avec une dizaine de participants."
                            }
                        ]
                    }
                ],
