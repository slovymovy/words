                        "glosses": [
                            "iemand die een eerder genomen besluit betreurt en de gevolgen ongedaan zou willen maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c58762-fba0-4a40-bb67-23e1353327b6",
                                "sense_id": "5469150b-4b94-3aea-abd0-0c0581bdbaf7",
                                "text": "De spijtoptant van de DSB Bank had het erg druk de laatste weken."
                            },
                            {
                                "example_id": "26d1b9be-5220-497c-b29f-dfecfcc95493",
                                "sense_id": "5469150b-4b94-3aea-abd0-0c0581bdbaf7",
                                "text": "Ook nu betreuren hoge spijtoptanten in Oekraïne het Memorandum van Boedapest uit 1994, waarbij Oekraïne zijn kernraketten inruilde voor (achteraf) waardeloze veiligheidsgaranties"
                            }
                        ]
                    },
                    {
                        "sense_id": "5116599d-c62d-36a5-8c9b-4e3e7c0a3630",
                        "entry_id": "2c0c1c96-90a3-3a7d-a214-9a6e732e4ff7",
                        "glosses": [
                            "iemand die na de soevereiniteitsoverdracht aan Indonesië tegen wil en dank de Indonesische nationaliteit gekregen had en liever de Nederlandse terugkreeg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33efaef-afaf-46a2-ba41-628a82a284df",
                                "sense_id": "5116599d-c62d-36a5-8c9b-4e3e7c0a3630",
                                "text": "Ook de jongvolwassen of adolescente kinderen van ouders die voor het warga negaraschap opteerden en tegen wil en dank automatisch Indonesiër waren geworden, telden een aanzienlijk aantal spijtoptanten."
                            }
                        ]
