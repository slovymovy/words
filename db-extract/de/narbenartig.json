                ],
                "senses": [
                    {
                        "sense_id": "c294a877-77fd-3c69-b30c-7224a826da87",
                        "entry_id": "2b81d0af-882b-3834-8333-3655e43d6941",
                        "glosses": [
                            "einer Narbe ähnelnd, an eine Narbe erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbbc295-1736-41c1-957c-0b070686b3ab",
                                "sense_id": "c294a877-77fd-3c69-b30c-7224a826da87",
                                "text": "„In allen Stadien von Fäulnis und abstoßender Verwesung setzten sie sich mit einer abscheulichen Zielstrebigkeit in Bewegung, die ihnen von hohen, entsetzlichen Wesen eingegeben wurde, die diese verrotteten Gebeine auferstehen und helle, lebendige Leiber bleich zu Boden sinken lassen konnten, wo sie die grüne Metamorphose des Grabes erwartete, und aus ihrem festen Fleisch kamen Abertausende Köpfe, und die weißen gefräßigen Würmer brachen daraus hervor und ließen kleine narbenartige Löcher zurück.“"
                            },
                            {
                                "example_id": "e34d4b9f-bc2f-419a-b856-10ee0e81a1fc",
                                "sense_id": "c294a877-77fd-3c69-b30c-7224a826da87",
                                "text": "„In seinem Nacken sah man eine narbenartige Lücke zwischen sonnenverbrannter Haut und Haaransatz, als er zur Bar hinüberging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
