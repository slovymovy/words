                            {
                                "example_id": "fcce7a6b-3697-48fa-908b-dc7d673620df",
                                "sense_id": "726e7fc0-c10e-34aa-ba52-ede9f3775fb6",
                                "text": "Als je zó hard rijdt, is je remafstand erg groot."
