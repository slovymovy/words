                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84ee72b8-d98b-4bdd-8c80-653f06835a81",
                        "entry_id": "40734d53-ea46-38a1-86d2-f67a4a95bb94",
                        "tags": [
                            "plural"
                        ],
                        "form": "rifles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7a92e16-96a6-3aea-814e-aca3a5505eae",
                        "entry_id": "40734d53-ea46-38a1-86d2-f67a4a95bb94",
                        "glosses": [
                            "Fusil."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "14a94da8-771e-41b8-b040-d0e450c44b3d",
                                "sense_id": "d7a92e16-96a6-3aea-814e-aca3a5505eae",
                                "text": "Carabine vingt-deux long rifle : Carabine de chasse ou de sport de calibre de vingt-deux centièmes de pouce (soit cinq millimètres cinquante huit)."
                            },
                            {
                                "example_id": "1fd60744-3437-4bb4-9756-8188b7425075",
                                "sense_id": "d7a92e16-96a6-3aea-814e-aca3a5505eae",
                                "text": "Le chasseur voulait davantage sans doute, car sa main tourmentait fébrilement la batterie de son rifle, un excellent Manton, arme de précision, à balle conique, qui permettait d’abattre un chat sauvage ou une antilope à une distance de huit à neuf cents yards."
                            },
                            {
                                "example_id": "88cd2c9f-50a3-467e-adf1-24633947fd49",
                                "sense_id": "d7a92e16-96a6-3aea-814e-aca3a5505eae",
                                "text": "Aussi, Blancs, Indiens ou demi-sang, lorsqu’ils se rencontrent dans la prairie, se saluent-ils toujours, l’œil au guet, les oreilles tendues et le doigt sur la détente de leur rifle."
                            },
                            {
                                "example_id": "f42ebf9a-36a2-49e2-913f-3e32fe90800c",
                                "sense_id": "d7a92e16-96a6-3aea-814e-aca3a5505eae",
                                "text": "On aurait dit d’honnêtes chasseurs de grives, s’ils n’avaient pas eu en bandoulière le rifle de guerre et à la ceinture la baïonnette."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf567be3-5e31-3896-8c98-5697372f623f",
                        "entry_id": "40734d53-ea46-38a1-86d2-f67a4a95bb94",
                        "glosses": [
                            "Tireur à ce fusil."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "0051b97d-30ff-499b-89ca-abdcf78e22a8",
                                "sense_id": "cf567be3-5e31-3896-8c98-5697372f623f",
                                "text": "Vous parlez ici au milieu des cent cinquante meilleurs rifles de la prairie, de ce projet odieux, avec autant de confiance que si vous étiez en sûreté au milieu de vos bandits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b46177fa-c616-404c-bcbd-f404a2e66dd4",
                        "source_entry_id": "40734d53-ea46-38a1-86d2-f67a4a95bb94",
                        "target_lang_word": "rifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5404f0d0-a7aa-3a8f-9951-912817ca55e6",
                                        "entry_id": "ee56181e-c0ac-3e1b-8ca0-1ca84f5644bd",
                                        "glosses": [
                                            "A firearm fired from the shoulder; improved range and accuracy is provided by a long, rifled barrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7516df78-5bd8-44e1-b8c2-7d49591eb81a",
                                                "sense_id": "5404f0d0-a7aa-3a8f-9951-912817ca55e6",
                                                "text": "Still, a dozen men with rifles, and cartridges to match, stayed behind when they filed through a white aldea lying silent amid the cane, and the Sin Verguenza swung into slightly quicker stride."
                                            },
                                            {
                                                "example_id": "46c3bcd4-d97a-43f5-8ff5-93a1392c77f0",
                                                "sense_id": "5404f0d0-a7aa-3a8f-9951-912817ca55e6",
                                                "text": "In the June days of 1848 Baudelaire reports seeing revolutionaries (he might have been one of them) going through the streets of Paris with rifles, shooting all the clocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d23ae5-2d58-3091-9d3e-ba0f4d860f73",
                                        "entry_id": "ee56181e-c0ac-3e1b-8ca0-1ca84f5644bd",
                                        "glosses": [
                                            "A rifleman."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53999bd0-bb1b-3b01-ba85-29276900ab34",
                                        "entry_id": "ee56181e-c0ac-3e1b-8ca0-1ca84f5644bd",
                                        "glosses": [
                                            "An artillery piece with a rifled barrel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e15093a-53b1-3389-abdf-18e877d89c6e",
                                        "entry_id": "ee56181e-c0ac-3e1b-8ca0-1ca84f5644bd",
                                        "glosses": [
                                            "A strip of wood covered with emery or a similar material, used for sharpening scythes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4f6ec9-bcd5-3106-88e8-872d94ffc932",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To quickly search through many items (such as papers, the contents of a drawer, a pile of clothing). (See also riffle)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c242069c-3f6e-40c1-bf03-d07dbc99f894",
                                                "sense_id": "6a4f6ec9-bcd5-3106-88e8-872d94ffc932",
                                                "text": "She made a mess when she rifled through the stack of papers, looking for the title document."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcbdf547-940d-3402-bbbe-4c83d8f2f00a",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To commit robbery or theft."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d702bdd-d2fe-412b-aea4-948decd469c4",
                                                "sense_id": "fcbdf547-940d-3402-bbbe-4c83d8f2f00a",
                                                "text": "Thither repair at accustomed times their harlots […] not with empty hands, for they be as skilful in picking, rifling, and filching as the upright men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceaae270-6b37-3f6a-a779-66c9b43ae4ba",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To search with intent to steal; to ransack, pillage or plunder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fd3fe5b-1caa-4c6b-a372-cbf27990c932",
                                                "sense_id": "ceaae270-6b37-3f6a-a779-66c9b43ae4ba",
                                                "text": "thine enemies […]shall ransack and rifle all the things of Edom; and shall search out all thy hidden commodities, and carry them away at once"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e087c5a-7361-3229-aa2a-e1462a6d8af4",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To strip of goods; to rob; to pillage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfde3b49-02ae-44f1-94f9-1e8faa48d3c2",
                                                "sense_id": "1e087c5a-7361-3229-aa2a-e1462a6d8af4",
                                                "text": "Stand, sir, and throw us that you have about ye: / If not, we'll make you sit and rifle you."
                                            },
                                            {
                                                "example_id": "24f799f8-e454-4ed1-93c5-c082282de35f",
                                                "sense_id": "1e087c5a-7361-3229-aa2a-e1462a6d8af4",
                                                "text": "Ben, in his long, lonely wanderings about the island, had found the skeleton — it was he that had rifled it; he had found the treasure; he had dug it up […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de839889-06e5-3145-b829-28c9da672693",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To seize and bear away by force; to snatch away; to carry off."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08c2787-8c91-44a5-bec2-cc5dfacced25",
                                                "sense_id": "de839889-06e5-3145-b829-28c9da672693",
                                                "text": "Time shall rifle every youthful grace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0200c239-a93d-32b5-8795-df4575640b5b",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To add a spiral groove to a gun bore to make a fired bullet spin in flight in order to improve range and accuracy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3d28c2e-67d4-3bbb-9700-5267e84a3af1",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To cause (a projectile, as a rifle bullet) to travel in a flat ballistic trajectory."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c1d324-9f1e-4a46-b38d-b5d9f68fc8fd",
                                                "sense_id": "a3d28c2e-67d4-3bbb-9700-5267e84a3af1",
                                                "text": "Davies's cross was headed away from danger by Robert Huth, only for Baird to take the ball in his stride and rifle his right-footed effort towards the corner from the edge of the box."
                                            },
                                            {
                                                "example_id": "fdbb57a8-c167-4ec4-b482-f15f11193a35",
                                                "sense_id": "a3d28c2e-67d4-3bbb-9700-5267e84a3af1",
                                                "text": "2011 Fighting for Gold: The Story of Canada's Sledge Hockey Paralympic Gold by Lorna Schultz Schultz Nicholson\nBut a Norwegian player rifled off a point shot that sailed into the back of the net."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4528b0c9-83ce-32c3-b674-e254edc0b1c1",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To move in a flat ballistic trajectory (as a rifle bullet)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd713f04-8f13-4a20-986f-686458ff63ba",
                                                "sense_id": "4528b0c9-83ce-32c3-b674-e254edc0b1c1",
                                                "text": "The ball rifled off the bat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85812285-8434-377a-ae05-06a2f3fcc568",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To dispose of in a raffle."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b9383d-2d05-446b-bcba-ea30c32eca44",
                                                "sense_id": "85812285-8434-377a-ae05-06a2f3fcc568",
                                                "text": "I've at one throw / Rifled away the diadem of Spain; […]"
                                            },
                                            {
                                                "example_id": "d32b1bc6-e02d-4a6d-b1ec-6dd58fbe0523",
                                                "sense_id": "85812285-8434-377a-ae05-06a2f3fcc568",
                                                "text": "If you like not that course but intend to be rid of her , rifle her at a tavern , where you may swallow down some fifty wiseacres ' sons and heirs to old tenements and common gardens , like so many raw yolks with muscadine to bedward Kate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9927ad9a-4988-3212-a7dc-9bedfc6e7b03",
                                        "entry_id": "ced83380-34e3-35c8-8c81-8acb1ff2c8be",
                                        "glosses": [
                                            "To engage in a raffle."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f484f32-da57-40aa-b150-07e588f102c3",
                                                "sense_id": "9927ad9a-4988-3212-a7dc-9bedfc6e7b03",
                                                "text": "We'll strike up a drum, set up a tent, call people together, put crowns apiece, let's rifle for her"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
