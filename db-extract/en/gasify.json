                                    {
                                        "sense_id": "a01abe55-4c0f-3e1a-8e21-e4263f5ca625",
                                        "entry_id": "8761876f-bac6-37d3-970b-d7b738fcc63c",
                                        "glosses": [
                                            "Faire passer à l’état de gaz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6513a2a3-f1a0-48c7-87f4-8f469dae66d1",
                                                "sense_id": "a01abe55-4c0f-3e1a-8e21-e4263f5ca625",
                                                "text": "La méthode indirecte consiste à gazéifier le charbon, ce qui produit un gaz synthétique appelé syngas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f6df9f-b287-3744-ba08-b1951ed7826d",
                                        "entry_id": "8761876f-bac6-37d3-970b-d7b738fcc63c",
                                        "glosses": [
                                            "Ajouter du gaz carbonique dans (de l’eau ou un liquide)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ced605-c1ec-4b5c-a348-45b07f4cc3a8",
                                                "sense_id": "09f6df9f-b287-3744-ba08-b1951ed7826d",
                                                "text": "L’acide carbonique étant un excitant spécial des organes digestifs, qui fait mieux tolérer cette eau à l’intérieur ; on a commencé d’en gazéfier à l’établissement, pour la boire sous forme d’eau de Selz ou de limonade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68b649c-ab4e-3148-bdd1-897d6e7b2fef",
                                        "entry_id": "8761876f-bac6-37d3-970b-d7b738fcc63c",
                                        "glosses": [
                                            "Développer les infrastructures de distribution du gaz dans une zone afin de pouvoir utiliser cette ressource comme énergie."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0ffcfd-11ff-4be9-ae8f-b58c146c9c8a",
                                                "sense_id": "b68b649c-ab4e-3148-bdd1-897d6e7b2fef",
                                                "text": "« L’objectif est de connecter l’infrastructure de transport de gaz de l’ouest et de l’est de la Russie, de gazéifier la Sibérie orientale », a-t-il déclaré, sans donner davantage d’informations sur le calendrier du projet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
