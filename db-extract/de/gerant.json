                "senses": [
                    {
                        "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                        "entry_id": "1e242bad-1340-33f4-a916-217af3663e8a",
                        "glosses": [
                            "Geschäftsführer eines Gastrounternehmens"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "4e651406-1a86-4973-8e74-a9b91bfb7177",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Gesucht Stelle als Gerant […] in alkoholfreiem Betrieb der Stadt Bern.“"
                            },
                            {
                                "example_id": "10754d1a-cd69-488f-82ef-4122a1fc3f68",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Grösseres Gewicht haben […] der Hinweis Oettlis auf das nach seiner Darstellung von ihm am Tage der II. Gläubigerversammlung (31. August 1970) dem Konkursverwalter unterbreitete Angebot, das Hotel auf den 1. Dezember 1970 zu einem angemessenen Zins zu pachten und durch einen Geranten auf eigene Rechnung betreiben zu lassen.“"
                            },
                            {
                                "example_id": "6635e2cf-0b15-46f0-87c3-f59574ceeb45",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Seit dem neuen Jahr sind Petra Stieger und Marcel Meyer Geranten des Restaurants Rosengarten in Widnau. Die bisherige Wirtin Erika Schwinger zieht sich nach und nach aus dem Geschäft zurück.“"
                            },
                            {
                                "example_id": "2f3b2276-23c7-4374-9de8-5d94a5ff80bb",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Ab dieser Sommersaison führen die Geranten Katrin Iten und Dawid Janik zusammen mit ihrem Team das Berggasthaus Prodkamm und kümmern sich mit viel Leidenschaft um die Bedürfnisse der Gäste.“"
                            },
                            {
                                "example_id": "c812bab9-fa33-40f7-b68b-5361ca469f5d",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Die Nachfolge ist geregelt – das Hotel Rischli wird mit neuen Geranten weitergeführt.“"
                            },
                            {
                                "example_id": "e210fee9-2ced-4aa0-85ae-940ddd9894f8",
                                "sense_id": "2771db2c-e7a8-3705-a832-6dc27f845b58",
                                "text": "„Nach dreissig Jahren wechseln die Geranten und seitdem führt das Ehepaar Vögeli unter dem neuen Namen Grischalodge das Haus mit Umsicht und grossem Engagement.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
