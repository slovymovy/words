    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3861ec4-c468-3ba8-af71-ff5e4a670dc9",
                    "sense_definition": "met een rasp voedsel of materiaal in kleine stukjes verdelen of afvijlen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet eerst de kaas <w>raspen</w> voordat je deze over de pasta strooit.",
                            "target_lang_translations": {
                                "en": "You must first <w>grate</w> the cheese before you sprinkle it over the pasta."
                            }
                        },
                        {
                            "text": "Voor dit recept moet je verse wortels <w>raspen</w> voor een fijne structuur.",
                            "target_lang_translations": {
                                "en": "For this recipe, you need to <w>grate</w> fresh carrots for a fine texture."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaven",
                        "fijnmaken"
                    ],
                    "common_phrases": [
                        "kaas raspen",
                        "wortels raspen"
                    ],
                    "target_lang_definitions": {
                        "en": "to divide or file down food or material into small pieces using a grater"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "to shred food using a grater"
                            },
                            {
                                "target_lang_word": "shred",
                                "target_lang_sense_clarification": "to cut or tear into long, narrow strips"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5f7505-0a3c-3b47-9116-e02a7e666767",
                    "sense_definition": "iets met kracht over een ruw oppervlak wrijven om het glad te maken of te verwijderen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman begon het ruwe hout te <w>raspen</w> om de randen gladder te maken.",
                            "target_lang_translations": {
                                "en": "The carpenter began to <w>rasp</w> the rough wood to make the edges smoother."
                            }
                        },
                        {
                            "text": "Hij moest de oude verflaag van de muur <w>raspen</w> voor hij opnieuw kon schilderen.",
                            "target_lang_translations": {
                                "en": "He had to <w>scrape</w> the old layer of paint off the wall before he could paint again."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuren",
                        "vijlen"
                    ],
                    "common_phrases": [
                        "hout raspen"
                    ],
                    "target_lang_definitions": {
                        "en": "to rub something with force over a rough surface to make it smooth or to remove a layer"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rasp",
                                "target_lang_sense_clarification": "to scrape with a coarse file"
                            },
                            {
                                "target_lang_word": "scrape",
                                "target_lang_sense_clarification": "to remove a layer by rubbing with a tool"
                            },
                            {
                                "target_lang_word": "sand",
                                "target_lang_sense_clarification": "to make smooth using an abrasive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "173c845f-a823-3b88-b931-9b11fbd1c161",
                    "sense_definition": "een onaangenaam, scherp en schurend geluid voortbrengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn stem begon te <w>raspen</w> nadat hij de hele avond had geschreeuwd.",
                            "target_lang_translations": {
                                "en": "His voice began to <w>rasp</w> after he had been shouting all evening."
                            }
                        },
                        {
                            "text": "De metalen deur bleef over de stenen vloer <w>raspen</w> bij het openen.",
                            "target_lang_translations": {
                                "en": "The metal door continued to <w>grate</w> across the stone floor when opening."
                            }
                        }
                    ],
                    "synonyms": [
                        "krassen",
                        "schrapen"
                    ],
                    "common_phrases": [
                        "een raspende stem"
                    ],
                    "target_lang_definitions": {
                        "en": "to produce an unpleasant, sharp, and abrasive sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "to make a harsh, rasping noise"
                            },
                            {
                                "target_lang_word": "rasp",
                                "target_lang_sense_clarification": "to make a rough, harsh sound"
                            },
                            {
                                "target_lang_word": "creak",
                                "target_lang_sense_clarification": "to make a harsh, high-pitched sound"
                            }
                        ]
                    }
                }
            ]
        },
