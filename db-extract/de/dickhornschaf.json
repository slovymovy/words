                        "examples": [
                            {
                                "example_id": "b90b81c8-66aa-41b9-bc41-d88b3c4cc8b0",
                                "sense_id": "9878edfe-831c-338f-b5ed-47d748fe40e2",
                                "text": "„Sie haben erfolglos nach Dickhornschafen Ausschau gehalten, deren Jagdsaison hier im Staat als Letzte endet, nämlich erst mitten im Februar.“"
                            },
                            {
                                "example_id": "863cfb4d-1e18-4bad-9c68-7efccef7314f",
                                "sense_id": "9878edfe-831c-338f-b5ed-47d748fe40e2",
                                "text": "„›Da drüben in den Bergen gibt es Pumas, Dickhornschafe und Adler.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
