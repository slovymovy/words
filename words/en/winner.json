                                "target_lang_word": "gagnant",
                                "target_lang_sense_clarification": "terme général pour celui qui gagne"
                            },
                            {
                                "target_lang_word": "vainqueur",
                                "target_lang_sense_clarification": "celui qui remporte une compétition ou une bataille"
                            },
                            {
                                "target_lang_word": "gagnante",
                                "target_lang_sense_clarification": "forme féminine de gagnant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fdf4118-7c24-339d-813b-af2374903664",
                    "sense_definition": "A point or goal that wins a competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He scored the <w>winner</w> in the final minute of the match.",
