                                                "sense_id": "22d10524-c4ad-33e8-bbd7-ce8e280ef867",
                                                "text": "L'anthropographie française, ou moyens de correspondre à des distances. éloignées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b13c8d-0feb-3519-9e23-db7f29a093cc",
                                        "entry_id": "68d593f5-b7d9-3e0a-b059-c03abc106d79",
                                        "glosses": [
                                            "Anthropologie descriptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
