                "senses": [
                    {
                        "sense_id": "427e8025-8796-3be7-b2fe-0301993b6e7d",
                        "entry_id": "b7541a73-cb8e-3b6d-8b8a-1bce337a1f31",
                        "glosses": [
                            "Embrasser sur la bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098cc2f8-4f3a-4188-b201-e48bbddbbfe8",
                                "sense_id": "427e8025-8796-3be7-b2fe-0301993b6e7d",
                                "text": "Comment smacker"
                            },
                            {
                                "example_id": "9b4ad9f1-1b0a-4924-8dfd-6437b4ce1a14",
                                "sense_id": "427e8025-8796-3be7-b2fe-0301993b6e7d",
                                "text": "L’élève et la chanteuse ont tout bonnement eu l’idée de se smacker à la fin de la prestation."
                            },
                            {
                                "example_id": "88deb526-0d8b-499d-837c-93d64acd775f",
                                "sense_id": "427e8025-8796-3be7-b2fe-0301993b6e7d",
                                "text": "Je vous le dis tout de suite, je suis sortie avec un mec et deux filles, et avec les filles on ne faisait pas que se tenir la main et se smacker !"
                            },
                            {
                                "example_id": "8bce94b6-19c1-4492-bb55-3fefd86dd070",
                                "sense_id": "427e8025-8796-3be7-b2fe-0301993b6e7d",
                                "text": "Les jeunes filles de 16 ans adorent se smacker devant les mecs ou se coller pour exciter les hommes."
                            }
                        ]
                    }
