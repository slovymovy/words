                    },
                    {
                        "translation_id": "4cf72063-c751-47d7-a632-2a29969c4a89",
                        "source_entry_id": "aef427f7-63cc-3fd3-bacd-5977de406a32",
                        "target_lang_word": "magistralement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magistralement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d20df270-c97e-3293-9878-57a87f9c904c",
                                        "entry_id": "9d634977-1daf-312b-bac3-1dd5da224097",
                                        "glosses": [
                                            "D’une manière, d’un ton, d’un air magistral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5021c3c-8ae8-4b2e-93ee-dd37022ee3a1",
                                                "sense_id": "d20df270-c97e-3293-9878-57a87f9c904c",
                                                "text": "Ils [les riches] croient le payer [un auteur] avec usure, s'ils disent magistralement qu’ils ont lu son livre."
                                            },
                                            {
                                                "example_id": "ccd3285d-5d9c-4d47-8d7a-4b7a61d7ec99",
                                                "sense_id": "d20df270-c97e-3293-9878-57a87f9c904c",
                                                "text": "Devait-il écrire si magistralement et si mal sur des matières qu’il n'entendait pas du tout ?"
                                            },
                                            {
                                                "example_id": "34f49b13-5436-4737-b50e-e02ee23b0ca7",
                                                "sense_id": "d20df270-c97e-3293-9878-57a87f9c904c",
                                                "text": "Des écrivains obscurs qui prononceraient magistralement sur les écrits d’un auteur célèbre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c008014e-f69d-4718-b099-329d6aa5f77f",
                        "source_entry_id": "aef427f7-63cc-3fd3-bacd-5977de406a32",
                        "target_lang_word": "admirablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admirablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                        "entry_id": "f6261c13-5bd4-31e5-8b0e-3ef38edca920",
                                        "glosses": [
                                            "D’une manière admirable, parfaite, merveilleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdcd4cd-7c76-402e-bd56-9d11b647e121",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "La porte du pullman de queue, fermée à clef, s’ouvrit : superbement, admirablement vide, la voiture offrait à ses visiteurs impromptus le plus admirable décor de marqueterie en bois de rose — jaune citron et carmin pâle — qui se pût imaginer."
                                            },
                                            {
                                                "example_id": "cefb50eb-ad8a-448d-9c27-7cf532e22afd",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            },
                                            {
                                                "example_id": "a69486f3-b33a-49d7-8406-edd287e6321c",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "Ces deux adverbes joints font admirablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a81f7d-7c35-4810-ae65-cb343f303bc8",
                        "source_entry_id": "aef427f7-63cc-3fd3-bacd-5977de406a32",
                        "target_lang_word": "de main de maître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de main de maître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b98b43ee-f898-3b77-9696-62bab1667f9a",
                                        "entry_id": "1e3658e2-32b4-354f-84ec-778610f22c55",
                                        "glosses": [
                                            "Avec dextérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77629227-453e-445e-9ce8-5b00c4c7c5c1",
                                                "sense_id": "b98b43ee-f898-3b77-9696-62bab1667f9a",
                                                "text": "Les premiers devoirs seraient rédigés de main de maître, sans ratures, sans taches surtout."
                                            },
                                            {
                                                "example_id": "bed792fc-8dbc-4241-8603-2ae8b380d9c2",
                                                "sense_id": "b98b43ee-f898-3b77-9696-62bab1667f9a",
                                                "text": "Menée de main de maître, cette opération de police réussit pleinement."
                                            },
                                            {
                                                "example_id": "e9bfb12a-208e-4667-b7cc-1bfbe6c41828",
                                                "sense_id": "b98b43ee-f898-3b77-9696-62bab1667f9a",
                                                "text": "Cinquante minutes de démonstration de couture menée de main de maître suffisent à vous chambouler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb3e2ee2-407e-4570-a074-ae77312216aa",
                        "source_entry_id": "aef427f7-63cc-3fd3-bacd-5977de406a32",
                        "target_lang_word": "comme pas un",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comme pas un",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5dfdc0-a720-36bd-8956-913fb9403a15",
                                        "entry_id": "91e74cd8-8b3d-362b-b74d-6824265c1f8b",
                                        "glosses": [
                                            "Comme aucun autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbca193-e4e4-4120-9413-25eabe89b50b",
                                                "sense_id": "4f5dfdc0-a720-36bd-8956-913fb9403a15",
                                                "text": "Un bien brave garçon, ce commerçant ! Doux et serviable comme pas un."
                                            },
                                            {
                                                "example_id": "8c4c1daa-19c6-411f-a78e-225a71045bfa",
                                                "sense_id": "4f5dfdc0-a720-36bd-8956-913fb9403a15",
                                                "text": "Paysagiste, il peignit comme pas un la nature sans jamais tenir une palette."
                                            },
                                            {
                                                "example_id": "44afb6cb-f484-46e3-81e7-75b516845fa1",
                                                "sense_id": "4f5dfdc0-a720-36bd-8956-913fb9403a15",
                                                "text": "Vraiment, je te croyais plus futé que ça, toi qui te piques de savoir mentir comme pas un !"
                                            },
                                            {
                                                "example_id": "80de38d2-51da-455a-bb9b-badb8b2363d0",
                                                "sense_id": "4f5dfdc0-a720-36bd-8956-913fb9403a15",
                                                "text": "Il a de l’argent à la pelle, son domaine est exploité comme pas un."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
