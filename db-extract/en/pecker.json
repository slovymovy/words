                        "tags": [
                            "historical",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "4875a1cf-2a16-48b3-a541-3c93308a020f",
                                "sense_id": "b6259700-d424-350f-96f3-813bea2feae4",
                                "text": "Click, click, click, the pecker is at work."
                            },
                            {
                                "example_id": "f4968d9c-0ba3-48e9-9869-d8c965601786",
                                "sense_id": "b6259700-d424-350f-96f3-813bea2feae4",
                                "text": "Pecker, the small cylindrical pin which rises and falls in scanning the holes punched in a slip corresponding to the coding of the message."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c69d84f-6a79-3d2b-94d0-1637e42c21e1",
                        "entry_id": "ee0098a1-9c24-3dd4-af5d-3d3d41583a57",
                        "glosses": [
