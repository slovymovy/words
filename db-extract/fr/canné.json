                "senses": [
                    {
                        "sense_id": "7f1e521b-95ba-3406-8204-4a9911ad5108",
                        "entry_id": "a0a54a3d-0fa5-3a19-a97c-ea4b081d0f99",
                        "glosses": [
                            "Qui est fait avec la canne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23943590-a970-42af-a279-bf427968ed9d",
                                "sense_id": "7f1e521b-95ba-3406-8204-4a9911ad5108",
                                "text": "Châssis cannés pour chaises."
                            },
                            {
                                "example_id": "1cc663f0-8aa8-4e26-9608-228fb30bea35",
                                "sense_id": "7f1e521b-95ba-3406-8204-4a9911ad5108",
                                "text": "Chaise cannée : Chaise dont le siège est formé de petites languettes de cannes découpées et tressées en carré ou en losange, etc."
                            },
                            {
                                "example_id": "d426313d-95a7-4ff7-8a78-3f593682b1cc",
                                "sense_id": "7f1e521b-95ba-3406-8204-4a9911ad5108",
                                "text": "On ne médite pas sur une chaise cannée ; on se gaufre la peau à son contact, c’est tout le résultat qu’on en tire. Rien n’est plus ridicule, vu de dos, qu’un monsieur nu qui quitte une chaise cannée."
                            },
                            {
                                "example_id": "d459835b-f588-4bb3-8ed7-b7e4f82cfe0d",
                                "sense_id": "7f1e521b-95ba-3406-8204-4a9911ad5108",
                                "text": "Du dedans, on la dirait démeublée en dépit d’une salle à manger à table de marbre flanquée d’une douzaine de chaises ripolinées et cannées."
                            }
                        ]
                    },
                    {
