                            {
                                "example_id": "0159a843-c7e2-412c-9c4d-7506bc97fc6a",
                                "sense_id": "bd6a90b9-6d11-3493-b0f3-4c2e39299845",
                                "text": "Vrouwenorganisaties vrezen dat de mogelijkheid voor zwangeren om vrij een verloskundige of gynaecoloog te kiezen verdwijnt, doordat de geboortezorg momenteel sterk en te snel verandert."
                            },
                            {
                                "example_id": "f75a0b6f-821b-4f56-95cb-a0369811a060",
                                "sense_id": "bd6a90b9-6d11-3493-b0f3-4c2e39299845",
                                "text": "Een echtpaar dat binnenkort een eerste kind verwacht, gaat via de rechter afdwingen dat in de geboorteakte straks geen moeder wordt geregistreerd. In plaats daarvan wil de zwangere Ryan Ramharak worden geregistreerd als 'ouder'."
                            }
                        ]
                    }
