{
    "word_family": [
        "declare",
        "declarative",
        "declaratory",
        "undeclared"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6c201b4-b013-3af5-98ab-7ebdef440c77",
                    "sense_definition": "A formal or explicit statement or announcement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government issued a formal <w>declaration</w> of war against the neighboring country.",
                            "target_lang_translations": {
                                "ru": "Правительство выпустило официальное <w>объявление</w> войны соседней стране."
                            }
                        },
                        {
                            "text": "The witness made a solemn <w>declaration</w> that everything she said was the truth.",
                            "target_lang_translations": {
                                "ru": "Свидетельница сделала торжественное <w>заявление</w> о том, что всё сказанное ею — правда."
                            }
                        }
                    ],
                    "synonyms": [
                        "statement",
                        "notice",
                        "avowal"
                    ],
                    "common_phrases": [
                        "formal declaration",
                        "solemn declaration",
                        "written declaration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное или явное заявление или объявление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное высказывание"
                            },
                            {
                                "target_lang_word": "объявление",
                                "target_lang_sense_clarification": "действие по значению объявлять"
                            },
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "торжественное заявление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e341323b-9904-3c38-b113-2d34dbd0810d",
                    "sense_definition": "An official list of items or goods provided for legal or administrative purposes, such as for customs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must complete a customs <w>declaration</w> before you can leave the airport.",
                            "target_lang_translations": {
                                "ru": "Вы должны заполнить таможенную <w>декларацию</w>, прежде чем сможете покинуть аэропорт."
                            }
                        },
                        {
                            "text": "The traveler forgot to include the expensive jewelry on his customs <w>declaration</w>.",
                            "target_lang_translations": {
                                "ru": "Путешественник забыл включить дорогие украшения в свою таможенную <w>декларацию</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "statement",
                        "notice"
                    ],
                    "common_phrases": [
                        "customs declaration",
                        "import declaration",
                        "tax declaration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный список предметов или товаров, предоставляемый для юридических или административных целей, например, для таможни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "таможенная или налоговая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36984f29-17a3-36bd-8054-34a351e8f30c",
                    "sense_definition": "A formal and explicit expression of one's love for another person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was nervous about making a <w>declaration</w> of love to his best friend.",
                            "target_lang_translations": {
                                "ru": "Он нервничал из-за того, что собирался сделать <w>признание</w> в любви своей лучшей подруге."
                            }
                        },
                        {
                            "text": "Her sudden <w>declaration</w> of love took him completely by surprise.",
                            "target_lang_translations": {
                                "ru": "Её внезапное <w>признание</w> в любви застало его врасплох."
                            }
                        }
                    ],
                    "synonyms": [
                        "avowal"
                    ],
                    "common_phrases": [
                        "declaration of love"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in romantic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное и явное выражение любви к другому человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "в любви"
                            },
                            {
                                "target_lang_word": "объяснение",
                                "target_lang_sense_clarification": "в чувствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb5274e-a008-3bd1-83ef-71ce055116f5",
                    "sense_definition": "In computer programming, a statement that specifies the properties of an identifier, such as a variable or function name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_specification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler failed because the variable <w>declaration</w> was missing from the code.",
                            "target_lang_translations": {
                                "ru": "Компилятор выдал ошибку, так как в коде отсутствовало <w>объявление</w> переменной."
                            }
                        },
                        {
                            "text": "A function <w>declaration</w> tells the program about the function's name and return type.",
                            "target_lang_translations": {
                                "ru": "<w>Объявление</w> функции сообщает программе имя функции и тип возвращаемого значения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variable declaration",
                        "function declaration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В компьютерном программировании — инструкция, определяющая свойства идентификатора, такого как переменная или имя функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявление",
                                "target_lang_sense_clarification": "переменной или функции"
                            },
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "в коде программы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30ffb075-d519-366f-9205-cf196191827a",
                    "sense_definition": "A formal legal document that outlines the facts and grounds for a lawsuit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer filed a <w>declaration</w> to initiate the civil proceedings against the company.",
                            "target_lang_translations": {
                                "ru": "Адвокат подал <w>заявление</w>, чтобы начать гражданское судопроизводство против компании."
                            }
                        },
                        {
                            "text": "The defendant received a copy of the <w>declaration</w> detailing the claims against him.",
                            "target_lang_translations": {
                                "ru": "Ответчик получил копию <w>заявления</w> с подробным описанием претензий к нему."
                            }
                        }
                    ],
                    "synonyms": [
                        "statement"
                    ],
                    "common_phrases": [
                        "legal declaration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный юридический документ, излагающий факты и основания для судебного иска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "исковое или юридическое"
                            },
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "юридический документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c8cf72-07a9-3ac7-bcc0-10b427f1e451",
                    "sense_definition": "In cricket, the act of a captain voluntarily ending their team's innings before all players are out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain's bold <w>declaration</w> left the opposing team with a difficult target to chase.",
                            "target_lang_translations": {
                                "ru": "Смелая <w>декларация</w> капитана оставила команде противника сложную цель для достижения."
                            }
                        },
                        {
                            "text": "After reaching a lead of three hundred runs, the team made a tactical <w>declaration</w>.",
                            "target_lang_translations": {
                                "ru": "Добившись преимущества в триста ранов, команда сделала тактическую <w>декларацию</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tactical declaration"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to cricket-playing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете — добровольное прекращение капитаном иннинга своей команды до того, как все игроки выбыли из игры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декларация",
                                "target_lang_sense_clarification": "прекращение иннинга в крикете"
                            },
                            {
                                "target_lang_word": "объявление",
                                "target_lang_sense_clarification": "о завершении серии бросков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}