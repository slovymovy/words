                        "sense_id": "a06d6c54-3000-3853-b8e4-eac39376a8b6",
                        "entry_id": "42f47009-cf85-3321-8299-3d196a35bfc1",
                        "glosses": [
                            "spezielle Creme zur Bräunung der Haut ohne schädliches UV-Licht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1459b41-4b9f-4b4c-9390-d81f7b40cb41",
                                "sense_id": "a06d6c54-3000-3853-b8e4-eac39376a8b6",
                                "text": "Sie bevorzugt Bräunungscreme, weil sie die Risiken von Sonnenstudios wegen des UV-Lichts fürchtet."
                            },
                            {
                                "example_id": "b19768c7-166c-4c83-bb98-35797e15c75d",
                                "sense_id": "a06d6c54-3000-3853-b8e4-eac39376a8b6",
                                "text": "„Und jetzt, wo sie ihn zum ersten Mal im Tageslicht sah, war sie sich außerdem relativ sicher, dass er im Gesicht Bräunungscreme benutzte, denn am Kinn war deutlich eine gelbbraune Linie zu erkennen.“"
                            }
                        ],
