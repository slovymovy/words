                                                "example_id": "64576d0e-f4bb-4320-9be1-adef4765d78d",
                                                "sense_id": "32764741-0689-34a6-a4d5-252bb911c505",
                                                "text": "Yet it is not the predominant views of the experts but the views of a minority, mostly of rather doubtful standing in their profession, which are taken up and spread by the intellectuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7999907f-befb-31ba-91fc-1b13fd09767f",
                                        "entry_id": "dd93fae6-b5fa-36a4-b10b-69008302f350",
                                        "glosses": [
