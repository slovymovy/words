                        "examples": [
                            {
                                "example_id": "f243c73f-f37f-430c-b293-0078b1fb0dfb",
                                "sense_id": "3bdecb0b-d499-3958-8f2e-14245973d8bc",
                                "text": "[W]e muſt not take this mercifull indulgence given to our defectuoſities, as a diſpenſation for the ſordidnes of our loves, but rather in a holy effect and contention of gratitude, ſtrain to love God the more purely, and irreſpectively to our ſelves, in regard of the tranſcendent benignity of this diſpenſation."
                            },
                            {
                                "example_id": "ce7df6aa-18aa-4e6e-bf36-be018faf6f51",
                                "sense_id": "3bdecb0b-d499-3958-8f2e-14245973d8bc",
                                "text": "[…] and presented her, with pride not less than pleasure, to their noble visitant, who, although surprised by the youthfulness of her countenance (rendered the more striking from her late illness), thought that its gentle benignity augured well for his future hopes, […]"
                            }
