                "senses": [
                    {
                        "sense_id": "840280a4-71ac-3bf7-a6db-fc74e25da8a0",
                        "entry_id": "c00999ac-c6f3-3763-b4b4-d0a37f06e702",
                        "glosses": [
                            "jemand, der aufgehängt wurde, um ihn dadurch hinzurichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7ad785-e198-4c16-9d12-81bab66416d7",
                                "sense_id": "840280a4-71ac-3bf7-a6db-fc74e25da8a0",
                                "text": "„Dann fühlte ich, wie einer der Gehenkten mich am Knöchel des linken Beines packte.“"
                            },
                            {
                                "example_id": "e57acabb-072e-45d6-a21e-a11a59c51675",
                                "sense_id": "840280a4-71ac-3bf7-a6db-fc74e25da8a0",
                                "text": "„Genau in meinem Blickfeld, näher und näher heranrückend, fast über mir schon baumelt eine Gestalt, ein Gehenkter am Ast des Chausseebaumes; deutsche Wehrmachtsuniform, nur die Stiefel fehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
