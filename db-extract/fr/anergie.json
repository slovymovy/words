                        "sense_id": "bc778246-1e4c-3194-b494-6622816eaa17",
                        "entry_id": "c0353db6-1d18-33c1-b419-f25d923ba47e",
                        "glosses": [
                            "Manque d’énergie, de tonicité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a04d22f-c6f3-4c05-a5cb-282a4d4d12a3",
                                "sense_id": "bc778246-1e4c-3194-b494-6622816eaa17",
                                "text": "La rougeole ou le SIDA peuvent provoquer une anergie trompeuse."
