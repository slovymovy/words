                                        "sense_id": "03c77256-312e-3575-bc06-40c569031d21",
                                        "entry_id": "f62101c3-fc02-333b-af78-0172cae504e5",
                                        "glosses": [
                                            "Qualifie un être vivant issu d’une cellule dans laquelle a été introduit un ADN étranger."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8dc8f74-5c8a-47cf-941e-455e9ca85b74",
                                                "sense_id": "03c77256-312e-3575-bc06-40c569031d21",
                                                "text": "Ainsi, les promesses chimériques de maïs transgéniques capables de pousser sans eau, voire dans les déserts, sont sans doute techniquement réalisables à terme, mais ces plantes ultra-sobres et ultra-tolérantes ne produiront alors que quelques kilos de grains."
                                            }
                                        ]
                                    }
                                ]
                            }
