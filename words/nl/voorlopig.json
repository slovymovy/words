            "senses": [
                {
                    "sense_id": "06624acf-148c-31c4-b51d-894b0e958300",
                    "sense_definition": "Voor dit moment, in afwachting van latere ontwikkelingen of een definitieve situatie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik blijf <w>voorlopig</w> nog even hier wachten.",
                            "target_lang_translations": {
                                "ru": "Я <w>пока</w> еще подожду здесь.",
                                "en": "I will wait here <w>for the time being</w>.",
                                "pl": "Zostanę tutaj i <w>na razie</w> jeszcze chwilę poczekam.",
                                "de": "Ich werde <w>vorläufig</w> noch hier warten.",
                                "fr": "Je vais <w>pour l'instant</w> attendre ici encore un peu.",
                                "it": "Aspetterò qui ancora <w>per il momento</w>.",
                                "cs": "Zůstanu <w>zatím</w> ještě chvíli čekat tady.",
                                "tr": "<w>Şimdilik</w> burada biraz daha bekleyeceğim.",
                                "es": "Me quedaré esperando aquí <w>por ahora</w>.",
                                "zh": "我<w>暂时</w>还会在这里等一会儿。"
                            }
                        },
                        {
                            "text": "We gaan <w>voorlopig</w> niet op vakantie vanwege het werk.",
                            "target_lang_translations": {
                                "ru": "Мы <w>пока</w> не поедем в отпуск из-за работы.",
                                "en": "We are not going on vacation <w>for now</w> because of work.",
                                "pl": "<w>Na razie</w> nie jedziemy na wakacje z powodu pracy.",
                                "de": "Wir fahren <w>vorerst</w> wegen der Arbeit nicht in den Urlaub.",
                                "fr": "Nous ne partons pas en vacances <w>pour le moment</w> à cause du travail.",
                                "it": "Non andremo in vacanza <w>per ora</w> a causa del lavoro.",
                                "cs": "Kvůli práci <w>prozatím</w> nepojedeme na dovolenou.",
                                "tr": "İş nedeniyle <w>şimdilik</w> tatile gitmiyoruz.",
                                "es": "No nos iremos de vacaciones <w>de momento</w> debido al trabajo.",
                                "zh": "因为工作原因，我们<w>暂时</w>不去度假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tijdelijk"
                    ],
                    "antonyms": [
                        "voorgoed",
                        "definitief"
                    ],
                    "common_phrases": [
                        "voorlopig niet",
                        "voorlopig nog",
                        "maar voorlopig"
                    ],
                    "target_lang_definitions": {
                        "ru": "На данный момент, в ожидании дальнейшего развития событий или окончательной ситуации.",
                        "en": "For the moment, awaiting later developments or a definitive situation.",
                        "pl": "Na ten moment, w oczekiwaniu na późniejszy rozwój wydarzeń lub sytuację ostateczną.",
                        "de": "Für den Moment, in Erwartung späterer Entwicklungen oder einer endgültigen Situation.",
                        "fr": "Pour le moment, en attendant des développements ultérieurs ou une situation définitive.",
                        "it": "Per il momento, in attesa di sviluppi futuri o di una situazione definitiva.",
                        "cs": "Pro tento okamžik, v očekávání pozdějšího vývoje nebo definitivní situace.",
                        "tr": "Şu an için, daha sonraki gelişmeleri veya kesin bir durumu beklerken.",
                        "es": "Por el momento, a la espera de desarrollos posteriores o de una situación definitiva.",
                        "zh": "指目前阶段，等待后续发展或最终情况。"
                    },
