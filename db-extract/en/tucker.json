            {
                "entry_id": "d6ffae61-d098-3d8e-825e-be3fbf57d8cc",
                "word": "tucker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "84264e11-60e6-4c38-bd24-76c4a2ea5b68",
                        "entry_id": "d6ffae61-d098-3d8e-825e-be3fbf57d8cc",
                        "tags": [
