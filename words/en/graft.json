                    "synonyms": [
                        "affix",
                        "attach",
                        "join",
                        "unite"
                    ],
                    "target_lang_definitions": {
                        "ru": "присоединить одну вещь к другой таким образом, чтобы создать тесный или постоянный союз"
                    },
                    "translations": {
                        "ru": [
