                                    {
                                        "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                        "entry_id": "eca029a5-f5cc-3b08-8691-8a39b36f681a",
                                        "glosses": [
                                            "wie ein Affe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18de6d71-6889-4831-b4cd-e7a0cd365710",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Äffischer kann man sich ja kaum noch benehmen!"
                                            },
                                            {
                                                "example_id": "126ba692-5bb7-4fde-8443-81627d1040c2",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Dies sah aber bei dem feierlichen Ernst, den er annahm, so possierlich aus, zumal da er äffische Possenkleider an hatte, daß Männer und Frauen laut lachen mußten, so ernsthaft auch die Freude des Tages war."
                                            },
                                            {
                                                "example_id": "bfad1d9a-2281-4697-ab30-bd683cca8532",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Während diese auf \"menschliche\" Musik so gut wie nicht reagierten, führten die äffischen Kompositionen Teils zu den erwarteten Ergebnissen: Musik aus Angstlauten machte die Lisztaffen ängstlich und vice versa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                        "entry_id": "eca029a5-f5cc-3b08-8691-8a39b36f681a",
                                        "glosses": [
                                            "(vor allem in der Evolutionsbiologie) auf den Affen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4f857c-82a4-40e8-bcba-c2b67e5cbe58",
                                                "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                                "text": "Während diese auf \"menschliche\" Musik so gut wie nicht reagierten, führten die äffischen Kompositionen Teils zu den erwarteten Ergebnissen: Musik aus Angstlauten machte die Lisztaffen ängstlich und vice versa."
                                            },
                                            {
                                                "example_id": "16abaf20-25eb-45df-812b-59d9415f62de",
                                                "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                                "text": "Die Affennatur raste, sich überkugelnd, aus mir hinaus und weg, so daß mein erster Lehrer selbst davon fast äffisch wurde, bald den Unterricht aufgeben und in eine Heilanstalt gebracht werden mußte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
