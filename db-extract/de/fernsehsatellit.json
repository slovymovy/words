                        "sense_id": "da630b7c-2150-3e0a-9014-2bc16c2ff8c7",
                        "entry_id": "4c104564-5d22-37a2-8667-6b248d65d0db",
                        "glosses": [
                            "Satellit, der für die Übertragung von Fernsehprogrammen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b547b1e3-2b52-412c-993c-59e67a3055fc",
                                "sense_id": "da630b7c-2150-3e0a-9014-2bc16c2ff8c7",
                                "text": "„Eine europäische Ariane-5-Rakete hat im dritten Anlauf zwei neue Fernsehsatelliten ins All gebracht.“"
                            },
                            {
                                "example_id": "e3ced7cb-1343-4e8c-a0aa-f8b447e60562",
                                "sense_id": "da630b7c-2150-3e0a-9014-2bc16c2ff8c7",
                                "text": "„Manche Fernsehsatelliten senden ihre Signale nämlich bis in Frequenzbereiche, in denen die Radioteleskope die elektromagnetischen Signale von kosmischen Objekten im ganzen Weltall empfangen wollen und die sogar für die Radioastronomie geschützt sind (z.B. bei 10,6-10,7GHz).“"
                            }
                        ],
