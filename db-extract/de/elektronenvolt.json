                "senses": [
                    {
                        "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                        "entry_id": "b98a19a3-d3d9-394b-b423-a79cfd3e69a9",
                        "glosses": [
                            "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "725403fb-845e-4342-97fc-59127986d708",
                                "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                                "text": "„Ein Elektronenvolt (eV) ist die Energie, die ein Elektron aufnimmt, wenn es ein elektrisches Feld der Spannung von 1 Volt durchläuft. Es entspricht etwa 1,6·10⁻¹⁹ J.“"
                            },
                            {
                                "example_id": "79649381-e51e-4949-8053-493f912e169b",
                                "sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                                "text": "„Die Energieabstände zwischen elektronischen Zuständen sind am größten und liegen bei einigen Elektronenvolt, die zugehörige Strahlung liegt etwa im sichtbaren Bereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e4bd718-6e32-4ca9-a4fd-0b9a5ab42a18",
                        "source_entry_id": "b98a19a3-d3d9-394b-b423-a79cfd3e69a9",
                        "source_sense_id": "7a680f78-4de4-3b69-9dc1-6287266352de",
                        "source_sense_description": "Maßeinheit der Energie, die häufig in der Atomphysik, Kernphysik und Teilchenphysik benutzt wird",
                        "target_lang_word": "electron volt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electron volt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc2b025-07cb-3b80-9dc1-7b6e7bf2b7f4",
                                        "entry_id": "35205d6d-7214-39ce-bcee-b5f111dd23d2",
                                        "glosses": [
                                            "A unit for measuring the energy of subatomic particles; the energy equal to that attained by an electron moving through a potential difference of one volt. Equivalent to 1.6022 × 10⁻¹⁹ joules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abefe5aa-d409-4a65-bcda-7e7b0c0c8ac4",
                                                "sense_id": "4bc2b025-07cb-3b80-9dc1-7b6e7bf2b7f4",
                                                "text": "To get a feel for the size, the energy required to completely liberate an electron from the ground state of a hydrogen atom is 13.6 electron volts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
