        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0468e0c4-5b32-3671-b522-b7861e2035df",
                    "sense_definition": "Personnage incarné ou représenté par un acteur au théâtre ou au cinéma.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "theatre_cinema",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette comédienne a obtenu le premier <w>rôle</w> dans un film historique très attendu."
                        },
                        {
                            "text": "Il interprète un second <w>rôle</w> discret mais essentiel au dénouement de la pièce."
                        }
                    ],
                    "synonyms": [
                        "personnage"
                    ],
                    "common_phrases": [
                        "rôle principal",
                        "second rôle"
                    ]
                },
                {
                    "sense_id": "0f6f58c8-8733-3c0b-90d1-ac5ff1641a9b",
                    "sense_definition": "Fonction, utilité ou influence de quelqu'un ou de quelque chose dans un ensemble ou une situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fonction_utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éducation joue un <w>rôle</w> majeur dans le développement économique d'un pays moderne."
                        },
                        {
                            "text": "Le médecin lui a expliqué en détail le <w>rôle</w> protecteur de ce médicament."
                        }
                    ],
                    "synonyms": [
                        "fonction",
                        "mission"
                    ],
                    "common_phrases": [
                        "jouer un rôle important",
                        "rôle clé"
                    ]
                },
                {
                    "sense_id": "dae39b25-ebc8-3cc5-9843-ed378f4b92bb",
                    "sense_definition": "Texte ou ensemble des répliques qu'un acteur doit apprendre et réciter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "theatre_cinema",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acteur passe plusieurs heures chaque soir à apprendre son <w>rôle</w> par cœur."
                        },
                        {
                            "text": "En pleine représentation, le jeune acteur a oublié son <w>rôle</w> et a dû improviser."
                        }
                    ],
                    "synonyms": [
                        "texte",
                        "réplique"
                    ],
                    "common_phrases": [
                        "apprendre son rôle",
                        "distribuer les rôles"
                    ]
                },
                {
                    "sense_id": "2591565a-ff95-341f-aabf-a425c670ebbd",
                    "sense_definition": "Comportement, attitude ou conduite qu'une personne adopte dans la vie sociale ou dans une circonstance donnée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fonction_utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En intervenant avec fermeté lors du débat, le président est pleinement resté dans son <w>rôle</w>."
                        },
                        {
                            "text": "Il s'efforçait de tenir le <w>rôle</w> de médiateur afin d'apaiser les tensions entre collègues."
                        }
                    ],
                    "synonyms": [
                        "posture",
                        "attitude"
                    ],
                    "common_phrases": [
                        "être dans son rôle",
                        "jouer un double rôle"
                    ]
                },
                {
