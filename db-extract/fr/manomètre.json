        "fr-extract.jsonl": [
            {
                "entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                "word": "manomètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8abbf677-d2e5-4828-856b-ed5aaf8ac163",
                        "entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "tags": [
                            "plural"
                        ],
                        "form": "manomètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fecf26c1-a0f8-3076-a406-c1a8af77ff92",
                        "entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "glosses": [
                            "Instrument qui sert à mesurer la pression des gaz ou des vapeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2deacbcf-9417-446d-a511-f6d93097864b",
                                "sense_id": "fecf26c1-a0f8-3076-a406-c1a8af77ff92",
                                "text": "Seule, une petite lanterne éclairait le niveau d’eau, pour que nulle lumière n’aveuglât le mécanicien ; et, sur le cadran du manomètre, dont l’émail semblait garder une lueur propre, il avait vu que l’aiguille bleue, tremblante, baissait rapidement."
                            },
                            {
                                "example_id": "e7816a3e-497f-4e19-b14b-e20a86467bf5",
                                "sense_id": "fecf26c1-a0f8-3076-a406-c1a8af77ff92",
                                "text": "Elle surveillait le courrier des postulants avec le regard fixe du chauffeur de locomotive sur son manomètre."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e965361-d3b8-3a3f-8be9-a2b8b54f8491",
                        "entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "glosses": [
                            "Instrument pour mesurer la pression des fluides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de126500-076f-469a-b655-213a13acb016",
                                "sense_id": "2e965361-d3b8-3a3f-8be9-a2b8b54f8491",
                                "text": "Dans le Point-d’Interrogation […] nous avons toujours quelque chose à faire. […] Il y a le manomètre de pression d’huile et de pression d’essence à contrôler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e46d52f7-02d0-496b-a27d-4553430a7c2d",
                        "source_entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "target_lang_word": "Manometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                        "entry_id": "b289de50-09b6-3f5e-83da-ea01cece04b3",
                                        "glosses": [
                                            "Messgerät, das den Druck in Flüssigkeiten oder Gasen misst"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69bd4123-efcb-4b93-816f-5fb0a70de5d4",
                                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                                "text": "Das Manometer wird über dem Quecksilberspiegel in das Membrangefäß gehängt und dieses dann oben mit einem Deckel fest verschlossen."
                                            },
                                            {
                                                "example_id": "dcce6b70-6a2f-4218-959b-cd61b27ab92f",
                                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                                "text": "„Die Tauchtiefe sollte über ein Manometer angezeigt werden.“"
                                            },
                                            {
                                                "example_id": "11bf0dcd-7132-48a9-88ed-c84400399744",
                                                "sense_id": "8fd1cc1e-bdaa-3b1b-9675-c506445a0423",
                                                "text": "„Der Zeiger auf dem Manometer ist der größte Feind des Heizers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Manometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7f4fa5-19c9-316a-943b-cda1c7aaa6af",
                                        "entry_id": "ed273b12-bbbe-3784-a481-9347b35377d7",
                                        "glosses": [
                                            "Ausruf der Verwunderung oder auch der Verärgerung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034e5929-af4e-403f-bf90-6c94bcc34d0c",
                                                "sense_id": "5a7f4fa5-19c9-316a-943b-cda1c7aaa6af",
                                                "text": "Manometer, das ging aber flott!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4c34382-1602-48c4-9ea8-37f0e50e0df6",
                        "source_entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "target_lang_word": "Druckmessgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7e66e5f4-84e3-41c8-b3de-2c144411c8b0",
                        "source_entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "target_lang_word": "manometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4042ffe-2811-3fc5-a86c-0abd3bd9d10f",
                                        "entry_id": "68edd643-ea84-3f50-bb8d-6a21993f3a70",
                                        "glosses": [
                                            "An instrument to measure pressure in a fluid, especially a double-legged liquid column gauge used to measure the difference in the pressures of two fluids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7095a7-a04d-4d04-8342-431f5eb2c673",
                                                "sense_id": "d4042ffe-2811-3fc5-a86c-0abd3bd9d10f",
                                                "text": "As soon as the manometer of the pump indicated the maximum of rarification, the apparatus was inclined […]"
                                            },
                                            {
                                                "example_id": "0d1a087b-9fe6-42be-a861-e870a6ee5378",
                                                "sense_id": "d4042ffe-2811-3fc5-a86c-0abd3bd9d10f",
                                                "text": "Pökler helped in working out the Halbmodelle solution: bisecting the model lengthwise and mounting it flat-side to the wall of the test chamber, bringing the tubes through that way to all the manometers outside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a80d135-d4c0-4177-ab3b-e830248b1bcf",
                        "source_entry_id": "e350348c-b9e4-37a2-bbc2-3efef2fc9e13",
                        "target_lang_word": "manómetro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
