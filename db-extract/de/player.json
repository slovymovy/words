                                                "text": "All the world's a ſtage, / And all the men and women, merely Players"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141bed61-d5d8-35d4-ac89-18e7946250de",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
