                        "zh": [
                            {
                                "target_lang_word": "麻木的",
                                "target_lang_sense_clarification": "指失去思考能力"
                            },
                            {
                                "target_lang_word": "发呆的",
                                "target_lang_sense_clarification": "指因无聊或疲劳而反应迟钝"
                            }
                        ]
                    }
                },
                {
