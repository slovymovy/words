                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e09007-0f21-4e90-b5d4-d0f04105ed3f",
                                "sense_id": "ca622572-a3f2-3d0f-b66d-d9507ebfb771",
                                "text": "„Doch wenn sie sah, wer es war, wedelte sie mit ihrem Stummelschwanz – und das war alles.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
