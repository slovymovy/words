                        "examples": [
                            {
                                "example_id": "661b8ca2-2f2c-4572-a16b-f1c891e1031a",
                                "sense_id": "3b280733-0894-3692-b3e9-973407936902",
                                "text": "„Ik vind het lekker, dat vroege opstaan”, zei hij daarover, „vroeger zat ik in een club en bestelde flessen van duizend euro, snoof me helemaal wappie en ging slapen als de vogels wakker worden."
                            },
                            {
                                "example_id": "fa98478c-fe74-4eb8-8a99-5de6481f93c6",
                                "sense_id": "3b280733-0894-3692-b3e9-973407936902",
                                "text": "Toch gaat het om '140 mil', beweert Fem: \"Echte knallers. Je wordt er helemaal wappie van!\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
