                ],
                "senses": [
                    {
                        "sense_id": "38e0f554-3d81-377f-ad9e-70d3e29b90ec",
                        "entry_id": "e901f6be-9b5c-3cc2-a734-1b1506c50f15",
                        "glosses": [
                            "of Aalborg"
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "727f9243-c2a8-414e-aa8c-94bb871e3b65",
                                "sense_id": "38e0f554-3d81-377f-ad9e-70d3e29b90ec",
                                "text": "[...] kopenhaskiej i 100 — do aalborskiej, oraz 60-70 studentów na Wydziale II.",
                                "translation": "… Copenhagen and 100 - to Aalborg, as well as 60-70 students in the second faculty.",
                                "english": "… Copenhagen and 100 - to Aalborg, as well as 60-70 students in the second faculty."
                            },
                            {
                                "example_id": "6a973a60-73c6-42c1-821e-27860a9e98d3",
                                "sense_id": "38e0f554-3d81-377f-ad9e-70d3e29b90ec",
                                "text": "W ślad za Agendą 21 poszła „Karta Europejskich Miast i Miasteczek Dążących do Zrównoważonego Rozwoju\" („Karta Aalborska\") przyjęta przez 80 europejskich.",
                                "translation": "In the wake of Agenda 21, the \"Charter of European Cities and Towns Trying for Sustainable Development\" (the \"Aalborg charter\") came, and was accepted by 80 europeans.",
                                "english": "In the wake of Agenda 21, the \"Charter of European Cities and Towns Trying for Sustainable Development\" (the \"Aalborg charter\") came, and was accepted by 80 europeans."
                            },
                            {
                                "example_id": "7f2e2274-5804-4cd6-a5ae-79ad24fa26c7",
                                "sense_id": "38e0f554-3d81-377f-ad9e-70d3e29b90ec",
                                "text": "Czy możliwe byłoby uczynienie tego tak od razu, skoro dom aalborski prowadził kilka dobrze prosperujących dzieł i posiadał własne, zagospodarowane nieruchomości?",
                                "translation": "Would it be possible to do this like that right away, since the Aalborg house led a few well-prospering works and owned their own domesticated real estate?",
                                "english": "Would it be possible to do this like that right away, since the Aalborg house led a few well-prospering works and owned their own domesticated real estate?"
                            }
                        ]
                    }
                ],
