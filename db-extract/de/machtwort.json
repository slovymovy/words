                        ],
                        "form": "die Machtworte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                        "entry_id": "47f1721e-f0c8-3b56-a491-6f7cdd6d5554",
                        "glosses": [
                            "von einer einzelnen Person getroffene Entscheidung, die aufgrund deren Kompetenz, Autorität zwingend so angenommen werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d9cf60-4317-47d3-a9ee-68fe1509de81",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "Diese Schlamperei ist untragbar, es ist Zeit für ein Machtwort vom Direktor."
                            },
                            {
                                "example_id": "3eb1dcf0-15c7-4392-bb6b-4e98862b9ab5",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "„Als ich ihn fragte, warum er nicht ein Machtwort sprach, um seine Enkelin vor der Beschneidung zu retten, spielte er den Ahnungslosen.“"
                            },
                            {
                                "example_id": "ccde1e80-86e9-45e7-bedd-cd26bad8d97d",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "„Das ging so lange, bis Mama ein Machtwort sprach.“"
                            },
                            {
                                "example_id": "3543eb2c-36c8-419f-b332-8430b65a6381",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "„Es ist ein Verteilungskampf um Bedeutung, der so nur denkbar ist, weil Kohl keine Machtworte mehr sprechen kann.“"
                            },
                            {
                                "example_id": "b8e683a6-a3c4-460c-80dc-13be82115d80",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "„Das Machtwort ist gesprochen.“"
                            },
                            {
                                "example_id": "46b9bb86-d099-47d8-bafa-29672bff1d82",
                                "sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                                "text": "„Nach einem Machtwort ihres Bruders, König Maha Vajiralongkorn, wurde die Kandidatur von staatlicher Seite für unzulässig erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6afdfc2f-bf0a-44c0-b1ff-6b017ea75bb9",
                        "source_entry_id": "47f1721e-f0c8-3b56-a491-6f7cdd6d5554",
                        "source_sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                        "target_lang_word": "word of command",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8e3ce785-f08f-4e9b-9d33-9f6eacc0fdcc",
                        "source_entry_id": "47f1721e-f0c8-3b56-a491-6f7cdd6d5554",
                        "source_sense_id": "f230ce36-671f-3e69-878f-9b07e619edc6",
                        "target_lang_word": "decree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42cf2e9b-84a9-306d-b1fa-9ae8b61c58bf",
                                        "entry_id": "d6260cc2-a400-37e9-afc5-96204950afc6",
                                        "glosses": [
                                            "To command by a decree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fac8bca-b8e3-4279-a405-91db1aee011f",
                                                "sense_id": "42cf2e9b-84a9-306d-b1fa-9ae8b61c58bf",
                                                "text": "A court decrees a restoration of property."
                                            },
                                            {
                                                "example_id": "4b533f26-aab3-4e0d-9f41-1bf9ce2bb434",
                                                "sense_id": "42cf2e9b-84a9-306d-b1fa-9ae8b61c58bf",
                                                "text": "Thou shalt also decree a thing, and it shall be established unto thee."
                                            },
                                            {
                                                "example_id": "95e3149b-2812-4fb4-9460-cd7851dd9ad8",
                                                "sense_id": "42cf2e9b-84a9-306d-b1fa-9ae8b61c58bf",
                                                "text": "In Xanadu did Kubla Khan / A stately pleasure-dome decree: / Where Alph, the sacred river, ran / Through caverns measureless to man / Down to a sunless sea."
                                            },
                                            {
                                                "example_id": "e70a238c-ad5c-475f-95a2-b005642d3bab",
                                                "sense_id": "42cf2e9b-84a9-306d-b1fa-9ae8b61c58bf",
                                                "text": "The Nhasangs themselves are from Ngaba, which is in the Amdo region of northeastern Tibetan, a cultural borderland where Tibetan and Sichuan traditions meet. China has decreed that Ngaba is within Sichuan Province."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77c96210-242f-3e11-ae58-b5f48fb6be7f",
                                        "entry_id": "8ea1232c-ec58-3788-a406-084da1f55061",
                                        "glosses": [
                                            "An edict or law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c9f4b5-ec94-41f6-8dc1-76269f90d449",
                                                "sense_id": "77c96210-242f-3e11-ae58-b5f48fb6be7f",
                                                "text": "There went out a decree from Caesar Augustus that all the world should be taxed."
                                            },
                                            {
                                                "example_id": "de25f93a-f2ee-4ba0-9915-195ea656da7d",
                                                "sense_id": "77c96210-242f-3e11-ae58-b5f48fb6be7f",
                                                "text": "Poor hand, why quiverest thou at this decree?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f5ab6b-fd3f-369a-8b6a-ec67ab190e11",
                                        "entry_id": "8ea1232c-ec58-3788-a406-084da1f55061",
                                        "glosses": [
                                            "The judicial decision in a litigated cause rendered by a court of equity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14b3211b-207c-306d-b614-a721fc0f7d67",
                                        "entry_id": "8ea1232c-ec58-3788-a406-084da1f55061",
                                        "glosses": [
                                            "The determination of a cause in a court of admiralty or court of probate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44c364e7-f85f-3b36-9c1e-39d04bfa7754",
                                        "entry_id": "8ea1232c-ec58-3788-a406-084da1f55061",
                                        "glosses": [
                                            "A predetermination made by God; an act of providence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
