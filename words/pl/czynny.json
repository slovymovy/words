                        "en": "Open and accessible to customers or clients (of a shop, office, service outlet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "о заведениях"
                            },
                            {
                                "target_lang_word": "работающий",
                                "target_lang_sense_clarification": "о графике работы"
                            }
                        ],
