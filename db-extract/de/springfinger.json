                "senses": [
                    {
                        "sense_id": "95967b1f-7bb2-38b4-8e62-f984c1beec09",
                        "entry_id": "ee87bf86-34ef-3027-af83-cfe3468510fa",
                        "glosses": [
                            "anlagebedingte Erkrankung, bei der die Beugesehnen eines Fingers über dem beugeseitigen Fingergrundgelenk am Übergang von Hohlhand zu den Fingern verdickt sind und dadurch nicht mehr frei (sondern nur ruck- und schnappartig) durch das dortige Ringband gleiten können"
                        ],
                        "tags": [
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "322e3cf3-1262-468e-8ca6-0009fac515ce",
                                "sense_id": "95967b1f-7bb2-38b4-8e62-f984c1beec09",
                                "text": "„Die biomechanische Untersuchung der Hand sollte vor allem die differenzialdiagnostisch bedeutende und häufige Tendovaginitis stenosans (Springfinger) ausschließen.“"
                            },
                            {
                                "example_id": "b39427f4-afb7-411c-9295-92e5253cd759",
                                "sense_id": "95967b1f-7bb2-38b4-8e62-f984c1beec09",
                                "text": "„Davon hab ich mir noch die Sehne durchgerissen, von dieser schweren Landarbeit, und hab den Springfinger gekriegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
