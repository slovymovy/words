                "senses": [
                    {
                        "sense_id": "70d2b311-5f65-3da9-bb7d-5d50e93f87e2",
                        "entry_id": "4ab85af3-64da-3cc9-bfbc-1d69dac3d8cb",
                        "glosses": [
                            "slecht Engels, met slechte uitspraak en slechte grammatica"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489e4bbd-5bc6-4a33-ab61-9066363323b1",
                                "sense_id": "70d2b311-5f65-3da9-bb7d-5d50e93f87e2",
                                "text": "Mijn steenkolenengels is na dertien jaar in Engelstalige landen gewoond te hebben toch een stuk beter geworden."
                            },
                            {
                                "example_id": "1e72de8a-eda2-4201-933e-c7a2e7813520",
                                "sense_id": "70d2b311-5f65-3da9-bb7d-5d50e93f87e2",
                                "text": "Op 18-jarige leeftijd vertrok hij in ’t bezit van een weinig steenkolen-Engels, naar Engeland, bracht een half jaar door aan The Royal Normal College for the Blind in Upper-Norwood, met ’t doel daar opleiding te ontvangen voor leeraar in de Wiskunde."
                            },
                            {
                                "example_id": "f2164a30-ce0f-4aea-876d-6047778583f5",
                                "sense_id": "70d2b311-5f65-3da9-bb7d-5d50e93f87e2",
                                "text": "Ja zeker, vooruit maar, hurry up.\" Kees kende wat Engelsch — steenkool-Engelsch, zooals men dat op de havenplaatsen noemde."
                            },
                            {
                                "example_id": "d4963a37-2d71-46ab-8c20-43dc7600c3f0",
                                "sense_id": "70d2b311-5f65-3da9-bb7d-5d50e93f87e2",
                                "text": "'n Reeds lang in 't Zeemanshuis gelogeerde Zweed voegde zich bij ons en vertelde : „Morge ik ga work an boord. Grootveld zegt to me ein uur.\" In onze onmiddellijke nabijheid knoopte 't kleine koopmannetje 'n gesprek aan met 'n Engelschman: „You sleap here this night?\" vroeg-i in steenkool-Engelsch. „No,\" was 't antwoord. „I go directly to London.\" „No Saterday with the boat ?\""
                            }
                        ]
                    }
                ],
