                "senses": [
                    {
                        "sense_id": "545ec8ae-57db-335a-aa73-94d232c81137",
                        "entry_id": "5bce069d-30d4-331e-b697-1694cdb27dcc",
                        "glosses": [
                            "Gueux, misérable dont les dents claquent de froid."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "94294b78-b377-45ba-b4d0-5333359fbc6d",
                                "sense_id": "545ec8ae-57db-335a-aa73-94d232c81137",
                                "text": "Les claquedents pullulaient sur les parvis, attendant, affamés, la viande et le pain de Marie distribués par les bedeaux de la paroisse en l’honneur de la Vierge."
                            },
                            {
                                "example_id": "eb4ceac8-0cfa-4aef-84d4-73800d9273e6",
                                "sense_id": "545ec8ae-57db-335a-aa73-94d232c81137",
                                "text": "Par bonheur, on arrivait dans un village dont j’ai oublié le nom, village, il est vrai, rempli déjà d’un nombre infini de loqueteux et de claquedents."
                            }
                        ]
                    },
                    {
                        "sense_id": "eca2efbf-1518-3718-92a3-551c1641b438",
                        "entry_id": "5bce069d-30d4-331e-b697-1694cdb27dcc",
                        "glosses": [
                            "Bordel."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "af8f384f-cf05-4a17-be8f-110776385f26",
                                "sense_id": "eca2efbf-1518-3718-92a3-551c1641b438",
                                "text": "Pourquoi la rue des Chapeliers me fait-elle songer au claquedent de la Barbuda, à Lisbonne, dans le Bairro Alto (Quartier haut)."
                            }
                        ]
                    },
                    {
                        "sense_id": "538fc7e2-598b-3cfd-9296-62c2649f285c",
                        "entry_id": "5bce069d-30d4-331e-b697-1694cdb27dcc",
                        "glosses": [
                            "Couard, dont les dents claquent de peur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69191add-b2e2-440e-92b4-cd7fe1ef433b",
                                "sense_id": "538fc7e2-598b-3cfd-9296-62c2649f285c",
                                "text": "Blazius, lui, n'augurait rien de bon de ce triomphe ; il redoutait, non sans raison, l'humeur vindicative de Vallombreuse …. Sur quoi Hérode, confiant en l'appui de Sigognac et du marquis, l'appelait poltron, trembleur et claquedents."
                            }
                        ]
                    }
