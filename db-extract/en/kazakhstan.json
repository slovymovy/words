                    },
                    {
                        "translation_id": "8517c9b6-ff32-42a5-8b2b-54c4aa17006c",
                        "source_entry_id": "31a992a5-2d65-3bdd-a1ff-86778f0b3453",
                        "source_sense_id": "b1777c41-5bc3-3dd7-b999-16aaa5d9ecc5",
                        "source_sense_description": "country in Central Asia and Eastern Europe",
                        "target_lang_word": "Kazakhstan",
