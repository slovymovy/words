                        "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                        "entry_id": "9259527f-c41d-37f2-a0ec-3390e985adfe",
                        "glosses": [
                            "The state or quality of being dingy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "cb4464ba-2696-4f1b-83fc-f4824e32cb3a",
                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                "text": "His nether garments were of a blueish gray—violent in its colours once, but sobered now by age and dinginess—and were so stretched and strained in a tough conflict between his braces and his straps, that they appeared every moment in danger of flying asunder at the knees."
                            },
                            {
                                "example_id": "e70a2b81-10aa-4024-a329-b459ec484d9f",
                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                "text": "He was a pitiful image of shabby gentility and the dinginess of “reduced circumstances.”"
                            },
                            {
                                "example_id": "825c247c-6f61-459b-9ed2-cb9ccb24732d",
                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                "text": "The streets were thunderous; a vast energy heaved under the universal coating of dinginess."
                            },
                            {
                                "example_id": "2aba8afa-70d9-4aa3-b2fb-6d9fbdad2fb2",
                                "sense_id": "fa7bbe15-39ab-32fc-b869-78ebc57880d3",
                                "text": "The cramped dinginess of such important stations as Grantham and Peterborough has to be experienced to be believed."
                            }
                        ]
                    }
                ],
