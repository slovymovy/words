                "senses": [
                    {
                        "sense_id": "2e35d632-e800-3f27-bd6f-efbeaadc0b65",
                        "entry_id": "125fa56b-6b10-3ab1-a63c-e2e8ddcb77b7",
                        "glosses": [
                            "The wooden housing for a ship's compass, with its corrector magnets and illuminating arrangements. The log and other equipment for measuring the ship's speed are also stowed there."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8ff97e-eee3-4d4f-90c0-a6c9f5e7bf06",
                                "sense_id": "2e35d632-e800-3f27-bd6f-efbeaadc0b65",
                                "text": "The lamp, or candle, which lights the binnacle, is placed in the cabin, of course the expence of one light is saved, and all the inconveniences of blowing out in a squally night, and likewise the trouble of trimming the lamp, are avoided."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c51d4a3-7384-30dc-b787-49ee611c29ae",
                        "entry_id": "125fa56b-6b10-3ab1-a63c-e2e8ddcb77b7",
                        "glosses": [
                            "The instrument cluster on a car or motorcycle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
