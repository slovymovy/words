                ],
                "senses": [
                    {
                        "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                        "entry_id": "bae58839-fa9e-3411-a721-fe385a38f156",
                        "glosses": [
                            "Durchdringung des saudi-arabischen Arbeitsmarktes mit einheimischen Arbeitskräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222e4b6a-4e99-4e92-ba02-551f472c63a5",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Trotz dieser oberflächlichen Erfolge schreitet die Saudisierung des Privatsektors nur schleppend voran, nach wie vor dominieren ausländische Arbeitskräfte in der saudischen Wirtschaft.“"
                            },
                            {
                                "example_id": "733dc985-ac9d-4cf3-8857-ecbf3f707044",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Saudi-Arabien wird künftig versuchen, den begonnenen Prozess der Saudisierung verstärkt voranzutreiben, unabhängig davon, ob das gegenwärtige politische System des Landes stabil bleibt.“"
                            },
                            {
                                "example_id": "88f662ed-4bf9-46f5-84c8-1636d0bcb8bb",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Riad möchte Millionen Fremdarbeiter aus dem Land drängen und die Saudisierung durchsetzen.“"
                            },
                            {
                                "example_id": "9142f368-35e8-451c-98ed-b5cd7ebc30a2",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Seit einigen Jahren betreibt die Regierung eine ‚Saudisierung‘: Die Unternehmen müssen sich verpflichten, immer mehr inländische Arbeitskräfte einzustellen.“"
                            },
                            {
                                "example_id": "986b6d8f-6c6e-44ba-b0a4-c6d58dc91a87",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Unter dem Stichwort ‚Saudisierung‘ will die Ölmonarchie am Golf bis zur Jahrtausendwende 660 000 Arbeitsplätze schaffen.“"
                            },
                            {
                                "example_id": "d9baab23-36e8-4e2a-9cc7-ec27f838fab5",
                                "sense_id": "7a9eaa57-39e8-3d40-a4bc-10ae54cb40d1",
                                "text": "„Die seit Jahren angepeilte Lösung dieses für die Ölstaaten existentiellen Problems heißt ‚Saudisierung‘, ‚Kuwaitisierung‘, ‚Omanisierung‘: Saudis, Kuwaitis, Omanis sollen schrittweise die Ausländer ablösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
